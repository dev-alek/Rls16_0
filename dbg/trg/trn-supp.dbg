        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code       as character no-undo .
        3   define input  parameter p-trn-doc-close  as logical   no-undo .
        4   define input  parameter p-update-supp    as logical   no-undo .
        5   define input  parameter p-update-chk-doc as logical   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Обновление оборотов по поставщику".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2':u,p-doc-code,p-trn-doc-close)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define temp-table temp-cli-gds no-undo
       85     field temp-cli-type         like ub.cli-gds.cli-type
       86     field temp-cli-code         like ub.cli-gds.cli-code
       87     field temp-host-code        like ub.cli-gds.host-code
       88     field temp-artic            like ub.cli-gds.artic
       89     field temp-prod-type        like ub.cli-gds.prod-type
       90     field temp-prod-code        like ub.cli-gds.prod-code
       91     field temp-supp-qnty        like ub.cli-gds.supp-qnty
       92     field temp-supp-base        like ub.cli-gds.supp-base
       93     field temp-supp-rubl        like ub.cli-gds.supp-rubl
       94     field temp-in-qnty          like ub.cli-gds.in-qnty
       95     field temp-in-base          like ub.cli-gds.in-base
       96     field temp-in-rubl          like ub.cli-gds.in-rubl
       97     field temp-out-qnty         like ub.cli-gds.out-qnty
       98     field temp-out-sum          like ub.cli-gds.out-sum
       99     field temp-out-discnt       like ub.cli-gds.out-discnt
      100     field temp-ret-qnty         like ub.cli-gds.ret-qnty
      101     field temp-ret-sum          like ub.cli-gds.ret-sum
      102     field temp-ret-discnt       like ub.cli-gds.ret-discnt
      103     field temp-update-in-code   as logical
      104     field temp-in-code          like ub.cli-gds.in-code
      105     field temp-exch-code        like ub.cli-gds.exch-code
      106     field temp-price-cli        like ub.cli-gds.price-cli
      107     field temp-unit-cli         like ub.cli-gds.unit-cli
      108     index pi temp-cli-type temp-cli-code temp-host-code temp-artic temp-prod-type temp-prod-code
      109   .
      110   define buffer buf_trn-doc         for ub.trn-doc   .
      111   define buffer buf_chk-doc         for ub.chk-doc   .
      112   define buffer income_buf_trn-doc  for ub.trn-doc   .
      113   define buffer buf_doc-line        for ub.doc-line  .
      114   define buffer income_buf_doc-line for ub.doc-line  .
      115   define buffer buf_gds-dtl         for ub.gds-dtl   .
      116   define buffer buf_goods           for ub.goods     .
      117   define buffer archive_parts       for ub.parts     .
      118   define buffer buf_temp-cli-gds    for temp-cli-gds .
      119   define buffer buf_cli-gds         for ub.cli-gds   .
      120   define variable v-update-sign               as integer   no-undo .
      121   define variable v-r-b-is-base               as logical   no-undo .
      122   define variable v-change-qnty               as decimal   no-undo .
      123   define variable v-change-price-base         as decimal   no-undo .
      124   define variable v-change-price-rubl         as decimal   no-undo .
      125   define variable v-total-qnty                as decimal   no-undo .
      126   define variable v-total-base-total          as decimal   no-undo .
      127   define variable v-total-rubl-total          as decimal   no-undo .
      128   define variable v-total-gds-dtl-sum-base    as decimal   no-undo .
      129   define variable v-total-gds-dtl-sum-rubl    as decimal   no-undo .
      130   define variable v-total-gds-dtl-discnt-base as decimal   no-undo .
      131   define variable v-total-gds-dtl-discnt-rubl as decimal   no-undo .
      132   define variable v-flag                      as logical   no-undo .
      133   do
      134   on error undo, return error return-value
      135   :
      136     find first buf_trn-doc no-lock
      137       where buf_trn-doc.doc-code = p-doc-code
      138       no-error .
      139     if not available buf_trn-doc
      140     then do:
      141       undo, return error substitute("&1: Не найден документ &2", vss-workfile, p-doc-code) .
      142     end.
      143     if p-update-chk-doc = true
      144     then do:
      145       for each buf_chk-doc no-lock
      146         where buf_chk-doc.out-code = p-doc-code
      147           and buf_chk-doc.d-card <> "":u
      148       on error undo, return error return-value
      149       :
      150         if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0 then next.
      151         run str/trnsupds.p
      152           (input buf_chk-doc.doc-code
      153           ,input p-trn-doc-close
      154           ) .
      155       end.
      156     end.
      157     if p-trn-doc-close = true
      158     then do:
      159       assign
      160         v-update-sign = 1
      161       .
      162     end.
      163     else do:
      164       assign
      165         v-update-sign = -1
      166       .
      167     end.
      168   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      170     (output v-r-b-is-base
      171     )  .
      172     for each buf_doc-line exclusive-lock
      173       where buf_doc-line.doc-code = buf_trn-doc.doc-code
      174     on error undo, return error return-value
      175     :
      176       assign
      177         v-total-qnty                = 0
      178         v-total-base-total          = 0
      179         v-total-rubl-total          = 0
      180         v-total-gds-dtl-sum-base    = 0
      181         v-total-gds-dtl-sum-rubl    = 0
      182         v-total-gds-dtl-discnt-base = 0
      183         v-total-gds-dtl-discnt-rubl = 0
      184       .
      185       find first buf_goods no-lock
      186         where buf_goods.artic     = buf_doc-line.artic
      187           and buf_goods.prod-type = buf_doc-line.prod-type
      188           and buf_goods.prod-code = buf_doc-line.prod-code
      189         .
      190       if buf_goods.gds-type = 'т':U
      191       then do:
      192         run clear-temp-cli-gds in this-procedure .
      193         for each archive_parts share-lock
      194           where archive_parts.out-code  = buf_doc-line.doc-code
      195             and archive_parts.obj-type  = buf_doc-line.obj-type
      196             and archive_parts.obj-code  = buf_doc-line.obj-code
      197             and archive_parts.artic     = buf_doc-line.artic
      198             and archive_parts.prod-type = buf_doc-line.prod-type
      199             and archive_parts.prod-code = buf_doc-line.prod-code
      200         on error undo, return error return-value
      201         :
      202           run create-temp-cli-gds in this-procedure
      203             (input  archive_parts.supp-type
      204             ,input  archive_parts.supp-code
      205             ,input  buf_trn-doc.host-code
      206             ,input  archive_parts.artic
      207             ,input  archive_parts.prod-type
      208             ,input  archive_parts.prod-code
      209             ,buffer buf_temp-cli-gds
      210             ) .
      211           assign
      212             v-change-qnty = archive_parts.fact-qnty
      213           .
      214           if buf_trn-doc.doc-type = 'рас':U
      215           or buf_trn-doc.doc-type = 'спи':U
      216           then do:
      217             assign
      218               v-change-qnty     = - v-change-qnty
      219             .
      220           end.
      221           assign
      222             v-change-price-base = archive_parts.price-base * v-change-qnty
      223             v-change-price-rubl = archive_parts.price-rubl * v-change-qnty
      224           .
      225           assign
      226             buf_temp-cli-gds.temp-supp-qnty  = buf_temp-cli-gds.temp-supp-qnty
      227                                              + v-change-qnty
      228             buf_temp-cli-gds.temp-supp-base  = buf_temp-cli-gds.temp-supp-base
      229                                              + v-change-price-base
      230             buf_temp-cli-gds.temp-supp-rubl  = buf_temp-cli-gds.temp-supp-rubl
      231                                              + v-change-price-rubl
      232           .
      233           assign
      234             v-total-qnty       = v-total-qnty
      235                                + archive_parts.fact-qnty
      236             v-total-base-total = v-total-base-total
      237                                + archive_parts.price-base * archive_parts.fact-qnty
      238             v-total-rubl-total = v-total-rubl-total
      239                                + archive_parts.price-rubl * archive_parts.fact-qnty
      240           .
      241         end.
      242         for each buf_gds-dtl share-lock
      243           where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
      244             and buf_gds-dtl.artic     = buf_doc-line.artic
      245             and buf_gds-dtl.prod-type = buf_doc-line.prod-type
      246             and buf_gds-dtl.prod-code = buf_doc-line.prod-code
      247         on error undo, return error
      248         :
      249           assign
      250             v-total-gds-dtl-sum-base    = v-total-gds-dtl-sum-base
      251                                         + buf_gds-dtl.fact-qnty * (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
      252             v-total-gds-dtl-sum-rubl    = v-total-gds-dtl-sum-rubl
      253                                         + buf_gds-dtl.fact-qnty * (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
      254             v-total-gds-dtl-discnt-base = v-total-gds-dtl-discnt-base
      255                                         + buf_gds-dtl.fact-qnty * buf_gds-dtl.discnt-base
      256             v-total-gds-dtl-discnt-rubl = v-total-gds-dtl-discnt-rubl
      257                                         + buf_gds-dtl.fact-qnty * buf_gds-dtl.discnt-rubl
      258           .
      259         end.
      260         if buf_trn-doc.internal = no
      261         then do:
      262           run create-temp-cli-gds in this-procedure
      263             (input  buf_trn-doc.cli-type
      264             ,input  buf_trn-doc.cli-code
      265             ,input  buf_trn-doc.host-code
      266             ,input  buf_doc-line.artic
      267             ,input  buf_doc-line.prod-type
      268             ,input  buf_doc-line.prod-code
      269             ,buffer buf_temp-cli-gds
      270             ) no-error .
      271           if error-status :error
      272           then do:
      273             message
      274               vss-workfile vss-revision vss-description skip
      275               "Ошибка при вызове процедуры" 'create-temp-cli-gds':u skip
      276               "Клиент" buf_trn-doc.cli-type buf_trn-doc.cli-code skip
      277               "Фирма" buf_trn-doc.host-code skip
      278               "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      279               error-status :get-message(1) skip
      280               return-value skip
      281               view-as alert-box error .
      282             undo, return error return-value .
      283           end.
      284           case buf_trn-doc.doc-type
      285           :
      286             when 'при':U
      287             then do:
      288               if v-total-qnty <> 0
      289               then do:
      290                 assign
      291                   buf_temp-cli-gds.temp-in-qnty = v-total-qnty
      292                   buf_temp-cli-gds.temp-in-base = v-total-base-total
      293                   buf_temp-cli-gds.temp-in-rubl = v-total-rubl-total
      294                 .
      295                 if p-trn-doc-close = true
      296                 then do:
      297                   assign
      298                     buf_temp-cli-gds.temp-update-in-code = true
      299                     buf_temp-cli-gds.temp-in-code        = buf_trn-doc.doc-code
      300                     buf_temp-cli-gds.temp-exch-code      = buf_trn-doc.exch-code
      301                     buf_temp-cli-gds.temp-price-cli      = buf_doc-line.price-cli
      302                     buf_temp-cli-gds.temp-unit-cli       = buf_doc-line.unit-cli
      303                   .
      304                 end.
      305                 else do:
      306                   v-flag = false .
      307                   for each income_buf_doc-line no-lock
      308                     where income_buf_doc-line.obj-type     = buf_doc-line.obj-type
      309                       and income_buf_doc-line.obj-code     = buf_doc-line.obj-code
      310                       and income_buf_doc-line.artic        = buf_doc-line.artic
      311                       and income_buf_doc-line.prod-type    = buf_doc-line.prod-type
      312                       and income_buf_doc-line.prod-code    = buf_doc-line.prod-code
      313                       and income_buf_doc-line.status_      = 'факт':U
      314                       and income_buf_doc-line.doc-code    <> buf_doc-line.doc-code
      315                   ,first income_buf_trn-doc no-lock
      316                     where income_buf_trn-doc.doc-code = income_buf_doc-line.doc-code
      317                       and income_buf_trn-doc.doc-type = 'при':U
      318                   by income_buf_doc-line.fact-order descending
      319                   on error undo, return error return-value
      320                   :
      321                      if not (income_buf_trn-doc.cli-type = buf_trn-doc.cli-type and
      322                              income_buf_trn-doc.cli-code = buf_trn-doc.cli-code)
      323                      then next.
      324                     assign
      325                       buf_temp-cli-gds.temp-update-in-code = true
      326                       buf_temp-cli-gds.temp-in-code        = income_buf_trn-doc.doc-code
      327                       buf_temp-cli-gds.temp-exch-code      = income_buf_trn-doc.exch-code
      328                       buf_temp-cli-gds.temp-price-cli      = income_buf_doc-line.price-cli
      329                       buf_temp-cli-gds.temp-unit-cli       = income_buf_doc-line.unit-cli
      330                       v-flag = true
      331                     .
      332                     leave .
      333                   end.
      334                   if v-flag = false then do:
      335                     assign
      336                       buf_temp-cli-gds.temp-update-in-code = true
      337                       buf_temp-cli-gds.temp-in-code        = ""
      338                       buf_temp-cli-gds.temp-price-cli      = 0
      339                       buf_temp-cli-gds.temp-unit-cli       = ?
      340                       buf_temp-cli-gds.temp-exch-code      = ?
      341                       .
      342                   end.
      343                 end.
      344               end.
      345             end.
      346             when 'рас':U
      347             then do:
      348               assign
      349                 buf_temp-cli-gds.temp-out-qnty   = v-total-qnty
      350               .
      351               if v-r-b-is-base = true
      352               then do:
      353                 assign
      354                   buf_temp-cli-gds.temp-out-sum    = v-total-gds-dtl-sum-base
      355                   buf_temp-cli-gds.temp-out-discnt = v-total-gds-dtl-discnt-base
      356                 .
      357               end.
      358               else do:
      359                 assign
      360                   buf_temp-cli-gds.temp-out-sum    = v-total-gds-dtl-sum-rubl
      361                   buf_temp-cli-gds.temp-out-discnt = v-total-gds-dtl-discnt-rubl
      362                 .
      363               end.
      364             end.
      365             when 'возврат':U
      366             then do:
      367               assign
      368                 buf_temp-cli-gds.temp-ret-qnty   = v-total-qnty
      369               .
      370               if v-r-b-is-base = true
      371               then do:
      372                 assign
      373                   buf_temp-cli-gds.temp-ret-sum    = v-total-gds-dtl-sum-base
      374                   buf_temp-cli-gds.temp-ret-discnt = v-total-gds-dtl-discnt-base
      375                 .
      376               end.
      377               else do:
      378                 assign
      379                   buf_temp-cli-gds.temp-ret-sum    = v-total-gds-dtl-sum-rubl
      380                   buf_temp-cli-gds.temp-ret-discnt = v-total-gds-dtl-discnt-rubl
      381                 .
      382               end.
      383             end.
      384           end case .
      385         end.
      386         for each buf_temp-cli-gds
      387         on error undo, return error
      388         :
      389   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cligdscr in g#library
      391     (input  buf_temp-cli-gds.temp-cli-type
      392     ,input  buf_temp-cli-gds.temp-cli-code
      393     ,input  buf_temp-cli-gds.temp-host-code
      394     ,input  buf_temp-cli-gds.temp-artic
      395     ,input  buf_temp-cli-gds.temp-prod-type
      396     ,input  buf_temp-cli-gds.temp-prod-code
      397     ,buffer buf_cli-gds
      398     ) no-error .
      399           if error-status :error
      400           then do:
      401             message
      402               vss-workfile vss-revision vss-description skip
      403               "Ошибка при создании записи информации остатков по клиенту" skip
      404               "cli-type"  buf_temp-cli-gds.temp-cli-type  skip
      405               "cli-code"  buf_temp-cli-gds.temp-cli-code  skip
      406               "host-code" buf_temp-cli-gds.temp-host-code skip
      407               "artic"     buf_temp-cli-gds.temp-artic     skip
      408               "prod-type" buf_temp-cli-gds.temp-prod-type skip
      409               "prod-code" buf_temp-cli-gds.temp-prod-code skip
      410               view-as alert-box error .
      411             undo, return error .
      412           end.
      413           find current buf_cli-gds exclusive-lock .
      414           if p-update-supp = true
      415           then do:
      416             assign
      417               buf_cli-gds.supp-qnty  = buf_cli-gds.supp-qnty  + buf_temp-cli-gds.temp-supp-qnty
      418                                                               * v-update-sign
      419               buf_cli-gds.supp-base  = buf_cli-gds.supp-base  + buf_temp-cli-gds.temp-supp-base
      420                                                               * v-update-sign
      421               buf_cli-gds.supp-rubl  = buf_cli-gds.supp-rubl  + buf_temp-cli-gds.temp-supp-rubl
      422                                                               * v-update-sign
      423             .
      424           end.
      425           assign
      426             buf_cli-gds.in-qnty    = buf_cli-gds.in-qnty    + buf_temp-cli-gds.temp-in-qnty
      427                                                             * v-update-sign
      428             buf_cli-gds.in-base    = buf_cli-gds.in-base    + buf_temp-cli-gds.temp-in-base
      429                                                             * v-update-sign
      430             buf_cli-gds.in-rubl    = buf_cli-gds.in-rubl    + buf_temp-cli-gds.temp-in-rubl
      431                                                             * v-update-sign
      432             buf_cli-gds.out-qnty   = buf_cli-gds.out-qnty   + buf_temp-cli-gds.temp-out-qnty
      433                                                             * v-update-sign
      434             buf_cli-gds.out-sum    = buf_cli-gds.out-sum    + buf_temp-cli-gds.temp-out-sum
      435                                                             * v-update-sign
      436             buf_cli-gds.out-discnt = buf_cli-gds.out-discnt + buf_temp-cli-gds.temp-out-discnt
      437                                                             * v-update-sign
      438             buf_cli-gds.ret-qnty   = buf_cli-gds.ret-qnty   + buf_temp-cli-gds.temp-ret-qnty
      439                                                             * v-update-sign
      440             buf_cli-gds.ret-sum    = buf_cli-gds.ret-sum    + buf_temp-cli-gds.temp-ret-sum
      441                                                             * v-update-sign
      442             buf_cli-gds.ret-discnt = buf_cli-gds.ret-discnt + buf_temp-cli-gds.temp-ret-discnt
      443                                                             * v-update-sign
      444           .
      445           if buf_temp-cli-gds.temp-update-in-code = true
      446           then do:
      447             find income_buf_trn-doc no-lock
      448               where income_buf_trn-doc.doc-code = buf_cli-gds.in-code
      449               no-error .
      450             if  available income_buf_trn-doc
      451             and income_buf_trn-doc.status_ = 'факт':U
      452             and ( income_buf_trn-doc.fact-date > buf_trn-doc.fact-date
      453                 or (income_buf_trn-doc.fact-date = buf_trn-doc.fact-date
      454                     and income_buf_trn-doc.fact-num > buf_trn-doc.fact-num
      455                     )
      456                 )
      457             then do:
      458             end.
      459             else do:
      460               assign
      461                 buf_cli-gds.in-code   = buf_temp-cli-gds.temp-in-code
      462                 buf_cli-gds.exch-code = buf_temp-cli-gds.temp-exch-code
      463                 buf_cli-gds.price-cli = buf_temp-cli-gds.temp-price-cli
      464                 buf_cli-gds.unit-cli  = buf_temp-cli-gds.temp-unit-cli
      465               .
      466             end.
      467           end.
      468         end.
      469       end.
      470     end.
      471   end.
      472   procedure clear-temp-cli-gds :
      473     define buffer buf_temp-cli-gds for temp-cli-gds .
      474     do
      475     on error undo, return error return-value
      476     :
      477       for each buf_temp-cli-gds
      478       on error undo, return error
      479       :
      480         delete buf_temp-cli-gds .
      481       end.
      482     end.
      483   end procedure.
      484   procedure create-temp-cli-gds :
      485     define input  parameter p-supp-type as character no-undo .
      486     define input  parameter p-supp-code as integer   no-undo .
      487     define input  parameter p-host-code as integer   no-undo .
      488     define input  parameter p-artic     as character no-undo .
      489     define input  parameter p-prod-type as character no-undo .
      490     define input  parameter p-prod-code as integer   no-undo .
      491     define parameter buffer buf_temp-cli-gds for temp-cli-gds .
      492     do
      493     on error undo, return error return-value
      494     :
      495       find first buf_temp-cli-gds
      496         where buf_temp-cli-gds.temp-cli-type  = p-supp-type
      497           and buf_temp-cli-gds.temp-cli-code  = p-supp-code
      498           and buf_temp-cli-gds.temp-host-code = p-host-code
      499           and buf_temp-cli-gds.temp-artic     = p-artic
      500           and buf_temp-cli-gds.temp-prod-type = p-prod-type
      501           and buf_temp-cli-gds.temp-prod-code = p-prod-code
      502         no-error .
      503       if not available buf_temp-cli-gds
      504       then do:
      505         create buf_temp-cli-gds .
      506         assign
      507           buf_temp-cli-gds.temp-cli-type  = p-supp-type
      508           buf_temp-cli-gds.temp-cli-code  = p-supp-code
      509           buf_temp-cli-gds.temp-host-code = p-host-code
      510           buf_temp-cli-gds.temp-artic     = p-artic
      511           buf_temp-cli-gds.temp-prod-type = p-prod-type
      512           buf_temp-cli-gds.temp-prod-code = p-prod-code
      513         .
      514       end.
      515     end.
      516   end procedure.
