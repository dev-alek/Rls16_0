      645   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      646   define variable v-waitfram-action01         as character   no-undo .
      647   define variable v-waitfram-action02         as character   no-undo .
      648   define variable v-waitfram-action03         as character   no-undo .
      649   define variable mWaitFramTextBeg            as character   no-undo.
      650   define variable mWaitFramTextEnd            as character   no-undo.
      651   define variable mWaitFramView               as logical     no-undo.
      652   define variable mWaitProcEvent              as logical     no-undo init yes.
      653   define variable mWaitFramInterval           as integer     no-undo init 1 .
      654   define variable mWaitFramStop               as logical     no-undo.
      655   define variable mWaitFramStopUser           as logical     no-undo.
      656   define variable mWaitFramStopTimeOut        as logical     no-undo.
      657   define variable mWaitFramStartProc          as datetime-tz no-undo.
      658   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      659   define button B-WaitFramStop auto-end-key
      660        label "Стоп"
      661        size 10 by 1 tooltip "Остоновить процесс".
      662   define button B-viewProcInfo
      663        label "Информация"
      664        size 15 by 1 tooltip "Информация о процесс".
      665   define frame waitfram
      666     v-waitfram-action01 format "x(72)" no-label skip
      667     v-waitfram-action02 format "x(72)" no-label skip
      668     v-waitfram-action03 format "x(72)" no-label skip
      669     B-viewProcInfo
      670     B-WaitFramStop at row 4 col 30
      671     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      672     .
      673   define new global shared variable mBatchMode as logical no-undo init ?.
      674   define variable mFramBachModHandle as handle no-undo.
      675   mFramBachModHandle = frame waitfram:handle.
      676   define variable mFameOldVis as logical no-undo.
      677   define variable mVisCUrentVin as logical no-undo.
      678   if session:batch-mode
      679   then
      680      mBatchMode = yes.
      681   if mBatchMode = ? then do:
      682     mVisCUrentVin = current-window:visible.
      683     mFameOldVis = mFramBachModHandle:visible.
      684     mFramBachModHandle:visible  = yes.
      685     mBatchMode = mFramBachModHandle:visible ne yes.
      686     mFramBachModHandle:visible = mFameOldVis.
      687     current-window:visible = mVisCUrentVin.
      688   end.
      689    if  log-manager:logfile-name ne ?
      690     then DO:
      691         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      692         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      693         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      694     end.
      695   on choose of B-WaitFramStop in frame waitfram
      696   do:
      697     mWaitFramStop = yes.
      698     mWaitFramStopUser = yes.
      699   end.
      700   function waitfram-check-timeout returns logical():
      701      define variable vtime as int64 no-undo.
      702      if mWaitFramStopTimeOut
      703      then
      704         return yes.
      705      vtime = ( now - mWaitFramStartProc ) / 1000 .
      706      if     mWaitFramTimeOut ne ?
      707         and mWaitFramTimeOut ne 0
      708         and mWaitFramTimeOut lt vtime
      709      then do:
      710         mWaitFramStopTimeOut = yes.
      711      end.
      712      return mWaitFramStopTimeOut.
      713   end.
      714   procedure waitfram-hide :
      715     if not session:batch-mode
      716     then do
      717     on error undo, return error return-value
      718     :
      719       pause 0 before-hide .
      720       if not mBatchMode then
      721         hide frame waitfram .
      722     if     not mWaitFramView
      723        and mWaitProcEvent
      724     then
      725       process events .
      726     end.
      727   end procedure.
      728   procedure waitfram-show :
      729     define input  parameter p-message as character no-undo .
      730     define variable v-left-margin as integer   no-undo .
      731     if not session:batch-mode
      732     then do
      733     on error undo, return error return-value
      734     :
      735       if length(p-message) <= 70 then do:
      736         assign
      737           v-left-margin = integer((70 - length(p-message)) / 2)
      738         .
      739         assign
      740           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      741         .
      742         assign
      743           v-waitfram-action01 = " "
      744           v-waitfram-action02 = " "
      745                                    + fill(" ", v-left-margin)
      746                                    + p-message
      747           v-waitfram-action03 = " "
      748         .
      749       end.
      750       else do:
      751         define variable vRindex1 as integer no-undo.
      752         define variable vRindex2 as integer no-undo.
      753         vRindex1 = r-index(p-message," ",70).
      754         if vRindex1 = 0
      755         then
      756            vRindex1 = 70.
      757         if length(p-message)  <= vRindex1 + 70 then do:
      758           assign
      759             v-waitfram-action01 = " "
      760             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      761             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      762           .
      763         end.
      764         else do:
      765           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      766           if vRindex2 <= vRindex1
      767           then
      768              vRindex2 = vRindex1 + 70.
      769           assign
      770             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      771             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      772             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      773           .
      774         end.
      775       end.
      776       B-viewProcInfo:visible   in frame waitfram = no.
      777       B-viewProcInfo:sensitive in frame waitfram = no.
      778       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      779       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      780       if  (   mWaitFramView
      781          or  mWaitProcEvent)
      782          and not mBatchMode
      783       then
      784          display
      785             v-waitfram-action01 skip
      786             v-waitfram-action02 skip
      787             v-waitfram-action03 skip
      788          with frame waitfram .
      789       if     mWaitFramView
      790          then do:
      791             if     mWaitFramInterval ne ?
      792                and not mBatchMode
      793             then
      794                wait-for go of frame waitfram pause mWaitFramInterval.
      795          end.
      796          else
      797             if     mWaitProcEvent
      798                and not mBatchMode
      799             then
      800                process events .
      801     end.
      802   end procedure.
      803      procedure waitfram-show-this:
      804         define input  parameter iInterval as int64 no-undo.
      805         define variable vtime as int64 no-undo.
      806         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      807         mWaitFramInterval = iInterval.
      808         run waitfram-show (substitute("&1&2 &3&4" ,
      809                                       mWaitFramTextBeg ,
      810                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      811                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      812                                       mWaitFramTextEnd
      813                                      )
      814                           ).
      815      end.
      816      procedure WaitFramRunPause:
      817         define input  parameter iInterval as dec no-undo.
      818         define variable vStart  as datetime-tz no-undo.
      819         define variable vend    as datetime-tz no-undo.
      820         define variable vint as int64 no-undo.
      821         define variable vOk as logical no-undo.
      822         vStart = now.
      823         vend   = vStart.
      824         publish "WaitFramPause" (iInterval,output vOk).
      825         vend   =  now.
      826         vint = vend - vStart.
      827         vint = iInterval - vint / 1000.
      828         if     not mWaitFramStop
      829            and (   vint > 0
      830                 or (    not vOk
      831                     and iInterval eq ?
      832                     )
      833                 )
      834         then
      835            run waitfram-show-this (iInterval).
      836         vend   =  now.
      837         vint = vend - vStart.
      838         vint = iInterval - vint / 1000.
      839         if     not mWaitFramStop
      840            and vint > 0
      841         then do:
      842            run gbl/pause.p (vint * 1000).
      843         end.
      844         if iInterval ne ?
      845         then
      846            publish "WaitFramStop".
      847         waitfram-check-timeout().
      848      end.
      849      procedure WaitFramWaitFor:
      850         define input  parameter iInterval as dec no-undo.
      851         assign
      852            mWaitFramStartProc   = now
      853            mWaitFramStopUser    = no
      854            mWaitFramStopTimeOut = no
      855         .
      856         block-wait:
      857         do while not mWaitFramStop:
      858            run WaitFramRunPause (iInterval).
      859            if  waitfram-check-timeout()
      860            then do:
      861               leave block-wait.
      862            end.
      863         end.
      864         run waitfram-hide.
      865      end.
      866   procedure waitfram-join :
      867     define input  parameter p-line-1  as character no-undo .
      868     define input  parameter p-line-2  as character no-undo .
      869     define input  parameter p-line-3  as character no-undo .
      870     define output parameter p-message as character no-undo .
      871     do
      872     on error undo, return error return-value
      873     :
      874       assign
      875         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      876                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      877                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      878       .
      879     end.
      880   end procedure.
      881   function waitfram-join-function returns character
      882     (input p-line-1 as character
      883     ,input p-line-2 as character
      884     ,input p-line-3 as character
      885     ).
      886     define variable v-message as character no-undo .
      887     run waitfram-join in this-procedure
      888       (input  p-line-1
      889       ,input  p-line-2
      890       ,input  p-line-3
      891       ,output v-message
      892       ) .
      893     return v-message .
      894   end function .
      895   define temp-table temp-gds-list no-undo
      896     field action-num  as integer
      897     field gds-code    as integer
      898     field host-code   as integer
      899     field obj-type    as character
      900     field obj-code    as integer
      901     field action      as character
      902     field bp_rowid    as rowid
      903     index xpk is primary unique action-num
      904     index xie1 gds-code
      905   .
      906   define variable v-view-log as logical no-undo .
      907   define variable v-stop as logical no-undo .
      908   define variable log-file-name as character no-undo init "send-cd.txt":U.
      909   main-block:
      910   do
      911   on error undo main-block, return error return-value
      912   :
      913     for each gdsolist:
      914       delete gdsolist.
      915     end.
      916     define buffer btpr-gds-lock_batchprocess for ub.batchprocess .
      917     run gbl/lock-prc.p
      918       (input 'gds':U
      919       ,input 0
      920       ,input 0
      921       ,input 0
      922       ,input ""
      923       ,input ""
      924       ,input ""
      925       ,input ",,,,,,Обработка изменений товара"
      926       ,input p-message-on
      927       ,buffer btpr-gds-lock_batchprocess
      928       ) no-error .
      929     if error-status :error
      930     then do:
      931       if p-message-on = true
      932       or error-status :get-message(1) <> ""
      933       then do:
      934         message
      935           vss-workfile vss-revision vss-description skip
      936           "В данный момент происходит Обработка изменений товара" skip
      937           view-as alert-box error .
      938       end.
      939       undo, return error "В данный момент происходит Обработка изменений товара" .
      940     end.
      941     run waitfram-show in this-procedure ("Ждите... Поиск информации, подлежащей отправке на кассы..." ).
      942     run create-gds-list in this-procedure .
      943     run waitfram-hide in this-procedure .
      944     run process-gds-list in this-procedure .
      945     run close-gds-list in this-procedure .
      946   end.
      947   procedure create-gds-list :
      948     define buffer buf_batchprocess for ub.batchprocess .
      949     define buffer buf_temp-gds-list for temp-gds-list .
      950     do
      951     on error undo, return error return-value
      952     :
      953       for each buf_BatchProcess no-lock
      954         where buf_BatchProcess.bp_type       = 'gds':U
      955           and buf_BatchProcess.bp_status     = 'N':U
      956       on error undo, return error return-value
      957       :
      958         create buf_temp-gds-list .
      959         assign
      960           buf_temp-gds-list.action-num = buf_BatchProcess.BatchProcess#
      961           buf_temp-gds-list.gds-code   = buf_BatchProcess.key#_one
      962           buf_temp-gds-list.host-code  = buf_BatchProcess.key#_two
      963           buf_temp-gds-list.obj-type   = buf_BatchProcess.charkey_one
      964           buf_temp-gds-list.obj-code   = buf_BatchProcess.key#_three
      965           buf_temp-gds-list.action     = buf_BatchProcess.bp_execsystime
      966           buf_temp-gds-list.bp_rowid   = rowid(buf_BatchProcess)
      967         .
      968       end.
      969     end.
      970   end procedure.
      971   procedure process-gds-list :
      972     define buffer buf_temp-gds-list for temp-gds-list .
      973     define buffer cli_shops for ub.clients .
      974     define buffer buf_cash-desk for ub.cash-desk .
      975     define variable lns-cnt as integer no-undo .
      976     define variable line-rec as recid no-undo .
      977     define variable v-db-num like ub.db.db-num no-undo .
      978     do
      979     on error undo, return error return-value
      980     :
      981   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      982   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      983     (output v-db-num
      984     )  .
      985       for each buf_temp-gds-list
      986       on error undo, return error return-value
      987       :
      988         find first ub.goods no-lock where
      989                   ub.goods.gds-code = buf_temp-gds-list.gds-code no-error .
      990         if avail ub.goods then do:
      991           if buf_temp-gds-list.obj-type = "":U
      992           AND buf_temp-gds-list.obj-code = 0 then do:
      993   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   find gds-list
      995     where gds-list.prod-type = goods.prod-type
      996       and gds-list.prod-code = goods.prod-code
      997       and gds-list.artic     = goods.artic
      998     no-error .
      999   if available gds-list then do:
     1000     assign
     1001       gds-list.to-del = no
     1002     .
     1003   end.
     1004   else do:
     1005     define variable v-last8 as integer no-undo .
     1006     find last gds-list use-index oi no-error.
     1007     if available gds-list then do:
     1008       v-last8 = gds-list.order-num .
     1009     end.
     1010     else do:
     1011       v-last8 = 0 .
     1012     end.
     1013     create gds-list .
     1014     buffer-copy goods to gds-list
     1015     assign
     1016       gds-list.to-del = no
     1017       gds-list.order-num = v-last8 + 1
     1018     .
     1019     assign
     1020       lns-cnt = lns-cnt + 1
     1021       line-rec = recid (gds-list)
     1022     .
     1023   end.
     1024               assign
     1025               gds-list.to-del = buf_temp-gds-list.action = "D":U
     1026               gds-list.order-num = action-num
     1027               .
     1028           end.
     1029           else do:
     1030             find first gdsolist where
     1031                        gdsolist.gds-code = buf_temp-gds-list.gds-code
     1032                   AND  gdsolist.obj-type = buf_temp-gds-list.obj-type
     1033                   and  gdsolist.obj-code = buf_temp-gds-list.obj-code
     1034                   no-error .
     1035             if not avail gdsolist then do:
     1036               create gdsolist.
     1037               buffer-copy goods to gdsolist
     1038               assign
     1039               gdsolist.to-del = (buf_temp-gds-list.action = "D":U)
     1040               gdsolist.order-num = lns-cnt + 1
     1041               gdsolist.obj-type = buf_temp-gds-list.obj-type
     1042               gdsolist.obj-code = buf_temp-gds-list.obj-code
     1043               .
     1044               assign
     1045               lns-cnt = lns-cnt + 1
     1046               line-rec = recid (gdsolist)
     1047               .
     1048             end.
     1049             else do:
     1050               assign
     1051               gdsolist.to-del = (buf_temp-gds-list.action = "D":U)
     1052               gdsolist.order-num =  buf_temp-gds-list.action-num
     1053               .
     1054             end.
     1055           end.
     1056         end.
     1057       end.
     1058       if (can-find(first gds-list)
     1059           or can-find(first gdsolist) )
     1060       and can-find(first buf_cash-desk where
     1061                         buf_cash-desk.db-num = v-db-num ) then do:
     1062         _cli-shops:
     1063         FOR EACH cli_shops no-lock where
     1064                cli_shops.obj-type = 'маг':U and
     1065                cli_shops.db-num = v-db-num,
     1066                FIRST buf_cash-desk where
     1067                      buf_cash-desk.obj-code = cli_shops.obj-code:
     1068          for each gdsolist no-lock where
     1069                   gdsolist.obj-type = 'маг':U and
     1070                   gdsolist.obj-code = cli_shops.obj-code:
     1071             find first gds-list where
     1072                        gds-list.gds-code = gdsolist.gds-code no-error .
     1073             if avail gds-list
     1074             and gds-list.order-num > gdsolist.order-num then NEXT.
     1075             if not avail gds-list then do:
     1076               find first goods no-lock where
     1077                          goods.gds-code = gdsolist.gds-code no-error .
     1078               if available goods then do:
     1079   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   find gds-list
     1081     where gds-list.prod-type = goods.prod-type
     1082       and gds-list.prod-code = goods.prod-code
     1083       and gds-list.artic     = goods.artic
     1084     no-error .
     1085   if available gds-list then do:
     1086     assign
     1087       gds-list.to-del = no
     1088     .
     1089   end.
     1090   else do:
     1091     define variable v-last9 as integer no-undo .
     1092     find last gds-list use-index oi no-error.
     1093     if available gds-list then do:
     1094       v-last9 = gds-list.order-num .
     1095     end.
     1096     else do:
     1097       v-last9 = 0 .
     1098     end.
     1099     create gds-list .
     1100     buffer-copy goods to gds-list
     1101     assign
     1102       gds-list.to-del = no
     1103       gds-list.order-num = v-last9 + 1
     1104     .
     1105     assign
     1106       lns-cnt = lns-cnt + 1
     1107       line-rec = recid (gds-list)
     1108     .
     1109   end.
     1110               end.
     1111             end.
     1112             if avail gds-list then
     1113             assign
     1114             gds-list.order-num = gdsolist.order-num
     1115             gds-list.qnty = -1
     1116             .
     1117          END.
     1118         run get-stop-state in p-log-handle (output v-stop).
     1119         if v-stop then do:
     1120           run write-log-and-file in p-log-handle (
     1121                 input 1
     1122               , input log-file-name
     1123               , input 1
     1124               , input substitute("!!!Процедура пересылки остановлена пользователем"
     1125                                   )
     1126                                     ).
     1127           leave _cli-shops.
     1128         end.
     1129         run str/send-gds.p (
     1130                         input parparentproc
     1131                        ,input this-procedure
     1132                        ,input p-log-handle
     1133                        ,input (string(cli_shops.obj-code) + chr(4) + "yes":U)
     1134                        ) no-error .
     1135         if error-status:error then do:
     1136             run set-view-log in p-log-handle(yes).
     1137         end.
     1138       end.
     1139     end.
     1140     end.
     1141   end procedure.
     1142   procedure close-gds-list :
     1143     define buffer buf_batchprocess for ub.batchprocess .
     1144     define buffer buf_temp-gds-list for temp-gds-list .
     1145     do
     1146     on error undo, return error return-value
     1147     :
     1148       for each buf_temp-gds-list
     1149       on error undo, return error return-value
     1150       :
     1151         do transaction
     1152         on error undo, return error return-value
     1153         :
     1154     find first buf_batchprocess exclusive-lock
     1155       where rowid(buf_batchprocess) = buf_temp-gds-list.bp_rowid
     1156       no-error .
     1157     if not available buf_batchprocess then do:
     1158       message
     1159         vss-workfile vss-revision vss-description skip
     1160         "Не найдена запись пересчета архива" skip
     1161         view-as alert-box error .
     1162       undo, return error .
     1163     end.
     1164     if buf_batchprocess.bp_status <> 'N':U then do:
     1165       message
     1166         vss-workfile vss-revision vss-description skip
     1167         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
     1168         "BP_Type"       buf_batchprocess.BP_Type       skip
     1169         "BP_Status"     buf_batchprocess.BP_Status     skip
     1170         "Key#_One"      buf_batchprocess.Key#_One      skip
     1171         "Key#_Two"      buf_batchprocess.Key#_Two      skip
     1172         "Key#_Three"    buf_batchprocess.Key#_Three    skip
     1173         "CharKey_One"   buf_batchprocess.CharKey_One   skip
     1174         "CharKey_Two"   buf_batchprocess.CharKey_Two   skip
     1175         "CharKey_Three" buf_batchprocess.CharKey_Three skip
     1176         view-as alert-box error .
     1177       undo, return error .
     1178     end.
     1179       define variable v-btpr_upd-today-10 as date      no-undo.
     1180     define variable v-btpr_upd-time-10  as integer   no-undo.
     1181     run cur-time in this-procedure ( output v-btpr_upd-today-10
     1182                                    , output v-btpr_upd-time-10
     1183                                    ).
     1184     assign
     1185       buf_batchprocess.bp_status         = 'D':U
     1186       buf_batchprocess.bp_execcounttries = buf_batchprocess.bp_execcounttries + 1
     1187       buf_batchprocess.bp_execuser_id    = g#userid
     1188       buf_batchprocess.bp_execsysdate    = v-btpr_upd-today-10
     1189       buf_batchprocess.bp_execsystime    = string(v-btpr_upd-time-10, 'hh:mm')
     1190       buf_batchprocess.bp_execsystimeint = v-btpr_upd-time-10
     1191     .
     1192         end.
     1193       end.
     1194     end.
     1195   end procedure.
