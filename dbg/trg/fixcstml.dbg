        1   block-level on error undo, throw.
        2   define input parameter p-forced as logical no-undo .
        3   define input parameter p-read-only as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Утилита импорта конфигурации настраиваемых полей".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure check-cl-version :
       81   define output parameter p-check as logical no-undo .
       82   define variable v-dopi1 as integer no-undo .
       83   define variable v-dopi2 as integer no-undo .
       84   define variable v-dopi3 as integer no-undo .
       85   define variable v-dopi4 as integer no-undo .
       86   define buffer buf_custom-labels for ub.custom-labels .
       87     do
       88     on error undo, return error
       89     :
       90       find first buf_custom-labels no-lock where
       91                 buf_custom-labels.tbl-name = '':U
       92             and buf_custom-labels.fld-name = '':U
       93             and buf_custom-labels.call-type = '':U
       94             and buf_custom-labels.call-point = '':U  no-error.
       95       if (not available buf_custom-labels
       96       or buf_custom-labels.custom-tooltip <> "v15_1.12" )
       97       then do:
       98         assign
       99         v-dopi1 = integer(entry(2, buf_custom-labels.custom-tooltip, "."))
      100         v-dopi2 = integer(entry(2, "v15_1.12", "."))
      101         v-dopi3 = integer(entry(2, entry(1, buf_custom-labels.custom-tooltip, "."), "_"))
      102         v-dopi4 = integer(entry(2, entry(1, "v15_1.12", "."), "_"))
      103         no-error .
      104         if error-status:error
      105         or v-dopi2 > v-dopi1
      106         or v-dopi4 > v-dopi3
      107         or left-trim(entry(1, buf_custom-labels.custom-tooltip, "."), "v":U) < "15"
      108         then do:
      109           assign
      110           p-check = yes.
      111         end.
      112       end.
      113     end.
      114   end procedure.
      115   procedure get-cl-version :
      116   define output parameter p-cl-version as character no-undo init ?.
      117   define buffer buf_custom-labels for ub.custom-labels .
      118   do
      119   on error undo, return error
      120   :
      121     find first buf_custom-labels no-lock where
      122               buf_custom-labels.tbl-name = '':U
      123           and buf_custom-labels.fld-name = '':U
      124           and buf_custom-labels.call-type = '':U
      125           and buf_custom-labels.call-point = '':U  no-error.
      126     if available buf_custom-labels then do:
      127         p-cl-version = buf_custom-labels.custom-tooltip.
      128     end.
      129   end.
      130   end procedure.
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define variable v-waitfram-action01         as character   no-undo .
      133   define variable v-waitfram-action02         as character   no-undo .
      134   define variable v-waitfram-action03         as character   no-undo .
      135   define variable mWaitFramTextBeg            as character   no-undo.
      136   define variable mWaitFramTextEnd            as character   no-undo.
      137   define variable mWaitFramView               as logical     no-undo.
      138   define variable mWaitProcEvent              as logical     no-undo init yes.
      139   define variable mWaitFramInterval           as integer     no-undo init 1 .
      140   define variable mWaitFramStop               as logical     no-undo.
      141   define variable mWaitFramStopUser           as logical     no-undo.
      142   define variable mWaitFramStopTimeOut        as logical     no-undo.
      143   define variable mWaitFramStartProc          as datetime-tz no-undo.
      144   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      145   define button B-WaitFramStop auto-end-key
      146        label "Стоп"
      147        size 10 by 1 tooltip "Остоновить процесс".
      148   define button B-viewProcInfo
      149        label "Информация"
      150        size 15 by 1 tooltip "Информация о процесс".
      151   define frame waitfram
      152     v-waitfram-action01 format "x(72)" no-label skip
      153     v-waitfram-action02 format "x(72)" no-label skip
      154     v-waitfram-action03 format "x(72)" no-label skip
      155     B-viewProcInfo
      156     B-WaitFramStop at row 4 col 30
      157     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      158     .
      159   define new global shared variable mBatchMode as logical no-undo init ?.
      160   define variable mFramBachModHandle as handle no-undo.
      161   mFramBachModHandle = frame waitfram:handle.
      162   define variable mFameOldVis as logical no-undo.
      163   define variable mVisCUrentVin as logical no-undo.
      164   if session:batch-mode
      165   then
      166      mBatchMode = yes.
      167   if mBatchMode = ? then do:
      168     mVisCUrentVin = current-window:visible.
      169     mFameOldVis = mFramBachModHandle:visible.
      170     mFramBachModHandle:visible  = yes.
      171     mBatchMode = mFramBachModHandle:visible ne yes.
      172     mFramBachModHandle:visible = mFameOldVis.
      173     current-window:visible = mVisCUrentVin.
      174   end.
      175    if  log-manager:logfile-name ne ?
      176     then DO:
      177         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      178         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      179         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      180     end.
      181   on choose of B-WaitFramStop in frame waitfram
      182   do:
      183     mWaitFramStop = yes.
      184     mWaitFramStopUser = yes.
      185   end.
      186   function waitfram-check-timeout returns logical():
      187      define variable vtime as int64 no-undo.
      188      if mWaitFramStopTimeOut
      189      then
      190         return yes.
      191      vtime = ( now - mWaitFramStartProc ) / 1000 .
      192      if     mWaitFramTimeOut ne ?
      193         and mWaitFramTimeOut ne 0
      194         and mWaitFramTimeOut lt vtime
      195      then do:
      196         mWaitFramStopTimeOut = yes.
      197      end.
      198      return mWaitFramStopTimeOut.
      199   end.
      200   procedure waitfram-hide :
      201     if not session:batch-mode
      202     then do
      203     on error undo, return error return-value
      204     :
      205       pause 0 before-hide .
      206       if not mBatchMode then
      207         hide frame waitfram .
      208     if     not mWaitFramView
      209        and mWaitProcEvent
      210     then
      211       process events .
      212     end.
      213   end procedure.
      214   procedure waitfram-show :
      215     define input  parameter p-message as character no-undo .
      216     define variable v-left-margin as integer   no-undo .
      217     if not session:batch-mode
      218     then do
      219     on error undo, return error return-value
      220     :
      221       if length(p-message) <= 70 then do:
      222         assign
      223           v-left-margin = integer((70 - length(p-message)) / 2)
      224         .
      225         assign
      226           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      227         .
      228         assign
      229           v-waitfram-action01 = " "
      230           v-waitfram-action02 = " "
      231                                    + fill(" ", v-left-margin)
      232                                    + p-message
      233           v-waitfram-action03 = " "
      234         .
      235       end.
      236       else do:
      237         define variable vRindex1 as integer no-undo.
      238         define variable vRindex2 as integer no-undo.
      239         vRindex1 = r-index(p-message," ",70).
      240         if vRindex1 = 0
      241         then
      242            vRindex1 = 70.
      243         if length(p-message)  <= vRindex1 + 70 then do:
      244           assign
      245             v-waitfram-action01 = " "
      246             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      247             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      248           .
      249         end.
      250         else do:
      251           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      252           if vRindex2 <= vRindex1
      253           then
      254              vRindex2 = vRindex1 + 70.
      255           assign
      256             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      257             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      258             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      259           .
      260         end.
      261       end.
      262       B-viewProcInfo:visible   in frame waitfram = no.
      263       B-viewProcInfo:sensitive in frame waitfram = no.
      264       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      265       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      266       if  (   mWaitFramView
      267          or  mWaitProcEvent)
      268          and not mBatchMode
      269       then
      270          display
      271             v-waitfram-action01 skip
      272             v-waitfram-action02 skip
      273             v-waitfram-action03 skip
      274          with frame waitfram .
      275       if     mWaitFramView
      276          then do:
      277             if     mWaitFramInterval ne ?
      278                and not mBatchMode
      279             then
      280                wait-for go of frame waitfram pause mWaitFramInterval.
      281          end.
      282          else
      283             if     mWaitProcEvent
      284                and not mBatchMode
      285             then
      286                process events .
      287     end.
      288   end procedure.
      289      procedure waitfram-show-this:
      290         define input  parameter iInterval as int64 no-undo.
      291         define variable vtime as int64 no-undo.
      292         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      293         mWaitFramInterval = iInterval.
      294         run waitfram-show (substitute("&1&2 &3&4" ,
      295                                       mWaitFramTextBeg ,
      296                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      297                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      298                                       mWaitFramTextEnd
      299                                      )
      300                           ).
      301      end.
      302      procedure WaitFramRunPause:
      303         define input  parameter iInterval as dec no-undo.
      304         define variable vStart  as datetime-tz no-undo.
      305         define variable vend    as datetime-tz no-undo.
      306         define variable vint as int64 no-undo.
      307         define variable vOk as logical no-undo.
      308         vStart = now.
      309         vend   = vStart.
      310         publish "WaitFramPause" (iInterval,output vOk).
      311         vend   =  now.
      312         vint = vend - vStart.
      313         vint = iInterval - vint / 1000.
      314         if     not mWaitFramStop
      315            and (   vint > 0
      316                 or (    not vOk
      317                     and iInterval eq ?
      318                     )
      319                 )
      320         then
      321            run waitfram-show-this (iInterval).
      322         vend   =  now.
      323         vint = vend - vStart.
      324         vint = iInterval - vint / 1000.
      325         if     not mWaitFramStop
      326            and vint > 0
      327         then do:
      328            run gbl/pause.p (vint * 1000).
      329         end.
      330         if iInterval ne ?
      331         then
      332            publish "WaitFramStop".
      333         waitfram-check-timeout().
      334      end.
      335      procedure WaitFramWaitFor:
      336         define input  parameter iInterval as dec no-undo.
      337         assign
      338            mWaitFramStartProc   = now
      339            mWaitFramStopUser    = no
      340            mWaitFramStopTimeOut = no
      341         .
      342         block-wait:
      343         do while not mWaitFramStop:
      344            run WaitFramRunPause (iInterval).
      345            if  waitfram-check-timeout()
      346            then do:
      347               leave block-wait.
      348            end.
      349         end.
      350         run waitfram-hide.
      351      end.
      352   procedure waitfram-join :
      353     define input  parameter p-line-1  as character no-undo .
      354     define input  parameter p-line-2  as character no-undo .
      355     define input  parameter p-line-3  as character no-undo .
      356     define output parameter p-message as character no-undo .
      357     do
      358     on error undo, return error return-value
      359     :
      360       assign
      361         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      362                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      363                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      364       .
      365     end.
      366   end procedure.
      367   function waitfram-join-function returns character
      368     (input p-line-1 as character
      369     ,input p-line-2 as character
      370     ,input p-line-3 as character
      371     ).
      372     define variable v-message as character no-undo .
      373     run waitfram-join in this-procedure
      374       (input  p-line-1
      375       ,input  p-line-2
      376       ,input  p-line-3
      377       ,output v-message
      378       ) .
      379     return v-message .
      380   end function .
      381   define stream imp-stream.
      382   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   define new shared temp-table temp-tables no-undo
      384   field tbl-name as character
      385   field buf-handle as handle
      386   field tbl-handle as handle
      387   index pi is unique primary
      388   tbl-name.
      389   define new shared temp-table temp-command no-undo
      390   field command-name as character
      391   field tbl-name as character
      392   field uniq-key-rec as character
      393   index pi is unique primary
      394   tbl-name
      395   command-name
      396   uniq-key-rec
      397   index icommand
      398   command-name
      399   tbl-name
      400   uniq-key-rec
      401   .
      402   define buffer buf_temp-tables for temp-tables.
      403   define variable v-check as logical no-undo .
      404   define variable v-force as logical no-undo .
      405   define variable v-mes   as character no-undo .
      406   define variable v-full-path        as character no-undo .
      407   define variable v-path             as character no-undo .
      408   define variable v-file-name        as character no-undo .
      409   define variable v-file-name-no-ext as character no-undo .
      410   define variable v-file-name-ext    as character no-undo .
      411   define variable v-md5-signature as character no-undo .
      412   define new shared temp-table tt-custom-labels no-undo like ub.custom-labels . find first buf_temp-tables where buf_temp-tables.tbl-name = "custom-labels" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "custom-labels"    buf_temp-tables.buf-handle = buffer tt-custom-labels:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
      413   define buffer buf_tt-custom-labels for tt-custom-labels.
      414   run waitfram-show in this-procedure ("Реинициализация конфигурации настраиваемых полей").
      415   main-block:
      416   do
      417   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      418   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      419   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      420   :
      421     if ( g#db-num > 0 ) then return.
      422     if not p-forced then do:
      423       run check-cl-version in this-procedure (output v-check).
      424     end.
      425     if v-check
      426     or p-forced
      427     then do:
      428       if v-check
      429       and p-read-only then do:
      430         return error substitute("&1 &2 &3&4До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!"
      431                                 ,vss-workfile
      432                                 ,vss-revision
      433                                 ,vss-description
      434                                 ,chr(10)).
      435       end.
      436       run gbl/md5.p (
      437          input  "cmp/fixcstml.txt"
      438         ,output v-md5-signature
      439         ) .
      440       if v-md5-signature <> "8B651E72326B3B3DCED41CB93B3AF2D5" then do:
      441         message
      442         substitute("Несовпадение файла эталонных записей по настраиваемым полям (fixcstml.txt) с контрольным числом")
      443         view-as alert-box error .
      444         undo, return error .
      445       end.
      446       run gbl/filename.p ( input "cmp/fixcstml.txt"
      447                           ,output v-full-path
      448                           ,output v-path
      449                           ,output v-file-name
      450                           ,output v-file-name-no-ext
      451                           ,output v-file-name-ext
      452                           ) no-error .
      453       if error-status:error then do:
      454         message
      455         substitute("Не найден файл эталонных записей по настраиваемым полям (fixcstml.txt)")
      456         view-as alert-box error .
      457         undo, return error .
      458       end.
      459       run str/diallog.w (
      460             input ?
      461           ,input this-procedure
      462           ,input ('utl/upgimptt.p' + chr(4)  +
      463                   '1' + chr(4) +
      464                   '1' + chr(4) +
      465                   '1' + chr(4) +
      466                   '1')
      467           ,input v-full-path
      468           ,input yes
      469           ,input 'Прервать'
      470           ,input 'Чтение файла в память') no-error .
      471       if error-status:error then do:
      472         message
      473         substitute("Ошибка при чтении в память файла кофигурации настраиваемых полей (fixcstml.txt)&1&2&1&3"
      474                      , chr(10)
      475                      , error-status:get-message(1)
      476                      , return-value )
      477         view-as alert-box error .
      478         undo, return error .
      479       end.
      480       if v-check
      481       or p-forced
      482       then do:
      483         find first buf_tt-custom-labels no-lock where
      484                   buf_tt-custom-labels.tbl-name = '':U
      485               and buf_tt-custom-labels.fld-name = '':U
      486               and buf_tt-custom-labels.call-type = '':U
      487               and buf_tt-custom-labels.call-point = '':U  no-error.
      488         if not available buf_tt-custom-labels
      489         or buf_tt-custom-labels.custom-tooltip <> "v15_1.12" then do:
      490           message
      491           substitute("Версии конфиг. настраив полей в r-кодах и файле конфигурации (fixcmstl.txt) НЕ СОВПАДАЮТ&1" +
      492                      "в r-кодах - &2&1" +
      493                      "в файле - &3"
      494                      , chr(10)
      495                      , "v15_1.12"
      496                      , buf_tt-custom-labels.custom-tooltip
      497                      )
      498           view-as alert-box error .
      499           undo, return error .
      500         end.
      501       end.
      502       run add-custom-labels in this-procedure no-error .
      503       if error-status:error then do:
      504         run waitfram-hide in this-procedure .
      505         assign
      506         v-mes = substitute("Ошибки при инициализации конфигурации настраиваемых полей:&1&2 &3"
      507                            , chr(10)
      508                            , error-status:get-message(1)
      509                            , return-value ).
      510         if p-forced then do:
      511           message
      512           v-mes
      513           view-as alert-box error .
      514         end.
      515         undo, return error v-mes.
      516       end.
      517     end.
      518     for each buf_temp-tables
      519     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      520     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      521     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      522     :
      523       if valid-handle(buf_temp-tables.tbl-handle) then do:
      524         delete object buf_temp-tables.tbl-handle.
      525        end.
      526     end.
      527   end.
      528   run waitfram-hide in this-procedure .
      529   procedure add-custom-labels :
      530   define variable v-cmp as logical no-undo .
      531   define variable v-error as logical no-undo .
      532   define buffer buf_tt-custom-labels for tt-custom-labels.
      533   define buffer buf2_tt-custom-labels for tt-custom-labels.
      534   define buffer buf_custom-labels for ub.custom-labels.
      535   define buffer buf2_custom-labels for ub.custom-labels.
      536   main-block:
      537   do
      538   on error undo, return error
      539   :
      540     _for:
      541     for each buf_tt-custom-labels
      542     where buf_tt-custom-labels.language > '':U
      543     break
      544     by buf_tt-custom-labels.language
      545     by buf_tt-custom-labels.call-type
      546     by buf_tt-custom-labels.call-point
      547     on error  undo _for, retry _for
      548     on stop   undo _for, retry _for
      549     on endkey undo _for, retry _for
      550     :
      551       if retry then do:
      552         v-error = yes.
      553         leave _for.
      554       end.
      555       if first-of(buf_tt-custom-labels.call-point) then do:
      556         for each buf2_tt-custom-labels where
      557                 buf2_tt-custom-labels.language = buf_tt-custom-labels.language
      558             and buf2_tt-custom-labels.call-type = buf_tt-custom-labels.call-type
      559             and buf2_tt-custom-labels.call-point = buf_tt-custom-labels.call-point
      560         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      561         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      562         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      563         :
      564           find first buf_custom-labels exclusive-lock where
      565                     buf_custom-labels.language = buf2_tt-custom-labels.language
      566                 and buf_custom-labels.call-type = buf2_tt-custom-labels.call-type
      567                 and buf_custom-labels.call-point = buf2_tt-custom-labels.call-point
      568                 and buf_custom-labels.tbl-name = buf2_tt-custom-labels.tbl-name
      569                 and buf_custom-labels.fld-name = buf2_tt-custom-labels.fld-name no-error.
      570           v-cmp = yes.
      571           if not available buf_custom-labels then do:
      572             create buf_custom-labels.
      573             v-cmp = no.
      574           end.
      575           else do:
      576             buffer-compare
      577             buf_custom-labels to buf2_tt-custom-labels
      578             case-sensitive
      579             save result in v-cmp.
      580           end.
      581           if not v-cmp then do:
      582             buffer-copy buf2_tt-custom-labels to buf_custom-labels.
      583           end.
      584         end.
      585       end.
      586     end.
      587     if not v-error  then do:
      588       _for2:
      589       for each buf_custom-labels no-lock
      590       on error  undo _for2, retry _for2
      591       on stop   undo _for2, retry _for2
      592       on endkey undo _for2, retry _for2
      593       :
      594         if retry then do:
      595           v-error = yes.
      596           leave _for2.
      597         end.
      598         find first buf2_tt-custom-labels where
      599                   buf2_tt-custom-labels.language = buf_custom-labels.language
      600               and buf2_tt-custom-labels.call-type = buf_custom-labels.call-type
      601               and buf2_tt-custom-labels.call-point = buf_custom-labels.call-point
      602               and buf2_tt-custom-labels.tbl-name = buf_custom-labels.tbl-name
      603               and buf2_tt-custom-labels.fld-name = buf_custom-labels.fld-name no-error.
      604         if not available buf2_tt-custom-labels then do:
      605           find first buf2_custom-labels exclusive-lock where
      606                     recid(buf2_custom-labels) = recid(buf_custom-labels).
      607           delete buf2_custom-labels.
      608         end.
      609       end.
      610     end.
      611     if not v-error then do:
      612       find first buf_tt-custom-labels where
      613                 buf_tt-custom-labels.language = '':U
      614             and buf_tt-custom-labels.call-type = '':U
      615             and buf_tt-custom-labels.call-point = '':U
      616             and buf_tt-custom-labels.tbl-name = '':U
      617             and buf_tt-custom-labels.fld-name = '':U no-error .
      618       find first buf_custom-labels where
      619                 buf_custom-labels.language = '':U
      620             and buf_custom-labels.call-type = '':U
      621             and buf_custom-labels.call-point = '':U
      622             and buf_custom-labels.tbl-name = '':U
      623             and buf_custom-labels.fld-name = '':U no-error.
      624       if not available buf_custom-labels then do:
      625         create buf_custom-labels.
      626       end.
      627       buffer-copy buf_tt-custom-labels to buf_custom-labels.
      628       release buf_tt-custom-labels no-error .
      629       if error-status:error then do:
      630         return error substitute("Ошибка при обновлении головной записи конфигурации настраиваемых полей &1&2&3"
      631                                 , error-status:get-message(1)
      632                                 , return-value ).
      633       end.
      634     end.
      635     else do:
      636        return error substitute("Ошибка при обновлении конфигурации настраиваемых полей &1&2&3"
      637                                , error-status:get-message(1)
      638                                , return-value ).
      639     end.
      640   end.
      641   end procedure.
