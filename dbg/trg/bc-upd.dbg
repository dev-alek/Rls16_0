      409     on error undo, return error
      410     :
      411           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-code-dt-seasons in g#attr-lib
      412         (input p-code
      413         ,input p-obj-type
      414         ,input p-obj-code
      415         ,output p-gds-code
      416         ,output p-dt-code
      417         ) no-error .
      418       if error-status :error
      419       then do:
      420         undo, return error return-value .
      421       end.
      422     end.
      423   end.
      424   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      425   procedure gen-b-code :
      426     define input  parameter type-code like ub.code-range.range-type no-undo .
      427     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      428     do
      429     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      430     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      431     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      432     :
      433       define buffer buf_thbj-attr     for ub.thbj-attr .
      434       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      435       define buffer buf_code-range for ub.code-range .
      436       define variable l-code         as   integer              no-undo .
      437       define variable v-db-num       like ub.db.db-num         no-undo .
      438       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      439       if type-code = 'sslc':U
      440       or type-code = 'ssgb':U
      441       then do:
      442         message
      443           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      444           "Обратитесь к администратору системы."
      445           view-as alert-box error .
      446         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      447       end.
      448       run trg/getpcode.p ( input  type-code
      449                      ,output cfg-param-code
      450                     ).
      451       run get-next-seq( input  type-code,
      452                         output l-code
      453                       ).
      454       find first buf_sys-ctrl no-lock.
      455       if type-code = 'sclc':U
      456       or type-code = 'pglc':U
      457       then do:
      458         assign
      459           v-db-num = 0
      460         .
      461       end.
      462       else do:
      463         assign
      464           v-db-num = buf_sys-ctrl.db-num
      465         .
      466       end.
      467       find first buf_code-range no-lock
      468         where buf_code-range.db-num     = v-db-num
      469           and buf_code-range.range-type = type-code
      470           and buf_code-range.stts       = "a"
      471         use-index stts
      472         no-error .
      473       if available buf_code-range
      474          and l-code <= buf_code-range.last-code
      475          and l-code >= buf_code-range.first-code then do:
      476         assign
      477           p-b-code = l-code
      478         .
      479       end.
      480       else do:
      481         if available buf_code-range
      482            and l-code < buf_code-range.last-code then do:
      483           message
      484             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      485             "Обратитесь к администратору системы."
      486             view-as alert-box error .
      487           undo, return error "sequence":U .
      488         end.
      489         do transaction
      490         on error undo, return error
      491         :
      492           find first buf_thbj-attr exclusive-lock
      493             where buf_thbj-attr.upper-prop-code = 'code-range':U
      494               and buf_thbj-attr.prop-code = cfg-param-code
      495               and buf_thbj-attr.obj-type   = 'БД':U
      496               and buf_thbj-attr.obj-code   = v-db-num
      497             no-error .
      498           if not available buf_thbj-attr then do:
      499             find first buf_thbj-attr exclusive-lock
      500               where buf_thbj-attr.upper-prop-code = 'code-range':U
      501                 and buf_thbj-attr.prop-code = cfg-param-code
      502                 and buf_thbj-attr.obj-type   = ''
      503                 and buf_thbj-attr.obj-code   = 0
      504               no-error .
      505             if not available buf_thbj-attr then do:
      506               if not locked buf_thbj-attr then do:
      507                 message
      508                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      509                   "Обратитесь к администратору системы."
      510                   view-as alert-box error .
      511               end.
      512               undo, return error "config":U .
      513             end.
      514           end.
      515           run get-next-seq( input type-code,
      516                             output l-code
      517                           ).
      518           find first buf_code-range
      519             where buf_code-range.db-num     = v-db-num
      520               and buf_code-range.range-type = type-code
      521               and buf_code-range.stts       = "a"
      522             use-index stts
      523             no-error .
      524           if available buf_code-range
      525           and l-code <= buf_code-range.last-code
      526           and l-code >= buf_code-range.first-code
      527           then do:
      528             assign
      529               p-b-code = l-code
      530             .
      531           end.
      532           else do:
      533             if available buf_code-range then do:
      534               assign
      535                 buf_code-range.stts = "u"
      536               .
      537             end.
      538             find first buf_code-range
      539               where buf_code-range.db-num     = v-db-num
      540                 and buf_code-range.range-type = type-code
      541                 and buf_code-range.stts       = "f"
      542               use-index stts
      543               no-error .
      544             if not available buf_code-range then do:
      545               message
      546                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      547                 "Обратитесь к администратору системы"
      548                 view-as alert-box error .
      549               undo, return error "code-range":U .
      550             end.
      551             assign
      552               buf_code-range.stts           = "a"
      553             .
      554             if buf_code-range.first-code = 1 then do:
      555               run set-seq-cr( input type-code,
      556                               input buf_code-range.first-code
      557                             ).
      558               assign
      559                 p-b-code = 1
      560               .
      561             end.
      562             else do:
      563               run set-seq-cr( input type-code,
      564                               input ( buf_code-range.first-code - 1 )
      565                             ).
      566               run get-next-seq( input type-code,
      567                                 output p-b-code
      568                               ).
      569             end.
      570           end.
      571         end.
      572       end.
      573     end.
      574   end procedure.
      575   procedure get-next-seq :
      576     define input  parameter type-code like ub.code-range.range-type no-undo .
      577     define output parameter next-seq  as   integer                  no-undo .
      578     do
      579     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      580     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      581     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      582     :
      583       case type-code:
      584         when 'bcgb':U then do:
      585           assign
      586             next-seq = next-value(s-bcgb-code, ub)
      587           .
      588         end.
      589         when 'scgb':U then do:
      590           assign
      591             next-seq = next-value(s-scgb-code, ub)
      592           .
      593         end.
      594         when 'sclc':U then do:
      595           assign
      596             next-seq = next-value(s-sclc-code, ub)
      597           .
      598         end.
      599         when 'pglc':U then do:
      600           assign
      601             next-seq = next-value(s-pglc-code, ub)
      602           .
      603         end.
      604         when 'dcgb':U then do:
      605           assign
      606             next-seq = next-value(s-dcgb-code, ub)
      607           .
      608         end.
      609         when 'ctgb':U then do:
      610           assign
      611             next-seq = next-value(s-ctgb-code, ub)
      612           .
      613         end.
      614         when 'drgb':U then do:
      615           assign
      616             next-seq = next-value(s-drgb-code, ub)
      617           .
      618         end.
      619         when 'fmgb':U then do:
      620           assign
      621             next-seq = next-value(s-fmgb-code, ub)
      622           .
      623         end.
      624         when 'pngb':U then do:
      625           assign
      626             next-seq = next-value(s-pngb-code, ub)
      627           .
      628         end.
      629         when 'cagb':U then do:
      630           assign
      631             next-seq = next-value(s-cagb-code, ub)
      632           .
      633         end.
      634         when 'fdgb':U then do:
      635           assign
      636             next-seq = next-value(s-fin-doc, ub)
      637           .
      638         end.
      639       end case.
      640     end.
      641   end procedure.
      642   procedure set-seq-cr :
      643     define input parameter type-code like ub.code-range.range-type no-undo .
      644     define input parameter set-val   like ub.code-range.first-code no-undo .
      645     do
      646     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      647     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      648     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      649     :
      650       case type-code:
      651         when 'bcgb':U then do:
      652           assign
      653             current-value(s-bcgb-code, ub) = set-val
      654           .
      655         end.
      656         when 'scgb':U then do:
      657           assign
      658             current-value(s-scgb-code, ub) = set-val
      659           .
      660         end.
      661         when 'sclc':U then do:
      662           assign
      663             current-value(s-sclc-code, ub) = set-val
      664           .
      665         end.
      666         when 'pglc':U then do:
      667           assign
      668             current-value(s-pglc-code, ub) = set-val
      669           .
      670         end.
      671         when 'dcgb':U then do:
      672           assign
      673             current-value(s-dcgb-code, ub) = set-val
      674           .
      675         end.
      676         when 'ctgb':U then do:
      677           assign
      678             current-value(s-ctgb-code, ub) = set-val
      679           .
      680         end.
      681         when 'drgb':U then do:
      682           assign
      683             current-value(s-drgb-code, ub) = set-val
      684           .
      685         end.
      686         when 'fmgb':U then do:
      687           assign
      688             current-value(s-fmgb-code, ub) = set-val
      689           .
      690         end.
      691         when 'pngb':U then do:
      692           assign
      693             current-value(s-pngb-code, ub) = set-val
      694           .
      695         end.
      696         when 'cagb':U then do:
      697           assign
      698             current-value(s-cagb-code, ub) = set-val
      699           .
      700         end.
      701         when 'fdgb':U then do:
      702           assign
      703             current-value(s-fin-doc, ub) = set-val
      704           .
      705         end.
      706       end case.
      707     end.
      708   end procedure.
      709   procedure new-bcod-gen-code-range :
      710     do
      711     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      712     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      713     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      714     :
      715       define input parameter p-db-num  like ub.db.db-num             no-undo .
      716       define input parameter type-code like ub.code-range.range-type no-undo .
      717       define buffer buf_code-range      for ub.code-range .
      718       define buffer last_code-range     for ub.code-range .
      719       define buffer last-1_code-range   for ub.code-range .
      720       define buffer last-2_code-range   for ub.code-range .
      721       define buffer last-3_code-range   for ub.code-range .
      722       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      723       define variable conf-par       as character no-undo .
      724       define variable par-type       as character no-undo .
      725       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      726       define variable v-cre-cdrg as logical   no-undo .
      727       define variable v-cre-str  as character no-undo .
      728       define variable v-cr1      as integer no-undo .
      729       define variable v-cr2      as integer no-undo .
      730       define variable v-cr3      as integer no-undo .
      731       define variable v-cmax     as integer no-undo .
      732       find first buf_sys-ctrl no-lock .
      733       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      734         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      735                                       ,vss-workfile
      736                                       ,vss-revision
      737                                       ,vss-description
      738                                       ,chr(10)
      739                                       , p-db-num
      740                                      ).
      741       end.
      742       run trg/getpcode.p ( input  type-code
      743                      ,output cfg-param-code
      744                     ).
      745       for each buf_code-range
      746         where buf_code-range.db-num     = -1
      747           and buf_code-range.range-type = type-code
      748           and buf_code-range.stts       = "f"
      749       by buf_code-range.first-code
      750       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      751       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      752       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      753       :
      754         assign
      755           buf_code-range.db-num = p-db-num
      756         .
      757         return .
      758       end.
      759       assign
      760         v-cre-cdrg = TRUE
      761       .
      762       case type-code:
      763         when 'sclc':U
      764         or when 'scgb':U
      765         or when 'pglc':U
      766         then do:
      767           find last last-1_code-range no-lock
      768             where last-1_code-range.range-type = 'sclc':U
      769             no-error .
      770           if available last-1_code-range then do:
      771             v-cr1 = last-1_code-range.last-code.
      772           end.
      773           find last last-2_code-range no-lock
      774             where last-2_code-range.range-type = 'scgb':U
      775             no-error .
      776           if available last-2_code-range then do:
      777             v-cr2 = last-2_code-range.last-code.
      778             end.
      779           find last last-3_code-range no-lock
      780             where last-3_code-range.range-type = 'pglc':U
      781             no-error .
      782           if available last-3_code-range then do:
      783             v-cr3 = last-3_code-range.last-code.
      784           end.
      785           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      786           .
      787           if v-cmax = v-cr1  then do:
      788               find last last_code-range no-lock
      789                 where recid( last_code-range ) = recid( last-1_code-range )
      790                 .
      791             end.
      792           if v-cmax = v-cr2  then do:
      793               find last last_code-range no-lock
      794                 where recid( last_code-range ) = recid( last-2_code-range )
      795                 .
      796             end.
      797           if v-cmax = v-cr3  then do:
      798             find last last_code-range no-lock
      799               where recid( last_code-range ) = recid( last-3_code-range )
      800               .
      801           end.
      802           if last_code-range.last-code + 1 > 99999 then do:
      803             assign
      804               v-cre-cdrg = FALSE
      805             .
      806           end.
      807         end.
      808         when 'bcgb':U
      809         or when 'sslc':U
      810         or when 'ssgb':U
      811         then do:
      812           find last last-1_code-range no-lock
      813             where last-1_code-range.range-type = 'sslc':U
      814             no-error .
      815           if available last-1_code-range then do:
      816             v-cr1 = last-1_code-range.last-code.
      817           end.
      818           find last last-2_code-range no-lock
      819             where last-2_code-range.range-type = 'bcgb':U
      820             no-error .
      821           if available last-2_code-range then do:
      822             v-cr2 = last-2_code-range.last-code.
      823             end.
      824           find last last-3_code-range no-lock
      825             where last-3_code-range.range-type = 'ssgb':U
      826             no-error .
      827           if available last-3_code-range then do:
      828             v-cr3 = last-3_code-range.last-code.
      829           end.
      830           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      831           .
      832           if v-cmax = v-cr1  then do:
      833               find last last_code-range no-lock
      834                 where recid( last_code-range ) = recid( last-1_code-range )
      835                 .
      836             end.
      837           if v-cmax = v-cr2  then do:
      838               find last last_code-range no-lock
      839                 where recid( last_code-range ) = recid( last-2_code-range )
      840                 .
      841             end.
      842           if v-cmax = v-cr3  then do:
      843             find last last_code-range no-lock
      844               where recid( last_code-range ) = recid( last-3_code-range )
      845               .
      846           end.
      847         end.
      848         otherwise do:
      849           find last last_code-range no-lock
      850             where last_code-range.range-type = type-code
      851             no-error .
      852         end.
      853       end case.
      854       if not available last_code-range then do:
      855         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      856                                       ,vss-workfile
      857                                       ,vss-revision
      858                                       ,vss-description
      859                                       , chr(10)
      860                                       , type-code
      861                                      ) .
      862       end.
      863       define variable v-mes1 as character no-undo .
      864       define variable v-param-type1 as character no-undo .
      865       define variable v-value-character1 as INTEGER no-undo .
      866       define variable v-value-date1 as date no-undo .
      867       define variable v-value-decimal1 as decimal no-undo .
      868       define variable v-value-integer1 AS integer no-undo .
      869       define variable v-value-logical1 AS LOGICAL no-undo .
      870       define variable v-tth1 as handle no-undo .
      871       run adm/shattri.p (
      872           input "get":U
      873           ,input  'БД':U
      874           ,input  p-db-num
      875           ,input  'code-range':U
      876           ,input  cfg-param-code
      877           ,output v-value-character1
      878           ,output v-value-date1
      879           ,output v-value-decimal1
      880           ,output v-value-integer1
      881           ,output v-value-logical1
      882           ,output v-param-type1
      883           ,INPUT-OUTPUT table-handle v-tth1
      884           ) no-error .
      885       if error-status :error then do:
      886         delete object v-tth1.
      887         v-mes1 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      888                            , error-status:get-message(1)
      889                            , chr(10)
      890                            , return-value ).
      891         undo, return error v-mes1.
      892       end.
      893       delete object v-tth1.
      894       if v-cre-cdrg = TRUE then do:
      895         create buf_code-range .
      896         assign
      897           buf_code-range.db-num     = p-db-num
      898           buf_code-range.range-type = type-code
      899           buf_code-range.stts       = "f"
      900           buf_code-range.first-code = last_code-range.last-code + 1
      901           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer1)
      902           v-cre-str = "Свободный диапазон успешно создан"
      903         .
      904       end.
      905       else do:
      906         assign
      907           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      908                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      909         .
      910       end.
      911     end.
      912     return v-cre-str .
      913   end procedure.
      914   procedure gen-new-code-range-if-neces :
      915     define input parameter v-db-num           like ub.db.db-num             no-undo .
      916     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      917     define input parameter v-cur-code         as   integer                  no-undo .
      918     define input parameter v-g#news           as   logical                  no-undo .
      919     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      920     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      921     do
      922     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      923     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      924     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      925     :
      926       define variable l-code-range-exist as logical   no-undo init false .
      927       define variable v-db-for-send      as character no-undo .
      928       define buffer buf_code-range  for ub.code-range .
      929       define buffer buf1_code-range for ub.code-range .
      930       define buffer buf_db          for ub.db .
      931       find first buf_code-range
      932         where buf_code-range.range-type = v-range-type
      933           and buf_code-range.last-code >= v-cur-code
      934         use-index last-codei
      935         no-error .
      936       if
      937       (
      938          available buf_code-range
      939          and
      940         (buf_code-range.db-num = v-db-num
      941           and
      942         buf_code-range.first-code <= v-cur-code
      943         )
      944       or
      945         (
      946           v-range-type = 'drgb':U
      947           AND
      948           v-cur-code = 0
      949         )
      950      )
      951      then do:
      952         assign
      953           l-code-range-exist = true
      954         .
      955         if v-g#news
      956         and buf_code-range.stts = "f" then do:
      957           assign
      958             buf_code-range.stts = "u"
      959           .
      960         end.
      961       end.
      962       if not l-code-range-exist
      963          and v-g#news-source-db <> 0
      964       then do:
      965         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      966                                       ,vss-workfile
      967                                       ,vss-revision
      968                                       ,vss-description
      969                                       ,chr(10)
      970                                       ,v-db-num
      971                                       ,v-range-type
      972                                       ,v-cur-code
      973                                      ).
      974       end.
      975       if (not l-code-range-exist
      976           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      977          )
      978       and ( not can-find (first buf1_code-range no-lock
      979                           where buf1_code-range.db-num = v-db-num
      980                             and buf1_code-range.range-type = v-range-type
      981                             and buf1_code-range.stts = "f"
      982                          )
      983           )
      984       then do:
      985         if v-g#db-num = 0 then do:
      986           run new-bcod-gen-code-range in this-procedure
      987             (input v-db-num,
      988              input v-range-type
      989             ) no-error .
      990           if error-status :error then do:
      991             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      992                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      993                                           ,v-db-num
      994                                           ,v-range-type
      995                                           ,v-cur-code
      996                                           ,chr(10)
      997                                           ,error-status:get-message(1)
      998                                           ,return-value
      999                                          ).
     1000           end.
     1001         end.
     1002         else do:
     1003           if v-range-type = 'sclc':U
     1004           or v-range-type = 'pglc':U
     1005           then do:
     1006             assign
     1007               v-db-for-send = "":U
     1008             .
     1009             if v-g#db-num = 0 then do:
     1010               for each buf_db no-lock
     1011                 where buf_db.db-num > 0
     1012                   and buf_db.db-num <> v-g#news-source-db
     1013               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1014               :
     1015                 assign
     1016                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1017                 .
     1018               end.
     1019               assign
     1020                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1021               .
     1022             end.
     1023             else do:
     1024               if not v-g#news then do:
     1025                 assign
     1026                   v-db-for-send = "0":U
     1027                 .
     1028               end.
     1029             end.
     1030             run nws/cr-route.p ( input 'send-cmd':U
     1031                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1032                                  "code-range":U + chr(1) +
     1033                                  (if v-range-type = 'sclc':U
     1034                                   then string( current-value(s-sclc-code, ub))
     1035                                   else string( current-value(s-pglc-code, ub))
     1036                                   ) + chr(1) +
     1037                                   v-range-type)
     1038                           ,input ?
     1039                           ,input v-db-for-send
     1040                           ) no-error .
     1041             if error-status :error then do:
     1042               undo, return error return-value.
     1043             end.
     1044           end.
     1045         end.
     1046       end.
     1047     end.
     1048   end procedure.
     1049   procedure cre-loc-sc-code-range :
     1050     define input parameter v-cur-code as integer no-undo .
     1051   define input parameter p-cdrg-type as character no-undo .
     1052     do
     1053     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1054     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1055     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1056     :
     1057       define buffer buf_code-range for ub.code-range .
     1058       find first buf_code-range
     1059            where buf_code-range.range-type = p-cdrg-type
     1060              and buf_code-range.first-code >= v-cur-code
     1061            no-error .
     1062       if not available buf_code-range then do:
     1063         run new-bcod-gen-code-range in this-procedure
     1064           ( input 0,
     1065             input p-cdrg-type
     1066           ) no-error .
     1067         if error-status :error then do:
     1068           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1069                                          + "Код &2&1&3 &4"
     1070                                         , chr(10)
     1071                                         , v-cur-code
     1072                                         , error-status:get-message(1)
     1073                                         , return-value
     1074                                        ) .
     1075         end.
     1076       end.
     1077     end.
     1078   end procedure.
     1079   procedure mark-used-if-need :
     1080   define input parameter p-cur-code as integer no-undo .
     1081   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1082   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1083     do
     1084     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1085     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1086     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1087     :
     1088       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1089       define buffer buf_code-range for ub.code-range .
     1090       assign
     1091       v-db-num = if p-range-type = 'sclc':U
     1092                  then 0
     1093                  else p-db-num
     1094       .
     1095   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   define buffer locK-batchprocess2 for ub.batchprocess.
     1097   run gbl/lock-prc.p
     1098       (input 'lscc':U
     1099       ,input 0
     1100       ,input 0
     1101       ,input 0
     1102       ,input ""
     1103       ,input ""
     1104       ,input ""
     1105       ,input (
     1106               ",,,Вкл/выкл лок. вес. кодов"
     1107              )
     1108       ,input true
     1109       ,buffer lock-batchprocess2
     1110       ) no-error .
     1111     if error-status :error then do:
     1112       message
     1113         vss-workfile vss-revision vss-description skip
     1114         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1115         view-as alert-box error .
     1116       undo, return error .
     1117     end.
     1118       find first buf_code-range
     1119            where buf_code-range.range-type = p-range-type
     1120              and buf_code-range.first-code >= p-cur-code
     1121              and buf_code-range.last-code <= p-cur-code
     1122              and buf_code-range.db-num = v-db-num
     1123            no-error .
     1124       if not available buf_code-range then do:
     1125         message
     1126           vss-workfile vss-revision vss-description skip
     1127           "Ошибка при создании поиске диапазона" skip
     1128           "База данных" p-db-num skip
     1129           "Код" p-cur-code skip
     1130           "Тип" p-range-type
     1131           error-status :get-message(1) skip
     1132           return-value skip
     1133           view-as alert-box error .
     1134         undo, return error .
     1135       end.
     1136       if buf_code-range.stts = "f":U then do:
     1137         assign
     1138         buf_code-range.stts = "u":U
     1139         .
     1140       end.
     1141     end.
     1142   end procedure.
