     1775   procedure do-on :
     1776   define input parameter p-rec as recid no-undo.
     1777   define buffer buf-on_prod-bc for ub.prod-bc.
     1778     do
     1779     on error undo, return error
     1780     :
     1781       find first buf-on_prod-bc exclusive-lock where
     1782                   recid(buf-on_prod-bc) = p-rec.
     1783       assign
     1784       buf-on_prod-bc.bc-on = yes
     1785       .
     1786       release buf-on_prod-bc.
     1787     end.
     1788   end procedure.
     1789   procedure do-off :
     1790   define input parameter p-rec as recid no-undo.
     1791   define buffer buf-off_prod-bc for ub.prod-bc.
     1792     do
     1793     on error undo, return error
     1794     :
     1795       find first buf-off_prod-bc exclusive-lock where
     1796                   recid(buf-off_prod-bc) = p-rec.
     1797       assign
     1798       buf-off_prod-bc.bc-on = no
     1799       .
     1800       release buf-off_prod-bc.
     1801     end.
     1802   end procedure.
     1803   procedure err-msg :
     1804   define input parameter p-msg as character no-undo .
     1805   define input parameter p-msg-type as character no-undo .
     1806     do
     1807     on error undo, return error
     1808     :
     1809       if not p-mute then do:
     1810         case p-msg-type:
     1811           when "error" then do:
     1812         message
     1813         p-msg
     1814         view-as alert-box error .
     1815       end.
     1816           when "warning" then do:
     1817             message
     1818             p-msg
     1819             view-as alert-box warning.
     1820           end.
     1821           otherwise do:
     1822             message
     1823             p-msg
     1824             view-as alert-box .
     1825           end.
     1826         end case.
     1827       end.
     1828       if valid-handle (p-write-proc-handle) then do:
     1829         run write-file in p-write-proc-handle ( input p-msg) .
     1830       end.
     1831     end.
     1832   end procedure.
