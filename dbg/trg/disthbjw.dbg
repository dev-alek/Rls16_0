        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.dis-thbj-rule old old_dis-thbj-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись скидок по объектам".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6'
       29                           ,  ub.dis-thbj-rule.host-code
       30                           ,  ub.dis-thbj-rule.obj-type
       31                           ,  ub.dis-thbj-rule.obj-code
       32                           ,  ub.dis-thbj-rule.pos-type
       33                           ,  ub.dis-thbj-rule.discnt-role
       34                           ,  ub.dis-thbj-rule.nonunique
       35                           )
       36       .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure cur-time :
       90      define output parameter p-today as date      no-undo .
       91      define output parameter p-time  as integer   no-undo .
       92     do
       93     on error undo, return error
       94     :
       95       define variable v-date1 as date      no-undo .
       96       define variable v-date2 as date      no-undo .
       97       define variable v-time  as integer   no-undo .
       98       assign
       99         v-date1 = today
      100         v-time  = time
      101         v-date2 = today
      102       .
      103       if v-date1 <> v-date2
      104       then do:
      105         assign
      106           v-date1 = today
      107           v-time  = v-time
      108         .
      109       end.
      110       assign
      111         p-today = v-date1
      112         p-time  = v-time
      113       .
      114     end.
      115   end.
      116   function cur-time-date returns character
      117   :
      118     return string(today, '99/99/9999':U) .
      119   end.
      120   function cur-time-mjd returns decimal
      121   :
      122     define variable v-date as date      no-undo .
      123     define variable v-time as integer   no-undo .
      124     run cur-time in this-procedure
      125       (output v-date
      126       ,output v-time
      127       ) .
      128     return integer(v-date) - 2400002 + (v-time / 86400) .
      129   end.
      130   function cur-time-get-ending-index returns integer
      131   (input p-number as integer
      132   )
      133   :
      134     if p-number < 0
      135     or p-number = ?
      136     then do:
      137       return 1 .
      138     end.
      139     define variable v-rest as integer   no-undo .
      140     assign
      141       p-number = p-number modulo 100
      142     .
      143     if p-number < 20
      144     then do:
      145       assign
      146         v-rest = p-number
      147       .
      148     end.
      149     else do:
      150       assign
      151         v-rest = p-number modulo 10
      152       .
      153     end.
      154     case v-rest :
      155       when 1
      156       then do:
      157         return 2 .
      158       end.
      159       when 2 or
      160       when 3 or
      161       when 4
      162       then do:
      163         return 3 .
      164       end.
      165       otherwise do:
      166         return 1 .
      167       end.
      168     end case .
      169   end.
      170   procedure cur-time-mjd-to-date :
      171      define input  parameter i-mjd-diff as decimal no-undo.
      172      define output parameter o-Date     as date    no-undo.
      173      define output parameter o-Time     as integer no-undo.
      174      define variable v-day-number as integer   no-undo .
      175      if    i-mjd-diff < 0
      176         or i-mjd-diff = ?
      177      then do:
      178         return "?" .
      179      end.
      180      assign
      181         v-day-number = truncate(i-mjd-diff,0).
      182         o-Date = date(v-day-number + 2400002).
      183         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185   end.
      186   function cur-time-mjd-to-string returns character
      187   (input p-mjd-diff as decimal
      188   )
      189   :
      190     define variable v-day-number as integer   no-undo .
      191     define variable v-seconds    as integer   no-undo .
      192     define variable v-hour       as integer   no-undo .
      193     define variable v-min        as integer   no-undo .
      194     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      195     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      196     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      197     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      198     if p-mjd-diff < 0
      199     or p-mjd-diff = ?
      200     then do:
      201       return "?" .
      202     end.
      203     assign
      204       v-day-number = integer(truncate(p-mjd-diff,0))
      205       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207     if v-seconds > 86400
      208     then do:
      209       assign
      210         v-seconds = 86400 - 1
      211       .
      212     end.
      213     if v-seconds < 0
      214     then do:
      215       assign
      216         v-seconds = 0
      217       .
      218     end.
      219     assign
      220       v-hour = truncate(v-seconds / 3600, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 3600
      224     .
      225     assign
      226       v-min = truncate(v-seconds / 60, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 60
      230     .
      231     return
      232         (if v-day-number <> 0
      233           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0
      237           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      241           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      242           else ""
      243         )
      244       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      245       .
      246   end.
      247   function cur-time-string returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      256   end.
      257   function cur-time-string-sec returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      266   end.
      267   function cur-time-custom  returns character
      268   (input p-prefix as character
      269   ,input p-date-format as character
      270   ,input p-delimiter as character
      271   ,input p-time-format as character
      272   ,input p-suffix as character
      273   )
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return
      282       p-prefix
      283       + string(v-date, p-date-format)
      284       + p-delimiter
      285       + string(v-time, p-time-format)
      286       + p-suffix
      287       .
      288   end.
      289   function cur-time-print  returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-datetime returns datetime
      300   :
      301     define variable v-char as character no-undo .
      302     define variable v-datetime as datetime no-undo .
      303     v-char = cur-time-string().
      304     v-datetime = datetime(v-char).
      305     return  v-datetime.
      306   end.
      307   function cur-time-string-msec returns character
      308   :
      309     define variable v-date as datetime  no-undo .
      310     v-date = now.
      311     return string(v-date) .
      312   end.
      313   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      314   define new global shared variable g#lib-nws as handle no-undo .
      315   define variable v-host-code as integer no-undo .
      316   define variable v-date as date no-undo .
      317   define variable v-time as integer no-undo .
      318   define variable v-obj-db-num as integer no-undo .
      319   define variable v-obj-type as character no-undo .
      320   define variable v-obj-code as integer no-undo .
      321   define buffer buf_c-dis-thbj-rule for ub.c-dis-thbj-rule.
      322   define buffer buf_c-cli-hist for ub.c-cli-hist.
      323   main-block:
      324   do
      325   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      326   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      327   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      328   :
      329     if not g#news
      330     and g#db-num > 0
      331     and (
      332         ub.dis-thbj-rule.obj-type  = '':U
      333         or
      334         ub.dis-thbj-rule.obj-code = 0
      335         or
      336         ub.dis-thbj-rule.host-code  = 0
      337         ) then do:
      338       message
      339       vss-workfile vss-revision vss-description skip
      340       substitute("&1&2 POS &3 тип скидки &4&5" +
      341                  "Нельзя изменять запись СКИДОК ПО ОБЪЕКТАМ/ФИРМАМ в УБД"
      342                  ,ub.dis-thbj-rule.obj-type
      343                  ,ub.dis-thbj-rule.obj-code
      344                  ,ub.dis-thbj-rule.pos-type
      345                  ,ub.dis-thbj-rule.discnt-role)
      346       view-as alert-box error .
      347       undo main-block, return error .
      348     end.
      349     if not g#news
      350     and (ub.dis-thbj-rule.obj-type = 'маг':U
      351     or ub.dis-thbj-rule.obj-type = 'скл':U) then do:
      352   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      354     (input  ub.dis-thbj-rule.obj-type
      355     ,input  ub.dis-thbj-rule.obj-code
      356     ,output v-obj-db-num
      357     )  .
      358       if v-obj-db-num <> g#db-num
      359       and g#db-num <> 0 then do:
      360         message
      361         vss-workfile vss-revision vss-description skip
      362         substitute("&1&2 POS &3 тип скидки &4&5" +
      363                   "Нельзя изменять запись СКИДОК ПО ОБЪЕКТАМ/ФИРМАМ в чужой БД"
      364                  ,ub.dis-thbj-rule.obj-type
      365                  ,ub.dis-thbj-rule.obj-code
      366                  ,ub.dis-thbj-rule.pos-type
      367                  ,ub.dis-thbj-rule.discnt-role)
      368         view-as alert-box error .
      369         undo main-block, return error .
      370       end.
      371     end.
      372     run str/callnews.p
      373       ( input 'dis-thbj-rule':U
      374         ,input (buffer ub.dis-thbj-rule:handle)
      375       ) .
      376     if g#news then do:
      377       define variable v-send as integer no-undo .
      378       v-send = integer('0':U).
      379   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      381     (input  g#db-num
      382     ,input  'dis-thbj-rule':U
      383     ,input  0
      384     ,input  '':U
      385     ,input  0
      386     ,input  '':U
      387     ,input  '':U
      388     ,input  '':U
      389     ,input  0
      390     ,input  0
      391     ,input  0
      392     ,input  'nws-to-hist'
      393     ,output v-send
      394     ) no-error .
      395     end.
      396     if not g#news
      397     or v-send >= 0 then do:
      398       run cur-time in this-procedure(output v-date, output v-time).
      399       create buf_c-dis-thbj-rule.
      400       buffer-copy old_dis-thbj-rule
      401       except
      402       pos-type
      403       templ-rl-root
      404       host-code
      405       obj-type
      406       obj-code
      407       nonunique
      408       to buf_c-dis-thbj-rule
      409       assign
      410       buf_c-dis-thbj-rule.pos-type           = ub.dis-thbj-rule.pos-type
      411       buf_c-dis-thbj-rule.discnt-role        = ub.dis-thbj-rule.discnt-role
      412       buf_c-dis-thbj-rule.obj-type           = ub.dis-thbj-rule.obj-type
      413       buf_c-dis-thbj-rule.obj-code           = ub.dis-thbj-rule.obj-code
      414       buf_c-dis-thbj-rule.host-code          = ub.dis-thbj-rule.host-code
      415       buf_c-dis-thbj-rule.nonunique          = ub.dis-thbj-rule.nonunique
      416       buf_c-dis-thbj-rule.chip-num           = next-value (s-cli-chip, ub)
      417       buf_c-dis-thbj-rule.corr-time          = v-time
      418       buf_c-dis-thbj-rule.corr-user-db-num   = g#db-num
      419       buf_c-dis-thbj-rule.corr-user-name     = (if g#news
      420                                                 then (chr(4) +  'СПН':U)
      421                                                 else (if g#esys
      422                                                       then (chr(4) +  'ВС':U)
      423                                                       else g#userid
      424                                                       )
      425                                                 )
      426       buf_c-dis-thbj-rule.corr-date          = v-date
      427       .
      428       if not (ub.dis-thbj-rule.obj-type = '':U
      429              and
      430              ub.dis-thbj-rule.obj-code = 0
      431              and
      432              ub.dis-thbj-rule.host-code = 0) then do:
      433         if ub.dis-thbj-rule.obj-type = 'маг':U
      434         or ub.dis-thbj-rule.obj-type = 'скл':U then do:
      435   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      436   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      437     (input  ub.dis-thbj-rule.obj-type
      438     ,input  ub.dis-thbj-rule.obj-code
      439     ,output v-host-code
      440     )  .
      441           assign
      442           v-obj-type = ub.dis-thbj-rule.obj-type
      443           v-obj-code = ub.dis-thbj-rule.obj-code
      444           .
      445         end.
      446         if ub.dis-thbj-rule.obj-type = 'орг':U then do:
      447           assign
      448           v-obj-type = 'орг':U
      449           v-obj-code = ub.dis-thbj-rule.host-code
      450           v-host-code = ub.dis-thbj-rule.obj-code.
      451         end.
      452         create buf_c-cli-hist.
      453         buffer-copy buf_c-dis-thbj-rule
      454         except obj-type obj-code
      455         to buf_c-cli-hist
      456         assign
      457         buf_c-cli-hist.action = (if new (ub.dis-thbj-rule )
      458                                 then integer('1':U)
      459                                 else integer('2':U))
      460         buf_c-cli-hist.subject = 'dis-thbj-rule':U
      461         buf_c-cli-hist.obj-type = v-obj-type
      462         buf_c-cli-hist.obj-code = v-obj-code
      463         buf_c-cli-hist.host-code = v-host-code
      464         buf_c-cli-hist.is-news = g#news
      465         buf_c-cli-hist.source-type = (if g#news
      466                                       then 'db':U
      467                                       else (if g#esys
      468                                             then 'esys':U
      469                                             else "":U)
      470                                       )
      471         buf_c-cli-hist.source-ref = (if g#news
      472                                     then string(g#news-source-db)
      473                                     else (if g#esys
      474                                           then string(g#esys-source-esys)
      475                                           else "":U)
      476                                     )
      477         .
      478       end.
      479     end.
      480     if g#oxml = yes
      481     then do:
      482       run str/calloxml.p (
      483             input 'update':U
      484           , input 'dis-thbj-rule':U
      485           , input ( buffer ub.dis-thbj-rule:handle )
      486       ) no-error.
      487       if error-status :error
      488       then do:
      489           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      490                                , chr(10)
      491                                , vss-workfile
      492                                , return-value
      493                                , error-status :get-message ( 1 ) ).
      494       end.
      495     end.
      496   end.
