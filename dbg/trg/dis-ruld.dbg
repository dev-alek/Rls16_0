        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.dis-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление правил скидок".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1',  ub.dis-rule.rule-num)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure dr-code :
      308     do
      309     on error undo, return error
      310     :
      311       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      312       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      313       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      314       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      315       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      316       define output parameter  p-level-1           as character no-undo .
      317       define output parameter  p-level-2           as character no-undo .
      318       define output parameter  p-global             as integer no-undo .
      319       define output parameter  p-host               as integer no-undo .
      320       define output parameter  p-object             as integer no-undo .
      321       define output parameter  p-output-display as logical   no-undo .
      322       define output parameter  p-tree           as char  no-undo .
      323       define output parameter  p-other          as character no-undo .
      324       define variable v-other as character no-undo .
      325       define buffer buf_dis-rule for ub.dis-rule .
      326       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      327       find first buf_dis-rule no-lock where
      328                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      329       find first buf_dis-cfg-rule no-lock where
      330               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      331           and buf_dis-cfg-rule.pos-type = '':U
      332           and buf_dis-cfg-rule.table-name = '':U
      333           and buf_dis-cfg-rule.discnt-role = '':U
      334           and buf_dis-cfg-rule.self-nonunique = '':U
      335               no-error.
      336       if not available buf_Dis-cfg-rule then do:
      337           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      338       end.
      339       assign
      340       p-des = buf_dis-rule.des
      341       p-discnt-type = buf_dis-rule.discnt-type
      342       p-subject-type = buf_dis-rule.subject-type
      343       p-value-type = buf_dis-rule.value-type
      344       p-global = (if available buf_dis-cfg-rule
      345                   then buf_dis-cfg-rule.has-global
      346                   else 0)
      347       p-host = (if available buf_dis-cfg-rule
      348                 then buf_dis-cfg-rule.has-host
      349                 else 0)
      350       p-object = (if available buf_dis-cfg-rule
      351                 then buf_dis-cfg-rule.has-obj
      352                 else 0)
      353       p-output-display = (buf_dis-rule.sts = integer('0':U))
      354       p-tree = buf_Dis-rule.uniq-field
      355       p-other = buf_dis-rule.other-inf
      356       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      357       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      358                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      359                    else '')
      360       .
      361     end.
      362   end procedure.
      363   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      364   procedure disrules-fill-properties:
      365   define input  parameter p-templ-rl-root as integer   no-undo .
      366   define buffer buf_drt-prop for ub.drt-prop.
      367   define buffer buf_temp-drt-prop for temp-drt-prop.
      368   do
      369   on error undo, return error return-value
      370   :
      371     for each buf_temp-drt-prop:
      372       delete buf_temp-drt-prop.
      373     end.
      374     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      375       create buf_temp-drt-prop.
      376       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      377     end.
      378   end.
      379   end procedure.
      380   procedure disrules-get-interface-form :
      381   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      382   define output parameter p-form-name as character no-undo .
      383   define buffer buf_temp-drt-prop for temp-drt-prop.
      384   define buffer buf_drt-prop for ub.drt-prop.
      385   find first buf_temp-drt-prop where
      386             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      387         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      388         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      389   if not available buf_temp-drt-prop then do:
      390     find first buf_drt-prop where
      391               buf_drt-prop.templ-rl-root = p-templ-rl-root
      392           and buf_drt-prop.upper-prop-code = "InputForm"
      393           and buf_drt-prop.prop-code = "FormName" no-error.
      394     if available buf_drt-prop then do:
      395       p-form-name = buf_drt-prop.property-value.
      396     end.
      397     else do:
      398       p-form-name = "ref/dis-ruli.w".
      399     end.
      400   end.
      401   else do:
      402     p-form-name = buf_temp-drt-prop.property-value.
      403   end.
      404   end procedure.
      405   ~
      406   define variable v-date as date no-undo .
      407   define variable v-time as integer no-undo .
      408   define buffer buf_c-dis-rule for ub.c-dis-rule.
      409   define variable v-db-num like ub.db.db-num no-undo .
      410   define variable v-db-list as character no-undo .
      411   define buffer buf_dis-rule for ub.dis-rule.
      412   main-block:
      413   do
      414   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      415   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      416   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      417   :
      418     if not g#news
      419     and ub.dis-rule.rule-num <= 99999
      420     and ub.dis-rule.sts <> integer('1':U)
      421     and ub.dis-rule.rule-num < 93
      422     then do:
      423       message
      424       vss-workfile vss-revision vss-description skip
      425       "Нельзя удалять запись ШАБЛОНОВ СКИДОК"
      426       view-as alert-box error .
      427       undo main-block, return error .
      428     end.
      429     if not g#news then do:
      430       if ( g#db-num > 0 ) then do:
      431         if ub.dis-rule.host-code = 0
      432         or ub.dis-rule.obj-code = 0 then do:
      433           find first buf_dis-rule no-lock where
      434                     buf_dis-rule.templ-rl-root = ub.dis-rule.templ-rl-root no-error.
      435           if buf_dis-rule.sts <> integer('1':U) then do:
      436             message
      437             vss-workfile vss-revision vss-description skip
      438             "Нельзя удалять ИСПОЛЬЗУЕМУЮ глобальную запись ПРАВИЛА СКИДОК  или запись ПРАВИЛА СКИДОК по фирме в УБД"
      439             view-as alert-box error .
      440             undo main-block, return error .
      441           end.
      442         end.
      443       end.
      444       if ub.dis-rule.obj-code > 0 then do:
      445   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      446   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      447     (input  ub.dis-rule.obj-type
      448     ,input  ub.dis-rule.obj-code
      449     ,output v-db-num
      450     )  .
      451         if v-db-num <> g#db-num and ( g#db-num > 0 ) then do:
      452           message
      453           vss-workfile vss-revision vss-description skip
      454           "Нельзя удалять запись ПРАВИЛА СКИДОК на объекте в чужой БД"
      455           view-as alert-box error .
      456           undo main-block, return error .
      457         end.
      458       end.
      459       if can-find(first buf_dis-rule no-lock where
      460                       buf_dis-rule.upper-rule-num = ub.dis-rule.rule-num
      461                   AND buf_dis-rule.rule-num < 93 ) then do:
      462         message
      463         vss-workfile vss-revision vss-description skip
      464         "Нельзя удалять запись ПРАВИЛА СКИДОК, если к ней привязана другая запись"
      465         view-as alert-box error .
      466         undo main-block, return error .
      467       end.
      468     end.
      469     if ub.dis-rule.upper-rule-num <= 99999
      470     then do:
      471       if ub.dis-rule.sts <> integer('99':U) then do:
      472         if ub.dis-rule.obj-code <> 0 then do:
      473   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      475     (input  ub.dis-rule.obj-type
      476     ,input  ub.dis-rule.obj-code
      477     ,output v-db-num
      478     )  .
      479           if g#db-num = 0
      480           and v-db-num <> 0  then do:
      481             assign
      482             v-db-list = string( v-db-num ) .
      483           end.
      484           if g#db-num <> 0 then do:
      485             assign
      486             v-db-list = "0"
      487             .
      488           end.
      489         end.
      490         run nws/cmd-del.p
      491           ( input 'dis-rule':U
      492           ,input (buffer ub.dis-rule:handle)
      493           ,input v-db-list
      494           ) no-error .
      495         if error-status :error then do:
      496           undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      497         end.
      498       end.
      499     end.
      500     run cur-time in this-procedure(output v-date, output v-time).
      501     create buf_c-dis-rule.
      502     buffer-copy ub.dis-rule to buf_c-dis-rule
      503     assign
      504     buf_c-dis-rule.rule-num             = ub.dis-rule.rule-num
      505     buf_c-dis-rule.chip-num           = next-value (s-dc-chip, ub)
      506     buf_c-dis-rule.corr-time          = v-time
      507     buf_c-dis-rule.corr-user-db-num   = g#db-num
      508     buf_c-dis-rule.corr-user-name     = (if g#news
      509                                          then (chr(4) +  'СПН':U)
      510                                          else (if g#esys
      511                                                then (chr(4) +  'ВС':U)
      512                                                else g#userid)
      513                                                )
      514     buf_c-dis-rule.corr-date          = v-date
      515     buf_c-dis-rule.is-news            = g#news
      516     buf_c-dis-rule.action             = integer('99':U)
      517     .
      518     if g#oxml = yes
      519     then do:
      520       run str/calloxml.p (
      521             input 'delete':U
      522           , input 'dis-rule':U
      523           , input ( buffer ub.dis-rule:handle )
      524       ) no-error.
      525       if error-status :error
      526       then do:
      527           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      528                                , chr(10)
      529                                , vss-workfile
      530                                , return-value
      531                                , error-status :get-message ( 1 ) ).
      532       end.
      533       end.
      534   end.
