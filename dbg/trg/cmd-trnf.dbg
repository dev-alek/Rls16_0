        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Отправка в новости шапки trn-doc".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input  parameter p-doc-code  as character no-undo .
       67   define input  parameter p-comand-type as character no-undo .
       68   define input  parameter p-db-list as character no-undo .
       69   define buffer buf_trn-doc for ub.trn-doc  .
       70   find first buf_trn-doc  no-lock where buf_trn-doc.doc-code = p-doc-code .
       71   define variable v-cmd-proc-handle as handle    no-undo .
       72   define variable v-cmd-code        as integer   no-undo .
       73   define variable v-db-list as character no-undo .
       74   define variable v-rec-ord as integer no-undo .
       75   do
       76   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       77   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       78   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       79   :
       80     run nws/cmd-bush.p persistent set v-cmd-proc-handle
       81       no-error .
       82     if error-status :error
       83     then do:
       84       message
       85         vss-workfile vss-revision vss-description skip
       86         substitute("Ошибка при запуске процедуры cmd-bush.p") skip
       87         error-status :get-message(1) skip
       88         return-value skip
       89         view-as alert-box error .
       90       delete procedure v-cmd-proc-handle .
       91       undo, return error return-value .
       92     end.
       93     define variable v-command as character no-undo .
       94     v-command =  substitute("&2&1&3&1&4"
       95                 , chr(6)
       96                 , 'cmd-trn-doc-fact':U
       97                 , p-comand-type
       98                 , p-doc-code
       99                 ).
      100     v-db-list = p-db-list .
      101     run begin-create-command in v-cmd-proc-handle
      102       (input  v-command
      103       ,input  v-db-list
      104       ,output v-cmd-code
      105       ) no-error.
      106     if error-status :error
      107     then do:
      108       message
      109         vss-workfile vss-revision vss-description skip
      110         substitute( "Ошибка при создании команды &1", 'cmd-trn-doc-fact':U ) skip
      111         error-status :get-message(1) skip
      112         return-value skip
      113         view-as alert-box error .
      114       delete procedure v-cmd-proc-handle .
      115       undo, return error return-value .
      116     end.
      117     for each buf_trn-doc exclusive-lock where buf_trn-doc.doc-code  = p-doc-code
      118     on error undo, return error return-value
      119     :
      120       run add-dump in v-cmd-proc-handle
      121         (input v-cmd-code
      122         ,input 'trn-doc':U
      123         ,input '+update':U
      124         ,input (buffer buf_trn-doc :handle)
      125         ,input '':U
      126         ,output v-rec-ord
      127         ) no-error .
      128       if error-status :error
      129       then do:
      130         message
      131           vss-workfile vss-revision vss-description skip
      132           substitute( "Ошибка при добавлении записи &1 в команду с кодом &2", 'trn-doc':U, v-cmd-code ) skip
      133           error-status :get-message(1) skip
      134           return-value skip
      135           view-as alert-box error .
      136         delete procedure v-cmd-proc-handle .
      137         undo, return error return-value .
      138       end.
      139     end.
      140     run send-command in v-cmd-proc-handle
      141       ( input v-cmd-code
      142        ,input p-db-list
      143       ) no-error .
      144     if error-status :error then do:
      145       message
      146         vss-workfile vss-revision vss-description skip
      147         substitute( "Ошибка при отправке в новости команды с кодом &1", v-cmd-code ) skip
      148         error-status :get-message(1) skip
      149         return-value skip
      150         view-as alert-box error .
      151       delete procedure v-cmd-proc-handle .
      152       undo, return error return-value .
      153     end.
      154     delete procedure v-cmd-proc-handle .
      155   end.
