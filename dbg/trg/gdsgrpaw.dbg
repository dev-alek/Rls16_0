        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.gds-grp-attr OLD oldgds-grp-attr.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись gds-grp-attr".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                                       ,ub.gds-grp-attr.node-code
       30                                       ,ub.gds-grp-attr.attr-code
       31                                       ,ub.gds-grp-attr.host-code
       32                                       ,ub.gds-grp-attr.obj-type
       33                                       ,ub.gds-grp-attr.obj-code
       34                                       )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure grp-attr-name :
       89   do
       90     on error undo, return error
       91     :
       92     define input  parameter p-code           as character no-undo .
       93     define output parameter p-type           as character no-undo .
       94     define output parameter p-format         as character no-undo .
       95     define output parameter p-label          as character no-undo .
       96     define output parameter p-user-can-edit  as logical   no-undo .
       97     define output parameter p-output-display as logical   no-undo .
       98     define output parameter p-other          as character no-undo .
       99       case p-code :
      100               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      101         otherwise do:
      102           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      103         end.
      104       end.
      105     end.
      106   end procedure.
      107   procedure grp-attr-tooltip :
      108   do
      109     on error undo, return error
      110     :
      111       define input  parameter p-code    as character no-undo .
      112       define output parameter p-tooltip as character no-undo .
      113       define output parameter p-label   as character no-undo .
      114       case p-code :
      115               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
      116         otherwise do:
      117               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      118         end.
      119       end.
      120     end.
      121   end procedure.
      122   procedure grp-attr-value :
      123   do
      124   on error undo, return error
      125   :
      126   define input  parameter p-node-code   as integer    no-undo.
      127   define input  parameter p-code        as character  no-undo.
      128   define input  parameter p-host-code   as integer    no-undo.
      129   define input  parameter p-obj-type    as character  no-undo.
      130   define input  parameter p-obj-code    as integer    no-undo.
      131   define output parameter p-value       as character  no-undo.
      132   define output parameter p-type        as character  no-undo.
      133       define variable v-format         as character no-undo .
      134       define variable v-label          as character no-undo .
      135       define variable v-user-can-edit  as logical   no-undo .
      136       define variable v-output-display as logical   no-undo .
      137       define variable v-other          as character no-undo .
      138       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      139       run grp-attr-name in this-procedure (
      140             input  p-code
      141           , output p-type
      142           , output v-format
      143           , output v-label
      144           , output v-user-can-edit
      145           , output v-output-display
      146           , output v-other
      147       ) no-error .
      148       if error-status :error
      149       then do:
      150           undo, return error return-value .
      151       end.
      152       find first buf_gds-grp-attr no-lock
      153            where buf_gds-grp-attr.node-code = p-node-code
      154              and buf_gds-grp-attr.attr-code = p-code
      155              and buf_gds-grp-attr.host-code = p-host-code
      156              and buf_gds-grp-attr.obj-type  = p-obj-type
      157              and buf_gds-grp-attr.obj-code  = p-obj-code
      158       no-error .
      159       if available buf_gds-grp-attr
      160       then do:
      161           assign
      162               p-value = buf_gds-grp-attr.attr-value
      163           .
      164       end.
      165       else do:
      166           assign
      167               p-value = if p-type = 'L':U then "no":U else ""
      168           .
      169       end.
      170   end.
      171   end procedure.
      172   procedure grp-attr-write :
      173   do
      174   on error undo, return error
      175   :
      176   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      177   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      178   define input parameter p-host-code  as integer                          no-undo.
      179   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      180   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      181   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      182       define variable v-type              as character                no-undo.
      183       define variable v-format            as character                no-undo.
      184       define variable v-label             as character                no-undo.
      185       define variable v-user-can-edit     as logical                  no-undo.
      186       define variable v-output-display    as logical                  no-undo.
      187       define variable v-other             as character                no-undo.
      188       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      189       run grp-attr-name in this-procedure (
      190                         input  p-code
      191                       , output v-type
      192                       , output v-format
      193                       , output v-label
      194                       , output v-user-can-edit
      195                       , output v-output-display
      196                       , output v-other
      197       ) no-error.
      198       if error-status :error
      199       then do:
      200           undo, return error return-value.
      201       end.
      202       find first buf_gds-grp-attr exclusive-lock
      203            where buf_gds-grp-attr.node-code  = p-node-code
      204              and buf_gds-grp-attr.attr-code  = p-code
      205              and buf_gds-grp-attr.host-code  = p-host-code
      206              and buf_gds-grp-attr.obj-type   = p-obj-type
      207              and buf_gds-grp-attr.obj-code   = p-obj-code
      208       no-error.
      209       if not available buf_gds-grp-attr
      210       then do:
      211           create buf_gds-grp-attr.
      212           assign
      213                   buf_gds-grp-attr.node-code  = p-node-code
      214                   buf_gds-grp-attr.attr-code  = p-code
      215                   buf_gds-grp-attr.host-code  = p-host-code
      216                   buf_gds-grp-attr.obj-type   = p-obj-type
      217                   buf_gds-grp-attr.obj-code   = p-obj-code
      218                   buf_gds-grp-attr.attr-value = p-value
      219           .
      220       end.
      221       else do:
      222           assign
      223               buf_gds-grp-attr.attr-value = p-value
      224           .
      225       end.
      226   end.
      227   end procedure.
      228   procedure grp-attr-delete :
      229   do
      230   on error undo, return error
      231   :
      232   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      233   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      234   define input parameter p-host-code  as integer                      no-undo.
      235   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      236   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      237   define output parameter p-deleted   as logical                      no-undo.
      238       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      239       define variable v-type              as character                no-undo.
      240       define variable v-format            as character                no-undo.
      241       define variable v-label             as character                no-undo.
      242       define variable v-user-can-edit     as logical                  no-undo.
      243       define variable v-output-display    as logical                  no-undo.
      244       define variable v-other             as character                no-undo.
      245       run grp-attr-name in this-procedure
      246       ( input  p-code
      247       , output v-type
      248       , output v-format
      249       , output v-label
      250       , output v-user-can-edit
      251       , output v-output-display
      252       , output v-other
      253       ) no-error .
      254       if error-status :error then do:
      255           undo, return error return-value .
      256       end.
      257       find first buf_gds-grp-attr exclusive-lock
      258            where buf_gds-grp-attr.node-code  = p-node-code
      259              and buf_gds-grp-attr.attr-code  = p-code
      260              and buf_gds-grp-attr.host-code  = p-host-code
      261              and buf_gds-grp-attr.obj-type   = p-obj-type
      262              and buf_gds-grp-attr.obj-code   = p-obj-code
      263       no-error.
      264       if not available buf_gds-grp-attr
      265       then do:
      266           assign
      267               p-deleted = no
      268           .
      269       end.
      270       else do:
      271          delete buf_gds-grp-attr.
      272          assign
      273               p-deleted = yes
      274           .
      275       end.
      276   end.
      277   end procedure.
      278   procedure grp-attr-news :
      279   do
      280   on error undo, return error
      281   :
      282       define input  parameter p-code           as character no-undo .
      283       define output parameter p-news           as logical   no-undo .
      284       case p-code :
      285               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
      286         otherwise do:
      287           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
      288         end.
      289       end.
      290   end.
      291   end procedure.
      292   procedure grp-attr-obj-value :
      293   do
      294   on error undo, return error
      295   :
      296   define input parameter p-node-code as integer      no-undo.
      297   define input parameter p-obj-type  as character    no-undo.
      298   define input parameter p-obj-code  as integer      no-undo.
      299   define input parameter p-attr-code as character    no-undo .
      300   define output parameter p-attr-value     as character   no-undo.
      301   define output parameter p-range     as integer      no-undo.
      302   define output parameter p-exists    as logical      no-undo.
      303   define variable v-host-code as integer      no-undo.
      304   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      306     (input  p-obj-type
      307     ,input  p-obj-code
      308     ,output v-host-code
      309     ) no-error .
      310   if error-status :error
      311   then do:
      312       message
      313         vss-workfile vss-revision vss-description
      314         skip "Не удалось найти фирму объекта"
      315         skip p-obj-type p-obj-code
      316         skip return-value
      317         skip trim(error-status :get-message(1))
      318              trim(error-status :get-message(2))
      319              trim(error-status :get-message(3))
      320              trim(error-status :get-message(4))
      321              trim(error-status :get-message(5))
      322       view-as alert-box error.
      323       undo, return error .
      324   end.
      325   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
      326   find first buf_gds-grp-attr no-lock
      327        where buf_gds-grp-attr.node-code = p-node-code
      328          and buf_gds-grp-attr.attr-code = p-attr-code
      329          and buf_gds-grp-attr.host-code = v-host-code
      330          and buf_gds-grp-attr.obj-type  = p-obj-type
      331          and buf_gds-grp-attr.obj-code  = p-obj-code
      332   no-error .
      333   if not available buf_gds-grp-attr
      334   then do:
      335       find first buf_gds-grp-attr no-lock
      336            where buf_gds-grp-attr.node-code = p-node-code
      337              and buf_gds-grp-attr.attr-code = p-attr-code
      338              and buf_gds-grp-attr.host-code = v-host-code
      339              and buf_gds-grp-attr.obj-type  = ""
      340              and buf_gds-grp-attr.obj-code  = 0
      341       no-error .
      342       if not available buf_gds-grp-attr
      343       then do:
      344           find first buf_gds-grp-attr no-lock
      345               where buf_gds-grp-attr.node-code = p-node-code
      346               and buf_gds-grp-attr.attr-code = p-attr-code
      347               and buf_gds-grp-attr.host-code = 0
      348               and buf_gds-grp-attr.obj-type  = ""
      349               and buf_gds-grp-attr.obj-code  = 0
      350           no-error .
      351           if not available buf_gds-grp-attr
      352           then do:
      353               assign
      354                   p-exists = no
      355               .
      356           end.
      357           else do:
      358               assign
      359                   p-exists = yes
      360                   p-range  = 1
      361               .
      362           end.
      363       end.
      364       else do:
      365           assign
      366               p-exists = yes
      367               p-range  = 2
      368           .
      369       end.
      370   end.
      371   else do:
      372       assign
      373           p-exists = yes
      374           p-range  = 3
      375       .
      376   end.
      377   if available buf_gds-grp-attr
      378   then do:
      379     assign
      380     p-attr-value = buf_gds-grp-attr.attr-value
      381     .
      382   end.
      383   end.
      384   end procedure.
      385   procedure ver-gds-grp-nabor :
      386   do
      387   on error undo, return error return-value
      388   :
      389   define input  parameter p-gds-code as integer   no-undo .
      390   define output parameter p-nabor as logical   no-undo .
      391   define buffer buf_goods for ub.goods.
      392   p-nabor = false .
      393   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      394   if error-status :error then return error .
      395   define variable v-value       as character  no-undo.
      396   define variable v-type        as character  no-undo.
      397     run grp-attr-value (
      398        input   buf_goods.grp-code
      399       ,input   'gds-grp-nabor':U
      400       ,input   0
      401       ,input   ""
      402       ,input   0
      403       ,output  v-value
      404       ,output  v-type       ) no-error .
      405       if error-status :error then return error .
      406     if v-value = "yes" then p-nabor = true  .
      407   end.
      408   end procedure.
      409   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      410   procedure cur-time :
      411      define output parameter p-today as date      no-undo .
      412      define output parameter p-time  as integer   no-undo .
      413     do
      414     on error undo, return error
      415     :
      416       define variable v-date1 as date      no-undo .
      417       define variable v-date2 as date      no-undo .
      418       define variable v-time  as integer   no-undo .
      419       assign
      420         v-date1 = today
      421         v-time  = time
      422         v-date2 = today
      423       .
      424       if v-date1 <> v-date2
      425       then do:
      426         assign
      427           v-date1 = today
      428           v-time  = v-time
      429         .
      430       end.
      431       assign
      432         p-today = v-date1
      433         p-time  = v-time
      434       .
      435     end.
      436   end.
      437   function cur-time-date returns character
      438   :
      439     return string(today, '99/99/9999':U) .
      440   end.
      441   function cur-time-mjd returns decimal
      442   :
      443     define variable v-date as date      no-undo .
      444     define variable v-time as integer   no-undo .
      445     run cur-time in this-procedure
      446       (output v-date
      447       ,output v-time
      448       ) .
      449     return integer(v-date) - 2400002 + (v-time / 86400) .
      450   end.
      451   function cur-time-get-ending-index returns integer
      452   (input p-number as integer
      453   )
      454   :
      455     if p-number < 0
      456     or p-number = ?
      457     then do:
      458       return 1 .
      459     end.
      460     define variable v-rest as integer   no-undo .
      461     assign
      462       p-number = p-number modulo 100
      463     .
      464     if p-number < 20
      465     then do:
      466       assign
      467         v-rest = p-number
      468       .
      469     end.
      470     else do:
      471       assign
      472         v-rest = p-number modulo 10
      473       .
      474     end.
      475     case v-rest :
      476       when 1
      477       then do:
      478         return 2 .
      479       end.
      480       when 2 or
      481       when 3 or
      482       when 4
      483       then do:
      484         return 3 .
      485       end.
      486       otherwise do:
      487         return 1 .
      488       end.
      489     end case .
      490   end.
      491   procedure cur-time-mjd-to-date :
      492      define input  parameter i-mjd-diff as decimal no-undo.
      493      define output parameter o-Date     as date    no-undo.
      494      define output parameter o-Time     as integer no-undo.
      495      define variable v-day-number as integer   no-undo .
      496      if    i-mjd-diff < 0
      497         or i-mjd-diff = ?
      498      then do:
      499         return "?" .
      500      end.
      501      assign
      502         v-day-number = truncate(i-mjd-diff,0).
      503         o-Date = date(v-day-number + 2400002).
      504         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      505     .
      506   end.
      507   function cur-time-mjd-to-string returns character
      508   (input p-mjd-diff as decimal
      509   )
      510   :
      511     define variable v-day-number as integer   no-undo .
      512     define variable v-seconds    as integer   no-undo .
      513     define variable v-hour       as integer   no-undo .
      514     define variable v-min        as integer   no-undo .
      515     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      516     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      517     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      518     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      519     if p-mjd-diff < 0
      520     or p-mjd-diff = ?
      521     then do:
      522       return "?" .
      523     end.
      524     assign
      525       v-day-number = integer(truncate(p-mjd-diff,0))
      526       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      527     .
      528     if v-seconds > 86400
      529     then do:
      530       assign
      531         v-seconds = 86400 - 1
      532       .
      533     end.
      534     if v-seconds < 0
      535     then do:
      536       assign
      537         v-seconds = 0
      538       .
      539     end.
      540     assign
      541       v-hour = truncate(v-seconds / 3600, 0)
      542     .
      543     assign
      544       v-seconds = v-seconds modulo 3600
      545     .
      546     assign
      547       v-min = truncate(v-seconds / 60, 0)
      548     .
      549     assign
      550       v-seconds = v-seconds modulo 60
      551     .
      552     return
      553         (if v-day-number <> 0
      554           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      555           else ""
      556         )
      557       + (if v-day-number <> 0 or v-hour <> 0
      558           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      559           else ""
      560         )
      561       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      562           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      563           else ""
      564         )
      565       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      566       .
      567   end.
      568   function cur-time-string returns character
      569   :
      570     define variable v-date as date      no-undo .
      571     define variable v-time as integer   no-undo .
      572     run cur-time in this-procedure
      573       (output v-date
      574       ,output v-time
      575       ) .
      576     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      577   end.
      578   function cur-time-string-sec returns character
      579   :
      580     define variable v-date as date      no-undo .
      581     define variable v-time as integer   no-undo .
      582     run cur-time in this-procedure
      583       (output v-date
      584       ,output v-time
      585       ) .
      586     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      587   end.
      588   function cur-time-custom  returns character
      589   (input p-prefix as character
      590   ,input p-date-format as character
      591   ,input p-delimiter as character
      592   ,input p-time-format as character
      593   ,input p-suffix as character
      594   )
      595   :
      596     define variable v-date as date      no-undo .
      597     define variable v-time as integer   no-undo .
      598     run cur-time in this-procedure
      599       (output v-date
      600       ,output v-time
      601       ) .
      602     return
      603       p-prefix
      604       + string(v-date, p-date-format)
      605       + p-delimiter
      606       + string(v-time, p-time-format)
      607       + p-suffix
      608       .
      609   end.
      610   function cur-time-print  returns character
      611   :
      612     define variable v-date as date      no-undo .
      613     define variable v-time as integer   no-undo .
      614     run cur-time in this-procedure
      615       (output v-date
      616       ,output v-time
      617       ) .
      618     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      619   end.
      620   function cur-time-datetime returns datetime
      621   :
      622     define variable v-char as character no-undo .
      623     define variable v-datetime as datetime no-undo .
      624     v-char = cur-time-string().
      625     v-datetime = datetime(v-char).
      626     return  v-datetime.
      627   end.
      628   function cur-time-string-msec returns character
      629   :
      630     define variable v-date as datetime  no-undo .
      631     v-date = now.
      632     return string(v-date) .
      633   end.
      634   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   procedure gds-grph_write-gds-grp-attr-trigger :
      636   define input parameter p-new-record as logical no-undo .
      637   define input parameter p-source-type like ub.c-gds-grp-hist.source-type no-undo .
      638   define input parameter p-source-ref  like ub.c-gds-grp-hist.source-ref no-undo .
      639   define input parameter p-action as integer no-undo .
      640   define variable v-date as date      no-undo.
      641   define variable v-time  as integer   no-undo.
      642   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      643   define buffer buf_c-gds-grp-attr for ub.c-gds-grp-attr.
      644     do
      645     on error undo, return error
      646     :
      647       run cur-time in this-procedure(output v-date, output v-time).
      648       create buf_c-gds-grp-attr.
      649       buffer-copy oldgds-grp-attr to buf_c-gds-grp-attr
      650       assign
      651       buf_c-gds-grp-attr.node-code          = (if p-new-record then ub.gds-grp-attr.node-code else oldgds-grp-attr.node-code)
      652       buf_c-gds-grp-attr.attr-code          = (if p-new-record then ub.gds-grp-attr.attr-code else  oldgds-grp-attr.attr-code)
      653       buf_c-gds-grp-attr.host-code          = (if p-new-record then ub.gds-grp-attr.host-code else  oldgds-grp-attr.host-code)
      654       buf_c-gds-grp-attr.obj-type           = (if p-new-record then ub.gds-grp-attr.obj-type  else  oldgds-grp-attr.obj-type)
      655       buf_c-gds-grp-attr.obj-code           = (if p-new-record then ub.gds-grp-attr.obj-code  else  oldgds-grp-attr.obj-code)
      656       buf_c-gds-grp-attr.chip-num           = next-value (s-gds-grp-chip, ub)
      657       buf_c-gds-grp-attr.corr-time          = v-time
      658       buf_c-gds-grp-attr.corr-user-db-num   = g#db-num
      659       buf_c-gds-grp-attr.corr-user-name     = (if g#news
      660                                           then (chr(4) +  'СПН':U)
      661                                           else (if g#esys
      662                                                then (chr(4) +  'ВС':U)
      663                                                else g#userid)
      664                                           )
      665       buf_c-gds-grp-attr.corr-date          = v-date
      666       .
      667       create buf_c-gds-grp-hist.
      668       buffer-copy buf_c-gds-grp-attr to buf_c-gds-grp-hist
      669       assign
      670       buf_c-gds-grp-hist.node-code           = buf_c-gds-grp-attr.node-code
      671       buf_c-gds-grp-hist.action = p-action
      672       buf_c-gds-grp-hist.subject = 'gds-grp-attr':U
      673       buf_c-gds-grp-hist.is-news = g#news
      674       buf_c-gds-grp-hist.source-type = p-source-type
      675       buf_c-gds-grp-hist.source-ref = p-source-ref
      676       buf_c-gds-grp-hist.is-del = (p-action = integer('99':U))
      677       .
      678     end.
      679   end procedure.
      680   procedure gds-grph_write-gds-grp-attr-proc  :
      681   define parameter buffer buf_gds-grp-attr for ub.gds-grp-attr .
      682   define input parameter p-action as integer no-undo .
      683   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      684   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      685   define variable v-date as date      no-undo.
      686   define variable v-time  as integer   no-undo.
      687   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      688   define buffer buf_c-gds-grp-attr for ub.c-gds-grp-attr.
      689     do
      690     on error undo, return error
      691     :
      692       if not available buf_gds-grp-attr then do:
      693         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      694                       "Ошибка задания входных параметров:Не определен атрибут группы товара" ).
      695       end.
      696       run cur-time in this-procedure(output v-date, output v-time).
      697       create buf_c-gds-grp-attr.
      698       buffer-copy buf_gds-grp-attr to buf_c-gds-grp-attr
      699       assign
      700       buf_c-gds-grp-attr.node-code          = buf_gds-grp-attr.node-code
      701       buf_c-gds-grp-attr.attr-code          = buf_gds-grp-attr.attr-code
      702       buf_c-gds-grp-attr.host-code          = buf_gds-grp-attr.host-code
      703       buf_c-gds-grp-attr.obj-type           = buf_gds-grp-attr.obj-type
      704       buf_c-gds-grp-attr.obj-code           = buf_gds-grp-attr.obj-code
      705       buf_c-gds-grp-attr.chip-num           = next-value (s-gds-grp-chip, ub)
      706       buf_c-gds-grp-attr.corr-time          = v-time
      707       buf_c-gds-grp-attr.corr-user-db-num   = g#db-num
      708       buf_c-gds-grp-attr.corr-user-name     = (if g#news
      709                                           then (chr(4) +  'СПН':U)
      710                                           else (if g#esys
      711                                                then (chr(4) +  'ВС':U)
      712                                                else g#userid)
      713                                           )
      714       buf_c-gds-grp-attr.corr-date          = v-date
      715       .
      716       create buf_c-gds-grp-hist.
      717       buffer-copy buf_c-gds-grp-attr to buf_c-gds-grp-hist
      718       assign
      719       buf_c-gds-grp-hist.action =  p-action
      720       buf_c-gds-grp-hist.subject = 'gds-grp-attr':U
      721       buf_c-gds-grp-hist.is-news = g#news
      722       buf_c-gds-grp-hist.source-type = p-source-type
      723       buf_c-gds-grp-hist.source-ref = p-source-ref
      724       .
      725     end.
      726   end procedure.
      727   procedure gds-grph_write-gds-grp-obj-proc  :
      728   define parameter buffer buf_gds-grp-obj for ub.gds-grp-obj .
      729   define input parameter p-action as integer no-undo .
      730   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      731   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      732   define variable v-date as date      no-undo.
      733   define variable v-time  as integer   no-undo.
      734   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      735   define buffer buf_c-gds-grp-obj for ub.c-gds-grp-obj.
      736     do
      737     on error undo, return error
      738     :
      739       if not available buf_gds-grp-obj then do:
      740         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      741                       "Ошибка задания входных параметров:Не определена группы товара на объекте" ).
      742       end.
      743       run cur-time in this-procedure(output v-date, output v-time).
      744       create buf_c-gds-grp-obj.
      745       buffer-copy buf_gds-grp-obj to buf_c-gds-grp-obj
      746       assign
      747       buf_c-gds-grp-obj.node-code          = buf_gds-grp-obj.node-code
      748       buf_c-gds-grp-obj.host-code          = buf_gds-grp-obj.host-code
      749       buf_c-gds-grp-obj.obj-type           = buf_gds-grp-obj.obj-type
      750       buf_c-gds-grp-obj.obj-code           = buf_gds-grp-obj.obj-code
      751       buf_c-gds-grp-obj.chip-num           = next-value (s-gds-grp-chip, ub)
      752       buf_c-gds-grp-obj.corr-time          = v-time
      753       buf_c-gds-grp-obj.corr-user-db-num   = g#db-num
      754       buf_c-gds-grp-obj.corr-user-name     = (if g#news
      755                                           then (chr(4) +  'СПН':U)
      756                                           else (if g#esys
      757                                                then (chr(4) +  'ВС':U)
      758                                                else g#userid)
      759                                           )
      760       buf_c-gds-grp-obj.corr-date          = v-date
      761       .
      762       create buf_c-gds-grp-hist.
      763       buffer-copy buf_c-gds-grp-obj to buf_c-gds-grp-hist
      764       assign
      765       buf_c-gds-grp-hist.action =  p-action
      766       buf_c-gds-grp-hist.subject = 'gds-grp-obj':U
      767       buf_c-gds-grp-hist.is-news = g#news
      768       buf_c-gds-grp-hist.source-type = p-source-type
      769       buf_c-gds-grp-hist.source-ref = p-source-ref
      770       .
      771     end.
      772   end procedure.
      773   procedure gds-grph_write-tax-rate-gds-grp-proc  :
      774   define parameter buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp .
      775   define input parameter p-action as integer no-undo .
      776   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      777   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      778   define variable v-date as date      no-undo.
      779   define variable v-time  as integer   no-undo.
      780   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      781   define buffer buf_c-tax-rate-gds-grp for ub.c-tax-rate-gds-grp.
      782     do
      783     on error undo, return error
      784     :
      785       if not available buf_tax-rate-gds-grp then do:
      786         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      787                       "Ошибка задания входных параметров:Не определена группы товара на объекте" ).
      788       end.
      789       run cur-time in this-procedure(output v-date, output v-time).
      790       create buf_c-tax-rate-gds-grp.
      791       buffer-copy buf_tax-rate-gds-grp to buf_c-tax-rate-gds-grp
      792       assign
      793       buf_c-tax-rate-gds-grp.node-code          = buf_tax-rate-gds-grp.node-code
      794       buf_c-tax-rate-gds-grp.tax-code           = buf_tax-rate-gds-grp.tax-code
      795       buf_c-tax-rate-gds-grp.host-code          = buf_tax-rate-gds-grp.host-code
      796       buf_c-tax-rate-gds-grp.obj-type           = buf_tax-rate-gds-grp.obj-type
      797       buf_c-tax-rate-gds-grp.obj-code           = buf_tax-rate-gds-grp.obj-code
      798       buf_c-tax-rate-gds-grp.chip-num           = next-value (s-gds-grp-chip, ub)
      799       buf_c-tax-rate-gds-grp.corr-time          = v-time
      800       buf_c-tax-rate-gds-grp.corr-user-db-num   = g#db-num
      801       buf_c-tax-rate-gds-grp.corr-user-name     = (if g#news
      802                                           then (chr(4) +  'СПН':U)
      803                                           else (if g#esys
      804                                                then (chr(4) +  'ВС':U)
      805                                                else g#userid)
      806                                           )
      807       buf_c-tax-rate-gds-grp.corr-date          = v-date
      808       .
      809       create buf_c-gds-grp-hist.
      810       buffer-copy buf_c-tax-rate-gds-grp to buf_c-gds-grp-hist
      811       assign
      812       buf_c-gds-grp-hist.action =  p-action
      813       buf_c-gds-grp-hist.subject = 'tax-rate-gds-grp':U
      814       buf_c-gds-grp-hist.is-news = g#news
      815       buf_c-gds-grp-hist.source-type = p-source-type
      816       buf_c-gds-grp-hist.source-ref = p-source-ref
      817       .
      818     end.
      819   end procedure.
      820   define variable p-news as logical no-undo.
      821   main-block:
      822   do
      823   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      824   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      825   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      826   :
      827     run grp-attr-news in this-procedure(input ub.gds-grp-attr.attr-code,
      828                                         output p-news) no-error.
      829     if p-news then
      830     run str/callnews.p
      831       ( input "gds-grp-attr"
      832        ,input (buffer ub.gds-grp-attr:handle)
      833       ) .
      834     if not g#news then do:
      835       run gds-grph_write-gds-grp-attr-trigger  in this-procedure (
      836                                                                   input new(ub.gds-grp-attr)
      837                                                                  ,input "":U
      838                                                                  ,input "":U
      839                                                                  ,input (if new(ub.gds-grp-attr)
      840                                                                          then integer('1':U)
      841                                                                          else integer('2':U)
      842                                                                         )
      843                                                                 ).
      844     end.
      845       if g#oxml = yes
      846       then do:
      847       run str/calloxml.p (
      848             input 'update':U
      849           , input 'gds-grp-attr':U
      850           , input ( buffer ub.gds-grp-attr:handle )
      851       ) no-error.
      852       if error-status :error
      853       then do:
      854           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      855                                , chr(10)
      856                                , vss-workfile
      857                                , return-value
      858                                , error-status :get-message ( 1 ) ).
      859       end.
      860       end.
      861   end.
