      788   function get-user-login returns character
      789     ( p-user-id as character ) :
      790     define variable v-user-login as character no-undo .
      791     run procedure-get-user-login in this-procedure (
      792         input p-user-id
      793       , output v-user-login
      794     ) .
      795     return v-user-login .
      796   end function.
      797   procedure procedure-get-user-login :
      798   define input  parameter p-user-id    as character no-undo .
      799   define output parameter p-user-login as character no-undo .
      800       define buffer buf_user-login for ub.user-login .
      801   do
      802   for buf_user-login
      803   on error undo, return error return-value
      804   :
      805       assign
      806           p-user-login = "":U
      807       .
      808       for each buf_user-login no-lock
      809          where buf_user-login.user-id = p-user-id
      810       by buf_user-login.db-num
      811       :
      812           assign
      813               p-user-login = substitute( "&1&2&3"
      814                                   , p-user-login
      815                                   , ( if p-user-login = "":U then "":U else ",":U )
      816                                   , buf_user-login.db-num )
      817           .
      818       end.
      819   end.
      820   end procedure.
      821   procedure SetAttrUserId:
      822      define input  parameter iDb-num      as integer   no-undo.
      823      define input  parameter iUserId      as character no-undo.
      824      define input  parameter iAttrCode    as character no-undo.
      825      define input  parameter iAttrValue   as character no-undo.
      826      define buffer user-login-attr  for ub.user-login-attr .
      827      find first user-login-attr where user-login-attr.db-num    eq idb-num
      828                                   and user-login-attr.user-id   eq iuserid
      829                                   and user-login-attr.attr-code eq iAttrCode
      830      exclusive-lock no-error.
      831      if     not available user-login-attr
      832         and iAttrValue ne ?
      833      then do:
      834         create user-login-attr.
      835         assign
      836            user-login-attr.db-num     = idb-num
      837            user-login-attr.user-id    = iuserid
      838            user-login-attr.attr-code  = iAttrCode
      839         .
      840      end.
      841      if iAttrValue eq ?
      842      then do:
      843         if available ub.user-login-attr
      844         then
      845            delete ub.user-login-attr.
      846      end.
      847      else
      848         user-login-attr.attr-value = iAttrValue.
      849   end procedure.
      850   function GetAttrUserId returns character (
      851      input iDb-num      as integer  ,
      852      input iUserId      as character,
      853      input iAttrCode    as character):
      854      define buffer user-login-attr  for ub.user-login-attr .
      855      find first user-login-attr where user-login-attr.db-num    eq idb-num
      856                                   and user-login-attr.user-id   eq iuserid
      857                                   and user-login-attr.attr-code eq iAttrCode
      858      no-lock no-error.
      859      return if not available ub.user-login-attr then ? else ub.user-login-attr.attr-value.
      860   end function.
      861   procedure getAccountSetting :
      862      define input  parameter i-user-id  as character no-undo.
      863      define output parameter o-adm-Ubd  as logical no-undo init ?.
      864      define output parameter v-adm-GBD  as logical no-undo.
      865      define output parameter o-superAdm as logical no-undo.
      866      define input-output parameter table for UserDbAdm .
      867      define variable v-adm-Ubd-int as integer no-undo.
      868      define buffer user-login for ub.user-login.
      869      define buffer db         for ub.db.
      870      define buffer user-account-attr for ub.user-account-attr.
      871      find first user-login where user-login.db-num  eq 0
      872                              and user-login.user-id eq i-user-id
      873      no-lock no-error.
      874      if available user-login
      875      then
      876         v-adm-gbd = user-login.user-administrator.
      877      else
      878         v-adm-gbd = ?.
      879      for each userDbAdm:
      880         delete userDbAdm.
      881      end.
      882      block-db:
      883      for each db where db.db-num ne 0 no-lock:
      884         if G#db-num ne 0
      885            and G#db-num ne db.db-num
      886         then
      887            next block-db.
      888         create UserDbAdm.
      889         UserDbAdm.db-num = ub.db.db-num.
      890         find first user-login where user-login.db-num  eq db.db-num
      891                                 and user-login.user-id eq i-user-id
      892         no-lock no-error.
      893         if not available user-login
      894         then
      895            v-adm-Ubd-int = 2.
      896         else if user-login.status_ eq 1
      897         then do:
      898            v-adm-Ubd-int = 2.
      899             UserDbAdm.db-block = yes.
      900             UserDbAdm.db-usr   = yes.
      901         end.
      902         else if user-login.user-administrator
      903         then do:
      904            UserDbAdm.db-adm = yes.
      905            UserDbAdm.db-usr = yes.
      906            if v-adm-Ubd-int eq 0
      907            then
      908               v-adm-Ubd-int = 1.
      909            else if v-adm-Ubd-int eq 3
      910            then do:
      911               v-adm-Ubd-int = 2.
      912            end.
      913         end.
      914         else do:
      915            if available ub.user-login
      916            then
      917               UserDbAdm.db-usr = yes.
      918            if v-adm-Ubd-int eq 0
      919            then
      920               v-adm-Ubd-int = 3.
      921            else if v-adm-Ubd-int eq 1
      922            then do:
      923               v-adm-Ubd-int = 2.
      924            end.
      925         end.
      926      end.
      927      if  v-adm-Ubd-int eq 1
      928      then
      929         o-adm-Ubd = true.
      930      else if v-adm-Ubd-int eq 3
      931      then
      932         o-adm-Ubd = false.
      933      find first user-account-attr where user-account-attr.user-id  eq i-user-id
      934                                     and user-account-attr.attr-code  eq "superADm"
      935      no-lock no-error.
      936      o-superAdm =  available user-account-attr and logical (user-account-attr.attr-value ) no-error.
      937   end.
      938   function check_alphanumeric returns character (
      939   input ipwd as character ,
      940   input itype as character ):
      941      define variable vCharEng as character no-undo
      942      init "abcdefghijklmnopqrstuvwxyz".
      943      define variable vCharRus as character no-undo
      944      init "йцукенгшщзхъфывапролджэячсмитьбюёЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЯЧСМИТЬБЮЁЭ".
      945      define variable vi as integer no-undo.
      946      define variable vdigitFl as logical no-undo.
      947      define variable vCharEngFl as logical no-undo.
      948      define variable vCharRusFl as logical no-undo.
      949      define variable vCharSpeFl as logical no-undo.
      950      define variable vTextNew as character no-undo.
      951      define variable vTextOld as character no-undo.
      952      vTextNew = ipwd.
      953      vTextOld = vTextNew.
      954      do vi = 0 to 9:
      955         vTextNew = replace(vTextNew,string (vi),"").
      956      end.
      957      if length(vTextOld) ne length(vTextNew)
      958      then
      959         vdigitFL = yes.
      960      vTextOld = vTextNew.
      961      do vi = 1 to length(vCharEng):
      962         vTextNew = replace(vtextNew,substring(vCharEng,vi,1),"").
      963      end.
      964      if length(vTextOld) ne length(vTextNew)
      965      then
      966         vCharEngFl = yes.
      967      vTextOld = vTextNew.
      968      do vi = 1 to length(vCharRus):
      969         vTextNew = replace(vtextNew,substring(vCharRus,vi,1),"").
      970      end.
      971      if length(vTextOld) ne length(vTextNew)
      972      then
      973         vCharEngFl = yes.
      974      if length(vTextNew) > 0
      975      then
      976         vCharSpeFl = yes.
      977      define variable vReturn as character no-undo.
      978      assign
      979         vReturn = vReturn + ", " + "не содержит цифр"           when lookup ("digit",   itype) > 0 and not vdigitFl
      980         vReturn = vReturn + ", " + "не содержит латинских букв" when lookup ("CharEng", itype) > 0 and not vCharEngFl
      981         vReturn = vReturn + ", " + "не содержит русских букв"   when lookup ("CharRus", itype) > 0 and not vCharRusFl
      982         vReturn = vReturn + ", " + "не содержит спец символов"  when lookup ("CharSpe", itype) > 0 and not vCharSpeFl
      983         vReturn = vReturn + ", " + "не содержит символов"       when lookup ("Char",    itype) > 0 and not (vCharEngFl or vCharRusFl or vCharSpeFl)
      984      .
      985      vReturn = substring (vReturn,3) no-error.
      986      return vReturn.
      987   end.
      988   procedure SaveLastPWD:
      989      define input  parameter iDb-num as integer   no-undo.
      990      define input  parameter iUserId as character no-undo.
      991      define input  parameter IPWD    as character no-undo.
      992      define buffer user-login-attr  for ub.user-login-attr .
      993      find first user-login-attr where user-login-attr.db-num    eq idb-num
      994                                   and user-login-attr.user-id   eq iuserid
      995                                   and user-login-attr.attr-code eq "LastPWD"
      996      exclusive-lock no-error.
      997      if not available user-login-attr
      998      then do:
      999         create user-login-attr.
     1000         assign
     1001            user-login-attr.db-num     = idb-num
     1002            user-login-attr.user-id    = iuserid
     1003            user-login-attr.attr-code  = "LastPWD"
     1004            user-login-attr.attr-value = ipwd
     1005         .
     1006      end.
     1007      else do:
     1008         user-login-attr.attr-value = user-login.user-password-encoded + chr(5) + user-login-attr.attr-value .
     1009         if num-entries (user-login-attr.attr-value , chr(5)) > 50
     1010         then
     1011            user-login-attr.attr-value = substring (user-login-attr.attr-value,1,r-index(user-login-attr.attr-value, chr(5)) - 1).
     1012      end.
     1013   end procedure.
     1014   function  CheckLastPWD returns character  (
     1015      input  iDb-num    as integer  ,
     1016      input  iUserId    as character,
     1017      input  IPWD       as character,
     1018      input  Iadm       as logical ) :
     1019      define buffer user-login       for ub.user-login .
     1020      define buffer user-login-attr  for ub.user-login-attr .
     1021      define variable vError as character  no-undo.
     1022      define variable v-obyznumbukv as logical no-undo .
     1023      define variable v-minparol as integer no-undo .
     1024      define variable v-tth as handle no-undo .
     1025      define variable VadmSuff as character no-undo.
     1026      define variable v-param-type as character no-undo .
     1027      define variable v-value-character as character no-undo .
     1028      define variable v-value-date as date no-undo .
     1029      define variable v-value-decimal as decimal no-undo .
     1030      define variable v-value-integer as integer no-undo .
     1031      define variable v-value-logical as logical no-undo .
     1032      find first user-login where user-login.db-num    eq idb-num
     1033                              and user-login.user-id   eq iUserId
     1034      no-lock no-error.
     1035      if Iadm
     1036      then
     1037         VadmSuff = 'Adm':U.
     1038      run adm/shattri.p (
     1039           input "get":U
     1040           ,input  '':U
     1041           ,input  0
     1042           ,input  'staff':U
     1043           ,input  'minparol':U + VadmSuff
     1044           ,output v-value-character
     1045           ,output v-value-date
     1046           ,output v-value-decimal
     1047           ,output v-minparol
     1048           ,output v-value-logical
     1049           ,output v-param-type
     1050           ,input-output table-handle v-tth
     1051           )  .
     1052       if v-minparol <> 0  then do:
     1053          if length(ipwd) < v-minparol
     1054           then do:
     1055              vError = substitute ("Длина поля должна быть не менее &1" , v-minparol).
     1056           end.
     1057       end.
     1058       run adm/shattri.p (
     1059           input "get":U
     1060           ,input  '':U
     1061           ,input  0
     1062           ,input  'staff':U
     1063           ,input  'obyznumbukv':U + VadmSuff
     1064           ,output v-value-character
     1065           ,output v-value-date
     1066           ,output v-value-decimal
     1067           ,output v-value-integer
     1068           ,output v-obyznumbukv
     1069           ,output v-param-type
     1070           ,input-output table-handle v-tth
     1071           )  .
     1072      if v-obyznumbukv = true
     1073      then do:
     1074         if check_alphanumeric(ipwd,"Digit,Char") ne ""
     1075         then do:
     1076            vError = vError + (if vError eq "" then "" else ", " )
     1077                   + "В пароле должны содержаться буквы и цифры".
     1078         end.
     1079      end.
     1080      define variable v-encode-value as character no-undo.
     1081      define variable v-Lastpaswd    as integer no-undo.
     1082      run adm/pswd-enc.p
     1083         (input  encode(ipwd)
     1084         ,output v-encode-value
     1085         ).
     1086      v-encode-value = encode(v-encode-value).
     1087      run adm/shattri.p (
     1088           input "get":U
     1089           ,input  '':U
     1090           ,input  0
     1091           ,input  'staff':U
     1092           ,input  'LastPaswd':U + VadmSuff
     1093           ,output v-value-character
     1094           ,output v-value-date
     1095           ,output v-value-decimal
     1096           ,output v-Lastpaswd
     1097           ,output v-value-logical
     1098           ,output v-param-type
     1099           ,input-output table-handle v-tth
     1100           )  .
     1101      if v-Lastpaswd ne 0
     1102      then do:
     1103         define variable vLastPwd as character no-undo.
     1104         vLastPwd = GetAttrUserId(iDb-num, iUserId, "LastPWD").
     1105         if vLastPwd ne ?
     1106         then do:
     1107            define variable Vi as integer no-undo.
     1108            vi = lookup (v-encode-value,vLastPwd,chr(5)).
     1109            if     vi ne 0
     1110               and vi le v-Lastpaswd
     1111            then
     1112               vError = vError + (if vError eq "" then "" else ", " )
     1113                      + substitute ("пароль не должен совпадать с последими &1 паролями",v-Lastpaswd).
     1114         end.
     1115      end.
     1116      delete object v-tth.
     1117      return vError.
     1118   end function.
     1119   procedure availOneAdm:
     1120      define input-output parameter table for UserDbAdm.
     1121      define output parameter oAdm as logical no-undo.
     1122      find first UserDbAdm where UserDbAdm.db-adm no-lock no-error.
     1123      oadm = available UserDbAdm.
     1124   end.
     1125   procedure update-user-login:
     1126      define input  parameter i-db-num     as integer          no-undo.
     1127      define input  parameter i-user-id    as character        no-undo.
     1128      define input  parameter i-user-login as character no-undo.
     1129      define input  parameter i-max-discnt as decimal no-undo.
     1130      define input  parameter i-quest-print as logical no-undo.
     1131      define input  parameter i-encoded-pass as character no-undo.
     1132      define input  parameter i-nextcon as logical no-undo.
     1133      define input  parameter i-user-administrator as logical no-undo.
     1134      define input  parameter i-Manual     as logical no-undo.
     1135      define input  parameter i-adm-gbd as logical no-undo.
     1136      define input  parameter i-adm-ubd as logical no-undo.
     1137      define input-output parameter table for UserDbAdm.
     1138      define buffer buf_user-login        for user-login.
     1139      do
     1140   for buf_user-login
     1141   on error undo, return error
     1142   :
     1143           if     i-Manual
     1144              and G#db-num eq 0
     1145           then do:
     1146              if     i-adm-gbd ne ?
     1147              then do:
     1148                 do transaction
     1149                 on error undo, return error return-value
     1150                 :
     1151                     find first buf_user-login where buf_user-login.db-num             eq 0
     1152                                                 and buf_user-login.user-login         eq i-user-login
     1153                                                 and buf_user-login.status_            eq 0
     1154                                                 and buf_user-login.user-id            ne i-user-id
     1155                     no-lock no-error.
     1156                     if available buf_user-login
     1157                     then
     1158                        undo, return error "Уже есть такой логин в ГБД".
     1159                     find first buf_user-login where buf_user-login.db-num             = 0
     1160                                                 and buf_user-login.user-id            = i-user-id
     1161                     exclusive-lock no-error.
     1162                     if not available buf_user-login
     1163                     then do:
     1164                        create buf_user-login .
     1165                        assign
     1166                            buf_user-login.db-num             = 0
     1167                            buf_user-login.user-id            = i-user-id
     1168                            buf_user-login.status_            = 0
     1169                        .
     1170                     end.
     1171                     assign
     1172                         buf_user-login.user-login         = i-user-login
     1173                         buf_user-login.user-administrator = i-adm-gbd
     1174                         buf_user-login.max-discnt         = i-max-discnt
     1175                         buf_user-login.quest-print        = i-quest-print
     1176                         buf_user-login.user-password-encoded = i-encoded-pass
     1177                     .
     1178                     if i-nextcon ne ?
     1179                     then do:
     1180                        run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1181                     end.
     1182                     run addobj(buf_user-login.db-num,buf_user-login.user-id) no-error.
     1183                     if error-status:error
     1184                     then
     1185                        return error return-value.
     1186                 end.
     1187              end.
     1188              else do transaction on error undo, return error return-value:
     1189                  find first buf_user-login where buf_user-login.db-num             = 0
     1190                                              and buf_user-login.user-id            = i-user-id
     1191                  exclusive-lock no-error.
     1192                  if available buf_user-login
     1193                  then
     1194                     delete buf_user-login.
     1195              end.
     1196              if     i-adm-ubd ne ?
     1197              then do:
     1198                 do transaction
     1199                 on error undo, return error return-value
     1200                 :
     1201                     define variable vDbError as character no-undo.
     1202                     block-db:
     1203                     for each db where db.db-num ne 0
     1204                     no-lock:
     1205                        find first buf_user-login where buf_user-login.db-num             eq db.db-num
     1206                                                    and buf_user-login.user-login         eq i-user-login
     1207                                                    and buf_user-login.status_            eq 0
     1208                                                    and buf_user-login.user-id            ne i-user-id
     1209                        no-lock no-error.
     1210                        if available buf_user-login
     1211                        then do:
     1212                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1213                           next block-db.
     1214                        end.
     1215                        find first buf_user-login where buf_user-login.db-num             = db.db-num
     1216                                                    and buf_user-login.user-id            = i-user-id
     1217                        exclusive-lock no-error.
     1218                        if not available buf_user-login
     1219                        then do:
     1220                           create buf_user-login .
     1221                           assign
     1222                               buf_user-login.db-num             = db.db-num
     1223                               buf_user-login.user-id            = i-user-id
     1224                               buf_user-login.status_            = 0
     1225                               buf_user-login.user-password-encoded = i-encoded-pass
     1226                           .
     1227                        end.
     1228                        assign
     1229                            buf_user-login.status_            = 0 when i-db-num ne G#db-num
     1230                            buf_user-login.user-login         = i-user-login
     1231                            buf_user-login.user-administrator = i-adm-ubd
     1232                            buf_user-login.max-discnt         = i-max-discnt
     1233                            buf_user-login.quest-print        = i-quest-print
     1234                        .
     1235                        if i-nextcon ne ?
     1236                        then do:
     1237                           run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1238                        end.
     1239                        run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1240                        if error-status:error
     1241                        then
     1242                           return error return-value.
     1243                    end.
     1244                    if vDbError ne ""
     1245                    then
     1246                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1247                 end.
     1248              end.
     1249              else do:
     1250                 do transaction
     1251                 on error undo, return error return-value
     1252                 :
     1253                     block-UserDb:
     1254                     for each UserDbAdm where UserDbAdm.db-num ne 0
     1255                     no-lock:
     1256                        find first buf_user-login where buf_user-login.db-num             eq UserDbAdm.db-num
     1257                                                    and buf_user-login.user-login         eq i-user-login
     1258                                                    and buf_user-login.status_            eq 0
     1259                                                    and buf_user-login.user-id            ne i-user-id
     1260                        no-lock no-error.
     1261                        if available buf_user-login and UserDbAdm.db-usr
     1262                        then do:
     1263                           vDbError = vDbError + "," + String(db.db-num) no-error.
     1264                           next block-UserDb.
     1265                        end.
     1266                        find first buf_user-login where buf_user-login.db-num             = UserDbAdm.db-num
     1267                                                    and buf_user-login.user-id            = i-user-id
     1268                        exclusive-lock no-error.
     1269                        if UserDbAdm.db-usr
     1270                        then do:
     1271                           if not available buf_user-login
     1272                           then do:
     1273                              create buf_user-login .
     1274                              assign
     1275                                  buf_user-login.db-num             = UserDbAdm.db-num
     1276                                  buf_user-login.user-id            = i-user-id
     1277                                  buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0
     1278                                  buf_user-login.user-password-encoded = i-encoded-pass
     1279                              .
     1280                           end.
     1281                           assign
     1282                               buf_user-login.status_            = if UserDbAdm.db-block then 1 else 0 when i-db-num ne G#db-num or G#db-num = 0
     1283                               buf_user-login.user-login         = i-user-login
     1284                               buf_user-login.user-administrator = UserDbAdm.db-adm
     1285                               buf_user-login.max-discnt         = i-max-discnt
     1286                               buf_user-login.quest-print        = i-quest-print
     1287                           .
     1288                           if i-nextcon ne ?
     1289                           then do:
     1290                              run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1291                           end.
     1292                           if UserDbAdm.db-adm
     1293                           then do:
     1294                              run addobj(buf_user-login.db-num,buf_user-login.user-id)no-error.
     1295                              if error-status:error
     1296                              then
     1297                                 undo, return error return-value.
     1298                           end.
     1299                       end.
     1300                       else do:
     1301                          if available buf_user-login
     1302                          then do:
     1303                             define variable vok as logical no-undo.
     1304                             run procedure-user-login-delete-question (UserDbAdm.db-num,i-user-id, no, output vok).
     1305                             if not vok
     1306                             then
     1307                                undo, return error return-value.
     1308                          end.
     1309                       end.
     1310                    end.
     1311                     if vDbError ne ""
     1312                     then
     1313                       undo, return error substitute ("Уже есть такой логин в УБД &1",substring (vDbError,2,4000)).
     1314                 end.
     1315              end.
     1316           end.
     1317           else do transaction
     1318           on error undo, return error return-value
     1319           :
     1320              find first buf_user-login where buf_user-login.db-num             = i-db-num
     1321                                          and buf_user-login.user-id            = i-user-id
     1322              exclusive-lock no-error.
     1323              if not available buf_user-login
     1324              then do:
     1325                 create buf_user-login .
     1326                 assign
     1327                    buf_user-login.db-num             = i-db-num
     1328                    buf_user-login.user-id            = i-user-id
     1329                    buf_user-login.status_            = 0
     1330                 .
     1331              end.
     1332              assign
     1333                   buf_user-login.user-login         = i-user-login
     1334                   buf_user-login.user-administrator = i-user-administrator
     1335                   buf_user-login.max-discnt         = i-max-discnt
     1336                   buf_user-login.quest-print        = i-quest-print
     1337                   buf_user-login.user-password-encoded = i-encoded-pass
     1338               .
     1339               if i-user-administrator
     1340               then
     1341                  run addobj(buf_user-login.db-num,buf_user-login.user-id).
     1342               if i-nextcon ne ?
     1343               then do:
     1344                  run SetAttrUserId(buf_user-login.db-num, buf_user-login.user-id, "ChangPwdNextConect", string(i-nextcon )).
     1345               end.
     1346           end.
     1347       end.
     1348   end procedure.
     1349   procedure addobj:
     1350      define input  parameter i-db-num as integer no-undo.
     1351      define input  parameter i-user-id as character no-undo.
     1352      define buffer buf_user-obj     for ub.user-obj.
     1353      define buffer buf_clients      for ub.clients.
     1354      if i-db-num <> 0 then do:
     1355          for each buf_clients
     1356              where buf_clients.db-num = i-db-num
     1357              and ( buf_clients.obj-type = 'маг':U
     1358                 or buf_clients.obj-type = 'скл':U
     1359                  )
     1360              no-lock:
     1361             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1362                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1363                                     and buf_user-obj.user-id      = i-user-id
     1364                                     and buf_user-obj.db-num       = i-db-num
     1365                                   no-lock)
     1366                                   then next.
     1367             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1368          end.
     1369       end.
     1370       else do:
     1371          for each buf_clients
     1372              where
     1373                  ( buf_clients.obj-type = 'маг':U
     1374                 or buf_clients.obj-type = 'скл':U
     1375                  )
     1376              no-lock:
     1377             if can-find (buf_user-obj where buf_user-obj.obj-type = buf_clients.obj-type
     1378                                     and buf_user-obj.obj-code     = buf_clients.obj-code
     1379                                     and buf_user-obj.user-id      = i-user-id
     1380                                     and buf_user-obj.db-num       = i-db-num
     1381                                   no-lock)
     1382                                   then next.
     1383             run enbl-obj (i-db-num, i-user-id, buf_clients.obj-type, buf_clients.obj-code).
     1384          end.
     1385       end.
     1386   end.
     1387   procedure enbl-obj :
     1388      define input  parameter i-db-num  as integer   no-undo.
     1389      define input  parameter i-user-id as character no-undo.
     1390      define input  parameter i-type    as character no-undo.
     1391      define input  parameter i-code    as integer   no-undo.
     1392       define variable v-host-code    as integer      no-undo.
     1393       define variable v-host-name    as character    no-undo.
     1394       define variable v-base-code    as integer      no-undo.
     1395       define buffer buf_user-obj      for ub.user-obj.
     1396       define buffer buf_user-host     for ub.user-host.
     1397       define buffer buf_clients       for ub.clients.
     1398   do
     1399   for buf_user-obj
     1400     , buf_user-host
     1401     , buf_clients
     1402   on error undo, return error
     1403   :
     1404       find first buf_user-obj exclusive-lock
     1405            where buf_user-obj.db-num    = i-db-num
     1406              and buf_user-obj.user-id   = i-user-id
     1407              and buf_user-obj.obj-type  = i-type
     1408              and buf_user-obj.obj-code  = i-code
     1409       no-error.
     1410       if not available buf_user-obj
     1411       then do:
     1412           find first buf_clients no-lock
     1413                where buf_clients.obj-type = i-type
     1414                  and buf_clients.obj-code = i-code
     1415           .
     1416   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1418     (input  i-type
     1419     ,input  i-code
     1420     ,output v-host-code
     1421     ,output v-host-name
     1422     )  .
     1423   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1425     (input  v-host-code
     1426     ,output v-base-code
     1427     )  .
     1428           create buf_user-obj.
     1429           assign
     1430               buf_user-obj.db-num    = i-db-num
     1431               buf_user-obj.user-id   = i-user-id
     1432               buf_user-obj.obj-type  = i-type
     1433               buf_user-obj.obj-code  = i-code
     1434               buf_user-obj.host-code = v-host-code
     1435           .
     1436           find first buf_user-host exclusive-lock
     1437                where buf_user-host.db-num    = i-db-num
     1438                  and buf_user-host.user-id   = i-user-id
     1439                  and buf_user-host.host-code = v-host-code
     1440           no-error.
     1441           if not available buf_user-host
     1442           then do:
     1443               create buf_user-host.
     1444               assign
     1445                   buf_user-host.db-num    = i-db-num
     1446                   buf_user-host.user-id   = i-user-id
     1447                   buf_user-host.host-code = v-host-code
     1448               .
     1449           end.
     1450      end.
     1451   end.
     1452   end procedure.
     1453   procedure procedure-user-login-change-password :
     1454      define input  parameter p-db-num         as integer          no-undo.
     1455      define input  parameter p-user-id        as character        no-undo.
     1456      define input  parameter iChange          as logical          no-undo.
     1457      define variable v-can-edit         as logical   no-undo .
     1458      define variable v-encoded-pass     as character no-undo .
     1459      define variable v-encoded-pass-old as character no-undo .
     1460      define variable v-nextcon          as logical   no-undo .
     1461      define variable VadmSuff           as character no-undo.
     1462      define variable vChange as logical no-undo.
     1463      define variable v-param-type as character no-undo .
     1464      define variable v-value-character as character no-undo .
     1465      define variable v-value-date as date no-undo .
     1466      define variable v-value-decimal as decimal no-undo .
     1467      define variable v-value-integer as integer no-undo .
     1468      define variable v-value-logical as logical no-undo .
     1469      define variable v-tth           as handle  no-undo .
     1470      define buffer buf_lock_user-login for user-login.
     1471      define buffer buf_init_user-account for user-account.
     1472      do:
     1473         find first buf_lock_user-login no-lock
     1474                 where buf_lock_user-login.db-num  = p-db-num
     1475                   and buf_lock_user-login.user-id = p-user-id
     1476         no-error.
     1477         if not available buf_lock_user-login then do:
     1478            message
     1479               "Нельзя редактировать пароль пока не заведен логин для пользователя" skip
     1480               view-as alert-box error .
     1481               undo, return error "Нельзя редактировать пароль пока не заведен логин для пользователя" .
     1482         end.
     1483         vChange = buf_lock_user-login.user-login eq userid ("ub") or iChange.
     1484         if     available buf_lock_user-login
     1485            and buf_lock_user-login.user-administrator
     1486         then
     1487            VadmSuff = 'Adm':U.
     1488         define variable v-TimeAvail as integer no-undo.
     1489         define variable v-DateChg   as date    no-undo.
     1490         define variable v-Time      as integer no-undo.
     1491         run cur-time-mjd-to-date (buf_lock_user-login.user-password-set-mjd, output v-DateChg, output v-Time).
     1492         run adm/shattri.p (
     1493              input "get":U
     1494              ,input  '':U
     1495              ,input  0
     1496              ,input  'staff':U
     1497              ,input  'TimeBlock':U + VadmSuff
     1498              ,output v-value-character
     1499              ,output v-value-date
     1500              ,output v-value-decimal
     1501              ,output v-TimeAvail
     1502              ,output v-value-logical
     1503              ,output v-param-type
     1504              ,input-output table-handle v-tth
     1505              )  .
     1506         if     not iChange
     1507            and v-TimeAvail ne 0
     1508            and v-DateChg + v-TimeAvail < today
     1509         then do:
     1510            do trans:
     1511               find current buf_lock_user-login exclusive-lock.
     1512               buf_lock_user-login.status_ = 1.
     1513            end.
     1514            return error "Ваша учетная запись заблокирована." .
     1515         end.
     1516         run adm/shattri.p (
     1517              input "get":U
     1518              ,input  '':U
     1519              ,input  0
     1520              ,input  'staff':U
     1521              ,input  'TimeAvail':U + VadmSuff
     1522              ,output v-value-character
     1523              ,output v-value-date
     1524              ,output v-value-decimal
     1525              ,output v-TimeAvail
     1526              ,output v-value-logical
     1527              ,output v-param-type
     1528              ,input-output table-handle v-tth
     1529              )  .
     1530         delete object v-tth.
     1531         define variable vfl as logical no-undo.
     1532         vfl = logical(GetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect")) no-error.
     1533         if    vfl eq yes
     1534            or (     v-TimeAvail ne 0
     1535                 and v-DateChg + v-TimeAvail < today)
     1536            or iChange
     1537         then do:
     1538             find first buf_init_user-account where buf_init_user-account.user-id = buf_lock_user-login.user-id
     1539             no-lock.
     1540             assign
     1541             v-encoded-pass-old = buf_lock_user-login.user-password-encoded
     1542             v-encoded-pass     = buf_lock_user-login.user-password-encoded.
     1543             do while v-encoded-pass = v-encoded-pass-old or v-encoded-pass eq ?:
     1544                v-encoded-pass = v-encoded-pass-old.
     1545                run adm/chg-pswd.w ( input  this-procedure
     1546                                   , input  p-db-num
     1547                                   , input  buf_lock_user-login.user-id
     1548                                   , input  buf_lock_user-login.user-login
     1549                                   , input  substitute('&1 &2 &3':U, buf_init_user-account.last-name
     1550                                                                   , buf_init_user-account.first-name
     1551                                                                   , buf_init_user-account.second-name
     1552                                          )
     1553                                   , input  iChange
     1554                                   , input  yes
     1555                                   , input  buf_lock_user-login.user-password-encoded
     1556                                   , input  yes
     1557                                   , input  buf_lock_user-login.user-administrator
     1558                                   , output v-encoded-pass
     1559                                   , output v-nextcon
     1560                                   ) no-error .
     1561               if error-status :error
     1562               then do:
     1563                 message
     1564                    vss-workfile vss-revision vss-description skip
     1565                    "Ошибка при вызове процедуры" 'adm/chg-pswd.w':U skip
     1566                    error-status :get-message(1) skip
     1567                    return-value skip
     1568                    view-as alert-box error .
     1569                 undo, return error return-value .
     1570                end.
     1571                if    v-encoded-pass = v-encoded-pass-old
     1572                then do:
     1573                    message
     1574                       vss-workfile vss-revision vss-description skip
     1575                       "Старый пароль и новый равны. Смените пароль.":U skip
     1576                       error-status :get-message(1) skip
     1577                       return-value skip
     1578                       view-as alert-box error .
     1579                end.
     1580                else if v-encoded-pass eq ?
     1581                then do:
     1582                   message  "Отказ от смены пароля. Работа дальше не возможна"
     1583                   view-as alert-box error.
     1584                   return error "Отказ от смены пароля. Работа дальше не возможна".
     1585                end.
     1586             end.
     1587             if v-encoded-pass <> ? then
     1588             do trans:
     1589                find current buf_lock_user-login
     1590                      exclusive-lock
     1591                   .
     1592                assign
     1593                   buf_lock_user-login.user-password-encoded = v-encoded-pass
     1594                .
     1595                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdNextConect", if vChange then v-nextcon else ?).
     1596                run SetAttrUserId(buf_lock_user-login.db-num, buf_lock_user-login.user-id, "ChangPwdUserId", string(g#userid)).
     1597                release buf_lock_user-login .
     1598                message
     1599                   "Пароль успешно изменен"
     1600                   view-as alert-box information
     1601                .
     1602             end.
     1603          end.
     1604      end.
     1605   end procedure.
     1606   procedure procedure-user-login-delete :
     1607      define input  parameter i-db-num     as integer          no-undo.
     1608      define input  parameter i-user-id    as character        no-undo.
     1609      define output parameter o-deleted   as logical          no-undo.
     1610      run procedure-user-login-delete-question (i-db-num,i-user-id,yes,output o-deleted).
     1611   end.
     1612   procedure procedure-user-login-delete-question :
     1613   define input  parameter i-db-num     as integer          no-undo.
     1614   define input  parameter i-user-id    as character        no-undo.
     1615   define input  parameter i-question as logical no-undo.
     1616   define output parameter o-deleted   as logical          no-undo.
     1617     define variable v-can-edit as logical   no-undo .
     1618       define buffer buf_user-login         for user-login .
     1619       define buffer buf_user-account       for user-account.
     1620       define buffer buf_init_user-account  for user-account.
     1621   do
     1622   for buf_user-login
     1623     , buf_user-account
     1624   on error undo, return error return-value
     1625   :
     1626       assign
     1627           o-deleted = no
     1628       .
     1629       find first buf_init_user-account no-lock
     1630            where buf_init_user-account.user-id = i-user-id
     1631           .
     1632       if available buf_init_user-account
     1633       then do:
     1634         do transaction
     1635         on error undo, return error return-value
     1636         :
     1637           run can-edit-login in this-procedure (
     1638                 input  i-db-num
     1639               , output v-can-edit
     1640           ).
     1641           if v-can-edit <> true
     1642           then do:
     1643             message
     1644               "Нельзя удалять логин пользователя для базы" i-db-num
     1645             view-as alert-box error .
     1646             undo, return error return-value .
     1647           end.
     1648           find first buf_user-login exclusive-lock
     1649                where buf_user-login.db-num  = i-db-num
     1650                  and buf_user-login.user-id = i-user-id
     1651           no-error no-wait.
     1652           if not available buf_user-login
     1653           then do:
     1654             if locked( buf_user-login )
     1655             then do:
     1656               find first buf_user-login no-lock
     1657                    where buf_user-login.db-num  = i-db-num
     1658                      and buf_user-login.user-id = i-user-id
     1659               .
     1660               message
     1661                 "Удаление логина невозможно" skip
     1662                 "Пользователь в данный момент работает в системе" skip
     1663                 "БД" i-db-num skip
     1664                 "Идентификатор" i-user-id skip
     1665                 "Псевдоним"                    buf_init_user-account.nik skip
     1666                 "Имя пользователя"             buf_init_user-account.last-name buf_init_user-account.first-name buf_init_user-account.second-name skip
     1667                 "Компьютер"                    buf_user-login.last-login-computer-name skip
     1668                 "Пользователь компьютера"      buf_user-login.last-login-computer-user skip
     1669                 "TCP имя компьютера"           buf_user-login.last-login-computer-tcp-name skip
     1670                 "IP адрес компьютера"          buf_user-login.last-login-computer-ip-addr skip
     1671                 "Идентификатор процесса"       buf_user-login.last-login-process-id skip
     1672                 "Номер подключения к БД"       buf_user-login.last-login-connection-id skip
     1673                 "Дата и время входа в систему" sys-time_mjd-to-loc-str-func( buf_user-login.last-login-mjd ) skip
     1674                 view-as alert-box error .
     1675             end.
     1676             else do:
     1677               message
     1678                 "У пользователя нет логина" skip
     1679                 "БД" i-db-num skip
     1680                 "Идентификатор" i-user-id skip
     1681                 "Удаление невозможно" skip
     1682                 view-as alert-box error .
     1683             end.
     1684             undo, return error return-value .
     1685           end.
     1686           define variable v-ok as logical   no-undo .
     1687           if not i-question
     1688           then
     1689              v-ok = yes.
     1690           else do:
     1691              find first buf_user-account no-lock
     1692                   where buf_user-account.user-id = buf_user-login.user-id
     1693              .
     1694              message
     1695                "Удаление логина пользователя"
     1696                skip "Идентификатор" buf_user-account.user-id
     1697                skip "Псевдоним"    buf_user-account.nik
     1698                skip "Пользователь" buf_user-account.last-name buf_user-account.first-name buf_user-account.second-name
     1699                skip "Логин для базы данных" buf_user-login.db-num
     1700                skip "Логин" buf_user-login.user-login
     1701                skip (1)
     1702                "После удаления пользователь не сможет работать в базе данных" buf_user-login.db-num skip
     1703                skip (1)
     1704                "Продолжить?"
     1705              view-as alert-box question
     1706              buttons yes-no
     1707              update v-ok .
     1708           end.
     1709           if v-ok = yes
     1710           then do:
     1711               run str/usrlog03.p (
     1712                     input buf_user-login.db-num
     1713                   , input buf_user-login.user-id
     1714               ).
     1715               assign
     1716                   o-deleted = yes
     1717               .
     1718           end.
     1719         end.
     1720       end.
     1721     end.
     1722   end procedure.
     1723   define buffer buf_user-login   for ub.user-login .
     1724   define buffer buf_c-user-login for ub.c-user-login .
     1725   define buffer buf_c-usr-hist   for ub.c-usr-hist .
     1726   main-block:
     1727   do transaction
     1728   on error   undo main-block, return error substitute('userlgnd error main-block,&1', return-value )
     1729   on end-key undo main-block, return error substitute('userlgnd end-key main-block,&1', return-value )
     1730   :
     1731     if ub.user-login.db-num = g#db-num
     1732     then do:
     1733       if  not new(ub.user-login)
     1734       and old-user-login.status_ = 0
     1735       then do:
     1736         find first ub._user exclusive-lock
     1737           where ub._user._userid = old-user-login.user-login
     1738           no-error .
     1739         if not available ub._user
     1740         then do:
     1741            ub.user-login.status_                    = 1.
     1742         end.
     1743         else
     1744            delete ub._user .
     1745       end.
     1746   DEFINE TEMP-TABLE tempUser NO-UNDO LIKE
     1747   ub._User
     1748   .
     1749   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1750       if ub.user-login.status_ = 0
     1751       then do:
     1752         find first ub.user-account
     1753              where ub.user-account.user-id = ub.user-login.user-id
     1754              no-lock
     1755              no-error .
     1756         if not available ub.user-account
     1757         then do:
     1758           create ub.user-account.
     1759           assign
     1760               ub.user-account.user-id               = ub.user-login.user-id
     1761               ub.user-account.status_               = 0
     1762               ub.user-account.first-name            = '':U
     1763               ub.user-account.second-name           = '':U
     1764               ub.user-account.last-name             = ub.user-login.user-login
     1765               ub.user-account.nik                   = ub.user-login.user-login
     1766               ub.user-account.company               = '':U
     1767               ub.user-account.department            = '':U
     1768               ub.user-account.e-mail                = '':U
     1769               ub.user-account.internal-phone-number = '':U
     1770               ub.user-account.mobile-phone-number   = '':U
     1771               ub.user-account.phone-number          = '':U
     1772               ub.user-account.position              = '':U
     1773               ub.user-account.PS                    = '':U
     1774               ub.user-account.room                  = '':U
     1775               ub.user-account.parent-user-id        = '':U
     1776               ub.user-account.check-parent          = false
     1777           .
     1778         end.
     1779         else
     1780            ub.user-login.status_ = ub.user-account.status_.
     1781      end.
     1782      if ub.user-login.status_ = 0
     1783      then do:
     1784         find first ub._user
     1785              where ub._user._userid    = ub.user-login.user-login
     1786              no-error
     1787              .
     1788         if not available ub._user then do:
     1789            create ub._user .
     1790            assign
     1791               ub._user._userid    = ub.user-login.user-login
     1792               ub._user._password  = ub.user-login.user-password-encoded
     1793            .
     1794         end.
     1795         ELSE DO:
     1796            BUFFER-COPY ub._User EXCEPT ub._User._Password ub._User._TenantId TO tempUser ASSIGN tempUser._Password = ub.user-login.user-password-encoded
     1797            .
     1798            DELETE ub._User.
     1799            CREATE ub._User.
     1800            BUFFER-COPY tempUser EXCEPT tempUser._TenantId TO _User.
     1801         END.
     1802         assign
     1803           ub._user._user-name = substitute('&1 &2 &3'
     1804                                           ,ub.user-account.last-name
     1805                                           ,ub.user-account.first-name
     1806                                           ,ub.user-account.second-name
     1807                                           )
     1808         .
     1809         release _user.
     1810       end.
     1811     end.
     1812     define variable v-chip-num as integer   no-undo .
     1813     define variable v-today    as date      no-undo .
     1814     define variable v-time     as integer   no-undo .
     1815     run cur-time in this-procedure
     1816       (output v-today
     1817       ,output v-time
     1818       ) .
     1819     assign
     1820       v-chip-num = next-value(s-usr-chip)
     1821     .
     1822     create buf_c-user-login .
     1823     buffer-copy old-user-login except db-num user-id to buf_c-user-login
     1824     assign
     1825       buf_c-user-login.db-num           = ub.user-login.db-num
     1826       buf_c-user-login.user-id          = ub.user-login.user-id
     1827       buf_c-user-login.corr-date        = v-today
     1828       buf_c-user-login.corr-time        = v-time
     1829       buf_c-user-login.corr-user-db-num = g#db-num
     1830       buf_c-user-login.corr-user-name   = (if g#news then (chr(4) +  'СПН':U) else g#userid)
     1831       buf_c-user-login.chip-num         = v-chip-num
     1832     NO-ERROR.
     1833     IF ERROR-STATUS :ERROR
     1834     THEN DO:
     1835        undo main-block, RETURN ERROR SUBSTITUTE( "&1. &2&3&4", vss-workfile , RETURN-VALUE, chr(10), ERROR-STATUS:GET-MESSAGE(1)).
     1836     END.
     1837     buffer-copy buf_c-user-login to buf_c-usr-hist
     1838     assign
     1839       buf_c-usr-hist.subject = 'user-login':U
     1840       buf_c-usr-hist.action  = (if new(ub.user-login) then integer('1':U) else integer('2':U))
     1841       buf_c-usr-hist.is-news = g#news
     1842       buf_c-usr-hist.source-type = (if g#news then 'db':U else "":U)
     1843       buf_c-usr-hist.source-ref  = (if g#news then string(g#news-source-db) else "":U)
     1844     .
     1845       if AVAILABLE ub.user-login then do:
     1846           if AVAILABLE buf_c-user-login then do:
     1847               if ub.user-login.last-login-mjd <> buf_c-user-login.last-login-mjd then do:
     1848                   run trg/userlog.p (
     1849                         input 'update':U
     1850                       , input 'c-usr-hist':U
     1851                       , input ( buffer buf_c-usr-hist :handle )
     1852                       , input ?
     1853                       , input ""
     1854                   ) no-error.
     1855                   if error-status :error
     1856                   then do:
     1857                       undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     1858                                           , chr(10)
     1859                                           , vss-workfile
     1860                                           , return-value
     1861                                           , error-status :get-message ( 1 ) ).
     1862                   end.
     1863               end.
     1864           end.
     1865       end.
     1866       if new(ub.user-login)
     1867       then
     1868          run trg/userlog.p (
     1869                         input 'create':U
     1870                       , input 'c-user-login':U
     1871                       , input ( buffer buf_c-user-login :handle )
     1872                       , input ?
     1873                       , input ""
     1874                   ) no-error.
     1875       else if ub.user-login.user-login ne old-user-login.user-login
     1876       then
     1877          run trg/userlog.p (
     1878                         input 'update':U
     1879                       , input 'c-user-login':U
     1880                       , input ( buffer buf_c-user-login :handle )
     1881                       , input ?
     1882                       , input ""
     1883                   ) no-error.
     1884       if ub.user-login.user-administrator ne old-user-login.user-administrator
     1885       then
     1886          run trg/userlog.p (
     1887                         input if ub.user-login.user-administrator then 'create':U else 'delete':U
     1888                       , input 'c-user-login':U + chr(3) + "adm"
     1889                       , input ( buffer buf_c-user-login :handle )
     1890                       , input ?
     1891                       , input ""
     1892                   ) no-error.
     1893       if     old-user-login.user-password-encoded ne user-login.user-password-encoded
     1894       then do:
     1895          run SaveLastPWD(ub.user-login.db-num,
     1896                          ub.user-login.user-id,
     1897                          ub.user-login.user-password-encoded).
     1898          if    old-user-login.user-password-set-mjd eq user-login.user-password-set-mjd
     1899          then do:
     1900             user-login.user-password-set-mjd = cur-time-mjd().
     1901          end.
     1902             run trg/userlog.p (
     1903                         input 'update':U
     1904                       , input 'c-user-login':U + chr(3) + "user-password"
     1905                       , input ( buffer buf_c-user-login :handle )
     1906                       , input ?
     1907                       , input ""
     1908                   ) no-error.
     1909                   if error-status :error
     1910                   then do:
     1911                       undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     1912                                           , chr(10)
     1913                                           , vss-workfile
     1914                                           , return-value
     1915                                           , error-status :get-message ( 1 ) ).
     1916                   end.
     1917       end.
     1918     run str/callnews.p
     1919       (input 'user-login':U
     1920       ,input (buffer ub.user-login :handle)
     1921       ) no-error .
     1922     if error-status:error then do:
     1923       undo main-block,  return error return-value .
     1924     end.
     1925       if g#oxml = yes
     1926       then do:
     1927          run str/calloxml.p (
     1928                input 'update':U
     1929              , input 'user-login':U
     1930              , input ( buffer ub.user-login:handle )
     1931          ) no-error.
     1932          if error-status :error
     1933          then do:
     1934              undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1935                                   , chr(10)
     1936                                   , vss-workfile
     1937                                   , return-value
     1938                                   , error-status :get-message ( 1 ) ).
     1939          end.
     1940      end.
     1941   end.
