        1   block-level on error undo, throw.
        2   trigger procedure for write of ub.user-login old buffer old-user-login .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись таблицы user-login".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define temp-table UserDbAdm
      304   field db-num as integer
      305   field db-adm as logical
      306   field db-usr as logical
      307   field db-block as logical
      308   index pi is unique db-num
      309   index adm db-adm db-usr
      310   .
      311   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   procedure sys-time_get-sys :
      314     define output parameter p-year         as integer   no-undo .
      315     define output parameter p-month        as integer   no-undo .
      316     define output parameter p-day          as integer   no-undo .
      317     define output parameter p-hour         as integer   no-undo .
      318     define output parameter p-minute       as integer   no-undo .
      319     define output parameter p-second       as integer   no-undo .
      320     define output parameter p-milliseconds as integer   no-undo .
      321     define variable v-system-time-structure as memptr    no-undo.
      322     do
      323     on error undo, return error return-value
      324     :
      325       assign
      326         set-size(v-system-time-structure) = 16
      327       .
      328       run GetSystemTime
      329         (input  get-pointer-value(v-system-time-structure)
      330         ) .
      331       assign
      332         p-year         = get-short(v-system-time-structure,  1)
      333         p-month        = get-short(v-system-time-structure,  3)
      334         p-day          = get-short(v-system-time-structure,  7)
      335         p-hour         = get-short(v-system-time-structure,  9)
      336         p-minute       = get-short(v-system-time-structure, 11)
      337         p-second       = get-short(v-system-time-structure, 13)
      338         p-milliseconds = get-short(v-system-time-structure, 15)
      339       .
      340       assign
      341         set-size(v-system-time-structure) = 0
      342       .
      343     end.
      344   end procedure.
      345   procedure sys-time_get-comp-user-name :
      346     define output parameter p-computer-name as character no-undo .
      347     define output parameter p-user-name     as character no-undo .
      348     define output parameter p-process-pid   as integer   no-undo .
      349     define variable v-return-value  as integer   no-undo .
      350     define variable v-buffer-length as integer   no-undo .
      351     define variable v-buffer-memptr as memptr    no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       assign
      356         v-buffer-length = 1024
      357         set-size(v-buffer-memptr) = v-buffer-length + 4
      358       .
      359       assign
      360         put-long(v-buffer-memptr, 1) = v-buffer-length
      361       .
      362       run GetComputerNameA
      363         (input  get-pointer-value(v-buffer-memptr) + 4
      364         ,input  get-pointer-value(v-buffer-memptr)
      365         ,output v-return-value
      366         ) .
      367       if v-return-value <> 0
      368       then do:
      369         assign
      370           p-computer-name = get-string(v-buffer-memptr, 5)
      371         .
      372       end.
      373       assign
      374         put-long(v-buffer-memptr, 1) = v-buffer-length
      375       .
      376       run GetUserNameA
      377         (input  get-pointer-value(v-buffer-memptr) + 4
      378         ,input  get-pointer-value(v-buffer-memptr)
      379         ,output v-return-value
      380         ) .
      381       if v-return-value <> 0
      382       then do:
      383         assign
      384           p-user-name = get-string(v-buffer-memptr, 5)
      385         .
      386       end.
      387       run GetCurrentProcessId
      388         (output p-process-pid
      389         ) .
      390       assign
      391         set-size(v-buffer-memptr) = 0
      392       .
      393     end.
      394   end procedure.
      395   procedure sys-time_get-http :
      396     define output parameter p-http-time as character no-undo .
      397     define variable v-year         as integer   no-undo .
      398     define variable v-month        as integer   no-undo .
      399     define variable v-day-of-week  as integer   no-undo .
      400     define variable v-day          as integer   no-undo .
      401     define variable v-hour         as integer   no-undo .
      402     define variable v-minute       as integer   no-undo .
      403     define variable v-second       as integer   no-undo .
      404     define variable v-milliseconds as integer   no-undo .
      405     do
      406     on error undo, return error return-value
      407     :
      408       run sys-time_get-sys in this-procedure
      409         (output v-year
      410         ,output v-month
      411         ,output v-day
      412         ,output v-hour
      413         ,output v-minute
      414         ,output v-second
      415         ,output v-milliseconds
      416         ) .
      417       assign
      418         v-day-of-week = weekday(date(v-month, v-day, v-year))
      419         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      420                     + ', ':u
      421                     + string(v-day, '99':u)
      422                     + ' ':u
      423                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      424                     + ' ':u
      425                     + string(v-year, '9999':u)
      426                     + ' ':u
      427                     + string(v-hour, '99':u)
      428                     + ':':u
      429                     + string(v-minute, '99':u)
      430                     + ':':u
      431                     + string(v-second, '99':u)
      432                     + ' ':u
      433                     + 'GMT':u
      434       .
      435     end.
      436   end procedure.
      437   procedure sys-time_set-sys :
      438     define input  parameter p-year         as integer   no-undo .
      439     define input  parameter p-month        as integer   no-undo .
      440     define input  parameter p-day          as integer   no-undo .
      441     define input  parameter p-hour         as integer   no-undo .
      442     define input  parameter p-minute       as integer   no-undo .
      443     define input  parameter p-second       as integer   no-undo .
      444     define input  parameter p-milliseconds as integer   no-undo .
      445     define variable v-system-time-structure as memptr    no-undo.
      446     define variable v-return-value as integer   no-undo .
      447     define variable v-day-of-week  as integer   no-undo .
      448     do
      449     on error undo, return error return-value
      450     :
      451       assign
      452         v-day-of-week = weekday(date(p-month, p-day, p-year))
      453       .
      454       assign
      455         set-size(v-system-time-structure) = 16
      456       .
      457       assign
      458         put-short(v-system-time-structure,  1) = p-year
      459         put-short(v-system-time-structure,  3) = p-month
      460         put-short(v-system-time-structure,  5) = v-day-of-week
      461         put-short(v-system-time-structure,  7) = p-day
      462         put-short(v-system-time-structure,  9) = p-hour
      463         put-short(v-system-time-structure, 11) = p-minute
      464         put-short(v-system-time-structure, 13) = p-second
      465         put-short(v-system-time-structure, 15) = p-milliseconds
      466       .
      467       run SetSystemTime
      468         (input  get-pointer-value(v-system-time-structure)
      469         ,output v-return-value
      470         ) .
      471       assign
      472         set-size(v-system-time-structure) = 0
      473       .
      474       if v-return-value = 0
      475       then do:
      476         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      477       end.
      478     end.
      479   end procedure.
      480   procedure sys-time_sys-to-mjd :
      481     define input  parameter p-year         as integer   no-undo .
      482     define input  parameter p-month        as integer   no-undo .
      483     define input  parameter p-day          as integer   no-undo .
      484     define input  parameter p-hour         as integer   no-undo .
      485     define input  parameter p-minute       as integer   no-undo .
      486     define input  parameter p-second       as integer   no-undo .
      487     define input  parameter p-milliseconds as integer   no-undo .
      488     define output parameter p-mjd          as decimal   no-undo .
      489     define variable v-year-correction as decimal   no-undo .
      490     define variable v-shift-year as decimal   no-undo .
      491     do
      492     on error undo, return error return-value
      493     :
      494       assign
      495         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      496         v-shift-year      = decimal(p-year) + v-year-correction
      497         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      498               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      499               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      500               + decimal(p-day) - 2432076.0
      501               + p-hour / 24.0
      502               + p-minute / 1440.0
      503               + p-second / 86400.0
      504               + p-milliseconds / 86400000.0
      505       .
      506     end.
      507   end procedure.
      508   procedure sys-time_sys-to-loc :
      509     define input  parameter p-sys-year         as integer   no-undo .
      510     define input  parameter p-sys-month        as integer   no-undo .
      511     define input  parameter p-sys-day          as integer   no-undo .
      512     define input  parameter p-sys-hour         as integer   no-undo .
      513     define input  parameter p-sys-minute       as integer   no-undo .
      514     define input  parameter p-sys-second       as integer   no-undo .
      515     define input  parameter p-sys-milliseconds as integer   no-undo .
      516     define output parameter p-loc-year         as integer   no-undo .
      517     define output parameter p-loc-month        as integer   no-undo .
      518     define output parameter p-loc-day          as integer   no-undo .
      519     define output parameter p-loc-hour         as integer   no-undo .
      520     define output parameter p-loc-minute       as integer   no-undo .
      521     define output parameter p-loc-second       as integer   no-undo .
      522     define output parameter p-loc-milliseconds as integer   no-undo .
      523     define variable v-system-time-structure as memptr    no-undo.
      524     define variable v-return-value          as integer   no-undo .
      525     define variable v-sys-day-of-week       as integer   no-undo .
      526     do
      527     on error undo, return error return-value
      528     :
      529       assign
      530         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      531       .
      532       assign
      533         set-size(v-system-time-structure) = 32
      534       .
      535       assign
      536         put-short(v-system-time-structure,  1) = p-sys-year
      537         put-short(v-system-time-structure,  3) = p-sys-month
      538         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      539         put-short(v-system-time-structure,  7) = p-sys-day
      540         put-short(v-system-time-structure,  9) = p-sys-hour
      541         put-short(v-system-time-structure, 11) = p-sys-minute
      542         put-short(v-system-time-structure, 13) = p-sys-second
      543         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      544       .
      545       run SystemTimeToTzSpecificLocalTime
      546         (input  0
      547         ,input  get-pointer-value(v-system-time-structure)
      548         ,input  get-pointer-value(v-system-time-structure) + 16
      549         ,output v-return-value
      550         ) .
      551       assign
      552         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      553         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      554         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      555         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      556         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      557         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      558         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      559       .
      560       assign
      561         set-size(v-system-time-structure) = 0
      562       .
      563       if v-return-value = 0
      564       then do:
      565         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      566       end.
      567     end.
      568   end procedure.
      569   procedure sys-time_mjd-to-sys :
      570     define input  parameter p-mjd          as decimal   no-undo .
      571     define output parameter p-year         as integer   no-undo .
      572     define output parameter p-month        as integer   no-undo .
      573     define output parameter p-day          as integer   no-undo .
      574     define output parameter p-hour         as integer   no-undo .
      575     define output parameter p-minute       as integer   no-undo .
      576     define output parameter p-second       as integer   no-undo .
      577     define output parameter p-milliseconds as integer   no-undo .
      578     define variable v-year-correction as decimal   no-undo .
      579     define variable v-shift-year      as decimal   no-undo .
      580     define variable v-conv-date     as date      no-undo .
      581     define variable v-int-part      as integer   no-undo .
      582     define variable v-fraction-part as decimal   no-undo .
      583     do
      584     on error undo, return error return-value
      585     :
      586       assign
      587         v-int-part      = integer(truncate(p-mjd, 0))
      588         v-fraction-part = p-mjd - v-int-part
      589         v-conv-date     = date(11, 17, 1858) + v-int-part
      590         p-year          = year(v-conv-date)
      591         p-month         = month(v-conv-date)
      592         p-day           = day(v-conv-date)
      593         v-fraction-part = v-fraction-part * 24.0
      594         p-hour          = integer(truncate(v-fraction-part, 0))
      595         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      596         p-minute        = integer(truncate(v-fraction-part, 0))
      597         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      598         p-second        = integer(truncate(v-fraction-part, 0))
      599         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      600         p-milliseconds  = integer(v-fraction-part)
      601       .
      602     end.
      603   end procedure.
      604   procedure sys-time_mjd-to-loc :
      605     define input  parameter p-mjd              as decimal   no-undo .
      606     define output parameter p-loc-year         as integer   no-undo .
      607     define output parameter p-loc-month        as integer   no-undo .
      608     define output parameter p-loc-day          as integer   no-undo .
      609     define output parameter p-loc-hour         as integer   no-undo .
      610     define output parameter p-loc-minute       as integer   no-undo .
      611     define output parameter p-loc-second       as integer   no-undo .
      612     define output parameter p-loc-milliseconds as integer   no-undo .
      613     define variable v-sys-year         as integer   no-undo .
      614     define variable v-sys-month        as integer   no-undo .
      615     define variable v-sys-day          as integer   no-undo .
      616     define variable v-sys-hour         as integer   no-undo .
      617     define variable v-sys-minute       as integer   no-undo .
      618     define variable v-sys-second       as integer   no-undo .
      619     define variable v-sys-milliseconds as integer   no-undo .
      620     do
      621     on error undo, return error return-value
      622     :
      623       run sys-time_mjd-to-sys
      624         (input  p-mjd
      625         ,output v-sys-year
      626         ,output v-sys-month
      627         ,output v-sys-day
      628         ,output v-sys-hour
      629         ,output v-sys-minute
      630         ,output v-sys-second
      631         ,output v-sys-milliseconds
      632         ) .
      633       run sys-time_sys-to-loc
      634         (input  v-sys-year
      635         ,input  v-sys-month
      636         ,input  v-sys-day
      637         ,input  v-sys-hour
      638         ,input  v-sys-minute
      639         ,input  v-sys-second
      640         ,input  v-sys-milliseconds
      641         ,output p-loc-year
      642         ,output p-loc-month
      643         ,output p-loc-day
      644         ,output p-loc-hour
      645         ,output p-loc-minute
      646         ,output p-loc-second
      647         ,output p-loc-milliseconds
      648         ) .
      649     end.
      650   end procedure.
      651   function sys-time_get-mjd-func returns decimal
      652   :
      653     define variable v-year         as integer   no-undo .
      654     define variable v-month        as integer   no-undo .
      655     define variable v-day          as integer   no-undo .
      656     define variable v-hour         as integer   no-undo .
      657     define variable v-minute       as integer   no-undo .
      658     define variable v-second       as integer   no-undo .
      659     define variable v-milliseconds as integer   no-undo .
      660     define variable v-mjd          as decimal   no-undo .
      661     run sys-time_get-sys in this-procedure
      662       (output v-year
      663       ,output v-month
      664       ,output v-day
      665       ,output v-hour
      666       ,output v-minute
      667       ,output v-second
      668       ,output v-milliseconds
      669       ) .
      670     run sys-time_sys-to-mjd in this-procedure
      671       (input  v-year
      672       ,input  v-month
      673       ,input  v-day
      674       ,input  v-hour
      675       ,input  v-minute
      676       ,input  v-second
      677       ,input  v-milliseconds
      678       ,output v-mjd
      679       ) .
      680     return v-mjd .
      681   end function .
      682   function sys-time_get-sys-str-func returns character
      683   :
      684     define variable v-utc-time as character no-undo .
      685     define variable v-year         as integer   no-undo .
      686     define variable v-month        as integer   no-undo .
      687     define variable v-day          as integer   no-undo .
      688     define variable v-hour         as integer   no-undo .
      689     define variable v-minute       as integer   no-undo .
      690     define variable v-second       as integer   no-undo .
      691     define variable v-milliseconds as integer   no-undo .
      692     run sys-time_get-sys in this-procedure
      693       (output v-year
      694       ,output v-month
      695       ,output v-day
      696       ,output v-hour
      697       ,output v-minute
      698       ,output v-second
      699       ,output v-milliseconds
      700       ) .
      701     assign
      702       v-utc-time  = 'UTC ':u
      703                   + string(v-year,         '9999':u)
      704                   + '/':u
      705                   + string(v-month,        '99':u)
      706                   + '/':u
      707                   + string(v-day,          '99':u)
      708                   + ' ':u
      709                   + string(v-hour,         '99':u)
      710                   + ':':u
      711                   + string(v-minute,       '99':u)
      712                   + ':':u
      713                   + string(v-second,       '99':u)
      714                   + ' ':u
      715                   + string(v-milliseconds, '999':u)
      716     .
      717     return v-utc-time.
      718   end function .
      719   function sys-time_mjd-to-loc-str-func returns character
      720     (v-sys-mjd as decimal)
      721   :
      722     define variable v-loc-str          as character no-undo .
      723     define variable v-loc-year         as integer   no-undo .
      724     define variable v-loc-month        as integer   no-undo .
      725     define variable v-loc-day          as integer   no-undo .
      726     define variable v-loc-hour         as integer   no-undo .
      727     define variable v-loc-minute       as integer   no-undo .
      728     define variable v-loc-second       as integer   no-undo .
      729     define variable v-loc-milliseconds as integer   no-undo .
      730     run sys-time_mjd-to-loc in this-procedure
      731       (input  v-sys-mjd
      732       ,output v-loc-year
      733       ,output v-loc-month
      734       ,output v-loc-day
      735       ,output v-loc-hour
      736       ,output v-loc-minute
      737       ,output v-loc-second
      738       ,output v-loc-milliseconds
      739       ) .
      740     assign
      741       v-loc-str = substitute('&1/&2/&3 &4:&5'
      742                             ,string(v-loc-day,    '99':U)
      743                             ,string(v-loc-month,  '99':U)
      744                             ,string(v-loc-year,   '9999':U)
      745                             ,string(v-loc-hour,   '99':U)
      746                             ,string(v-loc-minute, '99':U)
      747                             )
      748     .
      749     return v-loc-str .
      750   end function .
