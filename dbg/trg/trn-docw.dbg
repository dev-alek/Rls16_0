     4593                         buf_marking-lines.gds-code   = buf_goods.gds-code
     4594                         buf_marking-lines.obj-type   = buf_parts.obj-type
     4595                         buf_marking-lines.obj-code   = buf_parts.obj-code
     4596                         buf_marking-lines.in-code    = buf_parts.in-code
     4597                         buf_marking-lines.out-code   = buf_parts.out-code
     4598                         buf_marking-lines.part-code  = buf_parts.part-code
