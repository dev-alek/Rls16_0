     5565                     "Артикул" p-artic p-prod-type p-prod-code skip
     5566                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5567                     "Резерв" v-rsrv-code skip
     5568                     error-status :get-message(1) skip
     5569                     return-value skip
     5570                     view-as alert-box error .
     5571                   undo, return error .
     5572                 end.
     5573                 assign
