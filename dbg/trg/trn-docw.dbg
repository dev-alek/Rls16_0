        1   block-level on error undo, throw.
        2   using ibs.th.str.alcohol.*.
        3   TRIGGER PROCEDURE FOR WRITE OF ub.trn-doc OLD BUFFER old-doc .
        4   define variable vss-revision    as character no-undo initial "$Revision: c96af91888ad, 3081, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U .
        6   define variable vss-date        as character no-undo initial "$Date: 2022/08/05 16:16:26 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: trn-docw.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: trg/trn-docw.p $":U .
        9   define variable vss-description as character no-undo initial "Триггер на запись документа":U .
       10   define variable chg-qnty      as   decimal no-undo .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2|&3|&4',ub.trn-doc.doc-code,ub.trn-doc.ext-doc-type,ub.trn-doc.status_,ub.trn-doc.flag_)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure gdsobjcl :
       85     define input parameter p-gds-obj-recid    as recid no-undo .
       86     define input parameter p-update-fact-qnty as logical   no-undo .
       87     define variable vss-description as character no-undo init "$Workfile$ gdsobjcl: расчет записи товар на объекте ".
       88     define buffer buf_parts for ub.parts .
       89     define variable v-total-avrg-base as decimal no-undo .
       90     define variable v-total-avrg-rubl as decimal no-undo .
       91     define variable v-total-avrg-qnty as decimal no-undo .
       92     define variable v-parts-avrg-qnty as decimal no-undo .
       93     define variable v-total-fact-base as decimal no-undo .
       94     define variable v-total-fact-rubl as decimal no-undo .
       95     define variable v-total-fact-qnty as decimal no-undo .
       96     define variable v-parts-fact-qnty as decimal   no-undo .
       97     define buffer buf_gds-obj for ub.gds-obj .
       98     define buffer buf_prt-obj for ub.prt-obj .
       99     define buffer buf_gds-prt for ub.gds-prt .
      100     do
      101     on error undo, return error return-value
      102     :
      103       find first buf_gds-obj exclusive-lock
      104         where recid(buf_gds-obj) = p-gds-obj-recid
      105         no-error .
      106       if not available buf_gds-obj
      107       then do:
      108         message
      109           vss-workfile vss-revision vss-description skip
      110           "Ошибка задания входных параметров" skip
      111           "Не найдена запись товар на объекте" skip
      112           "Код записи (recid)" p-gds-obj-recid skip
      113           view-as alert-box error .
      114         undo, return error return-value .
      115       end.
      116       assign
      117         v-total-avrg-base = 0
      118         v-total-avrg-rubl = 0
      119         v-total-avrg-qnty = 0
      120         v-total-fact-base = 0
      121         v-total-fact-rubl = 0
      122         v-total-fact-qnty = 0
      123       .
      124       for each buf_parts no-lock
      125         where buf_parts.obj-type  = buf_gds-obj.obj-type
      126           and buf_parts.obj-code  = buf_gds-obj.obj-code
      127           and buf_parts.artic     = buf_gds-obj.artic
      128           and buf_parts.prod-type = buf_gds-obj.prod-type
      129           and buf_parts.prod-code = buf_gds-obj.prod-code
      130           and buf_parts.status_   = no
      131           and buf_parts.rsrv-free = yes
      132           and buf_parts.in-code   <> buf_parts.out-code
      133           and buf_parts.doc-type  <> 'акт':U
      134       on error undo, return error return-value
      135       :
      136         assign
      137           v-parts-avrg-qnty = 0
      138           v-parts-fact-qnty = 0
      139         .
      140         if buf_parts.out-code = 'free-zone':U
      141         then do:
      142           if buf_parts.fact-qnty > 0
      143           then do:
      144             assign
      145               v-parts-avrg-qnty = buf_parts.qnty
      146             .
      147           end.
      148           assign
      149             v-parts-fact-qnty = buf_parts.qnty
      150           .
      151         end.
      152         else do:
      153           assign
      154             v-parts-avrg-qnty = abs(buf_parts.qnty)
      155             v-parts-fact-qnty = abs(buf_parts.qnty)
      156           .
      157         end.
      158         assign
      159           v-total-avrg-base = v-total-avrg-base
      160                             + (buf_parts.price-base * v-parts-avrg-qnty)
      161           v-total-avrg-rubl = v-total-avrg-rubl
      162                             + (buf_parts.price-rubl * v-parts-avrg-qnty)
      163           v-total-avrg-qnty = v-total-avrg-qnty
      164                             + v-parts-avrg-qnty
      165           v-total-fact-base = v-total-fact-base
      166                             + (buf_parts.price-base * v-parts-fact-qnty)
      167           v-total-fact-rubl = v-total-fact-rubl
      168                             + (buf_parts.price-rubl * v-parts-fact-qnty)
      169           v-total-fact-qnty = v-total-fact-qnty
      170                             + v-parts-fact-qnty
      171         .
      172       end.
      173       if v-total-avrg-qnty < 0
      174       or v-total-avrg-qnty = ?
      175       then do:
      176         undo, return error
      177           vss-description + chr(10)
      178           + "Количество положительных партий в свободной зоне не может быть отрицательным или неопределенным" + chr(10)
      179           + "v-total-avrg-qnty " + (if v-total-avrg-qnty <> ? then string(v-total-avrg-qnty) else "?")
      180           .
      181       end.
      182       if v-total-fact-base = ?
      183       or v-total-fact-rubl = ?
      184       then do:
      185         undo, return error
      186           vss-description + chr(10)
      187           + "Сумма учетных цен по товару на объекте не может иметь неопределенное значение" + chr(10)
      188           + "v-total-fact-base " + (if v-total-fact-base <> ? then string(v-total-fact-base) else "?") + chr(10)
      189           + "v-total-fact-rubl " + (if v-total-fact-rubl <> ? then string(v-total-fact-rubl) else "?") + chr(10)
      190           .
      191       end.
      192       assign
      193         buf_gds-obj.avrg-qnty = v-total-avrg-qnty
      194         buf_gds-obj.fact-base = v-total-fact-base
      195         buf_gds-obj.fact-rubl = v-total-fact-rubl
      196       .
      197       if p-update-fact-qnty
      198       then do:
      199         message
      200           vss-workfile vss-revision vss-description skip
      201           "Ошибка задания входных параметров"
      202           "В данной версии обновление фактического количества не реализовано" skip
      203           "p-update-fact-qnty" p-update-fact-qnty skip
      204           view-as alert-box error .
      205         undo, return error return-value .
      206       end.
      207       if buf_gds-obj.fact-qnty <> v-total-fact-qnty
      208       then do:
      209         undo, return error
      210           vss-description + chr(10)
      211           + "Не совпадает общее количество по партиям и фактическое количество по товару на объекте" + chr(10)
      212           + "buf_gds-obj.fact-qnty " + (if buf_gds-obj.fact-qnty <> ? then string(buf_gds-obj.fact-qnty) else "?") + chr(10)
      213           + "v-total-fact-qnty "     + (if v-total-fact-qnty     <> ? then string(v-total-fact-qnty)     else "?") + chr(10)
      214           .
      215       end.
      216       if v-total-avrg-qnty > 0
      217       then do:
      218         assign
      219           buf_gds-obj.avrg-base = v-total-avrg-base / v-total-avrg-qnty
      220           buf_gds-obj.avrg-rubl = v-total-avrg-rubl / v-total-avrg-qnty
      221         .
      222       end.
      223       else do:
      224         if  buf_gds-obj.last-base > 0
      225         and buf_gds-obj.last-rubl > 0
      226         then do:
      227           assign
      228             buf_gds-obj.avrg-base = buf_gds-obj.last-base
      229             buf_gds-obj.avrg-rubl = buf_gds-obj.last-rubl
      230           .
      231         end.
      232       end.
      233       define variable v-total-sale-fact-qnty as decimal   no-undo .
      234       define variable v-total-fact-sale      as decimal   no-undo .
      235       assign
      236         v-total-sale-fact-qnty = 0
      237         v-total-fact-sale      = 0
      238       .
      239       for each buf_prt-obj
      240         where buf_prt-obj.obj-type  = buf_gds-obj.obj-type
      241           and buf_prt-obj.obj-code  = buf_gds-obj.obj-code
      242           and buf_prt-obj.artic     = buf_gds-obj.artic
      243           and buf_prt-obj.prod-type = buf_gds-obj.prod-type
      244           and buf_prt-obj.prod-code = buf_gds-obj.prod-code
      245           and buf_prt-obj.is-term   = true
      246       on error undo, return error return-value
      247       :
      248         assign
      249           v-total-sale-fact-qnty  = v-total-sale-fact-qnty
      250                                   + buf_prt-obj.fact-qnty
      251           v-total-fact-sale       = v-total-fact-sale
      252                                   + buf_prt-obj.fact-qnty * buf_prt-obj.price-sale
      253         .
      254       end.
      255       if v-total-fact-sale = ?
      256       then do:
      257         undo, return error
      258           vss-description + chr(10)
      259           + "Сумма продажных цен по товару на объекте не может иметь неопределенное значение" + chr(10)
      260           + "v-total-fact-sale " + (if v-total-fact-sale <> ? then string(v-total-fact-sale) else "?") + chr(10)
      261           .
      262       end.
      263       if buf_gds-obj.fact-qnty <> v-total-sale-fact-qnty
      264       then do:
      265         undo, return error
      266           vss-description + chr(10)
      267           + "Не совпадает общее количество по признакам и фактическое количество по товару на объекте" + chr(10)
      268           + "buf_gds-obj.fact-qnty "  + (if buf_gds-obj.fact-qnty <> ?  then string(buf_gds-obj.fact-qnty)  else "?") + chr(10)
      269           + "v-total-sale-fact-qnty " + (if v-total-sale-fact-qnty <> ? then string(v-total-sale-fact-qnty) else "?") + chr(10)
      270           .
      271       end.
      272       assign
      273         buf_gds-obj.fact-sale = v-total-fact-sale
      274       .
      275     end.
      276   end procedure .
      277   procedure gdsobjcl-calc-goods :
      278     define input parameter p-artic     like ub.goods.artic     no-undo .
      279     define input parameter p-prod-type like ub.goods.prod-type no-undo .
      280     define input parameter p-prod-code like ub.goods.prod-code no-undo .
      281     define variable vss-description as character no-undo init "$Workfile$ gdsobjcl-calc-goods".
      282     do
      283     on error undo, return error return-value
      284     :
      285       define buffer buf_gds-obj for ub.gds-obj .
      286       define buffer buf_prt-obj for ub.prt-obj .
      287       do
      288       on error undo, return error return-value
      289       :
      290         for each buf_prt-obj
      291           where buf_prt-obj.artic     = p-artic
      292             and buf_prt-obj.prod-type = p-prod-type
      293             and buf_prt-obj.prod-code = p-prod-code
      294         on error undo, return error return-value
      295         :
      296   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjup in g#library
      297     (buffer buf_prt-obj
      298     ) no-error .
      299           if error-status :error
      300           then do:
      301             undo, return error
      302               "объект "  + string(buf_prt-obj.obj-type) + " " + string(buf_prt-obj.obj-code) + chr(10)
      303               + "артикул " + string(buf_prt-obj.artic) + " " + string(buf_prt-obj.prod-type) + " " + string(buf_prt-obj.prod-code) + chr(10)
      304               + "признак " + string(buf_prt-obj.prt-code) + chr(10)
      305               + return-value .
      306           end.
      307         end.
      308         for each buf_gds-obj
      309           where buf_gds-obj.artic     = p-artic
      310             and buf_gds-obj.prod-type = p-prod-type
      311             and buf_gds-obj.prod-code = p-prod-code
      312         on error undo, return error return-value
      313         :
      314           run gdsobjcl in this-procedure
      315             (input recid(buf_gds-obj)
      316             ,input false
      317             ) no-error .
      318           if error-status :error
      319           then do:
      320             undo, return error
      321               "объект " + string(buf_gds-obj.obj-type) + " " + string(buf_gds-obj.obj-code) + chr(10)
      322               + return-value .
      323           end.
      324         end.
      325       end.
      326     end.
      327   end procedure.
      328   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   procedure cust_prc :
      330     define parameter buffer buf_trn-doc  for ub.trn-doc  .
      331     define parameter buffer buf_doc-line for ub.doc-line .
      332     define input  parameter l-custvalue  as logical no-undo .
      333     def buffer l-d-l      for ub.doc-line.
      334     def buffer bf-parts   for ub.parts.
      335     define variable    lOK        as logical no-undo .
      336     define variable parnum-place  like ub.doc-line.num-place no-undo.
      337     define variable parwt-brutto  like ub.doc-line.wt-brutto no-undo.
      338     if l-custvalue then do:
      339       if  buf_trn-doc.doc-type = 'при':U
      340       and buf_trn-doc.internal = no
      341       then do:
      342         find first bf-parts where bf-parts.obj-type  = buf_trn-doc.obj-type   and
      343                                   bf-parts.obj-code  = buf_trn-doc.obj-code   and
      344                                   bf-parts.prod-type = buf_doc-line.prod-type and
      345                                   bf-parts.prod-code = buf_doc-line.prod-code and
      346                                   bf-parts.artic     = buf_doc-line.artic     and
      347                                   bf-parts.out-code  = buf_trn-doc.doc-code   and
      348                                   bf-parts.cst-code <> ?                      and
      349                                   bf-parts.cst-code <> ""                     no-lock no-error.
      350         if available bf-parts then do:
      351            find first bf-parts where bf-parts.obj-type  = buf_trn-doc.obj-type   and
      352                                      bf-parts.obj-code  = buf_trn-doc.obj-code   and
      353                                      bf-parts.prod-type = buf_doc-line.prod-type and
      354                                      bf-parts.prod-code = buf_doc-line.prod-code and
      355                                      bf-parts.artic     = buf_doc-line.artic     and
      356                                      bf-parts.out-code  = buf_trn-doc.doc-code   and
      357                                      (bf-parts.cst-code = ? or bf-parts.cst-code = "") no-lock no-error.
      358            if available bf-parts then do:
      359               message
      360                "Не определен номер ГТД в партии товара" skip
      361                "Документ" buf_trn-doc.doc-code skip
      362                "Артикул"  buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      363                "Код партии" bf-parts.part-code skip
      364                view-as alert-box error .
      365              undo, return error return-value .
      366            end.
      367            if buf_doc-line.num-place = 0
      368            or buf_doc-line.num-place = ?
      369            then do:
      370              message
      371                "Не задано количество мест товара" skip
      372                "Документ" buf_trn-doc.doc-code skip
      373                "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      374                view-as alert-box error .
      375              undo, return error return-value .
      376            end.
      377            if buf_doc-line.wt-brutto = 0
      378            or buf_doc-line.wt-brutto = ?
      379            then do:
      380              message
      381                "Не заведен вес брутто товара" skip
      382                "Документ" buf_trn-doc.doc-code skip
      383                "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      384                view-as alert-box error .
      385              undo, return error return-value .
      386            end.
      387         end.
      388       end.
      389       else do:
      390         if  buf_trn-doc.doc-type <> 'инв':U
      391         and (   buf_doc-line.wt-brutto = 0
      392             or buf_doc-line.wt-brutto = ?
      393             or buf_doc-line.num-place = 0
      394             or buf_doc-line.num-place = ?)
      395         then do:
      396           find last l-d-l no-lock
      397             where l-d-l.artic     = buf_doc-line.artic
      398               and l-d-l.prod-type = buf_doc-line.prod-type
      399               and l-d-l.prod-code = buf_doc-line.prod-code
      400               and l-d-l.obj-type  = buf_doc-line.obj-type
      401               and l-d-l.obj-code  = buf_doc-line.obj-code
      402               and l-d-l.status_   = 'факт':U
      403               and l-d-l.num-place <> 0
      404               and l-d-l.num-place <> ?
      405               and l-d-l.wt-brutto <> 0
      406               and l-d-l.wt-brutto <> ?
      407               and recid(l-d-l)    <> recid(buf_doc-line)
      408             use-index fact-order
      409             no-error.
      410           if not available l-d-l then do:
      411             assign
      412               lOK = no
      413             .
      414             message
      415               "Не найдено ни одного веса товара:" buf_doc-line.artic " на объекте." skip
      416               "Будете задавать вручную?" skip
      417               view-as alert-box question buttons yes-no update lok.
      418             if lOK = yes then do:
      419               run str/set-wt.w
      420                 (input  buf_doc-line.artic
      421                 ,input  buf_doc-line.prod-type
      422                 ,input  buf_doc-line.prod-code
      423                 ,output parnum-place
      424                 ,output parwt-brutto
      425                 ) no-error.
      426               if error-status :error
      427               or parnum-place = 0
      428               or parnum-place = ?
      429               or parwt-brutto = 0
      430               or parwt-brutto = ?
      431               then do:
      432                 message "Без указания веса и кол-ва мест нельзя закрыть накладную."
      433                   view-as alert-box error buttons ok.
      434                 undo, return error return-value .
      435               end.
      436               else do:
      437                 do transaction
      438                 on error undo, return error return-value
      439                 :
      440                   assign
      441                     buf_doc-line.num-place = parnum-place
      442                     buf_doc-line.wt-brutto = parwt-brutto
      443                   .
      444                 end.
      445               end.
      446             end.
      447             else do:
      448               undo, return error return-value .
      449             end.
      450           end.
      451           else do:
      452             do transaction
      453             on error undo, return error return-value
      454             :
      455               assign
      456                 buf_doc-line.num-place = l-d-l.num-place * buf_doc-line.fact-qnty / l-d-l.fact-qnty
      457                 buf_doc-line.wt-brutto = l-d-l.wt-brutto * buf_doc-line.fact-qnty / l-d-l.fact-qnty
      458               .
      459             end.
      460           end.
      461         end.
      462       end.
      463     end.
      464     else do:
      465       if buf_doc-line.num-place <> 0
      466       or buf_doc-line.wt-brutto <> 0
      467       then do:
      468         do transaction
      469         on error undo, return error return-value
      470         :
      471           assign
      472             buf_doc-line.num-place = 0
      473             buf_doc-line.wt-brutto = 0
      474           .
      475         end.
      476       end.
      477     end.
      478   end procedure.
      479   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      480   procedure factord :
      481     define input  parameter p-fact-date            as date    no-undo .
      482     define input  parameter p-fact-time            as integer no-undo .
      483     define input  parameter p-fact-num             as integer no-undo .
      484     define input  parameter p-shift-date           as date    no-undo .
      485     define input  parameter p-shift-num            as integer no-undo .
      486     define input  parameter p-shift-on             as logical no-undo .
      487     define output parameter p-fact-order           as decimal no-undo .
      488     define output parameter p-shift-end-fact-order as decimal no-undo .
      489     define output parameter p-day-end-fact-order   as decimal no-undo .
      490     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      491     if p-fact-date = ?
      492     then do:
      493       return error "Не указана фактическая дата" .
      494     end.
      495     define variable v-fact-date-num as integer no-undo .
      496     assign
      497       v-fact-date-num = integer(p-fact-date)
      498     .
      499     if p-fact-num = ?
      500     or p-fact-num = 0
      501     then do:
      502       return error "Не задан p-fact-num " + string(p-fact-num) .
      503     end.
      504     if p-fact-num < 0
      505     then do:
      506       return error "Отрицательный fact-num " + string(p-fact-num) .
      507     end.
      508     if p-fact-num >= 100000000
      509     then do:
      510       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      511     end.
      512     if p-shift-on = true
      513     then do:
      514       if p-shift-date = ?
      515       then do:
      516         return error "Не задана дата смены" .
      517       end.
      518       if p-shift-num = ?
      519       or p-shift-num = 0
      520       then do:
      521         return error "Не задан номер смены" .
      522       end.
      523     end.
      524     else do:
      525       assign
      526         p-shift-date = p-fact-date
      527         p-shift-num  = 24
      528       .
      529     end.
      530     define variable v-shift-offset as integer no-undo .
      531     if p-shift-date = p-fact-date
      532     then do:
      533       assign
      534         v-shift-offset = 1
      535       .
      536     end.
      537     if p-shift-date < p-fact-date
      538     then do:
      539       assign
      540         v-shift-offset = 0
      541       .
      542     end.
      543     if p-shift-date > p-fact-date
      544     then do:
      545       message
      546         vss-workfile vss-revision vss-description skip
      547         "Неправильная дата закрытия смены" skip
      548         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      549         view-as alert-box error .
      550       undo, return error
      551         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      552           ,string(p-fact-date, '99/99/9999':U)
      553           ,string(p-shift-date, '99/99/9999':U)
      554           )
      555       .
      556     end.
      557     if p-shift-num < 1
      558     or p-shift-num > 24
      559     then do:
      560       message
      561         vss-workfile vss-revision vss-description skip
      562         "Неправильный номер смены" skip
      563         "p-shift-num" p-shift-num skip
      564         view-as alert-box error .
      565       undo, return error return-value .
      566     end.
      567     assign
      568       p-fact-order           = v-fact-date-num
      569                              + v-shift-offset * 0.5
      570                              + p-shift-num    * 0.02 - 0.01
      571                              + p-fact-num     * 0.0000000001
      572       p-shift-end-fact-order = v-fact-date-num
      573                              + v-shift-offset * 0.5
      574                              + p-shift-num    * 0.02
      575       p-day-end-fact-order   = v-fact-date-num
      576                              + 0.99
      577     .
      578     if p-fact-order           <= v-fact-date-num
      579     or p-shift-end-fact-order <= v-fact-date-num
      580     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      581     or p-shift-end-fact-order >= p-day-end-fact-order
      582     then do:
      583       message
      584         vss-workfile vss-revision vss-description skip
      585         "Внутренняя ошибка при генерации фактического номера" skip
      586         "p-fact-date"            p-fact-date            skip
      587         "p-fact-time"            p-fact-time            skip
      588         "p-fact-num"             p-fact-num             skip
      589         "p-shift-date"           p-shift-date           skip
      590         "p-shift-num"            p-shift-num            skip
      591         "p-shift-on"             p-shift-on             skip
      592         "p-shift-end-fact-order" p-shift-end-fact-order skip
      593         "p-day-end-fact-order"   p-day-end-fact-order   skip
      594         "v-fact-date-num"        v-fact-date-num        skip
      595         view-as alert-box error .
      596       undo, return error return-value .
      597     end.
      598   end procedure.
      599   procedure day-begin-fact-order :
      600     define input  parameter p-fact-date            as date    no-undo .
      601     define output parameter p-day-begin-fact-order as decimal no-undo .
      602     do
      603     on error undo, return error return-value
      604     :
      605       if p-fact-date = ?
      606       then do:
      607         assign
      608           p-day-begin-fact-order = 0
      609         .
      610       end.
      611       else do:
      612         assign
      613           p-day-begin-fact-order = integer(p-fact-date)
      614         .
      615       end.
      616     end.
      617   end procedure.
      618   procedure factord-max-fact-order :
      619     define output parameter p-max-fact-order as decimal   no-undo .
      620     do
      621     on error undo, return error return-value
      622     :
      623       run day-begin-fact-order in this-procedure
      624         (input  date(1, 1, 5000)
      625         ,output p-max-fact-order
      626         ) .
      627     end.
      628   end procedure.
      629   procedure factord-cut-archive :
      630     define input  parameter p-obj-type             as character no-undo .
      631     define input  parameter p-obj-code             as integer   no-undo .
      632     define input  parameter p-fact-date            as date      no-undo .
      633     define output parameter p-shift-on             as logical   no-undo .
      634     define output parameter p-shift-date           as date      no-undo .
      635     define output parameter p-shift-num            as integer   no-undo .
      636     define output parameter p-day-end-fact-order   as decimal   no-undo .
      637     define output parameter p-shift-end-fact-order as decimal   no-undo .
      638     define variable v-fact-order as decimal   no-undo .
      639     define buffer buf_shift-obj for ub.shift-obj .
      640     do
      641     on error undo, return error return-value
      642     :
      643   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      645     (input  p-obj-type
      646     ,input  p-obj-code
      647     ,input  'shift-on=request'
      648     ,output p-shift-on
      649     ) no-error .
      650       if error-status :error
      651       then do:
      652         message
      653           vss-workfile vss-revision vss-description skip
      654           "Ошибка при определении атрибута объекта" skip
      655           "Объект" p-obj-type p-obj-code skip
      656           error-status :get-message(1) skip
      657           return-value skip
      658           view-as alert-box error .
      659         undo, return error return-value .
      660       end.
      661       if p-shift-on = false
      662       then do:
      663         assign
      664           p-shift-date               = ?
      665           p-shift-num                = 0
      666         .
      667       end.
      668       else do:
      669         find first buf_shift-obj share-lock
      670           where buf_shift-obj.obj-type   = p-obj-type
      671             and buf_shift-obj.obj-code   = p-obj-code
      672             and buf_shift-obj.shift-date > p-fact-date
      673           use-index pi
      674           no-error .
      675         if not available buf_shift-obj
      676         or buf_shift-obj.status_ <> 'зкр':U
      677         then do:
      678           message
      679             vss-workfile vss-revision vss-description skip
      680             "Невозможно вычислить последнюю смену" skip
      681             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      682             "Объект" p-obj-type p-obj-code skip
      683             "Дата" p-fact-date skip
      684             view-as alert-box error .
      685           undo, return error return-value .
      686         end.
      687         find last buf_shift-obj share-lock
      688           where buf_shift-obj.obj-type = p-obj-type
      689             and buf_shift-obj.obj-code = p-obj-code
      690             and buf_shift-obj.shift-date <= p-fact-date
      691           use-index pi
      692           no-error .
      693         if available buf_shift-obj
      694         then do:
      695           if  buf_shift-obj.status_ = 'зкр':U
      696           then do:
      697             assign
      698               p-shift-date = buf_shift-obj.shift-date
      699               p-shift-num  = buf_shift-obj.shift-num
      700             .
      701           end.
      702           else do:
      703             message
      704               vss-workfile vss-revision vss-description skip
      705               "Невозможно вычислить последнюю смену" skip
      706               "Статус смены отличен от статуса" 'зкр':U skip
      707               "Объект" p-obj-type p-obj-code skip
      708               "Дата" p-fact-date skip
      709               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      710               view-as alert-box error .
      711             undo, return error return-value .
      712           end.
      713         end.
      714         else do:
      715           assign
      716             p-shift-date = p-fact-date - 1
      717             p-shift-num  = 1
      718           .
      719         end.
      720       end.
      721       run factord in this-procedure
      722         (input  p-fact-date
      723         ,input  1
      724         ,input  1
      725         ,input  p-shift-date
      726         ,input  p-shift-num
      727         ,input  p-shift-on
      728         ,output v-fact-order
      729         ,output p-shift-end-fact-order
      730         ,output p-day-end-fact-order
      731         ) no-error .
      732       if error-status :error
      733       then do:
      734         message
      735           vss-workfile vss-revision vss-description skip
      736           "Ошибка при вызове процедуры factord"
      737           error-status :get-message(1) skip
      738           return-value skip
      739           view-as alert-box error .
      740         undo, return error return-value .
      741       end.
      742     end.
      743   end procedure.
      744   procedure factord-lock-shift :
      745     define input  parameter p-obj-type  as character no-undo .
      746     define input  parameter p-obj-code  as integer   no-undo .
      747     define input  parameter p-fact-date as date      no-undo .
      748     define parameter buffer buf_shift-obj for ub.shift-obj .
      749     define variable v-shift-on      as logical   no-undo .
      750     define variable v-extra-message as character no-undo .
      751     define variable v-error as character no-undo .
      752     do
      753     on error undo, return error return-value
      754     :
      755   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      757     (input  p-obj-type
      758     ,input  p-obj-code
      759     ,input  'shift-on=request'
      760     ,output v-shift-on
      761     ) no-error .
      762       if error-status :error
      763       then do:
      764         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      765         undo, return error v-error .
      766       end.
      767       if v-shift-on = true
      768       then do:
      769         find first buf_shift-obj share-lock
      770           where buf_shift-obj.obj-type   = p-obj-type
      771             and buf_shift-obj.obj-code   = p-obj-code
      772             and buf_shift-obj.shift-date > p-fact-date
      773           use-index pi
      774           no-error .
      775         if not available buf_shift-obj
      776         or buf_shift-obj.status_ <> 'зкр':U
      777         then do:
      778           find last buf_shift-obj
      779             where buf_shift-obj.obj-type = p-obj-type
      780               and buf_shift-obj.obj-code = p-obj-code
      781               and buf_shift-obj.status_  = 'зкр':U
      782             use-index stts
      783             no-error .
      784           if available buf_shift-obj
      785           then do:
      786             assign
      787               v-extra-message =
      788                     substitute("Дата начала последеней закрытой смены на объекте &1"
      789                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      790                               )
      791             .
      792           end.
      793           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      794           undo, return error v-error .
      795         end.
      796       end.
      797     end.
      798   end procedure.
      799   procedure factord-end-day :
      800     define input  parameter p-fact-date            as date    no-undo .
      801     define output parameter p-day-end-fact-order   as decimal no-undo .
      802     do
      803     on error undo, return error return-value
      804     :
      805       if p-fact-date = ?
      806       then do:
      807         return error "Не указана фактическая дата" .
      808       end.
      809       assign
      810         p-day-end-fact-order = integer(p-fact-date) + 0.99
      811       .
      812     end.
      813   end procedure.
      814   procedure factord-to-date :
      815     define input  parameter p-fact-order as decimal no-undo .
      816     define output parameter p-fact-date  as date    no-undo .
      817     define variable v-ref-date  as date      no-undo .
      818     define variable v-ref-delta as integer   no-undo .
      819     do
      820     on error undo, return error return-value
      821     :
      822       if p-fact-order = ?
      823       or p-fact-order = 0
      824       then do:
      825         return error "Не указан fact-order" .
      826       end.
      827       assign
      828         v-ref-date  = date(1, 1, 2000)
      829       .
      830       assign
      831         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      832       .
      833       assign
      834         p-fact-date = v-ref-date + v-ref-delta
      835       .
      836     end.
      837   end procedure.
      838   procedure factord-to-fact-num :
      839     define input  parameter p-fact-order as decimal no-undo .
      840     define output parameter p-fact-num   as integer no-undo .
      841     define variable v-fact-order-trunc as decimal no-undo .
      842     do
      843     on error undo, return error return-value
      844     :
      845       if p-fact-order = ?
      846       or p-fact-order = 0
      847       then do:
      848         return error "Не указан fact-order" .
      849       end.
      850       assign
      851        v-fact-order-trunc = truncate(p-fact-order, 2)
      852       .
      853       assign
      854         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      855       .
      856     end.
      857   end procedure.
      858   procedure factord-to-shift-num :
      859     define input  parameter p-fact-order as decimal no-undo .
      860     define output parameter p-shift-num   as integer no-undo .
      861     define variable  p-shift-numd  as decimal   no-undo .
      862     define variable v-fact-order-trunc as decimal no-undo .
      863     do
      864     on error undo, return error return-value
      865     :
      866       if p-fact-order = ?
      867       or p-fact-order = 0
      868       then do:
      869         return error "Не указан fact-order" .
      870       end.
      871       assign
      872        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      873       .
      874       if v-fact-order-trunc < 0.5 then do:
      875         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      876       end.
      877       assign
      878         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      879         .
      880        assign
      881         p-shift-num = truncate (p-shift-numd , 0)
      882       .
      883     end.
      884   end procedure.
      885   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
