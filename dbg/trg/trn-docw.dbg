     5470                     vss-workfile vss-revision vss-description skip
     5471                     vss-include-info22 skip
     5472                     "Фактическое количество для товара," skip
     5473                     "который учитывается по двум единицам измерения" skip
     5474                     "должно равняться нулю или количеству по документу" skip
     5475                     "Документ" p-doc-code skip
     5476                     "Объект" p-obj-type p-obj-code skip
     5477                     "Артикул" p-artic p-prod-type p-prod-code skip
     5478                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5479                     "Количество по документу" archive_parts.qnty skip
     5480                     "Фактическое количество" archive_parts.fact-qnty skip
