     8072         define variable v-cur-SLT-base      as decimal   no-undo .
     8073         define variable v-cur-road-tax-base as decimal   no-undo .
     8074         define variable v-cur-excise-base   as decimal   no-undo .
     8075         assign
     8076           v-fact-qnty         = v-fact-qnty
     8077                               + v-gds-dtl-fact-qnty
     8078           v-cur-base          = v-cur-base
     8079                               + (if p-curr-r-b = 'base':U
     8080                                  then price-base-with-tax-sale-prl
     8081                                  else price-rubl-with-tax-sale-prl
     8082                                 )
     8083                               * v-gds-dtl-fact-qnty
     8084           v-cur-VAT-base      = v-cur-VAT-base
     8085                               + (if p-curr-r-b = 'base':U
     8086                                  then vat-base-sale-prl
     8087                                  else vat-rubl-sale-prl
     8088                                 )
     8089                               * v-gds-dtl-fact-qnty
     8090           v-cur-SLT-base      = v-cur-SLT-base
     8091                               + (if p-curr-r-b = 'base':U
     8092                                  then slt-base-sale-prl
     8093                                  else slt-rubl-sale-prl
     8094                                 )
     8095                               * v-gds-dtl-fact-qnty
     8096           v-cur-road-tax-base = v-cur-road-tax-base
     8097                               + (if p-curr-r-b = 'base':U
     8098                                  then road-tax-base-sale-prl
     8099                                  else road-tax-rubl-sale-prl
     8100                                 )
     8101                               * v-gds-dtl-fact-qnty
     8102           v-cur-excise-base   = v-cur-excise-base
     8103                               + (if p-curr-r-b = 'base':U
     8104                                  then excise-base-sale-prl
     8105                                  else excise-rubl-sale-prl
     8106                                 )
     8107                               * v-gds-dtl-fact-qnty
     8108         .
     8109       end.
     8110       assign
     8111         p-fact-qnty = v-fact-qnty
     8112       .
     8113       define variable v-base-rate                 like ub.curr-accnt.exch-rate no-undo .
     8114       define variable v-base-scale                like ub.curr-accnt.exch-scale no-undo .
     8115     assign
     8116       v-base-rate  = buf_trn-doc.base-rate
     8117       v-base-scale = buf_trn-doc.base-scale
     8118     .
     8119       if p-curr-r-b = 'base':U then do:
     8120         assign
     8121           p-sum-base       = v-cur-base
     8122           p-sum-rubl       = v-cur-base     * v-base-rate / v-base-scale
     8123           p-vat-base       = v-cur-VAT-base
     8124           p-vat-rubl       = v-cur-VAT-base * v-base-rate / v-base-scale
     8125           p-slt-base       = v-cur-SLT-base
     8126           p-slt-rubl       = v-cur-SLT-base * v-base-rate / v-base-scale
     8127           p-road-tax-base  = v-cur-road-tax-base
     8128           p-road-tax-rubl  = v-cur-road-tax-base * v-base-rate / v-base-scale
     8129           p-excise-base    = v-cur-excise-base
     8130           p-excise-rubl    = v-cur-excise-base * v-base-rate / v-base-scale
     8131           p-transport-base = 0
     8132           p-transport-rubl = 0
     8133           p-other-base     = 0
     8134           p-other-rubl     = 0
     8135         .
     8136       end.
     8137       else do:
     8138         assign
     8139           p-sum-base       = v-cur-base     / v-base-rate * v-base-scale
     8140           p-sum-rubl       = v-cur-base
     8141           p-vat-base       = v-cur-VAT-base / v-base-rate * v-base-scale
     8142           p-vat-rubl       = v-cur-VAT-base
     8143           p-slt-base       = v-cur-SLT-base / v-base-rate * v-base-scale
     8144           p-slt-rubl       = v-cur-SLT-base
     8145           p-road-tax-base  = v-cur-road-tax-base / v-base-rate * v-base-scale
     8146           p-road-tax-rubl  = v-cur-road-tax-base
     8147           p-excise-base    = v-cur-excise-base / v-base-rate * v-base-scale
     8148           p-excise-rubl    = v-cur-excise-base
     8149           p-transport-base = 0
     8150           p-transport-rubl = 0
     8151           p-other-base     = 0
     8152           p-other-rubl     = 0
     8153         .
     8154       end.
     8155     end.
     8156   end procedure.
     8157   define variable vss-include-info50 as character format "X(65)" no-undo
     8158   initial "@(#)$Workfile$ $Revision$".
     8159   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8160   procedure r-sale :
     8161     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
