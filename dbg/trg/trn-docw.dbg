    10114   assign
    10115     v-description-doc-type = ub.trn-doc.doc-type
    10116                            + " " + string(ub.trn-doc.internal, "внут/внеш")
    10117   .
    10118   def frame a
    10119     ub.trn-doc.doc-code                           label "Документ"             skip
    10120     v-description-doc-type                        label "Тип документа"        skip
    10121     v-current-action       format "x(40)":U    no-label                        skip
    10122     num_rec                format ">>>>>>>9":U    label "Обработано артикулов" skip
    10123     buf_doc-line.artic                            label "Текущий артикул"      skip
    10124     num_gds                format ">>>>>>>9":U    label "Обработано признаков" skip
    10125     v-current-time         format "x(8)":U        label "Время"                skip
    10126   with view-as dialog-box side-labels three-d
    10127        title "Обработка документа"
    10128     .
    10129   MAIN-BLOCK:
    10130   do transaction
    10131   on error   undo main-block, return error substitute('trn-docw error main-block,&1', return-value )
    10132   on end-key undo main-block, return error substitute('trn-docw end-key main-block,&1', return-value )
    10133   :
    10134     assign
    10135       v-new-trn-doc = new(ub.trn-doc)
    10136     .
    10137   do :
    10138     if ub.trn-doc.ext-doc-type = ""
    10139     or ub.trn-doc.ext-doc-type = ?
    10140     then do:
    10141       v-message = "Не задан расширенный тип документа" .
    10142       if g#news = false and g#esys = false and g#auto = false then
    10143       message
    10144         vss-workfile vss-revision vss-description skip
    10145         v-message skip
    10146         "Документ" ub.trn-doc.doc-code skip
    10147         "Тип документа" ub.trn-doc.ext-doc-type skip
    10148         "doc-type" ub.trn-doc.doc-type skip
    10149         "internal" ub.trn-doc.internal skip
    10150         "discnt-type" ub.trn-doc.discnt-type skip
    10151         "ret-supp" ub.trn-doc.ret-supp skip
    10152         "pay-code" ub.trn-doc.pay-code skip
    10153         view-as alert-box error .
    10154       undo main-block, return error v-message .
    10155     end.
    10156     if v-new-trn-doc = false
    10157     and ub.trn-doc.ext-doc-type <> old-doc.ext-doc-type
    10158     and not (old-doc.ext-doc-type = 'iv':U or ub.trn-doc.ext-doc-type = 'iv':U)
    10159     then do:
    10160       v-message = "Расширенный тип документа нельзя менять" .
    10161       if g#news = false and g#esys = false and g#auto = false then
    10162       message
    10163         vss-workfile vss-revision vss-description skip
    10164         v-message skip
    10165         "Документ" ub.trn-doc.doc-code skip
    10166         "Новый тип документа" ub.trn-doc.ext-doc-type skip
    10167         "Старый тип документа" old-doc.ext-doc-type skip
    10168         "doc-type" ub.trn-doc.doc-type skip
    10169         "internal" ub.trn-doc.internal skip
    10170         "discnt-type" ub.trn-doc.discnt-type skip
    10171         "ret-supp" ub.trn-doc.ret-supp skip
    10172         "pay-code" ub.trn-doc.pay-code skip
    10173         view-as alert-box error .
    10174       undo, return error v-message .
    10175     end.
    10176     else do:
    10177       if old-doc.ext-doc-type <> ub.trn-doc.ext-doc-type then do:
    10178         for each buf_doc-line exclusive-lock where
    10179                  buf_doc-line.doc-code = ub.trn-doc.doc-code
    10180         :
    10181           buf_doc-line.ext-doc-type = ub.trn-doc.ext-doc-type.
    10182         end.
    10183       end.
    10184     end.
    10185   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10186   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chkextdt in g#library
    10187     (buffer ub.trn-doc
    10188     ) no-error .
    10189     if error-status :error then do:
