     5211                 "Клиентское количество" archive_parts.cli-qnty skip
     5212                 view-as alert-box error .
     5213               undo, return error .
     5214             end.
     5215             if archive_parts.in-code <> archive_parts.out-code
     5216             then do:
     5217               if can-do('рас,спи':U,buf_trn-doc.doc-type)
     5218               or (buf_trn-doc.doc-type = 'инв':U
     5219                   and archive_parts.fact-qnty < 0)
     5220               then do:
     5221                 assign
     5222                   v-rsrv-code = 'free-zone':U
     5223                 .
     5224               end.
     5225               else do:
     5226                 assign
     5227                   v-rsrv-code = 'out-zone':U
     5228                 .
     5229               end.
     5230               run partcopy in this-procedure
     5231                 (input  true
