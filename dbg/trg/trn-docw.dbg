     4725               find current buf_marking-lines exclusive-lock .
     4726               delete buf_marking-lines .
     4727               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4728                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     4729                 then do :
     4730                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4731                   validate buf_marking.
     4732                 end.
     4733               end .
     4734             end .
     4735             else do :
     4736               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     4737               create buf_marking-lines .
     4738               assign
     4739                 buf_marking-lines.mark       = orig_marking-lines.mark
     4740                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4741                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4742                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4743                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4744                 buf_marking-lines.in-code    = buf_parts.in-code
     4745                 buf_marking-lines.out-code   = buf_parts.out-code
     4746                 buf_marking-lines.part-code  = buf_parts.part-code
     4747                 buf_marking-lines.prt-code   = buf_parts.prt-code
     4748               .
     4749               validate buf_marking-lines.
     4750               if buf_parts.out-code <> buf_parts.in-code
     4751               and buf_parts.out-code <> 'free-zone':U
     4752               and buf_parts.out-code <> 'out-zone':U
     4753               then do :
     4754                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     4755                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     4756               end .
     4757               end.
     4758             end .
     4759             release buf_marking-lines no-error .
     4760           end.
     4761         end .
     4762         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     4763         then do:
     4764           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     4765                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     4766                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     4767                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4768                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4769                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4770                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4771                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4772                                                   .
     4773             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     4774                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     4775                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     4776                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     4777                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     4778                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     4779                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     4780                                                    no-error .
     4781             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     4782               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4783                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     4784               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     4785                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     4786               validate ub.marking.
     4787             end.
     4788             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     4789             if available (buf_marking-lines)
     4790             then do:
     4791               assign
     4792                 buf_marking-lines.mark       = p-mark
     4793                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4794                 buf_marking-lines.gds-code   = buf_goods.gds-code
     4795                 buf_marking-lines.obj-type   = buf_parts.obj-type
     4796                 buf_marking-lines.obj-code   = buf_parts.obj-code
     4797                 buf_marking-lines.in-code    = buf_parts.in-code
     4798                 buf_marking-lines.out-code   = buf_parts.out-code
     4799                 buf_marking-lines.part-code  = buf_parts.part-code
     4800               .
     4801               validate buf_marking-lines.
     4802             end.
     4803           end.
     4804         end.
     4805       end.
     4806       else do:
     4807         find first buf_parts exclusive-lock
     4808           where recid(buf_parts) = recid(buf_orig_parts)
     4809           .
     4810       end.
     4811       if p-out-code = 'free-zone':U
     4812       or p-out-code = 'out-zone':U
     4813       then do:
     4814         if buf_parts.rsrv-free <>
     4815          (if buf_parts.out-code = 'free-zone':U then yes else no)
     4816         then do:
     4817           message
     4818             vss-workfile vss-revision vss-description skip
     4819             vss-include-info22 skip
     4820             "Ошибка типа резерва партии" skip
     4821             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     4822             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4823             "Партия" buf_parts.in-code buf_parts.part-code skip
     4824             "Резерв" buf_parts.out-code skip
     4825             "Статус" buf_parts.status_ skip
     4826             "Тип резерва" buf_parts.rsrv-free skip
     4827             view-as alert-box error .
     4828           undo, return error .
     4829         end.
     4830       end.
     4831     end.
     4832   end procedure.
     4833   procedure partcopy-to-childs-mark :
     4834     define parameter buffer buf_ml for ub.marking-lines .
     4835     define parameter buffer buf_orig-ml for ub.marking-lines .
     4836     define input parameter p-out-code as character no-undo .
     4837     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     4838     define buffer buf_ml-childs for ub.marking-lines .
     4839     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     4840       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4841         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     4842       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     4843         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     4844       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     4845         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     4846         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     4847         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     4848         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     4849         and buf_ml-childs.part-code = buf_orig-ml.part-code
     4850         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     4851         :
     4852         assign
     4853           buf_ml-childs.out-code  = p-out-code
     4854         .
     4855         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     4856       end.
     4857     end.
     4858   end.
     4859   procedure partcopy-update-parts :
     4860     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4861     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     4862     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     4863     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4864     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4865     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4866     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     4867     define buffer buf_trn-doc for ub.trn-doc .
     4868     define buffer archive_parts for ub.parts .
     4869     define buffer buf_parts   for ub.parts .
     4870     define buffer orig_marking-lines for ub.marking-lines .
     4871     define buffer buf_marking for ub.marking .
     4872     define buffer buf_goods for ub.goods .
     4873     define variable v-rsrv-code     as character no-undo .
     4874     define variable v-goods-twounit as logical   no-undo .
     4875     define variable v-value-character as character no-undo .
     4876     define variable v-value-date      as date no-undo .
     4877     define variable v-value-decimal   as decimal no-undo .
     4878     define variable v-value-integer   as integer no-undo .
     4879     define variable v-izlcstpr        as logical no-undo .
     4880     define variable v-tth             as handle no-undo .
     4881     define variable v-type            as character no-undo .
     4882     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     4883     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     4884     do
     4885     on error undo, return error return-value
     4886     :
     4887       find first buf_trn-doc no-lock
     4888         where buf_trn-doc.doc-code = p-doc-code
     4889         no-error .
     4890       if not available buf_trn-doc
     4891       then do:
     4892         message
     4893           vss-workfile vss-revision vss-description skip
     4894           vss-include-info22 skip
     4895           "Ошибка задания входных параметров" skip
     4896           "Не найден документ" skip
     4897           "Документ" p-doc-code skip
     4898           "Объект" p-obj-type p-obj-code skip
     4899           "Артикул" p-artic p-prod-type p-prod-code skip
     4900           error-status :get-message(1) skip
     4901           return-value skip
     4902           view-as alert-box error .
     4903         undo, return error .
     4904       end.
     4905       find first buf_goods no-lock where buf_goods.artic = p-artic
     4906                                      and buf_goods.prod-type = p-prod-type
     4907                                      and buf_goods.prod-code = p-prod-code
     4908                                      no-error .
     4909       if not available buf_goods
     4910       then do:
     4911         message
     4912           vss-workfile vss-revision vss-description skip
     4913           vss-include-info22 skip
     4914           "Ошибка задания входных параметров" skip
     4915           "Не найден товар" skip
     4916           "Документ" p-doc-code skip
     4917           "Объект" p-obj-type p-obj-code skip
     4918           "Артикул" p-artic p-prod-type p-prod-code skip
     4919           error-status :get-message(1) skip
     4920           return-value skip
     4921           view-as alert-box error .
     4922         undo, return error .
     4923       end.
     4924       if buf_trn-doc.ext-doc-type = 'vt':U
     4925       then do :
     4926           delete object v-tth no-error.
     4927           run adm/shattri.p (
     4928              input "get":U
     4929             ,input buf_trn-doc.obj-type
     4930             ,input buf_trn-doc.obj-code
     4931             ,input 'inv-obj':U
     4932             ,input  "izlcstpr"
     4933             ,output v-value-character
     4934             ,output v-value-date
     4935             ,output v-value-decimal
     4936             ,output v-value-integer
     4937             ,output v-izlcstpr
     4938             ,output v-type
     4939             ,INPUT-OUTPUT table-handle v-tth
     4940             ) no-error .
     4941             delete object v-tth no-error.
     4942           if error-status:error then do:
     4943             v-izlcstpr = false .
     4944           end.
     4945       end.
     4946       else do :
     4947           v-izlcstpr = false .
     4948       end.
     4949   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4950   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4951     (input  p-artic
     4952     ,input  p-prod-type
     4953     ,input  p-prod-code
     4954     ,input  'twounit=request':u
     4955     ,output v-goods-twounit
     4956     ) no-error .
     4957       if error-status :error
     4958       then do:
     4959         message
     4960           vss-workfile vss-revision vss-description skip
     4961           vss-include-info22 skip
     4962           "Ошибка при определении атрибута товара" skip
     4963           "Артикул" p-artic p-prod-type p-prod-code skip
     4964           error-status :get-message(1) skip
     4965           return-value skip
     4966           view-as alert-box error .
     4967         undo, return error .
     4968       end.
     4969       define query partcopy-select-parts for archive_parts .
     4970       open query partcopy-select-parts preselect each archive_parts
     4971         where archive_parts.obj-type  = p-obj-type
     4972           and archive_parts.obj-code  = p-obj-code
     4973           and archive_parts.artic     = p-artic
     4974           and archive_parts.prod-type = p-prod-type
     4975           and archive_parts.prod-code = p-prod-code
     4976           and archive_parts.out-code  = p-doc-code
     4977         .
     4978       get first partcopy-select-parts .
     4979       if buf_trn-doc.doc-type = 'при':U
     4980       then do:
     4981         do while available archive_parts
     4982         on error undo, return error return-value
     4983         :
     4984           if can-do('рас,спи':U, buf_trn-doc.doc-type)
     4985           or (buf_trn-doc.doc-type = 'инв':U
     4986               and archive_parts.fact-qnty < 0)
     4987           then do:
     4988             assign
     4989               v-rsrv-code = 'out-zone':U
     4990             .
     4991           end.
     4992           else do:
     4993             assign
     4994               v-rsrv-code = 'free-zone':U
     4995             .
     4996           end.
     4997           assign
     4998             archive_parts.status_   = yes
     4999             archive_parts.rsrv-free = ?
     5000           .
     5001           if archive_parts.in-code = p-doc-code
     5002           then do:
     5003             assign
     5004               archive_parts.fact-num  = buf_trn-doc.fact-num
     5005               archive_parts.fact-date = buf_trn-doc.fact-date
     5006               archive_parts.doc-type  = buf_trn-doc.doc-type
     5007             .
     5008           end.
     5009           if archive_parts.fact-qnty <> 0
     5010           then do:
     5011             run partcopy in this-procedure
     5012               (input  true
     5013               ,input  v-rsrv-code
     5014               ,buffer archive_parts
     5015               ,buffer buf_parts
     5016               ,input  ""
     5017               ) no-error .
     5018             if error-status :error
     5019             then do:
     5020               message
     5021                 vss-workfile vss-revision vss-description skip
     5022                 vss-include-info22 skip
     5023                 "Ошибка при создании партии" skip
     5024                 "Документ" p-doc-code skip
     5025                 "Объект" p-obj-type p-obj-code skip
     5026                 "Артикул" p-artic p-prod-type p-prod-code skip
     5027                 "Партия" archive_parts.in-code archive_parts.part-code skip
     5028                 "Резерв" v-rsrv-code skip
     5029                 error-status :get-message(1) skip
     5030                 return-value skip
     5031                 view-as alert-box error .
     5032               undo, return error .
     5033             end.
     5034             assign
     5035               buf_parts.qnty      = buf_parts.qnty     + archive_parts.fact-qnty
     5036               buf_parts.fact-qnty = buf_parts.qnty
     5037             .
     5038             if v-goods-twounit = true
     5039             then do:
     5040               assign
     5041                 buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     5042               .
     5043               case buf_trn-doc.ext-doc-type :
     5044                 when 'ie':U
     5045                 then do:
     5046                   if archive_parts.cli-qnty <> truncate(archive_parts.cli-qnty, 0 )
     5047                   then do:
     5048                     message
     5049                       vss-workfile vss-revision vss-description skip
     5050                       vss-include-info22 skip
     5051                       "Клиентское количество для товара," skip
     5052                       "который учитывается по двум единицам измерения" skip
     5053                       "должно равняться единице" skip
     5054                       "Документ" p-doc-code skip
     5055                       "Объект" p-obj-type p-obj-code skip
     5056                       "Артикул" p-artic p-prod-type p-prod-code skip
     5057                       "Партия" archive_parts.in-code archive_parts.part-code skip
     5058                       "Количество по документу" archive_parts.qnty skip
     5059                       "Фактическое количество" archive_parts.fact-qnty skip
     5060                       "Клиентское количество" archive_parts.cli-qnty skip
     5061                       view-as alert-box error .
     5062                     undo, return error .
     5063                   end.
     5064                 end.
     5065                 when 'iv':U
     5066                 then do:
     5067                   if archive_parts.cli-qnty <> 1
     5068                   then do:
     5069                     message
     5070                       vss-workfile vss-revision vss-description skip
     5071                       vss-include-info22 skip
     5072                       "Клиентское количество для товара," skip
     5073                       "который учитывается по двум единицам измерения" skip
     5074                       "должно равняться единице" skip
     5075                       "Документ" p-doc-code skip
     5076                       "Объект" p-obj-type p-obj-code skip
     5077                       "Артикул" p-artic p-prod-type p-prod-code skip
     5078                       "Партия" archive_parts.in-code archive_parts.part-code skip
     5079                       "Количество по документу" archive_parts.qnty skip
     5080                       "Фактическое количество" archive_parts.fact-qnty skip
     5081                       "Клиентское количество" archive_parts.cli-qnty skip
     5082                       view-as alert-box error .
     5083                     undo, return error .
     5084                   end.
     5085                 end.
     5086                 otherwise do:
     5087                   message
     5088                     vss-workfile vss-revision vss-description skip
     5089                     vss-include-info22 skip
     5090                     "Товар учитывается по двум единицам измерения" skip
     5091                     "Для приходов разрешен только внешний приход или приход перемещение" skip
     5092                     "Документ" p-doc-code skip
     5093                     "Объект" p-obj-type p-obj-code skip
     5094                     "Артикул" p-artic p-prod-type archive_parts.prod-code skip
     5095                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5096                     "Количество по документу" archive_parts.qnty skip
     5097                     "Фактическое количество" archive_parts.fact-qnty skip
     5098                     "Клиентское количество" archive_parts.cli-qnty skip
     5099                     view-as alert-box error .
     5100                   undo, return error .
     5101                 end.
     5102               end.
     5103             end.
     5104             else do:
     5105               if buf_parts.cli-base-rate <> 0
     5106               then do:
     5107                 assign
     5108                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5109                 .
     5110               end.
     5111               else do:
     5112                 assign
     5113                   buf_parts.cli-qnty = 0
     5114                 .
     5115               end.
     5116             end.
     5117             if  buf_parts.qnty      = 0
     5118             and buf_parts.fact-qnty = 0
     5119             then do:
     5120               if v-goods-twounit = true
     5121               then do:
     5122                 if buf_parts.cli-qnty <> 0
     5123                 then do:
     5124                   message
     5125                     vss-workfile vss-revision vss-description skip
     5126                     vss-include-info22 skip
     5127                     "Ошибка при удалении партии" skip
     5128                     "Документ" p-doc-code skip
     5129                     "Объект" p-obj-type p-obj-code skip
     5130                     "Артикул" p-artic p-prod-type p-prod-code skip
     5131                     "Партия" buf_parts.in-code buf_parts.part-code skip
     5132                     "Резерв" buf_parts.out-code skip
     5133                     "qnty" buf_parts.qnty skip
     5134                     "fact-qnty" buf_parts.fact-qnty skip
     5135                     "cli-qnty" buf_parts.cli-qnty skip
     5136                     view-as alert-box error .
     5137                   undo, return error .
     5138                 end.
     5139               end.
     5140               delete buf_parts .
     5141             end.
     5142           end.
     5143           else do :
     5144             if buf_trn-doc.ext-doc-type = 'iv':U
     5145             then
     5146             for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     5147                                                   and orig_marking-lines.obj-type   = archive_parts.obj-type
     5148                                                   and orig_marking-lines.obj-code   = archive_parts.obj-code
     5149                                                   and orig_marking-lines.in-code    = archive_parts.in-code
     5150                                                   and orig_marking-lines.out-code   = archive_parts.out-code
     5151                                                   and orig_marking-lines.part-code  = archive_parts.part-code,
     5152             first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5153               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     5154             end .
     5155           end .
     5156           get next partcopy-select-parts .
     5157         end.
     5158       end.
     5159       if buf_trn-doc.doc-type = 'рас':U
     5160       or buf_trn-doc.doc-type = 'спи':U
     5161       or buf_trn-doc.doc-type = 'возврат':U
     5162       or buf_trn-doc.doc-type = 'инв':U
     5163       then do:
     5164         do while available archive_parts
     5165         on error undo, return error return-value
     5166         :
     5167           assign
     5168             archive_parts.status_   = yes
     5169             archive_parts.rsrv-free = ?
     5170           .
     5171           if archive_parts.fact-qnty <> archive_parts.qnty
     5172           then do:
     5173             define variable v-is-hold as logical   no-undo .
     5174   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5175   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     5176     (input  buf_trn-doc.doc-code
     5177     ,output v-is-hold
     5178     ) no-error .
     5179             if error-status :error
     5180             then do:
     5181               message
     5182                 vss-workfile vss-revision vss-description skip
     5183                 vss-include-info22
