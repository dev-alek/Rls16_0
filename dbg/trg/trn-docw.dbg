     9592   procedure lineattr-write-add-line-cli :
     9593   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     9594   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     9595   define input  parameter p-cli-type      as character no-undo .
     9596   define input  parameter p-cli-code      as integer   no-undo .
     9597   define input  parameter p-contract-code as integer   no-undo .
     9598   define input  parameter p-host-code     as integer   no-undo .
     9599   define input  parameter p-exch-code     as integer   no-undo .
     9600   define input  parameter p-exch-rate     as decimal   no-undo .
     9601   define input  parameter p-exch-scale    as integer   no-undo .
     9602   define input  parameter p-sum-cli       as decimal   no-undo .
     9603   define input  parameter p-sum-vat       as decimal   no-undo .
     9604   define buffer buf_doc-line-attr for ub.doc-line-attr .
     9605     do
     9606     on error undo, return error return-value
     9607     :
     9608       find first buf_doc-line-attr exclusive-lock
     9609         where buf_doc-line-attr.doc-code  = p-doc-code
     9610           and buf_doc-line-attr.gds-code  = p-gds-code
     9611           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     9612                                             chr(4) + p-cli-type +
     9613                                             chr(4) + string(p-cli-code) +
     9614                                             chr(4) + string(p-contract-code) +
     9615                                             chr(4) + string(p-host-code)
     9616         no-error .
     9617       if not available buf_doc-line-attr then do:
     9618         create buf_doc-line-attr .
     9619         assign
     9620           buf_doc-line-attr.doc-code  = p-doc-code
     9621           buf_doc-line-attr.gds-code  = p-gds-code
     9622           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     9623                                         chr(4) + p-cli-type +
     9624                                         chr(4) + string(p-cli-code) +
     9625                                         chr(4) + string(p-contract-code) +
     9626                                         chr(4) + string(p-host-code)
     9627         .
     9628       end.
     9629       assign
     9630         buf_doc-line-attr.attr-value =
     9631         string(p-exch-code)  + chr(4) +
     9632         string(p-exch-rate)  + chr(4) +
     9633         string(p-exch-scale) + chr(4) +
     9634         string(p-sum-cli)    + chr(4) +
     9635         string(p-sum-vat)
     9636         .
     9637     end.
     9638   end procedure.
     9639   procedure lineattr-value-add-line-cli :
     9640   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     9641   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     9642   define input   parameter p-cli-type      as character no-undo .
     9643   define input   parameter p-cli-code      as integer   no-undo .
     9644   define input   parameter p-contract-code as integer   no-undo .
     9645   define input   parameter p-host-code     as integer   no-undo .
     9646   define output  parameter p-exch-code     as integer   no-undo .
     9647   define output  parameter p-exch-rate     as decimal   no-undo .
     9648   define output  parameter p-exch-scale    as integer   no-undo .
     9649   define output  parameter p-sum-cli       as decimal   no-undo .
     9650   define output  parameter p-sum-vat       as decimal   no-undo .
     9651   define buffer buf_doc-line-attr for ub.doc-line-attr .
     9652     do
     9653     on error undo, return error return-value
     9654     :
     9655       find first buf_doc-line-attr exclusive-lock
     9656         where buf_doc-line-attr.doc-code  = p-doc-code
     9657           and buf_doc-line-attr.gds-code  = p-gds-code
     9658           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     9659                                             chr(4) + p-cli-type +
     9660                                             chr(4) + string(p-cli-code) +
     9661                                             chr(4) + string(p-contract-code) +
     9662                                             chr(4) + string(p-host-code)
     9663         no-error .
     9664       if available buf_doc-line-attr then do:
     9665        assign
     9666           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     9667           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     9668           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     9669           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     9670           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     9671          .
     9672        end.
     9673     end.
     9674   end procedure.
     9675   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     9676     define variable v-code as character no-undo .
     9677     define variable v-type as character no-undo .
     9678     define variable v-gds-code as integer   no-undo .
     9679   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9680   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     9681     (input  local-doc-line.artic
     9682     ,input  local-doc-line.prod-type
     9683     ,input  local-doc-line.prod-code
     9684     ,output v-gds-code
     9685     )  .
     9686     run lineattr-value (
     9687         input   local-doc-line.doc-code ,
     9688         input   v-gds-code              ,
     9689         input   'reason-code':U ,
     9690         output  v-code                  ,
     9691         output  v-type ) .
     9692     find first ub.trn-reason no-lock where
     9693                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     9694     if not available ub.trn-reason then do:
     9695        return "" .
     9696     end.
     9697     else do:
     9698        return ub.trn-reason.reason-name .
     9699     end.
     9700   end function.
     9701   procedure lineattr-value-parts :
     9702     do
     9703     on error undo, return error return-value
     9704     :
     9705       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     9706       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     9707       define input  parameter p-part-code   as character no-undo .
     9708       define input  parameter p_in-code     as character no-undo .
     9709       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     9710       define output parameter p-value       as    decimal   no-undo .
     9711       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9712       find first buf_doc-line-attr no-lock
     9713         where buf_doc-line-attr.doc-code  = p-doc-code
     9714           and buf_doc-line-attr.gds-code  = p-gds-code
     9715           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     9716         no-error .
     9717       if avail buf_doc-line-attr then do:
     9718         assign
     9719           p-value = decimal( buf_doc-line-attr.attr-value)
     9720         .
     9721       end.
     9722       else do:
     9723         assign
     9724           p-value = 0
     9725         .
     9726       end.
     9727     end.
     9728   end procedure.
     9729   procedure lineattr-write-parts :
     9730     do
     9731     on error undo, return error return-value
     9732     :
     9733       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     9734       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9735       define input parameter p-part-code  as character no-undo .
     9736       define input parameter p_in-code    as character no-undo .
     9737       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     9738       define input parameter p-value      as decimal   no-undo .
     9739       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9740       find first buf_doc-line-attr exclusive-lock
     9741         where buf_doc-line-attr.doc-code  = p-doc-code
     9742           and buf_doc-line-attr.gds-code  = p-gds-code
     9743           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     9744         no-error .
     9745       if not available buf_doc-line-attr then do:
     9746         create buf_doc-line-attr .
     9747         assign
     9748           buf_doc-line-attr.doc-code  = p-doc-code
     9749           buf_doc-line-attr.gds-code  = p-gds-code
     9750           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     9751         .
     9752       end.
     9753       assign
     9754         buf_doc-line-attr.attr-value = string( p-value )
     9755       .
     9756     end.
     9757   end procedure.
