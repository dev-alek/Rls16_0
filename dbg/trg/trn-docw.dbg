     5507                       vss-workfile vss-revision vss-description skip
     5508                       vss-include-info22 skip
     5509                       "Ошибка при удалении партии" skip
     5510                       "Документ" p-doc-code skip
     5511                       "Объект" p-obj-type p-obj-code skip
     5512                       "Артикул" p-artic p-prod-type p-prod-code skip
     5513                       "Партия" buf_parts.in-code buf_parts.part-code skip
     5514                       "Резерв" buf_parts.out-code skip
     5515                       "qnty" buf_parts.qnty skip
     5516                       "fact-qnty" buf_parts.fact-qnty skip
     5517                       "cli-qnty" buf_parts.cli-qnty skip
     5518                       view-as alert-box error .
     5519                     undo, return error .
     5520                   end.
     5521                 end.
     5522                 delete buf_parts .
     5523               end.
     5524             end.
     5525           end.
     5526           if  ( archive_parts.in-code = buf_trn-doc.doc-code
     5527           and archive_parts.supp-type =
