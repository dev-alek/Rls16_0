     5262                     vss-workfile vss-revision vss-description skip
     5263                     vss-include-info22 skip
     5264                     "Клиентское количество для товара," skip
     5265                     "который учитывается по двум единицам измерения" skip
     5266                     "должно равняться единице" skip
     5267                     "Документ" p-doc-code skip
     5268                     "Объект" p-obj-type p-obj-code skip
     5269                     "Артикул" p-artic p-prod-type p-prod-code skip
     5270                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5271                     "Количество по документу" archive_parts.qnty skip
