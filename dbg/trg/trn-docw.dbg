     1490     define variable v-update-sign   as decimal   no-undo .
     1491     define variable v-doc-sign      as decimal   no-undo .
     1492     do
     1493     on error undo, return error return-value
     1494     :
     1495       if p-trn-doc-close = true
     1496       then do:
     1497         assign
     1498           v-update-sign = 1.0
     1499         .
     1500       end.
     1501       else do:
     1502         assign
     1503           v-update-sign = -1.0
     1504         .
     1505       end.
     1506       find first buf_doc-line no-lock
     1507         where buf_doc-line.doc-code  = p-doc-code
     1508           and buf_doc-line.artic     = p-artic
     1509           and buf_doc-line.prod-type = p-prod-type
     1510           and buf_doc-line.prod-code = p-prod-code
     1511         no-error .
