     4453         if not available buf_trn-doc
     4454         then
     4455            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     4456         if (
     4457             p-out-code = 'free-zone':U
     4458             and buf_orig_parts.in-code = buf_orig_parts.out-code
     4459            )
     4460         or
     4461            (
     4462             p-out-code = 'free-zone':U
     4463             and available pri_trn-doc
     4464             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     4465            )
     4466         or
     4467            (
     4468             available buf_trn-doc
     4469             and p-out-code = buf_trn-doc.doc-code
     4470             and buf_trn-doc.ext-doc-type = 'vt':U
     4471            )
     4472         or
     4473            (
     4474             p-mark = ""
     4475             and available buf_trn-doc
     4476             and p-out-code = 'free-zone':U
     4477             and buf_trn-doc.ext-doc-type = 'vt':U
     4478            )
     4479         or
     4480            (
     4481             p-mark = ""
     4482             and available buf_trn-doc
     4483             and p-out-code = 'free-zone':U
     4484             and buf_trn-doc.ext-doc-type = 'rs':U
     4485            )
     4486         then do :
     4487           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     4488             and ub.goods.prod-type = buf_parts.prod-type
     4489             and ub.goods.prod-code = buf_parts.prod-code.
     4490           def buffer buf_orig_ml for ub.marking-lines.
