     4500             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4501             then do :
     4502               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     4503                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     4504               end .
     4505               next .
     4506             end .
