      930   procedure trndocrs-clear :
      931     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      932     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      933     do
      934     on error undo, return error return-value
      935     :
      936       for each buf_temp-trndocrs-gds-dtl-rsrv
      937       on error undo, return error return-value
      938       :
