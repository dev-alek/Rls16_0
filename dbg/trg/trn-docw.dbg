    13694   procedure init-local-vars :
    13695     do
    13696     on error undo, return error return-value
    13697     :
    13698       if ub.trn-doc.obj-type = 'скл':U
    13699       then do:
    13700         find first ub.store no-lock
    13701           where ub.store.obj-code = ub.trn-doc.obj-code
    13702           .
    13703         assign
    13704           loc#obj-active  = ub.store.active
    13705           loc#in-ov = ub.store.in-ov
    13706         .
    13707       end.
    13708       else do:
    13709         find first ub.shop no-lock
    13710           where ub.shop.obj-code = ub.trn-doc.obj-code
    13711           .
    13712         assign
    13713           loc#obj-active  = yes
    13714           loc#in-ov = ub.shop.in-ov
    13715         .
    13716       end.
    13717     end.
    13718   end procedure.
    13719   procedure update-archive-parts-on-fact-close :
    13720     do
    13721     on error undo, return error return-value
    13722     :
    13723       for each buf_doc-line
    13724         where buf_doc-line.doc-code = ub.trn-doc.doc-code
    13725       on error undo, return error return-value
    13726       :
    13727         for each buf_parts
    13728           where buf_parts.out-code  = ub.trn-doc.doc-code
    13729             and buf_parts.obj-type  = ub.trn-doc.obj-type
    13730             and buf_parts.obj-code  = ub.trn-doc.obj-code
    13731             and buf_parts.artic     = buf_doc-line.artic
    13732             and buf_parts.prod-type = buf_doc-line.prod-type
    13733             and buf_parts.prod-code = buf_doc-line.prod-code
    13734         on error undo, return error return-value
    13735         :
    13736           assign
    13737             buf_parts.fact-num  = ub.trn-doc.fact-num
    13738             buf_parts.fact-date = ub.trn-doc.fact-date
    13739             buf_parts.doc-type  = ub.trn-doc.doc-type
    13740           .
    13741         end.
    13742       end.
    13743     end.
    13744   end procedure.
    13745   procedure show-action :
    13746     do
    13747     on error undo, return error return-value
    13748     :
    13749       define input parameter p-action as character no-undo .
    13750       assign
    13751         v-current-time = string(integer(truncate((etime - v-start-time) / 1000, 0)), 'HH:MM:SS':U)
    13752         v-current-action = p-action
    13753       .
    13754       display
    13755         v-current-time v-current-action
    13756         with frame a.
    13757     end.
    13758   end procedure.
    13759   procedure process-inquiry :
    13760     do
    13761     on error undo, return error return-value
    13762     :
    13763       run show-action in this-procedure
    13764         (input "Поиск не снятых резервов"
    13765         ).
    13766       for each buf_parts no-lock
    13767         where buf_parts.out-code = ub.trn-doc.doc-code
    13768       on error undo, return error return-value
    13769       :
    13770         message
    13771           vss-workfile vss-revision vss-description skip
    13772           "Найдены не снятые резервы" skip
    13773           "Документ" ub.trn-doc.doc-code skip
    13774           "Расширенный тип документа" ub.trn-doc.ext-doc-type skip
    13775           "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
    13776           "Присвоение статуса запрос невозможно" skip
    13777           view-as alert-box error .
    13778         undo, return error return-value .
    13779       end.
    13780       if  g#news
    13781       and g#db-num            = 0
    13782       and ub.trn-doc.status_  = 'запрос':U
    13783       and ub.trn-doc.flag_    = true
    13784       and ub.trn-doc.doc-type = 'при':U
    13785       and ub.trn-doc.internal = true
    13786       then do:
    13787         run trg/trn-docv.p (input ub.trn-doc.doc-code , output p-error , output v-message ) .
    13788         if p-error = true then do:
    13789           undo, return error v-message .
    13790         end.
    13791         run show-action in this-procedure
    13792           (input "Отправка документа в новости"
    13793           ).
    13794         run str/callnews.p
    13795           (input "trn-doc"
    13796           ,input (buffer ub.trn-doc:handle)
    13797           ) no-error .
    13798         if error-status :error
    13799         then do:
    13800           message
    13801             vss-workfile vss-revision vss-description skip
    13802             "Невозможно маршрутизировать ub.trn-doc для отправки в новости" skip
    13803             "Документ" ub.trn-doc.doc-code skip
    13804             error-status :get-message(1) skip
    13805             return-value skip
    13806             view-as alert-box error .
    13807           undo, return error return-value .
    13808         end.
    13809       end.
    13810       if  g#news = false
    13811       and (ub.trn-doc.status_ = 'запрос':U
    13812            and ub.trn-doc.flag_ = true
    13813           )
    13814       then do:
    13815         run show-action in this-procedure
    13816           (input "Отправка запроса в новости"
    13817           ).
    13818         run str/callnews.p
    13819           (input "trn-doc"
    13820           ,input (buffer ub.trn-doc:handle)
    13821           ) no-error .
    13822         if error-status :error
    13823         then do:
    13824           message
    13825             vss-workfile vss-revision vss-description skip
    13826             "Невозможно маршрутизировать trn-doc для отправки в новости" skip
    13827             "Документ" ub.trn-doc.doc-code skip
    13828             error-status :get-message(1) skip
    13829             return-value skip
    13830             view-as alert-box error .
    13831           undo, return error return-value .
    13832         end.
    13833       end.
    13834     end.
    13835   end procedure.
    13836   procedure update-doc-sum :
    13837     define input  parameter p-doc-code   as character no-undo .
    13838     define input  parameter p-fact-order as decimal   no-undo .
    13839     define buffer buf_trn-doc-sum  for ub.trn-doc-sum.
    13840     define buffer buf_doc-line-sum for ub.doc-line-sum.
    13841     do
    13842     on error undo, return error return-value
    13843     :
    13844       for each buf_trn-doc-sum exclusive-lock
    13845         where buf_trn-doc-sum.doc-code = p-doc-code
    13846       on error undo, return error return-value
    13847       :
    13848         assign
    13849           buf_trn-doc-sum.fact-order = p-fact-order
    13850         .
    13851       end.
    13852       for each buf_doc-line-sum exclusive-lock
    13853         where buf_doc-line-sum.doc-code = p-doc-code
    13854       on error undo, return error return-value
    13855       :
    13856         assign
    13857           buf_doc-line-sum.fact-order = p-fact-order
    13858         .
    13859       end.
    13860     end.
    13861   end procedure.
