     1516           "Не найдена строка документа" skip
     1517           "Документ" p-doc-code skip
     1518           "Товар" p-artic p-prod-code p-prod-type skip
     1519           view-as alert-box error .
     1520         undo, return error return-value .
     1521       end.
     1522       if buf_doc-line.fact-order = ?
     1523       or buf_doc-line.fact-order = 0
     1524       then do:
     1525         message
     1526           vss-workfile vss-revision vss-description skip
     1527           "Не задан логический номер строки документа" skip
     1528           "Документ" buf_doc-line.doc-code skip
     1529           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1530           "Логический номер документа" buf_doc-line.fact-order skip
     1531           view-as alert-box error .
     1532         undo, return error return-value .
     1533       end.
     1534       find first buf_goods no-lock
     1535         where buf_goods.artic     = p-artic
     1536           and buf_goods.prod-type = p-prod-type
     1537           and buf_goods.prod-code = p-prod-code
     1538         .
     1539       assign
     1540         v-obj-type  = buf_doc-line.obj-type
     1541         v-obj-code  = buf_doc-line.obj-code
     1542       .
     1543       find first buf_trn-doc no-lock
