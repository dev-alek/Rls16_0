     8167     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
     8168     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
     8169     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     8170     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
     8171     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     8172     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
