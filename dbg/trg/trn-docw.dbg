     7458     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     7459     define variable vardoc-type     as   character              no-undo.
     7460     do
     7461     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     7462     :
     7463       find first bf_price-list no-lock
     7464         where recid(bf_price-list) = parrecid
     7465         no-error .
     7466       if not available bf_price-list
     7467       then do:
     7468         return error "Ошибка во входящих параметрах prl-vat.i" .
     7469       end.
     7470       find first bf_goods no-lock
     7471         where bf_goods.artic     = bf_price-list.artic
     7472           and bf_goods.prod-type = bf_price-list.prod-type
     7473           and bf_goods.prod-code = bf_price-list.prod-code
     7474         no-error .
     7475       if not available bf_goods
