     5309                   assign
     5310                     buf_parts.cli-qnty = 0
     5311                   .
     5312                 end.
     5313               end.
     5314             end.
     5315             if  available buf_parts
     5316             and buf_parts.qnty      = 0
     5317             and buf_parts.fact-qnty = 0
     5318             then do:
     5319               if v-goods-twounit = true
     5320               then do:
     5321                 if buf_parts.cli-qnty <> 0
     5322                 then do:
