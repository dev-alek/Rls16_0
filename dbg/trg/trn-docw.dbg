     4572                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4573                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4574                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
