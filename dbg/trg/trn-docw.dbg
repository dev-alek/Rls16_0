     5575                   buf_parts.fact-qnty = buf_parts.qnty
     5576                 .
     5577                 if buf_trn-doc.ext-doc-type = 'rv':U
     5578                 then
     5579                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     5580                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     5581                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     5582                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     5583                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     5584                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     5585                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     5586                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5587                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     5588                   then
