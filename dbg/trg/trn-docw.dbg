     4509                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     4510                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     4511                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     4512                                                   and ub.marking-lines.out-code = p-out-code
     4513                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     4514                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     4515                                                   no-error .
     4516             if not available ub.marking-lines
     4517             then do :
