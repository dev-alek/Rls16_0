     7422       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
     7423       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
     7424       define variable transport-base-locoprl         like ub.doc-line.price-base no-undo.
     7425       define variable transport-rubl-locoprl         like ub.doc-line.price-rubl no-undo.
