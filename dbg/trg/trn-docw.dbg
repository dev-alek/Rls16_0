     5613                     .
     5614                   end.
     5615                   else do:
     5616                     assign
     5617                       buf_parts.cli-qnty = 0
     5618                     .
     5619                   end.
     5620                 end.
     5621             end.
     5622           end.
     5623           get next partcopy-select-parts .
     5624         end.
     5625       end.
     5626     end.
     5627   end procedure.
     5628   procedure partcopy-update-parts-delete :
     5629     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     5630     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     5631     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     5632     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     5633     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     5634     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     5635     define variable objMarks as class excisemarks no-undo.
     5636     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
     5637     define buffer buf_trn-doc    for ub.trn-doc .
     5638     define buffer archive_parts  for ub.parts .
     5639     define buffer buf_parts      for ub.parts .
