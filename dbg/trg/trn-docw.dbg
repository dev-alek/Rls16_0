      894     field rsrv-qnty        like ub.pl-gds.free-qnty
      895     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
      896     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
      897     field before-free-qnty like ub.pl-gds.fact-qnty
      898     field before-out-qnty  like ub.pl-gds.fact-qnty
      899     field after-free-qnty  like ub.pl-gds.fact-qnty
      900     field after-out-qnty   like ub.pl-gds.fact-qnty
