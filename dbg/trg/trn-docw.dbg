    13109   end procedure .
    13110   procedure process-line :
    13111     do
    13112     on error undo, return error return-value
    13113     :
    13114       define variable v-root-node like ub.gds-prt.node-code no-undo .
    13115       define variable v-today as date      no-undo.
    13116       define variable v-time  as integer   no-undo.
    13117       define variable return-AssMin   as logical   no-undo .
    13118       define variable return-igt      as character no-undo .
    13119       define variable gdop-min-stock  as decimal   no-undo .
    13120       define variable grop-max-stock  as decimal   no-undo .
    13121       define variable grop-level-always-presence  as decimal   no-undo .
    13122       define variable grop-min-order as decimal   no-undo .
    13123       def buffer buf_parts for ub.parts .
    13124       assign
    13125         num_rec   = num_rec + 1
    13126       .
    13127       if num_rec mod 10 = 0
    13128       then do:
    13129         assign
    13130           v-current-time = string(integer(truncate((etime - v-start-time) / 1000, 0)), 'HH:MM:SS':U)
    13131         .
    13132         display
    13133           num_rec buf_doc-line.artic num_gds v-current-time v-current-action
    13134           with frame a.
    13135       end.
    13136       assign
    13137         buf_doc-line.fact-order   = ub.trn-doc.fact-order
    13138         buf_doc-line.status_      = ub.trn-doc.status_
    13139         buf_doc-line.ext-doc-type = ub.trn-doc.ext-doc-type
    13140       .
    13141       find first buf_inv-line exclusive-lock
    13142         where buf_inv-line.doc-code  = buf_doc-line.doc-code
    13143           and buf_inv-line.artic     = buf_doc-line.artic
    13144           and buf_inv-line.prod-type = buf_doc-line.prod-type
    13145           and buf_inv-line.prod-code = buf_doc-line.prod-code
    13146         no-error.
    13147       if available buf_inv-line then do:
    13148         assign
    13149           buf_inv-line.fact-order   = ub.trn-doc.fact-order
    13150           buf_inv-line.status_      = ub.trn-doc.status_
    13151           buf_inv-line.host-code    = ub.trn-doc.host-code
    13152           buf_inv-line.obj-type     = ub.trn-doc.obj-type
    13153           buf_inv-line.obj-code     = ub.trn-doc.obj-code
    13154           buf_inv-line.ext-doc-type = ub.trn-doc.ext-doc-type
    13155         .
    13156       end.
    13157       find first buf_goods no-lock
    13158         where buf_goods.artic     = buf_doc-line.artic
    13159           and buf_goods.prod-type = buf_doc-line.prod-type
    13160           and buf_goods.prod-code = buf_doc-line.prod-code
    13161         no-error .
    13162       if not available buf_goods
    13163       then do:
    13164         message
    13165           vss-workfile vss-revision vss-description skip
    13166           "Не найден товар" skip
    13167           "Документ" ub.trn-doc.doc-code skip
    13168           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
    13169           "" (if g#db-num = 0
    13170               then "Если товар был переименован," + chr(10)
    13171                  + "необходимо принять новости в УБД и переформировать пакеты"
    13172               else ""
    13173             ) skip
    13174           view-as alert-box error .
    13175         undo, return error return-value .
    13176       end.
    13177       find first buf_gds-obj no-lock where
    13178                  buf_gds-obj.gds-code  = buf_goods.gds-code and
    13179                  buf_gds-obj.obj-type  = ub.trn-doc.obj-type and
    13180                  buf_gds-obj.obj-code  = ub.trn-doc.obj-code and
    13181                  buf_gds-obj.cash-parts = true no-error .
    13182       if available buf_gds-obj then do:
    13183          if par-is-pharm = "yes"   then do:
    13184             buf_doc-line.is-parts = yes .
    13185             run create-price-cash-parts in this-procedure (
    13186                   input buf_doc-line.doc-code
    13187                 , input buf_goods.gds-code
