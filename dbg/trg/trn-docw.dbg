     8841   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$":U .
     8842   procedure lggdstrn :
     8843     define input  parameter parext-doc-type         like ub.trn-doc.ext-doc-type         no-undo.
     8844     define input  parameter pardoc-office           as   logical                         no-undo.
     8845     define input  parameter parpurch-code           like ub.trn-doc.purch-code           no-undo.
     8846     define input  parameter pargds-office           as   logical                         no-undo.
     8847     define input  parameter pargds-pl-reserv        as   logical                         no-undo.
     8848     define input  parameter pargds-is-twounit       as   logical                         no-undo.
     8849     define input  parameter pargds-is-serial        as   logical                         no-undo.
     8850     define input  parameter pargds-artic            like ub.goods.artic                  no-undo.
     8851     define input  parameter pargds-prod-type        like ub.goods.prod-type              no-undo.
     8852     define input  parameter pargds-prod-code        like ub.goods.prod-code              no-undo.
     8853     define input  parameter pardoc-code             like ub.trn-doc.doc-code             no-undo.
     8854     define output parameter pargds-is-legal         as   logical                         no-undo.
     8855     define variable is-hold as logical no-undo.
     8856     do
     8857     on error undo, return error return-value
     8858     :
     8859   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8860   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     8861     (input  pardoc-code
     8862     ,output is-hold
     8863     ) no-error .
     8864       if error-status :error or is-hold = ? then do: assign is-hold = no. end.
     8865       assign
     8866         pargds-is-legal = no
     8867       .
     8868       if  pargds-office
     8869       and parext-doc-type <> 'ee':U
     8870       and parext-doc-type <> 'es':U
     8871       and parext-doc-type <> 're':U
     8872       and parext-doc-type <> 'rs':U
     8873       and parext-doc-type <> 'wm':U
     8874       and parext-doc-type <> 'we':U
     8875       then do:
     8876         return error substitute( 'Услуга &2 &3 &4 недопустима в данном типе документа (&1 "&5").'
     8877                                , entry( lookup( parext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     8878                                , pargds-artic
     8879                                , pargds-prod-type
     8880                                , pargds-prod-code
     8881                                , pardoc-code      ).
     8882       end.
     8883       if parext-doc-type <> 'ee':U then do:
     8884       if pardoc-office <> pargds-office
     8885       then do:
     8886         if pardoc-office = yes
     8887         then do:
     8888           return error substitute( 'В документе "&1" уже есть услуги. Добавление товаров в документ недопустимо.'
     8889                                  , pardoc-code ).
     8890         end.
     8891         else do:
     8892           return error substitute( 'В документе "&1" уже есть товары. Добавление услуг в документ недопустимо.'
     8893                                  , pardoc-code ).
     8894         end.
     8895         end.
     8896       end.
     8897       if pargds-pl-reserv = yes
     8898       then do:
     8899         if parpurch-code = 3 then do:
     8900           return error substitute( 'Товар &1 &2 &3 резервируется по складским местам. '
     8901                                  + 'Он не может быть принят на ответственное хранение ("&4").'
     8902                                  , pargds-artic
     8903                                  , pargds-prod-type
     8904                                  , pargds-prod-code
     8905                                  , pardoc-code      ).
     8906         end.
     8907       end.
     8908       if pargds-is-serial = yes
     8909       then do:
     8910         if is-hold = yes
     8911         then do:
     8912           return error substitute( 'Серийный товар &1 &2 &3 не может быть в документе межфирменного перемещения "&4".'
     8913                                  , pargds-artic
     8914                                  , pargds-prod-type
     8915                                  , pargds-prod-code
     8916                                  , pardoc-code      ).
     8917         end.
     8918       end.
     8919       if pargds-is-twounit = yes
     8920       then do:
     8921         if is-hold = yes
     8922         then do:
     8923           return error substitute( '&1 &2 &3 : Товар, измеряющийся в двух единицах измерения, не может быть '
     8924                                  + 'в документе межфирменного перемещения "&4".'
     8925                                  , pargds-artic
     8926                                  , pargds-prod-type
     8927                                  , pargds-prod-code
     8928                                  , pardoc-code      ).
     8929         end.
     8930       end.
     8931       assign
     8932         pargds-is-legal = yes
     8933       .
     8934     end.
     8935   end procedure.
     8936   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8937   procedure cur-time :
     8938      define output parameter p-today as date      no-undo .
     8939      define output parameter p-time  as integer   no-undo .
     8940     do
     8941     on error undo, return error
     8942     :
     8943       define variable v-date1 as date      no-undo .
     8944       define variable v-date2 as date      no-undo .
     8945       define variable v-time  as integer   no-undo .
     8946       assign
     8947         v-date1 = today
     8948         v-time  = time
     8949         v-date2 = today
     8950       .
     8951       if v-date1 <> v-date2
     8952       then do:
     8953         assign
     8954           v-date1 = today
     8955           v-time  = v-time
     8956         .
     8957       end.
     8958       assign
     8959         p-today = v-date1
     8960         p-time  = v-time
     8961       .
     8962     end.
     8963   end.
     8964   function cur-time-date returns character
     8965   :
     8966     return string(today, '99/99/9999':U) .
     8967   end.
     8968   function cur-time-mjd returns decimal
     8969   :
     8970     define variable v-date as date      no-undo .
     8971     define variable v-time as integer   no-undo .
     8972     run cur-time in this-procedure
     8973       (output v-date
     8974       ,output v-time
     8975       ) .
     8976     return integer(v-date) - 2400002 + (v-time / 86400) .
     8977   end.
     8978   function cur-time-get-ending-index returns integer
     8979   (input p-number as integer
     8980   )
     8981   :
     8982     if p-number < 0
     8983     or p-number = ?
     8984     then do:
     8985       return 1 .
     8986     end.
     8987     define variable v-rest as integer   no-undo .
     8988     assign
     8989       p-number = p-number modulo 100
     8990     .
     8991     if p-number < 20
     8992     then do:
     8993       assign
     8994         v-rest = p-number
     8995       .
     8996     end.
     8997     else do:
     8998       assign
     8999         v-rest = p-number modulo 10
     9000       .
     9001     end.
     9002     case v-rest :
     9003       when 1
     9004       then do:
     9005         return 2 .
     9006       end.
     9007       when 2 or
     9008       when 3 or
     9009       when 4
     9010       then do:
     9011         return 3 .
     9012       end.
     9013       otherwise do:
     9014         return 1 .
     9015       end.
     9016     end case .
     9017   end.
     9018   procedure cur-time-mjd-to-date :
     9019      define input  parameter i-mjd-diff as decimal no-undo.
     9020      define output parameter o-Date     as date    no-undo.
     9021      define output parameter o-Time     as integer no-undo.
     9022      define variable v-day-number as integer   no-undo .
     9023      if    i-mjd-diff < 0
     9024         or i-mjd-diff = ?
     9025      then do:
     9026         return "?" .
     9027      end.
     9028      assign
     9029         v-day-number = truncate(i-mjd-diff,0).
     9030         o-Date = date(v-day-number + 2400002).
     9031         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     9032     .
     9033   end.
     9034   function cur-time-mjd-to-string returns character
     9035   (input p-mjd-diff as decimal
     9036   )
     9037   :
     9038     define variable v-day-number as integer   no-undo .
     9039     define variable v-seconds    as integer   no-undo .
     9040     define variable v-hour       as integer   no-undo .
     9041     define variable v-min        as integer   no-undo .
     9042     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     9043     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     9044     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     9045     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     9046     if p-mjd-diff < 0
     9047     or p-mjd-diff = ?
     9048     then do:
     9049       return "?" .
     9050     end.
     9051     assign
     9052       v-day-number = integer(truncate(p-mjd-diff,0))
     9053       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     9054     .
     9055     if v-seconds > 86400
     9056     then do:
     9057       assign
     9058         v-seconds = 86400 - 1
     9059       .
     9060     end.
     9061     if v-seconds < 0
     9062     then do:
     9063       assign
     9064         v-seconds = 0
     9065       .
     9066     end.
     9067     assign
     9068       v-hour = truncate(v-seconds / 3600, 0)
     9069     .
     9070     assign
     9071       v-seconds = v-seconds modulo 3600
     9072     .
     9073     assign
     9074       v-min = truncate(v-seconds / 60, 0)
     9075     .
     9076     assign
     9077       v-seconds = v-seconds modulo 60
     9078     .
     9079     return
     9080         (if v-day-number <> 0
     9081           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     9082           else ""
     9083         )
     9084       + (if v-day-number <> 0 or v-hour <> 0
     9085           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     9086           else ""
     9087         )
     9088       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     9089           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     9090           else ""
     9091         )
     9092       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     9093       .
     9094   end.
     9095   function cur-time-string returns character
     9096   :
     9097     define variable v-date as date      no-undo .
     9098     define variable v-time as integer   no-undo .
     9099     run cur-time in this-procedure
     9100       (output v-date
     9101       ,output v-time
     9102       ) .
     9103     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     9104   end.
     9105   function cur-time-string-sec returns character
     9106   :
     9107     define variable v-date as date      no-undo .
     9108     define variable v-time as integer   no-undo .
     9109     run cur-time in this-procedure
     9110       (output v-date
     9111       ,output v-time
     9112       ) .
     9113     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     9114   end.
     9115   function cur-time-custom  returns character
     9116   (input p-prefix as character
     9117   ,input p-date-format as character
     9118   ,input p-delimiter as character
     9119   ,input p-time-format as character
     9120   ,input p-suffix as character
     9121   )
     9122   :
     9123     define variable v-date as date      no-undo .
     9124     define variable v-time as integer   no-undo .
     9125     run cur-time in this-procedure
     9126       (output v-date
     9127       ,output v-time
     9128       ) .
     9129     return
     9130       p-prefix
     9131       + string(v-date, p-date-format)
     9132       + p-delimiter
     9133       + string(v-time, p-time-format)
     9134       + p-suffix
     9135       .
     9136   end.
     9137   function cur-time-print  returns character
     9138   :
     9139     define variable v-date as date      no-undo .
     9140     define variable v-time as integer   no-undo .
     9141     run cur-time in this-procedure
     9142       (output v-date
     9143       ,output v-time
     9144       ) .
     9145     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     9146   end.
     9147   function cur-time-datetime returns datetime
     9148   :
     9149     define variable v-char as character no-undo .
     9150     define variable v-datetime as datetime no-undo .
     9151     v-char = cur-time-string().
     9152     v-datetime = datetime(v-char).
     9153     return  v-datetime.
     9154   end.
     9155   function cur-time-string-msec returns character
     9156   :
     9157     define variable v-date as datetime  no-undo .
     9158     v-date = now.
     9159     return string(v-date) .
     9160   end.
     9161   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9162   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9163   define new global shared variable g#lib-nws as handle no-undo .
     9164   procedure clientsh_write-clients-proc  :
     9165   define parameter buffer buf_clients for ub.clients .
     9166   define input parameter p-source-type like ub.c-cli-hist.source-type no-undo .
     9167   define input parameter p-source-ref  like ub.c-cli-hist.source-ref no-undo .
     9168   define variable v-date as date      no-undo.
     9169   define variable v-time  as integer   no-undo.
     9170   define buffer buf_c-cli-hist for ub.c-cli-hist.
     9171   define buffer buf_c-clients for ub.c-clients.
     9172     do
     9173     on error undo, return error
     9174     :
     9175       if not available buf_clients then do:
     9176         message
     9177           vss-workfile vss-revision vss-description skip
     9178           "Ошибка задания входных параметров" skip
     9179           "Не определен контрагент" skip
     9180           view-as alert-box error .
     9181         undo, return error .
     9182       end.
     9183       if g#news then do:
     9184         define variable v-send as integer no-undo .
     9185         define variable v-subject as character no-undo .
     9186         case buf_clients.obj-type:
     9187           when 'орг':U then v-subject =  'firm':U.
     9188           when 'чел':U then v-subject =  'person':U.
     9189           when 'маг':U then v-subject =  'shop':U.
     9190           when 'скл':U then v-subject =  'store':U.
     9191         end case.
     9192         v-send = integer('0':U).
     9193   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9194   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     9195     (input  g#db-num
     9196     ,input  v-subject
     9197     ,input  0
     9198     ,input  '':U
     9199     ,input  0
     9200     ,input  '':U
     9201     ,input  '':U
     9202     ,input  '':U
     9203     ,input  0
     9204     ,input  0
     9205     ,input  0
     9206     ,input  'nws-to-hist'
     9207     ,output v-send
     9208     ) no-error .
     9209         if v-send < 0 then return.
     9210       end.
     9211       run cur-time in this-procedure(output v-date, output v-time).
     9212       create buf_c-clients.
     9213       buffer-copy buf_clients to buf_c-clients
     9214       assign
     9215       buf_c-clients.obj-code           = buf_clients.obj-code
     9216       buf_c-clients.obj-type           = buf_clients.obj-type
     9217       buf_c-clients.chip-num           = next-value (s-cli-chip, ub)
     9218       buf_c-clients.corr-time          = v-time
     9219       buf_c-clients.corr-user-db-num   = g#db-num
     9220       buf_c-clients.corr-user-name     = (if g#news
     9221                                           then (chr(4) +  'СПН':U)
     9222                                           else (if g#esys
     9223                                                 then (chr(4) +  'ВС':U)
     9224                                                 else g#userid)
     9225                                           )
     9226       buf_c-clients.corr-date          = v-date
     9227       .
     9228       create buf_c-cli-hist.
     9229       buffer-copy buf_c-clients to buf_c-cli-hist
     9230       assign
     9231       buf_c-cli-hist.action =  integer('2':U)
     9232       buf_c-cli-hist.subject = 'clients':U
     9233       buf_c-cli-hist.host-code = (if buf_clients.obj-type = 'орг':U
     9234                                   and
     9235                                   can-find(first ub.sysconf no-lock where
     9236                                                     ub.sysconf.host-code = buf_clients.obj-code)
     9237                                   then buf_clients.obj-code
     9238                                   else 0)
     9239       buf_c-cli-hist.is-news = g#news
     9240       buf_c-cli-hist.source-type = p-source-type
     9241       buf_c-cli-hist.source-ref = p-source-ref
     9242       .
     9243     end.
     9244   end procedure.
     9245   define new global shared variable g#libtfarh as handle no-undo .
     9246   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9247   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9248   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     9249   define variable par-type          as character no-undo.
     9250   define variable v-value-character as character no-undo .
     9251   define variable v-value-date      as date      no-undo .
     9252   define variable v-value-decimal   as decimal   no-undo .
     9253   define variable v-value-integer   as integer   no-undo .
     9254   define variable v-value-logical   as logical   no-undo .
     9255   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9256   procedure lineattr-value :
     9257     do
     9258     on error undo, return error return-value
     9259     :
     9260       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     9261       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9262       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     9263       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     9264       define output parameter p-type     as character no-undo .
     9265       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9266       def var v-format         as character no-undo .
     9267       def var v-fillin_width   as integer   no-undo .
     9268       def var v-fillin_height  as integer   no-undo .
     9269       def var v-label          as character no-undo .
     9270       def var v-user-can-edit  as logical   no-undo .
     9271       def var v-output-display as logical   no-undo .
     9272       def var v-other          as character no-undo .
     9273       run lineattr-code in this-procedure
     9274         (input  p-code
     9275         ,output p-type
     9276         ,output v-format
     9277         ,output v-fillin_width
     9278         ,output v-fillin_height
     9279         ,output v-label
     9280         ,output v-user-can-edit
     9281         ,output v-output-display
     9282         ,output v-other
     9283         ) no-error .
     9284       if error-status :error then do:
     9285         undo, return error return-value .
     9286       end.
     9287       find first buf_doc-line-attr no-lock
     9288         where buf_doc-line-attr.doc-code  = p-doc-code
     9289           and buf_doc-line-attr.gds-code  = p-gds-code
     9290           and buf_doc-line-attr.attr-code = p-code
     9291         no-error .
     9292       if avail buf_doc-line-attr then do:
     9293         assign
     9294           p-value =  buf_doc-line-attr.attr-value
     9295         .
     9296       end.
     9297       else do:
     9298         assign
     9299           p-value = if p-type = 'L':U then "no":U else ""
     9300         .
     9301       end.
     9302     end.
     9303   end procedure.
     9304   procedure lineattr-write :
     9305     do
     9306     on error undo, return error return-value
     9307     :
     9308       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     9309       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9310       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     9311       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     9312       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9313       def var v-type           as character no-undo .
     9314       def var v-format         as character no-undo .
     9315       def var v-fillin_width   as integer   no-undo .
     9316       def var v-fillin_height  as integer   no-undo .
     9317       def var v-label          as character no-undo .
     9318       def var v-user-can-edit  as logical   no-undo .
     9319       def var v-output-display as logical   no-undo .
     9320       def var v-other          as character no-undo .
     9321       run lineattr-code in this-procedure
     9322         (input  p-code
     9323         ,output v-type
     9324         ,output v-format
     9325         ,output v-fillin_width
     9326         ,output v-fillin_height
     9327         ,output v-label
     9328         ,output v-user-can-edit
     9329         ,output v-output-display
     9330         ,output v-other
     9331         ) no-error .
     9332       if error-status :error then do:
     9333         undo, return error return-value .
     9334       end.
     9335       find first buf_doc-line-attr exclusive-lock
     9336         where buf_doc-line-attr.doc-code  = p-doc-code
     9337           and buf_doc-line-attr.gds-code  = p-gds-code
     9338           and buf_doc-line-attr.attr-code = p-code
     9339         no-error .
     9340       if not available buf_doc-line-attr then do:
     9341         create buf_doc-line-attr .
     9342         assign
     9343           buf_doc-line-attr.doc-code  = p-doc-code
     9344           buf_doc-line-attr.gds-code = p-gds-code
     9345           buf_doc-line-attr.attr-code = p-code
     9346         .
     9347       end.
     9348       assign
     9349         buf_doc-line-attr.attr-value = p-value
     9350       .
     9351        release buf_doc-line-attr.
     9352     end.
     9353   end procedure.
     9354   procedure lineattr-exist :
     9355     do
     9356     on error undo, return error return-value
     9357     :
     9358       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     9359       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9360       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     9361       define output parameter p-exist   as logical  no-undo .
     9362       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9363       def var v-type           as character no-undo .
     9364       def var v-format         as character no-undo .
     9365       def var v-fillin_width   as integer   no-undo .
     9366       def var v-fillin_height  as integer   no-undo .
     9367       def var v-label          as character no-undo .
     9368       def var v-user-can-edit  as logical   no-undo .
     9369       def var v-output-display as logical   no-undo .
     9370       def var v-other          as character no-undo .
     9371       run lineattr-code in this-procedure
     9372         (input  p-code
     9373         ,output v-type
     9374         ,output v-format
     9375         ,output v-fillin_width
     9376         ,output v-fillin_height
     9377         ,output v-label
     9378         ,output v-user-can-edit
     9379         ,output v-output-display
     9380         ,output v-other
     9381         ) no-error .
     9382       if error-status :error then do:
     9383         undo, return error return-value .
     9384       end.
     9385       find first buf_doc-line-attr no-lock
     9386         where buf_doc-line-attr.doc-code  = p-doc-code
     9387           and buf_doc-line-attr.gds-code = p-gds-code
     9388           and buf_doc-line-attr.attr-code = p-code
     9389         no-error .
     9390       if  available buf_doc-line-attr then do:
     9391         p-exist = yes.
     9392       end.
     9393     end.
     9394   end procedure.
     9395   procedure lineattr-delete :
     9396     do
     9397     on error undo, return error return-value
     9398     :
     9399       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     9400       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9401       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     9402       define output parameter p-deleted  as logical no-undo.
     9403       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9404       def var v-type           as character no-undo .
     9405       def var v-format         as character no-undo .
     9406       def var v-fillin_width   as integer   no-undo .
     9407       def var v-fillin_height  as integer   no-undo .
     9408       def var v-label          as character no-undo .
     9409       def var v-user-can-edit  as logical   no-undo .
     9410       def var v-output-display as logical   no-undo .
     9411       def var v-other          as character no-undo .
     9412       run lineattr-code in this-procedure
     9413         (input  p-code
     9414         ,output v-type
     9415         ,output v-format
     9416         ,output v-fillin_width
     9417         ,output v-fillin_height
     9418         ,output v-label
     9419         ,output v-user-can-edit
     9420         ,output v-output-display
     9421         ,output v-other
     9422         ) no-error .
     9423       if error-status :error then do:
     9424         undo, return error return-value .
     9425       end.
     9426       find first buf_doc-line-attr exclusive-lock
     9427         where buf_doc-line-attr.doc-code  = p-doc-code
     9428           and buf_doc-line-attr.gds-code  = p-gds-code
     9429           and buf_doc-line-attr.attr-code = p-code
     9430         no-error NO-WAIT.
     9431       if not available buf_doc-line-attr then do:
     9432         p-deleted = no.
     9433       end.
     9434       else do:
     9435         delete buf_doc-line-attr.
     9436         p-deleted = yes.
     9437       end.
     9438     end.
     9439   end procedure.
     9440   procedure lineattr-code :
     9441     do on error undo, return error return-value
     9442     :
     9443       define input  parameter p-code           as character no-undo .
     9444       define output parameter p-type           as character no-undo .
     9445       define output parameter p-format         as character no-undo .
     9446       define output parameter p-fillin_width   as integer   no-undo .
     9447       define output parameter p-fillin_height  as integer   no-undo .
     9448       define output parameter p-label          as character no-undo .
     9449       define output parameter p-user-can-edit  as logical   no-undo .
     9450       define output parameter p-output-display as logical   no-undo .
     9451       define output parameter p-other          as character no-undo .
     9452       case p-code :
     9453               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     9454               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     9455               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     9456               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     9457               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     9458               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     9459               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     9460               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     9461               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     9462               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     9463               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     9464         otherwise do:
     9465           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     9466         end.
     9467       end.
     9468     end.
     9469   end procedure.
     9470   procedure lineattr-value-flora-gds :
     9471     do
     9472     on error undo, return error return-value
     9473     :
     9474       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     9475       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     9476       define input  parameter p-prt-code    as integer   no-undo .
     9477       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     9478       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     9479       define output parameter p-value       as    decimal   no-undo .
     9480       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9481       find first buf_doc-line-attr no-lock
     9482         where buf_doc-line-attr.doc-code  = p-doc-code
     9483           and buf_doc-line-attr.gds-code  = p-gds-code
     9484           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     9485         no-error .
     9486       if avail buf_doc-line-attr then do:
     9487         assign
     9488           p-value = decimal( buf_doc-line-attr.attr-value)
     9489         .
     9490       end.
     9491       else do:
     9492         assign
     9493           p-value = 0
     9494         .
     9495       end.
     9496     end.
     9497   end procedure.
     9498   procedure lineattr-write-flora-gds :
     9499     do
     9500     on error undo, return error return-value
     9501     :
     9502       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     9503       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9504       define input parameter p-prt-code    as integer   no-undo .
     9505       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9506       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     9507       define input parameter p-value    as decimal   no-undo .
     9508       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9509       find first buf_doc-line-attr exclusive-lock
     9510         where buf_doc-line-attr.doc-code  = p-doc-code
     9511           and buf_doc-line-attr.gds-code  = p-gds-code
     9512           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     9513         no-error .
     9514       if not available buf_doc-line-attr then do:
     9515         create buf_doc-line-attr .
     9516         assign
     9517           buf_doc-line-attr.doc-code  = p-doc-code
     9518           buf_doc-line-attr.gds-code  = p-gds-code
     9519           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     9520         .
     9521       end.
     9522       assign
     9523         buf_doc-line-attr.attr-value = string( p-value )
     9524       .
     9525     end.
     9526   end procedure.
     9527   procedure lineattr-delete-flora-gds :
     9528     do
     9529     on error undo, return error return-value
     9530     :
     9531       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     9532       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9533       define input  parameter p-prt-code    as integer   no-undo .
     9534       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9535       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     9536       define output parameter p-deleted  as logical no-undo.
     9537       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9538       find first buf_doc-line-attr exclusive-lock
     9539         where buf_doc-line-attr.doc-code  = p-doc-code
     9540           and buf_doc-line-attr.gds-code  = p-gds-code
     9541           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     9542         no-error NO-WAIT.
     9543       if not available buf_doc-line-attr then do:
     9544         p-deleted = no.
     9545       end.
     9546       else do:
     9547         delete buf_doc-line-attr.
     9548         p-deleted = yes.
     9549       end.
     9550     end.
     9551   end procedure.
     9552   procedure lineattr-delete-flora-all :
     9553     do
     9554     on error undo, return error return-value
     9555     :
     9556       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     9557       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     9558       define input  parameter p-prt-code    as integer   no-undo .
     9559       define buffer buf_doc-line-attr for ub.doc-line-attr .
     9560       for each buf_doc-line-attr exclusive-lock
     9561         where buf_doc-line-attr.doc-code  = p-doc-code
     9562           and buf_doc-line-attr.gds-code  = p-gds-code
     9563           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     9564        :
     9565         delete buf_doc-line-attr.
     9566       end.
     9567    end.
     9568   end procedure.
