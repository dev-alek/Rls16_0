     7202                                               if bf_parts.other-rubl < 0 then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "прочие расходы в рублях в партии",                                        bf_parts.other-rubl,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                         + " код партии " + string(bf_parts.part-code) + " " + " >>.".
     7203                                               if bf_parts.price-rubl - bf_parts.road-tax-rubl - (if bf_parts.transport-rubl <> ? then bf_parts.transport-rubl else 0) - (if bf_parts.other-rubl <> ? then bf_parts.other-rubl else 0) < 0 or bf_parts.price-rubl - bf_parts.road-tax-rubl - (if bf_parts.transport-rubl <> ? then bf_parts.transport-rubl else 0) - (if bf_parts.other-rubl <> ? then bf_parts.other-rubl else 0) = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "цена в рублях за вычетом компоненты " + varroad-taxname + " и всех расходов в партии",                                        bf_parts.price-rubl - bf_parts.road-tax-rubl - (if bf_parts.transport-rubl <> ? then bf_parts.transport-rubl else 0) - (if bf_parts.other-rubl <> ? then bf_parts.other-rubl else 0),                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                         + " код партии " + string(bf_parts.part-code) + " " + " >>.".
     7204                                               if bf_parts.price-base - bf_parts.road-tax-base - (if bf_parts.transport-base <> ? then bf_parts.transport-base else 0) - (if bf_parts.other-base <> ? then bf_parts.other-base else 0) < 0 or bf_parts.price-base - bf_parts.road-tax-base - (if bf_parts.transport-base <> ? then bf_parts.transport-base else 0) - (if bf_parts.other-base <> ? then bf_parts.other-base else 0) = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "цена в валюте за вычетом компоненты " + varroad-taxname + " и всех расходов в партии",                                        bf_parts.price-base - bf_parts.road-tax-base - (if bf_parts.transport-base <> ? then bf_parts.transport-base else 0) - (if bf_parts.other-base <> ? then bf_parts.other-base else 0),                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                         + " код партии " + string(bf_parts.part-code) + " " + " >>.".
     7205          end.
     7206      end.
     7207   end.
     7208   end.
     7209   procedure chksltpc :
     7210     do
     7211     on error undo, return error
     7212     :
     7213       define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     7214       define variable loc#cash-pay like ub.sysconf.cash-pay no-undo.
     7215       define buffer buf_trn-doc  for ub.trn-doc.
     7216       define buffer buf_sysconf  for ub.sysconf.
     7217       define buffer buf_doc-line for ub.doc-line.
     7218       define buffer buf_parts    for ub.parts.
     7219       define buffer buf_store    for ub.store.
     7220       define buffer buf_shop     for ub.shop.
     7221       def var v-have-slt-pc   as logical                  no-undo.
     7222       def var v-host-code     like ub.sysconf.host-code   no-undo .
     7223       find first buf_trn-doc no-lock
     7224         where buf_trn-doc.doc-code = pardoc-code
     7225         no-error
     7226         .
     7227       if not available buf_trn-doc then do:
     7228         return error "Ошибка задания входных параметров" + chr(10)
     7229           + "Не найден документ с номером " + pardoc-code
     7230           .
     7231       end.
     7232   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7234     (input  buf_trn-doc.obj-type
     7235     ,input  buf_trn-doc.obj-code
     7236     ,output v-host-code
     7237     )  .
     7238       find first buf_sysconf no-lock
     7239         where buf_sysconf.host-code = v-host-code
     7240         .
     7241       assign
     7242         loc#cash-pay  = buf_sysconf.cash-pay
     7243       .
     7244   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_st-sltyn in g#lib-trn3
     7245   (
     7246    input  recid(buf_trn-doc)
     7247   ,input  loc#cash-pay
     7248   ,output v-have-slt-pc
     7249   )
     7250   .
     7251       if v-have-slt-pc = no then do:
     7252          if buf_trn-doc.ext-doc-type = 'ep':U then do:
     7253             for each buf_doc-line no-lock
     7254              where buf_doc-line.doc-code =  buf_trn-doc.doc-code
     7255             on error undo, return error
     7256             :
     7257               for each buf_parts where buf_parts.out-code  = buf_trn-doc.doc-code   and
     7258                                        buf_parts.obj-type  = buf_doc-line.obj-type  and
     7259                                        buf_parts.obj-code  = buf_doc-line.obj-code  and
     7260                                        buf_parts.artic     = buf_doc-line.artic     and
     7261                                        buf_parts.prod-type = buf_doc-line.prod-type and
     7262                                        buf_parts.prod-code = buf_doc-line.prod-code:
     7263                  if buf_parts.slt-pc <> buf_doc-line.slt-pc then do:
     7264                     return error
     7265                     "В строке документа возврата поставщику " + buf_trn-doc.doc-code +
     7266                     " товар " + string(buf_doc-line.artic) + " " + buf_doc-line.prod-type + " " + string(buf_doc-line.prod-code) +
     7267                     " установлен налог с продаж " + string(buf_doc-line.slt-pc) + ", отличный от налога с продаж " + string(buf_parts.slt-pc) + " в партии с кодом " + (buf_parts.part-code) + " .".
     7268                  end.
     7269               end.
     7270             end.
     7271          end.
     7272          else do:
     7273            for each buf_doc-line no-lock
     7274              where buf_doc-line.doc-code =  buf_trn-doc.doc-code
     7275                and buf_doc-line.slt-pc   <> 0
     7276            on error undo, return error
     7277            :
     7278               return error
     7279                "В строке документа " + buf_trn-doc.doc-code +
     7280                " товар " + string(buf_doc-line.artic) + " " + buf_doc-line.prod-type + " " + string(buf_doc-line.prod-code) +
     7281                " установлен налог с продаж " + string(buf_doc-line.slt-pc) + ", отличный от 0." +
     7282                " Установка налога с продаж в данном документе недопустима.".
     7283            end.
     7284         end.
     7285       end.
     7286     end.
     7287   end procedure.
     7288   procedure chkvatpc :
     7289   do
     7290   on error undo, return error return-value
     7291   :
     7292     define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     7293     define buffer buf_trn-doc  for ub.trn-doc.
     7294     define buffer buf_doc-line for ub.doc-line.
     7295     define buffer buf_parts    for ub.parts.
     7296     find first buf_trn-doc no-lock
     7297       where buf_trn-doc.doc-code = pardoc-code
     7298       no-error
     7299       .
     7300     if not available buf_trn-doc then do:
     7301       return error "Ошибка задания входных параметров" + chr(10)
     7302         + "Не найден документ с номером " + pardoc-code
     7303         .
     7304     end.
     7305     if buf_trn-doc.ext-doc-type = 'ie':U and
     7306        buf_trn-doc.vat-type     = 'без':U     then do:
     7307       for each buf_doc-line no-lock
     7308            where buf_doc-line.doc-code =  buf_trn-doc.doc-code
     7309       on error undo, return error return-value
     7310       :
     7311          if buf_doc-line.vat-pc <> 0 then do:
     7312            return error
     7313             "В строке документа " + buf_trn-doc.doc-code +
     7314             " товар " + string(buf_doc-line.artic) + " " + buf_doc-line.prod-type + " " + string(buf_doc-line.prod-code) +
     7315             " установлен НДС " + string(buf_doc-line.vat-pc) + ", отличный от 0." +
     7316             " Установка НДС в данном документе с типом НДС - <без> недопустима.".
     7317          end.
     7318          for each buf_parts where buf_parts.out-code  = buf_trn-doc.doc-code   and
     7319                                   buf_parts.obj-type  = buf_doc-line.obj-type  and
     7320                                   buf_parts.obj-code  = buf_doc-line.obj-code  and
     7321                                   buf_parts.artic     = buf_doc-line.artic     and
     7322                                   buf_parts.prod-type = buf_doc-line.prod-type and
     7323                                   buf_parts.prod-code = buf_doc-line.prod-code on error undo, return error return-value :
     7324             if buf_parts.vat-pc <> 0 then do:
     7325                return error
     7326                "В строке документа " + buf_trn-doc.doc-code +
     7327                " товар " + string(buf_doc-line.artic) + " " + buf_doc-line.prod-type + " " + string(buf_doc-line.prod-code) +
     7328                " установлен НДС отличный от 0 в партии с кодом " + (buf_parts.part-code) + " . Это недопустимо для документа с типом НДС - без.".
     7329             end.
     7330          end.
     7331       end.
     7332     end.
     7333   end.
     7334   end procedure.
     7335   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
