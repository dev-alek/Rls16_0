     4336     define buffer buf_chk-doc for ub.chk-doc .
     4337     do
     4338     on error undo, return error return-value
     4339     :
     4340       if p-free-output-copy = true
     4341       then do:
     4342         if  p-out-code <> 'free-zone':U
     4343         and p-out-code <> 'out-zone':U
     4344         then do:
     4345           message
     4346             vss-workfile vss-revision vss-description skip
     4347             vss-include-info22 skip
     4348             "Ошибка задания входных параметров процедуры partcopy" skip
     4349             "p-free-output-copy" p-free-output-copy skip
     4350             "p-out-code" p-out-code skip
     4351             view-as alert-box error .
     4352           undo, return error .
     4353         end.
     4354       end.
     4355       if buf_orig_parts.out-code <> p-out-code
     4356       then do:
     4357         find first buf_parts exclusive-lock
     4358           where buf_parts.obj-type  = buf_orig_parts.obj-type
     4359             and buf_parts.obj-code  = buf_orig_parts.obj-code
     4360             and buf_parts.artic     = buf_orig_parts.artic
     4361             and buf_parts.prod-type = buf_orig_parts.prod-type
     4362             and buf_parts.prod-code = buf_orig_parts.prod-code
     4363             and buf_parts.in-code   = buf_orig_parts.in-code
     4364             and buf_parts.out-code  = p-out-code
     4365             and buf_parts.part-code = buf_orig_parts.part-code
     4366           no-error.
     4367         if not available buf_parts
     4368         then do:
     4369           define variable v-rsrv-free as logical   no-undo .
     4370           if p-out-code = 'free-zone':U
     4371           or p-out-code = 'out-zone':U
     4372           then do:
     4373             assign
     4374               v-rsrv-free =
     4375          (if p-out-code = 'free-zone':U then yes else no)
     4376             .
     4377           end.
     4378           else do:
     4379             assign
     4380               v-rsrv-free = ?
     4381             .
     4382           end.
     4383           create buf_parts .
     4384           buffer-copy buf_orig_parts to buf_parts
     4385           assign
     4386             buf_parts.out-code  = p-out-code
     4387             buf_parts.status_   = no
     4388             buf_parts.rsrv-free = v-rsrv-free
     4389             buf_parts.qnty      = 0
     4390             buf_parts.fact-qnty = 0
     4391             buf_parts.real-qnty = 0
     4392             buf_parts.cli-qnty  = 0
     4393           .
     4394           validate buf_parts .
     4395         end.
     4396         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     4397                                           ,input (buffer buf_orig_parts:handle)
     4398                                           ,output orig-part-key-rec).
     4399         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     4400                                           ,input (buffer buf_parts:handle)
     4401                                           ,output part-key-rec).
     4402         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     4403               and ub.gen-attr.p-key =  orig-part-key-rec:
     4404             if not valid-object (objMarks)
