     7444     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     7445     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     7446     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     7447     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     7448     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     7449     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     7450     define variable varobj-type    like ub.price-list.obj-type   no-undo.
