    13908   procedure create-price-cash-parts :
    13909   define input  parameter p-doc-code as character no-undo .
    13910   define input  parameter p-gds-code as integer   no-undo .
    13911   define input  parameter p-artic    as character no-undo .
    13912   define input  parameter p-prod-type as character no-undo .
    13913   define input  parameter p-prod-code as integer   no-undo .
    13914   define variable v-value  as decimal   no-undo .
    13915   define variable v-doc-num    like ub.price-list.doc-num    no-undo .
    13916   define variable v-price-sale like ub.price-list.price-sale no-undo .
    13917   define variable v-road-tax   like ub.price-list.road-tax   no-undo .
    13918   define variable v-excise     like ub.price-list.excise     no-undo .
    13919   define variable v-b-code as integer   no-undo .
    13920   define variable v-obj-type as character no-undo .
    13921   define variable v-obj-code as integer   no-undo .
    13922   define buffer buf_parts   for ub.parts  .
    13923   define buffer buf_trn-doc for ub.trn-doc  .
    13924   define variable v-price-target as character no-undo .
    13925   define variable v-price-target-type as character no-undo .
    13926     do
    13927     on error undo, return error return-value
    13928     :
    13929   find first buf_trn-doc no-lock where
    13930              buf_trn-doc.doc-code = p-doc-code no-error .
    13931       for each buf_parts no-lock where
    13932                buf_parts.out-code  = p-doc-code  and
    13933                buf_parts.obj-type  = buf_trn-doc.obj-type  and
    13934                buf_parts.obj-code  = buf_trn-doc.obj-code  and
    13935                buf_parts.artic     = p-artic     and
    13936                buf_parts.prod-type = p-prod-type and
    13937                buf_parts.prod-code = p-prod-code :
    13938               run lineattr-value-parts (
    13939                    input p-doc-code
    13940                   ,input p-gds-code
    13941                   ,input buf_parts.part-code
    13942                   ,input buf_parts.in-code
    13943                   ,input 'parts_price-sale':U
    13944                   ,output v-value ) .
    13945             if v-value = 0 then do:
    13946   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
    13947     (buffer buf_parts
    13948     ,output v-b-code
    13949     ) no-error .
    13950                 if error-status :error  or v-b-code = 0 then return error "no-bar-code-parts".
    13951                 v-obj-type = buf_trn-doc.obj-type .
    13952                 v-obj-code = buf_trn-doc.obj-code .
    13953                  if buf_trn-doc.ext-doc-type = 'iv':U then do:
    13954   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
    13955                           input 'price-target':U ,
    13956                          output v-price-target ,
    13957                          output v-price-target-type )  .
    13958                       if v-price-target <> "yes"  then do:
    13959                          v-obj-type = buf_trn-doc.cli-type .
    13960                          v-obj-code = buf_trn-doc.cli-code .
    13961                       end.
    13962                    end.
    13963   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13964   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
    13965     (input  v-obj-type
    13966     ,input  v-obj-code
    13967     ,input  v-b-code
    13968     ,input  0
    13969     ,input  0
    13970     ,output v-doc-num
    13971     ,output v-price-sale
    13972     ,output v-road-tax
    13973     ,output v-excise
    13974     )  .
    13975               run lineattr-write-parts (
    13976                   input p-doc-code
    13977                   ,input p-gds-code
    13978                   ,input buf_parts.part-code
    13979                   ,input buf_parts.in-code
    13980                   ,input 'parts_price-sale':U
    13981                   ,input v-price-sale
    13982                   ) no-error .
    13983             end.
    13984     end.
    13985     end.
    13986   end procedure.
