     2251         assign
     2252           v-prihod = true
     2253         .
     2254       end.
     2255       for each archive_parts no-lock
     2256         where archive_parts.out-code  = p-trn-doc-doc-code
     2257           and archive_parts.obj-type  = p-obj-type
     2258           and archive_parts.obj-code  = p-obj-code
     2259           and archive_parts.artic     = p-artic
     2260           and archive_parts.prod-type = p-prod-type
     2261           and archive_parts.prod-code = p-prod-code
     2262       on error undo, return error return-value
     2263       :
     2264         assign
     2265           v-change-qnty = archive_parts.fact-qnty
     2266           v-rsrv-qnty   = archive_parts.qnty
     2267         .
     2268         if p-goods-twounit = true
     2269         then do:
     2270           if archive_parts.fact-qnty = 0
     2271           then do:
     2272             assign
     2273               v-change-cli-qnty = 0
     2274             .
     2275           end.
     2276           else do:
     2277             if archive_parts.fact-qnty = archive_parts.qnty
     2278             then do:
     2279               assign
     2280                 v-change-cli-qnty = archive_parts.cli-qnty
     2281               .
     2282             end.
     2283             else do:
     2284               message
     2285                 vss-workfile vss-revision vss-description skip
     2286                 "Фактическое количество не совпадает с количеством по документу" skip
     2287                 "Документ" archive_parts.out-code skip
     2288                 "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     2289                 view-as alert-box error .
     2290               undo, return error return-value .
     2291             end.
     2292           end.
     2293         end.
     2294         else do:
     2295           assign
     2296             v-change-cli-qnty = archive_parts.fact-qnty / archive_parts.cli-base-rate
     2297           .
     2298         end.
     2299         if p-trn-doc-doc-type = 'рас':U
     2300         or p-trn-doc-doc-type = 'спи':U
     2301         then do:
     2302           assign
     2303             v-change-qnty     = - v-change-qnty
     2304             v-rsrv-qnty       = - v-rsrv-qnty
     2305             v-change-cli-qnty = - v-change-cli-qnty
     2306           .
     2307         end.
     2308         if p-place-rsrv = true then do:
     2309           run trndocrs-pl-gds-accum in this-procedure
     2310             (input archive_parts.pl-code
     2311             ,input (if p-need-rsrv = true then v-rsrv-qnty else 0.0)
     2312             ,input 0.0
     2313             ,input v-change-qnty
     2314             ,input 0.0
     2315             ) no-error .
     2316           if error-status :error then do:
     2317             message
     2318               vss-workfile vss-revision vss-description skip
     2319               "Ошибка при изменении зарезервированных количеств trndocrs-pl-gds-accum" skip
     2320               error-status :get-message(1) skip
     2321               return-value skip
     2322               view-as alert-box error .
     2323             undo, return error return-value .
     2324           end.
     2325         end.
     2326         assign
     2327           v-change-price-base = archive_parts.price-base * v-change-qnty
     2328           v-change-price-rubl = archive_parts.price-rubl * v-change-qnty
     2329         .
     2330         assign
     2331           p-total-qnty       = p-total-qnty       + v-change-qnty
     2332           p-total-cli-qnty   = p-total-cli-qnty   + v-change-cli-qnty
     2333           p-total-base-total = p-total-base-total + v-change-price-base
     2334           p-total-rubl-total = p-total-rubl-total + v-change-price-rubl
     2335           p-total-rsrv-qnty  = p-total-rsrv-qnty  + v-rsrv-qnty
     2336         .
     2337         if v-change-qnty > 0
     2338         then do:
     2339           assign
     2340             p-return-qnty        = p-return-qnty        + v-change-qnty
     2341             p-return-base-total  = p-return-base-total  + v-change-price-base
     2342             p-return-rubl-total  = p-return-rubl-total  + v-change-price-rubl
     2343           .
     2344         end.
     2345         else do:
     2346           assign
     2347             p-expense-qnty       = p-expense-qnty       + v-change-qnty
     2348             p-expense-base-total = p-expense-base-total + v-change-price-base
     2349             p-expense-rubl-total = p-expense-rubl-total + v-change-price-rubl
     2350           .
     2351         end.
     2352         assign
     2353           v-vozvrat = false
     2354         .
     2355         if p-trn-doc-doc-type = 'возврат':U
     2356         or (p-trn-doc-doc-type = 'инв':U
     2357             and archive_parts.fact-qnty > 0
     2358            )
     2359         then do:
     2360           assign
     2361             v-vozvrat = true
     2362           .
     2363         end.
     2364         if  v-prihod  <> true
     2365         and v-vozvrat <> true
     2366         and archive_parts.in-code = archive_parts.out-code
     2367         then do:
     2368           next.
     2369         end.
     2370         if v-vozvrat = true
     2371         then do:
     2372           find first check_archive_parts no-lock
     2373             where check_archive_parts.obj-type   = archive_parts.obj-type
     2374               and check_archive_parts.obj-code   = archive_parts.obj-code
     2375               and check_archive_parts.artic      = archive_parts.artic
     2376               and check_archive_parts.prod-type  = archive_parts.prod-type
     2377               and check_archive_parts.prod-code  = archive_parts.prod-code
     2378               and check_archive_parts.in-code    = archive_parts.in-code
     2379               and check_archive_parts.out-code   = 'free-zone':U
     2380               and check_archive_parts.part-code  = archive_parts.part-code
     2381             no-error .
     2382           if not available check_archive_parts
     2383           or check_archive_parts.fact-qnty <= 0
     2384           then do:
     2385             next.
     2386           end.
     2387         end.
     2388         assign
     2389           p-change-qnty       = p-change-qnty       + v-change-qnty
     2390           p-change-base-total = p-change-base-total + v-change-price-base
     2391           p-change-rubl-total = p-change-rubl-total + v-change-price-rubl
     2392         .
     2393       end.
     2394       if p-place-rsrv = true then do:
     2395         find first buf_goods no-lock
     2396           where buf_goods.artic     = p-artic
     2397             and buf_goods.prod-type = p-prod-type
     2398             and buf_goods.prod-code = p-prod-code
     2399           .
     2400         for each buf_doc-pl no-lock
     2401           where buf_doc-pl.obj-type = p-obj-type
     2402             and buf_doc-pl.obj-code = p-obj-code
     2403             and buf_doc-pl.out-code = p-trn-doc-doc-code
     2404             and buf_doc-pl.gds-code = buf_goods.gds-code
     2405         on error undo, return error return-value
     2406         :
     2407           assign
     2408             v-pl-change-qnty  = buf_doc-pl.fact-qnty
     2409             v-cli-change-qnty = buf_doc-pl.cli-fact-qnty
     2410             v-cli-rsrv-qnty   = (if p-need-rsrv = true then buf_doc-pl.cli-doc-qnty else 0.0)
     2411           .
     2412           if p-trn-doc-doc-type = 'рас':U
     2413           or p-trn-doc-doc-type = 'спи':U
     2414           then do:
     2415             assign
     2416               v-pl-change-qnty  = - v-pl-change-qnty
     2417               v-cli-change-qnty = - v-cli-change-qnty
     2418               v-cli-rsrv-qnty   = - v-cli-rsrv-qnty
     2419             .
     2420           end.
     2421           run trndocrs-pl-gds-accum in this-procedure
     2422             (input buf_doc-pl.pl-code
     2423             ,input 0.0
     2424             ,input v-cli-rsrv-qnty
     2425             ,input 0.0
     2426             ,input v-cli-change-qnty
     2427             ) no-error .
     2428           if error-status :error
     2429           then do:
     2430             message
     2431               vss-workfile vss-revision vss-description skip
     2432               "Ошибка при изменении зарезервированных количеств trndocrs-pl-gds-accum" skip
     2433               error-status :get-message(1) skip
     2434               return-value skip
     2435               view-as alert-box error .
     2436             undo, return error return-value .
     2437           end.
     2438           find first buf_temp-trndocrs-pl-gds-rsrv
     2439             where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_doc-pl.pl-code
     2440             .
     2441           if v-pl-change-qnty <> buf_temp-trndocrs-pl-gds-rsrv.fact-qnty
     2442             and v-pl-change-qnty <> 0.00
     2443           then do:
     2444             message
     2445               vss-workfile vss-revision vss-description skip
     2446               "Количество по партиям не совпадает с количеством по складским местам." skip
     2447               substitute( "Документ: &1", p-trn-doc-doc-code ) skip
     2448               substitute( "Товар: &1", buf_goods.gds-code )  skip
     2449               substitute( "Место хранения: &1", buf_doc-pl.pl-code )  skip
     2450               substitute( "Количество по партиям: &1 (&2)",  buf_temp-trndocrs-pl-gds-rsrv.fact-qnty , buf_goods.unit-base ) skip
     2451               substitute( "Количество по местам хр.: &1 (&2)", buf_doc-pl.fact-qnty, buf_goods.unit-base ) skip
     2452               view-as alert-box error .
     2453             undo, return error .
     2454           end.
     2455         end.
     2456       end.
     2457     end.
     2458   end procedure.
     2459   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2460   procedure partrqst :
     2461     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
     2462     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
     2463     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
     2464     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
     2465     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
     2466     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
     2467     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
     2468     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
     2469     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
     2470     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
     2471     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
     2472     define output parameter p-total-parts-price-base     as decimal                 no-undo .
     2473     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
     2474     define output parameter p-total-parts-transport-base as decimal                 no-undo .
     2475     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
     2476     define output parameter p-total-parts-other-base     as decimal                 no-undo .
     2477     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
     2478     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
     2479     do
     2480     on error undo, return error return-value
     2481     :
     2482       assign
     2483         p-total-parts-qnty           = 0
     2484         p-total-parts-fact-qnty      = 0
     2485         p-total-parts-cli-qnty       = 0
     2486         p-total-parts-fact-cli-qnty  = 0
     2487         p-total-parts-price-cli      = 0
     2488         p-total-parts-price-base     = 0
     2489         p-total-parts-price-rubl     = 0
     2490         p-total-parts-transport-base = 0
     2491         p-total-parts-transport-rubl = 0
     2492         p-total-parts-other-base     = 0
     2493         p-total-parts-other-rubl     = 0
     2494       .
     2495       define buffer buf_parts for ub.parts .
     2496       for each buf_parts no-lock
     2497         where buf_parts.out-code  = p-doc-code
     2498           and buf_parts.obj-type  = p-obj-type
     2499           and buf_parts.obj-code  = p-obj-code
     2500           and buf_parts.artic     = p-artic
     2501           and buf_parts.prod-type = p-prod-type
     2502           and buf_parts.prod-code = p-prod-code
     2503       on error undo, return error return-value
     2504       :
     2505         define variable v-parts-fact-multiplier as decimal   no-undo .
     2506         assign
     2507           v-parts-fact-multiplier = 1
     2508         .
     2509         if buf_parts.qnty <> 0 then do:
     2510           assign
     2511             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
     2512           .
     2513         end.
     2514         assign
     2515           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
     2516           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
     2517           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
     2518           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
     2519                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
     2520           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
     2521           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
     2522           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
     2523           p-total-parts-transport-base  = p-total-parts-transport-base
     2524                                         + buf_parts.fact-qnty
     2525                                           * (if   buf_parts.transport-base <> ?
     2526                                             then buf_parts.transport-base
     2527                                             else 0
     2528                                             )
     2529           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
     2530                                         + buf_parts.fact-qnty
     2531                                           * (if   buf_parts.transport-rubl <> ?
     2532                                             then buf_parts.transport-rubl
     2533                                             else 0
     2534                                             )
     2535           p-total-parts-other-base      = p-total-parts-other-base
     2536                                         + buf_parts.fact-qnty
     2537                                           * (if   buf_parts.other-base <> ?
     2538                                             then buf_parts.other-base
     2539                                             else 0
     2540                                             )
     2541           p-total-parts-other-rubl      = p-total-parts-other-rubl
     2542                                         + buf_parts.fact-qnty
     2543                                           * (if   buf_parts.other-rubl <> ?
     2544                                             then buf_parts.other-rubl
     2545                                             else 0
     2546                                             )
     2547         .
     2548       end.
     2549     end.
     2550   end procedure.
     2551   define new global shared variable g#lib-trn  as handle no-undo .
     2552   define new global shared variable g#lib-trn2 as handle no-undo .
     2553   define new global shared variable g#lib-trn3 as handle no-undo .
     2554   define new global shared variable g#lib-trn4 as handle no-undo .
     2555   function hvrdtax return logical (input parrecid as recid):
     2556   define variable varresult as logical no-undo.
     2557   run hvrdtax-proc (input parrecid, output varresult).
     2558   return varresult.
     2559   end function.
     2560   procedure hvrdtax-proc:
     2561   define input  parameter parrecid  as recid   no-undo.
     2562   define output parameter parresult as logical no-undo.
     2563   define buffer bf_goods for ub.goods.
     2564   define buffer bf_units for ub.units.
     2565   define buffer rt_tax   for ub.tax.
     2566   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     2567   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     2568   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     2569   if available rt_tax and
     2570       can-find(first ub.tax-units No-LOCK WHERE
     2571                      ub.tax-units.tax-code = rt_tax.tax-code AND
     2572                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     2573                                                       else assign parresult = no.
     2574   end procedure.
     2575   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2576   procedure gen-key-rec :
     2577     define input  parameter p-tbl-name    as character no-undo.
     2578     define input  parameter p-bh_tbl-name as handle    no-undo.
     2579     define output parameter p-key-rec     as character no-undo.
     2580     do
     2581     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2582     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2583     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2584     :
     2585       define variable fh               as handle    no-undo .
     2586       define variable v-ok             as logical   no-undo .
     2587       define variable v-inform         as character no-undo .
     2588       define variable v-ind            as integer   no-undo .
     2589       define variable v-idx-field-qnty as integer   no-undo .
     2590       if p-tbl-name = ?
     2591         or p-tbl-name = "":U
     2592       then do:
     2593         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info19 ).
     2594       end.
     2595       if not p-bh_tbl-name:available then do:
     2596         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info19, p-tbl-name ).
     2597       end.
     2598       assign
     2599         p-key-rec = p-tbl-name
     2600         v-inform  = p-bh_tbl-name:index-information(1)
     2601         v-ind     = 2
     2602       .
     2603       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2604       on error undo, return error
     2605       :
     2606         assign
     2607           v-inform = p-bh_tbl-name:index-information( v-ind )
     2608           v-ind    = v-ind + 1
     2609         .
     2610       end.
     2611       if v-inform = ?
     2612         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2613         or entry( 3, v-inform, ",":U ) <> "1":U
     2614       then do:
     2615         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info19, p-tbl-name ).
     2616       end.
     2617       else do:
     2618         assign
     2619           v-idx-field-qnty = num-entries( v-inform ) - 4
     2620         .
     2621         if v-idx-field-qnty < 2 then do:
     2622           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, p-tbl-name ).
     2623         end.
     2624         do v-ind = 1 to v-idx-field-qnty by 2
     2625         on error undo, return error
     2626         :
     2627           assign
     2628             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2629             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2630           .
     2631         end.
     2632       end.
     2633       if p-key-rec = ? then do:
     2634         assign
     2635           p-key-rec = "":U
     2636         .
     2637         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info19, p-tbl-name ).
     2638       end.
     2639     end.
     2640     return.
     2641   end procedure.
     2642   procedure gen-where-keyr-tab :
     2643     define input  parameter i-tableSerach as character no-undo.
     2644     define input  parameter i-tablekey   as character  no-undo.
     2645     define input  parameter p-key-rec    as character  no-undo.
     2646     define input  parameter p-key-handle as handle     no-undo .
     2647     define input  parameter p-db-name    as character  no-undo .
     2648     define input  parameter p-tt-handle  as handle     no-undo .
     2649     define output parameter o-Where      as character  no-undo.
     2650     do
     2651     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2652     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2653     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2654     :
     2655       define variable v-full-tbl-name  as character no-undo .
     2656       define variable bh_tbl-name      as handle    no-undo .
     2657       define variable fh_key           as handle    no-undo .
     2658       define variable fh_search        as handle    no-undo .
     2659       define variable v-field-num      as integer   no-undo .
     2660       define variable v-count-fld      as integer   no-undo .
     2661       define variable v-inform         as character no-undo .
     2662       define variable v-ind            as integer   no-undo .
     2663       define variable v-idx-field-qnty as integer   no-undo .
     2664       define variable v-field-name     as character no-undo .
     2665       define variable v-field-val      as character no-undo .
     2666       define variable v-word-link      as character no-undo .
     2667       define variable vTable           as character no-undo.
     2668       define variable bh_tbl-key       as handle    no-undo .
     2669       assign
     2670         p-key-rec = trim( p-key-rec )
     2671       .
     2672       if p-key-handle <> ? then do:
     2673         if not valid-handle(p-key-handle)
     2674            or p-key-handle:type <> "buffer"
     2675         then do:
     2676           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info19 ).
     2677         end.
     2678         if num-entries( p-key-rec, chr(3) ) > 1
     2679           or p-key-rec = ?
     2680           or p-key-rec = "":U
     2681         then do:
     2682           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info19, p-key-rec ).
     2683         end.
     2684       end.
     2685       else do:
     2686         if p-key-rec = ?
     2687           or p-key-rec = "":U
     2688         then do:
     2689           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info19 ).
     2690         end.
     2691       end.
     2692       assign
     2693         vTable = entry( 1 , p-key-rec, chr(3) )
     2694       .
     2695       if p-tt-handle <> ?
     2696         and ( not valid-handle(p-tt-handle)
     2697               or p-tt-handle:type <> "buffer"
     2698             )
     2699       then do:
     2700         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info19, vTable, chr(10) ).
     2701       end.
     2702       if p-tt-handle = ? then do:
     2703         assign
     2704           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2705         .
     2706         create buffer bh_tbl-name for table v-full-tbl-name .
     2707       end.
     2708       else do:
     2709         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2710       end.
     2711       assign
     2712         v-inform = bh_tbl-name:index-information(1)
     2713         v-ind    = 2
     2714       .
     2715       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2716       on error undo, return error
     2717       :
     2718         assign
     2719           v-inform = bh_tbl-name:index-information( v-ind )
     2720           v-ind    = v-ind + 1
     2721         .
     2722       end.
     2723       if v-inform = ?
     2724         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2725         or entry( 3, v-inform, ",":U ) <> "1":U
     2726       then do:
     2727         delete object bh_tbl-name no-error.
     2728         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info19, vTable ).
     2729       end.
     2730       assign
     2731         v-idx-field-qnty = num-entries( v-inform ) - 4
     2732       .
     2733       if v-idx-field-qnty < 2 then do:
     2734         delete object bh_tbl-name no-error.
     2735         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, vTable ).
     2736       end.
     2737       assign
     2738         o-where     = "where":U
     2739         v-word-link = "":U
     2740         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2741         v-count-fld = 0
     2742       .
     2743       if i-tablekey ne "" and i-tablekey ne ?
     2744       then do:
     2745         assign
     2746           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2747         .
     2748         create buffer bh_tbl-key for table v-full-tbl-name .
     2749       end.
     2750       if i-tableSerach ne "" and i-tableSerach ne ?
     2751       then do:
     2752         delete object bh_tbl-name no-error.
     2753         assign
     2754           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2755         .
     2756         create buffer bh_tbl-name for table v-full-tbl-name .
     2757       end.
     2758       block_where:
     2759       do v-ind = 1 to v-idx-field-qnty by 2
     2760       on error undo, return error
     2761       :
     2762         assign
     2763           v-count-fld = v-count-fld + 1
     2764         .
     2765         if p-key-handle = ?
     2766           and v-count-fld > v-field-num
     2767         then do:
     2768           leave block_where.
     2769         end.
     2770         define variable VfieldKeyTable as handle no-undo.
     2771         assign
     2772           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2773           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2774         .
     2775         if     bh_tbl-key ne ?
     2776         then do:
     2777            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2778            if VfieldKeyTable eq ?
     2779            then next block_where.
     2780         end.
     2781         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2782         then
     2783            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2784         else
     2785            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2786         if p-key-handle = ? then do:
     2787           assign
     2788             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2789           .
     2790         end.
     2791         else do:
     2792           assign
     2793             fh_key = p-key-handle:buffer-field( v-field-name )
     2794           .
     2795           if fh_key = ?
     2796             or not valid-handle( fh_key )
     2797           then do:
     2798             delete object bh_tbl-name.
     2799             if     bh_tbl-key ne ?
     2800             then
     2801                delete object bh_tbl-key.
     2802             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info19, p-key-handle:name, v-field-name ).
     2803           end.
     2804           assign
     2805             v-field-val = fh_key:buffer-value
     2806           .
     2807         end.
     2808         if fh_search:data-type ="character":U then do:
     2809           assign
     2810             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2811             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2812             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2813             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2814             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2815             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2816             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2817             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2818             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2819             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2820             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2821             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2822             v-field-val = substitute( '"&1"', v-field-val )
     2823           .
     2824         end.
     2825         assign
     2826           o-where = substitute( "&1 &2", o-where, v-field-val )
     2827         .
     2828         if v-word-link = "":U then do:
     2829           assign
     2830             v-word-link = "and":U
     2831           .
     2832         end.
     2833       end.
     2834       delete object bh_tbl-name.
     2835       if     bh_tbl-key ne ?
     2836       then
     2837          delete object bh_tbl-key.
     2838       if p-key-handle = ?
     2839         and v-count-fld <> v-field-num
     2840       then do:
     2841         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info19, vTable ).
     2842       end.
     2843     end.
     2844   end procedure.
     2845   procedure gen-hn-keyr-tab :
     2846     define input  parameter i-tableSerach as character no-undo.
     2847     define input  parameter i-tablekey   as character no-undo.
     2848     define input  parameter p-key-rec    as character no-undo.
     2849     define input  parameter p-key-handle as handle    no-undo .
     2850     define input  parameter p-db-name    as character no-undo .
     2851     define input  parameter p-tt-handle  as handle    no-undo .
     2852     define input  parameter p-stts-lock  as integer   no-undo .
     2853     define output parameter o-hn         as handle    no-undo.
     2854     define variable v-full-tbl-name as character no-undo.
     2855     define variable v-where         as character no-undo.
     2856     define variable bh_tbl-name     as handle    no-undo.
     2857     define variable vTable          as character no-undo.
     2858     do
     2859     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2860     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2861     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2862         run gen-where-keyr-tab(i-tableSerach,
     2863                                i-tablekey,
     2864                                p-key-rec,
     2865                                p-key-handle,
     2866                                p-db-name,
     2867                                p-tt-handle,
     2868                                output v-where).
     2869         if i-tableSerach ne "" and i-tableSerach ne ?
     2870         then do:
     2871            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2872            create buffer bh_tbl-name for table v-full-tbl-name .
     2873         end.
     2874         else do:
     2875            if p-tt-handle = ? then do:
     2876               assign
     2877                  vTable = entry( 1 , p-key-rec, chr(3) )
     2878               .
     2879               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2880               create buffer bh_tbl-name for table v-full-tbl-name .
     2881            end.
     2882            else do:
     2883               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2884            end.
     2885         end.
     2886         if p-tt-handle = ? then do:
     2887            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2888         end.
     2889         else do:
     2890            bh_tbl-name:find-first( v-where ) no-error .
     2891         end.
     2892         o-hn = bh_tbl-name.
     2893      end.
     2894   end procedure.
     2895   procedure gen-hn-keyr :
     2896     define input  parameter p-key-rec    as character no-undo.
     2897     define input  parameter p-key-handle as handle    no-undo .
     2898     define input  parameter p-db-name    as character no-undo .
     2899     define input  parameter p-tt-handle  as handle    no-undo .
     2900     define input  parameter p-stts-lock  as integer   no-undo .
     2901     define output parameter o-hn         as handle    no-undo.
     2902     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2903   end.
     2904   procedure gen-row-keyr :
     2905     define input  parameter p-key-rec    as character no-undo.
     2906     define input  parameter p-key-handle as handle    no-undo .
     2907     define input  parameter p-db-name    as character no-undo .
     2908     define input  parameter p-tt-handle  as handle    no-undo .
     2909     define input  parameter p-stts-lock  as integer   no-undo .
     2910     define output parameter p-tbl-row    as rowid     no-undo.
     2911     define output parameter p-tbl-name   as character no-undo.
     2912     define variable vHn as handle no-undo.
     2913       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2914       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2915       p-tbl-name =  vHn:table.
     2916       delete object vHn no-error.
     2917     if p-tbl-row = ? then do:
     2918       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info19, p-tbl-name, p-key-rec ).
     2919     end.
     2920     else do:
     2921       return.
     2922     end.
     2923   end procedure.
     2924   procedure gen-key-fv :
     2925     define input  parameter p-key-rec    as character no-undo .
     2926     define output parameter p-field-list as character no-undo .
     2927     define output parameter p-value-list as character no-undo.
     2928     do
     2929     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2930     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2931     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2932     :
     2933       define variable v-full-tbl-name  as character no-undo .
     2934       define variable bh_tbl-name      as handle    no-undo .
     2935       define variable v-tbl-name       as character no-undo .
     2936       define variable v-field-num      as integer   no-undo .
     2937       define variable v-count-fld      as integer   no-undo .
     2938       define variable v-inform         as character no-undo .
     2939       define variable v-ind            as integer   no-undo .
     2940       define variable v-idx-field-qnty as integer   no-undo .
     2941       define variable v-delim-key      as character no-undo .
     2942       if p-key-rec = ?
     2943         or p-key-rec = "":U
     2944       then do:
     2945         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info19 ).
     2946       end.
     2947       assign
     2948         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2949         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2950       .
     2951       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2952       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info19 ).
     2953       assign
     2954         v-inform = bh_tbl-name:index-information(1)
     2955         v-ind    = 2
     2956       .
     2957       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2958       on error undo, return error
     2959       :
     2960         assign
     2961           v-inform = bh_tbl-name:index-information( v-ind )
     2962           v-ind    = v-ind + 1
     2963         .
     2964       end.
     2965       if v-inform = ?
     2966         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2967         or entry( 3, v-inform, ",":U ) <> "1":U
     2968       then do:
     2969         delete object bh_tbl-name no-error.
     2970         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info19, v-tbl-name ).
     2971       end.
     2972       assign
     2973         v-idx-field-qnty = num-entries( v-inform ) - 4
     2974       .
     2975       if v-idx-field-qnty < 2 then do:
     2976         delete object bh_tbl-name no-error.
     2977         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, v-tbl-name ).
     2978       end.
     2979       assign
     2980         p-field-list = "":U
     2981         p-value-list = "":U
     2982         v-delim-key  = "":U
     2983         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2984         v-count-fld  = 0
     2985       .
     2986       block_where:
     2987       do v-ind = 1 to v-idx-field-qnty by 2
     2988       on error undo, return error
     2989       :
     2990         assign
     2991           v-count-fld = v-count-fld + 1
     2992         .
     2993         if v-count-fld > v-field-num then do:
     2994           leave block_where.
     2995         end.
     2996         assign
     2997           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2998           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2999         .
     3000         if v-ind = 1 then do:
     3001           assign
     3002             v-delim-key = chr(3)
     3003           .
     3004         end.
     3005       end.
     3006       delete object bh_tbl-name.
     3007       if v-count-fld <> v-field-num then do:
     3008         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info19, v-tbl-name ).
     3009       end.
     3010     end.
     3011   end procedure.
     3012   procedure gen-key-field :
     3013     define input  parameter p-table      as character no-undo .
     3014     define output parameter p-field-list as character no-undo .
     3015     do
     3016     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3017     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3018     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3019     :
     3020       define variable v-full-tbl-name  as character no-undo .
     3021       define variable bh_tbl-name      as handle    no-undo .
     3022       define variable v-tbl-name       as character no-undo .
     3023       define variable v-field-num      as integer   no-undo .
     3024       define variable v-count-fld      as integer   no-undo .
     3025       define variable v-inform         as character no-undo .
     3026       define variable v-ind            as integer   no-undo .
     3027       define variable v-idx-field-qnty as integer   no-undo .
     3028       define variable v-delim-key      as character no-undo .
     3029       if p-table = ?
     3030         or p-table = "":U
     3031       then do:
     3032         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info19 ).
     3033       end.
     3034       assign
     3035         v-tbl-name      = p-table
     3036         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3037       .
     3038       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3039       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info19 ).
     3040       assign
     3041         v-inform = bh_tbl-name:index-information(1)
     3042         v-ind    = 2
     3043       .
     3044       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3045       on error undo, return error
     3046       :
     3047         assign
     3048           v-inform = bh_tbl-name:index-information( v-ind )
     3049           v-ind    = v-ind + 1
     3050         .
     3051       end.
     3052       if v-inform = ?
     3053         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3054         or entry( 3, v-inform, ",":U ) <> "1":U
     3055       then do:
     3056         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info19, v-tbl-name ).
     3057       end.
     3058       assign
     3059         v-idx-field-qnty = num-entries( v-inform ) - 4
     3060       .
     3061       if v-idx-field-qnty < 2 then do:
     3062         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, v-tbl-name ).
     3063       end.
     3064       assign
     3065         p-field-list = "":U
     3066         v-delim-key  = "":U
     3067         v-count-fld  = 0
     3068       .
     3069       block_where:
     3070       do v-ind = 1 to v-idx-field-qnty by 2
     3071       on error undo, return error
     3072       :
     3073         assign
     3074           v-count-fld = v-count-fld + 1
     3075         .
     3076         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3077         if v-ind = 1 then do:
     3078           assign
     3079             v-delim-key = chr(3)
     3080           .
     3081         end.
     3082       end.
     3083       delete object bh_tbl-name.
     3084     end.
     3085   end procedure.
     3086   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3087   define variable vss-include-info21 as character format "X(65)" no-undo
     3088   initial "@(#)$Workfile$ $Revision$".
     3089   procedure xmlchar-test :
     3090   define input parameter p-in-string          as character        no-undo.
     3091   define output parameter p-out-string-enc    as character        no-undo.
     3092   define output parameter p-out-string-dec    as character        no-undo.
     3093   do
     3094   on error undo, return error
     3095   :
     3096          run xmlchar-encode in this-procedure
     3097       (
     3098             input p-in-string
     3099           , output p-out-string-enc
     3100       ).
     3101          run xmlchar-decode in this-procedure
     3102       (
     3103             input p-out-string-enc
     3104           , output p-out-string-dec
     3105       ).
     3106   end.
     3107   end .
     3108   procedure xmlchar-encode :
     3109   define input parameter p-in-string      as character        no-undo.
     3110   define output parameter p-out-string    as character        no-undo.
     3111       define variable v-position      as integer      no-undo.
     3112       define variable v-current-char  as character    no-undo.
     3113   do
     3114   on error undo, return error
     3115   :
     3116       assign
     3117           p-out-string = "":U
     3118       .
     3119       case p-in-string
     3120       :
     3121           when ?
     3122           then do:
     3123               assign
     3124                   p-out-string = "?":U
     3125               .
     3126           end.
     3127           when "?":U
     3128           then do:
     3129               assign
     3130                   p-out-string = "&#63;":U
     3131               .
     3132           end.
     3133           otherwise do:
     3134               do v-position = 1 to length( p-in-string )
     3135               :
     3136                   assign
     3137                       v-current-char = substring( p-in-string, v-position, 1 )
     3138                   .
     3139                   case v-current-char
     3140                   :
     3141                       when "&":U
     3142                       then do:
     3143                           assign
     3144                               p-out-string = p-out-string + "&amp;":U
     3145                           .
     3146                       end.
     3147                       when ">":U
     3148                       then do:
     3149                           assign
     3150                               p-out-string = p-out-string + "&gt;":U
     3151                           .
     3152                       end.
     3153                       when "<":U
     3154                       then do:
     3155                           assign
     3156                               p-out-string = p-out-string + "&lt;":U
     3157                           .
     3158                       end.
     3159                       when "'":U
     3160                       then do:
     3161                           assign
     3162                               p-out-string = p-out-string + "&apos;":U
     3163                           .
     3164                       end.
     3165                       when '"':U
     3166                       then do:
     3167                           assign
     3168                               p-out-string = p-out-string + "&quot;":U
     3169                           .
     3170                       end.
     3171                       when chr(1)
     3172                       then do:
     3173                           assign
     3174                               p-out-string = p-out-string + "":U
     3175                           .
     3176                       end.
     3177                       when chr(2)
     3178                       then do:
     3179                           assign
     3180                               p-out-string = p-out-string + "":U
     3181                           .
     3182                       end.
     3183                       when chr(3)
     3184                       then do:
     3185                           assign
     3186                               p-out-string = p-out-string + "":U
     3187                           .
     3188                       end.
     3189                       when chr(4)
     3190                       then do:
     3191                           assign
     3192                               p-out-string = p-out-string + "":U
     3193                           .
     3194                       end.
     3195                       when chr(5)
     3196                       then do:
     3197                           assign
     3198                               p-out-string = p-out-string + "":U
     3199                           .
     3200                       end.
     3201                       when chr(6)
     3202                       then do:
     3203                           assign
     3204                               p-out-string = p-out-string + "":U
     3205                           .
     3206                       end.
     3207                       when chr(7)
     3208                       then do:
     3209                           assign
     3210                               p-out-string = p-out-string + "":U
     3211                           .
     3212                       end.
     3213                       when chr(8)
     3214                       then do:
     3215                           assign
     3216                               p-out-string = p-out-string + "":U
     3217                           .
     3218                       end.
     3219                       when chr(9)
     3220                       then do:
     3221                           assign
     3222                               p-out-string = p-out-string + "":U
     3223                           .
     3224                       end.
     3225                       when chr(29)
     3226                       then do:
     3227                           assign
     3228                               p-out-string = p-out-string + "":U
     3229                           .
     3230                       end.
     3231                       when chr(10)
     3232                       then do:
     3233                           assign
     3234                               p-out-string = p-out-string + "&#10;":U
     3235                           .
     3236                       end.
     3237                       when chr(13)
     3238                       then do:
     3239                           assign
     3240                               p-out-string = p-out-string + "&#13;":U
     3241                           .
     3242                       end.
     3243                       otherwise do:
     3244                           assign
     3245                               p-out-string = p-out-string + v-current-char
     3246                           .
     3247                       end.
     3248                   end case.
     3249               end.
     3250           end.
     3251       end case.
     3252   end.
     3253   end .
     3254   procedure xmlchar-encode-1c :
     3255   define input parameter p-in-string      as character        no-undo.
     3256   define output parameter p-out-string    as character        no-undo.
     3257       define variable v-position      as integer      no-undo.
     3258       define variable v-current-char  as character    no-undo.
     3259   do
     3260   on error undo, return error
     3261   :
     3262       assign
     3263           p-out-string = "":U
     3264       .
     3265       case p-in-string
     3266       :
     3267           when ?
     3268           then do:
     3269               assign
     3270                   p-out-string = "?":U
     3271               .
     3272           end.
     3273           otherwise do:
     3274               do v-position = 1 to length( p-in-string )
     3275               :
     3276                   assign
     3277                       v-current-char = substring( p-in-string, v-position, 1 )
     3278                   .
     3279                   case v-current-char
     3280                   :
     3281                       when chr(1)
     3282                       then do:
     3283                           assign
     3284                               p-out-string = p-out-string + " ":U
     3285                           .
     3286                       end.
     3287                       when chr(2)
     3288                       then do:
     3289                           assign
     3290                               p-out-string = p-out-string + " ":U
     3291                           .
     3292                       end.
     3293                       when chr(3)
     3294                       then do:
     3295                           assign
     3296                               p-out-string = p-out-string + " ":U
     3297                           .
     3298                       end.
     3299                       when chr(4)
     3300                       then do:
     3301                           assign
     3302                               p-out-string = p-out-string + " ":U
     3303                           .
     3304                       end.
     3305                       when chr(5)
     3306                       then do:
     3307                           assign
     3308                               p-out-string = p-out-string + " ":U
     3309                           .
     3310                       end.
     3311                       when chr(6)
     3312                       then do:
     3313                           assign
     3314                               p-out-string = p-out-string + " ":U
     3315                           .
     3316                       end.
     3317                       when chr(7)
     3318                       then do:
     3319                           assign
     3320                               p-out-string = p-out-string + " ":U
     3321                           .
     3322                       end.
     3323                       when chr(8)
     3324                       then do:
     3325                           assign
     3326                               p-out-string = p-out-string + " ":U
     3327                           .
     3328                       end.
     3329                       when chr(9)
     3330                       then do:
     3331                           assign
     3332                               p-out-string = p-out-string + " ":U
     3333                           .
     3334                       end.
     3335                       when chr(29)
     3336                       then do:
     3337                           assign
     3338                               p-out-string = p-out-string + " ":U
     3339                           .
     3340                       end.
     3341                       when chr(10)
     3342                       then do:
     3343                           assign
     3344                               p-out-string = p-out-string + " ":U
     3345                           .
     3346                       end.
     3347                       when chr(13)
     3348                       then do:
     3349                           assign
     3350                               p-out-string = p-out-string + " ":U
     3351                           .
     3352                       end.
     3353                       otherwise do:
     3354                           assign
     3355                               p-out-string = p-out-string + v-current-char
     3356                           .
     3357                       end.
     3358                   end case.
     3359               end.
     3360           end.
     3361       end case.
     3362   end.
     3363   end .
     3364   procedure xmlchar-decode :
     3365   define input parameter p-in-string      as character        no-undo.
     3366   define output parameter p-out-string    as character        no-undo.
     3367       define variable v-position      as integer      no-undo.
     3368       define variable v-last-position as integer      no-undo.
     3369       define variable v-temp-integer  as integer      no-undo.
     3370       define variable v-current-char  as character    no-undo.
     3371       define variable v-next-char     as character    no-undo.
     3372       define variable v-success       as logical      no-undo.
     3373   do
     3374   on error undo, return error
     3375   :
     3376       assign
     3377           p-out-string = "":U
     3378           v-position   = 0
     3379       .
     3380       replace-cycle:
     3381       do while yes
     3382       on error undo, return error
     3383       :
     3384           assign
     3385               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3386           .
     3387           if v-last-position <= v-position
     3388           then do:
     3389               if v-position = 0
     3390               then do:
     3391                   assign
     3392                       p-out-string = p-in-string
     3393                   .
     3394               end.
     3395               else do:
     3396                   assign
     3397                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3398                   .
     3399               end.
     3400               leave replace-cycle.
     3401           end.
     3402           else do:
     3403               assign
     3404                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3405                   v-position      = v-last-position
     3406                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3407               .
     3408               if v-current-char = "#":U
     3409               then do:
     3410                   assign
     3411                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3412                   .
     3413                   if v-last-position > 0
     3414                   then do:
     3415                       run xmlchar-read-integer in this-procedure
     3416                        (
     3417                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3418                           , output v-temp-integer
     3419                           , output v-success
     3420                       ).
     3421                       if v-success = yes
     3422                       and v-temp-integer >= 1
     3423                       and v-temp-integer <= 255
     3424                       then do:
     3425                           assign
     3426                               p-out-string = p-out-string + chr( v-temp-integer )
     3427                               v-position   = v-last-position + 1
     3428                           .
     3429                       end.
     3430                       else do:
     3431                           assign
     3432                               p-out-string = p-out-string + "&":U
     3433                               v-position   = v-position   + 1
     3434                           .
     3435                       end.
     3436                   end.
     3437                   else do:
     3438                       assign
     3439                           p-out-string = p-out-string + "&":U
     3440                           v-position   = v-position   + 1
     3441                       .
     3442                   end.
     3443               end.
     3444               else do:
     3445                   case substring( p-in-string, v-position + 1, 3 )
     3446                   :
     3447                       when "lt;":U
     3448                       then do:
     3449                           assign
     3450                               p-out-string = p-out-string + "<":U
     3451                               v-position   = v-position   + 3
     3452                           .
     3453                       end.
     3454                       when "gt;":U
     3455                       then do:
     3456                           assign
     3457                               p-out-string = p-out-string + ">":U
     3458                               v-position   = v-position   + 3
     3459                           .
     3460                       end.
     3461                       otherwise do:
     3462                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3463                           then do:
     3464                               assign
     3465                                   p-out-string = p-out-string + "&":U
     3466                                   v-position   = v-position   + 4
     3467                               .
     3468                           end.
     3469                           else do:
     3470                               case substring( p-in-string, v-position + 1, 5 )
     3471                               :
     3472                                   when "quot;":U
     3473                                   then do:
     3474                                       assign
     3475                                           p-out-string = p-out-string + '"':U
     3476                                           v-position   = v-position   + 5
     3477                                       .
     3478                                   end.
     3479                                   when "apos;":U
     3480                                   then do:
     3481                                       assign
     3482                                           p-out-string = p-out-string + "'":U
     3483                                           v-position   = v-position   + 5
     3484                                       .
     3485                                   end.
     3486                                   otherwise do:
     3487                                       assign
     3488                                           p-out-string = p-out-string + "&":U
     3489                                       .
     3490                                   end.
     3491                               end case.
     3492                           end.
     3493                       end.
     3494                   end case.
     3495               end.
     3496           end.
     3497       end.
     3498   end.
     3499   end .
     3500   procedure xmlchar-read-integer :
     3501   define input parameter p-input-string      as character        no-undo.
     3502   define output parameter p-output-integer   as integer          no-undo.
     3503   define output parameter p-success       as logical          no-undo.
     3504   do
     3505   on error undo, return error
     3506   :
     3507       assign
     3508           p-output-integer = integer( p-input-string )
     3509       no-error.
     3510       if error-status :error
     3511       then do:
     3512           assign
     3513               p-success           = no
     3514               p-output-integer    = 0
     3515           .
     3516       end.
     3517       else do:
     3518           assign
     3519               p-success           = yes
     3520           .
     3521       end.
     3522   end.
     3523   end.
     3524   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     3525   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     3526   define new global shared variable g#attr-lib  as handle no-undo .
     3527   define variable v-attr-lib-variable as handle no-undo .
     3528   define variable mMRCCode  as logical    no-undo.
     3529   define variable mTypeMark as character  no-undo.
     3530   function IS-NeedMark returns logical
     3531   ( input ib-code as integer  ,
     3532     input ib-str as character ):
     3533      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     3534      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     3535                                    and buf_prod-bc-attr.b-str  eq ib-str
     3536                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     3537        no-lock no-error.
     3538      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     3539   end.
     3540   function repTegforDm return char
     3541   (iDM as char ):
     3542       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     3543       define variable vteg as character no-undo.
     3544       define variable oDM as character no-undo.
     3545       define variable vi as integer no-undo.
     3546       oDM = iDm.
     3547       do vi = 1 to num-entries(vTeglist):
     3548          vTeg = entry(vi,vTeglist).
     3549          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     3550       end.
     3551       return oDM.
     3552   end.
     3553   function repSpecSimbforDm return char
     3554   (iDM as char ):
     3555       define variable oDM as character no-undo.
     3556     run
     3557       xmlchar-decode(iDM, output oDM).
     3558     return repTegforDm (oDM).
     3559   end.
     3560   function CheckGtin return logical
     3561   (iGtin as char):
     3562      define variable bar_code as character no-undo.
     3563      define variable vGtin as logical no-undo init "yes".
     3564      if length(iGtin) eq 14
     3565      then do:
     3566         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     3567         run str/chk-sum.p
     3568          (input-output bar_code ) no-error .
     3569         if iGtin ne  bar_code
     3570         then
     3571            vGtin = no.
     3572      end.
     3573      else
     3574         vGtin = no.
     3575      return vgtin.
     3576   end.
     3577   function repSpecSimbforXlm return char
     3578   (iDM as char ):
     3579       iDM = replace(iDM,chr(29),"").
     3580       return iDM.
     3581   end.
     3582   function getGtinByDM return char
     3583   (IDM as char):
     3584      define variable VTXT as char no-undo.
     3585      define variable vGtin as char no-undo.
     3586      vTXt = IdM.
     3587      vGtin = IDM.
     3588      if    length(vtxt) > 14
     3589      then do:
     3590         if   vtxt begins "(01)"
     3591                or vtxt begins "(02)"
     3592         then
     3593            vGtin = substring(vtxt,5,14).
     3594         else if   (vtxt begins "01"
     3595                or vtxt begins "02" )
     3596                and (   (    substring(iDm,17,2) eq "21"
     3597                         and length(vtxt) >= 21)
     3598                     or substring(iDm,17,2) eq "37"
     3599                     or substring(iDm,17,4) eq "(37)" )
     3600         then do:
     3601            vGtin = substring(vtxt,3,14).
     3602            if not checkGtin(vGtin)
     3603            then
     3604               vGtin = substring(vtxt,1,14).
     3605         end.
     3606         else if     length(vtxt) eq 14 + 7 + 4 + 4
     3607             or length(vtxt) eq 14 + 7 + 4
     3608             or length(vtxt) eq 14 + 7
     3609         then
     3610            vGtin = substring(vtxt,1,14).
     3611      end.
     3612      if not checkGtin(vGtin)
     3613      then
     3614         vGtin = "".
     3615      return vgtin.
     3616   end.
     3617   function getGdsCodeByGtin return int
     3618   (iGtin as char):
     3619      define buffer prod-bc  for ub.prod-bc.
     3620      define buffer bar-code for ub.bar-code.
     3621      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     3622      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3623      return if avail bar-code then bar-code.gds-code else ?.
     3624   end.
     3625   function getQntyCodeByGtin return decimal
     3626   (iGtin as char):
     3627      define buffer prod-bc  for ub.prod-bc.
     3628      define buffer bar-code for ub.bar-code.
     3629      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     3630      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     3631      return if avail bar-code then bar-code.cli-base-rate else ?.
     3632   end.
     3633   function getGdsCodeByDM return int
     3634   (iDm as char):
     3635      define variable vGtin as char no-undo.
     3636      define buffer prod-bc for ub.prod-bc.
     3637      vGtin  = getGtinByDM (IDM ).
     3638      return getGdsCodeByGtin (vGtin).
     3639   end.
     3640   function ChekTypeMarkByGds return logical
     3641   (iGds-code as integer ):
     3642      define buffer goods-attr for ub.goods-attr.
     3643      find first goods-attr where goods-attr.gds-code   = iGds-code
     3644                              and goods-attr.attr-code  = 'mark-type':U
     3645      no-lock no-error.
     3646      if available goods-attr
     3647      then do:
     3648         mTypeMark = goods-attr.attr-value.
     3649         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     3650           .
     3651      end.
     3652      else
     3653         return no.
     3654   end.
     3655   function ChekTypeMarkByDm return logical
     3656   (iDM as char ):
     3657      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     3658   end.
     3659   function ChekTypeMarkByGtin return logical
     3660   (iGtin as char ):
     3661      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     3662   end.
     3663   function GetNextElement return character
     3664     (input iAllTeg        as logical
     3665     ,output oteg          as character
     3666     ,output otegval       as character
     3667     ,input-output pstr    as character
     3668      ):
     3669        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     3670        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     3671        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     3672        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     3673        define variable vTeg as character no-undo.
     3674        define variable vLength as integer no-undo.
     3675        define variable vi as integer no-undo.
     3676        define variable vj as integer no-undo.
     3677        define buffer code for ub.code.
     3678        find first code where Code.parent eq "MarkType"
     3679                          and Code.CodeValue   eq mTypeMark
     3680                          no-lock no-error.
     3681        if     available code
     3682           and Code.misc1 ne ""
     3683           and Code.misc1 ne ?
     3684        then do:
     3685           integer (Code.misc1) no-error.
     3686           if not error-status:error
     3687           then
     3688             entry (4,vlistleng) = Code.misc1.
     3689        end.
     3690        if iAllTeg
     3691        then
     3692           assign
     3693              vlistElem     = vlistElem    + vlistElemDop
     3694              vlistleng     = vlistleng    + vlistlengDop
     3695           .
     3696        else if mMRCCode
     3697        then
     3698           assign
     3699              vlistElem     = vlistElem    + ",(8005),8005"
     3700              vlistleng     = vlistleng    + ",000006,0006"
     3701           .
     3702       block-elem:
     3703       do vi = 1 to num-entries(vlistElem):
     3704          vTeg = entry(vi,vlistElem).
     3705          if pstr begins vTeg
     3706          then do:
     3707             if    vTeg eq "21"
     3708             then
     3709                vLength = index(pstr,chr(29)) - 2 no-error.
     3710             if vLength  <= 0
     3711             then
     3712                vLength = int(entry(vi,vlistleng)).
     3713             otegval = substring (pstr,length(vteg) + 1, vLength).
     3714             oteg = replace(replace(vteg,")",""),"(","").
     3715             vTeg = vteg + otegval.
     3716             otegval = replace(otegval,chr(29),"").
     3717             oteg = replace(replace(oteg,")",""),"(","").
     3718             pstr = substring (pstr,length(vTeg)+ 1).
     3719             vTeg = replace(vTeg,chr(29),"").
     3720             leave block-elem.
     3721          end.
     3722          else
     3723             vTeg = "".
     3724       end.
     3725       return vteg.
     3726   end.
     3727   function GetCodeIdent return character
     3728   (iDm as char):
     3729      define variable Velement   as character no-undo init "first".
     3730      define variable oCodeIdent as character no-undo.
     3731      define variable vteg as character no-undo.
     3732      define variable vtegval as character no-undo.
     3733      define variable vGtin as character no-undo.
     3734      define buffer marking for ub.marking.
     3735      for first marking no-lock where
     3736                marking.mark eq iDm
     3737            and marking.unit-ext = "LEVEL2"
     3738      :
     3739        return iDm.
     3740      end.
     3741      vGtin  = getGtinByDM (iDm ).
     3742      ChekTypeMarkByDm(idm).
     3743      if iDm begins 'tech_':U
     3744      then
     3745         oCodeIdent = iDm.
     3746      else if length(iDm) < 21
     3747      then do:
     3748         find first marking where marking.mark eq idm
     3749         no-lock no-error.
     3750         oCodeIdent = if available marking then marking.mark else  ?.
     3751      end.
     3752      else if     length(iDm) eq 29
     3753         and not iDm begins "01"
     3754         and not iDm begins "02"
     3755      then
     3756         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     3757      else  if     length(iDm) >= 24
     3758               and (  iDm begins "01"
     3759                   or iDm begins "02")
     3760               and  substring(iDm,17,2) ne "21"
     3761      then do:
     3762         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     3763                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     3764         then
     3765            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     3766         else
     3767            oCodeIdent = iDM.
     3768      end.
     3769      else  if     (   length(iDm) eq 25
     3770                    or length(iDm) eq 21)
     3771               and (not iDm begins "01"
     3772               and  not iDm begins "02")
     3773      then
     3774         oCodeIdent = substring(iDm,1,21).
     3775      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     3776      then
     3777         oCodeIdent = substring(iDm,1,21).
     3778      else do while Velement ne "" and idm ne "":
     3779         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     3780         oCodeIdent = oCodeIdent + Velement.
     3781      end.
     3782      return oCodeIdent.
     3783   end.
     3784   function GetTegCod return character
     3785   (icodeIdent as char, iTeg as char):
     3786      define variable Velement   as character no-undo init "first".
     3787      define variable oTeg as character no-undo init ?.
     3788      define variable vteg as character no-undo.
     3789      define variable vtegval as character no-undo.
     3790      if     ((length(icodeIdent) eq 21
     3791         and not icodeIdent begins "01"
     3792         and not icodeIdent begins "02")
     3793         or
     3794             ( length(icodeIdent) eq 25
     3795               and not icodeIdent begins "01"
     3796               and not icodeIdent begins "02"))
     3797      then do:
     3798         if iTeg eq "01" or iTeg eq "02"
     3799         then
     3800            oTeg = substring(icodeIdent,1,21).
     3801         else  if  iTeg eq "21"
     3802         then
     3803            oTeg = substring(icodeIdent,15,7).
     3804      end.
     3805      else do:
     3806         ChekTypeMarkByDm(icodeIdent).
     3807         block-teg:
     3808            do while Velement ne "" and icodeIdent ne "":
     3809            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     3810            if    Velement begins iTeg
     3811               or Velement begins "(" + iTeg + ")"
     3812            then do:
     3813               oTeg = vtegval.
     3814               leave block-teg.
     3815            end.
     3816         end.
     3817      end.
     3818      return oTeg.
     3819   end.
     3820   function isOAD return logical
     3821   (icodeIdent as character):
     3822      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     3823   end.
     3824   function isMark return logical
     3825   (icodeIdent as character):
     3826      define buffer buf_marking for ub.marking.
     3827      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     3828             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     3829   end.
     3830   function addBracketForCode return character
     3831   (icodeIdent as char):
     3832      define variable Velement   as character no-undo init "first".
     3833      define variable oTeg as character no-undo.
     3834      define variable vteg as character no-undo.
     3835      define variable vtegval as character no-undo.
     3836      define buffer marking for ub.marking.
     3837      find first marking no-lock where
     3838                 marking.mark begins icodeIdent no-error.
     3839      if    not ChekTypeMarkByDm(icodeIdent)
     3840         or length(icodeIdent) le 24
     3841         or (avail marking and marking.unit-ext = "LEVEL2")
     3842      then
     3843         oTeg = icodeIdent.
     3844      else do:
     3845         if (  icodeIdent begins "01"
     3846            or icodeIdent begins "02"
     3847            ) and CheckGtin(substring (icodeIdent,3,14))
     3848            and substring (icodeIdent,17,2) eq "21"
     3849         then do:
     3850            mMRCCode = yes.
     3851            ChekTypeMarkByDm(icodeIdent).
     3852            block-teg:
     3853            do while Velement ne "" and icodeIdent ne "":
     3854               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     3855               if vteg ne ""
     3856               then
     3857                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     3858            end.
     3859            mMRCCode = no.
     3860         end.
     3861         else do:
     3862            oTeg = icodeIdent.
     3863         end.
     3864      end.
     3865      return oTeg.
     3866   end.
     3867   function getlevelByCodId return int
     3868   (iCode as char):
     3869      define variable vLength as int no-undo.
     3870      define variable vLevel  as int no-undo.
     3871      if not ChekTypeMarkByDM (icode) then return ?.
     3872      vLength = length(iCode).
     3873      if    vLength eq 18
     3874         or vLength eq 20
     3875      then
     3876         Vlevel = 4.
     3877      else if vLength eq 21
     3878      then
     3879         Vlevel = 1.
     3880      else if vLength eq 25
     3881      then do:
     3882         if  iCode begins "01"
     3883         then
     3884            Vlevel = 3.
     3885         else
     3886            Vlevel = 1.
     3887      end.
     3888      else if     vLength >= 26
     3889              and vLength <= 46
     3890      then do:
     3891         if    substring(iCode,17,2) eq "11"
     3892            or substring(iCode,17,2) eq "13"
     3893            or (    substring(iCode,17,2) eq "21"
     3894                and vLength >= 33
     3895                and substring(iCode,26,4) ne "8005")
     3896         then
     3897            Vlevel = 4.
     3898         else if    vLength eq 31
     3899                 or vLength eq 38
     3900                 or vLength eq 39
     3901                 or vLength eq 45
     3902         then
     3903            Vlevel = 1.
     3904         else if    vLength eq 35
     3905                 or vLength eq 43
     3906         then
     3907            Vlevel = 3.
     3908         else
     3909            Vlevel = ?.
     3910      end.
     3911      else
     3912         Vlevel = ?.
     3913      return Vlevel.
     3914   end.
     3915   function getLevelMotpBycodid return character
     3916   (iDm as char):
     3917      define variable vLevel as integer no-undo.
     3918      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3919      vLevel = getlevelByCodId(iDm).
     3920      if    vLevel eq ?
     3921         or vLevel < 1
     3922         or vLevel > 6
     3923      then
     3924         return ?.
     3925      else
     3926         return entry(vlevel,vList).
     3927   end.
     3928   function getLevelUTDByLevelMotp return character
     3929   (iUnit as char):
     3930      define variable vLevel as integer no-undo.
     3931      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     3932      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3933      vLevel = lookup(iUnit,vListMOTP).
     3934      if    vLevel eq ?
     3935         or vLevel < 1
     3936         or vLevel > 4
     3937      then
     3938         return ?.
     3939      else
     3940         return entry(vlevel,vListutd).
     3941   end.
     3942   function getLevelMotpByDM return character
     3943   (iDm as char):
     3944      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     3945   end.
     3946   function getLevelUTDByCodId return character
     3947   (iDm as char):
     3948      define variable vLevel as integer no-undo.
     3949      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     3950      vLevel = getlevelByCodId(iDm).
     3951      if    vLevel eq ?
     3952         or vLevel < 1
     3953         or vLevel > 4
     3954      then
     3955         return ?.
     3956      else
     3957         return entry(vlevel,vList).
     3958   end.
     3959   function getLevelUTDByDM return character
     3960   (iDm as char):
     3961      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     3962   end.
     3963   define variable mNotMarkQnty as logical no-undo.
     3964   function getQntyUTDByCodId return decimal
     3965   (iDM as char):
     3966      define variable vLevel as integer no-undo.
     3967      define variable vList as character no-undo init "1,5,10,500".
     3968      define variable vGtin as character no-undo.
     3969      define variable vqnty as decimal no-undo init ?.
     3970      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     3971      if vqnty eq ?
     3972      then do:
     3973         if not mNotMarkQnty
     3974         then do:
     3975            define buffer marking for ub.marking.
     3976            define variable vCodident as character no-undo.
     3977            vCodident = GetCodeIdent(idm).
     3978            find first marking where marking.mark begins vCodident no-lock no-error.
     3979            if     available marking
     3980               and marking.box-qnty ne ?
     3981            then
     3982               return marking.box-qnty.
     3983         end.
     3984         vGtin = getGtinByDm(iDM).
     3985         if ChekTypeMarkByGtin (vGtin)
     3986         then do:
     3987            vLevel = getlevelByCodId(iDM).
     3988            if     vLevel >= 1
     3989               and vLevel <= 4
     3990            then
     3991               vqnty = int(entry(vlevel,vList)).
     3992         end.
     3993         else
     3994            vqnty = getQntyCodeByGtin(vgtin).
     3995      end.
     3996      return vqnty.
     3997   end.
     3998   function getQntyUTDByDM return decimal
     3999   (iDm as char):
     4000      define variable vDM as character no-undo.
     4001      if     length (iDm) ne 25
     4002         and length (iDm) ne 29
     4003         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     4004      then
     4005         vDM = substring (iDm,1,length (iDm) - 6 ).
     4006      else
     4007         vDM = substring (iDm,1,length (iDm) - 4 ).
     4008      return getQntyUTDByCodId(vDM).
     4009   end.
     4010   function getMRC4 return decimal
     4011   (iMRC as char):
     4012      define variable oMrc     as decimal no-undo init ?.
     4013      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     4014      define variable vi       as integer no-undo.
     4015      define variable vfound   as integer no-undo.
     4016      define variable vposStart   as integer no-undo.
     4017      do:
     4018      OMRc = 0.
     4019      do vi = 1 to 4:
     4020         define variable vsimb as character no-undo.
     4021         vsimb = substring(iMRC,vi,1).
     4022         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     4023         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     4024         if vfound > 0
     4025         then
     4026            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     4027         end.
     4028         OMRc = OMRc / 100.
     4029      end.
     4030      return OMRc.
     4031   end.
     4032   function getMRCByDM return decimal
     4033   (iDm as char):
     4034      define variable vMRC     as character no-undo.
     4035      define variable oMrc     as decimal no-undo init ?.
     4036      define variable Velement as character no-undo init "empty".
     4037      define variable vteg as character no-undo.
     4038      define variable vtegval as character no-undo.
     4039      if    length(idm) eq 14 + 7 + 4 + 4
     4040         or length(idm) eq 14 + 7 + 4
     4041      then do:
     4042         vMRC = substring(idm,22,4).
     4043         omrc = getMRC4(vMRC).
     4044      end.
     4045      else do:
     4046          ChekTypeMarkByDm(iDm).
     4047          block-mrc:
     4048          do while Velement ne "" and idm ne "":
     4049             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     4050             if Velement begins "8005"
     4051             then do:
     4052                vMRC = substring(Velement,5,6).
     4053                leave block-mrc.
     4054             end.
     4055             else if Velement begins "(8005)"
     4056             then do:
     4057                vMRC = substring(Velement,7,6).
     4058                leave block-mrc.
     4059             end.
     4060          end.
     4061          if vMRC ne ""
     4062          then
     4063             OMRc = dec(vmrc) / 100 no-error.
     4064      end.
     4065      return OMRc.
     4066   end.
     4067   function MoveDate return Date
     4068   (idate as date,
     4069    iMonth as int64):
     4070      define variable vMonth   as int64 no-undo.
     4071      define variable vYear    as int64 no-undo.
     4072      define variable vDateNew as date  no-undo.
     4073       define variable vDay     as int64 no-undo.
     4074       vMonth = month(iDate) + iMonth.
     4075       vYear =  year(iDate).
     4076       if vMonth <= 0
     4077       then assign
     4078          vMonth = vMonth + 12
     4079           vYear  = vYear - 1
     4080       .
     4081       else if vMonth > 12
     4082       then assign
     4083          vMonth = vMonth - 12
     4084           vYear  = vYear + 1
     4085       .
     4086       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     4087       do while error-status:error eq yes:
     4088          VDay = vDay + 1.
     4089          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     4090       end.
     4091       if VDay > 0
     4092       then
     4093          vDateNew + 1.
     4094       return vDateNew.
     4095   end.
     4096   procedure checkEMRC:
     4097   define input  parameter iDm as character no-undo.
     4098   define output parameter vok as logical   no-undo init yes.
     4099      define variable v-value-emrc as character no-undo.
     4100      define variable v-type-emrc  as character no-undo.
     4101      define variable vDateIso     as character no-undo.
     4102      define variable vMRC         as decimal no-undo.
     4103      define variable vqnty        as decimal no-undo.
     4104      define variable vPrice       as decimal no-undo.
     4105      define variable vparent      as character no-undo.
     4106      define variable vgds-code    as integer no-undo.
     4107      define buffer code for ub.code.
     4108      vMRC = getMRCByDM(iDm).
     4109      if vMRC > 0
     4110      then do:
     4111         vgds-code = getGdsCodeByDM(iDm).
     4112         vqnty     = getQntyUTDByDM(iDm).
     4113               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4114            (
     4115             input   vgds-code
     4116            ,input   'emrc-type':U
     4117            ,output   v-value-emrc
     4118            ,output   v-type-emrc
     4119          ) no-error.
     4120          if     v-value-emrc ne ""
     4121             and v-value-emrc ne ?
     4122          then do:
     4123             vDateIso = iso-date(today).
     4124             vPrice = vMRC / vqnty.
     4125             vparent ="emc" + chr(4) + v-value-emrc.
     4126             find last code where Code.parent      eq vparent
     4127                              and Code.code        le vDateIso
     4128                              and code.status_  eq 0
     4129             no-lock no-error.
     4130             if not available code or ( vPrice  >= dec(Code.CodeValue))
     4131             then
     4132                vOk = true .
     4133             else do:
     4134                 define variable vText      as character no-undo.
     4135                 define variable vDate      as date no-undo.
     4136                 define variable vDateLast  as character no-undo.
     4137                 define variable vDateFirst as character no-undo.
     4138                 define variable vDate3     as date no-undo.
     4139                 vdate = date(code.misc1).
     4140                 vDateLast = code.misc1.
     4141                 vDate3 = MoveDate(today, - 3 ).
     4142                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     4143                                      string(vDate3  , "99/99/9999"),
     4144                                      string(vDate   , "99/99/9999")
     4145                                      ).
     4146                 vdateIso = iso-date(vdate3).
     4147                 find last code  where Code.parent      eq vparent
     4148                                   and Code.code        le vDateIso
     4149                                   and code.status_  eq 0 no-lock no-error.
     4150                 if available code
     4151                 then
     4152                    vDateIso = code.code.
     4153                 vDateFirst = vDateIso.
     4154                 vDateLast = iso-date(vdate).
     4155                 define variable vGood as logical no-undo.
     4156                 define variable vDateSale as date no-undo.
     4157                 define buffer bcode for code.
     4158                 for last code where Code.parent   eq vparent
     4159                                 and code.status_  eq 0
     4160                                 and code.code     < vDateLast
     4161                                 and code.code     >= vDateFirst
     4162                 no-lock:
     4163                    find first bcode where bCode.parent   eq vparent
     4164                                       and bcode.status_  eq 0
     4165                                       and bcode.code     > code.code no-lock no-error.
     4166                    if available bcode
     4167                    then do:
     4168                       if vPrice < dec(Code.CodeValue)
     4169                       then
     4170                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     4171                                                     chr(10),
     4172                                                     string(    date( code.misc1)       ,"99/99/9999"),
     4173                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     4174                                                     ).
     4175                       else do:
     4176                          vGood = yes.
     4177                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     4178                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     4179                                                     chr(10),
     4180                                                     string(    date( code.misc1)         ,"99/99/9999"),
     4181                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     4182                                                     string(         vDateSale            ,"99/99/9999"),
     4183                                                     string(vDateSale - today)
     4184                                                     ).
     4185                       end.
     4186                    end.
     4187                 end.
     4188                 if vgood
     4189                 then do:
     4190                    define variable choice as integer no-undo .
     4191                    run gbl/d-askw.w (input "Уточнение"
     4192                           ,input  vText
     4193                           ,input "|"
     4194                           ,input "Принять|Вернуть"
     4195                           ,input "Принять данный товар|Вернуть товар постащику"
     4196                           ,input 1
     4197                           ,input 2
     4198                           ,output choice) no-error.
     4199                    vok = choice eq 1.
     4200                 end.
     4201                 else
     4202                    vok =false.
     4203             end.
     4204          end.
     4205      end.
     4206   end.
     4207   function addGs2Mark return character
     4208   (iMark as char):
     4209      define variable vDM   as character no-undo.
     4210      define variable vIdx  as integer   no-undo.
     4211      if index(iMark,chr(29),1) > 0
     4212      then return iMark.
     4213      if substring(iMark,26,4) = "8005" then
     4214      do:
     4215        vIdx = index(iMark,"93",26 + 4 + 5).
     4216        if vIdx > 1 then do:
     4217          vDM = substitute("&1&4&2&4&3",
     4218                           substring(iMark,1,25),
     4219                           substring(iMark,26,vIdx - 25 - 1),
     4220                           substring(iMark,vIdx),
     4221                           chr(29)) no-error.
     4222          vIdx = index(vDm,"240",vIdx + 4).
     4223          if vIdx > 0 then
     4224          do:
     4225            vDM = substitute("&1&3&2",
     4226                             substring(vDm,1,vIdx - 1),
     4227                             substring(vDm,vIdx),
     4228                             chr(29)) no-error.
     4229          end.
     4230        end.
     4231        else
     4232          vDM = substitute("&1&3&2",
     4233                           substring(iMark,1,25),
     4234                           substring(iMark,26),
     4235                           chr(29)) no-error.
     4236      end.
     4237      else if substring(iMark,32,2) = "91" then
     4238      do:
     4239        vIdx = index(iMark,"92",32).
     4240        if vIdx > 1 then
     4241          vDM = substitute("&1&4&2&4&3",
     4242                           substring(iMark,1,31),
     4243                           substring(iMark,32,vIdx - 31 - 1),
     4244                           substring(iMark,vIdx),
     4245                           chr(29)) no-error.
     4246        else
     4247          vDM = substitute("&1&3&2",
     4248                           substring(iMark,1,31),
     4249                           substring(iMark,32),
     4250                           chr(29)) no-error.
     4251      end.
     4252      else if substring(iMark,39,2) = "91" then
     4253      do:
     4254        vIdx = index(iMark,"92",38).
     4255        if vIdx > 1 then
     4256          vDM = substitute("&1&4&2&4&3",
     4257                           substring(iMark,1,38),
     4258                           substring(iMark,39,vIdx - 38 - 1),
     4259                           substring(iMark,vIdx),
     4260                           chr(29)) no-error.
     4261        else
     4262          vDM = substitute("&1&3&2",
     4263                           substring(iMark,1,38),
     4264                           substring(iMark,39),
     4265                           chr(29)) no-error.
     4266      end.
     4267      else if substring(iMark,25,2) = "93" then
     4268      do:
     4269        vIdx = index(iMark,"92",25).
     4270        if vIdx > 1 then
     4271          vDM = substitute("&1&4&2&4&3",
     4272                           substring(iMark,1,24),
     4273                           substring(iMark,25,vIdx - 24 - 1),
     4274                           substring(iMark,vIdx),
     4275                           chr(29)) no-error.
     4276        else
     4277          vIdx = index(iMark,"3103",25).
     4278          if vIdx > 0 then
     4279          vDM = substitute("&1&4&2&4&3",
     4280                           substring(iMark,1,24),
     4281                           substring(iMark,25,vIdx - 24 - 1),
     4282                           substring(iMark,vIdx),
     4283                           chr(29)) no-error.
     4284          else
     4285            vDM = substitute("&1&3&2",
     4286                             substring(iMark,1,24),
     4287                             substring(iMark,25),
     4288                             chr(29)) no-error.
     4289      end.
     4290      else if substring(iMark,32,2) = "93" then
     4291      do:
     4292        vDM = substitute("&1&3&2",
     4293              substring(iMark,1,31),
     4294              substring(iMark,32),
     4295              chr(29)) no-error.
     4296      end.
     4297      return if vDM <> "" then vDm else iMark.
     4298   end.
     4299   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4300   procedure partcopy :
     4301     define input parameter  p-free-output-copy as logical   no-undo .
     4302     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     4303     define parameter buffer buf_orig_parts     for ub.parts .
     4304     define parameter buffer buf_parts          for ub.parts .
