      902     field cli-qnty         like ub.pl-gds.cli-qnty
      903     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
      904     index xpk is primary unique pl-code
      905   .
      906   procedure trndocrs-gds-dtl-clear :
      907     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      908     do
      909     on error undo, return error return-value
      910     :
      911       for each buf_temp-trndocrs-gds-dtl-rsrv
      912       on error undo, return error return-value
      913       :
      914         delete buf_temp-trndocrs-gds-dtl-rsrv .
