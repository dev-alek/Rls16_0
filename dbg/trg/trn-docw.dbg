     5491                   .
     5492                 end.
     5493                 else do:
     5494                   assign
     5495                     buf_parts.cli-qnty = 0
     5496                   .
     5497                 end.
     5498               end.
     5499               if  buf_parts.qnty      = 0
     5500               and buf_parts.fact-qnty = 0
     5501               then do:
     5502                 if v-goods-twounit = true
