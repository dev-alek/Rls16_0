     7775     define output parameter p-fact-qnty      as decimal   no-undo .
     7776     define output parameter p-vat-pc         as decimal   no-undo .
     7777     define output parameter p-slt-pc         as decimal   no-undo .
     7778     define output parameter p-sum-base       as decimal   no-undo .
     7779     define output parameter p-sum-rubl       as decimal   no-undo .
     7780     define output parameter p-vat-base       as decimal   no-undo .
     7781     define output parameter p-vat-rubl       as decimal   no-undo .
     7782     define output parameter p-slt-base       as decimal   no-undo .
     7783     define output parameter p-slt-rubl       as decimal   no-undo .
     7784     define output parameter p-road-tax-base  as decimal   no-undo .
     7785     define output parameter p-road-tax-rubl  as decimal   no-undo .
     7786     define output parameter p-transport-base as decimal   no-undo .
     7787     define output parameter p-transport-rubl as decimal   no-undo .
     7788     define output parameter p-other-base     as decimal   no-undo .
     7789     define output parameter p-other-rubl     as decimal   no-undo .
     7790     define output parameter p-excise-base    as decimal   no-undo .
     7791     define output parameter p-excise-rubl    as decimal   no-undo .
     7792     define variable vss-description as character no-undo initial "r-crsa-01: суммы товара в текущих продажных ценах на момент закрытия документа".
     7793     define buffer buf_gds-dtl  for ub.gds-dtl .
     7794     define buffer buf_doc-line for ub.doc-line .
     7795     define buffer buf_trn-doc  for ub.trn-doc .
     7796     do
     7797     on error undo, return error return-value
     7798     :
     7799       find first buf_doc-line no-lock
     7800         where buf_doc-line.doc-code  = p-doc-code
     7801           and buf_doc-line.artic     = p-artic
     7802           and buf_doc-line.prod-type = p-prod-type
     7803           and buf_doc-line.prod-code = p-prod-code
     7804         no-error .
     7805       if not available buf_doc-line then do:
     7806         message
     7807           vss-workfile vss-revision vss-description skip
     7808           vss-include-info47 skip
     7809           "Ошибка задания входных параметров" skip
     7810           "Не найдена строка документа" skip
     7811           "Документ" p-doc-code skip
     7812           "Артикул" p-artic p-prod-type p-prod-code skip
     7813           view-as alert-box error .
     7814         undo, return error .
     7815       end.
     7816       find first buf_trn-doc no-lock
     7817         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     7818         no-error .
     7819       if not available buf_trn-doc then do:
     7820         message
     7821           vss-workfile vss-revision vss-description skip
     7822           vss-include-info47 skip
     7823           "Не найден документ" skip
     7824           "Документ" p-doc-code skip
     7825           "Артикул" p-artic p-prod-type p-prod-code skip
     7826           view-as alert-box error .
     7827         undo, return error .
     7828       end.
     7829       define variable v-gds-dtl-fact-qnty       as decimal   no-undo .
     7830       define variable v-total-gds-dtl-fact-qnty as decimal   no-undo .
     7831       for each buf_gds-dtl no-lock
     7832         where buf_gds-dtl.doc-code  = p-doc-code
     7833           and buf_gds-dtl.artic     = p-artic
     7834           and buf_gds-dtl.prod-type = p-prod-type
     7835           and buf_gds-dtl.prod-code = p-prod-code
     7836       on error undo, return error
     7837       :
     7838         if buf_trn-doc.doc-type <> 'инв':U then do:
     7839           if buf_trn-doc.doc-type = 'при':U
     7840           or buf_trn-doc.doc-type = 'возврат':U
     7841           then do:
     7842             assign
     7843               v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     7844             .
     7845           end.
     7846           else do:
     7847             assign
     7848               v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     7849             .
     7850           end.
     7851         end.
     7852         else do:
     7853           assign
     7854             v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     7855           .
     7856         end.
     7857         assign
     7858           v-total-gds-dtl-fact-qnty = v-total-gds-dtl-fact-qnty
     7859                                     + v-gds-dtl-fact-qnty
     7860         .
