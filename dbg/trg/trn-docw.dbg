     4636                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     4637                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     4638                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     4639                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     4640                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     4641                                                              no-error .
