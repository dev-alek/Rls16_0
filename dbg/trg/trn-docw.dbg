     8179     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
     8180     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
     8181     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     8182     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
     8183     do
