     8219       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
     8220       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
     8221       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
     8222       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
     8223       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
     8224       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
     8225       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
     8226       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
     8227       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     8228       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     8229       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     8230       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
     8231       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     8232       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     8233       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     8234       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     8235       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
     8236       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     8237       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
     8238       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     8239       define variable varis-one-gds-dtl        as   logical                             no-undo.
     8240       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
     8241       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
     8242       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     8243       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     8244       define variable varoutvprb               as   character                           no-undo.
     8245       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
     8246       define buffer   in-vatp-trn-doco  for ub.trn-doc .
     8247       define buffer   in-vatp-partso    for ub.parts   .
     8248       define buffer   in-vatp-doco      for ub.trn-doc .
     8249       define buffer   in-vatp-goodso    for ub.goods   .
     8250       define buffer   in-vatp-sysconfo  for ub.sysconf .
     8251       define buffer   in-vatp_doc-attro for ub.doc-attr.
     8252       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     8253       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     8254       define variable varinvprbo                  as   character              no-undo.
     8255       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     8256       define variable cli-base-rateo              as   decimal                no-undo.
     8257       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     8258       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     8259       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     8260       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     8261       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     8262       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     8263       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     8264       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     8265       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     8266       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     8267       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     8268       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     8269       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     8270       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     8271       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     8272       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     8273       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     8274       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     8275       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     8276       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     8277       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     8278       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     8279       define variable varinvatp-envdo             as   character              no-undo.
     8280       define variable varinvatp-typeo             as   character              no-undo.
     8281       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     8282       define buffer buf_gds-dtl  for ub.gds-dtl .
     8283       define buffer buf_goods    for ub.goods .
     8284       define buffer buf_trn-doc  for ub.trn-doc .
     8285       define buffer buf_doc-line for ub.doc-line .
     8286       find first buf_doc-line no-lock
     8287         where buf_doc-line.doc-code  = p-doc-code
     8288           and buf_doc-line.artic     = p-artic
     8289           and buf_doc-line.prod-type = p-prod-type
     8290           and buf_doc-line.prod-code = p-prod-code
     8291         no-error .
     8292       if not available buf_doc-line then do:
     8293         message
     8294           vss-workfile vss-revision vss-description skip
     8295           vss-include-info51 skip
     8296           "Ошибка задания входных параметров" skip
     8297           "Не найдена строка документа" skip
     8298           "Документ" p-doc-code skip
     8299           "Артикул" p-artic p-prod-type p-prod-code skip
     8300           view-as alert-box error .
     8301         undo, return error .
     8302       end.
     8303       find first buf_trn-doc no-lock
     8304         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     8305         no-error .
     8306       if not available buf_trn-doc then do:
     8307         message
     8308           vss-workfile vss-revision vss-description skip
     8309           vss-include-info51 skip
     8310           "Не найден документ" skip
     8311           "Документ" p-doc-code skip
     8312           "Артикул" p-artic p-prod-type p-prod-code skip
     8313           view-as alert-box error .
     8314         undo, return error .
     8315       end.
     8316       for each buf_gds-dtl no-lock
     8317         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     8318           and buf_gds-dtl.artic     = buf_doc-line.artic
     8319           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     8320           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     8321       on error undo, return error
     8322       :
     8323           if buf_trn-doc.doc-type <> 'инв':U
     8324           then do:
     8325               if buf_trn-doc.doc-type = 'при':U
     8326               or buf_trn-doc.doc-type = 'возврат':U
     8327               then do:
     8328                   assign
     8329                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     8330                   .
     8331               end.
     8332               else do:
     8333                   assign
     8334                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     8335                   .
     8336               end.
     8337           end.
     8338           else do:
     8339               assign
     8340                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     8341               .
     8342           end.
     8343           if v-gds-dtl-fact-qnty <> 0
     8344           then do:
     8345   if buf_trn-doc.ext-doc-type = 'ot':U or
     8346      buf_trn-doc.ext-doc-type = ?                 then do:
     8347     assign
     8348      out-vatp-have-vat-slt = yes.
     8349   end.
     8350   else do:
     8351     find first out-vatp_doc-attr no-lock
     8352       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     8353         and out-vatp_doc-attr.attr-code = 'envd':U
     8354         no-error .
     8355     if not available out-vatp_doc-attr then do:
     8356       assign
     8357         out-vatp-have-vat-slt = yes.
     8358     end.
     8359     else do:
     8360        out-vatp-have-vat-slt = no.
     8361     end.
     8362   end.
     8363   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     8364                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     8365                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     8366   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8367   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     8368     (input  buf_doc-line.artic
     8369     ,input  buf_doc-line.prod-type
     8370     ,input  buf_doc-line.prod-code
     8371     ,output varroot-node
     8372     ) no-error .
     8373   if error-status :error then do:
     8374     message
     8375       vss-workfile vss-revision vss-description skip
     8376       "Ошибка при определении корневого признака товара" skip
     8377       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     8378       error-status :get-message(1) skip
     8379       return-value skip
     8380       view-as alert-box error .
     8381     undo, return error .
     8382   end.
     8383   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     8384     (input  varroot-node
     8385     ,input  'empty-scale=request'
     8386     ,output varempty-scale
     8387     ) no-error .
     8388   if error-status :error then do:
     8389     message
     8390       vss-workfile vss-revision vss-description skip
     8391       "Ошибка при определении атрибута признака" skip
     8392       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     8393       "Признак" varroot-node skip
     8394       "Запрашивался атрибут" "empty-scale=request" skip
     8395       error-status :get-message(1) skip
     8396       return-value skip
     8397       view-as alert-box error .
     8398     undo, return error .
     8399   end.
     8400   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8402     (output varoutvprb
     8403     )  .
     8404   if varoutvprb = "base":u then do:
     8405     assign
     8406           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     8407       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     8408     .
     8409   end.
     8410   else do:
     8411     assign
     8412           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     8413       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     8414     .
     8415   end.
     8416   if varoutvprb = "rubl":u then do:
     8417     assign
     8418           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     8419       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     8420   end.
     8421   else do:
     8422     assign
     8423           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     8424       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     8425   end.
     8426   assign
     8427     varis-cons-parts-have =  no.
     8428   assign
     8429     varfact-qnty       = 0
     8430     varcons-qnty       = 0
     8431     varprice-base-cons = 0
     8432     varprice-rubl-cons = 0.
     8433   find first out-vatp_doc-line where
     8434              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     8435          and out-vatp_doc-line.artic      = buf_doc-line.artic
     8436          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     8437          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     8438   if available out-vatp_doc-line           and
     8439     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     8440     assign
     8441       varfact-qnty = out-vatp_doc-line.fact-qnty.
     8442   end.
     8443   else do:
     8444     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     8445                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     8446                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     8447                                  and out-vatp_parts.artic      = buf_doc-line.artic
     8448                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     8449                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     8450       if out-vatp_parts.purch-code = 2 then do:
     8451   assign
     8452     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     8453     price-base-with-tax-loco = out-vatp_parts.price-base
     8454   .
     8455   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8456   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8457     (output varinvprbo
     8458     )  .
     8459     if out-vatp_parts.out-code = 'free-zone':U     or
     8460        out-vatp_parts.out-code = 'out-zone':U   or
     8461        out-vatp_parts.doc-type = 'акт':U then do:
     8462       assign
     8463         in-vatp-have-vat-slto = yes.
     8464     end.
     8465     else do:
     8466       find first in-vatp_doc-attro no-lock
     8467         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     8468           and in-vatp_doc-attro.attr-code = 'envd':U
     8469         no-error .
     8470       if not available in-vatp_doc-attro then do:
     8471         assign
     8472           in-vatp-have-vat-slto = yes.
     8473       end.
     8474       else do:
     8475            in-vatp-have-vat-slto = no.
     8476       end.
     8477     end.
     8478     assign
     8479      price-cli-with-tax-loco = out-vatp_parts.price-cli
     8480      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     8481     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     8482              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     8483     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     8484             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     8485             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     8486             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     8487             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     8488             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     8489             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     8490       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     8491     assign
     8492       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     8493     assign
     8494       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     8495       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     8496       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     8497       transport-cli-loco  = 0
     8498       other-cli-loco      = 0
     8499     .
     8500   ASSIGN
     8501             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     8502       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     8503   .
     8504         assign
     8505           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     8506           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     8507         assign
     8508           varis-cons-parts-have = yes
     8509           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     8510       end.
     8511       assign
     8512         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     8513     end.
     8514   end.
     8515   assign
     8516     varprice-base-cons = varprice-base-cons / varcons-qnty
     8517     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     8518   if varprice-base-cons = ? then do:
     8519     assign
     8520       varprice-base-cons = 0.
     8521   end.
     8522   if varprice-rubl-cons = ? then do:
     8523     assign
     8524       varprice-rubl-cons = 0.
     8525   end.
     8526   assign
     8527       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     8528     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     8529     discnt-base-sale            = buf_gds-dtl.discnt-base
     8530     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     8531       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     8532     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     8533     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     8534     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     8535     .
     8536   if buf_trn-doc.doc-type = 'инв':U then do:
     8537     assign
     8538       varfact-qnty = buf_gds-dtl.doc-qnty.
     8539   end.
     8540   else do:
     8541     assign
     8542       varfact-qnty = buf_gds-dtl.fact-qnty.
     8543   end.
     8544   if varis-cons-parts-have = no then do:
     8545     assign
     8546           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     8547           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     8548   end.
     8549   else do:
     8550     if buf_trn-doc.doc-type = 'инв':U then do:
     8551       assign
     8552               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8553               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8554        .
     8555     end.
     8556     else do:
     8557       assign
     8558               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8559               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8560        .
     8561     end.
     8562   end.
     8563   assign
     8564   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     8565   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     8566               ASSIGN
     8567                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     8568                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     8569                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     8570                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     8571                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     8572                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     8573                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     8574                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     8575                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     8576                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     8577                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     8578                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     8579                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     8580               .
     8581           end.
     8582       end.
     8583       assign
     8584           p-transport-base      = 0
     8585           p-transport-rubl      = 0
     8586           p-vat-pc              = buf_doc-line.vat-pc
     8587           p-slt-pc              = buf_doc-line.slt-pc
     8588       .
     8589     end.
     8590     if p-fact-qnty      = ?
     8591     or p-vat-pc         = ?
     8592     or p-slt-pc         = ?
     8593     or p-sum-base       = ?
     8594     or p-sum-rubl       = ?
     8595     or p-vat-base       = ?
     8596     or p-vat-rubl       = ?
     8597     or p-slt-base       = ?
     8598     or p-slt-rubl       = ?
     8599     or p-road-tax-base  = ?
     8600     or p-road-tax-rubl  = ?
     8601     or p-transport-base = ?
     8602     or p-transport-rubl = ?
     8603     or p-other-base     = ?
     8604     or p-other-rubl     = ?
     8605     or p-excise-base    = ?
     8606     or p-excise-rubl    = ?
     8607     then do:
     8608       message
     8609         vss-workfile vss-revision vss-description skip
     8610         vss-include-info51 skip
     8611         "Получены неопределенные значения" skip
     8612         "Документ" p-doc-code skip
     8613         "Артикул" p-artic p-prod-type p-prod-code skip
     8614         "fact-qnty     " p-fact-qnty      skip
     8615         "vat-pc        " p-vat-pc         skip
     8616         "slt-pc        " p-slt-pc         skip
     8617         "sum-base      " p-sum-base       skip
     8618         "sum-rubl      " p-sum-rubl       skip
     8619         "vat-base      " p-vat-base       skip
     8620         "vat-rubl      " p-vat-rubl       skip
     8621         "slt-base      " p-slt-base       skip
     8622         "slt-rubl      " p-slt-rubl       skip
     8623         "road-tax-base " p-road-tax-base  skip
     8624         "road-tax-rubl " p-road-tax-rubl  skip
     8625         "transport-base" p-transport-base skip
     8626         "transport-rubl" p-transport-rubl skip
     8627         "other-base    " p-other-base     skip
     8628         "other-rubl    " p-other-rubl     skip
     8629         "excise-base   " p-excise-base    skip
     8630         "excise-rubl   " p-excise-rubl    skip
     8631         view-as alert-box error .
     8632       undo, return error .
     8633     end.
     8634   end procedure.
     8635   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8636   procedure chkzero :
     8637     define input  parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     8638     define buffer buf_trn-doc  for ub.trn-doc .
     8639     define buffer buf_doc-line for ub.doc-line .
     8640     define variable v-artic     like ub.doc-line.artic     no-undo .
     8641     define variable v-prod-type like ub.doc-line.prod-type no-undo .
     8642     define variable v-prod-code like ub.doc-line.prod-code no-undo .
     8643     define variable v-fact-qnty      as decimal   no-undo .
     8644     define variable v-vat-pc         as decimal   no-undo .
     8645     define variable v-slt-pc         as decimal   no-undo .
     8646     define variable v-sum-base       as decimal   no-undo .
     8647     define variable v-sum-rubl       as decimal   no-undo .
     8648     define variable v-vat-base       as decimal   no-undo .
     8649     define variable v-vat-rubl       as decimal   no-undo .
     8650     define variable v-slt-base       as decimal   no-undo .
     8651     define variable v-slt-rubl       as decimal   no-undo .
