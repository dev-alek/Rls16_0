      948   procedure trndocrs-pl-gds-accum :
      949     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
      950     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
      951     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
      952     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
      953     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
      954     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      955     do
      956     on error undo, return error return-value
      957     :
      958       find first buf_temp-trndocrs-pl-gds-rsrv
      959         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      960         no-error .
      961       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      962         create buf_temp-trndocrs-pl-gds-rsrv .
      963         assign
      964           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      965         .
      966       end.
      967       assign
      968         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
      969         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
      970         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
      971         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
      972       .
      973     end.
      974   end procedure.
      975   procedure trndocrs-gds-dtl-accum :
      976     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
      977     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
      978     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
      979     do
      980     on error undo, return error return-value
      981     :
      982       find first buf_temp-trndocrs-gds-dtl-rsrv
      983         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      984         no-error .
      985       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
      986         create buf_temp-trndocrs-gds-dtl-rsrv .
      987         assign
      988           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      989         .
      990       end.
      991       assign
      992         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      993                                                + p-rsrv-qnty
      994       .
      995     end.
      996   end procedure.
      997   procedure trndocrs-pl-gds-request :
      998     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      999     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
     1000     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
     1001     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
     1002     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
     1003     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
     1004     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
     1005     define input parameter p-field-accum            as character no-undo .
     1006     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
     1007     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
     1008     do
     1009     on error undo, return error return-value
     1010     :
     1011       if lookup(p-field-accum, "before,after":u ) = 0 then do:
     1012         message
     1013           vss-workfile vss-revision vss-description skip
     1014           vss-include-info5 skip
     1015           "Ошибка задания входных параметров параметров" skip
     1016           "Неизвестное значение параметра" skip
     1017           "p-field-accum" p-field-accum skip
     1018           view-as alert-box error .
     1019         undo, return error return-value .
     1020       end.
     1021       case p-field-accum :
     1022         when "before":u then do:
     1023           for each buf_temp-trndocrs-pl-gds-rsrv
     1024           on error undo, return error return-value
     1025           :
     1026             assign
     1027               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
     1028               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
     1029             .
     1030           end.
     1031         end.
     1032         when "after":u then do:
     1033           for each buf_temp-trndocrs-pl-gds-rsrv
     1034           on error undo, return error return-value
     1035           :
     1036             assign
     1037               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
     1038               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
     1039             .
     1040           end.
     1041         end.
     1042         otherwise do:
     1043           message
     1044             vss-workfile vss-revision vss-description skip
     1045             vss-include-info5 skip
     1046             "Ошибка задания входных параметров параметров" skip
     1047             "Неизвестное значение параметра" skip
     1048             "p-field-accum" p-field-accum skip
     1049             view-as alert-box error .
     1050           undo, return error return-value .
     1051         end.
     1052       end.
     1053       define buffer buf_parts for ub.parts.
     1054       for each buf_parts no-lock
     1055         where buf_parts.out-code  = p-doc-code
     1056           and buf_parts.obj-type  = p-obj-type
     1057           and buf_parts.obj-code  = p-obj-code
     1058           and buf_parts.artic     = p-artic
     1059           and buf_parts.prod-type = p-prod-type
     1060           and buf_parts.prod-code = p-prod-code
     1061       on error undo, return error return-value
     1062       :
     1063         find first buf_temp-trndocrs-pl-gds-rsrv
     1064           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
     1065           no-error .
     1066         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
     1067           create buf_temp-trndocrs-pl-gds-rsrv .
     1068           assign
     1069             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
     1070           .
     1071         end.
     1072         if can-do('при,рас,спи':U, p-doc-type)
     1073         or (p-doc-type = 'инв':U
     1074             and buf_parts.fact-qnty < 0)
     1075         then do:
     1076           case p-field-accum :
     1077             when "before":u then do:
     1078               assign
     1079                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     1080                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     1081                   + abs(buf_parts.fact-qnty)
     1082               .
     1083             end.
     1084             when "after":u then do:
     1085               assign
     1086                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     1087                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     1088                   + abs(buf_parts.fact-qnty)
     1089               .
     1090             end.
     1091             otherwise do:
     1092               message
     1093                 vss-workfile vss-revision vss-description skip
     1094                 vss-include-info5 skip
     1095                 "Ошибка задания входных параметров параметров" skip
     1096                 "Неизвестное значение параметра" skip
     1097                 "p-field-accum" p-field-accum skip
     1098                 view-as alert-box error .
     1099               undo, return error return-value .
     1100             end.
     1101           end.
     1102         end.
     1103         else do:
     1104           case p-field-accum :
     1105             when "before":u then do:
     1106               assign
     1107                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     1108                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     1109                   + abs(buf_parts.fact-qnty)
     1110               .
     1111             end.
     1112             when "after":u then do:
     1113               assign
     1114                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     1115                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     1116                   + abs(buf_parts.fact-qnty)
     1117               .
     1118             end.
     1119             otherwise do:
     1120               message
     1121                 vss-workfile vss-revision vss-description skip
     1122                 vss-include-info5 skip
     1123                 "Ошибка задания входных параметров параметров" skip
     1124                 "Неизвестное значение параметра" skip
     1125                 "p-field-accum" p-field-accum skip
     1126                 view-as alert-box error .
     1127               undo, return error return-value .
     1128             end.
     1129           end.
     1130         end.
     1131       end.
     1132     end.
     1133   end procedure.
     1134   procedure trndocrs-pl-gds-calc-rsrv :
     1135     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
     1136     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
     1137     do
     1138     on error undo, return error return-value
     1139     :
     1140       for each buf_temp-trndocrs-pl-gds-rsrv
     1141       on error undo, return error return-value
     1142       :
     1143         assign
     1144           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     1145             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     1146             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     1147           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
     1148             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     1149             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     1150         .
     1151       end.
     1152     end.
     1153   end procedure.
     1154   procedure trndocrs-need-rsrv :
     1155     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
     1156     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
     1157     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
     1158     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
     1159     define output parameter p-need-rsrv    as logical   no-undo .
     1160     define buffer buf_goods   for ub.goods .
     1161     do
     1162     on error undo, return error return-value
     1163     :
     1164       find first buf_goods no-lock
     1165         where buf_goods.artic     = p-artic
     1166           and buf_goods.prod-type = p-prod-type
     1167           and buf_goods.prod-code = p-prod-code
     1168         .
     1169       if buf_goods.gds-type = 'т':U
     1170       and ( p-doc-type = 'рас':U
     1171             or p-doc-type = 'спи':U
     1172           )
     1173       then do:
     1174         assign
     1175           p-need-rsrv = true
     1176         .
     1177       end.
     1178       else do:
     1179         assign
     1180           p-need-rsrv = false
     1181         .
     1182       end.
     1183     end.
     1184   end procedure.
     1185   procedure trndocrs-need-create-doc-pl :
     1186     define input  parameter p-extended-doc-type  as character no-undo .
     1187     define input  parameter p-news               as logical   no-undo .
     1188     define input  parameter p-sale-auto          as logical   no-undo .
     1189     define output parameter p-need-create-doc-pl as logical   no-undo .
     1190     do
     1191     on error undo, return error return-value
     1192     :
     1193       if  not p-news
     1194       and p-extended-doc-type <> 'ie':U
     1195       and p-extended-doc-type <> 'es':U
     1196       and p-extended-doc-type <> 'rs':U
     1197       and not p-sale-auto
     1198       then do:
     1199         assign
     1200           p-need-create-doc-pl = true
     1201         .
     1202       end.
     1203       else do:
     1204         assign
     1205           p-need-create-doc-pl = false
     1206         .
     1207       end.
     1208     end.
     1209   end procedure.
     1210   procedure trndocrs-validate :
     1211     define input parameter p-place-rsrv as logical no-undo .
     1212     define input parameter p-chg-qnty   as decimal no-undo .
     1213     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     1214     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     1215     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
     1216     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
     1217     assign
     1218       v-total-gds-dtl-rsrv-qnty = 0
     1219       v-total-pl-gds-rsrv-qnty  = 0
     1220     .
     1221     do
     1222     on error undo, return error return-value
     1223     :
     1224       for each buf_temp-trndocrs-gds-dtl-rsrv
     1225       on error undo, return error return-value
     1226       :
     1227         assign
     1228           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
     1229                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     1230         .
     1231       end.
     1232       for each buf_temp-trndocrs-pl-gds-rsrv
     1233       on error undo, return error return-value
     1234       :
     1235         assign
     1236           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
     1237                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     1238         .
     1239       end.
     1240       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     1241         message
     1242           vss-workfile vss-revision vss-description skip
     1243           vss-include-info5 skip
     1244           "Ошибка при резервировании свободных количеств" skip
     1245           "Запрошено резервирование:" skip
     1246           "По товару" p-chg-qnty skip
     1247           "По признакам" v-total-gds-dtl-rsrv-qnty skip
     1248           "По складским местам" v-total-pl-gds-rsrv-qnty skip
     1249           view-as alert-box error .
     1250         undo, return error return-value .
     1251       end.
     1252       if p-place-rsrv then do:
     1253         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     1254           message
     1255             vss-workfile vss-revision vss-description skip
     1256             vss-include-info5 skip
     1257             "Ошибка при резервировании свободных количеств" skip
     1258             "Запрошено резервирование:" skip
     1259             "По товару" p-chg-qnty skip
     1260             "По признакам" v-total-gds-dtl-rsrv-qnty skip
     1261             "По складским местам" v-total-pl-gds-rsrv-qnty skip
     1262             view-as alert-box error .
     1263           undo, return error return-value .
     1264         end.
     1265       end.
     1266     end.
     1267   end procedure.
     1268   procedure trndocrs :
     1269     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
     1270     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
     1271     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
     1272     define input parameter p-artic      like ub.doc-line.artic     no-undo .
     1273     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
     1274     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
     1275     define input parameter p-chg-qnty   as decimal no-undo .
     1276     define buffer buf_db         for ub.db .
     1277     define buffer buf_gds-obj    for ub.gds-obj .
     1278     define buffer buf_prt-obj    for ub.prt-obj .
     1279     define buffer buf_gds-prt    for ub.gds-prt .
     1280     define buffer buf_goods      for ub.goods .
     1281     define buffer buf_pl-gds     for ub.pl-gds .
     1282     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     1283     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     1284     define variable v-node-code   like ub.gds-prt.node-code no-undo .
     1285     define variable v-curr-db-num like ub.db.db-num         no-undo .
     1286     define variable v-cmd         as   character            no-undo .
     1287     do
     1288     on error undo, return error return-value
     1289     :
     1290   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1291   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1292     (input  p-obj-type
     1293     ,input  p-obj-code
     1294     ,input  p-artic
     1295     ,input  p-prod-type
     1296     ,input  p-prod-code
     1297     ,buffer buf_gds-obj
     1298     ) no-error .
     1299       if error-status :error then do:
     1300         message
     1301           vss-workfile vss-revision vss-description skip
     1302           vss-include-info5 skip
     1303           "Ошибка при поиске товара на объекте" skip
     1304           "p-obj-type"  p-obj-type  skip
     1305           "p-obj-code"  p-obj-code  skip
     1306           "p-artic"     p-artic     skip
     1307           "p-prod-type" p-prod-type skip
     1308           "p-prod-code" p-prod-code skip
     1309           error-status :get-message(1) skip
     1310           return-value skip
     1311           view-as alert-box error .
     1312         undo, return error return-value .
     1313       end.
     1314       find current buf_gds-obj exclusive-lock .
     1315       run trndocrs-validate in this-procedure
     1316         (input buf_gds-obj.place-rsrv
     1317         ,input p-chg-qnty
     1318         ) no-error .
     1319       if error-status :error then do:
     1320         message
     1321           vss-workfile vss-revision vss-description skip
     1322           vss-include-info5 skip
     1323           "Противоречивые данные для резервирования" skip
     1324           error-status :get-message(1) skip
     1325           return-value skip
     1326           view-as alert-box error .
     1327         undo, return error return-value .
     1328       end.
     1329       assign
     1330         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
     1331         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
     1332       .
     1333   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1334     (input ?
     1335     ,input this-procedure:handle
     1336     ,input ?
     1337     ,input  'rest-update':U
     1338     ,input ?
     1339     ,input  buffer buf_gds-obj:handle
     1340     ,input 'fact-qnty,free-qnty'
     1341     ,input ''
     1342     ) no-error .
     1343   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1345     (output v-curr-db-num
     1346     )  .
     1347       find first buf_db no-lock
     1348         where buf_db.db-num = v-curr-db-num
     1349         .
     1350       if buf_db.db-num <> 0
     1351         and buf_db.on-line-rest = true
     1352       then do:
     1353         assign
     1354           v-cmd = "command":U + chr(1)
     1355                   + "create":U + chr(1)
     1356                   + "on-line-rest":U + chr(1)
     1357                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
     1358                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
     1359                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
     1360                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
     1361                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
     1362                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
     1363         .
     1364         run nws/cr-route.p
     1365           ( input 'send-cmd':U
     1366             ,input v-cmd
     1367             ,input ?
     1368             ,input "0":U
     1369           ).
     1370       end.
     1371       if buf_gds-obj.place-rsrv = true then do:
     1372         for each buf_temp-trndocrs-pl-gds-rsrv
     1373         on error undo, return error return-value
     1374         :
     1375           find first buf_goods no-lock
     1376             where buf_goods.artic     = p-artic
     1377               and buf_goods.prod-type = p-prod-type
     1378               and buf_goods.prod-code = p-prod-code
     1379             no-error .
     1380           if not available buf_goods then do:
     1381             message
     1382               vss-workfile vss-revision vss-description skip
     1383               vss-include-info5 skip
     1384               "Не найдена товар" skip
     1385               "Артикул" p-artic p-prod-type p-prod-code skip
     1386               view-as alert-box error .
     1387             undo, return error return-value .
     1388           end.
     1389           find first buf_pl-gds exclusive-lock
     1390             where buf_pl-gds.obj-type = p-obj-type
     1391               and buf_pl-gds.obj-code = p-obj-code
     1392               and buf_pl-gds.gds-code = buf_goods.gds-code
     1393               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
     1394             no-error .
     1395           if not available buf_pl-gds then do:
     1396             message
     1397               vss-workfile vss-revision vss-description skip
     1398               vss-include-info5 skip
     1399               "Не найдена привязка товара к складскому месту" skip
     1400               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
     1401               view-as alert-box error .
     1402             undo, return error return-value .
     1403           end.
     1404           assign
     1405             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     1406             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
     1407           .
