     5191               undo, return error .
     5192             end.
     5193             if buf_trn-doc.ext-doc-type = 'vt':U
     5194             or (buf_trn-doc.ext-doc-type = 're':U and v-is-hold = true)
     5195             or buf_trn-doc.ext-doc-type = 'ap':U
     5196             or buf_trn-doc.ext-doc-type = 'pc':U
     5197             or buf_trn-doc.ext-doc-type = 'mp':U
     5198             or  buf_trn-doc.ext-doc-type = 'vp':U
     5199             then do:
     5200               message
     5201                 vss-workfile vss-revision vss-description skip
     5202                 vss-include-info22 skip
     5203                 "Фактическое количество не может отличаться от количества по документу" skip
     5204                 "для документов инвентаризации, внутреннего возврата и автоматического возврата между фирмами" skip
     5205                 "Документ" p-doc-code skip
     5206                 "Объект" p-obj-type p-obj-code skip
