    10244     .
    10245   if par-is-pharm <> "yes"  then par-is-pharm = "no" .
    10246   else do:
    10247   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$workfile: $ $revision: $".
    10248   define variable v-o-pharm    as character no-undo .
    10249   define variable v-o-var-type as character no-undo .
    10250     run clntattr-value in this-procedure
    10251       ( input   ub.trn-doc.obj-type ,
    10252         input   ub.trn-doc.obj-code ,
    10253         input  'pharm':U,
    10254         output v-o-pharm    ,
    10255         output v-o-var-type )
    10256        no-error .
    10257     if v-o-pharm <> "yes":u or error-status :error then do:
    10258        par-is-pharm = "no"  .
    10259     end.
    10260   end.
    10261     run trg/chkdocnm.p
    10262       (input ub.trn-doc.doc-code
    10263       ,input 'trn-doc':U
    10264       ,input recid(ub.trn-doc)
    10265       ) no-error .
    10266     if error-status :error then do:
    10267       assign
    10268         v-message = substitute( "&1. Ошибка при проверке уникальности кода документа.&2Документ &3&2&4&2&5", vss-workfile, chr(10), ub.trn-doc.doc-code, return-value, error-status :get-message ( 1 ) ).
    10269       .
    10270       if g#news = false and g#esys = false and g#auto = false then
    10271         message
    10272           v-message
    10273           view-as alert-box error .
    10274       undo main-block, return error v-message .
    10275     end.
    10276     if v-new-trn-doc = true then do:
    10277      assign
    10278         ub.trn-doc.real-date-create = today
    10279         ub.trn-doc.real-time-create = time
    10280      .
    10281     end.
    10282     find first ub.clients no-lock
    10283       where ub.clients.obj-type = ub.trn-doc.cli-type
    10284         and ub.clients.obj-code = ub.trn-doc.cli-code
    10285       no-error .
    10286     if  v-new-trn-doc = true
    10287     then do:
    10288       define variable v-vid-action  as integer    no-undo.
    10289       define variable v-vid-param   as longchar   no-undo.
    10290   define variable v-initiator  as character no-undo.
    10291   case true:
    10292     when g#auto then v-initiator = "Auto".
    10293     when g#news then v-initiator = "Nws".
    10294     when g#esys then v-initiator = "Esys".
    10295     otherwise v-initiator = "User".
    10296   end case.
    10297       v-vid-action = 55 .
    10298       v-vid-param = "Initiator=" + v-initiator + chr(4) +
    10299                     "SHOP_NUM=" + string(ub.trn-doc.obj-code) + chr(4) +
    10300                     "DocNum=" + string(ub.trn-doc.doc-code) + chr(4) +
    10301                     "DocType=" + string(ub.trn-doc.doc-type) + chr(4) +
    10302                     "RESULT=0" + chr(4) +
    10303                     "Description=".
    10304       run trg/userlog.p (
    10305             input 'create':U
    10306           , input 'trn-doc':U
    10307           , input ( buffer ub.trn-doc :handle )
    10308           , input v-vid-action
    10309           , input v-vid-param
    10310       ) no-error.
    10311     end.
