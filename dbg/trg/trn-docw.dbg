     5332                     "qnty" buf_parts.qnty skip
     5333                     "fact-qnty" buf_parts.fact-qnty skip
     5334                     "cli-qnty" buf_parts.cli-qnty skip
     5335                     view-as alert-box error .
     5336                   undo, return error .
     5337                 end.
     5338               end.
     5339               delete buf_parts .
     5340             end.
     5341           end.
     5342           if archive_parts.in-code = buf_trn-doc.doc-code
     5343           then do:
     5344             assign
     5345               archive_parts.fact-num  = buf_trn-doc.fact-num
     5346               archive_parts.fact-date = buf_trn-doc.fact-date
     5347               archive_parts.doc-type  = buf_trn-doc.doc-type
     5348             .
     5349           end.
     5350           if archive_parts.fact-qnty <> 0
     5351           then do:
     5352             if can-do('рас,спи':U, buf_trn-doc.doc-type)
     5353             or (buf_trn-doc.doc-type = 'инв':U
     5354                 and archive_parts.fact-qnty < 0
     5355               )
     5356             then do:
     5357   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     5359     (input  buf_trn-doc.doc-code
     5360     ,output v-is-hold
     5361     ) no-error .
     5362               if error-status :error
     5363               then do:
     5364                 message
     5365                   vss-workfile vss-revision vss-description skip
     5366                   vss-include-info22
     5367                   "Ошибка при определении типа документа hold-doc.i" skip
     5368                   "Документ" p-doc-code skip
     5369                   "Объект" p-obj-type p-obj-code skip
     5370                   "Артикул" p-artic p-prod-type p-prod-code skip
     5371                   error-status :get-message(1) skip
     5372                   return-value skip
     5373                   view-as alert-box error .
     5374                 undo, return error .
     5375               end.
     5376               assign
     5377                 v-rsrv-code = 'out-zone':U
     5378               .
     5379               if buf_trn-doc.ext-doc-type  = 'ep':U
     5380               or (buf_trn-doc.ext-doc-type = 'ap':U )
     5381               or (buf_trn-doc.ext-doc-type = 'pc':U )
     5382               then do:
     5383                 assign
     5384                   v-rsrv-code = ""
     5385                 .
     5386                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     5387                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     5388                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     5389                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     5390                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     5391                                                       and orig_marking-lines.part-code  = archive_parts.part-code,
     5392                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     5393                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB .
     5394                 end .
     5395               end.
     5396             end.
     5397             else do:
     5398               assign
     5399                 v-rsrv-code = 'free-zone':U
     5400               .
     5401             end.
     5402             if v-rsrv-code <> ""
     5403             then do:
