     5290                     "Документ" p-doc-code skip
     5291                     "Объект" p-obj-type p-obj-code skip
     5292                     "Артикул" p-artic p-prod-type p-prod-code skip
     5293                     "Партия" archive_parts.in-code archive_parts.part-code skip
     5294                     "Количество по документу" archive_parts.qnty skip
