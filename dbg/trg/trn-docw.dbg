     4445                     undo, return error.
     4446                 end.
     4447             end.
     4448         end.
     4449         delete object objMarks no-error.
     4450         if p-mark = "news" then return .
     4451         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
