     1470     define input  parameter p-news          as logical no-undo .
     1471     define input  parameter p-trn-doc-close as logical   no-undo .
     1472     define input  parameter p-update-host   as logical no-undo .
     1473     define buffer buf_db       for ub.db .
     1474     define buffer buf_trn-doc  for ub.trn-doc .
     1475     define buffer buf_doc-line for ub.doc-line .
