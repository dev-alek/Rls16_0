     4422                 if p-out-code = 'free-zone':U then do:
     4423                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     4424                 end.
     4425                 else do:
     4426                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     4427                 end.
