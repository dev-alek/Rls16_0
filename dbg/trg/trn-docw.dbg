     4579                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     4580                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     4581                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     4582                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     4583                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     4584                                                            and buf_marking-lines.part-code  = buf_parts.part-code
