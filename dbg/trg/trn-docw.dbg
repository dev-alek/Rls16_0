     6068                     then
     6069                 do:
     6070                     message objMarks:ReturnMsg view-as alert-box error.
     6071                     delete object objMarks no-error.
     6072                     undo, return error.
     6073                 end.
     6074               end.
     6075               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     6076                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     6077                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     6078                                                           and del_marking-lines.in-code = buf_parts.in-code
     6079                                                           and del_marking-lines.out-code = buf_parts.out-code
     6080                                                           and del_marking-lines.part-code = buf_parts.part-code
     6081                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     6082                 delete del_marking-lines .
     6083               end.
     6084               delete buf_parts .
     6085             end.
     6086           end.
     6087           delete object objMarks no-error.
     6088           if v-need-unrv = true
     6089           then do:
     6090             release buf_parts no-error .
     6091             if archive_parts.out-code <> v-unrv-code and v-unrv-sign = -1 and v-izlcstpr
     6092             then do:
     6093                 find first buf_parts exclusive-lock
     6094                   where buf_parts.obj-type  = archive_parts.obj-type
     6095                     and buf_parts.obj-code  = archive_parts.obj-code
     6096                     and buf_parts.artic     = archive_parts.artic
     6097                     and buf_parts.prod-type = archive_parts.prod-type
     6098                     and buf_parts.prod-code = archive_parts.prod-code
     6099                     and buf_parts.in-code   = archive_parts.out-code
     6100                     and buf_parts.out-code  = v-unrv-code
     6101                     and buf_parts.part-code = archive_parts.part-code
     6102                   no-error.
     6103             end .
     6104             if not available  buf_parts
     6105             then do :
     6106                 run partcopy in this-procedure
     6107                   (input  true
     6108                   ,input  v-unrv-code
     6109                   ,buffer archive_parts
     6110                   ,buffer buf_parts
     6111                   ,input  ""
     6112                   ) no-error .
     6113                 if error-status :error
     6114                 then do:
     6115                   message
     6116                     vss-workfile vss-revision vss-description skip
     6117                     vss-include-info22 skip
     6118                     "Ошибка при создании партии" skip
     6119                     "Документ" p-doc-code skip
     6120                     "Объект" p-obj-type p-obj-code skip
     6121                     "Артикул" p-artic p-prod-type p-prod-code skip
     6122                     "Партия" archive_parts.in-code archive_parts.part-code skip
     6123                     "Необходимо резервировать" v-need-rsrv skip
     6124                     "Резерв" v-rsrv-code skip
     6125                     "Необходимо снятие резервов" v-need-unrv skip
     6126                     "Снятие резервов" v-unrv-code skip
     6127                     error-status :get-message(1) skip
     6128                     return-value skip
     6129                     view-as alert-box error .
     6130                   undo, return error .
     6131                 end.
     6132             end.
     6133             if new(buf_parts)
     6134             then do:
     6135   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6136   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6137     (input  p-artic
     6138     ,input  p-prod-type
     6139     ,input  p-prod-code
     6140     ,output v-gds-code
     6141     ) no-error .
     6142               if error-status :error
     6143               then do:
     6144                 message
     6145                   vss-workfile vss-revision vss-description skip
     6146                   vss-include-info22 skip
     6147                   "Ошибка при определении кода товара" skip
     6148                   "Документ" p-doc-code skip
     6149                   "Объект" p-obj-type p-obj-code skip
     6150                   "Артикул" p-artic p-prod-type p-prod-code skip
     6151                   "Партия" archive_parts.in-code archive_parts.part-code skip
     6152                   "Необходимо резервировать" v-need-rsrv skip
     6153                   "Резерв" v-rsrv-code skip
     6154                   "Необходимо снятие резервов" v-need-unrv skip
     6155                   "Снятие резервов" v-unrv-code skip
     6156                   error-status :get-message(1) skip
     6157                   return-value skip
     6158                   view-as alert-box error .
     6159                 undo, return error .
     6160               end.
     6161               find first buf_parts-attr no-lock
     6162                 where buf_parts-attr.in-code   = buf_parts.in-code
     6163                   and buf_parts-attr.gds-code  = v-gds-code
     6164                   and buf_parts-attr.part-code = buf_parts.part-code
     6165                 no-error .
     6166               if not available buf_parts-attr
     6167               then do:
     6168                 message
     6169                   vss-workfile vss-revision vss-description skip
     6170                   vss-include-info22 skip
     6171                   "Не найден атрибут партии" skip
     6172                   "Документ" p-doc-code skip
     6173                   "Объект" p-obj-type p-obj-code skip
     6174                   "Артикул" p-artic p-prod-type p-prod-code skip
     6175                   "Код товара" v-gds-code skip
     6176                   "Партия" archive_parts.in-code archive_parts.part-code skip
     6177                   "Необходимо резервировать" v-need-rsrv skip
     6178                   "Резерв" v-rsrv-code skip
     6179                   "Необходимо снятие резервов" v-need-unrv skip
     6180                   "Снятие резервов" v-unrv-code skip
     6181                   error-status :get-message(1) skip
     6182                   return-value skip
     6183                   view-as alert-box error .
     6184                 undo, return error .
     6185               end.
     6186               run factord-to-fact-num in this-procedure
     6187                 (input  buf_parts-attr.fact-order
     6188                 ,output v-fact-num
     6189                 ) no-error .
     6190               if error-status :error
     6191               then do:
     6192                 message
     6193                   vss-workfile vss-revision vss-description skip
     6194                   vss-include-info22 skip
     6195                   "Ошибка при определении порядкового номера партии" skip
     6196                   "Документ" p-doc-code skip
     6197                   "Объект" p-obj-type p-obj-code skip
     6198                   "Артикул" p-artic p-prod-type p-prod-code skip
     6199                   "Код товара" v-gds-code skip
     6200                   "Партия" archive_parts.in-code archive_parts.part-code skip
     6201                   "Необходимо резервировать" v-need-rsrv skip
     6202                   "Резерв" v-rsrv-code skip
     6203                   "Необходимо снятие резервов" v-need-unrv skip
     6204                   "Снятие резервов" v-unrv-code skip
     6205                   error-status :get-message(1) skip
     6206                   return-value skip
     6207                   view-as alert-box error .
     6208                 undo, return error .
     6209               end.
     6210   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run trnextdt in g#library
     6211     (input  buf_parts-attr.ext-doc-type
     6212     ,output v-doc-type
     6213     ) no-error .
     6214               if error-status :error
     6215               then do:
     6216                 message
     6217                   vss-workfile vss-revision vss-description skip
     6218                   vss-include-info22 skip
     6219                   "Ошибка при определении типа документа" skip
     6220                   "Документ" p-doc-code skip
     6221                   "Объект" p-obj-type p-obj-code skip
     6222                   "Артикул" p-artic p-prod-type p-prod-code skip
     6223                   "Код товара" v-gds-code skip
     6224                   "Партия" archive_parts.in-code archive_parts.part-code skip
     6225                   "Необходимо резервировать" v-need-rsrv skip
     6226                   "Резерв" v-rsrv-code skip
     6227                   "Необходимо снятие резервов" v-need-unrv skip
     6228                   "Снятие резервов" v-unrv-code skip
     6229                   error-status :get-message(1) skip
     6230                   return-value skip
     6231                   view-as alert-box error .
     6232                 undo, return error .
     6233               end.
     6234               assign
     6235                 buf_parts.fact-date = buf_parts-attr.fact-date
     6236                 buf_parts.fact-num  = v-fact-num
     6237                 buf_parts.doc-type  = v-doc-type
     6238               .
     6239             end.
     6240             assign
     6241               buf_parts.qnty      = buf_parts.qnty  + v-unrv-sign * archive_parts.fact-qnty
     6242               buf_parts.fact-qnty = buf_parts.qnty
     6243             .
     6244   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6245   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6246     (input  buf_parts.artic
     6247     ,input  buf_parts.prod-type
     6248     ,input  buf_parts.prod-code
     6249     ,output v-gds-code
     6250     ) no-error .
     6251             if buf_parts.out-code = 'free-zone':U
     6252             then
     6253             for each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = v-gds-code
     6254                                                         and buf_marking-lines.obj-type = archive_parts.obj-type
     6255                                                         and buf_marking-lines.obj-code = archive_parts.obj-code
     6256                                                         and buf_marking-lines.in-code  = archive_parts.in-code
     6257                                                         and buf_marking-lines.out-code = archive_parts.out-code
     6258                                                         and buf_marking-lines.part-code = archive_parts.part-code
     6259                                                         and buf_marking-lines.prt-code = archive_parts.prt-code:
     6260               for first buf_marking exclusive-lock where buf_marking.mark = buf_marking-lines.mark :
     6261                 find first free_marking-lines no-lock where free_marking-lines.mark       = buf_marking-lines.mark
     6262                                                         and free_marking-lines.gds-code   = buf_marking-lines.gds-code
     6263                                                         and free_marking-lines.obj-type   = buf_parts.obj-type
     6264                                                         and free_marking-lines.obj-code   = buf_parts.obj-code
     6265                                                         and free_marking-lines.in-code    = buf_parts.in-code
     6266                                                         and free_marking-lines.out-code   = buf_parts.out-code
     6267                                                         and free_marking-lines.part-code  = buf_parts.part-code
     6268                                                         and free_marking-lines.prt-code   = buf_parts.prt-code
     6269                                                         no-error .
     6270                 if not available free_marking-lines
     6271                 then do :
     6272                   create free_marking-lines .
     6273                   assign
     6274                     free_marking-lines.mark       = buf_marking-lines.mark
     6275                     free_marking-lines.doc-level  = buf_marking-lines.doc-level
     6276                     free_marking-lines.gds-code   = buf_marking-lines.gds-code
     6277                     free_marking-lines.obj-type   = buf_parts.obj-type
     6278                     free_marking-lines.obj-code   = buf_parts.obj-code
     6279                     free_marking-lines.in-code    = buf_parts.in-code
     6280                     free_marking-lines.out-code   = buf_parts.out-code
     6281                     free_marking-lines.part-code  = buf_parts.part-code
     6282                     free_marking-lines.prt-code   = buf_parts.prt-code
     6283                   .
     6284                 end .
     6285                 if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_trn-doc.doc-type <> 'спи':U and
     6286                    not (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U)
     6287                   then assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     6288                 if buf_trn-doc.ext-doc-type = 'es':U
     6289                 then do :
     6290                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB .
     6291                 end .
     6292                 for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     6293                   assign buf_marking-chk.sts = 0 .
     6294                 end .
     6295               end .
     6296               delete buf_marking-lines .
     6297             end.
     6298             if v-goods-twounit = true
     6299             then do:
     6300               assign
     6301                 buf_parts.cli-qnty = buf_parts.cli-qnty + v-unrv-sign * archive_parts.cli-qnty
     6302               .
     6303             end.
     6304             else do:
     6305               if buf_parts.cli-base-rate <> 0
     6306               then do:
     6307                 assign
     6308                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     6309                 .
     6310               end.
     6311               else do:
     6312                 assign
     6313                   buf_parts.cli-qnty = 0
     6314                 .
     6315               end.
     6316             end.
     6317             if  buf_parts.qnty      = 0
     6318             and buf_parts.fact-qnty = 0
     6319             then do:
     6320               if v-goods-twounit = true
     6321               then do:
     6322                 if buf_parts.cli-qnty <> 0
     6323                 then do:
     6324                   message
     6325                     vss-workfile vss-revision vss-description skip
     6326                     vss-include-info22 skip
     6327                     "Ошибка при удалении партии" skip
     6328                     "Документ" p-doc-code skip
     6329                     "Объект" p-obj-type p-obj-code skip
     6330                     "Артикул" p-artic p-prod-type p-prod-code skip
     6331                     "Партия" buf_parts.in-code buf_parts.part-code skip
     6332                     "Резерв" buf_parts.out-code skip
     6333                     "qnty" buf_parts.qnty skip
     6334                     "fact-qnty" buf_parts.fact-qnty skip
     6335                     "cli-qnty" buf_parts.cli-qnty skip
     6336                     view-as alert-box error .
     6337                   undo, return error .
     6338                 end.
     6339               end.
     6340               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     6341                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     6342                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     6343                                                           and del_marking-lines.in-code = buf_parts.in-code
     6344                                                           and del_marking-lines.out-code = buf_parts.out-code
     6345                                                           and del_marking-lines.part-code = buf_parts.part-code
     6346                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     6347                 delete del_marking-lines .
     6348               end.
     6349               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     6350                                           ,input (buffer buf_parts:handle)
     6351                                           ,output part-key-rec).
     6352               for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     6353                                        and ub.gen-attr.p-key =  part-key-rec
     6354               :
     6355                 find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     6356                 find current buf1_gen-attr exclusive-lock.
     6357                 delete buf1_gen-attr .
     6358               end.
     6359               delete buf_parts .
     6360             end.
     6361           end.
     6362         end.
     6363       end.
     6364     end.
     6365   end procedure.
     6366   procedure partcopy-rsrv-parts :
     6367     define input  parameter p-doc-code-rowid as rowid no-undo .
     6368     define input  parameter p-parts-rowid    as rowid no-undo .
     6369     define input  parameter p-rsrv-direction as logical   no-undo .
     6370     define input  parameter p-goods-twounit  as logical   no-undo .
     6371     define input  parameter p-is-hold        as logical   no-undo .
     6372     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     6373     define buffer buf_trn-doc for ub.trn-doc .
     6374     define buffer archive_parts for ub.parts .
     6375     define buffer buf_parts   for ub.parts .
     6376     define buffer orig_marking-lines for ub.marking-lines .
     6377     define buffer buf_marking-lines for ub.marking-lines .
     6378     define buffer buf_marking   for ub.marking .
     6379     define buffer buf_goods for ub.goods .
     6380     define variable v-rsrv-code as character no-undo .
     6381     do
     6382     on error undo, return error return-value
     6383     :
     6384       find first buf_trn-doc no-lock
     6385         where rowid(buf_trn-doc) = p-doc-code-rowid
     6386         no-error .
     6387       if not available buf_trn-doc
     6388       then do:
     6389         message
     6390           vss-workfile vss-revision vss-description skip
     6391           vss-include-info22 skip
     6392           "Ошибка задания входных параметров" skip
     6393           "Не найден документ" skip
     6394           "Документ" string(p-doc-code-rowid) skip
     6395           "Партия" string(p-parts-rowid) skip
     6396           error-status :get-message(1) skip
     6397           return-value skip
     6398           view-as alert-box error .
     6399         undo, return error .
     6400       end.
     6401       find first archive_parts
     6402         where rowid(archive_parts) = p-parts-rowid
     6403         no-error .
     6404       if not available archive_parts
     6405       then do:
     6406         message
     6407           vss-workfile vss-revision vss-description skip
     6408           vss-include-info22 skip
     6409           "Ошибка задания входных параметров" skip
     6410           "Не найдена партия" skip
     6411           "Документ" string(p-doc-code-rowid) skip
     6412           "Партия" string(p-parts-rowid) skip
     6413           error-status :get-message(1) skip
     6414           return-value skip
     6415           view-as alert-box error .
     6416         undo, return error .
     6417       end.
     6418       if  archive_parts.out-code <> archive_parts.in-code
     6419       and archive_parts.qnty <> 0
     6420       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     6421       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     6422       then do:
     6423         assign
     6424           v-rsrv-code =
     6425           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     6426         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     6427         then 'free-zone':U
     6428         else 'out-zone':U )
     6429         .
     6430         run partcopy in this-procedure
     6431           (input  true
     6432           ,input  v-rsrv-code
     6433           ,buffer archive_parts
     6434           ,buffer buf_parts
     6435           ,input  "news"
     6436           ) no-error .
     6437         if error-status :error
     6438         then do:
     6439           message
     6440             vss-workfile vss-revision vss-description skip
     6441             vss-include-info22 skip
     6442             "Ошибка при создании партии" skip
     6443             "Документ" buf_trn-doc.doc-code skip
     6444             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     6445             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     6446             "Партия" archive_parts.in-code archive_parts.part-code skip
     6447             "Количество" archive_parts.qnty skip
     6448             "Резерв" v-rsrv-code skip
     6449             error-status :get-message(1) skip
     6450             return-value skip
     6451             view-as alert-box error .
     6452           undo, return error .
     6453         end.
     6454         assign
     6455           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     6456                                                     * (if p-rsrv-direction = true
     6457                                                       then 1
     6458                                                       else -1
     6459                                                       )
     6460           buf_parts.fact-qnty = buf_parts.qnty
     6461         .
     6462         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     6463                                        and buf_goods.prod-type = archive_parts.prod-type
     6464                                        and buf_goods.prod-code = archive_parts.prod-code
     6465                                        .
     6466         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     6467                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     6468                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     6469                                               and orig_marking-lines.in-code    = archive_parts.in-code
     6470                                               and orig_marking-lines.out-code   = archive_parts.out-code
     6471                                               and orig_marking-lines.part-code  = archive_parts.part-code
     6472                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     6473                                               :
     6474           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     6475                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     6476                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     6477                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     6478                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     6479                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     6480                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     6481                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     6482                                                   no-error .
     6483           if available buf_marking-lines
     6484           then do :
     6485             find current buf_marking-lines exclusive-lock .
     6486             delete buf_marking-lines .
     6487             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     6488               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     6489             end .
     6490           end .
     6491           else do :
     6492             create buf_marking-lines .
     6493             assign
     6494               buf_marking-lines.mark       = orig_marking-lines.mark
     6495               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     6496               buf_marking-lines.gds-code   = buf_goods.gds-code
     6497               buf_marking-lines.obj-type   = buf_parts.obj-type
     6498               buf_marking-lines.obj-code   = buf_parts.obj-code
     6499               buf_marking-lines.in-code    = buf_parts.in-code
     6500               buf_marking-lines.out-code   = buf_parts.out-code
     6501               buf_marking-lines.part-code  = buf_parts.part-code
     6502               buf_marking-lines.prt-code   = buf_parts.prt-code
     6503             .
     6504             if buf_parts.out-code <> buf_parts.in-code
     6505             and buf_parts.out-code <> 'free-zone':U
     6506             and buf_parts.out-code <> 'out-zone':U
     6507             then do :
     6508               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     6509               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     6510             end .
     6511             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     6512               assign
     6513                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     6514                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     6515               .
     6516             end .
     6517           end .
     6518           release buf_marking-lines no-error .
     6519         end.
     6520         if p-goods-twounit = true
     6521         then do:
     6522           assign
     6523             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     6524                                                     * (if p-rsrv-direction = true
     6525                                                       then 1
     6526                                                       else -1
     6527                                                       )
     6528           .
     6529         end.
     6530         if  buf_parts.qnty      = 0
     6531         and buf_parts.fact-qnty = 0
     6532         then do:
     6533           if p-goods-twounit = true
     6534           then do:
     6535             if buf_parts.cli-qnty <> 0
     6536             then do:
     6537               message
     6538                 vss-workfile vss-revision vss-description skip
     6539                 vss-include-info22 skip
     6540                 "Ошибка при удалении партии" skip
     6541                 "Документ" buf_trn-doc.doc-code skip
     6542                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     6543                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     6544                 "Партия" buf_parts.in-code buf_parts.part-code skip
     6545                 "Резерв" buf_parts.out-code skip
     6546                 "qnty" buf_parts.qnty skip
     6547                 "fact-qnty" buf_parts.fact-qnty skip
     6548                 "cli-qnty" buf_parts.cli-qnty skip
     6549                 view-as alert-box error .
     6550               undo, return error .
     6551             end.
     6552           end.
     6553           delete buf_parts .
     6554         end.
     6555       end.
     6556     end.
     6557   end procedure.
     6558   procedure partcopy-update-doc-line-tot-fact :
     6559     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     6560     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     6561     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     6562     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     6563     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     6564       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     6565     define buffer buf_doc-line for ub.doc-line .
     6566     do
     6567     on error undo, return error return-value
     6568     :
     6569       find first buf_doc-line exclusive-lock
     6570         where buf_doc-line.doc-code  = p-doc-code
     6571           and buf_doc-line.artic     = p-artic
     6572           and buf_doc-line.prod-type = p-prod-type
     6573           and buf_doc-line.prod-code = p-prod-code
     6574         no-error .
     6575       if error-status :error
     6576       then do:
     6577         message
     6578           vss-workfile vss-revision vss-description skip
     6579           vss-include-info22 skip
     6580           "Ошибка задания входных параметров" skip
     6581           "Не найдена строка документа" skip
     6582           "Документ" p-doc-code skip
     6583           "Артикул" p-artic p-prod-type p-prod-code skip
     6584           error-status :get-message(1) skip
     6585           return-value skip
     6586           view-as alert-box error .
     6587         undo, return error .
     6588       end.
     6589       run partrqst in this-procedure
     6590         (input buf_doc-line.doc-code
     6591         ,input buf_doc-line.obj-type
     6592         ,input buf_doc-line.obj-code
     6593         ,input buf_doc-line.artic
     6594         ,input buf_doc-line.prod-type
     6595         ,input buf_doc-line.prod-code
     6596               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     6597         ) no-error .
     6598       if error-status :error
     6599       then do:
     6600         message
     6601           vss-workfile vss-revision vss-description skip
     6602           vss-include-info22 skip
     6603           "Ошибка при сборе информации по партиям" skip
     6604           "Документ" p-doc-code skip
     6605           "Артикул" p-artic p-prod-type p-prod-code skip
     6606           view-as alert-box error .
     6607         undo, return error .
     6608       end.
     6609       if v-total-parts-fact-qnty <> 0
     6610       then do:
     6611         assign
     6612           buf_doc-line.price-base      = v-total-parts-price-base
     6613                                        / v-total-parts-fact-qnty
     6614           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     6615                                        / v-total-parts-fact-qnty
     6616           buf_doc-line.transport-base  = v-total-parts-transport-base
     6617                                        / v-total-parts-fact-qnty
     6618           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     6619                                        / v-total-parts-fact-qnty
     6620           buf_doc-line.other-base      = v-total-parts-other-base
     6621                                        / v-total-parts-fact-qnty
     6622           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     6623                                        / v-total-parts-fact-qnty
     6624         .
     6625       end.
     6626       else do:
     6627       end.
     6628     end.
     6629   end procedure.
     6630   procedure partcopy-change-purch-code :
     6631     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     6632     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     6633     define parameter buffer buf_orig_parts     for ub.parts .
     6634     define parameter buffer buf1_parts         for ub.parts .
     6635     define parameter buffer buf2_parts         for ub.parts .
     6636     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     6637     define variable var-out-code  like ub.parts.out-code no-undo .
     6638     define variable var-part-code like ub.parts.part-code no-undo .
     6639     define buffer buf_goods        for ub.goods .
     6640     define buffer buf_parts-root   for ub.parts-root.
     6641     define buffer buf_trn-doc      for ub.trn-doc.
     6642     define buffer buf-orig_trn-doc for ub.trn-doc.
     6643     define buffer buf_units        for ub.units .
     6644     do
     6645     on error undo, return error return-value
     6646     :
     6647       if buf_orig_parts.out-code = p-in-code
     6648       then do:
     6649         message
     6650           vss-workfile vss-revision vss-description skip
     6651           vss-include-info22 skip
     6652           "Ошибка задания входных параметров процедуры partcopy" skip
     6653           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     6654           "p-in-code" p-in-code skip
     6655           view-as alert-box error .
     6656         undo, return error .
     6657       end.
     6658       find first buf_trn-doc no-lock
     6659         where buf_trn-doc.doc-code = p-in-code
     6660         .
     6661       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     6662       find first buf_goods no-lock
     6663         where buf_goods.artic = buf_orig_parts.artic
     6664           and buf_goods.prod-type = buf_orig_parts.prod-type
     6665           and buf_goods.prod-code = buf_orig_parts.prod-code
     6666         .
     6667       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     6668       find first buf1_parts exclusive-lock
     6669         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     6670           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     6671           and buf1_parts.artic     = buf_orig_parts.artic
     6672           and buf1_parts.prod-type = buf_orig_parts.prod-type
     6673           and buf1_parts.prod-code = buf_orig_parts.prod-code
     6674           and buf1_parts.in-code   = buf_orig_parts.in-code
     6675           and buf1_parts.out-code  = p-in-code
     6676           and buf1_parts.part-code = buf_orig_parts.part-code
     6677         no-error.
     6678       if not available buf1_parts
     6679       then do:
     6680         create buf1_parts .
     6681         buffer-copy buf_orig_parts to buf1_parts
     6682         assign
     6683           buf1_parts.in-code    = buf_orig_parts.in-code
     6684           buf1_parts.out-code   = p-in-code
     6685           buf1_parts.status_    = no
     6686           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6687           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     6688           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     6689           buf1_parts.purch-code = buf_orig_parts.purch-code
     6690           buf1_parts.rsrv-free  = ?
     6691           buf1_parts.status_    = yes
     6692         .
     6693         validate buf1_parts .
     6694       end.
     6695       if  lookup('сер':U, buf_units.type) > 0
     6696       then do:
     6697          var-part-code = buf_orig_parts.part-code.
     6698       end.
     6699       else do:
     6700           run holdprts-get-part-code in this-procedure
     6701             (input  p-in-code
     6702             ,output var-part-code
     6703             ) no-error .
     6704           if error-status :error
     6705           then dO:
     6706             undo, return error return-value.
     6707           end.
     6708       end.
     6709       find first buf2_parts exclusive-lock
     6710         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     6711           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     6712           and buf2_parts.artic     = buf_orig_parts.artic
     6713           and buf2_parts.prod-type = buf_orig_parts.prod-type
     6714           and buf2_parts.prod-code = buf_orig_parts.prod-code
     6715           and buf2_parts.in-code   = p-in-code
     6716           and buf2_parts.out-code  = p-in-code
     6717           and buf2_parts.part-code = var-part-code
     6718         no-error.
     6719       if not available buf2_parts
     6720       then do:
     6721         create buf2_parts .
     6722         buffer-copy buf_orig_parts to buf2_parts
     6723         assign
     6724           buf2_parts.in-code   = p-in-code
     6725           buf2_parts.out-code  = p-in-code
     6726           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6727           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     6728           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     6729           buf2_parts.purch-code = p-dest-purch-code
     6730           buf2_parts.part-code  = var-part-code
     6731           buf2_parts.rsrv-free  = ?
     6732           buf2_parts.status_    = yes
     6733         .
     6734         validate buf2_parts .
     6735       end.
     6736       assign
     6737         buf_orig_parts.in-code    = p-in-code
     6738         buf_orig_parts.part-code  = buf2_parts.part-code
     6739         buf_orig_parts.purch-code = buf2_parts.purch-code
     6740       .
     6741       find first buf_parts-root
     6742         where buf_parts-root.doc-code       = p-in-code
     6743           and buf_parts-root.in-code        = p-in-code
     6744           and buf_parts-root.gds-code       = buf_goods.gds-code
     6745           and buf_parts-root.part-code      = buf2_parts.part-code
     6746           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     6747           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6748           and buf_parts-root.orig-part-code = buf1_parts.part-code
     6749         no-error .
     6750       if not available buf_parts-root
     6751       then do:
     6752         create buf_parts-root.
     6753         assign
     6754         buf_parts-root.doc-code       = p-in-code
     6755         buf_parts-root.in-code        = p-in-code
     6756         buf_parts-root.gds-code       = buf_goods.gds-code
     6757         buf_parts-root.part-code      = buf2_parts.part-code
     6758         buf_parts-root.orig-in-code   = buf1_parts.in-code
     6759         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     6760         buf_parts-root.orig-part-code = buf1_parts.part-code
     6761         .
     6762       end.
     6763     end.
     6764   end procedure.
     6765   procedure addChildMarkingLines:
     6766     define input parameter iMark as character no-undo.
     6767     define input parameter iSts  as integer   no-undo.
     6768     define parameter buffer buf_marking-lines  for ub.marking-lines.
     6769     define parameter buffer buf_parts          for ub.parts.
     6770     define parameter buffer orig_marking-lines for ub.marking-lines.
     6771     define parameter buffer buf_orig_parts     for ub.parts.
     6772     define parameter buffer buf_goods          for ub.goods.
     6773     define buffer buf_marking-childs        for ub.marking.
     6774     define buffer buf_marking-lines-childs  for ub.marking-lines.
     6775     define buffer buf_marking-chk           for ub.marking-chk.
     6776     define buffer buf_chk-doc               for ub.chk-doc.
     6777     define buffer orig_marking-lines-childs for ub.marking-lines.
     6778     for each buf_marking-childs exclusive-lock where
     6779              buf_marking-childs.mark-parent = iMark :
     6780         find first buf_marking-lines-childs no-lock where
     6781                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6782                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6783                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6784                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6785                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6786                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6787                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6788                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6789         no-error .
     6790         if not available buf_marking-lines-childs then
     6791         do:
     6792           create buf_marking-lines-childs .
     6793           assign
     6794             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     6795             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     6796             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     6797             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     6798             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     6799             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     6800             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     6801             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     6802             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     6803             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     6804           .
     6805           validate buf_marking-childs.
     6806         end .
     6807         buf_marking-childs.sts = iSts .
     6808         for each buf_marking-chk exclusive-lock where
     6809                  buf_marking-chk.mark begins buf_marking-childs.mark
     6810         :
     6811           for first buf_chk-doc no-lock where
     6812                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     6813                 and buf_chk-doc.out-code = buf_parts.out-code
     6814           :
     6815             buf_marking-chk.sts = 0 .
     6816             validate buf_marking-chk.
     6817           end .
     6818         end .
     6819         if available orig_marking-lines
     6820         then do :
     6821           find first orig_marking-lines-childs exclusive-lock where
     6822                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     6823                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     6824                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     6825                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     6826                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     6827                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     6828                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     6829                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     6830           no-error .
     6831           if available orig_marking-lines-childs then
     6832             delete orig_marking-lines-childs .
     6833         end.
     6834         run addChildMarkingLines in this-procedure (
     6835           buf_marking-childs.mark,
     6836           iSts,
     6837           buffer buf_marking-lines,
     6838           buffer buf_parts,
     6839           buffer orig_marking-lines,
     6840           buffer buf_orig_parts,
     6841           buffer buf_goods
     6842         ).
     6843     end .
     6844   end.
     6845   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6846   procedure set-cli :
     6847     do
     6848     on error undo, return error return-value
     6849     :
     6850       define input parameter p-trn-doc-recid as recid no-undo .
     6851       define variable vss-description as character no-undo init "$Workfile$ Установка признаков клиента при закрытии документов" .
     6852       define buffer buf_trn-doc for ub.trn-doc .
     6853       define buffer buf_clients for ub.clients .
     6854       define variable v-cons-pay like ub.trn-doc.pay-code no-undo .
     6855       find first buf_trn-doc no-lock
     6856         where recid(buf_trn-doc) = p-trn-doc-recid
     6857         no-error .
     6858       if not available buf_trn-doc then do:
     6859         message
     6860           vss-workfile vss-revision vss-description skip
     6861           "Ошибка задания входных параметров" skip
     6862           "Не найден документ" skip
     6863           "Код записи документ (recid)" p-trn-doc-recid skip
     6864           view-as alert-box error .
     6865         undo, return error .
     6866       end.
     6867       define variable v-at-value as character no-undo .
     6868       define variable v-at-type  as character no-undo .
     6869   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6870   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objatext in g#library
     6871     (input  buf_trn-doc.obj-type
     6872     ,input  buf_trn-doc.obj-code
     6873     ,input  'cons-pay=request':u
     6874     ,output v-at-value
     6875     ,output v-at-type
     6876     ) no-error .
     6877       if error-status :error
     6878       or v-at-type <> 'I':U then do:
     6879         message
     6880           vss-workfile vss-revision vss-description skip
     6881           "Ошибка при определении расширенного атрибута объекта" skip
     6882           "Документ" buf_trn-doc.doc-code skip
     6883           "Объект" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
     6884           error-status :get-message(1) skip
     6885           return-value skip
     6886           view-as alert-box error .
     6887         undo, return error .
     6888       end.
     6889       assign
     6890         v-cons-pay = integer(v-at-value)
     6891       .
     6892       define variable l-sup as logical no-undo .
     6893       define variable l-buy as logical no-undo .
     6894       assign
     6895         l-sup = (lookup(buf_trn-doc.ext-doc-type, 'ie':U ) > 0)
     6896         l-buy = (lookup(buf_trn-doc.ext-doc-type, 'ee':U ) > 0)
     6897       .
     6898       if l-sup = true
     6899       or l-buy = true
     6900       then do:
     6901         find buf_clients no-lock
     6902           where buf_clients.obj-type = buf_trn-doc.cli-type
     6903             and buf_clients.obj-code = buf_trn-doc.cli-code
     6904           no-error .
     6905         if error-status :error then do:
     6906           message
     6907             vss-workfile vss-revision vss-description skip
     6908             "Не найден контрагент" skip
     6909             "Документ" buf_trn-doc.cli-type buf_trn-doc.cli-code skip
     6910             view-as alert-box error .
     6911           undo, return error .
     6912         end.
     6913         define variable l-gds  as logical   no-undo .
     6914         define variable l-cons as logical   no-undo .
     6915         define variable l-serv as logical   no-undo .
     6916         assign
     6917           l-gds  = false
     6918           l-cons = false
     6919           l-serv = false
     6920         .
     6921         if buf_trn-doc.office = true then do:
     6922           assign
     6923             l-serv = true
     6924           .
     6925         end.
     6926         else do:
     6927           if buf_trn-doc.purch-code = v-cons-pay then do:
     6928             assign
     6929               l-cons = true
     6930             .
     6931           end.
     6932           else do:
     6933             assign
     6934               l-gds = true
     6935             .
     6936           end.
     6937         end.
     6938         if l-sup then do:
     6939           if (l-gds  = true and (buf_clients.sup-gds  <> true) )
     6940           or (l-cons = true and (buf_clients.sup-cons <> true) )
     6941           or (l-serv = true and (buf_clients.sup-serv <> true) )
     6942           then
     6943           do transaction
     6944           on error undo, return error return-value
     6945           :
     6946             find current buf_clients exclusive-lock .
     6947             run clientsh_write-clients-proc in this-procedure  (
     6948                                                          buffer buf_clients
     6949                                                         ,input (if g#news then 'db':U else 'trn-doc':U)
     6950                                                         ,input (if g#news then string(g#news-source-db) else buf_trn-doc.doc-code)
     6951                                                         ) .
     6952             assign
     6953               buf_clients.sup-gds  = buf_clients.sup-gds  or l-gds
     6954               buf_clients.sup-cons = buf_clients.sup-cons or l-cons
     6955               buf_clients.sup-serv = buf_clients.sup-serv or l-serv
     6956             .
     6957           end.
     6958         end.
     6959         if l-buy then do:
     6960           if (l-gds  = true and (buf_clients.buy-gds  <> true) )
     6961           or (l-cons = true and (buf_clients.buy-cons <> true) )
     6962           or (l-serv = true and (buf_clients.buy-serv <> true) )
     6963           then
     6964           do transaction
     6965           on error undo, return error return-value
     6966           :
     6967             find current buf_clients exclusive-lock .
     6968             run clientsh_write-clients-proc in this-procedure  (
     6969                                                          buffer buf_clients
     6970                                                         ,input (if g#news then 'db':U else 'trn-doc':U)
     6971                                                         ,input (if g#news then string(g#news-source-db) else buf_trn-doc.doc-code)
     6972                                                         ) .
     6973             assign
     6974               buf_clients.buy-gds  = buf_clients.buy-gds  or l-gds
     6975               buf_clients.buy-cons = buf_clients.buy-cons or l-cons
     6976               buf_clients.buy-serv = buf_clients.buy-serv or l-serv
     6977             .
     6978           end.
     6979         end.
     6980       end.
     6981     end.
     6982   end procedure.
     6983   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6984   procedure trnbccr :
     6985     define input parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     6986     define variable vss-description as character no-undo init "trnbccr: Создание бар-кодов партий" .
     6987     define buffer buf_trn-doc  for ub.trn-doc .
     6988     define buffer buf_parts    for ub.parts .
     6989     define buffer buf_bar-code for ub.bar-code .
     6990     define buffer buf_goods    for ub.goods .
     6991     define variable v-root-node       as integer   no-undo .
     6992     define variable l-create-bar-code as logical   no-undo .
     6993     do
     6994     on error undo, return error
     6995     :
     6996       find first buf_trn-doc no-lock
     6997         where buf_trn-doc.doc-code = p-doc-code
     6998         no-error .
     6999       if not available buf_trn-doc then do:
     7000         message
     7001           vss-workfile vss-revision vss-description skip
     7002           "Ошибка задания входных параметров" skip
     7003           "Документ" p-doc-code skip
     7004           view-as alert-box error .
     7005         undo, return error .
     7006       end.
     7007       if buf_trn-doc.status_ <> 'факт':U then do:
     7008         message
     7009           vss-workfile vss-revision vss-description skip
     7010           "Документ имеет статус отличный от статуса" 'факт':U skip
     7011           "Документ" p-doc-code skip
     7012           view-as alert-box error .
     7013         undo, return error .
     7014       end.
     7015       for each buf_parts
     7016         where buf_parts.out-code = buf_trn-doc.doc-code
     7017           and buf_parts.in-code  = buf_parts.out-code
     7018       on error undo, return error
     7019       :
     7020   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7021   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     7022     (input  buf_parts.artic
     7023     ,input  buf_parts.prod-type
     7024     ,input  buf_parts.prod-code
     7025     ,output v-root-node
     7026     ) no-error .
     7027         if error-status :error then do:
     7028           message
     7029             vss-workfile vss-revision vss-description skip
     7030             "Ошибка при определении корневого признака" skip
     7031             view-as alert-box error .
     7032           undo, return error .
     7033         end.
     7034   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7035   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     7036     (input  buf_parts.obj-type
     7037     ,input  buf_parts.obj-code
     7038     ,input  buf_parts.artic
     7039     ,input  buf_parts.prod-type
     7040     ,input  buf_parts.prod-code
     7041     ,input  'create-bar-code=request':u
     7042     ,output l-create-bar-code
     7043     ) no-error .
     7044         if error-status :error then do:
     7045           message
     7046             vss-workfile vss-revision vss-description skip
     7047             "Ошибка при определении признака товара на объекте" skip
     7048             "Объект" buf_parts.obj-type buf_parts.obj-code skip
     7049             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     7050             "Запрашиваемый атрибут" "cash-parts=request":u skip
     7051             error-status :get-message(1) skip
     7052             return-value skip
     7053             view-as alert-box error .
     7054           undo, return error .
     7055         end.
     7056         if l-create-bar-code then do:
     7057           define variable v-bar-code-is-new as logical no-undo .
     7058           find first buf_goods no-lock
     7059             where buf_goods.artic     = buf_parts.artic
     7060               and buf_goods.prod-type = buf_parts.prod-type
     7061               and buf_goods.prod-code = buf_parts.prod-code
     7062             .
     7063   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     7065     (input  buf_goods.gds-code
     7066     ,input  v-root-node
     7067     ,input  buf_parts.part-code
     7068     ,input  buf_parts.in-code
     7069     ,input  buf_goods.unit-base
     7070     ,input  ?
     7071     ,output v-bar-code-is-new
     7072     ,buffer buf_bar-code
     7073     ) no-error .
     7074           if error-status :error then do:
     7075             message
     7076               vss-workfile vss-revision vss-description skip
     7077               "Ошибка при создании бар-кода партии" skip
     7078               error-status :get-message(1) skip
     7079               return-value skip
     7080               view-as alert-box error .
     7081             undo, return error .
     7082           end.
     7083         end.
     7084       end.
     7085     end.
     7086   end procedure.
     7087   def var vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7088   procedure tax-name:
     7089   define input  parameter pardef-tax  as character           no-undo.
     7090   define output parameter parname-tax as character initial ? no-undo.
     7091   define buffer bf_tax for ub.tax.
     7092   do on error undo, return error :
     7093      case pardef-tax:
     7094         when 'vat':U then do:
     7095                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     7096         end.
     7097         when 'slt':U then do:
     7098                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     7099         end.
     7100         when 'rdt':U then do:
     7101                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     7102         end.
     7103         when 'exc':U then do:
     7104                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     7105         end.
     7106         otherwise do:
     7107            return error "Задан неверный параметр " + pardef-tax + " .".
     7108         end.
     7109      end case.
     7110   end.
     7111   end procedure.
     7112   procedure chkprice:
     7113   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     7114   define buffer bf_trn-doc  for ub.trn-doc.
     7115   define buffer bf_doc-line for ub.doc-line.
     7116   define buffer bf_gds-dtl  for ub.gds-dtl.
     7117   define buffer bf_goods    for ub.goods.
     7118   define buffer bf_gds-prt  for ub.gds-prt.
     7119   define buffer bf_parts    for ub.parts.
     7120   define variable varroad-taxname as character no-undo.
     7121   define variable varexcisename   as character no-undo.
     7122   define variable varr-b          as character no-undo.
     7123   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7124   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7125     (output varr-b
     7126     )  .
     7127   run tax-name ('rdt':U,   output varroad-taxname).
     7128   run tax-name ('exc':U, output varexcisename).
     7129   do on error undo, return error return-value:
     7130      find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-error.
     7131       if not available bf_trn-doc then
     7132           return error SUBSTITUTE("Не найден документ с номером &1 (файл chkprice.i).", pardoc-code).
     7133      if bf_trn-doc.status_ = 'запрос':U then return.
     7134      for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code,
     7135          first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     7136                               bf_goods.prod-type = bf_doc-line.prod-type and
     7137                               bf_goods.prod-code = bf_doc-line.prod-code no-lock :
     7138        if bf_trn-doc.doc-type <> 'инв':U then do:
     7139          if bf_doc-line.doc-qnty = 0 and bf_doc-line.fact-qnty = 0 then next.
     7140                                             if bf_doc-line.price-cli < 0 or bf_doc-line.price-cli = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "цена поставщика",                                        bf_doc-line.price-cli,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7141                               if bf_doc-line.price-rubl < 0 or bf_doc-line.price-rubl = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "учетная цена в рублях",                                        bf_doc-line.price-rubl,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7142                               if bf_doc-line.price-base < 0 or bf_doc-line.price-base = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "учетная цена в базовой валюте",                                        bf_doc-line.price-base,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7143                               if bf_doc-line.road-tax < 0 or bf_doc-line.road-tax = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         varroad-taxname,                                        bf_doc-line.road-tax,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7144                               if bf_doc-line.excise < 0 or bf_doc-line.excise = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         varexcisename,                                        bf_doc-line.excise,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7145                               if bf_doc-line.transport-base < 0 then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "транспортные расходы в базовой валюте",                                        bf_doc-line.transport-base,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7146                               if bf_doc-line.transport-rubl < 0 then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "транспортные расходы в рублях",                                        bf_doc-line.transport-rubl,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7147                               if bf_doc-line.other-base < 0 then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "прочие расходы в базовой валюте",                                        bf_doc-line.other-base,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7148                               if bf_doc-line.other-rubl < 0 then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "прочие расходы в рублях",                                        bf_doc-line.other-rubl,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7149       end.
     7150       else do:
     7151          if bf_doc-line.fact-qnty = 0 then next.
     7152                                             if bf_doc-line.price-cli = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "цена поставщика",                                        bf_doc-line.price-cli,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7153                               if bf_doc-line.price-rubl = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "учетная цена в рублях",                                        bf_doc-line.price-rubl,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7154                               if bf_doc-line.price-base = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         "учетная цена в базовой валюте",                                        bf_doc-line.price-base,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
     7155                               if bf_doc-line.road-tax = ? then                             return error SUBSTITUTE("Ошибка в << &1 : &2 . Документ &3. Расширенный тип &4. Объект &5. Товар &6 &7 &8 &9 &10",                                         varroad-taxname,                                        bf_doc-line.road-tax,                                        bf_trn-doc.doc-code,                                         bf_trn-doc.ext-doc-type,                                         bf_trn-doc.obj-type + " " + string(bf_trn-doc.obj-code),                                         bf_goods.artic,                                         bf_goods.prod-type,                                         bf_goods.prod-code,                                         bf_goods.gds-name )                                          + " >>.".
