        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.scales-attr OLD oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись scales-attr".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3',  ub.scales-attr.db-num
       29                                             , ub.scales-attr.scales-num
       30                                             , ub.scales-attr.attr-code
       31                                             )
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure cur-time :
       86      define output parameter p-today as date      no-undo .
       87      define output parameter p-time  as integer   no-undo .
       88     do
       89     on error undo, return error
       90     :
       91       define variable v-date1 as date      no-undo .
       92       define variable v-date2 as date      no-undo .
       93       define variable v-time  as integer   no-undo .
       94       assign
       95         v-date1 = today
       96         v-time  = time
       97         v-date2 = today
       98       .
       99       if v-date1 <> v-date2
      100       then do:
      101         assign
      102           v-date1 = today
      103           v-time  = v-time
      104         .
      105       end.
      106       assign
      107         p-today = v-date1
      108         p-time  = v-time
      109       .
      110     end.
      111   end.
      112   function cur-time-date returns character
      113   :
      114     return string(today, '99/99/9999':U) .
      115   end.
      116   function cur-time-mjd returns decimal
      117   :
      118     define variable v-date as date      no-undo .
      119     define variable v-time as integer   no-undo .
      120     run cur-time in this-procedure
      121       (output v-date
      122       ,output v-time
      123       ) .
      124     return integer(v-date) - 2400002 + (v-time / 86400) .
      125   end.
      126   function cur-time-get-ending-index returns integer
      127   (input p-number as integer
      128   )
      129   :
      130     if p-number < 0
      131     or p-number = ?
      132     then do:
      133       return 1 .
      134     end.
      135     define variable v-rest as integer   no-undo .
      136     assign
      137       p-number = p-number modulo 100
      138     .
      139     if p-number < 20
      140     then do:
      141       assign
      142         v-rest = p-number
      143       .
      144     end.
      145     else do:
      146       assign
      147         v-rest = p-number modulo 10
      148       .
      149     end.
      150     case v-rest :
      151       when 1
      152       then do:
      153         return 2 .
      154       end.
      155       when 2 or
      156       when 3 or
      157       when 4
      158       then do:
      159         return 3 .
      160       end.
      161       otherwise do:
      162         return 1 .
      163       end.
      164     end case .
      165   end.
      166   procedure cur-time-mjd-to-date :
      167      define input  parameter i-mjd-diff as decimal no-undo.
      168      define output parameter o-Date     as date    no-undo.
      169      define output parameter o-Time     as integer no-undo.
      170      define variable v-day-number as integer   no-undo .
      171      if    i-mjd-diff < 0
      172         or i-mjd-diff = ?
      173      then do:
      174         return "?" .
      175      end.
      176      assign
      177         v-day-number = truncate(i-mjd-diff,0).
      178         o-Date = date(v-day-number + 2400002).
      179         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      180     .
      181   end.
      182   function cur-time-mjd-to-string returns character
      183   (input p-mjd-diff as decimal
      184   )
      185   :
      186     define variable v-day-number as integer   no-undo .
      187     define variable v-seconds    as integer   no-undo .
      188     define variable v-hour       as integer   no-undo .
      189     define variable v-min        as integer   no-undo .
      190     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      191     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      192     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      193     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      194     if p-mjd-diff < 0
      195     or p-mjd-diff = ?
      196     then do:
      197       return "?" .
      198     end.
      199     assign
      200       v-day-number = integer(truncate(p-mjd-diff,0))
      201       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203     if v-seconds > 86400
      204     then do:
      205       assign
      206         v-seconds = 86400 - 1
      207       .
      208     end.
      209     if v-seconds < 0
      210     then do:
      211       assign
      212         v-seconds = 0
      213       .
      214     end.
      215     assign
      216       v-hour = truncate(v-seconds / 3600, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 3600
      220     .
      221     assign
      222       v-min = truncate(v-seconds / 60, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 60
      226     .
      227     return
      228         (if v-day-number <> 0
      229           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0
      233           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      237           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      238           else ""
      239         )
      240       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      241       .
      242   end.
      243   function cur-time-string returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      252   end.
      253   function cur-time-string-sec returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      262   end.
      263   function cur-time-custom  returns character
      264   (input p-prefix as character
      265   ,input p-date-format as character
      266   ,input p-delimiter as character
      267   ,input p-time-format as character
      268   ,input p-suffix as character
      269   )
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return
      278       p-prefix
      279       + string(v-date, p-date-format)
      280       + p-delimiter
      281       + string(v-time, p-time-format)
      282       + p-suffix
      283       .
      284   end.
      285   function cur-time-print  returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      294   end.
      295   function cur-time-datetime returns datetime
      296   :
      297     define variable v-char as character no-undo .
      298     define variable v-datetime as datetime no-undo .
      299     v-char = cur-time-string().
      300     v-datetime = datetime(v-char).
      301     return  v-datetime.
      302   end.
      303   function cur-time-string-msec returns character
      304   :
      305     define variable v-date as datetime  no-undo .
      306     v-date = now.
      307     return string(v-date) .
      308   end.
      309   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   procedure scl-attr-code :
      312     do
      313     on error undo, return error
      314     :
      315       define input  parameter p-code           as character no-undo .
      316       define output parameter p-type           as character no-undo .
      317       define output parameter p-format         as character no-undo .
      318       define output parameter p-label          as character no-undo .
      319       define output parameter p-user-can-edit  as logical   no-undo .
      320       define output parameter p-output-display as logical   no-undo .
      321       define output parameter p-other          as character no-undo .
      322       case p-code :
      323               when 'tare-weight':U then do:     assign     p-label = "Веса и коды тары"     p-type = 'C':U      p-format = "X(32)"     p-label = "Веса и коды тары"     p-user-can-edit  = yes     p-output-display = true     p-other = 'scl=TIGER,MIRA,TIGER2,TIGER-SPCT2/spr=scl-attr-tare-weight':u      .   end.
      324         otherwise do:
      325           undo, return error "неизвестный атрибут весов" + " " + p-code .
      326         end.
      327       end.
      328     end.
      329   end procedure.
      330   procedure scl-attr-tooltip :
      331     do
      332     on error undo, return error
      333     :
      334       define input  parameter p-code    as character no-undo .
      335       define output parameter p-tooltip as character no-undo .
      336       define output parameter p-label   as character no-undo .
      337       case p-code :
      338               when 'tare-weight':U then do:     assign     p-tooltip = "Веса и коды тары"     p-label = "Веса и коды тары" .   end.
      339         otherwise do:
      340           undo, return error "неизвестный атрибут весов" + " " + p-code .
      341         end.
      342       end.
      343     end.
      344   end procedure.
      345   procedure scl-attr-value :
      346     do
      347     on error undo, return error
      348     :
      349       define input  parameter p-db-num   like ub.scales-attr.db-num        no-undo .
      350       define input  parameter p-scales-num like ub.scales-attr.scales-num      no-undo .
      351       define input  parameter p-code     like ub.scales-attr.attr-code      no-undo .
      352       define output parameter p-value    like ub.scales-attr.attr-value    no-undo .
      353       define output parameter p-type     as character no-undo .
      354       define buffer buf_scales-attr for ub.scales-attr .
      355       define variable v-format         as character no-undo .
      356       define variable v-label          as character no-undo .
      357       define variable v-user-can-edit  as logical   no-undo .
      358       define variable v-output-display as logical   no-undo .
      359       define variable v-other          as character no-undo .
      360       run scl-attr-code in this-procedure
      361         (input  p-code
      362         ,output p-type
      363         ,output v-format
      364         ,output v-label
      365         ,output v-user-can-edit
      366         ,output v-output-display
      367         ,output v-other
      368         ) no-error .
      369       if error-status :error then do:
      370         undo, return error return-value .
      371       end.
      372       find first buf_scales-attr no-lock
      373         where buf_scales-attr.db-num    = p-db-num
      374           and buf_scales-attr.scales-num  = p-scales-num
      375           and buf_scales-attr.attr-code = p-code
      376         no-error .
      377       if avail buf_scales-attr then do:
      378         assign
      379           p-value =  buf_scales-attr.attr-value
      380         .
      381       end.
      382       else do:
      383         assign
      384           p-value = if p-type = 'L':U then "no":U else ""
      385         .
      386       end.
      387     end.
      388   end procedure.
      389   procedure scl-attr-write :
      390     do
      391     on error undo, return error
      392     :
      393       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      394       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      395       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      396       define input parameter p-value    like ub.scales-attr.attr-value no-undo .
      397       define buffer buf_scales-attr for ub.scales-attr .
      398       define variable v-type           as character no-undo .
      399       define variable v-format         as character no-undo .
      400       define variable v-label          as character no-undo .
      401       define variable v-user-can-edit  as logical   no-undo .
      402       define variable v-output-display as logical   no-undo .
      403       define variable v-other          as character no-undo .
      404       run scl-attr-code in this-procedure
      405         (input  p-code
      406         ,output v-type
      407         ,output v-format
      408         ,output v-label
      409         ,output v-user-can-edit
      410         ,output v-output-display
      411         ,output v-other
      412         ) no-error .
      413       if error-status :error then do:
      414         undo, return error return-value .
      415       end.
      416       find first buf_scales-attr exclusive-lock
      417         where buf_scales-attr.db-num  = p-db-num
      418           and buf_scales-attr.scales-num  = p-scales-num
      419           and buf_scales-attr.attr-code = p-code
      420         no-error .
      421       if not available buf_scales-attr then do:
      422         create buf_scales-attr .
      423         assign
      424           buf_scales-attr.db-num    = p-db-num
      425           buf_scales-attr.scales-num  = p-scales-num
      426           buf_scales-attr.attr-code = p-code
      427         .
      428       end.
      429       assign
      430         buf_scales-attr.attr-value = p-value
      431       .
      432       release buf_scales-attr no-error .
      433       if error-status:error then do:
      434         undo, return error return-value .
      435       end.
      436     end.
      437   end procedure.
      438   procedure scl-attr-exist :
      439     do
      440     on error undo, return error
      441     :
      442       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      443       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      444       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      445       define output parameter p-exist   as logical  no-undo .
      446       define buffer buf_scales-attr for ub.scales-attr .
      447       define variable v-type           as character no-undo .
      448       define variable v-format         as character no-undo .
      449       define variable v-label          as character no-undo .
      450       define variable v-user-can-edit  as logical   no-undo .
      451       define variable v-output-display as logical   no-undo .
      452       define variable v-other          as character no-undo .
      453       run scl-attr-code in this-procedure
      454         (input  p-code
      455         ,output v-type
      456         ,output v-format
      457         ,output v-label
      458         ,output v-user-can-edit
      459         ,output v-output-display
      460         ,output v-other
      461         ) no-error .
      462       if error-status :error then do:
      463         undo, return error return-value .
      464       end.
      465       find first buf_scales-attr exclusive-lock
      466         where buf_scales-attr.db-num  = p-db-num
      467           and buf_scales-attr.scales-num  = p-scales-num
      468           and buf_scales-attr.attr-code = p-code
      469         no-error .
      470       if  available buf_scales-attr then do:
      471         p-exist = yes.
      472       end.
      473     end.
      474   end procedure.
      475   procedure scl-attr-delete :
      476     do
      477     on error undo, return error
      478     :
      479       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      480       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      481       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      482       define output parameter p-deleted  as logical no-undo.
      483       define buffer buf_scales-attr for ub.scales-attr .
      484       define variable v-type           as character no-undo .
      485       define variable v-format         as character no-undo .
      486       define variable v-label          as character no-undo .
      487       define variable v-user-can-edit  as logical   no-undo .
      488       define variable v-output-display as logical   no-undo .
      489       define variable v-other          as character no-undo .
      490       run scl-attr-code in this-procedure
      491         (input  p-code
      492         ,output v-type
      493         ,output v-format
      494         ,output v-label
      495         ,output v-user-can-edit
      496         ,output v-output-display
      497         ,output v-other
      498         ) no-error .
      499       if error-status :error then do:
      500         undo, return error return-value .
      501       end.
      502       find first buf_scales-attr exclusive-lock
      503         where buf_scales-attr.db-num  = p-db-num
      504           and buf_scales-attr.scales-num  = p-scales-num
      505           and buf_scales-attr.attr-code = p-code
      506         no-error NO-WAIT.
      507       if not available buf_scales-attr then do:
      508         p-deleted = no.
      509       end.
      510       else do:
      511         delete buf_scales-attr no-error .
      512         if error-status:error then do:
      513           undo, return error return-value .
      514         end.
      515         p-deleted = yes.
      516       end.
      517     end.
      518   end procedure.
      519   procedure scl-attr-news :
      520     do
      521     on error undo, return error
      522     :
      523       define input  parameter p-code           as character no-undo .
      524       define output parameter p-news           as logical   no-undo .
      525       case p-code :
      526               when 'tare-weight':U then do:     assign     p-news = yes.   end.
      527         otherwise do:
      528           p-news = no.
      529         end.
      530       end.
      531     end.
      532   end procedure.
      533   procedure scl-attr-hist :
      534     do
      535     on error undo, return error
      536     :
      537       define input  parameter p-code           as character no-undo .
      538       define output parameter p-hist           as logical   no-undo .
      539       case p-code :
      540               when 'tare-weight':U then do:     assign     p-hist = yes.   end.
      541         otherwise do:
      542           p-hist = no.
      543         end.
      544       end.
      545     end.
      546   end procedure.
      547   define variable v-date as date no-undo .
      548   define variable v-time as integer no-undo .
      549   define variable p-news as logical no-undo.
      550   define variable p-hist as logical no-undo.
      551   define buffer buf_scales for ub.scales.
      552   define buffer buf_c-scales for ub.c-scales.
      553   define buffer buf_c-scales-attr for ub.c-scales-attr.
      554   main-block:
      555   do
      556   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      557   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      558   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      559   :
      560     run scl-attr-news in this-procedure (
      561                                          input ub.scales-attr.attr-code
      562                                          ,output p-news) no-error.
      563     if not g#news and ub.scales-attr.db-num <> g#db-num then do:
      564       message
      565       "Нельзя изменять запись об атрибуте весов," skip
      566       "принадлежащих другой БД"
      567       view-as alert-box .
      568       undo main-block, return error.
      569     end.
      570     run scl-attr-hist in this-procedure (
      571                                         input ub.scales-attr.attr-code
      572                                         ,output p-hist) no-error.
      573     if p-hist then do:
      574       if not g#news then do:
      575         run cur-time in this-procedure(output v-date, output v-time).
      576         create buf_c-scales-attr.
      577         buffer-copy oldb to buf_c-scales-attr
      578         assign
      579         buf_c-scales-attr.db-num             =  ub.scales-attr.db-num
      580         buf_c-scales-attr.scales-num         =  ub.scales-attr.scales-num
      581         buf_c-scales-attr.attr-code          =  ub.scales-attr.attr-code
      582         buf_c-scales-attr.chip-num           = next-value (s-scales-chip, ub)
      583         buf_c-scales-attr.corr-time          = v-time
      584         buf_c-scales-attr.corr-user-db-num   = g#db-num
      585         buf_c-scales-attr.corr-user-name     = g#userid
      586         buf_c-scales-attr.corr-date          = v-date
      587         .
      588         create buf_c-scales.
      589         buffer-copy buf_c-scales-attr to buf_c-scales
      590         assign
      591         buf_c-scales.subject            = 'scales-attr':U
      592         buf_c-scales.action             = integer(if new(ub.scales-attr) then '1':U else '2':U)
      593         .
      594       end.
      595     end.
      596     if p-news then do:
      597       run str/callnews.p
      598         ( input "scales-attr"
      599           ,input (buffer ub.scales-attr:handle)
      600         ) no-error .
      601       if error-status:error then undo main-block, return error return-value .
      602     end.
      603       if g#oxml = yes
      604       then do:
      605       run str/calloxml.p (
      606             input 'update':U
      607           , input 'scales-attr':U
      608           , input ( buffer ub.scales-attr:handle )
      609       ) no-error.
      610       if error-status :error
      611       then do:
      612           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      613                                , chr(10)
      614                                , vss-workfile
      615                                , return-value
      616                                , error-status :get-message ( 1 ) ).
      617       end.
      618       end.
      619   end.
