     1298              :
     1299              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1300     end.
     1301   for each buf_price-all no-lock where
     1302            buf_price-all.obj-type = p-obj-type and
     1303            buf_price-all.obj-code = p-obj-code and
     1304            buf_price-all.gds-code = buf_goods.gds-code and
     1305            buf_price-all.status_  = 'акт':U  and
     1306          ( p-only-b-code = false   or
     1307          ( buf_price-all.b-code = p-main-b-code or
     1308            buf_price-all.b-code = p-b-code))    and
     1309           ( p-only-b-code = true  or
     1310             buf_price-all.b-code = p-b-code)
     1311             and
     1312             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1313           ( buf_price-all.fact-order-sys-to = ? or
     1314             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1315           :
     1316            v-interv   = "" .
     1317            v-grp-name = "" .
     1318            v-pay-name = "" .
     1319            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1320            if buf_price-all.bgr-id > 0 then do:
     1321               find first buf_buyer-group no-lock where
     1322                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1323                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1324               if available buf_buyer-group then do:
     1325                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1326                  find first buf_buyer-in-buyer-group no-lock where
     1327                             buf_buyer-in-buyer-group.stts         = 0 and
     1328                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1329                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1330                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1331                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1332                             no-error .
     1333                             if not available buf_buyer-in-buyer-group then do:
     1334                                v-grp-name = "".
     1335                                next.
     1336                             end.
     1337                             v-grp-name = buf_buyer-group.name .
     1338                  end.
     1339               end.
     1340               else do:
     1341                    v-grp-name = "".
     1342                    next.
     1343               end.
     1344            end.
     1345            if buf_price-all.tog-id > 0 then do:
     1346               find first buf_turnover-group no-lock where
     1347                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1348                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1349               if available buf_turnover-group then do:
     1350                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1351                     v-cli-oborot = v-cli-oborot-all  .
     1352                     find first buf1_tnv-in-turnover-group no-lock where
     1353                                buf1_tnv-in-turnover-group.stts       =  0     and
     1354                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1355                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1356                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1357                     find first buf2_tnv-in-turnover-group no-lock where
     1358                                buf2_tnv-in-turnover-group.stts       =  0     and
     1359                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1360                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1361                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1362                     if not (available buf1_tnv-in-turnover-group and
     1363                             available buf2_tnv-in-turnover-group ) then do:
     1364                             v-grp-name = "".
     1365                             next .
     1366                     end.
     1367                     v-grp-name = buf_turnover-group.name.
     1368                  end.
     1369               end.
     1370               else do:
     1371                    v-grp-name = "".
     1372                    next.
     1373               end.
     1374            end.
     1375            if buf_price-all.plt-fix-cource-crc-base = true then
     1376               assign
     1377                 v-base-rate  = buf_price-all.pdf-base-rate
     1378                 v-base-scale = buf_price-all.pdf-base-scale
     1379               .
     1380               else
     1381               assign
     1382                 v-base-rate  = v-base-rate0
     1383                 v-base-scale = v-base-scale0
     1384               .
     1385            if buf_price-all.plt-fix-cource-crc-doc = true then
     1386               assign
     1387                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1388                 v-exch-scale = buf_price-all.pdf-exch-scale
     1389               .
     1390               else do:
     1391   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1392   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1393     (input  buf_price-all.curr-code
     1394     ,input  to-day
     1395     ,output v-exch-rate0
     1396     ,output v-exch-scale0
     1397     ,output v-curr-abbr
     1398     )  .
     1399               assign
     1400                 v-exch-rate  = v-exch-rate0
     1401                 v-exch-scale = v-exch-scale0
     1402                 .
     1403              end.
     1404              v-date-1 = date ( "" )  .
     1405              if buf_price-all.fact-order-sys-from > 0 then do:
     1406                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1407                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1408                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1409              end.
     1410              v-date-2 =  date ( "" )  .
     1411              if buf_price-all.fact-order-sys-to > 0 then do:
     1412                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1413                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1414                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1415              end.
     1416              if buf_price-all.qnty-from <> ? then do :
     1417                 if not (
     1418                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1419                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1420                 ) then do:
     1421                        v-interv = "".
     1422                        next.
     1423                 end.
     1424                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1425              end.
     1426              if buf_price-all.sum-from <> ? then do :
     1427                 if not (
     1428                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1429                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1430                 ) then do:
     1431                    v-interv = "".
     1432                    next.
     1433                 end.
     1434                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1435              end.
     1436              if buf_price-all.turnover-from <> ? then do :
     1437                 if not (
     1438                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1439                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1440                 ) then do:
     1441                    v-interv = "".
     1442                    next.
     1443                 end.
     1444                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1445              end.
     1446              if buf_price-all.use-pay-type = 1 then do :
     1447                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1448                    v-pay-name = "" .
     1449                    next.
     1450                  end.
     1451                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1452              end.
     1453              if buf_price-all.use-cash-pay = 1 then do :
     1454                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1455                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1456                   v-pay-name = "" .
     1457                   next.
     1458                 end.
     1459                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1460              end.
     1461             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1462             create tt_price-all .
     1463             buffer-copy buf_price-all to tt_price-all
     1464             assign
     1465               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1466               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1467               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1468               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1469               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1470               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1471               tt_price-all.price-sale     = buf_price-all.price-sale
     1472               tt_price-all.road-tax       = buf_price-all.road-tax
     1473               tt_price-all.excise         = buf_price-all.excise
     1474               tt_price-all.pdf-exch-rate   = v-exch-rate
     1475               tt_price-all.pdf-exch-scale  = v-exch-scale
     1476               tt_price-all.pdf-base-rate   = v-base-rate
     1477               tt_price-all.pdf-base-scale  = v-base-scale
     1478               tt_price-all.grp-name        = v-grp-name
     1479               tt_price-all.date-1          = v-date-1
     1480               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1481               tt_price-all.time-1          = buf_price-all.start-sys-time
     1482               tt_price-all.date-2          = v-date-2
     1483               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1484               tt_price-all.time-2          = buf_price-all.end-sys-time
     1485               tt_price-all.interv-name     = v-interv
     1486               tt_price-all.pay-name        = v-pay-name
     1487               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1488             .
     1489   end.
     1490   define variable vt-plt-id as integer   no-undo .
     1491   define variable vt-plt-db as integer   no-undo .
     1492   define variable vt-pdf-id as integer   no-undo .
     1493   define variable vt-pdf-db as integer   no-undo .
     1494   define buffer neos_price-all for tt_price-all  .
     1495   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1496       if available tt_price-all then do:
     1497        assign
     1498          vt-plt-id = tt_price-all.plt-id
     1499          vt-plt-db = tt_price-all.plt-db-num
     1500          vt-pdf-id = tt_price-all.pdf-id
     1501          vt-pdf-db = tt_price-all.pdf-db
     1502        .
     1503        if tt_price-all.b-code = p-b-code then do:
     1504             assign
     1505               p-plt-id           = tt_price-all.plt-id
     1506               p-plt-db-num       = tt_price-all.plt-db-num
     1507               p-pdf-id           = tt_price-all.pdf-id
     1508               p-pdf-db-num       = tt_price-all.pdf-db
     1509               p-sale-price-base  = tt_price-all.price-sale-base
     1510               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1511               p-road-tax-base    = tt_price-all.road-tax-base
     1512               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1513               p-excise-base      = tt_price-all.excise-base
     1514               p-excise-rubl      = tt_price-all.excise-rubl
     1515               .
     1516        end.
     1517        else do:
     1518          find first neos_price-all where
     1519                     neos_price-all.b-code     = p-b-code  and
     1520                     neos_price-all.plt-id     = vt-plt-id and
     1521                     neos_price-all.plt-db-num = vt-plt-db and
     1522                     neos_price-all.pdf-id     = vt-pdf-id and
     1523                     neos_price-all.pdf-db     = vt-pdf-db
     1524                     use-index pi no-error .
     1525            if available neos_price-all then do:
     1526             assign
     1527               p-plt-id           = tt_price-all.plt-id
     1528               p-plt-db-num       = tt_price-all.plt-db-num
     1529               p-pdf-id           = tt_price-all.pdf-id
     1530               p-pdf-db-num       = tt_price-all.pdf-db
     1531               p-sale-price-base  = neos_price-all.price-sale-base
     1532               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1533               p-road-tax-base    = neos_price-all.road-tax-base
     1534               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1535               p-excise-base      = neos_price-all.excise-base
     1536               p-excise-rubl      = neos_price-all.excise-rubl
     1537               .
     1538            end.
     1539            else do:
     1540                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1541                 if error-status :error    then do:
     1542                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1543                   return error return-value .
     1544                 end.
     1545             assign
     1546               p-plt-id           = tt_price-all.plt-id
     1547               p-plt-db-num       = tt_price-all.plt-db-num
     1548               p-pdf-id           = tt_price-all.pdf-id
     1549               p-pdf-db-num       = tt_price-all.pdf-db
     1550               p-sale-price-base  = tt_price-all.price-sale-base
     1551               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1552               p-road-tax-base    = tt_price-all.road-tax-base
     1553               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1554               p-excise-base      = tt_price-all.excise-base
     1555               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1556               .
     1557            end.
     1558        end.
     1559     end.
     1560   end.
     1561   end procedure.
     1562   procedure mpl-tpl-auto :
     1563   define input  parameter p-b-code     as integer   no-undo .
     1564   define input  parameter p-obj-type   as character no-undo .
     1565   define input  parameter p-obj-code   as integer   no-undo .
     1566   define input  parameter p-plt-id     as integer   no-undo .
     1567   define input  parameter p-plt-db-num as integer   no-undo .
     1568   define input  parameter p-fact-order as decimal   no-undo .
     1569   define output parameter p-sale-price as decimal   no-undo .
     1570   define output parameter p-pdf-id     as integer   no-undo .
     1571   define output parameter p-pdf-db-num as integer   no-undo .
     1572     do
     1573     on error undo, return error return-value
     1574     :
     1575   if p-fact-order = ? then do:
     1576     run fact-order-mpl (
     1577         input   today       ,
     1578         input   p-obj-type  ,
     1579         input   p-obj-code  ,
     1580         output  p-fact-order ) .
     1581   end.
     1582   assign
     1583     p-pdf-id      = ?
     1584     p-pdf-db-num  = ?
     1585     p-sale-price  = ?
     1586   .
     1587   define buffer buf_bar-code for ub.bar-code  .
     1588   define buffer buf_goods for ub.goods  .
     1589   find first buf_bar-code no-lock where
     1590              buf_bar-code.b-code = p-b-code
     1591              no-error .
     1592   if error-status :error then return error return-value .
     1593   find first buf_goods no-lock where
     1594              buf_goods.gds-code = buf_bar-code.gds-code
     1595              no-error .
     1596   if error-status :error then return error return-value .
     1597   define variable v-main-b-code as integer   no-undo .
     1598   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1599     (input  buf_goods.gds-code
     1600     ,input  ?
     1601     ,output v-main-b-code
     1602     )  .
     1603   define buffer buf_price-all for ub.price-all  .
     1604   for each tt_price-all : delete tt_price-all. end.
     1605       for each buf_price-all no-lock where
     1606               buf_price-all.plt-id     = p-plt-id                 and
     1607               buf_price-all.plt-db-num = p-plt-db-num             and
     1608               buf_price-all.obj-type   = p-obj-type               and
     1609               buf_price-all.obj-code   = p-obj-code               and
     1610               buf_price-all.gds-code   = buf_goods.gds-code       and
     1611             ( buf_price-all.b-code = v-main-b-code or
     1612               buf_price-all.b-code = p-b-code)    and
     1613               buf_price-all.status_    = 'акт':U         and
     1614               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1615             ( buf_price-all.fact-order-sys-to = ? or
     1616               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1617               :
     1618                 create tt_price-all .
     1619                 buffer-copy buf_price-all to tt_price-all
     1620                 assign
     1621                   tt_price-all.price-sale  = buf_price-all.price-sale
     1622                 .
     1623       end.
     1624   define variable vt-plt-id as integer   no-undo .
     1625   define variable vt-plt-db as integer   no-undo .
     1626   define variable vt-pdf-id as integer   no-undo .
     1627   define variable vt-pdf-db as integer   no-undo .
     1628   define buffer neos_price-all for tt_price-all  .
     1629   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1630       if available tt_price-all then do:
     1631        assign
     1632          vt-plt-id = tt_price-all.plt-id
     1633          vt-plt-db = tt_price-all.plt-db-num
     1634          vt-pdf-id = tt_price-all.pdf-id
     1635          vt-pdf-db = tt_price-all.pdf-db
     1636        .
     1637        if tt_price-all.b-code = p-b-code then do:
     1638             assign
     1639               p-plt-id           = tt_price-all.plt-id
     1640               p-plt-db-num       = tt_price-all.plt-db-num
     1641               p-pdf-id           = tt_price-all.pdf-id
     1642               p-pdf-db-num       = tt_price-all.pdf-db
     1643               p-sale-price       = tt_price-all.price-sale
     1644               .
     1645        end.
     1646        else do:
     1647          find first neos_price-all where
     1648                     neos_price-all.b-code     = p-b-code  and
     1649                     neos_price-all.plt-id     = vt-plt-id and
     1650                     neos_price-all.plt-db-num = vt-plt-db and
     1651                     neos_price-all.pdf-id     = vt-pdf-id and
     1652                     neos_price-all.pdf-db     = vt-pdf-db
     1653                     use-index pi no-error .
     1654            if available neos_price-all then do:
     1655             assign
     1656               p-plt-id           = tt_price-all.plt-id
     1657               p-plt-db-num       = tt_price-all.plt-db-num
     1658               p-pdf-id           = tt_price-all.pdf-id
     1659               p-pdf-db-num       = tt_price-all.pdf-db
     1660               p-sale-price       = neos_price-all.price-sale
     1661               .
     1662            end.
     1663            else do:
     1664           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1665           if error-status :error    then do:
     1666              message "Не найден бар-код" p-b-code view-as alert-box error .
     1667              return error return-value .
     1668           end.
     1669             assign
     1670               p-plt-id           = tt_price-all.plt-id
     1671               p-plt-db-num       = tt_price-all.plt-db-num
     1672               p-pdf-id           = tt_price-all.pdf-id
     1673               p-pdf-db-num       = tt_price-all.pdf-db
     1674               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1675               .
     1676            end.
     1677        end.
     1678     end.
     1679     end.
     1680   end procedure.
     1681   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   procedure wthcattr-sprcli :
     1684   define input parameter parparentproc  as widget-handle no-undo.
     1685   define input parameter p-mode  as character no-undo.
     1686   define input-output parameter p-value as character no-undo .
     1687   define output parameter p-setted as logical no-undo .
     1688     DEFINE VARIABLE v-value as character no-undo .
     1689     define variable v-cli-type as character no-undo .
     1690     define variable v-cli-code as integer no-undo .
     1691     define buffer buf_clients   for ub.clients.
     1692     define variable v_rid as character no-undo.
     1693     define variable ref-rec as recid no-undo .
     1694     do
     1695     on error undo, return error
     1696     :
     1697         v-value = p-value.
     1698      if p-value <> '':U then do:
     1699       assign
     1700       v-cli-type = substring(p-value, 1, 3)
     1701       v-cli-code = integer(substring(p-value, 4))
     1702       no-error.
     1703       if error-status:error then do:
     1704         assign
     1705         v-cli-type = '':U
     1706         v-cli-code = 0
     1707         .
     1708       end.
     1709      end.
     1710      FIND FIRST buf_clients NO-LOCK WHERE
     1711               buf_clients.obj-type = v-cli-type AND
     1712               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1713      IF available(buf_clients) then do:
     1714       run ref/cli-all.w (
     1715                   input parparentproc
     1716                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1717                  ,input v-cli-type
     1718                  ,input 'все':U
     1719                  ,input 'все':U
     1720                  ,input RECID( buf_clients )
     1721                  ,input ",,,,,,NO"
     1722                  ,input ?
     1723                  ,OUTPUT v_rid ).
     1724     END.
     1725     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1726       run ref/cli-all.w (
     1727                    input parparentproc
     1728                   ,INPUT "b-sel":U
     1729                  ,input  v-cli-type
     1730                  ,input 'все':U
     1731                  ,input 'текущие':U
     1732                  ,input ?
     1733                  ,input ",,,,,,NO"
     1734                  ,input ?
     1735                  ,OUTPUT v_rid ).
     1736     END.
     1737     else do:
     1738       message
     1739       if p-value = "":U then 'Атрибут не задан!'
     1740       else substitute('Не найден клиент &1',p-value)
     1741       view-as alert-box warning.
     1742     end.
     1743     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1744       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1745       IF ERROR-STATUS:ERROR THEN DO:
     1746           RETURN NO-APPLY.
     1747       END.
     1748       FIND FIRST buf_clients NO-LOCK WHERE
     1749                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1750       IF AVAIL buf_clients THEN DO:
     1751         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1752       end.
     1753     end.
     1754     if v-value <> p-value then do:
     1755       p-value = v-value.
     1756       p-setted = yes.
     1757     end.
     1758     end.
     1759   end procedure.
     1760     define new global shared variable g#wthcalib as handle no-undo.
     1761   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1762   define variable v-tth as handle no-undo .
     1763   assign
     1764   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1765   def temp-table tt-wthlib-parts no-undo like ub.wth-parts.
     1766   Procedure wth-doc-close:
     1767       define input parameter p-rec        as recid     no-undo .
     1768       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1769     do
     1770     on error undo, return error return-value
     1771     :
     1772       find first cur-wth-parts where recid(cur-wth-parts) = p-rec exclusive-lock no-wait no-error.
     1773       if not available cur-wth-parts then return error substitute("Не найдена партия").
     1774       CASE cur-wth-parts.ext-doc-type:
     1775           WHEN 'ie':U or when 'rf':U or when 'ff':U
     1776           OR WHEN 'fj':U
     1777           THEN DO:
     1778              RUN wth-parts-close(BUFFER cur-wth-parts, 'free-zone':U ).
     1779           END.
     1780           WHEN 'ee':U THEN DO:
     1781               RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1782           END.
     1783           WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'rp':U
     1784             OR WHEN 'ip':U OR WHEN 'pc':U
     1785             OR WHEN 'pj':U
     1786              THEN DO:
     1787               RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1788           END.
     1789           WHEN 'df':U OR WHEN 'dp':U OR WHEN 'dc':U THEN DO:
     1790             RUN wth-parts-close(BUFFER cur-wth-parts, 'out-zone':U ).
     1791           end.
     1792           when 'ep':U or when 'ef':U
     1793           OR WHEN 'oj':U or when 'jj':U
     1794           then .
     1795           when 'xc':U then do:
     1796             if cur-wth-parts.type = 'при':U then
     1797                  RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1798             else RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1799           end.
     1800           OTHERWISE DO:
     1801               RETURN ERROR substitute("Неверный вызов процедуры закрытия: расш. тип = &1"
     1802                                    , cur-wth-parts.ext-doc-type
     1803                                       ).
     1804           END.
     1805       END CASE.
     1806       RELEASE cur-wth-parts.
     1807       END.
     1808   END.
     1809   PROCEDURE wth-parts-close:
     1810       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1811       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1812       define variable v-rec as recid.
     1813       if bfrom_wth-parts.stts  = 1 then return.
     1814          run str/wthpartp.p  ( INPUT     'ДОБАВЛЕНИЕ':U,
     1815                     INPUT     bfrom_wth-parts.obj-type,
     1816                     INPUT     bfrom_wth-parts.obj-code,
     1817                     INPUT     bfrom_wth-parts.w-p-code,
     1818                     INPUT     bfrom_wth-parts.wth-code,
     1819                     INPUT     bfrom_wth-parts.par-code,
     1820                     INPUT     bfrom_wth-parts.in-code ,
     1821                     INPUT     p-zone,
     1822                     INPUT     bfrom_wth-parts.ser-code,
     1823                     INPUT     bfrom_wth-parts.db-num  ,
     1824                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1825                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     1826                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1827                     INPUT     bfrom_wth-parts.fact-rangeTo ,
     1828                     INPUT     bfrom_wth-parts.host-code     ,
     1829                     INPUT     bfrom_wth-parts.contract-code               ,
     1830                     INPUT     bfrom_wth-parts.price-rubl    ,
     1831                     INPUT     bfrom_wth-parts.price-base    ,
     1832                     INPUT     bfrom_wth-parts.supp-type,
     1833                     INPUT     bfrom_wth-parts.supp-code,
     1834                     INPUT     bfrom_wth-parts.in-obj-type      ,
     1835                     INPUT     bfrom_wth-parts.in-obj-code      ,
     1836                     INPUT     bfrom_wth-parts.ext-doc-type,
     1837                     INPUT     bfrom_wth-parts.gds-code,
     1838                     INPUT     bfrom_wth-parts.stts               ,
     1839                     INPUT     bfrom_wth-parts.beg-dt        ,
     1840                     INPUT     bfrom_wth-parts.end-dt        ,
     1841                     INPUT     bfrom_wth-parts.vat-pc        ,
     1842                     INPUT     bfrom_wth-parts.cli-code,
     1843                     INPUT     bfrom_wth-parts.cli-type,
     1844                     INPUT     bfrom_wth-parts.out-obj-code,
     1845                     INPUT     bfrom_wth-parts.out-obj-type,
     1846                     INPUT     bfrom_wth-parts.sale-obj-code,
     1847                     INPUT     bfrom_wth-parts.sale-obj-type,
     1848                     INPUT     bfrom_wth-parts.out-code ,
     1849                     INPUT  yes,
     1850                     INPUT     '':U ,
     1851                     INPUT-OUTPUT v-rec
     1852                     ) no-error.
     1853       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     1854   END.
     1855   Procedure wth-doc-razrez:
     1856       define input parameter p-rec as recid NO-UNDO.
     1857       define input parameter p-doc-del AS log NO-UNDO.
     1858       define variable v-mess AS CHAR NO-UNDO.
     1859       define variable p-silent AS LOG INIT NO NO-UNDO.
     1860       DEFINE BUFFER b-wth-parts FOR ub.wth-parts.
     1861       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1862       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1863     do
     1864     on error undo, return error return-value
     1865     :
     1866       FIND FIRST cur-wth-parts WHERE recid(cur-wth-parts) = p-rec
     1867                                 EXCLUSIVE-LOCK .
     1868       IF AVAILABLE cur-wth-parts THEN DO:
     1869           CASE cur-wth-parts.ext-doc-type:
     1870               WHEN 'ie':U or when 'ip':U or when 'rp':U
     1871               or when 'ff':U or when 'rf':U
     1872               or when 'fj':U or when 'pj':U
     1873               THEN DO:
     1874                   RUN wth-parts-raz(BUFFER cur-wth-parts, "":U,p-doc-del) .
     1875               END.
     1876               WHEN 'ee':U or when 'ef':U or when 'jj':U
     1877               THEN DO:
     1878                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del) .
     1879               END.
     1880               WHEN 'ep':U or when 'oj':U THEN DO:
     1881                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del) .
     1882               END.
     1883               WHEN 'pc':U THEN DO:
     1884                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1885               END.
     1886               WHEN 'dp':U THEN DO:
     1887                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del)  .
     1888               END.
     1889               WHEN 'df':U THEN DO:
     1890                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del)  .
     1891               END.
     1892               WHEN 'dc':U THEN DO:
     1893                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1894               END.
     1895               WHEN 'ps':U OR WHEN 'pz':U THEN DO:
     1896                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del).
     1897               END.
     1898               when 'xc':U then do:
     1899                 if cur-wth-parts.type = 'при':U then
     1900                      RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del ).
     1901                 else RUN wth-parts-raz(BUFFER cur-wth-parts,  'free-zone':U ,p-doc-del).
     1902               end.
     1903               OTHERWISE DO:
     1904                   RETURN ERROR substitute("Неверный вызов процедуры разрезервирования: расш. тип =  :&1&2&3"
     1905                                        , cur-wth-parts.ext-doc-type
     1906                                        , error-status:get-message(1)
     1907                                        , return-value
     1908                                        ).
     1909               END.
     1910           END CASE.
     1911       END.
     1912     END.
     1913   END.
     1914   PROCEDURE wth-parts-raz:
     1915       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1916       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1917       DEFINE INPUT PARAMETER p-doc-del AS log NO-UNDO.
     1918       define variable v-mes as char no-undo.
     1919       define variable v-rec as recid no-undo.
     1920       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1921     do
     1922     on error undo, return error return-value
     1923     :
     1924       v-mes = substitute('Код серии: &1-&2 Диапазон &3-&4'
     1925                                      ,bfrom_wth-parts.ser-code
     1926                                      ,bfrom_wth-parts.db-num
     1927                                      ,bfrom_wth-parts.doc-rangeFrom
     1928                                      ,bfrom_wth-parts.doc-rangeTo).
     1929       IF lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN DO:
     1930           RETURN ERROR substitute("Нельзя удалять партии МЦ из зоны :&1&2&3&4&5"
     1931                                , error-status:get-message(1)
     1932                                , bfrom_wth-parts.out-code
     1933                                , return-value
     1934                                ,chr(10)
     1935                                ,v-mes
     1936                                ).
     1937       END.
     1938       v-rec = recid(bfrom_wth-parts).
     1939       CASE bfrom_wth-parts.ext-doc-type:
     1940           WHEN 'ie':U  or when 'fj':U or when  'pj':U THEN DO:
     1941               delete bfrom_wth-parts NO-ERROR.
     1942               if error-status:error then do:
     1943                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1944                                      , error-status:get-message(1)
     1945                                      , chr(10)
     1946                                      , return-value
     1947                                      ,v-mes
     1948                                      ).
     1949               END.
     1950           END.
     1951           when 'rp':U or when 'rf':U then do:
     1952             if p-doc-del then do:
     1953               delete bfrom_wth-parts NO-ERROR.
     1954               if error-status:error then do:
     1955                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1956                                      , error-status:get-message(1)
     1957                                      , chr(10)
     1958                                      , return-value
     1959                                      ,v-mes
     1960                                      ).
     1961               END.
     1962             end.
     1963             else   RETURN ERROR 'Нельзя удалять партии документа внутреннего возврата.'  .
     1964           end.
     1965           when 'ip':U or when 'ff':U then do:
     1966             if p-doc-del then do:
     1967               delete bfrom_wth-parts NO-ERROR.
     1968               if error-status:error then do:
     1969                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1970                                      , error-status:get-message(1)
     1971                                      , chr(10)
     1972                                      , return-value
     1973                                      ,v-mes
     1974                                      ).
     1975               END.
     1976             end.
     1977             else do:
     1978               run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     1979                     INPUT     bfrom_wth-parts.obj-type,
     1980                     INPUT     bfrom_wth-parts.obj-code,
     1981                     INPUT     bfrom_wth-parts.w-p-code,
     1982                     INPUT     bfrom_wth-parts.wth-code,
     1983                     INPUT     bfrom_wth-parts.par-code,
     1984                     INPUT     bfrom_wth-parts.in-code ,
     1985                     INPUT     bfrom_wth-parts.out-code,
     1986                     INPUT     bfrom_wth-parts.ser-code,
     1987                     INPUT     bfrom_wth-parts.db-num  ,
     1988                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1989                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     1990                     INPUT     bfrom_wth-parts.doc-RangeFrom ,
     1991                     INPUT     bfrom_wth-parts.doc-rangeTo  ,
     1992                     INPUT     bfrom_wth-parts.host-code     ,
     1993                     INPUT     bfrom_wth-parts.contract-code ,
     1994                     INPUT     bfrom_wth-parts.price-rubl    ,
     1995                     INPUT     bfrom_wth-parts.price-base    ,
     1996                     INPUT     bfrom_wth-parts.supp-type,
     1997                     INPUT     bfrom_wth-parts.supp-code,
     1998                     INPUT     bfrom_wth-parts.in-obj-type      ,
     1999                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2000                     INPUT     bfrom_wth-parts.ext-doc-type,
     2001                     INPUT     bfrom_wth-parts.gds-code,
     2002                     INPUT     1            ,
     2003                     INPUT     bfrom_wth-parts.beg-dt        ,
     2004                     INPUT     bfrom_wth-parts.end-dt        ,
     2005                     INPUT     bfrom_wth-parts.vat-pc        ,
     2006                     INPUT     bfrom_wth-parts.cli-code,
     2007                     INPUT     bfrom_wth-parts.cli-type,
     2008                     INPUT     bfrom_wth-parts.out-obj-code,
     2009                     INPUT     bfrom_wth-parts.out-obj-type,
     2010                     INPUT     bfrom_wth-parts.sale-obj-code,
     2011                     INPUT     bfrom_wth-parts.sale-obj-type,
     2012                     INPUT     bfrom_wth-parts.doc-code ,
     2013                     INPUT  yes,
     2014                     INPUT     bfrom_wth-parts.type ,
     2015                     INPUT-OUTPUT v-rec
     2016                     ) no-error.
     2017                if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2018             end.
     2019           end.
     2020           OTHERWISE DO:
     2021            run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2022                     INPUT     bfrom_wth-parts.obj-type,
     2023                     INPUT     bfrom_wth-parts.obj-code,
     2024                     INPUT     bfrom_wth-parts.w-p-code,
     2025                     INPUT     bfrom_wth-parts.wth-code,
     2026                     INPUT     bfrom_wth-parts.par-code,
     2027                     INPUT     bfrom_wth-parts.in-code ,
     2028                     INPUT     p-zone,
     2029                     INPUT     bfrom_wth-parts.ser-code,
     2030                     INPUT     bfrom_wth-parts.db-num  ,
     2031                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2032                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2033                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2034                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2035                     INPUT     bfrom_wth-parts.host-code     ,
     2036                     INPUT     bfrom_wth-parts.contract-code ,
     2037                     INPUT     bfrom_wth-parts.price-rubl    ,
     2038                     INPUT     bfrom_wth-parts.price-base    ,
     2039                     INPUT     bfrom_wth-parts.supp-type,
     2040                     INPUT     bfrom_wth-parts.supp-code,
     2041                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2042                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2043                     INPUT     bfrom_wth-parts.ext-doc-type,
     2044                     INPUT     bfrom_wth-parts.gds-code,
     2045                     INPUT     bfrom_wth-parts.stts             ,
     2046                     INPUT     bfrom_wth-parts.beg-dt        ,
     2047                     INPUT     bfrom_wth-parts.end-dt        ,
     2048                     INPUT     bfrom_wth-parts.vat-pc        ,
     2049                     INPUT     bfrom_wth-parts.cli-code,
     2050                     INPUT     bfrom_wth-parts.cli-type,
     2051                     INPUT     bfrom_wth-parts.out-obj-code,
     2052                     INPUT     bfrom_wth-parts.out-obj-type,
     2053                     INPUT     bfrom_wth-parts.sale-obj-code,
     2054                     INPUT     bfrom_wth-parts.sale-obj-type,
     2055                     INPUT     bfrom_wth-parts.doc-code ,
     2056                     INPUT  yes,
     2057                     INPUT      "":U ,
     2058                     INPUT-OUTPUT v-rec
     2059                     ) no-error.
     2060       if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2061           END.
     2062       END CASE.
     2063     END.
     2064   END.
     2065   procedure wth-parts-rezerv:
     2066       define input parameter        p-param            as logical no-undo.
     2067       define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2068       define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2069       define input parameter        p-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2070       define input parameter        p-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2071       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2072       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2073       define input parameter        p-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2074       define input parameter        p-price-base       LIKE ub.wth-parts.price-base no-undo .
     2075       define input parameter        p-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2076       define input parameter        p-host-code        LIKE ub.wth-parts.host-code no-undo .
     2077       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2078       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2079       define input parameter        p-w-p-code         LIKE ub.wth-parts.w-p-code no-undo .
     2080       define input parameter        p-wth-code         LIKE ub.wth-parts.wth-code no-undo .
     2081       define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2082       define input parameter        p-in-code          LIKE ub.wth-parts.in-code no-undo .
     2083       define input parameter        p-doc-code         LIKE ub.wth-parts.out-code no-undo .
     2084       define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2085       define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2086       define input parameter        p-ext-doc-type     LIKE ub.wth-parts.ext-doc-type no-undo .
     2087       define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2088       define input parameter        p-type             LIKE ub.wth-parts.type no-undo .
     2089       define input-output parameter p-rec        as recid     no-undo .
     2090     define buffer bfrom_wth-parts   for ub.wth-parts.
     2091     define buffer bufr_wth-doc      for ub.wth-doc.
     2092     define variable v-rec    as recid        no-undo.
     2093     define variable v-recDop as recid        no-undo.
     2094     define variable v-zone   as character    no-undo.
     2095     DEFINE variable v-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2096     define VARIABLE v-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2097     define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2098     define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     2099     define variable v-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2100     define variable v-mpl-date         as date      no-undo.
     2101     empty temp-table tt-wthlib-parts.
     2102   main-block:
     2103   do  transaction
     2104   on error  undo main-block, return error return-value + chr(32) + error-status:get-message(1)
     2105   on stop   undo main-block, return error
     2106   on endkey undo main-block, return error
     2107   :
     2108   FIND FIRST bufr_wth-doc WHERE bufr_wth-doc.doc-code = p-doc-code NO-LOCK NO-ERROR.
     2109   IF NOT AVAILABLE bufr_wth-doc THEN RETURN ERROR SUBSTITUTE('Не найден документ МЦ с номером &1',p-doc-code).
     2110     if lookup(p-ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0
     2111           then do:
     2112        run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     2113                     INPUT  p-obj-type,
     2114                     INPUT  p-obj-code,
     2115                     INPUT  p-w-p-code,
     2116                     INPUT  p-wth-code,
     2117                     INPUT  p-par-code,
     2118                     INPUT  p-in-code,
     2119                     INPUT  p-doc-code,
     2120                     INPUT  p-ser-code,
     2121                     INPUT  p-db-num  ,
     2122                     INPUT  p-Fact-RangeFrom ,
     2123                     INPUT  p-fact-rangeTo  ,
     2124                     INPUT  p-Fact-RangeFrom ,
     2125                     INPUT  p-fact-rangeTo ,
     2126                     INPUT  p-host-code     ,
     2127                     INPUT  0   ,
     2128                     INPUT  p-price-rubl    ,
     2129                     INPUT  p-price-base    ,
     2130                     INPUT  '':U,
     2131                     INPUT  0,
     2132                     INPUT  p-obj-type      ,
     2133                     INPUT  p-obj-code      ,
     2134                     INPUT  p-ext-doc-type,
     2135                     INPUT  p-gds-code,
     2136                     INPUT  0           ,
     2137                     INPUT  p-beg-dt        ,
     2138                     INPUT  p-end-dt        ,
     2139                     INPUT  p-vat-pc      ,
     2140                     INPUT  0,
     2141                     INPUT  '':U,
     2142                     INPUT  0,
     2143                     INPUT  '':U,
     2144                     INPUT  0,
     2145                     INPUT  '':U,
     2146                     INPUT  p-doc-code,
     2147                     INPUT  yes,
     2148                     INPUT p-type,
     2149                     INPUT-OUTPUT p-rec
     2150                     ) no-error.
     2151                   if error-status:error then undo main-block, return error return-value + error-status:get-message(1) .
     2152     end.
     2153     else do:
     2154       if p-rec <> ? then do:
     2155         find first bfrom_wth-parts exclusive-lock where
     2156                   recid(bfrom_wth-parts) = p-rec no-error.
     2157         if  available bfrom_wth-parts
     2158           and bfrom_wth-parts.wth-code = p-wth-code
     2159           and bfrom_wth-parts.par-code = p-par-code
     2160           and bfrom_wth-parts.ser-code = p-ser-code
     2161           and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0
     2162         then.
     2163         else if  available bfrom_wth-parts and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2164         then return error substitute('Резервирование из партии (Код серии: &1-&2 Диапазон &3-&4) невозможно, т.к. партия уже входит в состав документа'
     2165                                      ,bfrom_wth-parts.ser-code
     2166                                      ,bfrom_wth-parts.db-num
     2167                                      ,bfrom_wth-parts.doc-rangeFrom
     2168                                      ,bfrom_wth-parts.doc-rangeTo).
     2169         else if  available bfrom_wth-parts then undo, return error 'Партия указанная для резервирования не соответсвует указанным параметрам!'.
     2170         if available bfrom_wth-parts
     2171            and bfrom_wth-parts.doc-rangeFrom > p-fact-rangeFrom
     2172            or bfrom_wth-parts.doc-rangeTo   < p-fact-rangeTo
     2173         then undo, return error substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.&1Диапазон резервирования &4-&5'
     2174                                            ,chr(10)
     2175                                            ,bfrom_wth-parts.doc-rangeFrom
     2176                                            ,bfrom_wth-parts.doc-rangeTo
     2177                                            ,p-fact-rangeFrom
     2178                                            ,p-fact-rangeTo).
     2179       end.
     2180       else do:
     2181         if p-ext-doc-type = 'pz':U or (p-ext-doc-type = 'xc':U and p-type = 'при':U )then do:
     2182           for first bfrom_wth-parts no-lock where
     2183                                     bfrom_wth-parts.wth-code = p-wth-code
     2184                                 and bfrom_wth-parts.par-code = p-par-code
     2185                                 and bfrom_wth-parts.ser-code = p-ser-code
     2186                                 and bfrom_wth-parts.db-num = p-db-num
     2187                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2188                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2189                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2190                                 and bfrom_wth-parts.stts = 0
     2191                                 and bfrom_wth-parts.cli-code = p-cli-code
     2192                                 and bfrom_wth-parts.cli-type = p-cli-type
     2193                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2194                                 use-index  wth-idnt:
     2195                                 p-rec = recid(bfrom_wth-parts).
     2196            end.
     2197           If p-rec = ? and p-in-code > '' then do:
     2198              for first bfrom_wth-parts no-lock where
     2199                                     bfrom_wth-parts.wth-code = p-wth-code
     2200                                 and bfrom_wth-parts.par-code = p-par-code
     2201                                 and bfrom_wth-parts.ser-code = p-ser-code
     2202                                 and bfrom_wth-parts.db-num = p-db-num
     2203                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2204                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2205                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2206                                 and bfrom_wth-parts.stts = 0
     2207                                 and bfrom_wth-parts.cli-code = p-cli-code
     2208                                 and bfrom_wth-parts.cli-type = p-cli-type
     2209                                 use-index  wth-idnt:
     2210                                 p-rec = recid(bfrom_wth-parts).
     2211                 end.
     2212           end.
     2213                 if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2214                   recid(bfrom_wth-parts) = p-rec no-error.
     2215         end.
     2216         else if p-ext-doc-type = 'pc':U or p-ext-doc-type = 'ps':U or p-ext-doc-type = 'dc':U then do:
     2217           for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2218                                 and bfrom_wth-parts.par-code = p-par-code
     2219                                 and bfrom_wth-parts.ser-code = p-ser-code
     2220                                 and bfrom_wth-parts.db-num = p-db-num
     2221                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2222                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2223                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2224                                 and bfrom_wth-parts.stts = 0
     2225                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2226                                 use-index wth-idnt:
     2227                                 p-rec = recid(bfrom_wth-parts).
     2228            end.
     2229           If p-rec = ? and p-in-code > '' then do:
     2230            for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2231                                 and bfrom_wth-parts.par-code = p-par-code
     2232                                 and bfrom_wth-parts.ser-code = p-ser-code
     2233                                 and bfrom_wth-parts.db-num = p-db-num
     2234                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2235                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2236                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2237                                 and bfrom_wth-parts.stts = 0
     2238                                 :
     2239                                 p-rec = recid(bfrom_wth-parts).
     2240            end.
     2241           end.
     2242           if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2243                   recid(bfrom_wth-parts) = p-rec no-error.
     2244         end.
     2245         else do:
     2246           CASE p-ext-doc-type:
     2247                   WHEN 'ee':U or when 'xc':U or WHEN 'ef':U
     2248                   or when 'jj':U THEN DO:
     2249                       v-zone = 'free-zone':U.
     2250                   END.
     2251                   WHEN 'ep':U or when 'oj':U THEN DO:
     2252                       v-zone = 'put-zone':U.
     2253                   END.
     2254                   WHEN 'df':U THEN DO:
     2255                       v-zone = 'free-zone':U.
     2256                   END.
     2257                   WHEN 'dp':U  THEN DO:
     2258                       v-zone = 'put-zone':U.
     2259                   END.
     2260                   WHEN 'pc':U OR WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     2261                       v-zone = 'cli-zone':U.
     2262                   END.
     2263                   OTHERWISE DO:
     2264                       RETURN ERROR substitute("Неверный вызов процедуры резервирования: расш. тип = &1"
     2265                                            , p-ext-doc-type
     2266                                               ).
     2267                   END.
     2268           END CASE.
     2269           find first bfrom_wth-parts no-lock where
     2270                                     bfrom_wth-parts.wth-code = p-wth-code
     2271                                 and bfrom_wth-parts.obj-code = p-obj-code
     2272                                 and bfrom_wth-parts.obj-type = p-obj-type
     2273                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2274                                 and bfrom_wth-parts.par-code = p-par-code
     2275                                 and bfrom_wth-parts.ser-code = p-ser-code
     2276                                 and bfrom_wth-parts.db-num = p-db-num
     2277                                 and bfrom_wth-parts.out-code = v-zone
     2278                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2279                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2280                                 and bfrom_wth-parts.stts = 0
     2281                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2282                                 no-error.
     2283          If not available bfrom_wth-parts and p-in-code > '' then do:
     2284                  find first bfrom_wth-parts no-lock where
     2285                                     bfrom_wth-parts.wth-code = p-wth-code
     2286                                 and bfrom_wth-parts.obj-code = p-obj-code
     2287                                 and bfrom_wth-parts.obj-type = p-obj-type
     2288                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2289                                 and bfrom_wth-parts.par-code = p-par-code
     2290                                 and bfrom_wth-parts.ser-code = p-ser-code
     2291                                 and bfrom_wth-parts.db-num = p-db-num
     2292                                 and bfrom_wth-parts.out-code = v-zone
     2293                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2294                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2295                                 and bfrom_wth-parts.stts = 0
     2296                                 no-error.
     2297          end.
     2298         end.
     2299       end.
     2300       if not available bfrom_wth-parts then do:
     2301            if g#news then do:
     2302             return error 'forged':U.
     2303            end.
     2304            else
     2305             undo, return error substitute("Не найдена партия МЦ для резервирования &1Код МЦ &2&1Код номинала &3&1Код серии &4&1Диапазон с &5 по &6&1
     2306                                           ",chr(10),p-wth-code,p-par-code,p-ser-code,p-fact-rangeFrom,
     2307                                           p-fact-rangeTo).
     2308       end.
     2309       p-rec = recid(bfrom_wth-parts).
     2310       find current bfrom_wth-parts exclusive-lock.
     2311       create tt-wthlib-parts.
     2312       buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2313           ASSIGN v-beg-dt = if p-param then p-beg-dt else bfrom_wth-parts.beg-dt
     2314                  v-end-dt = if p-param then p-end-dt else bfrom_wth-parts.end-dt
     2315                  v-vat-pc = if p-param then p-vat-pc else bfrom_wth-parts.vat-pc
     2316                  v-price-rubl = if p-param then p-price-rubl else bfrom_wth-parts.price-rubl
     2317                  v-price-base = if p-param then p-price-base else bfrom_wth-parts.price-base  .
     2318       IF  not g#news and (p-ext-doc-type = 'ee':U or p-ext-doc-type = 'xc':U)  THEN DO:
     2319           IF v-beg-dt = ? AND v-end-dt = ? THEN DO:
     2320               RUN init_prtdate ( INPUT p-obj-type
     2321                                                 ,INPUT p-obj-code
     2322                                                 ,INPUT p-ser-code
     2323                                                 ,INPUT p-db-num
     2324                                                 ,INPUT bufr_wth-doc.doc-date
     2325                                                 ,OUTPUT v-beg-dt
     2326                                                 ,OUTPUT v-end-dt ) NO-ERROR.
     2327               if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2328           END.
     2329           IF v-price-rubl = 0 AND v-price-base = 0 THEN DO:
     2330             run set-wthmpl-date ( bufr_wth-doc.doc-code
     2331                                ,bufr_wth-doc.doc-date
     2332                                , v-beg-dt
     2333                                , output v-mpl-date) no-error.
     2334               RUN INIT_prtprice (
     2335                             p-host-code
     2336                           , p-obj-type
     2337                           , p-obj-code
     2338                           , p-cli-type
     2339                           , p-cli-code
     2340                           , p-wth-code
     2341                           , p-gds-code
     2342                           , p-par-code
     2343                           , v-mpl-date
     2344                           , OUTPUT  v-vat-pc
     2345                           , OUTPUT  v-price-rubl
     2346                           , OUTPUT  v-price-base
     2347                   ) NO-ERROR.
     2348             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2349           END.
     2350       END.
     2351         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2352                     INPUT     p-obj-type,
     2353                     INPUT     p-obj-code,
     2354                     INPUT     p-w-p-code,
     2355                     INPUT     bfrom_wth-parts.wth-code,
     2356                     INPUT     bfrom_wth-parts.par-code,
     2357                     INPUT     bfrom_wth-parts.in-code ,
     2358                     INPUT     p-doc-code,
     2359                     INPUT     bfrom_wth-parts.ser-code,
     2360                     INPUT     bfrom_wth-parts.db-num  ,
     2361                     INPUT     p-Fact-RangeFrom ,
     2362                     INPUT     p-fact-rangeTo  ,
     2363                     INPUT     p-Fact-RangeFrom ,
     2364                     INPUT     p-fact-rangeTo ,
     2365                     INPUT     bfrom_wth-parts.host-code     ,
     2366                     INPUT     bfrom_wth-parts.contract-code               ,
     2367                     INPUT     v-price-rubl ,
     2368                     INPUT     v-price-base  ,
     2369                     INPUT     bfrom_wth-parts.supp-type,
     2370                     INPUT     bfrom_wth-parts.supp-code,
     2371                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2372                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2373                     INPUT     p-ext-doc-type,
     2374                     INPUT     bfrom_wth-parts.gds-code,
     2375                     INPUT     0              ,
     2376                     INPUT     v-beg-dt    ,
     2377                     INPUT     v-end-dt   ,
     2378                     INPUT     v-vat-pc    ,
     2379                     INPUT     bfrom_wth-parts.cli-code,
     2380                     INPUT     bfrom_wth-parts.cli-type,
     2381                     INPUT     bfrom_wth-parts.out-obj-code,
     2382                     INPUT     bfrom_wth-parts.out-obj-type,
     2383                     INPUT     bfrom_wth-parts.sale-obj-code,
     2384                     INPUT     bfrom_wth-parts.sale-obj-type,
     2385                     INPUT     bfrom_wth-parts.doc-code,
     2386                     INPUT     yes,
     2387                     INPUT     p-type,
     2388                     INPUT-OUTPUT p-rec
     2389                     ) no-error.
     2390       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2391       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2392       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2393                     INPUT     tt-wthlib-parts.obj-type,
     2394                     INPUT     tt-wthlib-parts.obj-code,
     2395                     INPUT     tt-wthlib-parts.w-p-code,
     2396                     INPUT     tt-wthlib-parts.wth-code,
     2397                     INPUT     tt-wthlib-parts.par-code,
     2398                     INPUT     tt-wthlib-parts.in-code ,
     2399                     INPUT     tt-wthlib-parts.out-code,
     2400                     INPUT     tt-wthlib-parts.ser-code,
     2401                     INPUT     tt-wthlib-parts.db-num  ,
     2402                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2403                     INPUT     p-fact-rangeFrom - 1  ,
     2404                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2405                     INPUT     p-fact-rangeFrom - 1,
     2406                     INPUT     tt-wthlib-parts.host-code     ,
     2407                     INPUT     tt-wthlib-parts.contract-code               ,
     2408                     INPUT     tt-wthlib-parts.price-rubl    ,
     2409                     INPUT     tt-wthlib-parts.price-base    ,
     2410                     INPUT     tt-wthlib-parts.supp-type,
     2411                     INPUT     tt-wthlib-parts.supp-code,
     2412                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2413                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2414                     INPUT     tt-wthlib-parts.ext-doc-type,
     2415                     INPUT     tt-wthlib-parts.gds-code,
     2416                     INPUT     tt-wthlib-parts.stts               ,
     2417                     INPUT     tt-wthlib-parts.beg-dt        ,
     2418                     INPUT     tt-wthlib-parts.end-dt        ,
     2419                     INPUT     tt-wthlib-parts.vat-pc        ,
     2420                     INPUT     tt-wthlib-parts.cli-code,
     2421                     INPUT     tt-wthlib-parts.cli-type,
     2422                     INPUT     tt-wthlib-parts.out-obj-code,
     2423                     INPUT     tt-wthlib-parts.out-obj-type,
     2424                     INPUT     tt-wthlib-parts.sale-obj-code,
     2425                     INPUT     tt-wthlib-parts.sale-obj-type,
     2426                     INPUT     tt-wthlib-parts.doc-code,
     2427                     INPUT  yes,
     2428                     INPUT    tt-wthlib-parts.type,
     2429                     INPUT-OUTPUT v-recDop
     2430                     ) no-error.
     2431       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2432       end.
     2433       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2434               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2435                     INPUT     tt-wthlib-parts.obj-type,
     2436                     INPUT     tt-wthlib-parts.obj-code,
     2437                     INPUT     tt-wthlib-parts.w-p-code,
     2438                     INPUT     tt-wthlib-parts.wth-code,
     2439                     INPUT     tt-wthlib-parts.par-code,
     2440                     INPUT     tt-wthlib-parts.in-code ,
     2441                     INPUT     tt-wthlib-parts.out-code,
     2442                     INPUT     tt-wthlib-parts.ser-code,
     2443                     INPUT     tt-wthlib-parts.db-num  ,
     2444                     INPUT     p-fact-rangeTo + 1 ,
     2445                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2446                     INPUT     p-fact-rangeTo + 1 ,
     2447                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2448                     INPUT     tt-wthlib-parts.host-code     ,
     2449                     INPUT     tt-wthlib-parts.contract-code               ,
     2450                     INPUT     tt-wthlib-parts.price-rubl    ,
     2451                     INPUT     tt-wthlib-parts.price-base    ,
     2452                     INPUT     tt-wthlib-parts.supp-type,
     2453                     INPUT     tt-wthlib-parts.supp-code,
     2454                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2455                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2456                     INPUT     tt-wthlib-parts.ext-doc-type,
     2457                     INPUT     tt-wthlib-parts.gds-code,
     2458                     INPUT     tt-wthlib-parts.stts               ,
     2459                     INPUT     tt-wthlib-parts.beg-dt        ,
     2460                     INPUT     tt-wthlib-parts.end-dt        ,
     2461                     INPUT     tt-wthlib-parts.vat-pc        ,
     2462                     INPUT     tt-wthlib-parts.cli-code,
     2463                     INPUT     tt-wthlib-parts.cli-type,
     2464                     INPUT     tt-wthlib-parts.out-obj-code,
     2465                     INPUT     tt-wthlib-parts.out-obj-type,
     2466                     INPUT     tt-wthlib-parts.sale-obj-code,
     2467                     INPUT     tt-wthlib-parts.sale-obj-type,
     2468                     INPUT     tt-wthlib-parts.doc-code,
     2469                     INPUT     yes,
     2470                     INPUT     tt-wthlib-parts.type,
     2471                     INPUT-OUTPUT v-recDop
     2472                     ) no-error.
     2473         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2474       end.
     2475     end.
     2476   end.
     2477   end procedure.
     2478   procedure wth-parts-inter-edit:
     2479     define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2480     define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2481     define input-output parameter p-rec        as recid     no-undo .
     2482     define buffer bfrom_wth-parts   for ub.wth-parts.
     2483     define variable v-recDop as recid        no-undo.
     2484     do on error undo, return error:
     2485         find first bfrom_wth-parts exclusive-lock where
     2486                   recid(bfrom_wth-parts) = p-rec no-error.
     2487         if not available bfrom_wth-parts then return error
     2488           substitute('Не найдена партия (recid &1)', p-rec).
     2489         if p-fact-rangeFrom < bfrom_wth-parts.doc-rangeFrom or
     2490            p-fact-rangeTo > bfrom_wth-parts.doc-rangeTo then do:
     2491            return error 'Нельзя увеличивать границы диапазона.'.
     2492         end.
     2493         empty temp-table tt-wthlib-parts.
     2494         create tt-wthlib-parts.
     2495         buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2496         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2497                     INPUT     bfrom_wth-parts.obj-type,
     2498                     INPUT     bfrom_wth-parts.obj-code,
     2499                     INPUT     bfrom_wth-parts.w-p-code,
     2500                     INPUT     bfrom_wth-parts.wth-code,
     2501                     INPUT     bfrom_wth-parts.par-code,
     2502                     INPUT     bfrom_wth-parts.in-code ,
     2503                     INPUT     bfrom_wth-parts.doc-code,
     2504                     INPUT     bfrom_wth-parts.ser-code,
     2505                     INPUT     bfrom_wth-parts.db-num  ,
     2506                     INPUT     p-Fact-RangeFrom ,
     2507                     INPUT     p-fact-rangeTo  ,
     2508                     INPUT     p-Fact-RangeFrom ,
     2509                     INPUT     p-fact-rangeTo ,
     2510                     INPUT     bfrom_wth-parts.host-code     ,
     2511                     INPUT     bfrom_wth-parts.contract-code               ,
     2512                     INPUT     bfrom_wth-parts.price-rubl  ,
     2513                     INPUT     bfrom_wth-parts.price-base    ,
     2514                     INPUT     bfrom_wth-parts.supp-type,
     2515                     INPUT     bfrom_wth-parts.supp-code,
     2516                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2517                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2518                     INPUT     bfrom_wth-parts.ext-doc-type,
     2519                     INPUT     bfrom_wth-parts.gds-code,
     2520                     INPUT     0              ,
     2521                     INPUT     bfrom_wth-parts.beg-dt      ,
     2522                     INPUT     bfrom_wth-parts.end-dt      ,
     2523                     INPUT     bfrom_wth-parts.vat-pc      ,
     2524                     INPUT     bfrom_wth-parts.cli-code,
     2525                     INPUT     bfrom_wth-parts.cli-type,
     2526                     INPUT     bfrom_wth-parts.out-obj-code,
     2527                     INPUT     bfrom_wth-parts.out-obj-type,
     2528                     INPUT     bfrom_wth-parts.sale-obj-code,
     2529                     INPUT     bfrom_wth-parts.sale-obj-type,
     2530                     INPUT     bfrom_wth-parts.doc-code,
     2531                     INPUT     yes,
     2532                     INPUT     bfrom_wth-parts.type,
     2533                     INPUT-OUTPUT p-rec
     2534                     ) no-error.
     2535       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2536       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2537       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2538                     INPUT     tt-wthlib-parts.obj-type,
     2539                     INPUT     tt-wthlib-parts.obj-code,
     2540                     INPUT     tt-wthlib-parts.w-p-code,
     2541                     INPUT     tt-wthlib-parts.wth-code,
     2542                     INPUT     tt-wthlib-parts.par-code,
     2543                     INPUT     tt-wthlib-parts.in-code ,
     2544                     INPUT     tt-wthlib-parts.out-code,
     2545                     INPUT     tt-wthlib-parts.ser-code,
     2546                     INPUT     tt-wthlib-parts.db-num  ,
     2547                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2548                     INPUT     p-fact-rangeFrom - 1  ,
     2549                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2550                     INPUT     p-fact-rangeFrom - 1,
     2551                     INPUT     tt-wthlib-parts.host-code     ,
     2552                     INPUT     tt-wthlib-parts.contract-code               ,
     2553                     INPUT     tt-wthlib-parts.price-rubl    ,
     2554                     INPUT     tt-wthlib-parts.price-base    ,
     2555                     INPUT     tt-wthlib-parts.supp-type,
     2556                     INPUT     tt-wthlib-parts.supp-code,
     2557                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2558                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2559                     INPUT     tt-wthlib-parts.ext-doc-type,
     2560                     INPUT     tt-wthlib-parts.gds-code,
     2561                     INPUT     1             ,
     2562                     INPUT     tt-wthlib-parts.beg-dt        ,
     2563                     INPUT     tt-wthlib-parts.end-dt        ,
     2564                     INPUT     tt-wthlib-parts.vat-pc        ,
     2565                     INPUT     tt-wthlib-parts.cli-code,
     2566                     INPUT     tt-wthlib-parts.cli-type,
     2567                     INPUT     tt-wthlib-parts.out-obj-code,
     2568                     INPUT     tt-wthlib-parts.out-obj-type,
     2569                     INPUT     tt-wthlib-parts.sale-obj-code,
     2570                     INPUT     tt-wthlib-parts.sale-obj-type,
     2571                     INPUT     tt-wthlib-parts.doc-code,
     2572                     INPUT  yes,
     2573                     INPUT    tt-wthlib-parts.type,
     2574                     INPUT-OUTPUT v-recDop
     2575                     ) no-error.
     2576       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2577       end.
     2578       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2579               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2580                     INPUT     tt-wthlib-parts.obj-type,
     2581                     INPUT     tt-wthlib-parts.obj-code,
     2582                     INPUT     tt-wthlib-parts.w-p-code,
     2583                     INPUT     tt-wthlib-parts.wth-code,
     2584                     INPUT     tt-wthlib-parts.par-code,
     2585                     INPUT     tt-wthlib-parts.in-code ,
     2586                     INPUT     tt-wthlib-parts.out-code,
     2587                     INPUT     tt-wthlib-parts.ser-code,
     2588                     INPUT     tt-wthlib-parts.db-num  ,
     2589                     INPUT     p-fact-rangeTo + 1 ,
     2590                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2591                     INPUT     p-fact-rangeTo + 1 ,
     2592                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2593                     INPUT     tt-wthlib-parts.host-code     ,
     2594                     INPUT     tt-wthlib-parts.contract-code               ,
     2595                     INPUT     tt-wthlib-parts.price-rubl    ,
     2596                     INPUT     tt-wthlib-parts.price-base    ,
     2597                     INPUT     tt-wthlib-parts.supp-type,
     2598                     INPUT     tt-wthlib-parts.supp-code,
     2599                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2600                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2601                     INPUT     tt-wthlib-parts.ext-doc-type,
     2602                     INPUT     tt-wthlib-parts.gds-code,
     2603                     INPUT     1             ,
     2604                     INPUT     tt-wthlib-parts.beg-dt        ,
     2605                     INPUT     tt-wthlib-parts.end-dt        ,
     2606                     INPUT     tt-wthlib-parts.vat-pc        ,
     2607                     INPUT     tt-wthlib-parts.cli-code,
     2608                     INPUT     tt-wthlib-parts.cli-type,
     2609                     INPUT     tt-wthlib-parts.out-obj-code,
     2610                     INPUT     tt-wthlib-parts.out-obj-type,
     2611                     INPUT     tt-wthlib-parts.sale-obj-code,
     2612                     INPUT     tt-wthlib-parts.sale-obj-type,
     2613                     INPUT     tt-wthlib-parts.doc-code,
     2614                     INPUT     yes,
     2615                     INPUT     tt-wthlib-parts.type,
     2616                     INPUT-OUTPUT v-recDop
     2617                     ) no-error.
     2618         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2619         end.
     2620     end.
     2621   end procedure.
     2622   PROCEDURE INIT_prtdate:
     2623       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2624       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2625       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2626       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2627       define input parameter        p-date                AS DATE no-undo .
     2628       DEFINE OUTPUT PARAMETER p-beg-dt AS DATE NO-UNDO.
     2629       DEFINE OUTPUT PARAMETER p-end-dt AS DATE NO-UNDO.
     2630       DEFINE BUFFER buf_wth-ser FOR ub.wth-ser.
     2631       DEFINE VARIABLE v-rangeRule AS INT NO-UNDO.
     2632       define variable v-value-character as character no-undo .
     2633       define variable v-value-date as date no-undo .
     2634       define variable v-value-decimal as decimal no-undo .
     2635       define variable v-value-integer as INTEGER no-undo .
     2636       define variable v-value-logical AS LOGICAL no-undo .
     2637       define variable v-param-type as character no-undo .
     2638       FIND FIRST buf_wth-ser NO-LOCK
     2639           WHERE buf_wth-ser.ser-code = p-ser-code
     2640           AND buf_wth-ser.db-num = p-db-num.
     2641       IF buf_wth-ser.chk-bdt = 2 THEN DO:
     2642           p-beg-dt = buf_wth-ser.beg-dt.
     2643       END.
     2644       IF buf_wth-ser.chk-edt = 2 THEN DO:
     2645           p-end-dt = buf_wth-ser.end-dt.
     2646       END.
     2647       IF buf_wth-ser.chk-bdt = 0 AND buf_wth-ser.chk-edt = 0 THEN DO:
     2648           run adm/shattri.p (
     2649               input "get":U
     2650               ,input  p-obj-type
     2651               ,input  p-obj-code
     2652               ,input  'wthdoc_obj':U
     2653               ,input  'rangerule':U
     2654               ,output v-value-character
     2655               ,output v-value-date
     2656               ,output v-value-decimal
     2657               ,output v-value-integer
     2658               ,output v-value-logical
     2659               ,output v-param-type
     2660               ,INPUT-OUTPUT table-handle v-tth
     2661               ) no-error .
     2662           IF not error-status:error  then do:
     2663               v-rangeRule =  v-value-integer.
     2664           END.
     2665           CASE v-rangeRule:
     2666           WHEN 1 THEN DO:
     2667               IF MONTH(p-date) < 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date)))
     2668                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 2,YEAR(p-date))) - 1.
     2669               ELSE IF MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/12/&1',YEAR(p-date)))
     2670                                                 p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date) + 1)).
     2671               ELSE IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('01/01/&1',YEAR(p-date) + 1))
     2672                                                 p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2673           END.
     2674           when 2 then do:
     2675             IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2676                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2677             else ASSIGN p-beg-dt = DATE(substitute('&3/&1/&2',MONTH(p-date),YEAR(p-date),day(p-date)))
     2678                         p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date))) - 1
     2679                        .
     2680           end.
     2681           WHEN 3 THEN DO:
     2682               IF MONTH(p-date) < 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/&2/&3',day(p-date),MONTH(p-date),YEAR(p-date)))
     2683                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 3,YEAR(p-date))) - 1.
     2684               else if MONTH(p-date) = 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/10/&2',day(p-date),YEAR(p-date)))
     2685                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2686               else if MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('&1/11/&2',day(p-date),YEAR(p-date)))
     2687                                               p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2688               else if MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2689                                               p-end-dt = DATE(substitute('01/03/&1',YEAR(p-date) + 1)) - 1.
     2690           END.
     2691           when 4 then do:
     2692                p-beg-dt = p-date.
     2693                p-end-dt = date(substitute('31/12/&1',YEAR(p-date))).
     2694           end.
     2695           END CASE.
     2696       END.
     2697   END.
     2698   PROCEDURE INIT_prtprice:
     2699   define input parameter        p-host-code        LIKE ub.wth-parts.obj-type no-undo .
     2700   define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2701   define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2702   define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2703   define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2704   define input parameter        p-wth-code         LIKE ub.wth-parts.ser-code no-undo.
     2705   define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2706   define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2707   define input parameter        p-date                AS DATE no-undo .
     2708   DEFINE OUTPUT PARAMETER p-vat-pc LIKE ub.wth-parts.vat-pc NO-UNDO.
     2709   DEFINE OUTPUT PARAMETER p-price-rubl LIKE ub.wth-parts.price-rubl NO-UNDO.
     2710   DEFINE OUTPUT PARAMETER p-price-base LIKE ub.wth-parts.price-base NO-UNDO.
     2711   DEFINE BUFFER b-cash-pay FOR ub.cash-pay.
     2712   DEFINE BUFFER b-wth-par FOR ub.wth-par.
     2713   DEF VAR v-cash-type-pay AS CHAR no-undo.
     2714   define variable p-plt-id AS INT no-undo.
     2715   define variable  p-plt-db-num   AS INT no-undo.
     2716   define variable  p-pdf-id  AS INT no-undo.
     2717   define variable  p-pdf-db-num AS INT no-undo.
     2718   define variable  p-sale-price-base AS DEC no-undo.
     2719   define variable  p-sale-price-rubl AS DEC no-undo.
     2720   define variable  p-road-tax-base AS DEC no-undo.
     2721   define variable  p-road-tax-rubl AS DEC no-undo.
     2722   define variable  p-excise-base AS DEC no-undo.
     2723   define variable  p-excise-rubl AS DEC no-undo.
     2724   define variable  p-fact-order  AS DEC no-undo.
     2725   do on error undo, return error return-value :
     2726     FIND FIRST b-wth-par NO-LOCK WHERE b-wth-par.par-code = p-par-code
     2727                                     AND b-wth-par.wth-code = p-wth-code NO-ERROR.
     2728     IF NOT AVAILABLE b-wth-par THEN RETURN ERROR SUBSTITUTE("Не наден номинал с кодом &1",p-par-code).
     2729     FIND FIRST b-cash-pay WHERE b-cash-pay.wth-code = p-wth-code NO-LOCK NO-ERROR.
     2730     IF AVAILABLE b-cash-pay THEN v-cash-type-pay = STRING(recid(b-cash-pay)).
     2731     ELSE v-cash-type-pay = ?.
     2732     run fact-order-mpl (
     2733         INPUT p-date ,
     2734         INPUT p-obj-type ,
     2735         INPUT p-obj-code ,
     2736         OUTPUT p-fact-order
     2737         ) no-error .
     2738     if error-status:error then do:
     2739       message   return-value skip error-status:get-message(1)
     2740       skip  'Получение цены из множественного прайс-листа отклонено.'
     2741       view-as alert-box.
     2742       return.
     2743     end.
     2744   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2745   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2746     (input  p-gds-code
     2747     ,input  '1':U
     2748     ,input  ?
     2749     ,input  p-host-code
     2750     ,input  p-obj-type
     2751     ,input  p-obj-code
     2752     ,output p-vat-pc
     2753     ) no-error .
     2754     run mpl-autoprice in this-procedure
     2755       ( input    false
     2756         ,input   p-cli-type
     2757         ,input   p-cli-code
     2758         ,input   p-gds-code
     2759         ,input   p-gds-code
     2760         ,input   p-obj-type
     2761         ,input   p-obj-code
     2762         ,input   0
     2763         ,input   0
     2764         ,input   ""
     2765         ,input   v-cash-type-pay
     2766         ,input   p-fact-order
     2767         ,output  p-plt-id
     2768         ,output  p-plt-db-num
     2769         ,output  p-pdf-id
     2770         ,output  p-pdf-db-num
     2771         ,output  p-sale-price-base
     2772         ,output  p-sale-price-rubl
     2773         ,output  p-road-tax-base
     2774         ,output  p-road-tax-rubl
     2775         ,output  p-excise-base
     2776         ,output  p-excise-rubl
     2777         ) no-error .
     2778     if error-status:error then do:
     2779       message   return-value skip error-status:get-message(1) view-as alert-box.
     2780       return.
     2781     end.
     2782     p-price-rubl = p-sale-price-rubl * b-wth-par.par-val.
     2783     p-price-base = p-sale-price-base * b-wth-par.par-val.
     2784   end.
     2785   END.
     2786   procedure  set-wthmpl-date:
     2787   define input parameter p-doc-code like ub.wth-doc.doc-code no-undo.
     2788   define input parameter p-doc-date like ub.wth-doc.doc-date no-undo.
     2789   define input parameter p-beg-dt   like ub.wth-parts.beg-dt no-undo.
     2790   define output parameter p-date    like ub.wth-doc.doc-date no-undo.
     2791   define variable v-atrValue      as character no-undo .
     2792   define variable v-atrDsf      as CHARACTER no-undo .
     2793   define variable v-atrType     as character no-undo .
     2794   do on error undo, return error return-value :
     2795   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     2796                           input 'wthdsf':U ,
     2797                          output v-atrValue ,
     2798                          output v-atrType )  .
     2799     p-date = date(v-atrValue) no-error.
     2800     if p-date = ? then p-date = p-beg-dt no-error.
     2801     if p-date = ? then p-date = p-doc-date.
     2802   end.
     2803   end procedure.
     2804   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2805   define variable v-waitfram-action01         as character   no-undo .
     2806   define variable v-waitfram-action02         as character   no-undo .
     2807   define variable v-waitfram-action03         as character   no-undo .
     2808   define variable mWaitFramTextBeg            as character   no-undo.
     2809   define variable mWaitFramTextEnd            as character   no-undo.
     2810   define variable mWaitFramView               as logical     no-undo.
     2811   define variable mWaitProcEvent              as logical     no-undo init yes.
     2812   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2813   define variable mWaitFramStop               as logical     no-undo.
     2814   define variable mWaitFramStopUser           as logical     no-undo.
     2815   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2816   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2817   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2818   define button B-WaitFramStop auto-end-key
     2819        label "Стоп"
     2820        size 10 by 1 tooltip "Остоновить процесс".
     2821   define button B-viewProcInfo
     2822        label "Информация"
     2823        size 15 by 1 tooltip "Информация о процесс".
     2824   define frame waitfram
     2825     v-waitfram-action01 format "x(72)" no-label skip
     2826     v-waitfram-action02 format "x(72)" no-label skip
     2827     v-waitfram-action03 format "x(72)" no-label skip
     2828     B-viewProcInfo
     2829     B-WaitFramStop at row 4 col 30
     2830     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2831     .
     2832   define new global shared variable mBatchMode as logical no-undo init ?.
     2833   define variable mFramBachModHandle as handle no-undo.
     2834   mFramBachModHandle = frame waitfram:handle.
     2835   define variable mFameOldVis as logical no-undo.
     2836   define variable mVisCUrentVin as logical no-undo.
     2837   if session:batch-mode
     2838   then
     2839      mBatchMode = yes.
     2840   if mBatchMode = ? then do:
     2841     mVisCUrentVin = current-window:visible.
     2842     mFameOldVis = mFramBachModHandle:visible.
     2843     mFramBachModHandle:visible  = yes.
     2844     mBatchMode = mFramBachModHandle:visible ne yes.
     2845     mFramBachModHandle:visible = mFameOldVis.
     2846     current-window:visible = mVisCUrentVin.
     2847   end.
     2848    if  log-manager:logfile-name ne ?
     2849     then DO:
     2850         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2851         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2852         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2853     end.
     2854   on choose of B-WaitFramStop in frame waitfram
     2855   do:
     2856     mWaitFramStop = yes.
     2857     mWaitFramStopUser = yes.
     2858   end.
     2859   function waitfram-check-timeout returns logical():
     2860      define variable vtime as int64 no-undo.
     2861      if mWaitFramStopTimeOut
     2862      then
     2863         return yes.
     2864      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2865      if     mWaitFramTimeOut ne ?
     2866         and mWaitFramTimeOut ne 0
     2867         and mWaitFramTimeOut lt vtime
     2868      then do:
     2869         mWaitFramStopTimeOut = yes.
     2870      end.
     2871      return mWaitFramStopTimeOut.
     2872   end.
     2873   procedure waitfram-hide :
     2874     if not session:batch-mode
     2875     then do
     2876     on error undo, return error return-value
     2877     :
     2878       pause 0 before-hide .
     2879       if not mBatchMode then
     2880         hide frame waitfram .
     2881     if     not mWaitFramView
     2882        and mWaitProcEvent
     2883     then
     2884       process events .
     2885     end.
     2886   end procedure.
     2887   procedure waitfram-show :
     2888     define input  parameter p-message as character no-undo .
     2889     define variable v-left-margin as integer   no-undo .
     2890     if not session:batch-mode
     2891     then do
     2892     on error undo, return error return-value
     2893     :
     2894       if length(p-message) <= 70 then do:
     2895         assign
     2896           v-left-margin = integer((70 - length(p-message)) / 2)
     2897         .
     2898         assign
     2899           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2900         .
     2901         assign
     2902           v-waitfram-action01 = " "
     2903           v-waitfram-action02 = " "
     2904                                    + fill(" ", v-left-margin)
     2905                                    + p-message
     2906           v-waitfram-action03 = " "
     2907         .
     2908       end.
     2909       else do:
     2910         define variable vRindex1 as integer no-undo.
     2911         define variable vRindex2 as integer no-undo.
     2912         vRindex1 = r-index(p-message," ",70).
     2913         if vRindex1 = 0
     2914         then
     2915            vRindex1 = 70.
     2916         if length(p-message)  <= vRindex1 + 70 then do:
     2917           assign
     2918             v-waitfram-action01 = " "
     2919             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2920             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2921           .
     2922         end.
     2923         else do:
     2924           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2925           if vRindex2 <= vRindex1
     2926           then
     2927              vRindex2 = vRindex1 + 70.
     2928           assign
     2929             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2930             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2931             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2932           .
     2933         end.
     2934       end.
     2935       B-viewProcInfo:visible   in frame waitfram = no.
     2936       B-viewProcInfo:sensitive in frame waitfram = no.
     2937       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2938       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2939       if  (   mWaitFramView
     2940          or  mWaitProcEvent)
     2941          and not mBatchMode
     2942       then
     2943          display
     2944             v-waitfram-action01 skip
     2945             v-waitfram-action02 skip
     2946             v-waitfram-action03 skip
     2947          with frame waitfram .
     2948       if     mWaitFramView
     2949          then do:
     2950             if     mWaitFramInterval ne ?
     2951                and not mBatchMode
     2952             then
     2953                wait-for go of frame waitfram pause mWaitFramInterval.
     2954          end.
     2955          else
     2956             if     mWaitProcEvent
     2957                and not mBatchMode
     2958             then
     2959                process events .
     2960     end.
     2961   end procedure.
     2962      procedure waitfram-show-this:
     2963         define input  parameter iInterval as int64 no-undo.
     2964         define variable vtime as int64 no-undo.
     2965         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2966         mWaitFramInterval = iInterval.
     2967         run waitfram-show (substitute("&1&2 &3&4" ,
     2968                                       mWaitFramTextBeg ,
     2969                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2970                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2971                                       mWaitFramTextEnd
     2972                                      )
     2973                           ).
     2974      end.
     2975      procedure WaitFramRunPause:
     2976         define input  parameter iInterval as dec no-undo.
     2977         define variable vStart  as datetime-tz no-undo.
     2978         define variable vend    as datetime-tz no-undo.
     2979         define variable vint as int64 no-undo.
     2980         define variable vOk as logical no-undo.
     2981         vStart = now.
     2982         vend   = vStart.
     2983         publish "WaitFramPause" (iInterval,output vOk).
     2984         vend   =  now.
     2985         vint = vend - vStart.
     2986         vint = iInterval - vint / 1000.
     2987         if     not mWaitFramStop
     2988            and (   vint > 0
     2989                 or (    not vOk
     2990                     and iInterval eq ?
     2991                     )
     2992                 )
     2993         then
     2994            run waitfram-show-this (iInterval).
     2995         vend   =  now.
     2996         vint = vend - vStart.
     2997         vint = iInterval - vint / 1000.
     2998         if     not mWaitFramStop
     2999            and vint > 0
     3000         then do:
     3001            run gbl/pause.p (vint * 1000).
     3002         end.
     3003         if iInterval ne ?
     3004         then
     3005            publish "WaitFramStop".
     3006         waitfram-check-timeout().
     3007      end.
     3008      procedure WaitFramWaitFor:
     3009         define input  parameter iInterval as dec no-undo.
     3010         assign
     3011            mWaitFramStartProc   = now
     3012            mWaitFramStopUser    = no
     3013            mWaitFramStopTimeOut = no
     3014         .
     3015         block-wait:
     3016         do while not mWaitFramStop:
     3017            run WaitFramRunPause (iInterval).
     3018            if  waitfram-check-timeout()
     3019            then do:
     3020               leave block-wait.
     3021            end.
     3022         end.
     3023         run waitfram-hide.
     3024      end.
     3025   procedure waitfram-join :
     3026     define input  parameter p-line-1  as character no-undo .
     3027     define input  parameter p-line-2  as character no-undo .
     3028     define input  parameter p-line-3  as character no-undo .
     3029     define output parameter p-message as character no-undo .
     3030     do
     3031     on error undo, return error return-value
     3032     :
     3033       assign
     3034         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3035                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3036                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3037       .
     3038     end.
     3039   end procedure.
     3040   function waitfram-join-function returns character
     3041     (input p-line-1 as character
     3042     ,input p-line-2 as character
     3043     ,input p-line-3 as character
     3044     ).
     3045     define variable v-message as character no-undo .
     3046     run waitfram-join in this-procedure
     3047       (input  p-line-1
     3048       ,input  p-line-2
     3049       ,input  p-line-3
     3050       ,output v-message
     3051       ) .
     3052     return v-message .
     3053   end function .
     3054   define buffer buf_wth-doc   for wth-doc.
     3055   define buffer b_wth-parts   for wth-parts.
     3056   define variable v-rec  as recid no-undo.
     3057   define variable v-i    as integer      no-undo.
     3058   MainBlock: do
     3059   on error undo, return error return-value
     3060   :
     3061   for each tres-wth-parts where tres-wth-parts.stts = 0:
     3062     v-rec = ?.
     3063     run wth-parts-rezerv (
     3064                        p-param
     3065                       ,tres-wth-parts.fact-rangeFrom
     3066                       ,tres-wth-parts.fact-RangeTo
     3067                       ,tres-wth-parts.beg-dt
     3068                       ,tres-wth-parts.end-dt
     3069                       ,tres-wth-parts.ser-code
     3070                       ,tres-wth-parts.db-num
     3071                       ,tres-wth-parts.price-rubl
     3072                       ,tres-wth-parts.price-base
     3073                       ,tres-wth-parts.vat-pc
     3074                       ,tres-wth-parts.host-code
     3075                       ,tres-wth-parts.obj-type
     3076                       ,tres-wth-parts.obj-code
     3077                       ,tres-wth-parts.w-p-code
     3078                       ,tres-wth-parts.wth-code
     3079                       ,tres-wth-parts.par-code
     3080                       ,tres-wth-parts.in-code
     3081                       ,tres-wth-parts.out-code
     3082                       ,tres-wth-parts.cli-type
     3083                       ,tres-wth-parts.cli-code
     3084                       ,tres-wth-parts.ext-doc-type
     3085                       ,tres-wth-parts.gds-code
     3086                       ,tres-wth-parts.type
     3087                       ,input-output v-rec
     3088                      ) no-error.
     3089     if error-status:error then do:
     3090         if not g#news then   undo MainBlock, return error  return-value.
     3091         if return-value = 'forged' then do:
     3092           if tres-wth-parts.fact-rangeFrom = tres-wth-parts.fact-rangeTo
     3093           then do:
     3094             run CreateForgedParts(input tres-wth-parts.fact-rangeFrom )  no-error.
     3095             if error-status:error then undo MainBlock, return error  return-value.
     3096           end.
     3097           else  do v-i = tres-wth-parts.fact-rangeFrom to tres-wth-parts.fact-rangeTo:
     3098             run waitfram-show in this-procedure ( input substitute("Не удалось зарезервировать партию целиком (документ &2). Резервирование по номеру &1",v-i,tres-wth-parts.out-code) ).
     3099             v-rec = ?.
     3100               run wth-parts-rezerv (
     3101                         p-param
     3102                         ,v-i
     3103                         ,v-i
     3104                         ,tres-wth-parts.beg-dt
     3105                         ,tres-wth-parts.end-dt
     3106                         ,tres-wth-parts.ser-code
     3107                         ,tres-wth-parts.db-num
     3108                         ,tres-wth-parts.price-rubl
     3109                         ,tres-wth-parts.price-base
     3110                         ,tres-wth-parts.vat-pc
     3111                         ,tres-wth-parts.host-code
     3112                         ,tres-wth-parts.obj-type
     3113                         ,tres-wth-parts.obj-code
     3114                         ,tres-wth-parts.w-p-code
     3115                         ,tres-wth-parts.wth-code
     3116                         ,tres-wth-parts.par-code
     3117                         ,tres-wth-parts.in-code
     3118                         ,tres-wth-parts.out-code
     3119                         ,tres-wth-parts.cli-type
     3120                         ,tres-wth-parts.cli-code
     3121                         ,tres-wth-parts.ext-doc-type
     3122                         ,tres-wth-parts.gds-code
     3123                         ,tres-wth-parts.type
     3124                         ,input-output v-rec
     3125                       ) no-error.
     3126             if error-status:error then do:
     3127               if return-value = 'forged':U then do:
     3128                   run CreateForgedParts(input v-i ) no-error.
     3129                   if error-status:error then undo, return error  return-value + error-status:get-message(1) .
     3130               end.
     3131               else  do:
     3132                 run waitfram-hide in this-procedure .
     3133                 undo MainBlock, return error  return-value.
     3134               end.
     3135             end.
     3136           end.
     3137           run waitfram-hide in this-procedure .
     3138         end.
     3139      end.
     3140   end.
     3141   end.
     3142   procedure CreateForgedParts:
     3143   define input parameter  p-i as int no-undo.
     3144   run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     3145                     INPUT  tres-wth-parts.obj-type,
     3146                     INPUT  tres-wth-parts.obj-code,
     3147                     INPUT  tres-wth-parts.w-p-code,
     3148                     INPUT  tres-wth-parts.wth-code,
     3149                     INPUT  tres-wth-parts.par-code,
     3150                     INPUT  'фальшивый':U,
     3151                     INPUT  tres-wth-parts.out-code,
     3152                     INPUT  tres-wth-parts.ser-code,
     3153                     INPUT  tres-wth-parts.db-num  ,
     3154                     INPUT  p-i ,
     3155                     INPUT  p-i ,
     3156                     INPUT  p-i ,
     3157                     INPUT  p-i ,
     3158                     INPUT  tres-wth-parts.host-code     ,
     3159                     INPUT  tres-wth-parts.contract-code   ,
     3160                     INPUT  tres-wth-parts.price-rubl    ,
     3161                     INPUT  tres-wth-parts.price-base    ,
     3162                     INPUT  tres-wth-parts.supp-type,
     3163                     INPUT  tres-wth-parts.supp-code,
     3164                     INPUT  tres-wth-parts.in-obj-type      ,
     3165                     INPUT  tres-wth-parts.in-obj-code      ,
     3166                     INPUT  tres-wth-parts.ext-doc-type,
     3167                     INPUT  tres-wth-parts.gds-code,
     3168                     INPUT  0           ,
     3169                     INPUT  tres-wth-parts.beg-dt        ,
     3170                     INPUT  tres-wth-parts.end-dt        ,
     3171                     INPUT  tres-wth-parts.vat-pc      ,
     3172                     INPUT  tres-wth-parts.cli-code,
     3173                     INPUT  tres-wth-parts.cli-type,
     3174                     INPUT  tres-wth-parts.out-obj-code,
     3175                     INPUT  tres-wth-parts.out-obj-type,
     3176                     INPUT  tres-wth-parts.sale-obj-code,
     3177                     INPUT  tres-wth-parts.sale-obj-type,
     3178                     INPUT  tres-wth-parts.doc-code,
     3179                     INPUT  yes,
     3180                     INPUT tres-wth-parts.type,
     3181                     INPUT-OUTPUT v-rec
     3182                     ) no-error.
     3183                 if error-status:error then undo, return error return-value + error-status:get-message(1) .
     3184   end procedure.
