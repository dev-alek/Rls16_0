      371   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   procedure cur-time :
      375      define output parameter p-today as date      no-undo .
      376      define output parameter p-time  as integer   no-undo .
      377     do
      378     on error undo, return error
      379     :
      380       define variable v-date1 as date      no-undo .
      381       define variable v-date2 as date      no-undo .
      382       define variable v-time  as integer   no-undo .
      383       assign
      384         v-date1 = today
      385         v-time  = time
      386         v-date2 = today
      387       .
      388       if v-date1 <> v-date2
      389       then do:
      390         assign
      391           v-date1 = today
      392           v-time  = v-time
      393         .
      394       end.
      395       assign
      396         p-today = v-date1
      397         p-time  = v-time
      398       .
      399     end.
      400   end.
      401   function cur-time-date returns character
      402   :
      403     return string(today, '99/99/9999':U) .
      404   end.
      405   function cur-time-mjd returns decimal
      406   :
      407     define variable v-date as date      no-undo .
      408     define variable v-time as integer   no-undo .
      409     run cur-time in this-procedure
      410       (output v-date
      411       ,output v-time
      412       ) .
      413     return integer(v-date) - 2400002 + (v-time / 86400) .
      414   end.
      415   function cur-time-get-ending-index returns integer
      416   (input p-number as integer
      417   )
      418   :
      419     if p-number < 0
      420     or p-number = ?
      421     then do:
      422       return 1 .
      423     end.
      424     define variable v-rest as integer   no-undo .
      425     assign
      426       p-number = p-number modulo 100
      427     .
      428     if p-number < 20
      429     then do:
      430       assign
      431         v-rest = p-number
      432       .
      433     end.
      434     else do:
      435       assign
      436         v-rest = p-number modulo 10
      437       .
      438     end.
      439     case v-rest :
      440       when 1
      441       then do:
      442         return 2 .
      443       end.
      444       when 2 or
      445       when 3 or
      446       when 4
      447       then do:
      448         return 3 .
      449       end.
      450       otherwise do:
      451         return 1 .
      452       end.
      453     end case .
      454   end.
      455   procedure cur-time-mjd-to-date :
      456      define input  parameter i-mjd-diff as decimal no-undo.
      457      define output parameter o-Date     as date    no-undo.
      458      define output parameter o-Time     as integer no-undo.
      459      define variable v-day-number as integer   no-undo .
      460      if    i-mjd-diff < 0
      461         or i-mjd-diff = ?
      462      then do:
      463         return "?" .
      464      end.
      465      assign
      466         v-day-number = truncate(i-mjd-diff,0).
      467         o-Date = date(v-day-number + 2400002).
      468         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      469     .
      470   end.
      471   function cur-time-mjd-to-string returns character
      472   (input p-mjd-diff as decimal
      473   )
      474   :
      475     define variable v-day-number as integer   no-undo .
      476     define variable v-seconds    as integer   no-undo .
      477     define variable v-hour       as integer   no-undo .
      478     define variable v-min        as integer   no-undo .
      479     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      480     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      481     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      482     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      483     if p-mjd-diff < 0
      484     or p-mjd-diff = ?
      485     then do:
      486       return "?" .
      487     end.
      488     assign
      489       v-day-number = integer(truncate(p-mjd-diff,0))
      490       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      491     .
      492     if v-seconds > 86400
      493     then do:
      494       assign
      495         v-seconds = 86400 - 1
      496       .
      497     end.
      498     if v-seconds < 0
      499     then do:
      500       assign
      501         v-seconds = 0
      502       .
      503     end.
      504     assign
      505       v-hour = truncate(v-seconds / 3600, 0)
      506     .
      507     assign
      508       v-seconds = v-seconds modulo 3600
      509     .
      510     assign
      511       v-min = truncate(v-seconds / 60, 0)
      512     .
      513     assign
      514       v-seconds = v-seconds modulo 60
      515     .
      516     return
      517         (if v-day-number <> 0
      518           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      519           else ""
      520         )
      521       + (if v-day-number <> 0 or v-hour <> 0
      522           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      523           else ""
      524         )
      525       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      526           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      527           else ""
      528         )
      529       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      530       .
      531   end.
      532   function cur-time-string returns character
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      541   end.
      542   function cur-time-string-sec returns character
      543   :
      544     define variable v-date as date      no-undo .
      545     define variable v-time as integer   no-undo .
      546     run cur-time in this-procedure
      547       (output v-date
      548       ,output v-time
      549       ) .
      550     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      551   end.
      552   function cur-time-custom  returns character
      553   (input p-prefix as character
      554   ,input p-date-format as character
      555   ,input p-delimiter as character
      556   ,input p-time-format as character
      557   ,input p-suffix as character
      558   )
      559   :
      560     define variable v-date as date      no-undo .
      561     define variable v-time as integer   no-undo .
      562     run cur-time in this-procedure
      563       (output v-date
      564       ,output v-time
      565       ) .
      566     return
      567       p-prefix
      568       + string(v-date, p-date-format)
      569       + p-delimiter
      570       + string(v-time, p-time-format)
      571       + p-suffix
      572       .
      573   end.
      574   function cur-time-print  returns character
      575   :
      576     define variable v-date as date      no-undo .
      577     define variable v-time as integer   no-undo .
      578     run cur-time in this-procedure
      579       (output v-date
      580       ,output v-time
      581       ) .
      582     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      583   end.
      584   function cur-time-datetime returns datetime
      585   :
      586     define variable v-char as character no-undo .
      587     define variable v-datetime as datetime no-undo .
      588     v-char = cur-time-string().
      589     v-datetime = datetime(v-char).
      590     return  v-datetime.
      591   end.
      592   function cur-time-string-msec returns character
      593   :
      594     define variable v-date as datetime  no-undo .
      595     v-date = now.
      596     return string(v-date) .
      597   end.
      598   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   procedure factord :
      600     define input  parameter p-fact-date            as date    no-undo .
      601     define input  parameter p-fact-time            as integer no-undo .
      602     define input  parameter p-fact-num             as integer no-undo .
      603     define input  parameter p-shift-date           as date    no-undo .
      604     define input  parameter p-shift-num            as integer no-undo .
      605     define input  parameter p-shift-on             as logical no-undo .
      606     define output parameter p-fact-order           as decimal no-undo .
      607     define output parameter p-shift-end-fact-order as decimal no-undo .
      608     define output parameter p-day-end-fact-order   as decimal no-undo .
      609     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      610     if p-fact-date = ?
      611     then do:
      612       return error "Не указана фактическая дата" .
      613     end.
      614     define variable v-fact-date-num as integer no-undo .
      615     assign
      616       v-fact-date-num = integer(p-fact-date)
      617     .
      618     if p-fact-num = ?
      619     or p-fact-num = 0
      620     then do:
      621       return error "Не задан p-fact-num " + string(p-fact-num) .
      622     end.
      623     if p-fact-num < 0
      624     then do:
      625       return error "Отрицательный fact-num " + string(p-fact-num) .
      626     end.
      627     if p-fact-num >= 100000000
      628     then do:
      629       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      630     end.
      631     if p-shift-on = true
      632     then do:
      633       if p-shift-date = ?
      634       then do:
      635         return error "Не задана дата смены" .
      636       end.
      637       if p-shift-num = ?
      638       or p-shift-num = 0
      639       then do:
      640         return error "Не задан номер смены" .
      641       end.
      642     end.
      643     else do:
      644       assign
      645         p-shift-date = p-fact-date
      646         p-shift-num  = 24
      647       .
      648     end.
      649     define variable v-shift-offset as integer no-undo .
      650     if p-shift-date = p-fact-date
      651     then do:
      652       assign
      653         v-shift-offset = 1
      654       .
      655     end.
      656     if p-shift-date < p-fact-date
      657     then do:
      658       assign
      659         v-shift-offset = 0
      660       .
      661     end.
      662     if p-shift-date > p-fact-date
      663     then do:
      664       message
      665         vss-workfile vss-revision vss-description skip
      666         "Неправильная дата закрытия смены" skip
      667         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      668         view-as alert-box error .
      669       undo, return error
      670         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      671           ,string(p-fact-date, '99/99/9999':U)
      672           ,string(p-shift-date, '99/99/9999':U)
      673           )
      674       .
      675     end.
      676     if p-shift-num < 1
      677     or p-shift-num > 24
      678     then do:
      679       message
      680         vss-workfile vss-revision vss-description skip
      681         "Неправильный номер смены" skip
      682         "p-shift-num" p-shift-num skip
      683         view-as alert-box error .
      684       undo, return error return-value .
      685     end.
      686     assign
      687       p-fact-order           = v-fact-date-num
      688                              + v-shift-offset * 0.5
      689                              + p-shift-num    * 0.02 - 0.01
      690                              + p-fact-num     * 0.0000000001
      691       p-shift-end-fact-order = v-fact-date-num
      692                              + v-shift-offset * 0.5
      693                              + p-shift-num    * 0.02
      694       p-day-end-fact-order   = v-fact-date-num
      695                              + 0.99
      696     .
      697     if p-fact-order           <= v-fact-date-num
      698     or p-shift-end-fact-order <= v-fact-date-num
      699     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      700     or p-shift-end-fact-order >= p-day-end-fact-order
      701     then do:
      702       message
      703         vss-workfile vss-revision vss-description skip
      704         "Внутренняя ошибка при генерации фактического номера" skip
      705         "p-fact-date"            p-fact-date            skip
      706         "p-fact-time"            p-fact-time            skip
      707         "p-fact-num"             p-fact-num             skip
      708         "p-shift-date"           p-shift-date           skip
      709         "p-shift-num"            p-shift-num            skip
      710         "p-shift-on"             p-shift-on             skip
      711         "p-shift-end-fact-order" p-shift-end-fact-order skip
      712         "p-day-end-fact-order"   p-day-end-fact-order   skip
      713         "v-fact-date-num"        v-fact-date-num        skip
      714         view-as alert-box error .
      715       undo, return error return-value .
      716     end.
      717   end procedure.
      718   procedure day-begin-fact-order :
      719     define input  parameter p-fact-date            as date    no-undo .
      720     define output parameter p-day-begin-fact-order as decimal no-undo .
      721     do
      722     on error undo, return error return-value
      723     :
      724       if p-fact-date = ?
      725       then do:
      726         assign
      727           p-day-begin-fact-order = 0
      728         .
      729       end.
      730       else do:
      731         assign
      732           p-day-begin-fact-order = integer(p-fact-date)
      733         .
      734       end.
      735     end.
      736   end procedure.
      737   procedure factord-max-fact-order :
      738     define output parameter p-max-fact-order as decimal   no-undo .
      739     do
      740     on error undo, return error return-value
      741     :
      742       run day-begin-fact-order in this-procedure
      743         (input  date(1, 1, 5000)
      744         ,output p-max-fact-order
      745         ) .
      746     end.
      747   end procedure.
      748   procedure factord-cut-archive :
      749     define input  parameter p-obj-type             as character no-undo .
      750     define input  parameter p-obj-code             as integer   no-undo .
      751     define input  parameter p-fact-date            as date      no-undo .
      752     define output parameter p-shift-on             as logical   no-undo .
      753     define output parameter p-shift-date           as date      no-undo .
      754     define output parameter p-shift-num            as integer   no-undo .
      755     define output parameter p-day-end-fact-order   as decimal   no-undo .
      756     define output parameter p-shift-end-fact-order as decimal   no-undo .
      757     define variable v-fact-order as decimal   no-undo .
      758     define buffer buf_shift-obj for ub.shift-obj .
      759     do
      760     on error undo, return error return-value
      761     :
      762   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      764     (input  p-obj-type
      765     ,input  p-obj-code
      766     ,input  'shift-on=request'
      767     ,output p-shift-on
      768     ) no-error .
      769       if error-status :error
      770       then do:
      771         message
      772           vss-workfile vss-revision vss-description skip
      773           "Ошибка при определении атрибута объекта" skip
      774           "Объект" p-obj-type p-obj-code skip
      775           error-status :get-message(1) skip
      776           return-value skip
      777           view-as alert-box error .
      778         undo, return error return-value .
      779       end.
      780       if p-shift-on = false
      781       then do:
      782         assign
      783           p-shift-date               = ?
      784           p-shift-num                = 0
      785         .
      786       end.
      787       else do:
      788         find first buf_shift-obj share-lock
      789           where buf_shift-obj.obj-type   = p-obj-type
      790             and buf_shift-obj.obj-code   = p-obj-code
      791             and buf_shift-obj.shift-date > p-fact-date
      792           use-index pi
      793           no-error .
      794         if not available buf_shift-obj
      795         or buf_shift-obj.status_ <> 'зкр':U
      796         then do:
      797           message
      798             vss-workfile vss-revision vss-description skip
      799             "Невозможно вычислить последнюю смену" skip
      800             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      801             "Объект" p-obj-type p-obj-code skip
      802             "Дата" p-fact-date skip
      803             view-as alert-box error .
      804           undo, return error return-value .
      805         end.
      806         find last buf_shift-obj share-lock
      807           where buf_shift-obj.obj-type = p-obj-type
      808             and buf_shift-obj.obj-code = p-obj-code
      809             and buf_shift-obj.shift-date <= p-fact-date
      810           use-index pi
      811           no-error .
      812         if available buf_shift-obj
      813         then do:
      814           if  buf_shift-obj.status_ = 'зкр':U
      815           then do:
      816             assign
      817               p-shift-date = buf_shift-obj.shift-date
      818               p-shift-num  = buf_shift-obj.shift-num
      819             .
      820           end.
      821           else do:
      822             message
      823               vss-workfile vss-revision vss-description skip
      824               "Невозможно вычислить последнюю смену" skip
      825               "Статус смены отличен от статуса" 'зкр':U skip
      826               "Объект" p-obj-type p-obj-code skip
      827               "Дата" p-fact-date skip
      828               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      829               view-as alert-box error .
      830             undo, return error return-value .
      831           end.
      832         end.
      833         else do:
      834           assign
      835             p-shift-date = p-fact-date - 1
      836             p-shift-num  = 1
      837           .
      838         end.
      839       end.
      840       run factord in this-procedure
      841         (input  p-fact-date
      842         ,input  1
      843         ,input  1
      844         ,input  p-shift-date
      845         ,input  p-shift-num
      846         ,input  p-shift-on
      847         ,output v-fact-order
      848         ,output p-shift-end-fact-order
      849         ,output p-day-end-fact-order
      850         ) no-error .
      851       if error-status :error
      852       then do:
      853         message
      854           vss-workfile vss-revision vss-description skip
      855           "Ошибка при вызове процедуры factord"
      856           error-status :get-message(1) skip
      857           return-value skip
      858           view-as alert-box error .
      859         undo, return error return-value .
      860       end.
      861     end.
      862   end procedure.
      863   procedure factord-lock-shift :
      864     define input  parameter p-obj-type  as character no-undo .
      865     define input  parameter p-obj-code  as integer   no-undo .
      866     define input  parameter p-fact-date as date      no-undo .
      867     define parameter buffer buf_shift-obj for ub.shift-obj .
      868     define variable v-shift-on      as logical   no-undo .
      869     define variable v-extra-message as character no-undo .
      870     define variable v-error as character no-undo .
      871     do
      872     on error undo, return error return-value
      873     :
      874   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      876     (input  p-obj-type
      877     ,input  p-obj-code
      878     ,input  'shift-on=request'
      879     ,output v-shift-on
      880     ) no-error .
      881       if error-status :error
      882       then do:
      883         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      884         undo, return error v-error .
      885       end.
      886       if v-shift-on = true
      887       then do:
      888         find first buf_shift-obj share-lock
      889           where buf_shift-obj.obj-type   = p-obj-type
      890             and buf_shift-obj.obj-code   = p-obj-code
      891             and buf_shift-obj.shift-date > p-fact-date
      892           use-index pi
      893           no-error .
      894         if not available buf_shift-obj
      895         or buf_shift-obj.status_ <> 'зкр':U
      896         then do:
      897           find last buf_shift-obj
      898             where buf_shift-obj.obj-type = p-obj-type
      899               and buf_shift-obj.obj-code = p-obj-code
      900               and buf_shift-obj.status_  = 'зкр':U
      901             use-index stts
      902             no-error .
      903           if available buf_shift-obj
      904           then do:
      905             assign
      906               v-extra-message =
      907                     substitute("Дата начала последеней закрытой смены на объекте &1"
      908                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      909                               )
      910             .
      911           end.
      912           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      913           undo, return error v-error .
      914         end.
      915       end.
      916     end.
      917   end procedure.
      918   procedure factord-end-day :
      919     define input  parameter p-fact-date            as date    no-undo .
      920     define output parameter p-day-end-fact-order   as decimal no-undo .
      921     do
      922     on error undo, return error return-value
      923     :
      924       if p-fact-date = ?
      925       then do:
      926         return error "Не указана фактическая дата" .
      927       end.
      928       assign
      929         p-day-end-fact-order = integer(p-fact-date) + 0.99
      930       .
      931     end.
      932   end procedure.
      933   procedure factord-to-date :
      934     define input  parameter p-fact-order as decimal no-undo .
      935     define output parameter p-fact-date  as date    no-undo .
      936     define variable v-ref-date  as date      no-undo .
      937     define variable v-ref-delta as integer   no-undo .
      938     do
      939     on error undo, return error return-value
      940     :
      941       if p-fact-order = ?
      942       or p-fact-order = 0
      943       then do:
      944         return error "Не указан fact-order" .
      945       end.
      946       assign
      947         v-ref-date  = date(1, 1, 2000)
      948       .
      949       assign
      950         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      951       .
      952       assign
      953         p-fact-date = v-ref-date + v-ref-delta
      954       .
      955     end.
      956   end procedure.
      957   procedure factord-to-fact-num :
      958     define input  parameter p-fact-order as decimal no-undo .
      959     define output parameter p-fact-num   as integer no-undo .
      960     define variable v-fact-order-trunc as decimal no-undo .
      961     do
      962     on error undo, return error return-value
      963     :
      964       if p-fact-order = ?
      965       or p-fact-order = 0
      966       then do:
      967         return error "Не указан fact-order" .
      968       end.
      969       assign
      970        v-fact-order-trunc = truncate(p-fact-order, 2)
      971       .
      972       assign
      973         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      974       .
      975     end.
      976   end procedure.
      977   procedure factord-to-shift-num :
      978     define input  parameter p-fact-order as decimal no-undo .
      979     define output parameter p-shift-num   as integer no-undo .
      980     define variable  p-shift-numd  as decimal   no-undo .
      981     define variable v-fact-order-trunc as decimal no-undo .
      982     do
      983     on error undo, return error return-value
      984     :
      985       if p-fact-order = ?
      986       or p-fact-order = 0
      987       then do:
      988         return error "Не указан fact-order" .
      989       end.
      990       assign
      991        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      992       .
      993       if v-fact-order-trunc < 0.5 then do:
      994         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      995       end.
      996       assign
      997         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      998         .
      999        assign
     1000         p-shift-num = truncate (p-shift-numd , 0)
     1001       .
     1002     end.
     1003   end procedure.
     1004   procedure fact-order-mpl :
     1005     do
     1006     on error undo, return error return-value
     1007     :
     1008   define input  parameter p-doc-date as date     no-undo .
     1009   define input  parameter p-obj-type as character no-undo .
     1010   define input  parameter p-obj-code as integer   no-undo .
     1011   define output parameter p-fact-order as decimal   no-undo .
