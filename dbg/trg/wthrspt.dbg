     1233      if available buf_pay-type
     1234         then v-trn-pay-code = buf_pay-type.obj-code.
     1235         else v-trn-pay-code =  0.
     1236   end.
     1237   else v-trn-pay-code = 0 .
     1238   if p-cash-pay-type <> "" then do:
     1239      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1240      if available buf_pay-type
     1241         then
     1242           assign
     1243             v-cash-pay-curr = buf_cash-pay.curr-code
     1244             v-cash-pay-code = buf_cash-pay.cdpay-code
     1245           .
     1246         else
     1247           assign
     1248             v-cash-pay-curr = 0
     1249             v-cash-pay-code = 0
     1250             .
     1251   end.
     1252   else
     1253     assign
     1254       v-cash-pay-curr = 0
     1255       v-cash-pay-code = 0
     1256       .
     1257   for each tt_price-all  : delete tt_price-all . end.
     1258   assign
     1259     p-plt-id             = ?
     1260     p-plt-db-num         = ?
     1261     p-pdf-id             = ?
     1262     p-pdf-db-num         = ?
     1263     p-sale-price-base    = ?
     1264     p-sale-price-rubl    = ?
     1265     v-cli-oborot         = 0
     1266   .
