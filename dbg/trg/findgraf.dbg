        1   block-level on error undo, throw.
        2   define input  parameter p-host-code           like ub.fin-doc.host-code    no-undo .
        3   define input  parameter p-fin-doc-code        like ub.fin-doc.fin-doc-code no-undo .
        4   define input  parameter p-mode                as character                 no-undo .
        5   define input  parameter p-author             as character                 no-undo .
        6   define input  parameter p-status-current      like ub.fin-doc.status_      no-undo .
        7   define input  parameter p-status-date         like ub.fin-doc.fact-date    no-undo .
        8   define output parameter p-status_             like ub.fin-doc.status_      no-undo .
        9   define output parameter p-ask-date            as logical                   no-undo .
       10   define output parameter p-ask-message         as character                 no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Стандартный граф переходов финансовых документов".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define new global shared variable g#lib-farh as handle no-undo .
       87   define variable v-db-num like ub.db.db-num no-undo .
       88   define variable v-obj-db-num as integer no-undo init -1.
       89   define variable v-author as character no-undo .
       90   define buffer buf_sysconf for ub.sysconf.
       91   define buffer buf_fin-doc for ub.fin-doc.
       92   define buffer bf_clients for ub.clients.
       93   define buffer bf_db for ub.db .
       94   do on error undo, return error substitute ("Ошибка при вызове программы findgraf.p: &1 &2 &3 &4 при работе с документом &4.", error-status:get-message(1), error-status:get-message(2), return-value, p-host-code, p-fin-doc-code):
       95     if p-mode <> '<закрытие документа>':U
       96     AND p-mode <> '<открытие документа>':U
       97     AND p-mode <> '<закрытие документа на факт>':U
       98     AND p-mode <> '<отказ от документа>':U
       99        then do:
      100        return error substitute ("Неверный режим обработки документа &1.", p-mode).
      101     end.
      102   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      104     (output v-db-num
      105     ) no-error .
      106     if error-status:error then do:
      107       return error "Ошибка при определении номер текущей БД".
      108     end.
      109     find first buf_sysconf where
      110                buf_sysconf.host-code = p-host-code no-error.
      111     if not available buf_sysconf then do:
      112        return error substitute ("Не найдена фирма с номером &1 для платежа", p-host-code, p-fin-doc-code).
      113     end.
      114     find first buf_fin-doc where
      115               buf_fin-doc.host-code = p-host-code
      116           AND buf_fin-doc.fin-doc-code = p-fin-doc-code no-lock no-error.
      117     if not available buf_fin-doc then do:
      118        return error substitute ("Не найден платеж: фирма &1 с номером &2.", p-host-code, p-fin-doc-code).
      119     end.
      120     if buf_sysconf.firm-db-num = ? or
      121        buf_sysconf.firm-db-num < 0 then do:
      122        return error substitute ("Неверный номер базы данных &1 фирмы &2.", buf_sysconf.firm-db-num, buf_sysconf.host-code).
      123     end.
      124     find first bf_db where bf_db.db-num = buf_sysconf.firm-db-num no-lock no-error.
      125     if not available bf_db then do:
      126        return error substitute("Не найдена БД &1 документа &2 для фирмы &3.", buf_sysconf.firm-db-num, p-fin-doc-code, buf_sysconf.host-code).
      127     end.
      128     if buf_fin-doc.obj-type <> ''
      129     or buf_fin-doc.obj-code <> 0 then do:
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      132     (input  buf_fin-doc.obj-type
      133     ,input  buf_fin-doc.obj-code
      134     ,output v-obj-db-num
      135     )  .
      136     end.
      137     if not (v-db-num = buf_sysconf.firm-db-num
      138            or
      139            v-db-num = v-obj-db-num)
      140     then do:
      141       return error substitute("Нельзя изменять запись ПЛАТЕЖА в БД, отличной от главной БД фирмы и/или БД объекта:&1" +
      142                                "платеж &2&1" +
      143                                "номер текущей БД &3, номер главной БД фирмы &4, номер БД объекта &5"
      144                                , chr(10)
      145                                , buf_fin-doc.fin-doc-code
      146                                , v-db-num
      147                                , buf_sysconf.firm-db-num
      148                                , (if v-obj-db-num = -1 then "неопределена" else string(v-obj-db-num))
      149                                ).
      150     end.
      151     find first bf_clients where bf_clients.obj-type = buf_fin-doc.payer-type and
      152                                 bf_clients.obj-code = buf_fin-doc.payer-code no-lock no-error.
      153     if not available bf_clients then do:
      154        return error substitute ("Не найден плательщик &1 &2 для платежа &3.", buf_fin-doc.payer-type, buf_fin-doc.payer-code, buf_fin-doc.fin-doc-code).
      155     end.
      156     find first bf_clients where bf_clients.obj-type = buf_fin-doc.receiver-type and
      157                                 bf_clients.obj-code = buf_fin-doc.receiver-code no-lock no-error.
      158     if not available bf_clients then do:
      159        return error substitute ("Не найден получатель &1 &2 для платежа &3.", buf_fin-doc.receiver-type, buf_fin-doc.receiver-code, buf_fin-doc.fin-doc-code).
      160     end.
      161     if buf_fin-doc.status_ = 'факт':U then do:
      162        return error substitute ("Платеж &1 для фирмы &2 закрыт до факта. " + chr(10) + "Операции с ним не допустимы.", buf_fin-doc.prn-doc-code, buf_sysconf.host-code).
      163     end.
      164     run trg/findgrfp.p (
      165                      input this-procedure:handle
      166                     ,input  buf_fin-doc.fin-doc-type
      167                     ,input  buf_fin-doc.fin-ext-doc-type
      168                     ,input  buf_fin-doc.status_
      169                     ,input  p-mode
      170                     ,input  p-author
      171                     ,input  p-status-date
      172                     ,output p-status_
      173                     ,output p-ask-date
      174                     ,output p-ask-message
      175                     ) no-error.
      176     if error-status:error then do:
      177        return error substitute ("Ошибка:  &1"          + chr(10)
      178                                 + "по операции: &2"    + chr(10)
      179                                 + "номер документа &3" + chr(10)
      180                                 + "тип &4"             + chr(10)
      181                                 + "расш.тип &5"        + chr(10)
      182                                 + "статус &6"          + chr(10)
      183                                 ,
      184                                 return-value,
      185                                 p-mode,
      186                                 buf_fin-doc.fin-doc-code,
      187                                 buf_fin-doc.fin-doc-type,
      188                                 buf_fin-doc.fin-ext-doc-type,
      189                                 buf_fin-doc.status_
      190                                 ).
      191     end.
      192   end.
      193   procedure check-cl-bank :
      194   define buffer buf_fin-schet for ub.fin-schet.
      195   define buffer buf_fin-bank  for ub.fin-bank.
      196     do
      197     on error undo, return error
      198     :
      199     CASE buf_fin-doc.fin-ext-doc-type:
      200       when 'ппп':U then do:
      201         find first buf_fin-schet no-lock where
      202                   buf_fin-schet.host-code = buf_fin-doc.host-code
      203               AND buf_fin-schet.code-schet = buf_fin-doc.receiver-code-schet .
      204       end.
      205       when 'рпп':U then do:
      206         find first buf_fin-schet no-lock where
      207                   buf_fin-schet.host-code = buf_fin-doc.host-code
      208               AND buf_fin-schet.code-schet = buf_fin-doc.payer-code-schet .
      209       end.
      210     END CASE.
      211     find first buf_fin-bank no-lock where
      212               buf_fin-bank.host-code = buf_fin-doc.host-code
      213           AND buf_fin-bank.code-bank = buf_fin-schet.code-bank.
      214     if buf_fin-bank.cl-bank <> '':U then do:
      215       return error substitute("Платеж &1 для фирмы &2 проходит по счету банка&3 &4, который подключен к системе КЛИЕНТ-БАНК. ВРУЧНУЮ обработать невозможно"
      216                               , buf_fin-doc.prn-doc-code
      217                               , buf_sysconf.host-code
      218                               , chr(10)
      219                               , buf_fin-bank.bank-name).
      220     end.
      221     end.
      222   end procedure.
