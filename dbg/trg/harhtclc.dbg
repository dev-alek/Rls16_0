        1   block-level on error undo, throw.
        2   define input  parameter p-cat-code       like ub.hold-time.cat-code no-undo .
        3   define input  parameter p-lock-code      as character no-undo .
        4   define input  parameter p-btpr-type-code as character no-undo .
        5   define input  parameter p-doc-code       like ub.trn-doc.doc-code no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Расчет межфирменного архива по одному документу".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2|&3|&4':u,p-cat-code,p-lock-code,p-btpr-type-code,p-doc-code)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   PROCEDURE LastDate:
       86       def input parameter in-date as date no-undo.
       87       def output parameter LastDate as date no-undo.
       88       LastDate = ((DATE(MONTH(in-date),28,YEAR(in-date)) + 4) - DAY(DATE(MONTH(in-date),28,YEAR(in-date)) + 4)).
       89   END PROCEDURE.
       90   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure create-hold-time :
       92   define input parameter p-cat-code like ub.hold-time.cat-code no-undo .
       93   define input parameter p-start-date like ub.hold-time.start-date no-undo .
       94   DEFINE VARIABLE v-end-date like ub.hold-time.end-date no-undo .
       95   define buffer buf_hold-time for ub.hold-time .
       96   define buffer last_hold-time for ub.hold-time .
       97     do
       98     on error undo, return error
       99     :
      100       find last last_hold-time no-lock
      101         where last_hold-time.cat-code = p-cat-code
      102         use-index pi
      103         no-error .
      104       run gbl/lastdate.p
      105         (input p-start-date
      106         ,output v-end-date)
      107         no-error .
      108       if error-status :error then do:
      109         message
      110         vss-workfile vss-revision vss-description skip
      111         "Ошибка поиска последней даты периода" skip
      112         "Дата начала периода" p-start-date
      113         error-status :get-message(1) skip
      114         return-value skip
      115         view-as alert-box error .
      116         undo, return error.
      117       end.
      118       create buf_hold-time.
      119       assign
      120         buf_hold-time.cat-code       = p-cat-code
      121         buf_hold-time.time-code      = (if available last_hold-time
      122                                         then (last_hold-time.time-code + 1)
      123                                         else 1)
      124         buf_hold-time.time-type      = 'мес':U
      125         buf_hold-time.start-date     = p-start-date
      126         buf_hold-time.end-date       = v-end-date
      127         buf_hold-time.create-date    = today
      128         buf_hold-time.update-date    = today
      129         buf_hold-time.grpupdate-date = today
      130       .
      131     end.
      132   end procedure.
      133   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define new global shared variable g#trdcalib as handle no-undo.
      135   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   procedure holdprts-create-parts-supp :
      137     define input  parameter p-orig-in-code   like ub.parts-supp.orig-in-code   no-undo .
      138     define input  parameter p-orig-part-code like ub.parts-supp.orig-part-code no-undo .
      139     define input  parameter p-in-code        like ub.parts-supp.in-code        no-undo .
      140     define input  parameter p-artic          like ub.parts-supp.artic          no-undo .
      141     define input  parameter p-prod-type      like ub.parts-supp.prod-type      no-undo .
      142     define input  parameter p-prod-code      like ub.parts-supp.prod-code      no-undo .
      143     define input  parameter p-part-code      like ub.parts-supp.part-code      no-undo .
      144     define variable vss-description as character no-undo init "holdprts-create-parts-supp-01: скопировать атрибут партии".
      145     define buffer buf_parent_trn-doc  for ub.trn-doc .
      146     define buffer buf_child_trn-doc   for ub.trn-doc .
      147     define buffer buf_parts           for ub.parts .
      148     define buffer buf_parts-supp      for ub.parts-supp .
      149     define buffer buf_orig_parts-supp for ub.parts-supp .
      150     define buffer buf_income_trn-doc  for ub.trn-doc .
      151     define buffer buf_income_doc-line for ub.doc-line .
      152     define buffer buf_goods           for ub.goods .
      153       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      154       define buffer   in-vatp-parts    for ub.parts   .
      155       define buffer   in-vatp-doc      for ub.trn-doc .
      156       define buffer   in-vatp-goods    for ub.goods   .
      157       define buffer   in-vatp-sysconf  for ub.sysconf .
      158       define buffer   in-vatp_doc-attr for ub.doc-attr.
      159       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      160       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      161       define variable varinvprb                  as   character              no-undo.
      162       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      163       define variable cli-base-rate              as   decimal                no-undo.
      164       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      165       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      166       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      167       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      168       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      169       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      170       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      171       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      172       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      173       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      174       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      175       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      176       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      177       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      178       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      179       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      180       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      181       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      182       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      183       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      184       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      185       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      186       define variable varinvatp-envd             as   character              no-undo.
      187       define variable varinvatp-type             as   character              no-undo.
      188     do
      189     on error undo, return error return-value
      190     :
      191       find first buf_child_trn-doc no-lock
      192         where buf_child_trn-doc.doc-code = p-in-code
      193         no-error .
      194       if not available buf_child_trn-doc
      195       then do:
      196         return substitute("Не найден исходный документ &1", p-in-code) .
      197       end.
      198       find first buf_parent_trn-doc no-lock
      199         where buf_parent_trn-doc.doc-code = buf_child_trn-doc.hold-doc-code-parent
      200         no-error .
      201       if not available buf_parent_trn-doc
      202       then do:
      203         return substitute("Не найден приходный документ &1", buf_child_trn-doc.hold-doc-code-parent) .
      204       end.
      205       find first buf_parts-supp exclusive-lock
      206         where buf_parts-supp.in-code   = p-in-code
      207           and buf_parts-supp.artic     = p-artic
      208           and buf_parts-supp.prod-type = p-prod-type
      209           and buf_parts-supp.prod-code = p-prod-code
      210           and buf_parts-supp.part-code = p-part-code
      211         no-error .
      212       if available buf_parts-supp
      213       then do:
      214         message
      215           vss-workfile vss-revision vss-description skip
      216           vss-include-info3 skip
      217           "Попытка повторного создания партии атрибутов" skip
      218           "Документ прихода" p-in-code skip
      219           "Артикул" p-artic p-prod-type p-prod-code skip
      220           "Код партии" p-part-code skip
      221           "Исходный код партии" p-orig-in-code skip
      222           "Исходный код документа" p-orig-part-code skip
      223           view-as alert-box error .
      224         undo, return error .
      225       end.
      226       create buf_parts-supp .
      227       assign
      228         buf_parts-supp.in-code   = p-in-code
      229         buf_parts-supp.artic     = p-artic
      230         buf_parts-supp.prod-type = p-prod-type
      231         buf_parts-supp.prod-code = p-prod-code
      232         buf_parts-supp.part-code = p-part-code
      233       .
      234       assign
      235         buf_parts-supp.orig-in-code   = p-orig-in-code
      236         buf_parts-supp.orig-part-code = p-orig-part-code
      237       .
      238       find first buf_orig_parts-supp share-lock
      239         where buf_orig_parts-supp.in-code   = p-orig-in-code
      240           and buf_orig_parts-supp.artic     = p-artic
      241           and buf_orig_parts-supp.prod-type = p-prod-type
      242           and buf_orig_parts-supp.prod-code = p-prod-code
      243           and buf_orig_parts-supp.part-code = p-orig-part-code
      244         no-error .
      245       if available buf_orig_parts-supp
      246       then do:
      247         buffer-copy buf_orig_parts-supp
      248         except
      249           buf_orig_parts-supp.in-code
      250           buf_orig_parts-supp.artic
      251           buf_orig_parts-supp.prod-type
      252           buf_orig_parts-supp.prod-code
      253           buf_orig_parts-supp.part-code
      254           buf_orig_parts-supp.orig-in-code
      255           buf_orig_parts-supp.orig-part-code
      256         to buf_parts-supp.
      257       end.
      258       else do:
      259         find first buf_parts share-lock
      260           where buf_parts.obj-type  = buf_parent_trn-doc.obj-type
      261             and buf_parts.obj-code  = buf_parent_trn-doc.obj-code
      262             and buf_parts.artic     = p-artic
      263             and buf_parts.prod-type = p-prod-type
      264             and buf_parts.prod-code = p-prod-code
      265             and buf_parts.in-code   = p-orig-in-code
      266             and buf_parts.out-code  = buf_parent_trn-doc.doc-code
      267             and buf_parts.part-code = p-orig-part-code
      268           no-error .
      269         if not available buf_parts
      270         then do:
      271           message
      272             vss-workfile vss-revision vss-description skip
      273             vss-include-info3 skip
      274             "Ошибка задания входных параметров" skip
      275             "Не найдена исходная партия" skip
      276             "Исходный документ" p-orig-in-code skip
      277             "Артикул" p-artic p-prod-type p-prod-code skip
      278             "Код партии" p-orig-part-code skip
      279             view-as alert-box error .
      280           undo, return error .
      281         end.
      282         define variable v-base-rate         as decimal   no-undo .
      283         define variable v-base-scale        as integer   no-undo .
      284         define variable v-exch-rate         as decimal   no-undo .
      285         define variable v-exch-scale        as integer   no-undo .
      286         define variable v-extended-doc-type as character no-undo .
      287         define variable v-unit-cli          as character no-undo .
      288         find first buf_income_trn-doc no-lock
      289           where buf_income_trn-doc.doc-code = p-orig-in-code
      290           no-error .
      291         if available buf_income_trn-doc
      292         then do:
      293           find first buf_income_doc-line no-lock
      294             where buf_income_doc-line.doc-code  = p-orig-in-code
      295               and buf_income_doc-line.artic     = p-artic
      296               and buf_income_doc-line.prod-type = p-prod-type
      297               and buf_income_doc-line.prod-code = p-prod-code
      298             no-error .
      299           if not available buf_income_doc-line
      300           then do:
      301             message
      302               vss-workfile vss-revision vss-description skip
      303               vss-include-info3 skip
      304               "Не найдена исходная строка документа прихода" skip
      305               "Исходный документ" p-orig-in-code skip
      306               "Артикул" p-artic p-prod-type p-prod-code skip
      307               "Код партии" p-orig-part-code skip
      308               view-as alert-box error .
      309             undo, return error .
      310           end.
      311           assign
      312             v-base-rate         = buf_income_trn-doc.base-rate
      313             v-base-scale        = buf_income_trn-doc.base-scale
      314             v-exch-rate         = buf_income_trn-doc.exch-rate
      315             v-exch-scale        = buf_income_trn-doc.exch-scale
      316             v-extended-doc-type = buf_income_trn-doc.ext-doc-type
      317             v-unit-cli          = buf_income_doc-line.unit-cli
      318           .
      319         end.
      320         else do:
      321           find first buf_goods no-lock
      322             where buf_goods.artic     = buf_parts.artic
      323               and buf_goods.prod-type = buf_parts.prod-type
      324               and buf_goods.prod-code = buf_parts.prod-code
      325             .
      326           assign
      327             v-base-rate         = buf_parts.price-rubl / buf_parts.price-base
      328             v-base-scale        = 1
      329             v-exch-rate         = buf_parts.price-rubl / (buf_parts.price-cli * buf_parts.cli-base-rate)
      330             v-exch-scale        = 1
      331             v-extended-doc-type = 'ie':U
      332             v-unit-cli          = buf_goods.unit-cli
      333           .
      334         end.
      335          if v-base-rate = ? then v-base-rate = 1.
      336          if v-exch-rate = ? then v-exch-rate = 1.
      337   assign
      338     price-rubl-with-tax-loc = buf_parts.price-rubl
      339     price-base-with-tax-loc = buf_parts.price-base
      340   .
      341   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      342   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      343     (output varinvprb
      344     )  .
      345     if buf_parts.out-code = 'free-zone':U     or
      346        buf_parts.out-code = 'out-zone':U   or
      347        buf_parts.doc-type = 'акт':U then do:
      348       assign
      349         in-vatp-have-vat-slt = yes.
      350     end.
      351     else do:
      352       find first in-vatp_doc-attr no-lock
      353         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      354           and in-vatp_doc-attr.attr-code = 'envd':U
      355         no-error .
      356       if not available in-vatp_doc-attr then do:
      357         assign
      358           in-vatp-have-vat-slt = yes.
      359       end.
      360       else do:
      361            in-vatp-have-vat-slt = no.
      362       end.
      363     end.
      364     assign
      365      price-cli-with-tax-loc = buf_parts.price-cli
      366      cli-base-rate          = buf_parts.cli-base-rate.
      367     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      368              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      369     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      370             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      371             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      372             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      373             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      374             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      375             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      376       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      377     assign
      378       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      379     assign
      380       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      381       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      382       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      383       transport-cli-loc  = 0
      384       other-cli-loc      = 0
      385     .
      386   ASSIGN
      387             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      388       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      389   .
      390         assign
      391           buf_parts-supp.PS                = buf_parts.PS
      392           buf_parts-supp.SLT-type          = buf_parts.SLT-type
      393           buf_parts-supp.VAT-type          = buf_parts.VAT-type
      394           buf_parts-supp.base-rate         = v-base-rate
      395           buf_parts-supp.base-scale        = v-base-scale
      396           buf_parts-supp.cli-qnty          = buf_parts.cli-qnty
      397           buf_parts-supp.cst-code          = buf_parts.cst-code
      398           buf_parts-supp.doc-qnty          = buf_parts.qnty
      399           buf_parts-supp.exch-code         = buf_parts.exch-code
      400           buf_parts-supp.exch-rate         = v-exch-rate
      401           buf_parts-supp.exch-scale        = v-exch-scale
      402           buf_parts-supp.extended-doc-type = v-extended-doc-type
      403           buf_parts-supp.fact-date         = buf_parts.fact-date
      404           buf_parts-supp.fact-qnty         = buf_parts.fact-qnty
      405           buf_parts-supp.last-date         = buf_parts.last-date
      406           buf_parts-supp.pay-code          = buf_parts.pay-code
      407           buf_parts-supp.price-cli         = buf_parts.price-cli
      408           buf_parts-supp.purch-code        = buf_parts.purch-code
      409           buf_parts-supp.supp-code         = buf_parts.supp-code
      410           buf_parts-supp.supp-type         = buf_parts.supp-type
      411           buf_parts-supp.unit-cli          = v-unit-cli
      412         .
      413         assign
      414           buf_parts-supp.vat-pc         = vat-pc-loc
      415           buf_parts-supp.slt-pc         = slt-pc-loc
      416           buf_parts-supp.price-base     = price-base-with-tax-loc
      417           buf_parts-supp.price-rubl     = price-rubl-with-tax-loc
      418           buf_parts-supp.vat-base       = vat-base-loc
      419           buf_parts-supp.vat-rubl       = vat-rubl-loc
      420           buf_parts-supp.slt-base       = slt-base-loc
      421           buf_parts-supp.slt-rubl       = slt-rubl-loc
      422           buf_parts-supp.road-tax-base  = road-tax-base-loc
      423           buf_parts-supp.road-tax-rubl  = road-tax-rubl-loc
      424           buf_parts-supp.transport-base = transport-base-loc
      425           buf_parts-supp.transport-rubl = transport-rubl-loc
      426           buf_parts-supp.other-base     = other-base-loc
      427           buf_parts-supp.other-rubl     = other-rubl-loc
      428         .
      429       end.
      430     end.
      431   end procedure.
      432   procedure holdprts-get-part-code :
      433     define input  parameter p-doc-code       as character no-undo .
      434     define output parameter p-hold-part-code as integer   no-undo .
      435     define variable vss-description as character no-undo init "holdprts-get-part-code-01: создать уникальный код партии внутри документа".
      436     define variable v-attr-value as character no-undo .
      437     define variable v-attr-type  as character no-undo .
      438     define buffer buf_trn-doc for ub.trn-doc .
      439     do
      440     on error undo, return error return-value
      441     :
      442       find first buf_trn-doc exclusive-lock
      443         where buf_trn-doc.doc-code = p-doc-code
      444         no-error .
      445       if not available buf_trn-doc
      446       then do:
      447         message
      448           vss-workfile vss-revision vss-description skip
      449           vss-include-info3 skip
      450           "Ошибка задания входных параметров" skip
      451           "Не найден документ" p-doc-code skip
      452           view-as alert-box error .
      453         undo, return error .
      454       end.
      455   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      456                           input 'hold-part-code':U ,
      457                          output v-attr-value ,
      458                          output v-attr-type )  .
      459       assign
      460         p-hold-part-code = integer(v-attr-value) + 1
      461       .
      462   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
      463                          input 'hold-part-code':U ,
      464                          input string(p-hold-part-code) )  .
      465     end.
      466   end procedure.
      467   procedure holdprts-validate-document :
      468     define input  parameter p-doc-code as character no-undo .
      469     define variable vss-description as character no-undo init "holdprts-validate-document-01: проверить правильность документа".
      470     define buffer buf_trn-doc    for ub.trn-doc .
      471     define buffer parent_trn-doc for ub.trn-doc .
      472     define buffer buf_parts      for ub.parts .
      473     define buffer buf_parts-supp for ub.parts-supp .
      474     do
      475     on error undo, return error return-value
      476     :
      477       find first buf_trn-doc exclusive-lock
      478         where buf_trn-doc.doc-code = p-doc-code
      479         no-error .
      480       if not available buf_trn-doc
      481       then do:
      482         message
      483           vss-workfile vss-revision vss-description skip
      484           vss-include-info3 skip
      485           "Ошибка задания входных параметров" skip
      486           "Не найден документ" p-doc-code skip
      487           view-as alert-box error .
      488         undo, return error .
      489       end.
      490       find first parent_trn-doc exclusive-lock
      491         where parent_trn-doc.doc-code = buf_trn-doc.hold-doc-code-parent
      492         no-error .
      493       if not available parent_trn-doc
      494       then do:
      495         message
      496           vss-workfile vss-revision vss-description skip
      497           vss-include-info3 skip
      498           "Не найден родительский документ" skip
      499           "Документ" buf_trn-doc.doc-code skip
      500           "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
      501           view-as alert-box error .
      502         undo, return error .
      503       end.
      504       if buf_trn-doc.ext-doc-type <> 'ie':U
      505       then do:
      506         return .
      507       end.
      508       for each buf_parts share-lock
      509         where buf_parts.out-code = buf_trn-doc.doc-code
      510       on error undo, return error
      511       :
      512         find first buf_parts-supp share-lock
      513           where buf_parts-supp.in-code   = buf_parts.in-code
      514             and buf_parts-supp.artic     = buf_parts.artic
      515             and buf_parts-supp.prod-type = buf_parts.prod-type
      516             and buf_parts-supp.prod-code = buf_parts.prod-code
      517             and buf_parts-supp.part-code = buf_parts.part-code
      518           no-error .
      519         if not available buf_parts-supp
      520         then do:
      521           message
      522             vss-workfile vss-revision vss-description skip
      523             vss-include-info3 skip
      524             "Не найдена информация о поставщике" skip
      525             "Документ" buf_trn-doc.doc-code skip
      526             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
      527             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
      528             "Номер партии" buf_parts.part-code skip
      529             view-as alert-box error .
      530           undo, return error .
      531         end.
      532       end.
      533       for each buf_parts-supp share-lock
      534         where buf_parts-supp.in-code = buf_trn-doc.doc-code
      535       on error undo, return error
      536       :
      537         find first buf_parts share-lock
      538           where buf_parts.out-code  = buf_parts-supp.in-code
      539             and buf_parts.obj-type  = buf_trn-doc.obj-type
      540             and buf_parts.obj-code  = buf_trn-doc.obj-code
      541             and buf_parts.artic     = buf_parts-supp.artic
      542             and buf_parts.prod-type = buf_parts-supp.prod-type
      543             and buf_parts.prod-code = buf_parts-supp.prod-code
      544             and buf_parts.part-code = buf_parts-supp.part-code
      545           no-error .
      546         if not available buf_parts
      547         then do:
      548           message
      549             vss-workfile vss-revision vss-description skip
      550             vss-include-info3 skip
      551             "Задана информация о поставщике для неизвестной партии" skip
      552             "Документ" buf_trn-doc.doc-code skip
      553             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
      554             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
      555             "Номер партии" buf_parts.part-code skip
      556             view-as alert-box error .
      557           undo, return error .
      558         end.
      559       end.
      560       for each buf_parts share-lock
      561         where buf_parts.out-code = buf_trn-doc.hold-doc-code-parent
      562       on error undo, return error
      563       :
      564         if  buf_trn-doc.doc-type = 'при':U
      565         and buf_parts.qnty = buf_parts.fact-qnty
      566         then do:
      567           next.
      568         end.
      569         find first buf_parts-supp share-lock
      570           where buf_parts-supp.orig-in-code   = buf_parts.in-code
      571             and buf_parts-supp.artic          = buf_parts.artic
      572             and buf_parts-supp.prod-type      = buf_parts.prod-type
      573             and buf_parts-supp.prod-code      = buf_parts.prod-code
      574             and buf_parts-supp.orig-part-code = buf_parts.part-code
      575           no-error .
      576         if not available buf_parts-supp
      577         then do:
      578           message
      579             vss-workfile vss-revision vss-description skip
      580             vss-include-info3 skip
      581             "Не найдена информация о поставщике для исходной накладной" skip
      582             "Документ" buf_trn-doc.doc-code skip
      583             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
      584             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
      585             "Номер партии" buf_parts.part-code skip
      586             view-as alert-box error .
      587           undo, return error .
      588         end.
      589       end.
      590     end.
      591   end procedure.
      592   procedure holdprts-doc-type :
      593     define input  parameter p-cat-code as integer   no-undo .
      594     define input  parameter p-doc-code as character no-undo .
      595     define output parameter p-is-sale  as logical   no-undo .
      596     define output parameter p-is-purch as logical   no-undo .
      597     define variable vss-description as character no-undo init "holdprts-doc-type-01: определение типа документа для межфирменного архива".
      598     define buffer buf_trn-doc for ub.trn-doc .
      599     do
      600     on error undo, return error return-value
      601     :
      602       find first buf_trn-doc no-lock
      603         where buf_trn-doc.doc-code = p-doc-code
      604         no-error .
      605       if not available buf_trn-doc
      606       then do:
      607         message
      608           vss-workfile vss-revision vss-description skip
      609           vss-include-info3 skip
      610           "Ошибка задания входных параметров" skip
      611           "Не найден документ" skip
      612           "Документ" p-doc-code skip
      613           "Тип архива" p-cat-code skip
      614           view-as alert-box error .
      615         undo, return error .
      616       end.
      617       case p-cat-code :
      618         when 1
      619         then do:
      620           define variable v-is-hold as logical   no-undo .
      621   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
      623     (input  buf_trn-doc.doc-code
      624     ,output v-is-hold
      625     )  .
      626           if v-is-hold = true
      627           then do:
      628             assign
      629               p-is-sale  = false
      630               p-is-purch = false
      631             .
      632           end.
      633           else do:
      634             case buf_trn-doc.ext-doc-type :
      635               when 'ie':U or
      636               when 'ep':U
      637               then do:
      638                 assign
      639                   p-is-sale  = false
      640                   p-is-purch = true
      641                 .
      642               end.
      643               when 'ee':U or
      644               when 'es':U or
      645               when 're':U or
      646               when 'rs':U
      647               then do:
      648                 assign
      649                   p-is-sale  = true
      650                   p-is-purch = false
      651                 .
      652               end.
      653               when 'we':U or
      654               when 'vt':U or
      655               when 'vp':U or
      656               when 'ap':U or
      657               when 'mp':U or
      658               when 'pc':U or
      659               when 'iv':U or
      660               when 'ev':U or
      661               when 'io':U or
      662               when 'eo':U or
      663               when 'rv':U or
      664               when 'em':U or
      665               when 'wm':U or
      666               when 'im':U
      667               then do:
      668                 assign
      669                   p-is-sale  = false
      670                   p-is-purch = false
      671                 .
      672               end.
      673               otherwise do:
      674                 message
      675                   vss-workfile vss-revision vss-description skip
      676                   vss-include-info3 skip
      677                   "Неизвестный тип документа" skip
      678                   "Документ" buf_trn-doc.doc-code skip
      679                   "Тип документа" buf_trn-doc.ext-doc-type skip
      680                   "Тип архива" p-cat-code skip
      681                   view-as alert-box error .
      682                 undo, return error .
      683               end.
      684             end.
      685           end.
      686         end.
      687         when 2
      688         then do:
      689           case buf_trn-doc.ext-doc-type :
      690             when 'vt':U or
      691             when 'vp':U
      692             then do:
      693               assign
      694                 p-is-sale  = false
      695                 p-is-purch = true
      696               .
      697             end.
      698             otherwise do:
      699               assign
      700                 p-is-sale  = false
      701                 p-is-purch = false
      702               .
      703             end.
      704           end.
      705         end.
      706         when 3
      707         then do:
      708           case buf_trn-doc.ext-doc-type :
      709             when 'we':U
      710             then do:
      711               assign
      712                 p-is-sale  = false
      713                 p-is-purch = true
      714               .
      715             end.
      716             otherwise do:
      717               assign
      718                 p-is-sale  = false
      719                 p-is-purch = false
      720               .
      721             end.
      722           end.
      723         end.
      724         otherwise do:
      725           message
      726             vss-workfile vss-revision vss-description skip
      727             "Неизвестный тип архивов" skip
      728             "Документ" buf_trn-doc.doc-code skip
      729             "Тип документа" buf_trn-doc.ext-doc-type skip
      730             "Тип архива" p-cat-code skip
      731             view-as alert-box error .
      732           undo, return error return-value .
      733         end.
      734       end.
      735     end.
      736   end procedure.
      737   procedure holdprts-purch-values :
      738     define input  parameter p-doc-code             like ub.doc-line.doc-code  no-undo .
      739     define input  parameter p-artic                like ub.doc-line.artic     no-undo .
      740     define input  parameter p-prod-type            like ub.doc-line.prod-type no-undo .
      741     define input  parameter p-prod-code            like ub.doc-line.prod-code no-undo .
      742     define output parameter p-fact-qnty            as decimal   no-undo .
      743     define output parameter p-purch-sum-base       as decimal   no-undo .
      744     define output parameter p-purch-sum-rubl       as decimal   no-undo .
      745     define output parameter p-purch-VAT-base       as decimal   no-undo .
      746     define output parameter p-purch-VAT-rubl       as decimal   no-undo .
      747     define output parameter p-purch-SLT-base       as decimal   no-undo .
      748     define output parameter p-purch-SLT-rubl       as decimal   no-undo .
      749     define output parameter p-purch-road-tax-base  as decimal   no-undo .
      750     define output parameter p-purch-road-tax-rubl  as decimal   no-undo .
      751     define output parameter p-purch-excise-base    as decimal   no-undo .
      752     define output parameter p-purch-excise-rubl    as decimal   no-undo .
      753     define output parameter p-purch-transport-base as decimal   no-undo .
      754     define output parameter p-purch-transport-rubl as decimal   no-undo .
      755     define output parameter p-purch-other-base     as decimal   no-undo .
      756     define output parameter p-purch-other-rubl     as decimal   no-undo .
      757     define output parameter p-purch-discnt-base    as decimal   no-undo .
      758     define output parameter p-purch-discnt-rubl    as decimal   no-undo .
      759     define variable vss-description as character no-undo init "holdprts-purch-values-01: параметры закупки товара".
      760     define variable v-price-base     as decimal   no-undo .
      761     define variable v-price-rubl     as decimal   no-undo .
      762     define variable v-VAT-base       as decimal   no-undo .
      763     define variable v-VAT-rubl       as decimal   no-undo .
      764     define variable v-SLT-base       as decimal   no-undo .
      765     define variable v-SLT-rubl       as decimal   no-undo .
      766     define variable v-road-tax-base  as decimal   no-undo .
      767     define variable v-road-tax-rubl  as decimal   no-undo .
      768     define variable v-transport-base as decimal   no-undo .
      769     define variable v-transport-rubl as decimal   no-undo .
      770     define variable v-other-base     as decimal   no-undo .
      771     define variable v-other-rubl     as decimal   no-undo .
      772     define buffer buf_trn-doc        for ub.trn-doc .
      773     define buffer buf_parts          for ub.parts .
      774     define buffer buf_parts-supp     for ub.parts-supp .
      775     define buffer buf_doc-line       for ub.doc-line .
      776     define buffer buf_income_trn-doc for ub.trn-doc .
      777     do
      778     on error undo, return error return-value
      779     :
      780       find first buf_trn-doc no-lock
      781         where buf_trn-doc.doc-code = p-doc-code
      782         no-error .
      783       if not available buf_trn-doc
      784       then do:
      785         message
      786           vss-workfile vss-revision vss-description skip
      787           vss-include-info3 skip
      788           "Ошибка задания входных параметров" skip
      789           "Не найден документ" skip
      790           "Документ" p-doc-code skip
      791           view-as alert-box error .
      792         undo, return error .
      793       end.
      794       find first buf_doc-line no-lock
      795         where buf_doc-line.doc-code  = p-doc-code
      796           and buf_doc-line.artic     = p-artic
      797           and buf_doc-line.prod-type = p-prod-type
      798           and buf_doc-line.prod-code = p-prod-code
      799         no-error .
      800       if not available buf_doc-line
      801       then do:
      802         message
      803           vss-workfile vss-revision vss-description skip
      804           vss-include-info3 skip
      805           "Ошибка задания входных параметров" skip
      806           "Не найдена строка документа" skip
      807           "Документ" p-doc-code skip
      808           "Артикул" p-artic p-prod-type p-prod-code skip
      809           view-as alert-box error .
      810         undo, return error .
      811       end.
      812       assign
      813         p-fact-qnty            = 0
      814         p-purch-sum-base       = 0
      815         p-purch-sum-rubl       = 0
      816         p-purch-VAT-base       = 0
      817         p-purch-VAT-rubl       = 0
      818         p-purch-SLT-base       = 0
      819         p-purch-SLT-rubl       = 0
      820         p-purch-road-tax-base  = 0
      821         p-purch-road-tax-rubl  = 0
      822         p-purch-excise-base    = 0
      823         p-purch-excise-rubl    = 0
      824         p-purch-transport-base = 0
      825         p-purch-transport-rubl = 0
      826         p-purch-other-base     = 0
      827         p-purch-other-rubl     = 0
      828         p-purch-discnt-base    = 0
      829         p-purch-discnt-rubl    = 0
      830       .
      831       for each buf_parts no-lock
      832         where buf_parts.out-code  = buf_doc-line.doc-code
      833           and buf_parts.obj-type  = buf_doc-line.obj-type
      834           and buf_parts.obj-code  = buf_doc-line.obj-code
      835           and buf_parts.artic     = buf_doc-line.artic
      836           and buf_parts.prod-type = buf_doc-line.prod-type
      837           and buf_parts.prod-code = buf_doc-line.prod-code
      838       on error undo, return error
      839       :
      840         define variable v-parts-qnty as decimal   no-undo .
      841         assign
      842           v-parts-qnty = buf_parts.fact-qnty
      843                        * ( if lookup(buf_trn-doc.doc-type, 'рас,спи':U ) > 0
      844                            then -1
      845                            else 1
      846                          )
      847         .
      848         find first buf_parts-supp no-lock
      849           where buf_parts-supp.in-code   = buf_parts.in-code
      850             and buf_parts-supp.artic     = buf_parts.artic
      851             and buf_parts-supp.prod-type = buf_parts.prod-type
      852             and buf_parts-supp.prod-code = buf_parts.prod-code
      853             and buf_parts-supp.part-code = buf_parts.part-code
      854           no-error .
      855         if available buf_parts-supp
      856         then do:
      857           assign
      858             v-price-base     = buf_parts-supp.price-base
      859             v-price-rubl     = buf_parts-supp.price-rubl
      860             v-VAT-base       = buf_parts-supp.VAT-base
      861             v-VAT-rubl       = buf_parts-supp.VAT-rubl
      862             v-SLT-base       = buf_parts-supp.SLT-base
      863             v-SLT-rubl       = buf_parts-supp.SLT-rubl
      864             v-road-tax-base  = buf_parts-supp.road-tax-base
      865             v-road-tax-rubl  = buf_parts-supp.road-tax-rubl
      866             v-transport-base = buf_parts-supp.transport-base
      867             v-transport-rubl = buf_parts-supp.transport-rubl
      868             v-other-base     = buf_parts-supp.other-base
      869             v-other-rubl     = buf_parts-supp.other-rubl
      870           .
      871         end.
      872         else do:
      873       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      874       define buffer   in-vatp-parts    for ub.parts   .
      875       define buffer   in-vatp-doc      for ub.trn-doc .
      876       define buffer   in-vatp-goods    for ub.goods   .
      877       define buffer   in-vatp-sysconf  for ub.sysconf .
      878       define buffer   in-vatp_doc-attr for ub.doc-attr.
      879       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      880       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      881       define variable varinvprb                  as   character              no-undo.
      882       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      883       define variable cli-base-rate              as   decimal                no-undo.
      884       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      885       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      886       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      887       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      888       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      889       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      890       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      891       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      892       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      893       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      894       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      895       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      896       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      897       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      898       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      899       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      900       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      901       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      902       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      903       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      904       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      905       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      906       define variable varinvatp-envd             as   character              no-undo.
      907       define variable varinvatp-type             as   character              no-undo.
      908   assign
      909     price-rubl-with-tax-loc = buf_parts.price-rubl
      910     price-base-with-tax-loc = buf_parts.price-base
      911   .
      912   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      914     (output varinvprb
      915     )  .
      916     if buf_parts.out-code = 'free-zone':U     or
      917        buf_parts.out-code = 'out-zone':U   or
      918        buf_parts.doc-type = 'акт':U then do:
      919       assign
      920         in-vatp-have-vat-slt = yes.
      921     end.
      922     else do:
      923       find first in-vatp_doc-attr no-lock
      924         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      925           and in-vatp_doc-attr.attr-code = 'envd':U
      926         no-error .
      927       if not available in-vatp_doc-attr then do:
      928         assign
      929           in-vatp-have-vat-slt = yes.
      930       end.
      931       else do:
      932            in-vatp-have-vat-slt = no.
      933       end.
      934     end.
      935     assign
      936      price-cli-with-tax-loc = buf_parts.price-cli
      937      cli-base-rate          = buf_parts.cli-base-rate.
      938     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      939              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      940     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      941             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      942             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      943             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      944             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      945             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      946             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      947       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      948     assign
      949       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      950     assign
      951       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      952       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      953       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      954       transport-cli-loc  = 0
      955       other-cli-loc      = 0
      956     .
      957   ASSIGN
      958             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      959       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      960   .
      961           assign
      962             v-price-base     = price-base-with-tax-loc
      963             v-price-rubl     = price-rubl-with-tax-loc
      964             v-VAT-base       = vat-base-loc
      965             v-VAT-rubl       = vat-rubl-loc
      966             v-SLT-base       = slt-base-loc
      967             v-SLT-rubl       = slt-rubl-loc
      968             v-road-tax-base  = road-tax-base-loc
      969             v-road-tax-rubl  = road-tax-rubl-loc
      970             v-transport-base = transport-base-loc
      971             v-transport-rubl = transport-rubl-loc
      972             v-other-base     = other-base-loc
      973             v-other-rubl     = other-rubl-loc
      974           .
      975         end.
      976         assign
      977           p-fact-qnty            = p-fact-qnty            + v-parts-qnty
      978           p-purch-sum-base       = p-purch-sum-base       + v-price-base     * v-parts-qnty
      979           p-purch-sum-rubl       = p-purch-sum-rubl       + v-price-rubl     * v-parts-qnty
      980           p-purch-VAT-base       = p-purch-VAT-base       + v-VAT-base       * v-parts-qnty
      981           p-purch-VAT-rubl       = p-purch-VAT-rubl       + v-VAT-rubl       * v-parts-qnty
      982           p-purch-SLT-base       = p-purch-SLT-base       + v-SLT-base       * v-parts-qnty
      983           p-purch-SLT-rubl       = p-purch-SLT-rubl       + v-SLT-rubl       * v-parts-qnty
      984           p-purch-road-tax-base  = p-purch-road-tax-base  + v-road-tax-base  * v-parts-qnty
      985           p-purch-road-tax-rubl  = p-purch-road-tax-rubl  + v-road-tax-rubl  * v-parts-qnty
      986           p-purch-excise-base    = p-purch-excise-base    + 0
      987           p-purch-excise-rubl    = p-purch-excise-rubl    + 0
      988           p-purch-transport-base = p-purch-transport-base + v-transport-base * v-parts-qnty
      989           p-purch-transport-rubl = p-purch-transport-rubl + v-transport-rubl * v-parts-qnty
      990           p-purch-other-base     = p-purch-other-base     + v-other-base     * v-parts-qnty
      991           p-purch-other-rubl     = p-purch-other-rubl     + v-other-rubl     * v-parts-qnty
      992           p-purch-discnt-base    = p-purch-discnt-base    + 0
      993           p-purch-discnt-rubl    = p-purch-discnt-rubl    + 0
      994         .
      995       end.
      996     end.
      997   end procedure.
      998   procedure holdprts-sale-values :
