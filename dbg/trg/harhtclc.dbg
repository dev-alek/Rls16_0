     1398       assign
     1399               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1400               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1401        .
     1402     end.
     1403   end.
     1404   assign
     1405   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1406   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1407           assign
     1408             p-fact-qnty           = p-fact-qnty          + v-gds-dtl-fact-qnty
     1409             p-sale-sum-base       = p-sale-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1410             p-sale-sum-rubl       = p-sale-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1411             p-sale-vat-base       = p-sale-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1412             p-sale-vat-rubl       = p-sale-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1413             p-sale-slt-base       = p-sale-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1414             p-sale-slt-rubl       = p-sale-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1415             p-sale-road-tax-base  = p-sale-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1416             p-sale-road-tax-rubl  = p-sale-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1417             p-sale-excise-base    = p-sale-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1418             p-sale-excise-rubl    = p-sale-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1419             p-sale-discnt-base    = p-sale-discnt-base   + discnt-base-sale          * v-gds-dtl-fact-qnty
     1420             p-sale-discnt-rubl    = p-sale-discnt-rubl   + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1421           .
     1422         end.
     1423       end.
     1424       assign
     1425         p-sale-transport-base = 0
     1426         p-sale-transport-rubl = 0
     1427         p-sale-other-base     = 0
     1428         p-sale-other-rubl     = 0
     1429       .
     1430     end.
     1431   end procedure.
     1432   define variable v-start-date as date      no-undo .
     1433   define variable v-end-date   as date      no-undo .
     1434   define variable v-is-purch   as logical   no-undo .
     1435   define variable v-is-sale    as logical   no-undo .
     1436   define buffer buf_trn-doc      for ub.trn-doc .
     1437   define buffer locked_hold-time for ub.hold-time .
     1438   define buffer last_hold-time   for ub.hold-time .
     1439   define buffer locked_hold-trn  for ub.hold-trn .
     1440   do
     1441   on error undo, return error
     1442   :
     1443     find first buf_trn-doc share-lock
     1444       where buf_trn-doc.doc-code = p-doc-code
     1445       no-error .
     1446     if not available buf_trn-doc
     1447     then do:
     1448       message
     1449         vss-workfile vss-revision vss-description skip
     1450         "Ошибка задания входных параметров" skip
     1451         "Не найден документ" skip
     1452         "Документ" p-doc-code
     1453         view-as alert-box error .
     1454       return error .
     1455     end.
     1456     if buf_trn-doc.status_ <> 'факт':U
     1457     then do:
     1458       message
     1459         vss-workfile vss-revision vss-description skip
     1460         "Ошибка расчета межфирменного архива" skip
     1461         "Документ не в статусе" 'факт':U
     1462         "Документ" p-doc-code
     1463         view-as alert-box error .
     1464       return error .
     1465     end.
     1466     run lastdate in this-procedure
     1467       (input buf_trn-doc.fact-date
     1468       ,output v-end-date)
     1469       no-error .
     1470     if error-status :error
     1471     then do:
     1472       message
     1473       vss-workfile vss-revision vss-description skip
     1474       "Ошибка поиска последней даты месяца закрытия документа на факт"
     1475       "Документ" p-doc-code skip
     1476       "Факт дата" buf_trn-doc.fact-date
     1477       view-as alert-box error .
     1478       return error.
     1479     end.
     1480     assign
     1481       v-start-date = date(month(buf_trn-doc.fact-date), 1, year(buf_trn-doc.fact-date))
     1482     .
     1483     find first locked_hold-time exclusive-lock
     1484       where locked_hold-time.cat-code = p-cat-code
     1485         and locked_hold-time.time-type = 'мес':U
     1486         and locked_hold-time.start-date = v-start-date
     1487       no-error .
     1488     if not available locked_hold-time
     1489     then do:
     1490       run create-hold-time in this-procedure
     1491         (input p-cat-code
     1492         ,input v-start-date
     1493         ) no-error .
     1494       if error-status :error
     1495       then do:
     1496         message
     1497           vss-workfile vss-revision vss-description skip
     1498           "Ошибка при создании записи межфирменного архива" skip
     1499           "Документ" buf_trn-doc.doc-code skip
     1500           "cat-code" p-cat-code
     1501           "time-type" 'мес':U
     1502           "start-date" v-start-date
     1503           view-as alert-box error .
     1504         undo, return error .
     1505       end.
     1506       find first locked_hold-time exclusive-lock where
     1507                 locked_hold-time.cat-code = p-cat-code AND
     1508                 locked_hold-time.time-type = 'мес':U AND
     1509                 locked_hold-time.start-date = v-start-date .
     1510     end.
     1511     find first locked_hold-trn exclusive-lock
     1512       where locked_hold-trn.cat-code = p-cat-code
     1513         and locked_hold-trn.doc-code = p-doc-code
     1514         and locked_hold-trn.time-code = locked_hold-time.time-code
     1515       no-error .
     1516     if not available locked_hold-trn
     1517     then do:
     1518       create locked_hold-trn .
     1519       assign
     1520         locked_hold-trn.cat-code = p-cat-code
     1521         locked_hold-trn.doc-code = p-doc-code
     1522         locked_hold-trn.time-code = locked_hold-time.time-code
     1523         locked_hold-trn.is-purch = ?
     1524         locked_hold-trn.is-sale = ?
     1525       .
     1526     end.
     1527     else do:
     1528       undo, return error vss-workfile + vss-revision + chr(10)
     1529         + "Попытка повторного расчета документа" + chr(10)
     1530         + substitute("Категория &1", p-cat-code) + chr(10)
     1531         + substitute("Документ &1", p-doc-code) + chr(10)
     1532         .
     1533     end.
     1534     run holdprts-doc-type in this-procedure
     1535       (input  p-cat-code
     1536       ,input  buf_trn-doc.doc-code
     1537       ,output v-is-sale
     1538       ,output v-is-purch
     1539       ) .
     1540     if v-is-purch
     1541     then do:
     1542       run harh-calc-trn-purch in this-procedure
     1543         (input p-cat-code
     1544         ,input locked_hold-time.time-code
     1545         ,input buf_trn-doc.doc-code
     1546         ,input buf_trn-doc.cli-type
     1547         ,input buf_trn-doc.cli-code
     1548         ) no-error .
     1549       if error-status :error
     1550       then do:
     1551         message
     1552         vss-workfile vss-revision vss-description skip
     1553         "Ошибка расчета межфирменного архива"
     1554         "Документ закупки" buf_trn-doc.doc-code
     1555         view-as alert-box error .
     1556         undo, return error .
     1557       end.
     1558     end.
     1559     if v-is-sale
     1560     then do:
     1561       run harh-calc-trn-sale in this-procedure
     1562         (input p-cat-code
     1563         ,input locked_hold-time.time-code
     1564         ,input buf_trn-doc.doc-code
     1565         ) no-error .
     1566       if error-status :error
     1567       then do:
     1568         message
     1569         vss-workfile vss-revision vss-description skip
     1570         "Ошибка расчета межфирменного архива"
     1571         "Документ продажи" buf_trn-doc.doc-code
     1572         view-as alert-box error .
     1573         undo, return error .
     1574       end.
     1575     end.
     1576     assign
     1577       locked_hold-trn.is-purch = v-is-purch
     1578       locked_hold-trn.is-sale = v-is-sale
     1579     .
     1580   end.
     1581   procedure harh-calc-trn-purch :
     1582   define input parameter p-cat-code like ub.hold-time.cat-code no-undo .
     1583   define input parameter p-time-code like ub.hold-time.time-code no-undo .
     1584   define input parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     1585   define input parameter p-cli-type like ub.trn-doc.cli-type no-undo .
     1586   define input parameter p-cli-code like ub.trn-doc.cli-code no-undo .
     1587   DEFINE VARIABLE   v-fact-qnty             like ub.hold-purch.fact-qnty            no-undo .
     1588   DEFINE VARIABLE   v-purch-sum-base        like ub.hold-purch.purch-sum-base       no-undo .
     1589   DEFINE VARIABLE   v-purch-sum-rubl        like ub.hold-purch.purch-sum-rubl       no-undo .
     1590   DEFINE VARIABLE   v-purch-VAT-base        like ub.hold-purch.purch-VAT-base       no-undo .
     1591   DEFINE VARIABLE   v-purch-VAT-rubl        like ub.hold-purch.purch-VAT-rubl       no-undo .
     1592   DEFINE VARIABLE   v-purch-SLT-base        like ub.hold-purch.purch-SLT-base       no-undo .
     1593   DEFINE VARIABLE   v-purch-SLT-rubl        like ub.hold-purch.purch-SLT-rubl       no-undo .
     1594   DEFINE VARIABLE   v-purch-road-tax-base   like ub.hold-purch.purch-road-tax-base  no-undo .
     1595   DEFINE VARIABLE   v-purch-road-tax-rubl   like ub.hold-purch.purch-road-tax-rubl  no-undo .
     1596   DEFINE VARIABLE   v-purch-excise-base     like ub.hold-purch.purch-excise-base    no-undo .
     1597   DEFINE VARIABLE   v-purch-excise-rubl     like ub.hold-purch.purch-excise-rubl    no-undo .
     1598   DEFINE VARIABLE   v-purch-transport-base  like ub.hold-purch.purch-transport-base no-undo .
     1599   DEFINE VARIABLE   v-purch-transport-rubl  like ub.hold-purch.purch-transport-rubl no-undo .
     1600   DEFINE VARIABLE   v-purch-other-base      like ub.hold-purch.purch-other-base     no-undo .
     1601   DEFINE VARIABLE   v-purch-other-rubl      like ub.hold-purch.purch-other-rubl     no-undo .
     1602   DEFINE VARIABLE   v-purch-discnt-base     like ub.hold-purch.purch-discnt-base    no-undo .
     1603   DEFINE VARIABLE   v-purch-discnt-rubl     like ub.hold-purch.purch-discnt-rubl    no-undo .
     1604   DEFINE VARIABLE   v-node-code like ub.hold-purch-grp.node-code no-undo .
     1605   define buffer buf_doc-line for ub.doc-line .
     1606   define buffer buf_goods for ub.goods .
     1607   define buffer buf_hold-purch for ub.hold-purch.
     1608   define buffer buf_hold-purch-grp for ub.hold-purch-grp.
     1609   define buffer buf_hold-purch-supp for ub.hold-purch-supp.
     1610   define buffer buf_hold-purch-supp-gds for ub.hold-purch-supp-gds.
     1611     do
     1612     on error undo, return error
     1613     :
     1614       for each buf_doc-line no-lock
     1615         where buf_doc-line.doc-code = p-doc-code
     1616       on error undo, return error
     1617       :
     1618         run holdprts-purch-values in this-procedure
     1619           (input  p-doc-code
     1620           ,input  buf_doc-line.artic
     1621           ,input  buf_doc-line.prod-type
     1622           ,input  buf_doc-line.prod-code
     1623           ,output v-fact-qnty
     1624           ,output v-purch-sum-base
     1625           ,output v-purch-sum-rubl
     1626           ,output v-purch-VAT-base
     1627           ,output v-purch-VAT-rubl
     1628           ,output v-purch-SLT-base
     1629           ,output v-purch-SLT-rubl
     1630           ,output v-purch-road-tax-base
     1631           ,output v-purch-road-tax-rubl
     1632           ,output v-purch-excise-base
     1633           ,output v-purch-excise-rubl
     1634           ,output v-purch-transport-base
     1635           ,output v-purch-transport-rubl
     1636           ,output v-purch-other-base
     1637           ,output v-purch-other-rubl
     1638           ,output v-purch-discnt-base
     1639           ,output v-purch-discnt-rubl
     1640           ) .
     1641         find first buf_goods no-lock
     1642           where buf_goods.artic = buf_doc-line.artic
     1643             and buf_goods.prod-type = buf_doc-line.prod-type
     1644             and buf_goods.prod-code = buf_doc-line.prod-code
     1645           no-error .
     1646         if not available buf_goods
     1647         then do:
     1648           message
     1649             vss-workfile vss-revision vss-description skip
     1650             "Ошибка при заполнении межфирменного архива по строке документа закупки" skip
     1651             "Документ" p-doc-code skip
     1652             "cat-code" p-cat-code skip
     1653             "time-code" p-time-code skip
     1654             "Товар" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code
     1655             view-as alert-box error .
     1656           return error .
     1657         end.
     1658         run harh-set-good in this-procedure
     1659           (input p-cat-code
     1660           ,input p-time-code
     1661           ,input buf_goods.gds-code
     1662           ,input buf_goods.grp-name
     1663           ,output v-node-code
     1664           ) no-error .
     1665         if error-status :error
     1666         then do:
     1667           message
     1668           vss-workfile vss-revision vss-description skip
     1669           "Ошибка при регистрации товара в межфирменном архиве" skip
     1670           "Товар" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code SKIP
     1671           "cat-code" p-cat-code SKIP
     1672           "time-code" p-time-code
     1673           view-as alert-box error .
     1674           return error .
     1675         end.
     1676         find first buf_hold-purch exclusive-lock where
     1677                    buf_hold-purch.cat-code = p-cat-code AND
     1678                    buf_hold-purch.time-code = p-time-code AND
     1679                    buf_hold-purch.gds-code = buf_goods.gds-code no-error.
     1680         if not available buf_hold-purch
     1681         then do:
     1682           create buf_hold-purch .
     1683           assign
     1684             buf_hold-purch.cat-code = p-cat-code
     1685             buf_hold-purch.time-code = p-time-code
     1686             buf_hold-purch.gds-code = buf_goods.gds-code
     1687           .
     1688         end.
     1689         assign
     1690           buf_hold-purch.fact-qnty             =  buf_hold-purch.fact-qnty            +  v-fact-qnty
     1691           buf_hold-purch.purch-sum-base        =  buf_hold-purch.purch-sum-base       +  v-purch-sum-base
     1692           buf_hold-purch.purch-sum-rubl        =  buf_hold-purch.purch-sum-rubl       +  v-purch-sum-rubl
     1693           buf_hold-purch.purch-VAT-base        =  buf_hold-purch.purch-VAT-base       +  v-purch-VAT-base
     1694           buf_hold-purch.purch-VAT-rubl        =  buf_hold-purch.purch-VAT-rubl       +  v-purch-VAT-rubl
     1695           buf_hold-purch.purch-SLT-base        =  buf_hold-purch.purch-SLT-base       +  v-purch-SLT-base
     1696           buf_hold-purch.purch-SLT-rubl        =  buf_hold-purch.purch-SLT-rubl       +  v-purch-SLT-rubl
     1697           buf_hold-purch.purch-road-tax-base   =  buf_hold-purch.purch-road-tax-base  +  v-purch-road-tax-base
     1698           buf_hold-purch.purch-road-tax-rubl   =  buf_hold-purch.purch-road-tax-rubl  +  v-purch-road-tax-rubl
     1699           buf_hold-purch.purch-excise-base     =  buf_hold-purch.purch-excise-base    +  v-purch-excise-base
     1700           buf_hold-purch.purch-excise-rubl     =  buf_hold-purch.purch-excise-rubl    +  v-purch-excise-rubl
     1701           buf_hold-purch.purch-transport-base  =  buf_hold-purch.purch-transport-base +  v-purch-transport-base
     1702           buf_hold-purch.purch-transport-rubl  =  buf_hold-purch.purch-transport-rubl +  v-purch-transport-rubl
     1703           buf_hold-purch.purch-other-base      =  buf_hold-purch.purch-other-base     +  v-purch-other-base
     1704           buf_hold-purch.purch-other-rubl      =  buf_hold-purch.purch-other-rubl     +  v-purch-other-rubl
     1705           buf_hold-purch.purch-discnt-base     =  buf_hold-purch.purch-discnt-base    +  v-purch-discnt-base
     1706           buf_hold-purch.purch-discnt-rubl     =  buf_hold-purch.purch-discnt-rubl    +  v-purch-discnt-rubl
     1707         .
     1708         find first buf_hold-purch-grp exclusive-lock where
     1709                    buf_hold-purch-grp.cat-code = p-cat-code AND
     1710                    buf_hold-purch-grp.time-code = p-time-code AND
     1711                    buf_hold-purch-grp.node-code = v-node-code no-error.
     1712         if not available buf_hold-purch-grp
     1713         then do:
     1714           create buf_hold-purch-grp .
     1715           assign
     1716             buf_hold-purch-grp.cat-code = p-cat-code
     1717             buf_hold-purch-grp.time-code = p-time-code
     1718             buf_hold-purch-grp.node-code = v-node-code
     1719           .
     1720         end.
     1721         assign
     1722           buf_hold-purch-grp.fact-qnty             =  buf_hold-purch-grp.fact-qnty            +  v-fact-qnty
     1723           buf_hold-purch-grp.purch-sum-base        =  buf_hold-purch-grp.purch-sum-base       +  v-purch-sum-base
     1724           buf_hold-purch-grp.purch-sum-rubl        =  buf_hold-purch-grp.purch-sum-rubl       +  v-purch-sum-rubl
     1725           buf_hold-purch-grp.purch-VAT-base        =  buf_hold-purch-grp.purch-VAT-base       +  v-purch-VAT-base
     1726           buf_hold-purch-grp.purch-VAT-rubl        =  buf_hold-purch-grp.purch-VAT-rubl       +  v-purch-VAT-rubl
     1727           buf_hold-purch-grp.purch-SLT-base        =  buf_hold-purch-grp.purch-SLT-base       +  v-purch-SLT-base
     1728           buf_hold-purch-grp.purch-SLT-rubl        =  buf_hold-purch-grp.purch-SLT-rubl       +  v-purch-SLT-rubl
     1729           buf_hold-purch-grp.purch-road-tax-base   =  buf_hold-purch-grp.purch-road-tax-base  +  v-purch-road-tax-base
     1730           buf_hold-purch-grp.purch-road-tax-rubl   =  buf_hold-purch-grp.purch-road-tax-rubl  +  v-purch-road-tax-rubl
     1731           buf_hold-purch-grp.purch-excise-base     =  buf_hold-purch-grp.purch-excise-base    +  v-purch-excise-base
     1732           buf_hold-purch-grp.purch-excise-rubl     =  buf_hold-purch-grp.purch-excise-rubl    +  v-purch-excise-rubl
     1733           buf_hold-purch-grp.purch-transport-base  =  buf_hold-purch-grp.purch-transport-base +  v-purch-transport-base
     1734           buf_hold-purch-grp.purch-transport-rubl  =  buf_hold-purch-grp.purch-transport-rubl +  v-purch-transport-rubl
     1735           buf_hold-purch-grp.purch-other-base      =  buf_hold-purch-grp.purch-other-base     +  v-purch-other-base
     1736           buf_hold-purch-grp.purch-other-rubl      =  buf_hold-purch-grp.purch-other-rubl     +  v-purch-other-rubl
     1737           buf_hold-purch-grp.purch-discnt-base     =  buf_hold-purch-grp.purch-discnt-base    +  v-purch-discnt-base
     1738           buf_hold-purch-grp.purch-discnt-rubl     =  buf_hold-purch-grp.purch-discnt-rubl    +  v-purch-discnt-rubl
     1739         .
     1740         find first buf_hold-purch-supp exclusive-lock where
     1741                    buf_hold-purch-supp.cat-code = p-cat-code AND
     1742                    buf_hold-purch-supp.time-code = p-time-code AND
     1743                    buf_hold-purch-supp.cli-type = p-cli-type AND
     1744                    buf_hold-purch-supp.cli-code = p-cli-code
     1745                    no-error.
     1746         if not available buf_hold-purch-supp
     1747         then do:
     1748           create buf_hold-purch-supp .
     1749           assign
     1750             buf_hold-purch-supp.cat-code = p-cat-code
     1751             buf_hold-purch-supp.time-code = p-time-code
     1752             buf_hold-purch-supp.cli-type = p-cli-type
     1753             buf_hold-purch-supp.cli-code = p-cli-code
     1754           .
     1755         end.
     1756         assign
     1757           buf_hold-purch-supp.fact-qnty             =  buf_hold-purch-supp.fact-qnty            +  v-fact-qnty
     1758           buf_hold-purch-supp.purch-sum-base        =  buf_hold-purch-supp.purch-sum-base       +  v-purch-sum-base
     1759           buf_hold-purch-supp.purch-sum-rubl        =  buf_hold-purch-supp.purch-sum-rubl       +  v-purch-sum-rubl
     1760           buf_hold-purch-supp.purch-VAT-base        =  buf_hold-purch-supp.purch-VAT-base       +  v-purch-VAT-base
     1761           buf_hold-purch-supp.purch-VAT-rubl        =  buf_hold-purch-supp.purch-VAT-rubl       +  v-purch-VAT-rubl
     1762           buf_hold-purch-supp.purch-SLT-base        =  buf_hold-purch-supp.purch-SLT-base       +  v-purch-SLT-base
     1763           buf_hold-purch-supp.purch-SLT-rubl        =  buf_hold-purch-supp.purch-SLT-rubl       +  v-purch-SLT-rubl
     1764           buf_hold-purch-supp.purch-road-tax-base   =  buf_hold-purch-supp.purch-road-tax-base  +  v-purch-road-tax-base
     1765           buf_hold-purch-supp.purch-road-tax-rubl   =  buf_hold-purch-supp.purch-road-tax-rubl  +  v-purch-road-tax-rubl
     1766           buf_hold-purch-supp.purch-excise-base     =  buf_hold-purch-supp.purch-excise-base    +  v-purch-excise-base
     1767           buf_hold-purch-supp.purch-excise-rubl     =  buf_hold-purch-supp.purch-excise-rubl    +  v-purch-excise-rubl
     1768           buf_hold-purch-supp.purch-transport-base  =  buf_hold-purch-supp.purch-transport-base +  v-purch-transport-base
     1769           buf_hold-purch-supp.purch-transport-rubl  =  buf_hold-purch-supp.purch-transport-rubl +  v-purch-transport-rubl
     1770           buf_hold-purch-supp.purch-other-base      =  buf_hold-purch-supp.purch-other-base     +  v-purch-other-base
     1771           buf_hold-purch-supp.purch-other-rubl      =  buf_hold-purch-supp.purch-other-rubl     +  v-purch-other-rubl
     1772           buf_hold-purch-supp.purch-discnt-base     =  buf_hold-purch-supp.purch-discnt-base    +  v-purch-discnt-base
     1773           buf_hold-purch-supp.purch-discnt-rubl     =  buf_hold-purch-supp.purch-discnt-rubl    +  v-purch-discnt-rubl
     1774         .
     1775         find first buf_hold-purch-supp-gds exclusive-lock where
     1776                    buf_hold-purch-supp-gds.cat-code = p-cat-code AND
     1777                    buf_hold-purch-supp-gds.time-code = p-time-code AND
     1778                    buf_hold-purch-supp-gds.gds-code = buf_goods.gds-code AND
     1779                    buf_hold-purch-supp-gds.cli-type = p-cli-type AND
     1780                    buf_hold-purch-supp-gds.cli-code = p-cli-code
     1781                    no-error.
     1782         if not available buf_hold-purch-supp-gds
     1783         then do:
     1784           create buf_hold-purch-supp-gds .
     1785           assign
     1786             buf_hold-purch-supp-gds.cat-code = p-cat-code
     1787             buf_hold-purch-supp-gds.time-code = p-time-code
     1788             buf_hold-purch-supp-gds.cli-type = p-cli-type
     1789             buf_hold-purch-supp-gds.cli-code = p-cli-code
     1790             buf_hold-purch-supp-gds.gds-code = buf_goods.gds-code
     1791           .
     1792         end.
     1793         assign
     1794           buf_hold-purch-supp-gds.fact-qnty             =  buf_hold-purch-supp-gds.fact-qnty            +  v-fact-qnty
     1795           buf_hold-purch-supp-gds.purch-sum-base        =  buf_hold-purch-supp-gds.purch-sum-base       +  v-purch-sum-base
     1796           buf_hold-purch-supp-gds.purch-sum-rubl        =  buf_hold-purch-supp-gds.purch-sum-rubl       +  v-purch-sum-rubl
     1797           buf_hold-purch-supp-gds.purch-VAT-base        =  buf_hold-purch-supp-gds.purch-VAT-base       +  v-purch-VAT-base
     1798           buf_hold-purch-supp-gds.purch-VAT-rubl        =  buf_hold-purch-supp-gds.purch-VAT-rubl       +  v-purch-VAT-rubl
     1799           buf_hold-purch-supp-gds.purch-SLT-base        =  buf_hold-purch-supp-gds.purch-SLT-base       +  v-purch-SLT-base
     1800           buf_hold-purch-supp-gds.purch-SLT-rubl        =  buf_hold-purch-supp-gds.purch-SLT-rubl       +  v-purch-SLT-rubl
     1801           buf_hold-purch-supp-gds.purch-road-tax-base   =  buf_hold-purch-supp-gds.purch-road-tax-base  +  v-purch-road-tax-base
     1802           buf_hold-purch-supp-gds.purch-road-tax-rubl   =  buf_hold-purch-supp-gds.purch-road-tax-rubl  +  v-purch-road-tax-rubl
     1803           buf_hold-purch-supp-gds.purch-excise-base     =  buf_hold-purch-supp-gds.purch-excise-base    +  v-purch-excise-base
     1804           buf_hold-purch-supp-gds.purch-excise-rubl     =  buf_hold-purch-supp-gds.purch-excise-rubl    +  v-purch-excise-rubl
     1805           buf_hold-purch-supp-gds.purch-transport-base  =  buf_hold-purch-supp-gds.purch-transport-base +  v-purch-transport-base
     1806           buf_hold-purch-supp-gds.purch-transport-rubl  =  buf_hold-purch-supp-gds.purch-transport-rubl +  v-purch-transport-rubl
     1807           buf_hold-purch-supp-gds.purch-other-base      =  buf_hold-purch-supp-gds.purch-other-base     +  v-purch-other-base
     1808           buf_hold-purch-supp-gds.purch-other-rubl      =  buf_hold-purch-supp-gds.purch-other-rubl     +  v-purch-other-rubl
     1809           buf_hold-purch-supp-gds.purch-discnt-base     =  buf_hold-purch-supp-gds.purch-discnt-base    +  v-purch-discnt-base
     1810           buf_hold-purch-supp-gds.purch-discnt-rubl     =  buf_hold-purch-supp-gds.purch-discnt-rubl    +  v-purch-discnt-rubl
     1811         .
     1812       end.
     1813     end.
     1814   end procedure.
     1815   procedure harh-calc-trn-sale :
     1816     define input parameter p-cat-code like ub.hold-time.cat-code no-undo .
     1817     define input parameter p-time-code like ub.hold-time.time-code no-undo .
     1818     define input parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     1819     define variable   v-fact-qnty             like ub.hold-sale.fact-qnty            no-undo .
     1820     define variable   v-sale-sum-base         like ub.hold-sale.purch-sum-base       no-undo .
     1821     define variable   v-sale-sum-rubl         like ub.hold-sale.sale-sum-rubl        no-undo .
     1822     define variable   v-sale-vat-base         like ub.hold-sale.sale-vat-base        no-undo .
     1823     define variable   v-sale-vat-rubl         like ub.hold-sale.sale-vat-rubl        no-undo .
     1824     define variable   v-sale-slt-base         like ub.hold-sale.sale-slt-base        no-undo .
     1825     define variable   v-sale-slt-rubl         like ub.hold-sale.sale-slt-rubl        no-undo .
     1826     define variable   v-sale-road-tax-base    like ub.hold-sale.sale-road-tax-base   no-undo .
     1827     define variable   v-sale-road-tax-rubl    like ub.hold-sale.sale-road-tax-rubl   no-undo .
     1828     define variable   v-sale-excise-base      like ub.hold-sale.sale-excise-base     no-undo .
     1829     define variable   v-sale-excise-rubl      like ub.hold-sale.sale-excise-rubl     no-undo .
     1830     define variable   v-sale-transport-base   like ub.hold-sale.sale-transport-base  no-undo .
     1831     define variable   v-sale-transport-rubl   like ub.hold-sale.sale-transport-rubl  no-undo .
     1832     define variable   v-sale-other-base       like ub.hold-sale.sale-other-base      no-undo .
     1833     define variable   v-sale-other-rubl       like ub.hold-sale.sale-other-rubl      no-undo .
     1834     define variable   v-sale-discnt-base      like ub.hold-sale.sale-discnt-base     no-undo .
     1835     define variable   v-sale-discnt-rubl      like ub.hold-sale.sale-discnt-rubl     no-undo .
     1836     define variable   v-purch-sum-base        like ub.hold-sale.purch-sum-base       no-undo .
     1837     define variable   v-purch-sum-rubl        like ub.hold-sale.purch-sum-rubl       no-undo .
     1838     define variable   v-purch-vat-base        like ub.hold-sale.purch-vat-base       no-undo .
     1839     define variable   v-purch-vat-rubl        like ub.hold-sale.purch-vat-rubl       no-undo .
     1840     define variable   v-purch-slt-base        like ub.hold-sale.purch-slt-base       no-undo .
     1841     define variable   v-purch-slt-rubl        like ub.hold-sale.purch-slt-rubl       no-undo .
     1842     define variable   v-purch-road-tax-base   like ub.hold-sale.purch-road-tax-base  no-undo .
     1843     define variable   v-purch-road-tax-rubl   like ub.hold-sale.purch-road-tax-rubl  no-undo .
     1844     define variable   v-purch-excise-base     like ub.hold-sale.purch-excise-base    no-undo .
     1845     define variable   v-purch-excise-rubl     like ub.hold-sale.purch-excise-rubl    no-undo .
     1846     define variable   v-purch-transport-base  like ub.hold-sale.purch-transport-base no-undo .
     1847     define variable   v-purch-transport-rubl  like ub.hold-sale.purch-transport-rubl no-undo .
     1848     define variable   v-purch-other-base      like ub.hold-sale.purch-other-base     no-undo .
     1849     define variable   v-purch-other-rubl      like ub.hold-sale.purch-other-rubl     no-undo .
     1850     define variable   v-purch-discnt-base     like ub.hold-sale.purch-discnt-base    no-undo .
     1851     define variable   v-purch-discnt-rubl     like ub.hold-sale.purch-discnt-rubl    no-undo .
     1852     define variable   v-profit-base           like ub.hold-sale.profit-base          no-undo .
     1853     define variable   v-profit-rubl           like ub.hold-sale.profit-rubl          no-undo .
     1854     define variable   v-node-code like ub.hold-purch-grp.node-code no-undo .
     1855     define buffer buf_goods for ub.goods .
     1856     define buffer buf_doc-line for ub.doc-line .
     1857     define buffer buf_hold-sale for ub.hold-sale .
     1858     define buffer buf_hold-sale-grp for ub.hold-sale-grp .
     1859     do
     1860     on error undo, return error
     1861     :
     1862       for each buf_doc-line no-lock
     1863         where buf_doc-line.doc-code = p-doc-code
     1864       on error undo, return error
     1865       :
     1866         run holdprts-purch-values in this-procedure
     1867           (input  p-doc-code
     1868           ,input  buf_doc-line.artic
     1869           ,input  buf_doc-line.prod-type
     1870           ,input  buf_doc-line.prod-code
     1871           ,output v-fact-qnty
     1872           ,output v-purch-sum-base
     1873           ,output v-purch-sum-rubl
     1874           ,output v-purch-VAT-base
     1875           ,output v-purch-VAT-rubl
     1876           ,output v-purch-SLT-base
     1877           ,output v-purch-SLT-rubl
     1878           ,output v-purch-road-tax-base
     1879           ,output v-purch-road-tax-rubl
     1880           ,output v-purch-excise-base
     1881           ,output v-purch-excise-rubl
     1882           ,output v-purch-transport-base
     1883           ,output v-purch-transport-rubl
     1884           ,output v-purch-other-base
     1885           ,output v-purch-other-rubl
     1886           ,output v-purch-discnt-base
     1887           ,output v-purch-discnt-rubl
     1888           ) .
     1889         run holdprts-sale-values in this-procedure
     1890           (input  p-doc-code
     1891           ,input  buf_doc-line.artic
     1892           ,input  buf_doc-line.prod-type
     1893           ,input  buf_doc-line.prod-code
     1894           ,output v-fact-qnty
     1895           ,output v-sale-sum-base
     1896           ,output v-sale-sum-rubl
     1897           ,output v-sale-VAT-base
     1898           ,output v-sale-VAT-rubl
     1899           ,output v-sale-SLT-base
     1900           ,output v-sale-SLT-rubl
     1901           ,output v-sale-road-tax-base
     1902           ,output v-sale-road-tax-rubl
     1903           ,output v-sale-excise-base
     1904           ,output v-sale-excise-rubl
     1905           ,output v-sale-transport-base
     1906           ,output v-sale-transport-rubl
     1907           ,output v-sale-other-base
     1908           ,output v-sale-other-rubl
     1909           ,output v-sale-discnt-base
     1910           ,output v-sale-discnt-rubl
     1911           ) .
     1912         find first buf_goods no-lock
     1913           where buf_goods.artic = buf_doc-line.artic
     1914             and buf_goods.prod-type = buf_doc-line.prod-type
     1915             and buf_goods.prod-code = buf_doc-line.prod-code
     1916           no-error .
     1917         if not available buf_goods
     1918         then do:
     1919           message
     1920             vss-workfile vss-revision vss-description skip
     1921             "Ошибка при заполнении межфирменного архива по строке документа продажи" skip
     1922             "Документ" p-doc-code skip
     1923             "cat-code" p-cat-code skip
     1924             "time-code" p-time-code skip
     1925             "Товар" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code
     1926             view-as alert-box error .
     1927           return error .
     1928         end.
     1929         run harh-set-good in this-procedure
     1930           (input p-cat-code
     1931           ,input p-time-code
     1932           ,input buf_goods.gds-code
     1933           ,input buf_goods.grp-name
     1934           ,output v-node-code
     1935           ) no-error .
     1936         if error-status :error
     1937         then do:
     1938           message
     1939             vss-workfile vss-revision vss-description skip
     1940             "Ошибка при регистрации товара в межфирменном архиве" skip
     1941             "Товар" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code SKIP
     1942             "cat-code" p-cat-code SKIP
     1943             "time-code" p-time-code
     1944             view-as alert-box error .
     1945           return error .
     1946         end.
     1947         find first buf_hold-sale exclusive-lock
     1948           where buf_hold-sale.cat-code  = p-cat-code
     1949             and buf_hold-sale.time-code = p-time-code
     1950             and buf_hold-sale.gds-code  = buf_goods.gds-code
     1951           no-error .
     1952         if not available buf_hold-sale
     1953         then do:
     1954           create buf_hold-sale .
     1955           assign
     1956             buf_hold-sale.cat-code  = p-cat-code
     1957             buf_hold-sale.time-code = p-time-code
     1958             buf_hold-sale.gds-code  = buf_goods.gds-code
     1959           .
     1960         end.
     1961         assign
     1962           buf_hold-sale.fact-qnty            = buf_hold-sale.fact-qnty            + v-fact-qnty
     1963           buf_hold-sale.purch-sum-base       = buf_hold-sale.purch-sum-base       + v-purch-sum-base
     1964           buf_hold-sale.purch-sum-rubl       = buf_hold-sale.purch-sum-rubl       + v-purch-sum-rubl
     1965           buf_hold-sale.purch-VAT-base       = buf_hold-sale.purch-VAT-base       + v-purch-VAT-base
     1966           buf_hold-sale.purch-VAT-rubl       = buf_hold-sale.purch-VAT-rubl       + v-purch-VAT-rubl
     1967           buf_hold-sale.purch-SLT-base       = buf_hold-sale.purch-SLT-base       + v-purch-SLT-base
     1968           buf_hold-sale.purch-SLT-rubl       = buf_hold-sale.purch-SLT-rubl       + v-purch-SLT-rubl
     1969           buf_hold-sale.purch-road-tax-base  = buf_hold-sale.purch-road-tax-base  + v-purch-road-tax-base
     1970           buf_hold-sale.purch-road-tax-rubl  = buf_hold-sale.purch-road-tax-rubl  + v-purch-road-tax-rubl
     1971           buf_hold-sale.purch-excise-base    = buf_hold-sale.purch-excise-base    + v-purch-excise-base
     1972           buf_hold-sale.purch-excise-rubl    = buf_hold-sale.purch-excise-rubl    + v-purch-excise-rubl
     1973           buf_hold-sale.purch-transport-base = buf_hold-sale.purch-transport-base + v-purch-transport-base
     1974           buf_hold-sale.purch-transport-rubl = buf_hold-sale.purch-transport-rubl + v-purch-transport-rubl
     1975           buf_hold-sale.purch-other-base     = buf_hold-sale.purch-other-base     + v-purch-other-base
     1976           buf_hold-sale.purch-other-rubl     = buf_hold-sale.purch-other-rubl     + v-purch-other-rubl
     1977           buf_hold-sale.purch-discnt-base    = buf_hold-sale.purch-discnt-base    + v-purch-discnt-base
     1978           buf_hold-sale.purch-discnt-rubl    = buf_hold-sale.purch-discnt-rubl    + v-purch-discnt-rubl
     1979           buf_hold-sale.sale-sum-base        = buf_hold-sale.sale-sum-base        + v-sale-sum-base
     1980           buf_hold-sale.sale-sum-rubl        = buf_hold-sale.sale-sum-rubl        + v-sale-sum-rubl
     1981           buf_hold-sale.sale-VAT-base        = buf_hold-sale.sale-VAT-base        + v-sale-VAT-base
     1982           buf_hold-sale.sale-VAT-rubl        = buf_hold-sale.sale-VAT-rubl        + v-sale-VAT-rubl
     1983           buf_hold-sale.sale-SLT-base        = buf_hold-sale.sale-SLT-base        + v-sale-SLT-base
     1984           buf_hold-sale.sale-SLT-rubl        = buf_hold-sale.sale-SLT-rubl        + v-sale-SLT-rubl
     1985           buf_hold-sale.sale-road-tax-base   = buf_hold-sale.sale-road-tax-base   + v-sale-road-tax-base
     1986           buf_hold-sale.sale-road-tax-rubl   = buf_hold-sale.sale-road-tax-rubl   + v-sale-road-tax-rubl
     1987           buf_hold-sale.sale-excise-base     = buf_hold-sale.sale-excise-base     + v-sale-excise-base
     1988           buf_hold-sale.sale-excise-rubl     = buf_hold-sale.sale-excise-rubl     + v-sale-excise-rubl
     1989           buf_hold-sale.sale-transport-base  = buf_hold-sale.sale-transport-base  + v-sale-transport-base
     1990           buf_hold-sale.sale-transport-rubl  = buf_hold-sale.sale-transport-rubl  + v-sale-transport-rubl
     1991           buf_hold-sale.sale-other-base      = buf_hold-sale.sale-other-base      + v-sale-other-base
     1992           buf_hold-sale.sale-other-rubl      = buf_hold-sale.sale-other-rubl      + v-sale-other-rubl
     1993           buf_hold-sale.sale-discnt-base     = buf_hold-sale.sale-discnt-base     + v-sale-discnt-base
     1994           buf_hold-sale.sale-discnt-rubl     = buf_hold-sale.sale-discnt-rubl     + v-sale-discnt-rubl
     1995           buf_hold-sale.profit-base          = buf_hold-sale.profit-base          + v-profit-base
     1996           buf_hold-sale.profit-rubl          = buf_hold-sale.profit-rubl          + v-profit-rubl
     1997         .
     1998         find first buf_hold-sale-grp exclusive-lock where
     1999                    buf_hold-sale-grp.cat-code = p-cat-code AND
     2000                    buf_hold-sale-grp.time-code = p-time-code AND
     2001                    buf_hold-sale-grp.node-code = v-node-code no-error.
     2002         if not available buf_hold-sale-grp
     2003         then do:
     2004           create buf_hold-sale-grp .
     2005           assign
     2006             buf_hold-sale-grp.cat-code = p-cat-code
     2007             buf_hold-sale-grp.time-code = p-time-code
     2008             buf_hold-sale-grp.node-code = v-node-code
     2009           .
     2010         end.
     2011         assign
     2012           buf_hold-sale-grp.fact-qnty             =  buf_hold-sale-grp.fact-qnty            +  v-fact-qnty
     2013           buf_hold-sale-grp.purch-sum-base        =  buf_hold-sale-grp.purch-sum-base       +  v-purch-sum-base
     2014           buf_hold-sale-grp.purch-sum-rubl        =  buf_hold-sale-grp.purch-sum-rubl       +  v-purch-sum-rubl
     2015           buf_hold-sale-grp.purch-VAT-base        =  buf_hold-sale-grp.purch-VAT-base       +  v-purch-VAT-base
     2016           buf_hold-sale-grp.purch-VAT-rubl        =  buf_hold-sale-grp.purch-VAT-rubl       +  v-purch-VAT-rubl
     2017           buf_hold-sale-grp.purch-SLT-base        =  buf_hold-sale-grp.purch-SLT-base       +  v-purch-SLT-base
     2018           buf_hold-sale-grp.purch-SLT-rubl        =  buf_hold-sale-grp.purch-SLT-rubl       +  v-purch-SLT-rubl
     2019           buf_hold-sale-grp.purch-road-tax-base   =  buf_hold-sale-grp.purch-road-tax-base  +  v-purch-road-tax-base
     2020           buf_hold-sale-grp.purch-road-tax-rubl   =  buf_hold-sale-grp.purch-road-tax-rubl  +  v-purch-road-tax-rubl
     2021           buf_hold-sale-grp.purch-excise-base     =  buf_hold-sale-grp.purch-excise-base    +  v-purch-excise-base
     2022           buf_hold-sale-grp.purch-excise-rubl     =  buf_hold-sale-grp.purch-excise-rubl    +  v-purch-excise-rubl
     2023           buf_hold-sale-grp.purch-transport-base  =  buf_hold-sale-grp.purch-transport-base +  v-purch-transport-base
     2024           buf_hold-sale-grp.purch-transport-rubl  =  buf_hold-sale-grp.purch-transport-rubl +  v-purch-transport-rubl
     2025           buf_hold-sale-grp.purch-other-base      =  buf_hold-sale-grp.purch-other-base     +  v-purch-other-base
     2026           buf_hold-sale-grp.purch-other-rubl      =  buf_hold-sale-grp.purch-other-rubl     +  v-purch-other-rubl
     2027           buf_hold-sale-grp.purch-discnt-base     =  buf_hold-sale-grp.purch-discnt-base    +  v-purch-discnt-base
     2028           buf_hold-sale-grp.purch-discnt-rubl     =  buf_hold-sale-grp.purch-discnt-rubl    +  v-purch-discnt-rubl
     2029           buf_hold-sale-grp.sale-sum-base         =  buf_hold-sale-grp.sale-sum-base        +  v-sale-sum-base
     2030           buf_hold-sale-grp.sale-sum-rubl         =  buf_hold-sale-grp.sale-sum-rubl        +  v-sale-sum-rubl
     2031           buf_hold-sale-grp.sale-VAT-base         =  buf_hold-sale-grp.sale-VAT-base        +  v-sale-VAT-base
     2032           buf_hold-sale-grp.sale-VAT-rubl         =  buf_hold-sale-grp.sale-VAT-rubl        +  v-sale-VAT-rubl
     2033           buf_hold-sale-grp.sale-SLT-base         =  buf_hold-sale-grp.sale-SLT-base        +  v-sale-SLT-base
     2034           buf_hold-sale-grp.sale-SLT-rubl         =  buf_hold-sale-grp.sale-SLT-rubl        +  v-sale-SLT-rubl
     2035           buf_hold-sale-grp.sale-road-tax-base    =  buf_hold-sale-grp.sale-road-tax-base   +  v-sale-road-tax-base
     2036           buf_hold-sale-grp.sale-road-tax-rubl    =  buf_hold-sale-grp.sale-road-tax-rubl   +  v-sale-road-tax-rubl
     2037           buf_hold-sale-grp.sale-excise-base      =  buf_hold-sale-grp.sale-excise-base     +  v-sale-excise-base
     2038           buf_hold-sale-grp.sale-excise-rubl      =  buf_hold-sale-grp.sale-excise-rubl     +  v-sale-excise-rubl
     2039           buf_hold-sale-grp.sale-transport-base   =  buf_hold-sale-grp.sale-transport-base  +  v-sale-transport-base
     2040           buf_hold-sale-grp.sale-transport-rubl   =  buf_hold-sale-grp.sale-transport-rubl  +  v-sale-transport-rubl
     2041           buf_hold-sale-grp.sale-other-base       =  buf_hold-sale-grp.sale-other-base      +  v-sale-other-base
     2042           buf_hold-sale-grp.sale-other-rubl       =  buf_hold-sale-grp.sale-other-rubl      +  v-sale-other-rubl
     2043           buf_hold-sale-grp.sale-discnt-base      =  buf_hold-sale-grp.sale-discnt-base     +  v-sale-discnt-base
     2044           buf_hold-sale-grp.sale-discnt-rubl      =  buf_hold-sale-grp.sale-discnt-rubl     +  v-sale-discnt-rubl
     2045           buf_hold-sale-grp.profit-base           =  buf_hold-sale-grp.profit-base          +  v-profit-base
     2046           buf_hold-sale-grp.profit-rubl           =  buf_hold-sale-grp.profit-rubl          +  v-profit-rubl
     2047         .
     2048       end.
     2049     end.
     2050   end procedure.
     2051   procedure harh-set-good :
     2052     define input  parameter p-cat-code  like ub.hold-time.cat-code no-undo .
     2053     define input  parameter p-time-code like ub.hold-time.time-code no-undo .
     2054     define input  parameter p-gds-code  like ub.goods.gds-code no-undo .
     2055     define input  parameter p-grp-name  like ub.goods.grp-name no-undo .
     2056     define output parameter p-node-code like ub.hold-gds-grp.node-code no-undo .
     2057     define variable v-grp-name like ub.hold-gds-grp.grp-name no-undo .
     2058     define variable v-node-name like ub.hold-gds-grp.node-name no-undo .
     2059     define variable v-upper-code like ub.hold-gds-grp.upper-code no-undo .
     2060     define variable v-node-code like ub.hold-gds-grp.node-code no-undo .
     2061     define variable v-ii as integer no-undo .
     2062     define variable v-is-term like ub.hold-gds-grp.is-term no-undo .
     2063     define variable v-num-entries as integer no-undo .
     2064     define buffer locked_hold-goods for ub.hold-goods .
     2065     define buffer locked_hold-gds-grp for ub.hold-gds-grp .
     2066     do
     2067     on error undo, return error
     2068     :
     2069       find first locked_hold-goods exclusive-lock
     2070         where locked_hold-goods.cat-code = p-cat-code
     2071           and locked_hold-goods.time-code = p-time-code
     2072           and locked_hold-goods.gds-code = p-gds-code
     2073         no-error .
     2074       if available locked_hold-goods
     2075       then do:
     2076       end.
     2077       else do:
     2078         create locked_hold-goods .
     2079         assign
     2080           locked_hold-goods.cat-code = p-cat-code
     2081           locked_hold-goods.time-code = p-time-code
     2082           locked_hold-goods.gds-code = p-gds-code
     2083           locked_hold-goods.grp-name = p-grp-name
     2084         .
     2085       end.
     2086       assign
     2087         v-num-entries = num-entries(right-trim(p-grp-name, chr(47)), chr(47))
     2088       .
     2089       do v-ii = 1 to v-num-entries
     2090       on error undo, return error
     2091       :
     2092         assign
     2093           v-node-name = entry(v-ii, p-grp-name, chr(47))
     2094           v-grp-name = v-grp-name + (if v-grp-name = "":U
     2095                                     then "":U
     2096                                     else chr(47)) +
     2097                       entry(v-ii, p-grp-name, chr(47))
     2098           v-is-term = (if v-ii = v-num-entries
     2099                       then yes
     2100                       else no)
     2101         .
     2102         run harh-create-grp-node in this-procedure
     2103           (input p-cat-code
     2104           ,input p-time-code
     2105           ,input v-node-name
     2106           ,input v-grp-name
     2107           ,input v-upper-code
     2108           ,input-output v-node-code
     2109           ,input v-is-term
     2110           ) no-error.
     2111         if error-status :error
     2112         then do:
     2113           message
     2114           vss-workfile vss-revision vss-description skip
     2115           "Ошибка при заполнении межфирменных архивов" SKIP
     2116           "Группа товаров" p-grp-name
     2117           view-as alert-box error .
     2118           return error .
     2119         end.
     2120         assign
     2121           v-upper-code = v-node-code
     2122         .
     2123       end.
     2124       assign
     2125         locked_hold-goods.node-code = v-node-code
     2126         p-node-code                 = v-node-code
     2127       .
     2128     end.
     2129   end procedure.
     2130   procedure harh-create-grp-node :
     2131     define input parameter p-cat-code like ub.hold-time.cat-code no-undo .
     2132     define input parameter p-time-code like ub.hold-time.time-code no-undo .
     2133     define input parameter p-node-name like ub.hold-gds-grp.node-name no-undo .
     2134     define input parameter p-grp-name like ub.hold-gds-grp.grp-name no-undo .
     2135     define input parameter p-upper-code like ub.hold-gds-grp.upper-code no-undo .
     2136     define input-output parameter p-node-code like ub.hold-gds-grp.node-code no-undo .
     2137     define input parameter p-is-term like ub.hold-gds-grp.is-term no-undo .
     2138     define buffer locked_hold-gds-grp for ub.hold-gds-grp .
     2139     define buffer last_hold-gds-grp for ub.hold-gds-grp.
     2140     do
     2141     on error undo, return error
     2142     :
     2143       find first locked_hold-gds-grp exclusive-lock
     2144         where locked_hold-gds-grp.cat-code = p-cat-code
     2145           and locked_hold-gds-grp.time-code = p-time-code
     2146           and locked_hold-gds-grp.node-name = p-node-name
     2147           and locked_hold-gds-grp.upper-code = p-upper-code
     2148         no-error .
     2149       if available locked_hold-gds-grp
     2150       then do:
     2151         assign
     2152           p-node-code = locked_hold-gds-grp.node-code
     2153         .
     2154         return.
     2155       end.
     2156       else do:
     2157         find last last_hold-gds-grp no-lock
     2158           where last_hold-gds-grp.cat-code = p-cat-code
     2159             and last_hold-gds-grp.time-code = p-time-code
     2160           use-index pi
     2161           no-error .
     2162         create locked_hold-gds-grp .
     2163         assign
     2164           locked_hold-gds-grp.cat-code = p-cat-code
     2165           locked_hold-gds-grp.time-code = p-time-code
     2166           locked_hold-gds-grp.node-name = p-node-name
     2167           locked_hold-gds-grp.grp-name = right-trim(p-grp-name, chr(47)) + chr(47)
     2168           locked_hold-gds-grp.upper-code = p-upper-code
     2169           locked_hold-gds-grp.node-code = (if available last_hold-gds-grp
     2170                                             then (last_hold-gds-grp.node-code + 1)
     2171                                             else 1
     2172                                             )
     2173           locked_hold-gds-grp.is-term = p-is-term
     2174           p-node-code = locked_hold-gds-grp.node-code
     2175         .
     2176       end.
     2177     end.
     2178   end procedure.
