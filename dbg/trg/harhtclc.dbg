     1136           view-as alert-box error .
     1137         undo, return error .
     1138       end.
     1139       find first buf_doc-line no-lock
     1140         where buf_doc-line.doc-code  = p-doc-code
     1141           and buf_doc-line.artic     = p-artic
     1142           and buf_doc-line.prod-type = p-prod-type
     1143           and buf_doc-line.prod-code = p-prod-code
