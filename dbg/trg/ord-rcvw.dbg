        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.ord-doc-rcv  old old_ord-doc-rcv  .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись поставки".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   procedure factord :
      305     define input  parameter p-fact-date            as date    no-undo .
      306     define input  parameter p-fact-time            as integer no-undo .
      307     define input  parameter p-fact-num             as integer no-undo .
      308     define input  parameter p-shift-date           as date    no-undo .
      309     define input  parameter p-shift-num            as integer no-undo .
      310     define input  parameter p-shift-on             as logical no-undo .
      311     define output parameter p-fact-order           as decimal no-undo .
      312     define output parameter p-shift-end-fact-order as decimal no-undo .
      313     define output parameter p-day-end-fact-order   as decimal no-undo .
      314     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      315     if p-fact-date = ?
      316     then do:
      317       return error "Не указана фактическая дата" .
      318     end.
      319     define variable v-fact-date-num as integer no-undo .
      320     assign
      321       v-fact-date-num = integer(p-fact-date)
      322     .
      323     if p-fact-num = ?
      324     or p-fact-num = 0
      325     then do:
      326       return error "Не задан p-fact-num " + string(p-fact-num) .
      327     end.
      328     if p-fact-num < 0
      329     then do:
      330       return error "Отрицательный fact-num " + string(p-fact-num) .
      331     end.
      332     if p-fact-num >= 100000000
      333     then do:
      334       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      335     end.
      336     if p-shift-on = true
      337     then do:
      338       if p-shift-date = ?
      339       then do:
      340         return error "Не задана дата смены" .
      341       end.
      342       if p-shift-num = ?
      343       or p-shift-num = 0
      344       then do:
      345         return error "Не задан номер смены" .
      346       end.
      347     end.
      348     else do:
      349       assign
      350         p-shift-date = p-fact-date
      351         p-shift-num  = 24
      352       .
      353     end.
      354     define variable v-shift-offset as integer no-undo .
      355     if p-shift-date = p-fact-date
      356     then do:
      357       assign
      358         v-shift-offset = 1
      359       .
      360     end.
      361     if p-shift-date < p-fact-date
      362     then do:
      363       assign
      364         v-shift-offset = 0
      365       .
      366     end.
      367     if p-shift-date > p-fact-date
      368     then do:
      369       message
      370         vss-workfile vss-revision vss-description skip
      371         "Неправильная дата закрытия смены" skip
      372         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      373         view-as alert-box error .
      374       undo, return error
      375         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      376           ,string(p-fact-date, '99/99/9999':U)
      377           ,string(p-shift-date, '99/99/9999':U)
      378           )
      379       .
      380     end.
      381     if p-shift-num < 1
      382     or p-shift-num > 24
      383     then do:
      384       message
      385         vss-workfile vss-revision vss-description skip
      386         "Неправильный номер смены" skip
      387         "p-shift-num" p-shift-num skip
      388         view-as alert-box error .
      389       undo, return error return-value .
      390     end.
      391     assign
      392       p-fact-order           = v-fact-date-num
      393                              + v-shift-offset * 0.5
      394                              + p-shift-num    * 0.02 - 0.01
      395                              + p-fact-num     * 0.0000000001
      396       p-shift-end-fact-order = v-fact-date-num
      397                              + v-shift-offset * 0.5
      398                              + p-shift-num    * 0.02
      399       p-day-end-fact-order   = v-fact-date-num
      400                              + 0.99
      401     .
      402     if p-fact-order           <= v-fact-date-num
      403     or p-shift-end-fact-order <= v-fact-date-num
      404     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      405     or p-shift-end-fact-order >= p-day-end-fact-order
      406     then do:
      407       message
      408         vss-workfile vss-revision vss-description skip
      409         "Внутренняя ошибка при генерации фактического номера" skip
      410         "p-fact-date"            p-fact-date            skip
      411         "p-fact-time"            p-fact-time            skip
      412         "p-fact-num"             p-fact-num             skip
      413         "p-shift-date"           p-shift-date           skip
      414         "p-shift-num"            p-shift-num            skip
      415         "p-shift-on"             p-shift-on             skip
      416         "p-shift-end-fact-order" p-shift-end-fact-order skip
      417         "p-day-end-fact-order"   p-day-end-fact-order   skip
      418         "v-fact-date-num"        v-fact-date-num        skip
      419         view-as alert-box error .
      420       undo, return error return-value .
      421     end.
      422   end procedure.
      423   procedure day-begin-fact-order :
      424     define input  parameter p-fact-date            as date    no-undo .
      425     define output parameter p-day-begin-fact-order as decimal no-undo .
      426     do
      427     on error undo, return error return-value
      428     :
      429       if p-fact-date = ?
      430       then do:
      431         assign
      432           p-day-begin-fact-order = 0
      433         .
      434       end.
      435       else do:
      436         assign
      437           p-day-begin-fact-order = integer(p-fact-date)
      438         .
      439       end.
      440     end.
      441   end procedure.
      442   procedure factord-max-fact-order :
      443     define output parameter p-max-fact-order as decimal   no-undo .
      444     do
      445     on error undo, return error return-value
      446     :
      447       run day-begin-fact-order in this-procedure
      448         (input  date(1, 1, 5000)
      449         ,output p-max-fact-order
      450         ) .
      451     end.
      452   end procedure.
      453   procedure factord-cut-archive :
      454     define input  parameter p-obj-type             as character no-undo .
      455     define input  parameter p-obj-code             as integer   no-undo .
      456     define input  parameter p-fact-date            as date      no-undo .
      457     define output parameter p-shift-on             as logical   no-undo .
      458     define output parameter p-shift-date           as date      no-undo .
      459     define output parameter p-shift-num            as integer   no-undo .
      460     define output parameter p-day-end-fact-order   as decimal   no-undo .
      461     define output parameter p-shift-end-fact-order as decimal   no-undo .
      462     define variable v-fact-order as decimal   no-undo .
      463     define buffer buf_shift-obj for ub.shift-obj .
      464     do
      465     on error undo, return error return-value
      466     :
      467   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      468   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      469     (input  p-obj-type
      470     ,input  p-obj-code
      471     ,input  'shift-on=request'
      472     ,output p-shift-on
      473     ) no-error .
      474       if error-status :error
      475       then do:
      476         message
      477           vss-workfile vss-revision vss-description skip
      478           "Ошибка при определении атрибута объекта" skip
      479           "Объект" p-obj-type p-obj-code skip
      480           error-status :get-message(1) skip
      481           return-value skip
      482           view-as alert-box error .
      483         undo, return error return-value .
      484       end.
      485       if p-shift-on = false
      486       then do:
      487         assign
      488           p-shift-date               = ?
      489           p-shift-num                = 0
      490         .
      491       end.
      492       else do:
      493         find first buf_shift-obj share-lock
      494           where buf_shift-obj.obj-type   = p-obj-type
      495             and buf_shift-obj.obj-code   = p-obj-code
      496             and buf_shift-obj.shift-date > p-fact-date
      497           use-index pi
      498           no-error .
      499         if not available buf_shift-obj
      500         or buf_shift-obj.status_ <> 'зкр':U
      501         then do:
      502           message
      503             vss-workfile vss-revision vss-description skip
      504             "Невозможно вычислить последнюю смену" skip
      505             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      506             "Объект" p-obj-type p-obj-code skip
      507             "Дата" p-fact-date skip
      508             view-as alert-box error .
      509           undo, return error return-value .
      510         end.
      511         find last buf_shift-obj share-lock
      512           where buf_shift-obj.obj-type = p-obj-type
      513             and buf_shift-obj.obj-code = p-obj-code
      514             and buf_shift-obj.shift-date <= p-fact-date
      515           use-index pi
      516           no-error .
      517         if available buf_shift-obj
      518         then do:
      519           if  buf_shift-obj.status_ = 'зкр':U
      520           then do:
      521             assign
      522               p-shift-date = buf_shift-obj.shift-date
      523               p-shift-num  = buf_shift-obj.shift-num
      524             .
      525           end.
      526           else do:
      527             message
      528               vss-workfile vss-revision vss-description skip
      529               "Невозможно вычислить последнюю смену" skip
      530               "Статус смены отличен от статуса" 'зкр':U skip
      531               "Объект" p-obj-type p-obj-code skip
      532               "Дата" p-fact-date skip
      533               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      534               view-as alert-box error .
      535             undo, return error return-value .
      536           end.
      537         end.
      538         else do:
      539           assign
      540             p-shift-date = p-fact-date - 1
      541             p-shift-num  = 1
      542           .
      543         end.
      544       end.
      545       run factord in this-procedure
      546         (input  p-fact-date
      547         ,input  1
      548         ,input  1
      549         ,input  p-shift-date
      550         ,input  p-shift-num
      551         ,input  p-shift-on
      552         ,output v-fact-order
      553         ,output p-shift-end-fact-order
      554         ,output p-day-end-fact-order
      555         ) no-error .
      556       if error-status :error
      557       then do:
      558         message
      559           vss-workfile vss-revision vss-description skip
      560           "Ошибка при вызове процедуры factord"
      561           error-status :get-message(1) skip
      562           return-value skip
      563           view-as alert-box error .
      564         undo, return error return-value .
      565       end.
      566     end.
      567   end procedure.
      568   procedure factord-lock-shift :
      569     define input  parameter p-obj-type  as character no-undo .
      570     define input  parameter p-obj-code  as integer   no-undo .
      571     define input  parameter p-fact-date as date      no-undo .
      572     define parameter buffer buf_shift-obj for ub.shift-obj .
      573     define variable v-shift-on      as logical   no-undo .
      574     define variable v-extra-message as character no-undo .
      575     define variable v-error as character no-undo .
      576     do
      577     on error undo, return error return-value
      578     :
      579   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      581     (input  p-obj-type
      582     ,input  p-obj-code
      583     ,input  'shift-on=request'
      584     ,output v-shift-on
      585     ) no-error .
      586       if error-status :error
      587       then do:
      588         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      589         undo, return error v-error .
      590       end.
      591       if v-shift-on = true
      592       then do:
      593         find first buf_shift-obj share-lock
      594           where buf_shift-obj.obj-type   = p-obj-type
      595             and buf_shift-obj.obj-code   = p-obj-code
      596             and buf_shift-obj.shift-date > p-fact-date
      597           use-index pi
      598           no-error .
      599         if not available buf_shift-obj
      600         or buf_shift-obj.status_ <> 'зкр':U
      601         then do:
      602           find last buf_shift-obj
      603             where buf_shift-obj.obj-type = p-obj-type
      604               and buf_shift-obj.obj-code = p-obj-code
      605               and buf_shift-obj.status_  = 'зкр':U
      606             use-index stts
      607             no-error .
      608           if available buf_shift-obj
      609           then do:
      610             assign
      611               v-extra-message =
      612                     substitute("Дата начала последеней закрытой смены на объекте &1"
      613                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      614                               )
      615             .
      616           end.
      617           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      618           undo, return error v-error .
      619         end.
      620       end.
      621     end.
      622   end procedure.
      623   procedure factord-end-day :
      624     define input  parameter p-fact-date            as date    no-undo .
      625     define output parameter p-day-end-fact-order   as decimal no-undo .
      626     do
      627     on error undo, return error return-value
      628     :
      629       if p-fact-date = ?
      630       then do:
      631         return error "Не указана фактическая дата" .
      632       end.
      633       assign
      634         p-day-end-fact-order = integer(p-fact-date) + 0.99
      635       .
      636     end.
      637   end procedure.
      638   procedure factord-to-date :
      639     define input  parameter p-fact-order as decimal no-undo .
      640     define output parameter p-fact-date  as date    no-undo .
      641     define variable v-ref-date  as date      no-undo .
      642     define variable v-ref-delta as integer   no-undo .
      643     do
      644     on error undo, return error return-value
      645     :
      646       if p-fact-order = ?
      647       or p-fact-order = 0
      648       then do:
      649         return error "Не указан fact-order" .
      650       end.
      651       assign
      652         v-ref-date  = date(1, 1, 2000)
      653       .
      654       assign
      655         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      656       .
      657       assign
      658         p-fact-date = v-ref-date + v-ref-delta
      659       .
      660     end.
      661   end procedure.
      662   procedure factord-to-fact-num :
      663     define input  parameter p-fact-order as decimal no-undo .
      664     define output parameter p-fact-num   as integer no-undo .
      665     define variable v-fact-order-trunc as decimal no-undo .
      666     do
      667     on error undo, return error return-value
      668     :
      669       if p-fact-order = ?
      670       or p-fact-order = 0
      671       then do:
      672         return error "Не указан fact-order" .
      673       end.
      674       assign
      675        v-fact-order-trunc = truncate(p-fact-order, 2)
      676       .
      677       assign
      678         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      679       .
      680     end.
      681   end procedure.
      682   procedure factord-to-shift-num :
      683     define input  parameter p-fact-order as decimal no-undo .
      684     define output parameter p-shift-num   as integer no-undo .
      685     define variable  p-shift-numd  as decimal   no-undo .
      686     define variable v-fact-order-trunc as decimal no-undo .
      687     do
      688     on error undo, return error return-value
      689     :
      690       if p-fact-order = ?
      691       or p-fact-order = 0
      692       then do:
      693         return error "Не указан fact-order" .
      694       end.
      695       assign
      696        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      697       .
      698       if v-fact-order-trunc < 0.5 then do:
      699         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      700       end.
      701       assign
      702         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      703         .
      704        assign
      705         p-shift-num = truncate (p-shift-numd , 0)
      706       .
      707     end.
      708   end procedure.
      709   define variable num_rec        as integer   no-undo .
      710   define variable num_gds        as integer   no-undo .
      711   define variable start-time     as integer   no-undo .
      712   define variable current-time   as character no-undo .
      713   define variable current-action as character no-undo .
      714   define variable v-description-ord-type as character no-undo .
      715   define variable v-today as date      no-undo.
      716   define variable v-time  as integer   no-undo.
      717   define buffer o-clients  for clients.
      718   define buffer c-clients  for clients.
      719   define variable f-host as integer no-undo .
      720   assign
      721     v-description-ord-type = ub.ORD-doc-rcv.doc-type
      722   .
      723   def frame a
      724     ub.ORD-doc-rcv.rcv-code                    label "Поставка" skip
      725     v-description-ord-type                     label "Тип документа" skip
      726     current-action         format "x(40)"      no-label skip
      727     num_rec                format ">>>>>>>9"   label "Обработано артикулов" skip
      728     ub.ord-line-rcv.artic                      label "Текущий артикул"      skip
      729     num_gds                format ">>>>>>>9"   label "Обработано признаков" skip
      730     current-time           format "x(8)"       label "Время" skip
      731     with view-as dialog-box side-labels three-d
      732     title "Обработка поставки"
      733     .
      734   main-block :
      735   do transaction
      736   on error undo main-block, return error
      737   :
      738     if not g#news
      739     then do:
      740   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
      742     (output ub.ord-doc-rcv.user-db-num
      743     ,output ub.ord-doc-rcv.user-name
      744     ,output ub.ord-doc-rcv.sys-date
      745     ,output ub.ord-doc-rcv.sys-time
      746     ,output ub.ord-doc-rcv.sys-time-int
      747     )  .
      748     end.
      749     if ub.ord-doc-rcv.status_ = 'новый':U
      750     then do:
      751         if ub.ord-doc-rcv.creid = "" then do:
      752           assign
      753             ub.ord-doc-rcv.creid = g#userid
      754           .
      755         end.
      756       assign
      757         ub.ord-doc-rcv.fact-num = next-value (s-ord-fact, ub)
      758       .
      759     end.
      760     if ub.ORD-doc-rcv.doc-type = "in":U then do:
      761        find first o-clients where
      762                   o-clients.obj-code = ub.ORD-doc-rcv.obj-code and
      763                   o-clients.obj-type = ub.ORD-doc-rcv.obj-type no-lock no-error .
      764                   if not available o-clients then do:
      765                       message
      766                         vss-workfile vss-revision vss-description skip
      767                         "Объект" ub.ORD-doc-rcv.obj-code ub.ORD-doc-rcv.obj-type skip
      768                         "не найден !" skip
      769                         "Поставка" ub.ORD-doc-rcv.rcv-code skip
      770                         view-as alert-box error .
      771                       undo main-block, return error.
      772                   end.
      773          if ub.ORD-doc-rcv.obj-type = 'маг':U then do:
      774             find first shop where shop.obj-code = ub.ORD-doc-rcv.obj-code no-lock .
      775             f-host = shop.host-code.
      776          end.
      777          if ub.ORD-doc-rcv.obj-type = 'скл':U then do:
      778             find first store where store.obj-code = ub.ORD-doc-rcv.obj-code no-lock .
      779             f-host = store.host-code.
      780          end.
      781          if ub.ORD-doc-rcv.host-code <> f-host then do:
      782                       message
      783                         vss-workfile vss-revision vss-description skip
      784                         "Объект" ub.ORD-doc-rcv.obj-code ub.ORD-doc-rcv.obj-type skip
      785                         "не принадлежит фирме " ub.ORD-doc-rcv.host-code "!" skip
      786                         "Поставка" ub.ORD-doc-rcv.rcv-code skip
      787                         view-as alert-box error .
      788                       undo main-block, return error.
      789          end.
      790        find first c-clients where
      791                   c-clients.obj-code = ub.ORD-doc-rcv.cli-code and
      792                   c-clients.obj-type = ub.ORD-doc-rcv.cli-type no-lock no-error .
      793                   if not available c-clients then do:
      794                       message
      795                         vss-workfile vss-revision vss-description skip
      796                         "Контрагент" ub.ORD-doc-rcv.obj-code ub.ORD-doc-rcv.obj-type skip
      797                         "не найден !" skip
      798                         "Поставка" ub.ORD-doc-rcv.rcv-code skip
      799                         view-as alert-box error .
      800                       undo main-block, return error.
      801                   end.
      802          if ub.ORD-doc-rcv.cli-type = 'маг':U then do:
      803             find first shop where shop.obj-code = ub.ORD-doc-rcv.cli-code no-lock .
      804             f-host = shop.host-code.
      805          end.
      806          if ub.ORD-doc-rcv.cli-type = 'скл':U then do:
      807             find first store where store.obj-code = ub.ORD-doc-rcv.cli-code no-lock .
      808             f-host = store.host-code.
      809          end.
      810          if ub.ORD-doc-rcv.host-code <> f-host then do:
      811                       message
      812                         vss-workfile vss-revision vss-description skip
      813                         "Контрагент" ub.ORD-doc-rcv.cli-code ub.ORD-doc-rcv.cli-type skip
      814                         "не принадлежит фирме " ub.ORD-doc-rcv.host-code "!" skip
      815                         "Поставка" ub.ORD-doc-rcv.rcv-code skip
      816                         view-as alert-box error .
      817                       undo main-block, return error.
      818          end.
      819     end.
      820     if ub.ORD-doc-rcv.doc-type = "out":U then do:
      821        find first o-clients where
      822                   o-clients.obj-code = ub.ORD-doc-rcv.obj-code and
      823                   o-clients.obj-type = ub.ORD-doc-rcv.obj-type no-lock no-error .
      824                   if not available o-clients then do:
      825                       message
      826                         vss-workfile vss-revision vss-description skip
      827                         "Объект" ub.ORD-doc-rcv.obj-code ub.ORD-doc-rcv.obj-type skip
      828                         "не найден !" skip
      829                         "Поставка" ub.ORD-doc-rcv.rcv-code skip
      830                         view-as alert-box error .
      831                       undo main-block, return error.
      832                   end.
      833          if ub.ORD-doc-rcv.obj-type = 'маг':U then do:
      834             find first shop where shop.obj-code = ub.ORD-doc-rcv.obj-code no-lock .
      835             f-host = shop.host-code.
      836          end.
      837          if ub.ORD-doc-rcv.obj-type = 'скл':U then do:
      838             find first store where store.obj-code = ub.ORD-doc-rcv.obj-code no-lock .
      839             f-host = store.host-code.
      840          end.
      841          if ub.ORD-doc-rcv.host-code <> f-host then do:
      842                       message
      843                         vss-workfile vss-revision vss-description skip
      844                         "Объект" ub.ORD-doc-rcv.obj-code ub.ORD-doc-rcv.obj-type skip
      845                         "не принадлежит фирме " ub.ORD-doc-rcv.host-code "!" skip
      846                         "Поставка" ub.ORD-doc-rcv.rcv-code skip
      847                         view-as alert-box error .
      848                       undo main-block, return error.
      849          end.
      850        find first c-clients where
      851                   c-clients.obj-code = ub.ORD-doc-rcv.cli-code and
      852                   c-clients.obj-type = ub.ORD-doc-rcv.cli-type no-lock no-error .
      853                   if not available c-clients then do:
      854                       message
      855                         vss-workfile vss-revision vss-description skip
      856                         "Контрагент" ub.ORD-doc-rcv.obj-code ub.ORD-doc-rcv.obj-type skip
      857                         "не найден !" skip
      858                         "Поставка" ub.ORD-doc-rcv.rcv-code skip
      859                         view-as alert-box error .
      860                       undo main-block, return error.
      861                   end.
      862     end.
      863     if ub.ORD-doc-rcv.status_ = 'факт':U and g#news = false  then do:
      864       define var l-date as date      no-undo .
      865       define var l-time as integer   no-undo .
      866       define variable s-date as date      no-undo .
      867       define variable s-num  as integer   no-undo .
      868       define variable s-name as character no-undo .
      869       run cur-time in this-procedure (output l-date ,output  l-time) no-error .
      870       ub.ORD-doc-rcv.fact-time  = l-time .
      871       run gbl/factdate.p ( input ub.ORD-doc-rcv.obj-type  ,
      872                     input ub.ORD-doc-rcv.obj-code   ,
      873                     input-output ub.ORD-doc-rcv.fact-date ,
      874                     input-output ub.ORD-doc-rcv.fact-time ,
      875                     input-output s-date  ,
      876                     input-output s-num   ,
      877                     input-output s-name  ,
      878                     input        yes     ) no-error .
      879       assign
      880         ub.ORD-doc-rcv.shift-date = s-date
      881         ub.ORD-doc-rcv.shift-num  = s-num
      882         ub.ord-doc-rcv.shift-name = s-name
      883        .
      884       if not g#news then do:
      885         assign
      886           ub.ORD-doc-rcv.fact-num = next-value (s-ORD-fact, ub)
      887         .
      888         define variable v-fact-order           as decimal no-undo .
      889         define variable v-shift-end-fact-order as decimal no-undo .
      890         define variable v-day-end-fact-order   as decimal no-undo .
      891         define variable l-shift-on as logical no-undo .
      892   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      894     (input  ub.ORD-doc-rcv.obj-type
      895     ,input  ub.ORD-doc-rcv.obj-code
      896     ,input  'shift-on=request'
      897     ,output l-shift-on
      898     ) no-error .
      899         if error-status :error then do:
      900           message
      901             vss-workfile vss-revision vss-description skip
      902             "Ошибка при определении атрибута объекта" skip
      903             "Поставка" ub.ORD-doc-rcv.rcv-code skip
      904             "Объект" ub.ORD-doc-rcv.obj-type ub.ORD-doc-rcv.obj-code skip
      905             error-status :get-message(1) skip
      906             return-value skip
      907             view-as alert-box error .
      908           undo main-block, return error .
      909         end.
      910         run factord in this-procedure
      911           (input  ub.ORD-doc-rcv.fact-date
      912           ,input  ub.ORD-doc-rcv.fact-time
      913           ,input  ub.ORD-doc-rcv.fact-num
      914           ,input  ub.ORD-doc-rcv.shift-date
      915           ,input  ub.ORD-doc-rcv.shift-num
      916           ,input  l-shift-on
      917           ,output v-fact-order
      918           ,output v-shift-end-fact-order
      919           ,output v-day-end-fact-order
      920           ) no-error .
      921         if error-status :error
      922         or v-fact-order = ?
      923         or v-fact-order = 0 then do:
      924           message
      925             vss-workfile vss-revision vss-description skip
      926             "Ошибка при определении фактического номера складского документа" skip
      927             "Поставка" ub.ORD-doc-rcv.rcv-code skip
      928             "fact-date"               ub.ORD-doc-rcv.fact-date   skip
      929             "fact-time"               ub.ORD-doc-rcv.fact-time   skip
      930             "fact-num"                ub.ORD-doc-rcv.fact-num    skip
      931             "shift-date"              ub.ORD-doc-rcv.shift-date  skip
      932             "shift-num"               ub.ORD-doc-rcv.shift-num   skip
      933             "v-fact-order"            v-fact-order           skip
      934             "v-shift-end-fact-order"  v-shift-end-fact-order skip
      935             "v-day-end-fact-order"    v-day-end-fact-order   skip
      936             error-status :get-message(1) skip
      937             return-value skip
      938             view-as alert-box error .
      939           undo, return error .
      940         end.
      941         assign
      942           ub.ORD-doc-rcv.fact-order = v-fact-order
      943         .
      944       end.
      945     end.
      946     run cur-time in this-procedure ( output v-today
      947                                    , output start-time
      948                                    ).
      949     assign
      950       current-action = "Проверка статуса."
      951     .
      952     view frame a.
      953       display
      954       ub.ORD-doc-rcv.rcv-code
      955       v-description-ord-type
      956       with frame a.
      957     assign
      958       current-action = "Проверка строк."
      959       .
      960     for each ub.ord-line-rcv exclusive-lock
      961       where ub.ord-line-rcv.doc-code = ub.ORD-doc-rcv.doc-code
      962         and ub.ord-line-rcv.rcv-code = ub.ORD-doc-rcv.rcv-code
      963     on error undo main-block, return error
      964     on end-key undo main-block, return error
      965     :
      966       run process-line in this-procedure no-error .
      967       if error-status :error then do:
      968         message
      969           vss-workfile vss-revision vss-description skip
      970           "Ошибка при обработке товара" skip
      971           "Поставка" ub.ORD-doc-rcv.rcv-code skip
      972           "Артикул" ub.ord-line-rcv.artic ub.ord-line-rcv.prod-type ub.ord-line-rcv.prod-code skip
      973           error-status :get-message(1) skip
      974           return-value skip
      975           view-as alert-box error .
      976   if session :set-wait-state( "" ) then.
      977         undo main-block, return error .
      978       end.
      979     end.
      980   if g#news  = false and ub.ord-doc-rcv.status_  <> 'новый':U then do:
      981       create ub.c-ord-doc.
      982       BUFFER-COPY old_ord-doc-rcv  TO ub.c-ord-doc
      983       assign
      984         ub.c-ord-doc.chip-num           = next-value (s-corr-chip, ub)
      985         ub.c-ord-doc.corr-time          = start-time
      986         ub.c-ord-doc.corr-user-db-num   = g#db-num
      987         ub.c-ord-doc.corr-user-name     = g#userid
      988         ub.c-ord-doc.corr-date          = v-today
      989      .
      990   end.
      991    if ub.ORD-doc-rcv.status_ = 'факт':U or
      992     ( ub.ORD-doc-rcv.status_ = 'поставка':U AND OLD_ORD-doc-rcv.status_ <> 'поставка':U ) or
      993       ub.ORD-doc-rcv.status_ = 'запрос':U
      994       then do:
      995        if not g#news  then do:
      996           run str/callnews.p
      997             (input 'ord-doc-rcv':U
      998             ,input (buffer ub.ORD-doc-rcv:handle)
      999             ) no-error .
     1000           if error-status :error then do:
     1001             message
     1002               vss-workfile vss-revision vss-description skip
     1003               "1.Невозможно маршрутизировать ORD-doc-rcv для отправки в новости" skip
     1004               "Поставка" ub.ORD-doc-rcv.rcv-code skip
     1005               error-status :get-message(1) skip
     1006               return-value skip
     1007               view-as alert-box error .
     1008             undo, return error .
     1009           end.
     1010        end.
     1011        else do:
     1012        end.
     1013    end.
     1014     if  not g#news  and
     1015        ub.ord-doc-rcv.status_  = 'поставка':U and
     1016        old_ord-doc-rcv.status_ = 'поставка':U and
     1017     (  old_ord-doc-rcv.ship-time <> ub.ord-doc-rcv.ship-time or
     1018        old_ord-doc-rcv.fact-ship-time <> ub.ord-doc-rcv.fact-ship-time or
     1019        old_ord-doc-rcv.trn-code <> ub.ord-doc-rcv.trn-code ) then do:
     1020        run trg/cmd-rcvr.p (input ub.ord-doc-rcv.doc-code, input ub.ord-doc-rcv.rcv-code) no-error .
     1021        if error-status :error then do:
     1022           message
     1023             vss-workfile vss-revision vss-description skip
     1024             error-status :get-message(1) skip
     1025             return-value skip
     1026             "Ошибка trg/cmd-rcvr.p"
     1027             view-as alert-box error
     1028           .
     1029            return error return-value .
     1030        end.
     1031     end.
     1032       if ub.ORD-doc-rcv.doc-type = 'запрос':U and g#db-num = 0 and  g#news then do:
     1033           run str/callnews.p
     1034             (input 'ord-doc-rcv':U
     1035             ,input (buffer ub.ORD-doc-rcv:handle)
     1036             ) no-error .
     1037           if error-status :error then do:
     1038             message
     1039               vss-workfile vss-revision vss-description skip
     1040               "2.Невозможно маршрутизировать ORD-doc-rcv для отправки в новости" skip
     1041               "Связка Заказ ОО - Накладная" ub.ORD-doc-rcv.rcv-code skip
     1042               error-status :get-message(1) skip
     1043               return-value skip
     1044               view-as alert-box error .
     1045             undo, return error .
     1046           end.
     1047       end.
     1048     assign
     1049       current-action = "Проверка строк."
     1050     .
     1051     for each ub.ord-line-rcv exclusive-lock
     1052       where ub.ord-line-rcv.doc-code = ub.ORD-doc-rcv.doc-code
     1053         and ub.ord-line-rcv.rcv-code = ub.ORD-doc-rcv.rcv-code
     1054     on error undo main-block, return error
     1055     on end-key undo main-block, return error
     1056     :
     1057       run process-line in this-procedure no-error .
     1058       if error-status :error then do:
     1059         message
     1060           vss-workfile vss-revision vss-description skip
     1061           "Ошибка при обработке товара" skip
     1062           "Поставка" ub.ORD-doc-rcv.rcv-code skip
     1063           "Артикул" ub.ord-line-rcv.artic ub.ord-line-rcv.prod-type ub.ord-line-rcv.prod-code skip
     1064           error-status :get-message(1) skip
     1065           return-value skip
     1066           view-as alert-box error .
     1067   if session :set-wait-state( "" ) then.
     1068         undo main-block, return error .
     1069       end.
     1070     end.
     1071   define variable v-message as character no-undo .
     1072   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1073     (input ?
     1074     ,input this-procedure:handle
     1075     ,input ?
     1076     ,input 'event_rcv':U
     1077     ,input  buffer old_ord-doc-rcv:handle
     1078     ,input  buffer ub.ord-doc-rcv:handle
     1079     ,input ''
     1080     ,input ''
     1081     ) no-error .
     1082       if error-status:error
     1083       then do:
     1084         v-message = substitute("&1 &2 &3&4Ошибка при вызове процедуры rum-runa.i&4&5&4&5&6"
     1085                                 ,vss-workfile
     1086                                 ,vss-revision
     1087                                 ,vss-description
     1088                                 ,chr(10)
     1089                                 , error-status:get-message(1)
     1090                                 , return-value ).
     1091         if not g#news then do:
     1092           message
     1093           v-message
     1094           view-as alert-box error .
     1095         end.
     1096         undo main-block,  return error v-message.
     1097       end.
     1098       if g#oxml = yes
     1099       then do:
     1100       run str/calloxml.p (
     1101             input 'update':U
     1102           , input 'ord-doc-rcv':U
     1103           , input ( buffer ub.ord-doc-rcv:handle )
     1104       ) no-error.
     1105       if error-status :error
     1106       then do:
     1107           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1108                                , chr(10)
     1109                                , vss-workfile
     1110                                , return-value
     1111                                , error-status :get-message ( 1 ) ).
     1112       end.
     1113       end.
     1114   end.
     1115   procedure show-action :
     1116     do
     1117     on error undo, return error
     1118     :
     1119       define input parameter p-action as character no-undo .
     1120       define variable v-today as date      no-undo.
     1121       define variable v-time  as integer   no-undo.
     1122       run cur-time in this-procedure ( output v-today
     1123                                      , output v-time
     1124                                      ).
     1125       assign
     1126         current-time = string(v-time - start-time, "HH:MM:SS")
     1127         current-action = p-action
     1128       .
     1129       display
     1130         current-time current-action
     1131         with frame a.
     1132     end.
     1133   end procedure.
     1134   procedure process-line :
     1135     do
     1136     on error undo, return error
     1137     :
     1138       define variable v-root-node like ub.gds-prt.node-code no-undo .
     1139       define variable l-goods-twounit as logical no-undo .
     1140       define variable rsrv-code       as character no-undo .
     1141       define variable v-today as date      no-undo.
     1142       define variable v-time  as integer   no-undo.
     1143       def buffer buf_parts for ub.parts .
     1144       assign
     1145         num_rec   = num_rec + 1
     1146       .
     1147       if num_rec mod 10 = 0 then do:
     1148         run cur-time in this-procedure ( output v-today
     1149                                        , output v-time
     1150                                        ).
     1151         assign
     1152           current-time = string(v-time - start-time, "HH:MM:SS")
     1153         .
     1154         display
     1155           num_rec ub.ord-line-rcv.artic num_gds current-time current-action
     1156           with frame a.
     1157       end.
     1158       find first ub.goods no-lock
     1159         where ub.goods.artic     = ub.ord-line-rcv.artic
     1160           and ub.goods.prod-type = ub.ord-line-rcv.prod-type
     1161           and ub.goods.prod-code = ub.ord-line-rcv.prod-code
     1162         no-error .
     1163       if not available ub.goods then do:
     1164         message
     1165           vss-workfile vss-revision vss-description skip
     1166           "Не найден товар" skip
     1167           "Поставка" ub.ORD-doc-rcv.rcv-code skip
     1168           "Артикул" ub.ord-line-rcv.artic ub.ord-line-rcv.prod-type ub.ord-line-rcv.prod-code skip
     1169           "" (if g#db-num = 0
     1170               then "Если товар был переименован," + chr(10)
     1171                  + "необходимо принять новости в УБД и переформировать пакеты"
     1172               else ""
     1173             ) skip
     1174           view-as alert-box error .
     1175         undo, return error .
     1176       end.
     1177       if ub.ord-line-rcv.cli-base-rate = ? or  ub.ord-line-rcv.cli-base-rate = 0 then do:
     1178          assign
     1179            ub.ord-line-rcv.cli-base-rate = ub.goods.cli-base-rate
     1180          .
     1181       end.
     1182       if ub.ord-line-rcv.unit-cli = ? or  ub.ord-line-rcv.unit-cli = "" then do:
     1183          assign
     1184            ub.ord-line-rcv.unit-cli = ub.goods.unit-cli
     1185          .
     1186       end.
     1187     end.
     1188   end procedure .
