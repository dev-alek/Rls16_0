      989   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      990   procedure cur-time :
      991      define output parameter p-today as date      no-undo .
      992      define output parameter p-time  as integer   no-undo .
      993     do
      994     on error undo, return error
      995     :
      996       define variable v-date1 as date      no-undo .
      997       define variable v-date2 as date      no-undo .
      998       define variable v-time  as integer   no-undo .
      999       assign
     1000         v-date1 = today
     1001         v-time  = time
     1002         v-date2 = today
     1003       .
     1004       if v-date1 <> v-date2
     1005       then do:
     1006         assign
     1007           v-date1 = today
     1008           v-time  = v-time
     1009         .
     1010       end.
     1011       assign
     1012         p-today = v-date1
     1013         p-time  = v-time
     1014       .
     1015     end.
     1016   end.
     1017   function cur-time-date returns character
     1018   :
     1019     return string(today, '99/99/9999':U) .
     1020   end.
     1021   function cur-time-mjd returns decimal
     1022   :
     1023     define variable v-date as date      no-undo .
     1024     define variable v-time as integer   no-undo .
     1025     run cur-time in this-procedure
     1026       (output v-date
     1027       ,output v-time
     1028       ) .
     1029     return integer(v-date) - 2400002 + (v-time / 86400) .
     1030   end.
     1031   function cur-time-get-ending-index returns integer
     1032   (input p-number as integer
     1033   )
     1034   :
     1035     if p-number < 0
     1036     or p-number = ?
     1037     then do:
     1038       return 1 .
     1039     end.
     1040     define variable v-rest as integer   no-undo .
     1041     assign
     1042       p-number = p-number modulo 100
     1043     .
     1044     if p-number < 20
     1045     then do:
     1046       assign
     1047         v-rest = p-number
     1048       .
     1049     end.
     1050     else do:
     1051       assign
     1052         v-rest = p-number modulo 10
     1053       .
     1054     end.
     1055     case v-rest :
     1056       when 1
     1057       then do:
     1058         return 2 .
     1059       end.
     1060       when 2 or
     1061       when 3 or
     1062       when 4
     1063       then do:
     1064         return 3 .
     1065       end.
     1066       otherwise do:
     1067         return 1 .
     1068       end.
     1069     end case .
     1070   end.
     1071   procedure cur-time-mjd-to-date :
     1072      define input  parameter i-mjd-diff as decimal no-undo.
     1073      define output parameter o-Date     as date    no-undo.
     1074      define output parameter o-Time     as integer no-undo.
     1075      define variable v-day-number as integer   no-undo .
     1076      if    i-mjd-diff < 0
     1077         or i-mjd-diff = ?
     1078      then do:
     1079         return "?" .
     1080      end.
     1081      assign
     1082         v-day-number = truncate(i-mjd-diff,0).
     1083         o-Date = date(v-day-number + 2400002).
     1084         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1085     .
     1086   end.
     1087   function cur-time-mjd-to-string returns character
     1088   (input p-mjd-diff as decimal
     1089   )
     1090   :
     1091     define variable v-day-number as integer   no-undo .
     1092     define variable v-seconds    as integer   no-undo .
     1093     define variable v-hour       as integer   no-undo .
     1094     define variable v-min        as integer   no-undo .
     1095     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1096     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1097     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1098     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1099     if p-mjd-diff < 0
     1100     or p-mjd-diff = ?
     1101     then do:
     1102       return "?" .
     1103     end.
     1104     assign
     1105       v-day-number = integer(truncate(p-mjd-diff,0))
     1106       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1107     .
     1108     if v-seconds > 86400
     1109     then do:
     1110       assign
     1111         v-seconds = 86400 - 1
     1112       .
     1113     end.
     1114     if v-seconds < 0
     1115     then do:
     1116       assign
     1117         v-seconds = 0
     1118       .
     1119     end.
     1120     assign
     1121       v-hour = truncate(v-seconds / 3600, 0)
     1122     .
     1123     assign
     1124       v-seconds = v-seconds modulo 3600
     1125     .
     1126     assign
     1127       v-min = truncate(v-seconds / 60, 0)
     1128     .
     1129     assign
     1130       v-seconds = v-seconds modulo 60
     1131     .
     1132     return
     1133         (if v-day-number <> 0
     1134           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1135           else ""
     1136         )
     1137       + (if v-day-number <> 0 or v-hour <> 0
     1138           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1139           else ""
     1140         )
     1141       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1142           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1143           else ""
     1144         )
     1145       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1146       .
     1147   end.
     1148   function cur-time-string returns character
     1149   :
     1150     define variable v-date as date      no-undo .
     1151     define variable v-time as integer   no-undo .
     1152     run cur-time in this-procedure
     1153       (output v-date
     1154       ,output v-time
     1155       ) .
     1156     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1157   end.
     1158   function cur-time-string-sec returns character
     1159   :
     1160     define variable v-date as date      no-undo .
     1161     define variable v-time as integer   no-undo .
     1162     run cur-time in this-procedure
     1163       (output v-date
     1164       ,output v-time
     1165       ) .
     1166     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1167   end.
     1168   function cur-time-custom  returns character
     1169   (input p-prefix as character
     1170   ,input p-date-format as character
     1171   ,input p-delimiter as character
     1172   ,input p-time-format as character
     1173   ,input p-suffix as character
     1174   )
     1175   :
     1176     define variable v-date as date      no-undo .
     1177     define variable v-time as integer   no-undo .
     1178     run cur-time in this-procedure
     1179       (output v-date
     1180       ,output v-time
     1181       ) .
     1182     return
     1183       p-prefix
     1184       + string(v-date, p-date-format)
     1185       + p-delimiter
     1186       + string(v-time, p-time-format)
     1187       + p-suffix
     1188       .
     1189   end.
     1190   function cur-time-print  returns character
     1191   :
     1192     define variable v-date as date      no-undo .
     1193     define variable v-time as integer   no-undo .
     1194     run cur-time in this-procedure
     1195       (output v-date
     1196       ,output v-time
     1197       ) .
     1198     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1199   end.
     1200   function cur-time-datetime returns datetime
     1201   :
     1202     define variable v-char as character no-undo .
     1203     define variable v-datetime as datetime no-undo .
     1204     v-char = cur-time-string().
     1205     v-datetime = datetime(v-char).
     1206     return  v-datetime.
     1207   end.
     1208   function cur-time-string-msec returns character
     1209   :
     1210     define variable v-date as datetime  no-undo .
     1211     v-date = now.
     1212     return string(v-date) .
     1213   end.
     1214   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   procedure check-use-bar-code :
     1216     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     1217     do
     1218     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info7, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1219     on stop   undo, return error substitute( "&1. stop", vss-include-info7 )
     1220     on endkey undo, return error substitute( "&1. endkey", vss-include-info7 )
     1221     :
     1222       define buffer buf_bar-code for ub.bar-code .
     1223       find first buf_bar-code no-lock
     1224         where buf_bar-code.b-code     = p-b-code
     1225         no-error .
     1226       if not available buf_bar-code then do:
     1227         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info7, p-b-code ) .
     1228       end.
     1229       if buf_bar-code.stts = integer('99':U) then do:
     1230         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     1231                                 + "Выполняется удаление бар-кода"
     1232                                 ,vss-include-info7
     1233                                 ,p-b-code
     1234                                 ,chr(10)
     1235                               ) .
     1236       end.
     1237       if buf_bar-code.stts = integer('79':U) then do:
     1238         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     1239                                 + "Бар-код выключен"
     1240                                 ,vss-include-info7
     1241                                 ,p-b-code
     1242                                 ,chr(10)
     1243                               ) .
     1244       end.
     1245       return .
     1246     end.
     1247   end procedure.
     1248   define variable mMessFlg  as logical no-undo.
     1249   define variable mMessText as character no-undo.
     1250   mMessFlg =     not g#news
     1251              and not g#auto
     1252              and not g#oxml
     1253              and not g#esys.
     1254   main-block:
     1255   do
     1256   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1257   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1258   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1259   :
