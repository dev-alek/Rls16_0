     1374        or ub.prod-bc.bc-on-type eq 'GTIN':U
     1375     then do:
     1376       if l-prod-bc-weight = true then do:
     1377         if not g#news then do:
     1378   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1379   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1380   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
