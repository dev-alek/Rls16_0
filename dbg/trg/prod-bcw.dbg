     1446                chr(10)).
     1447             if mMessFlg
     1448             then
     1449             message
     1450               vss-workfile vss-revision vss-description skip
     1451               mMessText skip
     1452               error-status :get-message(1) skip
     1453               return-value skip
     1454               view-as alert-box.
     1455             undo main-block, return error mMessText.
     1456           end.
     1457         end.
     1458       end.
     1459     end.
     1460     else do:
     1461       if new( ub.prod-bc )
     1462          and l-prod-bc-weight
     1463       then do:
     1464         run gen-new-code-range-if-neces( input 0,
     1465                                          input 'sclc':U,
     1466                                          input int( ub.prod-bc.b-str ),
     1467                                          input g#news,
     1468                                          input g#db-num,
     1469                                          input g#news-source-db
     1470                                         ) no-error  .
     1471         if error-status:error then do:
     1472           message
     1473           vss-workfile vss-revision vss-description skip
     1474           error-status:get-message(1) skip
     1475           return-value
     1476           view-as alert-box error .
     1477           undo main-block, return error .
     1478         end.
     1479       end.
     1480       if new( ub.prod-bc )
     1481          and l-prod-bc-pgweight
     1482       then do:
     1483         run gen-new-code-range-if-neces( input 0,
     1484                                          input 'pglc':U,
     1485                                          input int( ub.prod-bc.b-str ),
     1486                                          input g#news,
     1487                                          input g#db-num,
     1488                                          input g#news-source-db
     1489                                         ) no-error  .
     1490         if error-status:error then do:
     1491           message
     1492           vss-workfile vss-revision vss-description skip
     1493           error-status:get-message(1) skip
     1494           return-value
     1495           view-as alert-box error .
     1496           undo main-block, return error .
     1497         end.
     1498       end.
     1499     end.
     1500     if (l-prod-bc-weight
     1501     or l-prod-bc-pgweight)
     1502     and (new( ub.prod-bc ) or
     1503                              (oldb.bc-on = no and
     1504                               (oldb.bc-on <> ub.prod-bc.bc-on)
     1505                              )
     1506                             ) then do:
     1507      if l-prod-bc-weight then
     1508      run trg/isvescod.p (input ub.prod-bc.b-code, yes, no, yes, ub.prod-bc.b-str, output loc#log, output v-on, output v-b-str) no-error.
     1509      else
     1510      run trg/ispgwcod.p (input ub.prod-bc.b-code, yes, no, yes, ub.prod-bc.b-str, output loc#log, output v-on, output v-b-str) no-error.
     1511      if not (loc#log and v-on) then do:
     1512        FIND FIRST buf_bar-code where
     1513                   buf_bar-code.b-code = ub.prod-bc.b-code No-ERROR.
     1514   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1515   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run sclcdattr in g#library
     1516     (input  buf_bar-code.gds-code
     1517     ,input  ''
     1518     ,input  0
     1519     ,input  ?
     1520     ,input  yes
     1521     ) no-error .
     1522         if error-status:error then do:
     1523              mMessText = substitute("Не удалось создать атрибут товара на объекте ВЕСОВОЙ КОД" ,
     1524                chr(10)).
     1525               if mMessFlg
     1526               then
     1527               message
     1528               vss-workfile vss-revision vss-description skip
     1529               mMessText skip
     1530               error-status :get-message(1) skip
     1531               return-value skip
     1532               view-as alert-box.
     1533             undo main-block, return error mMessText.
     1534         end.
     1535      end.
     1536     end.
     1537     if not g#news then do:
     1538     run check-use-bar-code in this-procedure ( input ub.prod-bc.b-code) no-error.
     1539     if error-status:error then do:
     1540       undo main-block, return error return-value .
     1541     end.
     1542     end.
     1543     if not g#news
     1544     and ((l-prod-bc-weight
     1545     and not l-prod-bc-global)
     1546        or (l-prod-bc-pgweight
     1547          and not l-prod-bc-global)
     1548        )
     1549       then do:
     1550         find first buf_prod-bc-db where
     1551                    buf_prod-bc-db.b-str = ub.prod-bc.b-str
     1552               AND  buf_prod-bc-db.b-code = ub.prod-bc.b-code
     1553               AND  buf_prod-bc-db.db-num = g#db-num no-error.
     1554         if not available buf_prod-bc-db then do:
     1555           create buf_prod-bc-db.
     1556         end.
     1557         buffer-copy ub.prod-bc to buf_prod-bc-db
     1558         assign
     1559         buf_prod-bc-db.db-num = g#db-num
     1560         .
     1561     end.
     1562     find buf_bar-code where buf_bar-code.b-code = ub.prod-bc.b-code no-lock no-error .
     1563     if available buf_bar-code then do:
     1564       run prod-bch_write-prod-bc-trigger in this-procedure  (
     1565                                           input new(ub.prod-bc)
     1566                                           ,input integer('2':U)
     1567                                           ,input buf_bar-code.gds-code
     1568                                           ,input (if g#news
     1569                                                   then 'db':U
     1570                                                   else (if g#esys
     1571                                                         then 'esys':U
     1572                                                         else "":U)
     1573                                                   )
     1574                                           ,input  (if g#news
     1575                                                     then string(g#news-source-db)
     1576                                                     else (if g#esys
     1577                                                           then string(g#esys-source-esys)
     1578                                                           else "":U)
     1579                                                     )
     1580                                         ) .
     1581     end.
     1582   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1583     (input ?
     1584     ,input this-procedure:handle
     1585     ,input ?
     1586     ,input  ( if new(ub.prod-bc) then 'addprcode':U else 'updateprcode':U )
     1587     ,input  buffer oldb:handle
     1588     ,input  buffer ub.prod-bc:handle
     1589     ,input ''
     1590     ,input ''
     1591     ) no-error .
     1592     if error-status:error
     1593     then do:
     1594       if mMessFlg then do:
     1595         message
     1596           vss-workfile vss-revision vss-description skip
     1597           "Ошибка при вызове процедуры rum-runa.i" skip
     1598           error-status :get-message(1) skip
     1599           return-value skip
     1600           view-as alert-box error .
     1601       end.
     1602       undo main-block,  return error return-value .
     1603     end.
     1604       if g#oxml = yes
     1605       then do:
     1606       run str/calloxml.p (
     1607             input 'update':U
     1608           , input 'prod-bc':U
     1609           , input ( buffer ub.prod-bc:handle )
     1610       ) no-error.
     1611       if error-status :error
     1612       then do:
     1613           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1614                                , chr(10)
     1615                                , vss-workfile
     1616                                , return-value
     1617                                , error-status :get-message ( 1 ) ).
     1618       end.
     1619       end.
     1620   end.
