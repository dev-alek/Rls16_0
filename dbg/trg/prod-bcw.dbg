     1402     ) no-error .
     1403       for each thbjattr_thbj-attr :
     1404           if thbjattr_thbj-attr.prop-code = 'is-scgb':U then v-is-scgb = thbjattr_thbj-attr.property-value-logical .
     1405       end.
     1406       if v-is-scgb <> true then do:
     1407          mMessText = substitute("Создание глобальных весовых кодов запрещено параметром (is-scgb)! &1Изменить этот параметр можно в Администратор-Глобальные настройки",
     1408                chr(10)).
     1409         if mMessFlg
     1410         then
     1411             message
     1412               vss-workfile vss-revision vss-description skip
     1413               mMessText skip
     1414               view-as alert-box.
     1415             undo main-block, return error mMessText.
     1416           end.
     1417         end.
     1418         if new( ub.prod-bc ) then do:
     1419           run gen-new-code-range-if-neces( input v-db-num
     1420                                           ,input 'scgb':U
     1421                                           ,input int( ub.prod-bc.b-str )
     1422                                           ,input g#news
     1423                                           ,input g#db-num
     1424                                           ,input g#news-source-db
     1425                                           ) no-error .
     1426           if error-status:error then do:
     1427             message
     1428             vss-workfile vss-revision vss-description skip
     1429             error-status:get-message(1) skip
     1430             return-value
     1431             view-as alert-box error .
     1432             undo main-block, return error .
     1433           end.
     1434         end.
     1435       end.
     1436       find buf_bar-code where buf_bar-code.b-code = ub.prod-bc.b-code no-lock no-error .
     1437       if available buf_bar-code then do:
     1438         find buf_goods where buf_goods.gds-code = buf_bar-code.gds-code no-lock no-error .
     1439         if available buf_goods and not new buf_goods then do:
     1440           run str/callnews.p (
     1441                                  input 'prod-bc':U
     1442                                 ,input (buffer ub.prod-bc:handle)
     1443                                 ) no-error .
