      855       buf_c-bar-code.gds-code           = p-gds-code
      856       buf_c-bar-code.chip-num           = buf_c-prod-bc.chip-num
      857       buf_c-bar-code.corr-time          = v-time
      858       buf_c-bar-code.corr-user-db-num   = g#db-num
      859       buf_c-bar-code.corr-user-name     = (if g#news
      860                                           then (chr(4) +  'СПН':U)
      861                                           else (if g#esys
      862                                                then (chr(4) +  'ВС':U)
      863                                                else g#userid)
      864                                          )
      865       buf_c-bar-code.corr-date          = v-date
      866       .
      867       create buf_c-gds-hist.
      868       buffer-copy buf_c-prod-bc to buf_c-gds-hist
      869       assign
      870       buf_c-gds-hist.gds-code           = p-gds-code
      871       buf_c-gds-hist.action = (if p-new-record
      872                                 then integer('1':U)
      873                                 else p-action
      874                               )
      875       buf_c-gds-hist.subject = 'prod-bc':U
      876       buf_c-gds-hist.is-news = g#news
      877       buf_c-gds-hist.source-type = (if g#news
