      881                                           else "":U)
      882                                     )
      883       buf_c-gds-hist.source-ref = (if g#news
      884                                     then string(g#news-source-db)
      885                                     else (if g#esys
      886                                           then string(g#esys-source-esys)
      887                                           else "":U)
      888                                     )
      889       .
      890     end.
      891   end procedure.
