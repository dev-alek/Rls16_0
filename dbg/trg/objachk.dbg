      413   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      414   procedure gen-key-rec :
      415     define input  parameter p-tbl-name    as character no-undo.
      416     define input  parameter p-bh_tbl-name as handle    no-undo.
      417     define output parameter p-key-rec     as character no-undo.
      418     do
      419     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      420     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      421     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      422     :
      423       define variable fh               as handle    no-undo .
      424       define variable v-ok             as logical   no-undo .
      425       define variable v-inform         as character no-undo .
      426       define variable v-ind            as integer   no-undo .
      427       define variable v-idx-field-qnty as integer   no-undo .
      428       if p-tbl-name = ?
      429         or p-tbl-name = "":U
      430       then do:
      431         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      432       end.
      433       if not p-bh_tbl-name:available then do:
      434         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      435       end.
      436       assign
      437         p-key-rec = p-tbl-name
      438         v-inform  = p-bh_tbl-name:index-information(1)
      439         v-ind     = 2
      440       .
      441       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      442       on error undo, return error
      443       :
      444         assign
      445           v-inform = p-bh_tbl-name:index-information( v-ind )
      446           v-ind    = v-ind + 1
      447         .
      448       end.
      449       if v-inform = ?
      450         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      451         or entry( 3, v-inform, ",":U ) <> "1":U
      452       then do:
      453         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      454       end.
      455       else do:
      456         assign
      457           v-idx-field-qnty = num-entries( v-inform ) - 4
      458         .
      459         if v-idx-field-qnty < 2 then do:
      460           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      461         end.
      462         do v-ind = 1 to v-idx-field-qnty by 2
      463         on error undo, return error
      464         :
      465           assign
      466             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      467             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      468           .
      469         end.
      470       end.
      471       if p-key-rec = ? then do:
      472         assign
      473           p-key-rec = "":U
      474         .
      475         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      476       end.
      477     end.
      478     return.
      479   end procedure.
      480   procedure gen-where-keyr-tab :
      481     define input  parameter i-tableSerach as character no-undo.
      482     define input  parameter i-tablekey   as character  no-undo.
      483     define input  parameter p-key-rec    as character  no-undo.
      484     define input  parameter p-key-handle as handle     no-undo .
      485     define input  parameter p-db-name    as character  no-undo .
      486     define input  parameter p-tt-handle  as handle     no-undo .
      487     define output parameter o-Where      as character  no-undo.
      488     do
      489     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      490     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      491     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      492     :
      493       define variable v-full-tbl-name  as character no-undo .
      494       define variable bh_tbl-name      as handle    no-undo .
      495       define variable fh_key           as handle    no-undo .
      496       define variable fh_search        as handle    no-undo .
      497       define variable v-field-num      as integer   no-undo .
      498       define variable v-count-fld      as integer   no-undo .
      499       define variable v-inform         as character no-undo .
      500       define variable v-ind            as integer   no-undo .
      501       define variable v-idx-field-qnty as integer   no-undo .
      502       define variable v-field-name     as character no-undo .
      503       define variable v-field-val      as character no-undo .
      504       define variable v-word-link      as character no-undo .
      505       define variable vTable           as character no-undo.
      506       define variable bh_tbl-key       as handle    no-undo .
      507       assign
      508         p-key-rec = trim( p-key-rec )
      509       .
      510       if p-key-handle <> ? then do:
      511         if not valid-handle(p-key-handle)
      512            or p-key-handle:type <> "buffer"
      513         then do:
      514           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      515         end.
      516         if num-entries( p-key-rec, chr(3) ) > 1
      517           or p-key-rec = ?
      518           or p-key-rec = "":U
      519         then do:
      520           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      521         end.
      522       end.
      523       else do:
      524         if p-key-rec = ?
      525           or p-key-rec = "":U
      526         then do:
      527           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      528         end.
      529       end.
      530       assign
      531         vTable = entry( 1 , p-key-rec, chr(3) )
      532       .
      533       if p-tt-handle <> ?
      534         and ( not valid-handle(p-tt-handle)
      535               or p-tt-handle:type <> "buffer"
      536             )
      537       then do:
      538         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      539       end.
      540       if p-tt-handle = ? then do:
      541         assign
      542           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      543         .
      544         create buffer bh_tbl-name for table v-full-tbl-name .
      545       end.
      546       else do:
      547         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      548       end.
      549       assign
      550         v-inform = bh_tbl-name:index-information(1)
      551         v-ind    = 2
      552       .
      553       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      554       on error undo, return error
      555       :
      556         assign
      557           v-inform = bh_tbl-name:index-information( v-ind )
      558           v-ind    = v-ind + 1
      559         .
      560       end.
      561       if v-inform = ?
      562         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      563         or entry( 3, v-inform, ",":U ) <> "1":U
      564       then do:
      565         delete object bh_tbl-name no-error.
      566         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      567       end.
      568       assign
      569         v-idx-field-qnty = num-entries( v-inform ) - 4
      570       .
      571       if v-idx-field-qnty < 2 then do:
      572         delete object bh_tbl-name no-error.
      573         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      574       end.
      575       assign
      576         o-where     = "where":U
      577         v-word-link = "":U
      578         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      579         v-count-fld = 0
      580       .
      581       if i-tablekey ne "" and i-tablekey ne ?
      582       then do:
      583         assign
      584           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      585         .
      586         create buffer bh_tbl-key for table v-full-tbl-name .
      587       end.
      588       if i-tableSerach ne "" and i-tableSerach ne ?
      589       then do:
      590         delete object bh_tbl-name no-error.
      591         assign
      592           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      593         .
      594         create buffer bh_tbl-name for table v-full-tbl-name .
      595       end.
      596       block_where:
      597       do v-ind = 1 to v-idx-field-qnty by 2
      598       on error undo, return error
      599       :
      600         assign
      601           v-count-fld = v-count-fld + 1
      602         .
      603         if p-key-handle = ?
      604           and v-count-fld > v-field-num
      605         then do:
      606           leave block_where.
      607         end.
      608         define variable VfieldKeyTable as handle no-undo.
      609         assign
      610           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      611           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      612         .
      613         if     bh_tbl-key ne ?
      614         then do:
      615            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      616            if VfieldKeyTable eq ?
      617            then next block_where.
      618         end.
      619         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      620         then
      621            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      622         else
      623            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      624         if p-key-handle = ? then do:
      625           assign
      626             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      627           .
      628         end.
      629         else do:
      630           assign
      631             fh_key = p-key-handle:buffer-field( v-field-name )
      632           .
      633           if fh_key = ?
      634             or not valid-handle( fh_key )
      635           then do:
      636             delete object bh_tbl-name.
      637             if     bh_tbl-key ne ?
      638             then
      639                delete object bh_tbl-key.
      640             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      641           end.
      642           assign
      643             v-field-val = fh_key:buffer-value
      644           .
      645         end.
      646         if fh_search:data-type ="character":U then do:
      647           assign
      648             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      649             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      650             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      651             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      652             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      653             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      654             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      655             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      656             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      657             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      658             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      659             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      660             v-field-val = substitute( '"&1"', v-field-val )
      661           .
      662         end.
      663         assign
      664           o-where = substitute( "&1 &2", o-where, v-field-val )
      665         .
      666         if v-word-link = "":U then do:
      667           assign
      668             v-word-link = "and":U
      669           .
      670         end.
      671       end.
      672       delete object bh_tbl-name.
      673       if     bh_tbl-key ne ?
      674       then
      675          delete object bh_tbl-key.
      676       if p-key-handle = ?
      677         and v-count-fld <> v-field-num
      678       then do:
      679         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      680       end.
      681     end.
      682   end procedure.
      683   procedure gen-hn-keyr-tab :
      684     define input  parameter i-tableSerach as character no-undo.
      685     define input  parameter i-tablekey   as character no-undo.
      686     define input  parameter p-key-rec    as character no-undo.
      687     define input  parameter p-key-handle as handle    no-undo .
      688     define input  parameter p-db-name    as character no-undo .
      689     define input  parameter p-tt-handle  as handle    no-undo .
      690     define input  parameter p-stts-lock  as integer   no-undo .
      691     define output parameter o-hn         as handle    no-undo.
      692     define variable v-full-tbl-name as character no-undo.
      693     define variable v-where         as character no-undo.
      694     define variable bh_tbl-name     as handle    no-undo.
      695     define variable vTable          as character no-undo.
      696     do
      697     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      698     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      699     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      700         run gen-where-keyr-tab(i-tableSerach,
      701                                i-tablekey,
      702                                p-key-rec,
      703                                p-key-handle,
      704                                p-db-name,
      705                                p-tt-handle,
      706                                output v-where).
      707         if i-tableSerach ne "" and i-tableSerach ne ?
      708         then do:
      709            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      710            create buffer bh_tbl-name for table v-full-tbl-name .
      711         end.
      712         else do:
      713            if p-tt-handle = ? then do:
      714               assign
      715                  vTable = entry( 1 , p-key-rec, chr(3) )
      716               .
      717               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      718               create buffer bh_tbl-name for table v-full-tbl-name .
      719            end.
      720            else do:
      721               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      722            end.
      723         end.
      724         if p-tt-handle = ? then do:
      725            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      726         end.
      727         else do:
      728            bh_tbl-name:find-first( v-where ) no-error .
      729         end.
      730         o-hn = bh_tbl-name.
      731      end.
      732   end procedure.
      733   procedure gen-hn-keyr :
      734     define input  parameter p-key-rec    as character no-undo.
      735     define input  parameter p-key-handle as handle    no-undo .
      736     define input  parameter p-db-name    as character no-undo .
      737     define input  parameter p-tt-handle  as handle    no-undo .
      738     define input  parameter p-stts-lock  as integer   no-undo .
      739     define output parameter o-hn         as handle    no-undo.
      740     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      741   end.
      742   procedure gen-row-keyr :
      743     define input  parameter p-key-rec    as character no-undo.
      744     define input  parameter p-key-handle as handle    no-undo .
      745     define input  parameter p-db-name    as character no-undo .
      746     define input  parameter p-tt-handle  as handle    no-undo .
      747     define input  parameter p-stts-lock  as integer   no-undo .
      748     define output parameter p-tbl-row    as rowid     no-undo.
      749     define output parameter p-tbl-name   as character no-undo.
      750     define variable vHn as handle no-undo.
      751       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      752       p-tbl-row = if vHn:available then vHn:rowid else ?.
      753       p-tbl-name =  vHn:table.
      754       delete object vHn no-error.
      755     if p-tbl-row = ? then do:
      756       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      757     end.
      758     else do:
      759       return.
      760     end.
      761   end procedure.
      762   procedure gen-key-fv :
      763     define input  parameter p-key-rec    as character no-undo .
      764     define output parameter p-field-list as character no-undo .
      765     define output parameter p-value-list as character no-undo.
      766     do
      767     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      768     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      769     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      770     :
      771       define variable v-full-tbl-name  as character no-undo .
      772       define variable bh_tbl-name      as handle    no-undo .
      773       define variable v-tbl-name       as character no-undo .
      774       define variable v-field-num      as integer   no-undo .
      775       define variable v-count-fld      as integer   no-undo .
      776       define variable v-inform         as character no-undo .
      777       define variable v-ind            as integer   no-undo .
      778       define variable v-idx-field-qnty as integer   no-undo .
      779       define variable v-delim-key      as character no-undo .
      780       if p-key-rec = ?
      781         or p-key-rec = "":U
      782       then do:
      783         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      784       end.
      785       assign
      786         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      787         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      788       .
      789       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      790       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      791       assign
      792         v-inform = bh_tbl-name:index-information(1)
      793         v-ind    = 2
      794       .
      795       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      796       on error undo, return error
      797       :
      798         assign
      799           v-inform = bh_tbl-name:index-information( v-ind )
      800           v-ind    = v-ind + 1
      801         .
      802       end.
      803       if v-inform = ?
      804         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      805         or entry( 3, v-inform, ",":U ) <> "1":U
      806       then do:
      807         delete object bh_tbl-name no-error.
      808         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      809       end.
      810       assign
      811         v-idx-field-qnty = num-entries( v-inform ) - 4
      812       .
      813       if v-idx-field-qnty < 2 then do:
      814         delete object bh_tbl-name no-error.
      815         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      816       end.
      817       assign
      818         p-field-list = "":U
      819         p-value-list = "":U
      820         v-delim-key  = "":U
      821         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      822         v-count-fld  = 0
      823       .
      824       block_where:
      825       do v-ind = 1 to v-idx-field-qnty by 2
      826       on error undo, return error
      827       :
      828         assign
      829           v-count-fld = v-count-fld + 1
      830         .
      831         if v-count-fld > v-field-num then do:
      832           leave block_where.
      833         end.
      834         assign
      835           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      836           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      837         .
      838         if v-ind = 1 then do:
      839           assign
      840             v-delim-key = chr(3)
      841           .
      842         end.
      843       end.
      844       delete object bh_tbl-name.
      845       if v-count-fld <> v-field-num then do:
      846         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      847       end.
      848     end.
      849   end procedure.
      850   procedure gen-key-field :
      851     define input  parameter p-table      as character no-undo .
      852     define output parameter p-field-list as character no-undo .
      853     do
      854     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      855     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      856     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      857     :
      858       define variable v-full-tbl-name  as character no-undo .
      859       define variable bh_tbl-name      as handle    no-undo .
      860       define variable v-tbl-name       as character no-undo .
      861       define variable v-field-num      as integer   no-undo .
      862       define variable v-count-fld      as integer   no-undo .
      863       define variable v-inform         as character no-undo .
      864       define variable v-ind            as integer   no-undo .
      865       define variable v-idx-field-qnty as integer   no-undo .
      866       define variable v-delim-key      as character no-undo .
      867       if p-table = ?
      868         or p-table = "":U
      869       then do:
      870         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      871       end.
      872       assign
      873         v-tbl-name      = p-table
      874         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      875       .
      876       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      877       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      878       assign
      879         v-inform = bh_tbl-name:index-information(1)
      880         v-ind    = 2
      881       .
      882       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      883       on error undo, return error
      884       :
      885         assign
      886           v-inform = bh_tbl-name:index-information( v-ind )
      887           v-ind    = v-ind + 1
      888         .
      889       end.
      890       if v-inform = ?
      891         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      892         or entry( 3, v-inform, ",":U ) <> "1":U
      893       then do:
      894         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      895       end.
      896       assign
      897         v-idx-field-qnty = num-entries( v-inform ) - 4
      898       .
      899       if v-idx-field-qnty < 2 then do:
      900         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      901       end.
      902       assign
      903         p-field-list = "":U
      904         v-delim-key  = "":U
      905         v-count-fld  = 0
      906       .
      907       block_where:
      908       do v-ind = 1 to v-idx-field-qnty by 2
      909       on error undo, return error
      910       :
      911         assign
      912           v-count-fld = v-count-fld + 1
      913         .
      914         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      915         if v-ind = 1 then do:
      916           assign
      917             v-delim-key = chr(3)
      918           .
      919         end.
      920       end.
      921       delete object bh_tbl-name.
      922     end.
      923   end procedure.
      924   main-block:
      925   do
      926   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      927   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      928   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      929   :
      930     if p-action <> "check-open":u then do:
      931       message
      932         vss-workfile vss-revision vss-description skip
      933         "Ошибка задания входных параметров" skip
      934         "p-action" p-action skip
      935         view-as alert-box error .
      936       undo main-block, return error .
      937     end.
      938     run check-catering        in this-procedure no-error .
      939     if error-status:error then do:
      940       return error return-value .
      941     end.
      942     run check-goa-proprietor  in this-procedure no-error .
      943     if error-status:error then do:
      944       undo main-block, return error return-value .
      945     end.
      946   end.
      947   procedure check-catering :
      948     do
      949     on error undo, return error
      950     :
      951       define buffer buf_shop for ub.shop.
      952       define buffer buf2_shop for ub.shop.
      953       define buffer buf_Clients for ub.clients.
      954       define buffer buf_temp-clients for temp-clients.
      955       if p-obj-type = 'маг':U then do:
      956         find first buf_shop no-lock where
      957                   buf_shop.obj-code = p-obj-code.
      958         if buf_shop.is-kitchen
      959         and buf_shop.kitchen-store-type <> "":U
      960         and buf_shop.kitchen-store-code <> 0
      961         then do:
      962           find first buf_clients no-lock where
      963                 buf_clients.db-num = p-source-db-num
      964             AND buf_clients.obj-type = buf_shop.kitchen-store-type
      965             AND buf_clients.obj-code = buf_shop.kitchen-store-code no-error .
      966           if available buf_clients and
      967           not can-find(first buf_temp-clients no-lock where
      968                             buf_temp-clients.obj-type = buf_shop.kitchen-store-type
      969                         AND buf_temp-clients.obj-code = buf_shop.kitchen-store-code) then do:
      970             undo, return error substitute("&1&2 определен как КУХНЯ, участвующая в производстве&3" +
      971                                      "&4&5 определен как СКЛАД данной КУХНИ&3" +
      972                                      "при перемещении &1&2 из БД &6 в БД &7,&3" +
      973                                      "СКЛАД КУХНИ &4&5 и КУХНЯ &1&2 будут находиться в разных БД&3" +
      974                                      "что недопустимо"
      975                                      ,p-obj-type
      976                                      ,p-obj-code
      977                                      , chr(10)
      978                                      , buf_clients.obj-type
      979                                      , buf_clients.obj-code
      980                                      , p-source-db-num
      981                                      , p-target-db-num).
      982           end.
      983         end.
      984         if buf_shop.is-kitchen-store
      985         then do:
      986           for each buf_clients no-lock where
      987                 buf_clients.db-num = p-source-db-num
      988             AND buf_clients.obj-type = 'маг':U,
      989             first buf2_shop no-lock where
      990                   buf2_shop.obj-code = buf_clients.obj-code:
      991             if not buf2_shop.is-kitchen then NEXT.
      992             if  not can-find(first buf_temp-clients no-lock where
      993                             buf_temp-clients.obj-type = 'маг':U
      994                         AND buf_temp-clients.obj-code = buf2_shop.obj-code) then do:
      995               undo, return error substitute("&1&2 определен как СКЛАД КУХНИ, участвующий в производстве&3" +
      996                                       "&4&5 определен как КУХНЯ даннгого СКЛАДА&3" +
      997                                       "при перемещении &1&2 из БД &6 в БД &7,&3" +
      998                                       "СКЛАД КУХНИ &1&2 и КУХНЯ &4&5 будут находиться в разных БД&3" +
      999                                       "что недопустимо"
     1000                                       ,p-obj-type
     1001                                       ,p-obj-code
     1002                                       , chr(10)
     1003                                       , buf_clients.obj-type
     1004                                       , buf_clients.obj-code
     1005                                       , p-source-db-num
     1006                                       , p-target-db-num).
     1007             end.
     1008           end.
     1009         end.
     1010       end.
     1011     end.
     1012   end procedure.
     1013   procedure check-goa-proprietor :
     1014     do
     1015     on error undo, return error
     1016     :
     1017       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     1018       define variable v-is-tpsi-object as logical no-undo .
     1019       define variable v-proprietor-obj-type like ub.clients.obj-type no-undo .
     1020       define variable v-proprietor-obj-code like ub.clients.obj-code no-undo .
     1021         _gds-obj-attr:
     1022         for each buf_gds-obj-attr no-lock where
     1023               buf_gds-obj-attr.obj-type = p-obj-type
     1024           AND buf_gds-obj-attr.obj-code = p-obj-code
     1025           AND buf_gds-obj-attr.attr-code = 'proprietor':U
     1026           :
     1027           if logical(buf_gds-obj-attr.attr-value) <> yes then NEXT _gds-obj-attr.
     1028           run get-proprietor(
     1029                             input buf_gds-obj-attr.gds-code
     1030                             ,input p-target-db-num
     1031                             ,input p-obj-type
     1032                             ,input p-obj-code
     1033                             ,output v-proprietor-obj-type
     1034                             ,output v-proprietor-obj-code
     1035                             ) no-error .
     1036           if not error-status:error
     1037           and v-proprietor-obj-type <> "":U
     1038           and v-proprietor-obj-code <> 0
     1039           then do:
     1040             undo, return error
     1041             substitute("На объекте &1&2 существуют атрибуты товара на объекте ПРИНАДЛЕЖНОСТЬ ТОВАРА,&3" +
     1042                         "конфликтующие с такими же атрибутами в БД &4 на объекте &5&6&3" +
     1043                         "товар &7"
     1044                         , p-obj-type
     1045                         , p-obj-code
     1046                         , chr(10)
     1047                         , p-target-db-num
     1048                         , v-proprietor-obj-type
     1049                         , v-proprietor-obj-code
     1050                         , buf_gds-obj-attr.gds-code
     1051                         ) .
     1052           end.
     1053       end.
     1054     end.
     1055   end procedure.
     1056   procedure get-proprietor :
     1057   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     1058   define input parameter p-target-db-num like ub.db.db-num no-undo .
     1059   define input parameter p-obj-type            like ub.gds-obj-attr.obj-type no-undo .
     1060   define input parameter p-obj-code            like ub.gds-obj-attr.obj-code no-undo .
     1061   define output parameter p-proprietor-obj-type like ub.gds-obj-attr.obj-type no-undo .
     1062   define output parameter p-proprietor-obj-code like ub.gds-obj-attr.obj-code no-undo .
     1063     do
     1064     on error undo, return error
     1065     :
     1066       define buffer buf_clients for ub.clients.
     1067       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     1068       for each buf_clients no-lock where
     1069               buf_clients.db-num = p-target-db-num,
     1070         each buf_gds-obj-attr no-lock where
     1071              buf_gds-obj-attr.gds-code = p-gds-code
     1072          AND buf_gds-obj-attr.attr-code = 'proprietor':U
     1073          AND buf_gds-obj-attr.obj-type = buf_clients.obj-type
     1074          AND buf_gds-obj-attr.obj-code = buf_clients.obj-code
     1075          :
     1076         if buf_gds-obj-attr.obj-type = p-obj-type
     1077         AND buf_gds-obj-attr.obj-code = p-obj-code then next.
     1078         assign
     1079         p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     1080         p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     1081         .
     1082         LEAVE.
     1083       end.
     1084     end.
     1085   end procedure.
     1086   procedure check-ext-system :
     1087   define variable v-names as character no-undo .
     1088   define variable v-ii as integer no-undo .
     1089   define variable v-uniq-key-rec as character no-undo .
     1090   define buffer buf_ext-classif for ub.ext-classif.
     1091   define buffer buf_clients for ub.clients.
     1092     do
     1093     on error undo, return error
     1094     :
     1095       find first buf_clients no-lock where
     1096                 buf_clients.obj-type = p-obj-type
     1097             and buf_clients.obj-code = p-obj-code.
     1098       run gen-key-rec in this-procedure ( input 'clients':U
     1099                                          ,input (buffer buf_clients:handle)
     1100                                          ,output v-uniq-key-rec).
     1101       v-names = 'clients-esys':U .
     1102       do v-ii = 1 to num-entries(v-names):
     1103         for each buf_Ext-classif where
     1104                 buf_ext-classif.classif-name = entry(v-ii, v-names)
     1105             and buf_Ext-classif.uniq-key-rec = v-uniq-key-rec:
     1106          case buf_ext-classif.classif-subject:
     1107            when 'clients-esys':U then do:
     1108               undo, return error substitute("&1&2 связан со СПЕЦИАЛЬНОЙ ВНЕШНЕЙ СИСТЕМОЙ &3&4" +
     1109                                       "перемещение невозможно"
     1110                                       ,p-obj-type
     1111                                       ,p-obj-code
     1112                                       ,buf_ext-classif.key#_one
     1113                                       ,chr(10)).
     1114             end.
     1115           end case.
     1116         end.
     1117       end.
     1118     end.
     1119   end procedure.
