        1   block-level on error undo, throw.
        2   define input  parameter p-cat-code       like ub.hold-time.cat-code no-undo .
        3   define input  parameter p-lock-code      as character no-undo .
        4   define input  parameter p-btpr-type-code as character no-undo .
        5   define input  parameter p-archive-name   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Первоначальный расчет межфирменных архивов".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure holdattr-code :
       83     do
       84     on error undo, return error
       85     :
       86       define input  parameter p-code           as character no-undo .
       87       define output parameter p-type           as character no-undo .
       88       define output parameter p-format         as character no-undo .
       89       define output parameter p-label          as character no-undo .
       90       define output parameter p-user-can-edit  as logical   no-undo .
       91       define output parameter p-output-display as logical   no-undo .
       92       define output parameter p-other          as character no-undo .
       93       case p-code :
       94               when 'begin-date':U then do:     assign     p-label = "Дата начала межфирменного архива"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата начала межфирменного архива"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       95               when 'is-calc':U then do:     assign     p-label = "Произв.расчет арх."     p-type = 'L':U      p-format = "+/-"     p-label = "Произв.расчет арх."     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       96         otherwise do:
       97           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
       98         end.
       99       end.
      100     end.
      101   end procedure.
      102   procedure holdattr-tooltip :
      103     do
      104     on error undo, return error
      105     :
      106       define input  parameter p-code    as character no-undo .
      107       define output parameter p-tooltip as character no-undo .
      108       define output parameter p-label   as character no-undo .
      109       case p-code :
      110               when 'begin-date':U then do:     assign     p-tooltip = "Дата начала межфирменного архива"     p-label = "Дата начала межфирменного архива" .   end.
      111               when 'is-calc':U then do:     assign     p-tooltip = "Производится расчет межфирменного архива"     p-label = "Произв.расчет арх." .   end.
      112         otherwise do:
      113           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      114         end.
      115       end.
      116     end.
      117   end procedure.
      118   procedure holdattr-value :
      119     do
      120     on error undo, return error
      121     :
      122       define input  parameter p-cat-code  like ub.hold-attr.cat-code     no-undo .
      123       define input  parameter p-code      like ub.hold-attr.attr-code  no-undo .
      124       define output parameter p-value     like ub.hold-attr.attr-value no-undo .
      125       define output parameter p-type      as character no-undo .
      126       define buffer buf_hold-attr for ub.hold-attr .
      127       def var v-format         as character no-undo .
      128       def var v-label          as character no-undo .
      129       def var v-user-can-edit  as logical   no-undo .
      130       def var v-output-display as logical   no-undo .
      131       def var v-other          as character no-undo .
      132       run holdattr-code in this-procedure
      133         (input  p-code
      134         ,output p-type
      135         ,output v-format
      136         ,output v-label
      137         ,output v-user-can-edit
      138         ,output v-output-display
      139         ,output v-other
      140         ) no-error .
      141       if error-status :error then do:
      142         undo, return error return-value .
      143       end.
      144       find first buf_hold-attr no-lock
      145         where buf_hold-attr.cat-code    = p-cat-code
      146           and buf_hold-attr.attr-code = p-code
      147         no-error .
      148       if avail buf_hold-attr then do:
      149         assign
      150           p-value =  buf_hold-attr.attr-value
      151         .
      152       end.
      153       else do:
      154         assign
      155           p-value = if p-type = 'L':U then "no":U else ""
      156         .
      157       end.
      158     end.
      159   end procedure.
      160   procedure holdattr-write :
      161     do
      162     on error undo, return error
      163     :
      164       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      165       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      166       define input parameter p-value     like ub.hold-attr.attr-value no-undo .
      167       define buffer buf_hold-attr for ub.hold-attr .
      168       def var v-type           as character no-undo .
      169       def var v-format         as character no-undo .
      170       def var v-label          as character no-undo .
      171       def var v-user-can-edit  as logical   no-undo .
      172       def var v-output-display as logical   no-undo .
      173       def var v-other          as character no-undo .
      174       run holdattr-code in this-procedure
      175         (input  p-code
      176         ,output v-type
      177         ,output v-format
      178         ,output v-label
      179         ,output v-user-can-edit
      180         ,output v-output-display
      181         ,output v-other
      182         ) no-error .
      183       if error-status :error then do:
      184         undo, return error return-value .
      185       end.
      186       find first buf_hold-attr exclusive-lock
      187         where buf_hold-attr.cat-code    = p-cat-code
      188           and buf_hold-attr.attr-code = p-code
      189         no-error .
      190       if not available buf_hold-attr then do:
      191         create buf_hold-attr .
      192         assign
      193           buf_hold-attr.cat-code    = p-cat-code
      194           buf_hold-attr.attr-code = p-code
      195         .
      196       end.
      197       assign
      198         buf_hold-attr.attr-value = p-value
      199       .
      200     end.
      201   end procedure.
      202   procedure holdattr-exist :
      203     do
      204     on error undo, return error
      205     :
      206       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      207       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      208       define output parameter p-exist    as logical  no-undo .
      209       define buffer buf_hold-attr for ub.hold-attr .
      210       def var v-type           as character no-undo .
      211       def var v-format         as character no-undo .
      212       def var v-label          as character no-undo .
      213       def var v-user-can-edit  as logical   no-undo .
      214       def var v-output-display as logical   no-undo .
      215       def var v-other          as character no-undo .
      216       run holdattr-code in this-procedure
      217         (input  p-code
      218         ,output v-type
      219         ,output v-format
      220         ,output v-label
      221         ,output v-user-can-edit
      222         ,output v-output-display
      223         ,output v-other
      224         ) no-error .
      225       if error-status :error then do:
      226         undo, return error return-value .
      227       end.
      228       find first buf_hold-attr no-lock
      229         where buf_hold-attr.cat-code    = p-cat-code
      230           and buf_hold-attr.attr-code = p-code
      231         no-error .
      232       if  available buf_hold-attr then do:
      233         p-exist = yes.
      234       end.
      235     end.
      236   end procedure.
      237   procedure holdattr-delete :
      238     do
      239     on error undo, return error
      240     :
      241       define input parameter p-cat-code   like ub.hold-attr.cat-code     no-undo .
      242       define input parameter p-code     like ub.hold-attr.attr-code  no-undo .
      243       define output parameter p-deleted  as logical no-undo.
      244       define buffer buf_hold-attr for ub.hold-attr .
      245       def var v-type           as character no-undo .
      246       def var v-format         as character no-undo .
      247       def var v-label          as character no-undo .
      248       def var v-user-can-edit  as logical   no-undo .
      249       def var v-output-display as logical   no-undo .
      250       def var v-other          as character no-undo .
      251       run holdattr-code in this-procedure
      252         (input  p-code
      253         ,output v-type
      254         ,output v-format
      255         ,output v-label
      256         ,output v-user-can-edit
      257         ,output v-output-display
      258         ,output v-other
      259         ) no-error .
      260       if error-status :error then do:
      261         undo, return error return-value .
      262       end.
      263       find first buf_hold-attr exclusive-lock
      264         where buf_hold-attr.cat-code    = p-cat-code
      265           and buf_hold-attr.attr-code = p-code
      266         no-error NO-WAIT.
      267       if not available buf_hold-attr then do:
      268         p-deleted = no.
      269       end.
      270       else do:
      271         delete buf_hold-attr.
      272         p-deleted = yes.
      273       end.
      274     end.
      275   end procedure.
      276   procedure holdattr-news :
      277     do
      278     on error undo, return error
      279     :
      280       define input  parameter p-code           as character no-undo .
      281       define output parameter p-news           as logical   no-undo .
      282       case p-code :
      283               when 'begin-date':U then do:     assign     p-news = no.   end.
      284               when 'is-calc':U then do:     assign     p-news = no.   end.
      285         otherwise do:
      286           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      287         end.
      288       end.
      289     end.
      290   end procedure.
      291   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   procedure create-hold-time :
      293   define input parameter p-cat-code like ub.hold-time.cat-code no-undo .
      294   define input parameter p-start-date like ub.hold-time.start-date no-undo .
      295   DEFINE VARIABLE v-end-date like ub.hold-time.end-date no-undo .
      296   define buffer buf_hold-time for ub.hold-time .
      297   define buffer last_hold-time for ub.hold-time .
      298     do
      299     on error undo, return error
      300     :
      301       find last last_hold-time no-lock
      302         where last_hold-time.cat-code = p-cat-code
      303         use-index pi
      304         no-error .
      305       run gbl/lastdate.p
      306         (input p-start-date
      307         ,output v-end-date)
      308         no-error .
      309       if error-status :error then do:
      310         message
      311         vss-workfile vss-revision vss-description skip
      312         "Ошибка поиска последней даты периода" skip
      313         "Дата начала периода" p-start-date
      314         error-status :get-message(1) skip
      315         return-value skip
      316         view-as alert-box error .
      317         undo, return error.
      318       end.
      319       create buf_hold-time.
      320       assign
      321         buf_hold-time.cat-code       = p-cat-code
      322         buf_hold-time.time-code      = (if available last_hold-time
      323                                         then (last_hold-time.time-code + 1)
      324                                         else 1)
      325         buf_hold-time.time-type      = 'мес':U
      326         buf_hold-time.start-date     = p-start-date
      327         buf_hold-time.end-date       = v-end-date
      328         buf_hold-time.create-date    = today
      329         buf_hold-time.update-date    = today
      330         buf_hold-time.grpupdate-date = today
      331       .
      332     end.
      333   end procedure.
      334   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      335   procedure cur-time :
      336      define output parameter p-today as date      no-undo .
      337      define output parameter p-time  as integer   no-undo .
      338     do
      339     on error undo, return error
      340     :
      341       define variable v-date1 as date      no-undo .
      342       define variable v-date2 as date      no-undo .
      343       define variable v-time  as integer   no-undo .
      344       assign
      345         v-date1 = today
      346         v-time  = time
      347         v-date2 = today
      348       .
      349       if v-date1 <> v-date2
      350       then do:
      351         assign
      352           v-date1 = today
      353           v-time  = v-time
      354         .
      355       end.
      356       assign
      357         p-today = v-date1
      358         p-time  = v-time
      359       .
      360     end.
      361   end.
      362   function cur-time-date returns character
      363   :
      364     return string(today, '99/99/9999':U) .
      365   end.
      366   function cur-time-mjd returns decimal
      367   :
      368     define variable v-date as date      no-undo .
      369     define variable v-time as integer   no-undo .
      370     run cur-time in this-procedure
      371       (output v-date
      372       ,output v-time
      373       ) .
      374     return integer(v-date) - 2400002 + (v-time / 86400) .
      375   end.
      376   function cur-time-get-ending-index returns integer
      377   (input p-number as integer
      378   )
      379   :
      380     if p-number < 0
      381     or p-number = ?
      382     then do:
      383       return 1 .
      384     end.
      385     define variable v-rest as integer   no-undo .
      386     assign
      387       p-number = p-number modulo 100
      388     .
      389     if p-number < 20
      390     then do:
      391       assign
      392         v-rest = p-number
      393       .
      394     end.
      395     else do:
      396       assign
      397         v-rest = p-number modulo 10
      398       .
      399     end.
      400     case v-rest :
      401       when 1
      402       then do:
      403         return 2 .
      404       end.
      405       when 2 or
      406       when 3 or
      407       when 4
      408       then do:
      409         return 3 .
      410       end.
      411       otherwise do:
      412         return 1 .
      413       end.
      414     end case .
      415   end.
      416   procedure cur-time-mjd-to-date :
      417      define input  parameter i-mjd-diff as decimal no-undo.
      418      define output parameter o-Date     as date    no-undo.
      419      define output parameter o-Time     as integer no-undo.
      420      define variable v-day-number as integer   no-undo .
      421      if    i-mjd-diff < 0
      422         or i-mjd-diff = ?
      423      then do:
      424         return "?" .
      425      end.
      426      assign
      427         v-day-number = truncate(i-mjd-diff,0).
      428         o-Date = date(v-day-number + 2400002).
      429         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      430     .
      431   end.
      432   function cur-time-mjd-to-string returns character
      433   (input p-mjd-diff as decimal
      434   )
      435   :
      436     define variable v-day-number as integer   no-undo .
      437     define variable v-seconds    as integer   no-undo .
      438     define variable v-hour       as integer   no-undo .
      439     define variable v-min        as integer   no-undo .
      440     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      441     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      442     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      443     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      444     if p-mjd-diff < 0
      445     or p-mjd-diff = ?
      446     then do:
      447       return "?" .
      448     end.
      449     assign
      450       v-day-number = integer(truncate(p-mjd-diff,0))
      451       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      452     .
      453     if v-seconds > 86400
      454     then do:
      455       assign
      456         v-seconds = 86400 - 1
      457       .
      458     end.
      459     if v-seconds < 0
      460     then do:
      461       assign
      462         v-seconds = 0
      463       .
      464     end.
      465     assign
      466       v-hour = truncate(v-seconds / 3600, 0)
      467     .
      468     assign
      469       v-seconds = v-seconds modulo 3600
      470     .
      471     assign
      472       v-min = truncate(v-seconds / 60, 0)
      473     .
      474     assign
      475       v-seconds = v-seconds modulo 60
      476     .
      477     return
      478         (if v-day-number <> 0
      479           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      480           else ""
      481         )
      482       + (if v-day-number <> 0 or v-hour <> 0
      483           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      484           else ""
      485         )
      486       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      487           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      488           else ""
      489         )
      490       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      491       .
      492   end.
      493   function cur-time-string returns character
      494   :
      495     define variable v-date as date      no-undo .
      496     define variable v-time as integer   no-undo .
      497     run cur-time in this-procedure
      498       (output v-date
      499       ,output v-time
      500       ) .
      501     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      502   end.
      503   function cur-time-string-sec returns character
      504   :
      505     define variable v-date as date      no-undo .
      506     define variable v-time as integer   no-undo .
      507     run cur-time in this-procedure
      508       (output v-date
      509       ,output v-time
      510       ) .
      511     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      512   end.
      513   function cur-time-custom  returns character
      514   (input p-prefix as character
      515   ,input p-date-format as character
      516   ,input p-delimiter as character
      517   ,input p-time-format as character
      518   ,input p-suffix as character
      519   )
      520   :
      521     define variable v-date as date      no-undo .
      522     define variable v-time as integer   no-undo .
      523     run cur-time in this-procedure
      524       (output v-date
      525       ,output v-time
      526       ) .
      527     return
      528       p-prefix
      529       + string(v-date, p-date-format)
      530       + p-delimiter
      531       + string(v-time, p-time-format)
      532       + p-suffix
      533       .
      534   end.
      535   function cur-time-print  returns character
      536   :
      537     define variable v-date as date      no-undo .
      538     define variable v-time as integer   no-undo .
      539     run cur-time in this-procedure
      540       (output v-date
      541       ,output v-time
      542       ) .
      543     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      544   end.
      545   function cur-time-datetime returns datetime
      546   :
      547     define variable v-char as character no-undo .
      548     define variable v-datetime as datetime no-undo .
      549     v-char = cur-time-string().
      550     v-datetime = datetime(v-char).
      551     return  v-datetime.
      552   end.
      553   function cur-time-string-msec returns character
      554   :
      555     define variable v-date as datetime  no-undo .
      556     v-date = now.
      557     return string(v-date) .
      558   end.
      559   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      560   define variable v-waitfram-action01         as character   no-undo .
      561   define variable v-waitfram-action02         as character   no-undo .
      562   define variable v-waitfram-action03         as character   no-undo .
      563   define variable mWaitFramTextBeg            as character   no-undo.
      564   define variable mWaitFramTextEnd            as character   no-undo.
      565   define variable mWaitFramView               as logical     no-undo.
      566   define variable mWaitProcEvent              as logical     no-undo init yes.
      567   define variable mWaitFramInterval           as integer     no-undo init 1 .
      568   define variable mWaitFramStop               as logical     no-undo.
      569   define variable mWaitFramStopUser           as logical     no-undo.
      570   define variable mWaitFramStopTimeOut        as logical     no-undo.
      571   define variable mWaitFramStartProc          as datetime-tz no-undo.
      572   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      573   define button B-WaitFramStop auto-end-key
      574        label "Стоп"
      575        size 10 by 1 tooltip "Остоновить процесс".
      576   define button B-viewProcInfo
      577        label "Информация"
      578        size 15 by 1 tooltip "Информация о процесс".
      579   define frame waitfram
      580     v-waitfram-action01 format "x(72)" no-label skip
      581     v-waitfram-action02 format "x(72)" no-label skip
      582     v-waitfram-action03 format "x(72)" no-label skip
      583     B-viewProcInfo
      584     B-WaitFramStop at row 4 col 30
      585     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      586     .
      587   define new global shared variable mBatchMode as logical no-undo init ?.
      588   define variable mFramBachModHandle as handle no-undo.
      589   mFramBachModHandle = frame waitfram:handle.
      590   define variable mFameOldVis as logical no-undo.
      591   define variable mVisCUrentVin as logical no-undo.
      592   if session:batch-mode
      593   then
      594      mBatchMode = yes.
      595   if mBatchMode = ? then do:
      596     mVisCUrentVin = current-window:visible.
      597     mFameOldVis = mFramBachModHandle:visible.
      598     mFramBachModHandle:visible  = yes.
      599     mBatchMode = mFramBachModHandle:visible ne yes.
      600     mFramBachModHandle:visible = mFameOldVis.
      601     current-window:visible = mVisCUrentVin.
      602   end.
      603    if  log-manager:logfile-name ne ?
      604     then DO:
      605         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      606         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      607         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      608     end.
      609   on choose of B-WaitFramStop in frame waitfram
      610   do:
      611     mWaitFramStop = yes.
      612     mWaitFramStopUser = yes.
      613   end.
      614   function waitfram-check-timeout returns logical():
      615      define variable vtime as int64 no-undo.
      616      if mWaitFramStopTimeOut
      617      then
      618         return yes.
      619      vtime = ( now - mWaitFramStartProc ) / 1000 .
      620      if     mWaitFramTimeOut ne ?
      621         and mWaitFramTimeOut ne 0
      622         and mWaitFramTimeOut lt vtime
      623      then do:
      624         mWaitFramStopTimeOut = yes.
      625      end.
      626      return mWaitFramStopTimeOut.
      627   end.
      628   procedure waitfram-hide :
      629     if not session:batch-mode
      630     then do
      631     on error undo, return error return-value
      632     :
      633       pause 0 before-hide .
      634       if not mBatchMode then
      635         hide frame waitfram .
      636     if     not mWaitFramView
      637        and mWaitProcEvent
      638     then
      639       process events .
      640     end.
      641   end procedure.
      642   procedure waitfram-show :
      643     define input  parameter p-message as character no-undo .
      644     define variable v-left-margin as integer   no-undo .
      645     if not session:batch-mode
      646     then do
      647     on error undo, return error return-value
      648     :
      649       if length(p-message) <= 70 then do:
      650         assign
      651           v-left-margin = integer((70 - length(p-message)) / 2)
      652         .
      653         assign
      654           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      655         .
      656         assign
      657           v-waitfram-action01 = " "
      658           v-waitfram-action02 = " "
      659                                    + fill(" ", v-left-margin)
      660                                    + p-message
      661           v-waitfram-action03 = " "
      662         .
      663       end.
      664       else do:
      665         define variable vRindex1 as integer no-undo.
      666         define variable vRindex2 as integer no-undo.
      667         vRindex1 = r-index(p-message," ",70).
      668         if vRindex1 = 0
      669         then
      670            vRindex1 = 70.
      671         if length(p-message)  <= vRindex1 + 70 then do:
      672           assign
      673             v-waitfram-action01 = " "
      674             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      675             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      676           .
      677         end.
      678         else do:
      679           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      680           if vRindex2 <= vRindex1
      681           then
      682              vRindex2 = vRindex1 + 70.
      683           assign
      684             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      685             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      686             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      687           .
      688         end.
      689       end.
      690       B-viewProcInfo:visible   in frame waitfram = no.
      691       B-viewProcInfo:sensitive in frame waitfram = no.
      692       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      693       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      694       if  (   mWaitFramView
      695          or  mWaitProcEvent)
      696          and not mBatchMode
      697       then
      698          display
      699             v-waitfram-action01 skip
      700             v-waitfram-action02 skip
      701             v-waitfram-action03 skip
      702          with frame waitfram .
      703       if     mWaitFramView
      704          then do:
      705             if     mWaitFramInterval ne ?
      706                and not mBatchMode
      707             then
      708                wait-for go of frame waitfram pause mWaitFramInterval.
      709          end.
      710          else
      711             if     mWaitProcEvent
      712                and not mBatchMode
      713             then
      714                process events .
      715     end.
      716   end procedure.
      717      procedure waitfram-show-this:
      718         define input  parameter iInterval as int64 no-undo.
      719         define variable vtime as int64 no-undo.
      720         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      721         mWaitFramInterval = iInterval.
      722         run waitfram-show (substitute("&1&2 &3&4" ,
      723                                       mWaitFramTextBeg ,
      724                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      725                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      726                                       mWaitFramTextEnd
      727                                      )
      728                           ).
      729      end.
      730      procedure WaitFramRunPause:
      731         define input  parameter iInterval as dec no-undo.
      732         define variable vStart  as datetime-tz no-undo.
      733         define variable vend    as datetime-tz no-undo.
      734         define variable vint as int64 no-undo.
      735         define variable vOk as logical no-undo.
      736         vStart = now.
      737         vend   = vStart.
      738         publish "WaitFramPause" (iInterval,output vOk).
      739         vend   =  now.
      740         vint = vend - vStart.
      741         vint = iInterval - vint / 1000.
      742         if     not mWaitFramStop
      743            and (   vint > 0
      744                 or (    not vOk
      745                     and iInterval eq ?
      746                     )
      747                 )
      748         then
      749            run waitfram-show-this (iInterval).
      750         vend   =  now.
      751         vint = vend - vStart.
      752         vint = iInterval - vint / 1000.
      753         if     not mWaitFramStop
      754            and vint > 0
      755         then do:
      756            run gbl/pause.p (vint * 1000).
      757         end.
      758         if iInterval ne ?
      759         then
      760            publish "WaitFramStop".
      761         waitfram-check-timeout().
      762      end.
      763      procedure WaitFramWaitFor:
      764         define input  parameter iInterval as dec no-undo.
      765         assign
      766            mWaitFramStartProc   = now
      767            mWaitFramStopUser    = no
      768            mWaitFramStopTimeOut = no
      769         .
      770         block-wait:
      771         do while not mWaitFramStop:
      772            run WaitFramRunPause (iInterval).
      773            if  waitfram-check-timeout()
      774            then do:
      775               leave block-wait.
      776            end.
      777         end.
      778         run waitfram-hide.
      779      end.
      780   procedure waitfram-join :
      781     define input  parameter p-line-1  as character no-undo .
      782     define input  parameter p-line-2  as character no-undo .
      783     define input  parameter p-line-3  as character no-undo .
      784     define output parameter p-message as character no-undo .
      785     do
      786     on error undo, return error return-value
      787     :
      788       assign
      789         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      790                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      791                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      792       .
      793     end.
      794   end procedure.
      795   function waitfram-join-function returns character
      796     (input p-line-1 as character
      797     ,input p-line-2 as character
      798     ,input p-line-3 as character
      799     ).
      800     define variable v-message as character no-undo .
      801     run waitfram-join in this-procedure
      802       (input  p-line-1
      803       ,input  p-line-2
      804       ,input  p-line-3
      805       ,output v-message
      806       ) .
      807     return v-message .
      808   end function .
      809   define variable conf-par     as character no-undo .
      810   define variable par-type     as character no-undo .
      811   define variable v-month      as integer   no-undo .
      812   define variable v-year       as integer   no-undo .
      813   define variable lok          as logical   no-undo .
      814   define variable v-begin-date as date      no-undo .
      815   define buffer del_hold-time for ub.hold-time .
      816   define buffer del_hold-trn for ub.hold-trn .
      817   define buffer del_hold-goods for ub.hold-goods .
      818   define buffer del_hold-gds-grp for ub.hold-gds-grp .
      819   define buffer del_hold-purch for ub.hold-purch .
      820   define buffer del_hold-purch-grp for ub.hold-purch-grp .
      821   define buffer del_hold-purch-supp for ub.hold-purch-supp .
      822   define buffer del_hold-purch-supp-gds for ub.hold-purch-supp-gds .
      823   define buffer del_hold-sale for ub.hold-sale .
      824   define buffer del_hold-sale-grp for ub.hold-sale-grp .
      825   define buffer buf_trn-doc for ub.trn-doc .
      826   define buffer buf_db for ub.db .
      827   define buffer buf_clients for ub.clients .
      828   do
      829   on error undo, return error
      830   :
      831   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      832     (input  'holding'
      833     ,input  0
      834     ,input  ''
      835     ,input  0
      836     ,input  ''
      837     ,input  ''
      838     ,input  ''
      839     ,input  yes
      840     ,output conf-par
      841     ,output par-type
      842     ) no-error .
      843     if error-status :error
      844     then do:
      845       message
      846         vss-workfile vss-revision vss-description skip
      847         "Ошибка при чтении параметра разрешены межфирменные архивы" skip
      848         error-status :get-message(1) skip
      849         return-value skip
      850         view-as alert-box error .
      851       undo, return error .
      852     end.
      853     if lookup(conf-par, 'true,yes') = 0
      854     then do:
      855       message
      856         "Межфирменные архивы запрещены параметром конфигурации" skip
      857         view-as alert-box information .
      858       return.
      859     end.
      860     run gbl/d-inpmnt.w
      861       (input p-archive-name
      862       ,input ?
      863       ,input-output v-month
      864       ,input-output v-year
      865       ,output lok
      866       ).
      867     if lok <> true
      868     then do:
      869       message
      870         "Не задана дата начала расчета межфирменных архивов" skip
      871         view-as alert-box information .
      872       undo, return error return-value .
      873     end.
      874     assign
      875       v-begin-date = date(v-month, 1, v-year)
      876     .
      877     if v-begin-date = ?
      878     then do:
      879       message
      880         vss-workfile vss-revision vss-description skip
      881         "Ошибка при задании даты начала расчета межфирменных архивов" skip
      882         p-archive-name skip
      883         error-status :get-message(1) skip
      884         return-value skip
      885         view-as alert-box error .
      886       undo, return error .
      887     end.
      888     define variable v-ok as logical   no-undo .
      889     message
      890       "ВНИМАНИЕ" skip
      891       "Это последний вопрос перед частичным расчетом архивов" skip
      892       p-archive-name skip
      893       "Будет произведен частичный расчет архивов с даты" string(v-begin-date, '99/99/9999':u) skip
      894       "Продолжить?" skip
      895       view-as alert-box question buttons yes-no update v-ok .
      896     if v-ok <> true
      897     then do:
      898       undo, return error return-value .
      899     end.
      900     define variable v-attr-value as character no-undo .
      901     define variable v-attr-type  as character no-undo .
      902     run holdattr-value in this-procedure
      903       (input  p-cat-code
      904       ,input  'begin-date':U
      905       ,output v-attr-value
      906       ,output v-attr-type
      907       ) no-error .
      908     if error-status :error
      909     then do:
      910       message
      911         vss-workfile vss-revision vss-description skip
      912         "Ошибка при чтении даты начала межфирменных архивов" skip
      913         p-archive-name skip
      914         error-status :get-message(1) skip
      915         return-value skip
      916         view-as alert-box error .
      917       undo, return error .
      918     end.
      919     define variable v-start-hold as date      no-undo .
      920     assign
      921       v-start-hold = date(v-attr-value)
      922     .
      923     if v-start-hold = ?
      924     then do:
      925       message
      926         p-archive-name skip
      927         "Неизвестна дата инициализации архива" skip
      928         "Невозможно произвести частичный расчет" skip
      929         view-as alert-box error .
      930       undo, return error return-value .
      931     end.
      932     if v-start-hold > v-begin-date
      933     then do:
      934       message
      935         p-archive-name skip
      936         "Дата частичного перерасчета архива не может быть раньше" skip
      937         "чем дата начала архива" skip
      938         "Дата начала архива" string(v-start-hold, '99/99/9999':u) skip
      939         "Дата частичного перерасчета архива" string(v-begin-date, '99/99/9999':u) skip
      940         view-as alert-box error .
      941       undo, return error return-value .
      942     end.
      943     run holdattr-write in this-procedure
      944       (input p-cat-code
      945       ,input 'is-calc':U
      946       ,input 'true':u
      947       ) no-error .
      948     if error-status :error
      949     then do:
      950       message
      951         vss-workfile vss-revision vss-description skip
      952         "Ошибка при записи атрибута - первоначальный расчет межфирменных архивов" skip
      953         p-archive-name skip
      954         error-status :get-message(1) skip
      955         return-value skip
      956         view-as alert-box error .
      957       undo, return error .
      958     end.
      959     define variable v-ind as integer   no-undo .
      960     for each del_hold-time
      961       where del_hold-time.cat-code   = p-cat-code
      962         and del_hold-time.start-date >= v-begin-date
      963     on error undo, return error
      964     :
      965       assign
      966         v-ind = 0
      967       .
      968       for each del_hold-trn
      969         where del_hold-trn.cat-code  = p-cat-code
      970           and del_hold-trn.time-code = del_hold-time.time-code
      971       on error undo, return error
      972       :
      973         assign
      974           v-ind = v-ind + 1
      975         .
      976         if v-ind modulo 10 = 0
      977         then do:
      978           run waitfram-show in this-procedure
      979             (input substitute("Дата &1. Удаление списка документов &2"
      980                              ,string(del_hold-time.start-date, '99/99/9999':u)
      981                              ,v-ind)
      982             ) .
      983         end.
      984         delete del_hold-trn .
      985       end.
      986       assign
      987         v-ind = 0
      988       .
      989       for each del_hold-goods
      990         where del_hold-goods.cat-code  = p-cat-code
      991           and del_hold-goods.time-code = del_hold-time.time-code
      992       on error undo, return error
      993       :
      994         if v-ind modulo 10 = 0
      995         then do:
      996           run waitfram-show in this-procedure
      997             (input substitute("Дата &1. Удаление списка товаров &2"
      998                              ,string(del_hold-time.start-date, '99/99/9999':u)
      999                              ,v-ind)
     1000             ) .
     1001         end.
     1002         delete del_hold-goods .
     1003       end.
     1004       assign
     1005         v-ind = 0
     1006       .
     1007       for each del_hold-gds-grp
     1008         where del_hold-gds-grp.cat-code  = p-cat-code
     1009           and del_hold-gds-grp.time-code = del_hold-time.time-code
     1010       on error undo, return error
     1011       :
     1012         if v-ind modulo 10 = 0
     1013         then do:
     1014           run waitfram-show in this-procedure
     1015             (input substitute("Дата &1. Удаление списка групп товаров &2"
     1016                              ,string(del_hold-time.start-date, '99/99/9999':u)
     1017                              ,v-ind)
     1018             ) .
     1019         end.
     1020         delete del_hold-gds-grp .
     1021       end.
     1022       assign
     1023         v-ind = 0
     1024       .
     1025       for each del_hold-purch
     1026         where del_hold-purch.cat-code  = p-cat-code
     1027           and del_hold-purch.time-code = del_hold-time.time-code
     1028       on error undo, return error
     1029       :
     1030         if v-ind modulo 10 = 0
     1031         then do:
     1032           run waitfram-show in this-procedure
     1033             (input substitute("Дата &1. Удаление информации о закупках &2"
     1034                              ,string(del_hold-time.start-date, '99/99/9999':u)
     1035                              ,v-ind)
     1036             ) .
     1037         end.
     1038         delete del_hold-purch .
     1039       end.
     1040       assign
     1041         v-ind = 0
     1042       .
     1043       for each del_hold-purch-grp
     1044         where del_hold-purch-grp.cat-code  = p-cat-code
     1045           and del_hold-purch-grp.time-code = del_hold-time.time-code
     1046       on error undo, return error
     1047       :
     1048         if v-ind modulo 10 = 0
     1049         then do:
     1050           run waitfram-show in this-procedure
     1051             (input substitute("Дата &1. Удаление информации о закупках по группам &2"
     1052                              ,string(del_hold-time.start-date, '99/99/9999':u)
     1053                              ,v-ind)
     1054             ) .
     1055         end.
     1056         delete del_hold-purch-grp .
     1057       end.
     1058       assign
     1059         v-ind = 0
     1060       .
     1061       for each del_hold-purch-supp
     1062         where del_hold-purch-supp.cat-code  = p-cat-code
     1063           and del_hold-purch-supp.time-code = del_hold-time.time-code
     1064       on error undo, return error
     1065       :
     1066         if v-ind modulo 10 = 0
     1067         then do:
     1068           run waitfram-show in this-procedure
     1069             (input substitute("Дата &1. Удаление информации о закупках по поставщикам &2"
     1070                              ,string(del_hold-time.start-date, '99/99/9999':u)
     1071                              ,v-ind)
     1072             ) .
     1073         end.
     1074         delete del_hold-purch-supp .
     1075       end.
     1076       assign
     1077         v-ind = 0
     1078       .
     1079       for each del_hold-purch-supp-gds
     1080         where del_hold-purch-supp-gds.cat-code  = p-cat-code
     1081           and del_hold-purch-supp-gds.time-code = del_hold-time.time-code
     1082       on error undo, return error
     1083       :
     1084         if v-ind modulo 10 = 0
     1085         then do:
     1086           run waitfram-show in this-procedure
     1087             (input substitute("Дата &1. Удаление информации о закупках по поставщикам по товарам &2"
     1088                              ,string(del_hold-time.start-date, '99/99/9999':u)
     1089                              ,v-ind)
     1090             ) .
     1091         end.
     1092         delete del_hold-purch-supp-gds .
     1093       end.
     1094       assign
     1095         v-ind = 0
     1096       .
     1097       for each del_hold-sale
     1098         where del_hold-sale.cat-code  = p-cat-code
     1099           and del_hold-sale.time-code = del_hold-time.time-code
     1100       on error undo, return error
     1101       :
     1102         if v-ind modulo 10 = 0
     1103         then do:
     1104           run waitfram-show in this-procedure
     1105             (input substitute("Дата &1. Удаление информации о продажах &2"
     1106                              ,string(del_hold-time.start-date, '99/99/9999':u)
     1107                              ,v-ind)
     1108             ) .
     1109         end.
     1110         delete del_hold-sale .
     1111       end.
     1112       assign
     1113         v-ind = 0
     1114       .
     1115       for each del_hold-sale-grp
     1116         where del_hold-sale-grp.cat-code  = p-cat-code
     1117           and del_hold-sale-grp.time-code = del_hold-time.time-code
     1118       on error undo, return error
     1119       :
     1120         if v-ind modulo 10 = 0
     1121         then do:
     1122           run waitfram-show in this-procedure
     1123             (input substitute("Дата &1. Удаление информации о продажах по группам &2"
     1124                              ,string(del_hold-time.start-date, '99/99/9999':u)
     1125                              ,v-ind)
     1126             ) .
     1127         end.
     1128         delete del_hold-sale-grp .
     1129       end.
     1130       delete del_hold-time .
     1131     end.
     1132     for each buf_db no-lock
     1133     ,each buf_clients no-lock
     1134       where buf_clients.db-num = buf_db.db-num
     1135     ,each buf_trn-doc no-lock
     1136       where buf_trn-doc.obj-type = buf_clients.obj-type
     1137         and buf_trn-doc.obj-code = buf_clients.obj-code
     1138         and buf_trn-doc.status_ = 'факт':U
     1139         and buf_trn-doc.fact-date >= v-begin-date
     1140     on error undo, return error
     1141     :
     1142       run waitfram-show in this-procedure
     1143         (input substitute("Расчет архивов по категории &1. Документ &2. Дата &3"
     1144                ,p-cat-code
     1145                ,buf_trn-doc.doc-code
     1146                ,string(buf_trn-doc.fact-date, '99/99/9999':u)
     1147                )
     1148         ) .
     1149       do transaction
     1150       on error undo, return error
     1151       :
     1152         define buffer buf_batchprocess for ub.batchprocess .
     1153         define buffer update_batchprocess for ub.batchprocess .
     1154         find first buf_BatchProcess exclusive-lock
     1155           where buf_BatchProcess.bp_type     = p-btpr-type-code
     1156             and buf_BatchProcess.bp_status   = 'N':U
     1157             and buf_batchprocess.charkey_one = buf_trn-doc.doc-code
     1158           no-error .
     1159         if available buf_BatchProcess
     1160         then do:
     1161     find first update_batchprocess exclusive-lock
     1162       where rowid(update_batchprocess) = rowid(buf_batchprocess)
     1163       no-error .
     1164     if not available update_batchprocess then do:
     1165       message
     1166         vss-workfile vss-revision vss-description skip
     1167         "Не найдена запись пересчета архива" skip
     1168         view-as alert-box error .
     1169       undo, return error .
     1170     end.
     1171     if update_batchprocess.bp_status <> 'N':U then do:
     1172       message
     1173         vss-workfile vss-revision vss-description skip
     1174         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
     1175         "BP_Type"       update_batchprocess.BP_Type       skip
     1176         "BP_Status"     update_batchprocess.BP_Status     skip
     1177         "Key#_One"      update_batchprocess.Key#_One      skip
     1178         "Key#_Two"      update_batchprocess.Key#_Two      skip
     1179         "Key#_Three"    update_batchprocess.Key#_Three    skip
     1180         "CharKey_One"   update_batchprocess.CharKey_One   skip
     1181         "CharKey_Two"   update_batchprocess.CharKey_Two   skip
     1182         "CharKey_Three" update_batchprocess.CharKey_Three skip
     1183         view-as alert-box error .
     1184       undo, return error .
     1185     end.
     1186       define variable v-btpr_upd-today-4 as date      no-undo.
     1187     define variable v-btpr_upd-time-4  as integer   no-undo.
     1188     run cur-time in this-procedure ( output v-btpr_upd-today-4
     1189                                    , output v-btpr_upd-time-4
     1190                                    ).
     1191     assign
     1192       update_batchprocess.bp_status         = 'D':U
     1193       update_batchprocess.bp_execcounttries = update_batchprocess.bp_execcounttries + 1
     1194       update_batchprocess.bp_execuser_id    = g#userid
     1195       update_batchprocess.bp_execsysdate    = v-btpr_upd-today-4
     1196       update_batchprocess.bp_execsystime    = string(v-btpr_upd-time-4, 'hh:mm')
     1197       update_batchprocess.bp_execsystimeint = v-btpr_upd-time-4
     1198     .
     1199         end.
     1200         run trg/harhtclc.p
     1201           (input p-cat-code
     1202           ,input p-lock-code
     1203           ,input p-btpr-type-code
     1204           ,input buf_trn-doc.doc-code
     1205           ) no-error.
     1206         if error-status :error
     1207         then do:
     1208           message
     1209             vss-workfile vss-revision vss-description skip
     1210             p-archive-name skip
     1211             string       ("Ошибка при первоначальном расчете межфирменных архивов:" + chr(10) +
     1212                           "cat-code:" + chr(32) + string(p-cat-code) + chr(10) +
     1213                           "документ:" + chr(32) + buf_trn-doc.doc-code + chr(10)
     1214                           )
     1215           view-as alert-box error .
     1216           undo, return error
     1217             ("Ошибка при первоначальном расчете межфирменных архивов:" + chr(10) +
     1218                           "cat-code:" + chr(32) + string(p-cat-code) + chr(10) +
     1219                           "документ:" + chr(32) + buf_trn-doc.doc-code + chr(10)
     1220                           ).
     1221         end.
     1222       end.
     1223     end.
     1224     run holdattr-write in this-procedure
     1225       (input p-cat-code
     1226       ,input 'is-calc':U
     1227       ,input 'false':u
     1228       ) no-error .
     1229     if error-status :error
     1230     then do:
     1231       message
     1232         vss-workfile vss-revision vss-description skip
     1233         "Ошибка при записи атрибута - первоначальный расчет межфирменных архивов" skip
     1234         error-status :get-message(1) skip
     1235         return-value skip
     1236         view-as alert-box error .
     1237       undo, return error .
     1238     end.
     1239   end.
