      380   procedure cur-time :
      381      define output parameter p-today as date      no-undo .
      382      define output parameter p-time  as integer   no-undo .
      383     do
      384     on error undo, return error
      385     :
      386       define variable v-date1 as date      no-undo .
      387       define variable v-date2 as date      no-undo .
      388       define variable v-time  as integer   no-undo .
      389       assign
      390         v-date1 = today
      391         v-time  = time
      392         v-date2 = today
      393       .
      394       if v-date1 <> v-date2
      395       then do:
      396         assign
      397           v-date1 = today
      398           v-time  = v-time
      399         .
      400       end.
      401       assign
      402         p-today = v-date1
      403         p-time  = v-time
      404       .
      405     end.
      406   end.
      407   function cur-time-date returns character
      408   :
      409     return string(today, '99/99/9999':U) .
      410   end.
      411   function cur-time-mjd returns decimal
      412   :
      413     define variable v-date as date      no-undo .
      414     define variable v-time as integer   no-undo .
      415     run cur-time in this-procedure
      416       (output v-date
      417       ,output v-time
      418       ) .
      419     return integer(v-date) - 2400002 + (v-time / 86400) .
      420   end.
      421   function cur-time-get-ending-index returns integer
      422   (input p-number as integer
      423   )
      424   :
      425     if p-number < 0
      426     or p-number = ?
      427     then do:
      428       return 1 .
      429     end.
      430     define variable v-rest as integer   no-undo .
      431     assign
      432       p-number = p-number modulo 100
      433     .
      434     if p-number < 20
      435     then do:
      436       assign
      437         v-rest = p-number
      438       .
      439     end.
      440     else do:
      441       assign
      442         v-rest = p-number modulo 10
      443       .
      444     end.
      445     case v-rest :
      446       when 1
      447       then do:
      448         return 2 .
      449       end.
      450       when 2 or
      451       when 3 or
      452       when 4
      453       then do:
      454         return 3 .
      455       end.
      456       otherwise do:
      457         return 1 .
      458       end.
      459     end case .
      460   end.
      461   procedure cur-time-mjd-to-date :
      462      define input  parameter i-mjd-diff as decimal no-undo.
      463      define output parameter o-Date     as date    no-undo.
      464      define output parameter o-Time     as integer no-undo.
      465      define variable v-day-number as integer   no-undo .
      466      if    i-mjd-diff < 0
      467         or i-mjd-diff = ?
      468      then do:
      469         return "?" .
      470      end.
      471      assign
      472         v-day-number = truncate(i-mjd-diff,0).
      473         o-Date = date(v-day-number + 2400002).
      474         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      475     .
      476   end.
      477   function cur-time-mjd-to-string returns character
      478   (input p-mjd-diff as decimal
      479   )
      480   :
      481     define variable v-day-number as integer   no-undo .
      482     define variable v-seconds    as integer   no-undo .
      483     define variable v-hour       as integer   no-undo .
      484     define variable v-min        as integer   no-undo .
      485     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      486     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      487     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      488     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      489     if p-mjd-diff < 0
      490     or p-mjd-diff = ?
      491     then do:
      492       return "?" .
      493     end.
      494     assign
      495       v-day-number = integer(truncate(p-mjd-diff,0))
      496       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      497     .
      498     if v-seconds > 86400
      499     then do:
      500       assign
      501         v-seconds = 86400 - 1
      502       .
      503     end.
      504     if v-seconds < 0
      505     then do:
      506       assign
      507         v-seconds = 0
      508       .
      509     end.
      510     assign
      511       v-hour = truncate(v-seconds / 3600, 0)
      512     .
      513     assign
      514       v-seconds = v-seconds modulo 3600
      515     .
      516     assign
      517       v-min = truncate(v-seconds / 60, 0)
      518     .
      519     assign
      520       v-seconds = v-seconds modulo 60
      521     .
      522     return
      523         (if v-day-number <> 0
      524           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      525           else ""
      526         )
      527       + (if v-day-number <> 0 or v-hour <> 0
      528           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      529           else ""
      530         )
      531       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      532           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      533           else ""
      534         )
      535       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      536       .
      537   end.
      538   function cur-time-string returns character
      539   :
      540     define variable v-date as date      no-undo .
      541     define variable v-time as integer   no-undo .
      542     run cur-time in this-procedure
      543       (output v-date
      544       ,output v-time
      545       ) .
      546     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      547   end.
      548   function cur-time-string-sec returns character
      549   :
      550     define variable v-date as date      no-undo .
      551     define variable v-time as integer   no-undo .
      552     run cur-time in this-procedure
      553       (output v-date
      554       ,output v-time
      555       ) .
      556     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      557   end.
      558   function cur-time-custom  returns character
      559   (input p-prefix as character
      560   ,input p-date-format as character
      561   ,input p-delimiter as character
      562   ,input p-time-format as character
      563   ,input p-suffix as character
      564   )
      565   :
      566     define variable v-date as date      no-undo .
      567     define variable v-time as integer   no-undo .
      568     run cur-time in this-procedure
      569       (output v-date
      570       ,output v-time
      571       ) .
      572     return
      573       p-prefix
      574       + string(v-date, p-date-format)
      575       + p-delimiter
      576       + string(v-time, p-time-format)
      577       + p-suffix
      578       .
      579   end.
      580   function cur-time-print  returns character
      581   :
      582     define variable v-date as date      no-undo .
      583     define variable v-time as integer   no-undo .
      584     run cur-time in this-procedure
      585       (output v-date
      586       ,output v-time
      587       ) .
      588     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      589   end.
      590   function cur-time-datetime returns datetime
      591   :
      592     define variable v-char as character no-undo .
      593     define variable v-datetime as datetime no-undo .
      594     v-char = cur-time-string().
      595     v-datetime = datetime(v-char).
      596     return  v-datetime.
      597   end.
      598   function cur-time-string-msec returns character
      599   :
      600     define variable v-date as datetime  no-undo .
      601     v-date = now.
      602     return string(v-date) .
      603   end.
      604   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   procedure factord :
      606     define input  parameter p-fact-date            as date    no-undo .
      607     define input  parameter p-fact-time            as integer no-undo .
      608     define input  parameter p-fact-num             as integer no-undo .
      609     define input  parameter p-shift-date           as date    no-undo .
      610     define input  parameter p-shift-num            as integer no-undo .
      611     define input  parameter p-shift-on             as logical no-undo .
      612     define output parameter p-fact-order           as decimal no-undo .
      613     define output parameter p-shift-end-fact-order as decimal no-undo .
      614     define output parameter p-day-end-fact-order   as decimal no-undo .
      615     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      616     if p-fact-date = ?
      617     then do:
      618       return error "Не указана фактическая дата" .
      619     end.
      620     define variable v-fact-date-num as integer no-undo .
      621     assign
      622       v-fact-date-num = integer(p-fact-date)
      623     .
      624     if p-fact-num = ?
      625     or p-fact-num = 0
      626     then do:
      627       return error "Не задан p-fact-num " + string(p-fact-num) .
      628     end.
      629     if p-fact-num < 0
      630     then do:
      631       return error "Отрицательный fact-num " + string(p-fact-num) .
      632     end.
      633     if p-fact-num >= 100000000
      634     then do:
      635       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      636     end.
      637     if p-shift-on = true
      638     then do:
      639       if p-shift-date = ?
      640       then do:
      641         return error "Не задана дата смены" .
      642       end.
      643       if p-shift-num = ?
      644       or p-shift-num = 0
      645       then do:
      646         return error "Не задан номер смены" .
      647       end.
      648     end.
      649     else do:
      650       assign
      651         p-shift-date = p-fact-date
      652         p-shift-num  = 24
      653       .
      654     end.
      655     define variable v-shift-offset as integer no-undo .
      656     if p-shift-date = p-fact-date
      657     then do:
      658       assign
      659         v-shift-offset = 1
      660       .
      661     end.
      662     if p-shift-date < p-fact-date
      663     then do:
      664       assign
      665         v-shift-offset = 0
      666       .
      667     end.
      668     if p-shift-date > p-fact-date
      669     then do:
      670       message
      671         vss-workfile vss-revision vss-description skip
      672         "Неправильная дата закрытия смены" skip
      673         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      674         view-as alert-box error .
      675       undo, return error
      676         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      677           ,string(p-fact-date, '99/99/9999':U)
      678           ,string(p-shift-date, '99/99/9999':U)
      679           )
      680       .
      681     end.
      682     if p-shift-num < 1
      683     or p-shift-num > 24
      684     then do:
      685       message
      686         vss-workfile vss-revision vss-description skip
      687         "Неправильный номер смены" skip
      688         "p-shift-num" p-shift-num skip
      689         view-as alert-box error .
      690       undo, return error return-value .
      691     end.
      692     assign
      693       p-fact-order           = v-fact-date-num
      694                              + v-shift-offset * 0.5
      695                              + p-shift-num    * 0.02 - 0.01
      696                              + p-fact-num     * 0.0000000001
      697       p-shift-end-fact-order = v-fact-date-num
      698                              + v-shift-offset * 0.5
      699                              + p-shift-num    * 0.02
      700       p-day-end-fact-order   = v-fact-date-num
      701                              + 0.99
      702     .
      703     if p-fact-order           <= v-fact-date-num
      704     or p-shift-end-fact-order <= v-fact-date-num
      705     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      706     or p-shift-end-fact-order >= p-day-end-fact-order
      707     then do:
      708       message
      709         vss-workfile vss-revision vss-description skip
      710         "Внутренняя ошибка при генерации фактического номера" skip
      711         "p-fact-date"            p-fact-date            skip
      712         "p-fact-time"            p-fact-time            skip
      713         "p-fact-num"             p-fact-num             skip
      714         "p-shift-date"           p-shift-date           skip
      715         "p-shift-num"            p-shift-num            skip
      716         "p-shift-on"             p-shift-on             skip
      717         "p-shift-end-fact-order" p-shift-end-fact-order skip
      718         "p-day-end-fact-order"   p-day-end-fact-order   skip
      719         "v-fact-date-num"        v-fact-date-num        skip
      720         view-as alert-box error .
      721       undo, return error return-value .
      722     end.
      723   end procedure.
      724   procedure day-begin-fact-order :
      725     define input  parameter p-fact-date            as date    no-undo .
      726     define output parameter p-day-begin-fact-order as decimal no-undo .
      727     do
      728     on error undo, return error return-value
      729     :
      730       if p-fact-date = ?
      731       then do:
      732         assign
      733           p-day-begin-fact-order = 0
      734         .
      735       end.
      736       else do:
      737         assign
      738           p-day-begin-fact-order = integer(p-fact-date)
      739         .
      740       end.
      741     end.
      742   end procedure.
      743   procedure factord-max-fact-order :
      744     define output parameter p-max-fact-order as decimal   no-undo .
      745     do
      746     on error undo, return error return-value
      747     :
      748       run day-begin-fact-order in this-procedure
      749         (input  date(1, 1, 5000)
      750         ,output p-max-fact-order
      751         ) .
      752     end.
      753   end procedure.
      754   procedure factord-cut-archive :
      755     define input  parameter p-obj-type             as character no-undo .
      756     define input  parameter p-obj-code             as integer   no-undo .
      757     define input  parameter p-fact-date            as date      no-undo .
      758     define output parameter p-shift-on             as logical   no-undo .
      759     define output parameter p-shift-date           as date      no-undo .
      760     define output parameter p-shift-num            as integer   no-undo .
      761     define output parameter p-day-end-fact-order   as decimal   no-undo .
      762     define output parameter p-shift-end-fact-order as decimal   no-undo .
      763     define variable v-fact-order as decimal   no-undo .
      764     define buffer buf_shift-obj for ub.shift-obj .
      765     do
      766     on error undo, return error return-value
      767     :
      768   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      770     (input  p-obj-type
      771     ,input  p-obj-code
      772     ,input  'shift-on=request'
      773     ,output p-shift-on
      774     ) no-error .
      775       if error-status :error
      776       then do:
      777         message
      778           vss-workfile vss-revision vss-description skip
      779           "Ошибка при определении атрибута объекта" skip
      780           "Объект" p-obj-type p-obj-code skip
      781           error-status :get-message(1) skip
      782           return-value skip
      783           view-as alert-box error .
      784         undo, return error return-value .
      785       end.
      786       if p-shift-on = false
      787       then do:
      788         assign
      789           p-shift-date               = ?
      790           p-shift-num                = 0
      791         .
      792       end.
      793       else do:
      794         find first buf_shift-obj share-lock
      795           where buf_shift-obj.obj-type   = p-obj-type
      796             and buf_shift-obj.obj-code   = p-obj-code
      797             and buf_shift-obj.shift-date > p-fact-date
      798           use-index pi
      799           no-error .
      800         if not available buf_shift-obj
      801         or buf_shift-obj.status_ <> 'зкр':U
      802         then do:
      803           message
      804             vss-workfile vss-revision vss-description skip
      805             "Невозможно вычислить последнюю смену" skip
      806             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      807             "Объект" p-obj-type p-obj-code skip
      808             "Дата" p-fact-date skip
      809             view-as alert-box error .
      810           undo, return error return-value .
      811         end.
      812         find last buf_shift-obj share-lock
      813           where buf_shift-obj.obj-type = p-obj-type
      814             and buf_shift-obj.obj-code = p-obj-code
      815             and buf_shift-obj.shift-date <= p-fact-date
      816           use-index pi
      817           no-error .
      818         if available buf_shift-obj
      819         then do:
      820           if  buf_shift-obj.status_ = 'зкр':U
      821           then do:
      822             assign
      823               p-shift-date = buf_shift-obj.shift-date
      824               p-shift-num  = buf_shift-obj.shift-num
      825             .
      826           end.
      827           else do:
      828             message
      829               vss-workfile vss-revision vss-description skip
      830               "Невозможно вычислить последнюю смену" skip
      831               "Статус смены отличен от статуса" 'зкр':U skip
      832               "Объект" p-obj-type p-obj-code skip
      833               "Дата" p-fact-date skip
      834               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      835               view-as alert-box error .
      836             undo, return error return-value .
      837           end.
      838         end.
      839         else do:
      840           assign
      841             p-shift-date = p-fact-date - 1
      842             p-shift-num  = 1
      843           .
      844         end.
      845       end.
      846       run factord in this-procedure
      847         (input  p-fact-date
      848         ,input  1
      849         ,input  1
      850         ,input  p-shift-date
      851         ,input  p-shift-num
      852         ,input  p-shift-on
      853         ,output v-fact-order
      854         ,output p-shift-end-fact-order
      855         ,output p-day-end-fact-order
      856         ) no-error .
      857       if error-status :error
      858       then do:
      859         message
      860           vss-workfile vss-revision vss-description skip
      861           "Ошибка при вызове процедуры factord"
      862           error-status :get-message(1) skip
      863           return-value skip
      864           view-as alert-box error .
      865         undo, return error return-value .
      866       end.
      867     end.
      868   end procedure.
      869   procedure factord-lock-shift :
      870     define input  parameter p-obj-type  as character no-undo .
      871     define input  parameter p-obj-code  as integer   no-undo .
      872     define input  parameter p-fact-date as date      no-undo .
      873     define parameter buffer buf_shift-obj for ub.shift-obj .
      874     define variable v-shift-on      as logical   no-undo .
      875     define variable v-extra-message as character no-undo .
      876     define variable v-error as character no-undo .
      877     do
      878     on error undo, return error return-value
      879     :
      880   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      882     (input  p-obj-type
      883     ,input  p-obj-code
      884     ,input  'shift-on=request'
      885     ,output v-shift-on
      886     ) no-error .
      887       if error-status :error
      888       then do:
      889         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      890         undo, return error v-error .
      891       end.
      892       if v-shift-on = true
      893       then do:
      894         find first buf_shift-obj share-lock
      895           where buf_shift-obj.obj-type   = p-obj-type
      896             and buf_shift-obj.obj-code   = p-obj-code
      897             and buf_shift-obj.shift-date > p-fact-date
      898           use-index pi
      899           no-error .
      900         if not available buf_shift-obj
      901         or buf_shift-obj.status_ <> 'зкр':U
      902         then do:
      903           find last buf_shift-obj
      904             where buf_shift-obj.obj-type = p-obj-type
      905               and buf_shift-obj.obj-code = p-obj-code
      906               and buf_shift-obj.status_  = 'зкр':U
      907             use-index stts
      908             no-error .
      909           if available buf_shift-obj
      910           then do:
      911             assign
      912               v-extra-message =
      913                     substitute("Дата начала последеней закрытой смены на объекте &1"
      914                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      915                               )
      916             .
      917           end.
      918           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      919           undo, return error v-error .
      920         end.
      921       end.
      922     end.
      923   end procedure.
      924   procedure factord-end-day :
      925     define input  parameter p-fact-date            as date    no-undo .
      926     define output parameter p-day-end-fact-order   as decimal no-undo .
      927     do
      928     on error undo, return error return-value
      929     :
      930       if p-fact-date = ?
      931       then do:
      932         return error "Не указана фактическая дата" .
      933       end.
      934       assign
      935         p-day-end-fact-order = integer(p-fact-date) + 0.99
      936       .
      937     end.
      938   end procedure.
      939   procedure factord-to-date :
      940     define input  parameter p-fact-order as decimal no-undo .
      941     define output parameter p-fact-date  as date    no-undo .
      942     define variable v-ref-date  as date      no-undo .
      943     define variable v-ref-delta as integer   no-undo .
      944     do
      945     on error undo, return error return-value
      946     :
      947       if p-fact-order = ?
      948       or p-fact-order = 0
      949       then do:
      950         return error "Не указан fact-order" .
      951       end.
      952       assign
      953         v-ref-date  = date(1, 1, 2000)
      954       .
      955       assign
      956         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      957       .
      958       assign
      959         p-fact-date = v-ref-date + v-ref-delta
      960       .
      961     end.
      962   end procedure.
      963   procedure factord-to-fact-num :
      964     define input  parameter p-fact-order as decimal no-undo .
      965     define output parameter p-fact-num   as integer no-undo .
      966     define variable v-fact-order-trunc as decimal no-undo .
      967     do
      968     on error undo, return error return-value
      969     :
      970       if p-fact-order = ?
      971       or p-fact-order = 0
      972       then do:
      973         return error "Не указан fact-order" .
      974       end.
      975       assign
      976        v-fact-order-trunc = truncate(p-fact-order, 2)
      977       .
      978       assign
      979         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      980       .
      981     end.
      982   end procedure.
      983   procedure factord-to-shift-num :
      984     define input  parameter p-fact-order as decimal no-undo .
      985     define output parameter p-shift-num   as integer no-undo .
      986     define variable  p-shift-numd  as decimal   no-undo .
      987     define variable v-fact-order-trunc as decimal no-undo .
      988     do
      989     on error undo, return error return-value
      990     :
      991       if p-fact-order = ?
      992       or p-fact-order = 0
      993       then do:
      994         return error "Не указан fact-order" .
      995       end.
      996       assign
      997        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      998       .
      999       if v-fact-order-trunc < 0.5 then do:
     1000         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1001       end.
     1002       assign
     1003         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1004         .
     1005        assign
     1006         p-shift-num = truncate (p-shift-numd , 0)
     1007       .
     1008     end.
     1009   end procedure.
     1010   procedure fact-order-mpl :
     1011     do
     1012     on error undo, return error return-value
     1013     :
     1014   define input  parameter p-doc-date as date     no-undo .
     1015   define input  parameter p-obj-type as character no-undo .
     1016   define input  parameter p-obj-code as integer   no-undo .
     1017   define output parameter p-fact-order as decimal   no-undo .
     1018   define variable v-fact-date            as date    no-undo .
     1019   define variable v-fact-time            as integer no-undo .
     1020   define variable v-fact-order           as decimal no-undo .
     1021   define variable v-shift-end-fact-order as decimal no-undo .
     1022   define variable v-day-end-fact-order   as decimal no-undo .
     1023   define variable l-shift-on as logical no-undo .
     1024   define variable l-date as date      no-undo .
     1025   define variable l-time as integer   no-undo .
     1026   define variable shift-date as date      no-undo .
     1027   define variable shift-num  as integer   no-undo .
     1028   define variable shift-name as character no-undo .
     1029   define variable max-fact-order as decimal   no-undo .
     1030   define buffer buf_global-state for ub.global-state  .
     1031   find first buf_global-state no-lock no-error .
     1032   if not available buf_global-state then do:
     1033      message
     1034        "Не заданы параметры ценообразования!"
     1035        view-as alert-box error
     1036      .
     1037      return error return-value .
     1038   end.
     1039     run cur-time in this-procedure
     1040     ( output v-fact-date ,
     1041       output v-fact-time  ).
     1042   if p-doc-date = ? then do:
     1043   if buf_global-state.pl-use-sys-date-time  = true then do:
     1044         run factord in this-procedure
     1045           (input  v-fact-date
     1046           ,input  v-fact-time
     1047           ,input  v-fact-time
     1048           ,input  ?
     1049           ,input  ?
     1050           ,input  false
     1051           ,output v-fact-order
     1052           ,output v-shift-end-fact-order
     1053           ,output v-day-end-fact-order
     1054           ) no-error .
     1055         if error-status :error
     1056         or v-fact-order = ?
     1057         or v-fact-order = 0 then do:
     1058           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1059         end.
     1060         p-fact-order = v-fact-order .
     1061   end.
     1062   else do:
     1063   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1065     (input  p-obj-type
     1066     ,input  p-obj-code
     1067     ,input  'shift-on=request'
     1068     ,output l-shift-on
     1069     ) no-error .
     1070         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1071         if p-doc-date <> ? then do:
     1072         end.
     1073          run gbl/factdate.p
     1074          ( input        p-obj-type  ,
     1075            input        p-obj-code  ,
     1076            input-output v-fact-date ,
     1077            input-output v-fact-time ,
     1078            input-output shift-date      ,
     1079            input-output shift-num       ,
     1080            input-output shift-name      ,
     1081            input        yes
     1082            ) no-error .
     1083         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1084         run factord in this-procedure
     1085           (input  v-fact-date
     1086           ,input  v-fact-time
     1087           ,input  v-fact-time
     1088           ,input  shift-date
     1089           ,input  shift-num
     1090           ,input  l-shift-on
     1091           ,output v-fact-order
     1092           ,output v-shift-end-fact-order
     1093           ,output v-day-end-fact-order
     1094           ) no-error .
     1095         if error-status :error
     1096         or v-fact-order = ?
     1097         or v-fact-order = 0 then do:
     1098           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1099         end.
     1100         p-fact-order = v-fact-order .
     1101   end.
     1102   end.
     1103   else do:
     1104          run gbl/factdate.p
     1105          ( input        p-obj-type  ,
     1106            input        p-obj-code  ,
     1107            input-output v-fact-date ,
     1108            input-output v-fact-time ,
     1109            input-output shift-date      ,
     1110            input-output shift-num       ,
     1111            input-output shift-name      ,
     1112            input        yes
     1113            ) no-error .
     1114         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1115         v-fact-date = p-doc-date .
     1116         run factord in this-procedure
     1117           (input  v-fact-date
     1118           ,input  v-fact-time
     1119           ,input  v-fact-time
     1120           ,input  shift-date
     1121           ,input  shift-num
     1122           ,input  l-shift-on
     1123           ,output v-fact-order
     1124           ,output v-shift-end-fact-order
     1125           ,output v-day-end-fact-order
     1126           ) no-error .
     1127         if error-status :error
     1128         or v-fact-order = ?
     1129         or v-fact-order = 0 then do:
     1130           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1131         end.
     1132         p-fact-order = v-fact-order .
     1133   end.
     1134     end.
     1135   end procedure.
     1136   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     1137   field sale-qnty as decimal
     1138   field sale-sum  as decimal
     1139   field sale-tnv  as decimal
     1140   field price-sale-base as decimal
     1141   field price-sale-rubl as decimal
     1142   field road-tax-base   as decimal
     1143   field road-tax-rubl   as decimal
     1144   field excise-base as decimal
     1145   field excise-rubl as decimal
     1146   field date-1 as date
     1147   field date-2 as date
     1148   field shift-1 as int
     1149   field shift-2 as int
     1150   field time-1 as int
     1151   field time-2 as int
     1152   field grp-name as char
     1153   field interv-name as char
     1154   field pay-name as char
     1155   field unit-cli as char
     1156   index pi
     1157   plt-priority DESCENDING
     1158   fact-order DESCENDING
     1159   qnty-from asc
     1160   sum-from asc
     1161   turnover-from asc
     1162   date-1 DESCENDING
     1163   time-1 DESCENDING
     1164   date-2 DESCENDING
     1165   time-2 DESCENDING
     1166   type-price DESCENDING
     1167   .
     1168   procedure mpl-autoprice :
     1169   define input  parameter p-only-b-code as logical   no-undo .
     1170   define input  parameter p-cli-type    as character no-undo .
     1171   define input  parameter p-cli-code    as integer   no-undo .
     1172   define input  parameter p-main-b-code as integer   no-undo .
     1173   define input  parameter p-b-code      as integer   no-undo .
     1174   define input  parameter p-obj-type    as character no-undo .
     1175   define input  parameter p-obj-code    as integer   no-undo .
     1176   define input  parameter p-qnty-doc    as decimal   no-undo .
     1177   define input  parameter p-sum-doc     as decimal   no-undo .
     1178   define input  parameter p-vid-pay        as character no-undo .
     1179   define input  parameter p-cash-pay-type  as character no-undo .
     1180   define input  parameter p-fact-order  as decimal   no-undo .
     1181   define output parameter p-plt-id          as integer   no-undo .
     1182   define output parameter p-plt-db-num      as integer   no-undo .
     1183   define output parameter p-pdf-id          as integer   no-undo .
     1184   define output parameter p-pdf-db-num      as integer   no-undo .
     1185   define output parameter p-sale-price-base as decimal   no-undo .
     1186   define output parameter p-sale-price-rubl as decimal   no-undo .
     1187   define output parameter p-road-tax-base as decimal   no-undo .
     1188   define output parameter p-road-tax-rubl as decimal   no-undo .
     1189   define output parameter p-excise-base   as decimal   no-undo .
     1190   define output parameter p-excise-rubl   as decimal   no-undo .
     1191   define variable v-cli-oborot-ALL as decimal   no-undo .
     1192   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     1193   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     1194   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1195   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1196   define buffer buf_price-all              for ub.price-all  .
     1197   define buffer buf_goods                  for ub.goods      .
     1198   define buffer buf_global-state           for ub.global-state  .
     1199   define buffer buf_buyer-group            for ub.buyer-group  .
     1200   define buffer buf_turnover-group         for ub.turnover-group  .
     1201   define buffer buf_main-code              for ub.bar-code  .
     1202   define buffer buf_bar-code               for ub.bar-code  .
     1203   define buffer buf_pay-type               for ub.pay-type  .
     1204   define buffer buf_cash-pay               for ub.cash-pay  .
     1205   define variable to-day          as date      no-undo .
     1206   define variable v-base-rate0    as decimal   no-undo .
     1207   define variable v-base-scale0   as decimal   no-undo .
     1208   define variable v-exch-rate0    as decimal   no-undo .
     1209   define variable v-exch-scale0   as decimal   no-undo .
     1210   define variable v-base-rate     as decimal   no-undo .
     1211   define variable v-base-scale    as decimal   no-undo .
     1212   define variable v-exch-rate     as decimal   no-undo .
     1213   define variable v-exch-scale    as decimal   no-undo .
     1214   define variable v-host-code     as integer   no-undo .
     1215   define variable v-curr-abbr     as character no-undo .
     1216   define variable v-grp-name      as character no-undo .
     1217   define variable v-date-1        as date      no-undo .
     1218   define variable v-date-2        as date      no-undo .
     1219   define variable v-interv        as character no-undo .
     1220   define variable v-pay-name      as character no-undo .
     1221   define variable v-cli-oborot    as decimal   no-undo .
     1222   define variable v-trn-pay-code  as integer   no-undo .
     1223   define variable v-cash-pay-curr as integer   no-undo .
     1224   define variable v-cash-pay-code as integer   no-undo .
     1225   do
     1226   on error undo, return error return-value
     1227   :
     1228   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1229   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1230   if p-fact-order = ? then do:
     1231     run fact-order-mpl (
     1232         input   today       ,
     1233         input   p-obj-type  ,
     1234         input   p-obj-code  ,
     1235         output  p-fact-order ).
     1236   end.
     1237   if p-vid-pay <> "" then do:
     1238      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1239      if available buf_pay-type
     1240         then v-trn-pay-code = buf_pay-type.obj-code.
     1241         else v-trn-pay-code =  0.
     1242   end.
     1243   else v-trn-pay-code = 0 .
     1244   if p-cash-pay-type <> "" then do:
     1245      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1246      if available buf_pay-type
     1247         then
     1248           assign
     1249             v-cash-pay-curr = buf_cash-pay.curr-code
     1250             v-cash-pay-code = buf_cash-pay.cdpay-code
     1251           .
     1252         else
     1253           assign
     1254             v-cash-pay-curr = 0
     1255             v-cash-pay-code = 0
     1256             .
     1257   end.
     1258   else
     1259     assign
     1260       v-cash-pay-curr = 0
     1261       v-cash-pay-code = 0
     1262       .
     1263   for each tt_price-all  : delete tt_price-all . end.
     1264   assign
     1265     p-plt-id             = ?
     1266     p-plt-db-num         = ?
     1267     p-pdf-id             = ?
     1268     p-pdf-db-num         = ?
     1269     p-sale-price-base    = ?
     1270     p-sale-price-rubl    = ?
     1271     v-cli-oborot         = 0
     1272   .
     1273   find first buf_global-state no-lock no-error .
     1274   if not available buf_global-state then do:
     1275      message
     1276        "Не заданы параметры ценообразования!"
     1277        view-as alert-box error
     1278      .
     1279      return error return-value .
     1280   end.
     1281   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1282   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1283     (input  p-obj-type
     1284     ,input  p-obj-code
     1285     ,output to-day
     1286     )  .
     1287   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1288   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1289     (input  p-obj-type
     1290     ,input  p-obj-code
     1291     ,output v-host-code
     1292     )  .
     1293   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1294   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1295     (input  v-host-code
     1296     ,input  to-day
     1297     ,output v-base-rate0
     1298     ,output v-base-scale0
     1299     )  .
     1300     v-cli-oborot-ALL  = 0 .
     1301     for each buf_turnover-buyer-main no-lock  where
     1302              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1303              buf_turnover-buyer-main.cli-code = p-cli-code
     1304              :
     1305              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1306     end.
     1307   for each buf_price-all no-lock where
     1308            buf_price-all.obj-type = p-obj-type and
     1309            buf_price-all.obj-code = p-obj-code and
     1310            buf_price-all.gds-code = buf_goods.gds-code and
     1311            buf_price-all.status_  = 'акт':U  and
     1312          ( p-only-b-code = false   or
     1313          ( buf_price-all.b-code = p-main-b-code or
     1314            buf_price-all.b-code = p-b-code))    and
     1315           ( p-only-b-code = true  or
     1316             buf_price-all.b-code = p-b-code)
     1317             and
     1318             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1319           ( buf_price-all.fact-order-sys-to = ? or
     1320             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1321           :
     1322            v-interv   = "" .
     1323            v-grp-name = "" .
     1324            v-pay-name = "" .
     1325            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1326            if buf_price-all.bgr-id > 0 then do:
     1327               find first buf_buyer-group no-lock where
     1328                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1329                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1330               if available buf_buyer-group then do:
     1331                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1332                  find first buf_buyer-in-buyer-group no-lock where
     1333                             buf_buyer-in-buyer-group.stts         = 0 and
     1334                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1335                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1336                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1337                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1338                             no-error .
     1339                             if not available buf_buyer-in-buyer-group then do:
     1340                                v-grp-name = "".
     1341                                next.
     1342                             end.
     1343                             v-grp-name = buf_buyer-group.name .
     1344                  end.
     1345               end.
     1346               else do:
     1347                    v-grp-name = "".
     1348                    next.
     1349               end.
     1350            end.
     1351            if buf_price-all.tog-id > 0 then do:
     1352               find first buf_turnover-group no-lock where
     1353                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1354                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1355               if available buf_turnover-group then do:
     1356                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1357                     v-cli-oborot = v-cli-oborot-all  .
     1358                     find first buf1_tnv-in-turnover-group no-lock where
     1359                                buf1_tnv-in-turnover-group.stts       =  0     and
     1360                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1361                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1362                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1363                     find first buf2_tnv-in-turnover-group no-lock where
     1364                                buf2_tnv-in-turnover-group.stts       =  0     and
     1365                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1366                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1367                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1368                     if not (available buf1_tnv-in-turnover-group and
     1369                             available buf2_tnv-in-turnover-group ) then do:
     1370                             v-grp-name = "".
     1371                             next .
     1372                     end.
     1373                     v-grp-name = buf_turnover-group.name.
     1374                  end.
     1375               end.
     1376               else do:
     1377                    v-grp-name = "".
     1378                    next.
     1379               end.
     1380            end.
     1381            if buf_price-all.plt-fix-cource-crc-base = true then
     1382               assign
     1383                 v-base-rate  = buf_price-all.pdf-base-rate
     1384                 v-base-scale = buf_price-all.pdf-base-scale
     1385               .
     1386               else
     1387               assign
     1388                 v-base-rate  = v-base-rate0
     1389                 v-base-scale = v-base-scale0
     1390               .
     1391            if buf_price-all.plt-fix-cource-crc-doc = true then
     1392               assign
     1393                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1394                 v-exch-scale = buf_price-all.pdf-exch-scale
     1395               .
     1396               else do:
     1397   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1399     (input  buf_price-all.curr-code
     1400     ,input  to-day
     1401     ,output v-exch-rate0
     1402     ,output v-exch-scale0
     1403     ,output v-curr-abbr
     1404     )  .
     1405               assign
     1406                 v-exch-rate  = v-exch-rate0
     1407                 v-exch-scale = v-exch-scale0
     1408                 .
     1409              end.
     1410              v-date-1 = date ( "" )  .
     1411              if buf_price-all.fact-order-sys-from > 0 then do:
     1412                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1413                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1414                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1415              end.
     1416              v-date-2 =  date ( "" )  .
     1417              if buf_price-all.fact-order-sys-to > 0 then do:
     1418                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1419                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1420                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1421              end.
     1422              if buf_price-all.qnty-from <> ? then do :
     1423                 if not (
     1424                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1425                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1426                 ) then do:
     1427                        v-interv = "".
     1428                        next.
     1429                 end.
     1430                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1431              end.
     1432              if buf_price-all.sum-from <> ? then do :
     1433                 if not (
     1434                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1435                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1436                 ) then do:
     1437                    v-interv = "".
     1438                    next.
     1439                 end.
     1440                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1441              end.
     1442              if buf_price-all.turnover-from <> ? then do :
     1443                 if not (
     1444                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1445                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1446                 ) then do:
     1447                    v-interv = "".
     1448                    next.
     1449                 end.
     1450                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1451              end.
     1452              if buf_price-all.use-pay-type = 1 then do :
     1453                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1454                    v-pay-name = "" .
     1455                    next.
     1456                  end.
     1457                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1458              end.
     1459              if buf_price-all.use-cash-pay = 1 then do :
     1460                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1461                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1462                   v-pay-name = "" .
     1463                   next.
     1464                 end.
     1465                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1466              end.
     1467             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1468             create tt_price-all .
     1469             buffer-copy buf_price-all to tt_price-all
     1470             assign
     1471               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1472               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1473               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1474               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1475               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1476               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1477               tt_price-all.price-sale     = buf_price-all.price-sale
     1478               tt_price-all.road-tax       = buf_price-all.road-tax
     1479               tt_price-all.excise         = buf_price-all.excise
     1480               tt_price-all.pdf-exch-rate   = v-exch-rate
     1481               tt_price-all.pdf-exch-scale  = v-exch-scale
     1482               tt_price-all.pdf-base-rate   = v-base-rate
     1483               tt_price-all.pdf-base-scale  = v-base-scale
     1484               tt_price-all.grp-name        = v-grp-name
     1485               tt_price-all.date-1          = v-date-1
     1486               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1487               tt_price-all.time-1          = buf_price-all.start-sys-time
     1488               tt_price-all.date-2          = v-date-2
     1489               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1490               tt_price-all.time-2          = buf_price-all.end-sys-time
     1491               tt_price-all.interv-name     = v-interv
     1492               tt_price-all.pay-name        = v-pay-name
     1493               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1494             .
     1495   end.
     1496   define variable vt-plt-id as integer   no-undo .
     1497   define variable vt-plt-db as integer   no-undo .
     1498   define variable vt-pdf-id as integer   no-undo .
     1499   define variable vt-pdf-db as integer   no-undo .
     1500   define buffer neos_price-all for tt_price-all  .
     1501   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1502       if available tt_price-all then do:
     1503        assign
     1504          vt-plt-id = tt_price-all.plt-id
     1505          vt-plt-db = tt_price-all.plt-db-num
     1506          vt-pdf-id = tt_price-all.pdf-id
     1507          vt-pdf-db = tt_price-all.pdf-db
     1508        .
     1509        if tt_price-all.b-code = p-b-code then do:
     1510             assign
     1511               p-plt-id           = tt_price-all.plt-id
     1512               p-plt-db-num       = tt_price-all.plt-db-num
     1513               p-pdf-id           = tt_price-all.pdf-id
     1514               p-pdf-db-num       = tt_price-all.pdf-db
     1515               p-sale-price-base  = tt_price-all.price-sale-base
     1516               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1517               p-road-tax-base    = tt_price-all.road-tax-base
     1518               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1519               p-excise-base      = tt_price-all.excise-base
     1520               p-excise-rubl      = tt_price-all.excise-rubl
     1521               .
     1522        end.
     1523        else do:
     1524          find first neos_price-all where
     1525                     neos_price-all.b-code     = p-b-code  and
     1526                     neos_price-all.plt-id     = vt-plt-id and
     1527                     neos_price-all.plt-db-num = vt-plt-db and
     1528                     neos_price-all.pdf-id     = vt-pdf-id and
     1529                     neos_price-all.pdf-db     = vt-pdf-db
     1530                     use-index pi no-error .
     1531            if available neos_price-all then do:
     1532             assign
     1533               p-plt-id           = tt_price-all.plt-id
     1534               p-plt-db-num       = tt_price-all.plt-db-num
     1535               p-pdf-id           = tt_price-all.pdf-id
     1536               p-pdf-db-num       = tt_price-all.pdf-db
     1537               p-sale-price-base  = neos_price-all.price-sale-base
     1538               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1539               p-road-tax-base    = neos_price-all.road-tax-base
     1540               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1541               p-excise-base      = neos_price-all.excise-base
     1542               p-excise-rubl      = neos_price-all.excise-rubl
     1543               .
     1544            end.
     1545            else do:
     1546                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1547                 if error-status :error    then do:
     1548                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1549                   return error return-value .
     1550                 end.
     1551             assign
     1552               p-plt-id           = tt_price-all.plt-id
     1553               p-plt-db-num       = tt_price-all.plt-db-num
     1554               p-pdf-id           = tt_price-all.pdf-id
     1555               p-pdf-db-num       = tt_price-all.pdf-db
     1556               p-sale-price-base  = tt_price-all.price-sale-base
     1557               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1558               p-road-tax-base    = tt_price-all.road-tax-base
     1559               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1560               p-excise-base      = tt_price-all.excise-base
     1561               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1562               .
     1563            end.
     1564        end.
     1565     end.
     1566   end.
     1567   end procedure.
     1568   procedure mpl-tpl-auto :
     1569   define input  parameter p-b-code     as integer   no-undo .
     1570   define input  parameter p-obj-type   as character no-undo .
     1571   define input  parameter p-obj-code   as integer   no-undo .
     1572   define input  parameter p-plt-id     as integer   no-undo .
     1573   define input  parameter p-plt-db-num as integer   no-undo .
     1574   define input  parameter p-fact-order as decimal   no-undo .
     1575   define output parameter p-sale-price as decimal   no-undo .
     1576   define output parameter p-pdf-id     as integer   no-undo .
     1577   define output parameter p-pdf-db-num as integer   no-undo .
     1578     do
     1579     on error undo, return error return-value
     1580     :
     1581   if p-fact-order = ? then do:
     1582     run fact-order-mpl (
     1583         input   today       ,
     1584         input   p-obj-type  ,
     1585         input   p-obj-code  ,
     1586         output  p-fact-order ) .
     1587   end.
     1588   assign
     1589     p-pdf-id      = ?
     1590     p-pdf-db-num  = ?
     1591     p-sale-price  = ?
     1592   .
     1593   define buffer buf_bar-code for ub.bar-code  .
     1594   define buffer buf_goods for ub.goods  .
     1595   find first buf_bar-code no-lock where
     1596              buf_bar-code.b-code = p-b-code
     1597              no-error .
     1598   if error-status :error then return error return-value .
     1599   find first buf_goods no-lock where
     1600              buf_goods.gds-code = buf_bar-code.gds-code
     1601              no-error .
     1602   if error-status :error then return error return-value .
     1603   define variable v-main-b-code as integer   no-undo .
     1604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1605     (input  buf_goods.gds-code
     1606     ,input  ?
     1607     ,output v-main-b-code
     1608     )  .
     1609   define buffer buf_price-all for ub.price-all  .
     1610   for each tt_price-all : delete tt_price-all. end.
     1611       for each buf_price-all no-lock where
     1612               buf_price-all.plt-id     = p-plt-id                 and
     1613               buf_price-all.plt-db-num = p-plt-db-num             and
     1614               buf_price-all.obj-type   = p-obj-type               and
     1615               buf_price-all.obj-code   = p-obj-code               and
     1616               buf_price-all.gds-code   = buf_goods.gds-code       and
     1617             ( buf_price-all.b-code = v-main-b-code or
     1618               buf_price-all.b-code = p-b-code)    and
     1619               buf_price-all.status_    = 'акт':U         and
     1620               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1621             ( buf_price-all.fact-order-sys-to = ? or
     1622               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1623               :
     1624                 create tt_price-all .
     1625                 buffer-copy buf_price-all to tt_price-all
     1626                 assign
     1627                   tt_price-all.price-sale  = buf_price-all.price-sale
     1628                 .
     1629       end.
     1630   define variable vt-plt-id as integer   no-undo .
     1631   define variable vt-plt-db as integer   no-undo .
     1632   define variable vt-pdf-id as integer   no-undo .
     1633   define variable vt-pdf-db as integer   no-undo .
     1634   define buffer neos_price-all for tt_price-all  .
     1635   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1636       if available tt_price-all then do:
     1637        assign
     1638          vt-plt-id = tt_price-all.plt-id
     1639          vt-plt-db = tt_price-all.plt-db-num
     1640          vt-pdf-id = tt_price-all.pdf-id
     1641          vt-pdf-db = tt_price-all.pdf-db
     1642        .
     1643        if tt_price-all.b-code = p-b-code then do:
     1644             assign
     1645               p-plt-id           = tt_price-all.plt-id
     1646               p-plt-db-num       = tt_price-all.plt-db-num
     1647               p-pdf-id           = tt_price-all.pdf-id
     1648               p-pdf-db-num       = tt_price-all.pdf-db
     1649               p-sale-price       = tt_price-all.price-sale
     1650               .
     1651        end.
     1652        else do:
     1653          find first neos_price-all where
     1654                     neos_price-all.b-code     = p-b-code  and
     1655                     neos_price-all.plt-id     = vt-plt-id and
     1656                     neos_price-all.plt-db-num = vt-plt-db and
     1657                     neos_price-all.pdf-id     = vt-pdf-id and
     1658                     neos_price-all.pdf-db     = vt-pdf-db
     1659                     use-index pi no-error .
     1660            if available neos_price-all then do:
     1661             assign
     1662               p-plt-id           = tt_price-all.plt-id
     1663               p-plt-db-num       = tt_price-all.plt-db-num
     1664               p-pdf-id           = tt_price-all.pdf-id
     1665               p-pdf-db-num       = tt_price-all.pdf-db
     1666               p-sale-price       = neos_price-all.price-sale
     1667               .
     1668            end.
     1669            else do:
     1670           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1671           if error-status :error    then do:
     1672              message "Не найден бар-код" p-b-code view-as alert-box error .
     1673              return error return-value .
     1674           end.
     1675             assign
     1676               p-plt-id           = tt_price-all.plt-id
     1677               p-plt-db-num       = tt_price-all.plt-db-num
     1678               p-pdf-id           = tt_price-all.pdf-id
     1679               p-pdf-db-num       = tt_price-all.pdf-db
     1680               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1681               .
     1682            end.
     1683        end.
     1684     end.
     1685     end.
     1686   end procedure.
     1687   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1688   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1689   procedure wthcattr-sprcli :
     1690   define input parameter parparentproc  as widget-handle no-undo.
     1691   define input parameter p-mode  as character no-undo.
     1692   define input-output parameter p-value as character no-undo .
     1693   define output parameter p-setted as logical no-undo .
     1694     DEFINE VARIABLE v-value as character no-undo .
     1695     define variable v-cli-type as character no-undo .
     1696     define variable v-cli-code as integer no-undo .
     1697     define buffer buf_clients   for ub.clients.
     1698     define variable v_rid as character no-undo.
     1699     define variable ref-rec as recid no-undo .
     1700     do
     1701     on error undo, return error
     1702     :
     1703         v-value = p-value.
     1704      if p-value <> '':U then do:
     1705       assign
     1706       v-cli-type = substring(p-value, 1, 3)
     1707       v-cli-code = integer(substring(p-value, 4))
     1708       no-error.
     1709       if error-status:error then do:
     1710         assign
     1711         v-cli-type = '':U
     1712         v-cli-code = 0
     1713         .
     1714       end.
     1715      end.
     1716      FIND FIRST buf_clients NO-LOCK WHERE
     1717               buf_clients.obj-type = v-cli-type AND
     1718               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1719      IF available(buf_clients) then do:
     1720       run ref/cli-all.w (
     1721                   input parparentproc
     1722                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1723                  ,input v-cli-type
     1724                  ,input 'все':U
     1725                  ,input 'все':U
     1726                  ,input RECID( buf_clients )
     1727                  ,input ",,,,,,NO"
     1728                  ,input ?
     1729                  ,OUTPUT v_rid ).
     1730     END.
     1731     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1732       run ref/cli-all.w (
     1733                    input parparentproc
     1734                   ,INPUT "b-sel":U
     1735                  ,input  v-cli-type
     1736                  ,input 'все':U
     1737                  ,input 'текущие':U
     1738                  ,input ?
     1739                  ,input ",,,,,,NO"
     1740                  ,input ?
     1741                  ,OUTPUT v_rid ).
     1742     END.
     1743     else do:
     1744       message
     1745       if p-value = "":U then 'Атрибут не задан!'
     1746       else substitute('Не найден клиент &1',p-value)
     1747       view-as alert-box warning.
     1748     end.
     1749     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1750       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1751       IF ERROR-STATUS:ERROR THEN DO:
     1752           RETURN NO-APPLY.
     1753       END.
     1754       FIND FIRST buf_clients NO-LOCK WHERE
     1755                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1756       IF AVAIL buf_clients THEN DO:
     1757         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1758       end.
     1759     end.
     1760     if v-value <> p-value then do:
     1761       p-value = v-value.
     1762       p-setted = yes.
     1763     end.
     1764     end.
     1765   end procedure.
     1766     define new global shared variable g#wthcalib as handle no-undo.
     1767   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
     1768   define variable v-tth as handle no-undo .
     1769   assign
     1770   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1771   def temp-table tt-wthlib-parts no-undo like ub.wth-parts.
     1772   Procedure wth-doc-close:
     1773       define input parameter p-rec        as recid     no-undo .
     1774       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1775     do
     1776     on error undo, return error return-value
     1777     :
     1778       find first cur-wth-parts where recid(cur-wth-parts) = p-rec exclusive-lock no-wait no-error.
     1779       if not available cur-wth-parts then return error substitute("Не найдена партия").
     1780       CASE cur-wth-parts.ext-doc-type:
     1781           WHEN 'ie':U or when 'rf':U or when 'ff':U
     1782           OR WHEN 'fj':U
     1783           THEN DO:
     1784              RUN wth-parts-close(BUFFER cur-wth-parts, 'free-zone':U ).
     1785           END.
     1786           WHEN 'ee':U THEN DO:
     1787               RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1788           END.
     1789           WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'rp':U
     1790             OR WHEN 'ip':U OR WHEN 'pc':U
     1791             OR WHEN 'pj':U
     1792              THEN DO:
     1793               RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1794           END.
     1795           WHEN 'df':U OR WHEN 'dp':U OR WHEN 'dc':U THEN DO:
     1796             RUN wth-parts-close(BUFFER cur-wth-parts, 'out-zone':U ).
     1797           end.
     1798           when 'ep':U or when 'ef':U
     1799           OR WHEN 'oj':U or when 'jj':U
     1800           then .
     1801           when 'xc':U then do:
     1802             if cur-wth-parts.type = 'при':U then
     1803                  RUN wth-parts-close(BUFFER cur-wth-parts, 'put-zone':U ).
     1804             else RUN wth-parts-close(BUFFER cur-wth-parts, 'cli-zone':U ).
     1805           end.
     1806           OTHERWISE DO:
     1807               RETURN ERROR substitute("Неверный вызов процедуры закрытия: расш. тип = &1"
     1808                                    , cur-wth-parts.ext-doc-type
     1809                                       ).
     1810           END.
     1811       END CASE.
     1812       RELEASE cur-wth-parts.
     1813       END.
     1814   END.
     1815   PROCEDURE wth-parts-close:
     1816       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1817       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1818       define variable v-rec as recid.
     1819       if bfrom_wth-parts.stts  = 1 then return.
     1820          run str/wthpartp.p  ( INPUT     'ДОБАВЛЕНИЕ':U,
     1821                     INPUT     bfrom_wth-parts.obj-type,
     1822                     INPUT     bfrom_wth-parts.obj-code,
     1823                     INPUT     bfrom_wth-parts.w-p-code,
     1824                     INPUT     bfrom_wth-parts.wth-code,
     1825                     INPUT     bfrom_wth-parts.par-code,
     1826                     INPUT     bfrom_wth-parts.in-code ,
     1827                     INPUT     p-zone,
     1828                     INPUT     bfrom_wth-parts.ser-code,
     1829                     INPUT     bfrom_wth-parts.db-num  ,
     1830                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1831                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     1832                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1833                     INPUT     bfrom_wth-parts.fact-rangeTo ,
     1834                     INPUT     bfrom_wth-parts.host-code     ,
     1835                     INPUT     bfrom_wth-parts.contract-code               ,
     1836                     INPUT     bfrom_wth-parts.price-rubl    ,
     1837                     INPUT     bfrom_wth-parts.price-base    ,
     1838                     INPUT     bfrom_wth-parts.supp-type,
     1839                     INPUT     bfrom_wth-parts.supp-code,
     1840                     INPUT     bfrom_wth-parts.in-obj-type      ,
     1841                     INPUT     bfrom_wth-parts.in-obj-code      ,
     1842                     INPUT     bfrom_wth-parts.ext-doc-type,
     1843                     INPUT     bfrom_wth-parts.gds-code,
     1844                     INPUT     bfrom_wth-parts.stts               ,
     1845                     INPUT     bfrom_wth-parts.beg-dt        ,
     1846                     INPUT     bfrom_wth-parts.end-dt        ,
     1847                     INPUT     bfrom_wth-parts.vat-pc        ,
     1848                     INPUT     bfrom_wth-parts.cli-code,
     1849                     INPUT     bfrom_wth-parts.cli-type,
     1850                     INPUT     bfrom_wth-parts.out-obj-code,
     1851                     INPUT     bfrom_wth-parts.out-obj-type,
     1852                     INPUT     bfrom_wth-parts.sale-obj-code,
     1853                     INPUT     bfrom_wth-parts.sale-obj-type,
     1854                     INPUT     bfrom_wth-parts.out-code ,
     1855                     INPUT  yes,
     1856                     INPUT     '':U ,
     1857                     INPUT-OUTPUT v-rec
     1858                     ) no-error.
     1859       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     1860   END.
     1861   Procedure wth-doc-razrez:
     1862       define input parameter p-rec as recid NO-UNDO.
     1863       define input parameter p-doc-del AS log NO-UNDO.
     1864       define variable v-mess AS CHAR NO-UNDO.
     1865       define variable p-silent AS LOG INIT NO NO-UNDO.
     1866       DEFINE BUFFER b-wth-parts FOR ub.wth-parts.
     1867       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1868       DEFINE BUFFER cur-wth-parts FOR ub.wth-parts.
     1869     do
     1870     on error undo, return error return-value
     1871     :
     1872       FIND FIRST cur-wth-parts WHERE recid(cur-wth-parts) = p-rec
     1873                                 EXCLUSIVE-LOCK .
     1874       IF AVAILABLE cur-wth-parts THEN DO:
     1875           CASE cur-wth-parts.ext-doc-type:
     1876               WHEN 'ie':U or when 'ip':U or when 'rp':U
     1877               or when 'ff':U or when 'rf':U
     1878               or when 'fj':U or when 'pj':U
     1879               THEN DO:
     1880                   RUN wth-parts-raz(BUFFER cur-wth-parts, "":U,p-doc-del) .
     1881               END.
     1882               WHEN 'ee':U or when 'ef':U or when 'jj':U
     1883               THEN DO:
     1884                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del) .
     1885               END.
     1886               WHEN 'ep':U or when 'oj':U THEN DO:
     1887                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del) .
     1888               END.
     1889               WHEN 'pc':U THEN DO:
     1890                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1891               END.
     1892               WHEN 'dp':U THEN DO:
     1893                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'put-zone':U,p-doc-del)  .
     1894               END.
     1895               WHEN 'df':U THEN DO:
     1896                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'free-zone':U,p-doc-del)  .
     1897               END.
     1898               WHEN 'dc':U THEN DO:
     1899                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del)  .
     1900               END.
     1901               WHEN 'ps':U OR WHEN 'pz':U THEN DO:
     1902                   RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del).
     1903               END.
     1904               when 'xc':U then do:
     1905                 if cur-wth-parts.type = 'при':U then
     1906                      RUN wth-parts-raz(BUFFER cur-wth-parts, 'cli-zone':U,p-doc-del ).
     1907                 else RUN wth-parts-raz(BUFFER cur-wth-parts,  'free-zone':U ,p-doc-del).
     1908               end.
     1909               OTHERWISE DO:
     1910                   RETURN ERROR substitute("Неверный вызов процедуры разрезервирования: расш. тип =  :&1&2&3"
     1911                                        , cur-wth-parts.ext-doc-type
     1912                                        , error-status:get-message(1)
     1913                                        , return-value
     1914                                        ).
     1915               END.
     1916           END CASE.
     1917       END.
     1918     END.
     1919   END.
     1920   PROCEDURE wth-parts-raz:
     1921       DEFINE PARAMETER BUFFER bfrom_wth-parts FOR ub.wth-parts.
     1922       DEFINE INPUT PARAMETER p-zone AS CHAR NO-UNDO.
     1923       DEFINE INPUT PARAMETER p-doc-del AS log NO-UNDO.
     1924       define variable v-mes as char no-undo.
     1925       define variable v-rec as recid no-undo.
     1926       DEFINE BUFFER buf_wth-parts FOR ub.wth-parts.
     1927     do
     1928     on error undo, return error return-value
     1929     :
     1930       v-mes = substitute('Код серии: &1-&2 Диапазон &3-&4'
     1931                                      ,bfrom_wth-parts.ser-code
     1932                                      ,bfrom_wth-parts.db-num
     1933                                      ,bfrom_wth-parts.doc-rangeFrom
     1934                                      ,bfrom_wth-parts.doc-rangeTo).
     1935       IF lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0 THEN DO:
     1936           RETURN ERROR substitute("Нельзя удалять партии МЦ из зоны :&1&2&3&4&5"
     1937                                , error-status:get-message(1)
     1938                                , bfrom_wth-parts.out-code
     1939                                , return-value
     1940                                ,chr(10)
     1941                                ,v-mes
     1942                                ).
     1943       END.
     1944       v-rec = recid(bfrom_wth-parts).
     1945       CASE bfrom_wth-parts.ext-doc-type:
     1946           WHEN 'ie':U  or when 'fj':U or when  'pj':U THEN DO:
     1947               delete bfrom_wth-parts NO-ERROR.
     1948               if error-status:error then do:
     1949                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1950                                      , error-status:get-message(1)
     1951                                      , chr(10)
     1952                                      , return-value
     1953                                      ,v-mes
     1954                                      ).
     1955               END.
     1956           END.
     1957           when 'rp':U or when 'rf':U then do:
     1958             if p-doc-del then do:
     1959               delete bfrom_wth-parts NO-ERROR.
     1960               if error-status:error then do:
     1961                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1962                                      , error-status:get-message(1)
     1963                                      , chr(10)
     1964                                      , return-value
     1965                                      ,v-mes
     1966                                      ).
     1967               END.
     1968             end.
     1969             else   RETURN ERROR 'Нельзя удалять партии документа внутреннего возврата.'  .
     1970           end.
     1971           when 'ip':U or when 'ff':U then do:
     1972             if p-doc-del then do:
     1973               delete bfrom_wth-parts NO-ERROR.
     1974               if error-status:error then do:
     1975                 return error substitute("Ошибка при удалении записи партии МЦ:&1&2&3&2&4"
     1976                                      , error-status:get-message(1)
     1977                                      , chr(10)
     1978                                      , return-value
     1979                                      ,v-mes
     1980                                      ).
     1981               END.
     1982             end.
     1983             else do:
     1984               run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     1985                     INPUT     bfrom_wth-parts.obj-type,
     1986                     INPUT     bfrom_wth-parts.obj-code,
     1987                     INPUT     bfrom_wth-parts.w-p-code,
     1988                     INPUT     bfrom_wth-parts.wth-code,
     1989                     INPUT     bfrom_wth-parts.par-code,
     1990                     INPUT     bfrom_wth-parts.in-code ,
     1991                     INPUT     bfrom_wth-parts.out-code,
     1992                     INPUT     bfrom_wth-parts.ser-code,
     1993                     INPUT     bfrom_wth-parts.db-num  ,
     1994                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     1995                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     1996                     INPUT     bfrom_wth-parts.doc-RangeFrom ,
     1997                     INPUT     bfrom_wth-parts.doc-rangeTo  ,
     1998                     INPUT     bfrom_wth-parts.host-code     ,
     1999                     INPUT     bfrom_wth-parts.contract-code ,
     2000                     INPUT     bfrom_wth-parts.price-rubl    ,
     2001                     INPUT     bfrom_wth-parts.price-base    ,
     2002                     INPUT     bfrom_wth-parts.supp-type,
     2003                     INPUT     bfrom_wth-parts.supp-code,
     2004                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2005                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2006                     INPUT     bfrom_wth-parts.ext-doc-type,
     2007                     INPUT     bfrom_wth-parts.gds-code,
     2008                     INPUT     1            ,
     2009                     INPUT     bfrom_wth-parts.beg-dt        ,
     2010                     INPUT     bfrom_wth-parts.end-dt        ,
     2011                     INPUT     bfrom_wth-parts.vat-pc        ,
     2012                     INPUT     bfrom_wth-parts.cli-code,
     2013                     INPUT     bfrom_wth-parts.cli-type,
     2014                     INPUT     bfrom_wth-parts.out-obj-code,
     2015                     INPUT     bfrom_wth-parts.out-obj-type,
     2016                     INPUT     bfrom_wth-parts.sale-obj-code,
     2017                     INPUT     bfrom_wth-parts.sale-obj-type,
     2018                     INPUT     bfrom_wth-parts.doc-code ,
     2019                     INPUT  yes,
     2020                     INPUT     bfrom_wth-parts.type ,
     2021                     INPUT-OUTPUT v-rec
     2022                     ) no-error.
     2023                if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2024             end.
     2025           end.
     2026           OTHERWISE DO:
     2027            run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2028                     INPUT     bfrom_wth-parts.obj-type,
     2029                     INPUT     bfrom_wth-parts.obj-code,
     2030                     INPUT     bfrom_wth-parts.w-p-code,
     2031                     INPUT     bfrom_wth-parts.wth-code,
     2032                     INPUT     bfrom_wth-parts.par-code,
     2033                     INPUT     bfrom_wth-parts.in-code ,
     2034                     INPUT     p-zone,
     2035                     INPUT     bfrom_wth-parts.ser-code,
     2036                     INPUT     bfrom_wth-parts.db-num  ,
     2037                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2038                     INPUT     bfrom_wth-parts.fact-rangeTo   ,
     2039                     INPUT     bfrom_wth-parts.Fact-RangeFrom ,
     2040                     INPUT     bfrom_wth-parts.fact-rangeTo  ,
     2041                     INPUT     bfrom_wth-parts.host-code     ,
     2042                     INPUT     bfrom_wth-parts.contract-code ,
     2043                     INPUT     bfrom_wth-parts.price-rubl    ,
     2044                     INPUT     bfrom_wth-parts.price-base    ,
     2045                     INPUT     bfrom_wth-parts.supp-type,
     2046                     INPUT     bfrom_wth-parts.supp-code,
     2047                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2048                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2049                     INPUT     bfrom_wth-parts.ext-doc-type,
     2050                     INPUT     bfrom_wth-parts.gds-code,
     2051                     INPUT     bfrom_wth-parts.stts             ,
     2052                     INPUT     bfrom_wth-parts.beg-dt        ,
     2053                     INPUT     bfrom_wth-parts.end-dt        ,
     2054                     INPUT     bfrom_wth-parts.vat-pc        ,
     2055                     INPUT     bfrom_wth-parts.cli-code,
     2056                     INPUT     bfrom_wth-parts.cli-type,
     2057                     INPUT     bfrom_wth-parts.out-obj-code,
     2058                     INPUT     bfrom_wth-parts.out-obj-type,
     2059                     INPUT     bfrom_wth-parts.sale-obj-code,
     2060                     INPUT     bfrom_wth-parts.sale-obj-type,
     2061                     INPUT     bfrom_wth-parts.doc-code ,
     2062                     INPUT  yes,
     2063                     INPUT      "":U ,
     2064                     INPUT-OUTPUT v-rec
     2065                     ) no-error.
     2066       if error-status:error then undo, return error return-value + chr(10) + error-status:get-message(1) .
     2067           END.
     2068       END CASE.
     2069     END.
     2070   END.
     2071   procedure wth-parts-rezerv:
     2072       define input parameter        p-param            as logical no-undo.
     2073       define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2074       define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2075       define input parameter        p-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2076       define input parameter        p-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2077       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2078       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2079       define input parameter        p-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2080       define input parameter        p-price-base       LIKE ub.wth-parts.price-base no-undo .
     2081       define input parameter        p-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2082       define input parameter        p-host-code        LIKE ub.wth-parts.host-code no-undo .
     2083       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2084       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2085       define input parameter        p-w-p-code         LIKE ub.wth-parts.w-p-code no-undo .
     2086       define input parameter        p-wth-code         LIKE ub.wth-parts.wth-code no-undo .
     2087       define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2088       define input parameter        p-in-code          LIKE ub.wth-parts.in-code no-undo .
     2089       define input parameter        p-doc-code         LIKE ub.wth-parts.out-code no-undo .
     2090       define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2091       define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2092       define input parameter        p-ext-doc-type     LIKE ub.wth-parts.ext-doc-type no-undo .
     2093       define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2094       define input parameter        p-type             LIKE ub.wth-parts.type no-undo .
     2095       define input-output parameter p-rec        as recid     no-undo .
     2096     define buffer bfrom_wth-parts   for ub.wth-parts.
     2097     define buffer bufr_wth-doc      for ub.wth-doc.
     2098     define variable v-rec    as recid        no-undo.
     2099     define variable v-recDop as recid        no-undo.
     2100     define variable v-zone   as character    no-undo.
     2101     DEFINE variable v-beg-dt           LIKE ub.wth-parts.beg-dt no-undo .
     2102     define VARIABLE v-end-dt           LIKE ub.wth-parts.end-dt no-undo .
     2103     define variable v-price-rubl       LIKE ub.wth-parts.price-rubl no-undo .
     2104     define variable v-price-base       LIKE ub.wth-parts.price-base no-undo .
     2105     define variable v-vat-pc           LIKE ub.wth-parts.vat-pc no-undo .
     2106     define variable v-mpl-date         as date      no-undo.
     2107     empty temp-table tt-wthlib-parts.
     2108   main-block:
     2109   do  transaction
     2110   on error  undo main-block, return error return-value + chr(32) + error-status:get-message(1)
     2111   on stop   undo main-block, return error
     2112   on endkey undo main-block, return error
     2113   :
     2114   FIND FIRST bufr_wth-doc WHERE bufr_wth-doc.doc-code = p-doc-code NO-LOCK NO-ERROR.
     2115   IF NOT AVAILABLE bufr_wth-doc THEN RETURN ERROR SUBSTITUTE('Не найден документ МЦ с номером &1',p-doc-code).
     2116     if lookup(p-ext-doc-type,'ie,ip,rp,fj,pj,ff,rf':U) > 0
     2117           then do:
     2118        run str/wthpartp.p  ( INPUT 'ДОБАВЛЕНИЕ':U,
     2119                     INPUT  p-obj-type,
     2120                     INPUT  p-obj-code,
     2121                     INPUT  p-w-p-code,
     2122                     INPUT  p-wth-code,
     2123                     INPUT  p-par-code,
     2124                     INPUT  p-in-code,
     2125                     INPUT  p-doc-code,
     2126                     INPUT  p-ser-code,
     2127                     INPUT  p-db-num  ,
     2128                     INPUT  p-Fact-RangeFrom ,
     2129                     INPUT  p-fact-rangeTo  ,
     2130                     INPUT  p-Fact-RangeFrom ,
     2131                     INPUT  p-fact-rangeTo ,
     2132                     INPUT  p-host-code     ,
     2133                     INPUT  0   ,
     2134                     INPUT  p-price-rubl    ,
     2135                     INPUT  p-price-base    ,
     2136                     INPUT  '':U,
     2137                     INPUT  0,
     2138                     INPUT  p-obj-type      ,
     2139                     INPUT  p-obj-code      ,
     2140                     INPUT  p-ext-doc-type,
     2141                     INPUT  p-gds-code,
     2142                     INPUT  0           ,
     2143                     INPUT  p-beg-dt        ,
     2144                     INPUT  p-end-dt        ,
     2145                     INPUT  p-vat-pc      ,
     2146                     INPUT  0,
     2147                     INPUT  '':U,
     2148                     INPUT  0,
     2149                     INPUT  '':U,
     2150                     INPUT  0,
     2151                     INPUT  '':U,
     2152                     INPUT  p-doc-code,
     2153                     INPUT  yes,
     2154                     INPUT p-type,
     2155                     INPUT-OUTPUT p-rec
     2156                     ) no-error.
     2157                   if error-status:error then undo main-block, return error return-value + error-status:get-message(1) .
     2158     end.
     2159     else do:
     2160       if p-rec <> ? then do:
     2161         find first bfrom_wth-parts exclusive-lock where
     2162                   recid(bfrom_wth-parts) = p-rec no-error.
     2163         if  available bfrom_wth-parts
     2164           and bfrom_wth-parts.wth-code = p-wth-code
     2165           and bfrom_wth-parts.par-code = p-par-code
     2166           and bfrom_wth-parts.ser-code = p-ser-code
     2167           and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) > 0
     2168         then.
     2169         else if  available bfrom_wth-parts and lookup(bfrom_wth-parts.out-code,'free-zone,out-zone,cli-zone,фальшивый,put-zone':u) = 0
     2170         then return error substitute('Резервирование из партии (Код серии: &1-&2 Диапазон &3-&4) невозможно, т.к. партия уже входит в состав документа'
     2171                                      ,bfrom_wth-parts.ser-code
     2172                                      ,bfrom_wth-parts.db-num
     2173                                      ,bfrom_wth-parts.doc-rangeFrom
     2174                                      ,bfrom_wth-parts.doc-rangeTo).
     2175         else if  available bfrom_wth-parts then undo, return error 'Партия указанная для резервирования не соответсвует указанным параметрам!'.
     2176         if available bfrom_wth-parts
     2177            and bfrom_wth-parts.doc-rangeFrom > p-fact-rangeFrom
     2178            or bfrom_wth-parts.doc-rangeTo   < p-fact-rangeTo
     2179         then undo, return error substitute('Нельзя увеличивать границы диапазона.&1Диапазон партии &2-&3.&1Диапазон резервирования &4-&5'
     2180                                            ,chr(10)
     2181                                            ,bfrom_wth-parts.doc-rangeFrom
     2182                                            ,bfrom_wth-parts.doc-rangeTo
     2183                                            ,p-fact-rangeFrom
     2184                                            ,p-fact-rangeTo).
     2185       end.
     2186       else do:
     2187         if p-ext-doc-type = 'pz':U or (p-ext-doc-type = 'xc':U and p-type = 'при':U )then do:
     2188           for first bfrom_wth-parts no-lock where
     2189                                     bfrom_wth-parts.wth-code = p-wth-code
     2190                                 and bfrom_wth-parts.par-code = p-par-code
     2191                                 and bfrom_wth-parts.ser-code = p-ser-code
     2192                                 and bfrom_wth-parts.db-num = p-db-num
     2193                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2194                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2195                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2196                                 and bfrom_wth-parts.stts = 0
     2197                                 and bfrom_wth-parts.cli-code = p-cli-code
     2198                                 and bfrom_wth-parts.cli-type = p-cli-type
     2199                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2200                                 use-index  wth-idnt:
     2201                                 p-rec = recid(bfrom_wth-parts).
     2202            end.
     2203           If p-rec = ? and p-in-code > '' then do:
     2204              for first bfrom_wth-parts no-lock where
     2205                                     bfrom_wth-parts.wth-code = p-wth-code
     2206                                 and bfrom_wth-parts.par-code = p-par-code
     2207                                 and bfrom_wth-parts.ser-code = p-ser-code
     2208                                 and bfrom_wth-parts.db-num = p-db-num
     2209                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2210                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2211                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2212                                 and bfrom_wth-parts.stts = 0
     2213                                 and bfrom_wth-parts.cli-code = p-cli-code
     2214                                 and bfrom_wth-parts.cli-type = p-cli-type
     2215                                 use-index  wth-idnt:
     2216                                 p-rec = recid(bfrom_wth-parts).
     2217                 end.
     2218           end.
     2219                 if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2220                   recid(bfrom_wth-parts) = p-rec no-error.
     2221         end.
     2222         else if p-ext-doc-type = 'pc':U or p-ext-doc-type = 'ps':U or p-ext-doc-type = 'dc':U then do:
     2223           for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2224                                 and bfrom_wth-parts.par-code = p-par-code
     2225                                 and bfrom_wth-parts.ser-code = p-ser-code
     2226                                 and bfrom_wth-parts.db-num = p-db-num
     2227                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2228                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2229                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2230                                 and bfrom_wth-parts.stts = 0
     2231                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2232                                 use-index wth-idnt:
     2233                                 p-rec = recid(bfrom_wth-parts).
     2234            end.
     2235           If p-rec = ? and p-in-code > '' then do:
     2236            for first bfrom_wth-parts no-lock where bfrom_wth-parts.wth-code = p-wth-code
     2237                                 and bfrom_wth-parts.par-code = p-par-code
     2238                                 and bfrom_wth-parts.ser-code = p-ser-code
     2239                                 and bfrom_wth-parts.db-num = p-db-num
     2240                                 and bfrom_wth-parts.out-code = 'cli-zone':U
     2241                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2242                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2243                                 and bfrom_wth-parts.stts = 0
     2244                                 :
     2245                                 p-rec = recid(bfrom_wth-parts).
     2246            end.
     2247           end.
     2248           if p-rec <> ? then  find first bfrom_wth-parts no-lock where
     2249                   recid(bfrom_wth-parts) = p-rec no-error.
     2250         end.
     2251         else do:
     2252           CASE p-ext-doc-type:
     2253                   WHEN 'ee':U or when 'xc':U or WHEN 'ef':U
     2254                   or when 'jj':U THEN DO:
     2255                       v-zone = 'free-zone':U.
     2256                   END.
     2257                   WHEN 'ep':U or when 'oj':U THEN DO:
     2258                       v-zone = 'put-zone':U.
     2259                   END.
     2260                   WHEN 'df':U THEN DO:
     2261                       v-zone = 'free-zone':U.
     2262                   END.
     2263                   WHEN 'dp':U  THEN DO:
     2264                       v-zone = 'put-zone':U.
     2265                   END.
     2266                   WHEN 'pc':U OR WHEN 'ps':U OR WHEN 'pz':U OR WHEN 'dc':U THEN DO:
     2267                       v-zone = 'cli-zone':U.
     2268                   END.
     2269                   OTHERWISE DO:
     2270                       RETURN ERROR substitute("Неверный вызов процедуры резервирования: расш. тип = &1"
     2271                                            , p-ext-doc-type
     2272                                               ).
     2273                   END.
     2274           END CASE.
     2275           find first bfrom_wth-parts no-lock where
     2276                                     bfrom_wth-parts.wth-code = p-wth-code
     2277                                 and bfrom_wth-parts.obj-code = p-obj-code
     2278                                 and bfrom_wth-parts.obj-type = p-obj-type
     2279                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2280                                 and bfrom_wth-parts.par-code = p-par-code
     2281                                 and bfrom_wth-parts.ser-code = p-ser-code
     2282                                 and bfrom_wth-parts.db-num = p-db-num
     2283                                 and bfrom_wth-parts.out-code = v-zone
     2284                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2285                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2286                                 and bfrom_wth-parts.stts = 0
     2287                                 and (IF p-in-code > '':U then bfrom_wth-parts.in-code = p-in-code else true)
     2288                                 no-error.
     2289          If not available bfrom_wth-parts and p-in-code > '' then do:
     2290                  find first bfrom_wth-parts no-lock where
     2291                                     bfrom_wth-parts.wth-code = p-wth-code
     2292                                 and bfrom_wth-parts.obj-code = p-obj-code
     2293                                 and bfrom_wth-parts.obj-type = p-obj-type
     2294                                 and bfrom_wth-parts.w-p-code = p-w-p-code
     2295                                 and bfrom_wth-parts.par-code = p-par-code
     2296                                 and bfrom_wth-parts.ser-code = p-ser-code
     2297                                 and bfrom_wth-parts.db-num = p-db-num
     2298                                 and bfrom_wth-parts.out-code = v-zone
     2299                                 and bfrom_wth-parts.fact-rangeFrom <= p-fact-rangeFrom
     2300                                 and bfrom_wth-parts.fact-rangeTo >= p-fact-rangeTo
     2301                                 and bfrom_wth-parts.stts = 0
     2302                                 no-error.
     2303          end.
     2304         end.
     2305       end.
     2306       if not available bfrom_wth-parts then do:
     2307            if g#news then do:
     2308             return error 'forged':U.
     2309            end.
     2310            else
     2311             undo, return error substitute("Не найдена партия МЦ для резервирования &1Код МЦ &2&1Код номинала &3&1Код серии &4&1Диапазон с &5 по &6&1
     2312                                           ",chr(10),p-wth-code,p-par-code,p-ser-code,p-fact-rangeFrom,
     2313                                           p-fact-rangeTo).
     2314       end.
     2315       p-rec = recid(bfrom_wth-parts).
     2316       find current bfrom_wth-parts exclusive-lock.
     2317       create tt-wthlib-parts.
     2318       buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2319           ASSIGN v-beg-dt = if p-param then p-beg-dt else bfrom_wth-parts.beg-dt
     2320                  v-end-dt = if p-param then p-end-dt else bfrom_wth-parts.end-dt
     2321                  v-vat-pc = if p-param then p-vat-pc else bfrom_wth-parts.vat-pc
     2322                  v-price-rubl = if p-param then p-price-rubl else bfrom_wth-parts.price-rubl
     2323                  v-price-base = if p-param then p-price-base else bfrom_wth-parts.price-base  .
     2324       IF  not g#news and (p-ext-doc-type = 'ee':U or p-ext-doc-type = 'xc':U)  THEN DO:
     2325           IF v-beg-dt = ? AND v-end-dt = ? THEN DO:
     2326               RUN init_prtdate ( INPUT p-obj-type
     2327                                                 ,INPUT p-obj-code
     2328                                                 ,INPUT p-ser-code
     2329                                                 ,INPUT p-db-num
     2330                                                 ,INPUT bufr_wth-doc.doc-date
     2331                                                 ,OUTPUT v-beg-dt
     2332                                                 ,OUTPUT v-end-dt ) NO-ERROR.
     2333               if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2334           END.
     2335           IF v-price-rubl = 0 AND v-price-base = 0 THEN DO:
     2336             run set-wthmpl-date ( bufr_wth-doc.doc-code
     2337                                ,bufr_wth-doc.doc-date
     2338                                , v-beg-dt
     2339                                , output v-mpl-date) no-error.
     2340               RUN INIT_prtprice (
     2341                             p-host-code
     2342                           , p-obj-type
     2343                           , p-obj-code
     2344                           , p-cli-type
     2345                           , p-cli-code
     2346                           , p-wth-code
     2347                           , p-gds-code
     2348                           , p-par-code
     2349                           , v-mpl-date
     2350                           , OUTPUT  v-vat-pc
     2351                           , OUTPUT  v-price-rubl
     2352                           , OUTPUT  v-price-base
     2353                   ) NO-ERROR.
     2354             if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2355           END.
     2356       END.
     2357         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2358                     INPUT     p-obj-type,
     2359                     INPUT     p-obj-code,
     2360                     INPUT     p-w-p-code,
     2361                     INPUT     bfrom_wth-parts.wth-code,
     2362                     INPUT     bfrom_wth-parts.par-code,
     2363                     INPUT     bfrom_wth-parts.in-code ,
     2364                     INPUT     p-doc-code,
     2365                     INPUT     bfrom_wth-parts.ser-code,
     2366                     INPUT     bfrom_wth-parts.db-num  ,
     2367                     INPUT     p-Fact-RangeFrom ,
     2368                     INPUT     p-fact-rangeTo  ,
     2369                     INPUT     p-Fact-RangeFrom ,
     2370                     INPUT     p-fact-rangeTo ,
     2371                     INPUT     bfrom_wth-parts.host-code     ,
     2372                     INPUT     bfrom_wth-parts.contract-code               ,
     2373                     INPUT     v-price-rubl ,
     2374                     INPUT     v-price-base  ,
     2375                     INPUT     bfrom_wth-parts.supp-type,
     2376                     INPUT     bfrom_wth-parts.supp-code,
     2377                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2378                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2379                     INPUT     p-ext-doc-type,
     2380                     INPUT     bfrom_wth-parts.gds-code,
     2381                     INPUT     0              ,
     2382                     INPUT     v-beg-dt    ,
     2383                     INPUT     v-end-dt   ,
     2384                     INPUT     v-vat-pc    ,
     2385                     INPUT     bfrom_wth-parts.cli-code,
     2386                     INPUT     bfrom_wth-parts.cli-type,
     2387                     INPUT     bfrom_wth-parts.out-obj-code,
     2388                     INPUT     bfrom_wth-parts.out-obj-type,
     2389                     INPUT     bfrom_wth-parts.sale-obj-code,
     2390                     INPUT     bfrom_wth-parts.sale-obj-type,
     2391                     INPUT     bfrom_wth-parts.doc-code,
     2392                     INPUT     yes,
     2393                     INPUT     p-type,
     2394                     INPUT-OUTPUT p-rec
     2395                     ) no-error.
     2396       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2397       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2398       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2399                     INPUT     tt-wthlib-parts.obj-type,
     2400                     INPUT     tt-wthlib-parts.obj-code,
     2401                     INPUT     tt-wthlib-parts.w-p-code,
     2402                     INPUT     tt-wthlib-parts.wth-code,
     2403                     INPUT     tt-wthlib-parts.par-code,
     2404                     INPUT     tt-wthlib-parts.in-code ,
     2405                     INPUT     tt-wthlib-parts.out-code,
     2406                     INPUT     tt-wthlib-parts.ser-code,
     2407                     INPUT     tt-wthlib-parts.db-num  ,
     2408                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2409                     INPUT     p-fact-rangeFrom - 1  ,
     2410                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2411                     INPUT     p-fact-rangeFrom - 1,
     2412                     INPUT     tt-wthlib-parts.host-code     ,
     2413                     INPUT     tt-wthlib-parts.contract-code               ,
     2414                     INPUT     tt-wthlib-parts.price-rubl    ,
     2415                     INPUT     tt-wthlib-parts.price-base    ,
     2416                     INPUT     tt-wthlib-parts.supp-type,
     2417                     INPUT     tt-wthlib-parts.supp-code,
     2418                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2419                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2420                     INPUT     tt-wthlib-parts.ext-doc-type,
     2421                     INPUT     tt-wthlib-parts.gds-code,
     2422                     INPUT     tt-wthlib-parts.stts               ,
     2423                     INPUT     tt-wthlib-parts.beg-dt        ,
     2424                     INPUT     tt-wthlib-parts.end-dt        ,
     2425                     INPUT     tt-wthlib-parts.vat-pc        ,
     2426                     INPUT     tt-wthlib-parts.cli-code,
     2427                     INPUT     tt-wthlib-parts.cli-type,
     2428                     INPUT     tt-wthlib-parts.out-obj-code,
     2429                     INPUT     tt-wthlib-parts.out-obj-type,
     2430                     INPUT     tt-wthlib-parts.sale-obj-code,
     2431                     INPUT     tt-wthlib-parts.sale-obj-type,
     2432                     INPUT     tt-wthlib-parts.doc-code,
     2433                     INPUT  yes,
     2434                     INPUT    tt-wthlib-parts.type,
     2435                     INPUT-OUTPUT v-recDop
     2436                     ) no-error.
     2437       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2438       end.
     2439       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2440               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2441                     INPUT     tt-wthlib-parts.obj-type,
     2442                     INPUT     tt-wthlib-parts.obj-code,
     2443                     INPUT     tt-wthlib-parts.w-p-code,
     2444                     INPUT     tt-wthlib-parts.wth-code,
     2445                     INPUT     tt-wthlib-parts.par-code,
     2446                     INPUT     tt-wthlib-parts.in-code ,
     2447                     INPUT     tt-wthlib-parts.out-code,
     2448                     INPUT     tt-wthlib-parts.ser-code,
     2449                     INPUT     tt-wthlib-parts.db-num  ,
     2450                     INPUT     p-fact-rangeTo + 1 ,
     2451                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2452                     INPUT     p-fact-rangeTo + 1 ,
     2453                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2454                     INPUT     tt-wthlib-parts.host-code     ,
     2455                     INPUT     tt-wthlib-parts.contract-code               ,
     2456                     INPUT     tt-wthlib-parts.price-rubl    ,
     2457                     INPUT     tt-wthlib-parts.price-base    ,
     2458                     INPUT     tt-wthlib-parts.supp-type,
     2459                     INPUT     tt-wthlib-parts.supp-code,
     2460                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2461                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2462                     INPUT     tt-wthlib-parts.ext-doc-type,
     2463                     INPUT     tt-wthlib-parts.gds-code,
     2464                     INPUT     tt-wthlib-parts.stts               ,
     2465                     INPUT     tt-wthlib-parts.beg-dt        ,
     2466                     INPUT     tt-wthlib-parts.end-dt        ,
     2467                     INPUT     tt-wthlib-parts.vat-pc        ,
     2468                     INPUT     tt-wthlib-parts.cli-code,
     2469                     INPUT     tt-wthlib-parts.cli-type,
     2470                     INPUT     tt-wthlib-parts.out-obj-code,
     2471                     INPUT     tt-wthlib-parts.out-obj-type,
     2472                     INPUT     tt-wthlib-parts.sale-obj-code,
     2473                     INPUT     tt-wthlib-parts.sale-obj-type,
     2474                     INPUT     tt-wthlib-parts.doc-code,
     2475                     INPUT     yes,
     2476                     INPUT     tt-wthlib-parts.type,
     2477                     INPUT-OUTPUT v-recDop
     2478                     ) no-error.
     2479         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2480       end.
     2481     end.
     2482   end.
     2483   end procedure.
     2484   procedure wth-parts-inter-edit:
     2485     define input parameter        p-fact-rangeFrom   LIKE ub.wth-parts.Fact-RangeFrom no-undo .
     2486     define input parameter        p-fact-RangeTo     LIKE ub.wth-parts.Fact-RangeTo no-undo   .
     2487     define input-output parameter p-rec        as recid     no-undo .
     2488     define buffer bfrom_wth-parts   for ub.wth-parts.
     2489     define variable v-recDop as recid        no-undo.
     2490     do on error undo, return error:
     2491         find first bfrom_wth-parts exclusive-lock where
     2492                   recid(bfrom_wth-parts) = p-rec no-error.
     2493         if not available bfrom_wth-parts then return error
     2494           substitute('Не найдена партия (recid &1)', p-rec).
     2495         if p-fact-rangeFrom < bfrom_wth-parts.doc-rangeFrom or
     2496            p-fact-rangeTo > bfrom_wth-parts.doc-rangeTo then do:
     2497            return error 'Нельзя увеличивать границы диапазона.'.
     2498         end.
     2499         empty temp-table tt-wthlib-parts.
     2500         create tt-wthlib-parts.
     2501         buffer-copy bfrom_wth-parts to tt-wthlib-parts.
     2502         run str/wthpartp.p  ( INPUT     'ИЗМЕНЕНИЕ':U,
     2503                     INPUT     bfrom_wth-parts.obj-type,
     2504                     INPUT     bfrom_wth-parts.obj-code,
     2505                     INPUT     bfrom_wth-parts.w-p-code,
     2506                     INPUT     bfrom_wth-parts.wth-code,
     2507                     INPUT     bfrom_wth-parts.par-code,
     2508                     INPUT     bfrom_wth-parts.in-code ,
     2509                     INPUT     bfrom_wth-parts.doc-code,
     2510                     INPUT     bfrom_wth-parts.ser-code,
     2511                     INPUT     bfrom_wth-parts.db-num  ,
     2512                     INPUT     p-Fact-RangeFrom ,
     2513                     INPUT     p-fact-rangeTo  ,
     2514                     INPUT     p-Fact-RangeFrom ,
     2515                     INPUT     p-fact-rangeTo ,
     2516                     INPUT     bfrom_wth-parts.host-code     ,
     2517                     INPUT     bfrom_wth-parts.contract-code               ,
     2518                     INPUT     bfrom_wth-parts.price-rubl  ,
     2519                     INPUT     bfrom_wth-parts.price-base    ,
     2520                     INPUT     bfrom_wth-parts.supp-type,
     2521                     INPUT     bfrom_wth-parts.supp-code,
     2522                     INPUT     bfrom_wth-parts.in-obj-type      ,
     2523                     INPUT     bfrom_wth-parts.in-obj-code      ,
     2524                     INPUT     bfrom_wth-parts.ext-doc-type,
     2525                     INPUT     bfrom_wth-parts.gds-code,
     2526                     INPUT     0              ,
     2527                     INPUT     bfrom_wth-parts.beg-dt      ,
     2528                     INPUT     bfrom_wth-parts.end-dt      ,
     2529                     INPUT     bfrom_wth-parts.vat-pc      ,
     2530                     INPUT     bfrom_wth-parts.cli-code,
     2531                     INPUT     bfrom_wth-parts.cli-type,
     2532                     INPUT     bfrom_wth-parts.out-obj-code,
     2533                     INPUT     bfrom_wth-parts.out-obj-type,
     2534                     INPUT     bfrom_wth-parts.sale-obj-code,
     2535                     INPUT     bfrom_wth-parts.sale-obj-type,
     2536                     INPUT     bfrom_wth-parts.doc-code,
     2537                     INPUT     yes,
     2538                     INPUT     bfrom_wth-parts.type,
     2539                     INPUT-OUTPUT p-rec
     2540                     ) no-error.
     2541       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2542       if tt-wthlib-parts.fact-rangeFrom <> p-fact-rangeFrom then do:
     2543       run str/wthpartp.p ( INPUT     'ДОБАВЛЕНИЕ':U,
     2544                     INPUT     tt-wthlib-parts.obj-type,
     2545                     INPUT     tt-wthlib-parts.obj-code,
     2546                     INPUT     tt-wthlib-parts.w-p-code,
     2547                     INPUT     tt-wthlib-parts.wth-code,
     2548                     INPUT     tt-wthlib-parts.par-code,
     2549                     INPUT     tt-wthlib-parts.in-code ,
     2550                     INPUT     tt-wthlib-parts.out-code,
     2551                     INPUT     tt-wthlib-parts.ser-code,
     2552                     INPUT     tt-wthlib-parts.db-num  ,
     2553                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2554                     INPUT     p-fact-rangeFrom - 1  ,
     2555                     INPUT     tt-wthlib-parts.Fact-RangeFrom ,
     2556                     INPUT     p-fact-rangeFrom - 1,
     2557                     INPUT     tt-wthlib-parts.host-code     ,
     2558                     INPUT     tt-wthlib-parts.contract-code               ,
     2559                     INPUT     tt-wthlib-parts.price-rubl    ,
     2560                     INPUT     tt-wthlib-parts.price-base    ,
     2561                     INPUT     tt-wthlib-parts.supp-type,
     2562                     INPUT     tt-wthlib-parts.supp-code,
     2563                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2564                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2565                     INPUT     tt-wthlib-parts.ext-doc-type,
     2566                     INPUT     tt-wthlib-parts.gds-code,
     2567                     INPUT     1             ,
     2568                     INPUT     tt-wthlib-parts.beg-dt        ,
     2569                     INPUT     tt-wthlib-parts.end-dt        ,
     2570                     INPUT     tt-wthlib-parts.vat-pc        ,
     2571                     INPUT     tt-wthlib-parts.cli-code,
     2572                     INPUT     tt-wthlib-parts.cli-type,
     2573                     INPUT     tt-wthlib-parts.out-obj-code,
     2574                     INPUT     tt-wthlib-parts.out-obj-type,
     2575                     INPUT     tt-wthlib-parts.sale-obj-code,
     2576                     INPUT     tt-wthlib-parts.sale-obj-type,
     2577                     INPUT     tt-wthlib-parts.doc-code,
     2578                     INPUT  yes,
     2579                     INPUT    tt-wthlib-parts.type,
     2580                     INPUT-OUTPUT v-recDop
     2581                     ) no-error.
     2582       if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2583       end.
     2584       if tt-wthlib-parts.fact-rangeTo <> p-fact-rangeTo then do:
     2585               run str/wthpartp.p    ( INPUT 'ДОБАВЛЕНИЕ':U,
     2586                     INPUT     tt-wthlib-parts.obj-type,
     2587                     INPUT     tt-wthlib-parts.obj-code,
     2588                     INPUT     tt-wthlib-parts.w-p-code,
     2589                     INPUT     tt-wthlib-parts.wth-code,
     2590                     INPUT     tt-wthlib-parts.par-code,
     2591                     INPUT     tt-wthlib-parts.in-code ,
     2592                     INPUT     tt-wthlib-parts.out-code,
     2593                     INPUT     tt-wthlib-parts.ser-code,
     2594                     INPUT     tt-wthlib-parts.db-num  ,
     2595                     INPUT     p-fact-rangeTo + 1 ,
     2596                     INPUT     tt-wthlib-parts.fact-rangeTo  ,
     2597                     INPUT     p-fact-rangeTo + 1 ,
     2598                     INPUT     tt-wthlib-parts.fact-rangeTo,
     2599                     INPUT     tt-wthlib-parts.host-code     ,
     2600                     INPUT     tt-wthlib-parts.contract-code               ,
     2601                     INPUT     tt-wthlib-parts.price-rubl    ,
     2602                     INPUT     tt-wthlib-parts.price-base    ,
     2603                     INPUT     tt-wthlib-parts.supp-type,
     2604                     INPUT     tt-wthlib-parts.supp-code,
     2605                     INPUT     tt-wthlib-parts.in-obj-type      ,
     2606                     INPUT     tt-wthlib-parts.in-obj-code      ,
     2607                     INPUT     tt-wthlib-parts.ext-doc-type,
     2608                     INPUT     tt-wthlib-parts.gds-code,
     2609                     INPUT     1             ,
     2610                     INPUT     tt-wthlib-parts.beg-dt        ,
     2611                     INPUT     tt-wthlib-parts.end-dt        ,
     2612                     INPUT     tt-wthlib-parts.vat-pc        ,
     2613                     INPUT     tt-wthlib-parts.cli-code,
     2614                     INPUT     tt-wthlib-parts.cli-type,
     2615                     INPUT     tt-wthlib-parts.out-obj-code,
     2616                     INPUT     tt-wthlib-parts.out-obj-type,
     2617                     INPUT     tt-wthlib-parts.sale-obj-code,
     2618                     INPUT     tt-wthlib-parts.sale-obj-type,
     2619                     INPUT     tt-wthlib-parts.doc-code,
     2620                     INPUT     yes,
     2621                     INPUT     tt-wthlib-parts.type,
     2622                     INPUT-OUTPUT v-recDop
     2623                     ) no-error.
     2624         if error-status:error then undo, return error return-value + error-status:get-message(1) .
     2625         end.
     2626     end.
     2627   end procedure.
     2628   PROCEDURE INIT_prtdate:
     2629       define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2630       define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2631       define input parameter        p-ser-code         LIKE ub.wth-parts.ser-code no-undo.
     2632       define input parameter        p-db-num           LIKE ub.wth-parts.db-num no-undo .
     2633       define input parameter        p-date                AS DATE no-undo .
     2634       DEFINE OUTPUT PARAMETER p-beg-dt AS DATE NO-UNDO.
     2635       DEFINE OUTPUT PARAMETER p-end-dt AS DATE NO-UNDO.
     2636       DEFINE BUFFER buf_wth-ser FOR ub.wth-ser.
     2637       DEFINE VARIABLE v-rangeRule AS INT NO-UNDO.
     2638       define variable v-value-character as character no-undo .
     2639       define variable v-value-date as date no-undo .
     2640       define variable v-value-decimal as decimal no-undo .
     2641       define variable v-value-integer as INTEGER no-undo .
     2642       define variable v-value-logical AS LOGICAL no-undo .
     2643       define variable v-param-type as character no-undo .
     2644       FIND FIRST buf_wth-ser NO-LOCK
     2645           WHERE buf_wth-ser.ser-code = p-ser-code
     2646           AND buf_wth-ser.db-num = p-db-num.
     2647       IF buf_wth-ser.chk-bdt = 2 THEN DO:
     2648           p-beg-dt = buf_wth-ser.beg-dt.
     2649       END.
     2650       IF buf_wth-ser.chk-edt = 2 THEN DO:
     2651           p-end-dt = buf_wth-ser.end-dt.
     2652       END.
     2653       IF buf_wth-ser.chk-bdt = 0 AND buf_wth-ser.chk-edt = 0 THEN DO:
     2654           run adm/shattri.p (
     2655               input "get":U
     2656               ,input  p-obj-type
     2657               ,input  p-obj-code
     2658               ,input  'wthdoc_obj':U
     2659               ,input  'rangerule':U
     2660               ,output v-value-character
     2661               ,output v-value-date
     2662               ,output v-value-decimal
     2663               ,output v-value-integer
     2664               ,output v-value-logical
     2665               ,output v-param-type
     2666               ,INPUT-OUTPUT table-handle v-tth
     2667               ) no-error .
     2668           IF not error-status:error  then do:
     2669               v-rangeRule =  v-value-integer.
     2670           END.
     2671           CASE v-rangeRule:
     2672           WHEN 1 THEN DO:
     2673               IF MONTH(p-date) < 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date)))
     2674                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 2,YEAR(p-date))) - 1.
     2675               ELSE IF MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('01/12/&1',YEAR(p-date)))
     2676                                                 p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date) + 1)).
     2677               ELSE IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('01/01/&1',YEAR(p-date) + 1))
     2678                                                 p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2679           END.
     2680           when 2 then do:
     2681             IF MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2682                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2683             else ASSIGN p-beg-dt = DATE(substitute('&3/&1/&2',MONTH(p-date),YEAR(p-date),day(p-date)))
     2684                         p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 1,YEAR(p-date))) - 1
     2685                        .
     2686           end.
     2687           WHEN 3 THEN DO:
     2688               IF MONTH(p-date) < 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/&2/&3',day(p-date),MONTH(p-date),YEAR(p-date)))
     2689                                                 p-end-dt = DATE(substitute('01/&1/&2',MONTH(p-date) + 3,YEAR(p-date))) - 1.
     2690               else if MONTH(p-date) = 10 THEN ASSIGN p-beg-dt = DATE(substitute('&1/10/&2',day(p-date),YEAR(p-date)))
     2691                                               p-end-dt = DATE(substitute('31/12/&1',YEAR(p-date))).
     2692               else if MONTH(p-date) = 11 THEN ASSIGN p-beg-dt = DATE(substitute('&1/11/&2',day(p-date),YEAR(p-date)))
     2693                                               p-end-dt = DATE(substitute('31/01/&1',YEAR(p-date) + 1)).
     2694               else if MONTH(p-date) = 12 THEN ASSIGN p-beg-dt = DATE(substitute('&1/12/&2',day(p-date),YEAR(p-date)))
     2695                                               p-end-dt = DATE(substitute('01/03/&1',YEAR(p-date) + 1)) - 1.
     2696           END.
     2697           when 4 then do:
     2698                p-beg-dt = p-date.
     2699                p-end-dt = date(substitute('31/12/&1',YEAR(p-date))).
     2700           end.
     2701           END CASE.
     2702       END.
     2703   END.
     2704   PROCEDURE INIT_prtprice:
     2705   define input parameter        p-host-code        LIKE ub.wth-parts.obj-type no-undo .
     2706   define input parameter        p-obj-type         LIKE ub.wth-parts.obj-type no-undo .
     2707   define input parameter        p-obj-code         LIKE ub.wth-parts.obj-code no-undo .
     2708   define input parameter        p-cli-type         LIKE ub.wth-parts.cli-type no-undo .
     2709   define input parameter        p-cli-code         LIKE ub.wth-parts.cli-code no-undo .
     2710   define input parameter        p-wth-code         LIKE ub.wth-parts.ser-code no-undo.
     2711   define input parameter        p-gds-code         LIKE ub.wth-parts.gds-code no-undo .
     2712   define input parameter        p-par-code         LIKE ub.wth-parts.par-code no-undo .
     2713   define input parameter        p-date                AS DATE no-undo .
     2714   DEFINE OUTPUT PARAMETER p-vat-pc LIKE ub.wth-parts.vat-pc NO-UNDO.
     2715   DEFINE OUTPUT PARAMETER p-price-rubl LIKE ub.wth-parts.price-rubl NO-UNDO.
     2716   DEFINE OUTPUT PARAMETER p-price-base LIKE ub.wth-parts.price-base NO-UNDO.
     2717   DEFINE BUFFER b-cash-pay FOR ub.cash-pay.
     2718   DEFINE BUFFER b-wth-par FOR ub.wth-par.
     2719   DEF VAR v-cash-type-pay AS CHAR no-undo.
     2720   define variable p-plt-id AS INT no-undo.
     2721   define variable  p-plt-db-num   AS INT no-undo.
     2722   define variable  p-pdf-id  AS INT no-undo.
     2723   define variable  p-pdf-db-num AS INT no-undo.
     2724   define variable  p-sale-price-base AS DEC no-undo.
     2725   define variable  p-sale-price-rubl AS DEC no-undo.
     2726   define variable  p-road-tax-base AS DEC no-undo.
     2727   define variable  p-road-tax-rubl AS DEC no-undo.
     2728   define variable  p-excise-base AS DEC no-undo.
     2729   define variable  p-excise-rubl AS DEC no-undo.
     2730   define variable  p-fact-order  AS DEC no-undo.
     2731   do on error undo, return error return-value :
     2732     FIND FIRST b-wth-par NO-LOCK WHERE b-wth-par.par-code = p-par-code
     2733                                     AND b-wth-par.wth-code = p-wth-code NO-ERROR.
     2734     IF NOT AVAILABLE b-wth-par THEN RETURN ERROR SUBSTITUTE("Не наден номинал с кодом &1",p-par-code).
     2735     FIND FIRST b-cash-pay WHERE b-cash-pay.wth-code = p-wth-code NO-LOCK NO-ERROR.
     2736     IF AVAILABLE b-cash-pay THEN v-cash-type-pay = STRING(recid(b-cash-pay)).
     2737     ELSE v-cash-type-pay = ?.
     2738     run fact-order-mpl (
     2739         INPUT p-date ,
     2740         INPUT p-obj-type ,
     2741         INPUT p-obj-code ,
     2742         OUTPUT p-fact-order
     2743         ) no-error .
     2744     if error-status:error then do:
     2745       message   return-value skip error-status:get-message(1)
     2746       skip  'Получение цены из множественного прайс-листа отклонено.'
     2747       view-as alert-box.
     2748       return.
     2749     end.
     2750   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2751   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2752     (input  p-gds-code
     2753     ,input  '1':U
     2754     ,input  ?
     2755     ,input  p-host-code
     2756     ,input  p-obj-type
     2757     ,input  p-obj-code
     2758     ,output p-vat-pc
     2759     ) no-error .
     2760     run mpl-autoprice in this-procedure
     2761       ( input    false
     2762         ,input   p-cli-type
     2763         ,input   p-cli-code
     2764         ,input   p-gds-code
     2765         ,input   p-gds-code
     2766         ,input   p-obj-type
     2767         ,input   p-obj-code
     2768         ,input   0
     2769         ,input   0
     2770         ,input   ""
     2771         ,input   v-cash-type-pay
     2772         ,input   p-fact-order
     2773         ,output  p-plt-id
     2774         ,output  p-plt-db-num
     2775         ,output  p-pdf-id
     2776         ,output  p-pdf-db-num
     2777         ,output  p-sale-price-base
     2778         ,output  p-sale-price-rubl
     2779         ,output  p-road-tax-base
     2780         ,output  p-road-tax-rubl
     2781         ,output  p-excise-base
     2782         ,output  p-excise-rubl
     2783         ) no-error .
     2784     if error-status:error then do:
     2785       message   return-value skip error-status:get-message(1) view-as alert-box.
     2786       return.
     2787     end.
     2788     p-price-rubl = p-sale-price-rubl * b-wth-par.par-val.
     2789     p-price-base = p-sale-price-base * b-wth-par.par-val.
     2790   end.
     2791   END.
     2792   procedure  set-wthmpl-date:
     2793   define input parameter p-doc-code like ub.wth-doc.doc-code no-undo.
     2794   define input parameter p-doc-date like ub.wth-doc.doc-date no-undo.
     2795   define input parameter p-beg-dt   like ub.wth-parts.beg-dt no-undo.
     2796   define output parameter p-date    like ub.wth-doc.doc-date no-undo.
     2797   define variable v-atrValue      as character no-undo .
     2798   define variable v-atrDsf      as CHARACTER no-undo .
     2799   define variable v-atrType     as character no-undo .
     2800   do on error undo, return error return-value :
     2801   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     2802                           input 'wthdsf':U ,
     2803                          output v-atrValue ,
     2804                          output v-atrType )  .
     2805     p-date = date(v-atrValue) no-error.
     2806     if p-date = ? then p-date = p-beg-dt no-error.
     2807     if p-date = ? then p-date = p-doc-date.
     2808   end.
     2809   end procedure.
     2810   define variable rid AS RECID NO-UNDO.
     2811   define variable v-mess as character no-undo .
     2812   DEF BUFFER buf-doc  FOR ub.wth-doc.
     2813   define buffer buf_wth-parts   for ub.wth-parts.
     2814   main-block:
     2815   do
     2816   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2817   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2818   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2819   :
     2820   for each buf_wth-parts no-lock where
     2821                              buf_wth-parts.w-p-code = ub.wth-dtl.w-p-code
     2822                              and buf_wth-parts.wth-code = ub.wth-dtl.wth-code
     2823                              and buf_wth-parts.par-code = ub.wth-dtl.par-code
     2824                              and buf_wth-parts.out-code = ub.wth-dtl.doc-code
     2825       on error undo, return error return-value:
     2826       run wth-doc-razrez in this-procedure
     2827             ( input recid(buf_wth-parts) ,
     2828               input true
     2829               ).
     2830   end.
     2831       if g#oxml = yes
     2832       then do:
     2833       run str/calloxml.p (
     2834             input 'delete':U
     2835           , input 'wth-dtl':U
     2836           , input ( buffer ub.wth-dtl:handle )
     2837       ) no-error.
     2838       if error-status :error
     2839       then do:
     2840           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
     2841                                , chr(10)
     2842                                , vss-workfile
     2843                                , return-value
     2844                                , error-status :get-message ( 1 ) ).
     2845       end.
     2846       end.
     2847   END.
