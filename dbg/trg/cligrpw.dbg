        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.cli-grp OLD oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись группы клиентов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3',ub.cli-grp.node-code,ub.cli-grp.upper-code,ub.cli-grp.node-name)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cli-grplib-get-full-name :
       83      define input parameter  p-node-code  as integer      no-undo.
       84      define output parameter p-full-name as character    no-undo.
       85   do
       86   on error undo, return error
       87   :
       88       define variable v-upper-code    as integer           no-undo.
       89       define buffer buf_cli-grp       for ub.cli-grp.
       90       define buffer buf_upper_cli-grp for ub.cli-grp.
       91       find first buf_cli-grp no-lock
       92            where buf_cli-grp.node-code = p-node-code
       93       no-error.
       94       if not available buf_cli-grp
       95       then do:
       96           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
       97       end.
       98       assign
       99           p-full-name  = ""
      100           v-upper-code = 1
      101       .
      102       do while buf_cli-grp.upper-code <> 0
      103       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      104       :
      105           assign
      106               p-full-name  = buf_cli-grp.node-name
      107                            + (if p-full-name <> "" then chr(47) else "")
      108                            + p-full-name
      109               v-upper-code = buf_cli-grp.upper-code
      110           .
      111           find first buf_cli-grp no-lock
      112                where buf_cli-grp.node-code = v-upper-code
      113           no-error.
      114           if not available buf_cli-grp
      115           then do:
      116               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      117                                   + string( v-upper-code )
      118                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      119           end.
      120       end.
      121       assign
      122       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      123       .
      124   end.
      125   end .
      126   procedure cgrplib-get-node-from-full-name :
      127   define input parameter p-full-name as character no-undo .
      128   define output parameter p-node-code as integer no-undo .
      129   define variable v-ii as integer no-undo .
      130   define variable v-upper-code as integer no-undo .
      131   define variable v-root-code as integer no-undo .
      132   define variable v-entry as character no-undo .
      133   define buffer buf_cli-grp       for ub.cli-grp.
      134   do
      135   on error undo, return error
      136   :
      137     find first buf_cli-grp no-lock
      138         where buf_cli-grp.upper-code = 0
      139     no-error .
      140     if not available buf_cli-grp
      141     then do:
      142         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      143     end.
      144     else do:
      145       assign
      146       v-root-code = buf_cli-grp.node-code
      147       .
      148     end.
      149     v-upper-code = v-root-code.
      150     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      151       assign
      152       v-entry = entry(v-ii, p-full-name, chr(47)).
      153       if v-entry = '' then leave.
      154       find first buf_cli-grp no-lock where
      155                 buf_cli-grp.node-name = v-entry
      156             and buf_cli-grp.upper-code = v-upper-code
      157             no-error.
      158       if not available buf_cli-grp then do:
      159         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      160       end.
      161       else do:
      162         p-node-code = buf_cli-grp.node-code.
      163         v-upper-code = buf_cli-grp.node-code.
      164       end.
      165     end.
      166   end.
      167   end .
      168   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170   define new global shared variable g#lib-nws as handle no-undo .
      171   procedure clientsh_write-clients-proc  :
      172   define parameter buffer buf_clients for ub.clients .
      173   define input parameter p-source-type like ub.c-cli-hist.source-type no-undo .
      174   define input parameter p-source-ref  like ub.c-cli-hist.source-ref no-undo .
      175   define variable v-date as date      no-undo.
      176   define variable v-time  as integer   no-undo.
      177   define buffer buf_c-cli-hist for ub.c-cli-hist.
      178   define buffer buf_c-clients for ub.c-clients.
      179     do
      180     on error undo, return error
      181     :
      182       if not available buf_clients then do:
      183         message
      184           vss-workfile vss-revision vss-description skip
      185           "Ошибка задания входных параметров" skip
      186           "Не определен контрагент" skip
      187           view-as alert-box error .
      188         undo, return error .
      189       end.
      190       if g#news then do:
      191         define variable v-send as integer no-undo .
      192         define variable v-subject as character no-undo .
      193         case buf_clients.obj-type:
      194           when 'орг':U then v-subject =  'firm':U.
      195           when 'чел':U then v-subject =  'person':U.
      196           when 'маг':U then v-subject =  'shop':U.
      197           when 'скл':U then v-subject =  'store':U.
      198         end case.
      199         v-send = integer('0':U).
      200   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      202     (input  g#db-num
      203     ,input  v-subject
      204     ,input  0
      205     ,input  '':U
      206     ,input  0
      207     ,input  '':U
      208     ,input  '':U
      209     ,input  '':U
      210     ,input  0
      211     ,input  0
      212     ,input  0
      213     ,input  'nws-to-hist'
      214     ,output v-send
      215     ) no-error .
      216         if v-send < 0 then return.
      217       end.
      218       run cur-time in this-procedure(output v-date, output v-time).
      219       create buf_c-clients.
      220       buffer-copy buf_clients to buf_c-clients
      221       assign
      222       buf_c-clients.obj-code           = buf_clients.obj-code
      223       buf_c-clients.obj-type           = buf_clients.obj-type
      224       buf_c-clients.chip-num           = next-value (s-cli-chip, ub)
      225       buf_c-clients.corr-time          = v-time
      226       buf_c-clients.corr-user-db-num   = g#db-num
      227       buf_c-clients.corr-user-name     = (if g#news
      228                                           then (chr(4) +  'СПН':U)
      229                                           else (if g#esys
      230                                                 then (chr(4) +  'ВС':U)
      231                                                 else g#userid)
      232                                           )
      233       buf_c-clients.corr-date          = v-date
      234       .
      235       create buf_c-cli-hist.
      236       buffer-copy buf_c-clients to buf_c-cli-hist
      237       assign
      238       buf_c-cli-hist.action =  integer('2':U)
      239       buf_c-cli-hist.subject = 'clients':U
      240       buf_c-cli-hist.host-code = (if buf_clients.obj-type = 'орг':U
      241                                   and
      242                                   can-find(first ub.sysconf no-lock where
      243                                                     ub.sysconf.host-code = buf_clients.obj-code)
      244                                   then buf_clients.obj-code
      245                                   else 0)
      246       buf_c-cli-hist.is-news = g#news
      247       buf_c-cli-hist.source-type = p-source-type
      248       buf_c-cli-hist.source-ref = p-source-ref
      249       .
      250     end.
      251   end procedure.
      252   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      253   procedure cur-time :
      254      define output parameter p-today as date      no-undo .
      255      define output parameter p-time  as integer   no-undo .
      256     do
      257     on error undo, return error
      258     :
      259       define variable v-date1 as date      no-undo .
      260       define variable v-date2 as date      no-undo .
      261       define variable v-time  as integer   no-undo .
      262       assign
      263         v-date1 = today
      264         v-time  = time
      265         v-date2 = today
      266       .
      267       if v-date1 <> v-date2
      268       then do:
      269         assign
      270           v-date1 = today
      271           v-time  = v-time
      272         .
      273       end.
      274       assign
      275         p-today = v-date1
      276         p-time  = v-time
      277       .
      278     end.
      279   end.
      280   function cur-time-date returns character
      281   :
      282     return string(today, '99/99/9999':U) .
      283   end.
      284   function cur-time-mjd returns decimal
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return integer(v-date) - 2400002 + (v-time / 86400) .
      293   end.
      294   function cur-time-get-ending-index returns integer
      295   (input p-number as integer
      296   )
      297   :
      298     if p-number < 0
      299     or p-number = ?
      300     then do:
      301       return 1 .
      302     end.
      303     define variable v-rest as integer   no-undo .
      304     assign
      305       p-number = p-number modulo 100
      306     .
      307     if p-number < 20
      308     then do:
      309       assign
      310         v-rest = p-number
      311       .
      312     end.
      313     else do:
      314       assign
      315         v-rest = p-number modulo 10
      316       .
      317     end.
      318     case v-rest :
      319       when 1
      320       then do:
      321         return 2 .
      322       end.
      323       when 2 or
      324       when 3 or
      325       when 4
      326       then do:
      327         return 3 .
      328       end.
      329       otherwise do:
      330         return 1 .
      331       end.
      332     end case .
      333   end.
      334   procedure cur-time-mjd-to-date :
      335      define input  parameter i-mjd-diff as decimal no-undo.
      336      define output parameter o-Date     as date    no-undo.
      337      define output parameter o-Time     as integer no-undo.
      338      define variable v-day-number as integer   no-undo .
      339      if    i-mjd-diff < 0
      340         or i-mjd-diff = ?
      341      then do:
      342         return "?" .
      343      end.
      344      assign
      345         v-day-number = truncate(i-mjd-diff,0).
      346         o-Date = date(v-day-number + 2400002).
      347         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      348     .
      349   end.
      350   function cur-time-mjd-to-string returns character
      351   (input p-mjd-diff as decimal
      352   )
      353   :
      354     define variable v-day-number as integer   no-undo .
      355     define variable v-seconds    as integer   no-undo .
      356     define variable v-hour       as integer   no-undo .
      357     define variable v-min        as integer   no-undo .
      358     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      359     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      360     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      361     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      362     if p-mjd-diff < 0
      363     or p-mjd-diff = ?
      364     then do:
      365       return "?" .
      366     end.
      367     assign
      368       v-day-number = integer(truncate(p-mjd-diff,0))
      369       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      370     .
      371     if v-seconds > 86400
      372     then do:
      373       assign
      374         v-seconds = 86400 - 1
      375       .
      376     end.
      377     if v-seconds < 0
      378     then do:
      379       assign
      380         v-seconds = 0
      381       .
      382     end.
      383     assign
      384       v-hour = truncate(v-seconds / 3600, 0)
      385     .
      386     assign
      387       v-seconds = v-seconds modulo 3600
      388     .
      389     assign
      390       v-min = truncate(v-seconds / 60, 0)
      391     .
      392     assign
      393       v-seconds = v-seconds modulo 60
      394     .
      395     return
      396         (if v-day-number <> 0
      397           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      398           else ""
      399         )
      400       + (if v-day-number <> 0 or v-hour <> 0
      401           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      402           else ""
      403         )
      404       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      405           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      406           else ""
      407         )
      408       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      409       .
      410   end.
      411   function cur-time-string returns character
      412   :
      413     define variable v-date as date      no-undo .
      414     define variable v-time as integer   no-undo .
      415     run cur-time in this-procedure
      416       (output v-date
      417       ,output v-time
      418       ) .
      419     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      420   end.
      421   function cur-time-string-sec returns character
      422   :
      423     define variable v-date as date      no-undo .
      424     define variable v-time as integer   no-undo .
      425     run cur-time in this-procedure
      426       (output v-date
      427       ,output v-time
      428       ) .
      429     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      430   end.
      431   function cur-time-custom  returns character
      432   (input p-prefix as character
      433   ,input p-date-format as character
      434   ,input p-delimiter as character
      435   ,input p-time-format as character
      436   ,input p-suffix as character
      437   )
      438   :
      439     define variable v-date as date      no-undo .
      440     define variable v-time as integer   no-undo .
      441     run cur-time in this-procedure
      442       (output v-date
      443       ,output v-time
      444       ) .
      445     return
      446       p-prefix
      447       + string(v-date, p-date-format)
      448       + p-delimiter
      449       + string(v-time, p-time-format)
      450       + p-suffix
      451       .
      452   end.
      453   function cur-time-print  returns character
      454   :
      455     define variable v-date as date      no-undo .
      456     define variable v-time as integer   no-undo .
      457     run cur-time in this-procedure
      458       (output v-date
      459       ,output v-time
      460       ) .
      461     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      462   end.
      463   function cur-time-datetime returns datetime
      464   :
      465     define variable v-char as character no-undo .
      466     define variable v-datetime as datetime no-undo .
      467     v-char = cur-time-string().
      468     v-datetime = datetime(v-char).
      469     return  v-datetime.
      470   end.
      471   function cur-time-string-msec returns character
      472   :
      473     define variable v-date as datetime  no-undo .
      474     v-date = now.
      475     return string(v-date) .
      476   end.
      477   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      478   procedure cli-grph_write-cli-grp-trigger :
      479   define input parameter p-new-record as logical no-undo .
      480   define input parameter p-source-type as character no-undo .
      481   define input parameter p-source-ref  as character no-undo .
      482   define input parameter p-action as integer no-undo .
      483   define variable v-date as date      no-undo.
      484   define variable v-time  as integer   no-undo.
      485   define buffer buf_c-cli-grp for ub.c-cli-grp.
      486     do
      487     on error undo, return error
      488     :
      489       run cur-time in this-procedure(output v-date, output v-time).
      490       create buf_c-cli-grp.
      491       buffer-copy oldb to buf_c-cli-grp
      492       assign
      493       buf_c-cli-grp.node-code           = (if p-new-record then ub.cli-grp.node-code else oldb.node-code)
      494       buf_c-cli-grp.chip-num           = next-value (s-cli-grp-chip, ub)
      495       buf_c-cli-grp.corr-time          = v-time
      496       buf_c-cli-grp.corr-user-db-num   = g#db-num
      497       buf_c-cli-grp.corr-user-name     = (if g#news
      498                                           then (chr(4) +  'СПН':U)
      499                                           else (if g#esys
      500                                                 then (chr(4) +  'ВС':U)
      501                                                 else
      502                                                g#userid)
      503                                           )
      504       buf_c-cli-grp.corr-date          = v-date
      505       buf_c-cli-grp.is-del             = (p-action = integer('99':U))
      506       buf_c-cli-grp.action             =  p-action
      507       buf_c-cli-grp.subject            = 'cli-grp':U
      508       .
      509     end.
      510   end procedure.
      511   define buffer b-cli-grp for ub.cli-grp.
      512   define buffer other_cli-grp for ub.cli-grp.
      513   define variable name as char no-undo.
      514   define variable uc as int no-undo.
      515   define variable skip-proc as log no-undo.
      516   define variable v-changed-node-code like ub.cli-grp.node-code no-undo .
      517   define variable v-changed-node-code-2 like ub.cli-grp.node-code no-undo .
      518   define variable v-date as date no-undo .
      519   define variable v-time as integer no-undo .
      520   define variable v-only-is-term as logical no-undo .
      521   define variable v-chr as character no-undo .
      522   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      523   define buffer buf2_dis-grp-rule for ub.dis-grp-rule.
      524   define buffer buf_clients for ub.clients.
      525   main-block:
      526   do
      527   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      528   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      529   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      530   :
      531     if not g#news and ( g#db-num > 0 ) then do:
      532       message
      533       vss-workfile vss-revision vss-description skip
      534       "Нельзя изменять запись ГРУППЫ КЛИЕНТОВ в УБД" skip
      535       "Номер текущей БД" g#db-num
      536       view-as alert-box error .
      537       undo main-block, return error .
      538     end.
      539     on write of ub.clients override do: end.
      540     on write of ub.cli-grp override do: end.
      541     on write of ub.c-clients override do: end.
      542     on write of ub.c-cli-hist override do: end.
      543     run cli-grplib-get-full-name in this-procedure
      544       (input ub.cli-grp.node-code
      545       ,output name
      546       ).
      547     if oldb.node-code <> ub.cli-grp.node-code
      548     then do:
      549       find b-cli-grp
      550         where b-cli-grp.node-code = ub.cli-grp.upper-code
      551         .
      552       assign
      553         cli-grp.lvl-num = b-cli-grp.lvl-num + 1
      554          b-cli-grp.is-term = no
      555       .
      556     assign
      557     v-changed-node-code = ub.cli-grp.node-code
      558     .
      559       for each buf_clients
      560         where buf_clients.grp-code = b-cli-grp.node-code
      561       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      562       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      563       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      564       :
      565         run clientsh_write-clients-proc  in this-procedure (
      566                                                              buffer buf_clients
      567                                                             ,input 'grp-chg':U
      568                                                             ,input string(ub.cli-grp.node-code)
      569                                                             ).
      570         assign
      571         buf_clients.grp-code = ub.cli-grp.node-code
      572         .
      573       end.
      574       for each buf_dis-grp-rule share-lock where
      575               buf_dis-grp-rule.classif-type = 'cli-grp':U
      576           and buf_dis-grp-rule.node-code = b-cli-grp.node-code
      577           and buf_dis-grp-rule.host-code = 0
      578           and buf_dis-grp-rule.obj-type = '':U
      579           and buf_dis-grp-rule.obj-code = 0
      580       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      581       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      582       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      583       :
      584          create buf2_dis-grp-rule.
      585          buffer-copy buf_dis-grp-rule except node-code to buf2_dis-grp-rule
      586          assign
      587          buf2_dis-grp-rule.node-code = ub.cli-grp.node-code
      588          .
      589          delete buf_dis-grp-rule.
      590       end.
      591     end.
      592     else if ub.cli-grp.upper-code <> oldb.upper-code then do:
      593         find b-cli-grp  where
      594           b-cli-grp.node-code = ub.cli-grp.upper-code no-wait no-error.
      595       if not available b-cli-grp then do:
      596          undo main-block, return error substitute("cli-grp with node-code &1 is locked", ub.cli-grp.upper-code).
      597       end.
      598       assign
      599       b-cli-grp.is-term = no
      600       ub.cli-grp.lvl-num = b-cli-grp.lvl-num + 1
      601       .
      602       find first b-cli-grp where
      603                b-cli-grp.node-code = oldb.upper-code no-wait no-error.
      604       if locked(b-cli-grp) then do:
      605         undo main-block, return error substitute("cli-grp with node-code &1 is locked", oldb.upper-code) .
      606       end.
      607       else do:
      608         if available b-cli-grp then do:
      609           if not can-find(first other_cli-grp no-lock where
      610                                 other_cli-grp.upper-code = oldb.upper-code
      611                             AND recid(other_cli-grp) <> recid(ub.cli-grp)) then do:
      612             assign
      613             b-cli-grp.is-term = yes
      614             .
      615           end.
      616         end.
      617       end.
      618     end.
      619     buffer-compare oldb to ub.cli-grp
      620     case-sensitive
      621     save result in v-chr.
      622     if v-chr = "is-term":U then do:
      623       assign
      624       v-only-is-term = yes
      625       .
      626     end.
      627     assign
      628       ub.cli-grp.is-term = yes
      629     .
      630     assign
      631     v-changed-node-code-2 = ub.cli-grp.node-code
      632     .
      633     run grp-tree in this-procedure
      634       (input ub.cli-grp.node-code
      635       ,input name
      636       ) no-error.
      637     if error-status:error then do:
      638       message
      639         vss-workfile vss-revision vss-description skip
      640         "Ошибка при вызове процедуры grp-tree" skip
      641         error-status :get-message(1) skip
      642         return-value skip
      643         view-as alert-box error .
      644       undo main-block, return error.
      645     end.
      646     define variable v-synch-cli-grp as integer   no-undo .
      647     assign
      648       v-synch-cli-grp = next-value (synch-cli-grp, ub)
      649     .
      650     run str/callnews.p
      651       (input 'cli-grp':U
      652       ,input (buffer ub.cli-grp:handle)
      653       ) no-error .
      654     if error-status :error then do:
      655       message
      656         error-status :get-message(1) skip
      657         return-value skip
      658         view-as alert-box.
      659       undo main-block, return error.
      660     end.
      661     if not g#news then do:
      662       define variable v-l as logical no-undo .
      663       buffer-compare oldb to ub.cli-grp
      664       case-sensitive
      665       save result in v-l.
      666       if not v-l then
      667       run cli-grph_write-cli-grp-trigger in this-procedure (
      668                                                               new(ub.cli-grp)
      669                                                              ,"":U
      670                                                              ,"":U
      671                                                              , (if new(ub.cli-grp) then integer('1':U) else integer('2':U))
      672                                                              ).
      673     end.
      674     if g#oxml = yes
      675     then do:
      676       run str/calloxml.p (
      677             input 'update':U
      678           , input 'cli-grp':U
      679           , input ( buffer ub.cli-grp:handle )
      680       ) no-error.
      681       if error-status :error
      682       then do:
      683           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      684                                , chr(10)
      685                                , vss-workfile
      686                                , return-value
      687                                , error-status :get-message ( 1 ) ).
      688       end.
      689     end.
      690       if new(ub.cli-grp) then
      691     do:
      692       run trg/userlog.p (
      693         input 'create':U
      694         , input 'cli-grp':U
      695         , input ( buffer ub.cli-grp :handle )
      696         , input ?
      697         , input ""
      698         ) no-error.
      699       if error-status :error
      700         then
      701       do:
      702         undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      703           , chr(10)
      704           , vss-workfile
      705           , return-value
      706           , error-status :get-message ( 1 ) ).
      707       end.
      708     end.
      709     else
      710     do:
      711       run trg/userlog.p (
      712         input 'update':U
      713         , input 'cli-grp':U
      714         , input ( buffer ub.cli-grp :handle )
      715         , input ?
      716         , input ""
      717         ) no-error.
      718       if error-status :error
      719         then
      720       do:
      721         undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      722           , chr(10)
      723           , vss-workfile
      724           , return-value
      725           , error-status :get-message ( 1 ) ).
      726       end.
      727     end.
      728   END.
      729   procedure grp-tree :
      730     define input param nc as int no-undo.
      731     define input param cur-name as char no-undo.
      732     define buffer b-g-g for ub.cli-grp.
      733     main-block:
      734     do
      735     on error undo, return error return-value
      736     :
      737       for each b-g-g
      738         where b-g-g.upper-code = nc
      739         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      740         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      741         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      742         :
      743         if nc = ub.cli-grp.node-code then do:
      744           assign
      745             ub.cli-grp.is-term = no
      746           .
      747         end.
      748         run grp-tree in this-procedure
      749           (input b-g-g.node-code
      750           ,input trim(cur-name, chr(47)) + (if cur-name = "":U then "":U else chr(47)) + b-g-g.node-name
      751           ).
      752       end.
      753       for each ub.clients
      754         where ub.clients.grp-code = nc
      755         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      756         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      757         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      758         :
      759         if v-changed-node-code <> nc
      760         and not v-only-is-term
      761         then do:
      762           run clientsh_write-clients-proc  in this-procedure (
      763                                                                 buffer ub.clients
      764                                                               ,input 'grp-chg':U
      765                                                               ,input string(v-changed-node-code-2)
      766                                                               ).
      767         end.
      768         assign
      769           ub.clients.grp-name = trim(cur-name , chr(47)) + chr(47)
      770         .
      771       end.
      772     end.
      773   end procedure.
