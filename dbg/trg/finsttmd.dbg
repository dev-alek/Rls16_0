        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.fin-statement .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление банковской выписки".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2', ub.fin-statement.host-code, ub.fin-statement.sttm-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure write-fin-statement-history :
      308   define parameter buffer buf_fin-statement for ub.fin-statement.
      309   define variable v-date as date no-undo .
      310   define variable v-time as integer no-undo .
      311   define buffer buf_c-fin-statement for ub.c-fin-statement.
      312   define buffer buf_c-fin-statement-line for ub.c-fin-statement-line.
      313   define buffer buf_c-fin-statement-attr for ub.c-fin-statement-attr.
      314     do
      315     on error undo, return error
      316     :
      317       run cur-time in this-procedure(output v-date, output v-time).
      318       create buf_c-fin-statement.
      319       buffer-copy buf_fin-statement to buf_c-fin-statement
      320       assign
      321       buf_c-fin-statement.chip-num           = next-value (s-fin-corr-chip, ub)
      322       buf_c-fin-statement.corr-time          = v-time
      323       buf_c-fin-statement.corr-user-db-num   = g#db-num
      324       buf_c-fin-statement.corr-user-name     = g#userid
      325       buf_c-fin-statement.corr-date          = v-date
      326       buf_c-fin-statement.corr-doc-code      = "":U
      327       .
      328       for each ub.fin-statement-line where
      329                ub.fin-statement-line.host-code = buf_fin-statement.host-code
      330            AND ub.fin-statement-line.sttm-code = buf_fin-statement.sttm-code:
      331         create buf_c-fin-statement-line.
      332         buffer-copy ub.fin-statement-line to buf_c-fin-statement-line
      333         assign
      334         buf_c-fin-statement-line.chip-num           = buf_c-fin-statement.chip-num
      335         buf_c-fin-statement-line.corr-user-db-num   = buf_c-fin-statement.corr-user-db-num
      336         .
      337       end.
      338       for each ub.fin-statement-attr where
      339                ub.fin-statement-attr.host-code = buf_fin-statement.host-code
      340            AND ub.fin-statement-attr.sttm-code = buf_fin-statement.sttm-code:
      341         create buf_c-fin-statement-attr.
      342         buffer-copy ub.fin-statement-attr to buf_c-fin-statement-attr
      343         assign
      344         buf_c-fin-statement-attr.chip-num           = buf_c-fin-statement.chip-num
      345         buf_c-fin-statement-attr.corr-user-db-num   = buf_c-fin-statement.corr-user-db-num
      346         buf_c-fin-statement-attr.attr-value         = buf_c-fin-statement-attr.attr-value
      347         .
      348       end.
      349       release buf_c-fin-statement.
      350     end.
      351   end procedure.
      352   define buffer buf_sysconf  for ub.sysconf.
      353   define buffer buf_fin-connect for ub.fin-connect.
      354   define buffer buf_fin-statement-line for ub.fin-statement-line.
      355   define buffer buf_fin-statement-attr for ub.fin-statement-attr.
      356   define buffer buf_fin-doc for ub.fin-doc.
      357   main-block:
      358   do
      359   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      360   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      361   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      362   :
      363     if not g#news then do:
      364       find first buf_sysconf no-lock where buf_sysconf.host-code = ub.fin-statement.host-code.
      365       if buf_sysconf.firm-db-num <> g#db-num
      366       then do:
      367         message
      368         vss-workfile vss-revision vss-description skip
      369         "Нельзя удалять запись БАНКОВСКОЙ ВЫПИСКИ в БД, отличной от главной БД фирмы" skip
      370         "Номер текущей БД" g#db-num "Номер главной БД фирмы" buf_sysconf.firm-db-num
      371         view-as alert-box error .
      372         undo main-block, return error .
      373       end.
      374     end.
      375     if (ub.fin-statement.status_ = 'факт':U
      376     OR ub.fin-statement.status_ = 'банк':U)
      377     and ub.fin-statement.is-del  <> yes
      378     then do:
      379       message
      380         vss-workfile vss-revision vss-description skip
      381         "Нельзя удалять выписку, закрытую до статуса" ub.fin-statement.status_ skip
      382         "Фирма" ub.fin-statement.host-code skip
      383         "Выписка" ub.fin-statement.sttm-code skip
      384         "Статус выписки" ub.fin-statement.status_ skip
      385         view-as alert-box error .
      386       undo main-block, return error .
      387     end.
      388     if not g#news
      389     and ub.fin-statement.status_ <> 'новый':U
      390     and ub.fin-statement.status_ <> 'факт':U then do:
      391       run write-fin-statement-history in this-procedure( buffer ub.fin-statement) no-error .
      392       if error-status :error
      393       then do:
      394         message
      395           vss-workfile vss-revision vss-description skip
      396           "Ошибка при обновлении истории по выписке" skip
      397           "Фирма" ub.fin-statement.host-code skip
      398           "Платеж" ub.fin-statement.sttm-code skip
      399           error-status :get-message(1) skip
      400           return-value skip
      401           view-as alert-box error .
      402         undo, return error .
      403       end.
      404     end.
      405     for each buf_fin-statement-line where
      406             buf_fin-statement-line.sttm-code = ub.fin-statement.sttm-code
      407        AND  buf_fin-statement-line.host-code = ub.fin-statement.host-code
      408     on error undo main-block, return error
      409     :
      410       if buf_fin-statement-line.fin-doc-code > 0 then do:
      411         find first buf_fin-doc where
      412                 buf_fin-doc.host-code = ub.fin-statement.host-code
      413             and buf_fin-doc.sttm-code = ub.fin-statement.sttm-code
      414             and buf_fin-doc.fin-doc-code = buf_fin-statement-line.fin-doc-code.
      415         assign
      416         buf_fin-doc.sttm-code = 0.
      417       end.
      418       delete buf_fin-statement-line .
      419     end.
      420     for each buf_fin-statement-attr where
      421             buf_fin-statement-attr.sttm-code = ub.fin-statement.sttm-code
      422        AND  buf_fin-statement-attr.host-code = ub.fin-statement.host-code
      423     on error undo main-block, return error
      424     :
      425       delete buf_fin-statement-attr .
      426     end.
      427     if buf_sysconf.firm-db-num <> 0
      428     then do:
      429       run nws/cmd-del.p
      430         ( input 'fin-statement':U
      431          ,input (buffer ub.fin-statement:handle)
      432          ,input "0":U
      433         ) no-error .
      434       if error-status :error then do:
      435         return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      436       end.
      437     end.
      438       if g#oxml = yes
      439       then do:
      440       run str/calloxml.p (
      441             input 'delete':U
      442           , input 'fin-statement':U
      443           , input ( buffer ub.fin-statement:handle )
      444       ) no-error.
      445       if error-status :error
      446       then do:
      447           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      448                                , chr(10)
      449                                , vss-workfile
      450                                , return-value
      451                                , error-status :get-message ( 1 ) ).
      452       end.
      453       end.
      454   end.
