        1   block-level on error undo, throw.
        2   define input  parameter pobj-type like ub.clients.obj-type     no-undo.
        3   define input  parameter pobj-code like ub.clients.obj-code     no-undo.
        4   define input  parameter ppl-code  like ub.place.pl-code        no-undo.
        5   define input  parameter ploc1     like ub.place.loc1           no-undo.
        6   define input  parameter pis-meas  like ub.place.is-meas        no-undo.
        7   define input-output  parameter pis-petrol-place as logical     no-undo.
        8   define output parameter loc#log   as logical                   no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision$":u .
       10   define variable vss-author      as character no-undo init "$Author$":u .
       11   define variable vss-date        as character no-undo init "$Date$":u .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       13   define variable vss-archive     as character no-undo init "$Archive$":u .
       14   define variable vss-description as character no-undo init "Проверки правильности задания loc1 для резервуара" .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable is-petrol-place       as logical no-undo.
       74   define variable is-found-another-loc1 as logical no-undo.
       75   define variable V-DOPI as integer no-undo .
       76   define buffer buf_pl-gds for ub.pl-gds.
       77   define buffer buf_goods for ub.goods.
       78   define buffer buf_units for ub.units.
       79   define buffer buf_place for ub.place.
       80   if pis-petrol-place then is-petrol-place = yes.
       81   else do:
       82     FOR EACH buf_pl-gds No-LOCK WHERE
       83             buf_pl-gds.pl-code = ppl-code AND
       84             buf_pl-gds.obj-type = pobj-type AND
       85             buf_pl-gds.obj-code = pobj-code,
       86         FIRST buf_goods no-LOCK WHERE
       87               buf_goods.gds-code = buf_pl-gds.gds-code,
       88         FIRST buf_units No-LOCK WHERE
       89               buf_units.unit-name = buf_goods.unit-base AND
       90               LOOKUP('топ':U, buf_units.type) > 0:
       91       is-petrol-place = yes.
       92       leave.
       93     END.
       94   end.
       95   if NOT is-petrol-place then do:
       96     loc#log = yes.
       97     return.
       98   END.
       99   assign
      100   v-dopi = integer(ploc1)
      101   no-error .
      102   if error-status:error
      103   or v-dopi <= 0
      104   or v-dopi > 999
      105   or ploc1 <> trim(string(v-dopi, ">>9"))
      106   then do:
      107     return substitute("объект &1&2&3коорд1 (&4) - ошибочна&3" +
      108                       "коорд1 для топливного резервуара должна быть ПОЛОЖИТЕЛЬНЫМ ТРЕХЗНАЧНЫМ ЧИСЛОМ БЕЗ ЛИДИРУЮЩИХ НУЛЕЙ"
      109                     ,pobj-type
      110                     ,pobj-code
      111                     ,chr(10)
      112                     ,PLOC1
      113                     ).
      114   end.
      115   _place:
      116   FOR EACH buf_place No-LOCK WHERE
      117            buf_place.obj-type = pobj-type AND
      118            buf_place.obj-code = pobj-code:
      119     if buf_place.loc1 = ploc1 AND
      120        buf_place.pl-code <> ppl-code AND
      121        buf_place.is-meas = yes
      122        then do:
      123       FOR EACH buf_pl-gds No-LOCK WHERE
      124               buf_pl-gds.pl-code = buf_place.pl-code AND
      125               buf_pl-gds.obj-type = pobj-type AND
      126               buf_pl-gds.obj-code = pobj-code,
      127           FIRST buf_goods no-LOCK WHERE
      128                 buf_goods.gds-code = buf_pl-gds.gds-code,
      129           FIRST buf_units No-LOCK WHERE
      130                 buf_units.unit-name = buf_goods.unit-base AND
      131                 LOOKUP('топ':U, buf_units.type) > 0:
      132         is-found-another-loc1 = yes.
      133         leave _place.
      134       END.
      135     END.
      136   END.
      137   if is-petrol-place
      138   AND pis-meas
      139   AND is-found-another-loc1 then do:
      140     return substitute("объект &1&2&3коорд1, равную &4&3уже имеет резервуар &5"
      141                     ,pobj-type
      142                     ,pobj-code
      143                     ,chr(10)
      144                     ,ploc1
      145                     ,buf_place.pl-code).
      146   END.
      147   else do:
      148     loc#log = yes.
      149   end.
