        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Отправка в новости шапки price-doc-forming".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input  parameter p-pdf-id      as integer   no-undo .
       67   define input  parameter p-pdf-db      as integer   no-undo .
       68   define input  parameter p-plt-id      as integer   no-undo .
       69   define input  parameter p-plt-db-num  as integer   no-undo .
       70   define input  parameter p-comand-type as character no-undo .
       71   define input  parameter p-db-list     as character no-undo .
       72   define buffer buf_price-doc-forming for ub.price-doc-forming  .
       73   find first buf_price-doc-forming  no-lock where
       74              buf_price-doc-forming.pdf-id     = p-pdf-id     and
       75              buf_price-doc-forming.pdf-db     = p-pdf-db     and
       76              buf_price-doc-forming.plt-id     = p-plt-id     and
       77              buf_price-doc-forming.plt-db-num = p-plt-db-num
       78              .
       79   define variable v-cmd-proc-handle as handle    no-undo .
       80   define variable v-cmd-code        as integer   no-undo .
       81   define variable v-db-list as character no-undo .
       82   define variable v-rec-ord as integer no-undo .
       83   do
       84   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       85   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       86   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       87   :
       88     run nws/cmd-bush.p persistent set v-cmd-proc-handle
       89       no-error .
       90     if error-status :error
       91     then do:
       92       message
       93         vss-workfile vss-revision vss-description skip
       94         substitute("Ошибка при запуске процедуры cmd-bush.p") skip
       95         error-status :get-message(1) skip
       96         return-value skip
       97         view-as alert-box error .
       98       delete procedure v-cmd-proc-handle .
       99       undo, return error return-value .
      100     end.
      101     define variable v-command as character no-undo .
      102     v-command =  substitute("&2&1&3&1&4&1&5&1&6&1&7"
      103                 , chr(6)
      104                 , 'cmd-pdf-fact':U
      105                 , p-comand-type
      106                 , p-pdf-id
      107                 , p-pdf-db
      108                 , p-plt-id
      109                 , p-plt-db-num
      110                 ).
      111     v-db-list = p-db-list .
      112     run begin-create-command in v-cmd-proc-handle
      113       (input  v-command
      114       ,input  v-db-list
      115       ,output v-cmd-code
      116       ) no-error.
      117     if error-status :error
      118     then do:
      119       message
      120         vss-workfile vss-revision vss-description skip
      121         substitute( "Ошибка при создании команды &1", 'cmd-pdf-fact':U ) skip
      122         error-status :get-message(1) skip
      123         return-value skip
      124         view-as alert-box error .
      125       delete procedure v-cmd-proc-handle .
      126       undo, return error return-value .
      127     end.
      128     for each buf_price-doc-forming exclusive-lock where
      129              buf_price-doc-forming.pdf-id     = p-pdf-id     and
      130              buf_price-doc-forming.pdf-db     = p-pdf-db     and
      131              buf_price-doc-forming.plt-id     = p-plt-id     and
      132              buf_price-doc-forming.plt-db-num = p-plt-db-num
      133     on error undo, return error return-value
      134     :
      135       run add-dump in v-cmd-proc-handle
      136         (input v-cmd-code
      137         ,input 'price-doc-forming':U
      138         ,input '+update':U
      139         ,input (buffer buf_price-doc-forming :handle)
      140         ,input '':U
      141         ,output v-rec-ord
      142         ) no-error .
      143       if error-status :error
      144       then do:
      145         message
      146           vss-workfile vss-revision vss-description skip
      147           substitute( "Ошибка при добавлении записи &1 в команду с кодом &2", 'price-doc-forming':U, v-cmd-code ) skip
      148           error-status :get-message(1) skip
      149           return-value skip
      150           view-as alert-box error .
      151         delete procedure v-cmd-proc-handle .
      152         undo, return error return-value .
      153       end.
      154     end.
      155     run send-command in v-cmd-proc-handle
      156       ( input v-cmd-code
      157        ,input p-db-list
      158       ) no-error .
      159     if error-status :error then do:
      160       message
      161         vss-workfile vss-revision vss-description skip
      162         substitute( "Ошибка при отправке в новости команды с кодом &1", v-cmd-code ) skip
      163         error-status :get-message(1) skip
      164         return-value skip
      165         view-as alert-box error .
      166       delete procedure v-cmd-proc-handle .
      167       undo, return error return-value .
      168     end.
      169     delete procedure v-cmd-proc-handle .
      170   end.
