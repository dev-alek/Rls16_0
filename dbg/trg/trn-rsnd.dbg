        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.trn-reason.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Триггер на удаление оснований (причин) создания документов":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define buffer buf_rsn-attr for ub.trn-rsn-attr.
       79   define buffer buf_trn-doc  for ub.trn-doc.
       80   define buffer buf_rsn-host for ub.trn-reason-host.
       81   define buffer buf_rsn-obj  for ub.trn-reason-obj.
       82   main-block:
       83   do
       84   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       85   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       86   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       87   :
       88     find first buf_trn-doc no-lock where
       89                buf_trn-doc.reason-code = ub.trn-reason.reason-code no-error.
       90     if available buf_trn-doc then do:
       91       undo, return error substitute(
       92         '&1. Обоснование (причина) создания документов &2 "&3" используется в документах (&4)',
       93         vss-workfile, ub.trn-reason.reason-code, ub.trn-reason.reason-name, buf_trn-doc.doc-code ).
       94     end.
       95     find first buf_rsn-obj no-lock where
       96                buf_rsn-obj.reason-code = ub.trn-reason.reason-code no-error.
       97     if available buf_rsn-obj then do:
       98       undo, return error substitute(
       99         '&1. Обоснование (причина) создания документов &2 "&3" используется в настройках по умолчанию на объекте &4 &5',
      100         vss-workfile, ub.trn-reason.reason-code, ub.trn-reason.reason-name, buf_rsn-obj.obj-type, buf_rsn-obj.obj-code ).
      101     end.
      102     find first buf_rsn-host no-lock where
      103                buf_rsn-host.reason-code = ub.trn-reason.reason-code no-error.
      104     if available buf_rsn-host then do:
      105       undo, return error substitute(
      106         '&1. Обоснование (причина) создания документов &2 "&3" используется в настройках по умолчанию на фирме &4',
      107         vss-workfile, ub.trn-reason.reason-code, ub.trn-reason.reason-name, buf_rsn-host.host-code ).
      108     end.
      109     run nws/cmd-del.p ( input "trn-reason":U, input ( buffer ub.trn-reason :handle ), input "":U ) no-error.
      110     if error-status :error then do:
      111       undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4",
      112                                      vss-workfile, chr(10), return-value, error-status :get-message ( 1 ) ).
      113     end.
      114     if g#news <> yes then do:
      115       create ub.c-trn-reason.
      116       buffer-copy ub.trn-reason to ub.c-trn-reason no-error.
      117       if error-status :error then do: undo, return error. end.
      118       assign ub.c-trn-reason.action           = integer( '99':U )
      119              ub.c-trn-reason.corr-date        = today
      120              ub.c-trn-reason.corr-time        = time
      121              ub.c-trn-reason.corr-user-name   = g#userid
      122              ub.c-trn-reason.corr-user-db-num = g#db-num
      123              ub.c-trn-reason.chip-num         = next-value( s-corr-chip, ub ) no-error.
      124       if error-status :error then do: undo, return error. end.
      125     end.
      126     for each buf_rsn-attr no-lock where
      127              buf_rsn-attr.reason-code = ub.trn-reason.reason-code :
      128       find first ub.trn-rsn-attr exclusive-lock where
      129           recid( ub.trn-rsn-attr ) = recid( buf_rsn-attr ).
      130       run nws/cmd-del.p ( input "trn-rsn-attr":U, input ( buffer ub.trn-rsn-attr :handle ), input "":U ) no-error.
      131       if error-status :error then do:
      132         undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4",
      133                                        vss-workfile, chr(10), return-value, error-status :get-message ( 1 ) ).
      134       end.
      135       if g#news <> yes then do:
      136         create ub.c-trn-rsn-attr.
      137         buffer-copy ub.trn-rsn-attr to ub.c-trn-rsn-attr no-error.
      138         if error-status :error then do: undo, return error. end.
      139         assign ub.c-trn-rsn-attr.action           = ub.c-trn-reason.action
      140                ub.c-trn-rsn-attr.corr-date        = ub.c-trn-reason.corr-date
      141                ub.c-trn-rsn-attr.corr-time        = ub.c-trn-reason.corr-time
      142                ub.c-trn-rsn-attr.corr-user-name   = ub.c-trn-reason.corr-user-name
      143                ub.c-trn-rsn-attr.corr-user-db-num = ub.c-trn-reason.corr-user-db-num
      144                ub.c-trn-rsn-attr.chip-num         = ub.c-trn-reason.chip-num no-error.
      145         if error-status :error then do: undo, return error. end.
      146       end.
      147       delete ub.trn-rsn-attr.
      148     end.
      149       if g#oxml = yes
      150       then do:
      151       run str/calloxml.p (
      152             input 'delete':U
      153           , input 'trn-reason':U
      154           , input ( buffer ub.trn-reason:handle )
      155       ) no-error.
      156       if error-status :error
      157       then do:
      158           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      159                                , chr(10)
      160                                , vss-workfile
      161                                , return-value
      162                                , error-status :get-message ( 1 ) ).
      163       end.
      164       end.
      165   end.
