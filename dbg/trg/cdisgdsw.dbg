        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-dis-gds-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись истории СКИДОК ТОВАРА НА ОБЪЕКТЕ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8'
       29                           , ub.c-dis-gds-rule.obj-type
       30                           , ub.c-dis-gds-rule.obj-code
       31                           , ub.c-dis-gds-rule.gds-code
       32                           , ub.c-dis-gds-rule.pos-type
       33                           , ub.c-dis-gds-rule.discnt-role
       34                           , ub.c-dis-gds-rule.nonunique
       35                           , ub.c-dis-gds-rule.corr-user-db-num
       36                           , ub.c-dis-gds-rule.chip-num
       37                           )
       38       .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable v-db-num like ub.db.db-num no-undo .
       91   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
       92   main-block:
       93   do
       94   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       95   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       96   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       97   :
       98      if ub.c-dis-gds-rule.obj-type = 'маг':U
       99      or ub.c-dis-gds-rule.obj-type = 'скл':U then do:
      100   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      102     (input  ub.c-dis-gds-rule.obj-type
      103     ,input  ub.c-dis-gds-rule.obj-code
      104     ,output v-db-num
      105     )  .
      106       if not g#news and g#db-num <> v-db-num and g#db-num <> 0 then do:
      107           message
      108           vss-workfile vss-revision vss-description skip
      109           "Нельзя изменять запись ИСТОРИИ СКИДОК НА ОБЪЕКТЕ в БД, отличной от БД объекта, если она не ГБД" skip
      110           "Номер текущей БД" g#db-num "Номер БД объекта" v-db-num
      111           view-as alert-box error .
      112           undo, return error .
      113         end.
      114     end.
      115     if
      116     not g#news
      117     OR (g#news
      118         and g#db-num = 0
      119         and ub.c-dis-gds-rule.corr-user-name <> (chr(4) +  'СПН':U)
      120         )
      121     or (g#news
      122         and g#db-num > 0
      123         and ub.c-dis-gds-rule.corr-user-name = (chr(4) +  'СПН':U)
      124         )
      125     then do:
      126         run str/callnews.p
      127           (input 'c-dis-gds-rule':U
      128       ,input (buffer ub.c-dis-gds-rule:handle)
      129       ).
      130     end.
      131     if g#oxml = yes
      132     then do:
      133       run str/calloxml.p (
      134             input 'update':U
      135           , input 'c-dis-gds-rule':U
      136           , input ( buffer ub.c-dis-gds-rule:handle )
      137       ) no-error.
      138       if error-status :error
      139       then do:
      140           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      141                                , chr(10)
      142                                , vss-workfile
      143                                , return-value
      144                                , error-status :get-message ( 1 ) ).
      145       end.
      146     end.
      147   end.
