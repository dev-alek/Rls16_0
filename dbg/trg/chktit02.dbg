        1   block-level on error undo, throw.
        2   define input parameter p-exit-on-error as logical no-undo .
        3   define input parameter p-doc-code like ub.chk-doc.doc-code no-undo .
        4   define input parameter p-doc-type as integer no-undo .
        5   define input parameter p-host-code like ub.sysconf.host-code no-undo .
        6   define input parameter p-obj-type like ub.chk-doc.obj-type no-undo .
        7   define input parameter p-obj-code like ub.chk-doc.obj-code no-undo .
        8   define input parameter p-chk-date like ub.chk-doc.chk-date no-undo .
        9   define input parameter p-chk-time like ub.chk-doc.chk-time no-undo .
       10   define input parameter p-shift-date like ub.chk-doc.shift-date no-undo .
       11   define input parameter p-shift-num like ub.chk-doc.shift-num no-undo .
       12   define input parameter p-shift-name like ub.chk-doc.shift-name no-undo .
       13   define input parameter p-pay-desk like ub.chk-doc.pay-desk no-undo .
       14   define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
       15   define input-output    parameter p-cash-rate like ub.chk-doc.cash-rate no-undo .
       16   define input parameter p-cashier like ub.chk-doc.cashier no-undo .
       17   define input parameter p-sales-man like ub.chk-doc.sales-man no-undo .
       18   define input parameter p-d-card like ub.chk-doc.d-card no-undo .
       19   define input parameter p-z-number like ub.chk-doc.z-number no-undo .
       20   define input parameter p-PS like ub.chk-doc.PS no-undo .
       21   define input parameter p-lines-exist as logical no-undo .
       22   define input parameter r-b as character no-undo .
       23   define input parameter cas-shft as logical no-undo .
       24   define input parameter l-shift-on as logical no-undo .
       25   define input parameter t-shft as integer no-undo .
       26   define input parameter v-shft as integer no-undo .
       27   define input parameter cas-curs as logical no-undo .
       28   define input parameter hnum as logical no-undo .
       29   define variable vss-revision    as character no-undo init "$Revision$":U .
       30   define variable vss-author      as character no-undo init "$Author$":U .
       31   define variable vss-date        as character no-undo init "$Date$":U .
       32   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       33   define variable vss-archive     as character no-undo init "$Archive$":U .
       34   define variable vss-description as character no-undo init "Проверка корректности шапки чека МЦ".
       35   procedure vss-get-info :
       36     define output parameter p-vss-revision    like vss-revision    no-undo .
       37     define output parameter p-vss-author      like vss-author      no-undo .
       38     define output parameter p-vss-date        like vss-date        no-undo .
       39     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       40     define output parameter p-vss-archive     like vss-archive     no-undo .
       41     define output parameter p-vss-description like vss-description no-undo .
       42     assign
       43       p-vss-revision    = vss-revision
       44       p-vss-author      = vss-author
       45       p-vss-date        = vss-date
       46       p-vss-workfile    = vss-workfile
       47       p-vss-archive     = vss-archive
       48       p-vss-description = vss-description
       49     .
       50   end procedure.
       51   procedure vss-get-parameters :
       52     define output parameter p-vss-parameters as character no-undo .
       53   end procedure.
       54   define new global shared variable g#vssrevis-logger as handle    no-undo .
       55   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       56   define variable v-vssrevis-logger                   as handle    no-undo .
       57   procedure vss-logevent :
       58     define input  parameter p-extra-paramters as character no-undo .
       59     define variable v-vssrevis-parameters as character no-undo .
       60     do
       61     on error undo, return error return-value
       62     :
       63       if  valid-handle(v-vssrevis-logger)
       64       and v-vssrevis-logger :get-signature("logevent") <> ""
       65       then do:
       66         run vss-get-parameters in this-procedure
       67           (output v-vssrevis-parameters
       68           ).
       69         run logevent in v-vssrevis-logger
       70           (input vss-workfile
       71           ,input vss-revision
       72           ,input v-vssrevis-parameters
       73           ,input p-extra-paramters
       74           ).
       75       end.
       76     end.
       77   end procedure.
       78   assign
       79     v-vssrevis-logger = g#vssrevis-logger
       80   .
       81   if  valid-handle(v-vssrevis-logger)
       82   and v-vssrevis-logger :get-signature("logevent") <> ""
       83   then do:
       84     assign
       85       v-vssrevis-logevent = true
       86     .
       87     run vss-logevent in this-procedure (input vss-description) .
       88   end.
       89   define new global shared variable g#language as character no-undo .
       90   if g#language <> '' and g#language <> 'rus':U then do:
       91     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       92   end.
       93   define new global shared variable g#library  as handle no-undo .
       94   define new global shared variable g#library2 as handle no-undo .
       95   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
       97                                                       ,input p-range-type as character
       98                                                       ,input p-code as integer):
       99   define variable v-seq-val as integer no-undo .
      100   define buffer buf_code-range for ub.code-range.
      101   find first buf_code-range no-lock where
      102             buf_code-range.db-num = p-db-num
      103       and  buf_code-range.range-type = p-range-type
      104       and  buf_code-range.stts = 'u'
      105       and buf_code-range.first-code <= p-code
      106       and buf_code-range.last-code >= p-code no-error .
      107   if available buf_code-range then return yes.
      108   CASE p-range-type:
      109     when 'pngb':U then do:
      110       v-seq-val = current-value(s-pngb-code, ub).
      111     end.
      112     when 'fmgb':U then do:
      113       v-seq-val = current-value(s-fmgb-code, ub).
      114     end.
      115   END CASE.
      116   if p-code <= v-seq-val then do:
      117     find first buf_code-range no-lock where
      118               buf_code-range.db-num = p-db-num
      119         and  buf_code-range.range-type = p-range-type
      120         and  buf_code-range.stts = 'a'
      121         and buf_code-range.first-code <= p-code
      122         no-error .
      123    if available buf_code-range then return yes.
      124   end.
      125   find first buf_code-range no-lock where
      126             buf_code-range.db-num = p-db-num
      127       and  buf_code-range.range-type = p-range-type
      128       and  buf_code-range.stts = 'f'
      129       and buf_code-range.first-code <= p-code
      130       and buf_code-range.last-code >= p-code
      131       no-error .
      132   if available buf_code-range then return yes.
      133   return no.
      134   END FUNCTION.
      135   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      136                                                       ,input p-range-type as character
      137                                                       ,input p-code as integer):
      138   define variable v-seq-val as integer no-undo .
      139   define buffer buf_code-range for ub.code-range.
      140   CASE p-range-type:
      141     when 'pngb':U then do:
      142       v-seq-val = current-value(s-pngb-code, ub).
      143     end.
      144     when 'fmgb':U then do:
      145       v-seq-val = current-value(s-fmgb-code, ub).
      146     end.
      147   END CASE.
      148   if p-code <= v-seq-val then do:
      149     find first buf_code-range no-lock where
      150               buf_code-range.db-num = p-db-num
      151         and  buf_code-range.range-type = p-range-type
      152         and buf_code-range.first-code <= p-code
      153         and buf_code-range.last-code >= p-code no-error .
      154     if available buf_code-range then return yes.
      155   end.
      156   return no.
      157   END FUNCTION.
      158   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      159                                                       ,input p-db-num as integer
      160                                                       ,input p-staff-code as integer
      161                                                       ,input p-date as date
      162                                                        ):
      163   define buffer buf_staff for ub.staff.
      164   if p-date = ? then do:
      165     p-date = today .
      166   end.
      167   find first buf_staff no-lock where
      168             buf_staff.role = p-role
      169         and buf_staff.role-level = 'db':U
      170         and buf_staff.db-num = p-db-num
      171         and buf_staff.staff-code = p-staff-code
      172         and buf_staff.date-end >= p-date use-index pi  no-error .
      173   if available buf_staff then do:
      174     return buf_staff.psn-code.
      175   end.
      176   return 0.
      177   end FUNCTION.
      178   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      179                                                             ,input p-db-num as integer
      180                                                             ,input p-date as date
      181                                                                 ):
      182   define buffer buf_staff for ub.staff.
      183   define buffer buf2_staff for ub.staff.
      184   if p-date = ? then do:
      185     p-date = today .
      186   end.
      187   for each  buf_staff no-lock where
      188             buf_staff.role = p-role
      189         and buf_staff.db-num = p-db-num,
      190   first buf2_staff no-lock where
      191         buf2_staff.role = p-role
      192     and buf2_staff.role-level = 'db':U
      193     and buf2_staff.staff-code = buf_staff.staff-code
      194     and buf2_staff.date-start <= p-date
      195     and buf2_staff.date-end >= p-date
      196   by buf_staff.staff-code
      197   by date-start descending:
      198     return buf_staff.staff-code.
      199   end.
      200   end FUNCTION.
      201   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      202                                                  ,input p-db-num as integer
      203                                                  ,input p-psn-code as integer
      204                                                  ,input p-date as date
      205                                                  ,output p-c-password as character
      206                                                        ):
      207   define buffer buf_staff for ub.staff.
      208   if p-date = ? then do:
      209     p-date = today .
      210   end.
      211   find first buf_staff no-lock where
      212             buf_staff.role = p-role
      213         and buf_staff.role-level = 'db':U
      214         and buf_staff.db-num = p-db-num
      215        and buf_staff.date-end >= p-date
      216        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      217   if available buf_staff
      218   then do:
      219     assign
      220     p-c-password = buf_staff.password.
      221     return buf_staff.staff-code.
      222   end.
      223   p-c-password = ''.
      224   return 0.
      225   end FUNCTION.
      226   FUNCTION gbclcode-is-psn-role returns integer (
      227                                                 input p-role as character
      228                                                 ,input p-psn-code as integer
      229                                                 ,input p-date as date
      230                                                     ):
      231   define buffer buf_staff for ub.staff.
      232   if p-date = ? then do:
      233     p-date = today .
      234   end.
      235   for each buf_staff no-lock where
      236             buf_staff.psn-code = p-psn-code
      237        and  buf_staff.role = p-role
      238   by buf_staff.role-level
      239   by buf_staff.date-start
      240        :
      241     if  buf_staff.date-start <= p-date and
      242     buf_staff.date-end >= p-date  then do:
      243       return buf_staff.staff-code.
      244     end.
      245   end.
      246   return 0.
      247   end FUNCTION.
      248   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      249   define variable v-role-name as character no-undo .
      250   assign
      251   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      252   no-error .
      253   return v-role-name.
      254   END.
      255   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   FUNCTION gbclcode-get-position returns character ( input p-role as character
      257                                                     ,input p-role-level as character
      258                                                     ,input p-work-place as character
      259                                                     ,input p-staff-code as integer
      260                                                                ):
      261   define variable v-role-name as character no-undo .
      262   define variable v-role-level as character no-undo .
      263   define variable v-staff-code as integer no-undo .
      264   assign
      265   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      266   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      267   v-staff-code = p-staff-code
      268   no-error .
      269   return substitute("&1, &2, Код &3"
      270                   ,v-role-name
      271                   ,v-role-level
      272                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      273   END.
      274   FUNCTION gbclcode-get-work-place returns character (
      275                                                   input p-role as character
      276                                                  ,input p-role-level as character
      277                                                  ,input p-db-num as integer
      278                                                  ,input p-host-code as integer
      279                                                  ,input p-obj-type as character
      280                                                  ,input p-obj-code as integer
      281                                                  ) :
      282   define variable v-work-place as character no-undo .
      283   define variable v-obj-type as character no-undo .
      284     case p-role-level:
      285       when 'db':U then do:
      286         v-work-place = string(p-db-num, "99999").
      287       end.
      288       when 'firm':U then do:
      289         v-work-place = string(p-host-code, "99999").
      290       end.
      291       when 'object':U then do:
      292         assign
      293         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      294         .
      295       end.
      296     END CASE.
      297     return v-work-place.
      298   END FUNCTION.
      299   FUNCTION gbclcode-get-level-last-code returns integer (
      300                                                           input p-role as character
      301                                                         , input p-role-level as character
      302                                                         , input p-work-place as character
      303                                                         , input p-date-start as date
      304                                                         ):
      305   DEFINE VARIABLE v-today as date no-undo .
      306   define buffer buf_staff for ub.staff.
      307   if p-work-place = chr(63) then return ?.
      308   if p-date-start = ? then do:
      309     v-today = today .
      310   end.
      311   else do:
      312     v-today = p-date-start.
      313   end.
      314   find last buf_staff no-lock where
      315             buf_staff.role = p-role
      316        and  buf_staff.role-level = p-role-level
      317        and  buf_staff.work-place = p-work-place
      318        and  buf_staff.date-start <= v-today + 1
      319        and  buf_staff.date-end >= v-today + 1
      320        use-index pi  no-error .
      321   if available buf_staff
      322   then return buf_staff.staff-code.
      323   return 0.
      324   end FUNCTION.
      325   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   procedure cur-time :
      327      define output parameter p-today as date      no-undo .
      328      define output parameter p-time  as integer   no-undo .
      329     do
      330     on error undo, return error
      331     :
      332       define variable v-date1 as date      no-undo .
      333       define variable v-date2 as date      no-undo .
      334       define variable v-time  as integer   no-undo .
      335       assign
      336         v-date1 = today
      337         v-time  = time
      338         v-date2 = today
      339       .
      340       if v-date1 <> v-date2
      341       then do:
      342         assign
      343           v-date1 = today
      344           v-time  = v-time
      345         .
      346       end.
      347       assign
      348         p-today = v-date1
      349         p-time  = v-time
      350       .
      351     end.
      352   end.
      353   function cur-time-date returns character
      354   :
      355     return string(today, '99/99/9999':U) .
      356   end.
      357   function cur-time-mjd returns decimal
      358   :
      359     define variable v-date as date      no-undo .
      360     define variable v-time as integer   no-undo .
      361     run cur-time in this-procedure
      362       (output v-date
      363       ,output v-time
      364       ) .
      365     return integer(v-date) - 2400002 + (v-time / 86400) .
      366   end.
      367   function cur-time-get-ending-index returns integer
      368   (input p-number as integer
      369   )
      370   :
      371     if p-number < 0
      372     or p-number = ?
      373     then do:
      374       return 1 .
      375     end.
      376     define variable v-rest as integer   no-undo .
      377     assign
      378       p-number = p-number modulo 100
      379     .
      380     if p-number < 20
      381     then do:
      382       assign
      383         v-rest = p-number
      384       .
      385     end.
      386     else do:
      387       assign
      388         v-rest = p-number modulo 10
      389       .
      390     end.
      391     case v-rest :
      392       when 1
      393       then do:
      394         return 2 .
      395       end.
      396       when 2 or
      397       when 3 or
      398       when 4
      399       then do:
      400         return 3 .
      401       end.
      402       otherwise do:
      403         return 1 .
      404       end.
      405     end case .
      406   end.
      407   procedure cur-time-mjd-to-date :
      408      define input  parameter i-mjd-diff as decimal no-undo.
      409      define output parameter o-Date     as date    no-undo.
      410      define output parameter o-Time     as integer no-undo.
      411      define variable v-day-number as integer   no-undo .
      412      if    i-mjd-diff < 0
      413         or i-mjd-diff = ?
      414      then do:
      415         return "?" .
      416      end.
      417      assign
      418         v-day-number = truncate(i-mjd-diff,0).
      419         o-Date = date(v-day-number + 2400002).
      420         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      421     .
      422   end.
      423   function cur-time-mjd-to-string returns character
      424   (input p-mjd-diff as decimal
      425   )
      426   :
      427     define variable v-day-number as integer   no-undo .
      428     define variable v-seconds    as integer   no-undo .
      429     define variable v-hour       as integer   no-undo .
      430     define variable v-min        as integer   no-undo .
      431     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      432     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      433     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      434     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      435     if p-mjd-diff < 0
      436     or p-mjd-diff = ?
      437     then do:
      438       return "?" .
      439     end.
      440     assign
      441       v-day-number = integer(truncate(p-mjd-diff,0))
      442       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      443     .
      444     if v-seconds > 86400
      445     then do:
      446       assign
      447         v-seconds = 86400 - 1
      448       .
      449     end.
      450     if v-seconds < 0
      451     then do:
      452       assign
      453         v-seconds = 0
      454       .
      455     end.
      456     assign
      457       v-hour = truncate(v-seconds / 3600, 0)
      458     .
      459     assign
      460       v-seconds = v-seconds modulo 3600
      461     .
      462     assign
      463       v-min = truncate(v-seconds / 60, 0)
      464     .
      465     assign
      466       v-seconds = v-seconds modulo 60
      467     .
      468     return
      469         (if v-day-number <> 0
      470           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      471           else ""
      472         )
      473       + (if v-day-number <> 0 or v-hour <> 0
      474           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      475           else ""
      476         )
      477       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      478           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      479           else ""
      480         )
      481       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      482       .
      483   end.
      484   function cur-time-string returns character
      485   :
      486     define variable v-date as date      no-undo .
      487     define variable v-time as integer   no-undo .
      488     run cur-time in this-procedure
      489       (output v-date
      490       ,output v-time
      491       ) .
      492     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      493   end.
      494   function cur-time-string-sec returns character
      495   :
      496     define variable v-date as date      no-undo .
      497     define variable v-time as integer   no-undo .
      498     run cur-time in this-procedure
      499       (output v-date
      500       ,output v-time
      501       ) .
      502     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      503   end.
      504   function cur-time-custom  returns character
      505   (input p-prefix as character
      506   ,input p-date-format as character
      507   ,input p-delimiter as character
      508   ,input p-time-format as character
      509   ,input p-suffix as character
      510   )
      511   :
      512     define variable v-date as date      no-undo .
      513     define variable v-time as integer   no-undo .
      514     run cur-time in this-procedure
      515       (output v-date
      516       ,output v-time
      517       ) .
      518     return
      519       p-prefix
      520       + string(v-date, p-date-format)
      521       + p-delimiter
      522       + string(v-time, p-time-format)
      523       + p-suffix
      524       .
      525   end.
      526   function cur-time-print  returns character
      527   :
      528     define variable v-date as date      no-undo .
      529     define variable v-time as integer   no-undo .
      530     run cur-time in this-procedure
      531       (output v-date
      532       ,output v-time
      533       ) .
      534     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      535   end.
      536   function cur-time-datetime returns datetime
      537   :
      538     define variable v-char as character no-undo .
      539     define variable v-datetime as datetime no-undo .
      540     v-char = cur-time-string().
      541     v-datetime = datetime(v-char).
      542     return  v-datetime.
      543   end.
      544   function cur-time-string-msec returns character
      545   :
      546     define variable v-date as datetime  no-undo .
      547     v-date = now.
      548     return string(v-date) .
      549   end.
      550   DEFINE VARIABLE var-chk-type as character no-undo .
      551   DEFINE VARIABLE var-entry as character no-undo .
      552   DEFINE VARIABLE vardb-num like ub.clients.db-num no-undo .
      553   DEFINE VARIABLE v-shift-date as date no-undo.
      554   DEFINE VARIABLE v-shift-num as integer no-undo.
      555   DEFINE VARIABLE v-shift-name as character no-undo.
      556   DEFINE VARIABLE varbase-code like ub.sysconf.base-code no-undo .
      557   define buffer cashier for ub.person.
      558   define buffer sales-man for ub.person.
      559   define buffer buf_cash-desk for ub.cash-desk.
      560   define buffer buf_clients for ub.clients.
      561   define buffer buf_dis-card for ub.dis-card.
      562   define buffer buf_dis-card-type for ub.dis-card-type.
      563   do
      564   on error undo, return error return-value
      565   :
      566     FIND FIRST ub.sysconf No-LOCK WHERE
      567               ub.sysconf.host-code = p-host-code No-ERROR.
      568     IF NOT AVAIL ub.sysconf THEN DO:
      569       undo, return error substitute("Не найдена фирма &1!", p-host-code).
      570     END.
      571     varbase-code = ub.sysconf.base-code.
      572     FIND FIRST buf_clients No-LOCK WHERE
      573               buf_clients.obj-type = p-obj-type AND
      574               buf_clients.obj-code = p-obj-code NO-ERROR.
      575     IF NOT AVAIL buf_clients THEN DO:
      576       undo, return error substitute("Не найден объект &1&2!", p-obj-type, p-obj-code).
      577     END.
      578     vardb-num = buf_clients.db-num.
      579     if cas-shft or l-shift-on then do:
      580         if ABS(p-SHIFT-date - p-CHK-date) > 1 then do:
      581            undo, return error substitute("Чек &1 - ошибочный.&2" +
      582                                          "Несоответствуют друг другу дата чека &3 и дата начала смены &4!"
      583                                         , p-doc-code
      584                                         , chr(10)
      585                                         , p-chk-date
      586                                         ,p-shift-date
      587                                         ).
      588         end.
      589         if p-shift-num = 0 then do:
      590           undo, return error substitute("Чек &1 - ошибочный.&2" +
      591                                         "Номер смены не может равняться 0!"
      592                                         , p-doc-code
      593                                         , chr(10)).
      594         end.
      595         if l-shift-on then do:
      596           run curshift in this-procedure no-error.
      597           if error-status:error then.
      598           else do:
      599             if p-shift-date <> v-shift-date OR
      600               p-shift-num <> v-shift-num then do:
      601             undo, return error substitute("Чек &1 - ошибочный.&2" +
      602                                           "Несоответствуют друг другу дата/номер смены чека &3/&4&2" +
      603                                            "и дата/номер смены на объекте &5/&6!"
      604                                           ,p-doc-code
      605                                           ,chr(10)
      606                                           ,p-shift-date
      607                                           ,p-shift-name
      608                                           ,v-shift-date
      609                                           ,v-shift-num
      610                                           ).
      611             end.
      612           end.
      613         if v-shft >= 0 then do:
      614           FOR EACH ub.shift-cash No-LOCK WHERE
      615                   ub.shift-cash.obj-type = p-obj-type AND
      616                   ub.shift-cash.obj-code = p-obj-code AND
      617                   ub.shift-cash.cash-num = p-pay-desk AND
      618                   (ub.shift-cash.shift-date = p-shift-date OR
      619                   ub.shift-cash.shift-date = p-shift-date - 1) AND
      620                   ub.shift-cash.shift-num = p-shift-num:
      621             if ub.shift-cash.sale-date = p-shift-date then LEAVE.
      622           END.
      623           if not avail ub.shift-cash then do:
      624            undo, return error substitute("Чек &1 - ошибочный.&2" +
      625                                          "На кассе &3 &4&5&2" +
      626                                          "не  было смены c пор. N &2 за &7"
      627                                          ,p-doc-code
      628                                          ,chr(10)
      629                                          ,p-pay-desk
      630                                          ,p-obj-type
      631                                          ,p-obj-code
      632                                          ,p-shift-num
      633                                          ,string(p-shift-date, "99/99/9999")).
      634           END.
      635         end.
      636     end.
      637     ELSE DO:
      638       if (p-chk-date - p-shift-date) > 1
      639       then do:
      640         undo, return error substitute("Чек &1 - ошибочный.&2" +
      641                                       "Не соответствуют друг другу дата чека &3 и дата начала смены &4!"
      642                                     , p-doc-code
      643                                     , chr(10)
      644                                     , p-chk-date
      645                                     ,p-shift-date
      646                                     ).
      647       end.
      648     END.
      649     if not cas-curs then do:
      650       if varbase-code = 0 or r-b = "rubl":U then
      651       assign
      652       p-cash-rate = 1
      653       .
      654       else do:
      655         FIND FIRST ub.curr-shop No-LOCK WHERE
      656                     ub.curr-shop.obj-type = p-obj-type AND
      657                     ub.curr-shop.obj-code = p-obj-code AND
      658                     ub.curr-shop.curr-code = varbase-code AND
      659                 ( ( ub.curr-shop.exch-date = p-chk-date AND
      660                     ub.curr-shop.exch-time <= p-chk-time ) OR
      661                   ub.curr-shop.exch-date < p-chk-date ) NO-ERROR .
      662         if  not available ub.curr-shop then do:
      663           undo, return error
      664           substitute("Чек &1 - ошибочный.&2" +
      665                      "Нет магазинного курса базовой валюты на дату и время чека-&2&3 &4!"
      666                     , p-doc-code
      667                     , chr(10)
      668                     ,string(p-chk-date, "99/99/9999")
      669                     ,string(p-chk-time, "hh:mm")).
      670         end.
      671         p-cash-rate = ub.curr-shop.exch-rate / ub.curr-shop.exch-scale.
      672       end.
      673     end.
      674     else do:
      675       if p-cash-rate = 0 then do:
      676         undo, return error
      677         substitute("Чек &1 - ошибочный.&2" +
      678                    "Неверный курс базовой валюты базовой валюты на дату и время чека-&2&3 &4 = &5!"
      679                   , p-doc-code
      680                   , chr(10)
      681                   ,string(p-chk-date, "99/99/9999")
      682                   ,string(p-chk-time, "hh:mm")
      683                   ,p-cash-rate
      684                   ).
      685       end.
      686     end.
      687     if gbclcode-is-this-db-role ( input 'C':U, input vardb-num, input p-cashier, input p-chk-date) = 0 then do:
      688        undo, return error substitute(
      689                                 "!!!Чек МЦ &1 - ошибочный. &2 Нет сведений о кассире &3 на &4"
      690                                 , p-doc-code
      691                                 , chr(10)
      692                                 , p-cashier
      693                                 , string(p-chk-date, "99/99/9999")
      694                               ).
      695     end.
      696     if p-doc-type = 0 then do:
      697       if gbclcode-is-this-db-role( input 'S':U, input vardb-num, input p-sales-man, input p-chk-date) = 0 then do:
      698        undo, return error substitute(
      699                                 "!!!Чек МЦ &1 - ошибочный. &2 Нет сведений о продавце &3 на &4"
      700                                 , p-doc-code
      701                                 , chr(10)
      702                                 , p-sales-man
      703                                 , string(p-chk-date, "99/99/9999")
      704                               ).
      705       end.
      706     end.
      707     find first ub.sys-ctrl No-LOCK.
      708     FIND FIRST buf_cash-desk where
      709               buf_cash-desk.db-num = ub.sys-ctrl.db-num AND
      710               buf_cash-desk.obj-code = p-obj-code AND
      711               buf_cash-desk.cash-num = p-pay-desk no-error.
      712     if not available buf_cash-desk then dO:
      713       undo, return error substitute("!!!Чек &1 - ошибочный. &2 Нет сведений о кассе &3 с типом &4"
      714                                 , p-doc-code
      715                                 , chr(10)
      716                                 , p-pay-desk
      717                                 , p-pos-type
      718                               ).
      719     end.
      720     end.
      721    return var-chk-type.
      722   end.
      723   procedure curshift :
      724      do
      725     on error undo, return error return-value
      726     :
      727   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      728   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      729     (input  p-obj-type
      730     ,input  p-obj-code
      731     ,output v-shift-date
      732     ,output v-shift-num
      733     ,output v-shift-name
      734     ) no-error .
      735       if error-status:error then do:
      736         undo, return error substitute("&1 &2 &3&4Не удалось определить дату и время текущей смены&4&5&4&6"
      737                                      ,vss-workfile
      738                                      ,vss-revision
      739                                      ,vss-description
      740                                      , error-status:get-message(1)
      741                                      , return-value ).
      742       end.
      743     end.
      744   end procedure.
