        1   block-level on error undo, throw.
        2   define input  parameter pobj-type like ub.clients.obj-type     no-undo.
        3   define input  parameter pobj-code like ub.clients.obj-code     no-undo.
        4   define input  parameter ppl-code  like ub.place.pl-code        no-undo.
        5   define input  parameter pgds-code like ub.goods.gds-code       no-undo.
        6   define output parameter parresult as logical                   no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":u .
        8   define variable vss-author      as character no-undo init "$Author$":u .
        9   define variable vss-date        as character no-undo init "$Date$":u .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       11   define variable vss-archive     as character no-undo init "$Archive$":u .
       12   define variable vss-description as character no-undo init "Связывание резервуара с топливом" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   function nzpl-spl returns logical
       84   (input p-obj-type as character
       85                                   , input p-obj-code as integer):
       86   define variable v-dopi    as integer no-undo .
       87   define variable v-param-type as character no-undo .
       88   define variable v-value-character as character no-undo .
       89   define variable v-value-date as date no-undo .
       90   define variable v-value-decimal as decimal no-undo .
       91   define variable v-value-integer as integer no-undo .
       92   define variable v-value-logical as logical no-undo .
       93   define variable v-tth as handle no-undo .
       94   define variable dflt-cd as character no-undo .
       95   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   define variable v-param-type1 as character no-undo .
       97   define variable v-value-date1 as date no-undo .
       98   define variable v-value-decimal1 as decimal no-undo .
       99   define variable v-value-integer1 as INTEGER no-undo .
      100   define variable v-value-logical1 AS LOGICAL no-undo .
      101   define variable v-tth1 as handle no-undo .
      102   run adm/shattri.p (
      103       input "get":U
      104       ,input  p-obj-type
      105       ,input  p-obj-code
      106       ,input  'cd-sending':U
      107       ,input  'dflt-cd':U
      108       ,output dflt-cd
      109       ,output v-value-date1
      110       ,output v-value-decimal1
      111       ,output v-value-integer1
      112       ,output v-value-logical1
      113       ,output v-param-type1
      114       ,INPUT-OUTPUT table-handle v-tth1
      115       ) no-error .
      116   delete object v-tth1 no-error.
      117   if dflt-cd <> 'IBM':U
      118   and dflt-cd <> 'IBM-XML':U then return no.
      119   if dflt-cd = 'IBM-XML':U then return yes.
      120   run adm/shattri.p (
      121       input "get":U
      122       ,input  p-obj-type
      123       ,input  p-obj-code
      124       ,input  'cd-type-ibm':U
      125       ,input  'ibmspool':U
      126       ,output v-value-character
      127       ,output v-value-date
      128       ,output v-value-decimal
      129       ,output v-value-integer
      130       ,output v-value-logical
      131       ,output v-param-type
      132       ,INPUT-OUTPUT table-handle v-tth
      133       ) no-error .
      134   if error-status:error then do:
      135     delete object v-tth.
      136     return no.
      137   end.
      138   delete object v-tth.
      139   assign
      140   v-dopi = v-value-integer no-error .
      141   if v-dopi >= 6 then return yes.
      142   end. // FUNCTION/method
      143   FUNCTION nzpl-two returns logical
      144                                    (input p-obj-type as character
      145                                     , input p-obj-code as integer):
      146     define variable v-nzpl-two as logical no-undo.
      147     run
      148     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      149     return v-nzpl-two.
      150   end. // FUNCTION/method
      151   procedure nzpl-two-proc :
      152   define input  parameter p-obj-type   as character no-undo.
      153   define input  parameter p-obj-code   as integer   no-undo.
      154   define output parameter varge-two-pl as logical   no-undo.
      155   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      156   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      157   //do on error undo, return error return-value :
      158   assign
      159     varge-two-pl = no.
      160   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      161                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      162                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      163     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      164                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      165                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      166                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      167                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      168                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      169     if available bf-other_pl-gds-pump then do:
      170       assign
      171         varge-two-pl = yes.
      172       leave.
      173     end.
      174   end.
      175   //end.
      176   end. // procedure/method .
      177   procedure cplgdspm :
      178     define input parameter parobj-type  like ub.pl-gds-pump.obj-type  no-undo.
      179     define input parameter parobj-code  like ub.pl-gds-pump.obj-code  no-undo.
      180     define input parameter parpl-code   like ub.pl-gds-pump.pl-code   no-undo.
      181     define input parameter pargds-code  like ub.pl-gds-pump.gds-code  no-undo.
      182     define input parameter parpump-code like ub.pl-gds-pump.pump-code no-undo.
      183     define input parameter parstatus    like ub.pl-gds-pump.status_   no-undo.
      184       define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
      185       define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      186       define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      187       define buffer bf-place                for ub.place.
      188       if parstatus = 'тек':U then do:
      189         for each bf_pl-gds-pump no-lock
      190           where bf_pl-gds-pump.obj-type  =  parobj-type
      191             and bf_pl-gds-pump.obj-code  =  parobj-code
      192             and bf_pl-gds-pump.gds-code  =  pargds-code
      193             and bf_pl-gds-pump.pump-code =  parpump-code
      194             and bf_pl-gds-pump.pl-code   <> parpl-code
      195             and bf_pl-gds-pump.status_   =  'тек':U
      196         on error undo, return error
      197         :
      198           find first place where
      199                      place.obj-type = parobj-type
      200                  and place.obj-code = parobj-code
      201                  and place.pl-code  = parpl-code
      202                no-lock no-error.
      203           find first bf-place where
      204                      bf-place.obj-type = parobj-type
      205                  and bf-place.obj-code = parobj-code
      206                  and bf-place.pl-code = bf_pl-gds-pump.pl-code
      207                no-lock no-error.
      208           if nzpl-spl(parobj-type, parobj-code) <> yes then do:
      209             return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      210                                        ,parobj-type
      211                                        ,parobj-code
      212                                        ,if available place then place.loc1 else string(parpl-code)
      213                                        ,pargds-code
      214                                        ,parpump-code
      215                                        ,parstatus
      216                                        ,chr(10)
      217                                       )
      218                         + substitute( "КАССА не возвращает номер пистолета в чеке, а на объекте уже есть резервуар &1 с тем же товаром и связан он с этой же ТРК."
      219                                       ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      220                                     ).
      221           end.
      222           else do:
      223             find first bf_pl-pump-nozzle no-lock
      224               where bf_pl-pump-nozzle.obj-type  = parobj-type
      225                 and bf_pl-pump-nozzle.obj-code  = parobj-code
      226                 and bf_pl-pump-nozzle.pump-code = parpump-code
      227                 and bf_pl-pump-nozzle.pl-code   = parpl-code
      228               no-error.
      229             if available bf_pl-pump-nozzle then do:
      230               find first bf-other_pl-pump-nozzle no-lock
      231                 where bf-other_pl-pump-nozzle.obj-type  = bf_pl-gds-pump.obj-type
      232                   and bf-other_pl-pump-nozzle.obj-code  = bf_pl-gds-pump.obj-code
      233                   and bf-other_pl-pump-nozzle.pump-code = bf_pl-gds-pump.pump-code
      234                   and bf-other_pl-pump-nozzle.pl-code   = bf_pl-gds-pump.pl-code
      235                 no-error.
      236               if available bf-other_pl-pump-nozzle
      237                 and bf-other_pl-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
      238               then do:
      239                 return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      240                                          ,parobj-type
      241                                          ,parobj-code
      242                                          ,if available place then place.loc1 else string(parpl-code)
      243                                          ,pargds-code
      244                                          ,parpump-code
      245                                          ,parstatus
      246                                          ,chr(10)
      247                                        )
      248                             + substitute( "На объекте &1 &2 уже есть запись резервуар &3 в статусе &4, в котором находится этот же товар и он связан с этой же ТРК через этот же пистолет."
      249                                           ,bf_pl-gds-pump.obj-type
      250                                           ,bf_pl-gds-pump.obj-code
      251                                           ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      252                                           ,bf_pl-gds-pump.status_
      253                                         ).
      254               end.
      255             end.
      256           end.
      257         end.
      258       end.
      259   end . // procedure/method
      260   define buffer other-pl-gds-pump       for ub.pl-gds-pump.
      261   define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      262   define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      263   define variable v-ok      as logical   no-undo .
      264   define variable varstatus as character no-undo.
      265   define variable v-is-petrol-place as logical no-undo .
      266   find first ub.pl-gds no-lock where
      267              ub.pl-gds.obj-type = pobj-type and
      268              ub.pl-gds.obj-code = pobj-code and
      269              ub.pl-gds.pl-code  = ppl-code
      270              no-error.
      271    if available ub.pl-gds then do:
      272       return error
      273       ("объект " + pobj-type + string(pobj-code) + chr(10) +
      274        "резервуар " + string(ppl-code) + " уже занят - товар " + string(ub.pl-gds.gds-code)).
      275    end.
      276   find first ub.rvs-doc no-lock where
      277              ub.rvs-doc.obj-type = pobj-type and
      278              ub.rvs-doc.obj-code = pobj-code and
      279              ub.rvs-doc.rvs-type <> 'проверка':U and
      280              ub.rvs-doc.status_ <> 'факт':U  no-error.
      281   if available ub.rvs-doc then do:
      282     return error
      283       ("объект " + pobj-type + string(pobj-code) + chr(10) +
      284        "сверка " + string(ub.rvs-doc.rvs-code) + " не закрыта").
      285   end.
      286   find first ub.icnt-doc no-lock where
      287              ub.icnt-doc.obj-type = pobj-type and
      288              ub.icnt-doc.obj-code = pobj-code and
      289              ub.icnt-doc.status_ <> 'факт':U no-error.
      290   if available ub.icnt-doc then do:
      291     if ub.icnt-doc.doc-type = 'инв-сч-трк':U then do:
      292       return error
      293         ("объект " + pobj-type + string(pobj-code) + chr(10) +
      294         "инвентаризация счетчиков ТРК " + string(ub.icnt-doc.doc-code) + " не закрыта").
      295     end.
      296     if ub.icnt-doc.doc-type = 'сч-трк-погр':U then do:
      297       return error
      298         ("объект " + pobj-type + string(pobj-code) + chr(10) +
      299         "док-т измерения погрешности счетчиков ТРК " + string(ub.icnt-doc.doc-code) + " не закрыт").
      300     end.
      301   end.
      302   find first ub.place no-lock where
      303              ub.place.obj-type = pobj-type and
      304              ub.place.obj-code = pobj-code and
      305              ub.place.pl-code = ppl-code   no-error.
      306   if not available ub.place then do:
      307     return error
      308     ("объект " + pobj-type + string(pobj-code) + chr(10) +
      309      "резервуар " + string(ppl-code) + chr(32) + "не найден").
      310   end.
      311   v-is-petrol-place = yes.
      312   run trg/plloc1wv.p (
      313                        input pobj-type
      314                       ,input pobj-code
      315                       ,input ppl-code
      316                       ,input ub.place.loc1
      317                       ,input ub.place.is-meas
      318                       ,input-output v-is-petrol-place
      319                       ,output v-ok) no-error.
      320   if error-status:error or
      321      v-ok <> yes        then do:
      322     return error return-value.
      323   end.
      324   _creation:
      325   do on error undo _creation, return error return-value:
      326     assign
      327       varstatus = 'тек':U.
      328     for each  ub.pl-pump no-lock where
      329               ub.pl-pump.obj-type = pobj-type and
      330               ub.pl-pump.obj-code = pobj-code and
      331               ub.pl-pump.pl-code  = ppl-code  on error undo, return error return-value :
      332       find first bf_pl-pump-nozzle where bf_pl-pump-nozzle.obj-type  = ub.pl-pump.obj-type  and
      333                                          bf_pl-pump-nozzle.obj-code  = ub.pl-pump.obj-code  and
      334                                          bf_pl-pump-nozzle.pl-code   = ub.pl-pump.pl-code   and
      335                                          bf_pl-pump-nozzle.pump-code = ub.pl-pump.pump-code no-lock no-error.
      336       for each other-pl-gds-pump no-lock where
      337                other-pl-gds-pump.obj-type  = pobj-type            and
      338                other-pl-gds-pump.obj-code  = pobj-code            and
      339                other-pl-gds-pump.pump-code = ub.pl-pump.pump-code and
      340                other-pl-gds-pump.gds-code  = pgds-code            on error undo, return error return-value :
      341         if other-pl-gds-pump.pl-code <> ppl-code then do:
      342           find first bf-other_pl-pump-nozzle where bf-other_pl-pump-nozzle.obj-type  = other-pl-gds-pump.obj-type  and
      343                                                    bf-other_pl-pump-nozzle.obj-code  = other-pl-gds-pump.obj-code  and
      344                                                    bf-other_pl-pump-nozzle.pl-code   = other-pl-gds-pump.pl-code   and
      345                                                    bf-other_pl-pump-nozzle.pump-code = other-pl-gds-pump.pump-code no-lock no-error.
      346           if available bf_pl-pump-nozzle       and
      347              available bf-other_pl-pump-nozzle and
      348              bf_pl-pump-nozzle.nozzle-code <> bf-other_pl-pump-nozzle.nozzle-code then do:
      349                 undo _creation, return error
      350                  ("объект " + pobj-type + string(pobj-code) + chr(10) +
      351                   "ТРК " + string(ub.pl-pump.pump-code) + " наливает топливо c внутренним кодом " + string(pgds-code) +
      352                   " из резервуара " + string(other-pl-gds-pump.pl-code) + " через пистолет " + string(bf-other_pl-pump-nozzle.nozzle-code) +
      353                   " . А данный резервур " + string(ub.pl-pump.pl-code) + " наливает на этой ТРК через пистолет " + string (bf_pl-pump-nozzle.nozzle-code) + ".Это недопустимо.").
      354            end.
      355            else do:
      356                 if other-pl-gds-pump.status_ = 'тек':U and nzpl-spl (input other-pl-gds-pump.obj-type, input other-pl-gds-pump.obj-code) then do:
      357                   message "На ТРК "  string(ub.pl-pump.pump-code)  " наливает топливо с внутренним кодом "  string(pgds-code)
      358                           " из резервуара " string(other-pl-gds-pump.pl-code) "."
      359                           "Данная привязка получит статус блокированный."
      360                   view-as alert-box.
      361                   assign
      362                     varstatus = 'блок':U.
      363                 end.
      364            end.
      365         end.
      366       end.
      367       create ub.pl-gds-pump.
      368       assign
      369         ub.pl-gds-pump.obj-type  = pobj-type
      370         ub.pl-gds-pump.obj-code  = pobj-code
      371         ub.pl-gds-pump.pl-code   = ppl-code
      372         ub.pl-gds-pump.gds-code  = pgds-code
      373         ub.pl-gds-pump.pump-code = ub.pl-pump.pump-code
      374         ub.pl-gds-pump.status_   = varstatus
      375         .
      376       run cplgdspm in this-procedure (input ub.pl-gds-pump.obj-type ,
      377                                       input ub.pl-gds-pump.obj-code ,
      378                                       input ub.pl-gds-pump.pl-code  ,
      379                                       input ub.pl-gds-pump.gds-code ,
      380                                       input ub.pl-gds-pump.pump-code,
      381                                       input ub.pl-gds-pump.status_     )
      382       no-error.
      383       if error-status:error then do:
      384         return error return-value.
      385       end.
      386     end.
      387     create ub.pl-gds.
      388     assign
      389       ub.pl-gds.obj-type = pobj-type
      390       ub.pl-gds.obj-code = pobj-code
      391       ub.pl-gds.pl-code  = ppl-code
      392       ub.pl-gds.gds-code = pgds-code
      393       ub.pl-gds.status_  = 'тек':U
      394     .
      395   end.
      396   assign
      397    parresult = yes
      398   .
