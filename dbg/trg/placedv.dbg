        1   block-level on error undo, throw.
        2   define input  parameter pobj-type like ub.clients.obj-type     no-undo.
        3   define input  parameter pobj-code like ub.clients.obj-code     no-undo.
        4   define input  parameter ppl-code  like ub.place.pl-code        no-undo.
        5   define output parameter loc#log   as logical                   no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":u .
        7   define variable vss-author      as character no-undo init "$Author$":u .
        8   define variable vss-date        as character no-undo init "$Date$":u .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       10   define variable vss-archive     as character no-undo init "$Archive$":u .
       11   define variable vss-description as character no-undo init "Проверки возможности удаления резервуара" .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable v-shift-date as date      no-undo.
       82   define variable v-shift-num  as integer   no-undo.
       83   define variable v-shift-name as character no-undo.
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
       86     (input  pobj-type
       87     ,input  pobj-code
       88     ,output v-shift-date
       89     ,output v-shift-num
       90     ,output v-shift-name
       91     ) no-error .
       92     find last ub.shift-obj no-lock where
       93               ub.shift-obj.obj-type = pobj-type and
       94               ub.shift-obj.obj-code = pobj-code and
       95               ub.shift-obj.status_ = 'факт':U use-index stts no-error.
       96     if avail ub.shift-obj then do:
       97       find first ub.rvs-doc no-lock where
       98                 ub.rvs-doc.obj-type = ub.shift-obj.obj-type and
       99                 ub.rvs-doc.obj-code = ub.shift-obj.obj-code and
      100                 ub.rvs-doc.shift-date = ub.shift-obj.shift-date and
      101                 ub.rvs-doc.shift-num = ub.shift-obj.shift-num and
      102                 ub.rvs-doc.status_ = 'факт':U and
      103                 ub.rvs-doc.rvs-type = 'смена':U no-error.
      104       if avail ub.rvs-doc then do:
      105         for each ub.rvs-line no-lock where
      106                 ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code and
      107                 ub.rvs-line.pl-code = ppl-code:
      108           if ub.rvs-line.system-qnty <> 0 then do:
      109             return error
      110           ("объект " + pobj-type + string(pobj-code) + chr(10) +
      111           "резервуар " + string(ppl-code) + chr(10) +
      112           "топливо " + string(ub.rvs-line.gds-code) + chr(10) +
      113           "имеются ненулевые книжные остатки по сверке последней закрытой смены")
      114           .
      115           end.
      116           if ub.rvs-line.state-measure-qnty <> 0 then do:
      117             return error
      118           ("объект " + pobj-type + string(pobj-code) + chr(10) +
      119           "резервуар " + string(ppl-code) + chr(10) +
      120           "топливо " + string(ub.rvs-line.gds-code) + chr(10) +
      121           "имеются ненулевые подтвержденные фактические остатки по сверке последней закрытой смены")
      122           .
      123           end.
      124         end.
      125       end.
      126       else return error.
      127     end.
      128   find first ub.doc-pl no-lock where
      129              ub.doc-pl.obj-type = pobj-type and
      130              ub.doc-pl.obj-code = pobj-code and
      131              ub.doc-pl.pl-code  = ppl-code  no-error .
      132   if available ub.doc-pl
      133   then do:
      134     return error substitute( 'объект &1 &2&3резервуар &4&3документ "&5"&3топливо &6 привязано к резервуару.'
      135                            , ub.doc-pl.obj-type
      136                            , ub.doc-pl.obj-code
      137                            , chr(10)
      138                            , ub.doc-pl.pl-code
      139                            , ub.doc-pl.out-code
      140                            , ub.doc-pl.gds-code
      141                            ) .
      142   end.
      143   find first ub.pl-gds no-lock where ub.pl-gds.obj-type = pobj-type and
      144              ub.pl-gds.obj-code = pobj-code and
      145              ub.pl-gds.pl-code  = ppl-code  no-error .
      146              if available (ub.pl-gds) then do:
      147                return error .
      148              end.
      149   _deletion:
      150   do on error undo _deletion, return error return-value:
      151     for each ub.pl-pump-nozzle where
      152             ub.pl-pump-nozzle.obj-type = pobj-type and
      153             ub.pl-pump-nozzle.obj-code = pobj-code and
      154             ub.pl-pump-nozzle.pl-code  = ppl-code on error undo, return error return-value :
      155       delete ub.pl-pump-nozzle no-error.
      156       if error-status:error then do:
      157         undo _deletion, return error ("Не удалось удалить запись pl-pump-nozzle " + chr(10) +
      158                                       "объект " + pobj-type + string(pobj-code) + chr(10) +
      159                                       "резервуар " + string(ppl-code) + chr(10) +
      160                                       "ТРК " + string(ub.pl-pump-nozzle.pump-code) +
      161                                       "пистолет " + string(ub.pl-pump-nozzle.nozzle-code)).
      162       end.
      163     end.
      164     for each ub.pl-gds-pump where
      165              ub.pl-gds-pump.obj-type = pobj-type and
      166              ub.pl-gds-pump.obj-code = pobj-code and
      167              ub.pl-gds-pump.pl-code  = ppl-code on error undo, return error return-value :
      168       delete ub.pl-gds-pump no-error.
      169       if error-status:error then do:
      170         undo _deletion, return error ("Не удалось удалить запись pl-gds-pump " + chr(10) +
      171                                       "объект " + pobj-type + string(pobj-code) + chr(10) +
      172                                       "резервуар " + string(ppl-code) + chr(10) +
      173                                       "топливо " + string(ub.pl-gds-pump.gds-code) + chr(10) +
      174                                       "ТРК " + string(ub.pl-gds-pump.pump-code)).
      175       end.
      176     end.
      177     for each ub.pl-pump where
      178             ub.pl-pump.obj-type = pobj-type and
      179             ub.pl-pump.obj-code = pobj-code and
      180             ub.pl-pump.pl-code  = ppl-code  on error undo, return error return-value :
      181       delete ub.pl-pump no-error.
      182       if error-status:error then do:
      183         undo _deletion, return ("Не удалось удалить запись pl-pump " + chr(10) +
      184                                 "объект " + pobj-type + string(pobj-code) + chr(10) +
      185                                 "резервуар " + string(ppl-code) + chr(10) +
      186                                 "ТРК " + string(ub.pl-pump.pump-code)).
      187       end.
      188     end.
      189   end.
      190   assign
      191   loc#log = yes.
