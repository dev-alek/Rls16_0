     1028   define variable v-dopi2 as integer no-undo .
     1029   define buffer buf_dis-time-rule for ub.dis-time-rule .
     1030     do
     1031     on error undo, return error
     1032     :
     1033       find first buf_dis-time-rule no-lock where
     1034                 buf_dis-time-rule.time-rule-num = 50000  no-error .
     1035       if not available buf_dis-time-rule
     1036       or buf_dis-time-rule.des <> "v16_0.1" then do:
     1037         assign
     1038         v-dopi1 = integer(entry(2, buf_Dis-time-rule.des, "."))
     1039         v-dopi2 = integer(entry(2, "v16_0.1", "."))
     1040         no-error .
     1041         if error-status:error
