     1095   define variable v-md5-signature as character no-undo .
     1096   define new shared temp-table tt-dis-rule no-undo like ub.dis-rule . find first buf_temp-tables where buf_temp-tables.tbl-name = "dis-rule" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "dis-rule"    buf_temp-tables.buf-handle = buffer tt-dis-rule:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1097   define new shared temp-table tt-dis-cfg-rule no-undo like ub.dis-cfg-rule . find first buf_temp-tables where buf_temp-tables.tbl-name = "dis-cfg-rule" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "dis-cfg-rule"    buf_temp-tables.buf-handle = buffer tt-dis-cfg-rule:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1098   define new shared temp-table tt-dis-time-rule no-undo like ub.dis-time-rule . find first buf_temp-tables where buf_temp-tables.tbl-name = "dis-time-rule" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "dis-time-rule"    buf_temp-tables.buf-handle = buffer tt-dis-time-rule:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1099   define new shared temp-table tt-drt-prop no-undo like ub.drt-prop . find first buf_temp-tables where buf_temp-tables.tbl-name = "drt-prop" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "drt-prop"    buf_temp-tables.buf-handle = buffer tt-drt-prop:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1100   define buffer buf_tt-dis-rule for tt-dis-rule.
     1101   define buffer buf_tt-dis-time-rule for tt-dis-time-rule.
     1102   run waitfram-show in this-procedure ("Реинициализация шаблонов для правил скидок и расписаний").
     1103   main-block:
     1104   do
     1105   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1106   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1107   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1108   :
     1109     if ( g#db-num > 0 ) then return.
     1110     if not p-forced then do:
     1111       run check-dr-version in this-procedure (output v-check1).
     1112       run check-dtr-version in this-procedure (output v-check2).
     1113     end.
     1114     if v-check1
     1115     or p-forced
     1116     or v-check2
     1117     then do:
     1118       if (v-check1
     1119       or v-check2 )
     1120       and p-read-only then do:
     1121         return error substitute("&1 &2 &3&4До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!"
     1122                                 ,vss-workfile
     1123                                 ,vss-revision
     1124                                 ,vss-description
     1125                                 ,chr(10)).
     1126       end.
     1127        run gbl/md5.p (
     1128          input  "cmp/fixdr.txt"
     1129         ,output v-md5-signature
     1130         ) .
     1131       if v-md5-signature <> "28A7174A802DD8DA5830681AF2A890C5" then do:
     1132         message
     1133         substitute("Несовпадение файла эталонных записей по правилам скидок и расписаний (fixdr.txt) с контрольным числом")
     1134         view-as alert-box error .
     1135         undo, return error .
     1136       end.
     1137       run gbl/filename.p ( input "cmp/fixdr.txt"
     1138                           ,output v-full-path
     1139                           ,output v-path
     1140                           ,output v-file-name
     1141                           ,output v-file-name-no-ext
     1142                           ,output v-file-name-ext
     1143                           ) no-error .
     1144       if error-status:error then do:
     1145         message
     1146         substitute("Не найден файл эталонных записей по правилам скидок и расписаний (fixdr.txt)")
     1147         view-as alert-box error .
     1148         undo, return error .
     1149       end.
     1150       run str/diallog.w (
     1151             input ?
     1152           ,input this-procedure
     1153           ,input ('utl/upgimptt.p' + chr(4)  +
     1154                   '1' + chr(4) +
     1155                   '1' + chr(4) +
     1156                   '1' + chr(4) +
     1157                   '1')
     1158           ,input v-full-path
     1159           ,input yes
     1160           ,input 'Прервать'
     1161           ,input 'Чтение файла в память') no-error .
     1162       if error-status:error then do:
     1163         message
     1164         substitute("Ошибка при чтении в память файла эталонных записей по правилам скидок и расписаний (fixdr.txt)&1&2&1&3"
     1165                      , chr(10)
     1166                      , error-status:get-message(1)
     1167                      , return-value )
     1168         view-as alert-box error .
     1169         undo, return error .
     1170       end.
     1171       if v-check1 then do:
     1172         find first buf_tt-dis-rule no-lock where
     1173                   buf_tt-dis-rule.rule-num = 0  no-error.
     1174         if not available buf_tt-dis-rule
     1175         or buf_tt-dis-rule.des <> "v16_0.1" then do:
     1176           message
     1177           substitute("Версии шаблонов скидок в r-кодах и файле эталонных записей по правилам скидок и расписаний (fixdr.txt) НЕ СОВПАДАЮТ&1" +
     1178                      "в r-кодах - &2&1" +
     1179                      "в файле - &3"
     1180                      , chr(10)
     1181                      , "v16_0.1"
     1182                      , buf_tt-dis-rule.des
     1183                      )
     1184           view-as alert-box error .
     1185           undo, return error .
     1186         end.
     1187       end.
     1188       if v-check2 then do:
     1189         find first buf_tt-dis-time-rule no-lock where
     1190                   buf_tt-dis-time-rule.time-rule-num = 50000 no-error.
     1191         if not available buf_tt-dis-time-rule
     1192         or buf_tt-dis-time-rule.des <> "v16_0.1" then do:
     1193           message
     1194           substitute("Версии шаблонов расписаний в r-кодах и файле эталонных записей по правилам скидок и расписаний (fixdr.txt) НЕ СОВПАДАЮТ&1" +
     1195                      "в r-кодах - &2&1" +
     1196                      "в файле - &3"
     1197                      , chr(10)
     1198                      , "v16_0.1"
     1199                      , buf_tt-dis-time-rule.des
     1200                      )
     1201           view-as alert-box error .
     1202           undo, return error .
     1203         end.
     1204       end.
     1205       run add-dis-rules in this-procedure no-error .
     1206       if error-status:error then do:
     1207         run waitfram-hide in this-procedure .
     1208         assign
     1209         v-mes = substitute("Ошибки при инициализации правил скидок:&1&2 &3"
     1210                            , chr(10)
     1211                            , error-status:get-message(1)
     1212                            , return-value ).
     1213         if p-forced then do:
     1214           message
     1215           v-mes
     1216           view-as alert-box error .
     1217         end.
     1218         undo, return error v-mes.
     1219       end.
     1220     end.
     1221     if v-check2 or p-forced then do:
     1222       run add-dis-time-rules in this-procedure no-error .
     1223       if error-status:error then do:
     1224         run waitfram-hide in this-procedure .
     1225         assign
     1226         v-mes = substitute("Ошибки при инициализации расписаний:&1&2 &3"
     1227                            , chr(10)
     1228                            , error-status:get-message(1)
     1229                            , return-value ).
     1230         if p-forced then do:
     1231           message
     1232           v-mes
     1233           view-as alert-box error .
     1234         end.
     1235         undo, return error v-mes.
     1236       end.
     1237     end.
     1238     for each buf_temp-tables
     1239     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1240     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1241     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1242     :
     1243       if valid-handle(buf_temp-tables.tbl-handle) then do:
     1244         delete object buf_temp-tables.tbl-handle.
     1245        end.
     1246     end.
     1247   end.
     1248   run waitfram-hide in this-procedure .
     1249   procedure delete-dis-time-rules :
     1250   define variable v-recid as recid no-undo .
     1251   define variable v-templ-rl-root as integer no-undo .
     1252   define buffer buf_dis-time-rule for ub.dis-time-rule.
     1253   define buffer del_dis-time-rule for ub.dis-time-rule.
     1254   define buffer down_dis-time-rule for ub.dis-time-rule.
     1255   define buffer buf_dis-rule for ub.dis-rule.
     1256     do
     1257     on error undo, return error
     1258     :
     1259        for each buf_dis-time-rule where
     1260                 buf_dis-time-rule.time-rule-num >= 50000 + 13
     1261             AND buf_dis-time-rule.upper-time-rule-num = 50000 :
     1262           assign
     1263           buf_dis-time-rule.sts = integer('1':U)
     1264           v-recid = recid(buf_dis-time-rule)
     1265           v-templ-rl-root = buf_dis-time-rule.templ-rl-root
     1266           .
     1267           release buf_dis-time-rule.
     1268           for each down_dis-time-rule where
     1269                   down_dis-time-rule.templ-rl-root = v-templ-rl-root
     1270               AND down_dis-time-rule.upper-time-rule-num = v-templ-rl-root
     1271               AND down_dis-time-rule.lvl-num <> 0
     1272           on error undo, return error:
     1273             for each buf_dis-rule exclusive-lock where
     1274                               buf_dis-rule.time-rule-num = down_dis-time-rule.time-rule-num
     1275             on error undo, return error :
     1276               delete buf_dis-rule.
     1277             end.
     1278             delete down_dis-time-rule.
     1279           end.
     1280           find first del_dis-time-rule where recid(del_dis-time-rule) = v-recid.
     1281           delete del_dis-time-rule.
     1282        end.
     1283     end.
     1284   end procedure.
     1285   procedure delete-dis-rules :
     1286   define input parameter p-templ-rl-root as integer no-undo .
     1287   define variable v-recid as recid no-undo .
     1288   define variable v-templ-rl-root as integer no-undo .
     1289   define buffer buf_dis-rule for ub.dis-rule.
     1290   define buffer del_dis-rule for ub.dis-rule.
     1291   define buffer down_dis-rule for ub.dis-rule.
     1292     main-block:
     1293     do
     1294     on error undo, return error
     1295     :
     1296        for each buf_dis-rule where
     1297                 ((buf_dis-rule.rule-num >= 93
     1298                 and p-templ-rl-root = ?)
     1299                 or
     1300                 (buf_dis-rule.templ-rl-root = p-templ-rl-root))
     1301             AND buf_dis-rule.upper-rule-num = 0
     1302        on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1303        on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1304        on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1305        :
     1306           if p-templ-rl-root <> ?
     1307           and buf_dis-rule.templ-rl-root <> p-templ-rl-root then next.
     1308           assign
     1309           buf_dis-rule.sts = integer('1':U)
     1310           v-recid = recid(buf_dis-rule)
     1311           v-templ-rl-root = buf_dis-rule.templ-rl-root
     1312           .
     1313           release buf_dis-rule.
     1314           for each down_dis-rule where
     1315                   down_dis-rule.templ-rl-root = v-templ-rl-root
     1316               AND down_dis-rule.upper-rule-num = v-templ-rl-root
     1317           on error undo, return error:
     1318             delete down_dis-rule.
     1319           end.
     1320           find first del_dis-rule where recid(del_dis-rule) = v-recid.
     1321           delete del_dis-rule.
     1322        end.
     1323     end.
     1324   end procedure.
     1325   procedure add-dis-rules :
     1326   define variable v-num-rules as integer no-undo .
     1327   define buffer buf_tt-dis-rule for tt-dis-rule.
     1328   main-block:
     1329   do
     1330   on error undo, return error
     1331   :
     1332     assign
     1333     v-num-rules = 93
     1334     .
     1335     for each buf_tt-dis-rule where
     1336             buf_tt-dis-rule.rule-num <= v-num-rules
     1337     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1338     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1339     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1340     :
     1341       run create-dis-rule in this-procedure (
     1342                                                buffer buf_tt-dis-rule
     1343                                               ,input buf_tt-dis-rule.des
     1344                                               ,input buf_tt-dis-rule.dis-kat
     1345                                               ,input buf_tt-dis-rule.discnt-type
     1346                                               ,input buf_tt-dis-rule.doc-qnty
     1347                                               ,input buf_tt-dis-rule.tot-sum
     1348                                               ,input buf_tt-dis-rule.charkey_one
     1349                                               ,input buf_tt-dis-rule.charkey_two
     1350                                               ,input buf_tt-dis-rule.charkey_three
     1351                                               ,input buf_tt-dis-rule.deckey_one
     1352                                               ,input buf_tt-dis-rule.deckey_two
     1353                                               ,input buf_tt-dis-rule.deckey_three
     1354                                               ,input buf_tt-dis-rule.key#_one
     1355                                               ,input buf_tt-dis-rule.key#_two
     1356                                               ,input buf_tt-dis-rule.key#_three
     1357                                               ,input buf_tt-dis-rule.subject-type
     1358                                               ,input buf_tt-dis-rule.time-rule-num
     1359                                               ,input buf_tt-dis-rule.upper-rule-num
     1360                                               ,input buf_tt-dis-rule.value-type
     1361                                               ,input buf_tt-dis-rule.sts
     1362                                               ,input buf_tt-dis-rule.uniq-field
     1363                                               ,input buf_tt-dis-rule.other
     1364                                               ,input buf_tt-dis-rule.rule-num
     1365                                             ) no-error .
     1366       if error-status:error then do:
     1367         undo, return error return-value .
     1368       end.
     1369     end.
     1370   end.
     1371   end procedure.
     1372   procedure add-dis-time-rules :
     1373   define variable v-num-rules as integer no-undo .
     1374   define buffer buf_tt-dis-time-rule for tt-dis-time-rule.
     1375   main-block:
     1376   do
     1377   on error undo, return error
     1378   :
     1379     assign
     1380     v-num-rules = 13
     1381     .
     1382     for each buf_tt-dis-time-rule where
     1383             buf_tt-dis-time-rule.time-rule-num >= 50000
     1384        and  buf_tt-dis-time-rule.time-rule-num <= (v-num-rules + 50000)
     1385     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1386     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1387     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1388     :
     1389       run create-dis-time-rule in this-procedure (
     1390                                                buffer buf_tt-dis-time-rule
     1391                                               ,input buf_tt-dis-time-rule.des
     1392                                               ,input buf_tt-dis-time-rule.date-from
     1393                                               ,input buf_tt-dis-time-rule.date-to
     1394                                               ,input buf_tt-dis-time-rule.time-from
     1395                                               ,input buf_tt-dis-time-rule.time-to
     1396                                               ,input buf_tt-dis-time-rule.month-day
     1397                                               ,input buf_tt-dis-time-rule.week-day-0
     1398                                               ,input buf_tt-dis-time-rule.week-day-1
     1399                                               ,input buf_tt-dis-time-rule.week-day-2
     1400                                               ,input buf_tt-dis-time-rule.week-day-3
     1401                                               ,input buf_tt-dis-time-rule.week-day-4
     1402                                               ,input buf_tt-dis-time-rule.week-day-5
     1403                                               ,input buf_tt-dis-time-rule.week-day-6
     1404                                               ,input buf_tt-dis-time-rule.week-day-7
     1405                                               ,input buf_tt-dis-time-rule.upper-time-rule-num
     1406                                               ,input buf_tt-dis-time-rule.value-type
     1407                                               ,input buf_tt-dis-time-rule.sts
     1408                                               ,input buf_tt-dis-time-rule.uniq-field
     1409                                               ,input buf_tt-dis-time-rule.other
     1410                                               ,input buf_tt-dis-time-rule.time-rule-num
     1411                                             ) no-error .
     1412     end.
     1413   end.
     1414   end procedure.
     1415   procedure create-dis-rule :
     1416   define parameter buffer buf_tt-dis-rule for tt-dis-rule.
     1417   define input parameter  p-des               like ub.dis-rule.des               no-undo .
     1418   define input parameter  p-dis-kat           like ub.dis-rule.dis-kat           no-undo .
     1419   define input parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
     1420   define input parameter  p-doc-qnty          like ub.dis-rule.doc-qnty          no-undo .
     1421   define input parameter  p-tot-sum           like ub.dis-rule.tot-sum           no-undo .
     1422   define input parameter  p-charkey_one       like ub.dis-rule.charkey_one       no-undo .
     1423   define input parameter  p-charkey_two       like ub.dis-rule.charkey_two       no-undo .
     1424   define input parameter  p-charkey_three     like ub.dis-rule.charkey_three     no-undo .
     1425   define input parameter  p-deckey_one        like ub.dis-rule.deckey_one       no-undo .
     1426   define input parameter  p-deckey_two        like ub.dis-rule.deckey_two       no-undo .
     1427   define input parameter  p-deckey_three      like ub.dis-rule.deckey_three     no-undo .
     1428   define input parameter  p-key#_one          like ub.dis-rule.key#_one          no-undo .
     1429   define input parameter  p-key#_two          like ub.dis-rule.key#_two          no-undo .
     1430   define input parameter  p-key#_three        like ub.dis-rule.key#_three        no-undo .
     1431   define input parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
     1432   define input parameter  p-time-rule-num     like ub.dis-rule.time-rule-num     no-undo .
     1433   define input parameter  p-upper-rule-num    like ub.dis-rule.upper-rule-num    no-undo .
     1434   define input parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
     1435   define input parameter  p-sts               like ub.dis-rule.sts               no-undo .
     1436   define input parameter  p-tree              like ub.dis-rule.uniq-field        no-undo .
     1437   define input parameter  p-other             like ub.dis-rule.other-inf         no-undo .
     1438   define input parameter  p-rule-num          like ub.dis-rule.rule-num          no-undo .
     1439   define variable v-doc-rec as recid no-undo .
     1440   define variable v-exists as logical no-undo .
     1441   define variable v-level1 as character no-undo .
     1442   define variable v-level2 as character no-undo .
     1443   define variable v-curr-level as character no-undo .
     1444   define variable v-cmp-char as character no-undo .
     1445   define variable v-exists2 as logical   no-undo .
     1446   define buffer buf_dis-rule for ub.dis-rule.
     1447   define buffer down_dis-rule for ub.dis-rule.
     1448   define buffer buf_tt-dis-cfg-rule for tt-dis-cfg-rule.
     1449   on write of ub.dis-rule override do:
     1450   end.
     1451   main-block:
     1452   do
     1453   on error undo, return error
     1454   :
     1455     find first buf_tt-dis-cfg-rule no-lock where
     1456               buf_tt-dis-cfg-rule.templ-rl-root = p-rule-num
     1457           and  buf_tt-dis-cfg-rule.table-name = '':U
     1458           and  buf_tt-dis-cfg-rule.time-templ-rl-root = 0
     1459           and  buf_tt-dis-cfg-rule.pos-type = '':U
     1460           and  buf_tt-dis-cfg-rule.discnt-role = '':U no-error .
     1461     if not available buf_tt-dis-cfg-rule then do:
     1462     end.
     1463     assign
     1464     v-level1 = entry(1, buf_tt-dis-cfg-rule.other-inf, ";":U)
     1465     v-level2 = (if num-entries(buf_tt-dis-cfg-rule.other-inf, ";":U) > 1
     1466                   then entry(2, buf_tt-dis-cfg-rule.other-inf, ";":U)
     1467                   else '')
     1468     .
     1469     find first buf_dis-rule where
     1470               buf_dis-rule.rule-num = p-rule-num no-error.
     1471     if not available buf_dis-rule then do:
     1472       on write of ub.dis-rule revert.
     1473       create buf_dis-rule.
     1474       buffer-copy buf_tt-dis-rule to buf_Dis-rule.
     1475     end.
     1476     else do:
     1477       if
     1478       (buf_dis-rule.time-rule-num <> p-time-rule-num
     1479       and
     1480       lookup("time-rule-num", v-level1) = 0
     1481       and
     1482       lookup("time-rule-num", v-level2) = 0
     1483       and
     1484       (buf_dis-rule.sts = integer('1':U)
     1485        or
     1486        p-time-rule-num = -1)
     1487       ) then do:
     1488         assign
     1489         buf_dis-rule.time-rule-num = p-time-rule-num
     1490         .
     1491         release buf_dis-rule.
     1492         find first buf_dis-rule where
     1493                   buf_dis-rule.rule-num = p-rule-num no-error.
     1494       end.
     1495       on write of ub.dis-rule revert.
     1496       buffer-compare buf_dis-rule
     1497       using des discnt-type uniq-field other-inf dis-kat doc-qnty tot-sum
     1498             charkey_one charkey_two charkey_three
     1499             deckey_one deckey_two deckey_three
     1500             key#_one key#_two key#_three
     1501       to buf_tt-dis-rule
     1502       save result in v-cmp-char.
     1503       if v-cmp-char <> ''
     1504       then do:
     1505         buffer-copy buf_tt-dis-rule
     1506         using des discnt-type uniq-field other-inf dis-kat doc-qnty tot-sum
     1507               charkey_one charkey_two charkey_three
     1508               deckey_one deckey_two deckey_three
     1509               key#_one key#_two key#_three
     1510         to buf_dis-rule
     1511         assign
     1512         v-doc-rec                      = recid(buf_dis-rule)
     1513         v-exists                       = yes
     1514         .
     1515       end.
     1516       if buf_dis-rule.sts               <> (if p-sts <> integer('1':U)
     1517                                           then integer('0':U)
     1518                                           else integer('1':U)) then do:
     1519         assign
     1520         buf_dis-rule.sts               = (if p-sts <> integer('1':U)
     1521                                           then integer('0':U)
     1522                                           else integer('1':U))
     1523         v-doc-rec                      = recid(buf_dis-rule)
     1524         v-exists2                       = yes
     1525         .
     1526       end.
     1527       if buf_dis-rule.rule-num > 0 then do:
     1528         if v-exists
     1529         and v-cmp-char <> "des"
     1530         then do:
     1531           for each down_dis-rule where
     1532                   down_dis-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     1533               and down_dis-rule.lvl-num > 0
     1534           on error undo main-block, return error:
     1535             if down_dis-rule.upper-rule-num <= 99999 then do:
     1536               assign
     1537               v-curr-level = v-level1
     1538               .
     1539             end.
     1540             else do:
     1541               assign
     1542               v-curr-level = v-level2
     1543               .
     1544             end.
     1545             if
     1546             down_dis-rule.uniq-field        <> p-tree
     1547             or down_dis-rule.discnt-type <> p-discnt-type
     1548             or
     1549             down_dis-rule.other-inf         <> p-other
     1550             or ((down_dis-rule.dis-kat        <> p-dis-kat )
     1551                 and
     1552                 lookup("dis-kat", v-curr-level) = 0
     1553               )
     1554             or ((down_dis-rule.doc-qnty       <> p-doc-qnty)
     1555                 and
     1556                 lookup("doc-qnty", v-curr-level) = 0
     1557               )
     1558             or ((down_dis-rule.tot-sum       <> p-tot-sum)
     1559                 and
     1560                 lookup("tot-sum", v-curr-level) = 0
     1561               )
     1562             or ((down_dis-rule.charkey_one       <> p-charkey_one)
     1563                 and
     1564                 lookup("charkey_one", v-curr-level) = 0
     1565               )
     1566             or ((down_dis-rule.charkey_two       <> p-charkey_two)
     1567                 and
     1568                 lookup("charkey_two", v-curr-level) = 0
     1569               )
     1570             or ((down_dis-rule.charkey_three       <> p-charkey_three)
     1571                 and
     1572                 lookup("charkey_three", v-curr-level) = 0
     1573               )
     1574             or ((down_dis-rule.deckey_one       <> p-deckey_one)
     1575                 and
     1576                 lookup("deckey_one", v-curr-level) = 0
     1577               )
     1578             or ((down_dis-rule.deckey_two       <> p-deckey_two)
     1579                 and
     1580                 lookup("deckey_two", v-curr-level) = 0
     1581               )
     1582             or ((down_dis-rule.deckey_three       <> p-deckey_three)
     1583                 and
     1584                 lookup("deckey_three", v-curr-level) = 0
     1585               )
     1586             or ((down_dis-rule.key#_one       <> p-key#_one)
     1587                 and
     1588                 lookup("key#_one", v-curr-level) = 0
     1589               )
     1590             or ((down_dis-rule.key#_two       <> p-key#_two)
     1591                 and
     1592                 lookup("key#_two", v-curr-level) = 0
     1593               )
     1594             or ((down_dis-rule.key#_three       <> p-key#_three)
     1595                 and
     1596                 lookup("key#_three", v-curr-level) = 0
     1597               )
     1598             then do:
     1599               assign
     1600               down_dis-rule.uniq-field        = p-tree
     1601               down_dis-rule.discnt-type       = p-discnt-type
     1602               down_dis-rule.other-inf         = p-other
     1603               down_dis-rule.dis-kat           = (if p-dis-kat <> down_dis-rule.dis-kat
     1604                                                 and lookup("dis-kat", v-curr-level) = 0
     1605                                                 then p-dis-kat else down_dis-rule.dis-kat)
     1606               down_dis-rule.doc-qnty          = (if p-doc-qnty <> down_dis-rule.doc-qnty
     1607                                                 and lookup("doc-qnty", v-curr-level) = 0
     1608                                                 then p-doc-qnty else down_dis-rule.doc-qnty)
     1609               down_dis-rule.tot-sum           = (if p-tot-sum <> down_dis-rule.tot-sum
     1610                                                 and lookup("tot-sum", v-curr-level) = 0
     1611                                                 then p-tot-sum else down_dis-rule.tot-sum)
     1612               down_dis-rule.charkey_one       = (if p-charkey_one <> down_dis-rule.charkey_one
     1613                                                 and lookup("charkey_one", v-curr-level) = 0
     1614                                                 then p-charkey_one else down_dis-rule.charkey_one)
     1615               down_dis-rule.charkey_two       = (if p-charkey_two <> down_dis-rule.charkey_two
     1616                                                 and lookup("charkey_two", v-curr-level) = 0
     1617                                                 then p-charkey_two else down_dis-rule.charkey_two)
     1618               down_dis-rule.charkey_three     = (if p-charkey_three <> down_dis-rule.charkey_three
     1619                                                 and lookup("charkey_three", v-curr-level) = 0
     1620                                                 then p-charkey_three else down_dis-rule.charkey_three)
     1621               down_dis-rule.deckey_one       = (if p-deckey_one <> down_dis-rule.deckey_one
     1622                                                 and lookup("deckey_one", v-curr-level) = 0
     1623                                                 then p-deckey_one else down_dis-rule.deckey_one)
     1624               down_dis-rule.deckey_two       = (if p-deckey_two <> down_dis-rule.deckey_two
     1625                                                 and lookup("deckey_two", v-curr-level) = 0
     1626                                                 then p-deckey_two else down_dis-rule.deckey_two)
     1627               down_dis-rule.deckey_three     = (if p-deckey_three <> down_dis-rule.deckey_three
     1628                                                 and lookup("deckey_three", v-curr-level) = 0
     1629                                                 then p-deckey_three else down_dis-rule.deckey_three)
     1630               down_dis-rule.key#_one       = (if p-key#_one <> down_dis-rule.key#_one
     1631                                                 and lookup("key#_one", v-curr-level) = 0
     1632                                                 then p-key#_one else down_dis-rule.key#_one)
     1633               down_dis-rule.key#_two       = (if p-key#_two <> down_dis-rule.key#_two
     1634                                               and lookup("key#_two", v-curr-level) = 0
     1635                                               then p-key#_two else down_dis-rule.key#_two)
     1636               down_dis-rule.key#_three     = (if p-key#_three <> down_dis-rule.key#_three
     1637                                               and lookup("key#_three", v-curr-level) = 0
     1638                                               then p-key#_three else down_dis-rule.key#_three)
     1639             .
     1640               if down_dis-rule.lvl-num <> 1 then do:
     1641                 assign
     1642                 down_dis-rule.sts               =  (if down_dis-rule.sts <> integer('2':U)
     1643                                                     then integer('2':U)
     1644                                                     else down_dis-rule.sts)
     1645                 .
     1646               end.
     1647               release down_dis-rule no-error .
     1648               if error-status:error then undo, return error return-value .
     1649             end.
     1650           end.
     1651         end.
     1652         if v-exists2 then do:
     1653           for each down_dis-rule where
     1654                   down_dis-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     1655               AND down_dis-rule.lvl-num       <> 0
     1656           on error undo main-block, return error:
     1657             if down_dis-rule.lvl-num <> 1 then do:
     1658               assign
     1659               down_dis-rule.sts               =  (if down_dis-rule.sts <> integer('2':U)
     1660                                                   then integer('2':U)
     1661                                                   else down_dis-rule.sts)
     1662               .
     1663               release down_dis-rule no-error .
     1664               if error-status:error then undo, return error return-value.
     1665             end.
     1666           end.
     1667         end.
     1668       end.
     1669       run create-dis-cfg-rule in this-procedure ( input p-rule-num).
     1670       run create-drt-prop in this-procedure ( input p-rule-num).
     1671       return .
     1672     end.
     1673     run create-dis-cfg-rule in this-procedure ( input p-rule-num).
     1674     run create-drt-prop in this-procedure ( input p-rule-num).
     1675   end.
     1676   end procedure.
     1677   procedure create-dis-time-rule :
     1678   define parameter buffer buf_tt-dis-time-rule for tt-dis-time-rule.
     1679   define input parameter  p-des               like ub.dis-rule.des               no-undo .
     1680   define input parameter  p-date-from         like ub.dis-time-rule.date-from no-undo .
     1681   define input parameter  p-date-to           like ub.dis-time-rule.date-to  no-undo .
     1682   define input parameter  p-time-from         like ub.dis-time-rule.time-from  no-undo .
     1683   define input parameter  p-time-to           like ub.dis-time-rule.time-to  no-undo .
     1684   define input parameter  p-month-day         like ub.dis-time-rule.month-day no-undo .
     1685   define input parameter  p-week-day-0        like ub.dis-time-rule.week-day-0 no-undo .
     1686   define input parameter  p-week-day-1        like ub.dis-time-rule.week-day-1 no-undo .
     1687   define input parameter  p-week-day-2        like ub.dis-time-rule.week-day-2 no-undo .
     1688   define input parameter  p-week-day-3        like ub.dis-time-rule.week-day-3 no-undo .
     1689   define input parameter  p-week-day-4        like ub.dis-time-rule.week-day-4 no-undo .
     1690   define input parameter  p-week-day-5        like ub.dis-time-rule.week-day-5 no-undo .
     1691   define input parameter  p-week-day-6        like ub.dis-time-rule.week-day-6 no-undo .
     1692   define input parameter  p-week-day-7        like ub.dis-time-rule.week-day-7 no-undo .
     1693   define input parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
     1694   define input parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
     1695   define input parameter  p-sts               like ub.dis-time-rule.sts no-undo .
     1696   define input parameter  p-tree              like ub.dis-time-rule.uniq-field        no-undo .
     1697   define input parameter  p-other             like ub.dis-time-rule.other-inf         no-undo .
     1698   define input parameter  p-time-rule-num     like ub.dis-time-rule.time-rule-num          no-undo .
     1699   define variable v-doc-rec as recid no-undo .
     1700   define variable v-exists as logical no-undo .
     1701   define variable v-exitst2 as logical   no-undo .
     1702   define variable v-level1 as character no-undo .
     1703   define variable v-level2 as character no-undo .
     1704   define variable v-curr-level as character no-undo .
     1705   define buffer buf_dis-time-rule for ub.dis-time-rule.
     1706   define buffer down_dis-time-rule for ub.dis-time-rule.
     1707   define buffer buf_tt-dis-cfg-rule for tt-dis-cfg-rule.
     1708   on write of ub.dis-time-rule override do: end.
     1709   main-block:
     1710   do
     1711   on error undo, return error
     1712   :
     1713     find first buf_tt-dis-cfg-rule no-lock where
     1714               buf_tt-dis-cfg-rule.time-templ-rl-root = p-time-rule-num
     1715           and  buf_tt-dis-cfg-rule.table-name = '':U
     1716           and  buf_tt-dis-cfg-rule.templ-rl-root = 0
     1717           and  buf_tt-dis-cfg-rule.pos-type = '':U
     1718           and  buf_tt-dis-cfg-rule.discnt-role = '':U no-error .
     1719     if not available buf_tt-dis-cfg-rule then do:
     1720     end.
     1721     assign
     1722     v-level1 = entry(1, buf_tt-dis-cfg-rule.other-inf, ";":U)
     1723     v-level2 = (if num-entries(buf_tt-dis-cfg-rule.other-inf, ";":U) > 1
     1724                   then entry(2, buf_tt-dis-cfg-rule.other-inf, ";":U)
     1725                   else '')
     1726     .
     1727     find first buf_dis-time-rule where
     1728               buf_dis-time-rule.time-rule-num  = p-time-rule-num  no-error.
     1729     if not available buf_dis-time-rule then do:
     1730       on write of ub.dis-time-rule revert.
     1731       create buf_dis-time-rule.
     1732       assign
     1733       buf_dis-time-rule.time-rule-num          = p-time-rule-num
     1734       v-exists = yes
     1735       .
     1736     end.
     1737     else do:
     1738       if buf_dis-time-rule.des <> p-des
     1739       or
     1740       buf_dis-time-rule.uniq-field        <> p-tree
     1741       or
     1742       buf_dis-time-rule.other-inf         <> p-other
     1743       or
     1744       buf_dis-time-rule.sts               <> (if p-sts <> integer('1':U)
     1745                                               then integer('0':U)
     1746                                               else integer('1':U))
     1747       then do:
     1748         assign
     1749         buf_dis-time-rule.des               = p-des
     1750         buf_dis-time-rule.uniq-field        = p-tree
     1751         buf_dis-time-rule.other-inf         = p-other
     1752         buf_dis-time-rule.sts               = (if p-sts <> integer('1':U)
     1753                                                 then integer('0':U)
     1754                                                 else integer('1':U))
     1755         v-exists = yes
     1756         .
     1757       end.
     1758       if buf_dis-time-rule.time-rule-num <> 50000 then do:
     1759         for each down_dis-time-rule where
     1760                 down_dis-time-rule.templ-rl-root = buf_dis-time-rule.templ-rl-root
     1761             AND  down_dis-time-rule.lvl-num       <> 0
     1762         on error undo main-block, return error:
     1763           if down_dis-time-rule.upper-time-rule-num <= 99999 then do:
     1764             assign
     1765             v-curr-level = v-level1
     1766             .
     1767           end.
     1768           else do:
     1769             assign
     1770             v-curr-level = v-level2
     1771             .
     1772           end.
     1773           if down_dis-time-rule.uniq-field        <> p-tree
     1774           or
     1775           down_dis-time-rule.other-inf         <> p-other
     1776           or ((down_dis-time-rule.time-from       <> p-time-from)
     1777               and
     1778               lookup("time-from", v-curr-level) = 0
     1779             )
     1780           or ((down_dis-time-rule.time-to       <> p-time-to)
     1781               and
     1782               lookup("time-to", v-curr-level) = 0
     1783             )
     1784           or ((down_dis-time-rule.date-from       <> p-date-from)
     1785               and
     1786               lookup("date-from", v-curr-level) = 0
     1787             )
     1788           or ((down_dis-time-rule.date-to       <> p-date-to)
     1789               and
     1790               lookup("date-to", v-curr-level) = 0
     1791             )
     1792           or ((down_dis-time-rule.week-day-0       <> p-week-day-0)
     1793               and
     1794               lookup("week-day-0", v-curr-level) = 0
     1795             )
     1796           or ((down_dis-time-rule.week-day-1       <> p-week-day-1)
     1797               and
     1798               lookup("week-day-1", v-curr-level) = 0
     1799             )
     1800           or ((down_dis-time-rule.week-day-2       <> p-week-day-2)
     1801               and
     1802               lookup("week-day-2", v-curr-level) = 0
     1803             )
     1804           or ((down_dis-time-rule.week-day-3       <> p-week-day-3)
     1805               and
     1806               lookup("week-day-3", v-curr-level) = 0
     1807             )
     1808           or ((down_dis-time-rule.week-day-4       <> p-week-day-4)
     1809               and
     1810               lookup("week-day-4", v-curr-level) = 0
     1811             )
     1812           or ((down_dis-time-rule.week-day-5       <> p-week-day-5)
     1813               and
     1814               lookup("week-day-5", v-curr-level) = 0
     1815             )
     1816           or ((down_dis-time-rule.week-day-6       <> p-week-day-6)
     1817               and
     1818               lookup("week-day-6", v-curr-level) = 0
     1819             )
     1820           or ((down_dis-time-rule.week-day-7       <> p-week-day-7)
     1821               and
     1822               lookup("week-day-7", v-curr-level) = 0
     1823             )
     1824           or ((down_dis-time-rule.month-day       <> p-month-day)
     1825               and
     1826               lookup("month-day", v-curr-level) = 0
     1827             )
     1828           then do:
     1829             assign
     1830             down_dis-time-rule.uniq-field        = p-tree
     1831             down_dis-time-rule.other-inf         = p-other
     1832             down_dis-time-rule.date-from        = p-date-from
     1833             down_dis-time-rule.date-to          = p-date-to
     1834             down_dis-time-rule.time-from        = (if  ((down_dis-time-rule.time-from       <> p-time-from)
     1835                                                     and
     1836                                                     lookup("time-from", v-curr-level) = 0
     1837                                                         )
     1838                                                   then p-time-from
     1839                                                   else down_dis-time-rule.time-from)
     1840             down_dis-time-rule.time-to          = (if  ((down_dis-time-rule.time-to       <> p-time-to)
     1841                                                     and
     1842                                                     lookup("time-to", v-curr-level) = 0
     1843                                                         )
     1844                                                   then p-time-to
     1845                                                   else down_dis-time-rule.time-to)
     1846             down_dis-time-rule.week-day-0       = (if ((down_dis-time-rule.week-day-0       <> p-week-day-0)
     1847                                                       and
     1848                                                       lookup("week-day-0", v-curr-level) = 0
     1849                                                     )
     1850                                                   then p-week-day-0
     1851                                                   else down_dis-time-rule.week-day-0)
     1852             down_dis-time-rule.week-day-1       = (if ((down_dis-time-rule.week-day-1       <> p-week-day-1)
     1853                                                       and
     1854                                                       lookup("week-day-1", v-curr-level) = 0
     1855                                                     )
     1856                                                   then p-week-day-1
     1857                                                   else down_dis-time-rule.week-day-1)
     1858             down_dis-time-rule.week-day-2       = (if ((down_dis-time-rule.week-day-2       <> p-week-day-2)
     1859                                                       and
     1860                                                       lookup("week-day-2", v-curr-level) = 0
     1861                                                     )
     1862                                                   then p-week-day-2
     1863                                                   else down_dis-time-rule.week-day-2)
     1864             down_dis-time-rule.week-day-3       = (if ((down_dis-time-rule.week-day-3       <> p-week-day-3)
     1865                                                       and
     1866                                                       lookup("week-day-3", v-curr-level) = 0
     1867                                                     )
     1868                                                   then p-week-day-3
     1869                                                   else down_dis-time-rule.week-day-3)
     1870             down_dis-time-rule.week-day-4       = (if ((down_dis-time-rule.week-day-4       <> p-week-day-4)
     1871                                                       and
     1872                                                       lookup("week-day-4", v-curr-level) = 0
     1873                                                     )
     1874                                                   then p-week-day-4
     1875                                                   else down_dis-time-rule.week-day-4)
     1876             down_dis-time-rule.week-day-5       = (if ((down_dis-time-rule.week-day-5       <> p-week-day-5)
     1877                                                       and
     1878                                                       lookup("week-day-5", v-curr-level) = 0
     1879                                                     )
     1880                                                   then p-week-day-5
     1881                                                   else down_dis-time-rule.week-day-5)
     1882             down_dis-time-rule.week-day-6       = (if ((down_dis-time-rule.week-day-6       <> p-week-day-6)
     1883                                                       and
     1884                                                       lookup("week-day-6", v-curr-level) = 0
     1885                                                     )
     1886                                                   then p-week-day-6
     1887                                                   else down_dis-time-rule.week-day-6)
     1888             down_dis-time-rule.week-day-7       = (if ((down_dis-time-rule.week-day-7       <> p-week-day-7)
     1889                                                       and
     1890                                                       lookup("week-day-7", v-curr-level) = 0
     1891                                                     )
     1892                                                   then p-week-day-7
     1893                                                   else down_dis-time-rule.week-day-7)
     1894             down_dis-time-rule.month-day       = (if ((down_dis-time-rule.month-day       <> p-month-day)
     1895                                                       and
     1896                                                       lookup("month-day", v-curr-level) = 0
     1897                                                     )
     1898                                                   then p-month-day
     1899                                                   else down_dis-time-rule.month-day)
     1900             .
     1901             release down_dis-time-rule no-error .
     1902             if error-status:error then undo, return error return-value .
     1903           end.
     1904         end.
     1905         for each down_dis-time-rule where
     1906                 down_dis-time-rule.templ-rl-root = buf_dis-time-rule.templ-rl-root
     1907             AND down_dis-time-rule.lvl-num       > 0
     1908         on error undo main-block, return error:
     1909           if down_dis-time-rule.lvl-num <> 1 then do:
     1910             assign
     1911             down_dis-time-rule.sts               =  (if down_dis-time-rule.sts <> integer('2':U)
     1912                                                 then integer('2':U)
     1913                                                 else down_dis-time-rule.sts)
     1914             .
     1915             release down_dis-time-rule no-error .
     1916             if error-status:error then undo, return error return-value.
     1917           end.
     1918         end.
     1919       end.
     1920       run create-drt-prop in this-procedure ( input p-time-rule-num).
     1921       return .
     1922     end.
     1923     if buf_dis-time-rule.des <> p-des
     1924     or
     1925     buf_dis-time-rule.date-from         <> p-date-from
     1926     or
     1927     buf_dis-time-rule.date-to           <> p-date-to
     1928     or
     1929     buf_dis-time-rule.time-from         <> p-time-from
     1930     or
     1931     buf_dis-time-rule.time-to           <> p-time-to
     1932     or
     1933     buf_dis-time-rule.month-day         <> p-month-day
     1934     or
     1935     buf_dis-time-rule.week-day-0        <> p-week-day-0
     1936     or
     1937     buf_dis-time-rule.week-day-1        <> p-week-day-1
     1938     or
     1939     buf_dis-time-rule.week-day-2        <> p-week-day-2
     1940     or
     1941     buf_dis-time-rule.week-day-3        <> p-week-day-3
     1942     or
     1943     buf_dis-time-rule.week-day-4        <> p-week-day-4
     1944     or
     1945     buf_dis-time-rule.week-day-5        <> p-week-day-5
     1946     or
     1947     buf_dis-time-rule.week-day-6        <> p-week-day-6
     1948     or
     1949     buf_dis-time-rule.week-day-7        <> p-week-day-7
     1950     or
     1951     buf_dis-time-rule.sts               <> (if p-sts <> integer('1':U)
     1952                                             then integer('0':U)
     1953                                             else integer('1':U))
     1954     or
     1955     buf_dis-time-rule.upper-time-rule-num    <> p-upper-time-rule-num
     1956     or
     1957     buf_dis-time-rule.value-type        <> p-value-type
     1958     or
     1959     buf_dis-time-rule.root              <> yes
     1960     or
     1961     buf_dis-time-rule.lvl-num           <> 0
     1962     or
     1963     buf_dis-time-rule.is-term           <> yes
     1964     or
     1965     buf_dis-time-rule.uniq-field        <> p-tree
     1966     or
     1967     buf_dis-time-rule.other-inf         <> p-other
     1968     or
     1969     buf_dis-time-rule.rl-root           <> p-time-rule-num
     1970     or
     1971     buf_dis-time-rule.templ-rl-root     <> p-time-rule-num
     1972     then do:
     1973       assign
     1974       buf_dis-time-rule.des                   = p-des
     1975       buf_dis-time-rule.upper-time-rule-num    = p-upper-time-rule-num
     1976       buf_dis-time-rule.date-from         = p-date-from
     1977       buf_dis-time-rule.date-to           = p-date-to
     1978       buf_dis-time-rule.time-from         = p-time-from
     1979       buf_dis-time-rule.time-to           = p-time-to
     1980       buf_dis-time-rule.month-day         = p-month-day
     1981       buf_dis-time-rule.week-day-0        = p-week-day-0
     1982       buf_dis-time-rule.week-day-1        = p-week-day-1
     1983       buf_dis-time-rule.week-day-2        = p-week-day-2
     1984       buf_dis-time-rule.week-day-3        = p-week-day-3
     1985       buf_dis-time-rule.week-day-4        = p-week-day-4
     1986       buf_dis-time-rule.week-day-5        = p-week-day-5
     1987       buf_dis-time-rule.week-day-6        = p-week-day-6
     1988       buf_dis-time-rule.week-day-7        = p-week-day-7
     1989       buf_dis-time-rule.value-type        = p-value-type
     1990       buf_dis-time-rule.root              = yes
     1991       buf_dis-time-rule.lvl-num           = 0
     1992       buf_dis-time-rule.is-term           = yes
     1993       buf_dis-time-rule.uniq-field        = p-tree
     1994       buf_dis-time-rule.other-inf         = p-other
     1995       buf_dis-time-rule.rl-root           = p-time-rule-num
     1996       buf_dis-time-rule.templ-rl-root     = p-time-rule-num
     1997       buf_dis-time-rule.sts               = (if p-sts <> integer('1':U)
     1998                                               then integer('0':U)
     1999                                               else integer('1':U))
     2000       .
     2001       release buf_dis-time-rule no-error .
     2002       if error-status:error then undo, return error return-value .
     2003     end.
     2004   end.
     2005   end procedure.
     2006   procedure create-dis-cfg-rule :
     2007   define input parameter p-rule-num as integer no-undo .
     2008   define buffer buf_tt-dis-cfg-rule for tt-dis-cfg-rule.
     2009   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     2010   define buffer buf2_dis-cfg-rule for ub.dis-cfg-rule.
     2011   main-block:
     2012   do
     2013   on error undo, return error
     2014   :
     2015     for each buf_tt-dis-cfg-rule no-lock where
     2016            buf_tt-dis-cfg-rule.templ-rl-root = p-rule-num
     2017     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2018     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2019     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2020     :
     2021       find first buf_dis-cfg-rule share-lock where
     2022                 buf_dis-cfg-rule.templ-rl-root = buf_tt-dis-cfg-rule.templ-rl-root
     2023             and buf_dis-cfg-rule.table-name = buf_tt-dis-cfg-rule.table-name
     2024             and buf_dis-cfg-rule.pos-type = buf_tt-dis-cfg-rule.pos-type
     2025             and buf_dis-cfg-rule.time-templ-rl-root = buf_tt-dis-cfg-rule.time-templ-rl-root
     2026             and buf_dis-cfg-rule.self-nonunique = buf_tt-dis-cfg-rule.self-nonunique no-error.
     2027       if not available buf_dis-cfg-rule then do:
     2028         create buf_dis-cfg-rule.
     2029       end.
     2030       buffer-copy buf_tt-dis-cfg-rule
     2031       to buf_dis-cfg-rule.
     2032     end.
     2033     for each buf_dis-cfg-rule no-lock where
     2034             buf_dis-cfg-rule.templ-rl-root = p-rule-num
     2035     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2036     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2037     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2038     :
     2039       find first buf_tt-dis-cfg-rule where
     2040               buf_tt-dis-cfg-rule.templ-rl-root = buf_dis-cfg-rule.templ-rl-root
     2041           and buf_tt-dis-cfg-rule.table-name = buf_dis-cfg-rule.table-name
     2042           and buf_tt-dis-cfg-rule.pos-type = buf_dis-cfg-rule.pos-type
     2043           and buf_tt-dis-cfg-rule.time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
     2044           and buf_tt-dis-cfg-rule.self-nonunique = buf_dis-cfg-rule.self-nonunique
     2045           no-error .
     2046       if not available buf_tt-dis-cfg-rule then do:
     2047         find first buf2_dis-cfg-rule exclusive-lock where
     2048                   recid(buf2_dis-cfg-rule) = recid(buf_dis-cfg-rule).
     2049         delete buf2_dis-cfg-rule.
     2050       end.
     2051     end.
     2052   end.
     2053   end procedure.
     2054   procedure create-drt-prop :
     2055   define input parameter p-templ-rl-root as integer no-undo .
     2056   define buffer buf_tt-drt-prop for tt-drt-prop.
     2057   define buffer buf_drt-prop for ub.drt-prop.
     2058   define buffer buf2_drt-prop for ub.drt-prop.
     2059   main-block:
     2060   do
     2061   on error undo, return error
     2062   :
     2063     for each buf_tt-drt-prop no-lock where
     2064             buf_tt-drt-prop.templ-rl-root = p-templ-rl-root
     2065     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2066     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2067     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2068     :
     2069       find first buf_drt-prop share-lock where
     2070                 buf_drt-prop.templ-rl-root = buf_tt-drt-prop.templ-rl-root
     2071             and buf_drt-prop.node-code = buf_tt-drt-prop.node-code no-error.
     2072       if not available buf_drt-prop then do:
     2073         create buf_drt-prop.
     2074       end.
     2075       buffer-copy buf_tt-drt-prop to buf_drt-prop.
     2076     end.
     2077     for each buf_drt-prop no-lock where
     2078             buf_drt-prop.templ-rl-root = p-templ-rl-root
     2079     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2080     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2081     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2082     :
     2083       find first buf_tt-drt-prop where
     2084               buf_tt-drt-prop.templ-rl-root = buf_drt-prop.templ-rl-root
     2085           and buf_tt-drt-prop.node-code = buf_drt-prop.node-code no-error .
     2086       if not available buf_tt-drt-prop then do:
     2087         find first buf2_drt-prop exclusive-lock where
     2088                   recid(buf2_drt-prop) = recid(buf_drt-prop).
     2089         delete buf2_drt-prop.
     2090       end.
     2091     end.
     2092   end.
     2093   end procedure.
