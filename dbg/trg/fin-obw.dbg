     1010   define variable v-value-decimal   as decimal   no-undo .
     1011   define variable v-fo-buyer-nws    as integer   no-undo .
     1012   define variable v-fo-supp-nws     as integer   no-undo .
     1013   define variable v-value-logical   as logical   no-undo .
     1014   define variable par-type          as character no-undo .
     1015   define variable v-activ-side as logical   no-undo .
     1016   main-block :
     1017   do transaction
     1018   on error undo main-block, return error
     1019   :
     1020   run adm/shattri.p (
     1021     input "get":U
     1022     ,input ""
     1023     ,input 0
     1024     ,input 'fin-global':U
     1025     ,input  ""
     1026     ,output v-value-character
     1027     ,output v-value-date
     1028     ,output v-value-decimal
     1029     ,output v-fo-buyer-nws
     1030     ,output v-value-logical
     1031     ,output par-type
     1032     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1033     ) no-error .
     1034   find first thbjattr_thbj-attr where
     1035              thbjattr_thbj-attr.obj-code  = 0  and
     1036              thbjattr_thbj-attr.obj-type  = ""  and
     1037              thbjattr_thbj-attr.prop-code = 'fo-buyer-nws':U and
     1038              thbjattr_thbj-attr.upper-prop-code = 'fin-global':U  no-error .
     1039   .
     1040   if error-status :error then do:
     1041      message
     1042        vss-workfile vss-revision vss-description skip
     1043        error-status :get-message(1) skip
     1044        return-value skip
     1045        ""
     1046        view-as alert-box error
     1047      .
     1048       return error return-value .
     1049   end.
     1050   v-fo-buyer-nws = thbjattr_thbj-attr.property-value-integer .
     1051   find first thbjattr_thbj-attr where
     1052              thbjattr_thbj-attr.obj-code  = 0  and
     1053              thbjattr_thbj-attr.obj-type  = ""  and
     1054              thbjattr_thbj-attr.prop-code = 'fo-supp-nws':U and
     1055              thbjattr_thbj-attr.upper-prop-code = 'fin-global':U  no-error .
     1056   .
     1057   if error-status :error then do:
     1058      message
     1059        vss-workfile vss-revision vss-description skip
     1060        error-status :get-message(1) skip
     1061        return-value skip
     1062        ""
     1063        view-as alert-box error
     1064      .
     1065       return error return-value .
     1066   end.
     1067   v-fo-supp-nws = thbjattr_thbj-attr.property-value-integer .
     1068   if ub.fin-ob.pay-date <> old_fin-ob.pay-date then do:
     1069      ub.fin-ob.user-name-pay = g#userid .
     1070   end.
     1071   find first buf_sysconf no-lock where buf_sysconf.host-code = ub.fin-ob.host-code.
     1072     if not g#news then do:
     1073       if ub.fin-ob.doc-type = 'рас':U then do:
     1074           if buf_sysconf.firm-db-num <> g#db-num then do:
     1075             message
     1076             vss-workfile vss-revision vss-description skip
     1077             "Нельзя изменять запись ФИН обязательств в БД, отличной от главной БД фирмы" skip
     1078             "Номер текущей БД" g#db-num "Номер главной БД фирмы" buf_sysconf.firm-db-num
     1079             view-as alert-box error .
     1080             undo, return error .
     1081           end.
     1082       end.
     1083     end.
     1084     if not new(ub.fin-ob) then do:
     1085       if not g#news then do:
     1086         if ub.fin-ob.receiver-code = 0 or ub.fin-ob.receiver-code = ? then do:
     1087           message vss-workfile vss-revision vss-description skip
     1088           "Не задан код контрагента !"  view-as alert-box information .
     1089           return error .
     1090         end.
     1091         if ub.fin-ob.payer-code = 0 or ub.fin-ob.payer-code = ? then do:
     1092           message
     1093           vss-workfile vss-revision vss-description skip
     1094           "Не задан код плательщика !"  view-as alert-box information .
     1095           return error .
     1096         end.
     1097         if not can-find (first ub.clients where ub.clients.obj-code = ub.fin-ob.receiver-code
     1098                                         and ub.clients.obj-type = ub.fin-ob.receiver-type no-lock )
     1099           then do:
     1100           message
     1101           vss-workfile vss-revision vss-description skip
     1102           "Не верно выбран получатель !"  view-as alert-box information .
     1103           return error .
     1104         end.
     1105         if not can-find (first ub.clients where ub.clients.obj-code = ub.fin-ob.payer-code
     1106                                             and ub.clients.obj-type = ub.fin-ob.payer-type no-lock )
     1107           then do:
     1108           message vss-workfile vss-revision vss-description skip
     1109           "Не верно выбран плательшик !"  view-as alert-box information .
     1110           return error .
     1111         end.
     1112       end.
     1113       run cur-time in this-procedure(output v-date, output v-time).
     1114       create buf_c-fin-ob.
     1115       buffer-copy old_fin-ob to buf_c-fin-ob
     1116       assign
     1117       buf_c-fin-ob.chip-num           = next-value (s-corr-chip, ub)
     1118       buf_c-fin-ob.corr-time          = v-time
     1119       buf_c-fin-ob.corr-user-db-num   = g#db-num
     1120       buf_c-fin-ob.corr-user-name     = g#userid
     1121       buf_c-fin-ob.corr-date          = v-date
     1122       .
     1123     end.
     1124     if ub.fin-ob.status_ = 'факт':U and not g#news then do:
     1125         if ub.fin-ob.doc-type = 'рас':U then do:
     1126             if g#db-num = 0 and v-fo-supp-nws = 1 then do:
     1127                   run str/callnews.p
     1128                   (input "fin-ob"
     1129                   ,input (buffer ub.fin-ob:handle)
     1130                   ) no-error .
     1131                 if error-status:error then do:
     1132                   message
     1133                     vss-workfile vss-revision vss-description skip
     1134                     "Ошибка при передаче в новости ФО" skip
     1135                     return-value skip
     1136                     view-as alert-box error .
     1137                     return error.
     1138                 end.
     1139             end.
     1140         end.
     1141         if ub.fin-ob.doc-type = 'при':U then do:
     1142   if (valid-handle(g#libofarh) <> true) then do:   run str/libofarh.p persistent no-error .   if error-status :error or (valid-handle(g#libofarh) <> true) then do:     message       "Error starting libofarh.p" skip       g#libofarh skip       g#libofarh :type skip       g#libofarh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libofarh_fo-activ in g#libofarh (
     1143    input ub.fin-ob.host-code
     1144   ,input ub.fin-ob.doc-code
     1145   ,input g#db-num
     1146   ,output v-activ-side
     1147   )
     1148   .
     1149           if v-activ-side = true and v-fo-buyer-nws = 0 then do:
     1150                   run str/callnews.p
     1151                   (input "fin-ob"
     1152                   ,input (buffer ub.fin-ob:handle)
     1153                   ) no-error .
     1154                 if error-status:error then do:
     1155                   message
     1156                     vss-workfile vss-revision vss-description skip
     1157                     "Ошибка при передаче в новости ФО" skip
     1158                     return-value skip
     1159                     view-as alert-box error .
     1160                     return error.
     1161                 end.
     1162             end.
     1163           if g#db-num = 0 and v-fo-buyer-nws = 1 then do:
     1164                   run str/callnews.p
     1165                   (input "fin-ob"
     1166                   ,input (buffer ub.fin-ob:handle)
     1167                   ) no-error .
     1168                 if error-status:error then do:
     1169                   message
     1170                     vss-workfile vss-revision vss-description skip
     1171                     "Ошибка при передаче в новости ФО" skip
     1172                     return-value skip
     1173                     view-as alert-box error .
     1174                     return error.
     1175                 end.
     1176             end.
     1177         end.
     1178     end.
     1179       if g#oxml = yes
     1180       then do:
     1181       run str/calloxml.p (
     1182             input 'update':U
     1183           , input 'fin-ob':U
     1184           , input ( buffer ub.fin-ob:handle )
     1185       ) no-error.
     1186       if error-status :error
     1187       then do:
     1188           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1189                                , chr(10)
     1190                                , vss-workfile
     1191                                , return-value
     1192                                , error-status :get-message ( 1 ) ).
     1193       end.
     1194       end.
     1195   end.
