      771       (input  p-upper-code
      772       ,input  p-code
      773       ,output p-label
      774       ,output p-user-can-edit
      775       ,output p-output-display
      776       ,output p-other
      777       ,output p-prop-list
      778       ,output p-prop-type-list
      779       ,output p-prop-label-list
      780       ,output p-global
      781       ,output p-host
      782       ,output p-shop
      783       ,output p-store
      784       ,output p-db
      785       ,output p-region
      786       ) no-error .
      787     if error-status :error
      788     then do:
      789       undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1)).
      790     end.
