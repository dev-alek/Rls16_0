        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.gds-grp.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление группы товара".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3',ub.gds-grp.node-code,ub.gds-grp.upper-code,ub.gds-grp.node-name)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   define new global shared variable g#lib-nws as handle no-undo .
      309   procedure goodsh_write-goods-proc  :
      310   define parameter buffer buf_goods for ub.goods .
      311   define input parameter p-action as integer no-undo .
      312   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      313   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      314   define variable v-date as date      no-undo.
      315   define variable v-time  as integer   no-undo.
      316   define buffer buf_c-gds-hist for ub.c-gds-hist.
      317   define buffer buf_c-goods for ub.c-goods.
      318     do
      319     on error undo, return error
      320     :
      321       if not available buf_goods then do:
      322         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      323                       "Ошибка задания входных параметров:Не определен товар" ).
      324       end.
      325       if g#news then do:
      326         define variable v-send as integer no-undo .
      327         v-send = integer('0':U).
      328   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      330     (input  g#db-num
      331     ,input  'goods':U
      332     ,input  0
      333     ,input  '':U
      334     ,input  0
      335     ,input  '':U
      336     ,input  '':U
      337     ,input  '':U
      338     ,input  0
      339     ,input  0
      340     ,input  0
      341     ,input  'nws-to-hist'
      342     ,output v-send
      343     ) no-error .
      344         if v-send < 0 then return.
      345       end.
      346       run cur-time in this-procedure(output v-date, output v-time).
      347       create buf_c-goods.
      348       buffer-copy buf_goods to buf_c-goods
      349       assign
      350       buf_c-goods.gds-code             = buf_goods.gds-code
      351       buf_c-goods.chip-num           = next-value (s-gds-chip, ub)
      352       buf_c-goods.corr-time          = v-time
      353       buf_c-goods.corr-user-db-num   = g#db-num
      354       buf_c-goods.corr-user-name     = (if g#news then (chr(4) +  'СПН':U)
      355                                         else (if g#esys
      356                                               then (chr(4) +  'ВС':U)
      357                                               else g#userid)
      358                                               )
      359       buf_c-goods.corr-date          = v-date
      360       .
      361       create buf_c-gds-hist.
      362       buffer-copy buf_c-goods to buf_c-gds-hist
      363       assign
      364       buf_c-gds-hist.action =  p-action
      365       buf_c-gds-hist.subject = 'goods':U
      366       buf_c-gds-hist.is-news = g#news
      367       buf_c-gds-hist.source-type = p-source-type
      368       buf_c-gds-hist.source-ref = p-source-ref
      369       .
      370     end.
      371   end procedure.
      372   define variable vss-include-info4 as character format "X(65)" no-undo
      373   initial "@(#)$Workfile$ $Revision$".
      374   procedure grplib-get-full-name :
      375      define input parameter p-node-code  as integer      no-undo.
      376      define output parameter p-full-name as character    no-undo.
      377      do
      378   on error undo, return error
      379   :
      380       define variable v-upper-code    as integer           no-undo.
      381       define buffer buf_gds-grp       for ub.gds-grp.
      382       define buffer buf_upper_gds-grp for ub.gds-grp.
      383       find first buf_gds-grp no-lock
      384            where buf_gds-grp.node-code = p-node-code
      385       no-error.
      386       if not available buf_gds-grp
      387       then do:
      388           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      389       end.
      390       assign
      391           p-full-name  = ""
      392           v-upper-code = 1
      393       .
      394       do while buf_gds-grp.upper-code <> 0
      395       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      396       :
      397           assign
      398               p-full-name  = buf_gds-grp.node-name
      399                            + (if p-full-name <> "" then chr(47) else "")
      400                            + p-full-name
      401               v-upper-code = buf_gds-grp.upper-code
      402           .
      403           find first buf_gds-grp no-lock
      404                where buf_gds-grp.node-code = v-upper-code
      405           no-error.
      406           if not available buf_gds-grp
      407           then do:
      408               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      409                                   + string( v-upper-code )
      410                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      411           end.
      412       end.
      413       assign
      414       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      415       .
      416   end.
      417   end .
      418   procedure grplib-get-node-from-full-name :
      419   define input parameter p-full-name as character no-undo .
      420   define output parameter p-node-code as integer no-undo .
      421   define variable v-ii as integer no-undo .
      422   define variable v-upper-code as integer no-undo .
      423   define variable v-root-code as integer no-undo .
      424   define variable v-entry as character no-undo .
      425   define buffer buf_gds-grp       for ub.gds-grp.
      426   do
      427   on error undo, return error
      428   :
      429     find first buf_gds-grp no-lock
      430         where buf_gds-grp.upper-code = 0
      431     no-error .
      432     if not available buf_gds-grp
      433     then do:
      434         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      435     end.
      436     else do:
      437       assign
      438       v-root-code = buf_gds-grp.node-code
      439       .
      440     end.
      441     v-upper-code = v-root-code.
      442     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      443       assign
      444       v-entry = entry(v-ii, p-full-name, chr(47)).
      445       if v-entry = '' then leave.
      446       find first buf_gds-grp no-lock where
      447                 buf_gds-grp.node-name = v-entry
      448             and buf_gds-grp.upper-code = v-upper-code
      449             no-error.
      450       if not available buf_gds-grp then do:
      451         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      452       end.
      453       else do:
      454         p-node-code = buf_gds-grp.node-code.
      455         v-upper-code = buf_gds-grp.node-code.
      456       end.
      457     end.
      458   end.
      459   end .
      460   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      461   procedure gds-grph_write-gds-grp-trigger :
      462   define input parameter p-new-record as logical no-undo .
      463   define input parameter p-source-type like ub.c-gds-grp-hist.source-type no-undo .
      464   define input parameter p-source-ref  like ub.c-gds-grp-hist.source-ref no-undo .
      465   define input parameter p-action as integer no-undo .
      466   define variable v-date as date      no-undo.
      467   define variable v-time  as integer   no-undo.
      468   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      469   define buffer buf_c-gds-grp for ub.c-gds-grp.
      470     do
      471     on error undo, return error
      472     :
      473       run cur-time in this-procedure(output v-date, output v-time).
      474       create buf_c-gds-grp.
      475       buffer-copy ub.gds-grp to buf_c-gds-grp
      476       assign
      477       buf_c-gds-grp.node-code           = (if p-new-record then ub.gds-grp.node-code else ub.gds-grp.node-code)
      478       buf_c-gds-grp.chip-num           = next-value (s-gds-grp-chip, ub)
      479       buf_c-gds-grp.corr-time          = v-time
      480       buf_c-gds-grp.corr-user-db-num   = g#db-num
      481       buf_c-gds-grp.corr-user-name     = (if g#news
      482                                           then (chr(4) +  'СПН':U)
      483                                           else (if g#esys
      484                                                then (chr(4) +  'ВС':U)
      485                                                else g#userid)
      486                                           )
      487       buf_c-gds-grp.corr-date          = v-date
      488       .
      489       create buf_c-gds-grp-hist.
      490       buffer-copy buf_c-gds-grp to buf_c-gds-grp-hist
      491       assign
      492       buf_c-gds-grp-hist.node-code           = buf_c-gds-grp.node-code
      493       buf_c-gds-grp-hist.action = p-action
      494       buf_c-gds-grp-hist.subject = 'gds-grp':U
      495       buf_c-gds-grp-hist.is-news = g#news
      496       buf_c-gds-grp-hist.source-type = p-source-type
      497       buf_c-gds-grp-hist.source-ref = p-source-ref
      498       .
      499     end.
      500   end procedure.
      501   procedure gds-grph_write-gds-grp-attr-proc  :
      502   define parameter buffer buf_gds-grp-attr for ub.gds-grp-attr .
      503   define input parameter p-action as integer no-undo .
      504   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      505   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      506   define variable v-date as date      no-undo.
      507   define variable v-time  as integer   no-undo.
      508   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      509   define buffer buf_c-gds-grp-attr for ub.c-gds-grp-attr.
      510     do
      511     on error undo, return error
      512     :
      513       if not available buf_gds-grp-attr then do:
      514         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      515                       "Ошибка задания входных параметров:Не определен атрибут группы товара" ).
      516       end.
      517       run cur-time in this-procedure(output v-date, output v-time).
      518       create buf_c-gds-grp-attr.
      519       buffer-copy buf_gds-grp-attr to buf_c-gds-grp-attr
      520       assign
      521       buf_c-gds-grp-attr.node-code          = buf_gds-grp-attr.node-code
      522       buf_c-gds-grp-attr.attr-code          = buf_gds-grp-attr.attr-code
      523       buf_c-gds-grp-attr.host-code          = buf_gds-grp-attr.host-code
      524       buf_c-gds-grp-attr.obj-type           = buf_gds-grp-attr.obj-type
      525       buf_c-gds-grp-attr.obj-code           = buf_gds-grp-attr.obj-code
      526       buf_c-gds-grp-attr.chip-num           = next-value (s-gds-grp-chip, ub)
      527       buf_c-gds-grp-attr.corr-time          = v-time
      528       buf_c-gds-grp-attr.corr-user-db-num   = g#db-num
      529       buf_c-gds-grp-attr.corr-user-name     = (if g#news
      530                                           then (chr(4) +  'СПН':U)
      531                                           else (if g#esys
      532                                                then (chr(4) +  'ВС':U)
      533                                                else g#userid)
      534                                           )
      535       buf_c-gds-grp-attr.corr-date          = v-date
      536       .
      537       create buf_c-gds-grp-hist.
      538       buffer-copy buf_c-gds-grp-attr to buf_c-gds-grp-hist
      539       assign
      540       buf_c-gds-grp-hist.action =  p-action
      541       buf_c-gds-grp-hist.subject = 'gds-grp-attr':U
      542       buf_c-gds-grp-hist.is-news = g#news
      543       buf_c-gds-grp-hist.source-type = p-source-type
      544       buf_c-gds-grp-hist.source-ref = p-source-ref
      545       .
      546     end.
      547   end procedure.
      548   procedure gds-grph_write-gds-grp-obj-proc  :
      549   define parameter buffer buf_gds-grp-obj for ub.gds-grp-obj .
      550   define input parameter p-action as integer no-undo .
      551   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      552   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      553   define variable v-date as date      no-undo.
      554   define variable v-time  as integer   no-undo.
      555   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      556   define buffer buf_c-gds-grp-obj for ub.c-gds-grp-obj.
      557     do
      558     on error undo, return error
      559     :
      560       if not available buf_gds-grp-obj then do:
      561         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      562                       "Ошибка задания входных параметров:Не определена группы товара на объекте" ).
      563       end.
      564       run cur-time in this-procedure(output v-date, output v-time).
      565       create buf_c-gds-grp-obj.
      566       buffer-copy buf_gds-grp-obj to buf_c-gds-grp-obj
      567       assign
      568       buf_c-gds-grp-obj.node-code          = buf_gds-grp-obj.node-code
      569       buf_c-gds-grp-obj.host-code          = buf_gds-grp-obj.host-code
      570       buf_c-gds-grp-obj.obj-type           = buf_gds-grp-obj.obj-type
      571       buf_c-gds-grp-obj.obj-code           = buf_gds-grp-obj.obj-code
      572       buf_c-gds-grp-obj.chip-num           = next-value (s-gds-grp-chip, ub)
      573       buf_c-gds-grp-obj.corr-time          = v-time
      574       buf_c-gds-grp-obj.corr-user-db-num   = g#db-num
      575       buf_c-gds-grp-obj.corr-user-name     = (if g#news
      576                                           then (chr(4) +  'СПН':U)
      577                                           else (if g#esys
      578                                                then (chr(4) +  'ВС':U)
      579                                                else g#userid)
      580                                           )
      581       buf_c-gds-grp-obj.corr-date          = v-date
      582       .
      583       create buf_c-gds-grp-hist.
      584       buffer-copy buf_c-gds-grp-obj to buf_c-gds-grp-hist
      585       assign
      586       buf_c-gds-grp-hist.action =  p-action
      587       buf_c-gds-grp-hist.subject = 'gds-grp-obj':U
      588       buf_c-gds-grp-hist.is-news = g#news
      589       buf_c-gds-grp-hist.source-type = p-source-type
      590       buf_c-gds-grp-hist.source-ref = p-source-ref
      591       .
      592     end.
      593   end procedure.
      594   procedure gds-grph_write-tax-rate-gds-grp-proc  :
      595   define parameter buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp .
      596   define input parameter p-action as integer no-undo .
      597   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      598   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      599   define variable v-date as date      no-undo.
      600   define variable v-time  as integer   no-undo.
      601   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      602   define buffer buf_c-tax-rate-gds-grp for ub.c-tax-rate-gds-grp.
      603     do
      604     on error undo, return error
      605     :
      606       if not available buf_tax-rate-gds-grp then do:
      607         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      608                       "Ошибка задания входных параметров:Не определена группы товара на объекте" ).
      609       end.
      610       run cur-time in this-procedure(output v-date, output v-time).
      611       create buf_c-tax-rate-gds-grp.
      612       buffer-copy buf_tax-rate-gds-grp to buf_c-tax-rate-gds-grp
      613       assign
      614       buf_c-tax-rate-gds-grp.node-code          = buf_tax-rate-gds-grp.node-code
      615       buf_c-tax-rate-gds-grp.tax-code           = buf_tax-rate-gds-grp.tax-code
      616       buf_c-tax-rate-gds-grp.host-code          = buf_tax-rate-gds-grp.host-code
      617       buf_c-tax-rate-gds-grp.obj-type           = buf_tax-rate-gds-grp.obj-type
      618       buf_c-tax-rate-gds-grp.obj-code           = buf_tax-rate-gds-grp.obj-code
      619       buf_c-tax-rate-gds-grp.chip-num           = next-value (s-gds-grp-chip, ub)
      620       buf_c-tax-rate-gds-grp.corr-time          = v-time
      621       buf_c-tax-rate-gds-grp.corr-user-db-num   = g#db-num
      622       buf_c-tax-rate-gds-grp.corr-user-name     = (if g#news
      623                                           then (chr(4) +  'СПН':U)
      624                                           else (if g#esys
      625                                                then (chr(4) +  'ВС':U)
      626                                                else g#userid)
      627                                           )
      628       buf_c-tax-rate-gds-grp.corr-date          = v-date
      629       .
      630       create buf_c-gds-grp-hist.
      631       buffer-copy buf_c-tax-rate-gds-grp to buf_c-gds-grp-hist
      632       assign
      633       buf_c-gds-grp-hist.action =  p-action
      634       buf_c-gds-grp-hist.subject = 'tax-rate-gds-grp':U
      635       buf_c-gds-grp-hist.is-news = g#news
      636       buf_c-gds-grp-hist.source-type = p-source-type
      637       buf_c-gds-grp-hist.source-ref = p-source-ref
      638       .
      639     end.
      640   end procedure.
      641   define buffer b-gds-grp          for ub.gds-grp.
      642   define buffer other_gds-grp      for ub.gds-grp.
      643   define buffer buf_c-gds-grp      for ub.c-gds-grp.
      644   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      645   define variable name   as char    no-undo.
      646   define variable uc     as int     no-undo.
      647   define variable v-date as date    no-undo .
      648   define variable v-time as integer no-undo .
      649   define buffer buf_scales-grp   for ub.scales-grp.
      650   define buffer buf2_scales-grp  for ub.scales-grp.
      651   define buffer buf_fbr-prn-grp  for ub.fbr-prn-grp.
      652   define buffer buf2_fbr-prn-grp for ub.fbr-prn-grp.
      653   main-block:
      654   do
      655       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      656       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      657       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      658       :
      659       on delete of ub.tax-rate-gds-grp override
      660           do:
      661           end.
      662       on delete of ub.gds-grp-attr override
      663           do:
      664           end.
      665       on delete of ub.gds-grp-obj override
      666           do:
      667           end.
      668       on write of ub.tax-rate-gds-grp override
      669           do:
      670           end.
      671       on write of ub.gds-grp-attr override
      672           do:
      673           end.
      674       on write of ub.gds-grp-obj override
      675           do:
      676           end.
      677       on write of ub.goods override
      678           do:
      679           end.
      680       if not g#news and g#db-num > 0 then
      681       do:
      682           message
      683               vss-workfile vss-revision vss-description skip
      684               "Нельзя удалять запись ГРУППЫ ТОВАРОВ в УБД" skip
      685               "Номер текущей БД" g#db-num
      686               view-as alert-box error .
      687           undo main-block, return error .
      688       end.
      689       for each ub.gds-grp-attr where
      690           ub.gds-grp-attr.node-code = ub.gds-grp.node-code:
      691           run gds-grph_write-gds-grp-attr-proc   in this-procedure (
      692               buffer ub.gds-grp-attr
      693               ,integer('99':U)
      694               ,'grp-chg':U
      695               ,string(ub.gds-grp.node-code)
      696               ).
      697           delete ub.gds-grp-attr.
      698       end.
      699       for each ub.gds-grp-obj where
      700           ub.gds-grp-obj.node-code = ub.gds-grp.node-code:
      701           run gds-grph_write-gds-grp-obj-proc   in this-procedure (
      702               buffer ub.gds-grp-obj
      703               ,integer('99':U)
      704               ,'grp-chg':U
      705               ,string(ub.gds-grp.node-code)
      706               ).
      707           delete ub.gds-grp-obj.
      708       end.
      709       run grplib-get-full-name in this-procedure
      710           (input ub.gds-grp.upper-code
      711           ,output name
      712           ).
      713       for each ub.goods
      714           where ub.goods.grp-code = ub.gds-grp.node-code
      715           on error undo main-block, return error
      716           :
      717           run goodsh_write-goods-proc   in this-procedure (
      718               buffer ub.goods
      719               ,integer('2':U)
      720               ,'grp-chg':U
      721               ,string(ub.gds-grp.node-code)
      722               ).
      723           assign
      724               ub.goods.grp-code = ub.gds-grp.upper-code
      725               ub.goods.grp-name = name
      726               .
      727           for each ub.gds-obj
      728               where ub.gds-obj.artic     = ub.goods.artic
      729               and ub.gds-obj.prod-type = ub.goods.prod-type
      730               and ub.gds-obj.prod-code = ub.goods.prod-code
      731               :
      732               assign
      733                   ub.gds-obj.grp-name = name
      734                   .
      735           end.
      736       end.
      737       for each buf_scales-grp where
      738           buf_scales-grp.node-code = ub.gds-grp.node-code
      739           and buf_scales-grp.db-num = g#db-num
      740           on error undo main-block, return error return-value  :
      741           find first buf2_scales-grp no-lock where
      742               buf2_scales-grp.node-code = ub.gds-grp.upper-code
      743               and buf2_scales-grp.scales-num = buf_scales-grp.scales-num
      744               and buf2_scales-grp.db-num     = g#db-num  no-error.
      745           if available buf2_scales-grp then
      746           do:
      747           end.
      748           else
      749           do:
      750               create buf2_scales-grp.
      751               assign
      752                   buf2_scales-grp.node-code  = ub.gds-grp.upper-code
      753                   buf2_scales-grp.db-num     = buf_scales-grp.db-num
      754                   buf2_scales-grp.scales-num = buf_scales-grp.scales-num
      755                   .
      756           end.
      757           delete buf_scales-grp.
      758       end.
      759       for each buf_fbr-prn-grp where
      760           buf_fbr-prn-grp.node-code = ub.gds-grp.node-code
      761           and buf_fbr-prn-grp.db-num = g#db-num
      762           on error undo main-block, return error return-value  :
      763           find first buf2_fbr-prn-grp no-lock where
      764               buf2_fbr-prn-grp.node-code = ub.gds-grp.upper-code
      765               and buf2_fbr-prn-grp.db-num = buf_fbr-prn-grp.db-num
      766               and buf2_fbr-prn-grp.prn-num = buf_fbr-prn-grp.prn-num  no-error.
      767           if available buf2_fbr-prn-grp then
      768           do:
      769           end.
      770           else
      771           do:
      772               create buf2_fbr-prn-grp.
      773               buffer-copy buf_fbr-prn-grp
      774                   except node-code to buf2_fbr-prn-grp
      775                   assign
      776                   buf2_fbr-prn-grp.node-code = ub.gds-grp.upper-code
      777                   .
      778           end.
      779           delete buf_fbr-prn-grp.
      780       end.
      781       for each ub.tax-rate-gds-grp where
      782           ub.tax-rate-gds-grp.node-code = ub.gds-grp.node-code:
      783           run gds-grph_write-tax-rate-gds-grp-proc   in this-procedure (
      784               buffer ub.tax-rate-gds-grp
      785               ,integer('99':U)
      786               ,'grp-chg':U
      787               ,string(ub.gds-grp.node-code)
      788               ).
      789           delete ub.tax-rate-gds-grp.
      790       end.
      791       for each b-gds-grp
      792           where b-gds-grp.upper-code = ub.gds-grp.node-code
      793           :
      794           assign
      795               b-gds-grp.upper-code = ub.gds-grp.upper-code
      796               .
      797       end.
      798       find first b-gds-grp where
      799           b-gds-grp.node-code = ub.gds-grp.upper-code.
      800       if not can-find(first other_gds-grp no-lock where
      801           other_gds-grp.upper-code = b-gds-grp.node-code
      802           AND recid(other_gds-grp) <> recid(ub.gds-grp)) then
      803       do:
      804           assign
      805               b-gds-grp.is-term = yes
      806               .
      807       end.
      808       define variable v-synch-gds-grp as integer no-undo .
      809       assign
      810           v-synch-gds-grp = next-value(synch-gds-grp, ub)
      811           .
      812       run nws/cmd-del.p
      813           ( input 'gds-grp':U
      814           ,input (buffer ub.gds-grp:handle)
      815           ,input "":U
      816           ) no-error .
      817       if error-status :error then
      818       do:
      819           undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      820       end.
      821       if not g#news then
      822       do:
      823           run gds-grph_write-gds-grp-trigger in this-procedure (
      824               no
      825               ,"":U
      826               ,"":U
      827               , integer('99':U)
      828               ).
      829       end.
      830       if g#oxml = yes
      831           then
      832       do:
      833           run str/calloxml.p (
      834               input 'delete':U
      835               , input 'gds-grp':U
      836               , input ( buffer ub.gds-grp:handle )
      837               ) no-error.
      838           if error-status :error
      839               then
      840           do:
      841               undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      842                   , chr(10)
      843                   , vss-workfile
      844                   , return-value
      845                   , error-status :get-message ( 1 ) ).
      846           end.
      847       end.
      848       run trg/userlog.p (
      849           input 'delete':U
      850           , input 'gds-grp':U
      851           , input ( buffer ub.gds-grp :handle )
      852           , input ?
      853           , input ""
      854           ) no-error.
      855       if error-status :error
      856           then
      857       do:
      858           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      859               , chr(10)
      860               , vss-workfile
      861               , return-value
      862               , error-status :get-message ( 1 ) ).
      863       end.
      864   end.
