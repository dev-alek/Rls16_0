        1   block-level on error undo, throw.
        2   define input parameter p-host-code      like ub.fin-statement.host-code no-undo .
        3   define input parameter p-sttm-code      like ub.fin-statement.sttm-code no-undo .
        4   define input parameter p-close-mode     as character no-undo .
        5   define input parameter p-author         as character no-undo .
        6   define input parameter p-status_        as character no-undo .
        7   define input-output parameter p-status-date    like ub.fin-statement.fact-date no-undo .
        8   define input parameter p-silent                       as logical no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Перевод статусов для банковских выписок".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure cur-time :
       86      define output parameter p-today as date      no-undo .
       87      define output parameter p-time  as integer   no-undo .
       88     do
       89     on error undo, return error
       90     :
       91       define variable v-date1 as date      no-undo .
       92       define variable v-date2 as date      no-undo .
       93       define variable v-time  as integer   no-undo .
       94       assign
       95         v-date1 = today
       96         v-time  = time
       97         v-date2 = today
       98       .
       99       if v-date1 <> v-date2
      100       then do:
      101         assign
      102           v-date1 = today
      103           v-time  = v-time
      104         .
      105       end.
      106       assign
      107         p-today = v-date1
      108         p-time  = v-time
      109       .
      110     end.
      111   end.
      112   function cur-time-date returns character
      113   :
      114     return string(today, '99/99/9999':U) .
      115   end.
      116   function cur-time-mjd returns decimal
      117   :
      118     define variable v-date as date      no-undo .
      119     define variable v-time as integer   no-undo .
      120     run cur-time in this-procedure
      121       (output v-date
      122       ,output v-time
      123       ) .
      124     return integer(v-date) - 2400002 + (v-time / 86400) .
      125   end.
      126   function cur-time-get-ending-index returns integer
      127   (input p-number as integer
      128   )
      129   :
      130     if p-number < 0
      131     or p-number = ?
      132     then do:
      133       return 1 .
      134     end.
      135     define variable v-rest as integer   no-undo .
      136     assign
      137       p-number = p-number modulo 100
      138     .
      139     if p-number < 20
      140     then do:
      141       assign
      142         v-rest = p-number
      143       .
      144     end.
      145     else do:
      146       assign
      147         v-rest = p-number modulo 10
      148       .
      149     end.
      150     case v-rest :
      151       when 1
      152       then do:
      153         return 2 .
      154       end.
      155       when 2 or
      156       when 3 or
      157       when 4
      158       then do:
      159         return 3 .
      160       end.
      161       otherwise do:
      162         return 1 .
      163       end.
      164     end case .
      165   end.
      166   procedure cur-time-mjd-to-date :
      167      define input  parameter i-mjd-diff as decimal no-undo.
      168      define output parameter o-Date     as date    no-undo.
      169      define output parameter o-Time     as integer no-undo.
      170      define variable v-day-number as integer   no-undo .
      171      if    i-mjd-diff < 0
      172         or i-mjd-diff = ?
      173      then do:
      174         return "?" .
      175      end.
      176      assign
      177         v-day-number = truncate(i-mjd-diff,0).
      178         o-Date = date(v-day-number + 2400002).
      179         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      180     .
      181   end.
      182   function cur-time-mjd-to-string returns character
      183   (input p-mjd-diff as decimal
      184   )
      185   :
      186     define variable v-day-number as integer   no-undo .
      187     define variable v-seconds    as integer   no-undo .
      188     define variable v-hour       as integer   no-undo .
      189     define variable v-min        as integer   no-undo .
      190     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      191     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      192     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      193     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      194     if p-mjd-diff < 0
      195     or p-mjd-diff = ?
      196     then do:
      197       return "?" .
      198     end.
      199     assign
      200       v-day-number = integer(truncate(p-mjd-diff,0))
      201       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203     if v-seconds > 86400
      204     then do:
      205       assign
      206         v-seconds = 86400 - 1
      207       .
      208     end.
      209     if v-seconds < 0
      210     then do:
      211       assign
      212         v-seconds = 0
      213       .
      214     end.
      215     assign
      216       v-hour = truncate(v-seconds / 3600, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 3600
      220     .
      221     assign
      222       v-min = truncate(v-seconds / 60, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 60
      226     .
      227     return
      228         (if v-day-number <> 0
      229           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0
      233           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      237           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      238           else ""
      239         )
      240       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      241       .
      242   end.
      243   function cur-time-string returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      252   end.
      253   function cur-time-string-sec returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      262   end.
      263   function cur-time-custom  returns character
      264   (input p-prefix as character
      265   ,input p-date-format as character
      266   ,input p-delimiter as character
      267   ,input p-time-format as character
      268   ,input p-suffix as character
      269   )
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return
      278       p-prefix
      279       + string(v-date, p-date-format)
      280       + p-delimiter
      281       + string(v-time, p-time-format)
      282       + p-suffix
      283       .
      284   end.
      285   function cur-time-print  returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      294   end.
      295   function cur-time-datetime returns datetime
      296   :
      297     define variable v-char as character no-undo .
      298     define variable v-datetime as datetime no-undo .
      299     v-char = cur-time-string().
      300     v-datetime = datetime(v-char).
      301     return  v-datetime.
      302   end.
      303   function cur-time-string-msec returns character
      304   :
      305     define variable v-date as datetime  no-undo .
      306     v-date = now.
      307     return string(v-date) .
      308   end.
      309   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   procedure factord :
      311     define input  parameter p-fact-date            as date    no-undo .
      312     define input  parameter p-fact-time            as integer no-undo .
      313     define input  parameter p-fact-num             as integer no-undo .
      314     define input  parameter p-shift-date           as date    no-undo .
      315     define input  parameter p-shift-num            as integer no-undo .
      316     define input  parameter p-shift-on             as logical no-undo .
      317     define output parameter p-fact-order           as decimal no-undo .
      318     define output parameter p-shift-end-fact-order as decimal no-undo .
      319     define output parameter p-day-end-fact-order   as decimal no-undo .
      320     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      321     if p-fact-date = ?
      322     then do:
      323       return error "Не указана фактическая дата" .
      324     end.
      325     define variable v-fact-date-num as integer no-undo .
      326     assign
      327       v-fact-date-num = integer(p-fact-date)
      328     .
      329     if p-fact-num = ?
      330     or p-fact-num = 0
      331     then do:
      332       return error "Не задан p-fact-num " + string(p-fact-num) .
      333     end.
      334     if p-fact-num < 0
      335     then do:
      336       return error "Отрицательный fact-num " + string(p-fact-num) .
      337     end.
      338     if p-fact-num >= 100000000
      339     then do:
      340       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      341     end.
      342     if p-shift-on = true
      343     then do:
      344       if p-shift-date = ?
      345       then do:
      346         return error "Не задана дата смены" .
      347       end.
      348       if p-shift-num = ?
      349       or p-shift-num = 0
      350       then do:
      351         return error "Не задан номер смены" .
      352       end.
      353     end.
      354     else do:
      355       assign
      356         p-shift-date = p-fact-date
      357         p-shift-num  = 24
      358       .
      359     end.
      360     define variable v-shift-offset as integer no-undo .
      361     if p-shift-date = p-fact-date
      362     then do:
      363       assign
      364         v-shift-offset = 1
      365       .
      366     end.
      367     if p-shift-date < p-fact-date
      368     then do:
      369       assign
      370         v-shift-offset = 0
      371       .
      372     end.
      373     if p-shift-date > p-fact-date
      374     then do:
      375       message
      376         vss-workfile vss-revision vss-description skip
      377         "Неправильная дата закрытия смены" skip
      378         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      379         view-as alert-box error .
      380       undo, return error
      381         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      382           ,string(p-fact-date, '99/99/9999':U)
      383           ,string(p-shift-date, '99/99/9999':U)
      384           )
      385       .
      386     end.
      387     if p-shift-num < 1
      388     or p-shift-num > 24
      389     then do:
      390       message
      391         vss-workfile vss-revision vss-description skip
      392         "Неправильный номер смены" skip
      393         "p-shift-num" p-shift-num skip
      394         view-as alert-box error .
      395       undo, return error return-value .
      396     end.
      397     assign
      398       p-fact-order           = v-fact-date-num
      399                              + v-shift-offset * 0.5
      400                              + p-shift-num    * 0.02 - 0.01
      401                              + p-fact-num     * 0.0000000001
      402       p-shift-end-fact-order = v-fact-date-num
      403                              + v-shift-offset * 0.5
      404                              + p-shift-num    * 0.02
      405       p-day-end-fact-order   = v-fact-date-num
      406                              + 0.99
      407     .
      408     if p-fact-order           <= v-fact-date-num
      409     or p-shift-end-fact-order <= v-fact-date-num
      410     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      411     or p-shift-end-fact-order >= p-day-end-fact-order
      412     then do:
      413       message
      414         vss-workfile vss-revision vss-description skip
      415         "Внутренняя ошибка при генерации фактического номера" skip
      416         "p-fact-date"            p-fact-date            skip
      417         "p-fact-time"            p-fact-time            skip
      418         "p-fact-num"             p-fact-num             skip
      419         "p-shift-date"           p-shift-date           skip
      420         "p-shift-num"            p-shift-num            skip
      421         "p-shift-on"             p-shift-on             skip
      422         "p-shift-end-fact-order" p-shift-end-fact-order skip
      423         "p-day-end-fact-order"   p-day-end-fact-order   skip
      424         "v-fact-date-num"        v-fact-date-num        skip
      425         view-as alert-box error .
      426       undo, return error return-value .
      427     end.
      428   end procedure.
      429   procedure day-begin-fact-order :
      430     define input  parameter p-fact-date            as date    no-undo .
      431     define output parameter p-day-begin-fact-order as decimal no-undo .
      432     do
      433     on error undo, return error return-value
      434     :
      435       if p-fact-date = ?
      436       then do:
      437         assign
      438           p-day-begin-fact-order = 0
      439         .
      440       end.
      441       else do:
      442         assign
      443           p-day-begin-fact-order = integer(p-fact-date)
      444         .
      445       end.
      446     end.
      447   end procedure.
      448   procedure factord-max-fact-order :
      449     define output parameter p-max-fact-order as decimal   no-undo .
      450     do
      451     on error undo, return error return-value
      452     :
      453       run day-begin-fact-order in this-procedure
      454         (input  date(1, 1, 5000)
      455         ,output p-max-fact-order
      456         ) .
      457     end.
      458   end procedure.
      459   procedure factord-cut-archive :
      460     define input  parameter p-obj-type             as character no-undo .
      461     define input  parameter p-obj-code             as integer   no-undo .
      462     define input  parameter p-fact-date            as date      no-undo .
      463     define output parameter p-shift-on             as logical   no-undo .
      464     define output parameter p-shift-date           as date      no-undo .
      465     define output parameter p-shift-num            as integer   no-undo .
      466     define output parameter p-day-end-fact-order   as decimal   no-undo .
      467     define output parameter p-shift-end-fact-order as decimal   no-undo .
      468     define variable v-fact-order as decimal   no-undo .
      469     define buffer buf_shift-obj for ub.shift-obj .
      470     do
      471     on error undo, return error return-value
      472     :
      473   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      475     (input  p-obj-type
      476     ,input  p-obj-code
      477     ,input  'shift-on=request'
      478     ,output p-shift-on
      479     ) no-error .
      480       if error-status :error
      481       then do:
      482         message
      483           vss-workfile vss-revision vss-description skip
      484           "Ошибка при определении атрибута объекта" skip
      485           "Объект" p-obj-type p-obj-code skip
      486           error-status :get-message(1) skip
      487           return-value skip
      488           view-as alert-box error .
      489         undo, return error return-value .
      490       end.
      491       if p-shift-on = false
      492       then do:
      493         assign
      494           p-shift-date               = ?
      495           p-shift-num                = 0
      496         .
      497       end.
      498       else do:
      499         find first buf_shift-obj share-lock
      500           where buf_shift-obj.obj-type   = p-obj-type
      501             and buf_shift-obj.obj-code   = p-obj-code
      502             and buf_shift-obj.shift-date > p-fact-date
      503           use-index pi
      504           no-error .
      505         if not available buf_shift-obj
      506         or buf_shift-obj.status_ <> 'зкр':U
      507         then do:
      508           message
      509             vss-workfile vss-revision vss-description skip
      510             "Невозможно вычислить последнюю смену" skip
      511             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      512             "Объект" p-obj-type p-obj-code skip
      513             "Дата" p-fact-date skip
      514             view-as alert-box error .
      515           undo, return error return-value .
      516         end.
      517         find last buf_shift-obj share-lock
      518           where buf_shift-obj.obj-type = p-obj-type
      519             and buf_shift-obj.obj-code = p-obj-code
      520             and buf_shift-obj.shift-date <= p-fact-date
      521           use-index pi
      522           no-error .
      523         if available buf_shift-obj
      524         then do:
      525           if  buf_shift-obj.status_ = 'зкр':U
      526           then do:
      527             assign
      528               p-shift-date = buf_shift-obj.shift-date
      529               p-shift-num  = buf_shift-obj.shift-num
      530             .
      531           end.
      532           else do:
      533             message
      534               vss-workfile vss-revision vss-description skip
      535               "Невозможно вычислить последнюю смену" skip
      536               "Статус смены отличен от статуса" 'зкр':U skip
      537               "Объект" p-obj-type p-obj-code skip
      538               "Дата" p-fact-date skip
      539               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      540               view-as alert-box error .
      541             undo, return error return-value .
      542           end.
      543         end.
      544         else do:
      545           assign
      546             p-shift-date = p-fact-date - 1
      547             p-shift-num  = 1
      548           .
      549         end.
      550       end.
      551       run factord in this-procedure
      552         (input  p-fact-date
      553         ,input  1
      554         ,input  1
      555         ,input  p-shift-date
      556         ,input  p-shift-num
      557         ,input  p-shift-on
      558         ,output v-fact-order
      559         ,output p-shift-end-fact-order
      560         ,output p-day-end-fact-order
      561         ) no-error .
      562       if error-status :error
      563       then do:
      564         message
      565           vss-workfile vss-revision vss-description skip
      566           "Ошибка при вызове процедуры factord"
      567           error-status :get-message(1) skip
      568           return-value skip
      569           view-as alert-box error .
      570         undo, return error return-value .
      571       end.
      572     end.
      573   end procedure.
      574   procedure factord-lock-shift :
      575     define input  parameter p-obj-type  as character no-undo .
      576     define input  parameter p-obj-code  as integer   no-undo .
      577     define input  parameter p-fact-date as date      no-undo .
      578     define parameter buffer buf_shift-obj for ub.shift-obj .
      579     define variable v-shift-on      as logical   no-undo .
      580     define variable v-extra-message as character no-undo .
      581     define variable v-error as character no-undo .
      582     do
      583     on error undo, return error return-value
      584     :
      585   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      587     (input  p-obj-type
      588     ,input  p-obj-code
      589     ,input  'shift-on=request'
      590     ,output v-shift-on
      591     ) no-error .
      592       if error-status :error
      593       then do:
      594         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      595         undo, return error v-error .
      596       end.
      597       if v-shift-on = true
      598       then do:
      599         find first buf_shift-obj share-lock
      600           where buf_shift-obj.obj-type   = p-obj-type
      601             and buf_shift-obj.obj-code   = p-obj-code
      602             and buf_shift-obj.shift-date > p-fact-date
      603           use-index pi
      604           no-error .
      605         if not available buf_shift-obj
      606         or buf_shift-obj.status_ <> 'зкр':U
      607         then do:
      608           find last buf_shift-obj
      609             where buf_shift-obj.obj-type = p-obj-type
      610               and buf_shift-obj.obj-code = p-obj-code
      611               and buf_shift-obj.status_  = 'зкр':U
      612             use-index stts
      613             no-error .
      614           if available buf_shift-obj
      615           then do:
      616             assign
      617               v-extra-message =
      618                     substitute("Дата начала последеней закрытой смены на объекте &1"
      619                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      620                               )
      621             .
      622           end.
      623           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      624           undo, return error v-error .
      625         end.
      626       end.
      627     end.
      628   end procedure.
      629   procedure factord-end-day :
      630     define input  parameter p-fact-date            as date    no-undo .
      631     define output parameter p-day-end-fact-order   as decimal no-undo .
      632     do
      633     on error undo, return error return-value
      634     :
      635       if p-fact-date = ?
      636       then do:
      637         return error "Не указана фактическая дата" .
      638       end.
      639       assign
      640         p-day-end-fact-order = integer(p-fact-date) + 0.99
      641       .
      642     end.
      643   end procedure.
      644   procedure factord-to-date :
      645     define input  parameter p-fact-order as decimal no-undo .
      646     define output parameter p-fact-date  as date    no-undo .
      647     define variable v-ref-date  as date      no-undo .
      648     define variable v-ref-delta as integer   no-undo .
      649     do
      650     on error undo, return error return-value
      651     :
      652       if p-fact-order = ?
      653       or p-fact-order = 0
      654       then do:
      655         return error "Не указан fact-order" .
      656       end.
      657       assign
      658         v-ref-date  = date(1, 1, 2000)
      659       .
      660       assign
      661         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      662       .
      663       assign
      664         p-fact-date = v-ref-date + v-ref-delta
      665       .
      666     end.
      667   end procedure.
      668   procedure factord-to-fact-num :
      669     define input  parameter p-fact-order as decimal no-undo .
      670     define output parameter p-fact-num   as integer no-undo .
      671     define variable v-fact-order-trunc as decimal no-undo .
      672     do
      673     on error undo, return error return-value
      674     :
      675       if p-fact-order = ?
      676       or p-fact-order = 0
      677       then do:
      678         return error "Не указан fact-order" .
      679       end.
      680       assign
      681        v-fact-order-trunc = truncate(p-fact-order, 2)
      682       .
      683       assign
      684         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      685       .
      686     end.
      687   end procedure.
      688   procedure factord-to-shift-num :
      689     define input  parameter p-fact-order as decimal no-undo .
      690     define output parameter p-shift-num   as integer no-undo .
      691     define variable  p-shift-numd  as decimal   no-undo .
      692     define variable v-fact-order-trunc as decimal no-undo .
      693     do
      694     on error undo, return error return-value
      695     :
      696       if p-fact-order = ?
      697       or p-fact-order = 0
      698       then do:
      699         return error "Не указан fact-order" .
      700       end.
      701       assign
      702        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      703       .
      704       if v-fact-order-trunc < 0.5 then do:
      705         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      706       end.
      707       assign
      708         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      709         .
      710        assign
      711         p-shift-num = truncate (p-shift-numd , 0)
      712       .
      713     end.
      714   end procedure.
      715   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      716   define variable v-date as date no-undo .
      717   define variable v-time as integer no-undo .
      718   define variable v-fact-order as decimal no-undo .
      719   define variable v-fact-order-start as decimal no-undo .
      720   define variable v-fact-order-end as decimal no-undo .
      721   define variable v-shift-end-fact-order as decimal no-undo .
      722   define variable v-day-end-fact-order as decimal no-undo .
      723   define variable v-pre-status_ as character no-undo .
      724   define variable v-curr-abbr like ub.currency.curr-abbr no-undo.
      725   define variable v-status_ as character no-undo .
      726   define variable v-ask-date as logical no-undo .
      727   define variable v-ask-message as character no-undo .
      728   define variable v-correct as logical no-undo .
      729   define variable v-err-mess as character no-undo .
      730   define variable v-ret-mess as character no-undo .
      731   define variable v-datestr as character no-undo .
      732   define variable v-prn-doc-code like ub.fin-statement.prn-doc-code no-undo .
      733   define variable v-fins-doc-type like ub.fin-statement.fins-doc-type no-undo .
      734   define buffer buf_fin-statement for ub.fin-statement.
      735   main-block:
      736   do
      737   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      738   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      739   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      740   :
      741     find first buf_fin-statement exclusive-lock where
      742               buf_fin-statement.host-code = p-host-code
      743            AND buf_fin-statement.sttm-code = p-sttm-code .
      744     assign
      745     v-prn-doc-code = buf_fin-statement.prn-doc-code
      746     v-fins-doc-type = buf_fin-statement.fins-doc-type
      747     .
      748     run trg/finsgraf.p (
      749                     input  buf_fin-statement.host-code
      750                     ,input  buf_fin-statement.sttm-code
      751                     ,input  p-close-mode
      752                     ,input  p-author
      753                     ,input  buf_fin-statement.status_
      754                     ,input  ?
      755                     ,output v-status_
      756                     ,output v-ask-date
      757                     ,output v-ask-message
      758                     ) no-error.
      759     if error-status:error
      760     or v-status_ <> p-status_
      761     or (v-ask-date and p-status-date = ?)
      762     then do:
      763       run err-mess ("Ошибка при проверке возможности открытия/закрытия/отказа", output v-ret-mess).
      764       undo main-block, return error v-ret-mess.
      765     end.
      766     assign
      767     v-pre-status_ = buf_fin-statement.status_
      768     .
      769     if p-status-date = ? and v-ask-date then do:
      770       run gbl/d-prompt.w (
      771         'title=':u + "Дата смены статуса" + '\':u
      772       + 'text1=':u + "Введите дату" + '\':u
      773       + 'format=99/99/9999' + '\':u
      774       + 'type=' + 'T':U + '\':u
      775       + 'fillin_row=2\':u
      776       + 'fillin_col=4\':u
      777       + 'fillin_width=20\':u
      778       + 'fillin_height=1\':u
      779       + 'max-chars=70\':u
      780       + 'readonly=no' + '\':u
      781       , input-output v-datestr
      782       ).
      783       if return-value = 'false':u then undo main-block, return error v-ret-mess.
      784       assign
      785       v-date = date(integer(substr(v-datestr, 4, 2))
      786                   ,integer(substr(v-datestr, 1, 2))
      787                   ,integer(substr(v-datestr, 7, 4)))
      788       no-error .
      789       if error-status:error then do:
      790         message
      791         "Вы ввели неверную дату"
      792         view-as alert-box error .
      793         undo main-block, return error .
      794       end.
      795       assign
      796       p-status-date = v-date
      797       .
      798     end.
      799     else do:
      800       if p-status-date = ? then do:
      801         run cur-time in this-procedure(output v-date, output v-time).
      802       end.
      803       if p-status-date <> ? then do:
      804         assign
      805         v-date = p-status-date
      806         .
      807       end.
      808     end.
      809     CASE buf_fin-statement.fins-doc-type:
      810       when 'стд':U then do:
      811         run check-standard-sttm in this-procedure no-error .
      812         if error-status:error then do:
      813           run err-mess (input return-value , output v-ret-mess).
      814           undo main-block, return error  v-ret-mess.
      815         end.
      816       end.
      817     END CASE.
      818     if error-status:error then do:
      819       if return-value <> "":U then do:
      820         if not p-silent then
      821         message
      822         return-value view-as alert-box .
      823         undo main-block, return error  return-value .
      824       end.
      825     end.
      826     CASE p-status_:
      827       when 'новый':U then do:
      828         assign
      829         buf_fin-statement.status_ = p-status_
      830         buf_fin-statement.fact-date = ?
      831         buf_fin-statement.bank-date = ?
      832         buf_fin-statement.fact-order-start = 0
      833         buf_fin-statement.fact-order-end = 0
      834         .
      835       end.
      836       when 'банк':U then do:
      837         assign
      838         buf_fin-statement.status_ = p-status_
      839         buf_fin-statement.fact-date = ?
      840         buf_fin-statement.bank-date = v-date
      841         buf_fin-statement.fact-order-start = 0
      842         buf_fin-statement.fact-order-end = 0
      843         .
      844       end.
      845       when 'факт':U then do:
      846         run factord in this-procedure (
      847                                          input  buf_fin-statement.start-date
      848                                         ,input  v-time
      849                                         ,input  next-value(s-fin-sttm-fact , ub)
      850                                         ,input  ?
      851                                         ,input  0
      852                                         ,input  no
      853                                         ,output v-fact-order-start
      854                                         ,output v-shift-end-fact-order
      855                                         ,output v-day-end-fact-order
      856                                         ).
      857         run factord in this-procedure (
      858                                          input  buf_fin-statement.end-date
      859                                         ,input  v-time
      860                                         ,input  next-value(s-fin-sttm-fact , ub)
      861                                         ,input  ?
      862                                         ,input  0
      863                                         ,input  no
      864                                         ,output v-fact-order-end
      865                                         ,output v-shift-end-fact-order
      866                                         ,output v-day-end-fact-order
      867                                         ).
      868         assign
      869         buf_fin-statement.status_ = p-status_
      870         buf_fin-statement.fact-date = v-date
      871         buf_fin-statement.fact-order = v-fact-order
      872         buf_fin-statement.fact-order-start = v-fact-order-start
      873         buf_fin-statement.fact-order-end = v-fact-order-end
      874         .
      875       end.
      876     END CASE.
      877     release buf_fin-statement no-error .
      878     if error-status:error then do:
      879       run err-mess (substitute("Ошибка при смене статуса на &1", p-status_), output v-ret-mess).
      880       undo main-block, return error v-ret-mess.
      881     end.
      882   end.
      883   procedure check-standard-sttm :
      884     do
      885     on error undo, return error
      886     :
      887           run ref/finstm01.p (
      888                       input 'ИЗМЕНЕНИЕ':U
      889                       ,input p-close-mode
      890                       ,input buf_fin-statement.host-code            ,input buf_fin-statement.sttm-code            ,input buf_fin-statement.curr-code            ,input buf_fin-statement.doc-date             ,input buf_fin-statement.bank-date            ,input buf_fin-statement.fact-date            ,input buf_fin-statement.fins-doc-type        ,input buf_fin-statement.fins-ext-doc-type    ,input buf_fin-statement.code-bank            ,input buf_fin-statement.bank-name            ,input buf_fin-statement.bank-city            ,input buf_fin-statement.bik                  ,input buf_fin-statement.code-schet           ,input buf_fin-statement.r-schet              ,input buf_fin-statement.c-schet              ,input buf_fin-statement.cli-name             ,input buf_fin-statement.prn-doc-code         ,input buf_fin-statement.PS                   ,input buf_fin-statement.sum-doc              ,input buf_fin-statement.start-sum-doc-th     ,input buf_fin-statement.start-sum-doc        ,input buf_fin-statement.in-sum-doc           ,input buf_fin-statement.out-sum-doc          ,input buf_fin-statement.end-sum-doc          ,input buf_fin-statement.num-docs             ,input buf_fin-statement.start-date           ,input buf_fin-statement.end-date
      891                       ,input p-status_
      892                       ,input v-date
      893                       ,output v-correct
      894                       ,output v-err-mess
      895                       ) no-error.
      896        if error-status:error then do:
      897          undo, return error substitute("&1 &2", error-status:get-message(1), return-value ).
      898        end.
      899        if not v-correct then do:
      900          undo, return error substitute("Ошибка при проверке корректности выписки типа &1 при переводе на статус &2: &3", buf_fin-statement.fins-doc-type, p-status_, v-err-mess).
      901        end.
      902     end.
      903   end procedure.
      904   PROCEDURE err-mess:
      905     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      906     define output parameter p-ret-mess as character no-undo .
      907     assign
      908     p-ret-mess =  substitute("БАНКОВСКАЯ ВЫПИСКА &1: фирма: &2 N: &3,&5вн.код выписки &4&5&6"
      909                               , buf_fin-statement.prn-doc-code
      910                               , buf_fin-statement.host-code
      911                               , buf_fin-statement.fins-doc-type
      912                               , buf_fin-statement.sttm-code
      913                               , chr(10)
      914                               , p-mess
      915                               ).
      916     CASE p-silent:
      917       when yes then do:
      918         if available buf_fin-statement then
      919         assign
      920         p-ret-mess =  substitute("БАНКОВСКАЯ ВЫПИСКА &1: фирма: &2 N: &3,&5вн.код выписки &4&5&6"
      921                                   , buf_fin-statement.prn-doc-code
      922                                   , buf_fin-statement.host-code
      923                                   , buf_fin-statement.fins-doc-type
      924                                   , buf_fin-statement.sttm-code
      925                                   , chr(10)
      926                                   , p-mess
      927                                   ).
      928         else
      929         assign
      930         p-ret-mess =  substitute("БАНКОВСКАЯ ВЫПИСКА &1: фирма: &2 N: &3,&5вн.код выписки &4&5&6"
      931                                   , v-prn-doc-code
      932                                   , p-host-code
      933                                   , v-fins-doc-type
      934                                   , p-sttm-code
      935                                   , chr(10)
      936                                   , p-mess
      937                                   ).
      938       end.
      939       when no then do:
      940         message
      941         p-mess
      942         view-as alert-box error .
      943       end.
      944     end.
      945   END PROCEDURE.
