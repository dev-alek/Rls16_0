        1   block-level on error undo, throw.
        2   using ibs.th.str.alcohol.*.
        3   define input parameter p-doc-code like ub.trn-doc.doc-code no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Резервирование по партиям".
       10   define variable chg-qnty      as   decimal no-undo .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure partrqst :
       73     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
       74     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
       75     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
       76     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
       77     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
       78     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
       79     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
       80     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
       81     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
       82     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
       83     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
       84     define output parameter p-total-parts-price-base     as decimal                 no-undo .
       85     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
       86     define output parameter p-total-parts-transport-base as decimal                 no-undo .
       87     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
       88     define output parameter p-total-parts-other-base     as decimal                 no-undo .
       89     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
       90     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
       91     do
       92     on error undo, return error return-value
       93     :
       94       assign
       95         p-total-parts-qnty           = 0
       96         p-total-parts-fact-qnty      = 0
       97         p-total-parts-cli-qnty       = 0
       98         p-total-parts-fact-cli-qnty  = 0
       99         p-total-parts-price-cli      = 0
      100         p-total-parts-price-base     = 0
      101         p-total-parts-price-rubl     = 0
      102         p-total-parts-transport-base = 0
      103         p-total-parts-transport-rubl = 0
      104         p-total-parts-other-base     = 0
      105         p-total-parts-other-rubl     = 0
      106       .
      107       define buffer buf_parts for ub.parts .
      108       for each buf_parts no-lock
      109         where buf_parts.out-code  = p-doc-code
      110           and buf_parts.obj-type  = p-obj-type
      111           and buf_parts.obj-code  = p-obj-code
      112           and buf_parts.artic     = p-artic
      113           and buf_parts.prod-type = p-prod-type
      114           and buf_parts.prod-code = p-prod-code
      115       on error undo, return error return-value
      116       :
      117         define variable v-parts-fact-multiplier as decimal   no-undo .
      118         assign
      119           v-parts-fact-multiplier = 1
      120         .
      121         if buf_parts.qnty <> 0 then do:
      122           assign
      123             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      124           .
      125         end.
      126         assign
      127           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      128           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      129           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      130           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      131                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      132           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      133           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      134           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      135           p-total-parts-transport-base  = p-total-parts-transport-base
      136                                         + buf_parts.fact-qnty
      137                                           * (if   buf_parts.transport-base <> ?
      138                                             then buf_parts.transport-base
      139                                             else 0
      140                                             )
      141           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      142                                         + buf_parts.fact-qnty
      143                                           * (if   buf_parts.transport-rubl <> ?
      144                                             then buf_parts.transport-rubl
      145                                             else 0
      146                                             )
      147           p-total-parts-other-base      = p-total-parts-other-base
      148                                         + buf_parts.fact-qnty
      149                                           * (if   buf_parts.other-base <> ?
      150                                             then buf_parts.other-base
      151                                             else 0
      152                                             )
      153           p-total-parts-other-rubl      = p-total-parts-other-rubl
      154                                         + buf_parts.fact-qnty
      155                                           * (if   buf_parts.other-rubl <> ?
      156                                             then buf_parts.other-rubl
      157                                             else 0
      158                                             )
      159         .
      160       end.
      161     end.
      162   end procedure.
      163   define new global shared variable g#lib-trn  as handle no-undo .
      164   define new global shared variable g#lib-trn2 as handle no-undo .
      165   define new global shared variable g#lib-trn3 as handle no-undo .
      166   define new global shared variable g#lib-trn4 as handle no-undo .
      167   function hvrdtax return logical (input parrecid as recid):
      168   define variable varresult as logical no-undo.
      169   run hvrdtax-proc (input parrecid, output varresult).
      170   return varresult.
      171   end function.
      172   procedure hvrdtax-proc:
      173   define input  parameter parrecid  as recid   no-undo.
      174   define output parameter parresult as logical no-undo.
      175   define buffer bf_goods for ub.goods.
      176   define buffer bf_units for ub.units.
      177   define buffer rt_tax   for ub.tax.
      178   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      179   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      180   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      181   if available rt_tax and
      182       can-find(first ub.tax-units No-LOCK WHERE
      183                      ub.tax-units.tax-code = rt_tax.tax-code AND
      184                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      185                                                       else assign parresult = no.
      186   end procedure.
      187   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      188   procedure gen-key-rec :
      189     define input  parameter p-tbl-name    as character no-undo.
      190     define input  parameter p-bh_tbl-name as handle    no-undo.
      191     define output parameter p-key-rec     as character no-undo.
      192     do
      193     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      194     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      195     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      196     :
      197       define variable fh               as handle    no-undo .
      198       define variable v-ok             as logical   no-undo .
      199       define variable v-inform         as character no-undo .
      200       define variable v-ind            as integer   no-undo .
      201       define variable v-idx-field-qnty as integer   no-undo .
      202       if p-tbl-name = ?
      203         or p-tbl-name = "":U
      204       then do:
      205         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      206       end.
      207       if not p-bh_tbl-name:available then do:
      208         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      209       end.
      210       assign
      211         p-key-rec = p-tbl-name
      212         v-inform  = p-bh_tbl-name:index-information(1)
      213         v-ind     = 2
      214       .
      215       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      216       on error undo, return error
      217       :
      218         assign
      219           v-inform = p-bh_tbl-name:index-information( v-ind )
      220           v-ind    = v-ind + 1
      221         .
      222       end.
      223       if v-inform = ?
      224         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      225         or entry( 3, v-inform, ",":U ) <> "1":U
      226       then do:
      227         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      228       end.
      229       else do:
      230         assign
      231           v-idx-field-qnty = num-entries( v-inform ) - 4
      232         .
      233         if v-idx-field-qnty < 2 then do:
      234           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      235         end.
      236         do v-ind = 1 to v-idx-field-qnty by 2
      237         on error undo, return error
      238         :
      239           assign
      240             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      241             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      242           .
      243         end.
      244       end.
      245       if p-key-rec = ? then do:
      246         assign
      247           p-key-rec = "":U
      248         .
      249         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      250       end.
      251     end.
      252     return.
      253   end procedure.
      254   procedure gen-where-keyr-tab :
      255     define input  parameter i-tableSerach as character no-undo.
      256     define input  parameter i-tablekey   as character  no-undo.
      257     define input  parameter p-key-rec    as character  no-undo.
      258     define input  parameter p-key-handle as handle     no-undo .
      259     define input  parameter p-db-name    as character  no-undo .
      260     define input  parameter p-tt-handle  as handle     no-undo .
      261     define output parameter o-Where      as character  no-undo.
      262     do
      263     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      264     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      265     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      266     :
      267       define variable v-full-tbl-name  as character no-undo .
      268       define variable bh_tbl-name      as handle    no-undo .
      269       define variable fh_key           as handle    no-undo .
      270       define variable fh_search        as handle    no-undo .
      271       define variable v-field-num      as integer   no-undo .
      272       define variable v-count-fld      as integer   no-undo .
      273       define variable v-inform         as character no-undo .
      274       define variable v-ind            as integer   no-undo .
      275       define variable v-idx-field-qnty as integer   no-undo .
      276       define variable v-field-name     as character no-undo .
      277       define variable v-field-val      as character no-undo .
      278       define variable v-word-link      as character no-undo .
      279       define variable vTable           as character no-undo.
      280       define variable bh_tbl-key       as handle    no-undo .
      281       assign
      282         p-key-rec = trim( p-key-rec )
      283       .
      284       if p-key-handle <> ? then do:
      285         if not valid-handle(p-key-handle)
      286            or p-key-handle:type <> "buffer"
      287         then do:
      288           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      289         end.
      290         if num-entries( p-key-rec, chr(3) ) > 1
      291           or p-key-rec = ?
      292           or p-key-rec = "":U
      293         then do:
      294           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      295         end.
      296       end.
      297       else do:
      298         if p-key-rec = ?
      299           or p-key-rec = "":U
      300         then do:
      301           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      302         end.
      303       end.
      304       assign
      305         vTable = entry( 1 , p-key-rec, chr(3) )
      306       .
      307       if p-tt-handle <> ?
      308         and ( not valid-handle(p-tt-handle)
      309               or p-tt-handle:type <> "buffer"
      310             )
      311       then do:
      312         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      313       end.
      314       if p-tt-handle = ? then do:
      315         assign
      316           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      317         .
      318         create buffer bh_tbl-name for table v-full-tbl-name .
      319       end.
      320       else do:
      321         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      322       end.
      323       assign
      324         v-inform = bh_tbl-name:index-information(1)
      325         v-ind    = 2
      326       .
      327       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      328       on error undo, return error
      329       :
      330         assign
      331           v-inform = bh_tbl-name:index-information( v-ind )
      332           v-ind    = v-ind + 1
      333         .
      334       end.
      335       if v-inform = ?
      336         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      337         or entry( 3, v-inform, ",":U ) <> "1":U
      338       then do:
      339         delete object bh_tbl-name no-error.
      340         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      341       end.
      342       assign
      343         v-idx-field-qnty = num-entries( v-inform ) - 4
      344       .
      345       if v-idx-field-qnty < 2 then do:
      346         delete object bh_tbl-name no-error.
      347         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      348       end.
      349       assign
      350         o-where     = "where":U
      351         v-word-link = "":U
      352         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      353         v-count-fld = 0
      354       .
      355       if i-tablekey ne "" and i-tablekey ne ?
      356       then do:
      357         assign
      358           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      359         .
      360         create buffer bh_tbl-key for table v-full-tbl-name .
      361       end.
      362       if i-tableSerach ne "" and i-tableSerach ne ?
      363       then do:
      364         delete object bh_tbl-name no-error.
      365         assign
      366           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      367         .
      368         create buffer bh_tbl-name for table v-full-tbl-name .
      369       end.
      370       block_where:
      371       do v-ind = 1 to v-idx-field-qnty by 2
      372       on error undo, return error
      373       :
      374         assign
      375           v-count-fld = v-count-fld + 1
      376         .
      377         if p-key-handle = ?
      378           and v-count-fld > v-field-num
      379         then do:
      380           leave block_where.
      381         end.
      382         define variable VfieldKeyTable as handle no-undo.
      383         assign
      384           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      385           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      386         .
      387         if     bh_tbl-key ne ?
      388         then do:
      389            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      390            if VfieldKeyTable eq ?
      391            then next block_where.
      392         end.
      393         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      394         then
      395            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      396         else
      397            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      398         if p-key-handle = ? then do:
      399           assign
      400             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      401           .
      402         end.
      403         else do:
      404           assign
      405             fh_key = p-key-handle:buffer-field( v-field-name )
      406           .
      407           if fh_key = ?
      408             or not valid-handle( fh_key )
      409           then do:
      410             delete object bh_tbl-name.
      411             if     bh_tbl-key ne ?
      412             then
      413                delete object bh_tbl-key.
      414             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      415           end.
      416           assign
      417             v-field-val = fh_key:buffer-value
      418           .
      419         end.
      420         if fh_search:data-type ="character":U then do:
      421           assign
      422             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      423             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      424             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      425             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      426             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      427             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      428             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      429             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      430             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      431             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      432             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      433             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      434             v-field-val = substitute( '"&1"', v-field-val )
      435           .
      436         end.
      437         assign
      438           o-where = substitute( "&1 &2", o-where, v-field-val )
      439         .
      440         if v-word-link = "":U then do:
      441           assign
      442             v-word-link = "and":U
      443           .
      444         end.
      445       end.
      446       delete object bh_tbl-name.
      447       if     bh_tbl-key ne ?
      448       then
      449          delete object bh_tbl-key.
      450       if p-key-handle = ?
      451         and v-count-fld <> v-field-num
      452       then do:
      453         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      454       end.
      455     end.
      456   end procedure.
      457   procedure gen-hn-keyr-tab :
      458     define input  parameter i-tableSerach as character no-undo.
      459     define input  parameter i-tablekey   as character no-undo.
      460     define input  parameter p-key-rec    as character no-undo.
      461     define input  parameter p-key-handle as handle    no-undo .
      462     define input  parameter p-db-name    as character no-undo .
      463     define input  parameter p-tt-handle  as handle    no-undo .
      464     define input  parameter p-stts-lock  as integer   no-undo .
      465     define output parameter o-hn         as handle    no-undo.
      466     define variable v-full-tbl-name as character no-undo.
      467     define variable v-where         as character no-undo.
      468     define variable bh_tbl-name     as handle    no-undo.
      469     define variable vTable          as character no-undo.
      470     do
      471     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      472     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      473     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      474         run gen-where-keyr-tab(i-tableSerach,
      475                                i-tablekey,
      476                                p-key-rec,
      477                                p-key-handle,
      478                                p-db-name,
      479                                p-tt-handle,
      480                                output v-where).
      481         if i-tableSerach ne "" and i-tableSerach ne ?
      482         then do:
      483            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      484            create buffer bh_tbl-name for table v-full-tbl-name .
      485         end.
      486         else do:
      487            if p-tt-handle = ? then do:
      488               assign
      489                  vTable = entry( 1 , p-key-rec, chr(3) )
      490               .
      491               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      492               create buffer bh_tbl-name for table v-full-tbl-name .
      493            end.
      494            else do:
      495               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      496            end.
      497         end.
      498         if p-tt-handle = ? then do:
      499            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      500         end.
      501         else do:
      502            bh_tbl-name:find-first( v-where ) no-error .
      503         end.
      504         o-hn = bh_tbl-name.
      505      end.
      506   end procedure.
      507   procedure gen-hn-keyr :
      508     define input  parameter p-key-rec    as character no-undo.
      509     define input  parameter p-key-handle as handle    no-undo .
      510     define input  parameter p-db-name    as character no-undo .
      511     define input  parameter p-tt-handle  as handle    no-undo .
      512     define input  parameter p-stts-lock  as integer   no-undo .
      513     define output parameter o-hn         as handle    no-undo.
      514     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      515   end.
      516   procedure gen-row-keyr :
      517     define input  parameter p-key-rec    as character no-undo.
      518     define input  parameter p-key-handle as handle    no-undo .
      519     define input  parameter p-db-name    as character no-undo .
      520     define input  parameter p-tt-handle  as handle    no-undo .
      521     define input  parameter p-stts-lock  as integer   no-undo .
      522     define output parameter p-tbl-row    as rowid     no-undo.
      523     define output parameter p-tbl-name   as character no-undo.
      524     define variable vHn as handle no-undo.
      525       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      526       p-tbl-row = if vHn:available then vHn:rowid else ?.
      527       p-tbl-name =  vHn:table.
      528       delete object vHn no-error.
      529     if p-tbl-row = ? then do:
      530       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      531     end.
      532     else do:
      533       return.
      534     end.
      535   end procedure.
      536   procedure gen-key-fv :
      537     define input  parameter p-key-rec    as character no-undo .
      538     define output parameter p-field-list as character no-undo .
      539     define output parameter p-value-list as character no-undo.
      540     do
      541     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      542     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      543     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      544     :
      545       define variable v-full-tbl-name  as character no-undo .
      546       define variable bh_tbl-name      as handle    no-undo .
      547       define variable v-tbl-name       as character no-undo .
      548       define variable v-field-num      as integer   no-undo .
      549       define variable v-count-fld      as integer   no-undo .
      550       define variable v-inform         as character no-undo .
      551       define variable v-ind            as integer   no-undo .
      552       define variable v-idx-field-qnty as integer   no-undo .
      553       define variable v-delim-key      as character no-undo .
      554       if p-key-rec = ?
      555         or p-key-rec = "":U
      556       then do:
      557         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      558       end.
      559       assign
      560         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      561         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      562       .
      563       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      564       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      565       assign
      566         v-inform = bh_tbl-name:index-information(1)
      567         v-ind    = 2
      568       .
      569       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      570       on error undo, return error
      571       :
      572         assign
      573           v-inform = bh_tbl-name:index-information( v-ind )
      574           v-ind    = v-ind + 1
      575         .
      576       end.
      577       if v-inform = ?
      578         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      579         or entry( 3, v-inform, ",":U ) <> "1":U
      580       then do:
      581         delete object bh_tbl-name no-error.
      582         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      583       end.
      584       assign
      585         v-idx-field-qnty = num-entries( v-inform ) - 4
      586       .
      587       if v-idx-field-qnty < 2 then do:
      588         delete object bh_tbl-name no-error.
      589         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      590       end.
      591       assign
      592         p-field-list = "":U
      593         p-value-list = "":U
      594         v-delim-key  = "":U
      595         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      596         v-count-fld  = 0
      597       .
      598       block_where:
      599       do v-ind = 1 to v-idx-field-qnty by 2
      600       on error undo, return error
      601       :
      602         assign
      603           v-count-fld = v-count-fld + 1
      604         .
      605         if v-count-fld > v-field-num then do:
      606           leave block_where.
      607         end.
      608         assign
      609           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      610           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      611         .
      612         if v-ind = 1 then do:
      613           assign
      614             v-delim-key = chr(3)
      615           .
      616         end.
      617       end.
      618       delete object bh_tbl-name.
      619       if v-count-fld <> v-field-num then do:
      620         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      621       end.
      622     end.
      623   end procedure.
      624   procedure gen-key-field :
      625     define input  parameter p-table      as character no-undo .
      626     define output parameter p-field-list as character no-undo .
      627     do
      628     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      629     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      630     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      631     :
      632       define variable v-full-tbl-name  as character no-undo .
      633       define variable bh_tbl-name      as handle    no-undo .
      634       define variable v-tbl-name       as character no-undo .
      635       define variable v-field-num      as integer   no-undo .
      636       define variable v-count-fld      as integer   no-undo .
      637       define variable v-inform         as character no-undo .
      638       define variable v-ind            as integer   no-undo .
      639       define variable v-idx-field-qnty as integer   no-undo .
      640       define variable v-delim-key      as character no-undo .
      641       if p-table = ?
      642         or p-table = "":U
      643       then do:
      644         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      645       end.
      646       assign
      647         v-tbl-name      = p-table
      648         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      649       .
      650       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      651       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      652       assign
      653         v-inform = bh_tbl-name:index-information(1)
      654         v-ind    = 2
      655       .
      656       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      657       on error undo, return error
      658       :
      659         assign
      660           v-inform = bh_tbl-name:index-information( v-ind )
      661           v-ind    = v-ind + 1
      662         .
      663       end.
      664       if v-inform = ?
      665         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      666         or entry( 3, v-inform, ",":U ) <> "1":U
      667       then do:
      668         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      669       end.
      670       assign
      671         v-idx-field-qnty = num-entries( v-inform ) - 4
      672       .
      673       if v-idx-field-qnty < 2 then do:
      674         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      675       end.
      676       assign
      677         p-field-list = "":U
      678         v-delim-key  = "":U
      679         v-count-fld  = 0
      680       .
      681       block_where:
      682       do v-ind = 1 to v-idx-field-qnty by 2
      683       on error undo, return error
      684       :
      685         assign
      686           v-count-fld = v-count-fld + 1
      687         .
      688         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      689         if v-ind = 1 then do:
      690           assign
      691             v-delim-key = chr(3)
      692           .
      693         end.
      694       end.
      695       delete object bh_tbl-name.
      696     end.
      697   end procedure.
      698   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      699   define variable vss-include-info3 as character format "X(65)" no-undo
      700   initial "@(#)$Workfile$ $Revision$".
      701   procedure xmlchar-test :
      702   define input parameter p-in-string          as character        no-undo.
      703   define output parameter p-out-string-enc    as character        no-undo.
      704   define output parameter p-out-string-dec    as character        no-undo.
      705   do
      706   on error undo, return error
      707   :
      708          run xmlchar-encode in this-procedure
      709       (
      710             input p-in-string
      711           , output p-out-string-enc
      712       ).
      713          run xmlchar-decode in this-procedure
      714       (
      715             input p-out-string-enc
      716           , output p-out-string-dec
      717       ).
      718   end.
      719   end .
      720   procedure xmlchar-encode :
      721   define input parameter p-in-string      as character        no-undo.
      722   define output parameter p-out-string    as character        no-undo.
      723       define variable v-position      as integer      no-undo.
      724       define variable v-current-char  as character    no-undo.
      725   do
      726   on error undo, return error
      727   :
      728       assign
      729           p-out-string = "":U
      730       .
      731       case p-in-string
      732       :
      733           when ?
      734           then do:
      735               assign
      736                   p-out-string = "?":U
      737               .
      738           end.
      739           when "?":U
      740           then do:
      741               assign
      742                   p-out-string = "&#63;":U
      743               .
      744           end.
      745           otherwise do:
      746               do v-position = 1 to length( p-in-string )
      747               :
      748                   assign
      749                       v-current-char = substring( p-in-string, v-position, 1 )
      750                   .
      751                   case v-current-char
      752                   :
      753                       when "&":U
      754                       then do:
      755                           assign
      756                               p-out-string = p-out-string + "&amp;":U
      757                           .
      758                       end.
      759                       when ">":U
      760                       then do:
      761                           assign
      762                               p-out-string = p-out-string + "&gt;":U
      763                           .
      764                       end.
      765                       when "<":U
      766                       then do:
      767                           assign
      768                               p-out-string = p-out-string + "&lt;":U
      769                           .
      770                       end.
      771                       when "'":U
      772                       then do:
      773                           assign
      774                               p-out-string = p-out-string + "&apos;":U
      775                           .
      776                       end.
      777                       when '"':U
      778                       then do:
      779                           assign
      780                               p-out-string = p-out-string + "&quot;":U
      781                           .
      782                       end.
      783                       when chr(1)
      784                       then do:
      785                           assign
      786                               p-out-string = p-out-string + "":U
      787                           .
      788                       end.
      789                       when chr(2)
      790                       then do:
      791                           assign
      792                               p-out-string = p-out-string + "":U
      793                           .
      794                       end.
      795                       when chr(3)
      796                       then do:
      797                           assign
      798                               p-out-string = p-out-string + "":U
      799                           .
      800                       end.
      801                       when chr(4)
      802                       then do:
      803                           assign
      804                               p-out-string = p-out-string + "":U
      805                           .
      806                       end.
      807                       when chr(5)
      808                       then do:
      809                           assign
      810                               p-out-string = p-out-string + "":U
      811                           .
      812                       end.
      813                       when chr(6)
      814                       then do:
      815                           assign
      816                               p-out-string = p-out-string + "":U
      817                           .
      818                       end.
      819                       when chr(7)
      820                       then do:
      821                           assign
      822                               p-out-string = p-out-string + "":U
      823                           .
      824                       end.
      825                       when chr(8)
      826                       then do:
      827                           assign
      828                               p-out-string = p-out-string + "":U
      829                           .
      830                       end.
      831                       when chr(9)
      832                       then do:
      833                           assign
      834                               p-out-string = p-out-string + "":U
      835                           .
      836                       end.
      837                       when chr(29)
      838                       then do:
      839                           assign
      840                               p-out-string = p-out-string + "":U
      841                           .
      842                       end.
      843                       when chr(10)
      844                       then do:
      845                           assign
      846                               p-out-string = p-out-string + "&#10;":U
      847                           .
      848                       end.
      849                       when chr(13)
      850                       then do:
      851                           assign
      852                               p-out-string = p-out-string + "&#13;":U
      853                           .
      854                       end.
      855                       otherwise do:
      856                           assign
      857                               p-out-string = p-out-string + v-current-char
      858                           .
      859                       end.
      860                   end case.
      861               end.
      862           end.
      863       end case.
      864   end.
      865   end .
      866   procedure xmlchar-encode-1c :
