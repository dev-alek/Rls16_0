     3852             assign
     3853               buf_parts.qnty      = buf_parts.qnty  + v-unrv-sign * archive_parts.fact-qnty
     3854               buf_parts.fact-qnty = buf_parts.qnty
     3855             .
     3856   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     3858     (input  buf_parts.artic
     3859     ,input  buf_parts.prod-type
     3860     ,input  buf_parts.prod-code
     3861     ,output v-gds-code
     3862     ) no-error .
     3863             if buf_parts.out-code = 'free-zone':U
     3864             then
     3865             for each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = v-gds-code
     3866                                                         and buf_marking-lines.obj-type = archive_parts.obj-type
     3867                                                         and buf_marking-lines.obj-code = archive_parts.obj-code
     3868                                                         and buf_marking-lines.in-code  = archive_parts.in-code
     3869                                                         and buf_marking-lines.out-code = archive_parts.out-code
     3870                                                         and buf_marking-lines.part-code = archive_parts.part-code
     3871                                                         and buf_marking-lines.prt-code = archive_parts.prt-code:
     3872               for first buf_marking exclusive-lock where buf_marking.mark = buf_marking-lines.mark :
     3873                 find first free_marking-lines no-lock where free_marking-lines.mark       = buf_marking-lines.mark
     3874                                                         and free_marking-lines.gds-code   = buf_marking-lines.gds-code
     3875                                                         and free_marking-lines.obj-type   = buf_parts.obj-type
     3876                                                         and free_marking-lines.obj-code   = buf_parts.obj-code
     3877                                                         and free_marking-lines.in-code    = buf_parts.in-code
     3878                                                         and free_marking-lines.out-code   = buf_parts.out-code
     3879                                                         and free_marking-lines.part-code  = buf_parts.part-code
     3880                                                         and free_marking-lines.prt-code   = buf_parts.prt-code
     3881                                                         no-error .
     3882                 if not available free_marking-lines
     3883                 then do :
     3884                   create free_marking-lines .
     3885                   assign
     3886                     free_marking-lines.mark       = buf_marking-lines.mark
     3887                     free_marking-lines.doc-level  = buf_marking-lines.doc-level
     3888                     free_marking-lines.gds-code   = buf_marking-lines.gds-code
     3889                     free_marking-lines.obj-type   = buf_parts.obj-type
     3890                     free_marking-lines.obj-code   = buf_parts.obj-code
     3891                     free_marking-lines.in-code    = buf_parts.in-code
     3892                     free_marking-lines.out-code   = buf_parts.out-code
     3893                     free_marking-lines.part-code  = buf_parts.part-code
     3894                     free_marking-lines.prt-code   = buf_parts.prt-code
     3895                   .
     3896                 end .
     3897                 if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_trn-doc.doc-type <> 'спи':U and
     3898                    not (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U)
     3899                   then assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3900                 if buf_trn-doc.ext-doc-type = 'es':U
     3901                 then do :
     3902                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB .
     3903                 end .
     3904                 for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     3905                   assign buf_marking-chk.sts = 0 .
     3906                 end .
     3907               end .
     3908               delete buf_marking-lines .
     3909             end.
     3910             if v-goods-twounit = true
     3911             then do:
     3912               assign
     3913                 buf_parts.cli-qnty = buf_parts.cli-qnty + v-unrv-sign * archive_parts.cli-qnty
     3914               .
     3915             end.
     3916             else do:
     3917               if buf_parts.cli-base-rate <> 0
     3918               then do:
     3919                 assign
     3920                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3921                 .
     3922               end.
     3923               else do:
     3924                 assign
     3925                   buf_parts.cli-qnty = 0
     3926                 .
     3927               end.
     3928             end.
     3929             if  buf_parts.qnty      = 0
     3930             and buf_parts.fact-qnty = 0
     3931             then do:
     3932               if v-goods-twounit = true
     3933               then do:
     3934                 if buf_parts.cli-qnty <> 0
     3935                 then do:
     3936                   message
     3937                     vss-workfile vss-revision vss-description skip
     3938                     vss-include-info4 skip
     3939                     "Ошибка при удалении партии" skip
     3940                     "Документ" p-doc-code skip
     3941                     "Объект" p-obj-type p-obj-code skip
     3942                     "Артикул" p-artic p-prod-type p-prod-code skip
     3943                     "Партия" buf_parts.in-code buf_parts.part-code skip
     3944                     "Резерв" buf_parts.out-code skip
     3945                     "qnty" buf_parts.qnty skip
     3946                     "fact-qnty" buf_parts.fact-qnty skip
     3947                     "cli-qnty" buf_parts.cli-qnty skip
     3948                     view-as alert-box error .
     3949                   undo, return error .
     3950                 end.
     3951               end.
     3952               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     3953                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     3954                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     3955                                                           and del_marking-lines.in-code = buf_parts.in-code
     3956                                                           and del_marking-lines.out-code = buf_parts.out-code
     3957                                                           and del_marking-lines.part-code = buf_parts.part-code
     3958                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     3959                 delete del_marking-lines .
     3960               end.
     3961               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3962                                           ,input (buffer buf_parts:handle)
     3963                                           ,output part-key-rec).
     3964               for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     3965                                        and ub.gen-attr.p-key =  part-key-rec
     3966               :
     3967                 find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     3968                 find current buf1_gen-attr exclusive-lock.
     3969                 delete buf1_gen-attr .
     3970               end.
     3971               delete buf_parts .
     3972             end.
     3973           end.
     3974         end.
     3975       end.
     3976     end.
     3977   end procedure.
     3978   procedure partcopy-rsrv-parts :
     3979     define input  parameter p-doc-code-rowid as rowid no-undo .
     3980     define input  parameter p-parts-rowid    as rowid no-undo .
     3981     define input  parameter p-rsrv-direction as logical   no-undo .
     3982     define input  parameter p-goods-twounit  as logical   no-undo .
     3983     define input  parameter p-is-hold        as logical   no-undo .
     3984     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     3985     define buffer buf_trn-doc for ub.trn-doc .
     3986     define buffer archive_parts for ub.parts .
     3987     define buffer buf_parts   for ub.parts .
     3988     define buffer orig_marking-lines for ub.marking-lines .
     3989     define buffer buf_marking-lines for ub.marking-lines .
     3990     define buffer buf_marking   for ub.marking .
     3991     define buffer buf_goods for ub.goods .
     3992     define variable v-rsrv-code as character no-undo .
     3993     do
     3994     on error undo, return error return-value
     3995     :
     3996       find first buf_trn-doc no-lock
     3997         where rowid(buf_trn-doc) = p-doc-code-rowid
     3998         no-error .
     3999       if not available buf_trn-doc
     4000       then do:
     4001         message
     4002           vss-workfile vss-revision vss-description skip
     4003           vss-include-info4 skip
     4004           "Ошибка задания входных параметров" skip
     4005           "Не найден документ" skip
     4006           "Документ" string(p-doc-code-rowid) skip
     4007           "Партия" string(p-parts-rowid) skip
     4008           error-status :get-message(1) skip
     4009           return-value skip
     4010           view-as alert-box error .
     4011         undo, return error .
     4012       end.
     4013       find first archive_parts
     4014         where rowid(archive_parts) = p-parts-rowid
     4015         no-error .
     4016       if not available archive_parts
     4017       then do:
     4018         message
     4019           vss-workfile vss-revision vss-description skip
     4020           vss-include-info4 skip
     4021           "Ошибка задания входных параметров" skip
     4022           "Не найдена партия" skip
     4023           "Документ" string(p-doc-code-rowid) skip
     4024           "Партия" string(p-parts-rowid) skip
     4025           error-status :get-message(1) skip
     4026           return-value skip
     4027           view-as alert-box error .
     4028         undo, return error .
     4029       end.
     4030       if  archive_parts.out-code <> archive_parts.in-code
     4031       and archive_parts.qnty <> 0
     4032       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     4033       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     4034       then do:
     4035         assign
     4036           v-rsrv-code =
     4037           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     4038         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     4039         then 'free-zone':U
     4040         else 'out-zone':U )
     4041         .
     4042         run partcopy in this-procedure
     4043           (input  true
     4044           ,input  v-rsrv-code
     4045           ,buffer archive_parts
     4046           ,buffer buf_parts
     4047           ,input  "news"
     4048           ) no-error .
     4049         if error-status :error
     4050         then do:
     4051           message
     4052             vss-workfile vss-revision vss-description skip
     4053             vss-include-info4 skip
     4054             "Ошибка при создании партии" skip
     4055             "Документ" buf_trn-doc.doc-code skip
     4056             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     4057             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     4058             "Партия" archive_parts.in-code archive_parts.part-code skip
     4059             "Количество" archive_parts.qnty skip
     4060             "Резерв" v-rsrv-code skip
     4061             error-status :get-message(1) skip
     4062             return-value skip
     4063             view-as alert-box error .
     4064           undo, return error .
     4065         end.
     4066         assign
     4067           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     4068                                                     * (if p-rsrv-direction = true
     4069                                                       then 1
     4070                                                       else -1
     4071                                                       )
     4072           buf_parts.fact-qnty = buf_parts.qnty
     4073         .
     4074         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     4075                                        and buf_goods.prod-type = archive_parts.prod-type
     4076                                        and buf_goods.prod-code = archive_parts.prod-code
     4077                                        .
     4078         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4079                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     4080                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     4081                                               and orig_marking-lines.in-code    = archive_parts.in-code
     4082                                               and orig_marking-lines.out-code   = archive_parts.out-code
     4083                                               and orig_marking-lines.part-code  = archive_parts.part-code
     4084                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     4085                                               :
     4086           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     4087                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     4088                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     4089                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     4090                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     4091                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     4092                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     4093                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     4094                                                   no-error .
     4095           if available buf_marking-lines
     4096           then do :
     4097             find current buf_marking-lines exclusive-lock .
     4098             delete buf_marking-lines .
     4099             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4100               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     4101             end .
     4102           end .
     4103           else do :
     4104             create buf_marking-lines .
     4105             assign
     4106               buf_marking-lines.mark       = orig_marking-lines.mark
     4107               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4108               buf_marking-lines.gds-code   = buf_goods.gds-code
     4109               buf_marking-lines.obj-type   = buf_parts.obj-type
     4110               buf_marking-lines.obj-code   = buf_parts.obj-code
     4111               buf_marking-lines.in-code    = buf_parts.in-code
     4112               buf_marking-lines.out-code   = buf_parts.out-code
     4113               buf_marking-lines.part-code  = buf_parts.part-code
     4114               buf_marking-lines.prt-code   = buf_parts.prt-code
     4115             .
     4116             if buf_parts.out-code <> buf_parts.in-code
     4117             and buf_parts.out-code <> 'free-zone':U
     4118             and buf_parts.out-code <> 'out-zone':U
     4119             then do :
     4120               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     4121               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     4122             end .
     4123             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4124               assign
     4125                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     4126                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     4127               .
     4128             end .
     4129           end .
     4130           release buf_marking-lines no-error .
     4131         end.
     4132         if p-goods-twounit = true
     4133         then do:
     4134           assign
     4135             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     4136                                                     * (if p-rsrv-direction = true
     4137                                                       then 1
     4138                                                       else -1
     4139                                                       )
     4140           .
     4141         end.
     4142         if  buf_parts.qnty      = 0
     4143         and buf_parts.fact-qnty = 0
     4144         then do:
     4145           if p-goods-twounit = true
     4146           then do:
     4147             if buf_parts.cli-qnty <> 0
     4148             then do:
     4149               message
     4150                 vss-workfile vss-revision vss-description skip
     4151                 vss-include-info4 skip
     4152                 "Ошибка при удалении партии" skip
     4153                 "Документ" buf_trn-doc.doc-code skip
     4154                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     4155                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4156                 "Партия" buf_parts.in-code buf_parts.part-code skip
     4157                 "Резерв" buf_parts.out-code skip
     4158                 "qnty" buf_parts.qnty skip
     4159                 "fact-qnty" buf_parts.fact-qnty skip
     4160                 "cli-qnty" buf_parts.cli-qnty skip
     4161                 view-as alert-box error .
     4162               undo, return error .
     4163             end.
     4164           end.
     4165           delete buf_parts .
     4166         end.
     4167       end.
     4168     end.
     4169   end procedure.
     4170   procedure partcopy-update-doc-line-tot-fact :
     4171     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4172     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4173     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4174     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4175     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     4176       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     4177     define buffer buf_doc-line for ub.doc-line .
     4178     do
     4179     on error undo, return error return-value
     4180     :
     4181       find first buf_doc-line exclusive-lock
     4182         where buf_doc-line.doc-code  = p-doc-code
     4183           and buf_doc-line.artic     = p-artic
     4184           and buf_doc-line.prod-type = p-prod-type
     4185           and buf_doc-line.prod-code = p-prod-code
     4186         no-error .
     4187       if error-status :error
     4188       then do:
     4189         message
     4190           vss-workfile vss-revision vss-description skip
     4191           vss-include-info4 skip
     4192           "Ошибка задания входных параметров" skip
     4193           "Не найдена строка документа" skip
     4194           "Документ" p-doc-code skip
     4195           "Артикул" p-artic p-prod-type p-prod-code skip
     4196           error-status :get-message(1) skip
     4197           return-value skip
     4198           view-as alert-box error .
     4199         undo, return error .
     4200       end.
     4201       run partrqst in this-procedure
     4202         (input buf_doc-line.doc-code
     4203         ,input buf_doc-line.obj-type
     4204         ,input buf_doc-line.obj-code
     4205         ,input buf_doc-line.artic
     4206         ,input buf_doc-line.prod-type
     4207         ,input buf_doc-line.prod-code
     4208               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     4209         ) no-error .
     4210       if error-status :error
     4211       then do:
     4212         message
     4213           vss-workfile vss-revision vss-description skip
     4214           vss-include-info4 skip
     4215           "Ошибка при сборе информации по партиям" skip
     4216           "Документ" p-doc-code skip
     4217           "Артикул" p-artic p-prod-type p-prod-code skip
     4218           view-as alert-box error .
     4219         undo, return error .
     4220       end.
     4221       if v-total-parts-fact-qnty <> 0
     4222       then do:
     4223         assign
     4224           buf_doc-line.price-base      = v-total-parts-price-base
     4225                                        / v-total-parts-fact-qnty
     4226           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     4227                                        / v-total-parts-fact-qnty
     4228           buf_doc-line.transport-base  = v-total-parts-transport-base
     4229                                        / v-total-parts-fact-qnty
     4230           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     4231                                        / v-total-parts-fact-qnty
     4232           buf_doc-line.other-base      = v-total-parts-other-base
     4233                                        / v-total-parts-fact-qnty
     4234           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     4235                                        / v-total-parts-fact-qnty
     4236         .
     4237       end.
     4238       else do:
     4239       end.
     4240     end.
     4241   end procedure.
     4242   procedure partcopy-change-purch-code :
     4243     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     4244     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     4245     define parameter buffer buf_orig_parts     for ub.parts .
     4246     define parameter buffer buf1_parts         for ub.parts .
     4247     define parameter buffer buf2_parts         for ub.parts .
     4248     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     4249     define variable var-out-code  like ub.parts.out-code no-undo .
     4250     define variable var-part-code like ub.parts.part-code no-undo .
     4251     define buffer buf_goods        for ub.goods .
     4252     define buffer buf_parts-root   for ub.parts-root.
     4253     define buffer buf_trn-doc      for ub.trn-doc.
     4254     define buffer buf-orig_trn-doc for ub.trn-doc.
     4255     define buffer buf_units        for ub.units .
     4256     do
     4257     on error undo, return error return-value
     4258     :
     4259       if buf_orig_parts.out-code = p-in-code
     4260       then do:
     4261         message
     4262           vss-workfile vss-revision vss-description skip
     4263           vss-include-info4 skip
     4264           "Ошибка задания входных параметров процедуры partcopy" skip
     4265           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     4266           "p-in-code" p-in-code skip
     4267           view-as alert-box error .
     4268         undo, return error .
     4269       end.
     4270       find first buf_trn-doc no-lock
     4271         where buf_trn-doc.doc-code = p-in-code
     4272         .
     4273       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     4274       find first buf_goods no-lock
     4275         where buf_goods.artic = buf_orig_parts.artic
     4276           and buf_goods.prod-type = buf_orig_parts.prod-type
     4277           and buf_goods.prod-code = buf_orig_parts.prod-code
     4278         .
     4279       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     4280       find first buf1_parts exclusive-lock
     4281         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     4282           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     4283           and buf1_parts.artic     = buf_orig_parts.artic
     4284           and buf1_parts.prod-type = buf_orig_parts.prod-type
     4285           and buf1_parts.prod-code = buf_orig_parts.prod-code
     4286           and buf1_parts.in-code   = buf_orig_parts.in-code
     4287           and buf1_parts.out-code  = p-in-code
     4288           and buf1_parts.part-code = buf_orig_parts.part-code
     4289         no-error.
     4290       if not available buf1_parts
     4291       then do:
     4292         create buf1_parts .
     4293         buffer-copy buf_orig_parts to buf1_parts
     4294         assign
     4295           buf1_parts.in-code    = buf_orig_parts.in-code
     4296           buf1_parts.out-code   = p-in-code
     4297           buf1_parts.status_    = no
     4298           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     4299           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     4300           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     4301           buf1_parts.purch-code = buf_orig_parts.purch-code
     4302           buf1_parts.rsrv-free  = ?
     4303           buf1_parts.status_    = yes
     4304         .
     4305         validate buf1_parts .
     4306       end.
     4307       if  lookup('сер':U, buf_units.type) > 0
     4308       then do:
     4309          var-part-code = buf_orig_parts.part-code.
     4310       end.
     4311       else do:
     4312           run holdprts-get-part-code in this-procedure
     4313             (input  p-in-code
     4314             ,output var-part-code
     4315             ) no-error .
     4316           if error-status :error
     4317           then dO:
     4318             undo, return error return-value.
     4319           end.
     4320       end.
     4321       find first buf2_parts exclusive-lock
     4322         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     4323           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     4324           and buf2_parts.artic     = buf_orig_parts.artic
     4325           and buf2_parts.prod-type = buf_orig_parts.prod-type
     4326           and buf2_parts.prod-code = buf_orig_parts.prod-code
     4327           and buf2_parts.in-code   = p-in-code
     4328           and buf2_parts.out-code  = p-in-code
     4329           and buf2_parts.part-code = var-part-code
     4330         no-error.
     4331       if not available buf2_parts
     4332       then do:
     4333         create buf2_parts .
     4334         buffer-copy buf_orig_parts to buf2_parts
     4335         assign
     4336           buf2_parts.in-code   = p-in-code
     4337           buf2_parts.out-code  = p-in-code
     4338           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     4339           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     4340           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     4341           buf2_parts.purch-code = p-dest-purch-code
     4342           buf2_parts.part-code  = var-part-code
     4343           buf2_parts.rsrv-free  = ?
     4344           buf2_parts.status_    = yes
     4345         .
     4346         validate buf2_parts .
     4347       end.
     4348       assign
     4349         buf_orig_parts.in-code    = p-in-code
     4350         buf_orig_parts.part-code  = buf2_parts.part-code
     4351         buf_orig_parts.purch-code = buf2_parts.purch-code
     4352       .
     4353       find first buf_parts-root
     4354         where buf_parts-root.doc-code       = p-in-code
     4355           and buf_parts-root.in-code        = p-in-code
     4356           and buf_parts-root.gds-code       = buf_goods.gds-code
     4357           and buf_parts-root.part-code      = buf2_parts.part-code
     4358           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     4359           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     4360           and buf_parts-root.orig-part-code = buf1_parts.part-code
     4361         no-error .
     4362       if not available buf_parts-root
     4363       then do:
     4364         create buf_parts-root.
     4365         assign
     4366         buf_parts-root.doc-code       = p-in-code
     4367         buf_parts-root.in-code        = p-in-code
     4368         buf_parts-root.gds-code       = buf_goods.gds-code
     4369         buf_parts-root.part-code      = buf2_parts.part-code
     4370         buf_parts-root.orig-in-code   = buf1_parts.in-code
     4371         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     4372         buf_parts-root.orig-part-code = buf1_parts.part-code
     4373         .
     4374       end.
     4375     end.
     4376   end procedure.
     4377   procedure addChildMarkingLines:
     4378     define input parameter iMark as character no-undo.
     4379     define input parameter iSts  as integer   no-undo.
     4380     define parameter buffer buf_marking-lines  for ub.marking-lines.
     4381     define parameter buffer buf_parts          for ub.parts.
     4382     define parameter buffer orig_marking-lines for ub.marking-lines.
     4383     define parameter buffer buf_orig_parts     for ub.parts.
     4384     define parameter buffer buf_goods          for ub.goods.
     4385     define buffer buf_marking-childs        for ub.marking.
     4386     define buffer buf_marking-lines-childs  for ub.marking-lines.
     4387     define buffer buf_marking-chk           for ub.marking-chk.
     4388     define buffer buf_chk-doc               for ub.chk-doc.
     4389     define buffer orig_marking-lines-childs for ub.marking-lines.
     4390     for each buf_marking-childs exclusive-lock where
     4391              buf_marking-childs.mark-parent = iMark :
     4392         find first buf_marking-lines-childs no-lock where
     4393                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     4394                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     4395                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     4396                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     4397                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     4398                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     4399                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     4400                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     4401         no-error .
     4402         if not available buf_marking-lines-childs then
     4403         do:
     4404           create buf_marking-lines-childs .
     4405           assign
     4406             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     4407             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     4408             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     4409             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     4410             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     4411             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     4412             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     4413             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     4414             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     4415             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     4416           .
     4417           validate buf_marking-childs.
     4418         end .
     4419         buf_marking-childs.sts = iSts .
     4420         for each buf_marking-chk exclusive-lock where
     4421                  buf_marking-chk.mark begins buf_marking-childs.mark
     4422         :
     4423           for first buf_chk-doc no-lock where
     4424                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     4425                 and buf_chk-doc.out-code = buf_parts.out-code
     4426           :
     4427             buf_marking-chk.sts = 0 .
     4428             validate buf_marking-chk.
     4429           end .
     4430         end .
     4431         if available orig_marking-lines
     4432         then do :
     4433           find first orig_marking-lines-childs exclusive-lock where
     4434                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     4435                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     4436                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     4437                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     4438                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     4439                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     4440                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     4441                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     4442           no-error .
     4443           if available orig_marking-lines-childs then
     4444             delete orig_marking-lines-childs .
     4445         end.
     4446         run addChildMarkingLines in this-procedure (
     4447           buf_marking-childs.mark,
     4448           iSts,
     4449           buffer buf_marking-lines,
     4450           buffer buf_parts,
     4451           buffer orig_marking-lines,
     4452           buffer buf_orig_parts,
     4453           buffer buf_goods
     4454         ).
     4455     end .
     4456   end.
     4457   define variable unrv-code as character no-undo .
     4458   define buffer buf_parts for ub.parts .
     4459   define variable l-goods-twounit as logical no-undo .
     4460   main-block :
     4461   do transaction
     4462   on error undo, return error
     4463   :
     4464     find first ub.trn-doc no-lock
     4465       where ub.trn-doc.doc-code = p-doc-code
     4466       no-error .
     4467     if error-status :error then do:
     4468       message
     4469         vss-workfile vss-revision vss-description skip
     4470         "Ошибка задания входных параметров" skip
     4471         "Не найден документ" skip
     4472         "Документ" p-doc-code skip
     4473         view-as alert-box error .
     4474       undo, return error .
     4475     end.
     4476     for each ub.doc-line no-lock
     4477       where ub.doc-line.doc-code = p-doc-code
     4478     on error undo main-block, return error
     4479     :
     4480       find first ub.goods no-lock
     4481         where ub.goods.artic     = ub.doc-line.artic
     4482           and ub.goods.prod-type = ub.doc-line.prod-type
     4483           and ub.goods.prod-code = ub.doc-line.prod-code
     4484         no-error .
     4485       if not available ub.goods then do:
     4486         message
     4487           vss-workfile vss-revision vss-description skip
     4488           "Не найден товар" skip
     4489           "Документ" ub.trn-doc.doc-code skip
     4490           "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     4491           view-as alert-box error .
     4492         undo, return error .
     4493       end.
     4494   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4495   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4496     (input  ub.goods.artic
     4497     ,input  ub.goods.prod-type
     4498     ,input  ub.goods.prod-code
     4499     ,input  'twounit=request':u
     4500     ,output l-goods-twounit
     4501     ) no-error .
     4502       if error-status :error then do:
     4503         message
     4504           vss-workfile vss-revision vss-description skip
     4505           "Ошибка при определении атрибута товара" skip
     4506           "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
     4507           error-status :get-message(1) skip
     4508           return-value skip
     4509           view-as alert-box error .
     4510         undo, return error .
     4511       end.
     4512       if ub.goods.gds-type = 'т':U then do:
     4513         for each ub.parts
     4514           where ub.parts.out-code  = ub.doc-line.doc-code
     4515             and ub.parts.obj-type  = ub.doc-line.obj-type
     4516             and ub.parts.obj-code  = ub.doc-line.obj-code
     4517             and ub.parts.artic     = ub.doc-line.artic
     4518             and ub.parts.prod-code = ub.doc-line.prod-code
     4519             and ub.parts.prod-type = ub.doc-line.prod-type
     4520             and ub.parts.in-code <> ub.parts.out-code
     4521         on error undo main-block, return error
     4522         :
     4523           if can-do('рас,спи':U,ub.trn-doc.doc-type)
     4524           or (ub.trn-doc.doc-type = 'инв':U
     4525               and ub.parts.fact-qnty < 0)
     4526           then do:
     4527             assign
     4528               unrv-code = 'free-zone':U
     4529             .
     4530           end.
     4531           else do:
     4532             assign
     4533               unrv-code = 'out-zone':U
     4534             .
     4535           end.
     4536           if  ub.parts.in-code <> ub.parts.out-code
     4537           and ub.parts.in-code <> 'стар. приход':U then do:
     4538             run partcopy in this-procedure
     4539               (input  true
     4540               ,input  unrv-code
     4541               ,buffer ub.parts
     4542               ,buffer buf_parts
     4543               ,input ""
     4544               ) no-error .
     4545             if error-status :error then do:
     4546               message
     4547                 vss-workfile vss-revision vss-description skip
     4548                 "Ошибка при создании партии" skip
     4549                 "Объект" ub.parts.obj-type ub.parts.obj-code skip
     4550                 "Артикул" ub.parts.artic ub.parts.prod-type ub.parts.prod-code skip
     4551                 "Партия" ub.parts.in-code ub.parts.part-code skip
     4552                 "Резерв" unrv-code skip
     4553                 error-status :get-message(1) skip
     4554                 return-value skip
     4555                 view-as alert-box error .
     4556               undo, return error .
     4557             end.
     4558             assign
     4559               buf_parts.qnty      = buf_parts.qnty - abs(ub.parts.qnty)
     4560               buf_parts.fact-qnty = buf_parts.qnty
     4561             .
     4562             if l-goods-twounit = true then do:
     4563               assign
     4564                 buf_parts.cli-qnty = buf_parts.cli-qnty - abs(ub.parts.cli-qnty)
     4565               .
     4566             end.
     4567             if  buf_parts.qnty      = 0
     4568             and buf_parts.fact-qnty = 0 then do:
     4569               if l-goods-twounit = true then do:
     4570                 if buf_parts.cli-qnty <> 0 then do:
     4571                   message
     4572                     vss-workfile vss-revision vss-description skip
     4573                     "Ошибка при удалении партии" skip
     4574                     "Объект" buf_parts.obj-type buf_parts.obj-code skip
     4575                     "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4576                     "Партия" buf_parts.in-code buf_parts.part-code skip
     4577                     "Резерв" buf_parts.out-code skip
     4578                     "qnty" buf_parts.qnty skip
     4579                     "fact-qnty" buf_parts.fact-qnty skip
     4580                     "cli-qnty" buf_parts.cli-qnty skip
     4581                     view-as alert-box error .
     4582                   undo, return error .
     4583                 end.
     4584               end.
     4585               delete buf_parts .
     4586             end.
     4587           end.
     4588         end.
     4589       end.
     4590     end.
     4591   end.
