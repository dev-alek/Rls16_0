      906                       then do:
      907                           assign
      908                               p-out-string = p-out-string + " ":U
      909                           .
      910                       end.
      911                       when chr(4)
      912                       then do:
      913                           assign
      914                               p-out-string = p-out-string + " ":U
      915                           .
      916                       end.
      917                       when chr(5)
      918                       then do:
      919                           assign
      920                               p-out-string = p-out-string + " ":U
      921                           .
      922                       end.
      923                       when chr(6)
      924                       then do:
      925                           assign
      926                               p-out-string = p-out-string + " ":U
      927                           .
      928                       end.
      929                       when chr(7)
      930                       then do:
      931                           assign
      932                               p-out-string = p-out-string + " ":U
      933                           .
      934                       end.
      935                       when chr(8)
      936                       then do:
      937                           assign
      938                               p-out-string = p-out-string + " ":U
      939                           .
      940                       end.
      941                       when chr(9)
      942                       then do:
      943                           assign
      944                               p-out-string = p-out-string + " ":U
      945                           .
      946                       end.
      947                       when chr(29)
      948                       then do:
      949                           assign
      950                               p-out-string = p-out-string + " ":U
      951                           .
      952                       end.
      953                       when chr(10)
      954                       then do:
      955                           assign
      956                               p-out-string = p-out-string + " ":U
      957                           .
      958                       end.
      959                       when chr(13)
      960                       then do:
      961                           assign
      962                               p-out-string = p-out-string + " ":U
      963                           .
      964                       end.
      965                       otherwise do:
      966                           assign
      967                               p-out-string = p-out-string + v-current-char
      968                           .
      969                       end.
      970                   end case.
      971               end.
      972           end.
      973       end case.
      974   end.
      975   end .
      976   procedure xmlchar-decode :
      977   define input parameter p-in-string      as character        no-undo.
      978   define output parameter p-out-string    as character        no-undo.
      979       define variable v-position      as integer      no-undo.
      980       define variable v-last-position as integer      no-undo.
      981       define variable v-temp-integer  as integer      no-undo.
      982       define variable v-current-char  as character    no-undo.
      983       define variable v-next-char     as character    no-undo.
      984       define variable v-success       as logical      no-undo.
      985   do
      986   on error undo, return error
      987   :
      988       assign
      989           p-out-string = "":U
      990           v-position   = 0
      991       .
      992       replace-cycle:
      993       do while yes
      994       on error undo, return error
      995       :
      996           assign
      997               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      998           .
      999           if v-last-position <= v-position
     1000           then do:
     1001               if v-position = 0
     1002               then do:
     1003                   assign
     1004                       p-out-string = p-in-string
     1005                   .
     1006               end.
     1007               else do:
     1008                   assign
     1009                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1010                   .
     1011               end.
     1012               leave replace-cycle.
     1013           end.
     1014           else do:
     1015               assign
     1016                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1017                   v-position      = v-last-position
     1018                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1019               .
     1020               if v-current-char = "#":U
     1021               then do:
     1022                   assign
     1023                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1024                   .
     1025                   if v-last-position > 0
     1026                   then do:
     1027                       run xmlchar-read-integer in this-procedure
     1028                        (
     1029                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1030                           , output v-temp-integer
     1031                           , output v-success
     1032                       ).
     1033                       if v-success = yes
     1034                       and v-temp-integer >= 1
     1035                       and v-temp-integer <= 255
     1036                       then do:
     1037                           assign
     1038                               p-out-string = p-out-string + chr( v-temp-integer )
     1039                               v-position   = v-last-position + 1
     1040                           .
     1041                       end.
     1042                       else do:
     1043                           assign
     1044                               p-out-string = p-out-string + "&":U
     1045                               v-position   = v-position   + 1
     1046                           .
     1047                       end.
     1048                   end.
     1049                   else do:
     1050                       assign
     1051                           p-out-string = p-out-string + "&":U
     1052                           v-position   = v-position   + 1
     1053                       .
     1054                   end.
     1055               end.
     1056               else do:
     1057                   case substring( p-in-string, v-position + 1, 3 )
     1058                   :
     1059                       when "lt;":U
     1060                       then do:
     1061                           assign
     1062                               p-out-string = p-out-string + "<":U
     1063                               v-position   = v-position   + 3
     1064                           .
     1065                       end.
     1066                       when "gt;":U
     1067                       then do:
     1068                           assign
     1069                               p-out-string = p-out-string + ">":U
     1070                               v-position   = v-position   + 3
     1071                           .
     1072                       end.
     1073                       otherwise do:
     1074                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1075                           then do:
     1076                               assign
     1077                                   p-out-string = p-out-string + "&":U
     1078                                   v-position   = v-position   + 4
     1079                               .
     1080                           end.
     1081                           else do:
     1082                               case substring( p-in-string, v-position + 1, 5 )
     1083                               :
     1084                                   when "quot;":U
     1085                                   then do:
     1086                                       assign
     1087                                           p-out-string = p-out-string + '"':U
     1088                                           v-position   = v-position   + 5
     1089                                       .
     1090                                   end.
     1091                                   when "apos;":U
     1092                                   then do:
     1093                                       assign
     1094                                           p-out-string = p-out-string + "'":U
     1095                                           v-position   = v-position   + 5
     1096                                       .
     1097                                   end.
     1098                                   otherwise do:
     1099                                       assign
     1100                                           p-out-string = p-out-string + "&":U
     1101                                       .
     1102                                   end.
     1103                               end case.
     1104                           end.
     1105                       end.
     1106                   end case.
     1107               end.
     1108           end.
     1109       end.
     1110   end.
     1111   end .
     1112   procedure xmlchar-read-integer :
     1113   define input parameter p-input-string      as character        no-undo.
     1114   define output parameter p-output-integer   as integer          no-undo.
     1115   define output parameter p-success       as logical          no-undo.
     1116   do
     1117   on error undo, return error
     1118   :
     1119       assign
     1120           p-output-integer = integer( p-input-string )
     1121       no-error.
     1122       if error-status :error
     1123       then do:
     1124           assign
     1125               p-success           = no
     1126               p-output-integer    = 0
     1127           .
     1128       end.
     1129       else do:
     1130           assign
     1131               p-success           = yes
     1132           .
     1133       end.
     1134   end.
     1135   end.
     1136   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1137   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1138   define new global shared variable g#attr-lib  as handle no-undo .
     1139   define variable v-attr-lib-variable as handle no-undo .
     1140   define variable mMRCCode  as logical    no-undo.
     1141   define variable mTypeMark as character  no-undo.
     1142   function IS-NeedMark returns logical
     1143   ( input ib-code as integer  ,
     1144     input ib-str as character ):
     1145      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1146      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1147                                    and buf_prod-bc-attr.b-str  eq ib-str
     1148                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1149        no-lock no-error.
     1150      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1151   end.
     1152   function repTegforDm return char
     1153   (iDM as char ):
     1154       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1155       define variable vteg as character no-undo.
     1156       define variable oDM as character no-undo.
     1157       define variable vi as integer no-undo.
     1158       oDM = iDm.
     1159       do vi = 1 to num-entries(vTeglist):
     1160          vTeg = entry(vi,vTeglist).
     1161          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1162       end.
     1163       return oDM.
     1164   end.
     1165   function repSpecSimbforDm return char
     1166   (iDM as char ):
     1167       define variable oDM as character no-undo.
     1168     run
     1169       xmlchar-decode(iDM, output oDM).
     1170     return repTegforDm (oDM).
     1171   end.
     1172   function CheckGtin return logical
     1173   (iGtin as char):
     1174      define variable bar_code as character no-undo.
     1175      define variable vGtin as logical no-undo init "yes".
     1176      if length(iGtin) eq 14
     1177      then do:
     1178         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1179         run str/chk-sum.p
     1180          (input-output bar_code ) no-error .
     1181         if iGtin ne  bar_code
     1182         then
     1183            vGtin = no.
     1184      end.
     1185      else
     1186         vGtin = no.
     1187      return vgtin.
     1188   end.
     1189   function repSpecSimbforXlm return char
     1190   (iDM as char ):
     1191       iDM = replace(iDM,chr(29),"").
     1192       return iDM.
     1193   end.
     1194   function getGtinByDM return char
     1195   (IDM as char):
     1196      define variable VTXT as char no-undo.
     1197      define variable vGtin as char no-undo.
     1198      vTXt = IdM.
     1199      vGtin = IDM.
     1200      if    length(vtxt) > 14
     1201      then do:
     1202         if   vtxt begins "(01)"
     1203                or vtxt begins "(02)"
     1204         then
     1205            vGtin = substring(vtxt,5,14).
     1206         else if   (vtxt begins "01"
     1207                or vtxt begins "02" )
     1208                and (   (    substring(iDm,17,2) eq "21"
     1209                         and length(vtxt) >= 21)
     1210                     or substring(iDm,17,2) eq "37"
     1211                     or substring(iDm,17,4) eq "(37)" )
     1212         then do:
     1213            vGtin = substring(vtxt,3,14).
     1214            if not checkGtin(vGtin)
     1215            then
     1216               vGtin = substring(vtxt,1,14).
     1217         end.
     1218         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1219             or length(vtxt) eq 14 + 7 + 4
     1220             or length(vtxt) eq 14 + 7
     1221         then
     1222            vGtin = substring(vtxt,1,14).
     1223      end.
     1224      if not checkGtin(vGtin)
     1225      then
     1226         vGtin = "".
     1227      return vgtin.
     1228   end.
     1229   function getGdsCodeByGtin return int
     1230   (iGtin as char):
     1231      define buffer prod-bc  for ub.prod-bc.
     1232      define buffer bar-code for ub.bar-code.
     1233      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1234      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1235      return if avail bar-code then bar-code.gds-code else ?.
     1236   end.
     1237   function getQntyCodeByGtin return decimal
     1238   (iGtin as char):
     1239      define buffer prod-bc  for ub.prod-bc.
     1240      define buffer bar-code for ub.bar-code.
     1241      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1242      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1243      return if avail bar-code then bar-code.cli-base-rate else ?.
     1244   end.
     1245   function getGdsCodeByDM return int
     1246   (iDm as char):
     1247      define variable vGtin as char no-undo.
     1248      define buffer prod-bc for ub.prod-bc.
     1249      vGtin  = getGtinByDM (IDM ).
     1250      return getGdsCodeByGtin (vGtin).
     1251   end.
     1252   function ChekTypeMarkByGds return logical
     1253   (iGds-code as integer ):
     1254      define buffer goods-attr for ub.goods-attr.
     1255      find first goods-attr where goods-attr.gds-code   = iGds-code
     1256                              and goods-attr.attr-code  = 'mark-type':U
     1257      no-lock no-error.
     1258      if available goods-attr
     1259      then do:
     1260         mTypeMark = goods-attr.attr-value.
     1261         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1262           .
     1263      end.
     1264      else
     1265         return no.
     1266   end.
     1267   function ChekTypeMarkByDm return logical
     1268   (iDM as char ):
     1269      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1270   end.
     1271   function ChekTypeMarkByGtin return logical
     1272   (iGtin as char ):
     1273      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1274   end.
     1275   function GetNextElement return character
     1276     (input iAllTeg        as logical
     1277     ,output oteg          as character
     1278     ,output otegval       as character
     1279     ,input-output pstr    as character
     1280      ):
     1281        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1282        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1283        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1284        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1285        define variable vTeg as character no-undo.
     1286        define variable vLength as integer no-undo.
     1287        define variable vi as integer no-undo.
     1288        define variable vj as integer no-undo.
     1289        define buffer code for ub.code.
     1290        find first code where Code.parent eq "MarkType"
     1291                          and Code.CodeValue   eq mTypeMark
     1292                          no-lock no-error.
     1293        if     available code
     1294           and Code.misc1 ne ""
     1295           and Code.misc1 ne ?
     1296        then do:
     1297           integer (Code.misc1) no-error.
     1298           if not error-status:error
     1299           then
     1300             entry (4,vlistleng) = Code.misc1.
     1301        end.
     1302        if iAllTeg
     1303        then
     1304           assign
     1305              vlistElem     = vlistElem    + vlistElemDop
     1306              vlistleng     = vlistleng    + vlistlengDop
     1307           .
     1308        else if mMRCCode
     1309        then
     1310           assign
     1311              vlistElem     = vlistElem    + ",(8005),8005"
     1312              vlistleng     = vlistleng    + ",000006,0006"
     1313           .
     1314       block-elem:
     1315       do vi = 1 to num-entries(vlistElem):
     1316          vTeg = entry(vi,vlistElem).
     1317          if pstr begins vTeg
     1318          then do:
     1319             if    vTeg eq "21"
     1320             then
     1321                vLength = index(pstr,chr(29)) - 2 no-error.
     1322             if vLength  <= 0
     1323             then
     1324                vLength = int(entry(vi,vlistleng)).
     1325             otegval = substring (pstr,length(vteg) + 1, vLength).
     1326             oteg = replace(replace(vteg,")",""),"(","").
     1327             vTeg = vteg + otegval.
     1328             otegval = replace(otegval,chr(29),"").
     1329             oteg = replace(replace(oteg,")",""),"(","").
     1330             pstr = substring (pstr,length(vTeg)+ 1).
     1331             vTeg = replace(vTeg,chr(29),"").
     1332             leave block-elem.
     1333          end.
     1334          else
     1335             vTeg = "".
     1336       end.
     1337       return vteg.
     1338   end.
     1339   function GetCodeIdent return character
     1340   (iDm as char):
     1341      define variable Velement   as character no-undo init "first".
     1342      define variable oCodeIdent as character no-undo.
     1343      define variable vteg as character no-undo.
     1344      define variable vtegval as character no-undo.
     1345      define variable vGtin as character no-undo.
     1346      define buffer marking for ub.marking.
     1347      for first marking no-lock where
     1348                marking.mark eq iDm
     1349            and marking.unit-ext = "LEVEL2"
     1350      :
     1351        return iDm.
     1352      end.
     1353      vGtin  = getGtinByDM (iDm ).
     1354      ChekTypeMarkByDm(idm).
     1355      if iDm begins 'tech_':U
     1356      then
     1357         oCodeIdent = iDm.
     1358      else if length(iDm) < 21
     1359      then do:
     1360         find first marking where marking.mark eq idm
     1361         no-lock no-error.
     1362         oCodeIdent = if available marking then marking.mark else  ?.
     1363      end.
     1364      else if     length(iDm) eq 29
     1365         and not iDm begins "01"
     1366         and not iDm begins "02"
     1367      then
     1368         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1369      else  if     length(iDm) >= 24
     1370               and (  iDm begins "01"
     1371                   or iDm begins "02")
     1372               and  substring(iDm,17,2) ne "21"
     1373      then do:
     1374         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1375                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1376         then
     1377            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1378         else
     1379            oCodeIdent = iDM.
     1380      end.
     1381      else  if     (   length(iDm) eq 25
     1382                    or length(iDm) eq 21)
     1383               and (not iDm begins "01"
     1384               and  not iDm begins "02")
     1385      then
     1386         oCodeIdent = substring(iDm,1,21).
     1387      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1388      then
     1389         oCodeIdent = substring(iDm,1,21).
     1390      else do while Velement ne "" and idm ne "":
     1391         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1392         oCodeIdent = oCodeIdent + Velement.
     1393      end.
     1394      return oCodeIdent.
     1395   end.
     1396   function GetTegCod return character
     1397   (icodeIdent as char, iTeg as char):
     1398      define variable Velement   as character no-undo init "first".
     1399      define variable oTeg as character no-undo init ?.
     1400      define variable vteg as character no-undo.
     1401      define variable vtegval as character no-undo.
     1402      if     ((length(icodeIdent) eq 21
     1403         and not icodeIdent begins "01"
     1404         and not icodeIdent begins "02")
     1405         or
     1406             ( length(icodeIdent) eq 25
     1407               and not icodeIdent begins "01"
     1408               and not icodeIdent begins "02"))
     1409      then do:
     1410         if iTeg eq "01" or iTeg eq "02"
     1411         then
     1412            oTeg = substring(icodeIdent,1,21).
     1413         else  if  iTeg eq "21"
     1414         then
     1415            oTeg = substring(icodeIdent,15,7).
     1416      end.
     1417      else do:
     1418         ChekTypeMarkByDm(icodeIdent).
     1419         block-teg:
     1420            do while Velement ne "" and icodeIdent ne "":
     1421            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1422            if    Velement begins iTeg
     1423               or Velement begins "(" + iTeg + ")"
     1424            then do:
     1425               oTeg = vtegval.
     1426               leave block-teg.
     1427            end.
     1428         end.
     1429      end.
     1430      return oTeg.
     1431   end.
     1432   function isOAD return logical
     1433   (icodeIdent as character):
     1434      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1435   end.
     1436   function isMark return logical
     1437   (icodeIdent as character):
     1438      define buffer buf_marking for ub.marking.
     1439      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1440             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1441   end.
     1442   function addBracketForCode return character
     1443   (icodeIdent as char):
     1444      define variable Velement   as character no-undo init "first".
     1445      define variable oTeg as character no-undo.
     1446      define variable vteg as character no-undo.
     1447      define variable vtegval as character no-undo.
     1448      define buffer marking for ub.marking.
     1449      find first marking no-lock where
     1450                 marking.mark begins icodeIdent no-error.
     1451      if    not ChekTypeMarkByDm(icodeIdent)
     1452         or length(icodeIdent) le 24
     1453         or (avail marking and marking.unit-ext = "LEVEL2")
     1454      then
     1455         oTeg = icodeIdent.
     1456      else do:
     1457         if (  icodeIdent begins "01"
     1458            or icodeIdent begins "02"
     1459            ) and CheckGtin(substring (icodeIdent,3,14))
     1460            and substring (icodeIdent,17,2) eq "21"
     1461         then do:
     1462            mMRCCode = yes.
     1463            ChekTypeMarkByDm(icodeIdent).
     1464            block-teg:
     1465            do while Velement ne "" and icodeIdent ne "":
     1466               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1467               if vteg ne ""
     1468               then
     1469                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1470            end.
     1471            mMRCCode = no.
     1472         end.
     1473         else do:
     1474            oTeg = icodeIdent.
     1475         end.
     1476      end.
     1477      return oTeg.
     1478   end.
     1479   function getlevelByCodId return int
     1480   (iCode as char):
     1481      define variable vLength as int no-undo.
     1482      define variable vLevel  as int no-undo.
     1483      if not ChekTypeMarkByDM (icode) then return ?.
     1484      vLength = length(iCode).
     1485      if    vLength eq 18
     1486         or vLength eq 20
     1487      then
     1488         Vlevel = 4.
     1489      else if vLength eq 21
     1490      then
     1491         Vlevel = 1.
     1492      else if vLength eq 25
     1493      then do:
     1494         if  iCode begins "01"
     1495         then
     1496            Vlevel = 3.
     1497         else
     1498            Vlevel = 1.
     1499      end.
     1500      else if     vLength >= 26
     1501              and vLength <= 46
     1502      then do:
     1503         if    substring(iCode,17,2) eq "11"
     1504            or substring(iCode,17,2) eq "13"
     1505            or (    substring(iCode,17,2) eq "21"
     1506                and vLength >= 33
     1507                and substring(iCode,26,4) ne "8005")
     1508         then
     1509            Vlevel = 4.
     1510         else if    vLength eq 31
     1511                 or vLength eq 38
     1512                 or vLength eq 39
     1513                 or vLength eq 45
     1514         then
     1515            Vlevel = 1.
     1516         else if    vLength eq 35
     1517                 or vLength eq 43
     1518         then
     1519            Vlevel = 3.
     1520         else
     1521            Vlevel = ?.
     1522      end.
     1523      else
     1524         Vlevel = ?.
     1525      return Vlevel.
     1526   end.
     1527   function getLevelMotpBycodid return character
     1528   (iDm as char):
     1529      define variable vLevel as integer no-undo.
     1530      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1531      vLevel = getlevelByCodId(iDm).
     1532      if    vLevel eq ?
     1533         or vLevel < 1
     1534         or vLevel > 6
     1535      then
     1536         return ?.
     1537      else
     1538         return entry(vlevel,vList).
     1539   end.
     1540   function getLevelUTDByLevelMotp return character
     1541   (iUnit as char):
     1542      define variable vLevel as integer no-undo.
     1543      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1544      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1545      vLevel = lookup(iUnit,vListMOTP).
     1546      if    vLevel eq ?
     1547         or vLevel < 1
     1548         or vLevel > 4
     1549      then
     1550         return ?.
     1551      else
     1552         return entry(vlevel,vListutd).
     1553   end.
     1554   function getLevelMotpByDM return character
     1555   (iDm as char):
     1556      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1557   end.
     1558   function getLevelUTDByCodId return character
     1559   (iDm as char):
     1560      define variable vLevel as integer no-undo.
     1561      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1562      vLevel = getlevelByCodId(iDm).
     1563      if    vLevel eq ?
     1564         or vLevel < 1
     1565         or vLevel > 4
     1566      then
     1567         return ?.
     1568      else
     1569         return entry(vlevel,vList).
     1570   end.
     1571   function getLevelUTDByDM return character
     1572   (iDm as char):
     1573      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1574   end.
     1575   define variable mNotMarkQnty as logical no-undo.
     1576   function getQntyUTDByCodId return decimal
     1577   (iDM as char):
     1578      define variable vLevel as integer no-undo.
     1579      define variable vList as character no-undo init "1,5,10,500".
     1580      define variable vGtin as character no-undo.
     1581      define variable vqnty as decimal no-undo init ?.
     1582      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1583      if vqnty eq ?
     1584      then do:
     1585         if not mNotMarkQnty
     1586         then do:
     1587            define buffer marking for ub.marking.
     1588            define variable vCodident as character no-undo.
     1589            vCodident = GetCodeIdent(idm).
     1590            find first marking where marking.mark begins vCodident no-lock no-error.
     1591            if     available marking
     1592               and marking.box-qnty ne ?
     1593            then
     1594               return marking.box-qnty.
     1595         end.
     1596         vGtin = getGtinByDm(iDM).
     1597         if ChekTypeMarkByGtin (vGtin)
     1598         then do:
     1599            vLevel = getlevelByCodId(iDM).
     1600            if     vLevel >= 1
     1601               and vLevel <= 4
     1602            then
     1603               vqnty = int(entry(vlevel,vList)).
     1604         end.
     1605         else
     1606            vqnty = getQntyCodeByGtin(vgtin).
     1607      end.
     1608      return vqnty.
     1609   end.
     1610   function getQntyUTDByDM return decimal
     1611   (iDm as char):
     1612      define variable vDM as character no-undo.
     1613      if     length (iDm) ne 25
     1614         and length (iDm) ne 29
     1615         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1616      then
     1617         vDM = substring (iDm,1,length (iDm) - 6 ).
     1618      else
     1619         vDM = substring (iDm,1,length (iDm) - 4 ).
     1620      return getQntyUTDByCodId(vDM).
     1621   end.
     1622   function getMRC4 return decimal
     1623   (iMRC as char):
     1624      define variable oMrc     as decimal no-undo init ?.
     1625      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1626      define variable vi       as integer no-undo.
     1627      define variable vfound   as integer no-undo.
     1628      define variable vposStart   as integer no-undo.
     1629      do:
     1630      OMRc = 0.
     1631      do vi = 1 to 4:
     1632         define variable vsimb as character no-undo.
     1633         vsimb = substring(iMRC,vi,1).
     1634         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1635         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1636         if vfound > 0
     1637         then
     1638            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1639         end.
     1640         OMRc = OMRc / 100.
     1641      end.
     1642      return OMRc.
     1643   end.
     1644   function getMRCByDM return decimal
     1645   (iDm as char):
     1646      define variable vMRC     as character no-undo.
     1647      define variable oMrc     as decimal no-undo init ?.
     1648      define variable Velement as character no-undo init "empty".
     1649      define variable vteg as character no-undo.
     1650      define variable vtegval as character no-undo.
     1651      if    length(idm) eq 14 + 7 + 4 + 4
     1652         or length(idm) eq 14 + 7 + 4
     1653      then do:
     1654         vMRC = substring(idm,22,4).
     1655         omrc = getMRC4(vMRC).
     1656      end.
     1657      else do:
     1658          ChekTypeMarkByDm(iDm).
     1659          block-mrc:
     1660          do while Velement ne "" and idm ne "":
     1661             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1662             if Velement begins "8005"
     1663             then do:
     1664                vMRC = substring(Velement,5,6).
     1665                leave block-mrc.
     1666             end.
     1667             else if Velement begins "(8005)"
     1668             then do:
     1669                vMRC = substring(Velement,7,6).
     1670                leave block-mrc.
     1671             end.
     1672          end.
     1673          if vMRC ne ""
     1674          then
     1675             OMRc = dec(vmrc) / 100 no-error.
     1676      end.
     1677      return OMRc.
     1678   end.
     1679   function MoveDate return Date
     1680   (idate as date,
     1681    iMonth as int64):
     1682      define variable vMonth   as int64 no-undo.
     1683      define variable vYear    as int64 no-undo.
     1684      define variable vDateNew as date  no-undo.
     1685       define variable vDay     as int64 no-undo.
     1686       vMonth = month(iDate) + iMonth.
     1687       vYear =  year(iDate).
     1688       if vMonth <= 0
     1689       then assign
     1690          vMonth = vMonth + 12
     1691           vYear  = vYear - 1
     1692       .
     1693       else if vMonth > 12
     1694       then assign
     1695          vMonth = vMonth - 12
     1696           vYear  = vYear + 1
     1697       .
     1698       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1699       do while error-status:error eq yes:
     1700          VDay = vDay + 1.
     1701          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1702       end.
     1703       if VDay > 0
     1704       then
     1705          vDateNew + 1.
     1706       return vDateNew.
     1707   end.
     1708   procedure checkEMRC:
     1709   define input  parameter iDm as character no-undo.
     1710   define output parameter vok as logical   no-undo init yes.
     1711      define variable v-value-emrc as character no-undo.
     1712      define variable v-type-emrc  as character no-undo.
     1713      define variable vDateIso     as character no-undo.
     1714      define variable vMRC         as decimal no-undo.
     1715      define variable vqnty        as decimal no-undo.
     1716      define variable vPrice       as decimal no-undo.
     1717      define variable vparent      as character no-undo.
     1718      define variable vgds-code    as integer no-undo.
     1719      define buffer code for ub.code.
     1720      vMRC = getMRCByDM(iDm).
     1721      if vMRC > 0
     1722      then do:
     1723         vgds-code = getGdsCodeByDM(iDm).
     1724         vqnty     = getQntyUTDByDM(iDm).
     1725               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1726            (
     1727             input   vgds-code
     1728            ,input   'emrc-type':U
     1729            ,output   v-value-emrc
     1730            ,output   v-type-emrc
     1731          ) no-error.
     1732          if     v-value-emrc ne ""
     1733             and v-value-emrc ne ?
     1734          then do:
     1735             vDateIso = iso-date(today).
     1736             vPrice = vMRC / vqnty.
     1737             vparent ="emc" + chr(4) + v-value-emrc.
     1738             find last code where Code.parent      eq vparent
     1739                              and Code.code        le vDateIso
     1740                              and code.status_  eq 0
     1741             no-lock no-error.
     1742             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1743             then
     1744                vOk = true .
     1745             else do:
     1746                 define variable vText      as character no-undo.
     1747                 define variable vDate      as date no-undo.
     1748                 define variable vDateLast  as character no-undo.
     1749                 define variable vDateFirst as character no-undo.
     1750                 define variable vDate3     as date no-undo.
     1751                 vdate = date(code.misc1).
     1752                 vDateLast = code.misc1.
     1753                 vDate3 = MoveDate(today, - 3 ).
     1754                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1755                                      string(vDate3  , "99/99/9999"),
     1756                                      string(vDate   , "99/99/9999")
     1757                                      ).
     1758                 vdateIso = iso-date(vdate3).
     1759                 find last code  where Code.parent      eq vparent
     1760                                   and Code.code        le vDateIso
     1761                                   and code.status_  eq 0 no-lock no-error.
     1762                 if available code
     1763                 then
     1764                    vDateIso = code.code.
     1765                 vDateFirst = vDateIso.
     1766                 vDateLast = iso-date(vdate).
     1767                 define variable vGood as logical no-undo.
     1768                 define variable vDateSale as date no-undo.
     1769                 define buffer bcode for code.
     1770                 for last code where Code.parent   eq vparent
     1771                                 and code.status_  eq 0
     1772                                 and code.code     < vDateLast
     1773                                 and code.code     >= vDateFirst
     1774                 no-lock:
     1775                    find first bcode where bCode.parent   eq vparent
     1776                                       and bcode.status_  eq 0
     1777                                       and bcode.code     > code.code no-lock no-error.
     1778                    if available bcode
     1779                    then do:
     1780                       if vPrice < dec(Code.CodeValue)
     1781                       then
     1782                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1783                                                     chr(10),
     1784                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1785                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1786                                                     ).
     1787                       else do:
     1788                          vGood = yes.
     1789                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1790                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1791                                                     chr(10),
     1792                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1793                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1794                                                     string(         vDateSale            ,"99/99/9999"),
     1795                                                     string(vDateSale - today)
     1796                                                     ).
     1797                       end.
     1798                    end.
     1799                 end.
     1800                 if vgood
     1801                 then do:
     1802                    define variable choice as integer no-undo .
     1803                    run gbl/d-askw.w (input "Уточнение"
     1804                           ,input  vText
     1805                           ,input "|"
     1806                           ,input "Принять|Вернуть"
     1807                           ,input "Принять данный товар|Вернуть товар постащику"
     1808                           ,input 1
     1809                           ,input 2
     1810                           ,output choice) no-error.
     1811                    vok = choice eq 1.
     1812                 end.
     1813                 else
     1814                    vok =false.
     1815             end.
     1816          end.
     1817      end.
     1818   end.
     1819   function addGs2Mark return character
     1820   (iMark as char):
     1821      define variable vDM   as character no-undo.
     1822      define variable vIdx  as integer   no-undo.
     1823      if index(iMark,chr(29),1) > 0
     1824      then return iMark.
     1825      if substring(iMark,26,4) = "8005" then
     1826      do:
     1827        vIdx = index(iMark,"93",26 + 4 + 5).
     1828        if vIdx > 1 then do:
     1829          vDM = substitute("&1&4&2&4&3",
     1830                           substring(iMark,1,25),
     1831                           substring(iMark,26,vIdx - 25 - 1),
     1832                           substring(iMark,vIdx),
     1833                           chr(29)) no-error.
     1834          vIdx = index(vDm,"240",vIdx + 4).
     1835          if vIdx > 0 then
     1836          do:
     1837            vDM = substitute("&1&3&2",
     1838                             substring(vDm,1,vIdx - 1),
     1839                             substring(vDm,vIdx),
     1840                             chr(29)) no-error.
     1841          end.
     1842        end.
     1843        else
     1844          vDM = substitute("&1&3&2",
     1845                           substring(iMark,1,25),
     1846                           substring(iMark,26),
     1847                           chr(29)) no-error.
     1848      end.
     1849      else if substring(iMark,32,2) = "91" then
     1850      do:
     1851        vIdx = index(iMark,"92",32).
     1852        if vIdx > 1 then
     1853          vDM = substitute("&1&4&2&4&3",
     1854                           substring(iMark,1,31),
     1855                           substring(iMark,32,vIdx - 31 - 1),
     1856                           substring(iMark,vIdx),
     1857                           chr(29)) no-error.
     1858        else
     1859          vDM = substitute("&1&3&2",
     1860                           substring(iMark,1,31),
     1861                           substring(iMark,32),
     1862                           chr(29)) no-error.
     1863      end.
     1864      else if substring(iMark,39,2) = "91" then
     1865      do:
     1866        vIdx = index(iMark,"92",38).
     1867        if vIdx > 1 then
     1868          vDM = substitute("&1&4&2&4&3",
     1869                           substring(iMark,1,38),
     1870                           substring(iMark,39,vIdx - 38 - 1),
     1871                           substring(iMark,vIdx),
     1872                           chr(29)) no-error.
     1873        else
     1874          vDM = substitute("&1&3&2",
     1875                           substring(iMark,1,38),
     1876                           substring(iMark,39),
     1877                           chr(29)) no-error.
     1878      end.
     1879      else if substring(iMark,25,2) = "93" then
     1880      do:
     1881        vIdx = index(iMark,"92",25).
     1882        if vIdx > 1 then
     1883          vDM = substitute("&1&4&2&4&3",
     1884                           substring(iMark,1,24),
     1885                           substring(iMark,25,vIdx - 24 - 1),
     1886                           substring(iMark,vIdx),
     1887                           chr(29)) no-error.
     1888        else
     1889          vIdx = index(iMark,"3103",25).
     1890          if vIdx > 0 then
     1891          vDM = substitute("&1&4&2&4&3",
     1892                           substring(iMark,1,24),
     1893                           substring(iMark,25,vIdx - 24 - 1),
     1894                           substring(iMark,vIdx),
     1895                           chr(29)) no-error.
     1896          else
     1897            vDM = substitute("&1&3&2",
     1898                             substring(iMark,1,24),
     1899                             substring(iMark,25),
     1900                             chr(29)) no-error.
     1901      end.
     1902      else if substring(iMark,32,2) = "93" then
     1903      do:
     1904        vDM = substitute("&1&3&2",
     1905              substring(iMark,1,31),
     1906              substring(iMark,32),
     1907              chr(29)) no-error.
     1908      end.
     1909      return if vDM <> "" then vDm else iMark.
     1910   end.
     1911   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1912   procedure partcopy :
     1913     define input parameter  p-free-output-copy as logical   no-undo .
     1914     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     1915     define parameter buffer buf_orig_parts     for ub.parts .
     1916     define parameter buffer buf_parts          for ub.parts .
     1917     define input parameter  p-mark             as character no-undo .
     1918     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     1919     define variable v-value-character as character no-undo .
     1920     define variable v-value-date      as date no-undo .
     1921     define variable v-value-decimal   as decimal no-undo .
     1922     define variable v-value-integer   as integer no-undo .
     1923     define variable v-izlcstpr        as logical no-undo .
     1924     define variable v-tth             as handle no-undo .
     1925     define variable v-type            as character no-undo .
     1926     define variable part-key-rec      as character no-undo .
     1927     define variable orig-part-key-rec as character no-undo .
     1928     define variable del-part-key-rec  as character no-undo .
     1929     define variable objMarks as class excisemarks  no-undo .
     1930     define variable v-parent-mark-sts as integer   no-undo .
     1931     define variable v-mark-sts-list   as character no-undo .
     1932     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     1933     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     1934     define buffer buf_gen-attr for ub.gen-attr .
     1935     define buffer buf1_gen-attr for ub.gen-attr .
     1936     define buffer buf_doc-line  for ub.doc-line .
     1937     define buffer buf_marking for ub.marking .
     1938     define buffer buf_marking-childs for ub.marking .
     1939     define buffer orig_marking-lines for ub.marking-lines .
     1940     define buffer orig_marking-lines-childs for ub.marking-lines .
     1941     define buffer buf_marking-lines for ub.marking-lines .
     1942     define buffer buf_marking-lines-childs for ub.marking-lines .
     1943     define buffer buf_marking-pack for ub.marking .
     1944     define buffer buf_marking-chk for ub.marking-chk .
     1945     define buffer buf_goods for ub.goods .
     1946     define buffer buf_trn-doc for ub.trn-doc .
     1947     define buffer pri_trn-doc for ub.trn-doc .
     1948     define buffer buf_chk-doc for ub.chk-doc .
     1949     do
     1950     on error undo, return error return-value
     1951     :
     1952       if p-free-output-copy = true
     1953       then do:
     1954         if  p-out-code <> 'free-zone':U
     1955         and p-out-code <> 'out-zone':U
     1956         then do:
     1957           message
     1958             vss-workfile vss-revision vss-description skip
     1959             vss-include-info4 skip
     1960             "Ошибка задания входных параметров процедуры partcopy" skip
     1961             "p-free-output-copy" p-free-output-copy skip
     1962             "p-out-code" p-out-code skip
     1963             view-as alert-box error .
     1964           undo, return error .
     1965         end.
     1966       end.
     1967       if buf_orig_parts.out-code <> p-out-code
     1968       then do:
     1969         find first buf_parts exclusive-lock
     1970           where buf_parts.obj-type  = buf_orig_parts.obj-type
     1971             and buf_parts.obj-code  = buf_orig_parts.obj-code
     1972             and buf_parts.artic     = buf_orig_parts.artic
     1973             and buf_parts.prod-type = buf_orig_parts.prod-type
     1974             and buf_parts.prod-code = buf_orig_parts.prod-code
     1975             and buf_parts.in-code   = buf_orig_parts.in-code
     1976             and buf_parts.out-code  = p-out-code
     1977             and buf_parts.part-code = buf_orig_parts.part-code
     1978           no-error.
     1979         if not available buf_parts
     1980         then do:
     1981           define variable v-rsrv-free as logical   no-undo .
     1982           if p-out-code = 'free-zone':U
     1983           or p-out-code = 'out-zone':U
     1984           then do:
     1985             assign
     1986               v-rsrv-free =
     1987          (if p-out-code = 'free-zone':U then yes else no)
     1988             .
     1989           end.
     1990           else do:
     1991             assign
     1992               v-rsrv-free = ?
     1993             .
     1994           end.
     1995           create buf_parts .
     1996           buffer-copy buf_orig_parts to buf_parts
     1997           assign
     1998             buf_parts.out-code  = p-out-code
     1999             buf_parts.status_   = no
     2000             buf_parts.rsrv-free = v-rsrv-free
     2001             buf_parts.qnty      = 0
     2002             buf_parts.fact-qnty = 0
     2003             buf_parts.real-qnty = 0
     2004             buf_parts.cli-qnty  = 0
     2005           .
     2006           validate buf_parts .
     2007         end.
     2008         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2009                                           ,input (buffer buf_orig_parts:handle)
     2010                                           ,output orig-part-key-rec).
     2011         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2012                                           ,input (buffer buf_parts:handle)
     2013                                           ,output part-key-rec).
     2014         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     2015               and ub.gen-attr.p-key =  orig-part-key-rec:
     2016             if not valid-object (objMarks)
     2017               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     2018               if p-out-code = 'free-zone':U
     2019               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     2020                then
     2021               do:
     2022                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     2023                   if objMarks:StatusErr
     2024                       then
     2025                   do:
     2026                       message objMarks:ReturnMsg view-as alert-box error.
     2027                       delete object objMarks no-error.
     2028                       undo, return error.
     2029                   end.
     2030               end.
     2031             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     2032             do:
     2033                 if p-mark <> "" then do:
     2034                 if p-out-code = 'free-zone':U then do:
     2035                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     2036                 end.
     2037                 else do:
     2038                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     2039                 end.
     2040                 if objMarks:StatusErr
     2041                   then
     2042                 do:
     2043                   message objMarks:ReturnMsg view-as alert-box error.
     2044                   delete object objMarks no-error.
     2045                   undo, return error.
     2046                 end.
     2047               end.
     2048             end.
     2049             if p-out-code = 'out-zone':U then
     2050             do:
     2051                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     2052                 if objMarks:StatusErr
     2053                     then
     2054                 do:
     2055                     message objMarks:ReturnMsg view-as alert-box error.
     2056                     delete object objMarks no-error.
     2057                     undo, return error.
     2058                 end.
     2059             end.
     2060         end.
     2061         delete object objMarks no-error.
     2062         if p-mark = "news" then return .
     2063         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     2064         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     2065         if not available buf_trn-doc
     2066         then
     2067            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     2068         if (
     2069             p-out-code = 'free-zone':U
     2070             and buf_orig_parts.in-code = buf_orig_parts.out-code
     2071            )
     2072         or
     2073            (
     2074             p-out-code = 'free-zone':U
     2075             and available pri_trn-doc
     2076             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     2077            )
     2078         or
     2079            (
     2080             available buf_trn-doc
     2081             and p-out-code = buf_trn-doc.doc-code
     2082             and buf_trn-doc.ext-doc-type = 'vt':U
     2083            )
     2084         or
     2085            (
     2086             p-mark = ""
     2087             and available buf_trn-doc
     2088             and p-out-code = 'free-zone':U
     2089             and buf_trn-doc.ext-doc-type = 'vt':U
     2090            )
     2091         or
     2092            (
     2093             p-mark = ""
     2094             and available buf_trn-doc
     2095             and p-out-code = 'free-zone':U
     2096             and buf_trn-doc.ext-doc-type = 'rs':U
     2097            )
     2098         then do :
     2099           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     2100             and ub.goods.prod-type = buf_parts.prod-type
     2101             and ub.goods.prod-code = buf_parts.prod-code.
     2102           def buffer buf_orig_ml for ub.marking-lines.
     2103           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
     2104             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     2105             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     2106             and buf_orig_ml.in-code = buf_orig_parts.in-code
     2107             and buf_orig_ml.out-code = buf_orig_parts.out-code
     2108             and buf_orig_ml.part-code = buf_orig_parts.part-code
     2109             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     2110             if available pri_trn-doc
     2111             and pri_trn-doc.ext-doc-type = 'iv':U
     2112             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     2113             then do :
     2114               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     2115                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     2116               end .
     2117               next .
     2118             end .
     2119             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     2120                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     2121                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     2122                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     2123                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     2124                                                   and ub.marking-lines.out-code = p-out-code
     2125                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     2126                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     2127                                                   no-error .
     2128             if not available ub.marking-lines
     2129             then do :
     2130               create ub.marking-lines.
     2131               buffer-copy buf_orig_ml to ub.marking-lines
     2132               assign
     2133                 ub.marking-lines.out-code  = p-out-code
     2134                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     2135               .
     2136               validate ub.marking-lines.
     2137             end .
     2138             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     2139             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     2140               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     2141               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     2142                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     2143                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     2144                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     2145                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     2146               then do:
     2147                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2148                 validate buf_marking.
     2149               end.
     2150             end .
     2151           end .
     2152           end.
     2153         end .
     2154         define variable v-doc-type  as character no-undo .
     2155         define variable   v-status    as character no-undo .
     2156         define variable v-fact-qnty   as  decimal no-undo .
     2157         define variable ii    as integer no-undo .
     2158         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     2159                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     2160                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     2161                                        .
     2162         if available pri_trn-doc
     2163         and pri_trn-doc.ext-doc-type = 'rs':U
     2164         then do :
     2165           if p-mark <> ""
     2166           then do :
     2167           end .
     2168           else do :
     2169           end .
     2170         end .
     2171         else do :
     2172           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     2173           and p-mark <> ""
     2174           then do :
     2175             if p-out-code = 'free-zone':U
     2176             then do:
     2177                 if chg-qnty < 0
     2178                 then do :
     2179                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     2180                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     2181                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2182                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2183                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2184                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2185                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2186                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2187                                                           no-error .
     2188                   if available orig_marking-lines
     2189                   then do :
     2190                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     2191                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     2192                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     2193                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     2194                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     2195                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     2196                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     2197                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     2198                                                            no-error .
     2199                     if not available buf_marking-lines
     2200                     then do :
     2201                       create buf_marking-lines .
     2202                       assign
     2203                         buf_marking-lines.mark       = p-mark
     2204                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2205                         buf_marking-lines.gds-code   = buf_goods.gds-code
     2206                         buf_marking-lines.obj-type   = buf_parts.obj-type
     2207                         buf_marking-lines.obj-code   = buf_parts.obj-code
     2208                         buf_marking-lines.in-code    = buf_parts.in-code
     2209                         buf_marking-lines.out-code   = buf_parts.out-code
     2210                         buf_marking-lines.part-code  = buf_parts.part-code
     2211                         buf_marking-lines.prt-code   = buf_parts.prt-code
     2212                       .
     2213                       validate buf_marking-lines.
     2214                     end .
     2215                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     2216                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2217                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     2218                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     2219                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     2220                                                         :
     2221                           assign buf_marking-chk.sts = 0 .
     2222                           validate buf_marking-chk.
     2223                         end .
     2224                       end .
     2225                       if buf_marking.unit-ext <> "UNIT" or
     2226                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     2227                       then do :
     2228                         run addChildMarkingLines in this-procedure (
     2229                           buf_marking.mark,
     2230                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     2231                           buffer buf_marking-lines,
     2232                           buffer buf_parts,
     2233                           buffer orig_marking-lines,
     2234                           buffer buf_orig_parts,
     2235                           buffer buf_goods
     2236                         ).
     2237                       end .
     2238                     end.
     2239                     find current orig_marking-lines exclusive-lock .
     2240                     delete orig_marking-lines .
     2241                   end .
     2242                 end .
     2243             end.
     2244             else do:
     2245               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     2246                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     2247                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2248                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2249                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2250                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2251                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2252                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2253                                                              no-error .
     2254                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     2255                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     2256                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     2257                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     2258                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     2259                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     2260                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     2261                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     2262                                                         no-error .
     2263                 if not available buf_marking-lines
     2264                 then do :
     2265                   create buf_marking-lines .
     2266                   assign
     2267                     buf_marking-lines.mark       = p-mark
     2268                     buf_marking-lines.doc-level  = 1
     2269                     buf_marking-lines.gds-code   = buf_goods.gds-code
     2270                     buf_marking-lines.obj-type   = buf_parts.obj-type
     2271                     buf_marking-lines.obj-code   = buf_parts.obj-code
     2272                     buf_marking-lines.in-code    = buf_parts.in-code
     2273                     buf_marking-lines.out-code   = buf_parts.out-code
     2274                     buf_marking-lines.part-code  = buf_parts.part-code
     2275                     buf_marking-lines.prt-code   = buf_parts.prt-code
     2276                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     2277                   .
     2278                   validate buf_marking-lines.
     2279                 end .
     2280                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     2281                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     2282                   validate buf_marking.
     2283                   for first buf_marking-childs exclusive-lock where
     2284                             buf_marking-childs.mark = buf_marking.mark-parent:
     2285                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     2286                     validate buf_marking-childs.
     2287                   end.
     2288                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     2289                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     2290                                                     and buf_chk-doc.out-code = buf_parts.out-code
     2291                                                     :
     2292                       if buf_marking-chk.sts <> 2 then
     2293                       do:
     2294                          assign buf_marking-chk.sts = 1 .
     2295                          validate buf_marking-chk.
     2296                       end.
     2297                     end .
     2298                   end .
     2299                   if buf_marking.unit-ext <> "UNIT" or
     2300                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     2301                   then do :
     2302                     run addChildMarkingLines in this-procedure (
     2303                       buf_marking.mark,
     2304                       buf_marking.sts,
     2305                       buffer buf_marking-lines,
     2306                       buffer buf_parts,
     2307                       buffer orig_marking-lines,
     2308                       buffer buf_orig_parts,
     2309                       buffer buf_goods
     2310                     ).
     2311                   end .
     2312                 end.
     2313                 if available orig_marking-lines then
     2314                   delete orig_marking-lines .
     2315             end.
     2316           end.
     2317         end .
     2318         if p-out-code = 'out-zone':U
     2319         and trim(p-mark) = ""
     2320         then do :
     2321           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     2322                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2323                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2324                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2325                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2326                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2327                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2328                                                 :
     2329             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     2330                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     2331                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     2332                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     2333                                                     and buf_marking-lines.out-code   = p-out-code
     2334                                                     no-error .
     2335             if available buf_marking-lines
     2336             then do :
     2337               find current buf_marking-lines exclusive-lock .
     2338               delete buf_marking-lines .
     2339               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     2340                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     2341                 then do :
     2342                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2343                   validate buf_marking.
     2344                 end.
     2345               end .
     2346             end .
     2347             else do :
     2348               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     2349               create buf_marking-lines .
     2350               assign
     2351                 buf_marking-lines.mark       = orig_marking-lines.mark
     2352                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2353                 buf_marking-lines.gds-code   = buf_goods.gds-code
     2354                 buf_marking-lines.obj-type   = buf_parts.obj-type
     2355                 buf_marking-lines.obj-code   = buf_parts.obj-code
     2356                 buf_marking-lines.in-code    = buf_parts.in-code
     2357                 buf_marking-lines.out-code   = buf_parts.out-code
     2358                 buf_marking-lines.part-code  = buf_parts.part-code
     2359                 buf_marking-lines.prt-code   = buf_parts.prt-code
     2360               .
     2361               validate buf_marking-lines.
     2362               if buf_parts.out-code <> buf_parts.in-code
     2363               and buf_parts.out-code <> 'free-zone':U
     2364               and buf_parts.out-code <> 'out-zone':U
     2365               then do :
     2366                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     2367                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     2368               end .
     2369               end.
     2370             end .
     2371             release buf_marking-lines no-error .
     2372           end.
     2373         end .
     2374         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     2375         then do:
     2376           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     2377                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     2378                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2379                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2380                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2381                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2382                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2383                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2384                                                   .
     2385             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     2386                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     2387                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     2388                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     2389                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     2390                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     2391                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     2392                                                    no-error .
     2393             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     2394               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     2395                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     2396               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     2397                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     2398               validate ub.marking.
     2399             end.
     2400             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     2401             if available (buf_marking-lines)
     2402             then do:
     2403               assign
     2404                 buf_marking-lines.mark       = p-mark
     2405                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2406                 buf_marking-lines.gds-code   = buf_goods.gds-code
     2407                 buf_marking-lines.obj-type   = buf_parts.obj-type
     2408                 buf_marking-lines.obj-code   = buf_parts.obj-code
     2409                 buf_marking-lines.in-code    = buf_parts.in-code
     2410                 buf_marking-lines.out-code   = buf_parts.out-code
     2411                 buf_marking-lines.part-code  = buf_parts.part-code
     2412               .
     2413               validate buf_marking-lines.
     2414             end.
     2415           end.
     2416         end.
     2417       end.
     2418       else do:
     2419         find first buf_parts exclusive-lock
     2420           where recid(buf_parts) = recid(buf_orig_parts)
     2421           .
     2422       end.
     2423       if p-out-code = 'free-zone':U
     2424       or p-out-code = 'out-zone':U
     2425       then do:
     2426         if buf_parts.rsrv-free <>
     2427          (if buf_parts.out-code = 'free-zone':U then yes else no)
     2428         then do:
     2429           message
     2430             vss-workfile vss-revision vss-description skip
     2431             vss-include-info4 skip
     2432             "Ошибка типа резерва партии" skip
     2433             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     2434             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     2435             "Партия" buf_parts.in-code buf_parts.part-code skip
     2436             "Резерв" buf_parts.out-code skip
     2437             "Статус" buf_parts.status_ skip
     2438             "Тип резерва" buf_parts.rsrv-free skip
     2439             view-as alert-box error .
     2440           undo, return error .
     2441         end.
     2442       end.
     2443     end.
     2444   end procedure.
     2445   procedure partcopy-to-childs-mark :
     2446     define parameter buffer buf_ml for ub.marking-lines .
     2447     define parameter buffer buf_orig-ml for ub.marking-lines .
     2448     define input parameter p-out-code as character no-undo .
     2449     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     2450     define buffer buf_ml-childs for ub.marking-lines .
     2451     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     2452       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     2453         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     2454       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     2455         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     2456       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     2457         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     2458         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     2459         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     2460         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     2461         and buf_ml-childs.part-code = buf_orig-ml.part-code
     2462         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     2463         :
     2464         assign
     2465           buf_ml-childs.out-code  = p-out-code
     2466         .
     2467         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     2468       end.
     2469     end.
     2470   end.
     2471   procedure partcopy-update-parts :
     2472     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     2473     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     2474     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     2475     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     2476     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     2477     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     2478     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     2479     define buffer buf_trn-doc for ub.trn-doc .
     2480     define buffer archive_parts for ub.parts .
     2481     define buffer buf_parts   for ub.parts .
     2482     define buffer orig_marking-lines for ub.marking-lines .
     2483     define buffer buf_marking for ub.marking .
     2484     define buffer buf_goods for ub.goods .
     2485     define variable v-rsrv-code     as character no-undo .
     2486     define variable v-goods-twounit as logical   no-undo .
     2487     define variable v-value-character as character no-undo .
     2488     define variable v-value-date      as date no-undo .
     2489     define variable v-value-decimal   as decimal no-undo .
     2490     define variable v-value-integer   as integer no-undo .
     2491     define variable v-izlcstpr        as logical no-undo .
     2492     define variable v-tth             as handle no-undo .
