     2517       find first buf_goods no-lock where buf_goods.artic = p-artic
     2518                                      and buf_goods.prod-type = p-prod-type
     2519                                      and buf_goods.prod-code = p-prod-code
     2520                                      no-error .
     2521       if not available buf_goods
