     2968             then do:
     2969   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2970   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     2971     (input  buf_trn-doc.doc-code
     2972     ,output v-is-hold
     2973     ) no-error .
     2974               if error-status :error
     2975               then do:
     2976                 message
     2977                   vss-workfile vss-revision vss-description skip
     2978                   vss-include-info4
     2979                   "Ошибка при определении типа документа hold-doc.i" skip
     2980                   "Документ" p-doc-code skip
     2981                   "Объект" p-obj-type p-obj-code skip
     2982                   "Артикул" p-artic p-prod-type p-prod-code skip
     2983                   error-status :get-message(1) skip
     2984                   return-value skip
     2985                   view-as alert-box error .
     2986                 undo, return error .
     2987               end.
     2988               assign
     2989                 v-rsrv-code = 'out-zone':U
     2990               .
     2991               if buf_trn-doc.ext-doc-type  = 'ep':U
     2992               or (buf_trn-doc.ext-doc-type = 'ap':U )
     2993               or (buf_trn-doc.ext-doc-type = 'pc':U )
     2994               then do:
     2995                 assign
     2996                   v-rsrv-code = ""
     2997                 .
     2998                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     2999                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     3000                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     3001                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     3002                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     3003                                                       and orig_marking-lines.part-code  = archive_parts.part-code,
     3004                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3005                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB .
     3006                 end .
     3007               end.
     3008             end.
     3009             else do:
     3010               assign
     3011                 v-rsrv-code = 'free-zone':U
     3012               .
     3013             end.
     3014             if v-rsrv-code <> ""
     3015             then do:
     3016               run partcopy in this-procedure
     3017                 (input  true
     3018                 ,input  v-rsrv-code
     3019                 ,buffer archive_parts
     3020                 ,buffer buf_parts
     3021                 ,input  ""
     3022                 ) no-error .
     3023               if error-status :error
     3024               then do:
     3025                 message
     3026                   vss-workfile vss-revision vss-description skip
     3027                   vss-include-info4 skip
     3028                   "Ошибка при создании партии" skip
     3029                   "Документ" buf_trn-doc.doc-code skip
     3030                   "Объект" archive_parts.obj-type archive_parts.obj-code skip
     3031                   "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     3032                   "Партия" archive_parts.in-code archive_parts.part-code skip
     3033                   "Резерв" v-rsrv-code skip
     3034                   error-status :get-message(1) skip
     3035                   return-value skip
     3036                   view-as alert-box error .
     3037                 undo, return error .
     3038               end.
     3039               assign
     3040                 buf_parts.qnty      = buf_parts.qnty + abs(archive_parts.fact-qnty)
     3041                 buf_parts.fact-qnty = buf_parts.qnty
     3042               .
     3043               if v-goods-twounit = true
     3044               then do:
     3045                 define variable v-qnty-sign as integer   no-undo .
     3046                 assign
     3047                   v-qnty-sign = 1
     3048                 .
     3049                 if  buf_trn-doc.doc-type = 'инв':U
     3050                 and archive_parts.fact-qnty < 0
     3051                 then do:
     3052                   assign
     3053                     v-qnty-sign = - 1
     3054                   .
     3055                 end.
     3056                 if archive_parts.cli-qnty <> v-qnty-sign
     3057                 then do:
     3058                   message
     3059                     vss-workfile vss-revision vss-description skip
     3060                     vss-include-info4 skip
     3061                     "Клиентское количество для товара," skip
     3062                     "который учитывается по двум единицам измерения" skip
     3063                     "должно равняться" v-qnty-sign skip
     3064                     "Документ" p-doc-code skip
     3065                     "Объект" p-obj-type p-obj-code skip
     3066                     "Артикул" p-artic p-prod-type p-prod-code skip
     3067                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3068                     "Количество по документу" archive_parts.qnty skip
     3069                     "Фактическое количество" archive_parts.fact-qnty skip
     3070                     "Клиентское количество" archive_parts.cli-qnty skip
     3071                     view-as alert-box error .
     3072                   undo, return error .
     3073                 end.
     3074                 if archive_parts.fact-qnty = archive_parts.qnty
     3075                 then do:
     3076                   assign
     3077                     buf_parts.cli-qnty = buf_parts.cli-qnty + abs(archive_parts.cli-qnty)
     3078                   .
     3079                 end.
     3080                 else do:
     3081                   message
     3082                     vss-workfile vss-revision vss-description skip
     3083                     vss-include-info4 skip
     3084                     "Фактическое количество для товара," skip
     3085                     "который учитывается по двум единицам измерения" skip
     3086                     "должно равняться нулю или количеству по документу" skip
     3087                     "Документ" p-doc-code skip
     3088                     "Объект" p-obj-type p-obj-code skip
     3089                     "Артикул" p-artic p-prod-type p-prod-code skip
     3090                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3091                     "Количество по документу" archive_parts.qnty skip
     3092                     "Фактическое количество" archive_parts.fact-qnty skip
     3093                     "Клиентское количество" archive_parts.cli-qnty skip
     3094                     view-as alert-box error .
     3095                   undo, return error .
     3096                 end.
     3097               end.
     3098               else do:
     3099                 if buf_parts.cli-base-rate <> 0
     3100                 then do:
     3101                   assign
     3102                     buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3103                   .
     3104                 end.
     3105                 else do:
     3106                   assign
     3107                     buf_parts.cli-qnty = 0
     3108                   .
     3109                 end.
     3110               end.
     3111               if  buf_parts.qnty      = 0
     3112               and buf_parts.fact-qnty = 0
     3113               then do:
     3114                 if v-goods-twounit = true
     3115                 then do:
     3116                   if buf_parts.cli-qnty <> 0
     3117                   then do:
     3118                     message
     3119                       vss-workfile vss-revision vss-description skip
     3120                       vss-include-info4 skip
     3121                       "Ошибка при удалении партии" skip
     3122                       "Документ" p-doc-code skip
     3123                       "Объект" p-obj-type p-obj-code skip
     3124                       "Артикул" p-artic p-prod-type p-prod-code skip
     3125                       "Партия" buf_parts.in-code buf_parts.part-code skip
     3126                       "Резерв" buf_parts.out-code skip
     3127                       "qnty" buf_parts.qnty skip
     3128                       "fact-qnty" buf_parts.fact-qnty skip
     3129                       "cli-qnty" buf_parts.cli-qnty skip
     3130                       view-as alert-box error .
     3131                     undo, return error .
     3132                   end.
     3133                 end.
     3134                 delete buf_parts .
     3135               end.
     3136             end.
     3137           end.
     3138           if  ( archive_parts.in-code = buf_trn-doc.doc-code
     3139           and archive_parts.supp-type =
     3140           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     3141           and archive_parts.supp-code =
     3142           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     3143           )
     3144           or buf_trn-doc.ext-doc-type = 'rv':U
     3145           then do:
     3146             if can-do('рас,спи':U,buf_trn-doc.doc-type)
     3147             or (buf_trn-doc.doc-type = 'инв':U
     3148                 and archive_parts.fact-qnty < 0
     3149               )
     3150             then do:
     3151               assign
     3152                 v-rsrv-code = 'free-zone':U
     3153               .
     3154             end.
     3155             else do:
     3156               assign
     3157                 v-rsrv-code = 'out-zone':U
     3158               .
     3159             end.
     3160             if not v-izlcstpr
     3161             then do :
     3162                 run partcopy in this-procedure
     3163                   (input  true
     3164                   ,input  v-rsrv-code
     3165                   ,buffer archive_parts
     3166                   ,buffer buf_parts
     3167                   ,input  ""
     3168                   ) no-error .
     3169                 if error-status :error
     3170                 then do:
     3171                   message
     3172                     vss-workfile vss-revision vss-description skip
     3173                     vss-include-info4 skip
     3174                     "Ошибка при создании партии" skip
     3175                     "Документ" p-doc-code skip
     3176                     "Объект" p-obj-type p-obj-code skip
     3177                     "Артикул" p-artic p-prod-type p-prod-code skip
     3178                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3179                     "Резерв" v-rsrv-code skip
     3180                     error-status :get-message(1) skip
     3181                     return-value skip
     3182                     view-as alert-box error .
     3183                   undo, return error .
     3184                 end.
     3185                 assign
     3186                   buf_parts.qnty      = buf_parts.qnty - abs(archive_parts.fact-qnty)
     3187                   buf_parts.fact-qnty = buf_parts.qnty
     3188                 .
     3189                 if buf_trn-doc.ext-doc-type = 'rv':U
     3190                 then
     3191                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     3192                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     3193                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     3194                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     3195                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     3196                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     3197                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     3198                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3199                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     3200                   then
     3201                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3202                 end .
     3203                 if v-goods-twounit = true
     3204                 then do:
     3205                   message
     3206                     vss-workfile vss-revision vss-description skip
     3207                     vss-include-info4 skip
     3208                     "Запрещено порождение партий," skip
     3209                     "который учитывается по двум единицам измерения" skip
     3210                     "Документ" p-doc-code skip
     3211                     "Объект" p-obj-type p-obj-code skip
     3212                     "Артикул" p-artic p-prod-type p-prod-code skip
     3213                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3214                     "Количество по документу" archive_parts.qnty skip
     3215                     "Фактическое количество" archive_parts.fact-qnty skip
     3216                     "Клиентское количество" archive_parts.cli-qnty skip
     3217                     view-as alert-box error .
     3218                   undo, return error .
     3219                 end.
     3220                 else do:
     3221                   if buf_parts.cli-base-rate <> 0
     3222                   then do:
     3223                     assign
     3224                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3225                     .
     3226                   end.
     3227                   else do:
     3228                     assign
     3229                       buf_parts.cli-qnty = 0
     3230                     .
     3231                   end.
     3232                 end.
     3233             end.
     3234           end.
     3235           get next partcopy-select-parts .
     3236         end.
     3237       end.
     3238     end.
     3239   end procedure.
     3240   procedure partcopy-update-parts-delete :
     3241     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     3242     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     3243     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     3244     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     3245     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     3246     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     3247     define variable objMarks as class excisemarks no-undo.
     3248     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
     3249     define buffer buf_trn-doc    for ub.trn-doc .
     3250     define buffer archive_parts  for ub.parts .
     3251     define buffer buf_parts      for ub.parts .
     3252     define buffer buf_parts-attr for ub.parts-attr .
     3253     define variable v-rsrv-code as character no-undo .
     3254     define variable v-unrv-code as character no-undo .
     3255     define variable v-need-rsrv as logical   no-undo .
     3256     define variable v-need-unrv as logical   no-undo .
     3257     define variable v-rsrv-sign as integer   no-undo .
     3258     define variable v-unrv-sign as integer   no-undo .
     3259     define variable v-goods-twounit as logical   no-undo .
     3260     define variable v-value-character as character no-undo .
     3261     define variable v-value-date      as date no-undo .
     3262     define variable v-value-decimal   as decimal no-undo .
     3263     define variable v-value-integer   as integer no-undo .
     3264     define variable v-izlcstpr        as logical no-undo .
     3265     define variable v-tth             as handle no-undo .
     3266     define variable v-type            as character no-undo .
     3267     define buffer buf_marking-lines for ub.marking-lines .
     3268     define buffer del_marking-lines for ub.marking-lines .
     3269     define buffer free_marking-lines for ub.marking-lines .
     3270     define buffer buf_marking for ub.marking .
     3271     define buffer buf_marking-chk for ub.marking-chk .
     3272     define buffer buf_chk-doc for ub.chk-doc .
     3273     define variable part-key-rec as character no-undo .
     3274     define variable part-key-rec_arhive   as character no-undo .
     3275     define buffer buf1_gen-attr for ub.gen-attr .
     3276     do
     3277     on error undo, return error return-value
     3278     :
     3279       find first buf_trn-doc no-lock
     3280         where buf_trn-doc.doc-code = p-doc-code
     3281         no-error .
     3282       if not available buf_trn-doc
     3283       then do:
     3284         message
     3285           vss-workfile vss-revision vss-description skip
     3286           vss-include-info4 skip
     3287           "Ошибка задания входных параметров" skip
     3288           "Не найден документ" skip
     3289           "Документ" p-doc-code skip
     3290           "Объект" p-obj-type p-obj-code skip
     3291           "Артикул" p-artic p-prod-type p-prod-code skip
     3292           error-status :get-message(1) skip
     3293           return-value skip
     3294           view-as alert-box error .
     3295         undo, return error .
     3296       end.
     3297       if buf_trn-doc.ext-doc-type = 'vt':U
     3298       then do :
     3299           delete object v-tth no-error.
     3300           run adm/shattri.p (
     3301              input "get":U
     3302             ,input buf_trn-doc.obj-type
     3303             ,input buf_trn-doc.obj-code
     3304             ,input 'inv-obj':U
     3305             ,input  "izlcstpr"
     3306             ,output v-value-character
     3307             ,output v-value-date
     3308             ,output v-value-decimal
     3309             ,output v-value-integer
     3310             ,output v-izlcstpr
     3311             ,output v-type
     3312             ,INPUT-OUTPUT table-handle v-tth
     3313             ) no-error .
     3314             delete object v-tth no-error.
     3315           if error-status:error then do:
     3316             v-izlcstpr = false .
     3317           end.
     3318       end.
     3319       else do :
     3320           v-izlcstpr = false .
     3321       end.
     3322   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3323   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     3324     (input  p-artic
     3325     ,input  p-prod-type
     3326     ,input  p-prod-code
     3327     ,input  'twounit=request':u
     3328     ,output v-goods-twounit
     3329     ) no-error .
     3330       if error-status :error
     3331       then do:
     3332         message
     3333           vss-workfile vss-revision vss-description skip
     3334           vss-include-info4 skip
     3335           "Ошибка при определении атрибута товара" skip
     3336           "Артикул" p-artic p-prod-type p-prod-code skip
     3337           error-status :get-message(1) skip
     3338           return-value skip
     3339           view-as alert-box error .
     3340         undo, return error .
     3341       end.
     3342       define variable v-gds-code as integer   no-undo .
     3343   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3344   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     3345     (input  p-artic
     3346     ,input  p-prod-type
     3347     ,input  p-prod-code
     3348     ,output v-gds-code
     3349     ) no-error .
     3350       for each archive_parts
     3351         where archive_parts.obj-type  = p-obj-type
     3352           and archive_parts.obj-code  = p-obj-code
     3353           and archive_parts.artic     = p-artic
     3354           and archive_parts.prod-type = p-prod-type
     3355           and archive_parts.prod-code = p-prod-code
     3356           and archive_parts.out-code  = p-doc-code
     3357       on error undo, return error return-value
     3358       :
     3359         if archive_parts.fact-qnty <> 0
     3360         then do:
     3361           define variable v-create-part as logical   no-undo .
     3362           define variable v-old-return  as logical   no-undo .
     3363           assign
     3364             v-create-part = false
     3365             v-old-return  = false
     3366           .
     3367           if archive_parts.in-code = buf_trn-doc.doc-code
     3368           then do:
     3369             assign
     3370               v-create-part = true
     3371             .
     3372             if archive_parts.supp-type <>
     3373           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     3374             or archive_parts.supp-code <>
     3375           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     3376             then do:
     3377               assign
     3378                 v-old-return = true
     3379               .
     3380             end.
     3381           end.
     3382           define variable v-is-hold as logical   no-undo .
     3383   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3385     (input  buf_trn-doc.doc-code
     3386     ,output v-is-hold
     3387     ) no-error .
     3388           if error-status :error
     3389           then do:
     3390             message
     3391               vss-workfile vss-revision vss-description skip
     3392               vss-include-info4
     3393               "Ошибка при определении типа документа hold-doc.i" skip
     3394               "Документ" p-doc-code skip
     3395               "Объект" p-obj-type p-obj-code skip
     3396               "Артикул" p-artic p-prod-type p-prod-code skip
     3397               error-status :get-message(1) skip
     3398               return-value skip
     3399               view-as alert-box error .
     3400             undo, return error .
     3401           end.
     3402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partcond in g#library
     3403     (input  buf_trn-doc.ext-doc-type
     3404     ,input  v-is-hold
     3405     ,input  archive_parts.fact-qnty
     3406     ,input  v-create-part
     3407     ,input  v-old-return
     3408     ,output v-rsrv-code
     3409     ,output v-unrv-code
     3410     ,output v-need-rsrv
     3411     ,output v-need-unrv
     3412     ,output v-rsrv-sign
     3413     ,output v-unrv-sign
     3414     ) no-error .
     3415           if error-status :error
     3416           then do:
     3417             message
     3418               vss-workfile vss-revision vss-description skip
     3419               vss-include-info4
     3420               "Ошибка при определении параметров резервирования партии" skip
     3421               "Документ" p-doc-code skip
