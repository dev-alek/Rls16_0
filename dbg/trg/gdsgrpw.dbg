        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.gds-grp OLD oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись группы товаров".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3',ub.gds-grp.node-code,ub.gds-grp.upper-code,ub.gds-grp.node-name)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "X(65)" no-undo
       82   initial "@(#)$Workfile$ $Revision$".
       83   procedure grplib-get-full-name :
       84      define input parameter p-node-code  as integer      no-undo.
       85      define output parameter p-full-name as character    no-undo.
       86      do
       87   on error undo, return error
       88   :
       89       define variable v-upper-code    as integer           no-undo.
       90       define buffer buf_gds-grp       for ub.gds-grp.
       91       define buffer buf_upper_gds-grp for ub.gds-grp.
       92       find first buf_gds-grp no-lock
       93            where buf_gds-grp.node-code = p-node-code
       94       no-error.
       95       if not available buf_gds-grp
       96       then do:
       97           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
       98       end.
       99       assign
      100           p-full-name  = ""
      101           v-upper-code = 1
      102       .
      103       do while buf_gds-grp.upper-code <> 0
      104       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      105       :
      106           assign
      107               p-full-name  = buf_gds-grp.node-name
      108                            + (if p-full-name <> "" then chr(47) else "")
      109                            + p-full-name
      110               v-upper-code = buf_gds-grp.upper-code
      111           .
      112           find first buf_gds-grp no-lock
      113                where buf_gds-grp.node-code = v-upper-code
      114           no-error.
      115           if not available buf_gds-grp
      116           then do:
      117               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      118                                   + string( v-upper-code )
      119                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      120           end.
      121       end.
      122       assign
      123       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      124       .
      125   end.
      126   end .
      127   procedure grplib-get-node-from-full-name :
      128   define input parameter p-full-name as character no-undo .
      129   define output parameter p-node-code as integer no-undo .
      130   define variable v-ii as integer no-undo .
      131   define variable v-upper-code as integer no-undo .
      132   define variable v-root-code as integer no-undo .
      133   define variable v-entry as character no-undo .
      134   define buffer buf_gds-grp       for ub.gds-grp.
      135   do
      136   on error undo, return error
      137   :
      138     find first buf_gds-grp no-lock
      139         where buf_gds-grp.upper-code = 0
      140     no-error .
      141     if not available buf_gds-grp
      142     then do:
      143         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      144     end.
      145     else do:
      146       assign
      147       v-root-code = buf_gds-grp.node-code
      148       .
      149     end.
      150     v-upper-code = v-root-code.
      151     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      152       assign
      153       v-entry = entry(v-ii, p-full-name, chr(47)).
      154       if v-entry = '' then leave.
      155       find first buf_gds-grp no-lock where
      156                 buf_gds-grp.node-name = v-entry
      157             and buf_gds-grp.upper-code = v-upper-code
      158             no-error.
      159       if not available buf_gds-grp then do:
      160         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      161       end.
      162       else do:
      163         p-node-code = buf_gds-grp.node-code.
      164         v-upper-code = buf_gds-grp.node-code.
      165       end.
      166     end.
      167   end.
      168   end .
      169   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      171   define new global shared variable g#lib-nws as handle no-undo .
      172   procedure goodsh_write-goods-proc  :
      173   define parameter buffer buf_goods for ub.goods .
      174   define input parameter p-action as integer no-undo .
      175   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      176   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      177   define variable v-date as date      no-undo.
      178   define variable v-time  as integer   no-undo.
      179   define buffer buf_c-gds-hist for ub.c-gds-hist.
      180   define buffer buf_c-goods for ub.c-goods.
      181     do
      182     on error undo, return error
      183     :
      184       if not available buf_goods then do:
      185         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      186                       "Ошибка задания входных параметров:Не определен товар" ).
      187       end.
      188       if g#news then do:
      189         define variable v-send as integer no-undo .
      190         v-send = integer('0':U).
      191   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      193     (input  g#db-num
      194     ,input  'goods':U
      195     ,input  0
      196     ,input  '':U
      197     ,input  0
      198     ,input  '':U
      199     ,input  '':U
      200     ,input  '':U
      201     ,input  0
      202     ,input  0
      203     ,input  0
      204     ,input  'nws-to-hist'
      205     ,output v-send
      206     ) no-error .
      207         if v-send < 0 then return.
      208       end.
      209       run cur-time in this-procedure(output v-date, output v-time).
      210       create buf_c-goods.
      211       buffer-copy buf_goods to buf_c-goods
      212       assign
      213       buf_c-goods.gds-code             = buf_goods.gds-code
      214       buf_c-goods.chip-num           = next-value (s-gds-chip, ub)
      215       buf_c-goods.corr-time          = v-time
      216       buf_c-goods.corr-user-db-num   = g#db-num
      217       buf_c-goods.corr-user-name     = (if g#news then (chr(4) +  'СПН':U)
      218                                         else (if g#esys
      219                                               then (chr(4) +  'ВС':U)
      220                                               else g#userid)
      221                                               )
      222       buf_c-goods.corr-date          = v-date
      223       .
      224       create buf_c-gds-hist.
      225       buffer-copy buf_c-goods to buf_c-gds-hist
      226       assign
      227       buf_c-gds-hist.action =  p-action
      228       buf_c-gds-hist.subject = 'goods':U
      229       buf_c-gds-hist.is-news = g#news
      230       buf_c-gds-hist.source-type = p-source-type
      231       buf_c-gds-hist.source-ref = p-source-ref
      232       .
      233     end.
      234   end procedure.
