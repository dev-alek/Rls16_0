      416   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   procedure cur-time :
      418      define output parameter p-today as date      no-undo .
      419      define output parameter p-time  as integer   no-undo .
      420     do
      421     on error undo, return error
      422     :
      423       define variable v-date1 as date      no-undo .
      424       define variable v-date2 as date      no-undo .
      425       define variable v-time  as integer   no-undo .
      426       assign
      427         v-date1 = today
      428         v-time  = time
      429         v-date2 = today
      430       .
      431       if v-date1 <> v-date2
      432       then do:
      433         assign
      434           v-date1 = today
      435           v-time  = v-time
      436         .
      437       end.
      438       assign
      439         p-today = v-date1
      440         p-time  = v-time
      441       .
      442     end.
      443   end.
      444   function cur-time-date returns character
      445   :
      446     return string(today, '99/99/9999':U) .
      447   end.
      448   function cur-time-mjd returns decimal
      449   :
      450     define variable v-date as date      no-undo .
      451     define variable v-time as integer   no-undo .
      452     run cur-time in this-procedure
      453       (output v-date
      454       ,output v-time
      455       ) .
      456     return integer(v-date) - 2400002 + (v-time / 86400) .
      457   end.
      458   function cur-time-get-ending-index returns integer
      459   (input p-number as integer
      460   )
      461   :
      462     if p-number < 0
      463     or p-number = ?
      464     then do:
      465       return 1 .
      466     end.
      467     define variable v-rest as integer   no-undo .
      468     assign
      469       p-number = p-number modulo 100
      470     .
      471     if p-number < 20
      472     then do:
      473       assign
      474         v-rest = p-number
      475       .
      476     end.
      477     else do:
      478       assign
      479         v-rest = p-number modulo 10
      480       .
      481     end.
      482     case v-rest :
      483       when 1
      484       then do:
      485         return 2 .
      486       end.
      487       when 2 or
      488       when 3 or
      489       when 4
      490       then do:
      491         return 3 .
      492       end.
      493       otherwise do:
      494         return 1 .
      495       end.
      496     end case .
      497   end.
      498   procedure cur-time-mjd-to-date :
      499      define input  parameter i-mjd-diff as decimal no-undo.
      500      define output parameter o-Date     as date    no-undo.
      501      define output parameter o-Time     as integer no-undo.
      502      define variable v-day-number as integer   no-undo .
      503      if    i-mjd-diff < 0
      504         or i-mjd-diff = ?
      505      then do:
      506         return "?" .
      507      end.
      508      assign
      509         v-day-number = truncate(i-mjd-diff,0).
      510         o-Date = date(v-day-number + 2400002).
      511         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      512     .
      513   end.
      514   function cur-time-mjd-to-string returns character
      515   (input p-mjd-diff as decimal
      516   )
      517   :
      518     define variable v-day-number as integer   no-undo .
      519     define variable v-seconds    as integer   no-undo .
      520     define variable v-hour       as integer   no-undo .
      521     define variable v-min        as integer   no-undo .
      522     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      523     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      524     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      525     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      526     if p-mjd-diff < 0
      527     or p-mjd-diff = ?
      528     then do:
      529       return "?" .
      530     end.
      531     assign
      532       v-day-number = integer(truncate(p-mjd-diff,0))
      533       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      534     .
      535     if v-seconds > 86400
      536     then do:
      537       assign
      538         v-seconds = 86400 - 1
      539       .
      540     end.
      541     if v-seconds < 0
      542     then do:
      543       assign
      544         v-seconds = 0
      545       .
      546     end.
      547     assign
      548       v-hour = truncate(v-seconds / 3600, 0)
      549     .
      550     assign
      551       v-seconds = v-seconds modulo 3600
      552     .
      553     assign
      554       v-min = truncate(v-seconds / 60, 0)
      555     .
      556     assign
      557       v-seconds = v-seconds modulo 60
      558     .
      559     return
      560         (if v-day-number <> 0
      561           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      562           else ""
      563         )
      564       + (if v-day-number <> 0 or v-hour <> 0
      565           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      566           else ""
      567         )
      568       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      569           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      570           else ""
      571         )
      572       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      573       .
      574   end.
      575   function cur-time-string returns character
      576   :
      577     define variable v-date as date      no-undo .
      578     define variable v-time as integer   no-undo .
      579     run cur-time in this-procedure
      580       (output v-date
      581       ,output v-time
      582       ) .
      583     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      584   end.
      585   function cur-time-string-sec returns character
      586   :
      587     define variable v-date as date      no-undo .
      588     define variable v-time as integer   no-undo .
      589     run cur-time in this-procedure
      590       (output v-date
      591       ,output v-time
      592       ) .
      593     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      594   end.
      595   function cur-time-custom  returns character
      596   (input p-prefix as character
      597   ,input p-date-format as character
      598   ,input p-delimiter as character
      599   ,input p-time-format as character
      600   ,input p-suffix as character
      601   )
      602   :
      603     define variable v-date as date      no-undo .
      604     define variable v-time as integer   no-undo .
      605     run cur-time in this-procedure
      606       (output v-date
      607       ,output v-time
      608       ) .
      609     return
      610       p-prefix
      611       + string(v-date, p-date-format)
      612       + p-delimiter
      613       + string(v-time, p-time-format)
      614       + p-suffix
      615       .
      616   end.
      617   function cur-time-print  returns character
      618   :
      619     define variable v-date as date      no-undo .
      620     define variable v-time as integer   no-undo .
      621     run cur-time in this-procedure
      622       (output v-date
      623       ,output v-time
      624       ) .
      625     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      626   end.
      627   function cur-time-datetime returns datetime
      628   :
      629     define variable v-char as character no-undo .
      630     define variable v-datetime as datetime no-undo .
      631     v-char = cur-time-string().
      632     v-datetime = datetime(v-char).
      633     return  v-datetime.
      634   end.
      635   function cur-time-string-msec returns character
      636   :
      637     define variable v-date as datetime  no-undo .
      638     v-date = now.
      639     return string(v-date) .
      640   end.
      641   define buffer b-gds-grp          for ub.gds-grp.
      642   define buffer other_gds-grp      for ub.gds-grp.
      643   define buffer buf_c-gds-grp      for ub.c-gds-grp.
      644   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      645   define variable name                  as char      no-undo.
      646   define variable uc                    as int       no-undo.
      647   define variable skip-proc             as log       no-undo.
      648   define variable conf-par              as char      no-undo.
      649   define variable par-type              as char      no-undo.
      650   define variable v-changed-node-code   like ub.gds-grp.node-code no-undo .
      651   define variable v-changed-node-code-2 like ub.gds-grp.node-code no-undo .
      652   define variable v-date                as date      no-undo .
      653   define variable v-time                as integer   no-undo .
      654   define variable v-only-is-term        as logical   no-undo .
      655   define variable v-chr                 as character no-undo .
      656   define buffer buf_scales-grp   for ub.scales-grp.
      657   define buffer buf2_scales-grp  for ub.scales-grp.
      658   define buffer buf_fbr-prn-grp  for ub.fbr-prn-grp.
      659   define buffer buf2_fbr-prn-grp for ub.fbr-prn-grp.
      660   define variable v-value as character no-undo.
      661   define variable v-ttype as character no-undo.
      662   buffer-compare ub.gds-grp except unit-base to oldb
      663       case-sensitive
      664       save result in skip-proc.
      665   if skip-proc then
      666   do:
      667       return.
      668   end.
      669   on write of ub.goods override
      670       do:
      671       end.
      672   on write of ub.c-goods override
      673       do:
      674       end.
      675   on write of ub.c-gds-hist override
      676       do:
      677       end.
      678   on write of ub.gds-grp override
      679       do:
      680       end.
      681   main-block:
      682   do
      683       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      684       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      685       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      686       :
      687       run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-ttype) no-error.
      688       if v-value = "no"  then
      689       do:
      690           if not g#news and g#db-num > 0 then
      691           do:
      692               message
      693                   vss-workfile vss-revision vss-description skip
      694                   "Нельзя изменять запись ГРУППЫ ТОВАРОВ в УБД" skip
      695                   "Номер текущей БД" g#db-num
      696                   view-as alert-box error .
      697               undo main-block, return error .
      698           end.
      699       end.
      700       run grplib-get-full-name in this-procedure
      701           (input ub.gds-grp.node-code
      702           ,output name
      703           ).
      704       if ub.gds-grp.node-code <> oldb.node-code then
      705       do:
      706           find b-gds-grp
      707               where b-gds-grp.node-code = ub.gds-grp.upper-code
      708               .
      709           assign
      710               gds-grp.lvl-num   = b-gds-grp.lvl-num + 1
      711               b-gds-grp.is-term = no
      712               .
      713           assign
      714               v-changed-node-code = ub.gds-grp.node-code
      715               .
      716           for each ub.goods
      717               where ub.goods.grp-code = b-gds-grp.node-code
      718               ON ERROR UNDO main-block, RETURN ERROR
      719               :
      720               run goodsh_write-goods-proc   in this-procedure (
      721                   buffer ub.goods
      722                   ,integer('2':U)
      723                   ,'grp-chg':U
      724                   ,string(ub.gds-grp.node-code)
      725                   ).
      726               assign
      727                   ub.goods.grp-code = ub.gds-grp.node-code
      728                   .
      729           end.
      730           for each buf_scales-grp
      731               where buf_scales-grp.node-code = b-gds-grp.node-code
      732               and buf_scales-grp.db-num = g#db-num
      733               ON ERROR UNDO main-block, RETURN ERROR
      734               :
      735               find first buf2_scales-grp no-lock where
      736                   buf2_scales-grp.node-code = b-gds-grp.node-code
      737                   and buf2_scales-grp.db-num = buf_scales-grp.db-num
      738                   and buf2_scales-grp.scales-num = buf_scales-grp.scales-num no-error.
      739               if not available buf2_scales-grp then
      740               do:
      741                   create buf2_scales-grp.
      742                   assign
      743                       buf2_scales-grp.node-code  = b-gds-grp.node-code
      744                       buf2_scales-grp.db-num     = buf_scales-grp.db-num
      745                       buf2_scales-grp.scales-num = buf_scales-grp.scales-num
      746                       .
      747               end.
      748               delete buf_scales-grp.
      749           end.
      750           for each buf_fbr-prn-grp where
      751               buf_fbr-prn-grp.node-code = ub.gds-grp.node-code
      752               and buf_fbr-prn-grp.db-num = g#db-num
      753               on error undo main-block, return error return-value  :
      754               find first buf2_fbr-prn-grp no-lock where
      755                   buf2_fbr-prn-grp.node-code = ub.gds-grp.upper-code
      756                   and buf2_fbr-prn-grp.db-num = buf_fbr-prn-grp.db-num
      757                   and buf2_fbr-prn-grp.prn-num = buf_fbr-prn-grp.prn-num  no-error.
      758               if not available buf2_fbr-prn-grp then
      759               do:
      760                   create buf2_fbr-prn-grp.
      761                   buffer-copy buf_fbr-prn-grp
      762                       except node-code to buf2_fbr-prn-grp
      763                       assign
      764                       buf2_fbr-prn-grp.node-code = ub.gds-grp.upper-code
      765                       .
      766               end.
      767               delete buf_fbr-prn-grp.
      768           end.
      769           if ub.gds-grp.calc-method = "" then
      770           do:
      771               assign
      772                   ub.gds-grp.calc-method = b-gds-grp.calc-method
      773                   ub.gds-grp.increase-pc = b-gds-grp.increase-pc
      774                   .
      775           end.
      776       end.
      777       else if ub.gds-grp.upper-code <> oldb.upper-code then
      778           do:
      779               find b-gds-grp  where
      780                   b-gds-grp.node-code = ub.gds-grp.upper-code no-wait no-error.
      781               if not available b-gds-grp then
      782               do:
      783                   undo main-block, return error substitute("gds-grp with node-code &1 is locked", ub.gds-grp.upper-code).
      784               end.
      785               assign
      786                   gds-grp.lvl-num = b-gds-grp.lvl-num + 1
      787                   .
      788               assign
      789                   b-gds-grp.is-term  = no
      790                   ub.gds-grp.lvl-num = b-gds-grp.lvl-num + 1
      791                   .
      792               find first b-gds-grp where
      793                   b-gds-grp.node-code = oldb.upper-code no-wait no-error.
      794               if locked(b-gds-grp) then
      795               do:
      796                   undo main-block, return error substitute("gds-grp with node-code &1 is locked", oldb.upper-code) .
      797               end.
      798               else
      799               do:
      800                   if available b-gds-grp then
      801                   do:
      802                       if not can-find(first other_gds-grp no-lock where
      803                           other_gds-grp.upper-code = oldb.upper-code
      804                           AND recid(other_gds-grp) <> recid(ub.gds-grp)) then
      805                       do:
      806                           assign
      807                               b-gds-grp.is-term = yes
      808                               .
      809                       end.
      810                   end.
      811               end.
      812           end.
      813       buffer-compare oldb to ub.gds-grp
      814           case-sensitive
      815           save result in v-chr.
      816       if v-chr = "is-term":U then
      817       do:
      818           assign
      819               v-only-is-term = yes
      820               .
      821       end.
      822       assign
      823           ub.gds-grp.is-term = yes
      824           .
      825       assign
      826           v-changed-node-code-2 = ub.gds-grp.node-code
      827           .
      828       run grp-tree in this-procedure
      829           (input ub.gds-grp.node-code
      830           ,input name
      831           ) no-error.
      832       if error-status :error then
      833       do:
      834           message
      835               vss-workfile vss-revision vss-description skip
      836               "Ошибка при вызове процедуры grp-tree" skip
      837               error-status :get-message(1) skip
      838               return-value skip
      839               view-as alert-box error .
      840           undo main-block, return error.
      841       end.
      842       define variable v-synch-gds-grp as integer no-undo .
      843       assign
      844           v-synch-gds-grp = next-value(synch-gds-grp, ub)
      845           .
      846       if not g#news then
      847       do:
      848           define variable v-l as logical no-undo .
      849           buffer-compare oldb to ub.gds-grp
      850               case-sensitive
      851               save result in v-l.
      852           if not v-l then
      853               run gds-grph_write-gds-grp-trigger in this-procedure (
      854                   new(ub.gds-grp)
      855                   ,"":U
      856                   ,"":U
      857                   , (if new(ub.gds-grp) then integer('1':U) else integer('2':U))
      858                   ).
      859       end.
      860       run str/callnews.p
      861           (input 'gds-grp':U
      862           ,input (buffer ub.gds-grp:handle)
      863           ) no-error .
      864       if error-status :error then
      865       do:
      866           message
      867               error-status :get-message(1) skip
      868               return-value skip
      869               view-as alert-box.
      870           undo main-block, return error.
      871       end.
      872       if g#oxml = yes
      873           then
      874       do:
      875           run str/calloxml.p (
      876               input 'update':U
      877               , input 'gds-grp':U
      878               , input ( buffer ub.gds-grp:handle )
      879               ) no-error.
      880           if error-status :error
      881               then
      882           do:
      883               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      884                   , chr(10)
      885                   , vss-workfile
      886                   , return-value
      887                   , error-status :get-message ( 1 ) ).
      888           end.
      889       end.
      890       if new(ub.gds-grp) then
      891       do:
      892           run trg/userlog.p (
      893               input 'create':U
      894               , input 'gds-grp':U
      895               , input ( buffer ub.gds-grp :handle )
      896               , input ?
      897               , input ""
      898               ) no-error.
      899           if error-status :error
      900               then
      901           do:
      902               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      903                   , chr(10)
      904                   , vss-workfile
      905                   , return-value
      906                   , error-status :get-message ( 1 ) ).
      907           end.
      908       end.
      909       else
      910       do:
      911           run trg/userlog.p (
      912               input 'update':U
      913               , input 'gds-grp':U
      914               , input ( buffer ub.gds-grp :handle )
      915               , input ?
      916               , input ""
      917               ) no-error.
      918           if error-status :error
      919               then
      920           do:
      921               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      922                   , chr(10)
      923                   , vss-workfile
      924                   , return-value
      925                   , error-status :get-message ( 1 ) ).
      926           end.
      927       end.
      928   end.
      929   procedure grp-tree :
      930       define input  parameter nc       as integer   no-undo .
      931       define input  parameter cur-name as character no-undo .
      932       def buffer buf_gds-grp for ub.gds-grp .
      933       do
      934           on error undo, return error return-value
      935           :
      936           for each buf_gds-grp
      937               where buf_gds-grp.upper-code = nc
      938               on error undo, return error
      939               :
      940               if nc = ub.gds-grp.node-code then
      941               do:
      942                   assign
      943                       ub.gds-grp.is-term = no
      944                       .
      945               end.
      946               run grp-tree
      947                   (input buf_gds-grp.node-code,
      948                   trim(cur-name, chr(47)) + (if cur-name = "":U then "":U else chr(47)) + buf_gds-grp.node-name
      949                   ).
      950           end.
      951           for each ub.goods
      952               where ub.goods.grp-code = nc
      953               on error undo, return error
      954               :
      955               if v-changed-node-code <> nc
      956                   and not v-only-is-term
      957                   then
      958               do:
      959                   run goodsh_write-goods-proc   in this-procedure (
      960                       buffer ub.goods
      961                       ,integer('2':U)
      962                       ,'grp-chg':U
      963                       ,string(v-changed-node-code-2)
      964                       ).
      965               end.
      966               assign
      967                   ub.goods.grp-name = trim(cur-name , chr(47)) + chr(47)
      968                   .
      969               for each ub.gds-obj
      970                   where ub.gds-obj.artic     = ub.goods.artic
      971                   and ub.gds-obj.prod-type = ub.goods.prod-type
      972                   and ub.gds-obj.prod-code = ub.goods.prod-code
      973                   on error undo, return error
      974                   :
      975                   assign
      976                       ub.gds-obj.grp-name = trim(cur-name , chr(47)) + chr(47)
      977                       .
      978               end.
      979           end.
      980       end.
      981   end procedure.
