        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.tax-rate-gds OLD old-tax-rate-gds.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись для таблицы ставки налога на товар".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7':u,ub.tax-rate-gds.fact-order,ub.tax-rate-gds.gds-code,ub.tax-rate-gds.host-code,ub.tax-rate-gds.obj-code,ub.tax-rate-gds.obj-type,ub.tax-rate-gds.rate-code,ub.tax-rate-gds.tax-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   DEFINE VARIABLE conf-par as character no-undo .
       82   DEFINE VARIABLE par-type as character no-undo .
       83   DEFINE VARIABLE v-l as logical no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure cur-time :
       86      define output parameter p-today as date      no-undo .
       87      define output parameter p-time  as integer   no-undo .
       88     do
       89     on error undo, return error
       90     :
       91       define variable v-date1 as date      no-undo .
       92       define variable v-date2 as date      no-undo .
       93       define variable v-time  as integer   no-undo .
       94       assign
       95         v-date1 = today
       96         v-time  = time
       97         v-date2 = today
       98       .
       99       if v-date1 <> v-date2
      100       then do:
      101         assign
      102           v-date1 = today
      103           v-time  = v-time
      104         .
      105       end.
      106       assign
      107         p-today = v-date1
      108         p-time  = v-time
      109       .
      110     end.
      111   end.
      112   function cur-time-date returns character
      113   :
      114     return string(today, '99/99/9999':U) .
      115   end.
      116   function cur-time-mjd returns decimal
      117   :
      118     define variable v-date as date      no-undo .
      119     define variable v-time as integer   no-undo .
      120     run cur-time in this-procedure
      121       (output v-date
      122       ,output v-time
      123       ) .
      124     return integer(v-date) - 2400002 + (v-time / 86400) .
      125   end.
      126   function cur-time-get-ending-index returns integer
      127   (input p-number as integer
      128   )
      129   :
      130     if p-number < 0
      131     or p-number = ?
      132     then do:
      133       return 1 .
      134     end.
      135     define variable v-rest as integer   no-undo .
      136     assign
      137       p-number = p-number modulo 100
      138     .
      139     if p-number < 20
      140     then do:
      141       assign
      142         v-rest = p-number
      143       .
      144     end.
      145     else do:
      146       assign
      147         v-rest = p-number modulo 10
      148       .
      149     end.
      150     case v-rest :
      151       when 1
      152       then do:
      153         return 2 .
      154       end.
      155       when 2 or
      156       when 3 or
      157       when 4
      158       then do:
      159         return 3 .
      160       end.
      161       otherwise do:
      162         return 1 .
      163       end.
      164     end case .
      165   end.
      166   procedure cur-time-mjd-to-date :
      167      define input  parameter i-mjd-diff as decimal no-undo.
      168      define output parameter o-Date     as date    no-undo.
      169      define output parameter o-Time     as integer no-undo.
      170      define variable v-day-number as integer   no-undo .
      171      if    i-mjd-diff < 0
      172         or i-mjd-diff = ?
      173      then do:
      174         return "?" .
      175      end.
      176      assign
      177         v-day-number = truncate(i-mjd-diff,0).
      178         o-Date = date(v-day-number + 2400002).
      179         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      180     .
      181   end.
      182   function cur-time-mjd-to-string returns character
      183   (input p-mjd-diff as decimal
      184   )
      185   :
      186     define variable v-day-number as integer   no-undo .
      187     define variable v-seconds    as integer   no-undo .
      188     define variable v-hour       as integer   no-undo .
      189     define variable v-min        as integer   no-undo .
      190     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      191     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      192     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      193     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      194     if p-mjd-diff < 0
      195     or p-mjd-diff = ?
      196     then do:
      197       return "?" .
      198     end.
      199     assign
      200       v-day-number = integer(truncate(p-mjd-diff,0))
      201       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203     if v-seconds > 86400
      204     then do:
      205       assign
      206         v-seconds = 86400 - 1
      207       .
      208     end.
      209     if v-seconds < 0
      210     then do:
      211       assign
      212         v-seconds = 0
      213       .
      214     end.
      215     assign
      216       v-hour = truncate(v-seconds / 3600, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 3600
      220     .
      221     assign
      222       v-min = truncate(v-seconds / 60, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 60
      226     .
      227     return
      228         (if v-day-number <> 0
      229           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0
      233           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      237           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      238           else ""
      239         )
      240       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      241       .
      242   end.
      243   function cur-time-string returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      252   end.
      253   function cur-time-string-sec returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      262   end.
      263   function cur-time-custom  returns character
      264   (input p-prefix as character
      265   ,input p-date-format as character
      266   ,input p-delimiter as character
      267   ,input p-time-format as character
      268   ,input p-suffix as character
      269   )
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return
      278       p-prefix
      279       + string(v-date, p-date-format)
      280       + p-delimiter
      281       + string(v-time, p-time-format)
      282       + p-suffix
      283       .
      284   end.
      285   function cur-time-print  returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      294   end.
      295   function cur-time-datetime returns datetime
      296   :
      297     define variable v-char as character no-undo .
      298     define variable v-datetime as datetime no-undo .
      299     v-char = cur-time-string().
      300     v-datetime = datetime(v-char).
      301     return  v-datetime.
      302   end.
      303   function cur-time-string-msec returns character
      304   :
      305     define variable v-date as datetime  no-undo .
      306     v-date = now.
      307     return string(v-date) .
      308   end.
      309   define variable v-date as date      no-undo.
      310   define variable v-time  as integer   no-undo.
      311   define variable v-host-code like ub.sysconf.host-code no-undo .
      312   define variable v-creation as logical no-undo .
      313   define variable v-rate-code like ub.tax-rate-gds.rate-code no-undo .
      314   define variable v-fact-order like ub.tax-rate-gds.fact-order no-undo .
      315   define variable v-upgrade as logical no-undo .
      316   define buffer buf_c-gds-hist for ub.c-gds-hist.
      317   define buffer buf_tax-rate-gds for ub.tax-rate-gds.
      318   main-block:
      319   do
      320   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      321   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      322   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      323   :
      324     find ub.goods no-lock
      325       where ub.goods.gds-code     = ub.tax-rate-gds.gds-code
      326       no-error .
      327       run cur-time in this-procedure(output v-date, output v-time).
      328       assign
      329       ub.tax-rate-gds.chip-num           = (if not g#news then next-value (s-gds-chip, ub) else ub.tax-rate-gds.chip-num)
      330       ub.tax-rate-gds.corr-time          = (if not g#news then v-time else ub.tax-rate-gds.corr-time)
      331       ub.tax-rate-gds.corr-user-db-num   = (if not g#news then g#db-num else ub.tax-rate-gds.corr-user-db-num)
      332       ub.tax-rate-gds.corr-user-name     = (if g#news
      333                                           then (chr(4) +  'СПН':U)
      334                                           else (if g#esys
      335                                                 then (chr(4) +  'ВС':U)
      336                                                 else g#userid)
      337                                           )
      338       ub.tax-rate-gds.corr-date          = (if not g#news then v-date      else ub.tax-rate-gds.corr-date)
      339       .
      340       if not (ub.tax-rate-gds.obj-type = "":U and ub.tax-rate-gds.obj-code = 0 ) then do:
      341   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      342   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      343     (input  ub.tax-rate-gds.obj-type
      344     ,input  ub.tax-rate-gds.obj-code
      345     ,output v-host-code
      346     )  .
      347       end.
      348       assign
      349       v-upgrade = (if num-entries (ub.tax-rate-gds.corr-user-name, chr(4)) > 1
      350                   and entry(2, ub.tax-rate-gds.corr-user-name, chr(4)) = 'upgrade':U
      351                   then yes
      352                   else no).
      353       if new(ub.tax-rate-gds)
      354       or v-upgrade
      355       then do:
      356         find last buf_tax-rate-gds no-lock
      357           where buf_tax-rate-gds.gds-code   = ub.tax-rate-gds.gds-code
      358             and buf_tax-rate-gds.tax-code   = ub.tax-rate-gds.tax-code
      359             and buf_tax-rate-gds.host-code  = 0
      360             and buf_tax-rate-gds.obj-type   = ""
      361             and buf_tax-rate-gds.obj-code   = 0
      362             and buf_tax-rate-gds.fact-order < ub.tax-rate-gds.fact-order
      363           no-error .
      364         if available buf_tax-rate-gds then do:
      365           assign
      366           v-rate-code = buf_tax-rate-gds.rate-code
      367           v-fact-order = buf_tax-rate-gds.fact-order
      368           .
      369         end.
      370       end.
      371       create buf_c-gds-hist.
      372       buffer-copy ub.tax-rate-gds
      373       except chip-num corr-user-db-num corr-user-name corr-time corr-date
      374       to buf_c-gds-hist
      375       assign
      376       buf_c-gds-hist.chip-num           = next-value (s-gds-chip, ub)
      377       buf_c-gds-hist.corr-time          = (if v-upgrade
      378                                           then ub.tax-rate-gds.corr-time
      379                                           else v-time)
      380       buf_c-gds-hist.corr-user-db-num   = g#db-num
      381       buf_c-gds-hist.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) else g#userid)
      382       buf_c-gds-hist.corr-user-name     = (if g#news
      383                                           then (chr(4) +  'СПН':U)
      384                                           else (if g#esys
      385                                                 then (chr(4) +  'ВС':U)
      386                                                 else g#userid)
      387                                           )
      388       buf_c-gds-hist.corr-date          = (if v-upgrade
      389                                           then ub.tax-rate-gds.corr-date
      390                                           else v-date)
      391       buf_c-gds-hist.rate-code = (if v-upgrade
      392                                   then v-rate-code
      393                                   else (if new ub.tax-rate-gds then v-rate-code else old-tax-rate-gds.rate-code)
      394                                   )
      395       buf_c-gds-hist.fact-order = (if v-upgrade
      396                                    then v-fact-order
      397                                    else (if new ub.tax-rate-gds then v-fact-order else old-tax-rate-gds.fact-order)
      398                                    )
      399       buf_c-gds-hist.action = (if new(ub.tax-rate-gds) then integer('1':U) else integer('2':U))
      400       buf_c-gds-hist.subject = 'tax-rate-gds':U
      401       buf_c-gds-hist.host-code = v-host-code
      402       buf_c-gds-hist.is-news  = g#news
      403       buf_c-gds-hist.source-type = (if g#news
      404                                     then 'db':U
      405                                     else (if g#esys
      406                                           then 'esys':U
      407                                           else "":U)
      408                                     )
      409       buf_c-gds-hist.source-ref = (if g#news
      410                                     then string(g#news-source-db)
      411                                     else (if g#esys
      412                                           then string(g#esys-source-esys)
      413                                           else "":U)
      414                                     )
      415       .
      416     if not g#news then do:
      417   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   define variable send-ref as logical no-undo.
      419   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      420     (input  'send-ref'
      421     ,input  0
      422     ,input  ''
      423     ,input  0
      424     ,input  ''
      425     ,input  ''
      426     ,input  ''
      427     ,input  no
      428     ,output conf-par
      429     ,output par-type
      430     ) no-error .
      431     send-ref = (IF error-status:error or conf-par <> "yes" then no else yes).
      432       if send-ref then do:
      433         if new(ub.tax-rate-gds) then do:
      434           assign
      435           v-l = no
      436           .
      437         end.
      438         else do:
      439           assign
      440           v-l = yes
      441           .
      442           buffer-compare ub.tax-rate-gds using
      443           rate-code
      444           to old-tax-rate-gds
      445           case-sensitive
      446           save result in v-l .
      447         end.
      448         if not v-l then do:
      449           run trg/nu_gds.p (
      450                         input  ub.goods.gds-code
      451                         ,input  0
      452                         ,input  "":U
      453                         ,input  0
      454                         ,input  "U":U
      455                       ).
      456         end.
      457       end.
      458     end.
      459     if ( available ub.goods and not new (ub.goods))
      460     or not available ub.goods then do:
      461       run str/callnews.p
      462         (input 'tax-rate-gds':U
      463         ,input (buffer ub.tax-rate-gds:handle)
      464         ) no-error .
      465       if error-status:error then do:
      466         message
      467           vss-workfile vss-revision vss-description skip
      468           "Невозможно маршрутизировать tax-rate-gds для отправки в новости" skip
      469           error-status :get-message(1) skip
      470           return-value skip
      471           view-as alert-box.
      472         undo main-block, return error .
      473       end.
      474     end.
      475       if g#oxml = yes
      476       then do:
      477       run str/calloxml.p (
      478             input 'update':U
      479           , input 'tax-rate-gds':U
      480           , input ( buffer ub.tax-rate-gds:handle )
      481       ) no-error.
      482       if error-status :error
      483       then do:
      484           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      485                                , chr(10)
      486                                , vss-workfile
      487                                , return-value
      488                                , error-status :get-message ( 1 ) ).
      489       end.
      490       end.
      491   end.
