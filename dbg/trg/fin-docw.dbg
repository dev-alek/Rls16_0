      949   procedure c-fin-doc-attr-write :
      950    do
      951    on error undo, return error return-value
      952    :
      953   define input parameter p-host-code     like ub.c-fin-doc-attr.host-code  no-undo .
      954   define input parameter p-fin-doc-code  like ub.c-fin-doc-attr.fin-doc-code   no-undo .
      955   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
      956   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
      957   define input parameter p-attr-code     like ub.c-fin-doc-attr.attr-code  no-undo .
      958   define input parameter p-attr-value    like ub.c-fin-doc-attr.attr-value no-undo .
      959   define variable  v-format         as character no-undo .
      960   define variable  v-label          as character no-undo .
      961   define variable  v-user-can-edit  as logical   no-undo .
      962   define variable  v-output-display as logical   no-undo .
      963   define variable  v-other          as character no-undo .
      964   define variable  v-type           as character no-undo .
      965   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      966   run fd-attr-code in this-procedure
      967                                     (input  p-attr-code
      968                                     ,output v-type
      969                                     ,output v-format
      970                                     ,output v-label
      971                                     ,output v-user-can-edit
      972                                     ,output v-output-display
      973                                     ,output v-other
      974                                     ) no-error .
      975   if error-status :error then do:
      976     undo, return error return-value .
      977   end.
      978   find first buf_c-fin-doc-attr  exclusive-lock  where
      979             buf_c-fin-doc-attr.attr-code    = p-attr-code
      980         AND buf_c-fin-doc-attr.host-code    = p-host-code
      981         AND buf_c-fin-doc-attr.fin-doc-code     = p-fin-doc-code
      982         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
      983         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
      984     if not available  buf_c-fin-doc-attr then do:
      985         create buf_c-fin-doc-attr.
      986         assign
      987         buf_c-fin-doc-attr.attr-code    = p-attr-code
      988         buf_c-fin-doc-attr.attr-value   = p-attr-value
      989         buf_c-fin-doc-attr.host-code    = p-host-code
      990         buf_c-fin-doc-attr.fin-doc-code     = p-fin-doc-code
      991         .
      992     end.
      993     else do:
      994           buf_c-fin-doc-attr.attr-value   = p-attr-value .
      995     end.
      996    end.
      997   end procedure.
      998   procedure c-fin-doc-attr-value :
      999    do
     1000    on error undo, return error return-value
     1001    :
     1002   define input  parameter p-host-code    like ub.c-fin-doc-attr.host-code    no-undo .
     1003   define input  parameter p-fin-doc-code like ub.c-fin-doc-attr.fin-doc-code     no-undo .
     1004   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
     1005   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
     1006   define input  parameter p-attr-code    like ub.c-fin-doc-attr.attr-code    no-undo .
     1007   define output parameter p-attr-value   like ub.c-fin-doc-attr.attr-value   no-undo .
     1008   define variable  v-format         as character no-undo .
     1009   define variable  v-label          as character no-undo .
     1010   define variable  v-user-can-edit  as logical   no-undo .
     1011   define variable  v-output-display as logical   no-undo .
     1012   define variable  v-other          as character no-undo .
     1013   define variable  v-type           as character no-undo .
     1014   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1015   run fd-attr-code in this-procedure
     1016     (input  p-attr-code
     1017     ,output v-type
     1018     ,output v-format
     1019     ,output v-label
     1020     ,output v-user-can-edit
     1021     ,output v-output-display
     1022     ,output v-other
     1023     ) no-error .
     1024   if error-status :error then do:
     1025     undo, return error return-value .
     1026   end.
     1027   find first buf_c-fin-doc-attr no-lock where
     1028             buf_c-fin-doc-attr.attr-code    = p-attr-code
     1029         AND buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
     1030         AND buf_c-fin-doc-attr.host-code      = p-host-code
     1031         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
     1032         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
     1033     if available  buf_c-fin-doc-attr then do:
     1034       assign
     1035       p-attr-value = buf_c-fin-doc-attr.attr-value
     1036       .
     1037     end.
     1038     else do:
     1039       p-attr-value = ? .
     1040     end.
     1041    end.
     1042   end procedure.
     1043   procedure c-fin-doc-attr-value-nextchip :
     1044    do
     1045    on error undo, return error return-value
     1046    :
     1047   define input  parameter p-host-code    like ub.c-fin-doc-attr.host-code    no-undo .
     1048   define input  parameter p-fin-doc-code like ub.c-fin-doc-attr.fin-doc-code     no-undo .
     1049   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
     1050   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
     1051   define input  parameter p-attr-code    like ub.c-fin-doc-attr.attr-code    no-undo .
     1052   define output parameter p-attr-value   like ub.c-fin-doc-attr.attr-value   no-undo .
     1053   define variable  v-format         as character no-undo .
     1054   define variable  v-label          as character no-undo .
     1055   define variable  v-user-can-edit  as logical   no-undo .
     1056   define variable  v-output-display as logical   no-undo .
     1057   define variable  v-other          as character no-undo .
     1058   define variable  v-type           as character no-undo .
     1059   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1060   run fd-attr-code in this-procedure
     1061     (input  p-attr-code
     1062     ,output v-type
     1063     ,output v-format
     1064     ,output v-label
     1065     ,output v-user-can-edit
     1066     ,output v-output-display
     1067     ,output v-other
     1068     ) no-error .
     1069   if error-status :error then do:
     1070     undo, return error return-value .
     1071   end.
     1072   find first buf_c-fin-doc-attr no-lock where
     1073             buf_c-fin-doc-attr.attr-code    = p-attr-code
     1074         and buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
     1075         and buf_c-fin-doc-attr.host-code      = p-host-code
     1076         and buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
     1077         and buf_c-fin-doc-attr.chip-num         > p-chip-num      no-error .
     1078     if available  buf_c-fin-doc-attr then do:
     1079       assign
     1080       p-attr-value = buf_c-fin-doc-attr.attr-value
     1081       .
     1082     end.
     1083     else do:
     1084       p-attr-value = ? .
     1085     end.
     1086    end.
     1087   end procedure.
     1088   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1089   procedure write-fin-doc-history :
     1090   define parameter buffer buf_fin-doc for ub.fin-doc.
     1091   define variable v-date as date no-undo .
     1092   define variable v-time as integer no-undo .
     1093   define buffer buf_c-fin-doc for ub.c-fin-doc.
     1094   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
     1095   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1096     do
     1097     on error undo, return error
     1098     :
     1099       run cur-time in this-procedure(output v-date, output v-time).
     1100       create buf_c-fin-doc.
     1101       buffer-copy buf_fin-doc to buf_c-fin-doc
     1102       assign
     1103       buf_c-fin-doc.chip-num           = next-value (s-corr-chip, ub)
     1104       buf_c-fin-doc.corr-time          = v-time
     1105       buf_c-fin-doc.corr-user-db-num   = g#db-num
     1106       buf_c-fin-doc.corr-user-name     = g#userid
     1107       buf_c-fin-doc.corr-date          = v-date
     1108       buf_c-fin-doc.corr-doc-code      = "":U
     1109       .
     1110       for each ub.fin-doc-tax where
     1111                ub.fin-doc-tax.host-code = buf_fin-doc.host-code
     1112            AND ub.fin-doc-tax.fin-doc-code = buf_fin-doc.fin-doc-code:
     1113         create buf_c-fin-doc-tax.
     1114         buffer-copy ub.fin-doc-tax to buf_c-fin-doc-tax
     1115         assign
     1116         buf_c-fin-doc-tax.chip-num           = buf_c-fin-doc.chip-num
     1117         buf_c-fin-doc-tax.corr-user-db-num   = buf_c-fin-doc.corr-user-db-num
     1118         .
     1119       end.
     1120       for each ub.fin-doc-attr where
     1121                ub.fin-doc-attr.host-code = buf_fin-doc.host-code
     1122            AND ub.fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code:
     1123         create buf_c-fin-doc-attr.
     1124         buffer-copy ub.fin-doc-attr to buf_c-fin-doc-attr
     1125         assign
     1126         buf_c-fin-doc-attr.chip-num           = buf_c-fin-doc.chip-num
     1127         buf_c-fin-doc-attr.corr-user-db-num   = buf_c-fin-doc.corr-user-db-num
     1128         buf_c-fin-doc-attr.attr-value         = buf_c-fin-doc-attr.attr-value
     1129         .
     1130       end.
     1131       release buf_c-fin-doc.
     1132     end.
     1133   end procedure.
     1134   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1135   procedure gen-b-code :
     1136     define input  parameter type-code like ub.code-range.range-type no-undo .
     1137     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
     1138     do
     1139     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1140     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     1141     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     1142     :
     1143       define buffer buf_thbj-attr     for ub.thbj-attr .
     1144       define buffer buf_sys-ctrl   for ub.sys-ctrl .
     1145       define buffer buf_code-range for ub.code-range .
     1146       define variable l-code         as   integer              no-undo .
     1147       define variable v-db-num       like ub.db.db-num         no-undo .
     1148       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1149       if type-code = 'sslc':U
     1150       or type-code = 'ssgb':U
     1151       then do:
     1152         message
     1153           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     1154           "Обратитесь к администратору системы."
     1155           view-as alert-box error .
     1156         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     1157       end.
     1158       run trg/getpcode.p ( input  type-code
     1159                      ,output cfg-param-code
     1160                     ).
     1161       run get-next-seq( input  type-code,
     1162                         output l-code
     1163                       ).
     1164       find first buf_sys-ctrl no-lock.
     1165       if type-code = 'sclc':U
     1166       or type-code = 'pglc':U
     1167       then do:
     1168         assign
     1169           v-db-num = 0
     1170         .
     1171       end.
     1172       else do:
     1173         assign
     1174           v-db-num = buf_sys-ctrl.db-num
     1175         .
     1176       end.
     1177       find first buf_code-range no-lock
     1178         where buf_code-range.db-num     = v-db-num
     1179           and buf_code-range.range-type = type-code
     1180           and buf_code-range.stts       = "a"
     1181         use-index stts
     1182         no-error .
     1183       if available buf_code-range
     1184          and l-code <= buf_code-range.last-code
     1185          and l-code >= buf_code-range.first-code then do:
     1186         assign
     1187           p-b-code = l-code
     1188         .
     1189       end.
     1190       else do:
     1191         if available buf_code-range
     1192            and l-code < buf_code-range.last-code then do:
     1193           message
     1194             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     1195             "Обратитесь к администратору системы."
     1196             view-as alert-box error .
     1197           undo, return error "sequence":U .
     1198         end.
     1199         do transaction
     1200         on error undo, return error
     1201         :
     1202           find first buf_thbj-attr exclusive-lock
     1203             where buf_thbj-attr.upper-prop-code = 'code-range':U
     1204               and buf_thbj-attr.prop-code = cfg-param-code
     1205               and buf_thbj-attr.obj-type   = 'БД':U
     1206               and buf_thbj-attr.obj-code   = v-db-num
     1207             no-error .
     1208           if not available buf_thbj-attr then do:
     1209             find first buf_thbj-attr exclusive-lock
     1210               where buf_thbj-attr.upper-prop-code = 'code-range':U
     1211                 and buf_thbj-attr.prop-code = cfg-param-code
     1212                 and buf_thbj-attr.obj-type   = ''
     1213                 and buf_thbj-attr.obj-code   = 0
     1214               no-error .
     1215             if not available buf_thbj-attr then do:
     1216               if not locked buf_thbj-attr then do:
     1217                 message
     1218                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     1219                   "Обратитесь к администратору системы."
     1220                   view-as alert-box error .
     1221               end.
     1222               undo, return error "config":U .
     1223             end.
     1224           end.
     1225           run get-next-seq( input type-code,
     1226                             output l-code
     1227                           ).
     1228           find first buf_code-range
     1229             where buf_code-range.db-num     = v-db-num
     1230               and buf_code-range.range-type = type-code
     1231               and buf_code-range.stts       = "a"
     1232             use-index stts
     1233             no-error .
     1234           if available buf_code-range
     1235           and l-code <= buf_code-range.last-code
     1236           and l-code >= buf_code-range.first-code
     1237           then do:
     1238             assign
     1239               p-b-code = l-code
     1240             .
     1241           end.
     1242           else do:
     1243             if available buf_code-range then do:
     1244               assign
     1245                 buf_code-range.stts = "u"
     1246               .
     1247             end.
     1248             find first buf_code-range
     1249               where buf_code-range.db-num     = v-db-num
     1250                 and buf_code-range.range-type = type-code
     1251                 and buf_code-range.stts       = "f"
     1252               use-index stts
     1253               no-error .
     1254             if not available buf_code-range then do:
     1255               message
     1256                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     1257                 "Обратитесь к администратору системы"
     1258                 view-as alert-box error .
     1259               undo, return error "code-range":U .
     1260             end.
     1261             assign
     1262               buf_code-range.stts           = "a"
     1263             .
     1264             if buf_code-range.first-code = 1 then do:
     1265               run set-seq-cr( input type-code,
     1266                               input buf_code-range.first-code
     1267                             ).
     1268               assign
     1269                 p-b-code = 1
     1270               .
     1271             end.
     1272             else do:
     1273               run set-seq-cr( input type-code,
     1274                               input ( buf_code-range.first-code - 1 )
     1275                             ).
     1276               run get-next-seq( input type-code,
     1277                                 output p-b-code
     1278                               ).
     1279             end.
     1280           end.
     1281         end.
     1282       end.
     1283     end.
     1284   end procedure.
     1285   procedure get-next-seq :
     1286     define input  parameter type-code like ub.code-range.range-type no-undo .
     1287     define output parameter next-seq  as   integer                  no-undo .
     1288     do
     1289     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1290     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     1291     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     1292     :
     1293       case type-code:
     1294         when 'bcgb':U then do:
     1295           assign
     1296             next-seq = next-value(s-bcgb-code, ub)
     1297           .
     1298         end.
     1299         when 'scgb':U then do:
     1300           assign
     1301             next-seq = next-value(s-scgb-code, ub)
     1302           .
     1303         end.
     1304         when 'sclc':U then do:
     1305           assign
     1306             next-seq = next-value(s-sclc-code, ub)
     1307           .
     1308         end.
     1309         when 'pglc':U then do:
     1310           assign
     1311             next-seq = next-value(s-pglc-code, ub)
     1312           .
     1313         end.
     1314         when 'dcgb':U then do:
     1315           assign
     1316             next-seq = next-value(s-dcgb-code, ub)
     1317           .
     1318         end.
     1319         when 'ctgb':U then do:
     1320           assign
     1321             next-seq = next-value(s-ctgb-code, ub)
     1322           .
     1323         end.
     1324         when 'drgb':U then do:
     1325           assign
     1326             next-seq = next-value(s-drgb-code, ub)
     1327           .
     1328         end.
     1329         when 'fmgb':U then do:
     1330           assign
     1331             next-seq = next-value(s-fmgb-code, ub)
     1332           .
     1333         end.
     1334         when 'pngb':U then do:
     1335           assign
     1336             next-seq = next-value(s-pngb-code, ub)
     1337           .
     1338         end.
     1339         when 'cagb':U then do:
     1340           assign
     1341             next-seq = next-value(s-cagb-code, ub)
     1342           .
     1343         end.
     1344         when 'fdgb':U then do:
     1345           assign
     1346             next-seq = next-value(s-fin-doc, ub)
     1347           .
     1348         end.
     1349       end case.
     1350     end.
     1351   end procedure.
     1352   procedure set-seq-cr :
     1353     define input parameter type-code like ub.code-range.range-type no-undo .
     1354     define input parameter set-val   like ub.code-range.first-code no-undo .
     1355     do
     1356     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1357     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     1358     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     1359     :
     1360       case type-code:
     1361         when 'bcgb':U then do:
     1362           assign
     1363             current-value(s-bcgb-code, ub) = set-val
     1364           .
     1365         end.
     1366         when 'scgb':U then do:
     1367           assign
     1368             current-value(s-scgb-code, ub) = set-val
     1369           .
     1370         end.
     1371         when 'sclc':U then do:
     1372           assign
     1373             current-value(s-sclc-code, ub) = set-val
     1374           .
     1375         end.
     1376         when 'pglc':U then do:
     1377           assign
     1378             current-value(s-pglc-code, ub) = set-val
     1379           .
     1380         end.
     1381         when 'dcgb':U then do:
     1382           assign
     1383             current-value(s-dcgb-code, ub) = set-val
     1384           .
     1385         end.
     1386         when 'ctgb':U then do:
     1387           assign
     1388             current-value(s-ctgb-code, ub) = set-val
     1389           .
     1390         end.
     1391         when 'drgb':U then do:
     1392           assign
     1393             current-value(s-drgb-code, ub) = set-val
     1394           .
     1395         end.
     1396         when 'fmgb':U then do:
     1397           assign
     1398             current-value(s-fmgb-code, ub) = set-val
     1399           .
     1400         end.
     1401         when 'pngb':U then do:
     1402           assign
     1403             current-value(s-pngb-code, ub) = set-val
     1404           .
     1405         end.
     1406         when 'cagb':U then do:
     1407           assign
     1408             current-value(s-cagb-code, ub) = set-val
     1409           .
     1410         end.
     1411         when 'fdgb':U then do:
     1412           assign
     1413             current-value(s-fin-doc, ub) = set-val
     1414           .
     1415         end.
     1416       end case.
     1417     end.
     1418   end procedure.
     1419   procedure new-bcod-gen-code-range :
     1420     do
     1421     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1422     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1423     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1424     :
     1425       define input parameter p-db-num  like ub.db.db-num             no-undo .
     1426       define input parameter type-code like ub.code-range.range-type no-undo .
     1427       define buffer buf_code-range      for ub.code-range .
     1428       define buffer last_code-range     for ub.code-range .
     1429       define buffer last-1_code-range   for ub.code-range .
     1430       define buffer last-2_code-range   for ub.code-range .
     1431       define buffer last-3_code-range   for ub.code-range .
     1432       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     1433       define variable conf-par       as character no-undo .
     1434       define variable par-type       as character no-undo .
     1435       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1436       define variable v-cre-cdrg as logical   no-undo .
     1437       define variable v-cre-str  as character no-undo .
     1438       define variable v-cr1      as integer no-undo .
     1439       define variable v-cr2      as integer no-undo .
     1440       define variable v-cr3      as integer no-undo .
     1441       define variable v-cmax     as integer no-undo .
     1442       find first buf_sys-ctrl no-lock .
     1443       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     1444         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     1445                                       ,vss-workfile
     1446                                       ,vss-revision
     1447                                       ,vss-description
     1448                                       ,chr(10)
     1449                                       , p-db-num
     1450                                      ).
     1451       end.
     1452       run trg/getpcode.p ( input  type-code
     1453                      ,output cfg-param-code
     1454                     ).
     1455       for each buf_code-range
     1456         where buf_code-range.db-num     = -1
     1457           and buf_code-range.range-type = type-code
     1458           and buf_code-range.stts       = "f"
     1459       by buf_code-range.first-code
     1460       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1461       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1462       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1463       :
     1464         assign
     1465           buf_code-range.db-num = p-db-num
     1466         .
     1467         return .
     1468       end.
     1469       assign
     1470         v-cre-cdrg = TRUE
     1471       .
     1472       case type-code:
     1473         when 'sclc':U
     1474         or when 'scgb':U
     1475         or when 'pglc':U
     1476         then do:
     1477           find last last-1_code-range no-lock
     1478             where last-1_code-range.range-type = 'sclc':U
     1479             no-error .
     1480           if available last-1_code-range then do:
     1481             v-cr1 = last-1_code-range.last-code.
     1482           end.
     1483           find last last-2_code-range no-lock
     1484             where last-2_code-range.range-type = 'scgb':U
     1485             no-error .
     1486           if available last-2_code-range then do:
     1487             v-cr2 = last-2_code-range.last-code.
     1488             end.
     1489           find last last-3_code-range no-lock
     1490             where last-3_code-range.range-type = 'pglc':U
     1491             no-error .
     1492           if available last-3_code-range then do:
     1493             v-cr3 = last-3_code-range.last-code.
     1494           end.
     1495           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1496           .
     1497           if v-cmax = v-cr1  then do:
     1498               find last last_code-range no-lock
     1499                 where recid( last_code-range ) = recid( last-1_code-range )
     1500                 .
     1501             end.
     1502           if v-cmax = v-cr2  then do:
     1503               find last last_code-range no-lock
     1504                 where recid( last_code-range ) = recid( last-2_code-range )
     1505                 .
     1506             end.
     1507           if v-cmax = v-cr3  then do:
     1508             find last last_code-range no-lock
     1509               where recid( last_code-range ) = recid( last-3_code-range )
     1510               .
     1511           end.
     1512           if last_code-range.last-code + 1 > 99999 then do:
     1513             assign
     1514               v-cre-cdrg = FALSE
     1515             .
     1516           end.
     1517         end.
     1518         when 'bcgb':U
     1519         or when 'sslc':U
     1520         or when 'ssgb':U
     1521         then do:
     1522           find last last-1_code-range no-lock
     1523             where last-1_code-range.range-type = 'sslc':U
     1524             no-error .
     1525           if available last-1_code-range then do:
     1526             v-cr1 = last-1_code-range.last-code.
     1527           end.
     1528           find last last-2_code-range no-lock
     1529             where last-2_code-range.range-type = 'bcgb':U
     1530             no-error .
     1531           if available last-2_code-range then do:
     1532             v-cr2 = last-2_code-range.last-code.
     1533             end.
     1534           find last last-3_code-range no-lock
     1535             where last-3_code-range.range-type = 'ssgb':U
     1536             no-error .
     1537           if available last-3_code-range then do:
     1538             v-cr3 = last-3_code-range.last-code.
     1539           end.
     1540           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1541           .
     1542           if v-cmax = v-cr1  then do:
     1543               find last last_code-range no-lock
     1544                 where recid( last_code-range ) = recid( last-1_code-range )
     1545                 .
     1546             end.
     1547           if v-cmax = v-cr2  then do:
     1548               find last last_code-range no-lock
     1549                 where recid( last_code-range ) = recid( last-2_code-range )
     1550                 .
     1551             end.
     1552           if v-cmax = v-cr3  then do:
     1553             find last last_code-range no-lock
     1554               where recid( last_code-range ) = recid( last-3_code-range )
     1555               .
     1556           end.
     1557         end.
     1558         otherwise do:
     1559           find last last_code-range no-lock
     1560             where last_code-range.range-type = type-code
     1561             no-error .
     1562         end.
     1563       end case.
     1564       if not available last_code-range then do:
     1565         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     1566                                       ,vss-workfile
     1567                                       ,vss-revision
     1568                                       ,vss-description
     1569                                       , chr(10)
     1570                                       , type-code
     1571                                      ) .
     1572       end.
     1573       define variable v-mes6 as character no-undo .
     1574       define variable v-param-type6 as character no-undo .
     1575       define variable v-value-character6 as INTEGER no-undo .
     1576       define variable v-value-date6 as date no-undo .
     1577       define variable v-value-decimal6 as decimal no-undo .
     1578       define variable v-value-integer6 AS integer no-undo .
     1579       define variable v-value-logical6 AS LOGICAL no-undo .
     1580       define variable v-tth6 as handle no-undo .
     1581       run adm/shattri.p (
     1582           input "get":U
     1583           ,input  'БД':U
     1584           ,input  p-db-num
     1585           ,input  'code-range':U
     1586           ,input  cfg-param-code
     1587           ,output v-value-character6
     1588           ,output v-value-date6
     1589           ,output v-value-decimal6
     1590           ,output v-value-integer6
     1591           ,output v-value-logical6
     1592           ,output v-param-type6
     1593           ,INPUT-OUTPUT table-handle v-tth6
     1594           ) no-error .
     1595       if error-status :error then do:
     1596         delete object v-tth6.
     1597         v-mes6 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     1598                            , error-status:get-message(1)
     1599                            , chr(10)
     1600                            , return-value ).
     1601         undo, return error v-mes6.
     1602       end.
     1603       delete object v-tth6.
     1604       if v-cre-cdrg = TRUE then do:
     1605         create buf_code-range .
     1606         assign
     1607           buf_code-range.db-num     = p-db-num
     1608           buf_code-range.range-type = type-code
     1609           buf_code-range.stts       = "f"
     1610           buf_code-range.first-code = last_code-range.last-code + 1
     1611           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer6)
     1612           v-cre-str = "Свободный диапазон успешно создан"
     1613         .
     1614       end.
     1615       else do:
     1616         assign
     1617           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     1618                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     1619         .
     1620       end.
     1621     end.
     1622     return v-cre-str .
     1623   end procedure.
     1624   procedure gen-new-code-range-if-neces :
     1625     define input parameter v-db-num           like ub.db.db-num             no-undo .
     1626     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     1627     define input parameter v-cur-code         as   integer                  no-undo .
     1628     define input parameter v-g#news           as   logical                  no-undo .
     1629     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     1630     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     1631     do
     1632     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1633     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     1634     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     1635     :
     1636       define variable l-code-range-exist as logical   no-undo init false .
     1637       define variable v-db-for-send      as character no-undo .
     1638       define buffer buf_code-range  for ub.code-range .
     1639       define buffer buf1_code-range for ub.code-range .
     1640       define buffer buf_db          for ub.db .
     1641       find first buf_code-range
     1642         where buf_code-range.range-type = v-range-type
     1643           and buf_code-range.last-code >= v-cur-code
     1644         use-index last-codei
     1645         no-error .
     1646       if
     1647       (
     1648          available buf_code-range
     1649          and
     1650         (buf_code-range.db-num = v-db-num
     1651           and
     1652         buf_code-range.first-code <= v-cur-code
     1653         )
     1654       or
     1655         (
     1656           v-range-type = 'drgb':U
     1657           AND
     1658           v-cur-code = 0
     1659         )
     1660      )
     1661      then do:
     1662         assign
     1663           l-code-range-exist = true
     1664         .
     1665         if v-g#news
     1666         and buf_code-range.stts = "f" then do:
     1667           assign
     1668             buf_code-range.stts = "u"
     1669           .
     1670         end.
     1671       end.
     1672       if not l-code-range-exist
     1673          and v-g#news-source-db <> 0
     1674       then do:
     1675         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1676                                       ,vss-workfile
     1677                                       ,vss-revision
     1678                                       ,vss-description
     1679                                       ,chr(10)
     1680                                       ,v-db-num
     1681                                       ,v-range-type
     1682                                       ,v-cur-code
     1683                                      ).
     1684       end.
     1685       if (not l-code-range-exist
     1686           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1687          )
     1688       and ( not can-find (first buf1_code-range no-lock
     1689                           where buf1_code-range.db-num = v-db-num
     1690                             and buf1_code-range.range-type = v-range-type
     1691                             and buf1_code-range.stts = "f"
     1692                          )
     1693           )
     1694       then do:
     1695         if v-g#db-num = 0 then do:
     1696           run new-bcod-gen-code-range in this-procedure
     1697             (input v-db-num,
     1698              input v-range-type
     1699             ) no-error .
     1700           if error-status :error then do:
     1701             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1702                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1703                                           ,v-db-num
     1704                                           ,v-range-type
     1705                                           ,v-cur-code
     1706                                           ,chr(10)
     1707                                           ,error-status:get-message(1)
     1708                                           ,return-value
     1709                                          ).
     1710           end.
     1711         end.
     1712         else do:
     1713           if v-range-type = 'sclc':U
     1714           or v-range-type = 'pglc':U
     1715           then do:
     1716             assign
     1717               v-db-for-send = "":U
     1718             .
     1719             if v-g#db-num = 0 then do:
     1720               for each buf_db no-lock
     1721                 where buf_db.db-num > 0
     1722                   and buf_db.db-num <> v-g#news-source-db
     1723               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1724               :
     1725                 assign
     1726                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1727                 .
     1728               end.
     1729               assign
     1730                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1731               .
     1732             end.
     1733             else do:
     1734               if not v-g#news then do:
     1735                 assign
     1736                   v-db-for-send = "0":U
     1737                 .
     1738               end.
     1739             end.
     1740             run nws/cr-route.p ( input 'send-cmd':U
     1741                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1742                                  "code-range":U + chr(1) +
     1743                                  (if v-range-type = 'sclc':U
     1744                                   then string( current-value(s-sclc-code, ub))
     1745                                   else string( current-value(s-pglc-code, ub))
     1746                                   ) + chr(1) +
     1747                                   v-range-type)
     1748                           ,input ?
     1749                           ,input v-db-for-send
     1750                           ) no-error .
     1751             if error-status :error then do:
     1752               undo, return error return-value.
     1753             end.
     1754           end.
     1755         end.
     1756       end.
     1757     end.
     1758   end procedure.
     1759   procedure cre-loc-sc-code-range :
     1760     define input parameter v-cur-code as integer no-undo .
     1761   define input parameter p-cdrg-type as character no-undo .
     1762     do
     1763     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1764     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1765     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1766     :
     1767       define buffer buf_code-range for ub.code-range .
     1768       find first buf_code-range
     1769            where buf_code-range.range-type = p-cdrg-type
     1770              and buf_code-range.first-code >= v-cur-code
     1771            no-error .
     1772       if not available buf_code-range then do:
     1773         run new-bcod-gen-code-range in this-procedure
     1774           ( input 0,
     1775             input p-cdrg-type
     1776           ) no-error .
     1777         if error-status :error then do:
     1778           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1779                                          + "Код &2&1&3 &4"
     1780                                         , chr(10)
     1781                                         , v-cur-code
     1782                                         , error-status:get-message(1)
     1783                                         , return-value
     1784                                        ) .
     1785         end.
     1786       end.
     1787     end.
     1788   end procedure.
     1789   procedure mark-used-if-need :
     1790   define input parameter p-cur-code as integer no-undo .
     1791   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1792   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1793     do
     1794     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1795     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1796     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1797     :
     1798       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1799       define buffer buf_code-range for ub.code-range .
     1800       assign
     1801       v-db-num = if p-range-type = 'sclc':U
     1802                  then 0
     1803                  else p-db-num
     1804       .
     1805   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1806   define buffer locK-batchprocess7 for ub.batchprocess.
     1807   run gbl/lock-prc.p
     1808       (input 'lscc':U
     1809       ,input 0
     1810       ,input 0
     1811       ,input 0
     1812       ,input ""
     1813       ,input ""
     1814       ,input ""
     1815       ,input (
     1816               ",,,Вкл/выкл лок. вес. кодов"
     1817              )
     1818       ,input true
     1819       ,buffer lock-batchprocess7
     1820       ) no-error .
     1821     if error-status :error then do:
     1822       message
     1823         vss-workfile vss-revision vss-description skip
     1824         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1825         view-as alert-box error .
     1826       undo, return error .
     1827     end.
     1828       find first buf_code-range
     1829            where buf_code-range.range-type = p-range-type
     1830              and buf_code-range.first-code >= p-cur-code
     1831              and buf_code-range.last-code <= p-cur-code
     1832              and buf_code-range.db-num = v-db-num
     1833            no-error .
     1834       if not available buf_code-range then do:
     1835         message
     1836           vss-workfile vss-revision vss-description skip
     1837           "Ошибка при создании поиске диапазона" skip
     1838           "База данных" p-db-num skip
     1839           "Код" p-cur-code skip
     1840           "Тип" p-range-type
     1841           error-status :get-message(1) skip
     1842           return-value skip
     1843           view-as alert-box error .
     1844         undo, return error .
     1845       end.
     1846       if buf_code-range.stts = "f":U then do:
     1847         assign
     1848         buf_code-range.stts = "u":U
     1849         .
     1850       end.
     1851     end.
     1852   end procedure.
     1853   define variable v-creating-hist as logical no-undo .
     1854   define variable v-cmp as character no-undo .
     1855   define variable v-err as logical no-undo .
     1856   define variable v-obj-db-num as integer no-undo init -1.
     1857   define buffer buf_sysconf  for ub.sysconf.
     1858   main-block:
     1859   do
     1860   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1861   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1862   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1863   :
     1864     if new(ub.fin-doc) then do:
     1865       define variable v-db-num as integer   no-undo .
     1866       if g#news then assign v-db-num = g#news-source-db .
     1867       else           assign v-db-num = g#db-num .
     1868       run gen-new-code-range-if-neces( input v-db-num,
     1869                                        input 'fdgb':U,
     1870                                        input ub.fin-doc.fin-doc-code,
     1871                                        input g#news,
     1872                                        input g#db-num,
     1873                                        input g#news-source-db
     1874                                      ) no-error .
     1875       if error-status:error then do:
     1876         message
     1877         vss-workfile vss-revision vss-description skip
     1878         error-status :get-message(1) skip
     1879         return-value
     1880         view-as alert-box error .
     1881         undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ) .
     1882       end.
     1883     end.
     1884     if not g#news then do:
     1885       find first buf_sysconf no-lock where buf_sysconf.host-code = ub.fin-doc.host-code.
     1886       if buf_sysconf.firm-db-num <> g#db-num
     1887       then do:
     1888         if ub.fin-doc.obj-type <> ''
     1889         and ub.fin-doc.obj-code <> 0 then do:
     1890   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1891   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1892     (input  ub.fin-doc.obj-type
     1893     ,input  ub.fin-doc.obj-code
     1894     ,output v-obj-db-num
     1895     )  .
     1896           if not (v-obj-db-num = g#db-num or g#db-num = 0)
     1897           or not (ub.fin-doc.fin-ext-doc-type = 'пко':U
     1898                  or
     1899                  ub.fin-doc.fin-ext-doc-type = 'рко':U
     1900                  )
     1901          then do:
     1902            v-err = yes.
     1903           end.
     1904         end.
     1905         else do:
     1906           v-err  = yes.
     1907         end.
     1908         if v-err then do:
     1909           define variable v-mess  as character no-undo .
     1910                   v-mess = substitute("&1 &2 &3&4" +
     1911                                "Нельзя изменять запись ПЛАТЕЖА:&4" +
     1912                                "    в БД, отличной от главной БД фирмы&4"  +
     1913                                "или ПЛАТЕЖИ, не привязанные к объекту текущей БД в УБД&4" +
     1914                                "или БЕЗНАЛИЧНЫЕ ПЛАТЕЖИ в УБД" +
     1915                                "Номер текущей БД &5 Номер главной БД фирмы &6 Платеж привязан к объекту &7&8 тип платежа &9"
     1916                                 ,vss-workfile
     1917                                 ,vss-revision
     1918                                 ,vss-description
     1919                                 , chr(10)
     1920                                 , g#db-num
     1921                                 ,buf_sysconf.firm-db-num
     1922                                 , ub.fin-doc.obj-type
     1923                                 , ub.fin-doc.obj-code
     1924                                 , entry (lookup (ub.fin-doc.fin-ext-doc-type, 'пко,рко,ппп,рпп,апп,апр,':U), 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U)
     1925                                 ).
     1926         message
     1927           v-mess
     1928         view-as alert-box error .
     1929         undo main-block, return error .
     1930       end.
     1931     end.
     1932     end.
     1933     if not g#news
     1934     and not new(ub.fin-doc)
     1935     and (ub.fin-doc.status_ <> 'новый':U
     1936          or oldb.status_ <> 'новый':U
     1937          ) then do:
     1938       buffer-compare oldb
     1939       to ub.fin-doc
     1940       case-sensitive
     1941       save result in v-cmp
     1942       .
     1943       if v-cmp <> "":U then do:
     1944         assign
     1945         v-creating-hist = yes
     1946         .
     1947         run write-fin-doc-history in this-procedure (buffer oldb).
     1948       end.
     1949     end.
     1950     if oldb.status_ <> ub.fin-doc.status_
     1951     AND not new(ub.fin-doc)
     1952     and not g#news
     1953     then do:
     1954       run str/callnews.p
     1955         (input 'fin-doc':U
     1956         ,input (buffer ub.fin-doc:handle)
     1957         ).
     1958     end.
     1959     if oldb.prn-doc-code <> ub.fin-doc.prn-doc-code and ub.fin-doc.prn-doc-code <> "тех_"
     1960     AND not new(ub.fin-doc) and g#db-num <> 0
     1961     and oldb.status_ = ub.fin-doc.status_
     1962     and ub.fin-doc.status_ = 'факт':U
     1963     then do:
     1964     run nws/cr-route.p ( input 'send-cmd':U
     1965                   ,input "command":U + chr(1) + "fin-doc-prn-doc":U + chr(1) + string(ub.fin-doc.fin-doc-code) + chr(1) + string(ub.fin-doc.host-code) + chr(1) + string(ub.fin-doc.prn-doc-code) + chr(1) + "yes" + chr(1) + "1"
     1966                   ,input ?
     1967                   ,input 0
     1968                  ).
     1969     end.
     1970       if g#oxml = yes
     1971       then do:
     1972       run str/calloxml.p (
     1973             input 'update':U
     1974           , input 'fin-doc':U
     1975           , input ( buffer ub.fin-doc:handle )
     1976       ) no-error.
     1977       if error-status :error
     1978       then do:
     1979           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1980                                , chr(10)
     1981                                , vss-workfile
     1982                                , return-value
     1983                                , error-status :get-message ( 1 ) ).
     1984       end.
     1985       end.
     1986       if ub.fin-doc.status_ = 'факт':U then do:
     1987   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1988     (input ?
     1989     ,input this-procedure:handle
     1990     ,input ?
     1991     ,input 'event_fin-doc':U
     1992     ,input  buffer oldb:handle
     1993     ,input  buffer ub.fin-doc:handle
     1994     ,input ''
     1995     ,input ''
     1996     ) no-error .
     1997       if error-status :error
     1998       then
     1999       do:
     2000           return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
     2001               , chr(10)
     2002               , vss-workfile
     2003               , return-value
     2004               , error-status :get-message ( 1 ) ).
     2005       end.
     2006       end.
     2007   end.
