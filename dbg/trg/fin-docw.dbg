      940               when 'lockid':U then do:     assign     p-news = no.   end.
      941               when 'cover_sheet':U then do:     assign     p-news = no.   end.
      942               when 'pre-vedom':U then do:     assign     p-news = no.   end.
      943         otherwise do:
