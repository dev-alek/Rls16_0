      352   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   define variable v-waitfram-action01         as character   no-undo .
      354   define variable v-waitfram-action02         as character   no-undo .
      355   define variable v-waitfram-action03         as character   no-undo .
      356   define variable mWaitFramTextBeg            as character   no-undo.
      357   define variable mWaitFramTextEnd            as character   no-undo.
      358   define variable mWaitFramView               as logical     no-undo.
      359   define variable mWaitProcEvent              as logical     no-undo init yes.
      360   define variable mWaitFramInterval           as integer     no-undo init 1 .
      361   define variable mWaitFramStop               as logical     no-undo.
      362   define variable mWaitFramStopUser           as logical     no-undo.
      363   define variable mWaitFramStopTimeOut        as logical     no-undo.
      364   define variable mWaitFramStartProc          as datetime-tz no-undo.
      365   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      366   define button B-WaitFramStop auto-end-key
      367        label "Стоп"
      368        size 10 by 1 tooltip "Остоновить процесс".
      369   define button B-viewProcInfo
      370        label "Информация"
      371        size 15 by 1 tooltip "Информация о процесс".
      372   define frame waitfram
      373     v-waitfram-action01 format "x(72)" no-label skip
      374     v-waitfram-action02 format "x(72)" no-label skip
      375     v-waitfram-action03 format "x(72)" no-label skip
      376     B-viewProcInfo
      377     B-WaitFramStop at row 4 col 30
      378     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      379     .
      380   define new global shared variable mBatchMode as logical no-undo init ?.
      381   define variable mFramBachModHandle as handle no-undo.
      382   mFramBachModHandle = frame waitfram:handle.
      383   define variable mFameOldVis as logical no-undo.
      384   define variable mVisCUrentVin as logical no-undo.
      385   if session:batch-mode
      386   then
      387      mBatchMode = yes.
      388   if mBatchMode = ? then do:
      389     mVisCUrentVin = current-window:visible.
      390     mFameOldVis = mFramBachModHandle:visible.
      391     mFramBachModHandle:visible  = yes.
      392     mBatchMode = mFramBachModHandle:visible ne yes.
      393     mFramBachModHandle:visible = mFameOldVis.
      394     current-window:visible = mVisCUrentVin.
      395   end.
      396    if  log-manager:logfile-name ne ?
      397     then DO:
      398         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      399         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      400         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      401     end.
      402   on choose of B-WaitFramStop in frame waitfram
      403   do:
      404     mWaitFramStop = yes.
      405     mWaitFramStopUser = yes.
      406   end.
      407   function waitfram-check-timeout returns logical():
      408      define variable vtime as int64 no-undo.
      409      if mWaitFramStopTimeOut
      410      then
      411         return yes.
      412      vtime = ( now - mWaitFramStartProc ) / 1000 .
      413      if     mWaitFramTimeOut ne ?
      414         and mWaitFramTimeOut ne 0
      415         and mWaitFramTimeOut lt vtime
      416      then do:
      417         mWaitFramStopTimeOut = yes.
      418      end.
      419      return mWaitFramStopTimeOut.
      420   end.
      421   procedure waitfram-hide :
      422     if not session:batch-mode
      423     then do
      424     on error undo, return error return-value
      425     :
      426       pause 0 before-hide .
      427       if not mBatchMode then
      428         hide frame waitfram .
      429     if     not mWaitFramView
      430        and mWaitProcEvent
      431     then
      432       process events .
      433     end.
      434   end procedure.
      435   procedure waitfram-show :
      436     define input  parameter p-message as character no-undo .
      437     define variable v-left-margin as integer   no-undo .
      438     if not session:batch-mode
      439     then do
      440     on error undo, return error return-value
      441     :
      442       if length(p-message) <= 70 then do:
      443         assign
      444           v-left-margin = integer((70 - length(p-message)) / 2)
      445         .
      446         assign
      447           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      448         .
      449         assign
      450           v-waitfram-action01 = " "
      451           v-waitfram-action02 = " "
      452                                    + fill(" ", v-left-margin)
      453                                    + p-message
      454           v-waitfram-action03 = " "
      455         .
      456       end.
      457       else do:
      458         define variable vRindex1 as integer no-undo.
      459         define variable vRindex2 as integer no-undo.
      460         vRindex1 = r-index(p-message," ",70).
      461         if vRindex1 = 0
      462         then
      463            vRindex1 = 70.
      464         if length(p-message)  <= vRindex1 + 70 then do:
      465           assign
      466             v-waitfram-action01 = " "
      467             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      468             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      469           .
      470         end.
      471         else do:
      472           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      473           if vRindex2 <= vRindex1
      474           then
      475              vRindex2 = vRindex1 + 70.
      476           assign
      477             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      478             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      479             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      480           .
      481         end.
      482       end.
      483       B-viewProcInfo:visible   in frame waitfram = no.
      484       B-viewProcInfo:sensitive in frame waitfram = no.
      485       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      486       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      487       if  (   mWaitFramView
      488          or  mWaitProcEvent)
      489          and not mBatchMode
      490       then
      491          display
      492             v-waitfram-action01 skip
      493             v-waitfram-action02 skip
      494             v-waitfram-action03 skip
      495          with frame waitfram .
      496       if     mWaitFramView
      497          then do:
      498             if     mWaitFramInterval ne ?
      499                and not mBatchMode
      500             then
      501                wait-for go of frame waitfram pause mWaitFramInterval.
      502          end.
      503          else
      504             if     mWaitProcEvent
      505                and not mBatchMode
      506             then
      507                process events .
      508     end.
      509   end procedure.
      510      procedure waitfram-show-this:
      511         define input  parameter iInterval as int64 no-undo.
      512         define variable vtime as int64 no-undo.
      513         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      514         mWaitFramInterval = iInterval.
      515         run waitfram-show (substitute("&1&2 &3&4" ,
      516                                       mWaitFramTextBeg ,
      517                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      518                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      519                                       mWaitFramTextEnd
      520                                      )
      521                           ).
      522      end.
      523      procedure WaitFramRunPause:
      524         define input  parameter iInterval as dec no-undo.
      525         define variable vStart  as datetime-tz no-undo.
      526         define variable vend    as datetime-tz no-undo.
      527         define variable vint as int64 no-undo.
      528         define variable vOk as logical no-undo.
      529         vStart = now.
      530         vend   = vStart.
      531         publish "WaitFramPause" (iInterval,output vOk).
      532         vend   =  now.
      533         vint = vend - vStart.
      534         vint = iInterval - vint / 1000.
      535         if     not mWaitFramStop
      536            and (   vint > 0
      537                 or (    not vOk
      538                     and iInterval eq ?
      539                     )
      540                 )
      541         then
      542            run waitfram-show-this (iInterval).
      543         vend   =  now.
      544         vint = vend - vStart.
      545         vint = iInterval - vint / 1000.
      546         if     not mWaitFramStop
      547            and vint > 0
      548         then do:
      549            run gbl/pause.p (vint * 1000).
      550         end.
      551         if iInterval ne ?
      552         then
      553            publish "WaitFramStop".
      554         waitfram-check-timeout().
      555      end.
      556      procedure WaitFramWaitFor:
      557         define input  parameter iInterval as dec no-undo.
      558         assign
      559            mWaitFramStartProc   = now
      560            mWaitFramStopUser    = no
      561            mWaitFramStopTimeOut = no
      562         .
      563         block-wait:
      564         do while not mWaitFramStop:
      565            run WaitFramRunPause (iInterval).
      566            if  waitfram-check-timeout()
      567            then do:
      568               leave block-wait.
      569            end.
      570         end.
      571         run waitfram-hide.
      572      end.
      573   procedure waitfram-join :
      574     define input  parameter p-line-1  as character no-undo .
      575     define input  parameter p-line-2  as character no-undo .
      576     define input  parameter p-line-3  as character no-undo .
      577     define output parameter p-message as character no-undo .
      578     do
      579     on error undo, return error return-value
      580     :
      581       assign
      582         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      583                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      584                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      585       .
      586     end.
      587   end procedure.
      588   function waitfram-join-function returns character
      589     (input p-line-1 as character
      590     ,input p-line-2 as character
      591     ,input p-line-3 as character
      592     ).
      593     define variable v-message as character no-undo .
      594     run waitfram-join in this-procedure
      595       (input  p-line-1
      596       ,input  p-line-2
      597       ,input  p-line-3
      598       ,output v-message
      599       ) .
      600     return v-message .
      601   end function .
      602   define buffer buf_clients for ub.clients .
      603   define variable v-attr-code-calc           as character no-undo .
      604   define variable v-attr-code-del            as character no-undo .
      605   define variable v-attr-code-disable        as character no-undo .
      606   define variable v-attr-value               as character no-undo .
      607   define variable v-attr-type                as character no-undo .
      608   define variable v-archive-type-description as character no-undo .
      609   define variable v-lock-prc-restore         as character no-undo .
      610   define variable v-lock-prc-calc            as character no-undo .
      611   define variable v-lock-prc-stop-news       as character no-undo .
      612   define variable v-create-chip-num          as character no-undo .
      613   do
      614   on error undo, return error return-value
      615   :
      616     case p-archive-type
      617     :
      618       when 'arh':U
      619       then do:
      620         assign
      621           v-attr-code-calc           = 'arh-calc':U
      622           v-attr-code-del            = 'arh-del':U
      623           v-attr-code-disable        = 'arh-disable':U
      624           v-archive-type-description = "по товарам"
      625           v-lock-prc-restore         = 'rsar':U
      626           v-lock-prc-calc            = 'btpr':U
      627           v-lock-prc-stop-news       = 'rsrn':U
      628         .
      629       end.
      630       when 'ahsp':U
      631       then do:
      632         assign
      633           v-attr-code-calc           = 'ahsp-calc':U
      634           v-attr-code-del            = 'ahsp-del':U
      635           v-attr-code-disable        = 'ahsp-disable':U
      636           v-archive-type-description = "по поставщикам"
      637           v-lock-prc-restore         = 'rsas':U
      638           v-lock-prc-calc            = 'ahsp':U
      639           v-lock-prc-stop-news       = 'rssn':U
      640         .
      641       end.
      642       when 'aht':U
      643       then do:
      644         assign
      645           v-attr-code-calc           = 'aht-calc':U
      646           v-attr-code-del            = 'aht-del':U
      647           v-attr-code-disable        = 'aht-disable':U
      648           v-archive-type-description = "по типам приобретения"
      649           v-lock-prc-restore         = 'rsat':U
      650           v-lock-prc-calc            = 'ahtb':U
      651           v-lock-prc-stop-news       = 'rstn':U
      652         .
      653       end.
      654       otherwise do:
      655         message
      656           vss-workfile vss-revision vss-description skip
      657           "Ошибка задания входных параметров" skip
      658           "Неизвестное значение параметра p-archive-type" skip
      659           "" p-archive-type skip
      660           view-as alert-box error .
      661         undo, return error return-value .
      662       end.
      663     end.
      664     find first buf_clients no-lock
      665       where buf_clients.obj-type = p-obj-type
      666         and buf_clients.obj-code = p-obj-code
      667       no-error .
      668     if not available buf_clients
      669     then do:
      670       message
      671         vss-workfile vss-revision vss-description skip
      672         "Ошибка задания входных параметров" skip
      673         "Не найден объект" skip
      674         "Объект" p-obj-type p-obj-code skip
      675         view-as alert-box error .
      676       undo, return error return-value .
      677     end.
      678     if  p-obj-type <> 'маг':U
      679     and p-obj-type <> 'скл':U
      680     then do:
      681       message
      682         vss-workfile vss-revision vss-description skip
      683         "Ошибка задания входных параметров" skip
      684         "Неправильный тип объекта" skip
      685         "Объект" p-obj-type p-obj-code skip
      686         view-as alert-box error .
      687       undo, return error return-value .
      688     end.
      689     if p-disable = ?
      690     then do:
      691       message
      692         vss-workfile vss-revision vss-description skip
      693         "Ошибка задания входных параметров" skip
      694         "Не задано значение параметра p-disable" skip
      695         view-as alert-box error .
      696       undo, return error return-value .
      697     end.
      698     define buffer restore-arh-lock_batchprocess for ub.batchprocess .
      699     run gbl/lock-prc.p
      700       (input v-lock-prc-restore
      701       ,input p-obj-code
      702       ,input 0
      703       ,input 0
      704       ,input p-obj-type
      705       ,input ""
      706       ,input ""
      707       ,input substitute("Объект,,, ,,,Восстановление складского складского архива &1", v-archive-type-description)
      708       ,input true
      709       ,buffer restore-arh-lock_batchprocess
      710       ) no-error .
      711     if error-status :error
      712     then do:
      713       if error-status :get-message(1) <> ""
      714       then do:
      715         message
      716           vss-workfile vss-revision vss-description skip
      717           "Ошибка при вызове процедуры блокировки восстановления складского архива" skip
      718           "Объект" p-obj-type p-obj-code skip
      719           "Складской архив" v-archive-type-description skip
      720           error-status :get-message(1) skip
      721           return-value skip
      722           view-as alert-box error .
      723       end.
      724       undo, return error return-value .
      725     end.
      726     define variable v-need-stop-arh as logical   no-undo .
      727     assign
      728       v-need-stop-arh = false
      729     .
      730     define buffer calc-arh-lock_batchprocess for ub.batchprocess .
      731     run gbl/lock-prc.p
      732       (input v-lock-prc-calc
      733       ,input p-obj-code
      734       ,input 0
      735       ,input 0
      736       ,input p-obj-type
      737       ,input ""
      738       ,input ""
      739       ,input substitute("Объект,,, ,,,Расчет складского архива &1", v-archive-type-description)
      740       ,input false
      741       ,buffer calc-arh-lock_batchprocess
      742       ) no-error .
      743     if error-status :error then do:
      744       if error-status :get-message(1) <> ""
      745       then do:
      746         message
      747           vss-workfile vss-revision vss-description skip
      748           "Ошибка при вызове процедуры блокировки расчета складского архива" skip
      749           "Объект" p-obj-type p-obj-code skip
      750           "Складской архив" v-archive-type-description skip
      751           error-status :get-message(1) skip
      752           return-value skip
      753           view-as alert-box error .
      754         undo, return error substitute("Ошибка при вызове процедуры блокировки расчёта складского архива &1", v-archive-type-description) .
      755       end.
      756       assign
      757         v-need-stop-arh = true
      758       .
      759     end.
      760     define buffer stop-arh-news-lock_btpr for batchprocess .
      761     if v-need-stop-arh = true
      762     then do:
      763       do transaction
      764       on error undo, return error return-value
      765       :
      766         create stop-arh-news-lock_btpr .
      767         assign
      768           stop-arh-news-lock_btpr.bp_type       = 'lock':U + v-lock-prc-stop-news
      769           stop-arh-news-lock_btpr.bp_status     = 'N':U
      770           stop-arh-news-lock_btpr.Key#_One      = p-obj-code
      771           stop-arh-news-lock_btpr.Key#_Two      = 0
      772           stop-arh-news-lock_btpr.Key#_Three    = 0
      773           stop-arh-news-lock_btpr.CharKey_One   = p-obj-type
      774           stop-arh-news-lock_btpr.CharKey_Two   = ""
      775           stop-arh-news-lock_btpr.CharKey_Three = ""
      776         .
      777         define variable v-start-lock-time   as int64     no-undo .
      778         define variable v-start-lock-second as integer   no-undo .
      779         assign
      780           v-start-lock-time = etime
      781         .
      782         wait_block:
      783         do while true
      784         :
      785           assign
      786             v-start-lock-second = integer((etime - v-start-lock-time) / 1000)
      787           .
      788           run waitfram-show in this-procedure
      789             (input waitfram-join-function(substitute("Архив &1 рассчитывается на другой машине", v-archive-type-description)
      790                                          ,substitute("Отправлено сообщение о необходимости остановки расчёта складского архива &1", v-archive-type-description)
      791                                          ,substitute("Ожидание освобождение ресурса расчёта складского архива &1", string(v-start-lock-second, 'HH:MM:SS':U))
      792                                          )
      793             ) .
      794           run gbl/lock-prc.p
      795             (input v-lock-prc-calc
      796             ,input p-obj-code
      797             ,input 0
      798             ,input 0
      799             ,input p-obj-type
      800             ,input ""
      801             ,input ""
      802             ,input substitute("Объект,,, ,,,Расчет складского архива &1", v-archive-type-description)
      803             ,input false
      804             ,buffer calc-arh-lock_batchprocess
      805             ) no-error .
      806           if error-status :error
      807           then do:
      808             if error-status :get-message(1) <> ""
      809             then do:
      810               message
      811                 vss-workfile vss-revision vss-description skip
      812                 substitute("Ошибка при вызове процедуры блокировки расчета складского архива &1", v-archive-type-description) skip
      813                 error-status :get-message(1) skip
      814                 return-value skip
      815                 view-as alert-box error .
      816               undo, return error return-value .
      817             end.
      818           end.
      819           else do:
      820             leave wait_block .
      821           end.
      822           pause 1 no-message .
      823         end.
      824         delete stop-arh-news-lock_btpr .
      825         run waitfram-hide in this-procedure .
      826       end.
      827     end.
      828     if p-disable = true
      829     then do:
      830       run clntattr-value in this-procedure
      831         (input  p-obj-type
      832         ,input  p-obj-code
      833         ,input  v-attr-code-disable
      834         ,output v-attr-value
      835         ,output v-attr-type
      836         ) .
      837       if lookup(v-attr-value
      838                ,'yes,true':u
      839                ) = 0
      840       then do:
      841         run utl/arhiscr.p
      842           (input  p-obj-type
      843           ,input  p-obj-code
      844           ,input  p-archive-type
      845           ,input  'set-disable':U
      846           ,input  ""
      847           ,input  ""
      848           ,input  0
      849           ,input  ""
      850           ,input  ""
      851           ,input  ?
      852           ,output v-create-chip-num
      853           ) .
      854         run clntattr-write in this-procedure
      855           (input  p-obj-type
      856           ,input  p-obj-code
      857           ,input  v-attr-code-del
      858           ,input  'yes':u
      859           ) .
      860         run clntattr-write in this-procedure
      861           (input  p-obj-type
      862           ,input  p-obj-code
      863           ,input  v-attr-code-calc
      864           ,input  'yes':u
      865           ) .
      866         run clntattr-write in this-procedure
      867           (input  p-obj-type
      868           ,input  p-obj-code
      869           ,input  v-attr-code-disable
      870           ,input  'yes':u
      871           ) .
      872       end.
      873     end.
      874     else do:
      875       run clntattr-value in this-procedure
      876         (input  p-obj-type
      877         ,input  p-obj-code
      878         ,input  v-attr-code-disable
      879         ,output v-attr-value
      880         ,output v-attr-type
      881         ) .
      882       if lookup(v-attr-value
      883                ,'yes,true':u
      884                ) > 0
      885       then do:
      886         run utl/arhiscr.p
      887           (input  p-obj-type
      888           ,input  p-obj-code
      889           ,input  p-archive-type
      890           ,input  'clear-disable':U
      891           ,input  ""
      892           ,input  ""
      893           ,input  0
      894           ,input  ""
      895           ,input  ""
      896           ,input  ?
      897           ,output v-create-chip-num
      898           ) .
      899         run clntattr-write in this-procedure
      900           (input  p-obj-type
      901           ,input  p-obj-code
      902           ,input  v-attr-code-disable
      903           ,input  'no':u
      904           ) .
      905       end.
      906     end.
      907   end.
