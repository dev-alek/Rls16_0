        1   block-level on error undo, throw.
        2   define input parameter pardoc-code like ub.wth-line.doc-code no-undo .
        3   define input parameter parhost-code like ub.wth-doc.host-code no-undo .
        4   define input parameter parobj-type like ub.wth-doc.obj-type no-undo .
        5   define input parameter parobj-code like ub.wth-doc.obj-code no-undo .
        6   define input parameter parcli-type like ub.wth-doc.cli-type no-undo .
        7   define input parameter parcli-code like ub.wth-doc.cli-code no-undo .
        8   define input parameter parauto-fill like ub.wth-doc.auto-fill no-undo .
        9   define input parameter par-borned like ub.wth-doc.borned no-undo .
       10   define input parameter par-rid as recid no-undo .
       11   define input parameter parwth-code like ub.wth-line.wth-code no-undo .
       12   define input parameter parw-p-code like ub.wth-line.w-p-code no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Проверка корректности записи строки документа МЦ инвентар".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   DEFINE VARIABLE var-entry as character no-undo .
       89   define buffer buf_wth-place for ub.wth-place .
       90   define buffer buf_wth-line for ub.wth-line .
       91   do
       92   on error undo, return error
       93   :
       94   IF NOT CAN-FIND( ub.wealth NO-LOCK WHERE ub.wealth.wth-code = parwth-code ) THEN DO:
       95     MESSAGE
       96     "Материальная ценность" parwth-code "не найдена в справочнике!"
       97     VIEW-AS ALERT-BOX ERROR.
       98     var-entry = "wth-code":U.
       99     return error var-entry .
      100   END.
      101   FIND FIRST buf_wth-place NO-LOCK WHERE
      102       buf_wth-place.host-code   = parhost-code AND
      103       buf_wth-place.obj-type    = parobj-type AND
      104       buf_wth-place.obj-code    = parobj-code AND
      105       buf_wth-place.w-p-code    = parw-p-code  NO-ERROR.
      106   IF NOT AVAIL buf_wth-place THEN DO:
      107     MESSAGE
      108     "Документ" pardoc-code skip
      109     "МЦ" parwth-code skip
      110     "МХ" parw-p-code skip
      111     "Не найдено место хранения МЦ в справочнике!"
      112     VIEW-AS ALERT-BOX ERROR.
      113     var-entry = "w-p-code":U.
      114     return error var-entry .
      115   END.
      116   if parauto-fill and buf_wth-place.cash-desk = 0 and not par-borned then do:
      117     MESSAGE
      118     "Документ" pardoc-code skip
      119     "МЦ" parwth-code skip
      120     "МХ" parw-p-code skip
      121     "Для автоматического документа место хранения должно быть кассой!"
      122     VIEW-AS ALERT-BOX ERROR.
      123     var-entry = "w-p-code":U.
      124     return error var-entry .
      125   end.
      126   FIND FIRST buf_wth-line NO-LOCK WHERE
      127             buf_wth-line.obj-type    = parobj-type   AND
      128             buf_wth-line.obj-code    = parobj-code   AND
      129             buf_wth-line.w-p-code    = parw-p-code   AND
      130             buf_wth-line.wth-code    = parwth-code   AND
      131             buf_wth-line.doc-code    = pardoc-code AND
      132             RECID( buf_wth-line )   <>  par-rid NO-ERROR.
      133   IF AVAIL buf_wth-line THEN DO:
      134     MESSAGE
      135     "В этом документе уже есть запись материальной ценности" parwth-code "по м/х" parw-p-code "!" SKIP
      136     "Невозможно добавить в документ!"
      137     VIEW-AS ALERT-BOX ERROR.
      138     var-entry = "wth-code":U.
      139     return error var-entry .
      140   END.
      141   end.
