        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.c-wth-place.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление истории МХ МЦ".
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   define new global shared variable g#library  as handle no-undo .
       14   define new global shared variable g#library2 as handle no-undo .
       15   define   shared variable g#auto as logical no-undo.
       16   define   shared variable g#news as logical no-undo.
       17   define   shared variable g#oxml as logical no-undo.
       18   define   shared variable g#esys as logical no-undo.
       19   define   shared variable g#news-source-db as integer no-undo.
       20   define   shared variable g#esys-source-esys as integer no-undo.
       21   define   shared variable g#db-num as integer   no-undo .
       22   define   shared variable g#userid as character no-undo .
       23   define   shared variable g#passwd as character no-undo .
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42       assign
       43         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&7'
       44                              , ub.c-wth-place.host-code
       45                              , ub.c-wth-place.obj-type
       46                              , ub.c-wth-place.obj-code
       47                              , ub.c-wth-place.w-p-code
       48                              , ub.c-wth-place.corr-user-db-num
       49                              , ub.c-wth-place.chip-num
       50                              )
       51       .
       52   end procedure.
       53   define new global shared variable g#vssrevis-logger as handle    no-undo .
       54   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       55   define variable v-vssrevis-logger                   as handle    no-undo .
       56   procedure vss-logevent :
       57     define input  parameter p-extra-paramters as character no-undo .
       58     define variable v-vssrevis-parameters as character no-undo .
       59     do
       60     on error undo, return error return-value
       61     :
       62       if  valid-handle(v-vssrevis-logger)
       63       and v-vssrevis-logger :get-signature("logevent") <> ""
       64       then do:
       65         run vss-get-parameters in this-procedure
       66           (output v-vssrevis-parameters
       67           ).
       68         run logevent in v-vssrevis-logger
       69           (input vss-workfile
       70           ,input vss-revision
       71           ,input v-vssrevis-parameters
       72           ,input p-extra-paramters
       73           ).
       74       end.
       75     end.
       76   end procedure.
       77   assign
       78     v-vssrevis-logger = g#vssrevis-logger
       79   .
       80   if  valid-handle(v-vssrevis-logger)
       81   and v-vssrevis-logger :get-signature("logevent") <> ""
       82   then do:
       83     assign
       84       v-vssrevis-logevent = true
       85     .
       86     run vss-logevent in this-procedure (input vss-description) .
       87   end.
       88   main-block :
       89   do transaction
       90   on error undo main-block, return error return-value
       91   :
       92     message
       93     vss-workfile vss-revision vss-description skip
       94     "Нельзя удалять запись истории МХ МЦ"
       95     view-as alert-box error .
       96     undo main-block, return error .
       97   end.
