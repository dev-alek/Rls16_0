      206   procedure db-attr-manual-edit :
      207     define input  parameter p-code           as character no-undo .
      208     define output parameter p-section-num    as integer no-undo .
      209     do
      210     on error undo, return error
      211     :
      212           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-manual-edit in g#attr-lib
      213         (input  p-code
      214         ,output p-section-num
