        1   block-level on error undo, throw.
        2   define input  parameter p-archive-type as character no-undo .
        3   define input  parameter p-db-num       as integer   no-undo .
        4   define input  parameter p-disable      as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Запретить или разрешить расчет архива по базе данных".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new global shared variable g#attr-lib  as handle no-undo .
       71   define variable v-attr-lib-variable as handle no-undo .
       72   procedure db-attr-code :
       73     define input  parameter p-code           as character no-undo .
       74     define output parameter p-type           as character no-undo .
       75     define output parameter p-format         as character no-undo .
       76     define output parameter p-label          as character no-undo .
       77     define output parameter p-user-can-edit  as logical   no-undo .
       78     define output parameter p-output-display as logical   no-undo .
       79     define output parameter p-other          as character no-undo .
       80     do
       81     on error undo, return error
       82     :
       83           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
       84         (input  p-code
       85         ,output p-type
       86         ,output p-format
       87         ,output p-label
       88         ,output p-user-can-edit
       89         ,output p-output-display
       90         ,output p-other
       91         ) no-error .
       92       if error-status :error
       93       then do:
       94         undo, return error return-value .
       95       end.
       96     end.
       97   end procedure.
       98   procedure db-attr-tooltip :
       99     define input  parameter p-code    as character no-undo .
      100     define output parameter p-tooltip as character no-undo .
      101     define output parameter p-label   as character no-undo .
      102     do
      103     on error undo, return error
      104     :
      105           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-tooltip in g#attr-lib
      106         (input  p-code
      107         ,output p-tooltip
      108         ,output p-label
      109         ) no-error .
      110       if error-status :error
      111       then do:
      112         undo, return error return-value .
      113       end.
      114     end.
      115   end procedure.
      116   procedure db-attr-value :
