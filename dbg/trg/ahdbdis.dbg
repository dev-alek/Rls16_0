      222   procedure db-attr-batch-edit :
      223     define input  parameter p-code           as character no-undo .
      224     define output parameter p-section-num    as integer no-undo .
      225     do
      226     on error undo, return error
      227     :
      228           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-batch-edit in g#attr-lib
      229         (input  p-code
      230         ,output p-section-num
      231         ) no-error .
      232       if error-status :error
      233       then do:
      234         undo, return error return-value .
      235       end.
      236     end.
      237   end procedure.
      238   define buffer buf_db      for ub.db .
      239   define buffer buf_clients for ub.clients .
      240   define variable v-db-attr-code  as character no-undo .
      241   define variable v-db-attr-value as character no-undo .
      242   do
      243   on error undo, return error return-value
      244   :
      245     case p-archive-type
      246     :
      247       when 'arh':U
      248       then do:
      249         assign
      250           v-db-attr-code = 'arh-disable':U
      251         .
      252       end.
      253       when 'ahsp':U
      254       then do:
      255         assign
      256           v-db-attr-code = 'ahsp-disable':U
      257         .
      258       end.
      259       when 'aht':U
      260       then do:
      261         assign
      262           v-db-attr-code = 'aht-disable':U
      263         .
      264       end.
      265       otherwise do:
      266         message
      267           vss-workfile vss-revision vss-description skip
      268           "Ошибка задания входных параметров" skip
      269           "Неизвестное значение параметра p-archive-type" skip
      270           "" p-archive-type skip
      271           view-as alert-box error .
      272         undo, return error return-value .
      273       end.
      274     end case .
      275     find first buf_db no-lock
      276       where buf_db.db-num = p-db-num
      277       no-error .
      278     if not available buf_db
      279     then do:
      280       message
      281         vss-workfile vss-revision vss-description skip
      282         "Ошибка задания входных параметров" skip
      283         "Не найдена база данных" skip
      284         "Номер базы данных" p-db-num skip
      285         view-as alert-box error .
      286       undo, return error return-value .
      287     end.
      288     case p-disable
      289     :
      290       when true
      291       then do:
      292         assign
      293           v-db-attr-value = 'yes':u
      294         .
      295       end.
      296       when false
      297       then do:
      298         assign
      299           v-db-attr-value = 'no':u
      300         .
      301       end.
      302       otherwise do:
      303         message
      304           vss-workfile vss-revision vss-description skip
      305           "Ошибка задания входных параметров" skip
      306           "Не задано значение параметра p-disable" skip
      307           view-as alert-box error .
      308         undo, return error return-value .
      309       end.
      310     end.
      311     run db-attr-write in this-procedure
      312       (input  p-db-num
      313       ,input  v-db-attr-code
      314       ,input  v-db-attr-value
      315       ) .
      316     for each buf_clients no-lock
      317       where buf_clients.db-num = p-db-num
      318     on error undo, return error return-value
      319     :
      320       run trg/ahobjdis.p
      321         (input  p-archive-type
      322         ,input  buf_clients.obj-type
      323         ,input  buf_clients.obj-code
      324         ,input  p-disable
      325         ) .
      326     end.
      327   end.
