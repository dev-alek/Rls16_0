      118     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      119     define output parameter p-value     like ub.db-attr.attr-value no-undo .
      120     define output parameter p-type      as character no-undo .
      121     do
      122     on error undo, return error
      123     :
      124           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-value in g#attr-lib
      125         (input  p-db-num
      126         ,input  p-code
      127         ,output p-value
      128         ,output p-type
      129         ) no-error .
      130       if error-status :error
      131       then do:
      132         undo, return error return-value .
      133       end.
      134     end.
      135   end procedure.
      136   procedure db-attr-write :
      137     define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      138     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      139     define input parameter p-value     like ub.db-attr.attr-value no-undo .
      140     do
      141     on error undo, return error
      142     :
      143           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
      144         (input p-db-num
      145         ,input p-code
      146         ,input p-value
      147         ) no-error .
      148       if error-status :error
      149       then do:
      150         undo, return error return-value .
      151       end.
