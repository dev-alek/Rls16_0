      154   procedure db-attr-exist :
      155     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      156     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      157     define output parameter p-exist    as logical  no-undo .
      158     do
      159     on error undo, return error
      160     :
      161           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-exist in g#attr-lib
      162         (input  p-db-num
      163         ,input  p-code
