        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.pl-gds NEW BUFFER new_pl-gds OLD BUFFER old_pl-gds.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Триггер на запись pl-gds":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4'
       29                            , new_pl-gds.obj-type
       30                            , new_pl-gds.obj-code
       31                            , new_pl-gds.pl-code
       32                            , new_pl-gds.gds-code
       33                            )
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure cur-time :
       88      define output parameter p-today as date      no-undo .
       89      define output parameter p-time  as integer   no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       define variable v-date1 as date      no-undo .
       94       define variable v-date2 as date      no-undo .
       95       define variable v-time  as integer   no-undo .
       96       assign
       97         v-date1 = today
       98         v-time  = time
       99         v-date2 = today
      100       .
      101       if v-date1 <> v-date2
      102       then do:
      103         assign
      104           v-date1 = today
      105           v-time  = v-time
      106         .
      107       end.
      108       assign
      109         p-today = v-date1
      110         p-time  = v-time
      111       .
      112     end.
      113   end.
      114   function cur-time-date returns character
      115   :
      116     return string(today, '99/99/9999':U) .
      117   end.
      118   function cur-time-mjd returns decimal
      119   :
      120     define variable v-date as date      no-undo .
      121     define variable v-time as integer   no-undo .
      122     run cur-time in this-procedure
      123       (output v-date
      124       ,output v-time
      125       ) .
      126     return integer(v-date) - 2400002 + (v-time / 86400) .
      127   end.
      128   function cur-time-get-ending-index returns integer
      129   (input p-number as integer
      130   )
      131   :
      132     if p-number < 0
      133     or p-number = ?
      134     then do:
      135       return 1 .
      136     end.
      137     define variable v-rest as integer   no-undo .
      138     assign
      139       p-number = p-number modulo 100
      140     .
      141     if p-number < 20
      142     then do:
      143       assign
      144         v-rest = p-number
      145       .
      146     end.
      147     else do:
      148       assign
      149         v-rest = p-number modulo 10
      150       .
      151     end.
      152     case v-rest :
      153       when 1
      154       then do:
      155         return 2 .
      156       end.
      157       when 2 or
      158       when 3 or
      159       when 4
      160       then do:
      161         return 3 .
      162       end.
      163       otherwise do:
      164         return 1 .
      165       end.
      166     end case .
      167   end.
      168   procedure cur-time-mjd-to-date :
      169      define input  parameter i-mjd-diff as decimal no-undo.
      170      define output parameter o-Date     as date    no-undo.
      171      define output parameter o-Time     as integer no-undo.
      172      define variable v-day-number as integer   no-undo .
      173      if    i-mjd-diff < 0
      174         or i-mjd-diff = ?
      175      then do:
      176         return "?" .
      177      end.
      178      assign
      179         v-day-number = truncate(i-mjd-diff,0).
      180         o-Date = date(v-day-number + 2400002).
      181         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      182     .
      183   end.
      184   function cur-time-mjd-to-string returns character
      185   (input p-mjd-diff as decimal
      186   )
      187   :
      188     define variable v-day-number as integer   no-undo .
      189     define variable v-seconds    as integer   no-undo .
      190     define variable v-hour       as integer   no-undo .
      191     define variable v-min        as integer   no-undo .
      192     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      193     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      194     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      195     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      196     if p-mjd-diff < 0
      197     or p-mjd-diff = ?
      198     then do:
      199       return "?" .
      200     end.
      201     assign
      202       v-day-number = integer(truncate(p-mjd-diff,0))
      203       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      204     .
      205     if v-seconds > 86400
      206     then do:
      207       assign
      208         v-seconds = 86400 - 1
      209       .
      210     end.
      211     if v-seconds < 0
      212     then do:
      213       assign
      214         v-seconds = 0
      215       .
      216     end.
      217     assign
      218       v-hour = truncate(v-seconds / 3600, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 3600
      222     .
      223     assign
      224       v-min = truncate(v-seconds / 60, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 60
      228     .
      229     return
      230         (if v-day-number <> 0
      231           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0
      235           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      239           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      240           else ""
      241         )
      242       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      243       .
      244   end.
      245   function cur-time-string returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      254   end.
      255   function cur-time-string-sec returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      264   end.
      265   function cur-time-custom  returns character
      266   (input p-prefix as character
      267   ,input p-date-format as character
      268   ,input p-delimiter as character
      269   ,input p-time-format as character
      270   ,input p-suffix as character
      271   )
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return
      280       p-prefix
      281       + string(v-date, p-date-format)
      282       + p-delimiter
      283       + string(v-time, p-time-format)
      284       + p-suffix
      285       .
      286   end.
      287   function cur-time-print  returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-datetime returns datetime
      298   :
      299     define variable v-char as character no-undo .
      300     define variable v-datetime as datetime no-undo .
      301     v-char = cur-time-string().
      302     v-datetime = datetime(v-char).
      303     return  v-datetime.
      304   end.
      305   function cur-time-string-msec returns character
      306   :
      307     define variable v-date as datetime  no-undo .
      308     v-date = now.
      309     return string(v-date) .
      310   end.
      311   main-block:
      312   do
      313     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      314     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      315     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      316     :
      317     define variable v-l-ref     as logical no-undo.
      318     define variable v-l-rest    as logical no-undo.
      319     define variable v-db-num    like ub.db.db-num no-undo.
      320     define variable v-today     as date    no-undo .
      321     define variable v-time      as integer no-undo .
      322     define variable v-host-code like ub.sysconf.host-code no-undo .
      323     define variable v-cli-qnty  as decimal no-undo .
      324     define variable v-sign      as decimal no-undo .
      325     define buffer buf_goods        for ub.goods .
      326     define buffer buf_doc-line     for ub.doc-line .
      327     define buffer buf_doc-pl       for ub.doc-pl .
      328     define buffer buf_c-pl-gds     for ub.c-pl-gds.
      329     define buffer buf_c-gds-hist   for ub.c-gds-hist.
      330     define buffer buf_c-plc-hist   for ub.c-plc-hist.
      331     define buffer buf_c-table-bind for ub.c-table-bind.
      332     buffer-compare new_pl-gds
      333       using PS
      334       gds-code
      335       max-qnty
      336       obj-code
      337       obj-type
      338       pl-code
      339       status_
      340       tolerance
      341       to old_pl-gds
      342       case-sensitive
      343       save result in v-l-ref.
      344     buffer-compare new_pl-gds
      345       using cli-qnty
      346       fact-qnty
      347       free-qnty
      348       cli-fact-qnty
      349       cli-free-qnty
      350       to old_pl-gds
      351       case-sensitive
      352       save result in v-l-rest.
      353   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      354   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      355     (input  new_pl-gds.obj-type
      356     ,input  new_pl-gds.obj-code
      357     ,output v-db-num
      358     ) no-error .
      359     if error-status :error then
      360     do:
      361       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      362         "Ошибка при определении БД объекта товара на складском месте" skip
      363         "объект" new_pl-gds.obj-type new_pl-gds.obj-code skip
      364         view-as alert-box error.
      365       undo main-block, return error.
      366     end.
      367     find first buf_goods no-lock
      368       where buf_goods.gds-code = new_pl-gds.gds-code
      369       .
      370     if v-l-ref <> true then
      371     do:
      372       if g#db-num <> v-db-num
      373         and g#news <> yes
      374         then
      375       do:
      376         message
      377           vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      378           "Нельзя изменять запись ТОВАРА НА СКЛАДСКОМ МЕСТЕ в БД, отличной от БД объекта" skip
      379           "Номер текущей БД " g#db-num skip
      380           "Номер БД объекта " v-db-num
      381           view-as alert-box error.
      382         undo, return error.
      383       end.
      384       run str/callnews.p
      385         ( input 'pl-gds':U
      386         ,input ( buffer new_pl-gds :handle )
      387         ).
      388     end.
      389     if v-l-rest <> true then
      390     do:
      391       if old_pl-gds.cli-free-qnty <> ?
      392         and new_pl-gds.cli-free-qnty = ?
      393         then
      394       do:
      395         undo, return error substitute( 'Ошибка в свободном количестве на месте хранения&1'
      396           + 'Товар &2&1'
      397           + 'Место хранения: &3 (&4 &5)&1'
      398           + 'Свободное кол-во: &7 (&6)&1'
      399           + 'Фактическое кол-во: &8 (&6)&1'
      400           ,chr(10)
      401           ,buf_goods.gds-code
      402           ,new_pl-gds.pl-code
      403           ,new_pl-gds.obj-type
      404           ,new_pl-gds.obj-code
      405           ,buf_goods.unit-cli
      406           ,new_pl-gds.cli-free-qnty
      407           ,new_pl-gds.cli-fact-qnty
      408           ).
      409       end.
      410       if new_pl-gds.free-qnty = new_pl-gds.fact-qnty
      411         and new_pl-gds.cli-free-qnty <> new_pl-gds.cli-fact-qnty
      412         then
      413       do:
      414         assign
      415           v-cli-qnty = 0.0
      416           .
      417         for each buf_doc-line no-lock
      418           where buf_doc-line.obj-type  = new_pl-gds.obj-type
      419           and buf_doc-line.obj-code  = new_pl-gds.obj-code
      420           and buf_doc-line.prod-type = buf_goods.prod-type
      421           and buf_doc-line.prod-code = buf_goods.prod-code
      422           and buf_doc-line.artic     = buf_goods.artic
      423           and buf_doc-line.status_   <> 'факт':U
      424           ,first buf_doc-pl no-lock
      425           where buf_doc-pl.obj-type = buf_doc-line.obj-type
      426           and buf_doc-pl.obj-code = buf_doc-line.obj-code
      427           and buf_doc-pl.pl-code  = new_pl-gds.pl-code
      428           and buf_doc-pl.out-code = buf_doc-line.doc-code
      429           and buf_doc-pl.gds-code = buf_goods.gds-code
      430           on error undo, return error return-value
      431           :
      432           if lookup( buf_doc-line.ext-doc-type, 'ie,iv,im,re,rs,rv,vt':U ) > 0 then
      433           do:
      434             next.
      435           end.
      436           if lookup( buf_doc-line.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U ) > 0 then
      437           do:
      438             assign
      439               v-sign = -1.0
      440               .
      441           end.
      442           else
      443           do:
      444             assign
      445               v-sign = 1.0
      446               .
      447             if lookup( buf_doc-line.ext-doc-type, 'ie,re,rs,vt,vp,ap,mp,pc,iv,rv,im,io':U ) = 0 then
      448             do:
      449               undo, return error substitute( '&1. Тип "&2" не внесен в списки документов уменьшающих(увеличивающих) остатки!', vss-workfile, buf_doc-line.ext-doc-type).
      450             end.
      451           end.
      452           if buf_doc-pl.doc-qnty = 0.0
      453             and buf_doc-pl.cli-doc-qnty <> 0.0
      454             then
      455           do:
      456             assign
      457               v-cli-qnty = v-cli-qnty + v-sign * buf_doc-pl.cli-doc-qnty
      458               .
      459           end.
      460         end.
      461         if new_pl-gds.cli-free-qnty <> new_pl-gds.cli-fact-qnty - v-cli-qnty then
      462         do:
      463           undo, return error substitute( 'Ошибка в свободном количестве на месте хранения&1'
      464             + 'Товар &2&1'
      465             + 'Место хранения: &3 (&4 &5)&1'
      466             + 'После документа: &7 (&6)&1'
      467             + 'Должно быть: &8 (&6)'
      468             ,chr(10)
      469             ,buf_goods.gds-code
      470             ,new_pl-gds.pl-code
      471             ,new_pl-gds.obj-type
      472             ,new_pl-gds.obj-code
      473             ,buf_goods.unit-cli
      474             ,new_pl-gds.cli-free-qnty
      475             ,new_pl-gds.cli-fact-qnty - v-cli-qnty
      476             ).
      477         end.
      478       end.
      479     end.
      480     if g#news <> true
      481       and v-l-ref <> true
      482       then
      483     do:
      484       run cur-time in this-procedure(output v-today, output v-time).
      485       create buf_c-pl-gds.
      486       buffer-copy old_pl-gds
      487         except
      488         obj-type
      489         obj-code
      490         gds-code
      491         pl-code
      492         to buf_c-pl-gds
      493         assign
      494         buf_c-pl-gds.gds-code           = new_pl-gds.gds-code
      495         buf_c-pl-gds.obj-type           = new_pl-gds.obj-type
      496         buf_c-pl-gds.obj-code           = new_pl-gds.obj-code
      497         buf_c-pl-gds.pl-code            = new_pl-gds.pl-code
      498         buf_c-pl-gds.chip-num           = next-value (s-plc-chip, ub)
      499         buf_c-pl-gds.corr-time          = v-time
      500         buf_c-pl-gds.corr-user-db-num   = g#db-num
      501         buf_c-pl-gds.corr-user-name     = g#userid
      502         buf_c-pl-gds.corr-date          = v-today
      503         .
      504       create buf_c-plc-hist.
      505       buffer-copy buf_c-pl-gds to buf_c-plc-hist
      506         assign
      507         buf_c-plc-hist.action = (if new new_pl-gds then integer('1':U) else integer('2':U))
      508         buf_c-plc-hist.subject = 'pl-gds':U
      509         buf_c-plc-hist.is-news = g#news
      510         .
      511   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      513     (input  new_pl-gds.obj-type
      514     ,input  new_pl-gds.obj-code
      515     ,output v-host-code
      516     )  .
      517       create buf_c-gds-hist.
      518       buffer-copy buf_c-pl-gds
      519         except chip-num
      520         to buf_c-gds-hist
      521         assign
      522         buf_c-gds-hist.action = (if new new_pl-gds then integer('1':U) else integer('2':U))
      523         buf_c-gds-hist.subject = 'pl-gds':U
      524         buf_c-gds-hist.host-code = v-host-code
      525         buf_c-gds-hist.is-news = g#news
      526         buf_c-gds-hist.chip-num =   next-value (s-gds-chip, ub)
      527         buf_c-gds-hist.source-type = (if g#news then 'db':U else "":U)
      528         buf_c-gds-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      529         .
      530       create buf_c-table-bind.
      531       assign
      532         buf_c-table-bind.chip-num-rec     = buf_c-gds-hist.chip-num
      533         buf_c-table-bind.chip-num-src     = buf_c-pl-gds.chip-num
      534         buf_c-table-bind.corr-user-db-num = buf_c-pl-gds.corr-user-db-num
      535         buf_c-table-bind.tbl-name-rec     = 'c-gds-hist':U
      536         buf_c-table-bind.tbl-name-src     = 'c-plc-hist':U
      537         buf_c-table-bind.is-news          = g#news
      538         buf_c-table-bind.corr-user-name   = g#userid
      539         buf_c-table-bind.subject          = 'pl-gds':U
      540         .
      541     end.
      542     if g#oxml = yes then
      543     do:
      544       run str/calloxml.p
      545         ( input 'update':U
      546         ,input 'pl-gds':U
      547         ,input ( buffer ub.pl-gds:handle )
      548         ) no-error.
      549       if error-status :error then
      550       do:
      551         undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      552           , chr(10)
      553           , vss-workfile
      554           , return-value
      555           , error-status :get-message ( 1 ) ).
      556       end.
      557     end.
      558     define variable v-is as logical no-undo .
      559     buffer-compare old_pl-gds to new_pl-gds
      560       case-sensitive save result in v-is .
      561     if  new new_pl-gds then v-is = yes .
      562     if v-is then
      563     do:
      564   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      565     (input ?
      566     ,input this-procedure:handle
      567     ,input ?
      568     ,input 'ref-event':U
      569     ,input  buffer old_pl-gds:handle
      570     ,input  buffer new_pl-gds:handle
      571     ,input ''
      572     ,input ''
      573     ) no-error .
      574       if error-status :error
      575         then
      576       do:
      577         return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
      578           , chr(10)
      579           , vss-workfile
      580           , return-value
      581           , error-status :get-message ( 1 ) ).
      582       end.
      583     end.
      584   end.
