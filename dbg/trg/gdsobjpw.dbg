        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.gds-obj-prop OLD old_gds-obj-prop.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись индикаторов товара на объекте".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   procedure factord :
      305     define input  parameter p-fact-date            as date    no-undo .
      306     define input  parameter p-fact-time            as integer no-undo .
      307     define input  parameter p-fact-num             as integer no-undo .
      308     define input  parameter p-shift-date           as date    no-undo .
      309     define input  parameter p-shift-num            as integer no-undo .
      310     define input  parameter p-shift-on             as logical no-undo .
      311     define output parameter p-fact-order           as decimal no-undo .
      312     define output parameter p-shift-end-fact-order as decimal no-undo .
      313     define output parameter p-day-end-fact-order   as decimal no-undo .
      314     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      315     if p-fact-date = ?
      316     then do:
      317       return error "Не указана фактическая дата" .
      318     end.
      319     define variable v-fact-date-num as integer no-undo .
      320     assign
      321       v-fact-date-num = integer(p-fact-date)
      322     .
      323     if p-fact-num = ?
      324     or p-fact-num = 0
      325     then do:
      326       return error "Не задан p-fact-num " + string(p-fact-num) .
      327     end.
      328     if p-fact-num < 0
      329     then do:
      330       return error "Отрицательный fact-num " + string(p-fact-num) .
      331     end.
      332     if p-fact-num >= 100000000
      333     then do:
      334       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      335     end.
      336     if p-shift-on = true
      337     then do:
      338       if p-shift-date = ?
      339       then do:
      340         return error "Не задана дата смены" .
      341       end.
      342       if p-shift-num = ?
      343       or p-shift-num = 0
      344       then do:
      345         return error "Не задан номер смены" .
      346       end.
      347     end.
      348     else do:
      349       assign
      350         p-shift-date = p-fact-date
      351         p-shift-num  = 24
      352       .
      353     end.
      354     define variable v-shift-offset as integer no-undo .
      355     if p-shift-date = p-fact-date
      356     then do:
      357       assign
      358         v-shift-offset = 1
      359       .
      360     end.
      361     if p-shift-date < p-fact-date
      362     then do:
      363       assign
      364         v-shift-offset = 0
      365       .
      366     end.
      367     if p-shift-date > p-fact-date
      368     then do:
      369       message
      370         vss-workfile vss-revision vss-description skip
      371         "Неправильная дата закрытия смены" skip
      372         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      373         view-as alert-box error .
      374       undo, return error
      375         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      376           ,string(p-fact-date, '99/99/9999':U)
      377           ,string(p-shift-date, '99/99/9999':U)
      378           )
      379       .
      380     end.
      381     if p-shift-num < 1
      382     or p-shift-num > 24
      383     then do:
      384       message
      385         vss-workfile vss-revision vss-description skip
      386         "Неправильный номер смены" skip
      387         "p-shift-num" p-shift-num skip
      388         view-as alert-box error .
      389       undo, return error return-value .
      390     end.
      391     assign
      392       p-fact-order           = v-fact-date-num
      393                              + v-shift-offset * 0.5
      394                              + p-shift-num    * 0.02 - 0.01
      395                              + p-fact-num     * 0.0000000001
      396       p-shift-end-fact-order = v-fact-date-num
      397                              + v-shift-offset * 0.5
      398                              + p-shift-num    * 0.02
      399       p-day-end-fact-order   = v-fact-date-num
      400                              + 0.99
      401     .
      402     if p-fact-order           <= v-fact-date-num
      403     or p-shift-end-fact-order <= v-fact-date-num
      404     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      405     or p-shift-end-fact-order >= p-day-end-fact-order
      406     then do:
      407       message
      408         vss-workfile vss-revision vss-description skip
      409         "Внутренняя ошибка при генерации фактического номера" skip
      410         "p-fact-date"            p-fact-date            skip
      411         "p-fact-time"            p-fact-time            skip
      412         "p-fact-num"             p-fact-num             skip
      413         "p-shift-date"           p-shift-date           skip
      414         "p-shift-num"            p-shift-num            skip
      415         "p-shift-on"             p-shift-on             skip
      416         "p-shift-end-fact-order" p-shift-end-fact-order skip
      417         "p-day-end-fact-order"   p-day-end-fact-order   skip
      418         "v-fact-date-num"        v-fact-date-num        skip
      419         view-as alert-box error .
      420       undo, return error return-value .
      421     end.
      422   end procedure.
      423   procedure day-begin-fact-order :
      424     define input  parameter p-fact-date            as date    no-undo .
      425     define output parameter p-day-begin-fact-order as decimal no-undo .
      426     do
      427     on error undo, return error return-value
      428     :
      429       if p-fact-date = ?
      430       then do:
      431         assign
      432           p-day-begin-fact-order = 0
      433         .
      434       end.
      435       else do:
      436         assign
      437           p-day-begin-fact-order = integer(p-fact-date)
      438         .
      439       end.
      440     end.
      441   end procedure.
      442   procedure factord-max-fact-order :
      443     define output parameter p-max-fact-order as decimal   no-undo .
      444     do
      445     on error undo, return error return-value
      446     :
      447       run day-begin-fact-order in this-procedure
      448         (input  date(1, 1, 5000)
      449         ,output p-max-fact-order
      450         ) .
      451     end.
      452   end procedure.
      453   procedure factord-cut-archive :
      454     define input  parameter p-obj-type             as character no-undo .
      455     define input  parameter p-obj-code             as integer   no-undo .
      456     define input  parameter p-fact-date            as date      no-undo .
      457     define output parameter p-shift-on             as logical   no-undo .
      458     define output parameter p-shift-date           as date      no-undo .
      459     define output parameter p-shift-num            as integer   no-undo .
      460     define output parameter p-day-end-fact-order   as decimal   no-undo .
      461     define output parameter p-shift-end-fact-order as decimal   no-undo .
      462     define variable v-fact-order as decimal   no-undo .
      463     define buffer buf_shift-obj for ub.shift-obj .
      464     do
      465     on error undo, return error return-value
      466     :
      467   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      468   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      469     (input  p-obj-type
      470     ,input  p-obj-code
      471     ,input  'shift-on=request'
      472     ,output p-shift-on
      473     ) no-error .
      474       if error-status :error
      475       then do:
      476         message
      477           vss-workfile vss-revision vss-description skip
      478           "Ошибка при определении атрибута объекта" skip
      479           "Объект" p-obj-type p-obj-code skip
      480           error-status :get-message(1) skip
      481           return-value skip
      482           view-as alert-box error .
      483         undo, return error return-value .
      484       end.
      485       if p-shift-on = false
      486       then do:
      487         assign
      488           p-shift-date               = ?
      489           p-shift-num                = 0
      490         .
      491       end.
      492       else do:
      493         find first buf_shift-obj share-lock
      494           where buf_shift-obj.obj-type   = p-obj-type
      495             and buf_shift-obj.obj-code   = p-obj-code
      496             and buf_shift-obj.shift-date > p-fact-date
      497           use-index pi
      498           no-error .
      499         if not available buf_shift-obj
      500         or buf_shift-obj.status_ <> 'зкр':U
      501         then do:
      502           message
      503             vss-workfile vss-revision vss-description skip
      504             "Невозможно вычислить последнюю смену" skip
      505             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      506             "Объект" p-obj-type p-obj-code skip
      507             "Дата" p-fact-date skip
      508             view-as alert-box error .
      509           undo, return error return-value .
      510         end.
      511         find last buf_shift-obj share-lock
      512           where buf_shift-obj.obj-type = p-obj-type
      513             and buf_shift-obj.obj-code = p-obj-code
      514             and buf_shift-obj.shift-date <= p-fact-date
      515           use-index pi
      516           no-error .
      517         if available buf_shift-obj
      518         then do:
      519           if  buf_shift-obj.status_ = 'зкр':U
      520           then do:
      521             assign
      522               p-shift-date = buf_shift-obj.shift-date
      523               p-shift-num  = buf_shift-obj.shift-num
      524             .
      525           end.
      526           else do:
      527             message
      528               vss-workfile vss-revision vss-description skip
      529               "Невозможно вычислить последнюю смену" skip
      530               "Статус смены отличен от статуса" 'зкр':U skip
      531               "Объект" p-obj-type p-obj-code skip
      532               "Дата" p-fact-date skip
      533               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      534               view-as alert-box error .
      535             undo, return error return-value .
      536           end.
      537         end.
      538         else do:
      539           assign
      540             p-shift-date = p-fact-date - 1
      541             p-shift-num  = 1
      542           .
      543         end.
      544       end.
      545       run factord in this-procedure
      546         (input  p-fact-date
      547         ,input  1
      548         ,input  1
      549         ,input  p-shift-date
      550         ,input  p-shift-num
      551         ,input  p-shift-on
      552         ,output v-fact-order
      553         ,output p-shift-end-fact-order
      554         ,output p-day-end-fact-order
      555         ) no-error .
      556       if error-status :error
      557       then do:
      558         message
      559           vss-workfile vss-revision vss-description skip
      560           "Ошибка при вызове процедуры factord"
      561           error-status :get-message(1) skip
      562           return-value skip
      563           view-as alert-box error .
      564         undo, return error return-value .
      565       end.
      566     end.
      567   end procedure.
      568   procedure factord-lock-shift :
      569     define input  parameter p-obj-type  as character no-undo .
      570     define input  parameter p-obj-code  as integer   no-undo .
      571     define input  parameter p-fact-date as date      no-undo .
      572     define parameter buffer buf_shift-obj for ub.shift-obj .
      573     define variable v-shift-on      as logical   no-undo .
      574     define variable v-extra-message as character no-undo .
      575     define variable v-error as character no-undo .
      576     do
      577     on error undo, return error return-value
      578     :
      579   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      581     (input  p-obj-type
      582     ,input  p-obj-code
      583     ,input  'shift-on=request'
      584     ,output v-shift-on
      585     ) no-error .
      586       if error-status :error
      587       then do:
      588         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      589         undo, return error v-error .
      590       end.
      591       if v-shift-on = true
      592       then do:
      593         find first buf_shift-obj share-lock
      594           where buf_shift-obj.obj-type   = p-obj-type
      595             and buf_shift-obj.obj-code   = p-obj-code
      596             and buf_shift-obj.shift-date > p-fact-date
      597           use-index pi
      598           no-error .
      599         if not available buf_shift-obj
      600         or buf_shift-obj.status_ <> 'зкр':U
      601         then do:
      602           find last buf_shift-obj
      603             where buf_shift-obj.obj-type = p-obj-type
      604               and buf_shift-obj.obj-code = p-obj-code
      605               and buf_shift-obj.status_  = 'зкр':U
      606             use-index stts
      607             no-error .
      608           if available buf_shift-obj
      609           then do:
      610             assign
      611               v-extra-message =
      612                     substitute("Дата начала последеней закрытой смены на объекте &1"
      613                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      614                               )
      615             .
      616           end.
      617           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      618           undo, return error v-error .
      619         end.
      620       end.
      621     end.
      622   end procedure.
      623   procedure factord-end-day :
      624     define input  parameter p-fact-date            as date    no-undo .
      625     define output parameter p-day-end-fact-order   as decimal no-undo .
      626     do
      627     on error undo, return error return-value
      628     :
      629       if p-fact-date = ?
      630       then do:
      631         return error "Не указана фактическая дата" .
      632       end.
      633       assign
      634         p-day-end-fact-order = integer(p-fact-date) + 0.99
      635       .
      636     end.
      637   end procedure.
      638   procedure factord-to-date :
      639     define input  parameter p-fact-order as decimal no-undo .
      640     define output parameter p-fact-date  as date    no-undo .
      641     define variable v-ref-date  as date      no-undo .
      642     define variable v-ref-delta as integer   no-undo .
      643     do
      644     on error undo, return error return-value
      645     :
      646       if p-fact-order = ?
      647       or p-fact-order = 0
      648       then do:
      649         return error "Не указан fact-order" .
      650       end.
      651       assign
      652         v-ref-date  = date(1, 1, 2000)
      653       .
      654       assign
      655         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      656       .
      657       assign
      658         p-fact-date = v-ref-date + v-ref-delta
      659       .
      660     end.
      661   end procedure.
      662   procedure factord-to-fact-num :
      663     define input  parameter p-fact-order as decimal no-undo .
      664     define output parameter p-fact-num   as integer no-undo .
      665     define variable v-fact-order-trunc as decimal no-undo .
      666     do
      667     on error undo, return error return-value
      668     :
      669       if p-fact-order = ?
      670       or p-fact-order = 0
      671       then do:
      672         return error "Не указан fact-order" .
      673       end.
      674       assign
      675        v-fact-order-trunc = truncate(p-fact-order, 2)
      676       .
      677       assign
      678         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      679       .
      680     end.
      681   end procedure.
      682   procedure factord-to-shift-num :
      683     define input  parameter p-fact-order as decimal no-undo .
      684     define output parameter p-shift-num   as integer no-undo .
      685     define variable  p-shift-numd  as decimal   no-undo .
      686     define variable v-fact-order-trunc as decimal no-undo .
      687     do
      688     on error undo, return error return-value
      689     :
      690       if p-fact-order = ?
      691       or p-fact-order = 0
      692       then do:
      693         return error "Не указан fact-order" .
      694       end.
      695       assign
      696        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      697       .
      698       if v-fact-order-trunc < 0.5 then do:
      699         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      700       end.
      701       assign
      702         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      703         .
      704        assign
      705         p-shift-num = truncate (p-shift-numd , 0)
      706       .
      707     end.
      708   end procedure.
      709   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      710   define new global shared variable g#lib-nws as handle no-undo .
      711   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712   procedure ass-grp-gds-code-yes :
      713   define input  parameter p-gds-code   as integer   no-undo .
      714   define input  parameter p-node-code  as integer   no-undo .
      715   define input  parameter p-id         as integer   no-undo .
      716   define input  parameter p-db-num     as integer   no-undo .
      717   define output parameter p-ask        as logical   no-undo .
      718   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      719   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      720   define buffer buf_goods   for ub.goods  .
      721   define buffer buf_gds-grp for ub.gds-grp  .
      722   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
      723   define variable v-grp-qnty as integer   no-undo .
      724   define variable v-grp-lim as integer   no-undo .
      725     do
      726     on error undo, return error return-value
      727     :
      728   p-ask = ? .
      729   find first  ub.assortment-matrix no-lock where
      730               ub.assortment-matrix.asmt-id  = p-id and
      731               ub.assortment-matrix.db-num   = p-db-num and
      732               ub.assortment-matrix.asmt-type =  'Шаблон':U
      733               no-error .
      734   if available ub.assortment-matrix then do:
      735     p-ask = true .
      736     return .
      737   end.
      738   find first buf_gds-obj-prop no-lock where
      739             buf_gds-obj-prop.gds-code = p-gds-code and
      740             buf_gds-obj-prop.obj-type = ub.assortment-matrix.obj-type and
      741             buf_gds-obj-prop.obj-code = ub.assortment-matrix.obj-code and
      742             buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U no-error .
      743   if available buf_gds-obj-prop then do:
      744     p-ask = true .
      745     return .
      746   end.
      747   find first buf_goods no-lock where buf_goods.gds-code = p-gds-code .
      748   find first buf_gds-grp-obj-attr no-lock where
      749              buf_gds-grp-obj-attr.attr-code = 'LimAssMat':U and
      750              buf_gds-grp-obj-attr.obj-type  = string(p-id) and
      751              buf_gds-grp-obj-attr.obj-code  = p-db-num and
      752              buf_gds-grp-obj-attr.host-code = 0 and
      753              buf_gds-grp-obj-attr.node-code = p-node-code no-error .
      754   if error-status :error then do:
      755     p-ask = true .
      756     return .
      757   end.
      758   if buf_gds-grp-obj-attr.attr-value  = "0" then do:
      759     p-ask = false  .
      760     return .
      761   end.
      762     if buf_gds-grp-obj-attr.attr-value  = "" or
      763       buf_gds-grp-obj-attr.attr-value  = ?  or
      764       buf_gds-grp-obj-attr.attr-value  = "?" then do:
      765       find first buf_gds-grp no-lock where
      766                   buf_gds-grp.node-code = p-node-code no-error .
      767         if available buf_gds-grp  then do:
      768             if buf_gds-grp.upper-code = 0 then do:
      769                 p-ask = true .
      770                 return .
      771             end.
      772             else do:
      773                 run ass-grp-gds-code-yes (
      774                    input   p-gds-code
      775                   ,input   buf_gds-grp.upper-code
      776                   ,input   p-id
      777                   ,input   p-db-num
      778                   ,output  p-ask
      779                   ).
      780                 if p-ask <> ? then return .
      781           end.
      782         end.
      783     end.
      784     else do:
      785       v-grp-lim = int (buf_gds-grp-obj-attr.attr-value) no-error  .
      786       if v-grp-lim > 0 then do:
      787           v-grp-qnty = 0 .
      788           find first buf1_gds-grp-obj-attr no-lock where
      789                      buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
      790                      buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
      791                      buf1_gds-grp-obj-attr.obj-code  = p-db-num and
      792                      buf1_gds-grp-obj-attr.host-code = 0 and
      793                      buf1_gds-grp-obj-attr.node-code = p-node-code no-error .
      794           if available buf1_gds-grp-obj-attr then do:
      795             v-grp-qnty = int(buf1_gds-grp-obj-attr.attr-value) .
      796           end.
      797           if v-grp-lim >= v-grp-qnty + 1 then p-ask = true .
      798           else p-ask = false .
      799           return .
      800       end.
      801     end.
      802     end.
      803   end procedure.
      804   procedure recalc-gds-assgrp :
      805   define input  parameter p-action     as character no-undo .
      806   define input  parameter p-gds-code  as integer   no-undo .
      807   define input  parameter p-node-code  as integer   no-undo .
      808   define input  parameter p-id         as integer   no-undo .
      809   define input  parameter p-db-num     as integer   no-undo .
      810   define buffer buf_gds-grp for ub.gds-grp  .
      811   define buffer curr_gds-grp for ub.gds-grp  .
      812   define buffer buf1_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      813   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
      814   define variable kk as character no-undo .
      815     do
      816     on error undo, return error return-value
      817     :
      818   find first  ub.assortment-matrix no-lock where
      819               ub.assortment-matrix.asmt-id  = p-id and
      820               ub.assortment-matrix.db-num   = p-db-num and
      821               ub.assortment-matrix.asmt-type =  'Шаблон':U
      822               no-error .
      823       if available ub.assortment-matrix then do:
      824         return .
      825       end.
      826       find first buf_gds-obj-prop no-lock where
      827                  buf_gds-obj-prop.gds-code = p-gds-code and
      828                  buf_gds-obj-prop.obj-type = ub.assortment-matrix.obj-type and
      829                  buf_gds-obj-prop.obj-code = ub.assortment-matrix.obj-code and
      830                  buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U
      831                  no-error .
      832       if available buf_gds-obj-prop then do:
      833         if p-action <> '--' then  do:
      834            return .
      835         end.
      836       end.
      837       find first buf1_gds-grp-obj-attr exclusive-lock where
      838                  buf1_gds-grp-obj-attr.attr-code = 'QntyAssMat':U and
      839                  buf1_gds-grp-obj-attr.obj-type  = string(p-id) and
      840                  buf1_gds-grp-obj-attr.obj-code  = p-db-num and
      841                  buf1_gds-grp-obj-attr.host-code = 0 and
      842                  buf1_gds-grp-obj-attr.node-code = p-node-code
      843                  no-error .
      844       if available buf1_gds-grp-obj-attr then do:
      845          if p-action = '+' then  do:
      846             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) + 1 ).
      847          end.
      848          else do:
      849             kk = string( int( buf1_gds-grp-obj-attr.attr-value ) - 1 ).
      850          end.
      851          buf1_gds-grp-obj-attr.attr-value = kk .
      852       end.
      853       else do:
      854           if p-action = '+' then  do:
      855               create buf1_gds-grp-obj-attr .
      856                 assign
      857                   buf1_gds-grp-obj-attr.attr-code  = 'QntyAssMat':U
      858                   buf1_gds-grp-obj-attr.obj-type   = string(p-id)
      859                   buf1_gds-grp-obj-attr.obj-code   = p-db-num
      860                   buf1_gds-grp-obj-attr.host-code  = 0
      861                   buf1_gds-grp-obj-attr.node-code  = p-node-code
      862                   buf1_gds-grp-obj-attr.attr-value = "1"
      863                 .
      864           end.
      865       end.
      866      FIND FIRST curr_gds-grp WHERE
      867                 curr_gds-grp.node-code = p-node-code
      868           NO-LOCK NO-ERROR.
      869      if AVAILABLE curr_gds-grp AND curr_gds-grp.upper-code > 0 then do:
      870         run recalc-gds-assgrp (p-action ,p-gds-code , curr_gds-grp.upper-code,p-id,p-db-num ) .
      871      end.
      872     end.
      873   end procedure.
      874   define buffer buf_c-gds-obj-prop for c-gds-obj-prop.
      875   define buffer buf_c-gds-hist     for ub.c-gds-hist.
      876   define buffer buf_assortment-matrix for ub.assortment-matrix  .
      877   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
      878   define variable v-date as date no-undo .
      879   define variable v-time as integer no-undo .
      880   define variable v-host-code as integer no-undo .
      881   main-block :
      882   do transaction
      883   on error undo main-block, return error
      884   :
      885       run cur-time in this-procedure(output v-date, output v-time).
      886   if g#news = false then do:
      887       assign
      888         ub.gds-obj-prop.grop-date-update     = v-date
      889         ub.gds-obj-prop.grop-time-update     = v-time
      890         ub.gds-obj-prop.grop-db-num-update   = g#db-num
      891         ub.gds-obj-prop.grop-who-update      = g#userid
      892       .
      893      if ub.gds-obj-prop.gdop-igt = "" or ub.gds-obj-prop.gdop-igt = ? then do:
      894         assign
      895           ub.gds-obj-prop.gdop-igt = 'Пусто':U
      896           .
      897      end.
      898       if old_gds-obj-prop.gdop-assort-min <> ub.gds-obj-prop.gdop-assort-min and old_gds-obj-prop.gdop-assort-min = false then do:
      899         find first buf_assortment-matrix no-lock where
      900                     buf_assortment-matrix.asmt-status = 0 and
      901                     buf_assortment-matrix.obj-code = ub.gds-obj-prop.obj-code and
      902                     buf_assortment-matrix.obj-type = ub.gds-obj-prop.obj-type no-error .
      903         if available buf_assortment-matrix then do:
      904             find first buf_assortment-matrix-goods no-lock where
      905                         buf_assortment-matrix-goods.asmg-status = 0 and
      906                         buf_assortment-matrix-goods.gds-code = ub.gds-obj-prop.gds-code and
      907                         buf_assortment-matrix-goods.asmt-id  = buf_assortment-matrix.asmt-id and
      908                         buf_assortment-matrix-goods.db-num   = buf_assortment-matrix.db-num no-error .
      909              if not available buf_assortment-matrix-goods  then do:
      910                 message  substitute("Товар &1 не включен в ассортиментную матрицу &2 " ,
      911                 ub.gds-obj-prop.gds-code ,
      912                 buf_assortment-matrix.asmt-name
      913                 ) view-as alert-box error .
      914                  return error "Добавлять этот товар в Amin нельзя !".
      915              end.
      916       end.
      917      end.
      918   end.
      919     if g#news then do:
      920       define variable v-send as integer no-undo .
      921       v-send = integer('0':U).
      922   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      924     (input  g#db-num
      925     ,input  'gds-obj-prop':U
      926     ,input  0
      927     ,input  '':U
      928     ,input  0
      929     ,input  '':U
      930     ,input  '':U
      931     ,input  '':U
      932     ,input  0
      933     ,input  0
      934     ,input  0
      935     ,input  'nws-to-hist'
      936     ,output v-send
      937     ) no-error .
      938     end.
      939     if not g#news
      940     or v-send >= 0 then do:
      941       run cur-time in this-procedure(output v-date, output v-time).
      942       create buf_c-gds-obj-prop.
      943       buffer-copy old_gds-obj-prop to buf_c-gds-obj-prop
      944       assign
      945       buf_c-gds-obj-prop.gds-code         = ub.gds-obj-prop.gds-code
      946       buf_c-gds-obj-prop.obj-type         = ub.gds-obj-prop.obj-type
      947       buf_c-gds-obj-prop.obj-code         = ub.gds-obj-prop.obj-code
      948       buf_c-gds-obj-prop.chip-num         = next-value (s-gds-chip , ub)
      949       buf_c-gds-obj-prop.gdop-date-his    = v-date
      950       buf_c-gds-obj-prop.gdop-time-his    = v-time
      951       buf_c-gds-obj-prop.corr-user-db-num = g#db-num
      952       buf_c-gds-obj-prop.corr-user-name     = (if g#news
      953                                         then (chr(4) +  'СПН':U)
      954                                         else (if g#esys
      955                                               then (chr(4) +  'ВС':U)
      956                                               else g#userid)
      957                                         )
      958       .
      959       if ub.gds-obj-prop.obj-type <> 'орг':U then do:
      960   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      961   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      962     (input  ub.gds-obj-prop.obj-type
      963     ,input  ub.gds-obj-prop.obj-code
      964     ,output v-host-code
      965     )  .
      966       end.
      967       else do:
      968           v-host-code = ub.gds-obj-prop.obj-code .
      969       end.
      970       create buf_c-gds-hist.
      971       buffer-copy buf_c-gds-obj-prop to buf_c-gds-hist
      972       assign
      973       buf_c-gds-hist.action = (if new ub.gds-obj-prop then integer('1':U) else integer('2':U))
      974       buf_c-gds-hist.subject = 'gds-obj-prop':U
      975       buf_c-gds-hist.is-news = g#news
      976       buf_c-gds-hist.source-type = (if g#news
      977                                     then 'db':U
      978                                     else (if g#esys
      979                                           then 'esys':U
      980                                           else "":U)
      981                                     )
      982       buf_c-gds-hist.source-ref = (if g#news
      983                                     then string(g#news-source-db)
      984                                     else (if g#esys
      985                                           then string(g#esys-source-esys)
      986                                           else "":U)
      987                                     )
      988       buf_c-gds-hist.corr-date         = buf_c-gds-obj-prop.gdop-date-his
      989       buf_c-gds-hist.corr-time         = buf_c-gds-obj-prop.gdop-time-his
      990       buf_c-gds-hist.corr-user-db-num  = buf_c-gds-obj-prop.corr-user-db-num
      991       buf_c-gds-hist.corr-user-name    = buf_c-gds-obj-prop.corr-user-name
      992       buf_c-gds-hist.host-code         = v-host-code
      993       .
      994     end.
      995   if  true then do:
      996     run str/callnews.p
      997       (input 'gds-obj-prop':U
      998       ,input (buffer ub.gds-obj-prop:handle)
      999       ) no-error .
     1000     if error-status:error then do:
     1001        message
     1002         vss-workfile vss-revision vss-description skip
     1003         "Ошибка при передаче в новости" skip
     1004         return-value skip
     1005         view-as alert-box error .
     1006         return error.
     1007     end.
     1008   end.
     1009   define buffer buf_goods for ub.goods  .
     1010   define buffer del_assortment-matrix-goods for ub.assortment-matrix-goods  .
     1011   find first buf_goods no-lock where buf_goods.gds-code = ub.gds-obj-prop.gds-code no-error .
     1012   find first buf_assortment-matrix no-lock where
     1013              buf_assortment-matrix.obj-type    = ub.gds-obj-prop.obj-type and
     1014              buf_assortment-matrix.obj-code    = ub.gds-obj-prop.obj-code and
     1015              buf_assortment-matrix.asmt-status = 0 and
     1016              buf_assortment-matrix.asmt-type   = 'Объект':U
     1017              no-error .
     1018   find first buf_assortment-matrix-goods no-lock where
     1019              buf_assortment-matrix-goods.asmg-status = 0 and
     1020              buf_assortment-matrix-goods.gds-code    = ub.gds-obj-prop.gds-code and
     1021              buf_assortment-matrix-goods.asmt-id     = buf_assortment-matrix.asmt-id and
     1022              buf_assortment-matrix-goods.db-num      = buf_assortment-matrix.db-num
     1023              no-error .
     1024   find first del_assortment-matrix-goods no-lock where
     1025              del_assortment-matrix-goods.asmg-status = 1 and
     1026              del_assortment-matrix-goods.gds-code    = ub.gds-obj-prop.gds-code and
     1027              del_assortment-matrix-goods.asmt-id     = buf_assortment-matrix.asmt-id and
     1028              del_assortment-matrix-goods.db-num      = buf_assortment-matrix.db-num
     1029              no-error .
     1030   if (new(ub.gds-obj-prop) AND ub.gds-obj-prop.gdop-igt = 'Новинка':U) OR
     1031      (old_gds-obj-prop.gdop-igt <> ub.gds-obj-prop.gdop-igt)
     1032      THEN DO:
     1033      run make-attr-iztdel(ub.gds-obj-prop.gds-code , ub.gds-obj-prop.obj-type, ub.gds-obj-prop.obj-code) .
     1034      if available buf_assortment-matrix-goods then do:
     1035         run recalc-gds-assgrp
     1036           (
     1037             input  '--'  ,
     1038             input  buf_goods.gds-code  ,
     1039             input  buf_goods.grp-code  ,
     1040             input  buf_assortment-matrix.asmt-id ,
     1041             input  buf_assortment-matrix.db-num  )
     1042             no-error .
     1043       end.
     1044   end.
     1045     if g#oxml = yes
     1046     then do:
     1047       run str/calloxml.p (
     1048             input 'update':U
     1049           , input 'gds-obj-prop':U
     1050           , input ( buffer ub.gds-obj-prop:handle )
     1051       ) no-error.
     1052       if error-status :error
     1053       then do:
     1054           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1055                                , chr(10)
     1056                                , vss-workfile
     1057                                , return-value
     1058                                , error-status :get-message ( 1 ) ).
     1059       end.
     1060     end.
     1061   end.
     1062   procedure make-h :
     1063     do
     1064     on error undo, return error return-value
     1065     :
     1066         if error-status :error then
     1067            message
     1068             vss-workfile vss-revision vss-description skip
     1069             error-status :get-message(1) skip
     1070             "Ошибка создания истории товара"
     1071             view-as alert-box error .
     1072     end.
     1073   end procedure.
     1074   procedure make-attr-iztdel :
     1075   define input  parameter p-gds-code as integer   no-undo .
     1076   define input  parameter p-obj-type as character no-undo .
     1077   define input  parameter p-obj-code as integer   no-undo .
     1078   define buffer x-gds-obj-prop-attr for ub.gds-obj-prop-attr  .
     1079     do
     1080     on error undo, return error return-value
     1081     :
     1082      find first x-gds-obj-prop-attr no-lock WHERE
     1083                 x-gds-obj-prop-attr.gds-code = p-gds-code AND
     1084                 x-gds-obj-prop-attr.obj-code = p-obj-code AND
     1085                 x-gds-obj-prop-attr.obj-type = p-obj-type and
     1086                 x-gds-obj-prop-attr.attr-code = 'CorrIztDel':U no-error .
     1087      if not available x-gds-obj-prop-attr then do:
     1088         create  x-gds-obj-prop-attr .
     1089         assign
     1090           x-gds-obj-prop-attr.gds-code = p-gds-code
     1091           x-gds-obj-prop-attr.obj-code = p-obj-code
     1092           x-gds-obj-prop-attr.obj-type = p-obj-type
     1093           x-gds-obj-prop-attr.attr-code = 'CorrIztDel':U
     1094           x-gds-obj-prop-attr.attr-value = string(today, "99/99/9999" )
     1095         .
     1096      end.
     1097      else do:
     1098         find first x-gds-obj-prop-attr exclusive-lock WHERE
     1099                     x-gds-obj-prop-attr.gds-code = p-gds-code AND
     1100                     x-gds-obj-prop-attr.obj-code = p-obj-code AND
     1101                     x-gds-obj-prop-attr.obj-type = p-obj-type and
     1102                     x-gds-obj-prop-attr.attr-code = 'CorrIztDel':U no-error .
     1103         assign
     1104           x-gds-obj-prop-attr.attr-value = string(today, "99/99/9999" )
     1105         .
     1106      end.
     1107     end.
     1108   end procedure.
