        1   block-level on error undo, throw.
        2   trigger procedure for write of ub.db old buffer old-db.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись базы данных".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   Function reverse returns character (str as character).
       80      define variable rev_incl_s as character init "" no-undo .
       81      define variable rev_incl_i as integer no-undo .
       82      define variable rev_incl_l as integer no-undo .
       83      rev_incl_l = length(str).
       84      do rev_incl_i = 1 to rev_incl_l:
       85         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
       86      end.
       87      return rev_incl_s.
       88   end.
       89   procedure check-enc.
       90     define input  parameter p-db-num    as integer   no-undo .
       91     define input  parameter p-db-key    as character no-undo .
       92     define input  parameter p-code      as character no-undo .
       93     define input  parameter p-value     as character no-undo .
       94     define input  parameter p-beg-date  as date      no-undo .
       95     define input  parameter p-end-date  as date      no-undo .
       96     define input  parameter p-enc-value as character no-undo .
       97     define output parameter p-answer    as logical   no-undo .
       98     define variable tmp         as character no-undo .
       99     define variable v-enc-value as character no-undo .
      100     if p-db-num <> 0
      101       and p-db-key = "":U
      102     then do:
      103       assign
      104         p-answer = true
      105       .
      106       return.
      107     end.
      108     if p-db-key = "unload-db":U then do:
      109       assign
      110         p-answer = true
      111       .
      112       return.
      113     end.
      114     if p-code = ""  then do:
      115       assign
      116         tmp = string( p-db-num ) + reverse (p-db-key).
      117       .
      118     end.
      119     else do:
      120       assign
      121         tmp = string( p-db-num )
      122               + trim( p-db-key )
      123               + reverse( trim( p-code ) )
      124               + reverse( trim( p-value ) )
      125               + reverse( string( p-beg-date, "99.99.9999" ) )
      126               + reverse( string( p-end-date, "99.99.9999" ) )
      127       .
      128     end.
      129     run pswd-enc in this-procedure
      130       ( input tmp
      131        ,output v-enc-value
      132       ) no-error .
      133     if error-status:error then do:
      134       message
      135         vss-workfile vss-revision vss-description skip
      136         "Ошибка при вызове процедуры pswd-enc" skip
      137         return-value skip
      138         error-status :get-message(1) skip
      139         view-as alert-box error .
      140       undo, return error .
      141     end.
      142     if v-enc-value = p-enc-value then do:
      143       assign
      144         p-answer = true
      145       .
      146     end.
      147     else do:
      148       assign
      149         p-answer = false
      150       .
      151     end.
      152   end.
      153   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   procedure pswd-enc :
      155     define input parameter  pswd     as character no-undo .
      156     define output parameter enc-pswd as character no-undo .
      157     do
      158     on error undo, return error return-value
      159     :
      160       assign
      161         enc-pswd = encode(pswd + string(index(pswd, "k")))
      162       .
      163     end.
      164   end procedure.
      165   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   procedure cur-time :
      167      define output parameter p-today as date      no-undo .
      168      define output parameter p-time  as integer   no-undo .
      169     do
      170     on error undo, return error
      171     :
      172       define variable v-date1 as date      no-undo .
      173       define variable v-date2 as date      no-undo .
      174       define variable v-time  as integer   no-undo .
      175       assign
      176         v-date1 = today
      177         v-time  = time
      178         v-date2 = today
      179       .
      180       if v-date1 <> v-date2
      181       then do:
      182         assign
      183           v-date1 = today
      184           v-time  = v-time
      185         .
      186       end.
      187       assign
      188         p-today = v-date1
      189         p-time  = v-time
      190       .
      191     end.
      192   end.
      193   function cur-time-date returns character
      194   :
      195     return string(today, '99/99/9999':U) .
      196   end.
      197   function cur-time-mjd returns decimal
      198   :
      199     define variable v-date as date      no-undo .
      200     define variable v-time as integer   no-undo .
      201     run cur-time in this-procedure
      202       (output v-date
      203       ,output v-time
      204       ) .
      205     return integer(v-date) - 2400002 + (v-time / 86400) .
      206   end.
      207   function cur-time-get-ending-index returns integer
      208   (input p-number as integer
      209   )
      210   :
      211     if p-number < 0
      212     or p-number = ?
      213     then do:
      214       return 1 .
      215     end.
      216     define variable v-rest as integer   no-undo .
      217     assign
      218       p-number = p-number modulo 100
      219     .
      220     if p-number < 20
      221     then do:
      222       assign
      223         v-rest = p-number
      224       .
      225     end.
      226     else do:
      227       assign
      228         v-rest = p-number modulo 10
      229       .
      230     end.
      231     case v-rest :
      232       when 1
      233       then do:
      234         return 2 .
      235       end.
      236       when 2 or
      237       when 3 or
      238       when 4
      239       then do:
      240         return 3 .
      241       end.
      242       otherwise do:
      243         return 1 .
      244       end.
      245     end case .
      246   end.
      247   procedure cur-time-mjd-to-date :
      248      define input  parameter i-mjd-diff as decimal no-undo.
      249      define output parameter o-Date     as date    no-undo.
      250      define output parameter o-Time     as integer no-undo.
      251      define variable v-day-number as integer   no-undo .
      252      if    i-mjd-diff < 0
      253         or i-mjd-diff = ?
      254      then do:
      255         return "?" .
      256      end.
      257      assign
      258         v-day-number = truncate(i-mjd-diff,0).
      259         o-Date = date(v-day-number + 2400002).
      260         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      261     .
      262   end.
      263   function cur-time-mjd-to-string returns character
      264   (input p-mjd-diff as decimal
      265   )
      266   :
      267     define variable v-day-number as integer   no-undo .
      268     define variable v-seconds    as integer   no-undo .
      269     define variable v-hour       as integer   no-undo .
      270     define variable v-min        as integer   no-undo .
      271     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      272     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      273     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      274     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      275     if p-mjd-diff < 0
      276     or p-mjd-diff = ?
      277     then do:
      278       return "?" .
      279     end.
      280     assign
      281       v-day-number = integer(truncate(p-mjd-diff,0))
      282       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      283     .
      284     if v-seconds > 86400
      285     then do:
      286       assign
      287         v-seconds = 86400 - 1
      288       .
      289     end.
      290     if v-seconds < 0
      291     then do:
      292       assign
      293         v-seconds = 0
      294       .
      295     end.
      296     assign
      297       v-hour = truncate(v-seconds / 3600, 0)
      298     .
      299     assign
      300       v-seconds = v-seconds modulo 3600
      301     .
      302     assign
      303       v-min = truncate(v-seconds / 60, 0)
      304     .
      305     assign
      306       v-seconds = v-seconds modulo 60
      307     .
      308     return
      309         (if v-day-number <> 0
      310           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      311           else ""
      312         )
      313       + (if v-day-number <> 0 or v-hour <> 0
      314           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      315           else ""
      316         )
      317       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      318           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      319           else ""
      320         )
      321       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      322       .
      323   end.
      324   function cur-time-string returns character
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      333   end.
      334   function cur-time-string-sec returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      343   end.
      344   function cur-time-custom  returns character
      345   (input p-prefix as character
      346   ,input p-date-format as character
      347   ,input p-delimiter as character
      348   ,input p-time-format as character
      349   ,input p-suffix as character
      350   )
      351   :
      352     define variable v-date as date      no-undo .
      353     define variable v-time as integer   no-undo .
      354     run cur-time in this-procedure
      355       (output v-date
      356       ,output v-time
      357       ) .
      358     return
      359       p-prefix
      360       + string(v-date, p-date-format)
      361       + p-delimiter
      362       + string(v-time, p-time-format)
      363       + p-suffix
      364       .
      365   end.
      366   function cur-time-print  returns character
      367   :
      368     define variable v-date as date      no-undo .
      369     define variable v-time as integer   no-undo .
      370     run cur-time in this-procedure
      371       (output v-date
      372       ,output v-time
      373       ) .
      374     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      375   end.
      376   function cur-time-datetime returns datetime
      377   :
      378     define variable v-char as character no-undo .
      379     define variable v-datetime as datetime no-undo .
      380     v-char = cur-time-string().
      381     v-datetime = datetime(v-char).
      382     return  v-datetime.
      383   end.
      384   function cur-time-string-msec returns character
      385   :
      386     define variable v-date as datetime  no-undo .
      387     v-date = now.
      388     return string(v-date) .
      389   end.
      390   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   define variable v-waitfram-action01         as character   no-undo .
      392   define variable v-waitfram-action02         as character   no-undo .
      393   define variable v-waitfram-action03         as character   no-undo .
      394   define variable mWaitFramTextBeg            as character   no-undo.
      395   define variable mWaitFramTextEnd            as character   no-undo.
      396   define variable mWaitFramView               as logical     no-undo.
      397   define variable mWaitProcEvent              as logical     no-undo init yes.
      398   define variable mWaitFramInterval           as integer     no-undo init 1 .
      399   define variable mWaitFramStop               as logical     no-undo.
      400   define variable mWaitFramStopUser           as logical     no-undo.
      401   define variable mWaitFramStopTimeOut        as logical     no-undo.
      402   define variable mWaitFramStartProc          as datetime-tz no-undo.
      403   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      404   define button B-WaitFramStop auto-end-key
      405        label "Стоп"
      406        size 10 by 1 tooltip "Остоновить процесс".
      407   define button B-viewProcInfo
      408        label "Информация"
      409        size 15 by 1 tooltip "Информация о процесс".
      410   define frame waitfram
      411     v-waitfram-action01 format "x(72)" no-label skip
      412     v-waitfram-action02 format "x(72)" no-label skip
      413     v-waitfram-action03 format "x(72)" no-label skip
      414     B-viewProcInfo
      415     B-WaitFramStop at row 4 col 30
      416     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      417     .
      418   define new global shared variable mBatchMode as logical no-undo init ?.
      419   define variable mFramBachModHandle as handle no-undo.
      420   mFramBachModHandle = frame waitfram:handle.
      421   define variable mFameOldVis as logical no-undo.
      422   define variable mVisCUrentVin as logical no-undo.
      423   if session:batch-mode
      424   then
      425      mBatchMode = yes.
      426   if mBatchMode = ? then do:
      427     mVisCUrentVin = current-window:visible.
      428     mFameOldVis = mFramBachModHandle:visible.
      429     mFramBachModHandle:visible  = yes.
      430     mBatchMode = mFramBachModHandle:visible ne yes.
      431     mFramBachModHandle:visible = mFameOldVis.
      432     current-window:visible = mVisCUrentVin.
      433   end.
      434    if  log-manager:logfile-name ne ?
      435     then DO:
      436         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      437         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      438         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      439     end.
      440   on choose of B-WaitFramStop in frame waitfram
      441   do:
      442     mWaitFramStop = yes.
      443     mWaitFramStopUser = yes.
      444   end.
      445   function waitfram-check-timeout returns logical():
      446      define variable vtime as int64 no-undo.
      447      if mWaitFramStopTimeOut
      448      then
      449         return yes.
      450      vtime = ( now - mWaitFramStartProc ) / 1000 .
      451      if     mWaitFramTimeOut ne ?
      452         and mWaitFramTimeOut ne 0
      453         and mWaitFramTimeOut lt vtime
      454      then do:
      455         mWaitFramStopTimeOut = yes.
      456      end.
      457      return mWaitFramStopTimeOut.
      458   end.
      459   procedure waitfram-hide :
      460     if not session:batch-mode
      461     then do
      462     on error undo, return error return-value
      463     :
      464       pause 0 before-hide .
      465       if not mBatchMode then
      466         hide frame waitfram .
      467     if     not mWaitFramView
      468        and mWaitProcEvent
      469     then
      470       process events .
      471     end.
      472   end procedure.
      473   procedure waitfram-show :
      474     define input  parameter p-message as character no-undo .
      475     define variable v-left-margin as integer   no-undo .
      476     if not session:batch-mode
      477     then do
      478     on error undo, return error return-value
      479     :
      480       if length(p-message) <= 70 then do:
      481         assign
      482           v-left-margin = integer((70 - length(p-message)) / 2)
      483         .
      484         assign
      485           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      486         .
      487         assign
      488           v-waitfram-action01 = " "
      489           v-waitfram-action02 = " "
      490                                    + fill(" ", v-left-margin)
      491                                    + p-message
      492           v-waitfram-action03 = " "
      493         .
      494       end.
      495       else do:
      496         define variable vRindex1 as integer no-undo.
      497         define variable vRindex2 as integer no-undo.
      498         vRindex1 = r-index(p-message," ",70).
      499         if vRindex1 = 0
      500         then
      501            vRindex1 = 70.
      502         if length(p-message)  <= vRindex1 + 70 then do:
      503           assign
      504             v-waitfram-action01 = " "
      505             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      506             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      507           .
      508         end.
      509         else do:
      510           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      511           if vRindex2 <= vRindex1
      512           then
      513              vRindex2 = vRindex1 + 70.
      514           assign
      515             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      516             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      517             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      518           .
      519         end.
      520       end.
      521       B-viewProcInfo:visible   in frame waitfram = no.
      522       B-viewProcInfo:sensitive in frame waitfram = no.
      523       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      524       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      525       if  (   mWaitFramView
      526          or  mWaitProcEvent)
      527          and not mBatchMode
      528       then
      529          display
      530             v-waitfram-action01 skip
      531             v-waitfram-action02 skip
      532             v-waitfram-action03 skip
      533          with frame waitfram .
      534       if     mWaitFramView
      535          then do:
      536             if     mWaitFramInterval ne ?
      537                and not mBatchMode
      538             then
      539                wait-for go of frame waitfram pause mWaitFramInterval.
      540          end.
      541          else
      542             if     mWaitProcEvent
      543                and not mBatchMode
      544             then
      545                process events .
      546     end.
      547   end procedure.
      548      procedure waitfram-show-this:
      549         define input  parameter iInterval as int64 no-undo.
      550         define variable vtime as int64 no-undo.
      551         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      552         mWaitFramInterval = iInterval.
      553         run waitfram-show (substitute("&1&2 &3&4" ,
      554                                       mWaitFramTextBeg ,
      555                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      556                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      557                                       mWaitFramTextEnd
      558                                      )
      559                           ).
      560      end.
      561      procedure WaitFramRunPause:
      562         define input  parameter iInterval as dec no-undo.
      563         define variable vStart  as datetime-tz no-undo.
      564         define variable vend    as datetime-tz no-undo.
      565         define variable vint as int64 no-undo.
      566         define variable vOk as logical no-undo.
      567         vStart = now.
      568         vend   = vStart.
      569         publish "WaitFramPause" (iInterval,output vOk).
      570         vend   =  now.
      571         vint = vend - vStart.
      572         vint = iInterval - vint / 1000.
      573         if     not mWaitFramStop
      574            and (   vint > 0
      575                 or (    not vOk
      576                     and iInterval eq ?
      577                     )
      578                 )
      579         then
      580            run waitfram-show-this (iInterval).
      581         vend   =  now.
      582         vint = vend - vStart.
      583         vint = iInterval - vint / 1000.
      584         if     not mWaitFramStop
      585            and vint > 0
      586         then do:
      587            run gbl/pause.p (vint * 1000).
      588         end.
      589         if iInterval ne ?
      590         then
      591            publish "WaitFramStop".
      592         waitfram-check-timeout().
      593      end.
      594      procedure WaitFramWaitFor:
      595         define input  parameter iInterval as dec no-undo.
      596         assign
      597            mWaitFramStartProc   = now
      598            mWaitFramStopUser    = no
      599            mWaitFramStopTimeOut = no
      600         .
      601         block-wait:
      602         do while not mWaitFramStop:
      603            run WaitFramRunPause (iInterval).
      604            if  waitfram-check-timeout()
      605            then do:
      606               leave block-wait.
      607            end.
      608         end.
      609         run waitfram-hide.
      610      end.
      611   procedure waitfram-join :
      612     define input  parameter p-line-1  as character no-undo .
      613     define input  parameter p-line-2  as character no-undo .
      614     define input  parameter p-line-3  as character no-undo .
      615     define output parameter p-message as character no-undo .
      616     do
      617     on error undo, return error return-value
      618     :
      619       assign
      620         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      621                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      622                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      623       .
      624     end.
      625   end procedure.
      626   function waitfram-join-function returns character
      627     (input p-line-1 as character
      628     ,input p-line-2 as character
      629     ,input p-line-3 as character
      630     ).
      631     define variable v-message as character no-undo .
      632     run waitfram-join in this-procedure
      633       (input  p-line-1
      634       ,input  p-line-2
      635       ,input  p-line-3
      636       ,output v-message
      637       ) .
      638     return v-message .
      639   end function .
      640   main-block:
      641   do
      642   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      643   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      644   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      645   :
      646     define variable v-message as character no-undo .
      647     define variable par-type  as character no-undo .
      648     define variable v-ok      as logical   no-undo .
      649     define variable v-ii      as integer   no-undo .
      650     define variable v-date    as date      no-undo .
      651     define variable v-time    as integer   no-undo .
      652     define buffer buf_sys-ctrl         for ub.sys-ctrl .
      653     define buffer buf_hist-nws-option  for ub.hist-nws-option.
      654     define buffer buf2_hist-nws-option for ub.hist-nws-option.
      655     define buffer buf_c-db             for ub.c-db .
      656     if g#news = false then do:
      657       if ub.db.db-key <> "":U
      658         and ub.db.db-key <> ?
      659         and ub.db.db-key <> old-db.db-key
      660       then do:
      661         define buffer buf_db for ub.db.
      662         find first buf_db
      663           where buf_db.db-key = ub.db.db-key
      664             and rowid(buf_db) <> rowid(ub.db)
      665           no-error .
      666         if available buf_db then do:
      667           message
      668             vss-workfile vss-revision vss-description skip
      669             "Ключ базы должен уникальным" skip
      670             "Ключ записываемый для базы данных" ub.db.db-num skip
      671             "Совпадает с ключом для базы данных" buf_db.db-num skip
      672             error-status :get-message(1) skip
      673             return-value skip
      674             view-as alert-box error .
      675           undo main-block, return error .
      676         end.
      677         run check-enc in this-procedure
      678           ( input ub.db.db-num
      679           ,input ub.db.db-key
      680           ,input ""
      681           ,input ""
      682           ,input ?
      683           ,input ?
      684           ,input ub.db.db-key-enc
      685           ,output v-ok
      686           ) no-error .
      687         if error-status :error then do:
      688           message
      689             vss-workfile vss-revision vss-description skip
      690             "Ошибка при проверке кодирования ключа" skip
      691             "Номер базы данных" ub.db.db-num skip
      692             error-status :get-message(1) skip
      693             return-value skip
      694             view-as alert-box error .
      695           undo main-block, return error.
      696         end.
      697         if v-ok <> true then do:
      698           message
      699             vss-workfile vss-revision vss-description skip
      700             "Нарушение кодировки ключа базы" skip
      701             "Номер базы данных" ub.db.db-num skip
      702             view-as alert-box error .
      703           undo main-block, return error.
      704         end.
      705       end.
      706       if new(ub.db)
      707         and ub.db.db-num <> 0
      708       then do:
      709         run waitfram-show in this-procedure ( input "Ждите... идет копирование опций маршрутизации и истории" ).
      710         for each buf_hist-nws-option no-lock
      711           where buf_hist-nws-option.db-num = 0
      712         on error undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      713         :
      714           create buf2_hist-nws-option.
      715           if buf_hist-nws-option.subject-group = 'c-dc-hist':U then do:
      716             buffer-copy buf_hist-nws-option
      717             except db-num
      718             to buf2_hist-nws-option
      719             assign
      720             buf2_hist-nws-option.db-num = ub.db.db-num
      721             .
      722           end.
      723           else do:
      724             buffer-copy buf_hist-nws-option
      725             except
      726             db-num
      727             get-hist-from-nws
      728             hist-from-prim
      729             hist-to-nws
      730             nws-to-cd
      731             nws-to-hist
      732             smart-nws
      733             to buf2_hist-nws-option
      734             assign
      735             buf2_hist-nws-option.db-num = ub.db.db-num
      736             buf2_hist-nws-option.get-hist-from-nws = ( if buf_hist-nws-option.get-hist-from-nws = integer('10':U)
      737                                                       or buf_hist-nws-option.get-hist-from-nws = integer('-10':U)
      738                                                       then buf_hist-nws-option.get-hist-from-nws
      739                                                       else integer('0':U))
      740             buf2_hist-nws-option.hist-from-prim = ( if buf_hist-nws-option.hist-from-prim = integer('10':U)
      741                                                       or buf_hist-nws-option.hist-from-prim = integer('-10':U)
      742                                                       then buf_hist-nws-option.hist-from-prim
      743                                                       else integer('0':U))
      744             buf2_hist-nws-option.hist-to-nws = ( if buf_hist-nws-option.hist-to-nws = integer('10':U)
      745                                                       or buf_hist-nws-option.hist-to-nws = integer('-10':U)
      746                                                       then buf_hist-nws-option.hist-to-nws
      747                                                       else integer('0':U))
      748             buf2_hist-nws-option.nws-to-cd = ( if buf_hist-nws-option.nws-to-cd = integer('10':U)
      749                                                       or buf_hist-nws-option.nws-to-cd = integer('-10':U)
      750                                                       then buf_hist-nws-option.nws-to-cd
      751                                                       else integer('-1':U))
      752             buf2_hist-nws-option.nws-to-hist = ( if buf_hist-nws-option.nws-to-hist = integer('10':U)
      753                                                       or buf_hist-nws-option.nws-to-hist = integer('-10':U)
      754                                                       then buf_hist-nws-option.nws-to-hist
      755                                                       else integer('0':U))
      756             buf2_hist-nws-option.smart-nws = ( if buf_hist-nws-option.smart-nws = integer('10':U)
      757                                                       or buf_hist-nws-option.smart-nws = integer('-10':U)
      758                                                       then buf_hist-nws-option.smart-nws
      759                                                       else integer('-1':U))
      760             .
      761           end.
      762           v-ii = v-ii + 1.
      763           if v-ii modulo 10 = 0 then do:
      764             run waitfram-show in this-procedure ( input substitute("Ждите... идет копирование опций маршрутизации и истории: &1", v-ii) ).
      765           end.
      766         end.
      767         run waitfram-hide in this-procedure .
      768       end.
      769     end.
      770     find first buf_sys-ctrl no-lock .
      771     run cur-time in this-procedure
      772       ( output v-date
      773       , output v-time
      774       ).
      775     create buf_c-db.
      776     if new(ub.db) then do:
      777       assign
      778         buf_c-db.db-num = ub.db.db-num
      779       .
      780     end.
      781     else do:
      782       buffer-copy old-db to buf_c-db .
      783     end.
      784     assign
      785       buf_c-db.action           = integer(if new(ub.db) then '1':U else '2':U)
      786       buf_c-db.chip-num         = dynamic-next-value ( "s-db-chip", "ub")
      787       buf_c-db.corr-time        = v-time
      788       buf_c-db.corr-date        = v-date
      789       buf_c-db.corr-user-db-num = buf_sys-ctrl.db-num
      790       buf_c-db.corr-user-name   = (if g#news = true then "СПН" else g#userid )
      791     .
      792     if trim( buf_c-db.corr-user-name ) = "":U then do:
      793       assign
      794         buf_c-db.corr-user-name = userid( "ub":U )
      795       .
      796     end.
      797     run str/callnews.p
      798       (input 'db':U
      799       ,input (buffer ub.db:handle)
      800       ) no-error .
      801     if error-status :error then do:
      802       assign
      803         v-message = substitute( "&1. Невозможно маршрутизировать информацию по БД (db) для отправки в новости. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) )
      804       .
      805       if g#news = false then do:
      806         message
      807           v-message
      808           view-as alert-box error.
      809       end.
      810       undo main-block,  return error .
      811     end.
      812     if g#oxml = yes then do:
      813       run str/calloxml.p
      814         ( input 'update':U
      815          ,input 'db':U
      816          ,input ( buffer ub.db:handle )
      817         ) no-error.
      818       if error-status :error then do:
      819           undo main-block, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      820                                                     ,chr(10)
      821                                                     ,vss-workfile
      822                                                     ,return-value
      823                                                     ,error-status :get-message ( 1 )
      824                                                   ).
      825       end.
      826     end.
      827   end.
