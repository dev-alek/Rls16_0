        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.goods OLD old-goods .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись товара".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4':u,ub.goods.gds-code,ub.goods.artic,ub.goods.prod-type,ub.goods.prod-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "X(65)" no-undo
       82   initial "@(#)$Workfile$ $Revision$".
       83   procedure grplib-get-full-name :
       84      define input parameter p-node-code  as integer      no-undo.
       85      define output parameter p-full-name as character    no-undo.
       86      do
       87   on error undo, return error
       88   :
       89       define variable v-upper-code    as integer           no-undo.
       90       define buffer buf_gds-grp       for ub.gds-grp.
       91       define buffer buf_upper_gds-grp for ub.gds-grp.
       92       find first buf_gds-grp no-lock
       93            where buf_gds-grp.node-code = p-node-code
       94       no-error.
       95       if not available buf_gds-grp
       96       then do:
       97           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
       98       end.
       99       assign
      100           p-full-name  = ""
      101           v-upper-code = 1
      102       .
      103       do while buf_gds-grp.upper-code <> 0
      104       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      105       :
      106           assign
      107               p-full-name  = buf_gds-grp.node-name
      108                            + (if p-full-name <> "" then chr(47) else "")
      109                            + p-full-name
      110               v-upper-code = buf_gds-grp.upper-code
      111           .
      112           find first buf_gds-grp no-lock
      113                where buf_gds-grp.node-code = v-upper-code
      114           no-error.
      115           if not available buf_gds-grp
      116           then do:
      117               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      118                                   + string( v-upper-code )
      119                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      120           end.
      121       end.
      122       assign
      123       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      124       .
      125   end.
      126   end .
      127   procedure grplib-get-node-from-full-name :
      128   define input parameter p-full-name as character no-undo .
      129   define output parameter p-node-code as integer no-undo .
      130   define variable v-ii as integer no-undo .
      131   define variable v-upper-code as integer no-undo .
      132   define variable v-root-code as integer no-undo .
      133   define variable v-entry as character no-undo .
      134   define buffer buf_gds-grp       for ub.gds-grp.
      135   do
      136   on error undo, return error
      137   :
      138     find first buf_gds-grp no-lock
      139         where buf_gds-grp.upper-code = 0
      140     no-error .
      141     if not available buf_gds-grp
      142     then do:
      143         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      144     end.
      145     else do:
      146       assign
      147       v-root-code = buf_gds-grp.node-code
      148       .
      149     end.
      150     v-upper-code = v-root-code.
      151     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      152       assign
      153       v-entry = entry(v-ii, p-full-name, chr(47)).
      154       if v-entry = '' then leave.
      155       find first buf_gds-grp no-lock where
      156                 buf_gds-grp.node-name = v-entry
      157             and buf_gds-grp.upper-code = v-upper-code
      158             no-error.
      159       if not available buf_gds-grp then do:
      160         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      161       end.
      162       else do:
      163         p-node-code = buf_gds-grp.node-code.
      164         v-upper-code = buf_gds-grp.node-code.
      165       end.
      166     end.
      167   end.
      168   end .
      169   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170   procedure cur-time :
      171      define output parameter p-today as date      no-undo .
      172      define output parameter p-time  as integer   no-undo .
      173     do
      174     on error undo, return error
      175     :
      176       define variable v-date1 as date      no-undo .
      177       define variable v-date2 as date      no-undo .
      178       define variable v-time  as integer   no-undo .
      179       assign
      180         v-date1 = today
      181         v-time  = time
      182         v-date2 = today
      183       .
      184       if v-date1 <> v-date2
      185       then do:
      186         assign
      187           v-date1 = today
      188           v-time  = v-time
      189         .
      190       end.
      191       assign
      192         p-today = v-date1
      193         p-time  = v-time
      194       .
      195     end.
      196   end.
      197   function cur-time-date returns character
      198   :
      199     return string(today, '99/99/9999':U) .
      200   end.
      201   function cur-time-mjd returns decimal
      202   :
      203     define variable v-date as date      no-undo .
      204     define variable v-time as integer   no-undo .
      205     run cur-time in this-procedure
      206       (output v-date
      207       ,output v-time
      208       ) .
      209     return integer(v-date) - 2400002 + (v-time / 86400) .
      210   end.
      211   function cur-time-get-ending-index returns integer
      212   (input p-number as integer
      213   )
      214   :
      215     if p-number < 0
      216     or p-number = ?
      217     then do:
      218       return 1 .
      219     end.
      220     define variable v-rest as integer   no-undo .
      221     assign
      222       p-number = p-number modulo 100
      223     .
      224     if p-number < 20
      225     then do:
      226       assign
      227         v-rest = p-number
      228       .
      229     end.
      230     else do:
      231       assign
      232         v-rest = p-number modulo 10
      233       .
      234     end.
      235     case v-rest :
      236       when 1
      237       then do:
      238         return 2 .
      239       end.
      240       when 2 or
      241       when 3 or
      242       when 4
      243       then do:
      244         return 3 .
      245       end.
      246       otherwise do:
      247         return 1 .
      248       end.
      249     end case .
      250   end.
      251   procedure cur-time-mjd-to-date :
      252      define input  parameter i-mjd-diff as decimal no-undo.
      253      define output parameter o-Date     as date    no-undo.
      254      define output parameter o-Time     as integer no-undo.
      255      define variable v-day-number as integer   no-undo .
      256      if    i-mjd-diff < 0
      257         or i-mjd-diff = ?
      258      then do:
      259         return "?" .
      260      end.
      261      assign
      262         v-day-number = truncate(i-mjd-diff,0).
      263         o-Date = date(v-day-number + 2400002).
      264         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      265     .
      266   end.
      267   function cur-time-mjd-to-string returns character
      268   (input p-mjd-diff as decimal
      269   )
      270   :
      271     define variable v-day-number as integer   no-undo .
      272     define variable v-seconds    as integer   no-undo .
      273     define variable v-hour       as integer   no-undo .
      274     define variable v-min        as integer   no-undo .
      275     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      276     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      277     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      278     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      279     if p-mjd-diff < 0
      280     or p-mjd-diff = ?
      281     then do:
      282       return "?" .
      283     end.
      284     assign
      285       v-day-number = integer(truncate(p-mjd-diff,0))
      286       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      287     .
      288     if v-seconds > 86400
      289     then do:
      290       assign
      291         v-seconds = 86400 - 1
      292       .
      293     end.
      294     if v-seconds < 0
      295     then do:
      296       assign
      297         v-seconds = 0
      298       .
      299     end.
      300     assign
      301       v-hour = truncate(v-seconds / 3600, 0)
      302     .
      303     assign
      304       v-seconds = v-seconds modulo 3600
      305     .
      306     assign
      307       v-min = truncate(v-seconds / 60, 0)
      308     .
      309     assign
      310       v-seconds = v-seconds modulo 60
      311     .
      312     return
      313         (if v-day-number <> 0
      314           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      315           else ""
      316         )
      317       + (if v-day-number <> 0 or v-hour <> 0
      318           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      319           else ""
      320         )
      321       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      322           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      323           else ""
      324         )
      325       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      326       .
      327   end.
      328   function cur-time-string returns character
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      337   end.
      338   function cur-time-string-sec returns character
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      347   end.
      348   function cur-time-custom  returns character
      349   (input p-prefix as character
      350   ,input p-date-format as character
      351   ,input p-delimiter as character
      352   ,input p-time-format as character
      353   ,input p-suffix as character
      354   )
      355   :
      356     define variable v-date as date      no-undo .
      357     define variable v-time as integer   no-undo .
      358     run cur-time in this-procedure
      359       (output v-date
      360       ,output v-time
      361       ) .
      362     return
      363       p-prefix
      364       + string(v-date, p-date-format)
      365       + p-delimiter
      366       + string(v-time, p-time-format)
      367       + p-suffix
      368       .
      369   end.
      370   function cur-time-print  returns character
      371   :
      372     define variable v-date as date      no-undo .
      373     define variable v-time as integer   no-undo .
      374     run cur-time in this-procedure
      375       (output v-date
      376       ,output v-time
      377       ) .
      378     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      379   end.
      380   function cur-time-datetime returns datetime
      381   :
      382     define variable v-char as character no-undo .
      383     define variable v-datetime as datetime no-undo .
      384     v-char = cur-time-string().
      385     v-datetime = datetime(v-char).
      386     return  v-datetime.
      387   end.
      388   function cur-time-string-msec returns character
      389   :
      390     define variable v-date as datetime  no-undo .
      391     v-date = now.
      392     return string(v-date) .
      393   end.
      394   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   define new global shared variable g#lib-nws as handle no-undo .
      397   procedure goodsh_write-goods-trigger :
      398   define input parameter p-new-record as logical no-undo .
      399   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      400   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      401   define variable v-date as date      no-undo.
      402   define variable v-time  as integer   no-undo.
      403   define buffer buf_c-gds-hist for ub.c-gds-hist.
      404   define buffer buf_c-goods for ub.c-goods.
      405     do
      406     on error undo, return error
      407     :
      408       if g#news then do:
      409         define variable v-send as integer no-undo .
      410         v-send = integer('0':U).
      411   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      412   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      413     (input  g#db-num
      414     ,input  'goods':U
      415     ,input  0
      416     ,input  '':U
      417     ,input  0
      418     ,input  '':U
      419     ,input  '':U
      420     ,input  '':U
      421     ,input  0
      422     ,input  0
      423     ,input  0
      424     ,input  'nws-to-hist'
      425     ,output v-send
      426     ) no-error .
      427         if v-send < 0 then return.
      428       end.
      429       run cur-time in this-procedure(output v-date, output v-time).
      430       create buf_c-goods.
      431       buffer-copy old-goods to buf_c-goods
      432       assign
      433       buf_c-goods.gds-code           = (if p-new-record then ub.goods.gds-code else old-goods.gds-code)
      434       buf_c-goods.chip-num           = next-value (s-gds-chip, ub)
      435       buf_c-goods.corr-time          = v-time
      436       buf_c-goods.corr-user-db-num   = g#db-num
      437       buf_c-goods.corr-user-name     = (if g#news then (chr(4) +  'СПН':U)
      438                                         else (if g#esys
      439                                               then (chr(4) +  'ВС':U)
      440                                               else g#userid)
      441                                         )
      442       buf_c-goods.corr-date          = v-date
      443       .
      444       create buf_c-gds-hist.
      445       buffer-copy buf_c-goods to buf_c-gds-hist
      446       assign
      447       buf_c-gds-hist.gds-code           = buf_c-goods.gds-code
      448       buf_c-gds-hist.action = (if p-new-record
      449                                 then integer('1':U)
      450                                 else (if ub.goods.gds-code = old-goods.gds-code
      451                                       then integer('2':U)
      452                                       else integer('9':U))
      453                               )
      454       buf_c-gds-hist.subject = 'goods':U
      455       buf_c-gds-hist.is-news = g#news
      456       buf_c-gds-hist.source-type = p-source-type
      457       buf_c-gds-hist.source-ref = p-source-ref
      458       .
      459     end.
      460   end procedure.
      461   procedure goodsh_write-goods-proc  :
      462   define parameter buffer buf_goods for ub.goods .
      463   define input parameter p-action as integer no-undo .
      464   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      465   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      466   define variable v-date as date      no-undo.
      467   define variable v-time  as integer   no-undo.
      468   define buffer buf_c-gds-hist for ub.c-gds-hist.
      469   define buffer buf_c-goods for ub.c-goods.
      470     do
      471     on error undo, return error
      472     :
      473       if not available buf_goods then do:
      474         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      475                       "Ошибка задания входных параметров:Не определен товар" ).
      476       end.
      477       if g#news then do:
      478         define variable v-send as integer no-undo .
      479         v-send = integer('0':U).
      480   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      481   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      482     (input  g#db-num
      483     ,input  'goods':U
      484     ,input  0
      485     ,input  '':U
      486     ,input  0
      487     ,input  '':U
      488     ,input  '':U
      489     ,input  '':U
      490     ,input  0
      491     ,input  0
      492     ,input  0
      493     ,input  'nws-to-hist'
      494     ,output v-send
      495     ) no-error .
      496         if v-send < 0 then return.
      497       end.
      498       run cur-time in this-procedure(output v-date, output v-time).
      499       create buf_c-goods.
      500       buffer-copy buf_goods to buf_c-goods
      501       assign
      502       buf_c-goods.gds-code             = buf_goods.gds-code
      503       buf_c-goods.chip-num           = next-value (s-gds-chip, ub)
      504       buf_c-goods.corr-time          = v-time
      505       buf_c-goods.corr-user-db-num   = g#db-num
      506       buf_c-goods.corr-user-name     = (if g#news then (chr(4) +  'СПН':U)
      507                                         else (if g#esys
      508                                               then (chr(4) +  'ВС':U)
      509                                               else g#userid)
      510                                               )
      511       buf_c-goods.corr-date          = v-date
      512       .
      513       create buf_c-gds-hist.
      514       buffer-copy buf_c-goods to buf_c-gds-hist
      515       assign
      516       buf_c-gds-hist.action =  p-action
      517       buf_c-gds-hist.subject = 'goods':U
      518       buf_c-gds-hist.is-news = g#news
      519       buf_c-gds-hist.source-type = p-source-type
      520       buf_c-gds-hist.source-ref = p-source-ref
      521       .
      522     end.
      523   end procedure.
      524   DEFINE VARIABLE conf-par    as character no-undo .
      525   DEFINE VARIABLE par-type    as character no-undo .
      526   DEFINE VARIABLE v-l         as logical   no-undo .
      527   define variable v-date      as date      no-undo .
      528   define variable v-time      as integer   no-undo .
      529   define variable v-node-code as integer   no-undo .
      530   define variable v-grp-code  as integer   no-undo .
      531   define variable v-mes       as character no-undo .
      532   define variable v-mes0      as character no-undo .
      533   define buffer buf_c-goods    for ub.c-goods.
      534   define buffer buf_c-gds-hist for ub.c-gds-hist.
      535   main-block:
      536   do
      537       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      538       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      539       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      540       :
      541   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      542   define variable send-ref as logical no-undo.
      543   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      544     (input  'send-ref'
      545     ,input  0
      546     ,input  ''
      547     ,input  0
      548     ,input  ''
      549     ,input  ''
      550     ,input  ''
      551     ,input  no
      552     ,output conf-par
      553     ,output par-type
      554     ) no-error .
      555     send-ref = (IF error-status:error or conf-par <> "yes" then no else yes).
      556       if new(ub.goods) then
      557       do:
      558           assign
      559               v-l = no.
      560       end.
      561       else
      562       do:
      563           v-l = yes.
      564           buffer-compare ub.goods
      565               to old-goods
      566               case-sensitive
      567               save result in v-l.
      568       end.
      569       if v-l = yes then return.
      570       if new(ub.goods) then
      571       do:
      572           if ub.goods.gds-code = 0
      573               or ub.goods.gds-code = ? then
      574           do:
      575               message
      576                   vss-workfile vss-revision vss-description skip
      577                   "Не задан код товара" skip
      578                   "Код товара" ub.goods.gds-code skip
      579                   "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      580                   view-as alert-box error .
      581               undo main-block, return error .
      582           end.
      583           if  ub.goods.gds-type <> 'т':U
      584               and ub.goods.gds-type <> 'у':U then
      585           do:
      586               message
      587                   vss-workfile vss-revision vss-description skip
      588                   "Не задан тип товара" skip
      589                   "Код товара" ub.goods.gds-code skip
      590                   "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      591                   "ub.goods.gds-type" ub.goods.gds-type skip
      592                   view-as alert-box error .
      593               undo main-block, return error .
      594           end.
      595           if  ub.goods.prod-type <> 'чел':U
      596               and ub.goods.prod-type <> 'орг':U then
      597           do:
      598               message
      599                   vss-workfile vss-revision vss-description skip
      600                   "Недопустимый тип производителя товара" skip
      601                   "Код товара" ub.goods.gds-code skip
      602                   "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      603                   "ub.goods.prod-type" ub.goods.prod-type skip
      604                   view-as alert-box error .
      605               undo main-block, return error .
      606           end.
      607           find ub.units no-lock
      608               where ub.units.unit-name = ub.goods.unit-base
      609               no-error .
      610           if not available ub.units then
      611           do:
      612               message
      613                   vss-workfile vss-revision vss-description skip
      614                   "Не найдена базовая единица измерения" skip
      615                   "Код товара" ub.goods.gds-code skip
      616                   "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      617                   "Базовая единица измерения" ub.goods.unit-base skip
      618                   view-as alert-box error .
      619               undo main-block, return error .
      620           end.
      621           find ub.gds-prt no-lock
      622               where ub.gds-prt.upper-code = ub.goods.prt-root
      623               no-error .
      624           if not available ub.gds-prt
      625               or ub.gds-prt.prt-root <> ub.goods.prt-root then
      626           do:
      627               message
      628                   vss-workfile vss-revision vss-description skip
      629                   "Не найдена шкала" skip
      630                   "Код товара" ub.goods.gds-code skip
      631                   "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      632                   "Код шкалы" ub.goods.prt-root skip
      633                   view-as alert-box error .
      634               undo main-block, return error .
      635           end.
      636       end.
      637       else
      638       do:
      639           if ub.goods.gds-code <> old-goods.gds-code then
      640           do:
      641               message
      642                   vss-workfile vss-revision vss-description skip
      643                   "Нельзя изменить код товара" skip
      644                   "Код товара" ub.goods.gds-code skip
      645                   "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      646                   "old-goods.gds-code" old-goods.gds-code skip
      647                   view-as alert-box error .
      648               undo main-block, return error .
      649           end.
      650           if ub.goods.gds-type <> old-goods.gds-type then
      651           do:
      652               message
      653                   vss-workfile vss-revision vss-description skip
      654                   "Нельзя изменить тип товара" skip
      655                   "Код товара" ub.goods.gds-code skip
      656                   "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      657                   "ub.goods.gds-type" ub.goods.gds-type skip
      658                   "old-goods.gds-type" old-goods.gds-type skip
      659                   view-as alert-box error .
      660               undo main-block, return error .
      661           end.
      662           if ub.goods.prod-type <> old-goods.prod-type then
      663           do:
      664               if  ub.goods.prod-type <> 'чел':U
      665                   and ub.goods.prod-type <> 'орг':U then
      666               do:
      667                   message
      668                       vss-workfile vss-revision vss-description skip
      669                       "Недопустимый тип производителя товара" skip
      670                       "Код товара" ub.goods.gds-code skip
      671                       "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      672                       "ub.goods.prod-type" ub.goods.prod-type skip
      673                       view-as alert-box error .
      674                   undo main-block, return error .
      675               end.
      676           end.
      677           if ub.goods.unit-base <> old-goods.unit-base then
      678           do:
      679               message
      680                   vss-workfile vss-revision vss-description skip
      681                   "Нельзя изменить базовую единицу измерения товара" skip
      682                   "Код товара" ub.goods.gds-code skip
      683                   "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      684                   "ub.goods.unit-base" ub.goods.unit-base skip
      685                   "old-goods.unit-base" old-goods.unit-base skip
      686                   view-as alert-box error .
      687               undo main-block, return error .
      688           end.
      689           if ub.goods.prt-root <> old-goods.prt-root then
      690           do:
      691               find ub.gds-prt no-lock
      692                   where ub.gds-prt.upper-code = ub.goods.prt-root
      693                   no-error .
      694               if not available ub.gds-prt
      695                   or ub.gds-prt.prt-root <> ub.goods.prt-root then
      696               do:
      697                   message
      698                       vss-workfile vss-revision vss-description skip
      699                       "Не найдена шкала" skip
      700                       "Код товара" ub.goods.gds-code skip
      701                       "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      702                       "Код шкалы" ub.goods.prt-root skip
      703                       view-as alert-box error .
      704                   undo main-block, return error .
      705               end.
      706           end.
      707       end.
      708       if new (ub.goods)
      709           or ub.goods.grp-code <> old-goods.grp-code then
      710       do:
      711           run grplib-get-full-name in this-procedure (input ub.goods.grp-code, output ub.goods.grp-name) no-error .
      712           IF error-status:error
      713               AND G#NEWS
      714               AND G#DB-NUM = 0 THEN
      715           DO:
      716               v-mes0 = substitute("&1 &2 &3&4&5&4&5&4&6"
      717                   ,vss-workfile
      718                   ,vss-revision
      719                   ,vss-description
      720                   ,chr(10)
      721                   , error-status:get-message(1)
      722                   ,return-value).
      723               v-grp-code = ub.goods.grp-code.
      724               if old-goods.grp-code = ? then
      725               do:
      726                   error-status:error = yes.
      727               end.
      728               else
      729               do:
      730                   ASSIGN
      731                       UB.GOODS.grp-code = old-goods.grp-code.
      732                   run grplib-get-full-name in this-procedure (input ub.goods.grp-code, output ub.goods.grp-name) no-error .
      733                   v-mes0 =  substitute("&7&4&1 &2 &3&4&5&4&5&4&6&4"
      734                       ,vss-workfile
      735                       ,vss-revision
      736                       ,vss-description
      737                       ,chr(10)
      738                       , error-status:get-message(1)
      739                       ,return-value
      740                       ,v-mes0
      741                       ).
      742               end.
      743               if error-status:error then
      744               do:
      745                   run grplib-get-node-from-full-name ( input ub.goods.grp-name, output v-node-code) no-error.
      746                   if error-status:error then
      747                   do:
      748                       v-mes = substitute("&1 &2 &3&4&5&4&5&4&6&4&7&4&8&4&9"
      749                           ,vss-workfile
      750                           ,vss-revision
      751                           ,vss-description
      752                           ,chr(10)
      753                           , error-status:get-message(1)
      754                           ,return-value
      755                           ,v-mes0
      756                           ,substitute("Не удается поместить товар в группу с вн. кодом &1,&2" +
      757                           "и не удается поместить товар в группу с полным именем &3"
      758                           ,v-grp-code
      759                           ,chr(10)
      760                           ,ub.goods.grp-name)
      761                           , substitute("Возможно Вам следует СОЗДАТЬ группу товара с полным именем &1"
      762                           ,ub.goods.grp-name)
      763                           ).
      764                       undo main-block, return error v-mes .
      765                   end.
      766                   assign
      767                       ub.goods.grp-code = v-node-code.
      768               end.
      769           END.
      770           else
      771           do:
      772               if error-status:error then
      773               do:
      774                   v-mes = substitute("&1 &2 &3&4&5&4&6"
      775                       ,vss-workfile
      776                       ,vss-revision
      777                       ,vss-description
      778                       ,chr(10)
      779                       ,error-status:get-message(1)
      780                       ,return-value ).
      781                   if not g#news then
      782                   do:
      783                       message
      784                           v-mes view-as alert-box error .
      785                   end.
      786                   undo main-block, return error v-mes .
      787               end.
      788           end.
      789       end.
      790       if can-find(first ub.gds-grp where ub.gds-grp.upper-code = ub.goods.grp-code) then
      791       do:
      792           v-mes = substitute("Нельзя привязать товар с кодом &1 к нетерминальной группе с вн. кодом &2"
      793               , ub.goods.gds-code
      794               , ub.goods.grp-code).
      795           if not g#news then
      796           do:
      797               message
      798                   v-mes
      799                   view-as alert-box error .
      800           end.
      801           undo main-block, return error v-mes .
      802       end.
      803       if new (ub.goods)
      804           or ub.goods.grp-code <> old-goods.grp-code
      805           or ub.goods.unit-base <> ub.goods.unit-base then
      806       do:
      807           run trg/scan-grp.p (input ub.goods.grp-code, input ub.goods.unit-base).
      808       end.
      809       if old-goods.stts     <> ub.goods.stts
      810           or old-goods.grp-code <> ub.goods.grp-code then
      811       do:
      812           for each ub.gds-obj
      813               where ub.gds-obj.artic     = ub.goods.artic
      814               and ub.gds-obj.prod-type = ub.goods.prod-type
      815               and ub.gds-obj.prod-code = ub.goods.prod-code
      816               on error undo main-block, return error
      817               :
      818               assign
      819                   ub.gds-obj.grp-name = ub.goods.grp-name
      820                   ub.gds-obj.stts     = ub.goods.stts
      821                   .
      822           end.
      823       end.
      824       if old-goods.gds-name     <> ub.goods.gds-name
      825           then
      826       do:
      827           for each ub.contract-specif
      828               where ub.contract-specif.artic     = ub.goods.artic
      829               and ub.contract-specif.prod-type = ub.goods.prod-type
      830               and ub.contract-specif.prod-code = ub.goods.prod-code
      831               on error undo main-block, return error
      832               :
      833               assign
      834                   ub.contract-specif.gds-name = ub.goods.gds-name
      835                   .
      836           end.
      837       end.
      838       if not v-l then
      839       do:
      840           if old-goods.stts = integer('50':U)
      841               or old-goods.stts = integer('51':U)
      842               or ub.goods.stts = integer('50':U)
      843               or ub.goods.stts = integer('51':U)
      844               then
      845           do:
      846           end.
      847           else
      848           do:
      849               run str/callnews.p
      850                   (input 'goods':U
      851                   ,input (buffer ub.goods:handle)
      852                   ) no-error .
      853               if error-status:error then
      854               do:
      855                   if error-status :get-message(1) <> ""
      856                       then
      857                   do:
      858                       message
      859                           vss-workfile vss-revision vss-description skip
      860                           "Ошибка при вызове процедуры callnews.p" skip
      861                           error-status :get-message(1) skip
      862                           return-value skip
      863                           view-as alert-box error .
      864                   end.
      865                   undo main-block,  return error return-value .
      866               end.
      867   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      868     (input ?
      869     ,input this-procedure:handle
      870     ,input ?
      871     ,input  ( if new(ub.goods) then 'gdsadd':U else 'gdsupdate':U )
      872     ,input  buffer old-goods:handle
      873     ,input  buffer ub.goods:handle
      874     ,input ''
      875     ,input ''
      876     ) no-error .
      877               if error-status:error
      878                   then
      879               do:
      880                   if not g#news then
      881                   do:
      882                       message
      883                           vss-workfile vss-revision vss-description skip
      884                           "Ошибка при вызове процедуры rum-runa.i" skip
      885                           error-status :get-message(1) skip
      886                           return-value skip
      887                           view-as alert-box error .
      888                   end.
      889                   undo main-block,  return error return-value .
      890               end.
      891           end.
      892           if new (ub.goods) and ub.goods.gds-type = 'у':U then
      893           do:
      894               for each ub.gds-obj No-LOCK WHERE
      895                   ub.gds-obj.gds-code = ub.goods.gds-code
      896                   ON error undo, return error return-value
      897                   :
      898                   run str/callnews.p
      899                       (input 'gds-obj':U
      900                       ,input (buffer ub.gds-obj:handle)
      901                       ) no-error .
      902                   if error-status:error then
      903                   do:
      904                       if error-status :get-message(1) <> ""
      905                           then
      906                       do:
      907                           message
      908                               vss-workfile vss-revision vss-description skip
      909                               "Ошибка при вызове процедуры callnews.p (gds-obj)" skip
      910                               error-status :get-message(1) skip
      911                               return-value skip
      912                               view-as alert-box error .
      913                       end.
      914                       undo main-block,  return error return-value .
      915                   end.
      916               end.
      917           end.
      918           if not new(ub.goods) then
      919           do:
      920               find ub.units no-lock
      921                   where ub.units.unit-name = ub.goods.unit-base
      922                   no-error .
      923               if not available ub.units then
      924               do:
      925                   message
      926                       vss-workfile vss-revision vss-description skip
      927                       "Не найдена базовая единица измерения" skip
      928                       "Код товара" ub.goods.gds-code skip
      929                       "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      930                       "Базовая единица измерения" ub.goods.unit-base skip
      931                       view-as alert-box error .
      932                   undo main-block, return error .
      933               end.
      934               if (old-goods.gds-name  <> ub.goods.gds-name
      935                   or old-goods.engl-name <> ub.goods.engl-name
      936                   or old-goods.label-name <> ub.goods.label-name
      937                   )
      938                   and
      939                   (LOOKUP('вес':U, ub.units.type) > 0
      940                   or
      941                   (LOOKUP('шту':U, ub.units.type) > 0
      942                   and
      943                   can-find(first ub.code-range no-lock where ub.code-range.range-type = 'pglc':U)
      944                   )
      945                   )
      946                   then
      947               do:
      948   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   define variable v-attr-code7 as character no-undo .
      950   define buffer buf7_gds-prt for ub.gds-prt.
      951   define buffer buf7_bar-code for ub.bar-code.
      952   define buffer buf7_scales-gds for ub.scales-gds.
      953   define buffer buf7_scales for ub.scales.
      954   find buf7_gds-prt no-lock
      955     where buf7_gds-prt.upper-code = ub.goods.prt-root
      956     .
      957   find first buf7_bar-code no-lock
      958     where buf7_bar-code.gds-code  = ub.goods.gds-code
      959       and buf7_bar-code.node-code = buf7_gds-prt.node-code
      960       and buf7_bar-code.part-code = ""
      961       and buf7_bar-code.in-code   = ""
      962       and buf7_bar-code.unit-cli  = ub.goods.unit-base
      963     no-error .
      964   if available buf7_bar-code then do:
      965     for each buf7_scales-gds
      966       where buf7_scales-gds.db-num = g#db-num
      967         AND buf7_scales-gds.b-code = buf7_bar-code.b-code
      968     :
      969       find first buf7_scales
      970         where buf7_scales.scales-num = buf7_scales-gds.scales-num
      971          and buf7_scales.db-num = buf7_scales-gds.db-num
      972         .
      973       run ref/ves-pbc.p (
      974                       input ?
      975                     , input 'ИЗМЕНЕНИЕ':U
      976                       , input buf7_scales-gds.obj-type
      977                       , input buf7_scales-gds.obj-code
      978                       , input ?
      979                       , input ?
      980                       , input ?
      981                       , input ?
      982                       , buffer buf7_bar-code
      983                       , buffer buf7_scales) .
      984     end.
      985   end.
      986               end.
      987               if old-goods.struct <> ub.goods.struct
      988                   and (LOOKUP('вес':U, ub.units.type) > 0
      989                   or
      990                   (LOOKUP('шту':U, ub.units.type) > 0
      991                   and
      992                   can-find(first ub.code-range no-lock where ub.code-range.range-type = 'pglc':U)
      993                   )
      994                   )
      995                   then
      996               do:
      997   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      998   define variable v-attr-code8 as character no-undo .
      999   define buffer buf8_gds-prt for ub.gds-prt.
     1000   define buffer buf8_bar-code for ub.bar-code.
     1001   define buffer buf8_scales-gds for ub.scales-gds.
     1002   define buffer buf8_scales for ub.scales.
     1003   find buf8_gds-prt no-lock
     1004     where buf8_gds-prt.upper-code = ub.goods.prt-root
     1005     .
     1006   find first buf8_bar-code no-lock
     1007     where buf8_bar-code.gds-code  = ub.goods.gds-code
     1008       and buf8_bar-code.node-code = buf8_gds-prt.node-code
     1009       and buf8_bar-code.part-code = ""
     1010       and buf8_bar-code.in-code   = ""
     1011       and buf8_bar-code.unit-cli  = ub.goods.unit-base
     1012     no-error .
     1013   if available buf8_bar-code then do:
     1014     for each buf8_scales-gds
     1015       where buf8_scales-gds.db-num = g#db-num
     1016         AND buf8_scales-gds.b-code = buf8_bar-code.b-code
     1017     :
     1018       find first buf8_scales
     1019         where buf8_scales.scales-num = buf8_scales-gds.scales-num
     1020          and buf8_scales.db-num = buf8_scales-gds.db-num
     1021         .
     1022           assign
     1023       v-attr-code8 = entry (lookup (buf8_scales.scales-type, 'CAS_lp-16x,DIGI-SM,CAS_CL5000J,CAS_CL5000,TIGER-SPCT2,TIGER-SPCT1,CAS_LP-15,SHTRIH-M,CAS_LP-15v1.6':U), '8x50,15x80,6x50,6x50,8x50,8x50,8x50,8x50,8x50':U) no-error .
     1024       if lookup(buf8_scales.scales-type, 'CAS_lp-16x,DIGI-SM,CAS_CL5000J,CAS_CL5000,TIGER-SPCT2,TIGER-SPCT1,CAS_LP-15,SHTRIH-M,CAS_LP-15v1.6':U) > 0
     1025       and ('struct' = "struct" or v-attr-code8 = 'struct')
     1026       then do:
     1027       run ref/ves-pbc.p (
     1028                       input ?
     1029                     , input 'ИЗМЕНЕНИЕ':U
     1030                       , input buf8_scales-gds.obj-type
     1031                       , input buf8_scales-gds.obj-code
     1032                       , input ?
     1033                       , input ?
     1034                       , input ?
     1035                       , input ?
     1036                       , buffer buf8_bar-code
     1037                       , buffer buf8_scales) .
     1038         end.
     1039     end.
     1040   end.
     1041               end.
     1042           end.
     1043           if not g#news and new(ub.goods) then
     1044           do:
     1045               assign
     1046                   ub.goods.cr-db-num = g#db-num.
     1047           end.
     1048           if not g#news and send-ref then
     1049           do:
     1050               if not new(ub.goods) then
     1051               do:
     1052                   define variable v-l2 as logical no-undo .
     1053                   assign
     1054                       v-l2 = yes
     1055                       .
     1056                   buffer-compare ub.goods using
     1057                       engl-name gds-name chk-name
     1058                       to old-goods
     1059                       case-sensitive
     1060                       save result in v-l2 .
     1061                   if not v-l2 then
     1062                   do:
     1063                       run trg/nu_gds.p (
     1064                           input  ub.goods.gds-code
     1065                           ,input  0
     1066                           ,input  "":U
     1067                           ,input  0
     1068                           ,input  "U":U
     1069                           ).
     1070                   end.
     1071               end.
     1072           end.
     1073           run goodsh_write-goods-trigger in this-procedure  (
     1074               input new(ub.goods)
     1075               ,input (if g#news
     1076               then 'db':U
     1077               else (if g#esys
     1078               then 'esys':U
     1079               else "":U)
     1080               )
     1081               ,input  (if g#news
     1082               then string(g#news-source-db)
     1083               else (if g#esys
     1084               then string(g#esys-source-esys)
     1085               else "":U)
     1086               )
     1087               ) no-error .
     1088           if error-status:error then
     1089           do:
     1090               message
     1091                   vss-workfile vss-revision vss-description skip
     1092                   "Ошибка при вызове процедуры goodsh_write-goods-trigger" skip
     1093                   error-status :get-message(1) skip
     1094                   return-value skip
     1095                   view-as alert-box error .
     1096               undo main-block,  return error return-value .
     1097           end.
     1098       end.
     1099       if g#oxml = yes
     1100           then
     1101       do:
     1102           run str/calloxml.p (
     1103               input 'update':U
     1104               , input 'goods':U
     1105               , input ( buffer ub.goods:handle )
     1106               ) no-error.
     1107           if error-status :error
     1108               then
     1109           do:
     1110               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1111                   , chr(10)
     1112                   , vss-workfile
     1113                   , return-value
     1114                   , error-status :get-message ( 1 ) ).
     1115           end.
     1116       end.
     1117       if new(ub.goods) then
     1118       do:
     1119           run trg/userlog.p (
     1120               input 'create':U
     1121               , input 'goods':U
     1122               , input ( buffer ub.goods :handle )
     1123               , input ?
     1124               , input ""
     1125               ) no-error.
     1126           if error-status :error
     1127               then
     1128           do:
     1129               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     1130                   , chr(10)
     1131                   , vss-workfile
     1132                   , return-value
     1133                   , error-status :get-message ( 1 ) ).
     1134           end.
     1135       end.
     1136       else
     1137       do:
     1138           run trg/userlog.p (
     1139               input 'update':U
     1140               , input 'goods':U
     1141               , input ( buffer ub.goods :handle )
     1142               , input ?
     1143               , input ""
     1144               ) no-error.
     1145           if error-status :error
     1146               then
     1147           do:
     1148               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     1149                   , chr(10)
     1150                   , vss-workfile
     1151                   , return-value
     1152                   , error-status :get-message ( 1 ) ).
     1153           end.
     1154       end.
     1155   end.
