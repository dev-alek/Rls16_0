        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.gds-mercury .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление справочника соответсвия товаров mercury товарам TH".
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   define new global shared variable g#library  as handle no-undo .
       14   define new global shared variable g#library2 as handle no-undo .
       15   define   shared variable g#auto as logical no-undo.
       16   define   shared variable g#news as logical no-undo.
       17   define   shared variable g#oxml as logical no-undo.
       18   define   shared variable g#esys as logical no-undo.
       19   define   shared variable g#news-source-db as integer no-undo.
       20   define   shared variable g#esys-source-esys as integer no-undo.
       21   define   shared variable g#db-num as integer   no-undo .
       22   define   shared variable g#userid as character no-undo .
       23   define   shared variable g#passwd as character no-undo .
       24   main-block:
       25   do
       26   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       27   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       28   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       29   :
       30     for each ub.gds-mercury-attr exclusive-lock where ub.gds-mercury-attr.ID = ub.gds-mercury.ID and ub.gds-mercury-attr.db-num = ub.gds-mercury.db-num:
       31       delete ub.gds-mercury-attr.
       32     end.
       33     if not g#news
       34     then do:
       35       run nws/cmd-del.p
       36         ( input 'gds-mercury':U
       37          ,input (buffer ub.gds-mercury:handle)
       38          ,input "":U
       39         ) no-error .
       40       if error-status :error then do:
       41         message
       42           vss-workfile vss-revision vss-description skip
       43           "Невозможно маршрутизировать удаление gds-mercury для отправки в новости" skip
       44           error-status :get-message(1) skip
       45           return-value skip
       46           view-as alert-box error .
       47         undo , return error return-value .
       48       end.
       49     end.
       50   end.
