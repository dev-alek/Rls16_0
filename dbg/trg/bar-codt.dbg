        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Библиотека процедур для распределенной обработки бар-кодов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure gen-key-rec :
       79     define input  parameter p-tbl-name    as character no-undo.
       80     define input  parameter p-bh_tbl-name as handle    no-undo.
       81     define output parameter p-key-rec     as character no-undo.
       82     do
       83     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       84     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       85     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       86     :
       87       define variable fh               as handle    no-undo .
       88       define variable v-ok             as logical   no-undo .
       89       define variable v-inform         as character no-undo .
       90       define variable v-ind            as integer   no-undo .
       91       define variable v-idx-field-qnty as integer   no-undo .
       92       if p-tbl-name = ?
       93         or p-tbl-name = "":U
       94       then do:
       95         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       96       end.
       97       if not p-bh_tbl-name:available then do:
       98         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
       99       end.
      100       assign
      101         p-key-rec = p-tbl-name
      102         v-inform  = p-bh_tbl-name:index-information(1)
      103         v-ind     = 2
      104       .
      105       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      106       on error undo, return error
      107       :
      108         assign
      109           v-inform = p-bh_tbl-name:index-information( v-ind )
      110           v-ind    = v-ind + 1
      111         .
      112       end.
      113       if v-inform = ?
      114         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      115         or entry( 3, v-inform, ",":U ) <> "1":U
      116       then do:
      117         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      118       end.
      119       else do:
      120         assign
      121           v-idx-field-qnty = num-entries( v-inform ) - 4
      122         .
      123         if v-idx-field-qnty < 2 then do:
      124           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      125         end.
      126         do v-ind = 1 to v-idx-field-qnty by 2
      127         on error undo, return error
      128         :
      129           assign
      130             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      131             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      132           .
      133         end.
      134       end.
      135       if p-key-rec = ? then do:
      136         assign
      137           p-key-rec = "":U
      138         .
      139         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      140       end.
      141     end.
      142     return.
      143   end procedure.
      144   procedure gen-where-keyr-tab :
      145     define input  parameter i-tableSerach as character no-undo.
      146     define input  parameter i-tablekey   as character  no-undo.
      147     define input  parameter p-key-rec    as character  no-undo.
      148     define input  parameter p-key-handle as handle     no-undo .
      149     define input  parameter p-db-name    as character  no-undo .
      150     define input  parameter p-tt-handle  as handle     no-undo .
      151     define output parameter o-Where      as character  no-undo.
      152     do
      153     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      154     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      155     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      156     :
      157       define variable v-full-tbl-name  as character no-undo .
      158       define variable bh_tbl-name      as handle    no-undo .
      159       define variable fh_key           as handle    no-undo .
      160       define variable fh_search        as handle    no-undo .
      161       define variable v-field-num      as integer   no-undo .
      162       define variable v-count-fld      as integer   no-undo .
      163       define variable v-inform         as character no-undo .
      164       define variable v-ind            as integer   no-undo .
      165       define variable v-idx-field-qnty as integer   no-undo .
      166       define variable v-field-name     as character no-undo .
      167       define variable v-field-val      as character no-undo .
      168       define variable v-word-link      as character no-undo .
      169       define variable vTable           as character no-undo.
      170       define variable bh_tbl-key       as handle    no-undo .
      171       assign
      172         p-key-rec = trim( p-key-rec )
      173       .
      174       if p-key-handle <> ? then do:
      175         if not valid-handle(p-key-handle)
      176            or p-key-handle:type <> "buffer"
      177         then do:
      178           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      179         end.
      180         if num-entries( p-key-rec, chr(3) ) > 1
      181           or p-key-rec = ?
      182           or p-key-rec = "":U
      183         then do:
      184           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      185         end.
      186       end.
      187       else do:
      188         if p-key-rec = ?
      189           or p-key-rec = "":U
      190         then do:
      191           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      192         end.
      193       end.
      194       assign
      195         vTable = entry( 1 , p-key-rec, chr(3) )
      196       .
      197       if p-tt-handle <> ?
      198         and ( not valid-handle(p-tt-handle)
      199               or p-tt-handle:type <> "buffer"
      200             )
      201       then do:
      202         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      203       end.
      204       if p-tt-handle = ? then do:
      205         assign
      206           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      207         .
      208         create buffer bh_tbl-name for table v-full-tbl-name .
      209       end.
      210       else do:
      211         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      212       end.
      213       assign
      214         v-inform = bh_tbl-name:index-information(1)
      215         v-ind    = 2
      216       .
      217       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      218       on error undo, return error
      219       :
      220         assign
      221           v-inform = bh_tbl-name:index-information( v-ind )
      222           v-ind    = v-ind + 1
      223         .
      224       end.
      225       if v-inform = ?
      226         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      227         or entry( 3, v-inform, ",":U ) <> "1":U
      228       then do:
      229         delete object bh_tbl-name no-error.
      230         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      231       end.
      232       assign
      233         v-idx-field-qnty = num-entries( v-inform ) - 4
      234       .
      235       if v-idx-field-qnty < 2 then do:
      236         delete object bh_tbl-name no-error.
      237         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      238       end.
      239       assign
      240         o-where     = "where":U
      241         v-word-link = "":U
      242         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      243         v-count-fld = 0
      244       .
      245       if i-tablekey ne "" and i-tablekey ne ?
      246       then do:
      247         assign
      248           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      249         .
      250         create buffer bh_tbl-key for table v-full-tbl-name .
      251       end.
      252       if i-tableSerach ne "" and i-tableSerach ne ?
      253       then do:
      254         delete object bh_tbl-name no-error.
      255         assign
      256           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      257         .
      258         create buffer bh_tbl-name for table v-full-tbl-name .
      259       end.
      260       block_where:
      261       do v-ind = 1 to v-idx-field-qnty by 2
      262       on error undo, return error
      263       :
      264         assign
      265           v-count-fld = v-count-fld + 1
      266         .
      267         if p-key-handle = ?
      268           and v-count-fld > v-field-num
      269         then do:
      270           leave block_where.
      271         end.
      272         define variable VfieldKeyTable as handle no-undo.
      273         assign
      274           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      275           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      276         .
      277         if     bh_tbl-key ne ?
      278         then do:
      279            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      280            if VfieldKeyTable eq ?
      281            then next block_where.
      282         end.
      283         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      284         then
      285            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      286         else
      287            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      288         if p-key-handle = ? then do:
      289           assign
      290             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      291           .
      292         end.
      293         else do:
      294           assign
      295             fh_key = p-key-handle:buffer-field( v-field-name )
      296           .
      297           if fh_key = ?
      298             or not valid-handle( fh_key )
      299           then do:
      300             delete object bh_tbl-name.
      301             if     bh_tbl-key ne ?
      302             then
      303                delete object bh_tbl-key.
      304             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      305           end.
      306           assign
      307             v-field-val = fh_key:buffer-value
      308           .
      309         end.
      310         if fh_search:data-type ="character":U then do:
      311           assign
      312             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      313             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      314             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      315             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      316             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      317             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      318             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      319             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      320             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      321             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      322             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      323             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      324             v-field-val = substitute( '"&1"', v-field-val )
      325           .
      326         end.
      327         assign
      328           o-where = substitute( "&1 &2", o-where, v-field-val )
      329         .
      330         if v-word-link = "":U then do:
      331           assign
      332             v-word-link = "and":U
      333           .
      334         end.
      335       end.
      336       delete object bh_tbl-name.
      337       if     bh_tbl-key ne ?
      338       then
      339          delete object bh_tbl-key.
      340       if p-key-handle = ?
      341         and v-count-fld <> v-field-num
      342       then do:
      343         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      344       end.
      345     end.
      346   end procedure.
      347   procedure gen-hn-keyr-tab :
      348     define input  parameter i-tableSerach as character no-undo.
      349     define input  parameter i-tablekey   as character no-undo.
      350     define input  parameter p-key-rec    as character no-undo.
      351     define input  parameter p-key-handle as handle    no-undo .
      352     define input  parameter p-db-name    as character no-undo .
      353     define input  parameter p-tt-handle  as handle    no-undo .
      354     define input  parameter p-stts-lock  as integer   no-undo .
      355     define output parameter o-hn         as handle    no-undo.
      356     define variable v-full-tbl-name as character no-undo.
      357     define variable v-where         as character no-undo.
      358     define variable bh_tbl-name     as handle    no-undo.
      359     define variable vTable          as character no-undo.
      360     do
      361     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      362     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      363     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      364         run gen-where-keyr-tab(i-tableSerach,
      365                                i-tablekey,
      366                                p-key-rec,
      367                                p-key-handle,
      368                                p-db-name,
      369                                p-tt-handle,
      370                                output v-where).
      371         if i-tableSerach ne "" and i-tableSerach ne ?
      372         then do:
      373            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      374            create buffer bh_tbl-name for table v-full-tbl-name .
      375         end.
      376         else do:
      377            if p-tt-handle = ? then do:
      378               assign
      379                  vTable = entry( 1 , p-key-rec, chr(3) )
      380               .
      381               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      382               create buffer bh_tbl-name for table v-full-tbl-name .
      383            end.
      384            else do:
      385               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      386            end.
      387         end.
      388         if p-tt-handle = ? then do:
      389            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      390         end.
      391         else do:
      392            bh_tbl-name:find-first( v-where ) no-error .
      393         end.
      394         o-hn = bh_tbl-name.
      395      end.
      396   end procedure.
      397   procedure gen-hn-keyr :
      398     define input  parameter p-key-rec    as character no-undo.
      399     define input  parameter p-key-handle as handle    no-undo .
      400     define input  parameter p-db-name    as character no-undo .
      401     define input  parameter p-tt-handle  as handle    no-undo .
      402     define input  parameter p-stts-lock  as integer   no-undo .
      403     define output parameter o-hn         as handle    no-undo.
      404     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      405   end.
      406   procedure gen-row-keyr :
      407     define input  parameter p-key-rec    as character no-undo.
      408     define input  parameter p-key-handle as handle    no-undo .
      409     define input  parameter p-db-name    as character no-undo .
      410     define input  parameter p-tt-handle  as handle    no-undo .
      411     define input  parameter p-stts-lock  as integer   no-undo .
      412     define output parameter p-tbl-row    as rowid     no-undo.
      413     define output parameter p-tbl-name   as character no-undo.
      414     define variable vHn as handle no-undo.
      415       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      416       p-tbl-row = if vHn:available then vHn:rowid else ?.
      417       p-tbl-name =  vHn:table.
      418       delete object vHn no-error.
      419     if p-tbl-row = ? then do:
      420       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      421     end.
      422     else do:
      423       return.
      424     end.
      425   end procedure.
      426   procedure gen-key-fv :
      427     define input  parameter p-key-rec    as character no-undo .
      428     define output parameter p-field-list as character no-undo .
      429     define output parameter p-value-list as character no-undo.
      430     do
      431     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      432     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      433     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      434     :
      435       define variable v-full-tbl-name  as character no-undo .
      436       define variable bh_tbl-name      as handle    no-undo .
      437       define variable v-tbl-name       as character no-undo .
      438       define variable v-field-num      as integer   no-undo .
      439       define variable v-count-fld      as integer   no-undo .
      440       define variable v-inform         as character no-undo .
      441       define variable v-ind            as integer   no-undo .
      442       define variable v-idx-field-qnty as integer   no-undo .
      443       define variable v-delim-key      as character no-undo .
      444       if p-key-rec = ?
      445         or p-key-rec = "":U
      446       then do:
      447         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      448       end.
      449       assign
      450         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      451         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      452       .
      453       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      454       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      455       assign
      456         v-inform = bh_tbl-name:index-information(1)
      457         v-ind    = 2
      458       .
      459       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      460       on error undo, return error
      461       :
      462         assign
      463           v-inform = bh_tbl-name:index-information( v-ind )
      464           v-ind    = v-ind + 1
      465         .
      466       end.
      467       if v-inform = ?
      468         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      469         or entry( 3, v-inform, ",":U ) <> "1":U
      470       then do:
      471         delete object bh_tbl-name no-error.
      472         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      473       end.
      474       assign
      475         v-idx-field-qnty = num-entries( v-inform ) - 4
      476       .
      477       if v-idx-field-qnty < 2 then do:
      478         delete object bh_tbl-name no-error.
      479         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      480       end.
      481       assign
      482         p-field-list = "":U
      483         p-value-list = "":U
      484         v-delim-key  = "":U
      485         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      486         v-count-fld  = 0
      487       .
      488       block_where:
      489       do v-ind = 1 to v-idx-field-qnty by 2
      490       on error undo, return error
      491       :
      492         assign
      493           v-count-fld = v-count-fld + 1
      494         .
      495         if v-count-fld > v-field-num then do:
      496           leave block_where.
      497         end.
      498         assign
      499           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      500           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      501         .
      502         if v-ind = 1 then do:
      503           assign
      504             v-delim-key = chr(3)
      505           .
      506         end.
      507       end.
      508       delete object bh_tbl-name.
      509       if v-count-fld <> v-field-num then do:
      510         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      511       end.
      512     end.
      513   end procedure.
      514   procedure gen-key-field :
      515     define input  parameter p-table      as character no-undo .
      516     define output parameter p-field-list as character no-undo .
      517     do
      518     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      519     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      520     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      521     :
      522       define variable v-full-tbl-name  as character no-undo .
      523       define variable bh_tbl-name      as handle    no-undo .
      524       define variable v-tbl-name       as character no-undo .
      525       define variable v-field-num      as integer   no-undo .
      526       define variable v-count-fld      as integer   no-undo .
      527       define variable v-inform         as character no-undo .
      528       define variable v-ind            as integer   no-undo .
      529       define variable v-idx-field-qnty as integer   no-undo .
      530       define variable v-delim-key      as character no-undo .
      531       if p-table = ?
      532         or p-table = "":U
      533       then do:
      534         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      535       end.
      536       assign
      537         v-tbl-name      = p-table
      538         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      539       .
      540       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      541       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      542       assign
      543         v-inform = bh_tbl-name:index-information(1)
      544         v-ind    = 2
      545       .
      546       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      547       on error undo, return error
      548       :
      549         assign
      550           v-inform = bh_tbl-name:index-information( v-ind )
      551           v-ind    = v-ind + 1
      552         .
      553       end.
      554       if v-inform = ?
      555         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      556         or entry( 3, v-inform, ",":U ) <> "1":U
      557       then do:
      558         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      559       end.
      560       assign
      561         v-idx-field-qnty = num-entries( v-inform ) - 4
      562       .
      563       if v-idx-field-qnty < 2 then do:
      564         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      565       end.
      566       assign
      567         p-field-list = "":U
      568         v-delim-key  = "":U
      569         v-count-fld  = 0
      570       .
      571       block_where:
      572       do v-ind = 1 to v-idx-field-qnty by 2
      573       on error undo, return error
      574       :
      575         assign
      576           v-count-fld = v-count-fld + 1
      577         .
      578         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      579         if v-ind = 1 then do:
      580           assign
      581             v-delim-key = chr(3)
      582           .
      583         end.
      584       end.
      585       delete object bh_tbl-name.
      586     end.
      587   end procedure.
      588   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   procedure is-prt-bar-code :
      590   define input parameter p-b-code like ub.bar-code.b-code no-undo .
      591   define input parameter p-node-code like ub.bar-code.node-code no-undo .
      592   define input parameter p-part-code like ub.bar-code.part-code no-undo .
      593   define input parameter p-in-code    like ub.bar-code.in-code no-undo .
      594   define input parameter p-unit-cli   like ub.bar-code.unit-cli no-undo .
      595   define output parameter p-is as logical no-undo .
      596   define variable vss-description as character no-undo init "is-prt-bar-code-01: определяет является ли бар-код бар-кодом признака".
      597     do
      598     on error undo, return error
      599     :
      600       define buffer buf_gds-prt for ub.gds-prt.
      601       define buffer root_gds-prt for ub.gds-prt.
      602       find first buf_gds-prt no-lock where
      603                  buf_gds-prt.node-code = p-node-code  no-error .
      604       if not available buf_gds-prt then do:
      605         return error substitute( "&1. Не найден узел шкалы для бар-кода &2", vss-workfile, string(p-b-code) ).
      606       end.
      607       find first root_gds-prt no-lock where
      608                  root_gds-prt.prt-root = buf_gds-prt.prt-root
      609             AND  root_gds-prt.root     = yes no-error .
      610       if not avail root_gds-prt
      611       or root_gds-prt.node-name = '_Пустая шкала':U
      612       then do:
      613         return error substitute( "&1. Узел шкалы для бар-кода &2, относится к <ПУСТОЙ ШКАЛЕ>", vss-workfile, string(p-b-code) ).
      614       end.
      615       if p-in-code <> "":u
      616       and root_gds-prt.root = yes
      617       then do:
      618         return error substitute( "&1. Бар-код &2, является бар-кодом ПАРТИИ", vss-workfile, string(p-b-code) ).
      619       end.
      620       assign
      621       p-is = yes
      622       .
      623       return "":U.
      624     end.
      625   end procedure.
      626   procedure is-part-bar-code :
      627   define input parameter p-b-code like ub.bar-code.b-code no-undo .
      628   define input parameter p-node-code like ub.bar-code.node-code no-undo .
      629   define input parameter p-part-code like ub.bar-code.part-code no-undo .
      630   define input parameter p-in-code    like ub.bar-code.in-code no-undo .
      631   define input parameter p-unit-cli   like ub.bar-code.unit-cli no-undo .
      632   define output parameter p-is as logical no-undo .
      633   define variable vss-description as character no-undo init "is-part-bar-code-01: определяет является ли бар-код партионным".
      634     do
      635     on error undo, return error
      636     :
      637       define buffer buf_gds-prt for ub.gds-prt.
      638       find first buf_gds-prt no-lock where
      639                  buf_gds-prt.node-code = p-node-code  no-error .
      640       if not available buf_gds-prt
      641       then do:
      642         return error substitute( "&1. Не найден узел шкалы для бар-кода &2", vss-workfile, string(p-b-code) ).
      643       end.
      644       if p-in-code = "":U then do:
      645         return error substitute( "&1. Бар-код &2, относится НЕ к <ПАРТИИ>", vss-workfile, string(p-b-code) ).
      646       end.
      647       if buf_gds-prt.root <> yes
      648       then do:
      649         return error substitute( "&1. Узел шкалы для бар-кода &2, не является корневым", vss-workfile, string(p-b-code) ).
      650       end.
      651       assign
      652       p-is = yes
      653       .
      654       return "":U.
      655     end.
      656   end procedure.
      657   procedure is-ucli-bar-code :
      658   define input parameter p-b-code like ub.bar-code.b-code no-undo .
      659   define input parameter p-node-code like ub.bar-code.node-code no-undo .
      660   define input parameter p-part-code like ub.bar-code.part-code no-undo .
      661   define input parameter p-in-code    like ub.bar-code.in-code no-undo .
      662   define input parameter p-unit-cli   like ub.bar-code.unit-cli no-undo .
      663   define input parameter p-gds-code like ub.bar-code.gds-code no-undo .
      664   define output parameter p-is as logical no-undo .
      665   define variable vss-description as character no-undo init "is-ucli-bar-code-01: определяет является ли бар-код бар-кодом на доп.ед.изм.".
      666     do
      667     on error undo, return error
      668     :
      669       define buffer buf_goods for ub.goods.
      670       find first buf_goods no-lock where
      671                 buf_goods.gds-code = p-gds-code no-error .
      672       if not available buf_goods then do:
      673         return error substitute( "&1. Не найден товар для бар-кода &2", vss-workfile, string(p-b-code) ).
      674       end.
      675       if buf_goods.unit-base = p-unit-cli then do:
      676         return error substitute( "&1. Бар-код &2, относится к осн ед.изм.: осн.ид.изм. &3, ед.изм.бар-кода &4", vss-workfile, string(p-b-code), buf_goods.unit-base, p-unit-cli).
      677       end.
      678       assign
      679       p-is = yes
      680       .
      681       return "":U.
      682     end.
      683   end procedure.
      684   def new shared var bc-frmt as character no-undo .
      685   def new shared var bc-pfx  as character no-undo .
      686   def var bc-par-type as character no-undo .
      687       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      688       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      689           do:
      690               message "Не задан или не верно задан ТИП собственного бар-кода!"
      691                   view-as alert-box ERROR TITLE "".
      692               return error.
      693           end.
      694       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      695       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      696           do:
      697               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      698                   view-as alert-box ERROR TITLE "".
      699               return error.
      700           end.
      701   PROCEDURE gen-bc:
      702     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      703     def output parameter full-b-code     as character init ""    no-undo .
      704   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      705     define variable tmp-str2  as character no-undo.
      706     define variable tmp-num2  as character no-undo.
      707     define variable i2        as integer   no-undo.
      708     define variable sum2      as integer   no-undo.
      709     define variable len-code2 as integer   no-undo.
      710     define variable varcont2  as logical   initial yes no-undo.
      711     CASE bc-frmt :
      712       WHEN "EAN13" THEN do:
      713         assign
      714           tmp-str2 = string( internal-b-code, "999999999999" )
      715         .
      716       end.
      717       WHEN "EAN8" THEN do:
      718         assign
      719           tmp-str2 = string( internal-b-code, "9999999" )
      720         .
      721       end.
      722       OTHERWISE DO:
      723           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      724           view-as alert-box error.
      725           return error.
      726       END.
      727     END CASE.
      728     if varcont2 = yes then do:
      729       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
      730       then do:
      731         message
      732           "Невозможно сформировать бар-код" SKIP
      733           "для товара с кодом: " internal-b-code
      734           view-as alert-box error title "подрезание кода".
      735         return error.
      736       end.
      737       else do:
      738         assign
      739           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
      740           len-code2    = length( full-b-code )
      741         .
      742         define variable v-sum-char2 as character no-undo .
      743         assign
      744           sum2 = 0
      745         .
      746         do i2 = 1 to len-code2 by 2
      747         :
      748           assign
      749             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      750           .
      751           if v-sum-char2 < "0"
      752           or v-sum-char2 > "9"
      753           then do:
      754             message
      755               "Невозможно сформировать бар-код" skip
      756               "для товара с кодом: " internal-b-code skip
      757               view-as alert-box error title "подсчет контрольной суммы".
      758             return error.
      759           end.
      760           assign
      761             sum2 = sum2 + integer(v-sum-char2)
      762           .
      763         end.
      764         if varcont2 = yes then do:
      765           assign
      766             sum2 = sum2 * 3
      767           .
      768           do i2 = 2 to len-code2 by 2
      769           :
      770             assign
      771               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      772             .
      773             if v-sum-char2 < "0"
      774             or v-sum-char2 > "9"
      775             then do:
      776               message
      777                 "Невозможно сформировать бар-код" skip
      778                 "для товара с кодом: " internal-b-code skip
      779                 view-as alert-box error title "подсчет контрольной суммы".
      780               return error.
      781             end.
      782             assign
      783               sum2 = sum2 + integer(v-sum-char2)
      784             .
      785           end.
      786           if varcont2 = yes then do:
      787              if sum2 mod 10 = 0 then do:
      788                assign
      789                  full-b-code = full-b-code + '0'
      790                .
      791              end.
      792              else do:
      793                assign
      794                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      795                .
      796              end.
      797           end.
      798         end.
      799       end.
      800     end.
      801   END PROCEDURE.
      802   procedure block-del-prt-bar-code :
      803   define input  parameter pc-db-num       like ub.db-rec-attr.db-num       no-undo .
      804   define input  parameter pc-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
      805   define input  parameter pc-attr-code    like ub.db-rec-attr.attr-code    no-undo .
      806   define input  parameter pc-parameters   as   character                   no-undo .
      807   define output parameter pc-err-msg      as   character                   no-undo .
      808     do
      809     on error undo, return error
      810     :
      811       define variable v-rowid    as rowid     no-undo .
      812       define variable v-tbl-name as character no-undo .
      813       define variable v-is-prt-bar-code as logical no-undo .
      814       define variable l-terminal-prt as logical no-undo .
      815       define variable l-is-used as logical no-undo init yes.
      816       define variable v-old-stts as integer no-undo .
      817       define buffer buf_bar-code for ub.bar-code.
      818       define buffer buf_gds-prt for ub.gds-prt.
      819       run gen-row-keyr in this-procedure
      820         ( input  pc-uniq-key-rec
      821          ,input ?
      822          ,input "ub":U
      823          ,input ?
      824          ,input share-lock
      825          ,output v-rowid
      826          ,output v-tbl-name
      827         ) no-error .
      828       if error-status :error then do:
      829         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. &3 &4", vss-workfile, pc-uniq-key-rec, chr(10), return-value ).
      830       end.
      831       if v-tbl-name <> 'bar-code':U then do:
      832         return error substitute( "&1. Данная процедура может работать только с таблицей бар-кодов", vss-workfile ).
      833       end.
      834       find first buf_bar-code
      835         where rowid( buf_bar-code ) = v-rowid
      836         no-error .
      837       if not available buf_bar-code then do:
      838         return error substitute( "&1. Нет необходимого бар-кода &2", vss-workfile, pc-uniq-key-rec ).
      839       end.
      840       if buf_bar-code.stts = integer('99':U) then do:
      841         assign
      842         pc-err-msg = substitute( "Бар-код &1 уже заблокирован или удален!!! Блокировка невозможна!!!", pc-uniq-key-rec )
      843         .
      844         return .
      845       end.
      846       if buf_bar-code.stts_ <> 0
      847       and not (buf_bar-code.stts_ = integer('79':U))
      848       then do:
      849         return error substitute( "&1. Необходимый бар-код &2 находится в статусе &3", vss-workfile, buf_bar-code.b-code, buf_bar-code.stts_  ).
      850       end.
      851       run is-prt-bar-code in this-procedure (
      852                                              input buf_bar-code.b-code
      853                                             ,input buf_bar-code.node-code
      854                                             ,input buf_bar-code.part-code
      855                                             ,input buf_bar-code.in-code
      856                                             ,input buf_bar-code.unit-cli
      857                                             ,output v-is-prt-bar-code) no-error .
      858       if error-status:error then do:
      859         return error substitute( "&1. Ошибка при проверке является ли бар-код &2 бар-кодом признака: &3", vss-workfile, buf_bar-code.b-code, return-value ).
      860       end.
      861       if not v-is-prt-bar-code then do:
      862         return error substitute( "&1. Бар-код &2 не является бар-кодом признака", vss-workfile, buf_bar-code.b-code ).
      863       end.
      864       find first buf_gds-prt no-lock where
      865                  buf_gds-prt.node-code = buf_bar-code.node-code  no-error .
      866       if not available buf_gds-prt then do:
      867         return error substitute( "&1. Не найден узел шкалы для бар-кода &2", vss-workfile, buf_bar-code.b-code ).
      868       end.
      869   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      870     (input  buf_gds-prt.node-code
      871     ,input  'terminal-prt=request':u
      872     ,output l-terminal-prt
      873     ) no-error .
      874       if error-status :error
      875       then do:
      876         message return-value error-status:get-message(1) view-as alert-box .
      877         return error substitute( "&1. Ошибка при определении терминальности признака для бар-кода &2", vss-workfile, buf_bar-code.b-code ).
      878       end.
      879       do
      880       on error undo, return error
      881       on stop undo, return error
      882       :
      883         assign
      884         v-old-stts = buf_bar-code.stts_
      885         buf_bar-code.stts_ = integer('99':U)
      886         .
      887         run proc-is-used-prt-bar-code in this-procedure (buffer buf_bar-code, input pc-db-num, input l-terminal-prt, output l-is-used) no-error .
      888         if error-status :error
      889         then do:
      890           undo, return error substitute( "&1. Ошибка при проверке на использование в товародвижении бар-кода &2:&3&4"
      891                                         , vss-workfile
      892                                         , buf_bar-code.b-code
      893                                         , chr(10)
      894                                         , error-status:get-message(1)
      895                                         ).
      896         end.
      897         if l-is-used then do:
      898           assign
      899           buf_bar-code.stts_ = v-old-stts
      900           pc-err-msg = substitute( "&1. Бар-код &2 используется в товародвижении:&3&4"
      901                                    , vss-workfile
      902                                    , buf_bar-code.b-code
      903                                    , chr(10)
      904                                    , return-value
      905                                     )
      906           .
      907           return pc-err-msg.
      908         end.
      909       end.
      910     end.
      911   end procedure.
      912   procedure delete-prt-bar-code :
      913   define input  parameter pe-db-num       like ub.db-rec-attr.db-num       no-undo .
      914   define input  parameter pe-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
      915   define input  parameter pe-attr-code    like ub.db-rec-attr.attr-code    no-undo .
      916   define input  parameter pe-parameters   as   character                   no-undo .
      917   define output parameter pe-err-msg      as   character                   no-undo .
      918     do
      919     on error undo, return error
      920     :
      921       define variable v-rowid            as rowid     no-undo .
      922       define variable v-tbl-name         as character no-undo .
      923       define variable v_bp-rowid         as rowid     no-undo .
      924       define variable v-is-prt-bar-code as logical no-undo .
      925       define variable v-b-code like ub.bar-code.b-code no-undo .
      926       define variable l-is-used          as logical    no-undo .
      927       define buffer buf_bar-code         for ub.bar-code .
      928       run gen-row-keyr in this-procedure
      929         ( input  pe-uniq-key-rec
      930          ,input ?
      931          ,input "ub":U
      932          ,input ?
      933          ,input share-lock
      934          ,output v-rowid
      935          ,output v-tbl-name
      936         ) no-error .
      937       if error-status :error then do:
      938         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pe-uniq-key-rec, return-value ).
      939       end.
      940       if v-tbl-name <> 'bar-code':U then do:
      941         return error substitute( "&1. Данная процедура может работать только с таблицей бар-кодов", vss-workfile ).
      942       end.
      943       assign
      944       v-b-code = integer(entry(1, pe-parameters, chr(4)))
      945       .
      946       find first buf_bar-code exclusive-lock where
      947                 buf_bar-code.b-code = v-b-code no-wait no-error.
      948       if not available buf_bar-code
      949       and not locked(buf_bar-code) then do:
      950         find first buf_bar-code no-lock where
      951                     buf_bar-code.b-code = v-b-code no-error.
      952         if not available buf_bar-code then return.
      953       end.
      954       if not available buf_bar-code then do:
      955         return error substitute( "&1. Не найден или занят бар-код &2", vss-workfile, v-b-code ).
      956       end.
      957       if buf_bar-code.stts_ <> integer('99':U) then do:
      958         return error substitute( "&1. Бар-код &2 не заблокирован для удаления", vss-workfile, buf_bar-code.b-code ).
      959       end.
      960       run is-prt-bar-code in this-procedure (
      961                                              input buf_bar-code.b-code
      962                                             ,input buf_bar-code.node-code
      963                                             ,input buf_bar-code.part-code
      964                                             ,input buf_bar-code.in-code
      965                                             ,input buf_bar-code.unit-cli
      966                                             , output v-is-prt-bar-code) no-error .
      967       if error-status:error then do:
      968         return error substitute( "&1. Ошибка при проверке является ли бар-код &2 бар-кодом признака: &3", vss-workfile, buf_bar-code.b-code, return-value ).
      969       end.
      970       if not v-is-prt-bar-code then do:
      971         return error substitute( "&1. Бар-код &2 не является бар-кодом признака", vss-workfile, buf_bar-code.b-code).
      972       end.
      973       run proc-is-used-prt-bar-code in this-procedure (buffer buf_bar-code, input pe-db-num, input ?, output l-is-used) no-error .
      974       if error-status :error
      975       then do:
      976         undo, return error substitute( "&1. Ошибка при проверке на использование в товародвижении бар-кода &2:&3&4"
      977                                        , vss-workfile
      978                                        , buf_bar-code.b-code
      979                                        , chr(10)
      980                                        , error-status:get-message(1)
      981                                          ).
      982       end.
      983       if l-is-used then do:
      984         undo, return error substitute( "&1. Бар-код &2 используется в товародвижении&3&4"
      985                                       , vss-workfile
      986                                       , buf_bar-code.b-code
      987                                       , chr(10)
      988                                       , return-value
      989                                       ).
      990       end.
      991       do
      992       on error undo, return error
      993       on stop undo, return error
      994       :
      995         delete buf_bar-code.
      996       end.
      997     end.
      998   end procedure.
      999   procedure undo-delete-prt-bar-code :
     1000   define input  parameter pr-db-num       like ub.db-rec-attr.db-num       no-undo .
     1001   define input  parameter pr-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1002   define input  parameter pr-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1003   define input  parameter pr-parameters   as   character                   no-undo .
     1004   define output parameter pr-err-msg      as   character                   no-undo .
     1005     do
     1006     on error undo, return error
     1007     :
     1008       define variable v-rowid            as rowid     no-undo .
     1009       define variable v-tbl-name         as character no-undo .
     1010       define variable v_bp-rowid         as rowid     no-undo .
     1011       define variable v-gds-code like ub.goods.gds-code no-undo .
     1012       define variable v-b-code like ub.bar-code.b-code no-undo .
     1013       define variable v-node-code like ub.bar-code.node-code no-undo .
     1014       define variable v-part-code like ub.bar-code.part-code no-undo .
     1015       define variable v-in-code    like ub.bar-code.in-code no-undo .
     1016       define variable v-unit-cli   like ub.bar-code.unit-cli no-undo .
     1017       define variable v-cli-base-rate like ub.bar-code.cli-base-rate no-undo .
     1018       define variable v-new  as logical no-undo .
     1019       define variable v-old-stts as integer no-undo .
     1020       define buffer buf_db-rec-attr    for ub.db-rec-attr .
     1021       define buffer buf_bar-code       for ub.bar-code    .
     1022       run gen-row-keyr in this-procedure
     1023         ( input  pr-uniq-key-rec
     1024          ,input ?
     1025          ,input "ub":U
     1026          ,input ?
     1027          ,input share-lock
     1028          ,output v-rowid
     1029          ,output v-tbl-name
     1030         ) no-error .
     1031       if error-status :error then do:
     1032         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pr-uniq-key-rec, return-value ).
     1033       end.
     1034       if v-tbl-name <> 'bar-code':U then do:
     1035         return error substitute( "&1. Данная процедура может работать только с таблицей бар-кодов", vss-workfile ).
     1036       end.
     1037       find first buf_bar-code exclusive-lock where
     1038                  rowid(buf_bar-code) = v-rowid no-error  .
     1039       if not available buf_bar-code then do:
     1040         assign
     1041         v-b-code = integer(entry(1, pr-parameters, chr(4)))
     1042         v-old-stts = integer(entry(8, pr-parameters, chr(4)))
     1043         .
     1044         find first buf_bar-code exclusive-lock where
     1045                    buf_bar-code.b-code = v-b-code no-error no-wait.
     1046         if not available buf_bar-code
     1047         AND not LOCKED(buf_bar-code)
     1048         then do:
     1049           find first buf_bar-code no-lock where
     1050                    buf_bar-code.b-code = v-b-code no-error.
     1051           if not available buf_bar-code then do:
     1052             return .
     1053           end.
     1054           return error substitute( "&1. Нт найден или занят бакрод &2", vss-workfile, v-b-code ).
     1055         end.
     1056       end.
     1057       do
     1058       on error undo, return error
     1059       on stop undo, return error
     1060       :
     1061         if buf_bar-code.stts_ = integer('99':U) then do:
     1062           assign
     1063           buf_bar-code.stts_ = v-old-stts.
     1064           release buf_bar-code.
     1065         end.
     1066       end.
     1067     end.
     1068   end procedure.
     1069   procedure proc-is-used-prt-bar-code :
     1070   define parameter buffer buf_bar-code for ub.bar-code.
     1071   define input parameter p-db-num like ub.db.db-num no-undo .
     1072   define input parameter p-terminal-prt  as logical no-undo .
     1073   define output parameter p-is-used as logical no-undo init yes.
     1074     do
     1075     on error undo, return error
     1076     :
     1077       define variable v-artic  like ub.goods.artic no-undo .
     1078       define variable v-prod-type  like ub.goods.prod-type no-undo .
     1079       define variable v-prod-code  like ub.goods.prod-code no-undo .
     1080       define variable v-is-prt-bar-code as logical no-undo .
     1081       define buffer buf_goods for ub.goods.
     1082       define buffer buf_prt-obj for ub.prt-obj.
     1083       define buffer buf_prod-bc for ub.prod-bc.
     1084       define buffer buf_prod-bc-db for ub.prod-bc-db.
     1085       define buffer buf_clients for ub.clients.
     1086       define buffer buf_chk-gds for ub.chk-gds.
     1087       define buffer buf_scales-gds for ub.scales-gds.
     1088       define buffer buf_sert-join for ub.sert-join.
     1089       define buffer buf_price-list for ub.price-list.
     1090       define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds.
     1091       define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     1092       define buffer buf_gds-dtl for ub.gds-dtl.
     1093       define buffer buf_ord-dtl for ub.ord-dtl.
     1094       define buffer buf_ord-dtl-cons for ub.ord-dtl-cons.
     1095       define buffer buf_ord-dtl-rcv for ub.ord-dtl-rcv.
     1096       define buffer buf_tmp-sale-dtl for ub.tmp-sale-dtl.
     1097       run is-prt-bar-code in this-procedure (
     1098                                              input buf_bar-code.b-code
     1099                                             ,input buf_bar-code.node-code
     1100                                             ,input buf_bar-code.part-code
     1101                                             ,input buf_bar-code.in-code
     1102                                             ,input buf_bar-code.unit-cli
     1103                                             , output v-is-prt-bar-code) no-error .
     1104       if error-status:error then do:
     1105         return error substitute( "&1. Ошибка при проверке является ли бар-код &2 бар-кодом признака: &3", vss-workfile, string(buf_bar-code.b-code), return-value ).
     1106       end.
     1107       if not v-is-prt-bar-code then do:
     1108         return error substitute( "&1. Бар-код &2 не является бар-кодом признака", vss-workfile, buf_bar-code.b-code).
     1109       end.
     1110       find first buf_goods no-lock where
     1111                  buf_goods.gds-code = buf_bar-code.gds-code no-error .
     1112       if not avail buf_goods then return error.
     1113       find first buf_prt-obj no-lock where
     1114                  buf_prt-obj.artic = buf_goods.artic
     1115              AND buf_prt-obj.prod-type = buf_goods.prod-type
     1116              AND buf_prt-obj.prod-code = buf_goods.prod-code
     1117              AND buf_prt-obj.prt-code  = buf_bar-code.node-code no-error .
     1118       if available buf_prt-obj then
     1119       return substitute("prt-obj объект &1&2", buf_prt-obj.obj-type, buf_prt-obj.obj-code).
     1120       find first buf_prod-bc no-lock where
     1121                  buf_prod-bc.b-code = buf_bar-code.b-code no-error .
     1122       if available buf_prod-bc then
     1123       return substitute("prod-bc ДопБК &1" + buf_prod-bc.b-str).
     1124       find first buf_prod-bc-db no-lock where
     1125                  buf_prod-bc-db.b-code = buf_bar-code.b-code no-error .
     1126       if available buf_prod-bc-db then
     1127       return substitute("prod-bc-db ДопБК &1" + buf_prod-bc-db.b-str).
     1128       find first buf_sert-join no-lock where
     1129                  buf_sert-join.b-code = buf_bar-code.b-code no-error .
     1130       if available buf_sert-join then
     1131       return substitute("sert-join Сертификат &1" + buf_sert-join.sert-code).
     1132       find first buf_ord-dtl no-lock where
     1133                  buf_ord-dtl.artic = buf_goods.artic
     1134              AND buf_ord-dtl.prod-type = buf_goods.prod-type
     1135              AND buf_ord-dtl.prod-code = buf_goods.prod-code
     1136              AND buf_ord-dtl.node-code = buf_bar-code.node-code   no-error .
     1137       if available buf_ord-dtl then
     1138       return substitute("ord-dtl Код заказа &1" + buf_ord-dtl.doc-code).
     1139       find first buf_ord-dtl-cons no-lock where
     1140                  buf_ord-dtl-cons.artic = buf_goods.artic
     1141              AND buf_ord-dtl-cons.prod-type = buf_goods.prod-type
     1142              AND buf_ord-dtl-cons.prod-code = buf_goods.prod-code
     1143              AND buf_ord-dtl-cons.node-code = buf_bar-code.node-code   no-error .
     1144       if available buf_ord-dtl-cons then
     1145       return substitute("ord-dtl-cons Код заказа &1" + buf_ord-dtl-cons.cons-code).
     1146       find first buf_ord-dtl-rcv no-lock where
     1147                  buf_ord-dtl-rcv.artic = buf_goods.artic
     1148              AND buf_ord-dtl-rcv.prod-type = buf_goods.prod-type
     1149              AND buf_ord-dtl-rcv.prod-code = buf_goods.prod-code
     1150              AND buf_ord-dtl-rcv.node-code = buf_bar-code.node-code   no-error .
     1151       if available buf_ord-dtl-rcv then
     1152       return substitute("ord-dtl-rcv Код заказа &1" + buf_ord-dtl-rcv.doc-code).
     1153       find first buf_tmp-sale-dtl no-lock where
     1154                  buf_tmp-sale-dtl.artic = buf_goods.artic
     1155              AND buf_tmp-sale-dtl.prod-type = buf_goods.prod-type
     1156              AND buf_tmp-sale-dtl.prod-code = buf_goods.prod-code
     1157              AND buf_tmp-sale-dtl.node-code = buf_bar-code.node-code   no-error .
     1158       if available buf_tmp-sale-dtl then
     1159       return substitute("tmp-sale-dtl Код типа темпов продаж &1", buf_tmp-sale-dtl.tmp-code).
     1160       for each buf_clients no-lock where
     1161                p-db-num = 0
     1162             or buf_clients.db-num = p-db-num:
     1163         find first buf_price-list no-lock where
     1164                    buf_price-list.obj-type = buf_clients.obj-type
     1165                AND buf_price-list.obj-code = buf_clients.obj-code
     1166                AND buf_price-list.b-code   = buf_bar-code.b-code no-error .
     1167         if available buf_price-list then
     1168         return substitute("price-list объект &1&2 Номер переоценки &3",
     1169                            buf_price-list.obj-type, string(buf_price-list.obj-code),  buf_price-list.doc-num   ).
     1170         find first buf_gds-dtl no-lock where
     1171                    buf_gds-dtl.obj-type = buf_clients.obj-type
     1172                AND buf_gds-dtl.obj-code = buf_clients.obj-code
     1173                AND buf_gds-dtl.prod-type = buf_goods.prod-type
     1174                AND buf_gds-dtl.prod-code = buf_goods.prod-code
     1175                AND buf_gds-dtl.artic = buf_goods.artic
     1176                AND buf_gds-dtl.prt-code = buf_bar-code.node-code no-error .
     1177        if available buf_gds-dtl then
     1178        return substitute("gds-dtl объект &1&2 Номер накладной &3",
     1179                           buf_gds-dtl.obj-type, string(buf_gds-dtl.obj-code),  buf_gds-dtl.doc-code  ).
     1180       end.
     1181       find first buf_chk-gds no-lock where
     1182               buf_chk-gds.b-code = buf_bar-code.b-code  no-error .
     1183       if available buf_chk-gds then
     1184       return substitute("chk-gds Чек &1", buf_chk-gds.doc-code).
     1185       find first buf_price-doc-forming-gds no-lock where
     1186                 buf_price-doc-forming-gds.b-code   = buf_bar-code.b-code no-error .
     1187       if available buf_price-doc-forming-gds then
     1188       return substitute("price-doc-forming-gds Номер ДНЦ &1 БД &2"
     1189                           ,  buf_price-doc-forming-gds.pdf-id
     1190                           ,  buf_price-doc-forming-gds.pdf-db  ).
     1191       for each buf_dis-gds-rule no-lock where
     1192               buf_dis-gds-rule.gds-code = buf_bar-code.gds-code:
     1193         if buf_dis-gds-rule.nonunique = string(buf_bar-code.b-code) then do:
     1194           return substitute("dis-gds-rule Роль скидки &1 Объект &2&3"
     1195                               , buf_dis-gds-rule.discnt-role
     1196                               , buf_dis-gds-rule.obj-type
     1197                               , buf_dis-gds-rule.obj-code
     1198                                 ).
     1199         end.
     1200       end.
     1201       assign
     1202       p-is-used = no
     1203       .
     1204       return "":U.
     1205     end.
     1206   end procedure.
     1207   procedure block-del-part-bar-code :
     1208   define input  parameter pc-db-num       like ub.db-rec-attr.db-num       no-undo .
     1209   define input  parameter pc-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1210   define input  parameter pc-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1211   define input  parameter pc-parameters   as   character                   no-undo .
     1212   define output parameter pc-err-msg      as   character                   no-undo .
     1213     do
     1214     on error undo, return error
     1215     :
     1216       define variable v-rowid    as rowid     no-undo .
     1217       define variable v-tbl-name as character no-undo .
     1218       define variable v-is-part-bar-code as logical no-undo .
     1219       define variable l-is-used as logical no-undo init yes.
     1220       define variable v-old-stts as integer no-undo .
     1221       define buffer buf_bar-code for ub.bar-code.
     1222       define buffer buf_gds-prt for ub.gds-prt.
     1223       run gen-row-keyr in this-procedure
     1224         ( input  pc-uniq-key-rec
     1225          ,input ?
     1226          ,input "ub":U
     1227          ,input ?
     1228          ,input share-lock
     1229          ,output v-rowid
     1230          ,output v-tbl-name
     1231         ) no-error .
     1232       if error-status :error then do:
     1233         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. &3 &4", vss-workfile, pc-uniq-key-rec, chr(10), return-value ).
     1234       end.
     1235       if v-tbl-name <> 'bar-code':U then do:
     1236         return error substitute( "&1. Данная процедура может работать только с таблицей бар-кодов", vss-workfile ).
     1237       end.
     1238       find first buf_bar-code
     1239         where rowid( buf_bar-code ) = v-rowid
     1240         no-error .
     1241       if not available buf_bar-code then do:
     1242         return error substitute( "&1. Нет необходимого бар-кода &2", vss-workfile, pc-uniq-key-rec ).
     1243       end.
     1244       if buf_bar-code.stts = integer('99':U) then do:
     1245         assign
     1246         pc-err-msg = substitute( "Бар-код &1 уже заблокирован или удален!!! Блокировка невозможна!!!", pc-uniq-key-rec )
     1247         .
     1248         return .
     1249       end.
     1250       if buf_bar-code.stts_ <> 0
     1251       and not (buf_bar-code.stts = integer('79':U))
     1252       then do:
     1253         return error substitute( "&1. Необходимый бар-код &2 находится в статусе &3", vss-workfile, buf_bar-code.b-code, buf_bar-code.stts_  ).
     1254       end.
     1255       run is-part-bar-code in this-procedure (
     1256                                              input buf_bar-code.b-code
     1257                                             ,input buf_bar-code.node-code
     1258                                             ,input buf_bar-code.part-code
     1259                                             ,input buf_bar-code.in-code
     1260                                             ,input buf_bar-code.unit-cli
     1261                                             , output v-is-part-bar-code) no-error .
     1262       if error-status:error then do:
     1263         return error substitute( "&1. Ошибка при проверке является ли бар-код &2 бар-кодом партии: &3", vss-workfile, buf_bar-code.b-code, return-value ).
     1264       end.
     1265       if not v-is-part-bar-code then do:
     1266         return error substitute( "&1. Бар-код &2 не является бар-кодом партии", vss-workfile, buf_bar-code.b-code ).
     1267       end.
     1268       if buf_bar-code.stts_ <> 0
     1269       and not buf_bar-code.stts_ = integer('79':U)
     1270       then do:
     1271         return error substitute( "&1. Необходимый бар-код &2 находится в статусе &3", vss-workfile, buf_bar-code.b-code, buf_bar-code.stts_  ).
     1272       end.
     1273       do
     1274       on error undo, return error
     1275       on stop undo, return error
     1276       :
     1277         assign
     1278         v-old-stts = buf_bar-code.stts_
     1279         buf_bar-code.stts_ = integer('99':U)
     1280         .
     1281         run proc-is-used-part-bar-code in this-procedure (buffer buf_bar-code, input pc-db-num, output l-is-used) no-error .
     1282         if error-status:error  then do:
     1283           undo, return error substitute( "&1. Ошибка при проверке на использование в товародвижении бар-кода &2:&3&4"
     1284                                         , vss-workfile
     1285                                         , buf_bar-code.b-code
     1286                                         , chr(10)
     1287                                         , error-status:get-message(1)
     1288                                         ).
     1289         end.
     1290         if l-is-used then do:
     1291           assign
     1292           buf_bar-code.stts_ = v-old-stts
     1293           .
     1294           assign
     1295           pc-err-msg = substitute( "&1. Бар-код &2 используется в товародвижении:&3&4"
     1296                                     , vss-workfile
     1297                                     , buf_bar-code.b-code
     1298                                     , chr(10)
     1299                                     , return-value
     1300                                       )
     1301           .
     1302           return pc-err-msg.
     1303         end.
     1304       end.
     1305     end.
     1306   end procedure.
     1307   procedure delete-part-bar-code :
     1308   define input  parameter pe-db-num       like ub.db-rec-attr.db-num       no-undo .
     1309   define input  parameter pe-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1310   define input  parameter pe-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1311   define input  parameter pe-parameters   as   character                   no-undo .
     1312   define output parameter pe-err-msg      as   character                   no-undo .
     1313     do
     1314     on error undo, return error
     1315     :
     1316       define variable v-rowid            as rowid     no-undo .
     1317       define variable v-tbl-name         as character no-undo .
     1318       define variable v_bp-rowid         as rowid     no-undo .
     1319       define variable v-is-part-bar-code as logical no-undo .
     1320       define variable v-b-code           like ub.bar-code.b-code no-undo .
     1321       define variable l-is-used          as logical   no-undo .
     1322       define buffer buf_bar-code         for ub.bar-code .
     1323       run gen-row-keyr in this-procedure
     1324         ( input  pe-uniq-key-rec
     1325          ,input ?
     1326          ,input "ub":U
     1327          ,input ?
     1328          ,input share-lock
     1329          ,output v-rowid
     1330          ,output v-tbl-name
     1331         ) no-error .
     1332       if error-status :error then do:
     1333         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pe-uniq-key-rec, return-value ).
     1334       end.
     1335       if v-tbl-name <> 'bar-code':U then do:
     1336         return error substitute( "&1. Данная процедура может работать только с таблицей бар-кодов", vss-workfile ).
     1337       end.
     1338       assign
     1339       v-b-code = integer(entry(1, pe-parameters, chr(4)))
     1340       .
     1341       find first buf_bar-code exclusive-lock where
     1342                 buf_bar-code.b-code = v-b-code no-wait no-error.
     1343       if not available buf_bar-code
     1344       AND not locked(buf_bar-code) then do:
     1345         find first buf_bar-code no-lock where
     1346                     buf_bar-code.b-code = v-b-code no-error.
     1347         if not available buf_bar-code then return.
     1348       end.
     1349       if not available buf_bar-code then do:
     1350         return error substitute( "&1. Не найден или занят бар-код &2", vss-workfile, v-b-code ).
     1351       end.
     1352       if not available buf_bar-code then do:
     1353         return error substitute( "&1. Нет необходимого бар-кода &2", vss-workfile, v-b-code ).
     1354       end.
     1355       if buf_bar-code.stts_ <> integer('99':U) then do:
     1356         return error substitute( "&1. Бар-код &2 не заблокирован для удаления", vss-workfile, buf_bar-code.b-code ).
     1357       end.
     1358       run is-part-bar-code in this-procedure (
     1359                                              input buf_bar-code.b-code
     1360                                             ,input buf_Bar-code.node-code
     1361                                             ,input buf_Bar-code.part-code
     1362                                             ,input buf_Bar-code.in-code
     1363                                             ,input buf_Bar-code.unit-cli
     1364                                             , output v-is-part-bar-code) no-error .
     1365       if error-status:error then do:
     1366         return error substitute( "&1. Ошибка при проверке является ли бар-код &2 бар-кодом партии: &3", vss-workfile, buf_bar-code.b-code, return-value ).
     1367       end.
     1368       if not v-is-part-bar-code then do:
     1369         return error substitute( "&1. Бар-код &2 не является бар-кодом партии", vss-workfile, buf_bar-code.b-code).
     1370       end.
     1371       run proc-is-used-part-bar-code in this-procedure (buffer buf_bar-code, input pe-db-num, output l-is-used) no-error .
     1372       if error-status :error
     1373       then do:
     1374         undo, return error substitute( "&1. Ошибка при проверке на использование в товародвижении бар-кода &2:&3&4"
     1375                                         , vss-workfile
     1376                                         , buf_bar-code.b-code
     1377                                         , chr(10)
     1378                                         , error-status:get-message(1)
     1379                                         ).
     1380       end.
     1381       if l-is-used then do:
     1382         undo, return  error substitute( "&1. Бар-код &2 используется в товародвижении:&3&4"
     1383                                        , vss-workfile
     1384                                        , buf_bar-code.b-code
     1385                                        , chr(10)
     1386                                        , return-value
     1387                                        ).
     1388       end.
     1389       do
     1390       on error undo, return error
     1391       on stop undo, return error
     1392       :
     1393         delete buf_bar-code.
     1394       end.
     1395     end.
     1396   end procedure.
     1397   procedure undo-delete-part-bar-code :
     1398   define input  parameter pr-db-num       like ub.db-rec-attr.db-num       no-undo .
     1399   define input  parameter pr-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1400   define input  parameter pr-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1401   define input  parameter pr-parameters   as   character                   no-undo .
     1402   define output parameter pr-err-msg      as   character                   no-undo .
     1403     do
     1404     on error undo, return error
     1405     :
     1406       define variable v-rowid            as rowid     no-undo .
     1407       define variable v-tbl-name         as character no-undo .
     1408       define variable v_bp-rowid         as rowid     no-undo .
     1409       define variable v-gds-code like ub.goods.gds-code no-undo .
     1410       define variable v-b-code like ub.bar-code.b-code no-undo .
     1411       define variable v-node-code like ub.bar-code.node-code no-undo .
     1412       define variable v-part-code like ub.bar-code.part-code no-undo .
     1413       define variable v-in-code    like ub.bar-code.in-code no-undo .
     1414       define variable v-unit-cli   like ub.bar-code.unit-cli no-undo .
     1415       define variable v-cli-base-rate like ub.bar-code.cli-base-rate no-undo .
     1416       define variable v-new  as logical no-undo .
     1417       define variable v-old-stts as integer no-undo .
     1418       define buffer buf_db-rec-attr    for ub.db-rec-attr .
     1419       define buffer buf_bar-code       for ub.bar-code    .
     1420       run gen-row-keyr in this-procedure
     1421         ( input  pr-uniq-key-rec
     1422          ,input ?
     1423          ,input "ub":U
     1424          ,input ?
     1425          ,input share-lock
     1426          ,output v-rowid
     1427          ,output v-tbl-name
     1428         ) no-error .
     1429       if error-status :error then do:
     1430         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pr-uniq-key-rec, return-value ).
     1431       end.
     1432       if v-tbl-name <> 'bar-code':U then do:
     1433         return error substitute( "&1. Данная процедура может работать только с таблицей бар-кодов", vss-workfile ).
     1434       end.
     1435       find first buf_bar-code exclusive-lock where
     1436                  rowid(buf_bar-code) = v-rowid no-error  .
     1437       if not available buf_bar-code then do:
     1438         assign
     1439         v-b-code = integer(entry(1, pr-parameters, chr(4)))
     1440         v-old-stts = integer(entry(8, pr-parameters, chr(4)))
     1441         .
     1442         find first buf_bar-code exclusive-lock where
     1443                    buf_bar-code.b-code = v-b-code no-error no-wait.
     1444         if not available buf_bar-code
     1445         AND not LOCKED(buf_bar-code)
     1446         then do:
     1447           find first buf_bar-code no-lock where
     1448                    buf_bar-code.b-code = v-b-code no-error.
     1449           if not available buf_bar-code then do:
     1450             return .
     1451           end.
     1452           return error substitute( "&1. Не найден или занят бар-код &2", vss-workfile, v-b-code ).
     1453         end.
     1454       end.
     1455       do
     1456       on error undo, return error
     1457       on stop undo, return error
     1458       :
     1459         if buf_bar-code.stts_ = integer('99':U) then do:
     1460           assign
     1461           buf_bar-code.stts_ = v-old-stts.
     1462           release buf_bar-code.
     1463         end.
     1464         assign
     1465         v-gds-code  = integer(entry(2, pr-parameters, chr(4)))
     1466         v-node-code = integer(entry(3, pr-parameters, chr(4)))
     1467         v-part-code = entry(4, pr-parameters, chr(4))
     1468         v-in-code   = entry(5, pr-parameters, chr(4))
     1469         v-unit-cli  = entry(6, pr-parameters, chr(4))
     1470         v-cli-base-rate = integer(entry(7, pr-parameters, chr(4)))
     1471         v-old-stts = integer(entry(8, pr-parameters, chr(4)))
     1472         .
     1473       end.
     1474     end.
     1475   end procedure.
     1476   procedure proc-is-used-part-bar-code :
     1477   define parameter buffer buf_bar-code for ub.bar-code.
     1478   define input parameter p-db-num like ub.db.db-num no-undo .
     1479   define output parameter p-is-used as logical no-undo init yes.
     1480     do
     1481     on error undo, return error
     1482     :
     1483       define variable v-artic  like ub.goods.artic no-undo .
     1484       define variable v-prod-type  like ub.goods.prod-type no-undo .
     1485       define variable v-prod-code  like ub.goods.prod-code no-undo .
     1486       define variable v-is-part-bar-code as logical no-undo .
     1487       define buffer buf_goods for ub.goods.
     1488       define buffer buf_trn-doc for ub.trn-doc.
     1489       define buffer buf_doc-prts for ub.doc-prts.
     1490       define buffer buf_prod-bc for ub.prod-bc.
     1491       define buffer buf_prod-bc-db for ub.prod-bc-db.
     1492       define buffer buf_clients for ub.clients.
     1493       define buffer buf_chk-gds for ub.chk-gds.
     1494       define buffer buf_sert-join for ub.sert-join.
     1495       define buffer buf_price-list for ub.price-list.
     1496       define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds.
     1497       define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     1498       run is-part-bar-code in this-procedure (
     1499                                              input buf_bar-code.b-code
     1500                                             ,input buf_bar-code.node-code
     1501                                             ,input buf_bar-code.part-code
     1502                                             ,input buf_bar-code.in-code
     1503                                             ,input buf_bar-code.unit-cli
     1504                                             ,output v-is-part-bar-code) no-error .
     1505       if error-status:error then do:
     1506         return error substitute( "&1. Ошибка при проверке является ли бар-код &2 бар-кодом партии: &3", vss-workfile, string(buf_bar-code.b-code), return-value ).
     1507       end.
     1508       if not v-is-part-bar-code then do:
     1509         return error substitute( "&1. Бар-код &2 не является бар-кодом партии", vss-workfile, string(buf_bar-code.b-code) ).
     1510       end.
     1511       find first buf_goods no-lock where
     1512                  buf_goods.gds-code = buf_bar-code.gds-code no-error .
     1513       if not avail buf_goods then return error.
     1514       find first buf_trn-doc no-lock where
     1515                  buf_trn-doc.doc-code = buf_bar-code.in-code no-error .
     1516       if available buf_trn-doc then
     1517       return substitute("trn-doc объект &1&2 Номер документа &3",
     1518                          buf_trn-doc.obj-type, string(buf_trn-doc.obj-code),  buf_trn-doc.doc-code   ).
     1519       find first buf_prod-bc no-lock where
     1520                  buf_prod-bc.b-code = buf_bar-code.b-code no-error .
     1521       if available buf_prod-bc then
     1522       return substitute("prod-bc ДопБК &1", buf_prod-bc.b-str).
     1523       find first buf_prod-bc-db no-lock where
     1524                  buf_prod-bc-db.b-code = buf_bar-code.b-code no-error .
     1525       if available buf_prod-bc-db then
     1526       return substitute("prod-bc-db ДопБК &1", buf_prod-bc-db.b-str).
     1527       find first buf_sert-join no-lock where
     1528                  buf_sert-join.b-code = buf_bar-code.b-code no-error .
     1529       if available buf_sert-join then
     1530       return substitute("sert-join Сертификат &1", buf_sert-join.sert-code).
     1531       for each buf_clients no-lock where
     1532                p-db-num = 0
     1533             or buf_clients.db-num = p-db-num:
     1534         find first buf_price-list no-lock where
     1535                    buf_price-list.obj-type = buf_clients.obj-type
     1536                AND buf_price-list.obj-code = buf_clients.obj-code
     1537                AND buf_price-list.b-code   = buf_bar-code.b-code no-error .
     1538         if available buf_price-list then
     1539         return substitute("price-list объект &1&2 Номер переоценки &3",
     1540                            buf_price-list.obj-type, string(buf_price-list.obj-code),  buf_price-list.doc-num   ).
     1541       end.
     1542       find first buf_chk-gds no-lock where
     1543               buf_chk-gds.b-code = buf_bar-code.b-code  no-error .
     1544       if available buf_chk-gds then
     1545       return substitute("chk-gds Чек &1", buf_chk-gds.doc-code).
     1546       find first buf_price-doc-forming-gds no-lock where
     1547               buf_price-doc-forming-gds.b-code   = buf_bar-code.b-code no-error .
     1548       if available buf_price-doc-forming-gds then
     1549       return substitute("price-doc-forming-gds Номер ДНЦ &1 БД &2"
     1550                           ,  buf_price-doc-forming-gds.pdf-id
     1551                           ,  buf_price-doc-forming-gds.pdf-db  ).
     1552       for each buf_dis-gds-rule no-lock where
     1553               buf_dis-gds-rule.gds-code = buf_bar-code.gds-code:
     1554         if buf_dis-gds-rule.nonunique = string(buf_bar-code.b-code) then do:
     1555           return substitute("dis-gds-rule Роль скидки &1 Объект &2&3"
     1556                               , buf_dis-gds-rule.discnt-role
     1557                               , buf_dis-gds-rule.obj-type
     1558                               , buf_dis-gds-rule.obj-code
     1559                                 ).
     1560         end.
     1561       end.
     1562       assign
     1563       p-is-used = no
     1564       .
     1565       return "":U.
     1566     end.
     1567   end procedure.
     1568   procedure block-del-ucli-bar-code :
     1569   define input  parameter pc-db-num       like ub.db-rec-attr.db-num       no-undo .
     1570   define input  parameter pc-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1571   define input  parameter pc-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1572   define input  parameter pc-parameters   as   character                   no-undo .
     1573   define output parameter pc-err-msg      as   character                   no-undo .
     1574     do
     1575     on error undo, return error
     1576     :
     1577       define variable v-rowid            as rowid     no-undo .
     1578       define variable v-tbl-name         as character no-undo .
     1579       define variable v-is-ucli-bar-code as logical no-undo .
     1580       define variable l-terminal-prt     as logical no-undo .
     1581       define variable l-is-used          as logical no-undo init yes.
     1582       define variable v-prod-bc          as character no-undo .
     1583       define variable v-bar-code         as integer   no-undo .
     1584       define variable v-old-stts         as integer no-undo .
     1585       define buffer buf_bar-code for ub.bar-code.
     1586       define buffer buf_prod-bc for ub.prod-bc .
     1587       define buffer buf_gds-prt for ub.gds-prt.
     1588       define buffer buf_units-base for ub.units.
     1589       define buffer buf_units-cli for ub.units.
     1590       define buffer buf_goods for ub.goods.
     1591       run gen-row-keyr in this-procedure
     1592         ( input  pc-uniq-key-rec
     1593          ,input ?
     1594          ,input "ub":U
     1595          ,input ?
     1596          ,input share-lock
     1597          ,output v-rowid
     1598          ,output v-tbl-name
     1599         ) no-error .
     1600       if error-status :error then do:
     1601         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. &3 &4", vss-workfile, pc-uniq-key-rec, chr(10), return-value ).
     1602       end.
     1603       if v-tbl-name <> 'bar-code':U then do:
     1604         return error substitute( "&1. Данная процедура может работать только с таблицей бар-кодов", vss-workfile ).
     1605       end.
     1606       assign
     1607         v-bar-code = integer( entry( 2, pc-uniq-key-rec, chr(3) ) )
     1608         v-old-stts = integer( entry( 8, pc-parameters, chr(4) ) )
     1609       .
     1610       find first buf_bar-code
     1611         where rowid( buf_bar-code ) = v-rowid
     1612         no-error .
     1613       if not available buf_bar-code then do:
     1614         run gen-bc in this-procedure
     1615           ( input v-bar-code
     1616            ,output v-prod-bc
     1617           ).
     1618         find first buf_prod-bc exclusive-lock
     1619           where buf_prod-bc.b-str = v-prod-bc
     1620           no-error.
     1621         if available buf_prod-bc then do:
     1622           find next buf_prod-bc share-lock
     1623             where buf_prod-bc.b-str = v-prod-bc
     1624             no-error.
     1625           if available buf_prod-bc then do:
     1626             return error substitute( "&1. Системная ошибка!!! Найдено несколько порожденных Доп.БК с одинаковыми кодами (&2)", vss-workfile, v-prod-bc) .
     1627           end.
     1628           else do:
     1629             assign
     1630               pc-err-msg = substitute( "Бар-код &1 был преобразован в Доп.БК &2!", v-bar-code, v-prod-bc )
     1631             .
     1632             return .
     1633           end.
     1634         end.
     1635         else do:
     1636           return error substitute( "&1. Нет необходимого бар-кода &2", vss-workfile, pc-uniq-key-rec ).
     1637         end.
     1638       end.
     1639       if buf_bar-code.stts = integer('99':U) then do:
     1640         assign
     1641         pc-err-msg = substitute( "Бар-код &1 уже заблокирован или удален!!! Блокировка невозможна!!!", pc-uniq-key-rec )
     1642         .
     1643         return .
     1644       end.
     1645       if buf_bar-code.stts_ <> 0
     1646       and not buf_bar-code.stts_ = integer('79':U)
     1647       then do:
     1648         return error substitute( "&1. Необходимый бар-код &2 находится в статусе &3", vss-workfile, buf_bar-code.b-code, buf_bar-code.stts_  ).
     1649       end.
     1650       run is-ucli-bar-code in this-procedure (
     1651                                              input buf_bar-code.b-code
     1652                                             ,input buf_bar-code.node-code
     1653                                             ,input buf_bar-code.part-code
     1654                                             ,input buf_bar-code.in-code
     1655                                             ,input buf_bar-code.unit-cli
     1656                                             ,input buf_bar-code.gds-code
     1657                                             ,output v-is-ucli-bar-code) no-error .
     1658       if error-status:error then do:
     1659         return error substitute( "&1. Ошибка при проверке является ли бар-код &2 бар-кодом на доп. ед.изм: &3", vss-workfile, buf_bar-code.b-code, return-value ).
     1660       end.
     1661       if not v-is-ucli-bar-code then do:
     1662         return error substitute( "&1. Бар-код &2 не является бар-кодом на доп.ед.изм.", vss-workfile, buf_bar-code.b-code ).
     1663       end.
     1664       do
     1665       on error undo, return error
     1666       on stop undo, return error
     1667       :
     1668           assign
     1669           buf_bar-code.stts_ = integer('99':U)
     1670           .
     1671           run proc-is-used-ucli-bar-code in this-procedure (buffer buf_bar-code, input pc-db-num, output l-is-used) no-error .
     1672           if error-status :error
     1673           then do:
     1674             undo, return error substitute( "&1. Ошибка при проверке на использование в товародвижении бар-кода &2:&3&4"
     1675                                            , vss-workfile
     1676                                            , buf_bar-code.b-code
     1677                                            , chr(10)
     1678                                            , error-status:get-message(1)
     1679                                            ).
     1680           end.
     1681           if l-is-used then do:
     1682                     assign
     1683             buf_bar-code.stts_ = v-old-stts
     1684             pc-err-msg = substitute( "&1. Бар-код &2 используется в товародвижении:&3&4"
     1685                                       , vss-workfile
     1686                                       , buf_bar-code.b-code
     1687                                       , chr(10)
     1688                                       , return-value
     1689                                        )
     1690             .
     1691             return pc-err-msg.
     1692           end.
     1693       end.
     1694     end.
     1695   end procedure.
     1696   procedure delete-ucli-bar-code :
     1697   define input  parameter pe-db-num       like ub.db-rec-attr.db-num       no-undo .
     1698   define input  parameter pe-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1699   define input  parameter pe-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1700   define input  parameter pe-parameters   as   character                   no-undo .
     1701   define output parameter pe-err-msg      as   character                   no-undo .
     1702     main-block:
     1703     do
     1704     on error undo main-block, return error
     1705     :
     1706       define variable v-rowid            as rowid     no-undo .
     1707       define variable v-tbl-name         as character no-undo .
     1708       define variable v_bp-rowid         as rowid     no-undo .
     1709       define variable v-is-ucli-bar-code as logical no-undo .
     1710       define variable v-b-code like ub.bar-code.b-code no-undo .
     1711       define variable l-is-used          as logical   no-undo .
     1712       define buffer buf_bar-code         for ub.bar-code .
     1713       define buffer buf_bar-code-attr    for ub.bar-code-attr .
     1714       define buffer buf_bar-code-obj-attr    for ub.bar-code-obj-attr .
     1715       run gen-row-keyr in this-procedure
     1716         ( input  pe-uniq-key-rec
     1717          ,input ?
     1718          ,input "ub":U
     1719          ,input ?
     1720          ,input share-lock
     1721          ,output v-rowid
     1722          ,output v-tbl-name
     1723         ) no-error .
     1724       if error-status :error then do:
     1725         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pe-uniq-key-rec, return-value ).
     1726       end.
     1727       if v-tbl-name <> 'bar-code':U then do:
     1728         return error substitute( "&1. Данная процедура может работать только с таблицей бар-кодов", vss-workfile ).
     1729       end.
     1730        assign
     1731        v-b-code = integer(entry(1, pe-parameters, chr(4)))
     1732        .
     1733       find first buf_bar-code exclusive-lock where
     1734                 buf_bar-code.b-code = v-b-code no-wait no-error.
     1735       if not available buf_bar-code
     1736       and not locked(buf_bar-code) then do:
     1737         find first buf_bar-code no-lock where
     1738                     buf_bar-code.b-code = v-b-code no-error.
     1739         if not available buf_bar-code then return.
     1740       end.
     1741       if not available buf_bar-code then do:
     1742         return error substitute( "&1. Не найден или занят бар-код &2", vss-workfile, v-b-code ).
     1743       end.
     1744       if buf_bar-code.stts_ <> integer('99':U) then do:
     1745         return error substitute( "&1. Бар-код &2 не заблокирован для удаления", vss-workfile, buf_bar-code.b-code ).
     1746       end.
     1747       run is-ucli-bar-code in this-procedure (
     1748                                              input buf_bar-code.b-code
     1749                                             ,input buf_bar-code.node-code
     1750                                             ,input buf_bar-code.part-code
     1751                                             ,input buf_bar-code.in-code
     1752                                             ,input buf_bar-code.unit-cli
     1753                                             ,input buf_bar-code.gds-code
     1754                                             , output v-is-ucli-bar-code) no-error .
     1755       if error-status:error then do:
     1756         return error substitute( "&1. Ошибка при проверке является ли бар-код &2 бар-кодом на доп.ед.изм.: &3", vss-workfile, buf_bar-code.b-code, return-value ).
     1757       end.
     1758       if not v-is-ucli-bar-code then do:
     1759         return error substitute( "&1. Бар-код &2 не является бар-кодом на доп.ед.изм.", vss-workfile, buf_bar-code.b-code).
     1760       end.
     1761       run proc-is-used-ucli-bar-code in this-procedure (buffer buf_bar-code, input pe-db-num, output l-is-used) no-error .
     1762       if error-status :error
     1763       then do:
     1764         undo main-block, return error substitute( "&1. Ошибка при проверке на использование в товародвижении бар-кода &2:&3&4"
     1765                                        , vss-workfile
     1766                                        , buf_bar-code.b-code
     1767                                        , chr(10)
     1768                                        , error-status:get-message(1)
     1769                                        ).
     1770       end.
     1771       if l-is-used then do:
     1772         undo main-block, return error substitute( "&1. Бар-код &2 используется в товародвижении:&3&4"
     1773                                       , vss-workfile
     1774                                       , buf_bar-code.b-code
     1775                                       , chr(10)
     1776                                       , return-value
     1777                                       ).
     1778       end.
     1779       for each buf_bar-code-attr share-lock where
     1780               buf_bar-code-attr.b-code = buf_bar-code.b-code
     1781       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1782       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1783       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1784       :
     1785         delete buf_bar-code-attr.
     1786       end.
     1787       for each buf_bar-code-obj-attr share-lock where
     1788               buf_bar-code-obj-attr.b-code = buf_bar-code.b-code
     1789       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1790       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1791       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1792       :
     1793         delete buf_bar-code-obj-attr.
     1794       end.
     1795       do
     1796       on error undo main-block, return error
     1797       on stop undo main-block, return error
     1798       :
     1799         delete buf_bar-code.
     1800       end.
     1801     end.
     1802   end procedure.
     1803   procedure undo-delete-ucli-bar-code :
     1804   define input  parameter pr-db-num       like ub.db-rec-attr.db-num       no-undo .
     1805   define input  parameter pr-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1806   define input  parameter pr-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1807   define input  parameter pr-parameters   as   character                   no-undo .
     1808   define output parameter pr-err-msg      as   character                   no-undo .
     1809     do
     1810     on error undo, return error
     1811     :
     1812       define variable v-rowid            as rowid     no-undo .
     1813       define variable v-tbl-name         as character no-undo .
     1814       define variable v_bp-rowid         as rowid     no-undo .
     1815       define variable v-gds-code like ub.goods.gds-code no-undo .
     1816       define variable v-b-code like ub.bar-code.b-code no-undo .
     1817       define variable v-new  as logical no-undo .
     1818       define variable v-old-stts as integer no-undo .
     1819       define buffer buf_db-rec-attr    for ub.db-rec-attr .
     1820       define buffer buf_bar-code       for ub.bar-code    .
     1821       run gen-row-keyr in this-procedure
     1822         ( input  pr-uniq-key-rec
     1823          ,input ?
     1824          ,input "ub":U
     1825          ,input ?
     1826          ,input share-lock
     1827          ,output v-rowid
     1828          ,output v-tbl-name
     1829         ) no-error .
     1830       if error-status :error then do:
     1831         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pr-uniq-key-rec, return-value ).
     1832       end.
     1833       if v-tbl-name <> 'bar-code':U then do:
     1834         return error substitute( "&1. Данная процедура может работать только с таблицей бар-кодов", vss-workfile ).
     1835       end.
     1836       find first buf_bar-code exclusive-lock where
     1837                  rowid(buf_bar-code) = v-rowid no-error  .
     1838       if not available buf_bar-code then do:
     1839         assign
     1840         v-b-code = integer(entry(1, pr-parameters, chr(4)))
     1841         v-old-stts = integer(entry(8, pr-parameters, chr(4)))
     1842         .
     1843         find first buf_bar-code exclusive-lock where
     1844                    buf_bar-code.b-code = v-b-code no-error no-wait.
     1845         if not available buf_bar-code
     1846         AND not LOCKED(buf_bar-code)
     1847         then do:
     1848           find first buf_bar-code no-lock where
     1849                    buf_bar-code.b-code = v-b-code no-error.
     1850           if not available buf_bar-code then do:
     1851             return .
     1852           end.
     1853           return error substitute( "&1. Не найден или занят бар-код &2", vss-workfile, v-b-code ).
     1854         end.
     1855       end.
     1856       do
     1857       on error undo, return error
     1858       on stop undo, return error
     1859       :
     1860         if buf_bar-code.stts_ = integer('99':U) then do:
     1861           assign
     1862           buf_bar-code.stts_ = v-old-stts.
     1863           release buf_bar-code.
     1864         end.
     1865       end.
     1866     end.
     1867   end procedure.
     1868   procedure proc-is-used-ucli-bar-code :
     1869   define parameter buffer buf_bar-code for ub.bar-code.
     1870   define input parameter p-db-num like ub.db.db-num no-undo .
     1871   define output parameter p-is-used as logical no-undo init yes.
     1872     do
     1873     on error undo, return error
     1874     :
     1875       define variable v-artic  like ub.goods.artic no-undo .
     1876       define variable v-prod-type  like ub.goods.prod-type no-undo .
     1877       define variable v-prod-code  like ub.goods.prod-code no-undo .
     1878       define variable v-is-ucli-bar-code as logical no-undo .
     1879       define buffer buf_goods for ub.goods.
     1880       define buffer buf_prt-obj for ub.prt-obj.
     1881       define buffer buf_prod-bc for ub.prod-bc.
     1882       define buffer buf_prod-bc-db for ub.prod-bc-db.
     1883       define buffer buf_clients for ub.clients.
     1884       define buffer buf_chk-gds for ub.chk-gds.
     1885       define buffer buf_scales-gds for ub.scales-gds.
     1886       define buffer buf_sert-join for ub.sert-join.
     1887       define buffer buf_price-list for ub.price-list.
     1888       define buffer buf_price-doc-forming-gds for ub.price-doc-forming-gds.
     1889       define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     1890       define buffer buf_gds-dtl for ub.gds-dtl.
     1891       define buffer buf_ord-dtl for ub.ord-dtl.
     1892       define buffer buf_ord-dtl-cons for ub.ord-dtl-cons.
     1893       define buffer buf_ord-dtl-rcv for ub.ord-dtl-rcv.
     1894       define buffer buf_tmp-sale-dtl for ub.tmp-sale-dtl.
     1895       run is-ucli-bar-code in this-procedure (
     1896                                              input buf_bar-code.b-code
     1897                                             ,input buf_bar-code.node-code
     1898                                             ,input buf_bar-code.part-code
     1899                                             ,input buf_bar-code.in-code
     1900                                             ,input buf_bar-code.unit-cli
     1901                                             ,input buf_bar-code.gds-code
     1902                                             , output v-is-ucli-bar-code) no-error .
     1903       if error-status:error then do:
     1904         return error substitute( "&1. Ошибка при проверке является ли бар-код &2 бар-кодом на доп.ед.изм.: &3", vss-workfile, string(buf_bar-code.b-code), return-value ).
     1905       end.
     1906       if not v-is-ucli-bar-code then do:
     1907         return error substitute( "&1. Бар-код &2 не является бар-кодом на доп ед.изм.", vss-workfile, buf_bar-code.b-code).
     1908       end.
     1909       find first buf_goods no-lock where
     1910                  buf_goods.gds-code = buf_bar-code.gds-code no-error .
     1911       if not avail buf_goods then return error.
     1912       find first buf_prod-bc no-lock where
     1913                  buf_prod-bc.b-code = buf_bar-code.b-code no-error .
     1914       if available buf_prod-bc then
     1915       return substitute("prod-bc ДопБК &1" + buf_prod-bc.b-str).
     1916       find first buf_prod-bc-db no-lock where
     1917                  buf_prod-bc-db.b-code = buf_bar-code.b-code no-error .
     1918       if available buf_prod-bc-db then
     1919       return substitute("prod-bc-db ДопБК &1" + buf_prod-bc-db.b-str).
     1920       find first buf_sert-join no-lock where
     1921                  buf_sert-join.b-code = buf_bar-code.b-code no-error .
     1922       if available buf_sert-join then
     1923       return substitute("sert-join Сертификат &1" + buf_sert-join.sert-code).
     1924       for each buf_clients no-lock where
     1925                p-db-num = 0
     1926             or buf_clients.db-num = p-db-num:
     1927         find first buf_price-list no-lock where
     1928                    buf_price-list.obj-type = buf_clients.obj-type
     1929                AND buf_price-list.obj-code = buf_clients.obj-code
     1930                AND buf_price-list.b-code   = buf_bar-code.b-code no-error .
     1931         if available buf_price-list then
     1932         return substitute("price-list объект &1&2 Номер переоценки &3",
     1933                            buf_price-list.obj-type, string(buf_price-list.obj-code),  buf_price-list.doc-num   ).
     1934       end.
     1935       find first buf_chk-gds no-lock where
     1936               buf_chk-gds.b-code = buf_bar-code.b-code  no-error .
     1937       if available buf_chk-gds then
     1938       return substitute("chk-gds Чек &1", buf_chk-gds.doc-code).
     1939       find first buf_price-doc-forming-gds no-lock where
     1940                 buf_price-doc-forming-gds.b-code   = buf_bar-code.b-code no-error .
     1941       if available buf_price-doc-forming-gds then
     1942       return substitute("price-doc-forming-gds Номер ДНЦ &1 БД &2"
     1943                           ,  buf_price-doc-forming-gds.pdf-id
     1944                           ,  buf_price-doc-forming-gds.pdf-db  ).
     1945       for each buf_dis-gds-rule no-lock where
     1946               buf_dis-gds-rule.gds-code = buf_bar-code.gds-code:
     1947         if buf_dis-gds-rule.nonunique = string(buf_bar-code.b-code) then do:
     1948           return substitute("dis-gds-rule Роль скидки &1 Объект &2&3"
     1949                               , buf_dis-gds-rule.discnt-role
     1950                               , buf_dis-gds-rule.obj-type
     1951                               , buf_dis-gds-rule.obj-code
     1952                                 ).
     1953         end.
     1954       end.
     1955       assign
     1956       p-is-used = no
     1957       .
     1958       return "":U.
     1959     end.
     1960   end procedure.
