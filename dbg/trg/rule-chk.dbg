        1   block-level on error undo, throw.
        2   define input parameter p-mode as character no-undo .
        3   define input parameter p-rule-id as integer no-undo .
        4   define output parameter p-ok as logical no-undo .
        5   define output parameter p-mess as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Проверка возможности удаления или изменения правила".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define variable v-waitfram-action01         as character   no-undo .
       83   define variable v-waitfram-action02         as character   no-undo .
       84   define variable v-waitfram-action03         as character   no-undo .
       85   define variable mWaitFramTextBeg            as character   no-undo.
       86   define variable mWaitFramTextEnd            as character   no-undo.
       87   define variable mWaitFramView               as logical     no-undo.
       88   define variable mWaitProcEvent              as logical     no-undo init yes.
       89   define variable mWaitFramInterval           as integer     no-undo init 1 .
       90   define variable mWaitFramStop               as logical     no-undo.
       91   define variable mWaitFramStopUser           as logical     no-undo.
       92   define variable mWaitFramStopTimeOut        as logical     no-undo.
       93   define variable mWaitFramStartProc          as datetime-tz no-undo.
       94   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       95   define button B-WaitFramStop auto-end-key
       96        label "Стоп"
       97        size 10 by 1 tooltip "Остоновить процесс".
       98   define button B-viewProcInfo
       99        label "Информация"
      100        size 15 by 1 tooltip "Информация о процесс".
      101   define frame waitfram
      102     v-waitfram-action01 format "x(72)" no-label skip
      103     v-waitfram-action02 format "x(72)" no-label skip
      104     v-waitfram-action03 format "x(72)" no-label skip
      105     B-viewProcInfo
      106     B-WaitFramStop at row 4 col 30
      107     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      108     .
      109   define new global shared variable mBatchMode as logical no-undo init ?.
      110   define variable mFramBachModHandle as handle no-undo.
      111   mFramBachModHandle = frame waitfram:handle.
      112   define variable mFameOldVis as logical no-undo.
      113   define variable mVisCUrentVin as logical no-undo.
      114   if session:batch-mode
      115   then
      116      mBatchMode = yes.
      117   if mBatchMode = ? then do:
      118     mVisCUrentVin = current-window:visible.
      119     mFameOldVis = mFramBachModHandle:visible.
      120     mFramBachModHandle:visible  = yes.
      121     mBatchMode = mFramBachModHandle:visible ne yes.
      122     mFramBachModHandle:visible = mFameOldVis.
      123     current-window:visible = mVisCUrentVin.
      124   end.
      125    if  log-manager:logfile-name ne ?
      126     then DO:
      127         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      128         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      129         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      130     end.
      131   on choose of B-WaitFramStop in frame waitfram
      132   do:
      133     mWaitFramStop = yes.
      134     mWaitFramStopUser = yes.
      135   end.
      136   function waitfram-check-timeout returns logical():
      137      define variable vtime as int64 no-undo.
      138      if mWaitFramStopTimeOut
      139      then
      140         return yes.
      141      vtime = ( now - mWaitFramStartProc ) / 1000 .
      142      if     mWaitFramTimeOut ne ?
      143         and mWaitFramTimeOut ne 0
      144         and mWaitFramTimeOut lt vtime
      145      then do:
      146         mWaitFramStopTimeOut = yes.
      147      end.
      148      return mWaitFramStopTimeOut.
      149   end.
      150   procedure waitfram-hide :
      151     if not session:batch-mode
      152     then do
      153     on error undo, return error return-value
      154     :
      155       pause 0 before-hide .
      156       if not mBatchMode then
      157         hide frame waitfram .
      158     end.
      159   end procedure.
      160   procedure waitfram-show :
      161     define input  parameter p-message as character no-undo .
      162     define variable v-left-margin as integer   no-undo .
      163     if not session:batch-mode
      164     then do
      165     on error undo, return error return-value
      166     :
      167       if length(p-message) <= 70 then do:
      168         assign
      169           v-left-margin = integer((70 - length(p-message)) / 2)
      170         .
      171         assign
      172           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      173         .
      174         assign
      175           v-waitfram-action01 = " "
      176           v-waitfram-action02 = " "
      177                                    + fill(" ", v-left-margin)
      178                                    + p-message
      179           v-waitfram-action03 = " "
      180         .
      181       end.
      182       else do:
      183         define variable vRindex1 as integer no-undo.
      184         define variable vRindex2 as integer no-undo.
      185         vRindex1 = r-index(p-message," ",70).
      186         if vRindex1 = 0
      187         then
      188            vRindex1 = 70.
      189         if length(p-message)  <= vRindex1 + 70 then do:
      190           assign
      191             v-waitfram-action01 = " "
      192             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      194           .
      195         end.
      196         else do:
      197           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      198           if vRindex2 <= vRindex1
      199           then
      200              vRindex2 = vRindex1 + 70.
      201           assign
      202             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      203             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      204             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      205           .
      206         end.
      207       end.
      208       B-viewProcInfo:visible   in frame waitfram = no.
      209       B-viewProcInfo:sensitive in frame waitfram = no.
      210       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      211       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      212       if  (   mWaitFramView
      213          or  mWaitProcEvent)
      214          and not mBatchMode
      215       then
      216          display
      217             v-waitfram-action01 skip
      218             v-waitfram-action02 skip
      219             v-waitfram-action03 skip
      220          with frame waitfram .
      221     end.
      222   end procedure.
      223      procedure waitfram-show-this:
      224         define input  parameter iInterval as int64 no-undo.
      225         define variable vtime as int64 no-undo.
      226         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      227         mWaitFramInterval = iInterval.
      228         run waitfram-show (substitute("&1&2 &3&4" ,
      229                                       mWaitFramTextBeg ,
      230                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      231                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      232                                       mWaitFramTextEnd
      233                                      )
      234                           ).
      235      end.
      236      procedure WaitFramRunPause:
      237         define input  parameter iInterval as dec no-undo.
      238         define variable vStart  as datetime-tz no-undo.
      239         define variable vend    as datetime-tz no-undo.
      240         define variable vint as int64 no-undo.
      241         define variable vOk as logical no-undo.
      242         vStart = now.
      243         vend   = vStart.
      244         publish "WaitFramPause" (iInterval,output vOk).
      245         vend   =  now.
      246         vint = vend - vStart.
      247         vint = iInterval - vint / 1000.
      248         if     not mWaitFramStop
      249            and (   vint > 0
      250                 or (    not vOk
      251                     and iInterval eq ?
      252                     )
      253                 )
      254         then
      255            run waitfram-show-this (iInterval).
      256         vend   =  now.
      257         vint = vend - vStart.
      258         vint = iInterval - vint / 1000.
      259         if     not mWaitFramStop
      260            and vint > 0
      261         then do:
      262            run gbl/pause.p (vint * 1000).
      263         end.
      264         if iInterval ne ?
      265         then
      266            publish "WaitFramStop".
      267         waitfram-check-timeout().
      268      end.
      269      procedure WaitFramWaitFor:
      270         define input  parameter iInterval as dec no-undo.
      271         assign
      272            mWaitFramStartProc   = now
      273            mWaitFramStopUser    = no
      274            mWaitFramStopTimeOut = no
      275         .
      276         block-wait:
      277         do while not mWaitFramStop:
      278            run WaitFramRunPause (iInterval).
      279            if  waitfram-check-timeout()
      280            then do:
      281               leave block-wait.
      282            end.
      283         end.
      284         run waitfram-hide.
      285      end.
      286   procedure waitfram-join :
      287     define input  parameter p-line-1  as character no-undo .
      288     define input  parameter p-line-2  as character no-undo .
      289     define input  parameter p-line-3  as character no-undo .
      290     define output parameter p-message as character no-undo .
      291     do
      292     on error undo, return error return-value
      293     :
      294       assign
      295         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      298       .
      299     end.
      300   end procedure.
      301   function waitfram-join-function returns character
      302     (input p-line-1 as character
      303     ,input p-line-2 as character
      304     ,input p-line-3 as character
      305     ).
      306     define variable v-message as character no-undo .
      307     run waitfram-join in this-procedure
      308       (input  p-line-1
      309       ,input  p-line-2
      310       ,input  p-line-3
      311       ,output v-message
      312       ) .
      313     return v-message .
      314   end function .
      315   define buffer buf_rule-by-set for ub.rule-by-set.
      316   define buffer buf_rule-by-call for ub.rule-by-call.
      317   define buffer buf_rule-by-profile for ub.rule-by-profile.
      318   main-block:
      319   do
      320   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      321   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      322   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      323   :
      324     run waitfram-show in this-procedure ( input "Ждите..." ).
      325     find first buf_rule-by-call no-lock where
      326               buf_rule-by-call.rule_id = p-rule-id no-error.
      327     if available buf_rule-by-call  then do:
      328       p-mess =  substitute("Невозможно удалить/изменить правило &1&2" +
      329                 "Правило вызывается в точке &3(&4) кодекс &5  набор &6 порядок вызова &7"
      330                 , p-rule-id
      331                 , chr(10)
      332                 , buf_rule-by-call.call#_id
      333                 , buf_rule-by-call.call_id
      334                 , buf_rule-by-call.codex_id
      335                 , buf_rule-by-call.ruleset_id
      336                 , buf_rule-by-call.order_id
      337                 ).
      338       run waitfram-hide in this-procedure .
      339       return.
      340     end.
      341     find first buf_rule-by-set no-lock where
      342               buf_rule-by-set.rule_id = p-rule-id no-error.
      343     if available buf_rule-by-set  then do:
      344       p-mess =  substitute("Невозможно удалить/изменить правило &1&2" +
      345                 "Правило привязано к своду правил &3 кодекс &4"
      346                 , p-rule-id
      347                 , chr(10)
      348                 , buf_rule-by-set.ruleset_id
      349                 , buf_rule-by-set.codex_id).
      350       run waitfram-hide in this-procedure .
      351       return.
      352     end.
      353     find first buf_rule-by-profile no-lock where
      354             buf_rule-by-profile.rule_id = p-rule-id no-error.
      355     if available buf_rule-by-profile then do:
      356       p-mess =  substitute("Невозможно удалить правило &1&2" +
      357                 "Правило привязано к алгоритму &3"
      358                 , p-rule-id
      359                 , chr(10)
      360                 , buf_rule-by-profile.profile_id
      361                 ).
      362       run waitfram-hide in this-procedure .
      363       return.
      364     end.
      365     assign
      366     p-ok = yes.
      367     run waitfram-hide in this-procedure .
      368   end.
