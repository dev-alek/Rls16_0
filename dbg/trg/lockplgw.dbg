        1   block-level on error undo, throw.
        2   define input parameter p-obj-type          like ub.wth-pobj.obj-type no-undo .
        3   define input parameter p-obj-code          like ub.wth-pobj.obj-code no-undo .
        4   define input parameter p-wth-code          like ub.wth-pobj.wth-code  no-undo .
        5   define input parameter p-w-p-code          like ub.wth-pobj.w-p-code  no-undo .
        6   define input parameter p-action            as character no-undo .
        7   define input parameter p-no-check-doc-code as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Блокировка и разблокировка МЦ на МХ".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define buffer buf_wth-obj  for ub.wth-obj .
       75   define buffer buf_wth-doc  for ub.wth-doc .
       76   define buffer buf_wth-line for ub.wth-line .
       77   main-block:
       78   do
       79   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       80   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       81   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       82   :
       83     if lookup( p-action
       84       , "assign-doc-on=true"  + ","
       85       + "assign-doc-on=false" + ","
       86       + "check-doc-on=true"   + ","
       87       + "check-doc-on=false" ) = 0
       88     then do:
       89       message
       90         vss-workfile vss-revision vss-description skip
       91         "Ошибка задания входных параметров" skip
       92         "Неизвестное значение p-action" skip
       93         "p-action" p-action skip
       94         view-as alert-box error .
       95       undo main-block, return error .
       96     end.
       97     find first ub.wealth no-lock
       98       where ub.wealth.wth-code = p-wth-code
       99       no-error .
      100     if not available ub.wealth then do:
      101       message
      102         vss-workfile vss-revision vss-description skip
      103         "Ошибка задания входных параметров" skip
      104         "Код МЦ" p-wth-code skip
      105         view-as alert-box error .
      106       undo main-block, return error .
      107     end.
      108   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthpobjc in g#library
      110     (input  p-obj-type
      111     ,input  p-obj-code
      112     ,input  ub.wealth.wth-code
      113     ,input p-w-p-code
      114     ,buffer ub.wth-pobj
      115     ) no-error .
      116     if error-status :error then do:
      117       message
      118         vss-workfile vss-revision vss-description skip
      119         "Ошибка при поиске МЦ на МХ объекта" skip
      120         "obj-type"  p-obj-type skip
      121         "obj-code"  p-obj-code skip
      122         "wth-code"  p-wth-code skip
      123         "w-p-code"  p-w-p-code skip
      124         error-status :get-message(1) skip
      125         return-value skip
      126         view-as alert-box error .
      127       undo main-block, return error .
      128     end.
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthobjcr in g#library
      131     (input  p-obj-type
      132     ,input  p-obj-code
      133     ,input  ub.wealth.wth-code
      134     ,buffer buf_wth-obj
      135     ) no-error .
      136     if error-status :error then do:
      137       message
      138         vss-workfile vss-revision vss-description skip
      139         "Ошибка при поиске МЦ на объекте" skip
      140         "obj-type"  p-obj-type skip
      141         "obj-code"  p-obj-code skip
      142         "wth-code"  p-wth-code skip
      143         error-status :get-message(1) skip
      144         return-value skip
      145         view-as alert-box error .
      146       undo main-block, return error .
      147     end.
      148     find current buf_wth-obj exclusive-lock .
      149     release buf_wth-obj .
      150     find current ub.wth-pobj exclusive-lock .
      151     if ub.wth-pobj.doc-on = ? then do:
      152       message
      153         vss-workfile vss-revision vss-description skip
      154         "МЦ на МХ имеет неопределенный статус" skip
      155         "Объект" p-obj-type p-obj-code skip
      156         "МХ" p-w-p-code skip
      157         "Код МЦ" ub.wealth.wth-code skip
      158         "ub.wth-pobj.doc-on" ub.wth-pobj.doc-on skip
      159         view-as alert-box error .
      160       undo main-block, return error .
      161     end.
      162     case p-action :
      163       when "assign-doc-on=true" then do:
      164         if ub.wth-pobj.doc-on = false then do:
      165           do
      166           on error undo main-block, return error
      167           :
      168             assign
      169               ub.wth-pobj.doc-on = true
      170             .
      171           end.
      172         end.
      173         else do:
      174           for each buf_wth-doc no-lock
      175             where buf_wth-doc.obj-type = ub.wth-pobj.obj-type
      176               and buf_wth-doc.obj-code = ub.wth-pobj.obj-code
      177               and buf_wth-doc.status_  = 'разрешен':U
      178           on error undo main-block, return error
      179           :
      180             for each buf_wth-line no-lock
      181               where buf_wth-line.doc-code = buf_wth-doc.doc-code
      182                 and buf_wth-line.obj-type = ub.wth-pobj.obj-type
      183                 and buf_wth-line.obj-code = ub.wth-pobj.obj-code
      184                 and buf_wth-line.w-p-code  = ub.wth-pobj.w-p-code
      185                 and buf_wth-line.wth-code = ub.wth-pobj.wth-code
      186             on error undo main-block, return error
      187             :
      188               message
      189                 "Невозможно заблокировать МЦ на МХ" skip
      190                 "МЦ уже является заблокированной" skip
      191                 "Объект" p-obj-type p-obj-code skip
      192                 "МХ" p-w-p-code skip
      193                 "Код МЦ" ub.wealth.wth-code skip
      194                 "Существует документ МЦ" buf_wth-doc.doc-code skip
      195                 "Статус документа" buf_wth-doc.status_ skip
      196                 view-as alert-box information .
      197               undo main-block, return error .
      198             end.
      199           end.
      200           message
      201             vss-workfile vss-revision vss-description skip
      202             "Невозможно заблокировать МЦ на МХ" skip
      203             "МЦ уже является заблокированной" skip
      204             "Объект" p-obj-type p-obj-code skip
      205             "МХ" p-w-p-code skip
      206             "Код МЦ" ub.wealth.wth-code skip
      207             view-as alert-box error .
      208           undo main-block, return error .
      209         end.
      210       end.
      211       when "assign-doc-on=false" then do:
      212         if ub.wth-pobj.doc-on = true then do:
      213           for each buf_wth-doc no-lock
      214             where buf_wth-doc.obj-type = ub.wth-pobj.obj-type
      215               and buf_wth-doc.obj-code = ub.wth-pobj.obj-code
      216               and ( buf_wth-doc.status_  = 'разрешен':U
      217                   )
      218               and buf_wth-doc.doc-code <> p-no-check-doc-code
      219           on error undo main-block, return error
      220           :
      221             for each buf_wth-line no-lock
      222               where buf_wth-line.doc-code = buf_wth-doc.doc-code
      223                 and buf_wth-line.obj-type = ub.wth-pobj.obj-type
      224                 and buf_wth-line.obj-code = ub.wth-pobj.obj-code
      225                 and buf_wth-line.w-p-code  = ub.wth-pobj.w-p-code
      226                 and buf_wth-line.wth-code = ub.wth-pobj.wth-code
      227             on error undo main-block, return error
      228             :
      229               message
      230                 vss-workfile vss-revision vss-description skip
      231                 "Невозможно снять блокировку на МЦ на МХ" skip
      232                 "Объект" p-obj-type p-obj-code skip
      233                 "МХ" p-w-p-code skip
      234                 "Код МЦ" ub.wealth.wth-code skip
      235                 "Существует документ МЦ" buf_wth-doc.doc-code skip
      236                 "Статус документа" buf_wth-doc.status_ skip
      237                 view-as alert-box information .
      238               undo main-block, return error .
      239             end.
      240           end.
      241           do
      242           on error undo main-block, return error
      243           :
      244             assign
      245               ub.wth-pobj.doc-on = false
      246             .
      247           end.
      248         end.
      249         else do:
      250           message
      251             vss-workfile vss-revision vss-description skip
      252             "Невозможно разблокировать МЦ на МХ" skip
      253             "МЦ не является заблокированной" skip
      254             "Объект" p-obj-type p-obj-code skip
      255             "МХ" p-w-p-code skip
      256             "Код МЦ" ub.wealth.wth-code skip
      257             view-as alert-box error .
      258           undo main-block, return error .
      259         end.
      260       end.
      261       when "check-doc-on=true" then do:
      262         if ub.wth-pobj.doc-on <> true then do:
      263           message
      264             vss-workfile vss-revision vss-description skip
      265             "МЦ на МХ не является заблокированной" skip
      266             "Объект" p-obj-type p-obj-code skip
      267             "Место хранения" p-w-p-code skip
      268             "Код МЦ" ub.wealth.wth-code skip
      269             view-as alert-box information .
      270           undo main-block, return error .
      271         end.
      272       end.
      273       when "check-doc-on=false" then do:
      274         if ub.wth-pobj.doc-on <> false then do:
      275           message
      276             vss-workfile vss-revision vss-description skip
      277             "МЦ на МХ является заблокированной" skip
      278             "Объект" p-obj-type p-obj-code skip
      279             "МХ" p-w-p-code skip
      280             "Код МЦ" ub.wealth.wth-code skip
      281             view-as alert-box information .
      282           undo main-block, return error .
      283         end.
      284       end.
      285       otherwise do:
      286         message
      287           vss-workfile vss-revision vss-description skip
      288           "Внутрення ошибка" skip
      289           "Неизвестное значение p-action" skip
      290           "p-action" p-action skip
      291           view-as alert-box error .
      292         undo main-block, return error .
      293       end.
      294     end case .
      295   end.
