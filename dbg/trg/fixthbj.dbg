      502   procedure thbjattr_value :
      503   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      504   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      505   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      506   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
