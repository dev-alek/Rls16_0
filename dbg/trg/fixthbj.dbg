     1210   define variable v-check as logical no-undo .
     1211   define variable v-force as logical no-undo .
     1212   define variable v-mes   as character no-undo .
     1213   define buffer buf_thbj-attr for ub.thbj-attr.
     1214   run waitfram-show in this-procedure ("Реинициализация конфигурации настроек объектов TH").
     1215   main-block:
     1216   do
     1217   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1218   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1219   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1220   :
     1221     if not p-forced then do:
     1222       run check-thbj-version in this-procedure ( output v-check).
     1223     end.
     1224     if v-check
     1225     or p-forced
     1226     then do:
     1227        if v-check
     1228        and p-read-only then do:
     1229           return error substitute("&1 &2 &3&4До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!"
     1230                                   ,vss-workfile
     1231                                   ,vss-revision
     1232                                   ,vss-description
     1233                                   ,chr(10)).
     1234        end.
     1235       run str/diallog.w ( input ?
     1236                   , input this-procedure
     1237                   , input ('update-thbj-attr':U + chr(4) +
     1238                           "1" + chr(4) +
     1239                           "1" + chr(4) +
     1240                           "1" + chr(4) +
     1241                           "1" + chr(4) +
     1242                           "yes")
     1243                   , input ''
     1244                   , input yes
     1245                   , input 'Прервать'
     1246                   , input 'Обновлeние логической структуры параметров объектов IBS TH') no-error .
     1247       if error-status:error then do:
     1248         message
     1249         substitute("Ошибка обновлeнии логической структуры параметров объектов IBS TH&1&2&1&3"
     1250                      , chr(10)
     1251                      , error-status:get-message(1)
     1252                      , return-value )
     1253         view-as alert-box error .
     1254         undo, return error .
     1255       end.
     1256       find first buf_thbj-attr share-lock where
     1257                 buf_thbj-attr.upper-prop-code = ''
     1258            and  buf_thbj-attr.prop-code = ''
     1259            and buf_thbj-attr.obj-type = ''
     1260            and buf_thbj-attr.obj-code = 0 no-error.
     1261       if not available buf_thbj-attr then do:
     1262         if g#db-num = 0 then do:
     1263           create buf_thbj-attr.
     1264         end.
     1265       end.
     1266       if available buf_thbj-attr
     1267       and g#db-num = 0 then do:
     1268         assign
     1269         buf_thbj-attr.property-value-character = "v15_1.1"
     1270         .
     1271       end.
     1272     end.
     1273   end.
     1274   run waitfram-hide in this-procedure .
     1275   procedure update-thbj-attr :
     1276   define input parameter parparentproc as widget-handle no-undo .
     1277   define input parameter p-parent-handle  as widget-handle no-undo .
     1278   define input parameter p-log-handle  as handle no-undo .
     1279   define input parameter p-parameter   as character no-undo .
     1280   define variable v-label as character no-undo .
     1281   define variable v-user-can-edit as logical no-undo .
     1282   define variable v-output-display as logical   no-undo .
     1283   define variable v-other          as character no-undo .
     1284   define variable v-prop-list      as character no-undo .
     1285   define variable v-prop-type-list as character no-undo .
     1286   define variable v-prop-label-list as character no-undo .
     1287   define variable v-global          as logical no-undo .
     1288   define variable v-host           as logical no-undo .
     1289   define variable v-shop           as logical no-undo .
     1290   define variable v-store          as logical no-undo .
     1291   define variable v-db             as logical no-undo .
     1292   define variable v-upper-code as character no-undo .
     1293   define variable v-param-type as character no-undo .
     1294   define variable v-value-character as character no-undo .
     1295   define variable v-value-date as date no-undo .
     1296   define variable v-value-decimal as decimal no-undo .
     1297   define variable v-value-integer as INTEGER no-undo .
     1298   define variable v-value-logical AS LOGICAL no-undo .
     1299   define variable v-tth as handle no-undo .
     1300   define variable v-ii as integer no-undo .
     1301   assign
     1302   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1303   define buffer buf_clients for ub.clients.
     1304   define buffer buf_sysconf for ub.sysconf.
     1305   main-block:
     1306   do
     1307   on error undo, return error
     1308   :
     1309     do v-ii = 1 to num-entries('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
     1310       v-upper-code = entry(v-ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U) .
     1311       if v-upper-code <> 'cd-type-IBS-TH':U then next.
     1312       run thbjattr_code in this-procedure (
     1313                                              input  v-upper-code
     1314                                             ,input  ''
     1315                                             ,output v-label
     1316                                             ,output v-user-can-edit
     1317                                             ,output v-output-display
     1318                                             ,output v-other
     1319                                             ,output v-prop-list
     1320                                             ,output v-prop-type-list
     1321                                             ,output v-prop-label-list
     1322                                             ,output v-global
     1323                                             ,output v-host
     1324                                             ,output v-shop
     1325                                             ,output v-store
     1326                                             ,output v-db
     1327                                             ) no-error.
     1328       if error-status:error then do:
     1329         undo main-block, return error substitute("Ошибка при определении свойств параметра &1", v-upper-code).
     1330       end.
     1331       if g#db-num > 0 then do:
     1332         assign
     1333         v-global = no
     1334         v-host = no
     1335         .
     1336       end.
     1337       case v-global:
     1338         when yes then do:
     1339           run adm/shattri.p (
     1340               input "init":U
     1341             , input '':U
     1342             , input 0
     1343             , input v-upper-code
     1344             , input "":U
     1345             , output v-value-character
     1346             , output v-value-date
     1347             , output v-value-decimal
     1348             , output v-value-integer
     1349             , output v-value-logical
     1350             , output v-param-type
     1351             , INPUT-OUTPUT table-handle v-tth
     1352             ) no-error .
     1353           if error-status:error then do:
     1354             undo main-block, return error substitute("Ошибка при определении значений глобального параметра &1", v-upper-code).
     1355           end.
     1356           run check-if-exists in this-procedure ( input '', input 0, input p-log-handle ) no-error.
     1357           if error-status:error then do:
     1358             undo main-block, return error substitute("Ошибка при проверке наличия в БД глобального параметра &1", v-upper-code).
     1359           end.
     1360         end.
     1361         otherwise do:
     1362           case v-host:
     1363             when yes then do:
     1364               for each buf_sysconf no-lock
     1365               on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1366               on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1367               on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1368               :
     1369                 run adm/shattri.p (
     1370                     input "init":U
     1371                   , input 'орг':U
     1372                   , input buf_sysconf.host-code
     1373                   , input v-upper-code
     1374                   , input "":U
     1375                   , output v-value-character
     1376                   , output v-value-date
     1377                   , output v-value-decimal
     1378                   , output v-value-integer
     1379                   , output v-value-logical
     1380                   , output v-param-type
     1381                   , INPUT-OUTPUT table-handle v-tth
     1382                   ) no-error .
     1383                 if error-status:error then do:
     1384                   undo main-block, return error substitute("Ошибка при определении значений параметра &1 по фирме &2", v-upper-code, buf_sysconf.host-code).
     1385                 end.
     1386                 run check-if-exists in this-procedure ( input 'орг':U, input buf_sysconf.host-code, input p-log-handle) no-error.
     1387                 if error-status:error then do:
     1388                   undo main-block, return error substitute("Ошибка при проверке наличия в БД параметра &1 по фирме &2", v-upper-code, buf_sysconf.host-code).
     1389                 end.
     1390               end.
     1391             end.
     1392             otherwise do:
     1393               case v-shop :
     1394                 when yes then do:
     1395                   for each buf_clients no-lock where buf_clients.obj-type = 'маг':U
     1396                   and (g#db-num = 0 or buf_clients.db-num = g#db-num)
     1397                   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1398                   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1399                   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1400                   :
     1401                     run adm/shattri.p (
     1402                         input "init":U
     1403                       , input buf_clients.obj-type
     1404                       , input buf_clients.obj-code
     1405                       , input v-upper-code
     1406                       , input "":U
     1407                       , output v-value-character
     1408                       , output v-value-date
     1409                       , output v-value-decimal
     1410                       , output v-value-integer
     1411                       , output v-value-logical
     1412                       , output v-param-type
     1413                       , INPUT-OUTPUT table-handle v-tth
     1414                       ) no-error .
     1415                     if error-status:error then do:
     1416                       undo main-block, return error substitute("Ошибка при определении значений параметра &1 по &2&3", v-upper-code, buf_clients.obj-type, buf_clients.obj-code).
     1417                     end.
     1418                     run check-if-exists in this-procedure ( input buf_clients.obj-type, buf_clients.obj-code, input p-log-handle) no-error.
     1419                     if error-status:error then do:
     1420                       undo main-block, return error substitute("Ошибка при проверке наличия в БД параметра &1 по &2&3", v-upper-code, buf_clients.obj-type, buf_clients.obj-code).
     1421                     end.
     1422                   end.
     1423                 end.
     1424               end.
     1425               case v-store :
     1426                 when yes then do:
     1427                   for each buf_clients no-lock where buf_clients.obj-type = 'скл':U
     1428                   and (g#db-num = 0 or buf_clients.db-num = g#db-num)
     1429                   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1430                   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1431                   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1432                   :
     1433                     run adm/shattri.p (
     1434                         input "init":U
     1435                       , input buf_clients.obj-type
     1436                       , input buf_clients.obj-code
     1437                       , input v-upper-code
     1438                       , input "":U
     1439                       , output v-value-character
     1440                       , output v-value-date
     1441                       , output v-value-decimal
     1442                       , output v-value-integer
     1443                       , output v-value-logical
     1444                       , output v-param-type
     1445                       , INPUT-OUTPUT table-handle v-tth
     1446                       ) no-error .
     1447                     if error-status:error then do:
     1448                       undo main-block, return error substitute("Ошибка при определении значений параметра &1 по &2&3", v-upper-code, buf_clients.obj-type, buf_clients.obj-code).
     1449                     end.
     1450                     run check-if-exists in this-procedure ( input buf_clients.obj-type, buf_clients.obj-code, input p-log-handle)  no-error.
     1451                     if error-status:error then do:
     1452                       undo main-block, return error substitute("Ошибка при проверке наличия в БД параметра &1 по &2&3", v-upper-code, buf_clients.obj-type, buf_clients.obj-code).
     1453                     end.
     1454                   end.
     1455                 end.
     1456               end case.
     1457             end.
     1458           end case.
     1459         end.
     1460       end case.
     1461     end.
     1462   end.
     1463   end procedure.
     1464   procedure check-if-exists :
     1465   define input parameter p-obj-type as character no-undo .
     1466   define input parameter p-obj-code as integer no-undo .
     1467   define input parameter p-log-hanlde as handle no-undo .
     1468   define variable log-file-name as character no-undo .
     1469   define variable v-label          as character no-undo .
     1470   define variable v-user-can-edit  as logical   no-undo .
     1471   define variable v-output-display as logical   no-undo .
     1472   define variable v-other          as character no-undo .
     1473   define variable v-prop-list      as character no-undo .
     1474   define variable v-prop-type-list as character no-undo .
     1475   define variable v-prop-label-list as character no-undo .
     1476   define variable v-global          as logical no-undo .
     1477   define variable v-host           as logical no-undo .
     1478   define variable v-shop           as logical no-undo .
     1479   define variable v-store          as logical no-undo .
     1480   define variable v-db             as logical no-undo .
     1481   define variable v-ii as integer no-undo .
     1482   define variable v-copy-2cda as logical no-undo .
     1483   define variable v-news as logical no-undo .
     1484   define variable v-from-gbd as logical no-undo .
     1485   define variable v-from-ubd as logical no-undo .
     1486   define variable v-db-num as integer no-undo .
     1487   define buffer buf_thbjattr_thbj-attr for thbjattr_thbj-attr.
     1488   define buffer buf_thbj-attr for ub.thbj-attr.
     1489   define buffer buf_Cash-desk for ub.cash-desk.
     1490   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     1491   main-block:
     1492   do
     1493   on error undo, return error
     1494   :
     1495     if p-obj-type = "" and g#db-num > 0 then return ''.
     1496     if p-obj-type = 'орг':U and g#db-num > 0 then return ''.
     1497     if p-obj-type = 'БД':U and p-obj-code <> g#db-num and g#db-num <> 0 then return ''.
     1498     if p-obj-type = 'маг':U
     1499     or p-obj-type = 'скл':U then do:
     1500   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1501   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1502     (input  p-obj-type
     1503     ,input  p-obj-code
     1504     ,output v-db-num
     1505     )  .
     1506       if v-db-num <> g#db-num  and g#db-num <> 0 then  return ''.
     1507     end.
     1508     for each buf_thbjattr_thbj-attr
     1509     break
     1510     by buf_thbjattr_thbj-attr.upper-prop-code
     1511     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1512     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1513     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1514     :
     1515       output to ll.txt append.
     1516       export buf_thbjattr_thbj-attr.
     1517       output close.
     1518       if first-of(buf_thbjattr_thbj-attr.upper-prop-code) then do:
     1519         find first buf_thbj-attr no-lock where
     1520                   buf_thbj-attr.obj-type = p-obj-type
     1521               and buf_thbj-attr.obj-code = p-obj-code
     1522               and buf_thbj-attr.upper-prop-code = buf_thbjattr_thbj-attr.upper-prop-code
     1523               and buf_thbj-attr.prop-code = '' no-error.
     1524         if not available buf_thbj-attr then do:
     1525           create buf_thbj-attr.
     1526           assign
     1527           buf_thbj-attr.obj-type = p-obj-type
     1528           buf_thbj-attr.obj-code = p-obj-code
     1529           buf_thbj-attr.upper-prop-code = buf_thbjattr_thbj-attr.upper-prop-code
     1530           buf_thbj-attr.prop-code = ''
     1531           .
     1532         end.
     1533         v-other = ''.
     1534         v-copy-2cda = no.
     1535         run thbjattr_code in this-procedure (
     1536                                               input  buf_thbjattr_thbj-attr.upper-prop-code
     1537                                               ,input  ''
     1538                                               ,output v-label
     1539                                               ,output v-user-can-edit
     1540                                               ,output v-output-display
     1541                                               ,output v-other
     1542                                               ,output v-prop-list
     1543                                               ,output v-prop-type-list
     1544                                               ,output v-prop-label-list
     1545                                               ,output v-global
     1546                                               ,output v-host
     1547                                               ,output v-shop
     1548                                               ,output v-store
     1549                                               ,output v-db
     1550                                               ) no-error.
     1551           do v-ii = 1 to num-entries(v-other, chr(47)):
     1552             if entry(1, entry(v-ii, v-other, chr(47)), "=":U) = "copy-2cda":U then do:
     1553               assign
     1554               v-copy-2cda = logical(entry(2, entry(v-ii, v-other, chr(47)), "=":U))
     1555               .
     1556               leave.
     1557             end.
     1558           end.
     1559           if v-copy-2cda = yes then do:
     1560             assign
     1561             v-news = no
     1562             v-from-ubd = no
     1563             v-from-gbd = no
     1564             .
     1565             run cd-attr-news  in this-procedure (
     1566                                                   input buf_thbjattr_thbj-attr.upper-prop-code
     1567                                                 ,input buf_thbjattr_thbj-attr.prop-code
     1568                                                 ,output v-news
     1569                                                 ,output v-from-gbd
     1570                                                 ,output v-from-ubd ) no-error.
     1571             if g#db-num > 0
     1572             and not v-from-ubd then v-copy-2cda = no.
     1573             if g#db-num = 0
     1574             and not v-from-gbd then v-copy-2cda = no.
     1575         end.
     1576       end.
     1577       find first buf_thbj-attr no-lock where
     1578                  buf_thbj-attr.obj-type = p-obj-type
     1579              and buf_thbj-attr.obj-code = p-obj-code
     1580              and buf_thbj-attr.upper-prop-code = buf_thbjattr_thbj-attr.upper-prop-code
     1581              and buf_thbj-attr.prop-code = buf_thbjattr_thbj-attr.prop-code no-error.
     1582       if not available buf_thbj-attr then do:
     1583         create buf_thbj-attr.
     1584         buffer-copy buf_thbjattr_thbj-attr
     1585         except obj-type obj-code
     1586         to buf_thbj-attr
     1587         assign
     1588         buf_thbj-attr.obj-type = p-obj-type
     1589         buf_thbj-attr.obj-code = p-obj-code
     1590         .
     1591       end.
     1592       if v-copy-2cda then do:
     1593         for each buf_cash-desk no-lock where
     1594                 buf_cash-desk.pos-type = entry(1, buf_thbj-attr.upper-prop-code, "_")
     1595         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1596         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1597         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1598         :
     1599           find first buf_cash-desk-attr no-lock where
     1600                     buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     1601                 and buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     1602                 and buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     1603                 and buf_cash-desk-attr.cash-num = buf_Cash-desk.cash-num
     1604                 and buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     1605                 and buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code no-error.
     1606           if not available buf_cash-desk-attr then do:
     1607             create buf_cash-desk-attr.
     1608             assign
     1609             buf_cash-desk-attr.db-num = buf_Cash-desk.db-num
     1610             buf_cash-desk-attr.pos-type = buf_Cash-desk.pos-type
     1611             buf_cash-desk-attr.obj-code = buf_Cash-desk.obj-code
     1612             buf_cash-desk-attr.cash-num = buf_Cash-desk.cash-num
     1613             buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     1614             buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     1615             buf_cash-desk-attr.attr-value-character = buf_thbjattr_thbj-attr.property-value-character
     1616             buf_cash-desk-attr.attr-value-date = buf_thbjattr_thbj-attr.property-value-date
     1617             buf_cash-desk-attr.attr-value-decimal = buf_thbjattr_thbj-attr.property-value-decimal
     1618             buf_cash-desk-attr.attr-value-integer = buf_thbjattr_thbj-attr.property-value-integer
     1619             buf_cash-desk-attr.attr-value-logical = buf_thbjattr_thbj-attr.property-value-logical
     1620             buf_cash-desk-attr.attr-value-type = buf_thbjattr_thbj-attr.prop-value-type
     1621             .
     1622           end.
     1623         end.
     1624       end.
     1625     end.
     1626   end.
     1627   end procedure.
