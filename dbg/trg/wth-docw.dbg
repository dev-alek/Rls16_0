     1264       for each buf-line exclusive-lock
     1265         where buf-line.doc-code = buf-new.doc-code
     1266       on error undo main-block, return error
     1267       on end-key undo main-block, return error
     1268       :
     1269         if buf-old.status_ <> buf-new.status_
     1270         then do:
     1271           run process-line in this-procedure no-error .
