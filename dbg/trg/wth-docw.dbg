      313   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      314   procedure thbjattr_code :
      315      define input  parameter p-upper-code     as character no-undo .
      316      define input  parameter p-code           as character no-undo .
      317      define output parameter p-label          as character no-undo .
      318      define output parameter p-user-can-edit  as logical   no-undo .
      319      define output parameter p-output-display as logical   no-undo .
      320      define output parameter p-other          as character no-undo .
      321      define output parameter p-prop-list      as character no-undo .
      322      define output parameter p-prop-type-list as character no-undo .
      323      define output parameter p-prop-label-list as character no-undo .
      324      define output parameter p-global          as logical no-undo .
      325      define output parameter p-host           as logical no-undo .
      326      define output parameter p-shop           as logical no-undo .
      327      define output parameter p-store          as logical no-undo .
      328      define output parameter p-db             as logical no-undo .
      329      define variable p-region as logical no-undo.
      330      run thbjattr_code_reg in this-procedure (
      331                                               p-upper-code,
      332                                               p-code,
      333                                               output p-label,
      334                                               output p-user-can-edit,
      335                                               output p-output-display,
      336                                               output p-other,
      337                                               output p-prop-list,
      338                                               output p-prop-type-list,
      339                                               output p-prop-label-list,
      340                                               output p-global,
      341                                               output p-host,
      342                                               output p-shop,
      343                                               output p-store,
      344                                               output p-db,
      345                                               output p-region
      346                                               ).
