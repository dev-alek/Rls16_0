     1330                             , input ""
     1331                             , input 0
     1332                             , input 'attr-wthrep':U
     1333                             , input  ""
     1334                             , output v-value-character
     1335                             , output v-value-date
     1336                             , output v-value-decimal
     1337                             , output v-value-integer
     1338                             , output v-value-logical
     1339                             , output v-param-type
     1340                             , INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1341                             ) no-error .
     1342           for first thbjattr_thbj-attr
     1343                 where thbjattr_thbj-attr.obj-code  = 0
     1344                   and thbjattr_thbj-attr.obj-type  = ""
     1345                   and thbjattr_thbj-attr.prop-code = 'docdstnws':U
     1346                   and thbjattr_thbj-attr.upper-prop-code = 'attr-wthrep':U
     1347                 no-lock:
     1348               assign
     1349               v-dstnws = not thbjattr_thbj-attr.property-value-logical.
     1350           end.
     1351       end.
     1352       if  (buf-new.status_ = 'факт':U
     1353       or   buf-new.exter_ = no )
     1354       and  (lookup(buf-new.ext-doc-type,'ep,ip,pj,rp,dp,oj':U) = 0 or ( lookup(buf-new.ext-doc-type,'ep,ip,pj,rp,dp,oj':U) > 0 and v-dstnws))
     1355       then do:
     1356         run show-action in this-procedure
     1357           (input "Отправка документа в новости"
     1358           ).
     1359         run str/callnews.p
     1360           ( INPUT "wth-doc"
     1361            ,INPUT (buffer Buf-New:handle)
     1362           ) NO-ERROR.
     1363         IF ERROR-STATUS:ERROR
     1364         THEN DO:
     1365           MESSAGE
     1366           vss-workfile vss-revision vss-description                    SKIP
     1367           "Невозможно маршрутизировать wth-doc для отправки в новости" SKIP
     1368           ERROR-STATUS:GET-MESSAGE( 1 ) SKIP RETURN-VALUE             SKIP
     1369           VIEW-AS ALERT-BOX ERROR.
     1370           UNDO, RETURN ERROR.
     1371         END.
     1372       END.
     1373       if g#oxml = yes
     1374       then do:
     1375       run str/calloxml.p (
     1376             input 'update':U
     1377           , input 'wth-doc':U
     1378           , input ( buffer ub.wth-doc:handle )
     1379       ) no-error.
     1380       if error-status :error
     1381       then do:
     1382           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1383                                , chr(10)
     1384                                , vss-workfile
     1385                                , return-value
     1386                                , error-status :get-message ( 1 ) ).
     1387       end.
     1388       end.
     1389   END.
     1390    procedure process-line :
     1391     do
     1392     on error undo, return error
     1393     :
     1394       assign
     1395         num_rec   = num_rec + 1
     1396       .
     1397       if num_rec mod 10 = 0 then do:
     1398         run cur-time in this-procedure ( output v-today
     1399                                        , output v-time
     1400                                        ).
     1401         assign
     1402           current-time = string(v-time - start-time, "HH:MM:SS")
     1403         .
     1404         display
     1405           num_rec buf-line.wth-code current-time current-action
     1406           with frame a.
     1407         process events .
     1408       end.
     1409       assign
     1410       buf-line.ext-doc-type = buf-new.ext-doc-type
     1411       buf-line.status_  = buf-new.status_
     1412       buf-line.fact-order = buf-new.fact-order
     1413       buf-line.fact-date  = buf-new.fact-date
     1414       .
     1415     end.
     1416   end procedure.
     1417   procedure show-action :
     1418     do
     1419     on error undo, return error
     1420     :
     1421       define input parameter p-action as character no-undo .
     1422       define variable v-today as date      no-undo.
     1423       define variable v-time  as integer   no-undo.
     1424       run cur-time in this-procedure ( output v-today
     1425                                      , output v-time
     1426                                      ).
     1427       assign
     1428         current-time = string(v-time - start-time, "HH:MM:SS")
     1429         current-action = p-action
     1430       .
     1431       display
     1432         current-time current-action
     1433         with frame a.
     1434       process events .
     1435     end.
     1436   end procedure.
