      600   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   DEFINE VARIABLE vardoc-sum-dtl like ub.wth-dtl.doc-sum no-undo .
      602   DEFINE VARIABLE varfact-sum-dtl like ub.wth-dtl.fact-sum no-undo .
      603   DEFINE VARIABLE varbef-sum-dtl like ub.wth-dtl.bef-sum no-undo .
      604   DEFINE VARIABLE varaft-sum-dtl like ub.wth-dtl.aft-sum no-undo .
      605   DEFINE VARIABLE vardoc-sum-line like ub.wth-line.doc-sum no-undo .
      606   DEFINE VARIABLE varfact-sum-line like ub.wth-line.fact-sum no-undo .
      607   DEFINE VARIABLE varbef-sum-line like ub.wth-line.bef-sum no-undo .
      608   DEFINE VARIABLE varaft-sum-line like ub.wth-line.aft-sum no-undo .
      609   DEFINE VARIABLE varsum-gds-rubl-line  like ub.wth-line.sum-gds-rubl no-undo .
      610   DEFINE VARIABLE varsum-gds-base-line  like ub.wth-line.sum-gds-base no-undo .
      611   DEFINE VARIABLE varsum-gds-rubl-dtl   like ub.wth-dtl.sum-gds-rubl no-undo .
      612   DEFINE VARIABLE varsum-gds-base-dtl   like ub.wth-dtl.sum-gds-base no-undo .
      613   DEFINE VARIABLE varsum-gds-rubl-parts like ub.wth-dtl.sum-gds-rubl no-undo .
      614   DEFINE VARIABLE varsum-gds-base-parts like ub.wth-dtl.sum-gds-base no-undo .
      615   DEFINE VARIABLE varis-dtl as logical no-undo .
      616   DEFINE VARIABLE varis-part as logical no-undo .
      617   DEFINE VARIABLE varinst-sum like ub.chk-pay.tot-sum no-undo .
      618   DEFINE VARIABLE varchk-type like ub.chk-doc.chk-type no-undo .
      619   define buffer check_chk-pay for ub.chk-pay .
      620   define buffer check_chk-doc for ub.chk-doc .
      621   define buffer bufdsum_wealth   for ub.wealth.
      622   define variable var-entry              as character no-undo .
      623   define variable varcli-name            as character no-undo .
      624   define variable var-mes                as character no-undo .
      625   define variable v-old-can-edit-inv-on  as character no-undo .
      626   define variable v-new-can-edit-inv-on  as character no-undo .
      627   define variable l-need-check-inv       as logical   no-undo init false .
      628   define variable num_rec                as integer   no-undo .
      629   define variable start-time             as integer   no-undo .
      630   define variable current-time           as character no-undo .
      631   define variable v-today                as date      no-undo .
      632   define variable v-time                 as integer   no-undo .
      633   define variable current-action         as character no-undo .
      634   define variable v-description-doc-type as character no-undo .
      635   define variable varchk-doc-exist     as logical   no-undo .
      636   define variable v-cmp as character no-undo .
      637   define variable par-talk    as logical      no-undo.
      638   define buffer buf-line    for ub.wth-line .
      639   define buffer buf-dtl     for ub.wth-dtl .
      640   define buffer buf_sysconf for ub.sysconf .
      641   define buffer buf_wth-parts   for ub.wth-parts.
      642   define buffer buf_out-wth-doc for ub.wth-doc.
      643   assign
      644     v-description-doc-type = buf-new.doc-type
      645                            + " " + string(buf-new.inter_, "внут/внеш")
      646   .
      647   define frame a
      648     buf-new.doc-code                           label "Документ" skip
      649     v-description-doc-type                     label "Тип документа" skip
      650     current-action         format "x(40)"      no-label skip
      651     num_rec                format ">>>>>>>9"   label "Обработано МЦ" skip
      652     buf-line.wth-code                          label "Текущий код МЦ" skip
      653     current-time           format "x(8)"       label "Время" skip
      654     with view-as dialog-box side-labels three-d
      655     title "Обработка документа"
      656     .
      657   main-block:
      658   do
      659   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      660   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      661   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      662   :
      663     if available buf-old
      664     then do:
      665   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthdat in g#library
      667     (input  buf-old.doc-type
      668     ,input   (NOT buf-new.exter_)
      669     ,input  buf-old.status_
      670     ,input  'can-change-status-inv-on=request'
      671     ,output v-old-can-edit-inv-on
      672     ) no-error .
      673       if error-status :error
      674       then do:
      675         message
      676           vss-workfile vss-revision vss-description skip
      677           "Невозможно запросить признак документа МЦ (buf-old)" skip
      678           "Документ" buf-new.doc-code skip
      679           error-status :get-message(1) skip
      680           return-value skip
      681           view-as alert-box error .
      682         undo, return error .
      683       end.
      684     end.
      685     else do:
      686       assign
      687         v-old-can-edit-inv-on = "true":u
      688       .
      689     end.
      690   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      691   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthdat in g#library
      692     (input  buf-new.doc-type
      693     ,input   (NOT buf-new.exter_)
      694     ,input  buf-new.status_
      695     ,input  'can-change-status-inv-on=request'
      696     ,output v-new-can-edit-inv-on
      697     ) no-error .
      698     if error-status :error
      699     then do:
      700       message
      701         vss-workfile vss-revision vss-description skip
      702         "Невозможно запросить признак документа МЦ (wth-doc)" skip
      703         "Документ" buf-new.doc-code skip
      704         error-status :get-message(1) skip
      705         return-value skip
      706         view-as alert-box error .
      707       undo, return error .
      708     end.
      709     if not g#news
      710     then do:
      711       if v-new-can-edit-inv-on <> "true":u
      712       or v-old-can-edit-inv-on <> "true":u
      713       or buf-new.status_ = 'факт':U
      714       or (buf-new.doc-type    = 'инв':U
      715           and buf-new.status_ = 'разрешен':U
      716           )
      717       then do:
      718         assign
      719           l-need-check-inv = true
      720         .
      721       end.
      722       if not new buf-new
      723       and buf-old.doc-type = 'инв':U
      724       and buf-old.status_  = 'разрешен':U
      725       then do:
      726         assign
      727           l-need-check-inv = false
      728         .
      729       end.
      730     end.
      731     if buf-new.auto-fill
      732     then do:
      733       find first buf_sysconf no-lock
      734         where buf_sysconf.host-code = buf-new.host-code
      735         no-error .
      736       if not available buf_sysconf
      737       then do:
      738         message
      739           vss-workfile vss-revision vss-description skip
      740           "Неизвестная фирма для документа МЦ (wth-doc)" skip
      741           "Документ" buf-new.doc-code skip
      742           error-status :get-message(1) skip
      743           return-value skip
      744           view-as alert-box error .
      745         undo, return error .
      746       end.
      747       if  buf-new.cli-type = buf_sysconf.sale-type
      748       and buf-new.cli-code = buf_sysconf.sale-code
      749       then do:
      750         assign
      751           varchk-doc-exist = no
      752         .
      753       end.
      754       else do:
      755         assign
      756           varchk-doc-exist = yes
      757         .
      758       end.
      759     end.
      760     if buf-new.borned
      761     then do:
      762       assign
      763         varchk-doc-exist = no
      764       .
      765     end.
      766     if not g#news  or buf-new.user-db-num = ?
      767     then do:
      768   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
      770     (output buf-new.user-db-num
      771     ,output buf-new.user-name
      772     ,output buf-new.sys-date
      773     ,output buf-new.sys-time
      774     ,output buf-new.sys-time-int
      775     )  .
      776       if g#news then buf-new.user-name  =  (chr(4) +  'СПН':U).
      777     end.
      778     if  buf-new.creid = '' and g#news then buf-new.creid = (chr(4) +  'СПН':U).
      779     else if  buf-new.creid = '' then
      780     buf-new.creid = g#userid .
      781    if (not g#news and buf-new.status_ = 'факт':U) or (g#news and  g#db-num = 0)
      782     then do:
      783         run trg/lock-wth.p
      784           (input buf-new.doc-code
      785           ,input l-need-check-inv
      786           ,input buf-new.fact-order
      787           ,input (buf-new.status_ = 'факт':U)
      788           ,input g#news
      789           ) no-error .
      790         if error-status :error
      791         then do:
      792           message
      793             "Не удалось наложить блокировку на все товары принадлежащие документу" skip
      794             "Документ" buf-new.doc-code skip
      795             error-status :get-message(1) skip
      796             return-value skip
      797             view-as alert-box information .
      798           undo main-block, return error .
      799         end.
      800     end.
      801     if g#news   and buf-new.status_ = 'факт':U
      802     then do:
      803       run str/stkotwth.p
      804         (input recid( buf-new )
      805         ,input no
      806         ,input yes
      807         ,input 0) no-error .
      808       if error-status :error
      809       then do:
      810         MESSAGE
      811         vss-workfile vss-revision SKIP vss-description   SKIP
      812         "Ошибка при установке остатков МЦ на объекте!"   SKIP
      813         ERROR-STATUS:GET-MESSAGE( 1 ) SKIP RETURN-VALUE SKIP
      814         VIEW-AS ALERT-BOX ERROR.
      815         UNDO, RETURN ERROR.
      816       END.
      817       if buf-new.is-back-date then do:
      818             run cur-time in this-procedure ( output v-today, output v-time).
      819             FOR EACH buf-line NO-LOCK WHERE
      820             buf-line.doc-code = buf-new.doc-code ON ERROR UNDO Main-Block, RETURN ERROR :
      821               run str/reclcwtl.p
      822                 (input buf-new.obj-type
      823                 ,input buf-new.obj-code
      824                 ,input buf-new.fact-ord - 0.0000000001
      825                 ,input buf-line.wth-code
      826                 ,input no
      827                 ,input 'close':U
      828                 ,input buf-new.doc-code
      829                 ,input buf-new.fact-date
      830                 ,input g#db-num
      831                 ,input g#userid
      832                 ,input v-today
      833                 ,input v-time
      834                 ,input string(v-time, "HH:MM:SS")
      835                 ) no-error .
      836               if error-status :error then do:
      837                 MESSAGE substitute("&1 &2 &3&4" +
      838                                       "Ошибка при пересчете остатков при закрытии док-та МЦ &5 задним числом&4"  +
      839                                       "&6&4&7"
      840                                       ,vss-workfile
      841                                       ,vss-revision
      842                                       ,vss-description
      843                                       ,chr(10)
      844                                       ,error-status :get-message(1)
      845                                       , return-value )  VIEW-AS ALERT-BOX ERROR.
      846                 UNDO Main-Block, RETURN ERROR var-mes.
      847               end.
      848             end.
      849       end.
      850     END.
      851     ELSE if not g#news and buf-new.status_ = 'факт':U
      852     then DO:
      853       run cur-time in this-procedure ( output v-today
      854                                     , output start-time
      855                                     ).
      856       assign
      857         current-action = "Обработка шапки документа."
      858       .
      859       run show-action in this-procedure
      860         (input "Обработка шапки документа."
      861         ).
      862         run gbl/chk-date.p
      863           (input buf-new.obj-type
      864           ,input buf-new.obj-code
      865           ,input buf-new.fact-date
      866           ,input buf-new.fact-time
      867           ,input buf-new.shift-date
      868           ,input buf-new.shift-num
      869           ,input yes
      870           ) no-error .
      871         if error-status :error
      872         then do:
      873           message
      874             vss-workfile vss-revision vss-description skip
      875             "Ошибка при установке дат, времен, смен в документе (wth-doc)." skip
      876             "Документ МЦ" buf-new.doc-code skip
      877             "fact-date"  buf-new.fact-date  skip
      878             "fact-time"  buf-new.fact-time  skip
      879             "shift-date" buf-new.shift-date skip
      880             "shift-num"  buf-new.shift-num  skip
      881             error-status :get-message(1) skip
      882             return-value skip
      883             view-as alert-box error .
      884           undo main-block, return error.
      885         end.
      886         CASE buf-new.doc-type:
      887           when 'инв':U
      888           then do:
      889             run trg/wth-inv2.p (
      890                   input no,
      891                   input buf-new.doc-code,
      892                   input buf-new.host-code,
      893                   input buf-new.obj-type,
      894                   input buf-new.obj-code,
      895                   input buf-new.operator,
      896                   input buf-new.deliver,
      897                   input buf-new.receiver,
      898                   input buf-new.inv-prs4,
      899                   input buf-new.inv-prs5,
      900                   input buf-new.auto-fill,
      901                   input yes,
      902                   input yes,
      903                   output varcli-name ) no-error.
      904           end.
      905           otherwise do:
      906             run trg/wth-inc2.p (
      907                   input no,
      908                   input buf-new.doc-code,
      909                   input buf-new.host-code,
      910                   input buf-new.obj-type,
      911                   input buf-new.obj-code,
      912                   input buf-new.cli-type,
      913                   input buf-new.cli-code,
      914                   input buf-new.operator,
      915                   input buf-new.deliver,
      916                   input buf-new.receiver,
      917                   input buf-new.doc-type,
      918                   input buf-new.auto-fill,
      919                   input buf-new.exter_,
      920                   input buf-new.inter_,
      921                   input buf-new.source-ref,
      922                   input buf-new.source-type,
      923                   input buf-new.borned,
      924                   input yes,
      925                   input buf-new.ext-doc-type  ,
      926                   output varcli-name) no-error.
      927           end.
      928         END CASE.
      929         if error-status:error
      930         then do:
      931            var-entry = return-value.
      932            UNDO Main-Block, RETURN ERROR var-entry.
      933         end.
      934       if  buf-new.doc-type <> 'обмен':U
      935       then do:
      936   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   assign
      938   vardoc-sum-dtl = 0
      939   varfact-sum-dtl = 0
      940   varbef-sum-dtl = 0
      941   varaft-sum-dtl = 0
      942   vardoc-sum-line = 0
      943   varfact-sum-line = 0
      944   varbef-sum-line = 0
      945   varaft-sum-line = 0
      946   varinst-sum = 0
      947   varsum-gds-rubl-line = 0
      948   varsum-gds-base-line = 0
      949   varsum-gds-rubl-dtl = 0
      950   varsum-gds-base-dtl = 0
      951   varsum-gds-rubl-parts = 0
      952   varsum-gds-base-parts = 0
      953   .
      954   FOR EACH buf-line No-LOCK WHERE
      955            buf-line.doc-code = buf-new.doc-code:
      956     assign
      957     vardoc-sum-dtl = 0
      958     varfact-sum-dtl = 0
      959     varbef-sum-dtl = 0
      960     varaft-sum-dtl = 0
      961     varsum-gds-rubl-dtl = 0
      962     varsum-gds-base-dtl = 0
      963     varis-dtl = no
      964     .
      965     FOR EACH buf-dtl No-LOCK WHERE
      966              buf-dtl.doc-code = buf-line.doc-code AND
      967              buf-dtl.wth-code = buf-line.wth-code AND
      968              buf-dtl.w-p-code = buf-line.w-p-code:
      969       assign
      970       varis-dtl = yes
      971       vardoc-sum-dtl = vardoc-sum-dtl + buf-dtl.doc-sum
      972       varfact-sum-dtl = varfact-sum-dtl + buf-dtl.fact-sum
      973       varbef-sum-dtl = varbef-sum-dtl + buf-dtl.bef-sum
      974       varaft-sum-dtl = varaft-sum-dtl + buf-dtl.aft-sum
