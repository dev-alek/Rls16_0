      348   procedure thbjattr_code_reg :
      349   define input  parameter p-upper-code     as character no-undo .
      350   define input  parameter p-code           as character no-undo .
      351   define output parameter p-label          as character no-undo .
      352   define output parameter p-user-can-edit  as logical   no-undo .
      353   define output parameter p-output-display as logical   no-undo .
      354   define output parameter p-other          as character no-undo .
      355   define output parameter p-prop-list      as character no-undo .
      356   define output parameter p-prop-type-list as character no-undo .
      357   define output parameter p-prop-label-list as character no-undo .
      358   define output parameter p-global          as logical no-undo .
      359   define output parameter p-host           as logical no-undo .
      360   define output parameter p-shop           as logical no-undo .
      361   define output parameter p-store          as logical no-undo .
      362   define output parameter p-db             as logical no-undo .
      363   define output parameter p-region         as logical no-undo .
      364   do
      365   on error undo, return error return-value
      366   :
      367       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      368       (input  p-upper-code
      369       ,input  p-code
      370       ,output p-label
      371       ,output p-user-can-edit
      372       ,output p-output-display
      373       ,output p-other
      374       ,output p-prop-list
      375       ,output p-prop-type-list
      376       ,output p-prop-label-list
      377       ,output p-global
      378       ,output p-host
      379       ,output p-shop
      380       ,output p-store
      381       ,output p-db
      382       ,output p-region
      383       ) no-error .
      384     if error-status :error
      385     then do:
      386       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      387     end.
      388   end.
      389   end procedure.
