     1290         where buf_wth-parts.out-code = buf-new.doc-code
     1291       on error undo main-block, return error 'Oшибка обработки партий МЦ'
     1292       on end-key undo main-block, return error 'Oшибка обработки партий МЦ'
     1293       :
