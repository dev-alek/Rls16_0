      507       ,input  p-code
      508       ,input  p-value-character
      509       ,input  p-value-date
      510       ,input  p-value-decimal
      511       ,input  p-value-integer
      512       ,input  p-value-logical
      513       ) no-error .
      514     if error-status :error
      515     then do:
      516       undo, return error return-value .
      517     end.
      518   end.
      519   end procedure.
      520   procedure thbjattr_set-section :
      521   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      522   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      523   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
      524   define input  parameter table-handle p-tth.
