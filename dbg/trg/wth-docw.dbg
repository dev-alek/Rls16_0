      526   on error undo, return error return-value
      527   :
      528       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_set-section in g#attr-lib
      529       (input  p-obj-type
      530       ,input  p-obj-code
      531       ,input  p-upper-code
      532       ,input  table-handle p-tth
      533       ) no-error .
      534     if error-status :error
      535     then do:
      536       delete object p-tth.
      537       undo, return error return-value .
      538     end.
      539     delete object p-tth.
      540   end.
      541   end procedure.
