        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.pl-gds-pump NEW BUFFER new_pl-gds-pump OLD BUFFER old_pl-gds-pump.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Триггер на запись pl-gds-pump":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                            , new_pl-gds-pump.obj-type
       30                            , new_pl-gds-pump.obj-code
       31                            , new_pl-gds-pump.gds-code
       32                            , new_pl-gds-pump.pump-code
       33                            , new_pl-gds-pump.pl-code
       34                             )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure cur-time :
       89      define output parameter p-today as date      no-undo .
       90      define output parameter p-time  as integer   no-undo .
       91     do
       92     on error undo, return error
       93     :
       94       define variable v-date1 as date      no-undo .
       95       define variable v-date2 as date      no-undo .
       96       define variable v-time  as integer   no-undo .
       97       assign
       98         v-date1 = today
       99         v-time  = time
      100         v-date2 = today
      101       .
      102       if v-date1 <> v-date2
      103       then do:
      104         assign
      105           v-date1 = today
      106           v-time  = v-time
      107         .
      108       end.
      109       assign
      110         p-today = v-date1
      111         p-time  = v-time
      112       .
      113     end.
      114   end.
      115   function cur-time-date returns character
      116   :
      117     return string(today, '99/99/9999':U) .
      118   end.
      119   function cur-time-mjd returns decimal
      120   :
      121     define variable v-date as date      no-undo .
      122     define variable v-time as integer   no-undo .
      123     run cur-time in this-procedure
      124       (output v-date
      125       ,output v-time
      126       ) .
      127     return integer(v-date) - 2400002 + (v-time / 86400) .
      128   end.
      129   function cur-time-get-ending-index returns integer
      130   (input p-number as integer
      131   )
      132   :
      133     if p-number < 0
      134     or p-number = ?
      135     then do:
      136       return 1 .
      137     end.
      138     define variable v-rest as integer   no-undo .
      139     assign
      140       p-number = p-number modulo 100
      141     .
      142     if p-number < 20
      143     then do:
      144       assign
      145         v-rest = p-number
      146       .
      147     end.
      148     else do:
      149       assign
      150         v-rest = p-number modulo 10
      151       .
      152     end.
      153     case v-rest :
      154       when 1
      155       then do:
      156         return 2 .
      157       end.
      158       when 2 or
      159       when 3 or
      160       when 4
      161       then do:
      162         return 3 .
      163       end.
      164       otherwise do:
      165         return 1 .
      166       end.
      167     end case .
      168   end.
      169   procedure cur-time-mjd-to-date :
      170      define input  parameter i-mjd-diff as decimal no-undo.
      171      define output parameter o-Date     as date    no-undo.
      172      define output parameter o-Time     as integer no-undo.
      173      define variable v-day-number as integer   no-undo .
      174      if    i-mjd-diff < 0
      175         or i-mjd-diff = ?
      176      then do:
      177         return "?" .
      178      end.
      179      assign
      180         v-day-number = truncate(i-mjd-diff,0).
      181         o-Date = date(v-day-number + 2400002).
      182         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184   end.
      185   function cur-time-mjd-to-string returns character
      186   (input p-mjd-diff as decimal
      187   )
      188   :
      189     define variable v-day-number as integer   no-undo .
      190     define variable v-seconds    as integer   no-undo .
      191     define variable v-hour       as integer   no-undo .
      192     define variable v-min        as integer   no-undo .
      193     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      194     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      195     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      196     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      197     if p-mjd-diff < 0
      198     or p-mjd-diff = ?
      199     then do:
      200       return "?" .
      201     end.
      202     assign
      203       v-day-number = integer(truncate(p-mjd-diff,0))
      204       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206     if v-seconds > 86400
      207     then do:
      208       assign
      209         v-seconds = 86400 - 1
      210       .
      211     end.
      212     if v-seconds < 0
      213     then do:
      214       assign
      215         v-seconds = 0
      216       .
      217     end.
      218     assign
      219       v-hour = truncate(v-seconds / 3600, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 3600
      223     .
      224     assign
      225       v-min = truncate(v-seconds / 60, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 60
      229     .
      230     return
      231         (if v-day-number <> 0
      232           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0
      236           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      240           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      241           else ""
      242         )
      243       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      244       .
      245   end.
      246   function cur-time-string returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      255   end.
      256   function cur-time-string-sec returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      265   end.
      266   function cur-time-custom  returns character
      267   (input p-prefix as character
      268   ,input p-date-format as character
      269   ,input p-delimiter as character
      270   ,input p-time-format as character
      271   ,input p-suffix as character
      272   )
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return
      281       p-prefix
      282       + string(v-date, p-date-format)
      283       + p-delimiter
      284       + string(v-time, p-time-format)
      285       + p-suffix
      286       .
      287   end.
      288   function cur-time-print  returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-datetime returns datetime
      299   :
      300     define variable v-char as character no-undo .
      301     define variable v-datetime as datetime no-undo .
      302     v-char = cur-time-string().
      303     v-datetime = datetime(v-char).
      304     return  v-datetime.
      305   end.
      306   function cur-time-string-msec returns character
      307   :
      308     define variable v-date as datetime  no-undo .
      309     v-date = now.
      310     return string(v-date) .
      311   end.
      312   DEFINE VARIABLE v-today     as date    no-undo .
      313   DEFINE VARIABLE v-time      as integer no-undo .
      314   define variable v-host-code like ub.sysconf.host-code no-undo .
      315   define buffer buf_c-pl-gds-pump for ub.c-pl-gds-pump.
      316   define buffer buf_c-gds-hist    for ub.c-gds-hist.
      317   define buffer buf_c-plc-hist    for ub.c-plc-hist.
      318   define buffer buf_c-pmp-hist    for ub.c-pmp-hist.
      319   define buffer buf_c-table-bind  for ub.c-table-bind.
      320   main-block:
      321   do
      322       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      323       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      324       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      325       :
      326       run str/callnews.p
      327           ( input 'pl-gds-pump':U
      328           ,input ( buffer new_pl-gds-pump :handle )
      329           ).
      330       if g#news <> yes then
      331       do:
      332           run cur-time in this-procedure(output v-today, output v-time).
      333           create buf_c-pl-gds-pump.
      334           buffer-copy old_pl-gds-pump
      335               except
      336               gds-code
      337               obj-type
      338               obj-code
      339               pl-code
      340               gds-code
      341               pump-code
      342               to buf_c-pl-gds-pump
      343               assign
      344               buf_c-pl-gds-pump.gds-code           = new_pl-gds-pump.gds-code
      345               buf_c-pl-gds-pump.obj-type           = new_pl-gds-pump.obj-type
      346               buf_c-pl-gds-pump.obj-code           = new_pl-gds-pump.obj-code
      347               buf_c-pl-gds-pump.pl-code            = new_pl-gds-pump.pl-code
      348               buf_c-pl-gds-pump.pump-code          = new_pl-gds-pump.pump-code
      349               buf_c-pl-gds-pump.chip-num           = next-value (s-plc-chip, ub)
      350               buf_c-pl-gds-pump.corr-time          = v-time
      351               buf_c-pl-gds-pump.corr-user-db-num   = g#db-num
      352               buf_c-pl-gds-pump.corr-user-name     = g#userid
      353               buf_c-pl-gds-pump.corr-date          = v-today
      354               .
      355           create buf_c-plc-hist.
      356           buffer-copy buf_c-pl-gds-pump to buf_c-plc-hist
      357               assign
      358               buf_c-plc-hist.action = (if new new_pl-gds-pump then integer('1':U) else integer('2':U))
      359               buf_c-plc-hist.subject = 'pl-gds-pump':U
      360               buf_c-plc-hist.is-news = g#news
      361               .
      362           if buf_c-pl-gds-pump.status_ <> new_pl-gds-pump.status_ then
      363           do:
      364               define variable v-vid-param as LONGCHAR  no-undo .
      365               define variable v-gds-name  as character no-undo .
      366               find first ub.goods no-lock where ub.goods.gds-code = buf_c-plc-hist.gds-code no-error .
      367               if AVAILABLE ub.goods then
      368               do:
      369                   v-gds-name = ub.goods.gds-name .
      370               end.
      371   define variable v-initiator  as character no-undo.
      372   case true:
      373     when g#auto then v-initiator = "Auto".
      374     when g#news then v-initiator = "Nws".
      375     when g#esys then v-initiator = "Esys".
      376     otherwise v-initiator = "User".
      377   end case.
      378               v-vid-param =
      379                   "Initiator=" + v-initiator + chr(4) +
      380                   "SHOP_NUM=" + string(buf_c-plc-hist.obj-code) + chr(4) +
      381                   "pl-code=" + string(buf_c-plc-hist.pl-code) + chr(4) +
      382                   "old-status_=" + buf_c-pl-gds-pump.status_  + chr(4) +
      383                   "status_=" + new_pl-gds-pump.status_ + chr(4) +
      384                   "gds-code=" + string(buf_c-plc-hist.gds-code) + chr(4) +
      385                   "gds-name=" + v-gds-name.
      386               run trg/userlog.p (
      387                   input 'update':U
      388                   , input 'c-plc-hist':U
      389                   , input ( buffer buf_c-plc-hist :handle )
      390                   , input 61
      391                   , input v-vid-param
      392                   ) no-error.
      393               if error-status :error
      394                   then
      395               do:
      396                   undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      397                       , chr(10)
      398                       , vss-workfile
      399                       , return-value
      400                       , error-status :get-message ( 1 ) ).
      401               end.
      402           end.
      403   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      404   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      405     (input  new_pl-gds-pump.obj-type
      406     ,input  new_pl-gds-pump.obj-code
      407     ,output v-host-code
      408     )  .
      409           create buf_c-gds-hist.
      410           buffer-copy buf_c-pl-gds-pump
      411               except chip-num
      412               to buf_c-gds-hist
      413               assign
      414               buf_c-gds-hist.action = (if new new_pl-gds-pump then integer('1':U) else integer('2':U))
      415               buf_c-gds-hist.subject = 'pl-gds-pump':U
      416               buf_c-gds-hist.host-code = v-host-code
      417               buf_c-gds-hist.is-news = g#news
      418               buf_c-gds-hist.chip-num =   next-value (s-gds-chip, ub)
      419               buf_c-gds-hist.source-type = (if g#news then 'db':U else "":U)
      420               buf_c-gds-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      421               .
      422           create buf_c-table-bind.
      423           assign
      424               buf_c-table-bind.chip-num-rec     = buf_c-gds-hist.chip-num
      425               buf_c-table-bind.chip-num-src     = buf_c-pl-gds-pump.chip-num
      426               buf_c-table-bind.corr-user-db-num = buf_c-pl-gds-pump.corr-user-db-num
      427               buf_c-table-bind.tbl-name-rec     = 'c-gds-hist':U
      428               buf_c-table-bind.tbl-name-src     = 'c-plc-hist':U
      429               buf_c-table-bind.is-news          = g#news
      430               buf_c-table-bind.corr-user-name   = g#userid
      431               buf_c-table-bind.subject          = 'pl-gds-pump':U
      432               .
      433           create buf_c-pmp-hist.
      434           buffer-copy buf_c-pl-gds-pump
      435               except chip-num
      436               to buf_c-pmp-hist
      437               assign
      438               buf_c-pmp-hist.action = (if new new_pl-gds-pump then integer('1':U) else integer('2':U))
      439               buf_c-pmp-hist.chip-num = next-value (s-pmp-chip, ub)
      440               buf_c-pmp-hist.subject = 'pl-gds-pump':U
      441               buf_c-pmp-hist.is-news = g#news
      442               buf_c-pmp-hist.gds-code = new_pl-gds-pump.gds-code
      443               .
      444           create buf_c-table-bind.
      445           assign
      446               buf_c-table-bind.chip-num-rec     = buf_c-pmp-hist.chip-num
      447               buf_c-table-bind.chip-num-src     = buf_c-pl-gds-pump.chip-num
      448               buf_c-table-bind.corr-user-db-num = buf_c-pl-gds-pump.corr-user-db-num
      449               buf_c-table-bind.tbl-name-rec     = 'c-pmp-hist':U
      450               buf_c-table-bind.tbl-name-src     = 'c-plc-hist':U
      451               buf_c-table-bind.is-news          = g#news
      452               buf_c-table-bind.corr-user-name   = g#userid
      453               buf_c-table-bind.subject          = 'pl-gds-pump':U
      454               .
      455       end.
      456       if g#oxml = yes
      457           then
      458       do:
      459           run str/calloxml.p (
      460               input 'update':U
      461               , input 'pl-gds-pump':U
      462               , input ( buffer ub.pl-gds-pump:handle )
      463               ) no-error.
      464           if error-status :error
      465               then
      466           do:
      467               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      468                   , chr(10)
      469                   , vss-workfile
      470                   , return-value
      471                   , error-status :get-message ( 1 ) ).
      472           end.
      473       end.
      474   end.
