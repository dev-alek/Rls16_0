     2190                         ,output par-pl-pfx
     2191                         ,output dopst) no-error.
     2192     if error-status :error or dopst <> "C":U then
     2193       par-pl-pfx = ?.
     2194     run gbl/conf-rd.p ( input "pl-frmt"
     2195                         ,input ""
     2196                         ,input ""
     2197                         ,input 0
     2198                         ,input ""
     2199                         ,input ""
     2200                         ,input ""
     2201                         ,input no
     2202                         ,output par-pl-frmt
     2203                         ,output dopst) no-error.
     2204     if error-status :error or dopst <> "C":U then
     2205       par-pl-frmt = ?.
     2206     if p-b-str begins par-bc-pfx and
     2207         (length (p-b-str) = 13 and
     2208         par-bc-frmt = "EAN13" or
     2209         length (p-b-str) = 8 and
     2210         par-bc-frmt = "EAN8") or
     2211         (p-b-str begins par-pl-pfx and
     2212         par-pl-pfx <> ? and
     2213         par-pl-frmt <> ?) and
     2214         (length (p-b-str) = 13 and
     2215         par-pl-frmt = "EAN13" or
     2216         length (p-b-str) = 8 and
     2217         par-pl-frmt = "EAN8")
     2218     then do:
     2219       v-mess = "Бар-код имеет префикс, зарезервированный для собственных товарных (складских мест) бар-кодов.".
     2220       run err-mess in this-procedure ( input-output v-mess).
     2221       undo, return error (if p-silent then v-mess else '').
     2222     end.
     2223     p-b:
     2224     do transaction
     2225     on error undo, return error return-value
     2226     :
     2227       add-on = yes.
     2228       for each same-prod-bc
     2229           where same-prod-bc.b-str = p-b-str
     2230       on error undo p-b, return error return-value
     2231       :
     2232         if same-prod-bc.b-code = p-b-code
     2233         then do:
     2234           v-mess = "Такой дополнительный бар-код уже существует.".
     2235           run err-mess in this-procedure ( input-output v-mess).
     2236           undo p-b, return (if p-silent then v-mess else '') .
     2237         end.
     2238         if length (p-b-str) < 3
     2239         then do:
     2240           v-mess =  "Повторные дополнительные коды для топливных товаров запрещены.".
     2241           run err-mess in this-procedure ( input-output v-mess).
     2242           undo p-b, return (if p-silent then v-mess else '') .
     2243         end.
     2244         find same-bar-code where
     2245               same-bar-code.b-code = same-prod-bc.b-code no-lock no-error.
     2246         if available same-bar-code then do:
     2247           find same-goods where
     2248                 same-goods.gds-code = same-bar-code.gds-code no-lock no-error.
     2249           if available same-goods then do:
     2250             if  same-goods.prod-type = buf_goods.prod-type
     2251             and same-goods.prod-code = buf_goods.prod-code
     2252             and dif-pdbc = yes
     2253             then do:
     2254               v-mess = substitute("Такой дополнительный бар-код уже существует для производителя: &1&2"
     2255                                   ,buf_goods.prod-type
     2256                                   ,buf_goods.prod-code).
     2257               run err-mess in this-procedure ( input-output v-mess).
     2258               undo p-b, return (if p-silent then v-mess else '') .
     2259             end.
     2260             find  same-gds-prt where
     2261                   same-gds-prt.node-code = same-bar-code.node-code no-lock no-error.
     2262             if available same-gds-prt then do:
     2263               v-mess = substitute("Для добавляемого дополнительного бар-кода найден повторный бар-код :&1&2&1&1" +
     2264                                     "Артикул :&3&1" +
     2265                                     "Код товара :&4&1" +
     2266                                     "Название :&5&1" +
     2267                                     "Единица измерения :&6&1&1" +
     2268                                     "Признак :&7&1" +
     2269                                     "Номер партии :&8&1" +
     2270                                     "Номер ПН :&9"
     2271                                   ,chr(10)
     2272                                   ,p-b-str
     2273                                   ,same-goods.artic
     2274                                   ,same-goods.gds-code
     2275                                   ,same-goods.gds-name
     2276                                   ,same-bar-code.unit-cli
     2277                                   ,same-gds-prt.f-name
     2278                                   ,same-bar-code.part-code
     2279                                   ,same-bar-code.in-code).
     2280               if not p-silent
     2281               and not g#news then do:
     2282                 message
     2283                 v-mess
     2284                 view-as alert-box warning.
     2285               end.
     2286               if p-cdrg-type eq 'GTIN':U
     2287               then
     2288                  undo p-b, return (if p-silent then v-mess else '') .
     2289             end.
     2290             if pbc-veto = yes then do:
     2291               if same-goods.gds-code <> buf_goods.gds-code then do:
     2292                 v-mess = substitute("Такой дополнительный бар-код  (&1) уже существует для товара:&2&3" +
     2293                                     "Код товара: &4&2" +
     2294                                     "Артикул: &5&2" +
     2295                                     "Производитель: &6&7&2" +
     2296                                     "Наименование: &8&2" +
     2297                                     "Добавление повторных бар-кодов запрещено."
     2298                                     ,p-b-str
     2299                                     ,chr(10)
     2300                                     ,chr(9)
     2301                                     ,same-goods.gds-code
     2302                                     ,same-goods.prod-type
     2303                                     ,same-goods.prod-code
     2304                                     ,same-goods.artic
     2305                                     ,same-goods.gds-name ).
     2306                 run err-mess in this-procedure ( input-output v-mess).
     2307                 undo p-b, return (if p-silent then v-mess else '') .
     2308               end.
     2309             end.
     2310           end.
     2311         end.
     2312         run trg/bc-upd.p
     2313           (input parparentproc
     2314           ,input p-b-code
     2315           ,input p-b-str
     2316           ,input yes
     2317           ,input p-silent
     2318           ,input send-ref
     2319           ,input recid(same-prod-bc)
     2320           ,input ?
     2321           ) no-error .
     2322         if error-status :error
     2323         then do:
     2324           if return-value <> "":U
     2325           then do:
     2326             v-mess = return-value .
     2327             run err-mess in this-procedure ( input-output v-mess).
     2328           end.
     2329           undo p-b, return (if p-silent then v-mess else '') .
     2330         end.
     2331         assign
     2332           add-on = no
     2333         .
     2334       end.
     2335       if not add-on
     2336       and not p-silent
     2337       then do:
     2338         define variable v-ok as logical   no-undo .
     2339         assign
     2340           v-ok = true
     2341         .
     2342         message
     2343           "Добавляемый бар-код будет добавлен как ВЫКЛЮЧЕННЫЙ" skip
     2344           "(поскольку были найдены повторные бар-коды)." skip
     2345           "Продолжить?" skip
     2346           view-as alert-box question buttons yes-no update v-ok .
     2347         if v-ok <> true
     2348         then do:
     2349           undo p-b, return (if p-silent then v-mess else '') .
     2350         end.
     2351       end.
     2352     end.
     2353   do
     2354   on error undo, return error return-value
     2355   :
     2356     create buf_prod-bc.
     2357     assign
     2358     buf_prod-bc.b-str = p-b-str
     2359     buf_prod-bc.b-code = p-b-code
     2360     buf_prod-bc.bc-on = add-on
     2361     buf_prod-bc.bc-on-type = p-cdrg-type
     2362     p-recid = recid(buf_prod-bc)
     2363     .
     2364     if p-nedeMark
     2365     then do:
     2366        create buf_prod-bc-attr.
     2367        assign
     2368           buf_prod-bc-attr.b-str  = p-b-str
     2369           buf_prod-bc-attr.b-code = p-b-code
     2370           buf_prod-bc-attr.attr-code = 'mark':U
     2371           buf_prod-bc-attr.attr-value = "yes"
     2372        .
     2373     end.
     2374   end.
     2375   PROCEDURE err-mess:
     2376     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     2377     CASE p-silent:
     2378       when yes then do:
     2379         assign
     2380         p-mess = substitute("Создание ДопБК для товара с кодом &1 на бар-код &2:&3&4"
     2381                            , buf_goods.gds-code
     2382                            , p-b-code
     2383                            , chr(10)
     2384                            , p-mess)
     2385         .
     2386       end.
     2387       when no then do:
     2388         message
     2389         p-mess
     2390         view-as alert-box error .
     2391       end.
     2392     end.
     2393   END PROCEDURE.
