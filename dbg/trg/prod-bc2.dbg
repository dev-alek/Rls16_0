        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo .
        3   define input  parameter p-silent as logical   no-undo .
        4   define input  parameter dif-pdbc as logical no-undo initial no.
        5   define input  parameter pbc-veto  as logical no-undo.
        6   define input  parameter send-ref as logical   no-undo .
        7   define input  parameter p-cdrg-type as character no-undo .
        8   define input  parameter p-ean-type as character no-undo .
        9   define parameter buffer buf_goods for ub.goods.
       10   define input  parameter p-b-code as integer   no-undo .
       11   define input  parameter p-nedeMark as logical   no-undo .
       12   define input-output  parameter p-b-str as character no-undo .
       13   define output parameter p-recid as recid no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Сохранение ДопБК".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure gen-b-code :
       91     define input  parameter type-code like ub.code-range.range-type no-undo .
       92     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
       93     do
       94     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       95     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
       96     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
       97     :
       98       define buffer buf_thbj-attr     for ub.thbj-attr .
       99       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      100       define buffer buf_code-range for ub.code-range .
      101       define variable l-code         as   integer              no-undo .
      102       define variable v-db-num       like ub.db.db-num         no-undo .
      103       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      104       if type-code = 'sslc':U
      105       or type-code = 'ssgb':U
      106       then do:
      107         message
      108           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      109           "Обратитесь к администратору системы."
      110           view-as alert-box error .
      111         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      112       end.
      113       run trg/getpcode.p ( input  type-code
      114                      ,output cfg-param-code
      115                     ).
      116       run get-next-seq( input  type-code,
      117                         output l-code
      118                       ).
      119       find first buf_sys-ctrl no-lock.
      120       if type-code = 'sclc':U
      121       or type-code = 'pglc':U
      122       then do:
      123         assign
      124           v-db-num = 0
      125         .
      126       end.
      127       else do:
      128         assign
      129           v-db-num = buf_sys-ctrl.db-num
      130         .
      131       end.
      132       find first buf_code-range no-lock
      133         where buf_code-range.db-num     = v-db-num
      134           and buf_code-range.range-type = type-code
      135           and buf_code-range.stts       = "a"
      136         use-index stts
      137         no-error .
      138       if available buf_code-range
      139          and l-code <= buf_code-range.last-code
      140          and l-code >= buf_code-range.first-code then do:
      141         assign
      142           p-b-code = l-code
      143         .
      144       end.
      145       else do:
      146         if available buf_code-range
      147            and l-code < buf_code-range.last-code then do:
      148           message
      149             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      150             "Обратитесь к администратору системы."
      151             view-as alert-box error .
      152           undo, return error "sequence":U .
      153         end.
      154         do transaction
      155         on error undo, return error
      156         :
      157           find first buf_thbj-attr exclusive-lock
      158             where buf_thbj-attr.upper-prop-code = 'code-range':U
      159               and buf_thbj-attr.prop-code = cfg-param-code
      160               and buf_thbj-attr.obj-type   = 'БД':U
      161               and buf_thbj-attr.obj-code   = v-db-num
      162             no-error .
      163           if not available buf_thbj-attr then do:
      164             find first buf_thbj-attr exclusive-lock
      165               where buf_thbj-attr.upper-prop-code = 'code-range':U
      166                 and buf_thbj-attr.prop-code = cfg-param-code
      167                 and buf_thbj-attr.obj-type   = ''
      168                 and buf_thbj-attr.obj-code   = 0
      169               no-error .
      170             if not available buf_thbj-attr then do:
      171               if not locked buf_thbj-attr then do:
      172                 message
      173                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      174                   "Обратитесь к администратору системы."
      175                   view-as alert-box error .
      176               end.
      177               undo, return error "config":U .
      178             end.
      179           end.
      180           run get-next-seq( input type-code,
      181                             output l-code
      182                           ).
      183           find first buf_code-range
      184             where buf_code-range.db-num     = v-db-num
      185               and buf_code-range.range-type = type-code
      186               and buf_code-range.stts       = "a"
      187             use-index stts
      188             no-error .
      189           if available buf_code-range
      190           and l-code <= buf_code-range.last-code
      191           and l-code >= buf_code-range.first-code
      192           then do:
      193             assign
      194               p-b-code = l-code
      195             .
      196           end.
      197           else do:
      198             if available buf_code-range then do:
      199               assign
      200                 buf_code-range.stts = "u"
      201               .
      202             end.
      203             find first buf_code-range
      204               where buf_code-range.db-num     = v-db-num
      205                 and buf_code-range.range-type = type-code
      206                 and buf_code-range.stts       = "f"
      207               use-index stts
      208               no-error .
      209             if not available buf_code-range then do:
      210               message
      211                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      212                 "Обратитесь к администратору системы"
      213                 view-as alert-box error .
      214               undo, return error "code-range":U .
      215             end.
      216             assign
      217               buf_code-range.stts           = "a"
      218             .
      219             if buf_code-range.first-code = 1 then do:
      220               run set-seq-cr( input type-code,
      221                               input buf_code-range.first-code
      222                             ).
      223               assign
      224                 p-b-code = 1
      225               .
      226             end.
      227             else do:
      228               run set-seq-cr( input type-code,
      229                               input ( buf_code-range.first-code - 1 )
      230                             ).
      231               run get-next-seq( input type-code,
      232                                 output p-b-code
      233                               ).
      234             end.
      235           end.
      236         end.
      237       end.
      238     end.
      239   end procedure.
      240   procedure get-next-seq :
      241     define input  parameter type-code like ub.code-range.range-type no-undo .
      242     define output parameter next-seq  as   integer                  no-undo .
      243     do
      244     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      245     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      246     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      247     :
      248       case type-code:
      249         when 'bcgb':U then do:
      250           assign
      251             next-seq = next-value(s-bcgb-code, ub)
      252           .
      253         end.
      254         when 'scgb':U then do:
      255           assign
      256             next-seq = next-value(s-scgb-code, ub)
      257           .
      258         end.
      259         when 'sclc':U then do:
      260           assign
      261             next-seq = next-value(s-sclc-code, ub)
      262           .
      263         end.
      264         when 'pglc':U then do:
      265           assign
      266             next-seq = next-value(s-pglc-code, ub)
      267           .
      268         end.
      269         when 'dcgb':U then do:
      270           assign
      271             next-seq = next-value(s-dcgb-code, ub)
      272           .
      273         end.
      274         when 'ctgb':U then do:
      275           assign
      276             next-seq = next-value(s-ctgb-code, ub)
      277           .
      278         end.
      279         when 'drgb':U then do:
      280           assign
      281             next-seq = next-value(s-drgb-code, ub)
      282           .
      283         end.
      284         when 'fmgb':U then do:
      285           assign
      286             next-seq = next-value(s-fmgb-code, ub)
      287           .
      288         end.
      289         when 'pngb':U then do:
      290           assign
      291             next-seq = next-value(s-pngb-code, ub)
      292           .
      293         end.
      294         when 'cagb':U then do:
      295           assign
      296             next-seq = next-value(s-cagb-code, ub)
      297           .
      298         end.
      299         when 'fdgb':U then do:
      300           assign
      301             next-seq = next-value(s-fin-doc, ub)
      302           .
      303         end.
      304       end case.
      305     end.
      306   end procedure.
      307   procedure set-seq-cr :
      308     define input parameter type-code like ub.code-range.range-type no-undo .
      309     define input parameter set-val   like ub.code-range.first-code no-undo .
      310     do
      311     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      312     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      313     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      314     :
      315       case type-code:
      316         when 'bcgb':U then do:
      317           assign
      318             current-value(s-bcgb-code, ub) = set-val
      319           .
      320         end.
      321         when 'scgb':U then do:
      322           assign
      323             current-value(s-scgb-code, ub) = set-val
      324           .
      325         end.
      326         when 'sclc':U then do:
      327           assign
      328             current-value(s-sclc-code, ub) = set-val
      329           .
      330         end.
      331         when 'pglc':U then do:
      332           assign
      333             current-value(s-pglc-code, ub) = set-val
      334           .
      335         end.
      336         when 'dcgb':U then do:
      337           assign
      338             current-value(s-dcgb-code, ub) = set-val
      339           .
      340         end.
      341         when 'ctgb':U then do:
      342           assign
      343             current-value(s-ctgb-code, ub) = set-val
      344           .
      345         end.
      346         when 'drgb':U then do:
      347           assign
      348             current-value(s-drgb-code, ub) = set-val
      349           .
      350         end.
      351         when 'fmgb':U then do:
      352           assign
      353             current-value(s-fmgb-code, ub) = set-val
      354           .
      355         end.
      356         when 'pngb':U then do:
      357           assign
      358             current-value(s-pngb-code, ub) = set-val
      359           .
      360         end.
      361         when 'cagb':U then do:
      362           assign
      363             current-value(s-cagb-code, ub) = set-val
      364           .
      365         end.
      366         when 'fdgb':U then do:
      367           assign
      368             current-value(s-fin-doc, ub) = set-val
      369           .
      370         end.
      371       end case.
      372     end.
      373   end procedure.
      374   procedure new-bcod-gen-code-range :
      375     do
      376     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      377     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      378     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      379     :
      380       define input parameter p-db-num  like ub.db.db-num             no-undo .
      381       define input parameter type-code like ub.code-range.range-type no-undo .
      382       define buffer buf_code-range      for ub.code-range .
      383       define buffer last_code-range     for ub.code-range .
      384       define buffer last-1_code-range   for ub.code-range .
      385       define buffer last-2_code-range   for ub.code-range .
      386       define buffer last-3_code-range   for ub.code-range .
      387       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      388       define variable conf-par       as character no-undo .
      389       define variable par-type       as character no-undo .
      390       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      391       define variable v-cre-cdrg as logical   no-undo .
      392       define variable v-cre-str  as character no-undo .
      393       define variable v-cr1      as integer no-undo .
      394       define variable v-cr2      as integer no-undo .
      395       define variable v-cr3      as integer no-undo .
      396       define variable v-cmax     as integer no-undo .
      397       find first buf_sys-ctrl no-lock .
      398       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      399         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      400                                       ,vss-workfile
      401                                       ,vss-revision
      402                                       ,vss-description
      403                                       ,chr(10)
      404                                       , p-db-num
      405                                      ).
      406       end.
      407       run trg/getpcode.p ( input  type-code
      408                      ,output cfg-param-code
      409                     ).
      410       for each buf_code-range
      411         where buf_code-range.db-num     = -1
      412           and buf_code-range.range-type = type-code
      413           and buf_code-range.stts       = "f"
      414       by buf_code-range.first-code
      415       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      416       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      417       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      418       :
      419         assign
      420           buf_code-range.db-num = p-db-num
      421         .
      422         return .
      423       end.
      424       assign
      425         v-cre-cdrg = TRUE
      426       .
      427       case type-code:
      428         when 'sclc':U
      429         or when 'scgb':U
      430         or when 'pglc':U
      431         then do:
      432           find last last-1_code-range no-lock
      433             where last-1_code-range.range-type = 'sclc':U
      434             no-error .
      435           if available last-1_code-range then do:
      436             v-cr1 = last-1_code-range.last-code.
      437           end.
      438           find last last-2_code-range no-lock
      439             where last-2_code-range.range-type = 'scgb':U
      440             no-error .
      441           if available last-2_code-range then do:
      442             v-cr2 = last-2_code-range.last-code.
      443             end.
      444           find last last-3_code-range no-lock
      445             where last-3_code-range.range-type = 'pglc':U
      446             no-error .
      447           if available last-3_code-range then do:
      448             v-cr3 = last-3_code-range.last-code.
      449           end.
      450           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      451           .
      452           if v-cmax = v-cr1  then do:
      453               find last last_code-range no-lock
      454                 where recid( last_code-range ) = recid( last-1_code-range )
      455                 .
      456             end.
      457           if v-cmax = v-cr2  then do:
      458               find last last_code-range no-lock
      459                 where recid( last_code-range ) = recid( last-2_code-range )
      460                 .
      461             end.
      462           if v-cmax = v-cr3  then do:
      463             find last last_code-range no-lock
      464               where recid( last_code-range ) = recid( last-3_code-range )
      465               .
      466           end.
      467           if last_code-range.last-code + 1 > 99999 then do:
      468             assign
      469               v-cre-cdrg = FALSE
      470             .
      471           end.
      472         end.
      473         when 'bcgb':U
      474         or when 'sslc':U
      475         or when 'ssgb':U
      476         then do:
      477           find last last-1_code-range no-lock
      478             where last-1_code-range.range-type = 'sslc':U
      479             no-error .
      480           if available last-1_code-range then do:
      481             v-cr1 = last-1_code-range.last-code.
      482           end.
      483           find last last-2_code-range no-lock
      484             where last-2_code-range.range-type = 'bcgb':U
      485             no-error .
      486           if available last-2_code-range then do:
      487             v-cr2 = last-2_code-range.last-code.
      488             end.
      489           find last last-3_code-range no-lock
      490             where last-3_code-range.range-type = 'ssgb':U
      491             no-error .
      492           if available last-3_code-range then do:
      493             v-cr3 = last-3_code-range.last-code.
      494           end.
      495           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      496           .
      497           if v-cmax = v-cr1  then do:
      498               find last last_code-range no-lock
      499                 where recid( last_code-range ) = recid( last-1_code-range )
      500                 .
      501             end.
      502           if v-cmax = v-cr2  then do:
      503               find last last_code-range no-lock
      504                 where recid( last_code-range ) = recid( last-2_code-range )
      505                 .
      506             end.
      507           if v-cmax = v-cr3  then do:
      508             find last last_code-range no-lock
      509               where recid( last_code-range ) = recid( last-3_code-range )
      510               .
      511           end.
      512         end.
      513         otherwise do:
      514           find last last_code-range no-lock
      515             where last_code-range.range-type = type-code
      516             no-error .
      517         end.
      518       end case.
      519       if not available last_code-range then do:
      520         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      521                                       ,vss-workfile
      522                                       ,vss-revision
      523                                       ,vss-description
      524                                       , chr(10)
      525                                       , type-code
      526                                      ) .
      527       end.
      528       define variable v-mes0 as character no-undo .
      529       define variable v-param-type0 as character no-undo .
      530       define variable v-value-character0 as INTEGER no-undo .
      531       define variable v-value-date0 as date no-undo .
      532       define variable v-value-decimal0 as decimal no-undo .
      533       define variable v-value-integer0 AS integer no-undo .
      534       define variable v-value-logical0 AS LOGICAL no-undo .
      535       define variable v-tth0 as handle no-undo .
      536       run adm/shattri.p (
      537           input "get":U
      538           ,input  'БД':U
      539           ,input  p-db-num
      540           ,input  'code-range':U
      541           ,input  cfg-param-code
      542           ,output v-value-character0
      543           ,output v-value-date0
      544           ,output v-value-decimal0
      545           ,output v-value-integer0
      546           ,output v-value-logical0
      547           ,output v-param-type0
      548           ,INPUT-OUTPUT table-handle v-tth0
      549           ) no-error .
      550       if error-status :error then do:
      551         delete object v-tth0.
      552         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      553                            , error-status:get-message(1)
      554                            , chr(10)
      555                            , return-value ).
      556         undo, return error v-mes0.
      557       end.
      558       delete object v-tth0.
      559       if v-cre-cdrg = TRUE then do:
      560         create buf_code-range .
      561         assign
      562           buf_code-range.db-num     = p-db-num
      563           buf_code-range.range-type = type-code
      564           buf_code-range.stts       = "f"
      565           buf_code-range.first-code = last_code-range.last-code + 1
      566           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      567           v-cre-str = "Свободный диапазон успешно создан"
      568         .
      569       end.
      570       else do:
      571         assign
      572           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      573                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      574         .
      575       end.
      576     end.
      577     return v-cre-str .
      578   end procedure.
      579   procedure gen-new-code-range-if-neces :
      580     define input parameter v-db-num           like ub.db.db-num             no-undo .
      581     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      582     define input parameter v-cur-code         as   integer                  no-undo .
      583     define input parameter v-g#news           as   logical                  no-undo .
      584     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      585     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      586     do
      587     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      588     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      589     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      590     :
      591       define variable l-code-range-exist as logical   no-undo init false .
      592       define variable v-db-for-send      as character no-undo .
      593       define buffer buf_code-range  for ub.code-range .
      594       define buffer buf1_code-range for ub.code-range .
      595       define buffer buf_db          for ub.db .
      596       find first buf_code-range
      597         where buf_code-range.range-type = v-range-type
      598           and buf_code-range.last-code >= v-cur-code
      599         use-index last-codei
      600         no-error .
      601       if
      602       (
      603          available buf_code-range
      604          and
      605         (buf_code-range.db-num = v-db-num
      606           and
      607         buf_code-range.first-code <= v-cur-code
      608         )
      609       or
      610         (
      611           v-range-type = 'drgb':U
      612           AND
      613           v-cur-code = 0
      614         )
      615      )
      616      then do:
      617         assign
      618           l-code-range-exist = true
      619         .
      620         if v-g#news
      621         and buf_code-range.stts = "f" then do:
      622           assign
      623             buf_code-range.stts = "u"
      624           .
      625         end.
      626       end.
      627       if not l-code-range-exist
      628          and v-g#news-source-db <> 0
      629       then do:
      630         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      631                                       ,vss-workfile
      632                                       ,vss-revision
      633                                       ,vss-description
      634                                       ,chr(10)
      635                                       ,v-db-num
      636                                       ,v-range-type
      637                                       ,v-cur-code
      638                                      ).
      639       end.
      640       if (not l-code-range-exist
      641           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      642          )
      643       and ( not can-find (first buf1_code-range no-lock
      644                           where buf1_code-range.db-num = v-db-num
      645                             and buf1_code-range.range-type = v-range-type
      646                             and buf1_code-range.stts = "f"
      647                          )
      648           )
      649       then do:
      650         if v-g#db-num = 0 then do:
      651           run new-bcod-gen-code-range in this-procedure
      652             (input v-db-num,
      653              input v-range-type
      654             ) no-error .
      655           if error-status :error then do:
      656             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      657                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      658                                           ,v-db-num
      659                                           ,v-range-type
      660                                           ,v-cur-code
      661                                           ,chr(10)
      662                                           ,error-status:get-message(1)
      663                                           ,return-value
      664                                          ).
      665           end.
      666         end.
      667         else do:
      668           if v-range-type = 'sclc':U
      669           or v-range-type = 'pglc':U
      670           then do:
      671             assign
      672               v-db-for-send = "":U
      673             .
      674             if v-g#db-num = 0 then do:
      675               for each buf_db no-lock
      676                 where buf_db.db-num > 0
      677                   and buf_db.db-num <> v-g#news-source-db
      678               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      679               :
      680                 assign
      681                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      682                 .
      683               end.
      684               assign
      685                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      686               .
      687             end.
      688             else do:
      689               if not v-g#news then do:
      690                 assign
      691                   v-db-for-send = "0":U
      692                 .
      693               end.
      694             end.
      695             run nws/cr-route.p ( input 'send-cmd':U
      696                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      697                                  "code-range":U + chr(1) +
      698                                  (if v-range-type = 'sclc':U
      699                                   then string( current-value(s-sclc-code, ub))
      700                                   else string( current-value(s-pglc-code, ub))
      701                                   ) + chr(1) +
      702                                   v-range-type)
      703                           ,input ?
      704                           ,input v-db-for-send
      705                           ) no-error .
      706             if error-status :error then do:
      707               undo, return error return-value.
      708             end.
      709           end.
      710         end.
      711       end.
      712     end.
      713   end procedure.
      714   procedure cre-loc-sc-code-range :
      715     define input parameter v-cur-code as integer no-undo .
      716   define input parameter p-cdrg-type as character no-undo .
      717     do
      718     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      719     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      720     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      721     :
      722       define buffer buf_code-range for ub.code-range .
      723       find first buf_code-range
      724            where buf_code-range.range-type = p-cdrg-type
      725              and buf_code-range.first-code >= v-cur-code
      726            no-error .
      727       if not available buf_code-range then do:
      728         run new-bcod-gen-code-range in this-procedure
      729           ( input 0,
      730             input p-cdrg-type
      731           ) no-error .
      732         if error-status :error then do:
      733           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      734                                          + "Код &2&1&3 &4"
      735                                         , chr(10)
      736                                         , v-cur-code
      737                                         , error-status:get-message(1)
      738                                         , return-value
      739                                        ) .
      740         end.
      741       end.
      742     end.
      743   end procedure.
      744   procedure mark-used-if-need :
      745   define input parameter p-cur-code as integer no-undo .
      746   define input parameter p-range-type like ub.code-range.range-type no-undo .
      747   define input parameter p-db-num like ub.code-range.db-num no-undo .
      748     do
      749     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      750     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      751     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      752     :
      753       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      754       define buffer buf_code-range for ub.code-range .
      755       assign
      756       v-db-num = if p-range-type = 'sclc':U
      757                  then 0
      758                  else p-db-num
      759       .
      760   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      761   define buffer locK-batchprocess1 for ub.batchprocess.
      762   run gbl/lock-prc.p
      763       (input 'lscc':U
      764       ,input 0
      765       ,input 0
      766       ,input 0
      767       ,input ""
      768       ,input ""
      769       ,input ""
      770       ,input (
      771               ",,,Вкл/выкл лок. вес. кодов"
      772              )
      773       ,input true
      774       ,buffer lock-batchprocess1
      775       ) no-error .
      776     if error-status :error then do:
      777       message
      778         vss-workfile vss-revision vss-description skip
      779         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      780         view-as alert-box error .
      781       undo, return error .
      782     end.
      783       find first buf_code-range
      784            where buf_code-range.range-type = p-range-type
      785              and buf_code-range.first-code >= p-cur-code
      786              and buf_code-range.last-code <= p-cur-code
      787              and buf_code-range.db-num = v-db-num
      788            no-error .
      789       if not available buf_code-range then do:
      790         message
      791           vss-workfile vss-revision vss-description skip
      792           "Ошибка при создании поиске диапазона" skip
      793           "База данных" p-db-num skip
      794           "Код" p-cur-code skip
      795           "Тип" p-range-type
      796           error-status :get-message(1) skip
      797           return-value skip
      798           view-as alert-box error .
      799         undo, return error .
      800       end.
      801       if buf_code-range.stts = "f":U then do:
      802         assign
      803         buf_code-range.stts = "u":U
      804         .
      805       end.
      806     end.
      807   end procedure.
      808   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   function is-numeral return logical
      810     (input p-string   as character ,
      811      input char-avail as character) :
      812     define variable p-replace-string as character no-undo .
      813     define variable log-result       as logical  no-undo .
      814     if p-string = ? then
      815       return false .
      816     p-replace-string = p-string.
      817     if lookup ("*", char-avail) > 0 then
      818         p-replace-string = replace (p-replace-string, '*', '9').
      819     if lookup ("digit", char-avail) > 0 then
      820       assign
      821         p-replace-string = replace (p-replace-string, '0', '9')
      822         p-replace-string = replace (p-replace-string, '1', '9')
      823         p-replace-string = replace (p-replace-string, '2', '9')
      824         p-replace-string = replace (p-replace-string, '3', '9')
      825         p-replace-string = replace (p-replace-string, '4', '9')
      826         p-replace-string = replace (p-replace-string, '5', '9')
      827         p-replace-string = replace (p-replace-string, '6', '9')
      828         p-replace-string = replace (p-replace-string, '7', '9')
      829         p-replace-string = replace (p-replace-string, '8', '9')
      830         .
      831     else
      832        p-replace-string = replace (p-replace-string, '9', chr(15))
      833         .
      834     if lookup ("letter", char-avail) > 0 then
      835       assign
      836         p-replace-string = replace (p-replace-string, 'A', '9')
      837         p-replace-string = replace (p-replace-string, 'B', '9')
      838         p-replace-string = replace (p-replace-string, 'C', '9')
      839         p-replace-string = replace (p-replace-string, 'D', '9')
      840         p-replace-string = replace (p-replace-string, 'E', '9')
      841         p-replace-string = replace (p-replace-string, 'F', '9')
      842         p-replace-string = replace (p-replace-string, 'G', '9')
      843         p-replace-string = replace (p-replace-string, 'H', '9')
      844         p-replace-string = replace (p-replace-string, 'I', '9')
      845         p-replace-string = replace (p-replace-string, 'J', '9')
      846         p-replace-string = replace (p-replace-string, 'K', '9')
      847         p-replace-string = replace (p-replace-string, 'L', '9')
      848         p-replace-string = replace (p-replace-string, 'M', '9')
      849         p-replace-string = replace (p-replace-string, 'N', '9')
      850         p-replace-string = replace (p-replace-string, 'O', '9')
      851         p-replace-string = replace (p-replace-string, 'P', '9')
      852         p-replace-string = replace (p-replace-string, 'Q', '9')
      853         p-replace-string = replace (p-replace-string, 'R', '9')
      854         p-replace-string = replace (p-replace-string, 'S', '9')
      855         p-replace-string = replace (p-replace-string, 'T', '9')
      856         p-replace-string = replace (p-replace-string, 'U', '9')
      857         p-replace-string = replace (p-replace-string, 'V', '9')
      858         p-replace-string = replace (p-replace-string, 'W', '9')
      859         p-replace-string = replace (p-replace-string, 'X', '9')
      860         p-replace-string = replace (p-replace-string, 'Y', '9')
      861         p-replace-string = replace (p-replace-string, 'Z', '9')
      862         p-replace-string = replace (p-replace-string, '_', '9')
      863         .
      864     return p-replace-string = fill ('9', length (p-string)).
      865   end.
      866   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      867   define new global shared variable g#attr-lib  as handle no-undo .
      868   define variable v-attr-lib-variable as handle no-undo .
      869   procedure gds-attr-name :
      870     define input  parameter p-code           as character no-undo .
      871     define output parameter p-type           as character no-undo .
      872     define output parameter p-format         as character no-undo .
      873     define output parameter p-label          as character no-undo .
      874     define output parameter p-user-can-edit  as logical   no-undo .
      875     define output parameter p-output-display as logical   no-undo .
      876     define output parameter p-other          as character no-undo .
      877     do
      878     on error undo, return error
      879     :
      880           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
      881         (input  p-code
      882         ,output p-type
      883         ,output p-format
      884         ,output p-label
      885         ,output p-user-can-edit
      886         ,output p-output-display
      887         ,output p-other
      888         ) no-error .
      889       if error-status :error
      890       then do:
      891         undo, return error return-value .
      892       end.
      893     end.
      894   end procedure.
