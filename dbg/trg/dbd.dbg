        1   block-level on error undo, throw.
        2   trigger procedure for delete of ub.db .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление записи базы данных".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   procedure cur-time :
       69      define output parameter p-today as date      no-undo .
       70      define output parameter p-time  as integer   no-undo .
       71     do
       72     on error undo, return error
       73     :
       74       define variable v-date1 as date      no-undo .
       75       define variable v-date2 as date      no-undo .
       76       define variable v-time  as integer   no-undo .
       77       assign
       78         v-date1 = today
       79         v-time  = time
       80         v-date2 = today
       81       .
       82       if v-date1 <> v-date2
       83       then do:
       84         assign
       85           v-date1 = today
       86           v-time  = v-time
       87         .
       88       end.
       89       assign
       90         p-today = v-date1
       91         p-time  = v-time
       92       .
       93     end.
       94   end.
       95   function cur-time-date returns character
       96   :
       97     return string(today, '99/99/9999':U) .
       98   end.
       99   function cur-time-mjd returns decimal
      100   :
      101     define variable v-date as date      no-undo .
      102     define variable v-time as integer   no-undo .
      103     run cur-time in this-procedure
      104       (output v-date
      105       ,output v-time
      106       ) .
      107     return integer(v-date) - 2400002 + (v-time / 86400) .
      108   end.
      109   function cur-time-get-ending-index returns integer
      110   (input p-number as integer
      111   )
      112   :
      113     if p-number < 0
      114     or p-number = ?
      115     then do:
      116       return 1 .
      117     end.
      118     define variable v-rest as integer   no-undo .
      119     assign
      120       p-number = p-number modulo 100
      121     .
      122     if p-number < 20
      123     then do:
      124       assign
      125         v-rest = p-number
      126       .
      127     end.
      128     else do:
      129       assign
      130         v-rest = p-number modulo 10
      131       .
      132     end.
      133     case v-rest :
      134       when 1
      135       then do:
      136         return 2 .
      137       end.
      138       when 2 or
      139       when 3 or
      140       when 4
      141       then do:
      142         return 3 .
      143       end.
      144       otherwise do:
      145         return 1 .
      146       end.
      147     end case .
      148   end.
      149   procedure cur-time-mjd-to-date :
      150      define input  parameter i-mjd-diff as decimal no-undo.
      151      define output parameter o-Date     as date    no-undo.
      152      define output parameter o-Time     as integer no-undo.
      153      define variable v-day-number as integer   no-undo .
      154      if    i-mjd-diff < 0
      155         or i-mjd-diff = ?
      156      then do:
      157         return "?" .
      158      end.
      159      assign
      160         v-day-number = truncate(i-mjd-diff,0).
      161         o-Date = date(v-day-number + 2400002).
      162         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      163     .
      164   end.
      165   function cur-time-mjd-to-string returns character
      166   (input p-mjd-diff as decimal
      167   )
      168   :
      169     define variable v-day-number as integer   no-undo .
      170     define variable v-seconds    as integer   no-undo .
      171     define variable v-hour       as integer   no-undo .
      172     define variable v-min        as integer   no-undo .
      173     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      174     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      175     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      176     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      177     if p-mjd-diff < 0
      178     or p-mjd-diff = ?
      179     then do:
      180       return "?" .
      181     end.
      182     assign
      183       v-day-number = integer(truncate(p-mjd-diff,0))
      184       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186     if v-seconds > 86400
      187     then do:
      188       assign
      189         v-seconds = 86400 - 1
      190       .
      191     end.
      192     if v-seconds < 0
      193     then do:
      194       assign
      195         v-seconds = 0
      196       .
      197     end.
      198     assign
      199       v-hour = truncate(v-seconds / 3600, 0)
      200     .
      201     assign
      202       v-seconds = v-seconds modulo 3600
      203     .
      204     assign
      205       v-min = truncate(v-seconds / 60, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 60
      209     .
      210     return
      211         (if v-day-number <> 0
      212           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      213           else ""
      214         )
      215       + (if v-day-number <> 0 or v-hour <> 0
      216           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      220           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      221           else ""
      222         )
      223       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      224       .
      225   end.
      226   function cur-time-string returns character
      227   :
      228     define variable v-date as date      no-undo .
      229     define variable v-time as integer   no-undo .
      230     run cur-time in this-procedure
      231       (output v-date
      232       ,output v-time
      233       ) .
      234     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      235   end.
      236   function cur-time-string-sec returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      245   end.
      246   function cur-time-custom  returns character
      247   (input p-prefix as character
      248   ,input p-date-format as character
      249   ,input p-delimiter as character
      250   ,input p-time-format as character
      251   ,input p-suffix as character
      252   )
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return
      261       p-prefix
      262       + string(v-date, p-date-format)
      263       + p-delimiter
      264       + string(v-time, p-time-format)
      265       + p-suffix
      266       .
      267   end.
      268   function cur-time-print  returns character
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      277   end.
      278   function cur-time-datetime returns datetime
      279   :
      280     define variable v-char as character no-undo .
      281     define variable v-datetime as datetime no-undo .
      282     v-char = cur-time-string().
      283     v-datetime = datetime(v-char).
      284     return  v-datetime.
      285   end.
      286   function cur-time-string-msec returns character
      287   :
      288     define variable v-date as datetime  no-undo .
      289     v-date = now.
      290     return string(v-date) .
      291   end.
      292   define new global shared variable g#library  as handle no-undo .
      293   define new global shared variable g#library2 as handle no-undo .
      294   define   shared variable g#auto as logical no-undo.
      295   define   shared variable g#news as logical no-undo.
      296   define   shared variable g#oxml as logical no-undo.
      297   define   shared variable g#esys as logical no-undo.
      298   define   shared variable g#news-source-db as integer no-undo.
      299   define   shared variable g#esys-source-esys as integer no-undo.
      300   define   shared variable g#db-num as integer   no-undo .
      301   define   shared variable g#userid as character no-undo .
      302   define   shared variable g#passwd as character no-undo .
      303   do
      304   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      305   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      306   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      307   :
      308     define buffer buf_db                for ub.db .
      309     define buffer buf_c-db              for ub.c-db .
      310     define buffer buf_sys-ctrl          for ub.sys-ctrl .
      311     define buffer buf-shop_clients      for ub.clients .
      312     define buffer buf-store_clients     for ub.clients .
      313     define buffer buf_cash-desk         for ub.cash-desk .
      314     define buffer buf_code-range        for ub.code-range .
      315     define buffer buf_schedule          for ub.schedule .
      316     define buffer buf_schedule-attr     for ub.schedule-attr .
      317     define buffer buf_prod-bc-db        for ub.prod-bc-db .
      318     define buffer buf_ext-file          for ub.ext-file .
      319     define buffer buf_ext-file-line     for ub.ext-file-line .
      320     define buffer buf_ext-file-par      for ub.ext-file-par .
      321     define buffer buf_db-rec-attr       for ub.db-rec-attr .
      322     define buffer buf_nws-doc-hist      for ub.nws-doc-hist .
      323     define buffer buf_pck-sent          for ub.pck-sent .
      324     define buffer buf_pck-rcvd          for ub.pck-rcvd .
      325     define buffer buf_route             for ub.route .
      326     define buffer buf_db-status         for ub.db-status .
      327     define buffer buf_upgrade           for ub.upgrade .
      328     define buffer buf_db-attr           for ub.db-attr .
      329     define buffer buf_hist-nws-option   for ub.hist-nws-option.
      330     define buffer buf_c-hist-nws-option for ub.c-hist-nws-option.
      331     define variable v-date    as date      no-undo .
      332     define variable v-time    as integer   no-undo .
      333     define variable v-db-num  as integer   no-undo .
      334     define variable v-msg     as logical   no-undo .
      335     define variable v-message as character no-undo .
      336     define variable v-db-list as character no-undo .
      337     define temp-table tt_range-stts no-undo
      338       field range-type like ub.code-range.range-type
      339       field first-code like ub.code-range.first-code
      340       field stts       like ub.code-range.stts
      341     .
      342     define variable v-action  as character no-undo .
      343     define variable v-counter as integer   no-undo .
      344     define variable v-mod     as integer   no-undo .
      345     define frame inf
      346       v-action  label "Таблица" format "X(50)" skip
      347       v-counter label "Записей" format ">>>>>>>>>9"
      348       with view-as dialog-box side-labels 1 columns three-d title "Удаление БД".
      349     find first buf_sys-ctrl no-lock .
      350     assign
      351       v-db-num = ub.db.db-num
      352     .
      353     if g#news = false then do:
      354       assign
      355         v-msg = true
      356       .
      357       if buf_sys-ctrl.db-num <> 0 then do:
      358         assign
      359           v-message = "Удаление БД может проводиться только в ГБД!!!"
      360         .
      361         if v-msg = true then do:
      362           message
      363             v-message
      364             view-as alert-box error.
      365         end.
      366         return error v-message .
      367       end.
      368     end.
      369     if v-db-num = 0 then do:
      370       assign
      371         v-message = "Нельзя удалить ГБД !!!"
      372       .
      373       if v-msg = true then do:
      374         message
      375           v-message
      376           view-as alert-box error.
      377       end.
      378       return error v-message .
      379     end.
      380     find first buf-shop_clients no-lock
      381       where buf-shop_clients.db-num   = v-db-num
      382         and buf-shop_clients.obj-type = 'маг':U
      383       no-error
      384     .
      385     find first buf-store_clients no-lock
      386       where buf-store_clients.db-num   = v-db-num
      387         and buf-store_clients.obj-type = 'скл':U
      388       no-error
      389     .
      390     if available buf-shop_clients
      391       or available buf-store_clients
      392     then do:
      393       assign
      394         v-message = substitute( "Есть объекты привязаные к БД &1. &2Нельзя удалить БД.", v-db-num, chr(10) )
      395       .
      396       if v-msg = true then do:
      397         message
      398           v-message
      399           view-as alert-box error .
      400       end.
      401       return error v-message .
      402     end.
      403     find first buf_cash-desk no-lock
      404       where buf_cash-desk.db-num = v-db-num
      405       no-error .
      406     if available buf_cash-desk then do:
      407       assign
      408         v-message = substitute( "Есть кассы привязаные к БД &1. &2Нельзя удалить БД.", v-db-num, chr(10) )
      409       .
      410       if v-msg = true then do:
      411         message
      412           v-message
      413           view-as alert-box error .
      414       end.
      415       return error v-message .
      416     end.
      417     view frame inf .
      418     assign
      419       v-counter = 0
      420       v-action  = "Создание записи истории"
      421       v-mod     = 5
      422     .
      423     run cur-time in this-procedure
      424       ( output v-date
      425       , output v-time
      426       ).
      427     create buf_c-db.
      428     buffer-copy ub.db to buf_c-db .
      429     assign
      430       buf_c-db.action           = integer('99':U)
      431       buf_c-db.chip-num         = dynamic-next-value ( "s-db-chip", "ub")
      432       buf_c-db.corr-time        = v-time
      433       buf_c-db.corr-date        = v-date
      434       buf_c-db.corr-user-db-num = buf_sys-ctrl.db-num
      435       buf_c-db.corr-user-name   = (if g#news = true then "СПН" else g#userid )
      436     .
      437     if trim( buf_c-db.corr-user-name ) = "":U then do:
      438       assign
      439         buf_c-db.corr-user-name = userid( "ub":U )
      440       .
      441     end.
      442     assign
      443       v-counter = 0
      444       v-action  = "Перепривязка диапазонов кодов"
      445       v-mod     = 5
      446     .
      447     for each tt_range-stts
      448     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      449     :
      450       delete tt_range-stts .
      451     end.
      452     for each buf_code-range exclusive-lock
      453       where buf_code-range.db-num = v-db-num
      454     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      455     :
      456       assign v-counter = v-counter + 1 .    if ( v-counter MODULO v-mod ) = 0 then do:       do with frame inf       :         assign           v-action :screen-value  = string( v-action, v-action :format)           v-counter :screen-value = string( v-counter, v-counter :format)         .       end.     end.
      457       create tt_range-stts.
      458       assign
      459         tt_range-stts.range-type = buf_code-range.range-type
      460         tt_range-stts.first-code = buf_code-range.first-code
      461         tt_range-stts.stts       = buf_code-range.stts
      462         buf_code-range.stts      = "X->0":U
      463         buf_code-range.db-num    = 0
      464       .
      465     end.
      466     for each tt_range-stts
      467     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      468     :
      469       find first buf_code-range exclusive-lock
      470         where buf_code-range.range-type = tt_range-stts.range-type
      471           and buf_code-range.first-code = tt_range-stts.first-code
      472       .
      473       if tt_range-stts.stts = "a":U then do:
      474         assign
      475           tt_range-stts.stts = "u":U
      476         .
      477       end.
      478       assign
      479         buf_code-range.stts = tt_range-stts.stts
      480       .
      481     end.
      482     for each tt_range-stts
      483     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      484     :
      485       delete tt_range-stts .
      486     end.
      487     assign
      488       v-counter = 0
      489       v-action  = "Удаление строк расписания"
      490       v-mod     = 1
      491     .
      492     for each buf_schedule exclusive-lock
      493       where buf_schedule.cre-db-num = v-db-num
      494     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      495     :
      496       assign v-counter = v-counter + 1 .    if ( v-counter MODULO v-mod ) = 0 then do:       do with frame inf       :         assign           v-action :screen-value  = string( v-action, v-action :format)           v-counter :screen-value = string( v-counter, v-counter :format)         .       end.     end.
      497       delete buf_schedule .
      498     end.
      499     assign
      500       v-counter = 0
      501       v-action  = "Удаление строк атрибутов расписания"
      502       v-mod     = 1
      503     .
      504     for each buf_schedule-attr exclusive-lock
      505       where buf_schedule-attr.cre-db-num = v-db-num
      506     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      507     :
      508       assign v-counter = v-counter + 1 .    if ( v-counter MODULO v-mod ) = 0 then do:       do with frame inf       :         assign           v-action :screen-value  = string( v-action, v-action :format)           v-counter :screen-value = string( v-counter, v-counter :format)         .       end.     end.
      509       delete buf_schedule-attr .
      510     end.
      511     assign
      512       v-counter = 0
      513       v-action  = "Удаление бар-кодов по базе данных"
      514       v-mod     = 5
      515     .
      516     for each buf_prod-bc-db exclusive-lock
      517       where buf_prod-bc-db.db-num = v-db-num
      518     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      519     :
      520       assign v-counter = v-counter + 1 .    if ( v-counter MODULO v-mod ) = 0 then do:       do with frame inf       :         assign           v-action :screen-value  = string( v-action, v-action :format)           v-counter :screen-value = string( v-counter, v-counter :format)         .       end.     end.
      521       delete buf_prod-bc-db .
      522     end.
      523     assign
      524       v-counter = 0
      525       v-action  = "Удаление информации из внешних файлов"
      526       v-mod     = 5
      527     .
      528     for each buf_ext-file exclusive-lock
      529       where buf_ext-file.db-num = v-db-num
      530     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      531     :
      532       assign v-counter = v-counter + 1 .    if ( v-counter MODULO v-mod ) = 0 then do:       do with frame inf       :         assign           v-action :screen-value  = string( v-action, v-action :format)           v-counter :screen-value = string( v-counter, v-counter :format)         .       end.     end.
      533       for each buf_ext-file-line exclusive-lock
