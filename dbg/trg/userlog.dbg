      459       run userlog-hist-table-add in this-procedure ( input 1, input "rvs-doc                ":U, input "rvs-line                    ":U, input "документа сверки                                ", input " строки                                                               ":U, input v-err-msg, output v-err-msg ).
      460       run userlog-hist-table-add in this-procedure ( input 1, input "thbj-attr              ":U, input "thbj-attr                   ":U, input "параметра объекта TH                            ", input "                                                                ":U, input v-err-msg, output v-err-msg ).
      461       run userlog-hist-table-add in this-procedure ( input 1, input "staff                  ":U, input "staff                       ":U, input "данные персонала                                ", input "данные персонала                                                  ":U, input v-err-msg, output v-err-msg ).
      462       if v-err-msg <> "":U
      463         then
      464       do:
      465         message
      466           vss-workfile vss-revision vss-description
      467           skip(1)
      468           skip
      469           "Ошибка вычисления дерева таблиц истории пользователя."
      470           skip(1)
      471           skip v-err-msg
      472           view-as alert-box error.
      473         undo, return error.
      474       end.
      475     end.
      476   end procedure.
      477   procedure userlog-get-table-name :
      478     define input parameter p-ulb-key        as integer          no-undo.
      479     define output parameter p-table-name    as character        no-undo.
      480     define buffer buf_temp_userlog-bush for temp_userlog-bush.
      481     do
      482       for buf_temp_userlog-bush
      483       on error undo, return error
      484       :
      485       find first buf_temp_userlog-bush
      486         where buf_temp_userlog-bush.ulb-key = p-ulb-key
      487         no-error.
      488       if available buf_temp_userlog-bush
      489         then
      490       do:
      491         assign
      492           p-table-name = buf_temp_userlog-bush.ulbTableName
      493           .
      494       end.
      495       else
      496       do:
      497         assign
      498           p-table-name = "":U
      499           .
      500       end.
      501     end.
      502   end procedure.
      503   procedure userlog-hist-table-add :
      504     define input  parameter i-ulbType            as integer          no-undo.
      505     define input  parameter i-ParentTableName    as character        no-undo.
      506     define input  parameter i-TableName          as character        no-undo.
      507     define input  parameter i-ParentDesc         as character        no-undo.
      508     define input  parameter i-Desc               as character        no-undo.
      509     define input  parameter i-in-err-msg         as character        no-undo.
      510     define output parameter o-out-err-msg       as character        no-undo.
      511      run userlog-hist-table-twokey-add(input  i-ulbType,
      512                                        input  i-ParentTableName,
      513                                        input  i-TableName,
      514                                        input  "",
      515                                        input  i-ParentDesc,
      516                                        input  i-Desc,
      517                                        input  i-in-err-msg,
      518                                        output o-out-err-msg).
      519   end.
      520   procedure userlog-hist-table-twokey-add :
      521     define input parameter p-ulbType            as integer          no-undo.
      522     define input parameter p-ParentTableName    as character        no-undo.
      523     define input parameter p-TableName          as character        no-undo.
      524     define input parameter i-Twokey             as character        no-undo.
      525     define input parameter p-ParentDesc         as character        no-undo.
      526     define input parameter p-Desc               as character        no-undo.
      527     define input parameter p-in-err-msg         as character        no-undo.
      528     define output parameter p-out-err-msg       as character        no-undo.
      529     define variable v-err-msg    as character no-undo.
      530     define variable v-success    as logical   no-undo.
      531     define variable v-found      as logical   no-undo.
      532     define variable v-parent-key as integer   no-undo.
      533     define buffer buf_temp_userlog-bush        for temp_userlog-bush.
      534     define buffer buf_parent-temp_userlog-bush for temp_userlog-bush.
      535     do
      536       for buf_temp_userlog-bush
      537       , buf_parent-temp_userlog-bush
      538       on error undo, return error
      539       :
      540       assign
      541         v-success         = no
      542         p-out-err-msg     = p-in-err-msg
      543         p-ParentTableName = trim( p-ParentTableName   )
      544         p-TableName       = trim( p-TableName         )
      545         i-Twokey          = trim( i-Twokey            )
      546         p-Desc            = trim( p-Desc              )
      547         p-ParentDesc      = trim( p-ParentDesc        )
      548         .
      549       if p-ulbType <> 1
      550         and p-ulbType <> 0
      551         then
      552       do:
      553         assign
      554           v-success = no
      555           v-err-msg = "Неизвестный тип истории пользователя."
      556           .
      557       end.
      558       else
      559       do:
      560         if p-ParentTableName = "":U
      561           or p-ParentTableName = p-TableName
      562           then
      563         do:
      564           assign
      565             v-success    = yes
      566             v-err-msg    = "":U
      567             v-parent-key = 0
      568             .
      569           if p-ulbType = 0
      570             then
      571           do:
      572             run userlog-create-userlog-bush in this-procedure (
      573               input p-ulbType
      574               , input 0
      575               , input p-ParentTableName
      576               , input i-Twokey
      577               , input p-ParentTableName
      578               , input "":U
      579               ) no-error.
      580             if error-status :error
      581               then
      582             do:
      583               assign
      584                 v-success = no
      585                 v-err-msg = substitute( "Ошибка создания корневой записи. &1 &2", return-value, trim( error-status :get-message( 1 ) ) )
      586                 .
      587             end.
      588             else
      589             do:
      590               find first buf_parent-temp_userlog-bush
      591                 where buf_parent-temp_userlog-bush.ulbParentKey = 0
      592                 and buf_parent-temp_userlog-bush.ulbTableName = p-ParentTableName
      593                 no-error.
      594               if not available buf_parent-temp_userlog-bush
      595                 then
      596               do:
      597                 assign
      598                   v-success = no
      599                   v-err-msg = "Не удалось создать корневую запись."
      600                   .
      601               end.
      602               else
      603               do:
      604                 assign
      605                   v-success    = yes
      606                   v-err-msg    = "":U
      607                   v-parent-key = buf_parent-temp_userlog-bush.ulb-key
      608                   .
      609               end.
      610             end.
      611           end.
      612         end.
      613         else
      614         do:
      615           find first buf_parent-temp_userlog-bush
      616             where buf_parent-temp_userlog-bush.ulbParentKey = 0
      617             and buf_parent-temp_userlog-bush.ulbTableName = p-ParentTableName
      618             no-error.
      619           if not available buf_parent-temp_userlog-bush
      620             then
      621           do:
      622             if p-ulbType = 0
      623               then
      624             do:
      625               run userlog-create-userlog-bush in this-procedure (
      626                 input p-ulbType
      627                 , input 0
      628                 , input p-ParentTableName
      629                 , input i-Twokey
      630                 , input p-ParentTableName
      631                 , input "":U
      632                 ) no-error.
      633               if error-status :error
      634                 then
      635               do:
      636                 assign
      637                   v-success = no
      638                   v-err-msg = substitute( "Ошибка создания записи. &1 &2", return-value, trim( error-status :get-message( 1 ) ) )
      639                   .
      640               end.
      641               else
      642               do:
      643                 find first buf_parent-temp_userlog-bush
      644                   where buf_parent-temp_userlog-bush.ulbParentKey = 0
      645                   and buf_parent-temp_userlog-bush.ulbTableName = p-ParentTableName
      646                   no-error.
      647                 if not available buf_parent-temp_userlog-bush
      648                   then
      649                 do:
      650                   assign
      651                     v-success = no
      652                     v-err-msg = "Не удалось создать корневую запись."
      653                     .
      654                 end.
      655                 else
      656                 do:
      657                   assign
      658                     v-success    = yes
      659                     v-err-msg    = "":U
      660                     v-parent-key = buf_parent-temp_userlog-bush.ulb-key
      661                     .
      662                 end.
      663               end.
      664             end.
      665             else
      666             do:
      667               assign
      668                 v-success = no
      669                 v-err-msg = "Неверно указан корневой узел."
      670                 .
      671             end.
      672           end.
      673           else
      674           do:
      675             assign
      676               v-success    = yes
      677               v-err-msg    = "":U
      678               v-parent-key = buf_parent-temp_userlog-bush.ulb-key
      679               .
      680           end.
      681         end.
      682         if v-success       = yes
      683           then
      684         do:
      685           run userlog-create-userlog-bush in this-procedure (
      686             input p-ulbType
      687             , input v-parent-key
      688             , input p-TableName
      689             , input i-Twokey
      690             , input p-ParentDesc
      691             , input p-Desc
      692             ) no-error.
      693           if error-status :error
      694             then
      695           do:
      696             assign
      697               v-success = no
      698               v-err-msg = substitute( "Ошибка создания записи. &1 &2", return-value, trim( error-status :get-message( 1 ) ) )
      699               .
      700           end.
      701           else
      702           do:
      703             assign
      704               v-success = yes
      705               v-err-msg = "":U
      706               .
      707           end.
      708         end.
      709       end.
      710       if v-success = no
      711         then
      712       do:
      713         assign
      714           p-out-err-msg = substitute( "&1&2 &3. Тип: '&4'. Таблица: '&5'. Родитель: '&6'.":U
      715                                           , p-out-err-msg
      716                                           , ( if p-out-err-msg = "":U then "":U else chr(10) )
      717                                           , v-err-msg
      718                                           , p-ulbType
      719                                           , p-ParentTableName
      720                                           , p-TableName
      721                                           )
      722           .
      723       end.
      724     end.
      725   end procedure.
      726   procedure userlog-create-userlog-bush :
      727     define input parameter p-ulbType            as integer          no-undo.
      728     define input parameter p-parent-key         as integer          no-undo.
      729     define input parameter p-TableName          as character        no-undo.
      730     define input parameter i-TwoKey          as character        no-undo.
      731     define input parameter p-ParentDesc         as character        no-undo.
      732     define input parameter p-Desc               as character        no-undo.
      733     define buffer buf_temp_userlog-bush for temp_userlog-bush.
      734     do
      735       for buf_temp_userlog-bush
      736       on error undo, return error
      737       :
      738       assign
      739         v-userlog-0-ulb-key = v-userlog-0-ulb-key + 1
      740         .
      741       create buf_temp_userlog-bush.
      742       assign
      743         buf_temp_userlog-bush.ulb-key       = v-userlog-0-ulb-key
      744         buf_temp_userlog-bush.ulbType       = p-ulbType
      745         buf_temp_userlog-bush.ulbParentKey  = p-parent-key
      746         buf_temp_userlog-bush.ulbTableName  = p-TableName
      747         buf_temp_userlog-bush.ulbTwoKey     = i-TwoKey
      748         buf_temp_userlog-bush.ulbParentDesc = p-ParentDesc
      749         buf_temp_userlog-bush.ulbDesc       = p-Desc
      750         buf_temp_userlog-bush.selected      = no
      751         .
      752     end.
      753   end procedure.
      754   define variable vss-include-info1 as character format "X(65)" no-undo
      755   initial "@(#)$Workfile$ $Revision$".
      756   procedure schemlib-get-index-fields :
      757   define input parameter p-table-name     as character        no-undo.
      758   define output parameter p-field-list    as character        no-undo.
      759       define variable v-table-handle          as handle       no-undo.
      760       define variable v-field-handle          as handle       no-undo.
      761       define variable v-index-info            as character    no-undo.
      762       define variable v-counter               as integer      no-undo.
      763       define variable v-index-fields-amount   as integer      no-undo.
      764   do
      765   on error undo, return error
      766   :
      767       if p-table-name = ?
      768       or p-table-name = "":U
      769       then do:
      770           return error substitute( "&1 (get-index-fields). Ошибка задания входных параметров. Задано пустое имя таблицы.", vss-workfile ).
      771       end.
      772       create buffer v-table-handle for table p-table-name no-error.
      773       if error-status :error
      774       then do:
      775           return error substitute( "&1 (get-index-fields). Ошибка задания входных параметров. Неверно задано имя таблицы '&2'.", vss-workfile, p-table-name ).
      776       end.
      777       assign
      778           v-counter       = 1
      779           v-index-info    = v-table-handle :index-information( v-counter )
      780       .
      781       do while v-index-info <> ?
      782       and entry( 3, v-index-info ) <> "1":U
      783       on error undo, return error
      784       :
      785           assign
      786               v-counter       = v-counter + 1
      787               v-index-info    = v-table-handle :index-information( v-counter )
      788           .
      789       end.
      790       if v-index-info = ?
      791       or LC( entry( 1, v-index-info ) ) = "default":U
      792       or entry( 3, v-index-info ) <> "1":U
      793       then do:
      794           return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-table-name ).
      795       end.
      796       else do:
      797           assign
      798               v-index-fields-amount = num-entries( v-index-info ) - 4
      799               p-field-list          = "":U
      800           .
      801           if v-index-fields-amount < 2
      802           then do:
      803               return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-index-info, p-table-name ).
      804           end.
      805           do v-counter = 1 to v-index-fields-amount by 2
      806           on error undo, return error
      807           :
      808               assign
      809                   v-field-handle  = v-table-handle :buffer-field( entry( 4 + v-counter, v-index-info ) ).
      810               .
      811               assign
      812                   p-field-list    = substitute( "&1&2&3":U
      813                                       , p-field-list
      814                                       , ( if p-field-list = "":U then "":U else ",":U )
      815                                       , v-field-handle :name
      816                                       )
      817               .
      818           end.
      819       end.
      820   end.
      821   end procedure.
      822   procedure schemlib-set-buffer :
      823   define input parameter p-table-name     as character        no-undo.
      824   define input parameter p-field-list     as character        no-undo.
      825   define input parameter p-value-list     as character        no-undo.
      826   define output parameter p-buffer-handle as handle           no-undo.
      827       define variable v-query-handle      as handle       no-undo.
      828       define variable v-query-string      as character    no-undo.
      829       define variable v-field-handle      as handle       no-undo.
      830       define variable v-field-name        as character    no-undo.
      831       define variable v-field-value       as character    no-undo.
      832       define variable v-field-counter     as integer      no-undo.
      833       define variable v-counter           as integer      no-undo.
      834       define variable v-field-type        as character    no-undo.
      835   do
      836   on error undo, return error
      837   :
      838       assign
      839           v-field-counter = num-entries( p-field-list )
      840       .
      841       if v-field-counter <> num-entries( p-value-list )
      842       then do:
      843           undo, return error substitute( "schemlib-set-buffer. Указан список значений '&1', не соответствующий списку полей '&2'."
      844                       , p-value-list
      845                       , p-field-list ).
      846       end.
      847       create buffer p-buffer-handle for table p-table-name.
      848       create query v-query-handle.
      849       v-query-handle :set-buffers( p-buffer-handle ).
      850       assign
      851           v-query-string  = substitute( "for each &1 no-lock":U, p-table-name )
      852       .
      853       do v-counter = 1 to v-field-counter
      854       on error undo, return error
      855       :
      856           assign
      857               v-field-name  = entry( v-counter, p-field-list )
      858               v-field-value = entry( v-counter, p-value-list )
      859           .
      860           assign
      861               v-field-handle = p-buffer-handle :buffer-field( v-field-name )
      862           .
      863           if not valid-handle( v-field-handle )
      864           then do:
      865               undo, return error substitute( "schemlib-set-buffer. Не найдено поле '&1' в таблице '&2'."
      866                       , v-field-name
      867                       , p-table-name ).
      868           end.
      869           assign
      870               v-field-type = v-field-handle :data-type
      871           .
      872           assign
      873               v-query-string  = substitute( "&1&2&3.&4=&5&6&5":U
      874                   , v-query-string
      875                   , ( if v-counter = 1 then " where ":U else " and ":U )
      876                   , p-table-name
      877                   , v-field-name
      878                   , ( if v-field-type = "character":U then '"':U else "":U )
      879                   , v-field-value
      880                   )
      881           .
      882       end.
      883       v-query-handle :query-prepare( v-query-string ).
      884       v-query-handle :query-open.
      885       v-query-handle :get-first( no-lock ).
      886       delete object v-query-handle.
      887   end.
      888   end procedure.
      889   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   procedure gen-key-rec :
      891     define input  parameter p-tbl-name    as character no-undo.
      892     define input  parameter p-bh_tbl-name as handle    no-undo.
      893     define output parameter p-key-rec     as character no-undo.
      894     do
      895     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      896     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      897     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      898     :
      899       define variable fh               as handle    no-undo .
      900       define variable v-ok             as logical   no-undo .
      901       define variable v-inform         as character no-undo .
      902       define variable v-ind            as integer   no-undo .
      903       define variable v-idx-field-qnty as integer   no-undo .
      904       if p-tbl-name = ?
      905         or p-tbl-name = "":U
      906       then do:
      907         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      908       end.
      909       if not p-bh_tbl-name:available then do:
      910         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      911       end.
      912       assign
      913         p-key-rec = p-tbl-name
      914         v-inform  = p-bh_tbl-name:index-information(1)
      915         v-ind     = 2
      916       .
      917       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      918       on error undo, return error
      919       :
      920         assign
      921           v-inform = p-bh_tbl-name:index-information( v-ind )
      922           v-ind    = v-ind + 1
      923         .
      924       end.
      925       if v-inform = ?
      926         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      927         or entry( 3, v-inform, ",":U ) <> "1":U
      928       then do:
      929         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      930       end.
      931       else do:
      932         assign
      933           v-idx-field-qnty = num-entries( v-inform ) - 4
      934         .
      935         if v-idx-field-qnty < 2 then do:
      936           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      937         end.
      938         do v-ind = 1 to v-idx-field-qnty by 2
      939         on error undo, return error
      940         :
      941           assign
      942             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      943             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      944           .
      945         end.
      946       end.
      947       if p-key-rec = ? then do:
      948         assign
      949           p-key-rec = "":U
      950         .
      951         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      952       end.
      953     end.
      954     return.
      955   end procedure.
      956   procedure gen-where-keyr-tab :
      957     define input  parameter i-tableSerach as character no-undo.
      958     define input  parameter i-tablekey   as character  no-undo.
      959     define input  parameter p-key-rec    as character  no-undo.
      960     define input  parameter p-key-handle as handle     no-undo .
      961     define input  parameter p-db-name    as character  no-undo .
      962     define input  parameter p-tt-handle  as handle     no-undo .
      963     define output parameter o-Where      as character  no-undo.
      964     do
      965     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      966     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      967     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      968     :
      969       define variable v-full-tbl-name  as character no-undo .
      970       define variable bh_tbl-name      as handle    no-undo .
      971       define variable fh_key           as handle    no-undo .
      972       define variable fh_search        as handle    no-undo .
      973       define variable v-field-num      as integer   no-undo .
      974       define variable v-count-fld      as integer   no-undo .
      975       define variable v-inform         as character no-undo .
      976       define variable v-ind            as integer   no-undo .
      977       define variable v-idx-field-qnty as integer   no-undo .
      978       define variable v-field-name     as character no-undo .
      979       define variable v-field-val      as character no-undo .
      980       define variable v-word-link      as character no-undo .
      981       define variable vTable           as character no-undo.
      982       define variable bh_tbl-key       as handle    no-undo .
      983       assign
      984         p-key-rec = trim( p-key-rec )
      985       .
      986       if p-key-handle <> ? then do:
      987         if not valid-handle(p-key-handle)
      988            or p-key-handle:type <> "buffer"
      989         then do:
      990           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      991         end.
      992         if num-entries( p-key-rec, chr(3) ) > 1
      993           or p-key-rec = ?
      994           or p-key-rec = "":U
      995         then do:
      996           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      997         end.
      998       end.
      999       else do:
     1000         if p-key-rec = ?
     1001           or p-key-rec = "":U
     1002         then do:
     1003           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
     1004         end.
     1005       end.
     1006       assign
     1007         vTable = entry( 1 , p-key-rec, chr(3) )
     1008       .
     1009       if p-tt-handle <> ?
     1010         and ( not valid-handle(p-tt-handle)
     1011               or p-tt-handle:type <> "buffer"
     1012             )
     1013       then do:
     1014         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
     1015       end.
     1016       if p-tt-handle = ? then do:
     1017         assign
     1018           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1019         .
     1020         create buffer bh_tbl-name for table v-full-tbl-name .
     1021       end.
     1022       else do:
     1023         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1024       end.
     1025       assign
     1026         v-inform = bh_tbl-name:index-information(1)
     1027         v-ind    = 2
     1028       .
     1029       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1030       on error undo, return error
     1031       :
     1032         assign
     1033           v-inform = bh_tbl-name:index-information( v-ind )
     1034           v-ind    = v-ind + 1
     1035         .
     1036       end.
     1037       if v-inform = ?
     1038         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1039         or entry( 3, v-inform, ",":U ) <> "1":U
     1040       then do:
     1041         delete object bh_tbl-name no-error.
     1042         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
     1043       end.
     1044       assign
     1045         v-idx-field-qnty = num-entries( v-inform ) - 4
     1046       .
     1047       if v-idx-field-qnty < 2 then do:
     1048         delete object bh_tbl-name no-error.
     1049         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
     1050       end.
     1051       assign
     1052         o-where     = "where":U
     1053         v-word-link = "":U
     1054         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1055         v-count-fld = 0
     1056       .
     1057       if i-tablekey ne "" and i-tablekey ne ?
     1058       then do:
     1059         assign
     1060           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1061         .
     1062         create buffer bh_tbl-key for table v-full-tbl-name .
     1063       end.
     1064       if i-tableSerach ne "" and i-tableSerach ne ?
     1065       then do:
     1066         delete object bh_tbl-name no-error.
     1067         assign
     1068           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1069         .
     1070         create buffer bh_tbl-name for table v-full-tbl-name .
     1071       end.
     1072       block_where:
     1073       do v-ind = 1 to v-idx-field-qnty by 2
     1074       on error undo, return error
     1075       :
     1076         assign
     1077           v-count-fld = v-count-fld + 1
     1078         .
     1079         if p-key-handle = ?
     1080           and v-count-fld > v-field-num
     1081         then do:
     1082           leave block_where.
     1083         end.
     1084         define variable VfieldKeyTable as handle no-undo.
     1085         assign
     1086           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1087           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1088         .
     1089         if     bh_tbl-key ne ?
     1090         then do:
     1091            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1092            if VfieldKeyTable eq ?
     1093            then next block_where.
     1094         end.
     1095         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1096         then
     1097            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1098         else
     1099            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1100         if p-key-handle = ? then do:
     1101           assign
     1102             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1103           .
     1104         end.
     1105         else do:
     1106           assign
     1107             fh_key = p-key-handle:buffer-field( v-field-name )
     1108           .
     1109           if fh_key = ?
     1110             or not valid-handle( fh_key )
     1111           then do:
     1112             delete object bh_tbl-name.
     1113             if     bh_tbl-key ne ?
     1114             then
     1115                delete object bh_tbl-key.
     1116             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
     1117           end.
     1118           assign
     1119             v-field-val = fh_key:buffer-value
     1120           .
     1121         end.
     1122         if fh_search:data-type ="character":U then do:
     1123           assign
     1124             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1125             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1126             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1127             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1128             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1129             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1130             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1131             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1132             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1133             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1134             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1135             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1136             v-field-val = substitute( '"&1"', v-field-val )
     1137           .
     1138         end.
     1139         assign
     1140           o-where = substitute( "&1 &2", o-where, v-field-val )
     1141         .
     1142         if v-word-link = "":U then do:
     1143           assign
     1144             v-word-link = "and":U
     1145           .
     1146         end.
     1147       end.
     1148       delete object bh_tbl-name.
     1149       if     bh_tbl-key ne ?
     1150       then
     1151          delete object bh_tbl-key.
     1152       if p-key-handle = ?
     1153         and v-count-fld <> v-field-num
     1154       then do:
     1155         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
     1156       end.
     1157     end.
     1158   end procedure.
     1159   procedure gen-hn-keyr-tab :
     1160     define input  parameter i-tableSerach as character no-undo.
     1161     define input  parameter i-tablekey   as character no-undo.
     1162     define input  parameter p-key-rec    as character no-undo.
     1163     define input  parameter p-key-handle as handle    no-undo .
     1164     define input  parameter p-db-name    as character no-undo .
     1165     define input  parameter p-tt-handle  as handle    no-undo .
     1166     define input  parameter p-stts-lock  as integer   no-undo .
     1167     define output parameter o-hn         as handle    no-undo.
     1168     define variable v-full-tbl-name as character no-undo.
     1169     define variable v-where         as character no-undo.
     1170     define variable bh_tbl-name     as handle    no-undo.
     1171     define variable vTable          as character no-undo.
     1172     do
     1173     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1174     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1175     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1176         run gen-where-keyr-tab(i-tableSerach,
     1177                                i-tablekey,
     1178                                p-key-rec,
     1179                                p-key-handle,
     1180                                p-db-name,
     1181                                p-tt-handle,
     1182                                output v-where).
     1183         if i-tableSerach ne "" and i-tableSerach ne ?
     1184         then do:
     1185            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1186            create buffer bh_tbl-name for table v-full-tbl-name .
     1187         end.
     1188         else do:
     1189            if p-tt-handle = ? then do:
     1190               assign
     1191                  vTable = entry( 1 , p-key-rec, chr(3) )
     1192               .
     1193               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1194               create buffer bh_tbl-name for table v-full-tbl-name .
     1195            end.
     1196            else do:
     1197               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1198            end.
     1199         end.
     1200         if p-tt-handle = ? then do:
     1201            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1202         end.
     1203         else do:
     1204            bh_tbl-name:find-first( v-where ) no-error .
     1205         end.
     1206         o-hn = bh_tbl-name.
     1207      end.
     1208   end procedure.
     1209   procedure gen-hn-keyr :
     1210     define input  parameter p-key-rec    as character no-undo.
     1211     define input  parameter p-key-handle as handle    no-undo .
     1212     define input  parameter p-db-name    as character no-undo .
     1213     define input  parameter p-tt-handle  as handle    no-undo .
     1214     define input  parameter p-stts-lock  as integer   no-undo .
     1215     define output parameter o-hn         as handle    no-undo.
     1216     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1217   end.
     1218   procedure gen-row-keyr :
     1219     define input  parameter p-key-rec    as character no-undo.
     1220     define input  parameter p-key-handle as handle    no-undo .
     1221     define input  parameter p-db-name    as character no-undo .
     1222     define input  parameter p-tt-handle  as handle    no-undo .
     1223     define input  parameter p-stts-lock  as integer   no-undo .
     1224     define output parameter p-tbl-row    as rowid     no-undo.
     1225     define output parameter p-tbl-name   as character no-undo.
     1226     define variable vHn as handle no-undo.
     1227       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1228       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1229       p-tbl-name =  vHn:table.
     1230       delete object vHn no-error.
     1231     if p-tbl-row = ? then do:
     1232       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
     1233     end.
     1234     else do:
     1235       return.
     1236     end.
     1237   end procedure.
     1238   procedure gen-key-fv :
     1239     define input  parameter p-key-rec    as character no-undo .
     1240     define output parameter p-field-list as character no-undo .
     1241     define output parameter p-value-list as character no-undo.
     1242     do
     1243     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1244     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1245     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1246     :
     1247       define variable v-full-tbl-name  as character no-undo .
     1248       define variable bh_tbl-name      as handle    no-undo .
     1249       define variable v-tbl-name       as character no-undo .
     1250       define variable v-field-num      as integer   no-undo .
     1251       define variable v-count-fld      as integer   no-undo .
     1252       define variable v-inform         as character no-undo .
     1253       define variable v-ind            as integer   no-undo .
     1254       define variable v-idx-field-qnty as integer   no-undo .
     1255       define variable v-delim-key      as character no-undo .
     1256       if p-key-rec = ?
     1257         or p-key-rec = "":U
     1258       then do:
     1259         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
     1260       end.
     1261       assign
     1262         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1263         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1264       .
     1265       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1266       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
     1267       assign
     1268         v-inform = bh_tbl-name:index-information(1)
     1269         v-ind    = 2
     1270       .
     1271       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1272       on error undo, return error
     1273       :
     1274         assign
     1275           v-inform = bh_tbl-name:index-information( v-ind )
     1276           v-ind    = v-ind + 1
     1277         .
     1278       end.
     1279       if v-inform = ?
     1280         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1281         or entry( 3, v-inform, ",":U ) <> "1":U
     1282       then do:
     1283         delete object bh_tbl-name no-error.
     1284         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
     1285       end.
     1286       assign
     1287         v-idx-field-qnty = num-entries( v-inform ) - 4
     1288       .
     1289       if v-idx-field-qnty < 2 then do:
     1290         delete object bh_tbl-name no-error.
     1291         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
     1292       end.
     1293       assign
     1294         p-field-list = "":U
     1295         p-value-list = "":U
     1296         v-delim-key  = "":U
     1297         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1298         v-count-fld  = 0
     1299       .
     1300       block_where:
     1301       do v-ind = 1 to v-idx-field-qnty by 2
     1302       on error undo, return error
     1303       :
     1304         assign
     1305           v-count-fld = v-count-fld + 1
     1306         .
     1307         if v-count-fld > v-field-num then do:
     1308           leave block_where.
     1309         end.
     1310         assign
     1311           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1312           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1313         .
     1314         if v-ind = 1 then do:
     1315           assign
     1316             v-delim-key = chr(3)
     1317           .
     1318         end.
     1319       end.
     1320       delete object bh_tbl-name.
     1321       if v-count-fld <> v-field-num then do:
     1322         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
     1323       end.
     1324     end.
     1325   end procedure.
     1326   procedure gen-key-field :
     1327     define input  parameter p-table      as character no-undo .
     1328     define output parameter p-field-list as character no-undo .
     1329     do
     1330     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1331     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1332     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1333     :
     1334       define variable v-full-tbl-name  as character no-undo .
     1335       define variable bh_tbl-name      as handle    no-undo .
     1336       define variable v-tbl-name       as character no-undo .
     1337       define variable v-field-num      as integer   no-undo .
     1338       define variable v-count-fld      as integer   no-undo .
     1339       define variable v-inform         as character no-undo .
     1340       define variable v-ind            as integer   no-undo .
     1341       define variable v-idx-field-qnty as integer   no-undo .
     1342       define variable v-delim-key      as character no-undo .
     1343       if p-table = ?
     1344         or p-table = "":U
     1345       then do:
     1346         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
     1347       end.
     1348       assign
     1349         v-tbl-name      = p-table
     1350         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1351       .
     1352       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1353       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
     1354       assign
     1355         v-inform = bh_tbl-name:index-information(1)
     1356         v-ind    = 2
     1357       .
     1358       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1359       on error undo, return error
     1360       :
     1361         assign
     1362           v-inform = bh_tbl-name:index-information( v-ind )
     1363           v-ind    = v-ind + 1
     1364         .
     1365       end.
     1366       if v-inform = ?
     1367         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1368         or entry( 3, v-inform, ",":U ) <> "1":U
     1369       then do:
     1370         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
     1371       end.
     1372       assign
     1373         v-idx-field-qnty = num-entries( v-inform ) - 4
     1374       .
     1375       if v-idx-field-qnty < 2 then do:
     1376         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
     1377       end.
     1378       assign
     1379         p-field-list = "":U
     1380         v-delim-key  = "":U
     1381         v-count-fld  = 0
     1382       .
     1383       block_where:
     1384       do v-ind = 1 to v-idx-field-qnty by 2
     1385       on error undo, return error
     1386       :
     1387         assign
     1388           v-count-fld = v-count-fld + 1
     1389         .
     1390         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1391         if v-ind = 1 then do:
     1392           assign
     1393             v-delim-key = chr(3)
     1394           .
     1395         end.
     1396       end.
     1397       delete object bh_tbl-name.
     1398     end.
     1399   end procedure.
     1400   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1401   procedure cur-time :
     1402      define output parameter p-today as date      no-undo .
     1403      define output parameter p-time  as integer   no-undo .
     1404     do
     1405     on error undo, return error
     1406     :
     1407       define variable v-date1 as date      no-undo .
     1408       define variable v-date2 as date      no-undo .
     1409       define variable v-time  as integer   no-undo .
     1410       assign
     1411         v-date1 = today
     1412         v-time  = time
     1413         v-date2 = today
     1414       .
     1415       if v-date1 <> v-date2
     1416       then do:
     1417         assign
     1418           v-date1 = today
     1419           v-time  = v-time
     1420         .
     1421       end.
     1422       assign
     1423         p-today = v-date1
     1424         p-time  = v-time
     1425       .
     1426     end.
     1427   end.
     1428   function cur-time-date returns character
     1429   :
     1430     return string(today, '99/99/9999':U) .
     1431   end.
     1432   function cur-time-mjd returns decimal
     1433   :
     1434     define variable v-date as date      no-undo .
     1435     define variable v-time as integer   no-undo .
     1436     run cur-time in this-procedure
     1437       (output v-date
     1438       ,output v-time
     1439       ) .
     1440     return integer(v-date) - 2400002 + (v-time / 86400) .
     1441   end.
     1442   function cur-time-get-ending-index returns integer
     1443   (input p-number as integer
     1444   )
     1445   :
     1446     if p-number < 0
     1447     or p-number = ?
     1448     then do:
     1449       return 1 .
     1450     end.
     1451     define variable v-rest as integer   no-undo .
     1452     assign
     1453       p-number = p-number modulo 100
     1454     .
     1455     if p-number < 20
     1456     then do:
     1457       assign
     1458         v-rest = p-number
     1459       .
     1460     end.
     1461     else do:
     1462       assign
     1463         v-rest = p-number modulo 10
     1464       .
     1465     end.
     1466     case v-rest :
     1467       when 1
     1468       then do:
     1469         return 2 .
     1470       end.
     1471       when 2 or
     1472       when 3 or
     1473       when 4
     1474       then do:
     1475         return 3 .
     1476       end.
     1477       otherwise do:
     1478         return 1 .
     1479       end.
     1480     end case .
     1481   end.
     1482   procedure cur-time-mjd-to-date :
     1483      define input  parameter i-mjd-diff as decimal no-undo.
     1484      define output parameter o-Date     as date    no-undo.
     1485      define output parameter o-Time     as integer no-undo.
     1486      define variable v-day-number as integer   no-undo .
     1487      if    i-mjd-diff < 0
     1488         or i-mjd-diff = ?
     1489      then do:
     1490         return "?" .
     1491      end.
     1492      assign
     1493         v-day-number = truncate(i-mjd-diff,0).
     1494         o-Date = date(v-day-number + 2400002).
     1495         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1496     .
     1497   end.
     1498   function cur-time-mjd-to-string returns character
     1499   (input p-mjd-diff as decimal
     1500   )
     1501   :
     1502     define variable v-day-number as integer   no-undo .
     1503     define variable v-seconds    as integer   no-undo .
     1504     define variable v-hour       as integer   no-undo .
     1505     define variable v-min        as integer   no-undo .
     1506     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1507     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1508     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1509     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1510     if p-mjd-diff < 0
     1511     or p-mjd-diff = ?
     1512     then do:
     1513       return "?" .
     1514     end.
     1515     assign
     1516       v-day-number = integer(truncate(p-mjd-diff,0))
     1517       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1518     .
     1519     if v-seconds > 86400
     1520     then do:
     1521       assign
     1522         v-seconds = 86400 - 1
     1523       .
     1524     end.
     1525     if v-seconds < 0
     1526     then do:
     1527       assign
     1528         v-seconds = 0
     1529       .
     1530     end.
     1531     assign
     1532       v-hour = truncate(v-seconds / 3600, 0)
     1533     .
     1534     assign
     1535       v-seconds = v-seconds modulo 3600
     1536     .
     1537     assign
     1538       v-min = truncate(v-seconds / 60, 0)
     1539     .
     1540     assign
     1541       v-seconds = v-seconds modulo 60
     1542     .
     1543     return
     1544         (if v-day-number <> 0
     1545           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1546           else ""
     1547         )
     1548       + (if v-day-number <> 0 or v-hour <> 0
     1549           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1550           else ""
     1551         )
     1552       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1553           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1554           else ""
     1555         )
     1556       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1557       .
     1558   end.
     1559   function cur-time-string returns character
     1560   :
     1561     define variable v-date as date      no-undo .
     1562     define variable v-time as integer   no-undo .
     1563     run cur-time in this-procedure
     1564       (output v-date
     1565       ,output v-time
     1566       ) .
     1567     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1568   end.
     1569   function cur-time-string-sec returns character
     1570   :
     1571     define variable v-date as date      no-undo .
     1572     define variable v-time as integer   no-undo .
     1573     run cur-time in this-procedure
     1574       (output v-date
     1575       ,output v-time
     1576       ) .
     1577     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1578   end.
     1579   function cur-time-custom  returns character
     1580   (input p-prefix as character
     1581   ,input p-date-format as character
     1582   ,input p-delimiter as character
     1583   ,input p-time-format as character
     1584   ,input p-suffix as character
     1585   )
     1586   :
     1587     define variable v-date as date      no-undo .
     1588     define variable v-time as integer   no-undo .
     1589     run cur-time in this-procedure
     1590       (output v-date
     1591       ,output v-time
     1592       ) .
     1593     return
     1594       p-prefix
     1595       + string(v-date, p-date-format)
     1596       + p-delimiter
     1597       + string(v-time, p-time-format)
     1598       + p-suffix
     1599       .
     1600   end.
     1601   function cur-time-print  returns character
     1602   :
     1603     define variable v-date as date      no-undo .
     1604     define variable v-time as integer   no-undo .
     1605     run cur-time in this-procedure
     1606       (output v-date
     1607       ,output v-time
     1608       ) .
     1609     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1610   end.
     1611   function cur-time-datetime returns datetime
     1612   :
     1613     define variable v-char as character no-undo .
     1614     define variable v-datetime as datetime no-undo .
     1615     v-char = cur-time-string().
     1616     v-datetime = datetime(v-char).
     1617     return  v-datetime.
     1618   end.
     1619   function cur-time-string-msec returns character
     1620   :
     1621     define variable v-date as datetime  no-undo .
     1622     v-date = now.
     1623     return string(v-date) .
     1624   end.
     1625   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1626   function usrnickf returns character ( input p-user-id as character):
     1627      define variable v-nick      as character    no-undo.
     1628      if p-user-id = ?
     1629      OR p-user-id = "":U
     1630      then do:
     1631         return '':U .
     1632      end.
     1633   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1634   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
     1635     (input  p-user-id
     1636     ,output v-nick
     1637     ) no-error .
     1638      if error-status :error
     1639      then do:
     1640         return p-user-id.
     1641      end.
     1642      else do:
     1643         return v-nick.
     1644      end.
     1645   end function.
     1646   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1647   define new global shared variable g#attr-lib  as handle no-undo .
     1648   define variable v-attr-lib-variable as handle no-undo .
     1649   procedure db-attr-code :
     1650     define input  parameter p-code           as character no-undo .
     1651     define output parameter p-type           as character no-undo .
     1652     define output parameter p-format         as character no-undo .
     1653     define output parameter p-label          as character no-undo .
     1654     define output parameter p-user-can-edit  as logical   no-undo .
     1655     define output parameter p-output-display as logical   no-undo .
     1656     define output parameter p-other          as character no-undo .
     1657     do
     1658     on error undo, return error
     1659     :
