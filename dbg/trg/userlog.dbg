     2323               create buf_c-user-log.
     2324               assign
     2325                   buf_c-user-log.corr-user-db-num = v-corr-user-db-num
     2326                   buf_c-user-log.cusr-id          = next-value( s-user-history )
     2327                   buf_c-user-log.chip-num         = 0
     2328                   buf_c-user-log.corr-date        = p-table-handle :buffer-field( "corr-date":U ) :buffer-value
     2329                   buf_c-user-log.corr-time        = p-table-handle :buffer-field( "corr-time":U ) :buffer-value
     2330                   buf_c-user-log.corr-user-name   = p-table-handle :buffer-field( "corr-user-name":U ) :buffer-value
     2331                   buf_c-user-log.des              = substitute( "&1 &2 &3":U
     2332                                                       , v-action-type
     2333                                                       , buf_temp_userlog-bush.ulbDesc
     2334                                                       , buf_temp_userlog-bush.ulbParentDesc
     2335                                                   )
     2336                   buf_c-user-log.have-screen      = yes
