     2231                   or v-parent-unique-key-rec = ""
     2232                   then do:
     2233                       return error substitute( "&1. Уникальный ключ имеет неопределенное значение. Имя таблицы &2.", vss-workfile, v-parent-name ).
     2234                   end.
     2235               end.
     2236           end.
     2237           create buf_c-user-log.
     2238           assign
     2239               buf_c-user-log.corr-user-db-num = v-corr-user-db-num
     2240               buf_c-user-log.cusr-id          = next-value( s-user-history )
     2241               buf_c-user-log.chip-num         = 0
     2242               buf_c-user-log.des              = substitute( "&1 &2 &3":U
     2243                                                   , v-action-type
     2244                                                   , buf_temp_userlog-bush.ulbDesc
     2245                                                   , buf_temp_userlog-bush.ulbParentDesc
     2246                                               )
     2247               buf_c-user-log.have-screen      = yes
     2248               buf_c-user-log.head-table-key   = v-parent-unique-key-rec
     2249               buf_c-user-log.head-table       = v-parent-name
     2250               buf_c-user-log.uniq-key-rec     = v-unique-key-rec
     2251           .
     2252           assign
     2253           buf_c-user-log.corr-date        = p-table-handle :buffer-field( "corr-date":U ) :buffer-value
     2254           buf_c-user-log.corr-time        = p-table-handle :buffer-field( "corr-time":U ) :buffer-value
     2255           buf_c-user-log.corr-user-name   = p-table-handle :buffer-field( "corr-user-name":U ) :buffer-value no-error.
     2256           if error-status :error then
     2257           do:
     2258               assign
     2259                   buf_c-user-log.corr-date      = v-corr-date
     2260                   buf_c-user-log.corr-time      = v-corr-time
     2261                   buf_c-user-log.corr-user-name = g#userid.
     2262           end.
     2263           if buf_c-user-log.corr-user-name = "" then do:
     2264             assign
     2265               buf_c-user-log.corr-user-name = p-table-handle :buffer-field( "user-id":U ) :buffer-value no-error.
     2266           end.
     2267       end.
     2268       block-userlog-type-bush:
     2269       for each buf_temp_userlog-bush
     2270          where buf_temp_userlog-bush.ulbType      = 0
     2271            and buf_temp_userlog-bush.ulbTableName = p-tbl-name
     2272            and buf_temp_userlog-bush.ulbParentKey <> 0
     2273       on error undo, return error
     2274       :
     2275          if m-two-key ne buf_temp_userlog-bush.ulbTwoKey
     2276          then
     2277             next block-userlog-type-bush.
     2278           run userlog-get-table-name in this-procedure (
     2279                 input buf_temp_userlog-bush.ulbParentKey
     2280               , output v-parent-name
     2281           ).
     2282           if v-parent-name = p-tbl-name
     2283           then do:
     2284           end.
     2285           else do:
     2286               run schemlib-get-index-fields in this-procedure (
     2287                     input v-parent-name
     2288                   , output v-field-list
     2289               ) no-error.
     2290               if error-status :error
     2291               or v-field-list = "":U
     2292               then do:
     2293                   undo, return error substitute( "&1. Ошибка вычисления первичного ключа родительской таблицы '&2' для таблицы '&3'", vss-description, v-parent-name, p-tbl-name ).
     2294               end.
     2295           if not valid-handle( p-table-handle :buffer-field( "subject":U ) )
     2296               then
     2297           do:
     2298               assign
     2299                   v-value-list = string(p-tbl-name)
     2300               .
     2301               undo, return error substitute( "&1. Ошибка структуры c-таблицы. В таблице &2 нет поля subject", vss-description, p-tbl-name ).
     2302           end.
     2303           else do:
