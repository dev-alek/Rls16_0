     2105       end.
     2106       assign
     2107           v-corr-user-db-num = p-table-handle :buffer-field( "corr-user-db-num":U ) :buffer-value
     2108           v-corr-date        = p-table-handle :buffer-field( "corr-date":U ) :buffer-value
     2109           v-corr-time        = p-table-handle :buffer-field( "corr-time":U ) :buffer-value
     2110           v-corr-user-name   = p-table-handle :buffer-field( "corr-user-name":U ) :buffer-value no-error
     2111       .
     2112       if error-status :error then
     2113       do:
     2114           if not p-tbl-name begins "c-"
     2115           then
     2116           do:
     2117               run cur-time in this-procedure(output v-corr-date, output v-corr-time).
     2118               assign
     2119                   v-corr-user-db-num = g#db-num
     2120                   v-corr-date        = v-corr-date
     2121                   v-corr-time        = v-corr-time
     2122                   v-corr-user-name   = g#userid .
     2123           end.
     2124           else
     2125           do:
     2126               undo, return error substitute( "Ошибка структуры c-таблицы  &2 ", vss-description, p-tbl-name ).
     2127           end.
     2128       end.
     2129       if v-corr-user-db-num   = ?
     2130       or v-corr-date          = ?
     2131       or v-corr-time          = ?
     2132       or v-corr-user-name     = ?
     2133       then do:
     2134           undo, return .
     2135       end.
     2136       run userlog-hist-table-init (
     2137             input p-tbl-name
     2138       ).
     2139       block-userlog-type-simple:
     2140       for each buf_temp_userlog-bush
     2141          where buf_temp_userlog-bush.ulbType = 1
     2142            and buf_temp_userlog-bush.ulbTableName = p-tbl-name
     2143       on error undo, return error
     2144       :
     2145          if m-two-key ne buf_temp_userlog-bush.ulbTwoKey
     2146          then
     2147             next block-userlog-type-simple.
     2148           if buf_temp_userlog-bush.ulbParentKey = 0
     2149           then do:
     2150               assign
     2151                   v-parent-unique-key-rec = v-unique-key-rec
     2152                   v-parent-name           = p-tbl-name
     2153               .
     2154           end.
     2155           else do:
     2156               run userlog-get-table-name in this-procedure (
     2157                     input buf_temp_userlog-bush.ulbParentKey
     2158                   , output v-parent-name
     2159               ).
     2160               if v-parent-name = p-tbl-name
     2161               then do:
     2162                   assign
     2163                       v-parent-unique-key-rec = v-unique-key-rec
     2164                   .
     2165               end.
     2166               else do:
     2167                  if p-tbl-name = "user-obj" or
     2168                     p-tbl-name = "user-host" or
     2169                     p-tbl-name = "user-login-action-role" or
     2170                     p-tbl-name = "user-login-action-item" or
     2171                     p-tbl-name = "user-menu-group"
     2172                     then do:
     2173                     v-field-list = "user-id" .
     2174                  end.
     2175                  else do:
     2176                   run schemlib-get-index-fields in this-procedure (
     2177                       input v-parent-name
     2178                       , output v-field-list
     2179                   ) no-error.
     2180                   end.
     2181                   if error-status :error
     2182                   or v-field-list = "":U
     2183                   then do:
     2184                       undo, return error substitute( "&1. Ошибка вычисления первичного ключа родительской таблицы '&2' для таблицы '&3'", vss-description, v-parent-name, p-tbl-name ).
     2185                   end.
     2186                   assign
     2187                       v-field-counter = num-entries( v-field-list )
     2188                   .
     2189                   do v-counter = 1 to v-field-counter
     2190                   on error undo, return error
     2191                   :
     2192                       assign
     2193                           v-field-handle = p-table-handle :buffer-field( entry( v-counter, v-field-list ) )
     2194                       .
     2195                       if not valid-handle( v-field-handle )
     2196                       then do:
     2197                           undo, return error substitute( "&1. В таблице '&2' нет поля, соответствующего полю '&3' в родительской таблице '&4'"
     2198                               , vss-description
     2199                               , v-parent-name
     2200                               , entry( v-counter, v-field-list )
     2201                               , v-parent-name
     2202                           ).
     2203                       end.
     2204                       assign
     2205                           v-value-list = substitute( "&1&2&3":U
     2206                                           , v-value-list
     2207                                           , ( if v-value-list = "":U then "":U else ",":U )
     2208                                           , v-field-handle :buffer-value
     2209                                           )
     2210                       .
     2211                   end.
     2212                   run schemlib-set-buffer in this-procedure (
     2213                       input v-parent-name
     2214                       , input v-field-list
     2215                       , input v-value-list
     2216                       , output v-parent-buffer-handle
     2217                   ) no-error.
     2218                   if error-status:error
     2219                   then
     2220                      return error return-value.
     2221                   run gen-key-rec in this-procedure (
     2222                       input v-parent-name
     2223                       , input v-parent-buffer-handle
     2224                       , output v-parent-unique-key-rec
     2225                   ) no-error.
     2226                   if error-status :error
     2227                   then do:
     2228                       return error substitute( "&1. Ошибка при генерации уникального ключа. &2. Имя таблицы &3.", vss-workfile, return-value, v-parent-name ).
     2229                   end.
