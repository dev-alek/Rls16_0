     2306               .
     2307           end.
     2308               run schemlib-set-buffer in this-procedure (
     2309                     input v-parent-name
     2310                   , input v-field-list
     2311                   , input v-value-list
     2312                   , output v-parent-buffer-handle
     2313               ).
     2314               run gen-key-rec in this-procedure (
