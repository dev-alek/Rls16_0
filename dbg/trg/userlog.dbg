     1844      no-lock no-error.
     1845      if     avail buf_c-user-log
     1846         and buf_c-user-log.cusr-id          > current-value( s-user-history )
     1847      then
     1848         current-value( s-user-history ) = buf_c-user-log.cusr-id.
     1849      release buf_c-user-log.
     1850      if p-action = 'report':U then do:
