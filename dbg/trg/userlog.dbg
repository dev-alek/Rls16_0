     2046               buf_c-user-log.corr-date        = v-corr-date
     2047               buf_c-user-log.corr-time        = v-corr-time
     2048               buf_c-user-log.corr-user-name   = g#userid
     2049               buf_c-user-log.des              = entry(1,p-tbl-name,chr(3))
     2050               buf_c-user-log.have-screen      = yes
     2051               buf_c-user-log.head-table-key   = entry(2,p-tbl-name,chr(3))
     2052               buf_c-user-log.head-table       = 'one-pwd':U
     2053               buf_c-user-log.uniq-key-rec     = entry(2,p-tbl-name,chr(3))
     2054            no-error.
     2055           return.
     2056       end.
     2057       if   p-action = 'MEASURER_PAR':U then do:
     2058           run cur-time in this-procedure(output v-corr-date, output v-corr-time).
     2059           create buf_c-user-log.
     2060           assign
     2061               buf_c-user-log.corr-user-db-num = g#db-num
     2062               buf_c-user-log.cusr-id          = next-value( s-user-history )
     2063               buf_c-user-log.chip-num         = 0
