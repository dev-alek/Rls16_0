     2079          p-tbl-name = entry(1,p-tbl-name,chr(3))
     2080       .
     2081       case p-action :
     2082           when 'delete':U      then v-action-type = "Удаление" .
     2083           when 'create':U      then v-action-type = "Создание" .
     2084           when 'update':U      then v-action-type = "Изменение" .
     2085           when 'update_err':U  then v-action-type = "Изменение ОШ." .
     2086           when 'delete_err':U  then v-action-type = "Удаление ОШ." .
     2087       end case.
     2088       if not p-table-handle :available
     2089       then do:
     2090           undo, return error substitute( "&1. Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-description, p-tbl-name ).
     2091       end.
     2092       run gen-key-rec in this-procedure (
     2093             input p-tbl-name
     2094           , input p-table-handle
     2095           , output v-unique-key-rec
     2096       ) no-error.
     2097       if error-status :error
     2098       then do:
     2099           return error substitute( "&1. Ошибка при генерации уникального ключа. &2. Имя таблицы &3.", vss-workfile, return-value, p-tbl-name ).
     2100       end.
     2101       if v-unique-key-rec = ?
     2102       or v-unique-key-rec = ""
