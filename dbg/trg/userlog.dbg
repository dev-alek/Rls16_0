     1855               buf_c-user-log.cusr-id          = next-value( s-user-history )
     1856               buf_c-user-log.chip-num         = 0
     1857               buf_c-user-log.corr-date        = v-corr-date
     1858               buf_c-user-log.corr-time        = v-corr-time
     1859               buf_c-user-log.corr-user-name   = g#userid
     1860               buf_c-user-log.des              = "Отчет " + entry(1,p-tbl-name,chr(3))
     1861               buf_c-user-log.have-screen      = yes
     1862               buf_c-user-log.head-table-key   = 'report:':U + chr(3) + entry(2,p-tbl-name,chr(3))
     1863               buf_c-user-log.head-table       = 'report':U
     1864               buf_c-user-log.uniq-key-rec     = 'report:':U + chr(3) + entry(2,p-tbl-name,chr(3))
     1865            no-error.
     1866           return.
     1867       end.
