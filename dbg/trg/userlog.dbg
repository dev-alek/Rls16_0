     2346       end.
     2347   end.
     2348   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2349     (input  'is-cctv'
     2350     ,input  ''
     2351     ,input  ''
     2352     ,input  0
     2353     ,input  ''
     2354     ,input  ''
     2355     ,input  ''
     2356     ,input  no
     2357     ,output par-is-cctv
     2358     ,output par-type
     2359     ) no-error .
     2360   is-cctv = lookup(par-is-cctv, "true,yes":U) > 0 .
     2361   return-value = "".
     2362   if p-video-action <> 0 and p-video-action <> ? and is-cctv
     2363       then
     2364   do :
     2365       define variable v-vid-ok  as logical   no-undo .
     2366       define variable v-vid-mes as character no-undo .
     2367       if not p-video-param begins "Login=" then
     2368       do :
     2369           find first buf_user-login no-lock
     2370               where buf_user-login.db-num  = g#db-num
     2371               and buf_user-login.user-id = g#userid
     2372               no-error .
     2373           if available buf_user-login
     2374               then
     2375           do:
     2376               assign
     2377                   p-video-param = p-video-param + chr(4) +
     2378                               "Login=" + buf_user-login.user-login + chr(4) +
     2379                               "THname=" + usrnickf(buf_user-login.user-id)
     2380                   .
     2381           end.
     2382       end.
     2383       run db-attr-value in this-procedure ( input g#db-num
     2384                                             , input 'mess-id-video':U
     2385                                             , output v-db-attr-value
     2386                                             , output v-db-attr-type
     2387                                             ) no-error .
     2388       assign
     2389         v-mess-id = integer (v-db-attr-value) no-error.
     2390       if v-mess-id = ?
     2391         then v-mess-id = 0.
     2392       p-video-param = p-video-param + chr(4) +
     2393         "MESSAGE_ID=" + string (v-mess-id)
     2394       .
     2395       v-mess-id = v-mess-id + 1.
     2396       run db-attr-write in this-procedure ( input g#db-num
     2397                                           , input 'mess-id-video':U
     2398                                           , input string (v-mess-id)
     2399                                           ) no-error .
     2400       run trg/video-action.p (input p-video-action,
     2401           input p-video-param,
