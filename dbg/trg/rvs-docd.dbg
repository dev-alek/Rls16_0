        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.rvs-doc.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Триггер на удаление документа сверки ":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define temp-table x_obj-group no-undo like ub.clients  .
       82   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
       83   procedure metod-gop-obj :
       84     do
       85     on error undo, return error return-value
       86     :
       87   define input  parameter p-cntxt-db-num as integer   no-undo .
       88   define input  parameter p-gop-id       as integer   no-undo .
       89   define input  parameter p-gop-db-num   as integer   no-undo .
       90   define buffer buf1_clients for ub.clients  .
       91   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
       92   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
       93   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
       94   for each  x_obj-group : delete x_obj-group. end.
       95   if p-gop-id = 0 or p-gop-id = ?  then do:
       96      if p-cntxt-db-num = 0  then do:
       97           for each buf1_clients no-lock where
       98                   (buf1_clients.obj-type = 'маг':U  or
       99                    buf1_clients.obj-type = 'скл':U  )
      100                   and
      101                   buf1_clients.db-num >= 0  and
      102                   buf1_clients.stts = 0
      103                   :
      104             create x_obj-group .
      105             assign
      106               x_obj-group.obj-code   = buf1_clients.obj-code
      107               x_obj-group.obj-type   = buf1_clients.obj-type
      108               x_obj-group.obj-name   = buf1_clients.obj-name
      109               x_obj-group.db-num     = buf1_clients.db-num
      110             .
      111           end.
      112      end.
      113      else do:
      114           for each buf1_clients no-lock where
      115                   (buf1_clients.obj-type = 'маг':U  or
      116                    buf1_clients.obj-type = 'скл':U  ) and
      117                    buf1_clients.db-num = p-cntxt-db-num  and
      118                    buf1_clients.stts = 0
      119                   :
      120             create x_obj-group .
      121             assign
      122               x_obj-group.obj-code   = buf1_clients.obj-code
      123               x_obj-group.obj-type   = buf1_clients.obj-type
      124               x_obj-group.obj-name   = buf1_clients.obj-name
      125               x_obj-group.db-num     = buf1_clients.db-num
      126             .
      127           end.
      128      end.
      129   end.
      130   else do:
      131         for each buf_db-grp-obj-price  where
      132                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      133                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      134                 buf_db-grp-obj-price.stts = 0  no-lock :
      135           for each buf1_clients no-lock where
      136                  (buf1_clients.obj-type = 'маг':U  or
      137                   buf1_clients.obj-type = 'скл':U  ) and
      138                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      139                   buf1_clients.stts = 0
      140                   :
      141             create x_obj-group .
      142             assign
      143               x_obj-group.obj-code   = buf1_clients.obj-code
      144               x_obj-group.obj-type   = buf1_clients.obj-type
      145               x_obj-group.obj-name   = buf1_clients.obj-name
      146               x_obj-group.db-num     = buf1_clients.db-num
      147             .
      148           end.
      149         end.
      150       for each buf_host-grp-obj-price where
      151               buf_host-grp-obj-price.gop-id     = p-gop-id and
      152               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      153               buf_host-grp-obj-price.stts = 0
      154               no-lock :
      155         for each buf1_clients no-lock where
      156                (buf1_clients.obj-type = 'маг':U  or
      157                 buf1_clients.obj-type = 'скл':U  ) and
      158                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      159                 buf1_clients.stts = 0
      160                 :
      161             find first x_obj-group no-lock  where
      162                       x_obj-group.obj-code   = buf1_clients.obj-code and
      163                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      164             if not available  x_obj-group then   create x_obj-group .
      165             assign
      166               x_obj-group.obj-code   = buf1_clients.obj-code
      167               x_obj-group.obj-type   = buf1_clients.obj-type
      168               x_obj-group.obj-name   = buf1_clients.obj-name
      169               x_obj-group.db-num     = buf1_clients.db-num
      170             .
      171         end.
      172       end.
      173       for each buf_obj-grp-obj-price where
      174               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      175               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      176               buf_obj-grp-obj-price.stts = 0
      177               no-lock :
      178         for each buf1_clients no-lock where
      179                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      180                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      181                   buf1_clients.stts     = 0
      182                   :
      183             find first  x_obj-group no-lock  where
      184                         x_obj-group.obj-code   = buf1_clients.obj-code and
      185                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      186             if not available  x_obj-group then   create x_obj-group .
      187             assign
      188               x_obj-group.obj-code   = buf1_clients.obj-code
      189               x_obj-group.obj-type   = buf1_clients.obj-type
      190               x_obj-group.obj-name   = buf1_clients.obj-name
      191               x_obj-group.db-num     = buf1_clients.db-num
      192             .
      193         end.
      194       end.
      195   end.
      196   end.
      197   end procedure.
      198   procedure metod-obj-in-gop :
      199   define input  parameter p-curr-db-num as integer   no-undo .
      200   define input  parameter p-obj-type as character no-undo .
      201   define input  parameter p-obj-code as integer   no-undo .
      202   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      203     do
      204     on error undo, return error return-value
      205     :
      206       empty temp-table x_grp-obj-price.
      207       for each buf_grp-obj-price where
      208                buf_grp-obj-price.stts = 0
      209                no-lock :
      210                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      211                  for each x_obj-group where
      212                           x_obj-group.obj-type = p-obj-type and
      213                           x_obj-group.obj-code = p-obj-code :
      214                       create  x_grp-obj-price.
      215                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      216                  end.
      217       end.
      218     end.
      219   end procedure.
      220   procedure metod-delobj-usr :
      221   define input  parameter p-pdf-id  as integer   no-undo .
      222   define input  parameter p-pdf-db  as integer   no-undo .
      223   define input  parameter p-plt-id  as integer   no-undo .
      224   define input  parameter p-plt-db-num as integer   no-undo .
      225   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      226     do
      227     on error undo, return error return-value
      228     :
      229   for each buf_price-doc-forming-attr no-lock  where
      230            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      231            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      232            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      233            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      234            buf_price-doc-forming-attr.attr-code begins "obj" :
      235      for each x_obj-group  where
      236               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      237               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      238        delete x_obj-group.
      239      end.
      240   end.
      241     if not can-find (first x_obj-group) then do:
      242        return "nullobj" .
      243     end.
      244   end.
      245   end procedure.
      246   procedure metod-obj-pdf :
      247   define input  parameter p-cntxt-db-num as integer   no-undo .
      248   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      249   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      250   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      251   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      252   define buffer buf_price-list-type for ub.price-list-type  .
      253   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      254     do
      255     on error undo, return error return-value
      256     :
      257    for each  x_obj-group : delete x_obj-group. end.
      258    find first buf_price-list-type no-lock where
      259               buf_price-list-type.plt-id = p-plt-id and
      260               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      261   if error-status :error then return error return-value .
      262    find first buf_price-doc-forming no-lock where
      263               buf_price-doc-forming.plt-id     = p-plt-id and
      264               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      265               buf_price-doc-forming.pdf-id     = p-pdf-id and
      266               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      267               no-error .
      268   if error-status :error then return error return-value .
      269     run metod-gop-obj in this-procedure (
      270         p-cntxt-db-num,
      271         buf_price-list-type.gop-id ,
      272         buf_price-list-type.gop-db-num
      273         ) no-error .
      274     run metod-delobj-usr in this-procedure (
      275       buf_price-doc-forming.pdf-id ,
      276       buf_price-doc-forming.pdf-db ,
      277       buf_price-doc-forming.plt-id ,
      278       buf_price-doc-forming.plt-db-num
      279       ) no-error .
      280     end.
      281   end procedure.
      282   define variable v-initiator  as character no-undo.
      283   case true:
      284     when g#auto then v-initiator = "Auto".
      285     when g#news then v-initiator = "Nws".
      286     when g#esys then v-initiator = "Esys".
      287     otherwise v-initiator = "User".
      288   end case.
      289     define new global shared variable g#lib-rvs as handle no-undo.
      290   define variable v-person as character no-undo.
      291   define variable v-mess as character no-undo .
      292   define variable v-value-character as character no-undo .
      293   define variable v-date-close-period as date      no-undo .
      294   define variable v-value-decimal as decimal   no-undo .
      295   define variable v-value-integer as integer   no-undo .
      296   define variable v-value-logical as logical   no-undo .
      297   define variable v-value-type as character no-undo .
      298   define variable v-vid-action  as integer  no-undo .
      299   define variable v-vid-param   as longchar no-undo .
      300   define variable varshift-date as date     no-undo.
      301   define variable varshift-num  as integer  no-undo.
      302   define variable varshift-name as char     no-undo.
      303   Main-Block:
      304   do
      305   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      306   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      307   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      308   :
      309   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      311     (input  ub.rvs-doc.obj-type
      312     ,input  ub.rvs-doc.obj-code
      313     ,output varshift-date
      314     ,output varshift-num
      315     ,output varshift-name
      316     ) no-error .
      317     if ( ub.rvs-doc.status_ = 'факт':U
      318         and ub.rvs-doc.is-del <> true
      319        )
      320       or ( g#news = false
      321            and ub.rvs-doc.status_ <> 'новый':U
      322            and ub.rvs-doc.status_ <> 'факт':U
      323           )
      324     then do:
      325       assign
      326         v-mess = substitute( "&1 &2&3"
      327                              + "Документ сверки может быть удален только в статусе новый или факт&3"
      328                              + "Сверка &4&3"
      329                              + "Складской документ &5&3"
      330                              + "Тип сверки &6&3"
      331                              + "Статус сверки &7&3"
      332                              , vss-workfile
      333                              , vss-revision
      334                              , chr(10)
      335                              , ub.rvs-doc.rvs-code
      336                              , ub.rvs-doc.out-code
      337                              , ub.rvs-doc.rvs-type
      338                              , ub.rvs-doc.status_
      339                            )
      340       .
      341       if g#news = false then do:
      342         message
      343           v-mess skip
      344           view-as alert-box error .
      345       end.
      346       undo Main-Block, return error v-mess .
      347     end.
      348       if  (ub.rvs-doc.status_ = 'факт':U  and ub.rvs-doc.is-del = true)
      349           then
      350       do:
      351   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_hstc-rvs in g#lib-rvs
      352   ( buffer ub.rvs-doc
      353    ,input integer('99':U)
      354    ,input ub.rvs-doc.rvs-code
      355    ,input dynamic-next-value('s-corr-chip':U,'ub':U)
      356   ) no-error.
      357           if error-status :error then
      358           do:
      359               message
      360                   vss-workfile vss-revision vss-description skip
      361                   substitute("Ошибка записи истории удаления документа сверки &1", ub.rvs-doc.rvs-code ) skip
      362                   error-status :get-message(1) skip
      363                   return-value skip
      364                   view-as alert-box error .
      365               undo main-block, return error .
      366           end.
      367       end.
      368     if ub.rvs-doc.status_ = 'факт':U
      369     and ub.rvs-doc.rvs-type <> 'проверка':U
      370     then do:
      371       run adm/shattri.p (
      372            input "get":U
      373           ,input ub.rvs-doc.obj-type
      374           ,input ub.rvs-doc.obj-code
      375           ,input 'nakl_par':U
      376           ,input  "date-close-period"
      377           ,output v-value-character
      378           ,output v-date-close-period
      379           ,output v-value-decimal
      380           ,output v-value-integer
      381           ,output v-value-logical
      382           ,output v-value-type
      383           ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      384           ) no-error .
      385       if error-status :error then v-date-close-period = date('').
      386       if v-date-close-period <> date('') then do:
      387           if ub.rvs-doc.fact-date < v-date-close-period
      388           then do:
      389             message  substitute(
      390               "Дата закрытия сверки &1 более ранняя, чем дата закрытия периода &2
      391               Дата закрытия сверки     &3 &2
      392               Дата закрытия периода    &4 &2
      393               Объект &5 &6 "
      394               ,
      395               ub.rvs-doc.rvs-code  ,
      396               chr(10)  ,
      397               string ( ub.rvs-doc.fact-date , "99/99/9999" ) ,
      398               string ( v-date-close-period,   "99/99/9999") ,
      399                         x_obj-group.obj-type ,
      400                         x_obj-group.obj-code  ) view-as alert-box information .
      401               return.
      402           end.
      403       end.
      404     end.
      405     for each ub.doc-attr exclusive-lock
      406       where ub.doc-attr.doc-code = ub.rvs-doc.rvs-code
      407     on error undo Main-Block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      408     :
      409       delete ub.doc-attr.
      410     end.
      411     for each ub.rvs-line exclusive-lock
      412       where ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code
      413     on error undo Main-Block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      414     :
      415       delete ub.rvs-line.
      416     end.
      417     for each ub.rvs-line-pump exclusive-lock
      418       where ub.rvs-line-pump.rvs-code = ub.rvs-doc.rvs-code
      419     on error undo Main-Block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      420     :
      421       delete ub.rvs-line-pump.
      422     end.
      423     if ub.rvs-doc.rvs-type <> 'проверка':U
      424     then do :
      425       define variable v-result as integer no-undo.
      426       if v-mess = "" then v-result = 0.
      427       else v-result = 1 .
      428       for first  ub.clients where ub.clients.obj-type = 'чел':U and  ub.clients.obj-code = ub.rvs-doc.boss no-lock :
      429           v-person = clients.obj-name.
      430       end.
      431       v-vid-action = 60.
      432       v-vid-param =
      433           "Initiator=" + v-initiator + chr(4) +
      434           "ResponsiblePerson=" + (if v-person <> ?  then v-person else "") + chr(4) +
      435           "SHOP_NUM=" + string(rvs-doc.obj-code) + chr(4) +
      436           "DocNum=" + string(rvs-doc.rvs-code) + chr(4) +
      437           "FactDate=" + (if string(rvs-doc.fact-date) = ? then '' else string(rvs-doc.fact-date)) + chr(4) +
      438           "DocType=" + string(rvs-doc.rvs-type) + chr(4) +
      439           "SHIFT_NUM_DOC=" + (if string(rvs-doc.shift-num) = ? then '' else string(rvs-doc.shift-num)) + (if string(rvs-doc.shift-date) = ? then '' else string(rvs-doc.shift-date , "99999999")) + chr(4) +
      440           "SHIFT_NUM=" + (if string(varshift-num) = ? then '' else string(varshift-num)) + (if string(varshift-date) = ? then '' else string(varshift-date, "99999999")) + chr(4) +
      441           "Status=" + string(rvs-doc.status_) + chr(4) +
      442           "RESULT=" + string( v-result ) + chr(4) +
      443           "Description=" + v-mess no-error.
      444       run trg/userlog.p (
      445           input 'delete':U
      446           , input 'rvs-doc':U
      447           , input ( buffer rvs-doc  :handle )
      448           , input v-vid-action
      449           , input v-vid-param
      450           ) no-error.
      451       if error-status :error
      452           then
      453       do:
      454           message substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      455               , chr(10)
      456               , vss-workfile
      457               , return-value
      458               , error-status :get-message ( 1 ) )
      459               view-as alert-box.
      460           return no-apply.
      461       end.
      462     end .
      463     if g#db-num <> 0 then do:
      464       run nws/cmd-del.p
      465         ( input "rvs-doc":U
      466          ,input (buffer ub.rvs-doc:handle)
      467          ,input "":U
      468         ) no-error .
      469       if error-status :error then do:
      470         undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( 1 ) ).
      471       end.
      472     end.
      473     if g#oxml = yes then do:
      474       run str/calloxml.p
      475         ( input 'delete':U
      476          ,input 'rvs-doc':U
      477          ,input ( buffer ub.rvs-doc:handle )
      478         ) no-error.
      479       if error-status :error then do:
      480         undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      481                                       ,chr(10)
      482                                       ,vss-workfile
      483                                       ,return-value
      484                                       ,error-status :get-message ( 1 )
      485                                      ).
      486       end.
      487     end.
      488     if ub.rvs-doc.status_ = 'факт':U
      489     then do:
      490   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      491     (input ?
      492     ,input this-procedure:handle
      493     ,input ?
      494     ,input 'event_rvs-doc':U
      495     ,input  buffer ub.rvs-doc:handle
      496     ,input ?
      497     ,input ''
      498     ,input ''
      499     ) no-error .
      500       if error-status :error
      501         then
      502       do:
      503         return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
      504           , chr(10)
      505           , vss-workfile
      506           , return-value
      507           , error-status :get-message ( 1 ) ).
      508       end.
      509     end.
      510   end.
