      273   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      274   procedure cur-time :
      275      define output parameter p-today as date      no-undo .
      276      define output parameter p-time  as integer   no-undo .
      277     do
      278     on error undo, return error
      279     :
      280       define variable v-date1 as date      no-undo .
      281       define variable v-date2 as date      no-undo .
      282       define variable v-time  as integer   no-undo .
      283       assign
      284         v-date1 = today
      285         v-time  = time
      286         v-date2 = today
      287       .
      288       if v-date1 <> v-date2
      289       then do:
      290         assign
      291           v-date1 = today
      292           v-time  = v-time
      293         .
      294       end.
      295       assign
      296         p-today = v-date1
      297         p-time  = v-time
      298       .
      299     end.
      300   end.
      301   function cur-time-date returns character
      302   :
      303     return string(today, '99/99/9999':U) .
      304   end.
      305   function cur-time-mjd returns decimal
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return integer(v-date) - 2400002 + (v-time / 86400) .
      314   end.
      315   function cur-time-get-ending-index returns integer
      316   (input p-number as integer
      317   )
      318   :
      319     if p-number < 0
      320     or p-number = ?
      321     then do:
      322       return 1 .
      323     end.
      324     define variable v-rest as integer   no-undo .
      325     assign
      326       p-number = p-number modulo 100
      327     .
      328     if p-number < 20
      329     then do:
      330       assign
      331         v-rest = p-number
      332       .
      333     end.
      334     else do:
      335       assign
      336         v-rest = p-number modulo 10
      337       .
      338     end.
      339     case v-rest :
      340       when 1
      341       then do:
      342         return 2 .
      343       end.
      344       when 2 or
      345       when 3 or
      346       when 4
      347       then do:
      348         return 3 .
      349       end.
      350       otherwise do:
      351         return 1 .
      352       end.
      353     end case .
      354   end.
      355   procedure cur-time-mjd-to-date :
      356      define input  parameter i-mjd-diff as decimal no-undo.
      357      define output parameter o-Date     as date    no-undo.
      358      define output parameter o-Time     as integer no-undo.
      359      define variable v-day-number as integer   no-undo .
      360      if    i-mjd-diff < 0
      361         or i-mjd-diff = ?
      362      then do:
      363         return "?" .
      364      end.
      365      assign
      366         v-day-number = truncate(i-mjd-diff,0).
      367         o-Date = date(v-day-number + 2400002).
      368         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      369     .
      370   end.
      371   function cur-time-mjd-to-string returns character
      372   (input p-mjd-diff as decimal
      373   )
      374   :
      375     define variable v-day-number as integer   no-undo .
      376     define variable v-seconds    as integer   no-undo .
      377     define variable v-hour       as integer   no-undo .
      378     define variable v-min        as integer   no-undo .
      379     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      380     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      381     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      382     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      383     if p-mjd-diff < 0
      384     or p-mjd-diff = ?
      385     then do:
      386       return "?" .
      387     end.
      388     assign
      389       v-day-number = integer(truncate(p-mjd-diff,0))
      390       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      391     .
      392     if v-seconds > 86400
      393     then do:
      394       assign
      395         v-seconds = 86400 - 1
      396       .
      397     end.
      398     if v-seconds < 0
      399     then do:
      400       assign
      401         v-seconds = 0
      402       .
      403     end.
      404     assign
      405       v-hour = truncate(v-seconds / 3600, 0)
      406     .
      407     assign
      408       v-seconds = v-seconds modulo 3600
      409     .
      410     assign
      411       v-min = truncate(v-seconds / 60, 0)
      412     .
      413     assign
      414       v-seconds = v-seconds modulo 60
      415     .
      416     return
      417         (if v-day-number <> 0
      418           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      419           else ""
      420         )
      421       + (if v-day-number <> 0 or v-hour <> 0
      422           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      423           else ""
      424         )
      425       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      426           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      427           else ""
      428         )
      429       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      430       .
      431   end.
      432   function cur-time-string returns character
      433   :
      434     define variable v-date as date      no-undo .
      435     define variable v-time as integer   no-undo .
      436     run cur-time in this-procedure
      437       (output v-date
      438       ,output v-time
      439       ) .
      440     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      441   end.
      442   function cur-time-string-sec returns character
      443   :
      444     define variable v-date as date      no-undo .
      445     define variable v-time as integer   no-undo .
      446     run cur-time in this-procedure
      447       (output v-date
      448       ,output v-time
      449       ) .
      450     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      451   end.
      452   function cur-time-custom  returns character
      453   (input p-prefix as character
      454   ,input p-date-format as character
      455   ,input p-delimiter as character
      456   ,input p-time-format as character
      457   ,input p-suffix as character
      458   )
      459   :
      460     define variable v-date as date      no-undo .
      461     define variable v-time as integer   no-undo .
      462     run cur-time in this-procedure
      463       (output v-date
      464       ,output v-time
      465       ) .
      466     return
      467       p-prefix
      468       + string(v-date, p-date-format)
      469       + p-delimiter
      470       + string(v-time, p-time-format)
      471       + p-suffix
      472       .
      473   end.
      474   function cur-time-print  returns character
      475   :
      476     define variable v-date as date      no-undo .
      477     define variable v-time as integer   no-undo .
      478     run cur-time in this-procedure
      479       (output v-date
      480       ,output v-time
      481       ) .
      482     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      483   end.
      484   function cur-time-datetime returns datetime
      485   :
      486     define variable v-char as character no-undo .
      487     define variable v-datetime as datetime no-undo .
      488     v-char = cur-time-string().
      489     v-datetime = datetime(v-char).
      490     return  v-datetime.
      491   end.
      492   function cur-time-string-msec returns character
      493   :
      494     define variable v-date as datetime  no-undo .
      495     v-date = now.
      496     return string(v-date) .
      497   end.
      498   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      499   define new global shared variable g#lib-nws as handle no-undo .
      500   define variable p-news as logical no-undo.
      501   define variable v-date as date no-undo .
      502   define variable v-time as integer no-undo .
      503   define buffer buf_c-gds-host-attr for ub.c-gds-host-attr.
      504   define buffer buf_c-gds-hist for ub.c-gds-hist.
      505   main-block:
      506   do
      507   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      508   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      509   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      510   :
      511     if g#news then do:
      512       define variable v-send as integer no-undo .
      513       v-send = integer('0':U).
      514   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      515   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      516     (input  g#db-num
      517     ,input  'gds-host-attr':U
      518     ,input  0
      519     ,input  '':U
      520     ,input  0
      521     ,input  '':U
      522     ,input  '':U
      523     ,input  '':U
      524     ,input  0
      525     ,input  0
      526     ,input  0
      527     ,input  'nws-to-hist'
      528     ,output v-send
      529     ) no-error .
      530     end.
      531     if not g#news
      532     or v-send >= 0 then do:
      533       run cur-time in this-procedure(output v-date, output v-time).
      534       create buf_c-gds-host-attr.
      535       buffer-copy ub.gds-host-attr to buf_c-gds-host-attr
      536       assign
      537       buf_c-gds-host-attr.chip-num           = next-value (s-gds-chip, ub)
      538       buf_c-gds-host-attr.corr-time          = v-time
      539       buf_c-gds-host-attr.corr-user-db-num   = g#db-num
      540       buf_c-gds-host-attr.corr-user-name     = (if g#news
      541                                         then (chr(4) +  'СПН':U)
      542                                         else (if g#esys
      543                                               then (chr(4) +  'ВС':U)
      544                                               else g#userid)
      545                                         )
      546       buf_c-gds-host-attr.corr-date          = v-date
      547       .
      548       create buf_c-gds-hist.
      549       buffer-copy buf_c-gds-host-attr to buf_c-gds-hist
      550       assign
      551       buf_c-gds-hist.action = integer('99':U)
      552       buf_c-gds-hist.subject = 'gds-host-attr':U
      553       buf_c-gds-hist.is-news = g#news
      554       buf_c-gds-hist.source-type = (if g#news
      555                                     then 'db':U
      556                                     else (if g#esys
      557                                           then 'esys':U
      558                                           else "":U)
      559                                     )
      560       buf_c-gds-hist.source-ref = (if g#news
      561                                     then string(g#news-source-db)
      562                                     else (if g#esys
      563                                           then string(g#esys-source-esys)
      564                                           else "":U)
      565                                     )
      566       .
      567     end.
      568     run gdshattr-news in this-procedure(input ub.gds-host-attr.attr-code,
      569                                         output p-news) no-error.
      570     if p-news then do:
      571       run nws/cmd-del.p
      572         ( input 'gds-host-attr':U
      573          ,input (buffer ub.gds-host-attr:handle)
      574          ,input "":U
      575         ) no-error .
      576       if error-status :error then do:
      577         undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      578       end.
      579      end.
      580       if g#oxml = yes
      581       then do:
      582       run str/calloxml.p (
      583             input 'delete':U
      584           , input 'gds-host-attr':U
      585           , input ( buffer ub.gds-host-attr:handle )
      586       ) no-error.
      587       if error-status :error
      588       then do:
      589           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      590                                , chr(10)
      591                                , vss-workfile
      592                                , return-value
      593                                , error-status :get-message ( 1 ) ).
      594       end.
      595       end.
      596   end.
