        1   block-level on error undo, throw.
        2   trigger procedure for delete of ub.ext-system .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Open XML. Триггер на удаление записи внешней подсистемы".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78       define variable v-chip-num    as integer      no-undo.
       79       define buffer buf_ext-system-attr for ub.ext-system-attr.
       80   main-block:
       81   do
       82   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       83   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       84   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       85   :
       86     for each buf_ext-system-attr where
       87             buf_ext-system-attr.esys-id = ub.ext-system.esys-id
       88         and buf_ext-system-attr.db-num = ub.ext-system.db-num
       89     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       90     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       91     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       92     :
       93       delete buf_Ext-system-attr.
       94     end.
       95     run trg/extsysh.p (
       96           buffer ub.ext-system
       97         , output v-chip-num
       98     ) no-error .
       99     if error-status:error
      100     then do:
      101         message
      102             vss-workfile vss-revision vss-description
      103             skip "Ошибка при создании истории изменения внешней подсистемы"
      104             skip "Внешняя подсистема:"
      105             skip "  номер   " ub.ext-system.esys-id
      106             skip "  БД номер" ub.ext-system.db-num
      107             skip "  имя     " ub.ext-system.esys-name
      108             skip return-value
      109             skip trim(error-status :get-message(1))
      110                   trim(error-status :get-message(2))
      111                   trim(error-status :get-message(3))
      112         view-as alert-box .
      113         undo main-block, return error.
      114     end.
      115     if ub.ext-system.esys-send-news-exp = yes
      116     then do:
      117         run nws/cmd-del.p (
      118               input 'ext-system':U
      119             , input ( buffer ub.ext-system :handle )
      120             , input "":U
      121         ) no-error .
      122         if error-status :error
      123         then do:
      124             undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      125         end.
      126     end.
      127     if g#oxml = yes
      128     then do:
      129       run str/calloxml.p (
      130             input 'delete':U
      131           , input 'ext-system':U
      132           , input ( buffer ub.ext-system:handle )
      133       ) no-error.
      134       if error-status :error
      135       then do:
      136           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      137                                , chr(10)
      138                                , vss-workfile
      139                                , return-value
      140                                , error-status :get-message ( 1 ) ).
      141       end.
      142     end.
      143   end.
