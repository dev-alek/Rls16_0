        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code   as character no-undo .
        3   define input  parameter p-table-name as character no-undo .
        4   define input  parameter p-obj-type   as character no-undo .
        5   define input  parameter p-obj-code   as integer   no-undo .
        6   define input  parameter p-fact-date  as date      no-undo .
        7   define input  parameter p-action     as character no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Создать запись о том, что необходимо пересчитать складской архив по типам приобретения".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32       assign
       33         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6',p-doc-code,p-table-name,p-obj-type,p-obj-code,p-fact-date,p-action)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure cur-time :
       88      define output parameter p-today as date      no-undo .
       89      define output parameter p-time  as integer   no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       define variable v-date1 as date      no-undo .
       94       define variable v-date2 as date      no-undo .
       95       define variable v-time  as integer   no-undo .
       96       assign
       97         v-date1 = today
       98         v-time  = time
       99         v-date2 = today
      100       .
      101       if v-date1 <> v-date2
      102       then do:
      103         assign
      104           v-date1 = today
      105           v-time  = v-time
      106         .
      107       end.
      108       assign
      109         p-today = v-date1
      110         p-time  = v-time
      111       .
      112     end.
      113   end.
      114   function cur-time-date returns character
      115   :
      116     return string(today, '99/99/9999':U) .
      117   end.
      118   function cur-time-mjd returns decimal
      119   :
      120     define variable v-date as date      no-undo .
      121     define variable v-time as integer   no-undo .
      122     run cur-time in this-procedure
      123       (output v-date
      124       ,output v-time
      125       ) .
      126     return integer(v-date) - 2400002 + (v-time / 86400) .
      127   end.
      128   function cur-time-get-ending-index returns integer
      129   (input p-number as integer
      130   )
      131   :
      132     if p-number < 0
      133     or p-number = ?
      134     then do:
      135       return 1 .
      136     end.
      137     define variable v-rest as integer   no-undo .
      138     assign
      139       p-number = p-number modulo 100
      140     .
      141     if p-number < 20
      142     then do:
      143       assign
      144         v-rest = p-number
      145       .
      146     end.
      147     else do:
      148       assign
      149         v-rest = p-number modulo 10
      150       .
      151     end.
      152     case v-rest :
      153       when 1
      154       then do:
      155         return 2 .
      156       end.
      157       when 2 or
      158       when 3 or
      159       when 4
      160       then do:
      161         return 3 .
      162       end.
      163       otherwise do:
      164         return 1 .
      165       end.
      166     end case .
      167   end.
      168   procedure cur-time-mjd-to-date :
      169      define input  parameter i-mjd-diff as decimal no-undo.
      170      define output parameter o-Date     as date    no-undo.
      171      define output parameter o-Time     as integer no-undo.
      172      define variable v-day-number as integer   no-undo .
      173      if    i-mjd-diff < 0
      174         or i-mjd-diff = ?
      175      then do:
      176         return "?" .
      177      end.
      178      assign
      179         v-day-number = truncate(i-mjd-diff,0).
      180         o-Date = date(v-day-number + 2400002).
      181         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      182     .
      183   end.
      184   function cur-time-mjd-to-string returns character
      185   (input p-mjd-diff as decimal
      186   )
      187   :
      188     define variable v-day-number as integer   no-undo .
      189     define variable v-seconds    as integer   no-undo .
      190     define variable v-hour       as integer   no-undo .
      191     define variable v-min        as integer   no-undo .
      192     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      193     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      194     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      195     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      196     if p-mjd-diff < 0
      197     or p-mjd-diff = ?
      198     then do:
      199       return "?" .
      200     end.
      201     assign
      202       v-day-number = integer(truncate(p-mjd-diff,0))
      203       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      204     .
      205     if v-seconds > 86400
      206     then do:
      207       assign
      208         v-seconds = 86400 - 1
      209       .
      210     end.
      211     if v-seconds < 0
      212     then do:
      213       assign
      214         v-seconds = 0
      215       .
      216     end.
      217     assign
      218       v-hour = truncate(v-seconds / 3600, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 3600
      222     .
      223     assign
      224       v-min = truncate(v-seconds / 60, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 60
      228     .
      229     return
      230         (if v-day-number <> 0
      231           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0
      235           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      239           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      240           else ""
      241         )
      242       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      243       .
      244   end.
      245   function cur-time-string returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      254   end.
      255   function cur-time-string-sec returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      264   end.
      265   function cur-time-custom  returns character
      266   (input p-prefix as character
      267   ,input p-date-format as character
      268   ,input p-delimiter as character
      269   ,input p-time-format as character
      270   ,input p-suffix as character
      271   )
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return
      280       p-prefix
      281       + string(v-date, p-date-format)
      282       + p-delimiter
      283       + string(v-time, p-time-format)
      284       + p-suffix
      285       .
      286   end.
      287   function cur-time-print  returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-datetime returns datetime
      298   :
      299     define variable v-char as character no-undo .
      300     define variable v-datetime as datetime no-undo .
      301     v-char = cur-time-string().
      302     v-datetime = datetime(v-char).
      303     return  v-datetime.
      304   end.
      305   function cur-time-string-msec returns character
      306   :
      307     define variable v-date as datetime  no-undo .
      308     v-date = now.
      309     return string(v-date) .
      310   end.
      311   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   define variable v-waitfram-action01         as character   no-undo .
      313   define variable v-waitfram-action02         as character   no-undo .
      314   define variable v-waitfram-action03         as character   no-undo .
      315   define variable mWaitFramTextBeg            as character   no-undo.
      316   define variable mWaitFramTextEnd            as character   no-undo.
      317   define variable mWaitFramView               as logical     no-undo.
      318   define variable mWaitProcEvent              as logical     no-undo init yes.
      319   define variable mWaitFramInterval           as integer     no-undo init 1 .
      320   define variable mWaitFramStop               as logical     no-undo.
      321   define variable mWaitFramStopUser           as logical     no-undo.
      322   define variable mWaitFramStopTimeOut        as logical     no-undo.
      323   define variable mWaitFramStartProc          as datetime-tz no-undo.
      324   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      325   define button B-WaitFramStop auto-end-key
      326        label "Стоп"
      327        size 10 by 1 tooltip "Остоновить процесс".
      328   define button B-viewProcInfo
      329        label "Информация"
      330        size 15 by 1 tooltip "Информация о процесс".
      331   define frame waitfram
      332     v-waitfram-action01 format "x(72)" no-label skip
      333     v-waitfram-action02 format "x(72)" no-label skip
      334     v-waitfram-action03 format "x(72)" no-label skip
      335     B-viewProcInfo
      336     B-WaitFramStop at row 4 col 30
      337     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      338     .
      339   define new global shared variable mBatchMode as logical no-undo init ?.
      340   define variable mFramBachModHandle as handle no-undo.
      341   mFramBachModHandle = frame waitfram:handle.
      342   define variable mFameOldVis as logical no-undo.
      343   define variable mVisCUrentVin as logical no-undo.
      344   if session:batch-mode
      345   then
      346      mBatchMode = yes.
      347   if mBatchMode = ? then do:
      348     mVisCUrentVin = current-window:visible.
      349     mFameOldVis = mFramBachModHandle:visible.
      350     mFramBachModHandle:visible  = yes.
      351     mBatchMode = mFramBachModHandle:visible ne yes.
      352     mFramBachModHandle:visible = mFameOldVis.
      353     current-window:visible = mVisCUrentVin.
      354   end.
      355    if  log-manager:logfile-name ne ?
      356     then DO:
      357         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      358         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      359         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      360     end.
      361   on choose of B-WaitFramStop in frame waitfram
      362   do:
      363     mWaitFramStop = yes.
      364     mWaitFramStopUser = yes.
      365   end.
      366   function waitfram-check-timeout returns logical():
      367      define variable vtime as int64 no-undo.
      368      if mWaitFramStopTimeOut
      369      then
      370         return yes.
      371      vtime = ( now - mWaitFramStartProc ) / 1000 .
      372      if     mWaitFramTimeOut ne ?
      373         and mWaitFramTimeOut ne 0
      374         and mWaitFramTimeOut lt vtime
      375      then do:
      376         mWaitFramStopTimeOut = yes.
      377      end.
      378      return mWaitFramStopTimeOut.
      379   end.
      380   procedure waitfram-hide :
      381     if not session:batch-mode
      382     then do
      383     on error undo, return error return-value
      384     :
      385       pause 0 before-hide .
      386       if not mBatchMode then
      387         hide frame waitfram .
      388     if     not mWaitFramView
      389        and mWaitProcEvent
      390     then
      391       process events .
      392     end.
      393   end procedure.
      394   procedure waitfram-show :
      395     define input  parameter p-message as character no-undo .
      396     define variable v-left-margin as integer   no-undo .
      397     if not session:batch-mode
      398     then do
      399     on error undo, return error return-value
      400     :
      401       if length(p-message) <= 70 then do:
      402         assign
      403           v-left-margin = integer((70 - length(p-message)) / 2)
      404         .
      405         assign
      406           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      407         .
      408         assign
      409           v-waitfram-action01 = " "
      410           v-waitfram-action02 = " "
      411                                    + fill(" ", v-left-margin)
      412                                    + p-message
      413           v-waitfram-action03 = " "
      414         .
      415       end.
      416       else do:
      417         define variable vRindex1 as integer no-undo.
      418         define variable vRindex2 as integer no-undo.
      419         vRindex1 = r-index(p-message," ",70).
      420         if vRindex1 = 0
      421         then
      422            vRindex1 = 70.
      423         if length(p-message)  <= vRindex1 + 70 then do:
      424           assign
      425             v-waitfram-action01 = " "
      426             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      427             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      428           .
      429         end.
      430         else do:
      431           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      432           if vRindex2 <= vRindex1
      433           then
      434              vRindex2 = vRindex1 + 70.
      435           assign
      436             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      437             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      438             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      439           .
      440         end.
      441       end.
      442       B-viewProcInfo:visible   in frame waitfram = no.
      443       B-viewProcInfo:sensitive in frame waitfram = no.
      444       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      445       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      446       if  (   mWaitFramView
      447          or  mWaitProcEvent)
      448          and not mBatchMode
      449       then
      450          display
      451             v-waitfram-action01 skip
      452             v-waitfram-action02 skip
      453             v-waitfram-action03 skip
      454          with frame waitfram .
      455       if     mWaitFramView
      456          then do:
      457             if     mWaitFramInterval ne ?
      458                and not mBatchMode
      459             then
      460                wait-for go of frame waitfram pause mWaitFramInterval.
      461          end.
      462          else
      463             if     mWaitProcEvent
      464                and not mBatchMode
      465             then
      466                process events .
      467     end.
      468   end procedure.
      469      procedure waitfram-show-this:
      470         define input  parameter iInterval as int64 no-undo.
      471         define variable vtime as int64 no-undo.
      472         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      473         mWaitFramInterval = iInterval.
      474         run waitfram-show (substitute("&1&2 &3&4" ,
      475                                       mWaitFramTextBeg ,
      476                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      477                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      478                                       mWaitFramTextEnd
      479                                      )
      480                           ).
      481      end.
      482      procedure WaitFramRunPause:
      483         define input  parameter iInterval as dec no-undo.
      484         define variable vStart  as datetime-tz no-undo.
      485         define variable vend    as datetime-tz no-undo.
      486         define variable vint as int64 no-undo.
      487         define variable vOk as logical no-undo.
      488         vStart = now.
      489         vend   = vStart.
      490         publish "WaitFramPause" (iInterval,output vOk).
      491         vend   =  now.
      492         vint = vend - vStart.
      493         vint = iInterval - vint / 1000.
      494         if     not mWaitFramStop
      495            and (   vint > 0
      496                 or (    not vOk
      497                     and iInterval eq ?
      498                     )
      499                 )
      500         then
      501            run waitfram-show-this (iInterval).
      502         vend   =  now.
      503         vint = vend - vStart.
      504         vint = iInterval - vint / 1000.
      505         if     not mWaitFramStop
      506            and vint > 0
      507         then do:
      508            run gbl/pause.p (vint * 1000).
      509         end.
      510         if iInterval ne ?
      511         then
      512            publish "WaitFramStop".
      513         waitfram-check-timeout().
      514      end.
      515      procedure WaitFramWaitFor:
      516         define input  parameter iInterval as dec no-undo.
      517         assign
      518            mWaitFramStartProc   = now
      519            mWaitFramStopUser    = no
      520            mWaitFramStopTimeOut = no
      521         .
      522         block-wait:
      523         do while not mWaitFramStop:
      524            run WaitFramRunPause (iInterval).
      525            if  waitfram-check-timeout()
      526            then do:
      527               leave block-wait.
      528            end.
      529         end.
      530         run waitfram-hide.
      531      end.
      532   procedure waitfram-join :
      533     define input  parameter p-line-1  as character no-undo .
      534     define input  parameter p-line-2  as character no-undo .
      535     define input  parameter p-line-3  as character no-undo .
      536     define output parameter p-message as character no-undo .
      537     do
      538     on error undo, return error return-value
      539     :
      540       assign
      541         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      542                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      543                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      544       .
      545     end.
      546   end procedure.
      547   function waitfram-join-function returns character
      548     (input p-line-1 as character
      549     ,input p-line-2 as character
      550     ,input p-line-3 as character
      551     ).
      552     define variable v-message as character no-undo .
      553     run waitfram-join in this-procedure
      554       (input  p-line-1
      555       ,input  p-line-2
      556       ,input  p-line-3
      557       ,output v-message
      558       ) .
      559     return v-message .
      560   end function .
      561   do
      562   on error undo, return error return-value
      563   :
      564     if lookup( p-table-name, 'trn-doc':U + chr(44) + 'price-doc':U ) = 0 then do:
      565       message
      566         vss-workfile vss-revision vss-description skip
      567         "Неизвестная таблица" skip
      568         "Документ" p-doc-code skip
      569         "Таблица" p-table-name skip
      570         "Действие" p-action skip
      571         view-as alert-box error .
      572       undo, return error .
      573     end.
      574     if p-action = ?
      575     or lookup(p-action, 'doc-delete':u + chr(44) + 'doc-change':u) = 0
      576     then do:
      577       message
      578         vss-workfile vss-revision vss-description skip
      579         "Ошибка задания входных параметров" skip
      580         "Неизвестное действие" skip
      581         "Документ" p-doc-code skip
      582         "Таблица" p-table-name skip
      583         "Действие" p-action skip
      584         view-as alert-box error .
      585       undo, return error return-value .
      586     end.
      587     define variable v-need-stop-aht as logical   no-undo .
      588     assign
      589       v-need-stop-aht = false
      590     .
      591     define buffer calc-aht-lock_batchprocess for ub.batchprocess .
      592     run gbl/lock-prc.p
      593       (input 'ahtb':U
      594       ,input p-obj-code
      595       ,input 0
      596       ,input 0
      597       ,input p-obj-type
      598       ,input ""
      599       ,input ""
      600       ,input "Объект,,, ,,,Расчет складского архива по типам приобретения"
      601       ,input true
      602       ,buffer calc-aht-lock_batchprocess
      603       ) no-error .
      604     if error-status :error
      605     then do:
      606       if error-status :get-message(1) <> ""
      607       then do:
      608         message
      609           vss-workfile vss-revision vss-description skip
      610           "Ошибка при вызове процедуры блокировки расчета складского архива по типам приобретения" skip
      611           error-status :get-message(1) skip
      612           return-value skip
      613           view-as alert-box error .
      614         undo, return error "Ошибка при вызове процедуры блокировки расчёта архива по типам приобретения" .
      615       end.
      616       assign
      617         v-need-stop-aht = true
      618       .
      619     end.
      620     define buffer stop-aht-news-lock_btpr for batchprocess .
      621     if v-need-stop-aht = true
      622     then do:
      623       do transaction
      624       on error undo, return error return-value
      625       :
      626         create stop-aht-news-lock_btpr .
      627         assign
      628           stop-aht-news-lock_btpr.bp_type       = 'lock':U + 'rstn':U
      629           stop-aht-news-lock_btpr.bp_status     = 'N':U
      630           stop-aht-news-lock_btpr.Key#_One      = p-obj-code
      631           stop-aht-news-lock_btpr.Key#_Two      = 0
      632           stop-aht-news-lock_btpr.Key#_Three    = 0
      633           stop-aht-news-lock_btpr.CharKey_One   = p-obj-type
      634           stop-aht-news-lock_btpr.CharKey_Two   = p-doc-code
      635           stop-aht-news-lock_btpr.CharKey_Three = ""
      636         .
      637         define variable v-start-lock-time   as int64     no-undo .
      638         define variable v-start-lock-second as integer   no-undo .
      639         assign
      640           v-start-lock-time = etime
      641         .
      642         wait_block:
      643         do while true
      644         :
      645           assign
      646             v-start-lock-second = integer((etime - v-start-lock-time) / 1000)
      647           .
      648           run waitfram-show in this-procedure
      649             (input waitfram-join-function("Архив по типам приобретения рассчитывается на другой машине"
      650                                           ,"Отправлено сообщение о необходимости остановки расчёта складского архива по типам приобретения"
      651                                           ,substitute("Ожидание освобождение ресурса расчёта складского архива &1", string(v-start-lock-second, 'HH:MM:SS':U))
      652                                           )
      653             ) .
      654           run gbl/lock-prc.p
      655             (input 'ahtb':U
      656             ,input p-obj-code
      657             ,input 0
      658             ,input 0
      659             ,input p-obj-type
      660             ,input ""
      661             ,input ""
      662             ,input "Объект,,, ,,,Расчет складского архива по типам приобретения"
      663             ,input true
      664             ,buffer calc-aht-lock_batchprocess
      665             ) no-error .
      666           if error-status :error
      667           then do:
      668             if error-status :get-message(1) <> ""
      669             then do:
      670               message
      671                 vss-workfile vss-revision vss-description skip
      672                 "Ошибка при вызове процедуры блокировки расчета складского архива по типам приобретения" skip
      673                 error-status :get-message(1) skip
      674                 return-value skip
      675                 view-as alert-box error .
      676               undo, return error "В данный момент рассчитывается складской архив по типам приобретения" .
      677             end.
      678           end.
      679           else do:
      680             leave wait_block .
      681           end.
      682           pause 1 no-message .
      683         end.
      684         delete stop-aht-news-lock_btpr .
      685         run waitfram-hide in this-procedure .
      686       end.
      687     end.
      688     do transaction
      689     on error undo, return error return-value
      690     :
      691     find first ub.batchprocess exclusive-lock
      692       where ub.batchprocess.bp_type   = 'aht':U
      693         and ub.batchprocess.bp_status = 'N':U
      694         and  ub.batchprocess.key#_one  = p-obj-code
      695         and ub.batchprocess.charkey_one = p-doc-code
      696         and ub.batchprocess.charkey_two = p-table-name
      697         and ub.batchprocess.charkey_three = p-obj-type
      698     no-error .
      699       if available ub.batchprocess then do:
      700         if p-action = 'doc-delete':u
      701         then do:
      702           delete ub.batchprocess .
      703         end.
      704       end.
      705       else do:
      706         run trg/markaht.p
      707           (input p-obj-type
      708           ,input p-obj-code
      709           ,input p-fact-date
      710           ,input p-doc-code
      711           ) no-error .
      712         if error-status :error then do:
      713           message
      714             vss-workfile vss-revision vss-description skip
      715             "Ошибка при вызове процедуры markaht.p" skip
      716             "Объект" p-obj-type p-obj-code skip
      717             "Дата" p-fact-date skip
      718             view-as alert-box error .
      719           undo, return error .
      720         end.
      721       end.
      722     end.
      723   end.
