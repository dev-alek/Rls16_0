        1   block-level on error undo, throw.
        2   trigger procedure for write of ub.utd
        3     new buffer new-utd
        4     old buffer old-utd
        5   .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Триггер на изменение таблицы abc-analysis-doc-attr".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure gen-key-rec :
      308     define input  parameter p-tbl-name    as character no-undo.
      309     define input  parameter p-bh_tbl-name as handle    no-undo.
      310     define output parameter p-key-rec     as character no-undo.
      311     do
      312     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      313     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      314     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      315     :
      316       define variable fh               as handle    no-undo .
      317       define variable v-ok             as logical   no-undo .
      318       define variable v-inform         as character no-undo .
      319       define variable v-ind            as integer   no-undo .
      320       define variable v-idx-field-qnty as integer   no-undo .
      321       if p-tbl-name = ?
      322         or p-tbl-name = "":U
      323       then do:
      324         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      325       end.
      326       if not p-bh_tbl-name:available then do:
      327         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      328       end.
      329       assign
      330         p-key-rec = p-tbl-name
      331         v-inform  = p-bh_tbl-name:index-information(1)
      332         v-ind     = 2
      333       .
      334       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      335       on error undo, return error
      336       :
      337         assign
      338           v-inform = p-bh_tbl-name:index-information( v-ind )
      339           v-ind    = v-ind + 1
      340         .
      341       end.
      342       if v-inform = ?
      343         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      344         or entry( 3, v-inform, ",":U ) <> "1":U
      345       then do:
      346         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      347       end.
      348       else do:
      349         assign
      350           v-idx-field-qnty = num-entries( v-inform ) - 4
      351         .
      352         if v-idx-field-qnty < 2 then do:
      353           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      354         end.
      355         do v-ind = 1 to v-idx-field-qnty by 2
      356         on error undo, return error
      357         :
      358           assign
      359             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      360             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      361           .
      362         end.
      363       end.
      364       if p-key-rec = ? then do:
      365         assign
      366           p-key-rec = "":U
      367         .
      368         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      369       end.
      370     end.
      371     return.
      372   end procedure.
      373   procedure gen-where-keyr-tab :
      374     define input  parameter i-tableSerach as character no-undo.
      375     define input  parameter i-tablekey   as character  no-undo.
      376     define input  parameter p-key-rec    as character  no-undo.
      377     define input  parameter p-key-handle as handle     no-undo .
      378     define input  parameter p-db-name    as character  no-undo .
      379     define input  parameter p-tt-handle  as handle     no-undo .
      380     define output parameter o-Where      as character  no-undo.
      381     do
      382     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      383     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      384     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      385     :
      386       define variable v-full-tbl-name  as character no-undo .
      387       define variable bh_tbl-name      as handle    no-undo .
      388       define variable fh_key           as handle    no-undo .
      389       define variable fh_search        as handle    no-undo .
      390       define variable v-field-num      as integer   no-undo .
      391       define variable v-count-fld      as integer   no-undo .
      392       define variable v-inform         as character no-undo .
      393       define variable v-ind            as integer   no-undo .
      394       define variable v-idx-field-qnty as integer   no-undo .
      395       define variable v-field-name     as character no-undo .
      396       define variable v-field-val      as character no-undo .
      397       define variable v-word-link      as character no-undo .
      398       define variable vTable           as character no-undo.
      399       define variable bh_tbl-key       as handle    no-undo .
      400       assign
      401         p-key-rec = trim( p-key-rec )
      402       .
      403       if p-key-handle <> ? then do:
      404         if not valid-handle(p-key-handle)
      405            or p-key-handle:type <> "buffer"
      406         then do:
      407           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      408         end.
      409         if num-entries( p-key-rec, chr(3) ) > 1
      410           or p-key-rec = ?
      411           or p-key-rec = "":U
      412         then do:
      413           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      414         end.
      415       end.
      416       else do:
      417         if p-key-rec = ?
      418           or p-key-rec = "":U
      419         then do:
      420           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      421         end.
      422       end.
      423       assign
      424         vTable = entry( 1 , p-key-rec, chr(3) )
      425       .
      426       if p-tt-handle <> ?
      427         and ( not valid-handle(p-tt-handle)
      428               or p-tt-handle:type <> "buffer"
      429             )
      430       then do:
      431         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      432       end.
      433       if p-tt-handle = ? then do:
      434         assign
      435           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      436         .
      437         create buffer bh_tbl-name for table v-full-tbl-name .
      438       end.
      439       else do:
      440         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      441       end.
      442       assign
      443         v-inform = bh_tbl-name:index-information(1)
      444         v-ind    = 2
      445       .
      446       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      447       on error undo, return error
      448       :
      449         assign
      450           v-inform = bh_tbl-name:index-information( v-ind )
      451           v-ind    = v-ind + 1
      452         .
      453       end.
      454       if v-inform = ?
      455         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      456         or entry( 3, v-inform, ",":U ) <> "1":U
      457       then do:
      458         delete object bh_tbl-name no-error.
      459         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      460       end.
      461       assign
      462         v-idx-field-qnty = num-entries( v-inform ) - 4
      463       .
      464       if v-idx-field-qnty < 2 then do:
      465         delete object bh_tbl-name no-error.
      466         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      467       end.
      468       assign
      469         o-where     = "where":U
      470         v-word-link = "":U
      471         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      472         v-count-fld = 0
      473       .
      474       if i-tablekey ne "" and i-tablekey ne ?
      475       then do:
      476         assign
      477           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      478         .
      479         create buffer bh_tbl-key for table v-full-tbl-name .
      480       end.
      481       if i-tableSerach ne "" and i-tableSerach ne ?
      482       then do:
      483         delete object bh_tbl-name no-error.
      484         assign
      485           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      486         .
      487         create buffer bh_tbl-name for table v-full-tbl-name .
      488       end.
      489       block_where:
      490       do v-ind = 1 to v-idx-field-qnty by 2
      491       on error undo, return error
      492       :
      493         assign
      494           v-count-fld = v-count-fld + 1
      495         .
      496         if p-key-handle = ?
      497           and v-count-fld > v-field-num
      498         then do:
      499           leave block_where.
      500         end.
      501         define variable VfieldKeyTable as handle no-undo.
      502         assign
      503           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      504           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      505         .
      506         if     bh_tbl-key ne ?
      507         then do:
      508            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      509            if VfieldKeyTable eq ?
      510            then next block_where.
      511         end.
      512         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      513         then
      514            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      515         else
      516            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      517         if p-key-handle = ? then do:
      518           assign
      519             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      520           .
      521         end.
      522         else do:
      523           assign
      524             fh_key = p-key-handle:buffer-field( v-field-name )
      525           .
      526           if fh_key = ?
      527             or not valid-handle( fh_key )
      528           then do:
      529             delete object bh_tbl-name.
      530             if     bh_tbl-key ne ?
      531             then
      532                delete object bh_tbl-key.
      533             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      534           end.
      535           assign
      536             v-field-val = fh_key:buffer-value
      537           .
      538         end.
      539         if fh_search:data-type ="character":U then do:
      540           assign
      541             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      542             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      543             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      544             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      545             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      546             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      547             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      548             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      549             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      550             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      551             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      552             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      553             v-field-val = substitute( '"&1"', v-field-val )
      554           .
      555         end.
      556         assign
      557           o-where = substitute( "&1 &2", o-where, v-field-val )
      558         .
      559         if v-word-link = "":U then do:
      560           assign
      561             v-word-link = "and":U
      562           .
      563         end.
      564       end.
      565       delete object bh_tbl-name.
      566       if     bh_tbl-key ne ?
      567       then
      568          delete object bh_tbl-key.
      569       if p-key-handle = ?
      570         and v-count-fld <> v-field-num
      571       then do:
      572         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      573       end.
      574     end.
      575   end procedure.
      576   procedure gen-hn-keyr-tab :
      577     define input  parameter i-tableSerach as character no-undo.
      578     define input  parameter i-tablekey   as character no-undo.
      579     define input  parameter p-key-rec    as character no-undo.
      580     define input  parameter p-key-handle as handle    no-undo .
      581     define input  parameter p-db-name    as character no-undo .
      582     define input  parameter p-tt-handle  as handle    no-undo .
      583     define input  parameter p-stts-lock  as integer   no-undo .
      584     define output parameter o-hn         as handle    no-undo.
      585     define variable v-full-tbl-name as character no-undo.
      586     define variable v-where         as character no-undo.
      587     define variable bh_tbl-name     as handle    no-undo.
      588     define variable vTable          as character no-undo.
      589     do
      590     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      591     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      592     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      593         run gen-where-keyr-tab(i-tableSerach,
      594                                i-tablekey,
      595                                p-key-rec,
      596                                p-key-handle,
      597                                p-db-name,
      598                                p-tt-handle,
      599                                output v-where).
      600         if i-tableSerach ne "" and i-tableSerach ne ?
      601         then do:
      602            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      603            create buffer bh_tbl-name for table v-full-tbl-name .
      604         end.
      605         else do:
      606            if p-tt-handle = ? then do:
      607               assign
      608                  vTable = entry( 1 , p-key-rec, chr(3) )
      609               .
      610               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      611               create buffer bh_tbl-name for table v-full-tbl-name .
      612            end.
      613            else do:
      614               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      615            end.
      616         end.
      617         if p-tt-handle = ? then do:
      618            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      619         end.
      620         else do:
      621            bh_tbl-name:find-first( v-where ) no-error .
      622         end.
      623         o-hn = bh_tbl-name.
      624      end.
      625   end procedure.
      626   procedure gen-hn-keyr :
      627     define input  parameter p-key-rec    as character no-undo.
      628     define input  parameter p-key-handle as handle    no-undo .
      629     define input  parameter p-db-name    as character no-undo .
      630     define input  parameter p-tt-handle  as handle    no-undo .
      631     define input  parameter p-stts-lock  as integer   no-undo .
      632     define output parameter o-hn         as handle    no-undo.
      633     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      634   end.
      635   procedure gen-row-keyr :
      636     define input  parameter p-key-rec    as character no-undo.
      637     define input  parameter p-key-handle as handle    no-undo .
      638     define input  parameter p-db-name    as character no-undo .
      639     define input  parameter p-tt-handle  as handle    no-undo .
      640     define input  parameter p-stts-lock  as integer   no-undo .
      641     define output parameter p-tbl-row    as rowid     no-undo.
      642     define output parameter p-tbl-name   as character no-undo.
      643     define variable vHn as handle no-undo.
      644       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      645       p-tbl-row = if vHn:available then vHn:rowid else ?.
      646       p-tbl-name =  vHn:table.
      647       delete object vHn no-error.
      648     if p-tbl-row = ? then do:
      649       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      650     end.
      651     else do:
      652       return.
      653     end.
      654   end procedure.
      655   procedure gen-key-fv :
      656     define input  parameter p-key-rec    as character no-undo .
      657     define output parameter p-field-list as character no-undo .
      658     define output parameter p-value-list as character no-undo.
      659     do
      660     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      661     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      662     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      663     :
      664       define variable v-full-tbl-name  as character no-undo .
      665       define variable bh_tbl-name      as handle    no-undo .
      666       define variable v-tbl-name       as character no-undo .
      667       define variable v-field-num      as integer   no-undo .
      668       define variable v-count-fld      as integer   no-undo .
      669       define variable v-inform         as character no-undo .
      670       define variable v-ind            as integer   no-undo .
      671       define variable v-idx-field-qnty as integer   no-undo .
      672       define variable v-delim-key      as character no-undo .
      673       if p-key-rec = ?
      674         or p-key-rec = "":U
      675       then do:
      676         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      677       end.
      678       assign
      679         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      680         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      681       .
      682       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      683       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      684       assign
      685         v-inform = bh_tbl-name:index-information(1)
      686         v-ind    = 2
      687       .
      688       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      689       on error undo, return error
      690       :
      691         assign
      692           v-inform = bh_tbl-name:index-information( v-ind )
      693           v-ind    = v-ind + 1
      694         .
      695       end.
      696       if v-inform = ?
      697         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      698         or entry( 3, v-inform, ",":U ) <> "1":U
      699       then do:
      700         delete object bh_tbl-name no-error.
      701         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      702       end.
      703       assign
      704         v-idx-field-qnty = num-entries( v-inform ) - 4
      705       .
      706       if v-idx-field-qnty < 2 then do:
      707         delete object bh_tbl-name no-error.
      708         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      709       end.
      710       assign
      711         p-field-list = "":U
      712         p-value-list = "":U
      713         v-delim-key  = "":U
      714         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      715         v-count-fld  = 0
      716       .
      717       block_where:
      718       do v-ind = 1 to v-idx-field-qnty by 2
      719       on error undo, return error
      720       :
      721         assign
      722           v-count-fld = v-count-fld + 1
      723         .
      724         if v-count-fld > v-field-num then do:
      725           leave block_where.
      726         end.
      727         assign
      728           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      729           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      730         .
      731         if v-ind = 1 then do:
      732           assign
      733             v-delim-key = chr(3)
      734           .
      735         end.
      736       end.
      737       delete object bh_tbl-name.
      738       if v-count-fld <> v-field-num then do:
      739         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      740       end.
      741     end.
      742   end procedure.
      743   procedure gen-key-field :
      744     define input  parameter p-table      as character no-undo .
      745     define output parameter p-field-list as character no-undo .
      746     do
      747     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      748     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      749     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      750     :
      751       define variable v-full-tbl-name  as character no-undo .
      752       define variable bh_tbl-name      as handle    no-undo .
      753       define variable v-tbl-name       as character no-undo .
      754       define variable v-field-num      as integer   no-undo .
      755       define variable v-count-fld      as integer   no-undo .
      756       define variable v-inform         as character no-undo .
      757       define variable v-ind            as integer   no-undo .
      758       define variable v-idx-field-qnty as integer   no-undo .
      759       define variable v-delim-key      as character no-undo .
      760       if p-table = ?
      761         or p-table = "":U
      762       then do:
      763         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      764       end.
      765       assign
      766         v-tbl-name      = p-table
      767         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      768       .
      769       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      770       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      771       assign
      772         v-inform = bh_tbl-name:index-information(1)
      773         v-ind    = 2
      774       .
      775       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      776       on error undo, return error
      777       :
      778         assign
      779           v-inform = bh_tbl-name:index-information( v-ind )
      780           v-ind    = v-ind + 1
      781         .
      782       end.
      783       if v-inform = ?
      784         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      785         or entry( 3, v-inform, ",":U ) <> "1":U
      786       then do:
      787         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      788       end.
      789       assign
      790         v-idx-field-qnty = num-entries( v-inform ) - 4
      791       .
      792       if v-idx-field-qnty < 2 then do:
      793         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      794       end.
      795       assign
      796         p-field-list = "":U
      797         v-delim-key  = "":U
      798         v-count-fld  = 0
      799       .
      800       block_where:
      801       do v-ind = 1 to v-idx-field-qnty by 2
      802       on error undo, return error
      803       :
      804         assign
      805           v-count-fld = v-count-fld + 1
      806         .
      807         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      808         if v-ind = 1 then do:
      809           assign
      810             v-delim-key = chr(3)
      811           .
      812         end.
      813       end.
      814       delete object bh_tbl-name.
      815     end.
      816   end procedure.
      817   define buffer buf_c-utd  for ub.c-utd .
      818   define variable v-date      as date      no-undo .
      819   define variable v-time      as integer   no-undo .
      820   define variable v-field-chg as character no-undo .
      821   define variable v-Seq       as int64     no-undo init ?.
      822   define variable vFlagseq    as logical no-undo.
      823   define variable vuniq-key-rec as character no-undo.
      824   define variable v-rowid as rowid no-undo.
      825   define variable v-tbl-name as character no-undo.
      826   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      827   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      828   def var utdTHSts as class ibs.th.str.utd.sts.th no-undo.
      829   def var utdEDISts as class ibs.th.str.utd.sts.edi no-undo.
      830   define variable volddb-num as integer no-undo.
      831   define variable volddoc-id as integer no-undo.
      832   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      834   define new global shared variable g#attr-lib  as handle no-undo .
      835   define variable v-attr-lib-variable as handle no-undo .
      836   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      837   function getattrUtdex returns char
      838   (idb-num   as integer,
      839    idoc-id   as integer,
      840    iattrcode as character,
      841    iExValue  as character  ):
      842      define buffer utd-attr for utd-attr.
      843      find first utd-attr where utd-attr.db-num eq idb-num
      844                            and utd-attr.doc-id eq idoc-id
      845                            and utd-attr.attr-code eq iattrcode
      846      no-lock no-error.
      847      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      848   end.
      849   function getattrUtd returns char
      850   (idb-num   as integer,
      851    idoc-id   as integer,
      852    iattrcode as character ):
      853     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      854   end.
      855   function setattrUtd returns logical
      856   (idb-num   as integer,
      857    idoc-id   as integer,
      858    iattrcode as character,
      859    iattrval  as character ):
      860      define buffer utd-attr for utd-attr.
      861      find first utd-attr where utd-attr.db-num eq idb-num
      862                            and utd-attr.doc-id eq idoc-id
      863                            and utd-attr.attr-code eq iattrcode
      864      no-lock no-error.
      865      if not available utd-attr
      866      then do:
      867         create utd-attr.
      868         assign
      869            utd-attr.db-num    = idb-num
      870            utd-attr.doc-id    = idoc-id
      871            utd-attr.attr-code = iattrcode
      872            utd-attr.attr-value = iattrval
      873         .
      874      end.
      875      else do:
      876         if utd-attr.attr-value ne iattrval
      877         then do:
      878            find current utd-attr exclusive-lock no-error.
      879            if available utd-attr
      880            then
      881               utd-attr.attr-value = iattrval.
      882         end.
      883      end.
      884      release utd-attr.
      885   end.
      886   function GetAttrUtdlinesEx returns char
      887   (idb-num   as integer,
      888    idoc-id   as integer,
      889    ilinenum  as integer,
      890    iattrcode as character,
      891    iExValue  as character  ):
      892      define buffer utd-lines-attr for utd-lines-attr.
      893      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      894                                  and utd-lines-attr.doc-id    eq idoc-id
      895                                  and utd-lines-attr.lineNum   eq ilineNum
      896                                  and utd-lines-attr.attr-code eq iattrcode
      897      no-lock no-error.
      898      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      899   end.
      900   function GetAttrUtdlines returns char
      901   (idb-num   as integer,
      902    idoc-id   as integer,
      903    ilinenum  as integer,
      904    iattrcode as character ):
      905      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      906   end.
      907   function setattrUtdlines returns logical
      908   (idb-num   as integer,
      909    idoc-id   as integer,
      910    ilinenum  as integer,
      911    iattrcode as character,
      912    iattrval  as character ):
      913      define buffer utd-lines-attr for utd-lines-attr.
      914      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      915                                  and utd-lines-attr.doc-id    eq idoc-id
      916                                  and utd-lines-attr.lineNum   eq ilineNum
      917                                  and utd-lines-attr.attr-code eq iattrcode
      918      no-lock no-error.
      919      if not available utd-lines-attr
      920      then do:
      921         if iattrval ne ?
      922            and iattrval ne ""
      923         then do:
      924            create utd-lines-attr.
      925            assign
      926               utd-lines-attr.db-num    = idb-num
      927               utd-lines-attr.doc-id    = idoc-id
      928               utd-lines-attr.lineNum   = ilineNum
      929               utd-lines-attr.attr-code = iattrcode
      930               utd-lines-attr.attr-value = iattrval
      931            .
      932         end.
      933      end.
      934      else do:
      935         if utd-lines-attr.attr-value ne iattrval
      936         then do:
      937            find current utd-lines-attr exclusive-lock no-error.
      938            if available utd-lines-attr
      939            then do:
      940               if    iattrval eq ?
      941                  or iattrval eq ""
      942               then do:
      943                  delete utd-lines-attr.
      944               end.
      945               else do:
      946                  utd-lines-attr.attr-value = iattrval.
      947               end.
      948            end.
      949         end.
      950      end.
      951      release utd-lines-attr.
      952   end.
      953   function GetAttrUtdMarkingLinesEx returns char
      954   (idb-num   as integer,
      955    idoc-id   as integer,
      956    ilinenum  as integer,
      957    imark     as character,
      958    iattrcode as character,
      959    iExValue  as character  ):
      960      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      961      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      962                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      963                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      964                                          and utd-marking-lines-attr.mark      eq imark
      965                                          and utd-marking-lines-attr.attr-code eq iattrcode
      966      no-lock no-error.
      967      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      968   end.
      969   function GetAttrUtdMarkingLines returns char
      970   (idb-num   as integer,
      971    idoc-id   as integer,
      972    ilinenum  as integer,
      973    imark     as character,
      974    iattrcode as character ):
      975      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      976   end.
      977   function setattrUtdMarkingLines returns logical
      978   (idb-num   as integer,
      979    idoc-id   as integer,
      980    ilinenum  as integer,
      981    imark     as character,
      982    iattrcode as character,
      983    iattrval  as character ):
      984      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      985      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      986                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      987                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      988                                          and utd-marking-lines-attr.mark      eq imark
      989                                          and utd-marking-lines-attr.attr-code eq iattrcode
      990      no-lock no-error.
      991      if not available utd-marking-lines-attr
      992      then do:
      993         if iattrval ne ?
      994            and iattrval ne ""
      995         then do:
      996            create utd-marking-lines-attr.
      997            assign
      998               utd-marking-lines-attr.db-num     = idb-num
      999               utd-marking-lines-attr.doc-id     = idoc-id
     1000               utd-marking-lines-attr.lineNum    = ilineNum
     1001               utd-marking-lines-attr.mark       = imark
     1002               utd-marking-lines-attr.attr-code  = iattrcode
     1003               utd-marking-lines-attr.attr-value = iattrval
     1004            .
     1005         end.
     1006      end.
     1007      else do:
     1008         if utd-marking-lines-attr.attr-value ne iattrval
     1009         then do:
     1010            find current utd-marking-lines-attr exclusive-lock no-error.
     1011            if available utd-marking-lines-attr
     1012            then do:
     1013               if    iattrval eq ?
     1014                  or iattrval eq ""
     1015               then do:
     1016                  delete utd-marking-lines-attr.
     1017               end.
     1018               else do:
     1019                  utd-marking-lines-attr.attr-value = iattrval.
     1020               end.
     1021            end.
     1022         end.
     1023      end.
     1024      release utd-marking-lines-attr.
     1025   end.
     1026   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   define variable vss-include-info6 as character format "X(65)" no-undo
     1028   initial "@(#)$Workfile$ $Revision$".
     1029   procedure xmlchar-test :
     1030   define input parameter p-in-string          as character        no-undo.
     1031   define output parameter p-out-string-enc    as character        no-undo.
     1032   define output parameter p-out-string-dec    as character        no-undo.
     1033   do
     1034   on error undo, return error
     1035   :
     1036          run xmlchar-encode in this-procedure
     1037       (
     1038             input p-in-string
     1039           , output p-out-string-enc
     1040       ).
     1041          run xmlchar-decode in this-procedure
     1042       (
     1043             input p-out-string-enc
     1044           , output p-out-string-dec
     1045       ).
     1046   end.
     1047   end .
     1048   procedure xmlchar-encode :
     1049   define input parameter p-in-string      as character        no-undo.
     1050   define output parameter p-out-string    as character        no-undo.
     1051       define variable v-position      as integer      no-undo.
     1052       define variable v-current-char  as character    no-undo.
     1053   do
     1054   on error undo, return error
     1055   :
     1056       assign
     1057           p-out-string = "":U
     1058       .
     1059       case p-in-string
     1060       :
     1061           when ?
     1062           then do:
     1063               assign
     1064                   p-out-string = "?":U
     1065               .
     1066           end.
     1067           when "?":U
     1068           then do:
     1069               assign
     1070                   p-out-string = "&#63;":U
     1071               .
     1072           end.
     1073           otherwise do:
     1074               do v-position = 1 to length( p-in-string )
     1075               :
     1076                   assign
     1077                       v-current-char = substring( p-in-string, v-position, 1 )
     1078                   .
     1079                   case v-current-char
     1080                   :
     1081                       when "&":U
     1082                       then do:
     1083                           assign
     1084                               p-out-string = p-out-string + "&amp;":U
     1085                           .
     1086                       end.
     1087                       when ">":U
     1088                       then do:
     1089                           assign
     1090                               p-out-string = p-out-string + "&gt;":U
     1091                           .
     1092                       end.
     1093                       when "<":U
     1094                       then do:
     1095                           assign
     1096                               p-out-string = p-out-string + "&lt;":U
     1097                           .
     1098                       end.
     1099                       when "'":U
     1100                       then do:
     1101                           assign
     1102                               p-out-string = p-out-string + "&apos;":U
     1103                           .
     1104                       end.
     1105                       when '"':U
     1106                       then do:
     1107                           assign
     1108                               p-out-string = p-out-string + "&quot;":U
     1109                           .
     1110                       end.
     1111                       when chr(1)
     1112                       then do:
     1113                           assign
     1114                               p-out-string = p-out-string + "":U
     1115                           .
     1116                       end.
     1117                       when chr(2)
     1118                       then do:
     1119                           assign
     1120                               p-out-string = p-out-string + "":U
     1121                           .
     1122                       end.
     1123                       when chr(3)
     1124                       then do:
     1125                           assign
     1126                               p-out-string = p-out-string + "":U
     1127                           .
     1128                       end.
     1129                       when chr(4)
     1130                       then do:
     1131                           assign
     1132                               p-out-string = p-out-string + "":U
     1133                           .
     1134                       end.
     1135                       when chr(5)
     1136                       then do:
     1137                           assign
     1138                               p-out-string = p-out-string + "":U
     1139                           .
     1140                       end.
     1141                       when chr(6)
     1142                       then do:
     1143                           assign
     1144                               p-out-string = p-out-string + "":U
     1145                           .
     1146                       end.
     1147                       when chr(7)
     1148                       then do:
     1149                           assign
     1150                               p-out-string = p-out-string + "":U
     1151                           .
     1152                       end.
     1153                       when chr(8)
     1154                       then do:
     1155                           assign
     1156                               p-out-string = p-out-string + "":U
     1157                           .
     1158                       end.
     1159                       when chr(9)
     1160                       then do:
     1161                           assign
     1162                               p-out-string = p-out-string + "":U
     1163                           .
     1164                       end.
     1165                       when chr(29)
     1166                       then do:
     1167                           assign
     1168                               p-out-string = p-out-string + "":U
     1169                           .
     1170                       end.
     1171                       when chr(10)
     1172                       then do:
     1173                           assign
     1174                               p-out-string = p-out-string + "&#10;":U
     1175                           .
     1176                       end.
     1177                       when chr(13)
     1178                       then do:
     1179                           assign
     1180                               p-out-string = p-out-string + "&#13;":U
     1181                           .
     1182                       end.
     1183                       otherwise do:
     1184                           assign
     1185                               p-out-string = p-out-string + v-current-char
     1186                           .
     1187                       end.
     1188                   end case.
     1189               end.
     1190           end.
     1191       end case.
     1192   end.
     1193   end .
     1194   procedure xmlchar-encode-1c :
     1195   define input parameter p-in-string      as character        no-undo.
     1196   define output parameter p-out-string    as character        no-undo.
     1197       define variable v-position      as integer      no-undo.
     1198       define variable v-current-char  as character    no-undo.
     1199   do
     1200   on error undo, return error
     1201   :
     1202       assign
     1203           p-out-string = "":U
     1204       .
     1205       case p-in-string
     1206       :
     1207           when ?
     1208           then do:
     1209               assign
     1210                   p-out-string = "?":U
     1211               .
     1212           end.
     1213           otherwise do:
     1214               do v-position = 1 to length( p-in-string )
     1215               :
     1216                   assign
     1217                       v-current-char = substring( p-in-string, v-position, 1 )
     1218                   .
     1219                   case v-current-char
     1220                   :
     1221                       when chr(1)
     1222                       then do:
     1223                           assign
     1224                               p-out-string = p-out-string + " ":U
     1225                           .
     1226                       end.
     1227                       when chr(2)
     1228                       then do:
     1229                           assign
     1230                               p-out-string = p-out-string + " ":U
     1231                           .
     1232                       end.
     1233                       when chr(3)
     1234                       then do:
     1235                           assign
     1236                               p-out-string = p-out-string + " ":U
     1237                           .
     1238                       end.
     1239                       when chr(4)
     1240                       then do:
     1241                           assign
     1242                               p-out-string = p-out-string + " ":U
     1243                           .
     1244                       end.
     1245                       when chr(5)
     1246                       then do:
     1247                           assign
     1248                               p-out-string = p-out-string + " ":U
     1249                           .
     1250                       end.
     1251                       when chr(6)
     1252                       then do:
     1253                           assign
     1254                               p-out-string = p-out-string + " ":U
     1255                           .
     1256                       end.
     1257                       when chr(7)
     1258                       then do:
     1259                           assign
     1260                               p-out-string = p-out-string + " ":U
     1261                           .
     1262                       end.
     1263                       when chr(8)
     1264                       then do:
     1265                           assign
     1266                               p-out-string = p-out-string + " ":U
     1267                           .
     1268                       end.
     1269                       when chr(9)
     1270                       then do:
     1271                           assign
     1272                               p-out-string = p-out-string + " ":U
     1273                           .
     1274                       end.
     1275                       when chr(29)
     1276                       then do:
     1277                           assign
     1278                               p-out-string = p-out-string + " ":U
     1279                           .
     1280                       end.
     1281                       when chr(10)
     1282                       then do:
     1283                           assign
     1284                               p-out-string = p-out-string + " ":U
     1285                           .
     1286                       end.
     1287                       when chr(13)
     1288                       then do:
     1289                           assign
     1290                               p-out-string = p-out-string + " ":U
     1291                           .
     1292                       end.
     1293                       otherwise do:
     1294                           assign
     1295                               p-out-string = p-out-string + v-current-char
     1296                           .
     1297                       end.
     1298                   end case.
     1299               end.
     1300           end.
     1301       end case.
     1302   end.
     1303   end .
     1304   procedure xmlchar-decode :
     1305   define input parameter p-in-string      as character        no-undo.
     1306   define output parameter p-out-string    as character        no-undo.
     1307       define variable v-position      as integer      no-undo.
     1308       define variable v-last-position as integer      no-undo.
     1309       define variable v-temp-integer  as integer      no-undo.
     1310       define variable v-current-char  as character    no-undo.
     1311       define variable v-next-char     as character    no-undo.
     1312       define variable v-success       as logical      no-undo.
     1313   do
     1314   on error undo, return error
     1315   :
     1316       assign
     1317           p-out-string = "":U
     1318           v-position   = 0
     1319       .
     1320       replace-cycle:
     1321       do while yes
     1322       on error undo, return error
     1323       :
     1324           assign
     1325               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1326           .
     1327           if v-last-position <= v-position
     1328           then do:
     1329               if v-position = 0
     1330               then do:
     1331                   assign
     1332                       p-out-string = p-in-string
     1333                   .
     1334               end.
     1335               else do:
     1336                   assign
     1337                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1338                   .
     1339               end.
     1340               leave replace-cycle.
     1341           end.
     1342           else do:
     1343               assign
     1344                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1345                   v-position      = v-last-position
     1346                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1347               .
     1348               if v-current-char = "#":U
     1349               then do:
     1350                   assign
     1351                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1352                   .
     1353                   if v-last-position > 0
     1354                   then do:
     1355                       run xmlchar-read-integer in this-procedure
     1356                        (
     1357                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1358                           , output v-temp-integer
     1359                           , output v-success
     1360                       ).
     1361                       if v-success = yes
     1362                       and v-temp-integer >= 1
     1363                       and v-temp-integer <= 255
     1364                       then do:
     1365                           assign
     1366                               p-out-string = p-out-string + chr( v-temp-integer )
     1367                               v-position   = v-last-position + 1
     1368                           .
     1369                       end.
     1370                       else do:
     1371                           assign
     1372                               p-out-string = p-out-string + "&":U
     1373                               v-position   = v-position   + 1
     1374                           .
     1375                       end.
     1376                   end.
     1377                   else do:
     1378                       assign
     1379                           p-out-string = p-out-string + "&":U
     1380                           v-position   = v-position   + 1
     1381                       .
     1382                   end.
     1383               end.
     1384               else do:
     1385                   case substring( p-in-string, v-position + 1, 3 )
     1386                   :
     1387                       when "lt;":U
     1388                       then do:
     1389                           assign
     1390                               p-out-string = p-out-string + "<":U
     1391                               v-position   = v-position   + 3
     1392                           .
     1393                       end.
     1394                       when "gt;":U
     1395                       then do:
     1396                           assign
     1397                               p-out-string = p-out-string + ">":U
     1398                               v-position   = v-position   + 3
     1399                           .
     1400                       end.
     1401                       otherwise do:
     1402                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1403                           then do:
     1404                               assign
     1405                                   p-out-string = p-out-string + "&":U
     1406                                   v-position   = v-position   + 4
     1407                               .
     1408                           end.
     1409                           else do:
     1410                               case substring( p-in-string, v-position + 1, 5 )
     1411                               :
     1412                                   when "quot;":U
     1413                                   then do:
     1414                                       assign
     1415                                           p-out-string = p-out-string + '"':U
     1416                                           v-position   = v-position   + 5
     1417                                       .
     1418                                   end.
     1419                                   when "apos;":U
     1420                                   then do:
     1421                                       assign
     1422                                           p-out-string = p-out-string + "'":U
     1423                                           v-position   = v-position   + 5
     1424                                       .
     1425                                   end.
     1426                                   otherwise do:
     1427                                       assign
     1428                                           p-out-string = p-out-string + "&":U
     1429                                       .
     1430                                   end.
     1431                               end case.
     1432                           end.
     1433                       end.
     1434                   end case.
     1435               end.
     1436           end.
     1437       end.
     1438   end.
     1439   end .
     1440   procedure xmlchar-read-integer :
     1441   define input parameter p-input-string      as character        no-undo.
     1442   define output parameter p-output-integer   as integer          no-undo.
     1443   define output parameter p-success       as logical          no-undo.
     1444   do
     1445   on error undo, return error
     1446   :
     1447       assign
     1448           p-output-integer = integer( p-input-string )
     1449       no-error.
     1450       if error-status :error
     1451       then do:
     1452           assign
     1453               p-success           = no
     1454               p-output-integer    = 0
     1455           .
     1456       end.
     1457       else do:
     1458           assign
     1459               p-success           = yes
     1460           .
     1461       end.
     1462   end.
     1463   end.
     1464   define variable mMRCCode  as logical    no-undo.
     1465   define variable mTypeMark as character  no-undo.
     1466   function IS-NeedMark returns logical
     1467   ( input ib-code as integer  ,
     1468     input ib-str as character ):
     1469      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1470      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1471                                    and buf_prod-bc-attr.b-str  eq ib-str
     1472                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1473        no-lock no-error.
     1474      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1475   end.
     1476   function repTegforDm return char
     1477   (iDM as char ):
     1478       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1479       define variable vteg as character no-undo.
     1480       define variable oDM as character no-undo.
     1481       define variable vi as integer no-undo.
     1482       oDM = iDm.
     1483       do vi = 1 to num-entries(vTeglist):
     1484          vTeg = entry(vi,vTeglist).
     1485          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1486       end.
     1487       return oDM.
     1488   end.
     1489   function repSpecSimbforDm return char
     1490   (iDM as char ):
     1491       define variable oDM as character no-undo.
     1492     run
     1493       xmlchar-decode(iDM, output oDM).
     1494     return repTegforDm (oDM).
     1495   end.
     1496   function CheckGtin return logical
     1497   (iGtin as char):
     1498      define variable bar_code as character no-undo.
     1499      define variable vGtin as logical no-undo init "yes".
     1500      if length(iGtin) eq 14
     1501      then do:
     1502         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1503         run str/chk-sum.p
     1504          (input-output bar_code ) no-error .
     1505         if iGtin ne  bar_code
     1506         then
     1507            vGtin = no.
     1508      end.
     1509      else
     1510         vGtin = no.
     1511      return vgtin.
     1512   end.
     1513   function repSpecSimbforXlm return char
     1514   (iDM as char ):
     1515       iDM = replace(iDM,chr(29),"").
     1516       return iDM.
     1517   end.
     1518   function getGtinByDM return char
     1519   (IDM as char):
     1520      define variable VTXT as char no-undo.
     1521      define variable vGtin as char no-undo.
     1522      vTXt = IdM.
     1523      vGtin = IDM.
     1524      if    length(vtxt) > 14
     1525      then do:
     1526         if   vtxt begins "(01)"
     1527                or vtxt begins "(02)"
     1528         then
     1529            vGtin = substring(vtxt,5,14).
     1530         else if   (vtxt begins "01"
     1531                or vtxt begins "02" )
     1532                and (   (    substring(iDm,17,2) eq "21"
     1533                         and length(vtxt) >= 21)
     1534                     or substring(iDm,17,2) eq "37"
     1535                     or substring(iDm,17,4) eq "(37)" )
     1536         then do:
     1537            vGtin = substring(vtxt,3,14).
     1538            if not checkGtin(vGtin)
     1539            then
     1540               vGtin = substring(vtxt,1,14).
     1541         end.
     1542         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1543             or length(vtxt) eq 14 + 7 + 4
     1544             or length(vtxt) eq 14 + 7
     1545         then
     1546            vGtin = substring(vtxt,1,14).
     1547      end.
     1548      if not checkGtin(vGtin)
     1549      then
     1550         vGtin = "".
     1551      return vgtin.
     1552   end.
     1553   function getGdsCodeByGtin return int
     1554   (iGtin as char):
     1555      define buffer prod-bc  for ub.prod-bc.
     1556      define buffer bar-code for ub.bar-code.
     1557      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1558      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1559      return if avail bar-code then bar-code.gds-code else ?.
     1560   end.
     1561   function getQntyCodeByGtin return decimal
     1562   (iGtin as char):
     1563      define buffer prod-bc  for ub.prod-bc.
     1564      define buffer bar-code for ub.bar-code.
     1565      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1566      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1567      return if avail bar-code then bar-code.cli-base-rate else ?.
     1568   end.
     1569   function getGdsCodeByDM return int
     1570   (iDm as char):
     1571      define variable vGtin as char no-undo.
     1572      define buffer prod-bc for ub.prod-bc.
     1573      vGtin  = getGtinByDM (IDM ).
     1574      return getGdsCodeByGtin (vGtin).
     1575   end.
     1576   function ChekTypeMarkByGds return logical
     1577   (iGds-code as integer ):
     1578      define buffer goods-attr for ub.goods-attr.
     1579      find first goods-attr where goods-attr.gds-code   = iGds-code
     1580                              and goods-attr.attr-code  = 'mark-type':U
     1581      no-lock no-error.
     1582      if available goods-attr
     1583      then do:
     1584         mTypeMark = goods-attr.attr-value.
     1585         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1586           .
     1587      end.
     1588      else
     1589         return no.
     1590   end.
     1591   function ChekTypeMarkByDm return logical
     1592   (iDM as char ):
     1593      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1594   end.
     1595   function ChekTypeMarkByGtin return logical
     1596   (iGtin as char ):
     1597      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1598   end.
     1599   function GetNextElement return character
     1600     (input iAllTeg        as logical
     1601     ,output oteg          as character
     1602     ,output otegval       as character
     1603     ,input-output pstr    as character
     1604      ):
     1605        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1606        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1607        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1608        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1609        define variable vTeg as character no-undo.
     1610        define variable vLength as integer no-undo.
     1611        define variable vi as integer no-undo.
     1612        define variable vj as integer no-undo.
     1613        define buffer code for ub.code.
     1614        find first code where Code.parent eq "MarkType"
     1615                          and Code.CodeValue   eq mTypeMark
     1616                          no-lock no-error.
     1617        if     available code
     1618           and Code.misc1 ne ""
     1619           and Code.misc1 ne ?
     1620        then do:
     1621           integer (Code.misc1) no-error.
     1622           if not error-status:error
     1623           then
     1624             entry (4,vlistleng) = Code.misc1.
     1625        end.
     1626        if iAllTeg
     1627        then
     1628           assign
     1629              vlistElem     = vlistElem    + vlistElemDop
     1630              vlistleng     = vlistleng    + vlistlengDop
     1631           .
     1632        else if mMRCCode
     1633        then
     1634           assign
     1635              vlistElem     = vlistElem    + ",(8005),8005"
     1636              vlistleng     = vlistleng    + ",000006,0006"
     1637           .
     1638       block-elem:
     1639       do vi = 1 to num-entries(vlistElem):
     1640          vTeg = entry(vi,vlistElem).
     1641          if pstr begins vTeg
     1642          then do:
     1643             if    vTeg eq "21"
     1644             then
     1645                vLength = index(pstr,chr(29)) - 2 no-error.
     1646             if vLength  <= 0
     1647             then
     1648                vLength = int(entry(vi,vlistleng)).
     1649             otegval = substring (pstr,length(vteg) + 1, vLength).
     1650             oteg = replace(replace(vteg,")",""),"(","").
     1651             vTeg = vteg + otegval.
     1652             otegval = replace(otegval,chr(29),"").
     1653             oteg = replace(replace(oteg,")",""),"(","").
     1654             pstr = substring (pstr,length(vTeg)+ 1).
     1655             vTeg = replace(vTeg,chr(29),"").
     1656             leave block-elem.
     1657          end.
     1658          else
     1659             vTeg = "".
     1660       end.
     1661       return vteg.
     1662   end.
     1663   function GetCodeIdent return character
     1664   (iDm as char):
     1665      define variable Velement   as character no-undo init "first".
     1666      define variable oCodeIdent as character no-undo.
     1667      define variable vteg as character no-undo.
     1668      define variable vtegval as character no-undo.
     1669      define variable vGtin as character no-undo.
     1670      define buffer marking for ub.marking.
     1671      for first marking no-lock where
     1672                marking.mark eq iDm
     1673            and marking.unit-ext = "LEVEL2"
     1674      :
     1675        return iDm.
     1676      end.
     1677      vGtin  = getGtinByDM (iDm ).
     1678      ChekTypeMarkByDm(idm).
     1679      if iDm begins 'tech_':U
     1680      then
     1681         oCodeIdent = iDm.
     1682      else if length(iDm) < 21
     1683      then do:
     1684         find first marking where marking.mark eq idm
     1685         no-lock no-error.
     1686         oCodeIdent = if available marking then marking.mark else  ?.
     1687      end.
     1688      else if     length(iDm) eq 29
     1689         and not iDm begins "01"
     1690         and not iDm begins "02"
     1691      then
     1692         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1693      else  if     length(iDm) >= 24
     1694               and (  iDm begins "01"
     1695                   or iDm begins "02")
     1696               and  substring(iDm,17,2) ne "21"
     1697      then do:
     1698         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1699                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1700         then
     1701            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1702         else
     1703            oCodeIdent = iDM.
     1704      end.
     1705      else  if     (   length(iDm) eq 25
     1706                    or length(iDm) eq 21)
     1707               and (not iDm begins "01"
     1708               and  not iDm begins "02")
     1709      then
     1710         oCodeIdent = substring(iDm,1,21).
     1711      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1712      then
     1713         oCodeIdent = substring(iDm,1,21).
     1714      else do while Velement ne "" and idm ne "":
     1715         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1716         oCodeIdent = oCodeIdent + Velement.
     1717      end.
     1718      return oCodeIdent.
     1719   end.
     1720   function GetTegCod return character
     1721   (icodeIdent as char, iTeg as char):
     1722      define variable Velement   as character no-undo init "first".
     1723      define variable oTeg as character no-undo init ?.
     1724      define variable vteg as character no-undo.
     1725      define variable vtegval as character no-undo.
     1726      if     ((length(icodeIdent) eq 21
     1727         and not icodeIdent begins "01"
     1728         and not icodeIdent begins "02")
     1729         or
     1730             ( length(icodeIdent) eq 25
     1731               and not icodeIdent begins "01"
     1732               and not icodeIdent begins "02"))
     1733      then do:
     1734         if iTeg eq "01" or iTeg eq "02"
     1735         then
     1736            oTeg = substring(icodeIdent,1,21).
     1737         else  if  iTeg eq "21"
     1738         then
     1739            oTeg = substring(icodeIdent,15,7).
     1740      end.
     1741      else do:
     1742         ChekTypeMarkByDm(icodeIdent).
     1743         block-teg:
     1744            do while Velement ne "" and icodeIdent ne "":
     1745            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1746            if    Velement begins iTeg
     1747               or Velement begins "(" + iTeg + ")"
     1748            then do:
     1749               oTeg = vtegval.
     1750               leave block-teg.
     1751            end.
     1752         end.
     1753      end.
     1754      return oTeg.
     1755   end.
     1756   function isOAD return logical
     1757   (icodeIdent as character):
     1758      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1759   end.
     1760   function isMark return logical
     1761   (icodeIdent as character):
     1762      define buffer buf_marking for ub.marking.
     1763      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1764             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1765   end.
     1766   function addBracketForCode return character
     1767   (icodeIdent as char):
     1768      define variable Velement   as character no-undo init "first".
     1769      define variable oTeg as character no-undo.
     1770      define variable vteg as character no-undo.
     1771      define variable vtegval as character no-undo.
     1772      define buffer marking for ub.marking.
     1773      find first marking no-lock where
     1774                 marking.mark begins icodeIdent no-error.
     1775      if    not ChekTypeMarkByDm(icodeIdent)
     1776         or length(icodeIdent) le 24
     1777         or (avail marking and marking.unit-ext = "LEVEL2")
     1778      then
     1779         oTeg = icodeIdent.
     1780      else do:
     1781         if (  icodeIdent begins "01"
     1782            or icodeIdent begins "02"
     1783            ) and CheckGtin(substring (icodeIdent,3,14))
     1784            and substring (icodeIdent,17,2) eq "21"
     1785         then do:
     1786            mMRCCode = yes.
     1787            ChekTypeMarkByDm(icodeIdent).
     1788            block-teg:
     1789            do while Velement ne "" and icodeIdent ne "":
     1790               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1791               if vteg ne ""
     1792               then
     1793                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1794            end.
     1795            mMRCCode = no.
     1796         end.
     1797         else do:
     1798            oTeg = icodeIdent.
     1799         end.
     1800      end.
     1801      return oTeg.
     1802   end.
     1803   function getlevelByCodId return int
     1804   (iCode as char):
     1805      define variable vLength as int no-undo.
     1806      define variable vLevel  as int no-undo.
     1807      if not ChekTypeMarkByDM (icode) then return ?.
     1808      vLength = length(iCode).
     1809      if    vLength eq 18
     1810         or vLength eq 20
     1811      then
     1812         Vlevel = 4.
     1813      else if vLength eq 21
     1814      then
     1815         Vlevel = 1.
     1816      else if vLength eq 25
     1817      then do:
     1818         if  iCode begins "01"
     1819         then
     1820            Vlevel = 3.
     1821         else
     1822            Vlevel = 1.
     1823      end.
     1824      else if     vLength >= 26
     1825              and vLength <= 46
     1826      then do:
     1827         if    substring(iCode,17,2) eq "11"
     1828            or substring(iCode,17,2) eq "13"
     1829            or (    substring(iCode,17,2) eq "21"
     1830                and vLength >= 33
     1831                and substring(iCode,26,4) ne "8005")
     1832         then
     1833            Vlevel = 4.
     1834         else if    vLength eq 31
     1835                 or vLength eq 38
     1836                 or vLength eq 39
     1837                 or vLength eq 45
     1838         then
     1839            Vlevel = 1.
     1840         else if    vLength eq 35
     1841                 or vLength eq 43
     1842         then
     1843            Vlevel = 3.
     1844         else
     1845            Vlevel = ?.
     1846      end.
     1847      else
     1848         Vlevel = ?.
     1849      return Vlevel.
     1850   end.
     1851   function getLevelMotpBycodid return character
     1852   (iDm as char):
     1853      define variable vLevel as integer no-undo.
     1854      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1855      vLevel = getlevelByCodId(iDm).
     1856      if    vLevel eq ?
     1857         or vLevel < 1
     1858         or vLevel > 6
     1859      then
     1860         return ?.
     1861      else
     1862         return entry(vlevel,vList).
     1863   end.
     1864   function getLevelUTDByLevelMotp return character
     1865   (iUnit as char):
     1866      define variable vLevel as integer no-undo.
     1867      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1868      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1869      vLevel = lookup(iUnit,vListMOTP).
     1870      if    vLevel eq ?
     1871         or vLevel < 1
     1872         or vLevel > 4
     1873      then
     1874         return ?.
     1875      else
     1876         return entry(vlevel,vListutd).
     1877   end.
     1878   function getLevelMotpByDM return character
     1879   (iDm as char):
     1880      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1881   end.
     1882   function getLevelUTDByCodId return character
     1883   (iDm as char):
     1884      define variable vLevel as integer no-undo.
     1885      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1886      vLevel = getlevelByCodId(iDm).
     1887      if    vLevel eq ?
     1888         or vLevel < 1
     1889         or vLevel > 4
     1890      then
     1891         return ?.
     1892      else
     1893         return entry(vlevel,vList).
     1894   end.
     1895   function getLevelUTDByDM return character
     1896   (iDm as char):
     1897      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1898   end.
     1899   define variable mNotMarkQnty as logical no-undo.
     1900   function getQntyUTDByCodId return decimal
     1901   (iDM as char):
     1902      define variable vLevel as integer no-undo.
     1903      define variable vList as character no-undo init "1,5,10,500".
     1904      define variable vGtin as character no-undo.
     1905      define variable vqnty as decimal no-undo init ?.
     1906      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1907      if vqnty eq ?
     1908      then do:
     1909         if not mNotMarkQnty
     1910         then do:
     1911            define buffer marking for ub.marking.
     1912            define variable vCodident as character no-undo.
     1913            vCodident = GetCodeIdent(idm).
     1914            find first marking where marking.mark begins vCodident no-lock no-error.
     1915            if     available marking
     1916               and marking.box-qnty ne ?
     1917            then
     1918               return marking.box-qnty.
     1919         end.
     1920         vGtin = getGtinByDm(iDM).
     1921         if ChekTypeMarkByGtin (vGtin)
     1922         then do:
     1923            vLevel = getlevelByCodId(iDM).
     1924            if     vLevel >= 1
     1925               and vLevel <= 4
     1926            then
     1927               vqnty = int(entry(vlevel,vList)).
     1928         end.
     1929         else
     1930            vqnty = getQntyCodeByGtin(vgtin).
     1931      end.
     1932      return vqnty.
     1933   end.
     1934   function getQntyUTDByDM return decimal
     1935   (iDm as char):
     1936      define variable vDM as character no-undo.
     1937      if     length (iDm) ne 25
     1938         and length (iDm) ne 29
     1939         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1940      then
     1941         vDM = substring (iDm,1,length (iDm) - 6 ).
     1942      else
     1943         vDM = substring (iDm,1,length (iDm) - 4 ).
     1944      return getQntyUTDByCodId(vDM).
     1945   end.
     1946   function getMRC4 return decimal
     1947   (iMRC as char):
     1948      define variable oMrc     as decimal no-undo init ?.
     1949      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1950      define variable vi       as integer no-undo.
     1951      define variable vfound   as integer no-undo.
     1952      define variable vposStart   as integer no-undo.
     1953      do:
     1954      OMRc = 0.
     1955      do vi = 1 to 4:
     1956         define variable vsimb as character no-undo.
     1957         vsimb = substring(iMRC,vi,1).
     1958         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1959         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1960         if vfound > 0
     1961         then
     1962            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1963         end.
     1964         OMRc = OMRc / 100.
     1965      end.
     1966      return OMRc.
     1967   end.
     1968   function getMRCByDM return decimal
     1969   (iDm as char):
     1970      define variable vMRC     as character no-undo.
     1971      define variable oMrc     as decimal no-undo init ?.
     1972      define variable Velement as character no-undo init "empty".
     1973      define variable vteg as character no-undo.
     1974      define variable vtegval as character no-undo.
     1975      if    length(idm) eq 14 + 7 + 4 + 4
     1976         or length(idm) eq 14 + 7 + 4
     1977      then do:
     1978         vMRC = substring(idm,22,4).
     1979         omrc = getMRC4(vMRC).
     1980      end.
     1981      else do:
     1982          ChekTypeMarkByDm(iDm).
     1983          block-mrc:
     1984          do while Velement ne "" and idm ne "":
     1985             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1986             if Velement begins "8005"
     1987             then do:
     1988                vMRC = substring(Velement,5,6).
     1989                leave block-mrc.
     1990             end.
     1991             else if Velement begins "(8005)"
     1992             then do:
     1993                vMRC = substring(Velement,7,6).
     1994                leave block-mrc.
     1995             end.
     1996          end.
     1997          if vMRC ne ""
     1998          then
     1999             OMRc = dec(vmrc) / 100 no-error.
     2000      end.
     2001      return OMRc.
     2002   end.
     2003   function MoveDate return Date
     2004   (idate as date,
     2005    iMonth as int64):
     2006      define variable vMonth   as int64 no-undo.
     2007      define variable vYear    as int64 no-undo.
     2008      define variable vDateNew as date  no-undo.
     2009       define variable vDay     as int64 no-undo.
     2010       vMonth = month(iDate) + iMonth.
     2011       vYear =  year(iDate).
     2012       if vMonth <= 0
     2013       then assign
     2014          vMonth = vMonth + 12
     2015           vYear  = vYear - 1
     2016       .
     2017       else if vMonth > 12
     2018       then assign
     2019          vMonth = vMonth - 12
     2020           vYear  = vYear + 1
     2021       .
     2022       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2023       do while error-status:error eq yes:
     2024          VDay = vDay + 1.
     2025          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2026       end.
     2027       if VDay > 0
     2028       then
     2029          vDateNew + 1.
     2030       return vDateNew.
     2031   end.
     2032   procedure checkEMRC:
     2033   define input  parameter iDm as character no-undo.
     2034   define output parameter vok as logical   no-undo init yes.
     2035      define variable v-value-emrc as character no-undo.
     2036      define variable v-type-emrc  as character no-undo.
     2037      define variable vDateIso     as character no-undo.
     2038      define variable vMRC         as decimal no-undo.
     2039      define variable vqnty        as decimal no-undo.
     2040      define variable vPrice       as decimal no-undo.
     2041      define variable vparent      as character no-undo.
     2042      define variable vgds-code    as integer no-undo.
     2043      define buffer code for ub.code.
     2044      vMRC = getMRCByDM(iDm).
     2045      if vMRC > 0
     2046      then do:
     2047         vgds-code = getGdsCodeByDM(iDm).
     2048         vqnty     = getQntyUTDByDM(iDm).
     2049               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2050            (
     2051             input   vgds-code
     2052            ,input   'emrc-type':U
     2053            ,output   v-value-emrc
     2054            ,output   v-type-emrc
     2055          ) no-error.
     2056          if     v-value-emrc ne ""
     2057             and v-value-emrc ne ?
     2058          then do:
     2059             vDateIso = iso-date(today).
     2060             vPrice = vMRC / vqnty.
     2061             vparent ="emc" + chr(4) + v-value-emrc.
     2062             find last code where Code.parent      eq vparent
     2063                              and Code.code        le vDateIso
     2064                              and code.status_  eq 0
     2065             no-lock no-error.
     2066             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2067             then
     2068                vOk = true .
     2069             else do:
     2070                 define variable vText      as character no-undo.
     2071                 define variable vDate      as date no-undo.
     2072                 define variable vDateLast  as character no-undo.
     2073                 define variable vDateFirst as character no-undo.
     2074                 define variable vDate3     as date no-undo.
     2075                 vdate = date(code.misc1).
     2076                 vDateLast = code.misc1.
     2077                 vDate3 = MoveDate(today, - 3 ).
     2078                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2079                                      string(vDate3  , "99/99/9999"),
     2080                                      string(vDate   , "99/99/9999")
     2081                                      ).
     2082                 vdateIso = iso-date(vdate3).
     2083                 find last code  where Code.parent      eq vparent
     2084                                   and Code.code        le vDateIso
     2085                                   and code.status_  eq 0 no-lock no-error.
     2086                 if available code
     2087                 then
     2088                    vDateIso = code.code.
     2089                 vDateFirst = vDateIso.
     2090                 vDateLast = iso-date(vdate).
     2091                 define variable vGood as logical no-undo.
     2092                 define variable vDateSale as date no-undo.
     2093                 define buffer bcode for code.
     2094                 for last code where Code.parent   eq vparent
     2095                                 and code.status_  eq 0
     2096                                 and code.code     < vDateLast
     2097                                 and code.code     >= vDateFirst
     2098                 no-lock:
     2099                    find first bcode where bCode.parent   eq vparent
     2100                                       and bcode.status_  eq 0
     2101                                       and bcode.code     > code.code no-lock no-error.
     2102                    if available bcode
     2103                    then do:
     2104                       if vPrice < dec(Code.CodeValue)
     2105                       then
     2106                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2107                                                     chr(10),
     2108                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2109                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2110                                                     ).
     2111                       else do:
     2112                          vGood = yes.
     2113                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2114                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2115                                                     chr(10),
     2116                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2117                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2118                                                     string(         vDateSale            ,"99/99/9999"),
     2119                                                     string(vDateSale - today)
     2120                                                     ).
     2121                       end.
     2122                    end.
     2123                 end.
     2124                 if vgood
     2125                 then do:
     2126                    define variable choice as integer no-undo .
     2127                    run gbl/d-askw.w (input "Уточнение"
     2128                           ,input  vText
     2129                           ,input "|"
     2130                           ,input "Принять|Вернуть"
     2131                           ,input "Принять данный товар|Вернуть товар постащику"
     2132                           ,input 1
     2133                           ,input 2
     2134                           ,output choice) no-error.
     2135                    vok = choice eq 1.
     2136                 end.
     2137                 else
     2138                    vok =false.
     2139             end.
     2140          end.
     2141      end.
     2142   end.
     2143   function addGs2Mark return character
     2144   (iMark as char):
     2145      define variable vDM   as character no-undo.
     2146      define variable vIdx  as integer   no-undo.
     2147      if index(iMark,chr(29),1) > 0
     2148      then return iMark.
     2149      if substring(iMark,26,4) = "8005" then
     2150      do:
     2151        vIdx = index(iMark,"93",26 + 4 + 5).
     2152        if vIdx > 1 then do:
     2153          vDM = substitute("&1&4&2&4&3",
     2154                           substring(iMark,1,25),
     2155                           substring(iMark,26,vIdx - 25 - 1),
     2156                           substring(iMark,vIdx),
     2157                           chr(29)) no-error.
     2158          vIdx = index(vDm,"240",vIdx + 4).
     2159          if vIdx > 0 then
     2160          do:
     2161            vDM = substitute("&1&3&2",
     2162                             substring(vDm,1,vIdx - 1),
     2163                             substring(vDm,vIdx),
     2164                             chr(29)) no-error.
     2165          end.
     2166        end.
     2167        else
     2168          vDM = substitute("&1&3&2",
     2169                           substring(iMark,1,25),
     2170                           substring(iMark,26),
     2171                           chr(29)) no-error.
     2172      end.
     2173      else if substring(iMark,32,2) = "91" then
     2174      do:
     2175        vIdx = index(iMark,"92",32).
     2176        if vIdx > 1 then
     2177          vDM = substitute("&1&4&2&4&3",
     2178                           substring(iMark,1,31),
     2179                           substring(iMark,32,vIdx - 31 - 1),
     2180                           substring(iMark,vIdx),
     2181                           chr(29)) no-error.
     2182        else
     2183          vDM = substitute("&1&3&2",
     2184                           substring(iMark,1,31),
     2185                           substring(iMark,32),
     2186                           chr(29)) no-error.
     2187      end.
     2188      else if substring(iMark,39,2) = "91" then
     2189      do:
     2190        vIdx = index(iMark,"92",38).
     2191        if vIdx > 1 then
     2192          vDM = substitute("&1&4&2&4&3",
     2193                           substring(iMark,1,38),
     2194                           substring(iMark,39,vIdx - 38 - 1),
     2195                           substring(iMark,vIdx),
     2196                           chr(29)) no-error.
     2197        else
     2198          vDM = substitute("&1&3&2",
     2199                           substring(iMark,1,38),
     2200                           substring(iMark,39),
     2201                           chr(29)) no-error.
     2202      end.
     2203      else if substring(iMark,25,2) = "93" then
     2204      do:
     2205        vIdx = index(iMark,"92",25).
     2206        if vIdx > 1 then
     2207          vDM = substitute("&1&4&2&4&3",
     2208                           substring(iMark,1,24),
     2209                           substring(iMark,25,vIdx - 24 - 1),
     2210                           substring(iMark,vIdx),
     2211                           chr(29)) no-error.
     2212        else
     2213          vIdx = index(iMark,"3103",25).
     2214          if vIdx > 0 then
     2215          vDM = substitute("&1&4&2&4&3",
     2216                           substring(iMark,1,24),
     2217                           substring(iMark,25,vIdx - 24 - 1),
     2218                           substring(iMark,vIdx),
     2219                           chr(29)) no-error.
     2220          else
     2221            vDM = substitute("&1&3&2",
     2222                             substring(iMark,1,24),
     2223                             substring(iMark,25),
     2224                             chr(29)) no-error.
     2225      end.
     2226      else if substring(iMark,32,2) = "93" then
     2227      do:
     2228        vDM = substitute("&1&3&2",
     2229              substring(iMark,1,31),
     2230              substring(iMark,32),
     2231              chr(29)) no-error.
     2232      end.
     2233      return if vDM <> "" then vDm else iMark.
     2234   end.
     2235   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2236   function AddUtdErrForTab returns logical
     2237   (idb-num         as integer ,
     2238    idoc-id         as integer ,
     2239    iTab            as character,
     2240    iObj            as handle ,
     2241    iCheckType      as character,
     2242    iCodeErr        as character,
     2243    iCheckObj       as character ):
     2244      define buffer utd-err for utd-err.
     2245      define buffer utd for utd.
     2246      find first utd where utd.db-num     eq idb-num
     2247                       and utd.doc-id     eq idoc-id
     2248                       and utd.Direction  eq 'Outbound'
     2249      no-lock no-error.
     2250      if available utd
     2251      then
     2252         return no.
     2253      define variable vRecKey as character no-undo.
     2254            run gen-key-rec (input iTab,
     2255                             input  iObj,
     2256                             output vRecKey).
     2257      find first utd-err where utd-err.db-num     eq idb-num
     2258                           and utd-err.doc-id     eq idoc-id
     2259                           and utd-err.CheckType  eq iCheckType
     2260                           and utd-err.CodeErr    eq iCodeErr
     2261                           and utd-err.CheckObj   eq iCheckObj
     2262      exclusive-lock no-error.
     2263      if not available utd-err
     2264      then do:
     2265         create utd-err.
     2266         assign
     2267            utd-err.db-num         = idb-num
     2268            utd-err.doc-id         = idoc-id
     2269            utd-err.CheckType      = iCheckType
     2270            utd-err.CodeErr        = iCodeErr
     2271            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2272            utd-err.reckey         = vRecKey
     2273            utd-err.qnty           = 1
     2274         .
     2275      end.
     2276      else
     2277         utd-err.qnty = utd-err.qnty + 1.
     2278      return utd-err.qnty eq 1.
     2279   end.
     2280   function AddUtdErr returns logical
     2281   (idb-num         as integer ,
     2282    idoc-id         as integer ,
     2283    iObj            as handle ,
     2284    iCheckType      as character,
     2285    iCodeErr        as character,
     2286    iCheckObj       as character ):
     2287      AddUtdErrForTab
     2288         (idb-num,
     2289          idoc-id,
     2290          iObj:table,
     2291          iObj,
     2292          iCheckType,
     2293          iCodeErr,
     2294          iCheckObj).
     2295   end.
     2296   function ClearUtdErrTypeCode returns logical
     2297   (idb-num         as integer,
     2298    idoc-id         as integer ,
     2299    iCheckType      as character,
     2300    iCodeErr        as character
     2301    ):
     2302      define buffer utd-err for utd-err.
     2303      if    iCheckType eq "*"
     2304         or iCheckType eq ?
     2305      then do:
     2306         if     iCodeErr ne ?
     2307            and iCodeErr ne "*"
     2308         then
     2309            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2310            view-as alert-box.
     2311         else
     2312         for each utd-err where utd-err.db-num  eq idb-num
     2313                            and utd-err.doc-id  eq idoc-id
     2314         exclusive-lock:
     2315            delete utd-err.
     2316         end.
     2317      end.
     2318      else do:
     2319         if    iCodeErr eq ?
     2320            or iCodeErr eq "*"
     2321         then do:
     2322            for each utd-err where utd-err.db-num     eq idb-num
     2323                               and utd-err.doc-id     eq idoc-id
     2324                               and utd-err.CheckType  eq iCheckType
     2325            exclusive-lock:
     2326               delete utd-err.
     2327            end.
     2328         end.
     2329         else do:
     2330            for each utd-err where utd-err.db-num     eq idb-num
     2331                               and utd-err.doc-id     eq idoc-id
     2332                               and utd-err.CheckType  eq iCheckType
     2333                               and ub.utd-err.CodeErr eq iCodeErr
     2334            exclusive-lock:
     2335               delete utd-err.
     2336            end.
     2337         end.
     2338      end.
     2339   end.
     2340   function ClearUtdErr returns logical
     2341   (idb-num         as integer,
     2342    idoc-id         as integer ,
     2343    iCheckType      as character
     2344    ):
     2345      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2346   end.
     2347   function GetMesError returns character
     2348   (itxt as character,
     2349    iobj as character ):
     2350    define variable vi as integer no-undo.
     2351    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2352       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2353    end.
     2354    return itxt.
     2355   end.
     2356   function GetTextErrorType returns character
     2357   (iCheckType as character,
     2358    iCodeErr   as character,
     2359    iChechObj  as character,
     2360    iType      as character  ):
     2361      define buffer code    for code.
     2362      define variable vError as character no-undo.
     2363      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2364                        and code.code   eq iCodeErr
     2365      no-lock no-error.
     2366      if available code
     2367      then do:
     2368         define variable vType as integer no-undo.
     2369         if code.misc3 eq "error"
     2370         then
     2371            vType = 0.
     2372         else if code.misc3 eq "warning"
     2373         then
     2374            vType = 1.
     2375         else if code.misc3 eq "Hiden"
     2376         then
     2377            vType = 2.
     2378         else
     2379            vtype = int(code.misc3) no-error.
     2380         case itype:
     2381            when "error"
     2382            then do:
     2383               if vtype eq 0
     2384               then
     2385                  vError = GetMesError(Code.CodeValue,iChechObj).
     2386            end.
     2387            when "warning"
     2388            then do:
     2389               if vtype <= 1
     2390               then
     2391                  vError = GetMesError(Code.CodeValue,iChechObj).
     2392            end.
     2393            otherwise do:
     2394               vError = GetMesError(Code.CodeValue,iChechObj).
     2395            end.
     2396         end.
     2397      end.
     2398      else
     2399         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2400      return vError.
     2401   end.
     2402   function GetTypeError returns integer
     2403   (iCheckType as character,
     2404    iCodeErr   as character):
     2405      define buffer code    for code.
     2406      define variable vType as integer no-undo.
     2407      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2408                        and code.code   eq iCodeErr
     2409      no-lock no-error.
     2410      if     not available code
     2411         and code.misc3 eq "error"
     2412      then
     2413         vType = 0.
     2414      else if code.misc3 eq "warning"
     2415      then
     2416         vType = 1.
     2417      else if code.misc3 eq "Hiden"
     2418      then
     2419         vType = 2.
     2420      else
     2421         vtype = int(code.misc3) no-error.
     2422      return vtype.
     2423   end.
     2424   function GetTextError returns character
     2425   (iCheckType as character,
     2426    iCodeErr   as character,
     2427    iChechObj  as character ):
     2428      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2429   end.
     2430   function GetErrForUtdStr returns character
     2431   (idb-num     as integer ,
     2432    idoc-id     as integer ,
     2433    iCheckType  as character
     2434    ):
     2435      define buffer utd-err for utd-err.
     2436      define buffer code    for code.
     2437      define variable vHQry as handle no-undo.
     2438      define variable vError as longchar no-undo.
     2439      define variable vErrorOne as longchar  no-undo.
     2440      define variable oError as character no-undo.
     2441      create query vHQry.
     2442      vHQry:set-buffers(buffer utd-err:handle).
     2443      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2444                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2445                               + if    iCheckType eq "*"
     2446                                    or iCheckType eq ?
     2447                                 then       ""
     2448                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2449      vHQry:query-open().
     2450      vHQry:get-first().
     2451      QRY-BLOCK:
     2452      repeat while not vHQry:query-off-end:
     2453         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2454         if     vErrorOne ne ""
     2455            and vErrorOne ne ?
     2456         then
     2457            vError = vError + ", " + vErrorOne.
     2458         vHQry:get-next().
     2459      end.
     2460      oError = substring(vError,3,4002).
     2461      return oError.
     2462   end.
     2463   function GetErrJsonForUtd returns character
     2464   (idb-num         as integer ,
     2465    idoc-id         as integer ,
     2466    iCheckType      as character
     2467    ):
     2468      define buffer utd-err for utd-err.
     2469      define variable vHQry as handle no-undo.
     2470      define variable vError as longchar no-undo.
     2471      define variable oError as character no-undo.
     2472      create query vHQry.
     2473      define variable vi as integer no-undo.
     2474      vHQry:set-buffers(buffer utd-err:handle).
     2475      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2476                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2477                               + if    iCheckType eq "*"
     2478                                    or iCheckType eq ?
     2479                                 then       ""
     2480                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2481      vHQry:query-open().
     2482      vHQry:get-first().
     2483      QRY-BLOCK:
     2484      repeat while not vHQry:query-off-end:
     2485         define variable vErrorOne as character no-undo.
     2486         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2487         if     vErrorOne ne ?
     2488            and vErrorOne ne ""
     2489         then do:
     2490            vi = vi + 1.
     2491            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2492                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2493                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2494         end.
     2495         vHQry:get-next().
     2496      end.
     2497      for first utd where utd.db-num eq idb-num
     2498                      and utd.doc-id eq idoc-id
     2499                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2500      no-lock,
     2501         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2502                                  and utd-marking-lines.doc-id eq idoc-id
     2503                                  and utd-marking-lines.doc-level eq 1
     2504      no-lock,
     2505         first marking where marking.mark eq utd-marking-lines.mark
     2506                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2507      no-lock:
     2508         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2509         if     vErrorOne ne ?
     2510            and vErrorOne ne ""
     2511         then do:
     2512            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2513                            + '","ОбъектОш":"' + marking.mark
     2514                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2515         end.
     2516      end.
     2517      if vError ne ""
     2518      then
     2519         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2520      return oError.
     2521   end.
     2522   function GetErrJsonForUtdReturn returns character
     2523   (idb-num         as integer ,
     2524    idoc-id         as integer ,
     2525    iCheckType      as character
     2526    ):
     2527      define buffer utd-err for utd-err.
     2528      define variable vHQry as handle no-undo.
     2529      define variable vError as longchar no-undo.
     2530      define variable oError as character no-undo.
     2531      define variable vi as integer no-undo.
     2532      create query vHQry.
     2533      vHQry:set-buffers(buffer utd-err:handle).
     2534      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2535                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2536                               + if    iCheckType eq "*"
     2537                                    or iCheckType eq ?
     2538                                 then       ""
     2539                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2540      vHQry:query-open().
     2541      vHQry:get-first().
     2542      QRY-BLOCK:
     2543      repeat while not vHQry:query-off-end:
     2544         define variable vErrorOne as character no-undo.
     2545         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2546         if     vErrorOne ne ?
     2547            and vErrorOne ne ""
     2548         then do:
     2549            vi = vi + 1.
     2550            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2551                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2552                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2553         end.
     2554         vHQry:get-next().
     2555      end.
     2556      if vError ne ""
     2557      then
     2558         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2559      return oError.
     2560   end.
     2561   function GetCodeTextError returns character
     2562   (iCheckType as character,
     2563    iCodeErr   as character,
     2564    iChechObj  as character,
     2565    output oCode as character,
     2566    output ovalue as character ):
     2567      define buffer code    for code.
     2568      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2569                        and code.code   eq iCodeErr
     2570      no-lock no-error.
     2571      if     available code
     2572      then do:
     2573         define variable vi as integer no-undo init ?.
     2574         vi = int(Code.misc3) no-error.
     2575         if    code.misc3 ne "error"
     2576            and vi ne 0
     2577         then
     2578            oCode = ?.
     2579         else if     Code.misc1 ne ?
     2580                 and Code.misc1 ne ""
     2581         then
     2582            assign
     2583               oCode  = GetMesError(Code.misc1,iChechObj)
     2584               ovalue = GetMesError(Code.misc2,iChechObj)
     2585            .
     2586      end.
     2587      return if oCode eq ""
     2588             then ""
     2589             else (oCode + "_" + ovalue).
     2590   end.
     2591   define temp-table TT-err no-undo
     2592     field code_ as character
     2593     field text_ as character
     2594   index code_ code_.
     2595   function GetErrTxtForUtd returns character
     2596   (idb-num         as integer ,
     2597    idoc-id         as integer ,
     2598    iCheckType      as character
     2599    ):
     2600      define buffer utd-err for utd-err.
     2601      define variable vHQry as handle no-undo.
     2602      define variable oError as character no-undo.
     2603      create query vHQry.
     2604      define variable vi as integer no-undo.
     2605      for each tt-err :
     2606         delete tt-err.
     2607      end.
     2608      vHQry:set-buffers(buffer utd-err:handle).
     2609      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2610                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2611                               + if    iCheckType eq "*"
     2612                                    or iCheckType eq ?
     2613                                 then       ""
     2614                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2615      vHQry:query-open().
     2616      vHQry:get-first().
     2617      define variable vcode as character no-undo.
     2618      define variable vvalue as character no-undo.
     2619      QRY-BLOCK:
     2620      repeat while not vHQry:query-off-end:
     2621         vi = vi + 1.
     2622         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2623         if vcode ne ?
     2624         then do:
     2625            find first tt-err where tt-err.code eq vcode
     2626            no-error.
     2627            if not available tt-err
     2628            then do:
     2629               create tt-err.
     2630               assign
     2631                  tt-err.code_ = vcode
     2632                  tt-err.text_ = vvalue
     2633               .
     2634            end.
     2635            else
     2636               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2637         end.
     2638         vHQry:get-next().
     2639      end.
     2640     find first utd where utd.db-num eq idb-num
     2641                         and utd.doc-id eq idoc-id
     2642         no-lock.
     2643      define buffer cancel_utd-lines for utd-lines.
     2644      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2645                                  and cancel_utd-lines.doc-id eq idoc-id
     2646      no-lock:
     2647         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2648         then do:
     2649            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2650                                        and utd-marking-lines.doc-id eq idoc-id
     2651                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2652            no-lock,
     2653               first marking where marking.mark eq utd-marking-lines.mark
     2654                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2655            no-lock:
     2656               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2657               find first tt-err where tt-err.code eq vcode
     2658               no-error.
     2659               if not available tt-err
     2660               then do:
     2661                  create tt-err.
     2662                  assign
     2663                     tt-err.code_ = vcode
     2664                     tt-err.text_ = vvalue
     2665                  .
     2666               end.
     2667               else
     2668                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2669            end.
     2670         end.
     2671         else do:
     2672            define variable vqnty as decimal no-undo.
     2673            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2674            if vqnty eq ? then vqnty = 0.
     2675            if vqnty ne cancel_utd-lines.Quantity
     2676            then do:
     2677               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2678               find first tt-err where tt-err.code eq vcode
     2679               no-error.
     2680               if not available tt-err
     2681               then do:
     2682                  create tt-err.
     2683                  assign
     2684                     tt-err.code_ = vcode
     2685                     tt-err.text_ = vvalue
     2686                  .
     2687               end.
     2688               else
     2689                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2690            end.
     2691         end.
     2692      end.
     2693      for each tt-err:
     2694         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2695      end.
     2696      return oError.
     2697   end.
     2698   define variable mFormatErr as character no-undo init "text".
     2699   function GetErrForUtd returns character
     2700   (idb-num         as integer ,
     2701    idoc-id         as integer ,
     2702    iType           as character
     2703    ):
     2704      if mFormatErr eq "text"
     2705      then
     2706         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2707      else do:
     2708         if itype eq "return"
     2709         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2710         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2711      end.
     2712   end.
     2713   function GetErrComText returns longchar
     2714   (icomment as character,
     2715    itext    as longchar ):
     2716       define variable vText as longchar no-undo.
     2717      if mFormatErr eq "text"
     2718      then do:
     2719         if icomment ne ""
     2720         then
     2721            icomment = substitute("comment:|&1|",icomment).
     2722         vText = icomment + itext.
     2723      end.
     2724      else do:
     2725         icomment = if icomment begins  '"'
     2726                    then icomment
     2727                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2728         vText = icomment + "," + itext.
     2729         vText = "~{" + trim(vText,",") + "~}".
     2730      end.
     2731      return vText.
     2732   end.
     2733   function CheckTypeForMarkLineType returns logical
     2734   (iObj            as handle,
     2735    iCheckType      as character,
     2736    iCodeErr        as character ,
     2737    iTypeErr        as character ):
     2738      define variable vRecKey-markLine as character no-undo.
     2739      define variable vGoodMark        as logical no-undo.
     2740      define variable vdb-num          as integer no-undo.
     2741      define variable vdoc-id          as integer no-undo.
     2742      define variable vlinenum         as integer no-undo.
     2743      define variable vErrorOne as character no-undo.
     2744      define buffer buf_utd-err for utd-err.
     2745      run gen-key-rec (input "utd-marking-lines",
     2746                       input  iObj,
     2747                       output vRecKey-markLine).
     2748      vGoodMark = yes.
     2749      vdb-num = iObj::db-num.
     2750      vdoc-id = iObj::doc-id.
     2751      vlinenum = iObj::linenum.
     2752      block-mark-err:
     2753      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2754                               and buf_utd-err.db-num = vdb-num
     2755                               and buf_utd-err.reckey = vRecKey-markLine
     2756                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2757                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2758      no-lock:
     2759         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2760         if     vErrorOne ne ?
     2761            and vErrorOne ne ""
     2762         then do:
     2763            vGoodMark = no.
     2764            leave block-mark-err.
     2765         end.
     2766      end.
     2767      return not vGoodMark.
     2768   end.
     2769   function CheckErrForMarkLineType returns logical
     2770   (iObj            as handle,
     2771    iType           as character  ):
     2772      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2773   end.
     2774   function CheckErrForMarkLine returns logical
     2775   (iObj            as handle):
     2776      return CheckErrForMarkLineType(iObj,"*").
     2777   end.
     2778   function CheckErrForLineTypeCode returns logical
     2779   (iObj                 as handle,
     2780    iCheckType           as character,
     2781    iCodeErr             as character,
     2782    iTypeErr             as character,
     2783    iOneErr              as logical):
     2784      define variable vRecKey-line     as character no-undo.
     2785      define buffer buf_utd-err for utd-err.
     2786      define variable vUtdlineError as logical no-undo.
     2787      define variable vErrorOne as character no-undo.
     2788            run gen-key-rec (input "utd-lines",
     2789                             input  iObj,
     2790                             output vRecKey-line).
     2791         define variable vdb-num as integer no-undo.
     2792         define variable vdoc-id as integer no-undo.
     2793         define variable vlinenum as integer no-undo.
     2794         vdb-num = iObj::db-num.
     2795         vdoc-id = iObj::doc-id.
     2796         vlinenum = iObj::linenum.
     2797         block-err:
     2798         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2799                                  and buf_utd-err.db-num = vdb-num
     2800                                  and buf_utd-err.reckey = vRecKey-line
     2801                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2802                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2803         no-lock:
     2804            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2805            if     vErrorOne ne ?
     2806               and vErrorOne ne ""
     2807            then do:
     2808               vUtdlineError = yes.
     2809               leave block-err.
     2810            end.
     2811         end.
     2812         if  not vUtdlineError
     2813         then do:
     2814            define variable vGoodMark as logical no-undo.
     2815            vGoodMark = yes.
     2816            block-line-err:
     2817            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2818                                         and utd-marking-lines.doc-id  eq vdoc-id
     2819                                         and utd-marking-lines.LineNum eq vLineNum
     2820            no-lock:
     2821               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2822               if     vGoodMark
     2823                  and iOneErr eq no
     2824               then
     2825                  leave block-line-err.
     2826               if     iOneErr = yes
     2827                  and not vGoodMark
     2828               then
     2829                  leave block-line-err.
     2830            end.
     2831            vUtdlineError = not vGoodMark.
     2832         end.
     2833      return vUtdlineError.
     2834   end.
     2835   function getErrForLineType returns character
     2836   (iObj            as handle,
     2837    iType           as character  ):
     2838      define variable vRecKey-line     as character no-undo.
     2839      define buffer buf_utd-err for utd-err.
     2840      define variable vUtdlineError as logical no-undo.
     2841      define variable vErrorOne as character no-undo.
     2842      define variable oError as character no-undo.
     2843            run gen-key-rec (input "utd-lines",
     2844                             input  iObj,
     2845                             output vRecKey-line).
     2846         define variable vdb-num as integer no-undo.
     2847         define variable vdoc-id as integer no-undo.
     2848         define variable vlinenum as integer no-undo.
     2849         vdb-num = iObj::db-num.
     2850         vdoc-id = iObj::doc-id.
     2851         vlinenum = iObj::linenum.
     2852         block-err:
     2853         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2854                                  and buf_utd-err.db-num = vdb-num
     2855                                  and buf_utd-err.reckey = vRecKey-line
     2856                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2857         no-lock:
     2858            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2859            if     vErrorOne ne ?
     2860               and vErrorOne ne ""
     2861            then do:
     2862               oError = oError + vErrorOne + " ".
     2863            end.
     2864         end.
     2865      return oError.
     2866   end.
     2867   function CheckErrForLineType returns logical
     2868   (iObj            as handle,
     2869    iType           as character  ):
     2870       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2871   end.
     2872   function CheckErrForLine returns logical
     2873   (iObj            as handle):
     2874      return CheckErrForLineType(iobj,"*").
     2875   end.
     2876   function CheckErrForUtd returns logical
     2877   (idb-num         as integer ,
     2878    idoc-id         as integer ):
     2879      for each utd-lines where utd-lines.db-num eq idb-num
     2880                           and utd-lines.doc-id eq idoc-id
     2881      no-lock :
     2882         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2883         then
     2884            return no.
     2885      end.
     2886      return yes.
     2887   end.
     2888   function CheckMarkUtd-28rel return logical
     2889    (input idb-num as integer,
     2890    input idoc-id as integer):
     2891    define buffer utd                   for utd.
     2892    define buffer utd-lines             for utd-lines.
     2893    define buffer utd-marking-lines     for utd-marking-lines.
     2894    define variable v-par-type as character no-undo.
     2895    define variable vgdsNoMark as logical no-undo.
     2896    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2897      define variable v-par-val  as character no-undo.
     2898      find first utd where utd.db-num eq idb-num
     2899                       and utd.doc-id eq idoc-id
     2900      no-lock no-error.
     2901      if available utd
     2902      then do:
     2903         if     utd.obj-code ne ?
     2904            and utd.obj-type ne ?
     2905         then do:
     2906            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2907            Block-utd-lines:
     2908            for each utd-lines where utd-lines.db-num eq idb-num
     2909                                 and utd-lines.doc-id eq idoc-id
     2910            no-lock:
     2911               if     utd-lines.gds-code ne ?
     2912                  and utd-lines.gds-code ne 0
     2913               then do:
     2914                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2915                       ( utd-lines.gds-code,
     2916                         'mark-type':U,
     2917                          output v-par-val,
     2918                          output v-par-type
     2919                       ).
     2920                  if     EDOParSec:IsEdo
     2921                     and EDOParSec:GetIsEDOForType(v-par-val)
     2922                  then do:
     2923                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2924                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2925                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2926                                                    and length(utd-marking-lines.mark) > 13
     2927                     no-lock no-error.
     2928                     if     avail utd-marking-lines
     2929                        and not CheckErrForLine(buffer utd-lines:handle)
     2930                     then
     2931                        leave Block-utd-lines.
     2932                  end.
     2933                  else
     2934                     vgdsNoMark = yes.
     2935               end.
     2936            end.
     2937            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2938            if vgdsNoMark then return available utd-lines . else return yes .
     2939         end.
     2940      end.
     2941      return yes.
     2942   end.
     2943   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2944   define temp-table tt-utd-mark no-undo like utd-marking-lines
     2945     field side as character.
     2946   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2947   function CheckMarkUtd return logical
     2948    (input idb-num  as integer,
     2949     input idoc-id  as integer):
     2950     define buffer utd-lines             for ub.utd-lines.
     2951     block-line:
     2952     for each utd-lines where utd-lines.db-num eq idb-num
     2953                          and utd-lines.doc-id eq idoc-id
     2954     no-lock:
     2955        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2956        then
     2957           leave block-line.
     2958     end.
     2959     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2960     return available utd-lines.
     2961   end.
     2962   function CheckNotMarkUtd return logical
     2963    (input idb-num  as integer,
     2964     input idoc-id  as integer):
     2965     define buffer utd-lines             for ub.utd-lines.
     2966     for each utd-lines where utd-lines.db-num eq idb-num
     2967                          and utd-lines.doc-id eq idoc-id
     2968     no-lock:
     2969        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2970        then
     2971           return yes.
     2972     end.
     2973     return no.
     2974   end.
     2975   function CheckMarkUtdLine return logical
     2976    (input idb-num  as integer,
     2977     input idoc-id  as integer,
     2978     input iLineNum as integer):
     2979    define buffer utd                   for utd.
     2980    define buffer utd-lines             for utd-lines.
     2981    define buffer utd-marking-lines     for utd-marking-lines.
     2982    define variable v-par-type as character no-undo.
     2983    define variable vMarking        as logical no-undo.
     2984    define variable vArtic          as logical no-undo.
     2985    define variable vTransitional   as logical no-undo.
     2986    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2987      define variable v-par-val  as character no-undo.
     2988      find first utd where utd.db-num eq idb-num
     2989                       and utd.doc-id eq idoc-id
     2990      no-lock no-error.
     2991      if available utd
     2992      then do:
     2993         if     utd.obj-code ne ?
     2994            and utd.obj-type ne ?
     2995         then do:
     2996            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2997            Block-utd-lines:
     2998            for each utd-lines where utd-lines.db-num   eq idb-num
     2999                                 and utd-lines.doc-id   eq idoc-id
     3000                                 and utd-lines.LineNum  eq iLineNum
     3001            no-lock:
     3002               if     utd-lines.gds-code ne ?
     3003                  and utd-lines.gds-code ne 0
     3004               then do:
     3005                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3006                       ( utd-lines.gds-code,
     3007                         'mark-type':U,
     3008                          output v-par-val,
     3009                          output v-par-type
     3010                       ).
     3011                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3012                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3013                  if vMarking
     3014                  then do:
     3015                     block-marking:
     3016                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3017                                                    and utd-marking-lines.doc-id   eq idoc-id
     3018                                                    and utd-marking-lines.LineNum  eq iLineNum
     3019                                                    and length(utd-marking-lines.mark) > 13
     3020                     no-lock:
     3021                        if isOAD(utd-marking-lines.mark)
     3022                        then do:
     3023                           assign
     3024                              vArtic   = yes
     3025                              vMarking = no
     3026                           .
     3027                           leave block-marking.
     3028                        end.
     3029                     end.
     3030                  end.
     3031                  if vArtic
     3032                  then do:
     3033                     block-artic:
     3034                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3035                                                    and utd-marking-lines.doc-id   eq idoc-id
     3036                                                    and utd-marking-lines.LineNum  eq iLineNum
     3037                                                    and length(utd-marking-lines.mark) > 13
     3038                     no-lock:
     3039                        if isMark(utd-marking-lines.mark)
     3040                        then do:
     3041                           assign
     3042                              vArtic   = no
     3043                              vMarking = yes
     3044                           .
     3045                           leave block-artic.
     3046                        end.
     3047                     end.
     3048                  end.
     3049                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3050                  if vTransitional
     3051                  then do:
     3052                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3053                                                    and utd-marking-lines.doc-id   eq idoc-id
     3054                                                    and utd-marking-lines.LineNum  eq iLineNum
     3055                                                    and length(utd-marking-lines.mark) > 13
     3056                     no-lock no-error.
     3057                     if not available utd-marking-lines
     3058                     then assign
     3059                        vMarking = no
     3060                        vArtic   = no
     3061                     .
     3062                  end.
     3063               end.
     3064               else
     3065                  assign
     3066                     vMarking      = yes
     3067                     vArtic        = no
     3068                     vTransitional = no
     3069                  .
     3070               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3071               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3072               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3073            end.
     3074         end.
     3075      end.
     3076      return vMarking or vArtic.
     3077   end.
     3078   function getMarkUtdLine return logical
     3079    (input  idb-num  as integer,
     3080     input  idoc-id  as integer,
     3081     input  iLineNum as integer,
     3082     output oMarking        as logical,
     3083     output oArtic          as logical,
     3084     output oTransitional   as logical):
     3085     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3086     oArtic        = not oMarking
     3087            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3088     oTransitional = (oMarking or oArtic)
     3089            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3090   end.
     3091   function CheckMarking return logical
     3092    (input idb-num as integer,
     3093    input idoc-id as integer,
     3094    input iTypeErr as character ):
     3095     define variable vMarkutd as logical no-undo.
     3096     define variable vCrErr   as logical no-undo.
     3097     define buffer utd-lines         for utd-lines.
     3098     define buffer utd-marking-lines for utd-marking-lines.
     3099     define buffer marking           for marking.
     3100     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3101      block-line:
     3102      for each utd-lines where utd-lines.db-num eq idb-num
     3103                           and utd-lines.doc-id eq idoc-id
     3104      no-lock:
     3105         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3106         then do:
     3107            for each utd-marking-lines
     3108                     where utd-marking-lines.db-num  = utd-lines.db-num
     3109                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3110                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3111            no-lock:
     3112               if isMark(utd-marking-lines.mark)
     3113               then do:
     3114                  find first marking where marking.mark eq utd-marking-lines.mark
     3115                  no-lock no-error.
     3116                  if not available marking
     3117                  then do:
     3118                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3119                     vCrErr = yes.
     3120                     next block-line.
     3121                  end.
     3122               end.
     3123            end.
     3124         end.
     3125      end.
     3126      return vCrErr.
     3127   end.
     3128   function CheckMarkForType return logical
     3129    (input idb-num   as integer,
     3130     input idoc-id   as integer):
     3131      define variable vMarking        as logical no-undo.
     3132      define variable vArtic          as logical no-undo.
     3133      define variable vTransitional   as logical no-undo.
     3134      define buffer utd-lines         for utd-lines.
     3135      define buffer utd-marking-lines for utd-marking-lines.
     3136      block-line:
     3137      for each utd-lines where utd-lines.db-num eq idb-num
     3138                           and utd-lines.doc-id eq idoc-id
     3139      no-lock:
     3140         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3141                          output vMarking         , output vArtic          , output vTransitional).
     3142         for each utd-marking-lines
     3143                     where utd-marking-lines.db-num  = utd-lines.db-num
     3144                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3145                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3146         no-lock:
     3147            if length(utd-marking-lines.mark) < 14
     3148            then do:
     3149               if (vMarking or vArtic) and not vTransitional
     3150               then
     3151                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3152            end.
     3153            else if not isMark(utd-marking-lines.mark)
     3154            then do:
     3155               if vMarking
     3156               then
     3157                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3158            end.
     3159            else do:
     3160            end.
     3161         end.
     3162      end.
     3163   end.
     3164   function WeighedProd return logical
     3165      ( input p-gds-code as integer) :
     3166      define variable v-par-val  as character no-undo.
     3167      define variable v-par-type as character no-undo.
     3168              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3169               ( p-gds-code,
     3170                 'weighed-gds':U,
     3171                  output v-par-val,
     3172                  output v-par-type
     3173               ).
     3174      return logical(v-par-val).
     3175   end.
     3176   function WghProdVariable return logical
     3177       (input p-obj-type as char,
     3178        input p-obj-code as integer,
     3179        input p-gds-code as integer) :
     3180      define variable v-wgh-val  as character no-undo.
     3181      define variable v-par-val  as character no-undo.
     3182      define variable v-par-type as character no-undo.
     3183      define variable vMarking        as logical no-undo.
     3184      define variable vArtic          as logical no-undo.
     3185      define variable vTransitional   as logical no-undo.
     3186      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3187         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3188           ( p-gds-code,
     3189             'weighed-gds':U,
     3190              output v-wgh-val,
     3191              output v-par-type
     3192           ).
     3193       if logical(v-wgh-val) = yes then do:
     3194           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3195               ( p-gds-code,
     3196                 'mark-type':U,
     3197                  output v-par-val,
     3198                  output v-par-type
     3199               ).
     3200           if v-par-val <> "" then do:
     3201               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3202               assign
     3203                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3204                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3205                  .
     3206           end.
     3207      end.
     3208      if v-wgh-val > "" and (vMarking or vArtic)
     3209      then return yes.
     3210      else return no.
     3211   end.
     3212   function MarkWeight return decimal
     3213      ( input p-mark as character) :
     3214      define buffer  buf_marking-attr for  ub.marking-attr.
     3215      define variable vMarkWeight as decimal no-undo.
     3216      vMarkWeight = 0.
     3217      if p-mark <> "" and p-mark <> ?
     3218      then do:
     3219          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3220                                        and buf_marking-attr.attr-code eq "weight"
     3221             no-lock no-error.
     3222          if not available buf_marking-attr
     3223          then do :
     3224            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3225                                          and buf_marking-attr.attr-code eq "weight"
     3226               no-lock no-error.
     3227          end .
     3228          if avail buf_marking-attr
     3229          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3230      end.
     3231      return vMarkWeight.
     3232   end.
     3233   function CheckQnty returns logical
     3234   (  input idb-num  as integer,
     3235      input idoc-id  as integer,
     3236      input iErrType as character
     3237   ):
     3238      if iErrType ne "loadUTD"
     3239      then do:
     3240         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3241         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3242         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3243      end.
     3244      if iErrType ne "CheckQnty"
     3245      then do:
     3246         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3247         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3248         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3249      end.
     3250      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3251      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3252      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3253      define buffer marking               for marking.
     3254      define buffer utd-lines             for utd-lines.
     3255      define buffer utd-marking-lines     for utd-marking-lines.
     3256      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3257      block-line:
     3258      for each utd-lines where utd-lines.db-num eq idb-num
     3259                           and utd-lines.doc-id eq idoc-id
     3260      no-lock:
     3261         define variable Vflagmark as logical no-undo.
     3262         find first buf_utd-marking-lines
     3263                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3264                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3265                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3266                         and length(buf_utd-marking-lines.mark) > 13
     3267         no-lock no-error.
     3268         if not available buf_utd-marking-lines
     3269         then
     3270            next block-line.
     3271         define variable vqntyMark as integer no-undo.
     3272         define variable vqntyOAD  as integer no-undo.
     3273         vqntyMark = 0.
     3274         vqntyOAD  = 0.
     3275         block-mark:
     3276         for each utd-marking-lines
     3277              where utd-marking-lines.db-num  = utd-lines.db-num
     3278                and utd-marking-lines.doc-id  = utd-lines.doc-id
     3279                and utd-marking-lines.LineNum = utd-lines.LineNum
     3280                and length(utd-marking-lines.mark) > 13
     3281                and utd-marking-lines.doc-level  = 1
     3282         no-lock:
     3283            if isMark(utd-marking-lines.mark)
     3284            then do:
     3285               find first marking where marking.mark eq utd-marking-lines.mark
     3286               no-lock no-error.
     3287               if available marking
     3288               then do:
     3289                  if marking.box-qnty ne ?
     3290                  then
     3291                     vqntyMark = vqntyMark + marking.box-qnty.
     3292               end.
     3293            end.
     3294            else do:
     3295               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     3296                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     3297                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     3298                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     3299                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     3300               no-lock no-error.
     3301               if available utd-marking-lines-attr
     3302               then
     3303                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     3304            end.
     3305         end.
     3306         if     utd-lines.gds-code   gt 0
     3307            and utd-lines.gds-code   ne ?
     3308            and vqntyMark            ne 0
     3309         then do:
     3310            if utd-lines.Quantity  < vqntyMark
     3311            then
     3312               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3313            else if utd-lines.Quantity  <> vqntyMark
     3314            then
     3315               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3316         end.
     3317         else if     utd-lines.gds-code   gt 0
     3318            and utd-lines.gds-code   ne ?
     3319            and vqntyOAD ne 0
     3320            and utd-lines.Quantity  ne vqntyOAD
     3321         then
     3322            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     3323      end.
     3324   end.
     3325   function CheckGds returns logical
     3326   (  input idb-num   as integer,
     3327      input idoc-id   as integer,
     3328      input iobj-type as character,
     3329      input iobj-code as integer,
     3330      input iErrType as character
     3331   ):
     3332      if iErrType ne "loadUTD"
     3333      then do:
     3334         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     3335         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     3336         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     3337         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3338         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     3339         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     3340         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     3341         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     3342         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     3343         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     3344         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     3345      end.
     3346      if iErrType ne "CheckGds"
     3347      then do:
     3348         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     3349         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     3350         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     3351         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     3352         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     3353         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     3354         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     3355         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     3356         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     3357         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     3358         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     3359      end.
     3360      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     3361      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     3362      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     3363      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3364      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     3365      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     3366      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     3367      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     3368      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     3369      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     3370      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     3371      define variable v-par-type as character no-undo.
     3372      define variable v-par-val  as character no-undo.
     3373      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3374      define buffer marking               for marking.
     3375      define buffer utd-lines             for utd-lines.
     3376      define buffer buf_utd-lines         for utd-lines.
     3377      define buffer utd-marking-lines     for utd-marking-lines.
     3378      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3379      define variable vGdsCode as integer no-undo.
     3380      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     3381      block-line:
     3382      for each utd-lines where utd-lines.db-num eq idb-num
     3383                           and utd-lines.doc-id eq idoc-id
     3384      no-lock:
     3385         vGdsCode = ?.
     3386         define variable Vflagmark as logical no-undo.
     3387         define variable VflagOAD  as logical no-undo.
     3388         assign
     3389            Vflagmark = no
     3390            VflagOAD = no
     3391         .
     3392         block-mark:
     3393         for each utd-marking-lines
     3394                  where utd-marking-lines.db-num  = utd-lines.db-num
     3395                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3396                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3397         no-lock:
     3398            if    isMark(utd-marking-lines.mark)
     3399               or isOAD (utd-marking-lines.mark)
     3400            then do:
     3401               define variable vnewGdsCode as integer no-undo.
     3402               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     3403               if isMark(utd-marking-lines.mark)
     3404               then do:
     3405                  Vflagmark = yes.
     3406                  find first marking where marking.mark eq utd-marking-lines.mark
     3407                  no-lock no-error.
     3408                  if not available marking
     3409                  then do:
     3410                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     3411                     next block-mark.
     3412                  end.
     3413                  if vnewGdsCode eq ?
     3414                  then
     3415                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     3416                  if    marking.gds-code eq 0
     3417                     or marking.gds-code eq ?
     3418                     or marking.sts eq 0
     3419                     or marking.sts eq ?
     3420                     or marking.box-qnty eq ?
     3421                     or (marking.gds-code ne vnewGdsCode
     3422                         and vnewGdsCode ne ?
     3423                         and vnewGdsCode ne 0)
     3424                  then do:
     3425                     find first marking where marking.mark eq utd-marking-lines.mark
     3426                     exclusive-lock no-error.
     3427                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     3428                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     3429                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     3430                     if    marking.gds-ext-id eq ""
     3431                        or marking.gds-ext-id eq ?
     3432                     then do:
     3433                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     3434                     end.
     3435                     else if    marking.gds-code eq 0
     3436                             or marking.gds-code eq ?
     3437                     then
     3438                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     3439                     else if     marking.sts eq 0
     3440                             or  marking.sts eq ?
     3441                     then
     3442                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     3443                  end.
     3444                  if utd-marking-lines.doc-level eq 1
     3445                  then do:
     3446                     if marking.box-qnty eq ?
     3447                     then
     3448                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3449                  end.
     3450               end.
     3451               else do:
     3452                  VflagOAD = yes.
     3453                  define variable vQnty as decimal no-undo.
     3454                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     3455                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     3456                                          utd-marking-lines.doc-id,
     3457                                          utd-marking-lines.LineNum,
     3458                                          utd-marking-lines.mark,
     3459                                          "box-qnty",
     3460                                           string(vQnty)).
     3461                  define variable vgtin as character no-undo.
     3462                  vgtin = getGtinByDM(utd-marking-lines.mark).
     3463                  if getQntyCodeByGtin(vgtin) ne 1
     3464                  then
     3465                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     3466               end.
     3467               if utd-marking-lines.gds-code ne vnewGdsCode
     3468               and vnewGdsCode ne ?
     3469               and vnewGdsCode ne 0
     3470               then do:
     3471                  find first buf_utd-marking-lines
     3472                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3473                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3474                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3475                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3476                  exclusive-lock no-error.
     3477                  if available buf_utd-marking-lines
     3478                  then do:
     3479                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     3480                  end.
     3481               end.
     3482            end.
     3483            else  do:
     3484               define variable vgdsbar as integer no-undo.
     3485               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     3486               if    utd-marking-lines.gds-code ne vgdsbar
     3487               then do:
     3488                  find first buf_utd-marking-lines
     3489                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3490                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3491                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3492                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3493                  exclusive-lock no-error.
     3494                  if available buf_utd-marking-lines
     3495                  then do:
     3496                     buf_utd-marking-lines.gds-code = vgdsbar.
     3497                  end.
     3498               end.
     3499               if vgdsbar ne ?
     3500               then do:
     3501                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3502                            ( vgdsbar,
     3503                              'mark-type':U,
     3504                              output v-par-val,
     3505                              output v-par-type
     3506                             ).
     3507                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     3508                       or  EDOParSec:GetIsArticForType(v-par-val))
     3509                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     3510                   and     EDOParSec:IsEdo
     3511                  then do:
     3512                     AddUtdErr(utd-marking-lines.db-num,
     3513                               utd-marking-lines.doc-id,
     3514                               buffer utd-marking-lines:handle,
     3515                               iErrType,
     3516                               "MarkingForTypeEDO",
     3517                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3518                  end.
     3519               end.
     3520            end.
     3521            if vGdsCode eq ?
     3522            then
     3523               vGdsCode = utd-marking-lines.gds-code.
     3524            if vGdsCode ne utd-marking-lines.gds-code
     3525            and utd-marking-lines.gds-code > 0
     3526            then do:
     3527               vGdsCode = -1.
     3528            end.
     3529         end.
     3530         if  vGdsCode = -1
     3531         then do:
     3532            vGdsCode = ?.
     3533            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     3534            next block-line.
     3535         end.
     3536         if vGdsCode ne ?
     3537         then do:
     3538                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3539                      ( vGdsCode,
     3540                        'mark-type':U,
     3541                        output v-par-val,
     3542                        output v-par-type
     3543                       ).
     3544            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     3545                and(
     3546                 (    EDOParSec:GetIsEDOForType(v-par-val)
     3547                     and not Vflagmark)
     3548                 or  (EDOParSec:GetIsArticForType(v-par-val)
     3549                     and not VflagOAD
     3550                     and not Vflagmark))
     3551            then do:
     3552               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     3553            end.
     3554         end.
     3555         if utd-lines.gds-code ne vGdsCode
     3556         then do:
     3557            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3558                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3559                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     3560            exclusive-lock no-error.
     3561            if available buf_utd-lines
     3562            then
     3563               buf_utd-lines.gds-code = vGdsCode.
     3564            release buf_utd-lines.
     3565         end.
     3566         define variable VBarCode as character no-undo.
     3567         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     3568         if VBarCode ne ?
     3569         then do:
     3570            if num-entries(VBarCode," ") > 0
     3571            then
     3572               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     3573            vgdsbar = GetGdsCodeByGtin(VBarCode).
     3574            if vgdsbar eq ? or vgdsbar eq 0
     3575            then do:
     3576               AddUtdErr(utd-lines.db-num,
     3577                         utd-lines.doc-id,
     3578                         buffer utd-lines:handle,
     3579                         iErrType,
     3580                         "NotFindGdsForBarCode",
     3581                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     3582            end.
     3583            else do:
     3584               if    utd-lines.gds-code eq ?
     3585                  or utd-lines.gds-code eq 0
     3586               then do:
     3587                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3588                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3589                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3590                  exclusive-lock no-error.
     3591                  if available buf_utd-lines
     3592                  then
     3593                     buf_utd-lines.gds-code = vgdsbar.
     3594                  release buf_utd-lines.
     3595               end.
     3596               else if utd-lines.gds-code ne vgdsbar
     3597               then do:
     3598                  AddUtdErr(utd-lines.db-num,
     3599                         utd-lines.doc-id,
     3600                         buffer utd-lines:handle,
     3601                         iErrType,
     3602                         "NotEqGgsForLineAndMark",
     3603                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     3604               end.
     3605            end.
     3606         end.
     3607         if vGdsCode eq ? and utd-lines.gds-code eq ?
     3608         then
     3609            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     3610      end.
     3611   end.
     3612   function GetUtdLineForOrig return logical
     3613   (input idb-num as integer,
     3614    input idoc-id as integer,
     3615    input ilineNum as integer,
     3616    input idb-numOrig as integer,
     3617    input idoc-idOrig as integer,
     3618    buffer edoc-lines for utd-lines):
     3619      define buffer edoc-marking-lines for ub.utd-marking-lines.
     3620      block-mark:
     3621      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     3622                                   and utd-marking-lines.doc-id  eq idoc-id
     3623                                   and utd-marking-lines.LineNum eq iLineNum
     3624                                   and utd-marking-lines.site eq "-"
     3625      no-lock:
     3626         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     3627                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     3628                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     3629                     no-lock no-error.
     3630         if available edoc-marking-lines
     3631         then do:
     3632            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     3633                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     3634                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     3635            no-lock no-error.
     3636               leave block-mark.
     3637          end.
     3638      end.
     3639       if not available edoc-lines
     3640       then do:
     3641          find  first  utd-lines where utd-lines.db-num      = idb-num
     3642                                   and utd-lines.doc-id      = idoc-id
     3643                                   and utd-lines.LineNum     = ilinenum
     3644             no-lock no-error.
     3645          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3646                                  and edoc-lines.doc-id      = idoc-idOrig
     3647                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     3648          no-lock no-error.
     3649       end.
     3650       if not available edoc-lines
     3651       then
     3652          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3653                                  and edoc-lines.doc-id      = idoc-idOrig
     3654                                  and edoc-lines.gds-code    = utd-lines.gds-code
     3655          no-lock no-error.
     3656   end.
     3657   function GetLastUTDinPack returns logical
     3658   (input idb-num as integer,
     3659    input idoc-id as integer,
     3660    output odb-num as integer,
     3661    output odoc-id as integer ) forward.
     3662   function getObgFns return logical
     3663   (input iDocumentNumber   as character ,
     3664    input iFnsParticipantId as character ,
     3665    input ikpp              as character ,
     3666    output ohost-code       as integer,
     3667    output oobj-type        as character ,
     3668    output oobj-code        as integer ,
     3669    output otext            as character  ):
     3670       define buffer ext-classif   for ext-classif.
     3671       define buffer clients       for clients.
     3672       define buffer buf_clients   for clients.
     3673       define buffer clients-attr  for clients-attr.
     3674       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3675                                and ext-classif.charkey_three eq iFnsParticipantId
     3676       no-lock no-error.
     3677       if available ext-classif
     3678       then do:
     3679          if ext-classif.CharKey_One eq 'маг':U
     3680          then do:
     3681             assign
     3682                oobj-type = ext-classif.CharKey_One
     3683                oobj-code = ext-classif.Key#_One
     3684             .
     3685             find first clients
     3686                  where clients.obj-type   = ext-classif.CharKey_One
     3687                    and clients.obj-code   = ext-classif.Key#_One
     3688             no-lock no-error .
     3689             if available clients
     3690             then
     3691                ohost-code =  clients.host-code.
     3692          end.
     3693          else do:
     3694             find first clients
     3695                  where clients.obj-type   = ext-classif.CharKey_One
     3696                    and clients.obj-code   = ext-classif.Key#_One
     3697                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     3698             no-lock no-error .
     3699             if not available clients
     3700             then do:
     3701                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     3702                return no.
     3703             end.
     3704             ohost-code = ext-classif.Key#_One.
     3705             block-cl:
     3706             for each clients-attr
     3707                where clients-attr.attr-code  = 'kpp':U
     3708                  and clients-attr.obj-type   = 'маг':U
     3709                  and clients-attr.attr-value = ikpp
     3710                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     3711                                             and buf_clients.obj-code   = clients-attr.obj-code
     3712                                             and buf_clients.host-code  = ohost-code)
     3713             no-lock :
     3714                leave block-cl.
     3715             end.
     3716             if     available clients
     3717                and clients.obj-type eq 'маг':U
     3718             then do:
     3719                assign
     3720                   oobj-type = clients.obj-type
     3721                   oobj-code = clients.obj-code
     3722                .
     3723             end.
     3724             else if available clients-attr
     3725             then do:
     3726                assign
     3727                   oobj-type = clients-attr.obj-type
     3728                   oobj-code = clients-attr.obj-code
     3729                .
     3730             end.
     3731             else do:
     3732                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     3733                return yes.
     3734             end.
     3735          end.
     3736       end.
     3737       else do:
     3738          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     3739          return no.
     3740       end.
     3741       return ?.
     3742   end.
     3743   function CheckUcdForReturn return logical
     3744   (input idb-numUcd as integer,
     3745    input idoc-idUcd as integer,
     3746    input idb-numRet as integer,
     3747    input idoc-idRet as integer  ):
     3748       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     3749                                    and utd-marking-lines.doc-id eq idoc-idUcd
     3750                                    and utd-marking-lines.doc-level eq 1
     3751       no-lock:
     3752          create tt-utd-mark.
     3753          buffer-copy utd-marking-lines to tt-utd-mark
     3754          assign
     3755             tt-utd-mark.side = "+"
     3756          .
     3757       end.
     3758       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     3759                                    and utd-marking-lines.doc-id eq idoc-idRet
     3760                                    and utd-marking-lines.doc-level eq 1
     3761       no-lock:
     3762          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     3763          no-lock no-error.
     3764          if available tt-utd-mark
     3765          then
     3766             tt-utd-mark.side = "".
     3767          else do:
     3768             create tt-utd-mark.
     3769             buffer-copy utd-marking-lines to tt-utd-mark
     3770             assign
     3771                tt-utd-mark.side = "-"
     3772             .
     3773          end.
     3774       end.
     3775       for each tt-utd-mark where  tt-utd-mark.side ne ""
     3776       no-lock:
     3777          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     3778       end.
     3779       for each tt-utd-mark:
     3780          delete tt-utd-mark.
     3781       end.
     3782   end.
     3783   function GetLastUTDinPackAft returns logical
     3784   (input idb-num as integer,
     3785    input idoc-id as integer,
     3786    output odb-num as integer,
     3787    output odoc-id as integer ) forward.
     3788   function SaturateAndCheckUTD return character
     3789   (input idb-num as integer,
     3790    input idoc-id as integer  ):
     3791      define buffer clients-attr          for clients-attr.
     3792      define buffer clients               for clients.
     3793      define buffer Utd                   for Utd.
     3794      define buffer utd_ret               for ub.utd.
     3795      define buffer utd-lines             for utd-lines.
     3796      define buffer buf_utd-lines         for utd-lines.
     3797      define buffer buf_utddoc-lines      for utd-lines.
     3798      define buffer marking               for marking.
     3799      define buffer marking-lines         for marking-lines.
     3800      define buffer utd-marking-lines     for utd-marking-lines.
     3801      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3802      define buffer contract              for contract.
     3803      define buffer old_utd               for Utd.
     3804      define variable vError as character no-undo.
     3805      define variable vGdsCode as integer no-undo.
     3806      define variable vcli-type as character no-undo.
     3807      define variable vcli-code as integer no-undo.
     3808      define variable vhost-code as integer no-undo init ?.
     3809      define variable vcontract-code as integer no-undo.
     3810      define variable vobj-type as character no-undo init ?.
     3811      define variable vobj-code as integer no-undo init ?.
     3812      define variable volddb-num as integer no-undo.
     3813      define variable volddoc-id as integer no-undo.
     3814      define variable vMark as logical no-undo.
     3815      define variable VUcd as logical no-undo.
     3816      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3817      define variable v-par-type as character no-undo.
     3818      define variable v-par-val  as character no-undo.
     3819      define variable VFileMark as logical no-undo.
     3820      define variable vunit     as int no-undo.
     3821      define variable vunitCode as character no-undo.
     3822      define variable vMarkingUtd as logical no-undo.
     3823      find first Utd where utd.db-num eq idb-num
     3824                       and utd.doc-id eq idoc-id
     3825      no-lock no-error.
     3826      if available Utd
     3827      then do:
     3828         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     3829         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     3830         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     3831         assign
     3832               vobj-type  = utd.obj-type
     3833               vobj-code  = utd.obj-code
     3834               vhost-code = utd.host-code
     3835         .
     3836         do:
     3837            define variable vtext       as character no-undo.
     3838            define variable vhost-code1 as integer   no-undo.
     3839            define variable vobj-type1  as character no-undo.
     3840            define variable vobj-code1  as integer   no-undo.
     3841             getObgFns
     3842                       (input utd.DocumentNumber ,
     3843                        input utd.obj-FnsParticipantId ,
     3844                        input utd.obj-kpp,
     3845                        output vhost-code1,
     3846                        output vobj-type1,
     3847                        output vobj-code1,
     3848                        output vtext ).
     3849            assign
     3850               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     3851               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     3852               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     3853            .
     3854            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     3855            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     3856            block-line:
     3857            for each utd-lines where utd-lines.db-num eq utd.db-num
     3858                                 and utd-lines.doc-id eq utd.doc-id
     3859            no-lock:
     3860               vGdsCode =?.
     3861               define variable vNotMarkForLine as logical no-undo.
     3862               vNotMarkForLine = no.
     3863               if not VUcd
     3864               then do:
     3865                  find first utd-marking-lines
     3866                       where utd-marking-lines.db-num  = utd-lines.db-num
     3867                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     3868                         and utd-marking-lines.LineNum = utd-lines.LineNum
     3869                  no-lock no-error.
     3870                  if not available utd-marking-lines
     3871                  then do:
     3872                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     3873                     vNotMarkForLine = yes.
     3874                  end.
     3875               end.
     3876               block-mark:
     3877               for each utd-marking-lines
     3878                  where utd-marking-lines.db-num  = utd-lines.db-num
     3879                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3880                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3881               no-lock:
     3882                  vMark = yes.
     3883                  if     isMark(utd-marking-lines.mark)
     3884                     and utd-marking-lines.gds-code  ne 0
     3885                     and utd-marking-lines.gds-code ne ?
     3886                  then do:
     3887                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3888                           ( utd-marking-lines.gds-code,
     3889                            'mark-type':U,
     3890                            output v-par-val,
     3891                            output v-par-type
     3892                            ).
     3893                      if     not VFileMark
     3894                         and not VUcd
     3895                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     3896                      then do:
     3897                          AddUtdErr(utd.db-num,
     3898                                     utd.doc-id,
     3899                                     buffer utd-marking-lines:handle,
     3900                                     "loadUtd",
     3901                                     "NotON_NSCHFDOPPRMARK",
     3902                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3903                     end.
     3904                  end.
     3905               end.
     3906               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     3907               then do :
     3908                  if     VUcd
     3909                  then do:
     3910                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     3911                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     3912                     if available buf_utddoc-lines
     3913                     then do:
     3914                        vGdsCode = buf_utddoc-lines.gds-code.
     3915                        vunitCode = buf_utddoc-lines.UnitCode.
     3916                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     3917                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3918                        then
     3919                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3920                               "loadUtd",
     3921                               "UcdUnitChangForUtd",
     3922                               string(utd-lines.LineNum )                  + chr(4) +
     3923                               buf_utddoc-lines.UnitCode                   + chr(4) +
     3924                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3925                     end.
     3926                     if     utd-lines.UnitCode ne ?
     3927                        and utd-lines.UnitCode ne ""
     3928                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3929                     then
     3930                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3931                               "loadUtd",
     3932                               "UcdUnitChang",
     3933                               string(utd-lines.LineNum )                  + chr(4) +
     3934                               utd-lines.UnitCode                          + chr(4) +
     3935                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3936                  end.
     3937               end.
     3938               else
     3939                  vGdsCode = utd-lines.gds-code.
     3940               define variable vValText as character no-undo.
     3941               define variable vValDec  as decimal no-undo.
     3942               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     3943               if VValText = ?
     3944               then do:
     3945                  vValDec = utd-lines.Quantity.
     3946                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     3947               end.
     3948               else
     3949                  vValDec = dec(VValText).
     3950               release bar-code .
     3951               if     vGdsCode > 0 and vGdsCode ne ?
     3952               then do:
     3953                  assign
     3954                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     3955                     vunit = ?
     3956                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     3957                  no-error.
     3958                  if vunit ne 0 and vunit ne ?
     3959                  then do:
     3960                     find units where units.OKEI eq vunit no-lock no-error.
     3961                     if available units
     3962                     then
     3963                        vunitCode = units.unit-name.
     3964                  end.
     3965                  find first bar-code where bar-code.gds-code eq vGdsCode
     3966                                        and bar-code.unit-cli eq vUnitCode
     3967                  no-lock no-error.
     3968                  if not available bar-code
     3969                  then
     3970                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3971                               "loadUtd",
     3972                               "Unit",
     3973                               string(utd-lines.LineNum )                  + chr(4) +
     3974                               string(vGdsCode)                            + chr(4) +
     3975                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     3976                               vunitCode).
     3977               end.
     3978               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     3979               then do:
     3980                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3981                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3982                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3983                  exclusive-lock no-error.
     3984                  if available buf_utd-lines
     3985                  then do:
     3986                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     3987                     release buf_utd-lines.
     3988                  end.
     3989               end.
     3990               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     3991               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     3992               if     not VUcd
     3993                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     3994               then
     3995                  vMarkingUtd = yes .
     3996            end.
     3997            if not VUcd
     3998            then
     3999               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     4000            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     4001                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     4002            no-lock no-error.
     4003            if available ext-classif
     4004            then
     4005               assign
     4006                  vcli-type = ext-classif.CharKey_One
     4007                  vcli-code = ext-classif.Key#_One
     4008               .
     4009            else do:
     4010               assign
     4011                 vcli-type = ?
     4012                 vcli-code = ?
     4013               .
     4014               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     4015            end.
     4016            find first contract  where contract.host-code eq vhost-code
     4017                                   and contract.cli-type  eq vcli-type
     4018                                   and contract.cli-code  eq vcli-code
     4019                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     4020            no-lock no-error.
     4021            define variable VContractEdo as logical no-undo init yes.
     4022            if available contract
     4023            then do:
     4024               assign
     4025                  VContractEdo = contract.whole-send-news > 0
     4026                  vcontract-code = contract.contract-code
     4027               .
     4028               if not VContractEdo
     4029               then
     4030                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     4031            end.
     4032            else do:
     4033               vcontract-code = ?.
     4034            end.
     4035         end.
     4036         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     4037         then do:
     4038            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     4039         end.
     4040         define variable vdoc-code as character no-undo init ?.
     4041         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4042         then do:
     4043            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4044                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4045                                 and utd_ret.Timestamp             le utd.Timestamp
     4046                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4047            no-lock no-error.
     4048            if available utd_ret
     4049            then do:
     4050               vdoc-code = utd_ret.doc-code.
     4051               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     4052            end.
     4053         end.
     4054      end.
     4055      find current utd exclusive-lock no-error.
     4056      if available utd
     4057      then do:
     4058         assign
     4059            utd.cli-type      = vcli-type      when vcli-type      ne ?
     4060            utd.cli-code      = vcli-code      when vcli-type      ne ?
     4061            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     4062            utd.contract-code = vcontract-code when vcontract-code ne ?
     4063            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     4064            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     4065            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     4066         .
     4067         if   ( utd.contract-code eq ?
     4068            or utd.contract-code eq 0)
     4069            and not vucd
     4070         then
     4071            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     4072         if utd.host-code eq ?
     4073            or utd.host-code eq 0
     4074         then
     4075            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     4076         if utd.obj-code eq ?
     4077            or utd.obj-code eq 0
     4078         then
     4079            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     4080      end.
     4081      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     4082      if vError eq ""
     4083      then do:
     4084         if utd.sts eq 0 or utd.sts eq ?
     4085         then
     4086            utd.sts = if VUcd
     4087                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     4088                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4089         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     4090         then do:
     4091            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4092         end.
     4093         if     not VUcd
     4094            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     4095         then do:
     4096            if not vMarkingUtd
     4097            then
     4098               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     4099         end.
     4100      end.
     4101      else do:
     4102         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     4103         then
     4104            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     4105      end.
     4106      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4107         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     4108      then
     4109         utd.sts-edi = ?.
     4110      else if     (not vMark and  not vucd) or not VContractEdo
     4111              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4112      then
     4113         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     4114      release utd no-error.
     4115      if error-status:error
     4116      then
     4117         return error return-value.
     4118      return vError.
     4119   end.
     4120   function ReCheckload returns logical
     4121   (idb-num as integer,
     4122    idoc-id as integer,
     4123    iload   as logical ):
     4124      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4125      define buffer buf_c-utd for ub.c-utd .
     4126      define buffer buf_utd   for ub.utd .
     4127      find first buf_utd where buf_utd.db-num eq idb-num
     4128                           and buf_utd.doc-id eq idoc-id
     4129      exclusive-lock no-error.
     4130      if available buf_utd
     4131      then do:
     4132         if    iload
     4133            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     4134         then do:
     4135            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     4136            if  error-status:error then
     4137            do:
     4138               message return-value view-as alert-box.
     4139            end.
     4140         end.
     4141         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4142            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4143            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     4144            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     4145         then do:
     4146            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     4147                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     4148                                              buf_c-utd.sts    eq buf_utd.sts and
     4149                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     4150            no-error .
     4151            if available (buf_c-utd)
     4152            then do:
     4153               buf_utd.sts = buf_c-utd.sts .
     4154               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4155            end.
     4156            else do:
     4157               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4158                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4159               then
     4160                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4161               else
     4162                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4163               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4164            end.
     4165         end.
     4166         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4167         then do:
     4168            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4169                                     input buf_utd.doc-id) .
     4170         end.
     4171      end.
     4172      release buf_utd.
     4173      unsubscribe "getNextseq".
     4174   end.
     4175   function ReCheck returns logical
     4176   (idb-num as integer,
     4177    idoc-id as integer ):
     4178      ReCheckload(idb-num,idoc-id,no).
     4179   end.
     4180   function GetLastUTDForPac returns logical
     4181   (iPackegeId as character ,
     4182    iTimestamp as datetime,
     4183    output odb-num as integer,
     4184    output odoc-id as integer ):
     4185      define buffer buf_utd for utd.
     4186      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4187                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4188                                and Buf_utd.Timestamp gt iTimestamp
     4189      no-lock no-error.
     4190      if available  buf_utd
     4191      then
     4192         assign
     4193            odb-num = buf_utd.db-num
     4194            odoc-id = buf_utd.doc-id
     4195         no-error.
     4196      else
     4197         assign
     4198            odb-num = ?
     4199            odoc-id = ?
     4200         no-error.
     4201   end.
     4202   function GetprevUTDForPac returns logical
     4203   (iPackegeId as character ,
     4204    iTimestamp as datetime,
     4205    output odb-num as integer,
     4206    output odoc-id as integer ):
     4207      define buffer buf_utd for utd.
     4208      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4209                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4210                                and Buf_utd.Timestamp < iTimestamp
     4211      no-lock no-error.
     4212      if available  buf_utd
     4213      then
     4214         assign
     4215            odb-num = buf_utd.db-num
     4216            odoc-id = buf_utd.doc-id
     4217         no-error.
     4218      else
     4219         assign
     4220            odb-num = ?
     4221            odoc-id = ?
     4222         no-error.
     4223   end.
     4224   function GetLastUTDinPackAft returns logical
     4225   (input idb-num as integer,
     4226    input idoc-id as integer,
     4227    output odb-num as integer,
     4228    output odoc-id as integer ):
     4229      define buffer buf_utd for utd.
     4230      define buffer     utd for utd.
     4231      find first utd where utd.db-num eq idb-num
     4232                       and utd.doc-id eq idoc-id
     4233      no-lock no-error.
     4234      if available utd
     4235      then do:
     4236         if utd.PackageId eq ""
     4237         then do:
     4238            assign
     4239               odb-num = utd.db-num
     4240               odoc-id = utd.doc-id
     4241            .
     4242            return yes.
     4243         end.
     4244         else do:
     4245            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4246            if    odb-num eq ?
     4247               or odoc-id eq ?
     4248            then do:
     4249               assign
     4250                  odb-num = utd.db-num
     4251                  odoc-id = utd.doc-id
     4252               .
     4253               return yes.
     4254            end.
     4255            else
     4256               return odoc-id = utd.doc-id.
     4257         end.
     4258      end.
     4259      return ?.
     4260   end.
     4261   function GetLastUTDinPackbef returns logical
     4262   (input idb-num as integer,
     4263    input idoc-id as integer,
     4264    output odb-num as integer,
     4265    output odoc-id as integer ):
     4266      define buffer buf_utd for utd.
     4267      define buffer     utd for utd.
     4268      find first utd where utd.db-num eq idb-num
     4269                       and utd.doc-id eq idoc-id
     4270      no-lock no-error.
     4271      if available utd
     4272      then do:
     4273         if utd.PackageId eq ""
     4274         then do:
     4275            assign
     4276               odb-num = utd.db-num
     4277               odoc-id = utd.doc-id
     4278            .
     4279            return yes.
     4280         end.
     4281         else do:
     4282            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4283            if    odb-num eq ?
     4284               or odoc-id eq ?
     4285            then do:
     4286               assign
     4287                  odb-num = utd.db-num
     4288                  odoc-id = utd.doc-id
     4289               .
     4290               return yes.
     4291            end.
     4292            else
     4293               return odoc-id = utd.doc-id.
     4294         end.
     4295      end.
     4296      return ?.
     4297   end.
     4298   function GetLastUTDinPack returns logical
     4299   (input idb-num as integer,
     4300    input idoc-id as integer,
     4301    output odb-num as integer,
     4302    output odoc-id as integer ):
     4303      define buffer buf_utd for utd.
     4304      define buffer     utd for utd.
     4305      find first utd where utd.db-num eq idb-num
     4306                       and utd.doc-id eq idoc-id
     4307      no-lock no-error.
     4308      if available utd
     4309      then do:
     4310         if utd.PackageId eq ""
     4311         then do:
     4312            assign
     4313               odb-num = utd.db-num
     4314               odoc-id = utd.doc-id
     4315            .
     4316            return yes.
     4317         end.
     4318         else do:
     4319            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     4320            if    odb-num eq ?
     4321               or odoc-id eq ?
     4322            then do:
     4323               assign
     4324                  odb-num = utd.db-num
     4325                  odoc-id = utd.doc-id
     4326               .
     4327               return yes.
     4328            end.
     4329            else
     4330               return odoc-id = utd.doc-id.
     4331         end.
     4332      end.
     4333      return ?.
     4334   end.
     4335   function delMark returns logical
     4336   ( buffer utd-marking-lines for utd-marking-lines ):
     4337      define buffer buf_utd-marking-line for utd-marking-lines.
     4338      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4339         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4340                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4341                                           and buf_utd-marking-line.mark      eq marking.mark
     4342         no-lock no-error.
     4343         if available  buf_utd-marking-line
     4344         then do:
     4345            delMark(buffer buf_utd-marking-line).
     4346            delete buf_utd-marking-line.
     4347         end.
     4348      end.
     4349   end.
     4350   function addMark returns logical
     4351   ( buffer utd-marking-lines for utd-marking-lines ):
     4352      define buffer buf_utd-marking-line for utd-marking-lines.
     4353      define buffer par_utd-marking-line for utd-marking-lines.
     4354      define buffer buf_utd for ub.utd .
     4355      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4356         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4357                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4358                                           and buf_utd-marking-line.mark      eq marking.mark
     4359         no-lock no-error.
     4360         if available  buf_utd-marking-line
     4361         then do:
     4362            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     4363            then do:
     4364               find current  buf_utd-marking-line exclusive-lock no-error.
     4365               if available buf_utd-marking-line
     4366               then
     4367                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     4368            end.
     4369         end.
     4370         else do:
     4371            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     4372                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     4373                                         no-error .
     4374            create buf_utd-marking-line.
     4375            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     4376            assign
     4377               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     4378               buf_utd-marking-line.mark      = marking.mark
     4379               buf_utd-marking-line.gds-code  = marking.Gds-code
     4380               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     4381                                               then marking.sts
     4382                                               else
     4383                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     4384                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     4385                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     4386                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     4387                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4388                                                else marking.sts
     4389            .
     4390            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     4391            do:
     4392              for first par_utd-marking-line no-lock where
     4393                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     4394                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     4395                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     4396                    and par_utd-marking-line.mark    = marking.mark-parent
     4397                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4398              :
     4399                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     4400              end.
     4401            end.
     4402         end.
     4403         addMark(buffer buf_utd-marking-line).
     4404      end.
     4405   end.
     4406   function UnLockUTDMarkbuf returns logical
     4407   (buffer old_utd for utd,
     4408    iAll as logical ):
     4409      define variable voldkey    as character no-undo.
     4410         run gen-key-rec (input "utd",
     4411                          input  buffer old_utd:handle,
     4412                          output voldkey).
     4413      for each marking where marking.loc-key eq voldkey
     4414      exclusive-lock:
     4415         if    iAll
     4416            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4417                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     4418         then do:
     4419            marking.loc-key = "".
     4420            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     4421         end.
     4422      end.
     4423   end.
     4424   function UnLockUTDMark returns logical
     4425   (idb-num as integer ,idoc-id as integer ,iall as logical):
     4426      define buffer old_utd for utd.
     4427      find first old_utd where old_utd.db-num eq idb-num
     4428                           and old_utd.db-num eq idoc-id
     4429      no-lock no-error.
     4430      if available old_utd
     4431      then do:
     4432         UnLockUTDMarkbuf(buffer old_utd,iall).
     4433      end.
     4434   end.
     4435   function changSts returns logical
     4436   (idb-num as integer ,
     4437    idoc-id as integer ,
     4438    old_sts_edo as character ,
     4439    new_sts_edo as character  ):
     4440      if     old_sts_edo ne new_sts_edo
     4441         and ( new_sts_edo eq "RevocationAccepted"
     4442              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     4443              )
     4444      then
     4445         UnLockUTDMark(idb-num,idoc-id,yes).
     4446      if     old_sts_edo ne new_sts_edo
     4447         and ( new_sts_edo eq "WithRecipientSignature"
     4448           or  new_sts_edo eq "WithRecipientPartiallySignature"
     4449              )
     4450      then
     4451         UnLockUTDMark(idb-num,idoc-id,no).
     4452   end.
     4453   function SetLockUTDMark returns logical
     4454   (idb-num as integer ,idoc-id as integer ):
     4455      define buffer new_utd for utd.
     4456      define buffer old_utd for utd.
     4457      define variable volddb-num as integer no-undo.
     4458      define variable volddoc-id as integer no-undo.
     4459      define variable voldkey    as character no-undo.
     4460      define variable vnewkey    as character no-undo.
     4461      find first new_utd where new_utd.db-num eq idb-num
     4462                           and new_utd.doc-id eq idoc-id
     4463      no-lock no-error.
     4464      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     4465      then do trans:
     4466         find first old_utd where old_utd.db-num eq volddb-num
     4467                              and old_utd.doc-id eq volddoc-id
     4468         no-lock no-error.
     4469            run gen-key-rec (input "utd",
     4470                             input  buffer new_utd:handle,
     4471                             output vnewkey).
     4472            run gen-key-rec (input "utd",
     4473                             input  buffer old_utd:handle,
     4474                             output voldkey).
     4475         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     4476                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     4477         no-lock:
     4478            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     4479            if available  marking
     4480            then do:
     4481               if    marking.loc-key eq ""
     4482                  or marking.loc-key eq ?
     4483                  or marking.loc-key eq voldkey
     4484               then do:
     4485                  find current marking exclusive-lock no-error.
     4486                  if available marking
     4487                  then do:
     4488                     marking.loc-key = vnewkey.
     4489                     release marking.
     4490                  end.
     4491               end.
     4492               else if marking.loc-key ne vnewkey
     4493               then do:
     4494                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     4495               end.
     4496            end.
     4497         end.
     4498         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     4499      end.
     4500   end.
     4501   define buffer buf_utd for ub.utd.
     4502   main-block:
     4503   do
     4504   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4505   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4506   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4507   :
     4508     if available (old-utd) and old-utd.doc-id = 0 and not g#news
     4509     then do:
     4510       new-utd.db-num = g#db-num.
     4511       new-utd.doc-id = next-value (s-utd-doc-code, ub).
     4512       new-utd.LoadDate = date (now).
     4513       new-utd.LoadTime = time.
     4514       new-utd.ModifyDate = date (now).
     4515       new-utd.ModifyTime = time.
     4516     end.
     4517     if new-utd.DocumentExt eq "" or new-utd.DocumentExt eq ?
     4518     then
     4519        new-utd.DocumentExt = string(new-utd.db-num) + "-" +  string(new-utd.doc-id).
     4520     if new-utd.Timestamp eq ?
     4521     then
     4522        new-utd.Timestamp = now.
     4523     utdTHSts = objSrv:Env:Utd:Sts:TH.
     4524     utdEDISts = objSrv:Env:Utd:Sts:EDI.
     4525     define variable vOldSts as integer no-undo.
     4526     vOldSts = new-utd.sts-edi.
     4527     if   (  (    g#db-num = new-utd.db-num
     4528             and g#news )
     4529            or (    g#db-num ne new-utd.db-num
     4530                and not g#news ))
     4531        and  new-utd.EDocType ne objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4532     then
     4533        assign
     4534           new-utd.OrganizationExt = old-utd.OrganizationExt
     4535           new-utd.DocumentExt     = old-utd.DocumentExt
     4536        .
     4537     if not g#news
     4538     then do:
     4539        if new-utd.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4540        then do:
     4541           if new-utd.sts-edi ne utdEDISts:WaitingForRecipientSignature:KeyIntDB
     4542           then
     4543           block-ucd:
     4544           for each buf_Utd where buf_utd.PackageId eq new-utd.PackageId
     4545                            and buf_utd.EDocType    eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     4546                            and buf_utd.Timestamp   le new-utd.Timestamp
     4547                            and buf_utd.sts-edi     ne utdEDISts:WithRecipientSignature:KeyIntDB
     4548                            and buf_utd.sts-edi     ne utdEDISts:WithRecipientPartiallySignature:KeyIntDB
     4549                            and buf_utd.sts-edi     ne utdEDISts:RecipientSignatureRequestReject:KeyIntDB
     4550           no-lock:
     4551              assign
     4552                 new-utd.sts-edi = old-utd.sts-edi
     4553              .
     4554              leave block-ucd.
     4555           end.
     4556           if new-utd.sts-edi eq  utdEDISts:WithRecipientSignature:KeyIntDB
     4557              or new-utd.sts-edi eq  utdEDISts:WithRecipientPartiallySignature:KeyIntDB
     4558           then
     4559              new-utd.sts = utdTHSts:Confirmed:KeyIntDB.
     4560        end.
     4561        else if not GetLastUTDinPack (new-utd.db-num, new-utd.doc-id, volddb-num, volddoc-id)
     4562           and    new-utd.EDocType = objSrv:Env:Utd:EDocType:utd:KeyIntDB
     4563        then
     4564            new-utd.sts-edi =   utdEDISts:Changed:KeyIntDB.
     4565        else if    new-utd.EDocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
     4566                or new-utd.EDocType = objSrv:Env:Utd:EDocType:Receipt:KeyIntDB
     4567                or new-utd.EDocType = objSrv:Env:Utd:EDocType:LK_RECEIPT:KeyIntDB
     4568                or new-utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB
     4569        then
     4570           new-utd.sts-edi eq  utdEDISts:RecipientResponseStatusNotAccep:KeyIntDB.
     4571        else if new-utd.EDocType = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4572        then do:
     4573            find first buf_utd where buf_utd.OrganizationExt eq new-utd.parentOrganizationExt
     4574                                 and buf_utd.DocumentExt     eq new-utd.parentDocumentExt
     4575                      no-lock no-error.
     4576            if     avail buf_utd
     4577               and buf_utd.sts-edi               = utdEDISts:RecipientSignatureRequestReject:KeyIntDB
     4578               and new-utd.parentDocumentExt     ne ""
     4579               and new-utd.parentOrganizationExt ne ""
     4580            then
     4581               new-utd.sts-edi = utdEDISts:WithRecipientSignature:KeyIntDB.
     4582            else
     4583               new-utd.sts-edi eq  utdEDISts:RecipientResponseStatusNotAccep:KeyIntDB.
     4584            if new-utd.sts             = ObjSrv:Env:Utd:Sts:th:NewStatus:KeyIntDB
     4585            then do:
     4586            end.
     4587            else if    new-utd.CounteragentId  eq ?
     4588               or new-utd.CounteragentId  eq ""
     4589               or new-utd.OrganizationExt eq ?
     4590               or new-utd.OrganizationExt eq ""
     4591            then
     4592               new-utd.sts             = ObjSrv:Env:Utd:Sts:th:RequireFilling:KeyIntDB.
     4593            else if new-utd.sts             = ObjSrv:Env:Utd:Sts:th:RequireFilling:KeyIntDB
     4594            then
     4595               new-utd.sts             = ObjSrv:Env:Utd:Sts:th:SignatureRequired:KeyIntDB.
     4596         end.
     4597         else if new-utd.EDocType = objSrv:Env:Utd:EDocType:utd:KeyIntDB
     4598                 or new-utd.EDocType = objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     4599         then do:
     4600            if     (new-utd.sts-edi ne  utdEDISts:AutoRejected:KeyIntDB
     4601                     and new-utd.sts-edi < utdEDISts:StatFinesh)
     4602               or new-utd.sts-edi eq ?
     4603            then do:
     4604               if new-utd.sts ne  utdTHSts:RejectionUtd:KeyIntDB
     4605               then do:
     4606                  new-utd.sts-edi =    utdEDISts:GetKeyIntDB(new-utd.RevocationStatus).
     4607                  if new-utd.sts-edi eq ?
     4608                  then
     4609                     new-utd.sts-edi =    utdEDISts:GetKeyIntDB(new-utd.ReceiptStatus).
     4610               end.
     4611               if     new-utd.sts-edi < utdEDISts:StatFinesh
     4612                   or new-utd.sts-edi eq ?
     4613               then do:
     4614                  if   new-utd.sts-edi eq  utdEDISts:SignatureAdjustment:KeyIntDB
     4615                  then
     4616                     new-utd.sts-edi = new-utd.sts-edi.
     4617                  else if     new-utd.sts eq  utdTHSts:CorrectionRequested:KeyIntDB
     4618                          and not new-utd.AmendmentRequested
     4619                  then
     4620                     new-utd.sts-edi = utdEDISts:SignatureAdjustment:KeyIntDB.
     4621                  if new-utd.sts-edi eq ?
     4622                  then
     4623                     new-utd.sts-edi =    utdEDISts:GetKeyIntDB(new-utd.RecipientResponseStatus).
     4624                  if      new-utd.sts-edi eq utdEDISts:WaitingForRecipientSignature:KeyIntDB
     4625                  then do:
     4626                     if new-utd.sts eq  utdTHSts:RejectionUtd:KeyIntDB
     4627                     then do:
     4628                        if vOldSts ne ?
     4629                        then
     4630                           new-utd.sts-edi = vOldSts.
     4631                        else
     4632                           new-utd.sts-edi = old-utd.sts-edi.
     4633                     end.
     4634                     else   if new-utd.sts ne  utdTHSts:SignatureRequired:KeyIntDB
     4635                     then
     4636                        new-utd.sts-edi = utdEDISts:Verification:KeyIntDB.
     4637                  end.
     4638               end.
     4639               if     (   old-utd.sts-edi eq  utdEDISts:sendAutoRejected:KeyIntDB
     4640                       or old-utd.sts-edi eq  utdEDISts:AutoRejected:KeyIntDB
     4641                       )
     4642                  and new-utd.sts-edi eq  utdEDISts:RecipientSignatureRequestReject:KeyIntDB
     4643               then do:
     4644                  new-utd.sts-edi = utdEDISts:SignatureAutoRejected:KeyIntDB.
     4645               end.
     4646            end.
     4647            if      new-utd.sts-edi eq utdEDISts:SignatureAutoRejected:KeyIntDB
     4648               and new-utd.sts      eq utdTHSts:RejectionUtd:KeyIntDB
     4649            then
     4650               new-utd.sts = utdTHSts:Rejection:KeyIntDB.
     4651            else if      new-utd.sts-edi = utdEDISts:WithRecipientSignature:KeyIntDB
     4652                     or new-utd.sts-edi = utdEDISts:WithRecipientPartiallySignature:KeyIntDB
     4653            then do:
     4654               if can-find(first utd-attr no-lock where utd-attr.doc-id = new-utd.doc-id
     4655                                                          and utd-attr.db-num = new-utd.db-num
     4656                                                          and utd-attr.attr-code = "sendcode"
     4657                                                          and utd-attr.attr-value = "3")
     4658               then do:
     4659                  new-utd.sts = utdTHSts:Rejection:KeyIntDB.
     4660                  UnLockUTDMark(new-utd.db-num ,new-utd.doc-id, yes ).
     4661               end.
     4662               else if new-utd.sts     = utdTHSts:SignatureRequired:KeyIntDB
     4663               then
     4664                  new-utd.sts = utdTHSts:AwaitingConfirmation:KeyIntDB.
     4665            end.
     4666            if     vOldSts  >= utdEDISts:StatChangLoanOnlyBeg
     4667               and vOldSts  <= utdEDISts:StatChangLoanOnlyEnd
     4668               and new-utd.sts-edi <= utdEDISts:StatFinesh
     4669            then
     4670               new-utd.sts-edi = vOldSts.
     4671            if  (    (
     4672                     new-utd.sts-edi = utdEDISts:WithRecipientSignature:KeyIntDB
     4673                or   new-utd.sts-edi = utdEDISts:WithRecipientPartiallySignature:KeyIntDB
     4674                or   new-utd.sts-edi = utdEDISts:Changed:KeyIntDB
     4675                     )
     4676                     and new-utd.sts = utdTHSts:Rejectionutd:KeyIntDB
     4677                 )
     4678                or new-utd.sts-edi = utdEDISts:RecipientSignatureRequestReject:KeyIntDB
     4679            then
     4680               new-utd.sts = utdTHSts:Rejection:KeyIntDB.
     4681            else if      new-utd.sts-edi = utdEDISts:RevocationAccepted:KeyIntDB
     4682            then
     4683               new-utd.sts = utdTHSts:Canceled:KeyIntDB.
     4684            if      new-utd.sts-edi = utdEDISts:AutoRejected:KeyIntDB
     4685            then
     4686               new-utd.sts = utdTHSts:RejectionUtd:KeyIntDB.
     4687            if
     4688                  (    new-utd.sts-edi eq utdEDISts:WithRecipientSignature:KeyIntDB
     4689                   or new-utd.sts-edi = utdEDISts:WithRecipientPartiallySignature:KeyIntDB)
     4690               and (       old-utd.sts     eq utdTHSts:DeliveryCodeMismatch:KeyIntDB
     4691                      or
     4692                      (     old-utd.sts eq utdTHSts:CorrectionRequested:KeyIntDB
     4693                       and integer (getattrUtd(new-utd.db-num,new-utd.doc-id,"ststhbeforeCorrection")) eq utdTHSts:DeliveryCodeMismatch:KeyIntDB
     4694                       )
     4695                   )
     4696            then
     4697               new-utd.sts     = utdTHSts:AwaitingConfirmation:KeyIntDB.
     4698         end.
     4699      end.
     4700      if     new-utd.EDocType eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     4701         and new-utd.sts-edi  eq utdEDISts:WithRecipientSignature:KeyIntDB
     4702      then do:
     4703         new-utd.sts = utdTHSts:Confirmed:KeyIntDB.
     4704         block-edoc:
     4705         for each buf_Utd where buf_utd.PackageId eq  new-utd.PackageId
     4706                            and buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4707                            and buf_utd.Timestamp ge new-utd.Timestamp
     4708         exclusive-lock:
     4709            buf_utd.sts-edi = utdEDISts:WithRecipientSignature:KeyIntDB.
     4710            validate buf_utd no-error.
     4711            if buf_utd.sts-edi ne ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB
     4712            then
     4713               leave block-edoc.
     4714         end.
     4715      end.
     4716      if         new-utd.sts      = utdTHSts:AwaitingConfirmation:KeyIntDB
     4717          and    (   new-utd.EDocType = objSrv:Env:Utd:EDocType:utd:KeyIntDB
     4718                  or new-utd.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB)
     4719      then
     4720          new-utd.sts     = utdTHSts:Confirmed:KeyIntDB.
     4721      if new-utd.sts ne old-utd.sts
     4722         and new-utd.sts eq utdTHSts:CorrectionRequested:KeyIntDB
     4723      then
     4724         setattrutd (new-utd.db-num,new-utd.doc-id,"ststhbeforeCorrection",string(old-utd.sts)).
     4725      if new-utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4726      then
     4727         SetLockUTDMark(new-utd.db-num,new-utd.doc-id).
     4728      if     new-utd.Direction  eq 'Outbound'
     4729         and new-utd.sts-edi    eq utdEDISts:WithRecipientSignature:KeyIntDB
     4730      then do:
     4731         define variable vIdDoc as character no-undo.
     4732         vIdDoc = getattrutdex (new-utd.db-num,new-utd.doc-id,"id_doc_th","").
     4733         if num-entries(vIdDoc,"_") eq 2
     4734         then do:
     4735            for each buf_Utd where buf_utd.db-num   eq int(entry(1,vIdDoc,"_"))
     4736                               and buf_utd.doc-id   eq int(entry(2,vIdDoc,"_"))
     4737                               and buf_utd.EDocType eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4738            exclusive-lock:
     4739               buf_utd.sts = utdTHSts:Confirmed:KeyIntDB.
     4740               validate buf_utd no-error.
     4741            end.
     4742         end.
     4743         new-utd.sts = utdTHSts:Confirmed:KeyIntDB.
     4744      end.
     4745      changSts(new-utd.db-num, new-utd.doc-id, old-utd.RevocationStatus , new-utd.RevocationStatus).
     4746      changSts(new-utd.db-num, new-utd.doc-id, old-utd.RecipientResponseStatus , new-utd.RecipientResponseStatus).
     4747      for each utd-lines where utd-lines.db-num eq  new-utd.db-num
     4748                           and utd-lines.doc-id eq  new-utd.doc-id
     4749                           and utd-lines.gds-code eq 0
     4750      exclusive-lock:
     4751          utd-lines.gds-code = ?.
     4752      end.
     4753      for each utd-marking-lines where utd-marking-lines.db-num eq  new-utd.db-num
     4754                           and utd-marking-lines.doc-id eq  new-utd.doc-id
     4755                           and utd-marking-lines.gds-code eq 0
     4756      exclusive-lock:
     4757          utd-marking-lines.gds-code = ?.
     4758          for first marking where marking.mark     eq utd-marking-lines.mark
     4759                              and marking.gds-code eq 0
     4760          exclusive-lock:
     4761             marking.gds-code = ?.
     4762          end.
     4763      end.
     4764   define buffer buf_c-utd-head for ub.c-utd-head .
     4765         buffer-compare new-utd to old-utd case-sensitive save result in v-field-chg.
     4766         if v-field-chg > "":U then . else return .
     4767         run cur-time in this-procedure (output v-date, output v-time).
     4768       publish "getNextseq" ("utd","s-c-utd-chip-num", "ub", output v-Seq ).
     4769       if v-Seq = ?
     4770       then
     4771          v-Seq  = next-value (s-c-utd-chip-num, ub).
     4772       else
     4773          vFlagSeq = yes.
     4774       if vFlagSeq
     4775       then do:
     4776                        if new(new-utd)
     4777          then do:
     4778    for first buf_c-utd where buf_c-utd.db-num eq new-utd.db-num
     4779   and buf_c-utd.doc-id eq new-utd.doc-id
     4780     and buf_c-utd.corr-user-db-num   = g#db-num and buf_c-utd.chip-num = v-Seq exclusive-lock: leave. end.
     4781          end.
     4782          else do:
     4783    for first buf_c-utd where buf_c-utd.db-num eq old-utd.db-num
     4784   and buf_c-utd.doc-id eq old-utd.doc-id
     4785     and buf_c-utd.corr-user-db-num   = g#db-num and buf_c-utd.chip-num = v-Seq exclusive-lock: leave. end.
     4786          end.
     4787       end.
     4788      if new(new-utd)
     4789      then do:
     4790         if not available buf_c-utd
     4791         then do:
     4792            create buf_c-utd.
     4793         buffer-copy new-utd to buf_c-utd
     4794         assign
     4795            buf_c-utd.chip-num           = v-Seq
     4796            buf_c-utd.corr-date          = v-date
     4797            buf_c-utd.corr-time          = v-time
     4798            buf_c-utd.corr-user-db-num   = g#db-num
     4799            buf_c-utd.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
     4800            buf_c-utd.action             = 1
     4801            buf_c-utd.is-del             = false
     4802         .
     4803         end.
     4804         else
     4805            if buf_c-utd.action eq 99
     4806            then
     4807               buf_c-utd.action = 2.
     4808      end.
     4809      else do:
     4810         if not available buf_c-utd
     4811         then do:
     4812            create buf_c-utd.
     4813            buffer-copy old-utd to buf_c-utd
     4814            assign
     4815               buf_c-utd.chip-num           = v-Seq
     4816               buf_c-utd.corr-date          = v-date
     4817               buf_c-utd.corr-time          = v-time
     4818               buf_c-utd.corr-user-db-num   = g#db-num
     4819               buf_c-utd.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
     4820               buf_c-utd.action             = 2 when buf_c-utd.action ne 1
     4821               buf_c-utd.is-del             = false
     4822            .
     4823         end.
     4824      end.
     4825         if vFlagSeq
     4826         then do:
     4827            if new(new-utd)
     4828            then do:
     4829    for first buf_c-utd-head where buf_c-utd-head.db-num eq new-utd.db-num
     4830   and buf_c-utd-head.doc-id eq new-utd.doc-id
     4831     and buf_c-utd-head.corr-user-db-num   = g#db-num and buf_c-utd-head.chip-num = v-Seq exclusive-lock: leave. end.
     4832            end.
     4833            else do:
     4834    for first buf_c-utd-head where buf_c-utd-head.db-num eq old-utd.db-num
     4835   and buf_c-utd-head.doc-id eq old-utd.doc-id
     4836     and buf_c-utd-head.corr-user-db-num   = g#db-num and buf_c-utd-head.chip-num = v-Seq exclusive-lock: leave. end.
     4837            end.
     4838         end.
     4839         if not available  buf_c-utd-head
     4840         then do:
     4841            create buf_c-utd-head.
     4842            buffer-copy  buf_c-utd to buf_c-utd-head
     4843            assign
     4844               buf_c-utd-head.subject = "utd"
     4845               buf_c-utd-head.is-news = g#news
     4846               buf_c-utd-head.source-type = (if g#news
     4847                                             then 'db':U
     4848                                             else (if g#esys
     4849                                                   then 'esys':U
     4850                                                   else "":U)
     4851                                             )
     4852               buf_c-utd-head.source-ref = (if g#news
     4853                                            then string(g#news-source-db)
     4854                                            else (if g#esys
     4855                                                  then string(g#esys-source-esys)
     4856                                                  else "":U)
     4857                                            )
     4858            .
     4859         end.
     4860         else do:
     4861            if     buf_c-utd-head.subject ne "*"
     4862            then
     4863               buf_c-utd-head.subject = "*".
     4864            if buf_c-utd-head.action  ne 88
     4865            then
     4866               buf_c-utd-head.action             = 88 .
     4867         end.
     4868     if not g#news and not (buffer new-utd:handle:buffer-compare (buffer old-utd:handle))
     4869     then do:
     4870       new-utd.ModifyDate = date (now).
     4871       new-utd.ModifyTime = time.
     4872       if     not g#esys
     4873          and new-utd.sts      ne old-utd.sts
     4874          and new-utd.EDocType ne objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4875       then do:
     4876          if new-utd.EDocType eq objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB
     4877          then do :
     4878             find first utd-attr no-lock where utd-attr.db-num = new-utd.db-num
     4879                                           and utd-attr.doc-id = new-utd.doc-id
     4880                                           and utd-attr.attr-code = "is-initial-set"
     4881                                           no-error .
     4882             if available utd-attr
     4883             and logical(utd-attr.attr-value)
     4884             then do :
     4885                run bge\send1cerp.p (?,
     4886                           this-procedure,
     4887                           this-procedure,
     4888                           "edi-doc",
     4889                           (buffer old-utd:handle),
     4890                           (buffer new-utd:handle),
     4891                           ?) no-error.
     4892                if error-status:error
     4893                then do:
     4894                   message return-value view-as alert-box.
     4895                end.
     4896             end .
     4897             else do :
     4898                find first utd-marking-lines no-lock where utd-marking-lines.db-num  = new-utd.db-num
     4899                                                       and utd-marking-lines.doc-id  = new-utd.doc-id
     4900                                                       and utd-marking-lines.doc-level = 1
     4901                                                       and (utd-marking-lines.sts = 0
     4902                                                         or utd-marking-lines.site = "only-send")
     4903                                                       no-error .
     4904                if available utd-marking-lines
     4905                then do :
     4906                   run bge\send1cerp.p (?,
     4907                               this-procedure,
     4908                               this-procedure,
     4909                               "edi-doc",
     4910                               (buffer old-utd:handle),
     4911                               (buffer new-utd:handle),
     4912                               ?) no-error.
     4913                   if error-status:error
     4914                   then do:
     4915                      message return-value view-as alert-box.
     4916                   end.
     4917                end .
     4918             end .
     4919          end .
     4920          else do :
     4921            run bge\send1cerp.p (?,
     4922                         this-procedure,
     4923                         this-procedure,
     4924                         "edi-doc",
     4925                         (buffer old-utd:handle),
     4926                         (buffer new-utd:handle),
     4927                         ?) no-error.
     4928            if error-status:error
     4929            then do:
     4930               message return-value view-as alert-box.
     4931            end.
     4932            for each utd-marking-lines where utd-marking-lines.db-num eq new-utd.db-num
     4933                                         and utd-marking-lines.doc-id eq new-utd.doc-id
     4934                                         and utd-marking-lines.doc-level eq 1
     4935            no-lock:
     4936               find first marking where marking.mark eq utd-marking-lines.mark
     4937               no-lock no-error.
     4938               if     available marking
     4939                  and marking.sts eq objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB
     4940               then
     4941                  run sendmark(marking.mark).
     4942               else if available marking then
     4943               do:
     4944                   find first ub.utd-marking-lines-attr no-lock where
     4945                              ub.utd-marking-lines-attr.db-num     = utd-marking-lines.db-num
     4946                          and ub.utd-marking-lines-attr.doc-id     = utd-marking-lines.doc-id
     4947                          and ub.utd-marking-lines-attr.LineNum    = utd-marking-lines.LineNum
     4948                          and ub.utd-marking-lines-attr.mark       = utd-marking-lines.mark
     4949                          and ub.utd-marking-lines-attr.attr-code  = "AddMarkWeight"
     4950                          and ub.utd-marking-lines-attr.attr-value = "yes"
     4951                          no-error.
     4952                   if available ub.utd-marking-lines-attr
     4953                   then
     4954                      run sendmark(marking.mark).
     4955               end.
     4956            end.
     4957          end .
     4958       end.
     4959       if g#db-num = 0 and
     4960         (
     4961         (new-utd.sts <> old-utd.sts
     4962         and (
     4963               new-utd.sts = utdTHSts:AwaitingDelivery:KeyIntDB
     4964           or  old-utd.sts = utdTHSts:AwaitingDelivery:KeyIntDB
     4965           or  new-utd.sts = utdTHSts:Confirmed:KeyIntDB
     4966           or  old-utd.sts = utdTHSts:Confirmed:KeyIntDB
     4967           or  new-utd.sts = utdTHSts:Rejection:KeyIntDB
     4968         ))
     4969         )
     4970       then do:
     4971         run str/callnews.p
     4972           (input 'utd':U
     4973           ,input (buffer new-utd:handle)
     4974           ) no-error .
     4975         if error-status:error then do:
     4976            if not G#auto
     4977            then
     4978                message  return-value
     4979                view-as  alert-box.
     4980           undo main-block,  return error return-value .
     4981         end.
     4982       end.
     4983       if g#db-num ne 0 and
     4984         (new-utd.sts <> old-utd.sts
     4985         and (
     4986               new-utd.sts ne utdTHSts:NewStatus:KeyIntDB
     4987         ))
     4988       then do:
     4989         run str/callnews.p
     4990           (input 'utd':U
     4991           ,input (buffer new-utd:handle)
     4992           ) no-error .
     4993         if error-status:error then do:
     4994           undo main-block,  return error return-value .
     4995         end.
     4996       end.
     4997       if new-utd.sts <> ? and new-utd.sts <> 0 and old-utd.sts-edi <> ? and new-utd.sts-edi <> ?
     4998       then do:
     4999         if g#db-num = 0 and (new-utd.sts-edi <> old-utd.sts-edi
     5000           and (
     5001                 new-utd.sts-edi = utdEDISts:RevocationAccepted:KeyIntDB
     5002           ))
     5003         then do:
     5004           run nws/cmdchgutd.p (buffer new-utd).
     5005         end.
     5006         if g#db-num ne 0 and (new-utd.sts-edi <> old-utd.sts-edi)
     5007         then do:
     5008           run nws/cmdchgutd.p (buffer new-utd).
     5009         end.
     5010       end.
     5011     end.
     5012     find first ub.clients no-lock  where ub.clients.obj-type = new-utd.obj-type and ub.clients.obj-code = new-utd.obj-code no-error.
     5013     if    (new-utd.sts = objSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB  and new-utd.sts <> old-utd.sts)
     5014       and (new-utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB)
     5015       and ((g#db-num ne 0 and g#news) or
     5016       ((new-utd.doc-code = "" or new-utd.doc-code eq ?)
     5017       and g#db-num eq 0 and not g#news))
     5018       and available ub.clients
     5019       and ub.clients.db-num = g#db-num
     5020       and g#db-num ne 0
     5021     then do:
     5022       def var v-file-name as character no-undo.
     5023       def var v-msg as character no-undo.
     5024       run ibs\th\str\utd\adaputd.p
     5025         (new-utd.db-num,
     5026         new-utd.doc-id,
     5027         g#userid
     5028         ) no-error.
     5029       if not error-status:error
     5030       then do:
     5031         if return-value matches "*ошибка*"
     5032         then v-msg = substitute ('Получен УПД. Документ № &1 от &2. Сформирована ПН: &3. &4', new-utd.DocumentNumber, string (new-utd.DocumentDate) , new-utd.doc-code, return-value).
     5033         else do:
     5034            if     new-utd.sts ne objSrv:Env:Utd:Sts:TH:Confirmed           :KeyIntDB
     5035            then    v-msg = substitute ('Получен УПД. Документ № &1 от &2. Сформирована ПН: &3. &5 &6 &4', new-utd.DocumentNumber, string (new-utd.DocumentDate) , new-utd.doc-code, return-value,
     5036            if ChecknotMarkUtd(new-utd.db-num,new-utd.doc-id) then "Немаркированные товары можно продавать на кассе." else "",
     5037            if CheckMarkUtd(new-utd.db-num,new-utd.doc-id) then "Продажа маркированных товаров из данной поставки запрещена до получения дополнительного уведомления. " else "").
     5038            else if     new-utd.sts eq objSrv:Env:Utd:Sts:TH:Confirmed           :KeyIntDB
     5039                    and CheckMarkUtd(new-utd.db-num,new-utd.doc-id)
     5040            then    v-msg = substitute ('Получен УПД. Документ № &1 от &2. Сформирована ПН: &3. &5 &4', new-utd.DocumentNumber, string (new-utd.DocumentDate) , new-utd.doc-code, return-value, "Маркированные товары данной поставки можно продавать на кассе.").
     5041         end.
     5042       end.
     5043         else v-msg = substitute ('Получен УПД. Документ: &1 от &2. Ошибка при формировании ПН. &3. &4', new-utd.DocumentNumber, string (new-utd.DocumentDate), trim(return-value, ".")).
     5044       if v-msg ne ""
     5045       then
     5046          run utl\proc-msg.p (v-msg) no-error.
     5047     end.
     5048     else if new-utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB and g#db-num > 0
     5049             and available (ub.clients)
     5050     then do:
     5051         def var v-mes as char no-undo.
     5052         v-mes = substitute("DB&1,gnews&2,stts&3,old-stts&4,clientdb&5",g#db-num,g#news,new-utd.sts,old-utd.sts,ub.clients.db-num).
     5053         if  log-manager:logfile-name ne ?
     5054      then log-manager:write-message(v-mes, "UTDWError").
     5055      else do:
     5056          output to c:\temp\utdwerr.txt append.
     5057          put v-mes skip.
     5058          output close.
     5059      end.
     5060     end.
     5061     if g#db-num ne 0 and new-utd.sts = objSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB and new-utd.EDocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
     5062     then do:
     5063         v-msg = substitute ('Получен документ первоначального ввода. Документ № &1 от &2. Обратитесь в Техническую поддержку.', new-utd.DocumentNumber, string (new-utd.DocumentDate)).
     5064         run utl\proc-msg.p (v-msg) no-error.
     5065     end.
     5066   end.
     5067   procedure sendmark:
     5068      define input  parameter iMark as character no-undo.
     5069      define buffer marking for marking.
     5070      find first marking where marking.mark eq imark
     5071      no-lock no-error.
     5072      if     available marking
     5073      then do:
     5074          run bge\send1cerp.p (?,
     5075                       this-procedure,
     5076                       this-procedure,
     5077                       "mark",
     5078                       (buffer marking:handle),
     5079                       ?,
     5080                       ?) no-error.
     5081         if error-status:error
     5082         then
     5083            message return-value view-as alert-box.
     5084         else do:
     5085            if marking.sts eq objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB
     5086            then do:
     5087               for each marking where marking.mark-parent eq imark
     5088               no-lock:
     5089                  run sendmark (marking.mark).
     5090               end.
     5091            end.
     5092         end.
     5093      end.
     5094   end.
