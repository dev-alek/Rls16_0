        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.fbr-gds-obj OLD oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись fbr-gds-obj".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3',ub.fbr-gds-obj.obj-type,ub.fbr-gds-obj.obj-code,ub.fbr-gds-obj.gds-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   DEFINE VARIABLE conf-par as character no-undo .
       82   DEFINE VARIABLE par-type as character no-undo .
       83   define variable v-host-code like ub.sysconf.host-code .
       84   define variable v-l as logical no-undo .
       85   define variable v-date as date no-undo .
       86   define variable v-time as integer no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure cur-time :
       89      define output parameter p-today as date      no-undo .
       90      define output parameter p-time  as integer   no-undo .
       91     do
       92     on error undo, return error
       93     :
       94       define variable v-date1 as date      no-undo .
       95       define variable v-date2 as date      no-undo .
       96       define variable v-time  as integer   no-undo .
       97       assign
       98         v-date1 = today
       99         v-time  = time
      100         v-date2 = today
      101       .
      102       if v-date1 <> v-date2
      103       then do:
      104         assign
      105           v-date1 = today
      106           v-time  = v-time
      107         .
      108       end.
      109       assign
      110         p-today = v-date1
      111         p-time  = v-time
      112       .
      113     end.
      114   end.
      115   function cur-time-date returns character
      116   :
      117     return string(today, '99/99/9999':U) .
      118   end.
      119   function cur-time-mjd returns decimal
      120   :
      121     define variable v-date as date      no-undo .
      122     define variable v-time as integer   no-undo .
      123     run cur-time in this-procedure
      124       (output v-date
      125       ,output v-time
      126       ) .
      127     return integer(v-date) - 2400002 + (v-time / 86400) .
      128   end.
      129   function cur-time-get-ending-index returns integer
      130   (input p-number as integer
      131   )
      132   :
      133     if p-number < 0
      134     or p-number = ?
      135     then do:
      136       return 1 .
      137     end.
      138     define variable v-rest as integer   no-undo .
      139     assign
      140       p-number = p-number modulo 100
      141     .
      142     if p-number < 20
      143     then do:
      144       assign
      145         v-rest = p-number
      146       .
      147     end.
      148     else do:
      149       assign
      150         v-rest = p-number modulo 10
      151       .
      152     end.
      153     case v-rest :
      154       when 1
      155       then do:
      156         return 2 .
      157       end.
      158       when 2 or
      159       when 3 or
      160       when 4
      161       then do:
      162         return 3 .
      163       end.
      164       otherwise do:
      165         return 1 .
      166       end.
      167     end case .
      168   end.
      169   procedure cur-time-mjd-to-date :
      170      define input  parameter i-mjd-diff as decimal no-undo.
      171      define output parameter o-Date     as date    no-undo.
      172      define output parameter o-Time     as integer no-undo.
      173      define variable v-day-number as integer   no-undo .
      174      if    i-mjd-diff < 0
      175         or i-mjd-diff = ?
      176      then do:
      177         return "?" .
      178      end.
      179      assign
      180         v-day-number = truncate(i-mjd-diff,0).
      181         o-Date = date(v-day-number + 2400002).
      182         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184   end.
      185   function cur-time-mjd-to-string returns character
      186   (input p-mjd-diff as decimal
      187   )
      188   :
      189     define variable v-day-number as integer   no-undo .
      190     define variable v-seconds    as integer   no-undo .
      191     define variable v-hour       as integer   no-undo .
      192     define variable v-min        as integer   no-undo .
      193     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      194     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      195     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      196     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      197     if p-mjd-diff < 0
      198     or p-mjd-diff = ?
      199     then do:
      200       return "?" .
      201     end.
      202     assign
      203       v-day-number = integer(truncate(p-mjd-diff,0))
      204       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206     if v-seconds > 86400
      207     then do:
      208       assign
      209         v-seconds = 86400 - 1
      210       .
      211     end.
      212     if v-seconds < 0
      213     then do:
      214       assign
      215         v-seconds = 0
      216       .
      217     end.
      218     assign
      219       v-hour = truncate(v-seconds / 3600, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 3600
      223     .
      224     assign
      225       v-min = truncate(v-seconds / 60, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 60
      229     .
      230     return
      231         (if v-day-number <> 0
      232           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0
      236           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      240           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      241           else ""
      242         )
      243       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      244       .
      245   end.
      246   function cur-time-string returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      255   end.
      256   function cur-time-string-sec returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      265   end.
      266   function cur-time-custom  returns character
      267   (input p-prefix as character
      268   ,input p-date-format as character
      269   ,input p-delimiter as character
      270   ,input p-time-format as character
      271   ,input p-suffix as character
      272   )
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return
      281       p-prefix
      282       + string(v-date, p-date-format)
      283       + p-delimiter
      284       + string(v-time, p-time-format)
      285       + p-suffix
      286       .
      287   end.
      288   function cur-time-print  returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-datetime returns datetime
      299   :
      300     define variable v-char as character no-undo .
      301     define variable v-datetime as datetime no-undo .
      302     v-char = cur-time-string().
      303     v-datetime = datetime(v-char).
      304     return  v-datetime.
      305   end.
      306   function cur-time-string-msec returns character
      307   :
      308     define variable v-date as datetime  no-undo .
      309     v-date = now.
      310     return string(v-date) .
      311   end.
      312   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   define new global shared variable g#lib-nws as handle no-undo .
      314   define buffer buf_clients for ub.clients.
      315   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
      316   define buffer buf_c-fbr-gds-obj for ub.c-fbr-gds-obj.
      317   define buffer buf_c-gds-hist for ub.c-gds-hist.
      318   main-block:
      319   do
      320   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      321   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      322   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      323   :
      324     if not g#news then do:
      325       find first buf_clients no-lock where
      326                  buf_clients.obj-type = ub.fbr-gds-obj.obj-type
      327              AND buf_clients.obj-code = ub.fbr-gds-obj.obj-code.
      328       if buf_clients.db-num <> g#db-num then do:
      329         message
      330         "Нельзя изменять запись атрибута товара (РЕСТОРАН) на объекте," skip
      331         "принадлежащем другой БД"
      332         view-as alert-box .
      333         undo main-block, return error.
      334       end.
      335     end.
      336     find first buf_fbr-gds-obj no-lock where
      337                buf_fbr-gds-obj.gds-code = ub.fbr-gds-obj.gds-code
      338            AND buf_fbr-gds-obj.obj-type = ub.fbr-gds-obj.obj-type
      339            AND buf_fbr-gds-obj.obj-code = ub.fbr-gds-obj.obj-code
      340            AND recid(buf_fbr-gds-obj) <> recid(ub.fbr-gds-obj)
      341            no-error .
      342     if available buf_fbr-gds-obj then do:
      343       message
      344       "Товар"  ub.fbr-gds-obj.gds-code skip
      345       "Уже есть атрибут товара (РЕСТОРАН) на объекте" ub.fbr-gds-obj.obj-type ub.fbr-gds-obj.obj-code
      346       view-as alert-box error .
      347       undo main-block, return error .
      348     end.
      349     if g#db-num > 0
      350     and not g#news then do:
      351       run str/callnews.p
      352         ( input 'fbr-gds-obj':U
      353         ,input (buffer ub.fbr-gds-obj:handle)
      354         ) .
      355     end.
      356   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   define variable send-ref as logical no-undo.
      358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      359     (input  'send-ref'
      360     ,input  0
      361     ,input  ''
      362     ,input  0
      363     ,input  ''
      364     ,input  ''
      365     ,input  ''
      366     ,input  no
      367     ,output conf-par
      368     ,output par-type
      369     ) no-error .
      370     send-ref = (IF error-status:error or conf-par <> "yes" then no else yes).
      371     if not g#news and send-ref then do:
      372       assign
      373       v-l = yes
      374       .
      375       buffer-compare ub.fbr-gds-obj using
      376       fbr-grp-code
      377       fbr-obj-code fbr-obj-type
      378       is-cd is-menu is-modificator is-null-price is-semi-finished
      379       to oldb
      380       case-sensitive
      381       save result in v-l .
      382       if not v-l then do:
      383   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      385     (input  ub.fbr-gds-obj.obj-type
      386     ,input  ub.fbr-gds-obj.obj-code
      387     ,output v-host-code
      388     )  .
      389         run trg/nu_gds.p (
      390                         input  ub.fbr-gds-obj.gds-code
      391                       ,input  v-host-code
      392                       ,input  ub.fbr-gds-obj.obj-type
      393                       ,input  ub.fbr-gds-obj.obj-code
      394                       ,input  (if not ub.fbr-gds-obj.is-cd  then "D":U else "U":U)
      395                       ).
      396       end.
      397     end.
      398     buffer-compare ub.fbr-gds-obj
      399     to oldb
      400     case-sensitive
      401     save result in v-l.
      402     if v-l = no then do:
      403       if g#news then do:
      404         define variable v-send as integer no-undo .
      405         v-send = integer('0':U).
      406   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      407   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      408     (input  g#db-num
      409     ,input  'fbr-gds-obj':U
      410     ,input  0
      411     ,input  '':U
      412     ,input  0
      413     ,input  '':U
      414     ,input  '':U
      415     ,input  '':U
      416     ,input  0
      417     ,input  0
      418     ,input  0
      419     ,input  'nws-to-hist'
      420     ,output v-send
      421     ) no-error .
      422       end.
      423       if not g#news
      424       or v-send >= 0 then do:
      425         run cur-time in this-procedure(output v-date, output v-time).
      426         create buf_c-fbr-gds-obj.
      427         buffer-copy oldb to buf_c-fbr-gds-obj
      428         assign
      429         buf_c-fbr-gds-obj.gds-code           = ub.fbr-gds-obj.gds-code
      430         buf_c-fbr-gds-obj.obj-type           = ub.fbr-gds-obj.obj-type
      431         buf_c-fbr-gds-obj.obj-code           = ub.fbr-gds-obj.obj-code
      432         buf_c-fbr-gds-obj.chip-num           = next-value (s-gds-chip, ub)
      433         buf_c-fbr-gds-obj.corr-time          = v-time
      434         buf_c-fbr-gds-obj.corr-user-db-num   = g#db-num
      435         buf_c-fbr-gds-obj.corr-user-name     = (if g#news
      436                                                then (chr(4) +  'СПН':U)
      437                                                else (if g#esys
      438                                                      then (chr(4) +  'ВС':U)
      439                                                      else g#userid)
      440                                                )
      441         buf_c-fbr-gds-obj.corr-date          = v-date
      442         .
      443         if v-host-code = 0 then do:
      444   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      446     (input  ub.fbr-gds-obj.obj-type
      447     ,input  ub.fbr-gds-obj.obj-code
      448     ,output v-host-code
      449     )  .
      450         end.
      451         create buf_c-gds-hist.
      452         buffer-copy buf_c-fbr-gds-obj to buf_c-gds-hist
      453         assign
      454         buf_c-gds-hist.action = (if new ub.fbr-gds-obj then integer('1':U) else integer('2':U))
      455         buf_c-gds-hist.subject = 'fbr-gds-obj':U
      456         buf_c-gds-hist.host-code = v-host-code
      457         buf_c-gds-hist.is-news = g#news
      458         buf_c-gds-hist.source-type = (if g#news
      459                                       then 'db':U
      460                                       else (if g#esys
      461                                             then  'esys':U
      462                                             else "":U)
      463                                       )
      464         buf_c-gds-hist.source-ref = (if g#news
      465                                      then string(g#news-source-db)
      466                                      else  (if g#esys
      467                                             then string(g#esys-source-esys)
      468                                             else "":U)
      469                                      )
      470         .
      471       end.
      472     end.
      473       if g#oxml = yes
      474       then do:
      475       run str/calloxml.p (
      476             input 'update':U
      477           , input 'fbr-gds-obj':U
      478           , input ( buffer ub.fbr-gds-obj:handle )
      479       ) no-error.
      480       if error-status :error
      481       then do:
      482           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      483                                , chr(10)
      484                                , vss-workfile
      485                                , return-value
      486                                , error-status :get-message ( 1 ) ).
      487       end.
      488       end.
      489   end.
