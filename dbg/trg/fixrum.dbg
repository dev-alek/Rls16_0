        1   block-level on error undo, throw.
        2   define input parameter p-forced as logical no-undo .
        3   define input parameter p-read-only as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Закачка конфигурации RUM".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   define variable v-waitfram-action01         as character   no-undo .
      306   define variable v-waitfram-action02         as character   no-undo .
      307   define variable v-waitfram-action03         as character   no-undo .
      308   define variable mWaitFramTextBeg            as character   no-undo.
      309   define variable mWaitFramTextEnd            as character   no-undo.
      310   define variable mWaitFramView               as logical     no-undo.
      311   define variable mWaitProcEvent              as logical     no-undo init yes.
      312   define variable mWaitFramInterval           as integer     no-undo init 1 .
      313   define variable mWaitFramStop               as logical     no-undo.
      314   define variable mWaitFramStopUser           as logical     no-undo.
      315   define variable mWaitFramStopTimeOut        as logical     no-undo.
      316   define variable mWaitFramStartProc          as datetime-tz no-undo.
      317   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      318   define button B-WaitFramStop auto-end-key
      319        label "Стоп"
      320        size 10 by 1 tooltip "Остоновить процесс".
      321   define button B-viewProcInfo
      322        label "Информация"
      323        size 15 by 1 tooltip "Информация о процесс".
      324   define frame waitfram
      325     v-waitfram-action01 format "x(72)" no-label skip
      326     v-waitfram-action02 format "x(72)" no-label skip
      327     v-waitfram-action03 format "x(72)" no-label skip
      328     B-viewProcInfo
      329     B-WaitFramStop at row 4 col 30
      330     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      331     .
      332   define new global shared variable mBatchMode as logical no-undo init ?.
      333   define variable mFramBachModHandle as handle no-undo.
      334   mFramBachModHandle = frame waitfram:handle.
      335   define variable mFameOldVis as logical no-undo.
      336   define variable mVisCUrentVin as logical no-undo.
      337   if session:batch-mode
      338   then
      339      mBatchMode = yes.
      340   if mBatchMode = ? then do:
      341     mVisCUrentVin = current-window:visible.
      342     mFameOldVis = mFramBachModHandle:visible.
      343     mFramBachModHandle:visible  = yes.
      344     mBatchMode = mFramBachModHandle:visible ne yes.
      345     mFramBachModHandle:visible = mFameOldVis.
      346     current-window:visible = mVisCUrentVin.
      347   end.
      348    if  log-manager:logfile-name ne ?
      349     then DO:
      350         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      351         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      352         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      353     end.
      354   on choose of B-WaitFramStop in frame waitfram
      355   do:
      356     mWaitFramStop = yes.
      357     mWaitFramStopUser = yes.
      358   end.
      359   function waitfram-check-timeout returns logical():
      360      define variable vtime as int64 no-undo.
      361      if mWaitFramStopTimeOut
      362      then
      363         return yes.
      364      vtime = ( now - mWaitFramStartProc ) / 1000 .
      365      if     mWaitFramTimeOut ne ?
      366         and mWaitFramTimeOut ne 0
      367         and mWaitFramTimeOut lt vtime
      368      then do:
      369         mWaitFramStopTimeOut = yes.
      370      end.
      371      return mWaitFramStopTimeOut.
      372   end.
      373   procedure waitfram-hide :
      374     if not session:batch-mode
      375     then do
      376     on error undo, return error return-value
      377     :
      378       pause 0 before-hide .
      379       if not mBatchMode then
      380         hide frame waitfram .
      381     if     not mWaitFramView
      382        and mWaitProcEvent
      383     then
      384       process events .
      385     end.
      386   end procedure.
      387   procedure waitfram-show :
      388     define input  parameter p-message as character no-undo .
      389     define variable v-left-margin as integer   no-undo .
      390     if not session:batch-mode
      391     then do
      392     on error undo, return error return-value
      393     :
      394       if length(p-message) <= 70 then do:
      395         assign
      396           v-left-margin = integer((70 - length(p-message)) / 2)
      397         .
      398         assign
      399           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      400         .
      401         assign
      402           v-waitfram-action01 = " "
      403           v-waitfram-action02 = " "
      404                                    + fill(" ", v-left-margin)
      405                                    + p-message
      406           v-waitfram-action03 = " "
      407         .
      408       end.
      409       else do:
      410         define variable vRindex1 as integer no-undo.
      411         define variable vRindex2 as integer no-undo.
      412         vRindex1 = r-index(p-message," ",70).
      413         if vRindex1 = 0
      414         then
      415            vRindex1 = 70.
      416         if length(p-message)  <= vRindex1 + 70 then do:
      417           assign
      418             v-waitfram-action01 = " "
      419             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      420             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      421           .
      422         end.
      423         else do:
      424           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      425           if vRindex2 <= vRindex1
      426           then
      427              vRindex2 = vRindex1 + 70.
      428           assign
      429             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      430             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      431             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      432           .
      433         end.
      434       end.
      435       B-viewProcInfo:visible   in frame waitfram = no.
      436       B-viewProcInfo:sensitive in frame waitfram = no.
      437       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      438       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      439       if  (   mWaitFramView
      440          or  mWaitProcEvent)
      441          and not mBatchMode
      442       then
      443          display
      444             v-waitfram-action01 skip
      445             v-waitfram-action02 skip
      446             v-waitfram-action03 skip
      447          with frame waitfram .
      448       if     mWaitFramView
      449          then do:
      450             if     mWaitFramInterval ne ?
      451                and not mBatchMode
      452             then
      453                wait-for go of frame waitfram pause mWaitFramInterval.
      454          end.
      455          else
      456             if     mWaitProcEvent
      457                and not mBatchMode
      458             then
      459                process events .
      460     end.
      461   end procedure.
      462      procedure waitfram-show-this:
      463         define input  parameter iInterval as int64 no-undo.
      464         define variable vtime as int64 no-undo.
      465         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      466         mWaitFramInterval = iInterval.
      467         run waitfram-show (substitute("&1&2 &3&4" ,
      468                                       mWaitFramTextBeg ,
      469                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      470                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      471                                       mWaitFramTextEnd
      472                                      )
      473                           ).
      474      end.
      475      procedure WaitFramRunPause:
      476         define input  parameter iInterval as dec no-undo.
      477         define variable vStart  as datetime-tz no-undo.
      478         define variable vend    as datetime-tz no-undo.
      479         define variable vint as int64 no-undo.
      480         define variable vOk as logical no-undo.
      481         vStart = now.
      482         vend   = vStart.
      483         publish "WaitFramPause" (iInterval,output vOk).
      484         vend   =  now.
      485         vint = vend - vStart.
      486         vint = iInterval - vint / 1000.
      487         if     not mWaitFramStop
      488            and (   vint > 0
      489                 or (    not vOk
      490                     and iInterval eq ?
      491                     )
      492                 )
      493         then
      494            run waitfram-show-this (iInterval).
      495         vend   =  now.
      496         vint = vend - vStart.
      497         vint = iInterval - vint / 1000.
      498         if     not mWaitFramStop
      499            and vint > 0
      500         then do:
      501            run gbl/pause.p (vint * 1000).
      502         end.
      503         if iInterval ne ?
      504         then
      505            publish "WaitFramStop".
      506         waitfram-check-timeout().
      507      end.
      508      procedure WaitFramWaitFor:
      509         define input  parameter iInterval as dec no-undo.
      510         assign
      511            mWaitFramStartProc   = now
      512            mWaitFramStopUser    = no
      513            mWaitFramStopTimeOut = no
      514         .
      515         block-wait:
      516         do while not mWaitFramStop:
      517            run WaitFramRunPause (iInterval).
      518            if  waitfram-check-timeout()
      519            then do:
      520               leave block-wait.
      521            end.
      522         end.
      523         run waitfram-hide.
      524      end.
      525   procedure waitfram-join :
      526     define input  parameter p-line-1  as character no-undo .
      527     define input  parameter p-line-2  as character no-undo .
      528     define input  parameter p-line-3  as character no-undo .
      529     define output parameter p-message as character no-undo .
      530     do
      531     on error undo, return error return-value
      532     :
      533       assign
      534         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      535                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      536                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      537       .
      538     end.
      539   end procedure.
      540   function waitfram-join-function returns character
      541     (input p-line-1 as character
      542     ,input p-line-2 as character
      543     ,input p-line-3 as character
      544     ).
      545     define variable v-message as character no-undo .
      546     run waitfram-join in this-procedure
      547       (input  p-line-1
      548       ,input  p-line-2
      549       ,input  p-line-3
      550       ,output v-message
      551       ) .
      552     return v-message .
      553   end function .
      554   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   procedure check-rum-version :
      556   define output parameter p-check as logical no-undo .
      557   define variable v-dopi1 as integer no-undo .
      558   define variable v-dopi2 as integer no-undo .
      559   define variable v-dopi3 as integer no-undo .
      560   define variable v-dopi4 as integer no-undo .
      561   define buffer buf_ruledict for ub.ruledict .
      562     do
      563     on error undo, return error
      564     :
      565       find first buf_ruledict no-lock where
      566                 buf_ruledict.entry-id = 0  no-error.
      567       if (not available buf_ruledict
      568       or buf_ruledict.documentation <> "v16_0.13" )
      569       then do:
      570         assign
      571         v-dopi1 = integer(entry(2, buf_ruledict.documentation,  "."))
      572         v-dopi2 = integer(entry(2, "v16_0.13", "."))
      573         v-dopi3 = integer(entry(2, entry(1, buf_ruledict.documentation, "."), "_"))
      574         v-dopi4 = integer(entry(2, entry(1, "v16_0.13", "."), "_"))
      575         no-error .
      576         if error-status:error
      577         or v-dopi2 > v-dopi1
      578         or v-dopi4 > v-dopi3
      579         or left-trim(entry(1, buf_ruledict.documentation, "."), "v":U) < "16"
      580         then do:
      581           assign
      582           p-check = yes.
      583         end.
      584       end.
      585     end.
      586   end procedure.
      587   procedure get-rum-version :
      588   define output parameter p-rum-version as character no-undo init ?.
      589   define buffer buf_ruledict for ub.ruledict .
      590   do
      591   on error undo, return error
      592   :
      593     find first buf_ruledict no-lock where
      594               buf_ruledict.entry-id = 0  no-error.
      595     if available buf_ruledict then do:
      596       p-rum-version = buf_ruledict.documentation.
      597     end.
      598   end.
      599   end procedure.
      600   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   procedure gen-key-rec :
      602     define input  parameter p-tbl-name    as character no-undo.
      603     define input  parameter p-bh_tbl-name as handle    no-undo.
      604     define output parameter p-key-rec     as character no-undo.
      605     do
      606     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      607     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      608     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      609     :
      610       define variable fh               as handle    no-undo .
      611       define variable v-ok             as logical   no-undo .
      612       define variable v-inform         as character no-undo .
      613       define variable v-ind            as integer   no-undo .
      614       define variable v-idx-field-qnty as integer   no-undo .
      615       if p-tbl-name = ?
      616         or p-tbl-name = "":U
      617       then do:
      618         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      619       end.
      620       if not p-bh_tbl-name:available then do:
      621         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      622       end.
      623       assign
      624         p-key-rec = p-tbl-name
      625         v-inform  = p-bh_tbl-name:index-information(1)
      626         v-ind     = 2
      627       .
      628       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      629       on error undo, return error
      630       :
      631         assign
      632           v-inform = p-bh_tbl-name:index-information( v-ind )
      633           v-ind    = v-ind + 1
      634         .
      635       end.
      636       if v-inform = ?
      637         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      638         or entry( 3, v-inform, ",":U ) <> "1":U
      639       then do:
      640         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      641       end.
      642       else do:
      643         assign
      644           v-idx-field-qnty = num-entries( v-inform ) - 4
      645         .
      646         if v-idx-field-qnty < 2 then do:
      647           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      648         end.
      649         do v-ind = 1 to v-idx-field-qnty by 2
      650         on error undo, return error
      651         :
      652           assign
      653             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      654             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      655           .
      656         end.
      657       end.
      658       if p-key-rec = ? then do:
      659         assign
      660           p-key-rec = "":U
      661         .
      662         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      663       end.
      664     end.
      665     return.
      666   end procedure.
      667   procedure gen-where-keyr-tab :
      668     define input  parameter i-tableSerach as character no-undo.
      669     define input  parameter i-tablekey   as character  no-undo.
      670     define input  parameter p-key-rec    as character  no-undo.
      671     define input  parameter p-key-handle as handle     no-undo .
      672     define input  parameter p-db-name    as character  no-undo .
      673     define input  parameter p-tt-handle  as handle     no-undo .
      674     define output parameter o-Where      as character  no-undo.
      675     do
      676     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      677     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      678     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      679     :
      680       define variable v-full-tbl-name  as character no-undo .
      681       define variable bh_tbl-name      as handle    no-undo .
      682       define variable fh_key           as handle    no-undo .
      683       define variable fh_search        as handle    no-undo .
      684       define variable v-field-num      as integer   no-undo .
      685       define variable v-count-fld      as integer   no-undo .
      686       define variable v-inform         as character no-undo .
      687       define variable v-ind            as integer   no-undo .
      688       define variable v-idx-field-qnty as integer   no-undo .
      689       define variable v-field-name     as character no-undo .
      690       define variable v-field-val      as character no-undo .
      691       define variable v-word-link      as character no-undo .
      692       define variable vTable           as character no-undo.
      693       define variable bh_tbl-key       as handle    no-undo .
      694       assign
      695         p-key-rec = trim( p-key-rec )
      696       .
      697       if p-key-handle <> ? then do:
      698         if not valid-handle(p-key-handle)
      699            or p-key-handle:type <> "buffer"
      700         then do:
      701           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      702         end.
      703         if num-entries( p-key-rec, chr(3) ) > 1
      704           or p-key-rec = ?
      705           or p-key-rec = "":U
      706         then do:
      707           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      708         end.
      709       end.
      710       else do:
      711         if p-key-rec = ?
      712           or p-key-rec = "":U
      713         then do:
      714           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      715         end.
      716       end.
      717       assign
      718         vTable = entry( 1 , p-key-rec, chr(3) )
      719       .
      720       if p-tt-handle <> ?
      721         and ( not valid-handle(p-tt-handle)
      722               or p-tt-handle:type <> "buffer"
      723             )
      724       then do:
      725         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      726       end.
      727       if p-tt-handle = ? then do:
      728         assign
      729           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      730         .
      731         create buffer bh_tbl-name for table v-full-tbl-name .
      732       end.
      733       else do:
      734         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      735       end.
      736       assign
      737         v-inform = bh_tbl-name:index-information(1)
      738         v-ind    = 2
      739       .
      740       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      741       on error undo, return error
      742       :
      743         assign
      744           v-inform = bh_tbl-name:index-information( v-ind )
      745           v-ind    = v-ind + 1
      746         .
      747       end.
      748       if v-inform = ?
      749         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      750         or entry( 3, v-inform, ",":U ) <> "1":U
      751       then do:
      752         delete object bh_tbl-name no-error.
      753         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      754       end.
      755       assign
      756         v-idx-field-qnty = num-entries( v-inform ) - 4
      757       .
      758       if v-idx-field-qnty < 2 then do:
      759         delete object bh_tbl-name no-error.
      760         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      761       end.
      762       assign
      763         o-where     = "where":U
      764         v-word-link = "":U
      765         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      766         v-count-fld = 0
      767       .
      768       if i-tablekey ne "" and i-tablekey ne ?
      769       then do:
      770         assign
      771           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      772         .
      773         create buffer bh_tbl-key for table v-full-tbl-name .
      774       end.
      775       if i-tableSerach ne "" and i-tableSerach ne ?
      776       then do:
      777         delete object bh_tbl-name no-error.
      778         assign
      779           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      780         .
      781         create buffer bh_tbl-name for table v-full-tbl-name .
      782       end.
      783       block_where:
      784       do v-ind = 1 to v-idx-field-qnty by 2
      785       on error undo, return error
      786       :
      787         assign
      788           v-count-fld = v-count-fld + 1
      789         .
      790         if p-key-handle = ?
      791           and v-count-fld > v-field-num
      792         then do:
      793           leave block_where.
      794         end.
      795         define variable VfieldKeyTable as handle no-undo.
      796         assign
      797           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      798           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      799         .
      800         if     bh_tbl-key ne ?
      801         then do:
      802            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      803            if VfieldKeyTable eq ?
      804            then next block_where.
      805         end.
      806         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      807         then
      808            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      809         else
      810            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      811         if p-key-handle = ? then do:
      812           assign
      813             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      814           .
      815         end.
      816         else do:
      817           assign
      818             fh_key = p-key-handle:buffer-field( v-field-name )
      819           .
      820           if fh_key = ?
      821             or not valid-handle( fh_key )
      822           then do:
      823             delete object bh_tbl-name.
      824             if     bh_tbl-key ne ?
      825             then
      826                delete object bh_tbl-key.
      827             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      828           end.
      829           assign
      830             v-field-val = fh_key:buffer-value
      831           .
      832         end.
      833         if fh_search:data-type ="character":U then do:
      834           assign
      835             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      836             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      837             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      838             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      839             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      840             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      841             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      842             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      843             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      844             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      845             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      846             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      847             v-field-val = substitute( '"&1"', v-field-val )
      848           .
      849         end.
      850         assign
      851           o-where = substitute( "&1 &2", o-where, v-field-val )
      852         .
      853         if v-word-link = "":U then do:
      854           assign
      855             v-word-link = "and":U
      856           .
      857         end.
      858       end.
      859       delete object bh_tbl-name.
      860       if     bh_tbl-key ne ?
      861       then
      862          delete object bh_tbl-key.
      863       if p-key-handle = ?
      864         and v-count-fld <> v-field-num
      865       then do:
      866         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      867       end.
      868     end.
      869   end procedure.
      870   procedure gen-hn-keyr-tab :
      871     define input  parameter i-tableSerach as character no-undo.
      872     define input  parameter i-tablekey   as character no-undo.
      873     define input  parameter p-key-rec    as character no-undo.
      874     define input  parameter p-key-handle as handle    no-undo .
      875     define input  parameter p-db-name    as character no-undo .
      876     define input  parameter p-tt-handle  as handle    no-undo .
      877     define input  parameter p-stts-lock  as integer   no-undo .
      878     define output parameter o-hn         as handle    no-undo.
      879     define variable v-full-tbl-name as character no-undo.
      880     define variable v-where         as character no-undo.
      881     define variable bh_tbl-name     as handle    no-undo.
      882     define variable vTable          as character no-undo.
      883     do
      884     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      885     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      886     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      887         run gen-where-keyr-tab(i-tableSerach,
      888                                i-tablekey,
      889                                p-key-rec,
      890                                p-key-handle,
      891                                p-db-name,
      892                                p-tt-handle,
      893                                output v-where).
      894         if i-tableSerach ne "" and i-tableSerach ne ?
      895         then do:
      896            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      897            create buffer bh_tbl-name for table v-full-tbl-name .
      898         end.
      899         else do:
      900            if p-tt-handle = ? then do:
      901               assign
      902                  vTable = entry( 1 , p-key-rec, chr(3) )
      903               .
      904               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      905               create buffer bh_tbl-name for table v-full-tbl-name .
      906            end.
      907            else do:
      908               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      909            end.
      910         end.
      911         if p-tt-handle = ? then do:
      912            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      913         end.
      914         else do:
      915            bh_tbl-name:find-first( v-where ) no-error .
      916         end.
      917         o-hn = bh_tbl-name.
      918      end.
      919   end procedure.
      920   procedure gen-hn-keyr :
      921     define input  parameter p-key-rec    as character no-undo.
      922     define input  parameter p-key-handle as handle    no-undo .
      923     define input  parameter p-db-name    as character no-undo .
      924     define input  parameter p-tt-handle  as handle    no-undo .
      925     define input  parameter p-stts-lock  as integer   no-undo .
      926     define output parameter o-hn         as handle    no-undo.
      927     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      928   end.
      929   procedure gen-row-keyr :
      930     define input  parameter p-key-rec    as character no-undo.
      931     define input  parameter p-key-handle as handle    no-undo .
      932     define input  parameter p-db-name    as character no-undo .
      933     define input  parameter p-tt-handle  as handle    no-undo .
      934     define input  parameter p-stts-lock  as integer   no-undo .
      935     define output parameter p-tbl-row    as rowid     no-undo.
      936     define output parameter p-tbl-name   as character no-undo.
      937     define variable vHn as handle no-undo.
      938       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      939       p-tbl-row = if vHn:available then vHn:rowid else ?.
      940       p-tbl-name =  vHn:table.
      941       delete object vHn no-error.
      942     if p-tbl-row = ? then do:
      943       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      944     end.
      945     else do:
      946       return.
      947     end.
      948   end procedure.
      949   procedure gen-key-fv :
      950     define input  parameter p-key-rec    as character no-undo .
      951     define output parameter p-field-list as character no-undo .
      952     define output parameter p-value-list as character no-undo.
      953     do
      954     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      955     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      956     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      957     :
      958       define variable v-full-tbl-name  as character no-undo .
      959       define variable bh_tbl-name      as handle    no-undo .
      960       define variable v-tbl-name       as character no-undo .
      961       define variable v-field-num      as integer   no-undo .
      962       define variable v-count-fld      as integer   no-undo .
      963       define variable v-inform         as character no-undo .
      964       define variable v-ind            as integer   no-undo .
      965       define variable v-idx-field-qnty as integer   no-undo .
      966       define variable v-delim-key      as character no-undo .
      967       if p-key-rec = ?
      968         or p-key-rec = "":U
      969       then do:
      970         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      971       end.
      972       assign
      973         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      974         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      975       .
      976       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      977       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      978       assign
      979         v-inform = bh_tbl-name:index-information(1)
      980         v-ind    = 2
      981       .
      982       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      983       on error undo, return error
      984       :
      985         assign
      986           v-inform = bh_tbl-name:index-information( v-ind )
      987           v-ind    = v-ind + 1
      988         .
      989       end.
      990       if v-inform = ?
      991         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      992         or entry( 3, v-inform, ",":U ) <> "1":U
      993       then do:
      994         delete object bh_tbl-name no-error.
      995         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      996       end.
      997       assign
      998         v-idx-field-qnty = num-entries( v-inform ) - 4
      999       .
     1000       if v-idx-field-qnty < 2 then do:
     1001         delete object bh_tbl-name no-error.
     1002         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1003       end.
     1004       assign
     1005         p-field-list = "":U
     1006         p-value-list = "":U
     1007         v-delim-key  = "":U
     1008         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1009         v-count-fld  = 0
     1010       .
     1011       block_where:
     1012       do v-ind = 1 to v-idx-field-qnty by 2
     1013       on error undo, return error
     1014       :
     1015         assign
     1016           v-count-fld = v-count-fld + 1
     1017         .
     1018         if v-count-fld > v-field-num then do:
     1019           leave block_where.
     1020         end.
     1021         assign
     1022           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1023           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1024         .
     1025         if v-ind = 1 then do:
     1026           assign
     1027             v-delim-key = chr(3)
     1028           .
     1029         end.
     1030       end.
     1031       delete object bh_tbl-name.
     1032       if v-count-fld <> v-field-num then do:
     1033         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
     1034       end.
     1035     end.
     1036   end procedure.
     1037   procedure gen-key-field :
     1038     define input  parameter p-table      as character no-undo .
     1039     define output parameter p-field-list as character no-undo .
     1040     do
     1041     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1042     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1043     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1044     :
     1045       define variable v-full-tbl-name  as character no-undo .
     1046       define variable bh_tbl-name      as handle    no-undo .
     1047       define variable v-tbl-name       as character no-undo .
     1048       define variable v-field-num      as integer   no-undo .
     1049       define variable v-count-fld      as integer   no-undo .
     1050       define variable v-inform         as character no-undo .
     1051       define variable v-ind            as integer   no-undo .
     1052       define variable v-idx-field-qnty as integer   no-undo .
     1053       define variable v-delim-key      as character no-undo .
     1054       if p-table = ?
     1055         or p-table = "":U
     1056       then do:
     1057         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1058       end.
     1059       assign
     1060         v-tbl-name      = p-table
     1061         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1062       .
     1063       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1064       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1065       assign
     1066         v-inform = bh_tbl-name:index-information(1)
     1067         v-ind    = 2
     1068       .
     1069       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1070       on error undo, return error
     1071       :
     1072         assign
     1073           v-inform = bh_tbl-name:index-information( v-ind )
     1074           v-ind    = v-ind + 1
     1075         .
     1076       end.
     1077       if v-inform = ?
     1078         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1079         or entry( 3, v-inform, ",":U ) <> "1":U
     1080       then do:
     1081         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1082       end.
     1083       assign
     1084         v-idx-field-qnty = num-entries( v-inform ) - 4
     1085       .
     1086       if v-idx-field-qnty < 2 then do:
     1087         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1088       end.
     1089       assign
     1090         p-field-list = "":U
     1091         v-delim-key  = "":U
     1092         v-count-fld  = 0
     1093       .
     1094       block_where:
     1095       do v-ind = 1 to v-idx-field-qnty by 2
     1096       on error undo, return error
     1097       :
     1098         assign
     1099           v-count-fld = v-count-fld + 1
     1100         .
     1101         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1102         if v-ind = 1 then do:
     1103           assign
     1104             v-delim-key = chr(3)
     1105           .
     1106         end.
     1107       end.
     1108       delete object bh_tbl-name.
     1109     end.
     1110   end procedure.
     1111   define stream imp-stream.
     1112   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1113   define new shared temp-table temp-tables no-undo
     1114   field tbl-name as character
     1115   field buf-handle as handle
     1116   field tbl-handle as handle
     1117   index pi is unique primary
     1118   tbl-name.
     1119   define new shared temp-table temp-command no-undo
     1120   field command-name as character
     1121   field tbl-name as character
     1122   field uniq-key-rec as character
     1123   index pi is unique primary
     1124   tbl-name
     1125   command-name
     1126   uniq-key-rec
     1127   index icommand
     1128   command-name
     1129   tbl-name
     1130   uniq-key-rec
     1131   .
     1132   define buffer buf_temp-tables for temp-tables.
