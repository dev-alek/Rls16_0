     1144   define new shared temp-table tt-prop-head no-undo like ub.prop-head . find first buf_temp-tables where buf_temp-tables.tbl-name = "prop-head" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "prop-head"    buf_temp-tables.buf-handle = buffer tt-prop-head:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1145   define new shared temp-table tt-prop-ruleset no-undo like ub.prop-ruleset . find first buf_temp-tables where buf_temp-tables.tbl-name = "prop-ruleset" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "prop-ruleset"    buf_temp-tables.buf-handle = buffer tt-prop-ruleset:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1146   define new shared temp-table tt-prop-map no-undo like ub.prop-map . find first buf_temp-tables where buf_temp-tables.tbl-name = "prop-map" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "prop-map"    buf_temp-tables.buf-handle = buffer tt-prop-map:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1147   define new shared temp-table tt-prop-script no-undo like ub.prop-script . find first buf_temp-tables where buf_temp-tables.tbl-name = "prop-script" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "prop-script"    buf_temp-tables.buf-handle = buffer tt-prop-script:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1148   define new shared temp-table tt-pscript-ruleset no-undo like ub.pscript-ruleset . find first buf_temp-tables where buf_temp-tables.tbl-name = "pscript-ruleset" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "pscript-ruleset"    buf_temp-tables.buf-handle = buffer tt-pscript-ruleset:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1149   define new shared temp-table tt-rule-profile no-undo like ub.rule-profile . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule-profile" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule-profile"    buf_temp-tables.buf-handle = buffer tt-rule-profile:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1150   define new shared temp-table tt-rule-by-profile no-undo like ub.rule-by-profile . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule-by-profile" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule-by-profile"    buf_temp-tables.buf-handle = buffer tt-rule-by-profile:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1151   define new shared temp-table tt-ruledict no-undo like ub.ruledict . find first buf_temp-tables where buf_temp-tables.tbl-name = "ruledict" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "ruledict"    buf_temp-tables.buf-handle = buffer tt-ruledict:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1152   define new shared temp-table tt-ruledict-param no-undo like ub.ruledict-param . find first buf_temp-tables where buf_temp-tables.tbl-name = "ruledict-param" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "ruledict-param"    buf_temp-tables.buf-handle = buffer tt-ruledict-param:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1153   define new shared temp-table tt-rule no-undo like ub.rule . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule"    buf_temp-tables.buf-handle = buffer tt-rule:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1154   define new shared temp-table tt-rule-script no-undo like ub.rule-script . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule-script" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule-script"    buf_temp-tables.buf-handle = buffer tt-rule-script:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1155   define new shared temp-table tt-rule-i-script no-undo like ub.rule-i-script . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule-i-script" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule-i-script"    buf_temp-tables.buf-handle = buffer tt-rule-i-script:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1156   define new shared temp-table tt-rule-by-set no-undo like ub.rule-by-set . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule-by-set" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule-by-set"    buf_temp-tables.buf-handle = buffer tt-rule-by-set:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1157   define new shared temp-table tt-prop-ref no-undo like ub.prop-ref . find first buf_temp-tables where buf_temp-tables.tbl-name = "prop-ref" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "prop-ref"    buf_temp-tables.buf-handle = buffer tt-prop-ref:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1158   define new shared temp-table tt-rp-rule-param no-undo like ub.rp-rule-param . find first buf_temp-tables where buf_temp-tables.tbl-name = "rp-rule-param" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rp-rule-param"    buf_temp-tables.buf-handle = buffer tt-rp-rule-param:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1159   define new shared temp-table tt-rule-process no-undo like ub.rule-process . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule-process" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule-process"    buf_temp-tables.buf-handle = buffer tt-rule-process:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1160   define buffer buf_tt-ruledict for tt-ruledict.
     1161   run waitfram-show in this-procedure ("Реинициализация конфигурации RUM").
     1162   main-block:
     1163   do
     1164   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1165   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1166   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1167   :
     1168     if ( g#db-num > 0 ) then return.
     1169     if not p-forced then do:
     1170       run check-rum-version in this-procedure (output v-check1).
     1171     end.
     1172     if v-check1
     1173     or p-forced
     1174     then do:
     1175        if v-check1
     1176        and p-read-only then do:
     1177           return error substitute("&1 &2 &3&4До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!"
     1178                                   ,vss-workfile
     1179                                   ,vss-revision
     1180                                   ,vss-description
     1181                                   ,chr(10)).
     1182        end.
     1183       run gbl/md5.p (
     1184          input  "cmp/fixrum.txt"
     1185         ,output v-md5-signature
     1186         ) .
     1187       if v-md5-signature <> "102FB8E7686A0D9709EA4F3B552EA51C" then do:
     1188         message
     1189         substitute("Несовпадение файла эталонных записей по конфигурации RUM (fixrum.txt) с контрольным числом")
     1190         view-as alert-box error .
     1191         undo, return error .
     1192       end.
     1193       run gbl/filename.p ( input "cmp/fixrum.txt"
     1194                           ,output v-full-path
     1195                           ,output v-path
     1196                           ,output v-file-name
     1197                           ,output v-file-name-no-ext
     1198                           ,output v-file-name-ext
     1199                           ) no-error .
     1200       if error-status:error then do:
     1201         message
     1202         substitute("Не найден файл эталонных записей по конфигурации RUM (fixrum.txt)")
     1203         view-as alert-box error .
     1204         undo, return error .
     1205       end.
     1206       run str/diallog.w (
     1207             input ?
     1208           ,input this-procedure
     1209           ,input ('utl/upg-imp.p' + chr(4)  +
     1210                   '1' + chr(4) +
     1211                   '1' + chr(4) +
     1212                   '1' + chr(4) +
     1213                   '1')
     1214           ,input v-full-path
     1215           ,input yes
     1216           ,input 'Прервать'
     1217           ,input 'Чтение файла в память') no-error .
     1218       if error-status:error then do:
     1219         message
     1220         substitute("Ошибка при чтении файла эталонных записей по конфигурации RUM (fixrum.txt)&1&2&1&3"
     1221                      , chr(10)
     1222                      , error-status:get-message(1)
     1223                      , return-value )
     1224         view-as alert-box error .
     1225         undo, return error .
     1226       end.
     1227       for each buf_temp-tables
     1228       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1229       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1230       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1231       :
     1232         if valid-handle(buf_temp-tables.tbl-handle) then do:
     1233           delete object buf_temp-tables.tbl-handle.
     1234         end.
     1235       end.
     1236       define buffer buf_rule for ub.rule.
     1237       find last buf_rule no-lock use-index pi.
     1238       if current-value(s-rule-id, ub) < buf_rule.rule_Id then do:
     1239         current-value(s-rule-id, ub) = buf_rule.rule_Id.
     1240       end.
     1241       define buffer buf_rule-script for ub.rule-script.
     1242       find last buf_rule-script no-lock use-index pi.
     1243       if current-value(s-rule-script-id, ub) < buf_rule-script.script_Id then do:
     1244         current-value(s-rule-script-id, ub) = buf_rule-script.script_Id.
     1245       end.
     1246       define variable v-rule-profile-uniq-key-rec as character no-undo .
     1247       define variable v-mess as character no-undo .
     1248       define buffer buf_rule-profile for ub.rule-profile.
     1249       define buffer buf_ruledict for ub.ruledict.
     1250       define buffer buf_ruledict-param for ub.ruledict-param.
     1251       for each buf_rule-profile no-lock
     1252       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1253       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1254       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1255       :
     1256         run gen-key-rec in this-procedure (
     1257                                           input  'rule-profile':U
     1258                                           ,input buffer buf_rule-profile:handle
     1259                                           ,output v-rule-profile-uniq-key-rec).
     1260         for first buf_ruledict no-lock where
     1261                 buf_ruledict.uniq-key-rec = v-rule-profile-uniq-key-rec,
     1262             each buf_ruledict-param no-lock where
     1263                 buf_ruledict-param.entry-id = buf_ruledict.entry-id
     1264         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1265         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1266         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
     1267           if buf_ruledict-param.param-data-type = 'character':U
     1268           and buf_ruledict-param.param-2-data-type = "xsd"
     1269           then do:
     1270             run rul/rdp-clob.p ( buffer buf_ruledict-param
     1271                                 ,input  'ИЗМЕНЕНИЕ':U) no-error.
     1272             if error-status:error then  do:
     1273                           message substitute("Не удалось сохранить CLOB &1:&2&3&2&4"                                 ,buf_ruledict-param.init-value-character                                 ,chr(10)                                 , error-status:get-message(1)                                 , return-value ) view-as alert-box.
     1274               undo, return error .
     1275             end.
     1276           end.
     1277         end.
     1278       end.
     1279     end.
     1280   end.
     1281   run waitfram-hide in this-procedure .
     1282   function get-order-id returns integer ( input p-profile-id as integer
     1283                                          ,input p-codex-id as integer
     1284                                          ,input p-ruleset-id as integer
     1285                                          ,input p-rp-order-id as integer
     1286                                          ,input p-call-id as character
     1287                                          ,input p-once-more as integer
     1288                                          ):
     1289   define variable v-ii as integer   no-undo .
     1290   define buffer buf_rule-by-call for ub.rule-by-call.
     1291   for each buf_rule-by-call no-lock where
     1292           buf_rule-by-call.call_id = p-call-id
     1293       and buf_rule-by-call.codex_id = p-codex-id
     1294       and buf_rule-by-call.ruleset_id = p-ruleset-id
     1295       and buf_rule-by-call.once-more = p-once-more
     1296       and buf_rule-by-call.profile_id = p-profile-id
     1297       :
     1298       if v-ii = p-rp-order-id then do:
     1299          return buf_rule-by-call.order_id.
     1300       end.
     1301       v-ii = v-ii + 1.
     1302   end.
     1303   return -1.
     1304   end.
     1305   procedure ruledict-param_add :
     1306   define input parameter p-bh as handle no-undo .
     1307     run ruledict-param_add-update in this-procedure ( input p-bh, input p-bh:rowid) no-error.
     1308     if error-status :error then undo, return error return-value .
     1309   end.
     1310   procedure ruledict-param_update :
     1311   define input parameter p-bh-old as handle no-undo .
     1312   define input parameter p-bh-new-temp as handle no-undo .
     1313     run ruledict-param_add-update in this-procedure ( input p-bh-new-temp, input p-bh-old:rowid) no-error.
     1314     if error-status :error then undo, return error return-value .
     1315   end.
     1316   procedure ruledict-param_add-update :
     1317   define input parameter p-bh as handle no-undo .
     1318   define input parameter p-rowid as rowid no-undo .
     1319   define buffer buf_ruledict-param for ub.ruledict-param.
     1320   define buffer buf_ruledict for ub.ruledict.
     1321     do
     1322     on error undo, return error
     1323     :
     1324       find first buf_ruledict-param where
     1325                 rowid(buf_ruledict-param) = p-rowid.
     1326       if p-bh::param-data-type = 'character':U
     1327       and p-bh::param-2-data-type = "xsd"
     1328       then do:
     1329         find first buf_ruledict no-lock where
     1330                   buf_ruledict.entry-id = buf_ruledict-param.entry-id  no-error.
     1331         if available buf_ruledict
     1332         and buf_ruledict.entry-type = 'rule-profile':U then do:
     1333           run rul/rdp-clob.p ( buffer buf_ruledict-param
     1334                               ,input (if new(buf_ruledict-param) then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)) no-error.
     1335           if error-status:error then  do:
     1336                       message substitute("Не удалось сохранить CLOB &1:&2&3&2&4"                               ,p-bh::init-value-character                               ,chr(10)                               , error-status:get-message(1)                               , return-value ) view-as alert-box.
     1337             undo, return error .
     1338           end.
     1339         end.
     1340       end.
     1341     end.
     1342   end procedure.
     1343   procedure ruledict-param_delete :
     1344   define input parameter p-bh as handle no-undo .
     1345   define buffer buf_ruledict-param for ub.ruledict-param.
     1346     do
     1347     on error undo, return error
     1348     :
     1349       find first buf_ruledict-param where
     1350                 rowid(buf_ruledict-param) = p-bh:rowid.
     1351       if buf_ruledict-param.param-data-type = 'character':U
     1352       and buf_ruledict-param.param-2-data-type = "xsd"
     1353       then do:
     1354         run rul/rdp-clob.p ( buffer buf_ruledict-param
     1355                             ,input  'удаление':U)) no-error.
     1356         if error-status:error then  do:
     1357                   message substitute("Не удалось сохранить CLOB &1:&2&3&2&4"                             ,buf_ruledict-param.init-value-character                             ,chr(10)                             , error-status:get-message(1)                             , return-value ) view-as alert-box.
     1358           undo, return error .
     1359         end.
     1360       end.
     1361     end.
     1362   end procedure.
     1363   procedure rp-rule-param_add :
     1364   define input parameter p-bh as handle no-undo .
     1365   define variable v-rule-profile-uniq-key-rec as character no-undo .
     1366   define variable v-curr-r-b as character no-undo .
     1367   define variable v-order-id as integer   no-undo .
     1368   define variable v-order-id2 as integer   no-undo .
     1369   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1370   define buffer buf2_rp-rule-param for ub.rp-rule-param.
     1371   define buffer buf_rule-call-param for ub.rule-call-param.
     1372   define buffer buf2_rule-call-param for ub.rule-call-param.
     1373   define buffer buf_rule-profile for ub.rule-profile.
     1374   define buffer buf_ruledict for ub.ruledict.
     1375   define buffer buf2_ruledict for ub.ruledict.
     1376   define buffer buf_ruledict2 for ub.ruledict.
     1377   define buffer buf_ruledict-param for ub.ruledict-param.
     1378   define buffer buf2_ruledict-param for ub.ruledict-param.
     1379   define buffer buf_ruledict-param2 for ub.ruledict-param.
     1380   define buffer buf_rule-by-call for ub.rule-by-call.
     1381   define buffer buf2_rule-by-call for ub.rule-by-call.
     1382   define buffer buf_rp-by-call for ub.rp-by-call.
     1383   define buffer buf_rule for ub.rule.
     1384   define buffer buf2_rule for ub.rule.
     1385   main-block:
     1386   do
     1387   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1388   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1389   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1390   :
     1391     find first buf_rp-rule-param where
     1392               rowid(buf_rp-rule-param) = p-bh:rowid.
     1393     find first buf_rule-profile where buf_rule-profile.profile_id = buf_rp-rule-param.profile_id.
     1394     run gen-key-rec in this-procedure (
     1395                                       input  'rule-profile':U
     1396                                       ,input buffer buf_rule-profile:handle
     1397                                       ,output v-rule-profile-uniq-key-rec).
     1398     find first buf_ruledict2 no-lock where
     1399             buf_ruledict2.entry-type = 'rule-profile':U
     1400         and  buf_ruledict2.uniq-key-rec = v-rule-profile-uniq-key-rec.
     1401     find first buf_ruledict-param2 no-lock where
     1402           buf_ruledict-param2.entry-id = buf_ruledict2.entry-id
     1403       and buf_ruledict-param2.param-name = buf_rp-rule-param.rp-param-name.
     1404     for each buf_rp-by-call exclusive-lock where
     1405             buf_rp-by-call.profile_id = buf_rp-rule-param.profile_id
     1406     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1407     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1408     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1409     :
     1410       v-order-id = get-order-id ( input buf_rp-rule-param.profile_id
     1411                                 ,input buf_rp-rule-param.codex_id
     1412                                 ,input buf_rp-rule-param.ruleset_id
     1413                                 ,input buf_rp-rule-param.rp_order_id
     1414                                 ,input buf_rp-by-call.call_id
     1415                                 ,input buf_rp-by-call.once-more
     1416                                 ).
     1417       if v-order-id <> -1 then do:
     1418         find first buf_rule-by-call exclusive-lock where
     1419               buf_rule-by-call.call_id = buf_rp-by-call.call_id
     1420           and buf_rule-by-call.codex_id = buf_rp-rule-param.codex_id
     1421           and buf_rule-by-call.ruleset_id = buf_rp-rule-param.ruleset_id
     1422           and buf_rule-by-call.order_id = v-order-id.
     1423         for each buf2_rp-rule-param no-lock where
     1424                   buf2_rp-rule-param.profile_id = buf_rp-rule-param.profile_id
     1425               and buf2_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name:
     1426           v-order-id2 = get-order-id ( input buf2_rp-rule-param.profile_id
     1427                                     ,input buf2_rp-rule-param.codex_id
     1428                                     ,input buf2_rp-rule-param.ruleset_id
     1429                                     ,input buf2_rp-rule-param.rp_order_id
     1430                                     ,input buf_rp-by-call.call_id
     1431                                     ,input buf_rp-by-call.once-more
     1432                                     ).
     1433           find first buf2_rule-by-call exclusive-lock where
     1434                 buf2_rule-by-call.call_id = buf_rp-by-call.call_id
     1435             and buf2_rule-by-call.codex_id = buf2_rp-rule-param.codex_id
     1436             and buf2_rule-by-call.ruleset_id = buf2_rp-rule-param.ruleset_id
     1437             and buf2_rule-by-call.order_id = v-order-id2.
     1438           find first buf2_rule no-lock where
     1439                     buf2_rule.rule_id = buf2_rp-rule-param.rule_id.
     1440           find first buf2_ruledict no-lock where
     1441                   buf2_ruledict.entry-type = 'rule':U
     1442               and  buf2_ruledict.uniq-key-rec = buf2_rule.uniq-key-rec.
     1443             find first buf2_ruledict-param where
     1444                       buf2_ruledict-param.entry-id = buf2_ruledict.entry-id
     1445                   and buf2_ruledict-param.param-name = buf2_rp-rule-param.rule-param-name
     1446                       .
     1447             find first buf2_rule-call-param where
     1448                       buf2_rule-call-param.call_id = buf2_rule-by-call.call_id
     1449                   and buf2_rule-call-param.codex_id = buf2_rule-by-call.codex_id
     1450                   and buf2_rule-call-param.ruleset_id = buf2_rule-by-call.ruleset_id
     1451                   and buf2_rule-call-param.order_id = buf2_rule-by-call.order_id
     1452                   and buf2_rule-call-param.param-name = buf2_ruledict-param.param-name no-error.
     1453            if available buf2_rule-call-param then leave.
     1454         end.
     1455         find first buf_rule no-lock where
     1456                   buf_rule.rule_id = buf_rule-by-call.rule_id.
     1457         find first buf_ruledict no-lock where
     1458                 buf_ruledict.entry-type = 'rule':U
     1459             and  buf_ruledict.uniq-key-rec = buf_rule.uniq-key-rec.
     1460           find first buf_ruledict-param where
     1461                     buf_ruledict-param.entry-id = buf_ruledict.entry-id
     1462                 and buf_ruledict-param.param-name = buf_rp-rule-param.rule-param-name
     1463                     .
     1464           find first buf_rule-call-param where
     1465                     buf_rule-call-param.call_id = buf_rule-by-call.call_id
     1466                 and buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     1467                 and buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     1468                 and buf_rule-call-param.order_id = buf_rule-by-call.order_id
     1469                 and buf_rule-call-param.param-name = buf_ruledict-param.param-name no-error.
     1470           if not available buf_rule-call-param then do:
     1471             create buf_rule-call-param.
     1472             assign
     1473             buf_rule-call-param.call#_id = buf_rule-by-call.call#_id
     1474             buf_rule-call-param.call_id = buf_rule-by-call.call_id
     1475             buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     1476             buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     1477             buf_rule-call-param.order_id = buf_rule-by-call.order_id
     1478             buf_rule-call-param.param-name = buf_ruledict-param.param-name
     1479             .
     1480           end.
     1481           assign
     1482           buf_rule-call-param.rule_id = buf_rule-by-call.rule_id
     1483           buf_rule-call-param.p-index = 0
     1484           buf_rule-call-param.param-des = buf_ruledict-param.documentation
     1485           buf_rule-call-param.param-num = buf_ruledict-param.param-num
     1486           buf_rule-call-param.param-label = buf_ruledict-param.param-label
     1487           buf_rule-call-param.param-mode = buf_ruledict-param.param-mode
     1488           buf_rule-call-param.param-data-type = buf_ruledict-param.param-data-type
     1489           buf_rule-call-param.param-2-data-type = buf_ruledict-param.param-2-data-type
     1490           buf_rule-call-param.param-3-data-type = buf_ruledict-param.param-3-data-type
     1491           buf_rule-call-param.param-value-character = buf_ruledict-param2.init-value-character
     1492           buf_rule-call-param.param-value-date = buf_ruledict-param2.init-value-date
     1493           buf_rule-call-param.param-value-decimal = buf_ruledict-param2.init-value-decimal
     1494           buf_rule-call-param.param-value-integer = buf_ruledict-param2.init-value-integer
     1495           buf_rule-call-param.param-value-logical = buf_ruledict-param2.init-value-logical
     1496           buf_rule-call-param.profile_id          = buf_rule-by-call.profile_id
     1497           buf_rule-call-param.once-more           = buf_rule-by-call.once-more
     1498           .
     1499           if available buf2_rule-call-param then do:
     1500             assign
     1501             buf_rule-call-param.param-value-character = buf2_rule-call-param.param-value-character
     1502             buf_rule-call-param.param-value-date      = buf2_rule-call-param.param-value-date
     1503             buf_rule-call-param.param-value-decimal   = buf2_rule-call-param.param-value-decimal
     1504             buf_rule-call-param.param-value-integer   = buf2_rule-call-param.param-value-integer
     1505             buf_rule-call-param.param-value-logical   = buf2_rule-call-param.param-value-logical
     1506             .
     1507           end.
     1508   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1509   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1510     (output v-curr-r-b
     1511     )  .
     1512         if buf_ruledict-param.param-2-data-type = "r-b" then do:
     1513           buf_rule-call-param.param-value-character = (if v-curr-r-b = 'rubl':U
     1514                                                           then 'rubl':U
     1515                                                           else 'base':U).
     1516         end.
     1517         if available buf_rule-call-param then do:
     1518           run str/callnews.p
     1519             (input 'rule-call-param':U
     1520             ,input (buffer buf_rule-call-param:handle)
     1521             ) no-error .
     1522           if error-status:error then do:
     1523                           message substitute("Не удалось сохранить rule-call-param&1:&2&1&3"                                 ,chr(10)                                 , error-status:get-message(1)                                 , return-value ) view-as alert-box.
     1524             undo main-block, return error .
     1525           end.
     1526         end.
     1527       end.
     1528     end.
     1529   end.
     1530   end procedure.
     1531   procedure rp-rule-param_delete :
     1532   define input parameter p-bh as handle no-undo .
     1533   define variable v-order-id as integer   no-undo .
     1534   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1535   define buffer buf_rp-by-call for ub.rp-by-call.
     1536   define buffer buf_rule-call-param for ub.rule-call-param.
     1537   main-block:
     1538   do
     1539   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1540   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1541   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1542   :
     1543     find first buf_rp-rule-param where
     1544               rowid(buf_rp-rule-param) = p-bh:rowid.
     1545     for each buf_rp-by-call exclusive-lock where
     1546             buf_rp-by-call.profile_id = buf_rp-rule-param.profile_id
     1547     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1548     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1549     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1550     :
     1551       v-order-id = get-order-id ( input buf_rp-rule-param.profile_id
     1552                                 ,input buf_rp-rule-param.codex_id
     1553                                 ,input buf_rp-rule-param.ruleset_id
     1554                                 ,input buf_rp-rule-param.rp_order_id
     1555                                 ,input buf_rp-by-call.call_id
     1556                                 ,input buf_rp-by-call.once-more
     1557                                 ).
     1558      if v-order-id <> -1 then do:
     1559        for each buf_rule-call-param exclusive-lock where
     1560             buf_rule-call-param.call_id = buf_rp-by-call.call_id
     1561         and buf_rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1562         and buf_rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1563         and buf_rule-call-param.order_id = v-order-id
     1564         and buf_rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1565         and buf_rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1566         and buf_rule-call-param.profile_id  = buf_rp-rule-param.profile_id
     1567         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1568         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1569         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1570         :
     1571           run nws/cmd-del.p
     1572             ( input 'rule-call-param':U
     1573             ,input (buffer buf_rule-call-param:handle)
     1574             ,input ''
     1575             ) no-error .
     1576           if error-status :error then do:
     1577             if error-status:error then do:
     1578                               message substitute("Не удалось удалить rule-call-param&1:&2&1&3"                                   ,chr(10)                                   , error-status:get-message(1)                                   , return-value ) view-as alert-box.
     1579                undo main-block, return error .
     1580             end.
     1581           end.
     1582           delete buf_rule-call-param.
     1583        end.
     1584      end.
     1585     end.
     1586   end.
     1587   end procedure.
     1588   procedure rule-by-profile_update :
     1589   define input parameter p-bh-old as handle no-undo .
     1590   define input parameter p-bh-new-temp as handle no-undo .
     1591   define variable v-order-id as integer   no-undo .
     1592   define buffer buf_rule-by-call for ub.rule-by-call.
     1593   define buffer buf_rp-by-call for ub.rp-by-call.
     1594   main-block:
     1595   do
     1596   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1597   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1598   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1599   :
     1600     if p-bh-old::is_dynamic <> p-bh-new-temp::is_dynamic
     1601     and p-bh-old::codex_id = p-bh-new-temp::codex_id
     1602     and p-bh-old::ruleset_id = p-bh-new-temp::ruleset_id
     1603     and p-bh-old::profile_id = p-bh-new-temp::profile_id
     1604     and p-bh-old::rule_id = p-bh-new-temp::rule_id
     1605     and p-bh-old::rp_order_id = p-bh-new-temp::rp_order_id then do:
     1606       for each buf_rp-by-call share-lock where
     1607               buf_rp-by-call.profile_id = p-bh-old::profile_id
     1608       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1609       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1610       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1611       :
     1612         v-order-id = get-order-id ( input p-bh-old::profile_id
     1613                                   ,input p-bh-old::codex_id
     1614                                   ,input p-bh-old::ruleset_id
     1615                                   ,input p-bh-old::rp_order_id
     1616                                   ,input buf_rp-by-call.call_id
     1617                                   ,input buf_rp-by-call.once-more
     1618                                   ).
     1619         if v-order-id <> -1 then do:
     1620           find first buf_rule-by-call share-lock where
     1621               buf_rule-by-call.call_id = buf_rp-by-call.call_id
     1622           and buf_rule-by-call.profile_id = p-bh-old::profile_id
     1623           and buf_rule-by-call.codex_id = p-bh-old::codex_id
     1624           and buf_rule-by-call.ruleset_id = p-bh-old::ruleset_id
     1625           and buf_rule-by-call.rule_id = p-bh-old::rule_id
     1626           and buf_rule-by-call.order_id = v-order-id no-error.
     1627           if available buf_rule-by-call then do:
     1628             if p-bh-old::is_dynamic = yes then do:
     1629               assign
     1630               buf_rule-by-call.can-calc = yes
     1631               buf_rule-by-call.can-run = yes
     1632               .
     1633             end.
     1634             if p-bh-old::is_dynamic = no
     1635             and p-bh-new-temp::is_dynamic = yes
     1636             then do:
     1637               assign
     1638               buf_rule-by-call.is_dynamic = yes
     1639               .
     1640             end.
     1641             run str/callnews.p
     1642               (input 'rule-by-call':U
     1643               ,input (buffer buf_rule-by-call:handle)
     1644               ) no-error .
     1645             if error-status:error then do:
     1646                           message substitute("Не удалось сохранить rule-by-call-param&1:&2&1&3"                                 ,chr(10)                                 , error-status:get-message(1)                                 , return-value ) view-as alert-box.
     1647               undo main-block, return error .
     1648           end.
     1649         end.
     1650       end.
     1651       end.
     1652     end.
     1653   end.
     1654   end procedure.
     1655   procedure rule-by-profile_add :
     1656   define input parameter p-bh as handle no-undo .
     1657   define variable v-order-id as integer no-undo .
     1658   define variable v-exist as logical   no-undo .
     1659   define variable v-rule-by-call-uniq-key-rec as character no-undo .
     1660   define buffer buf_rule-by-profile for ub.rule-by-profile.
     1661   define buffer buf_rp-by-call for ub.rp-by-call.
     1662   define buffer buf_rule-by-call for ub.rule-by-call.
     1663   define buffer buf_rule-profile for ub.rule-profile.
     1664   define buffer bufo_rule-by-profile  for ub.rule-by-profile .
     1665   define buffer buf_rule-call-param for ub.rule-call-param.
     1666   define buffer buf_rule for ub.rule.
     1667   main-block:
     1668   do
     1669   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1670   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1671   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1672   :
     1673     find first buf_rule-by-profile where
     1674               rowid(buf_rule-by-profile) = p-bh:rowid.
     1675     find first buf_rule-profile where
     1676               buf_rule-profile.profile_id = buf_rule-by-profile.profile_id.
     1677     for each buf_rp-by-call exclusive-lock where
     1678             buf_rp-by-call.profile_id = buf_rule-by-profile.profile_id
     1679     break
     1680     by buf_rp-by-call.call_id
     1681     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1682     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1683     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1684     :
     1685       v-exist = no.
     1686       find first bufo_rule-by-profile no-lock where
     1687                 bufo_rule-by-profile.profile_id = buf_rule-by-profile.profile_id
     1688             and bufo_rule-by-profile.codex_id = buf_rule-by-profile.codex_id
     1689             and bufo_rule-by-profile.ruleset_id = buf_rule-by-profile.ruleset_id
     1690             and bufo_rule-by-profile.rp_order_id = buf_rule-by-profile.rp_order_id no-error.
     1691       if available bufo_rule-by-profile  and
     1692       bufo_rule-by-profile.rule_id <> buf_rule-by-profile.rule_id then do:
     1693         v-order-id = get-order-id ( input buf_rp-by-call.profile_id
     1694                                   ,input buf_rule-by-profile.codex_id
     1695                                   ,input buf_rule-by-profile.ruleset_id
     1696                                   ,input buf_rule-by-profile.rp_order_id
     1697                                   ,input buf_rp-by-call.call_id
     1698                                   ,input buf_rp-by-call.once-more
     1699                                   ).
     1700         if v-order-id <> -1 then do:
     1701           find first buf_rule-by-call where
     1702                     buf_rule-by-call.call_id = buf_rp-by-call.call_id
     1703                 and buf_rule-by-call.profile_id = buf_rule-by-profile.profile_id
     1704                 and buf_rule-by-call.once-more = buf_rp-by-call.once-more
     1705                 and buf_rule-by-call.codex_id = buf_rule-by-profile.codex_id
     1706                 and buf_rule-by-call.ruleset_id  = buf_rule-by-profile.ruleset_id
     1707                 and buf_rule-by-call.order_id = v-order-id
     1708                 and buf_rule-by-call.rule_id = bufo_rule-by-profile.rule_id
     1709                 no-error.
     1710           if available buf_rule-by-call then do:
     1711             v-exist = yes.
     1712             for each buf_rule-call-param exclusive-lock where
     1713                     buf_rule-call-param.call_id = buf_rule-by-call.call_id
     1714                 and buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     1715                 and buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     1716                 and buf_rule-call-param.order_id = buf_rule-by-call.order_id
     1717             on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1718             on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1719             on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1720             :
     1721               assign
     1722               buf_rule-call-param.rule_id = buf_rule-by-profile.rule_id.
     1723               run str/callnews.p
     1724                 (input 'rule-call-param':U
     1725                 ,input (buffer buf_rule-call-param:handle)
     1726                 ) no-error .
     1727               if error-status:error then do:
     1728                               message substitute("Не удалось сохранить rule-call-param&1:&2&1&3"                                   ,chr(10)                                   , error-status:get-message(1)                                   , return-value ) view-as alert-box.
     1729                 undo main-block, return error .
     1730               end.
     1731           end.
     1732         end.
     1733       end.
     1734     end.
     1735       if not v-exist then do:
     1736         FIND FIRST buf_rule NO-LOCK WHERE
     1737                       buf_rule.RULE_id = buf_rule-by-profile.RULE_id .
     1738         FIND LAST buf_rule-by-call WHERE
     1739                   buf_rule-by-call.codex_id =  buf_rule-by-profile.codex_id
     1740               AND buf_rule-by-call.ruleset_id = buf_rule-by-profile.ruleset_id
     1741         USE-INDEX imain NO-ERROR.
     1742         IF AVAILABLE buf_rule-by-call THEN DO:
     1743           v-order-id = buf_rule-by-call.order_id + 1.
     1744         END.
     1745         ELSE DO:
     1746           v-order-id = 0.
     1747         END.
     1748         CREATE buf_rule-by-call.
     1749         BUFFER-COPY buf_rule-by-profile TO buf_rule-by-call
     1750         ASSIGN
     1751         buf_rule-by-call.order_id = v-order-id
     1752         buf_rule-by-call.algo-des = buf_rule-profile.NAME + chr(10) + buf_rule.NAME
     1753         buf_rule-by-call.is_dynamic = buf_rule-by-profile.IS_dynamic
     1754         buf_rule-by-call.can-calc = (IF buf_rule-by-call.is_dynamic
     1755                                     THEN  no
     1756                                     ELSE YES)
     1757         buf_rule-by-call.call_id = buf_rp-by-call.call_id
     1758       buf_rule-by-call.call#_id = buf_rp-by-call.call#_id
     1759         buf_rule-by-call.once-more = buf_rp-by-call.once-more
     1760         .
     1761       run gen-key-rec in this-procedure (
     1762                                         input  'rule-by-call':U
     1763                                         ,input buffer buf_rule-by-call:handle
     1764                                         ,output v-rule-by-call-uniq-key-rec).
     1765       buf_rule-by-call.uniq-key-rec = v-rule-by-call-uniq-key-rec    .
     1766       run str/callnews.p
     1767         (input 'rule-by-call':U
     1768         ,input (buffer buf_rule-by-call:handle)
     1769         ) no-error .
     1770       if error-status:error then do:
     1771               message substitute("Не удалось сохранить rule-by-call&1:&2&1&3"                           ,chr(10)                           , error-status:get-message(1)                           , return-value ) view-as alert-box.
     1772         undo main-block, return error .
     1773       end.
     1774       end.
     1775   end.
     1776   end.
     1777   end procedure.
     1778   procedure rule-by-profile_delete :
     1779   define input parameter p-bh as handle no-undo .
     1780   define variable v-order-id as integer no-undo .
     1781   define buffer buf_rule-by-profile for ub.rule-by-profile.
     1782   define buffer buf_rule-by-call for ub.rule-by-call.
     1783   main-block:
     1784   do
     1785   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1786   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1787   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1788   :
     1789     find first buf_rule-by-profile where
     1790               rowid(buf_rule-by-profile) = p-bh:rowid.
     1791     for each buf_rule-by-call exclusive-lock where
     1792             buf_rule-by-call.profile_id = buf_rule-by-profile.profile_id
     1793         and buf_rule-by-call.codex_id = buf_rule-by-profile.codex_id
     1794         and buf_rule-by-call.ruleset_id = buf_rule-by-profile.ruleset_id
     1795         and buf_rule-by-call.rule_id = buf_rule-by-profile.rule_id
     1796     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1797     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1798     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1799     :
     1800       run nws/cmd-del.p
     1801         ( input 'rule-by-call':U
     1802         ,input (buffer ub.rule-by-call:handle)
     1803         ,input ''
     1804         ) no-error .
     1805       if error-status :error then do:
     1806               message substitute("Не удалось удалить rule-call-param&1:&2&1&3"                           ,chr(10)                           , error-status:get-message(1)                           , return-value ) view-as alert-box.
     1807         undo main-block, return error .
     1808       end.
     1809       delete buf_rule-by-call.
     1810       .
     1811     end.
     1812   end.
     1813   end procedure.
