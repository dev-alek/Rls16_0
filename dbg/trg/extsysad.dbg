      189     define input  parameter p-db-num   like ub.ext-system-attr.db-num     no-undo .
      190     define input  parameter p-code     like ub.ext-system-attr.esya-attr-code  no-undo .
      191     define output parameter p-deleted  as logical no-undo.
      192     do
      193     on error undo, return error
      194     :
      195           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-delete in g#attr-lib
      196         (input  p-esys-id
