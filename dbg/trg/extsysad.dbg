      128     define input  parameter p-code      like ub.ext-system-attr.esya-attr-code  no-undo .
      129     define output parameter p-value     like ub.ext-system-attr.esya-attr-value no-undo .
      130     define output parameter p-type      as character no-undo .
      131     do
      132     on error undo, return error
      133     :
      134           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-value in g#attr-lib
      135         (input  p-esys-id
      136         ,input  p-db-num
      137         ,input  p-code
      138         ,output p-value
      139         ,output p-type
      140         ) no-error .
