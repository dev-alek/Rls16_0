      255   define variable v-news as logical   no-undo .
      256   main-block:
      257   do
      258   on error  undo main-block, return error substitute("&1. error &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      259   on endkey undo main-block, return error substitute("&1. endkey")
      260   on stop   undo main-block, return error substitute("&1. stop")
      261   :
      262     run ext-system-attr-news in this-procedure ( input ub.Ext-system-attr.esya-attr-code
      263                                                 ,output v-news).
      264     if v-news then do:
      265       run nws/cmd-del.p
      266       ( input 'ext-system-attr':U
      267        ,input (buffer ub.ext-system-attr:handle)
      268        ,input ''
      269       ) no-error .
      270       if error-status:error then do:
      271         if error-status :get-message(1) <> ""
      272         then do:
      273           message
      274             vss-workfile vss-revision vss-description skip
      275             "Ошибка при вызове процедуры cmd-del.p" skip
      276             error-status :get-message(1) skip
      277             return-value skip
      278             view-as alert-box error .
      279         end.
      280         undo main-block,  return error return-value .
      281       end.
      282     end.
      283       if g#oxml = yes
      284       then do:
      285       run str/calloxml.p (
      286             input 'delete':U
      287           , input 'ext-system-attr':U
      288           , input ( buffer ub.ext-system-attr:handle )
      289       ) no-error.
      290       if error-status :error
      291       then do:
      292           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      293                                , chr(10)
      294                                , vss-workfile
      295                                , return-value
      296                                , error-status :get-message ( 1 ) ).
      297       end.
      298       end.
      299   end.
