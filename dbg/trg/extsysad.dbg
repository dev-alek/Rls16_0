      111     do
      112     on error undo, return error
      113     :
      114           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-tooltip in g#attr-lib
      115         (input  p-code
      116         ,output p-tooltip
      117         ,output p-label
      118         ) no-error .
      119       if error-status :error
      120       then do:
      121         undo, return error return-value .
      122       end.
      123     end.
      124   end procedure.
