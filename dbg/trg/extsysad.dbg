      144       end.
      145     end.
      146   end procedure.
      147   procedure ext-system-attr-write :
      148     define input parameter p-esys-id   like ub.ext-system-attr.esys-id    no-undo .
      149     define input parameter p-db-num    like ub.ext-system-attr.db-num     no-undo .
      150     define input parameter p-code      like ub.ext-system-attr.esya-attr-code  no-undo .
      151     define input parameter p-value     like ub.ext-system-attr.esya-attr-value no-undo .
      152     do
      153     on error undo, return error
      154     :
      155           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-write in g#attr-lib
      156         (input p-esys-id
      157         ,input p-db-num
      158         ,input p-code
      159         ,input p-value
      160         ) no-error .
      161       if error-status :error
      162       then do:
      163         undo, return error return-value .
      164       end.
      165     end.
