        1   block-level on error undo, throw.
        2   define input parameter parinkas-code like ub.inkas.inkas-code no-undo .
        3   define input parameter parobj-type like ub.inkas.obj-type no-undo .
        4   define input parameter parobj-code like ub.inkas.obj-code no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Создание inkas-pay-desk для старых продаж".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   DEFINE VARIABLE var-doc-type as character no-undo .
       70   DEFINE VARIABLE v-exist-all-chk as integer no-undo .
       71   define temp-table tt-inkas-pay-desk no-undo like ub.inkas-pay-desk.
       72   for each tt-inkas-pay-desk:
       73     delete tt-inkas-pay-desk.
       74   end.
       75   _main:
       76   do
       77   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       78   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
       79   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ):
       80     find first ub.inkas no-lock where
       81                ub.inkas.inkas-code = parinkas-code.
       82     _chk-doc:
       83     for each ub.chk-doc No-LOCK WHERE
       84               ub.chk-doc.obj-type = parobj-type and
       85               ub.chk-doc.obj-code = parobj-code AND
       86               ub.chk-doc.out-code = parinkas-code:
       87         v-exist-all-chk = v-exist-all-chk + 1 .
       88         FOR  each ub.chk-pay no-lock where
       89               ub.chk-pay.doc-code = ub.chk-doc.doc-code
       90         break by
       91         ub.chk-pay.doc-code:
       92         if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0
       93         or lookup(string(ub.chk-doc.chk-type), '14,15,16,17,36':U) > 0
       94         then DO:
       95           next _chk-doc.
       96         END.
       97         assign
       98         var-doc-type =  (if ub.chk-doc.netto >= 0
       99                         then  'при':U
      100                         else 'рас':U)
      101         .
      102         FIND FIRST tt-inkas-pay-desk WHERE
      103                     tt-inkas-pay-desk.pay-code = ub.chk-pay.pay-code AND
      104                     tt-inkas-pay-desk.curr-code = ub.chk-pay.curr-code AND
      105                     tt-inkas-pay-desk.pay-desk = ub.chk-doc.pay-desk AND
      106                     tt-inkas-pay-desk.doc-type = var-doc-type AND
      107                     tt-inkas-pay-desk.cashier = ub.chk-doc.cashier NO-ERROR.
      108         if NOT available tt-inkas-pay-desk then do:
      109           CREATE tt-inkas-pay-desk.
      110           assign
      111           tt-inkas-pay-desk.pay-code = ub.chk-pay.pay-code
      112           tt-inkas-pay-desk.curr-code = ub.chk-pay.curr-code
      113           tt-inkas-pay-desk.pay-desk = ub.chk-doc.pay-desk
      114           tt-inkas-pay-desk.tot-sum = 0
      115           tt-inkas-pay-desk.tot-base = 0
      116           tt-inkas-pay-desk.tot-rubl = 0
      117           tt-inkas-pay-desk.doc-type = var-doc-type
      118           tt-inkas-pay-desk.cashier = ub.chk-doc.cashier
      119           .
      120         end.
      121         assign
      122         tt-inkas-pay-desk.tot-sum = tt-inkas-pay-desk.tot-sum + ub.chk-pay.tot-sum
      123         tt-inkas-pay-desk.tot-base = tt-inkas-pay-desk.tot-base + ub.chk-pay.tot-base
      124         tt-inkas-pay-desk.tot-rubl = tt-inkas-pay-desk.tot-rubl + ub.chk-pay.tot-rubl
      125         .
      126       end.
      127     END.
      128     if v-exist-all-chk < ub.inkas.num-chk then do:
      129       message
      130       vss-workfile vss-revision vss-description skip
      131       "Недостаточно информации для расчета выручки по кассам" skip
      132       "Возможно не передаются по новостям чеки" skip
      133       "или чеки были заархивированы" skip
      134       "Отчет о продаже" parinkas-code
      135       view-as alert-box error .
      136       return error.
      137     end.
      138     for each tt-inkas-pay-desK:
      139       create ub.inkas-pay-desk.
      140       buffer-copy tt-inkas-pay-desk to ub.inkas-pay-desk
      141       assign
      142       ub.inkas-pay-desk.inkas-code = parinkas-code
      143       .
      144       delete tt-inkas-pay-desk.
      145     END.
      146   end.
