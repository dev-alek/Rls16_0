        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.dis-grp-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление истории скидок по группам".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8'
       29                           ,  ub.dis-grp-rule.classif-type
       30                           ,  ub.dis-grp-rule.node-code
       31                           ,  ub.dis-grp-rule.host-code
       32                           ,  ub.dis-grp-rule.obj-type
       33                           ,  ub.dis-grp-rule.obj-code
       34                           ,  ub.dis-grp-rule.pos-type
       35                           ,  ub.dis-grp-rule.templ-rl-root
       36                           ,  ub.dis-grp-rule.nonunique
       37                           )
       38       .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure cur-time :
       92      define output parameter p-today as date      no-undo .
       93      define output parameter p-time  as integer   no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       define variable v-date1 as date      no-undo .
       98       define variable v-date2 as date      no-undo .
       99       define variable v-time  as integer   no-undo .
      100       assign
      101         v-date1 = today
      102         v-time  = time
      103         v-date2 = today
      104       .
      105       if v-date1 <> v-date2
      106       then do:
      107         assign
      108           v-date1 = today
      109           v-time  = v-time
      110         .
      111       end.
      112       assign
      113         p-today = v-date1
      114         p-time  = v-time
      115       .
      116     end.
      117   end.
      118   function cur-time-date returns character
      119   :
      120     return string(today, '99/99/9999':U) .
      121   end.
      122   function cur-time-mjd returns decimal
      123   :
      124     define variable v-date as date      no-undo .
      125     define variable v-time as integer   no-undo .
      126     run cur-time in this-procedure
      127       (output v-date
      128       ,output v-time
      129       ) .
      130     return integer(v-date) - 2400002 + (v-time / 86400) .
      131   end.
      132   function cur-time-get-ending-index returns integer
      133   (input p-number as integer
      134   )
      135   :
      136     if p-number < 0
      137     or p-number = ?
      138     then do:
      139       return 1 .
      140     end.
      141     define variable v-rest as integer   no-undo .
      142     assign
      143       p-number = p-number modulo 100
      144     .
      145     if p-number < 20
      146     then do:
      147       assign
      148         v-rest = p-number
      149       .
      150     end.
      151     else do:
      152       assign
      153         v-rest = p-number modulo 10
      154       .
      155     end.
      156     case v-rest :
      157       when 1
      158       then do:
      159         return 2 .
      160       end.
      161       when 2 or
      162       when 3 or
      163       when 4
      164       then do:
      165         return 3 .
      166       end.
      167       otherwise do:
      168         return 1 .
      169       end.
      170     end case .
      171   end.
      172   procedure cur-time-mjd-to-date :
      173      define input  parameter i-mjd-diff as decimal no-undo.
      174      define output parameter o-Date     as date    no-undo.
      175      define output parameter o-Time     as integer no-undo.
      176      define variable v-day-number as integer   no-undo .
      177      if    i-mjd-diff < 0
      178         or i-mjd-diff = ?
      179      then do:
      180         return "?" .
      181      end.
      182      assign
      183         v-day-number = truncate(i-mjd-diff,0).
      184         o-Date = date(v-day-number + 2400002).
      185         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187   end.
      188   function cur-time-mjd-to-string returns character
      189   (input p-mjd-diff as decimal
      190   )
      191   :
      192     define variable v-day-number as integer   no-undo .
      193     define variable v-seconds    as integer   no-undo .
      194     define variable v-hour       as integer   no-undo .
      195     define variable v-min        as integer   no-undo .
      196     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      197     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      198     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      199     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      200     if p-mjd-diff < 0
      201     or p-mjd-diff = ?
      202     then do:
      203       return "?" .
      204     end.
      205     assign
      206       v-day-number = integer(truncate(p-mjd-diff,0))
      207       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209     if v-seconds > 86400
      210     then do:
      211       assign
      212         v-seconds = 86400 - 1
      213       .
      214     end.
      215     if v-seconds < 0
      216     then do:
      217       assign
      218         v-seconds = 0
      219       .
      220     end.
      221     assign
      222       v-hour = truncate(v-seconds / 3600, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 3600
      226     .
      227     assign
      228       v-min = truncate(v-seconds / 60, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 60
      232     .
      233     return
      234         (if v-day-number <> 0
      235           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0
      239           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      243           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      244           else ""
      245         )
      246       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      247       .
      248   end.
      249   function cur-time-string returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      258   end.
      259   function cur-time-string-sec returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      268   end.
      269   function cur-time-custom  returns character
      270   (input p-prefix as character
      271   ,input p-date-format as character
      272   ,input p-delimiter as character
      273   ,input p-time-format as character
      274   ,input p-suffix as character
      275   )
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return
      284       p-prefix
      285       + string(v-date, p-date-format)
      286       + p-delimiter
      287       + string(v-time, p-time-format)
      288       + p-suffix
      289       .
      290   end.
      291   function cur-time-print  returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-datetime returns datetime
      302   :
      303     define variable v-char as character no-undo .
      304     define variable v-datetime as datetime no-undo .
      305     v-char = cur-time-string().
      306     v-datetime = datetime(v-char).
      307     return  v-datetime.
      308   end.
      309   function cur-time-string-msec returns character
      310   :
      311     define variable v-date as datetime  no-undo .
      312     v-date = now.
      313     return string(v-date) .
      314   end.
      315   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   define new global shared variable g#lib-nws as handle no-undo .
      317   define variable v-host-code as integer no-undo .
      318   define variable v-date as date no-undo .
      319   define variable v-time as integer no-undo .
      320   define variable v-obj-db-num as integer no-undo .
      321   define variable v-obj-type as character no-undo .
      322   define variable v-obj-code as integer no-undo .
      323   define buffer buf_c-dis-grp-rule for ub.c-dis-grp-rule.
      324   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      325   define buffer buf_c-sum-grp for ub.c-sum-grp.
      326   define buffer buf_c-sum-grp-obj for ub.c-sum-grp-obj.
      327   define buffer buf_c-cli-grp for ub.c-cli-grp.
      328   main-block:
      329   do
      330   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      331   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      332   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      333   :
      334     if not g#news
      335     and g#db-num > 0
      336     and (
      337         ub.dis-grp-rule.obj-type  = '':U
      338         or
      339         ub.dis-grp-rule.obj-code = 0
      340         or
      341         ub.dis-grp-rule.host-code  = 0
      342         ) then do:
      343       message
      344       vss-workfile vss-revision vss-description skip
      345       substitute("Фирма &1 &2&3 POS &4 код шаблона &5&6" +
      346                  "Нельзя удалять запись СКИДОК ПО ГРУППАМ в УБД"
      347                  ,ub.dis-grp-rule.host-code
      348                  ,ub.dis-grp-rule.obj-type
      349                  ,ub.dis-grp-rule.obj-code
      350                  ,ub.dis-grp-rule.pos-type
      351                  ,ub.dis-grp-rule.templ-rl-root
      352                  , chr(10)
      353                  )
      354       view-as alert-box error .
      355       undo main-block, return error .
      356     end.
      357     if ub.dis-grp-rule.obj-type = 'маг':U
      358     or ub.dis-grp-rule.obj-type = 'скл':U then do:
      359   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      361     (input  ub.dis-grp-rule.obj-type
      362     ,input  ub.dis-grp-rule.obj-code
      363     ,output v-obj-db-num
      364     )  .
      365       if v-obj-db-num <> g#db-num
      366       and g#db-num <> 0 then do:
      367         message
      368         vss-workfile vss-revision vss-description skip
      369         substitute("Фирма &1 &2&3 POS &4 код шаблона &5&6" +
      370                   "Нельзя удалять запись СКИДОК ПО ГРУППАМ в чужой БД"
      371                  ,ub.dis-grp-rule.host-code
      372                  ,ub.dis-grp-rule.obj-type
      373                  ,ub.dis-grp-rule.obj-code
      374                  ,ub.dis-grp-rule.pos-type
      375                  ,ub.dis-grp-rule.templ-rl-root
      376                  , chr(10)
      377                  )
      378         view-as alert-box error .
      379         undo main-block, return error .
      380       end.
      381     end.
      382     if g#news then do:
      383       define variable v-send as integer no-undo .
      384       v-send = integer('0':U).
      385   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      387     (input  g#db-num
      388     ,input  'dis-grp-rule':U
      389     ,input  0
      390     ,input  '':U
      391     ,input  0
      392     ,input  '':U
      393     ,input  '':U
      394     ,input  '':U
      395     ,input  0
      396     ,input  0
      397     ,input  0
      398     ,input  'nws-to-hist'
      399     ,output v-send
      400     ) no-error .
      401     end.
      402     if not g#news
      403     or v-send >= 0 then do:
      404       run cur-time in this-procedure(output v-date, output v-time).
      405       create buf_c-dis-grp-rule.
      406       buffer-copy ub.dis-grp-rule
      407       to buf_c-dis-grp-rule
      408       assign
      409       buf_c-dis-grp-rule.corr-time          = v-time
      410       buf_c-dis-grp-rule.corr-user-db-num   = g#db-num
      411       buf_c-dis-grp-rule.corr-user-name     = (if g#news
      412                                                then (chr(4) +  'СПН':U)
      413                                                else (if g#esys
      414                                                      then (chr(4) +  'ВС':U)
      415                                                      else g#userid)
      416                                                )
      417       buf_c-dis-grp-rule.corr-date          = v-date
      418       .
      419       CASE buf_c-dis-grp-rule.classif-type:
      420         when 'cli-grp':U then do:
      421           assign
      422           buf_c-dis-grp-rule.chip-num           = next-value (s-cli-grp-chip, ub)
      423           .
      424           create buf_c-cli-grp.
      425           buffer-copy buf_c-dis-grp-rule to buf_c-cli-grp
      426           assign
      427           buf_c-cli-grp.action = integer('99':U)
      428           buf_c-cli-grp.subject = 'dis-grp-rule':U
      429           buf_c-cli-grp.source-type = (if g#news
      430                                        then 'db':U
      431                                        else (if g#esys
      432                                              then 'esys':U
      433                                              else "":U)
      434                                       )
      435           buf_c-cli-grp.source-ref = (if g#news
      436                                        then string(g#news-source-db)
      437                                        else (if g#esys
      438                                              then string(g#esys-source-esys)
      439                                              else "":U)
      440                                        )
      441           .
      442         end.
      443         when 'gds-grp':U then do:
      444           assign
      445           buf_c-dis-grp-rule.chip-num           = next-value (s-gds-grp-chip, ub)
      446           .
      447           create buf_c-gds-grp-hist.
      448           buffer-copy buf_c-dis-grp-rule to buf_c-gds-grp-hist
      449           assign
      450           buf_c-dis-grp-rule.obj-type           = ub.dis-grp-rule.obj-type
      451           buf_c-dis-grp-rule.obj-code           = ub.dis-grp-rule.obj-code
      452           buf_c-dis-grp-rule.host-code           = ub.dis-grp-rule.host-code
      453           buf_c-gds-grp-hist.action = integer('99':U)
      454           buf_c-gds-grp-hist.subject = 'dis-grp-rule':U
      455           buf_c-gds-grp-hist.is-news = g#news
      456           buf_c-gds-grp-hist.source-type = (if g#news
      457                                        then 'db':U
      458                                        else (if g#esys
      459                                              then 'esys':U
      460                                              else "":U)
      461                                       )
      462           buf_c-gds-grp-hist.source-ref = (if g#news
      463                                        then string(g#news-source-db)
      464                                        else (if g#esys
      465                                              then string(g#esys-source-esys)
      466                                              else "":U)
      467                                        )
      468           .
      469         end.
      470         when 'sum-grp':U then do:
      471           assign
      472           buf_c-dis-grp-rule.chip-num           = next-value (s-ref-corr-chip, ub)
      473           .
      474           create buf_c-sum-grp.
      475           buffer-copy buf_c-dis-grp-rule to buf_c-sum-grp
      476           assign
      477           buf_c-sum-grp.grp-code    = ub.dis-grp-rule.node-code
      478           buf_c-sum-grp.action = integer('99':U)
      479           buf_c-sum-grp.subject = 'dis-grp-rule':U
      480           .
      481         end.
      482         when 'sum-grp-obj':U then do:
      483           assign
      484           buf_c-dis-grp-rule.chip-num           = next-value (s-ref-obj-corr-chip, ub)
      485           .
      486           create buf_c-sum-grp-obj.
      487           buffer-copy buf_c-dis-grp-rule to buf_c-sum-grp-obj
      488           assign
      489           buf_c-sum-grp-obj.obj-type = ub.dis-grp-rule.obj-type
      490           buf_c-sum-grp-obj.obj-code = ub.dis-grp-rule.obj-code
      491           buf_c-sum-grp-obj.grp-code    = ub.dis-grp-rule.node-code
      492           buf_c-sum-grp-obj.action = integer('99':U)
      493           buf_c-sum-grp-obj.subject = 'dis-grp-rule':U
      494           .
      495         end.
      496       END CASE.
      497     end.
      498     run nws/cmd-del.p
      499       ( input 'dis-grp-rule':U
      500         ,input (buffer ub.dis-grp-rule:handle)
      501         ,input "":U
      502       ) no-error .
      503     if error-status :error then do:
      504       return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      505     end.
      506     if g#oxml = yes
      507     then do:
      508       run str/calloxml.p (
      509             input 'delete':U
      510           , input 'dis-grp-rule':U
      511           , input ( buffer ub.dis-grp-rule:handle )
      512       ) no-error.
      513       if error-status :error
      514       then do:
      515           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      516                                , chr(10)
      517                                , vss-workfile
      518                                , return-value
      519                                , error-status :get-message ( 1 ) ).
      520       end.
      521     end.
      522   end.
