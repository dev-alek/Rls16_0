        1   block-level on error undo, throw.
        2   define input  parameter p-cat-code       like ub.hold-time.cat-code no-undo .
        3   define input  parameter p-lock-code      as character no-undo .
        4   define input  parameter p-btpr-type-code as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Первоначальный расчет межфирменных архивов".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure holdattr-code :
       82     do
       83     on error undo, return error
       84     :
       85       define input  parameter p-code           as character no-undo .
       86       define output parameter p-type           as character no-undo .
       87       define output parameter p-format         as character no-undo .
       88       define output parameter p-label          as character no-undo .
       89       define output parameter p-user-can-edit  as logical   no-undo .
       90       define output parameter p-output-display as logical   no-undo .
       91       define output parameter p-other          as character no-undo .
       92       case p-code :
       93               when 'begin-date':U then do:     assign     p-label = "Дата начала межфирменного архива"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата начала межфирменного архива"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       94               when 'is-calc':U then do:     assign     p-label = "Произв.расчет арх."     p-type = 'L':U      p-format = "+/-"     p-label = "Произв.расчет арх."     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       95         otherwise do:
       96           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
       97         end.
       98       end.
       99     end.
      100   end procedure.
      101   procedure holdattr-tooltip :
      102     do
      103     on error undo, return error
      104     :
      105       define input  parameter p-code    as character no-undo .
      106       define output parameter p-tooltip as character no-undo .
      107       define output parameter p-label   as character no-undo .
      108       case p-code :
      109               when 'begin-date':U then do:     assign     p-tooltip = "Дата начала межфирменного архива"     p-label = "Дата начала межфирменного архива" .   end.
      110               when 'is-calc':U then do:     assign     p-tooltip = "Производится расчет межфирменного архива"     p-label = "Произв.расчет арх." .   end.
      111         otherwise do:
      112           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      113         end.
      114       end.
      115     end.
      116   end procedure.
      117   procedure holdattr-value :
      118     do
      119     on error undo, return error
      120     :
      121       define input  parameter p-cat-code  like ub.hold-attr.cat-code     no-undo .
      122       define input  parameter p-code      like ub.hold-attr.attr-code  no-undo .
      123       define output parameter p-value     like ub.hold-attr.attr-value no-undo .
      124       define output parameter p-type      as character no-undo .
      125       define buffer buf_hold-attr for ub.hold-attr .
      126       def var v-format         as character no-undo .
      127       def var v-label          as character no-undo .
      128       def var v-user-can-edit  as logical   no-undo .
      129       def var v-output-display as logical   no-undo .
      130       def var v-other          as character no-undo .
      131       run holdattr-code in this-procedure
      132         (input  p-code
      133         ,output p-type
      134         ,output v-format
      135         ,output v-label
      136         ,output v-user-can-edit
      137         ,output v-output-display
      138         ,output v-other
      139         ) no-error .
      140       if error-status :error then do:
      141         undo, return error return-value .
      142       end.
      143       find first buf_hold-attr no-lock
      144         where buf_hold-attr.cat-code    = p-cat-code
      145           and buf_hold-attr.attr-code = p-code
      146         no-error .
      147       if avail buf_hold-attr then do:
      148         assign
      149           p-value =  buf_hold-attr.attr-value
      150         .
      151       end.
      152       else do:
      153         assign
      154           p-value = if p-type = 'L':U then "no":U else ""
      155         .
      156       end.
      157     end.
      158   end procedure.
      159   procedure holdattr-write :
      160     do
      161     on error undo, return error
      162     :
      163       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      164       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      165       define input parameter p-value     like ub.hold-attr.attr-value no-undo .
      166       define buffer buf_hold-attr for ub.hold-attr .
      167       def var v-type           as character no-undo .
      168       def var v-format         as character no-undo .
      169       def var v-label          as character no-undo .
      170       def var v-user-can-edit  as logical   no-undo .
      171       def var v-output-display as logical   no-undo .
      172       def var v-other          as character no-undo .
      173       run holdattr-code in this-procedure
      174         (input  p-code
      175         ,output v-type
      176         ,output v-format
      177         ,output v-label
      178         ,output v-user-can-edit
      179         ,output v-output-display
      180         ,output v-other
      181         ) no-error .
      182       if error-status :error then do:
      183         undo, return error return-value .
      184       end.
      185       find first buf_hold-attr exclusive-lock
      186         where buf_hold-attr.cat-code    = p-cat-code
      187           and buf_hold-attr.attr-code = p-code
      188         no-error .
      189       if not available buf_hold-attr then do:
      190         create buf_hold-attr .
      191         assign
      192           buf_hold-attr.cat-code    = p-cat-code
      193           buf_hold-attr.attr-code = p-code
      194         .
      195       end.
      196       assign
      197         buf_hold-attr.attr-value = p-value
      198       .
      199     end.
      200   end procedure.
      201   procedure holdattr-exist :
      202     do
      203     on error undo, return error
      204     :
      205       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      206       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      207       define output parameter p-exist    as logical  no-undo .
      208       define buffer buf_hold-attr for ub.hold-attr .
      209       def var v-type           as character no-undo .
      210       def var v-format         as character no-undo .
      211       def var v-label          as character no-undo .
      212       def var v-user-can-edit  as logical   no-undo .
      213       def var v-output-display as logical   no-undo .
      214       def var v-other          as character no-undo .
      215       run holdattr-code in this-procedure
      216         (input  p-code
      217         ,output v-type
      218         ,output v-format
      219         ,output v-label
      220         ,output v-user-can-edit
      221         ,output v-output-display
      222         ,output v-other
      223         ) no-error .
      224       if error-status :error then do:
      225         undo, return error return-value .
      226       end.
      227       find first buf_hold-attr no-lock
      228         where buf_hold-attr.cat-code    = p-cat-code
      229           and buf_hold-attr.attr-code = p-code
      230         no-error .
      231       if  available buf_hold-attr then do:
      232         p-exist = yes.
      233       end.
      234     end.
      235   end procedure.
      236   procedure holdattr-delete :
      237     do
      238     on error undo, return error
      239     :
      240       define input parameter p-cat-code   like ub.hold-attr.cat-code     no-undo .
      241       define input parameter p-code     like ub.hold-attr.attr-code  no-undo .
      242       define output parameter p-deleted  as logical no-undo.
      243       define buffer buf_hold-attr for ub.hold-attr .
      244       def var v-type           as character no-undo .
      245       def var v-format         as character no-undo .
      246       def var v-label          as character no-undo .
      247       def var v-user-can-edit  as logical   no-undo .
      248       def var v-output-display as logical   no-undo .
      249       def var v-other          as character no-undo .
      250       run holdattr-code in this-procedure
      251         (input  p-code
      252         ,output v-type
      253         ,output v-format
      254         ,output v-label
      255         ,output v-user-can-edit
      256         ,output v-output-display
      257         ,output v-other
      258         ) no-error .
      259       if error-status :error then do:
      260         undo, return error return-value .
      261       end.
      262       find first buf_hold-attr exclusive-lock
      263         where buf_hold-attr.cat-code    = p-cat-code
      264           and buf_hold-attr.attr-code = p-code
      265         no-error NO-WAIT.
      266       if not available buf_hold-attr then do:
      267         p-deleted = no.
      268       end.
      269       else do:
      270         delete buf_hold-attr.
      271         p-deleted = yes.
      272       end.
      273     end.
      274   end procedure.
      275   procedure holdattr-news :
      276     do
      277     on error undo, return error
      278     :
      279       define input  parameter p-code           as character no-undo .
      280       define output parameter p-news           as logical   no-undo .
      281       case p-code :
      282               when 'begin-date':U then do:     assign     p-news = no.   end.
      283               when 'is-calc':U then do:     assign     p-news = no.   end.
      284         otherwise do:
      285           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      286         end.
      287       end.
      288     end.
      289   end procedure.
      290   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      291   procedure create-hold-time :
      292   define input parameter p-cat-code like ub.hold-time.cat-code no-undo .
      293   define input parameter p-start-date like ub.hold-time.start-date no-undo .
      294   DEFINE VARIABLE v-end-date like ub.hold-time.end-date no-undo .
      295   define buffer buf_hold-time for ub.hold-time .
      296   define buffer last_hold-time for ub.hold-time .
      297     do
      298     on error undo, return error
      299     :
      300       find last last_hold-time no-lock
      301         where last_hold-time.cat-code = p-cat-code
      302         use-index pi
      303         no-error .
      304       run gbl/lastdate.p
      305         (input p-start-date
      306         ,output v-end-date)
      307         no-error .
      308       if error-status :error then do:
      309         message
      310         vss-workfile vss-revision vss-description skip
      311         "Ошибка поиска последней даты периода" skip
      312         "Дата начала периода" p-start-date
      313         error-status :get-message(1) skip
      314         return-value skip
      315         view-as alert-box error .
      316         undo, return error.
      317       end.
      318       create buf_hold-time.
      319       assign
      320         buf_hold-time.cat-code       = p-cat-code
      321         buf_hold-time.time-code      = (if available last_hold-time
      322                                         then (last_hold-time.time-code + 1)
      323                                         else 1)
      324         buf_hold-time.time-type      = 'мес':U
      325         buf_hold-time.start-date     = p-start-date
      326         buf_hold-time.end-date       = v-end-date
      327         buf_hold-time.create-date    = today
      328         buf_hold-time.update-date    = today
      329         buf_hold-time.grpupdate-date = today
      330       .
      331     end.
      332   end procedure.
      333   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334   procedure cur-time :
      335      define output parameter p-today as date      no-undo .
      336      define output parameter p-time  as integer   no-undo .
      337     do
      338     on error undo, return error
      339     :
      340       define variable v-date1 as date      no-undo .
      341       define variable v-date2 as date      no-undo .
      342       define variable v-time  as integer   no-undo .
      343       assign
      344         v-date1 = today
      345         v-time  = time
      346         v-date2 = today
      347       .
      348       if v-date1 <> v-date2
      349       then do:
      350         assign
      351           v-date1 = today
      352           v-time  = v-time
      353         .
      354       end.
      355       assign
      356         p-today = v-date1
      357         p-time  = v-time
      358       .
      359     end.
      360   end.
      361   function cur-time-date returns character
      362   :
      363     return string(today, '99/99/9999':U) .
      364   end.
      365   function cur-time-mjd returns decimal
      366   :
      367     define variable v-date as date      no-undo .
      368     define variable v-time as integer   no-undo .
      369     run cur-time in this-procedure
      370       (output v-date
      371       ,output v-time
      372       ) .
      373     return integer(v-date) - 2400002 + (v-time / 86400) .
      374   end.
      375   function cur-time-get-ending-index returns integer
      376   (input p-number as integer
      377   )
      378   :
      379     if p-number < 0
      380     or p-number = ?
      381     then do:
      382       return 1 .
      383     end.
      384     define variable v-rest as integer   no-undo .
      385     assign
      386       p-number = p-number modulo 100
      387     .
      388     if p-number < 20
      389     then do:
      390       assign
      391         v-rest = p-number
      392       .
      393     end.
      394     else do:
      395       assign
      396         v-rest = p-number modulo 10
      397       .
      398     end.
      399     case v-rest :
      400       when 1
      401       then do:
      402         return 2 .
      403       end.
      404       when 2 or
      405       when 3 or
      406       when 4
      407       then do:
      408         return 3 .
      409       end.
      410       otherwise do:
      411         return 1 .
      412       end.
      413     end case .
      414   end.
      415   procedure cur-time-mjd-to-date :
      416      define input  parameter i-mjd-diff as decimal no-undo.
      417      define output parameter o-Date     as date    no-undo.
      418      define output parameter o-Time     as integer no-undo.
      419      define variable v-day-number as integer   no-undo .
      420      if    i-mjd-diff < 0
      421         or i-mjd-diff = ?
      422      then do:
      423         return "?" .
      424      end.
      425      assign
      426         v-day-number = truncate(i-mjd-diff,0).
      427         o-Date = date(v-day-number + 2400002).
      428         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      429     .
      430   end.
      431   function cur-time-mjd-to-string returns character
      432   (input p-mjd-diff as decimal
      433   )
      434   :
      435     define variable v-day-number as integer   no-undo .
      436     define variable v-seconds    as integer   no-undo .
      437     define variable v-hour       as integer   no-undo .
      438     define variable v-min        as integer   no-undo .
      439     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      440     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      441     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      442     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      443     if p-mjd-diff < 0
      444     or p-mjd-diff = ?
      445     then do:
      446       return "?" .
      447     end.
      448     assign
      449       v-day-number = integer(truncate(p-mjd-diff,0))
      450       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      451     .
      452     if v-seconds > 86400
      453     then do:
      454       assign
      455         v-seconds = 86400 - 1
      456       .
      457     end.
      458     if v-seconds < 0
      459     then do:
      460       assign
      461         v-seconds = 0
      462       .
      463     end.
      464     assign
      465       v-hour = truncate(v-seconds / 3600, 0)
      466     .
      467     assign
      468       v-seconds = v-seconds modulo 3600
      469     .
      470     assign
      471       v-min = truncate(v-seconds / 60, 0)
      472     .
      473     assign
      474       v-seconds = v-seconds modulo 60
      475     .
      476     return
      477         (if v-day-number <> 0
      478           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      479           else ""
      480         )
      481       + (if v-day-number <> 0 or v-hour <> 0
      482           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      483           else ""
      484         )
      485       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      486           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      487           else ""
      488         )
      489       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      490       .
      491   end.
      492   function cur-time-string returns character
      493   :
      494     define variable v-date as date      no-undo .
      495     define variable v-time as integer   no-undo .
      496     run cur-time in this-procedure
      497       (output v-date
      498       ,output v-time
      499       ) .
      500     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      501   end.
      502   function cur-time-string-sec returns character
      503   :
      504     define variable v-date as date      no-undo .
      505     define variable v-time as integer   no-undo .
      506     run cur-time in this-procedure
      507       (output v-date
      508       ,output v-time
      509       ) .
      510     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      511   end.
      512   function cur-time-custom  returns character
      513   (input p-prefix as character
      514   ,input p-date-format as character
      515   ,input p-delimiter as character
      516   ,input p-time-format as character
      517   ,input p-suffix as character
      518   )
      519   :
      520     define variable v-date as date      no-undo .
      521     define variable v-time as integer   no-undo .
      522     run cur-time in this-procedure
      523       (output v-date
      524       ,output v-time
      525       ) .
      526     return
      527       p-prefix
      528       + string(v-date, p-date-format)
      529       + p-delimiter
      530       + string(v-time, p-time-format)
      531       + p-suffix
      532       .
      533   end.
      534   function cur-time-print  returns character
      535   :
      536     define variable v-date as date      no-undo .
      537     define variable v-time as integer   no-undo .
      538     run cur-time in this-procedure
      539       (output v-date
      540       ,output v-time
      541       ) .
      542     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      543   end.
      544   function cur-time-datetime returns datetime
      545   :
      546     define variable v-char as character no-undo .
      547     define variable v-datetime as datetime no-undo .
      548     v-char = cur-time-string().
      549     v-datetime = datetime(v-char).
      550     return  v-datetime.
      551   end.
      552   function cur-time-string-msec returns character
      553   :
      554     define variable v-date as datetime  no-undo .
      555     v-date = now.
      556     return string(v-date) .
      557   end.
      558   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      559   define variable v-waitfram-action01         as character   no-undo .
      560   define variable v-waitfram-action02         as character   no-undo .
      561   define variable v-waitfram-action03         as character   no-undo .
      562   define variable mWaitFramTextBeg            as character   no-undo.
      563   define variable mWaitFramTextEnd            as character   no-undo.
      564   define variable mWaitFramView               as logical     no-undo.
      565   define variable mWaitProcEvent              as logical     no-undo init yes.
      566   define variable mWaitFramInterval           as integer     no-undo init 1 .
      567   define variable mWaitFramStop               as logical     no-undo.
      568   define variable mWaitFramStopUser           as logical     no-undo.
      569   define variable mWaitFramStopTimeOut        as logical     no-undo.
      570   define variable mWaitFramStartProc          as datetime-tz no-undo.
      571   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      572   define button B-WaitFramStop auto-end-key
      573        label "Стоп"
      574        size 10 by 1 tooltip "Остоновить процесс".
      575   define button B-viewProcInfo
      576        label "Информация"
      577        size 15 by 1 tooltip "Информация о процесс".
      578   define frame waitfram
      579     v-waitfram-action01 format "x(72)" no-label skip
      580     v-waitfram-action02 format "x(72)" no-label skip
      581     v-waitfram-action03 format "x(72)" no-label skip
      582     B-viewProcInfo
      583     B-WaitFramStop at row 4 col 30
      584     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      585     .
      586   define new global shared variable mBatchMode as logical no-undo init ?.
      587   define variable mFramBachModHandle as handle no-undo.
      588   mFramBachModHandle = frame waitfram:handle.
      589   define variable mFameOldVis as logical no-undo.
      590   define variable mVisCUrentVin as logical no-undo.
      591   if session:batch-mode
      592   then
      593      mBatchMode = yes.
      594   if mBatchMode = ? then do:
      595     mVisCUrentVin = current-window:visible.
      596     mFameOldVis = mFramBachModHandle:visible.
      597     mFramBachModHandle:visible  = yes.
      598     mBatchMode = mFramBachModHandle:visible ne yes.
      599     mFramBachModHandle:visible = mFameOldVis.
      600     current-window:visible = mVisCUrentVin.
      601   end.
      602    if  log-manager:logfile-name ne ?
      603     then DO:
      604         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      605         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      606         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      607     end.
      608   on choose of B-WaitFramStop in frame waitfram
      609   do:
      610     mWaitFramStop = yes.
      611     mWaitFramStopUser = yes.
      612   end.
      613   function waitfram-check-timeout returns logical():
      614      define variable vtime as int64 no-undo.
      615      if mWaitFramStopTimeOut
      616      then
      617         return yes.
      618      vtime = ( now - mWaitFramStartProc ) / 1000 .
      619      if     mWaitFramTimeOut ne ?
      620         and mWaitFramTimeOut ne 0
      621         and mWaitFramTimeOut lt vtime
      622      then do:
      623         mWaitFramStopTimeOut = yes.
      624      end.
      625      return mWaitFramStopTimeOut.
      626   end.
      627   procedure waitfram-hide :
      628     if not session:batch-mode
      629     then do
      630     on error undo, return error return-value
      631     :
      632       pause 0 before-hide .
      633       if not mBatchMode then
      634         hide frame waitfram .
      635     if     not mWaitFramView
      636        and mWaitProcEvent
      637     then
      638       process events .
      639     end.
      640   end procedure.
      641   procedure waitfram-show :
      642     define input  parameter p-message as character no-undo .
      643     define variable v-left-margin as integer   no-undo .
      644     if not session:batch-mode
      645     then do
      646     on error undo, return error return-value
      647     :
      648       if length(p-message) <= 70 then do:
      649         assign
      650           v-left-margin = integer((70 - length(p-message)) / 2)
      651         .
      652         assign
      653           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      654         .
      655         assign
      656           v-waitfram-action01 = " "
      657           v-waitfram-action02 = " "
      658                                    + fill(" ", v-left-margin)
      659                                    + p-message
      660           v-waitfram-action03 = " "
      661         .
      662       end.
      663       else do:
      664         define variable vRindex1 as integer no-undo.
      665         define variable vRindex2 as integer no-undo.
      666         vRindex1 = r-index(p-message," ",70).
      667         if vRindex1 = 0
      668         then
      669            vRindex1 = 70.
      670         if length(p-message)  <= vRindex1 + 70 then do:
      671           assign
      672             v-waitfram-action01 = " "
      673             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      674             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      675           .
      676         end.
      677         else do:
      678           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      679           if vRindex2 <= vRindex1
      680           then
      681              vRindex2 = vRindex1 + 70.
      682           assign
      683             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      684             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      685             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      686           .
      687         end.
      688       end.
      689       B-viewProcInfo:visible   in frame waitfram = no.
      690       B-viewProcInfo:sensitive in frame waitfram = no.
      691       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      692       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      693       if  (   mWaitFramView
      694          or  mWaitProcEvent)
      695          and not mBatchMode
      696       then
      697          display
      698             v-waitfram-action01 skip
      699             v-waitfram-action02 skip
      700             v-waitfram-action03 skip
      701          with frame waitfram .
      702       if     mWaitFramView
      703          then do:
      704             if     mWaitFramInterval ne ?
      705                and not mBatchMode
      706             then
      707                wait-for go of frame waitfram pause mWaitFramInterval.
      708          end.
      709          else
      710             if     mWaitProcEvent
      711                and not mBatchMode
      712             then
      713                process events .
      714     end.
      715   end procedure.
      716      procedure waitfram-show-this:
      717         define input  parameter iInterval as int64 no-undo.
      718         define variable vtime as int64 no-undo.
      719         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      720         mWaitFramInterval = iInterval.
      721         run waitfram-show (substitute("&1&2 &3&4" ,
      722                                       mWaitFramTextBeg ,
      723                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      724                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      725                                       mWaitFramTextEnd
      726                                      )
      727                           ).
      728      end.
      729      procedure WaitFramRunPause:
      730         define input  parameter iInterval as dec no-undo.
      731         define variable vStart  as datetime-tz no-undo.
      732         define variable vend    as datetime-tz no-undo.
      733         define variable vint as int64 no-undo.
      734         define variable vOk as logical no-undo.
      735         vStart = now.
      736         vend   = vStart.
      737         publish "WaitFramPause" (iInterval,output vOk).
      738         vend   =  now.
      739         vint = vend - vStart.
      740         vint = iInterval - vint / 1000.
      741         if     not mWaitFramStop
      742            and (   vint > 0
      743                 or (    not vOk
      744                     and iInterval eq ?
      745                     )
      746                 )
      747         then
      748            run waitfram-show-this (iInterval).
      749         vend   =  now.
      750         vint = vend - vStart.
      751         vint = iInterval - vint / 1000.
      752         if     not mWaitFramStop
      753            and vint > 0
      754         then do:
      755            run gbl/pause.p (vint * 1000).
      756         end.
      757         if iInterval ne ?
      758         then
      759            publish "WaitFramStop".
      760         waitfram-check-timeout().
      761      end.
      762      procedure WaitFramWaitFor:
      763         define input  parameter iInterval as dec no-undo.
      764         assign
      765            mWaitFramStartProc   = now
      766            mWaitFramStopUser    = no
      767            mWaitFramStopTimeOut = no
      768         .
      769         block-wait:
      770         do while not mWaitFramStop:
      771            run WaitFramRunPause (iInterval).
      772            if  waitfram-check-timeout()
      773            then do:
      774               leave block-wait.
      775            end.
      776         end.
      777         run waitfram-hide.
      778      end.
      779   procedure waitfram-join :
      780     define input  parameter p-line-1  as character no-undo .
      781     define input  parameter p-line-2  as character no-undo .
      782     define input  parameter p-line-3  as character no-undo .
      783     define output parameter p-message as character no-undo .
      784     do
      785     on error undo, return error return-value
      786     :
      787       assign
      788         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      789                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      790                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      791       .
      792     end.
      793   end procedure.
      794   function waitfram-join-function returns character
      795     (input p-line-1 as character
      796     ,input p-line-2 as character
      797     ,input p-line-3 as character
      798     ).
      799     define variable v-message as character no-undo .
      800     run waitfram-join in this-procedure
      801       (input  p-line-1
      802       ,input  p-line-2
      803       ,input  p-line-3
      804       ,output v-message
      805       ) .
      806     return v-message .
      807   end function .
      808   define variable conf-par     as character no-undo .
      809   define variable par-type     as character no-undo .
      810   define variable v-month      as integer   no-undo .
      811   define variable v-year       as integer   no-undo .
      812   define variable lok          as logical   no-undo .
      813   define variable v-begin-date as date      no-undo .
      814   define buffer del_hold-time for ub.hold-time .
      815   define buffer del_hold-trn for ub.hold-trn .
      816   define buffer del_hold-goods for ub.hold-goods .
      817   define buffer del_hold-gds-grp for ub.hold-gds-grp .
      818   define buffer del_hold-purch for ub.hold-purch .
      819   define buffer del_hold-purch-grp for ub.hold-purch-grp .
      820   define buffer del_hold-purch-supp for ub.hold-purch-supp .
      821   define buffer del_hold-purch-supp-gds for ub.hold-purch-supp-gds .
      822   define buffer del_hold-sale for ub.hold-sale .
      823   define buffer del_hold-sale-grp for ub.hold-sale-grp .
      824   define buffer buf_trn-doc for ub.trn-doc .
      825   define buffer buf_db for ub.db .
      826   define buffer buf_clients for ub.clients .
      827   do
      828   on error undo, return error
      829   :
      830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      831     (input  'holding'
      832     ,input  0
      833     ,input  ''
      834     ,input  0
      835     ,input  ''
      836     ,input  ''
      837     ,input  ''
      838     ,input  yes
      839     ,output conf-par
      840     ,output par-type
      841     ) no-error .
      842     if error-status :error
      843     then do:
      844       message
      845         vss-workfile vss-revision vss-description skip
      846         "Ошибка при чтении параметра разрешены межфирменные архивы" skip
      847         error-status :get-message(1) skip
      848         return-value skip
      849         view-as alert-box error .
      850       undo, return error .
      851     end.
      852     if lookup(conf-par, 'true,yes') = 0
      853     then do:
      854       message
      855         "Межфирменные архивы запрещены параметром конфигурации" skip
      856         view-as alert-box information .
      857       return.
      858     end.
      859     run gbl/d-inpmnt.w
      860       (input ""
      861       ,input ?
      862       ,input-output v-month
      863       ,input-output v-year
      864       ,output lok
      865       ).
      866     if lok <> true
      867     then do:
      868       message
      869         "Не задана дата начала расчета межфирменных архивов" skip
      870         view-as alert-box information .
      871       return .
      872     end.
      873     assign
      874       v-begin-date = date(v-month, 1, v-year)
      875     .
      876     if v-begin-date = ?
      877     then do:
      878       message
      879         vss-workfile vss-revision vss-description skip
      880         "Ошибка при задании даты начала расчета межфирменных архивов" skip
      881         error-status :get-message(1) skip
      882         return-value skip
      883         view-as alert-box error .
      884       undo, return error .
      885     end.
      886     define variable v-ok as logical   no-undo .
      887     message
      888       "ВНИМАНИЕ" skip
      889       "У вас должна быть работоспособная резервная копия базы данных" skip
      890       "Это последний вопрос перед инициализацией межфирменного архива" skip
      891       "" skip
      892       "Будет произведено УДАЛЕНИЕ архива и расчет с даты" string(v-begin-date, '99/99/9999':u) skip
      893       "Продолжить?" skip
      894       view-as alert-box question buttons yes-no update v-ok .
      895     if v-ok <> true
      896     then do:
      897       undo, return error return-value .
      898     end.
      899     run holdattr-write in this-procedure
      900       (input p-cat-code
      901       ,input 'is-calc':U
      902       ,input 'true':u
      903       ) no-error .
      904     if error-status :error
      905     then do:
      906       message
      907         vss-workfile vss-revision vss-description skip
      908         "Ошибка при записи атрибута - первоначальный расчет межфирменных архивов" skip
      909         error-status :get-message(1) skip
      910         return-value skip
      911         view-as alert-box error .
      912       undo, return error .
      913     end.
      914     run holdattr-write in this-procedure
      915       (input p-cat-code
      916       ,input 'begin-date':U
      917       ,input string(v-begin-date, '99/99/9999':u)
      918       ) no-error .
      919     if error-status :error
      920     then do:
      921       message
      922         vss-workfile vss-revision vss-description skip
      923         "Ошибка при записи даты начала межфирменных архивов" skip
      924         error-status :get-message(1) skip
      925         return-value skip
      926         view-as alert-box error .
      927       undo, return error .
      928     end.
      929     for each del_hold-time
      930       where del_hold-time.cat-code = p-cat-code
      931     on error undo, return error
      932     :
      933       delete del_hold-time .
      934     end.
      935     for each del_hold-trn
      936       where del_hold-trn.cat-code = p-cat-code
      937     on error undo, return error
      938     :
      939       delete del_hold-trn .
      940     end.
      941     for each del_hold-goods
      942       where del_hold-goods.cat-code = p-cat-code
      943     on error undo, return error
      944     :
      945       delete del_hold-goods .
      946     end.
      947     for each del_hold-gds-grp
      948       where del_hold-gds-grp.cat-code = p-cat-code
      949     on error undo, return error
      950     :
      951       delete del_hold-gds-grp .
      952     end.
      953     for each del_hold-purch
      954       where del_hold-purch.cat-code = p-cat-code
      955     on error undo, return error
      956     :
      957       delete del_hold-purch .
      958     end.
      959     for each del_hold-purch-grp
      960       where del_hold-purch-grp.cat-code = p-cat-code
      961     on error undo, return error
      962     :
      963       delete del_hold-purch-grp .
      964     end.
      965     for each del_hold-purch-supp
      966       where del_hold-purch-supp.cat-code = p-cat-code
      967     on error undo, return error
      968     :
      969       delete del_hold-purch-supp .
      970     end.
      971     for each del_hold-purch-supp-gds
      972       where del_hold-purch-supp-gds.cat-code = p-cat-code
      973     on error undo, return error
      974     :
      975       delete del_hold-purch-supp-gds .
      976     end.
      977     for each del_hold-sale
      978       where del_hold-sale.cat-code = p-cat-code
      979     on error undo, return error
      980     :
      981       delete del_hold-sale .
      982     end.
      983     for each del_hold-sale-grp
      984       where del_hold-sale-grp.cat-code = p-cat-code
      985     on error undo, return error
      986     :
      987       delete del_hold-sale-grp .
      988     end.
      989     for each buf_db no-lock
      990     ,each buf_clients no-lock
      991       where buf_clients.db-num = buf_db.db-num
      992     ,each buf_trn-doc no-lock
      993       where buf_trn-doc.obj-type = buf_clients.obj-type
      994         and buf_trn-doc.obj-code = buf_clients.obj-code
      995         and buf_trn-doc.status_ = 'факт':U
      996         and buf_trn-doc.fact-date >= v-begin-date
      997     on error undo, return error
      998     :
      999       run waitfram-show in this-procedure
     1000         (input substitute("Расчет архивов по категории &1. Документ &2"
     1001                ,p-cat-code
     1002                ,buf_trn-doc.doc-code
     1003                )
     1004         ) .
     1005       do transaction
     1006       on error undo, return error
     1007       :
     1008         define buffer buf_batchprocess for ub.batchprocess .
     1009         define buffer update_batchprocess for ub.batchprocess .
     1010         find first buf_BatchProcess exclusive-lock
     1011           where buf_BatchProcess.bp_type     = p-btpr-type-code
     1012             and buf_BatchProcess.bp_status   = 'N':U
     1013             and buf_batchprocess.charkey_one = buf_trn-doc.doc-code
     1014           no-error .
     1015         if available buf_BatchProcess
     1016         then do:
     1017     find first update_batchprocess exclusive-lock
     1018       where rowid(update_batchprocess) = rowid(buf_batchprocess)
     1019       no-error .
     1020     if not available update_batchprocess then do:
     1021       message
     1022         vss-workfile vss-revision vss-description skip
     1023         "Не найдена запись пересчета архива" skip
     1024         view-as alert-box error .
     1025       undo, return error .
     1026     end.
     1027     if update_batchprocess.bp_status <> 'N':U then do:
     1028       message
     1029         vss-workfile vss-revision vss-description skip
     1030         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
     1031         "BP_Type"       update_batchprocess.BP_Type       skip
     1032         "BP_Status"     update_batchprocess.BP_Status     skip
     1033         "Key#_One"      update_batchprocess.Key#_One      skip
     1034         "Key#_Two"      update_batchprocess.Key#_Two      skip
     1035         "Key#_Three"    update_batchprocess.Key#_Three    skip
     1036         "CharKey_One"   update_batchprocess.CharKey_One   skip
     1037         "CharKey_Two"   update_batchprocess.CharKey_Two   skip
     1038         "CharKey_Three" update_batchprocess.CharKey_Three skip
     1039         view-as alert-box error .
     1040       undo, return error .
     1041     end.
     1042       define variable v-btpr_upd-today-4 as date      no-undo.
     1043     define variable v-btpr_upd-time-4  as integer   no-undo.
     1044     run cur-time in this-procedure ( output v-btpr_upd-today-4
     1045                                    , output v-btpr_upd-time-4
     1046                                    ).
     1047     assign
     1048       update_batchprocess.bp_status         = 'D':U
     1049       update_batchprocess.bp_execcounttries = update_batchprocess.bp_execcounttries + 1
     1050       update_batchprocess.bp_execuser_id    = g#userid
     1051       update_batchprocess.bp_execsysdate    = v-btpr_upd-today-4
     1052       update_batchprocess.bp_execsystime    = string(v-btpr_upd-time-4, 'hh:mm')
     1053       update_batchprocess.bp_execsystimeint = v-btpr_upd-time-4
     1054     .
     1055         end.
     1056         run trg/harhtclc.p
     1057           (input p-cat-code
     1058           ,input p-lock-code
     1059           ,input p-btpr-type-code
     1060           ,input buf_trn-doc.doc-code
     1061           ) no-error.
     1062         if error-status :error
     1063         then do:
     1064           message
     1065             vss-workfile vss-revision vss-description skip
     1066             string       ("Ошибка при первоначальном расчете межфирменных архивов:" + chr(10) +
     1067                           "cat-code:" + chr(32) + string(p-cat-code) + chr(10) +
     1068                           "документ:" + chr(32) + buf_trn-doc.doc-code + chr(10)
     1069                           )
     1070           view-as alert-box error .
     1071           undo, return error
     1072             ("Ошибка при первоначальном расчете межфирменных архивов:" + chr(10) +
     1073                           "cat-code:" + chr(32) + string(p-cat-code) + chr(10) +
     1074                           "документ:" + chr(32) + buf_trn-doc.doc-code + chr(10)
     1075                           ).
     1076         end.
     1077       end.
     1078     end.
     1079     run holdattr-write in this-procedure
     1080       (input p-cat-code
     1081       ,input 'is-calc':U
     1082       ,input 'false':u
     1083       ) no-error .
     1084     if error-status :error
     1085     then do:
     1086       message
     1087         vss-workfile vss-revision vss-description skip
     1088         "Ошибка при записи атрибута - первоначальный расчет межфирменных архивов" skip
     1089         error-status :get-message(1) skip
     1090         return-value skip
     1091         view-as alert-box error .
     1092       undo, return error .
     1093     end.
     1094   end.
