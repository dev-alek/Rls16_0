        1   block-level on error undo, throw.
        2   define input parameter parw-p-code      like ub.wth-place.w-p-code no-undo .
        3   define input parameter parhost-code     like ub.wth-place.host-code no-undo .
        4   define input parameter parobj-type      like ub.wth-place.obj-type no-undo .
        5   define input parameter parobj-code      like ub.wth-place.obj-code  no-undo .
        6   define input parameter parw-p-name      like ub.wth-place.w-p-name no-undo .
        7   define input parameter par-status_      like ub.wth-place.status_  no-undo .
        8   define input parameter parcash-desk     like ub.wth-place.cash-desk  no-undo .
        9   define input parameter parmain-cash-desk like ub.wth-place.main-cash-desk  no-undo .
       10   define input parameter par-PS            like ub.wth-place.ps  no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Проверка корректности при сохранении изменений в записи МХ МЦ".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   DEFINE VARIABLE var-entry as character no-undo .
       87   define buffer buf_clients  for ub.clients .
       88   define buffer buf_wth-place for ub.wth-place .
       89   FIND FIRST ub.sysconf No-LOCK WHERE
       90              ub.sysconf.host-code = parhost-code No-ERROR.
       91   IF NOT AVAIL ub.sysconf THEN DO:
       92     MESSAGE "Не найдена фирма!"
       93     VIEW-AS ALERT-BOX ERROR.
       94     return error var-entry.
       95   END.
       96   FIND FIRST buf_clients No-LOCK WHERE
       97             buf_clients.obj-type = parobj-type AND
       98             buf_clients.obj-code = parobj-code NO-ERROR.
       99   IF NOT AVAIL buf_clients or
      100     NOT  (buf_clients.obj-type = 'маг':U OR buf_clients.obj-type = 'скл':U) THEN DO:
      101     MESSAGE "Не найден или неверно определен объект!"
      102     VIEW-AS ALERT-BOX ERROR.
      103     var-entry =  "obj-type":U.
      104     return error var-entry.
      105   END.
      106   if buf_clients.obj-type = 'скл':U then do:
      107     if parcash-desk <> 0 then do:
      108        message "Нельзя определить кассу как МХ МЦ для объекта типа склад"
      109        view-as alert-box error .
      110        var-entry = "cash-desk":U.
      111        return error var-entry.
      112     end.
      113   end.
      114   else do:
      115     if parcash-desk <>0 then do:
      116       FIND FIRST ub.cash-desk No-LOCK WHERE
      117                  ub.cash-desk.db-num = buf_clients.db-num AND
      118                 ub.cash-desk.obj-code = parobj-code AND
      119                 ub.cash-desk.cash-num = parcash-desk No-ERROR.
      120       if not available ub.cash-desk then do:
      121         message "Не найдена касса N " parcash-desk "в магазине" parobj-code
      122         view-as alert-box error .
      123         var-entry = "cash-desk":U.
      124         return error var-entry.
      125       end.
      126       FIND FIRST buf_wth-place NO-LOCK WHERE
      127                  buf_wth-place.host-code = parhost-code and
      128                 buf_wth-place.obj-type = parobj-type and
      129                 buf_wth-place.obj-code = parobj-code and
      130                 buf_wth-place.cash-desk = parcash-desk and
      131                 buf_wth-place.w-p-code <> parw-p-code No-ERROR.
      132       if available buf_wth-place then do:
      133         message
      134         "Касса" parcash-desk "магазина" parobj-code skip
      135         "уже привязана к МХ" buf_wth-place.w-p-code
      136         view-as alert-box .
      137         var-entry = "cash-desk":U.
      138         return error var-entry.
      139       end.
      140     end.
      141     if parmain-cash-desk = yes then do:
      142       FIND FIRST buf_wth-place NO-LOCK WHERE
      143                  buf_wth-place.host-code = parhost-code and
      144                 buf_wth-place.obj-type = parobj-type and
      145                 buf_wth-place.obj-code = parobj-code and
      146                 buf_wth-place.main-cash-desk = yes and
      147                 buf_wth-place.w-p-code <> parw-p-code No-ERROR.
      148       if available buf_wth-place then do:
      149         message "Уже определена главная касса в магазине" parobj-code
      150         view-as alert-box error .
      151         var-entry = "main-cash-desk":U.
      152         return error var-entry.
      153       end.
      154     end.
      155   end.
