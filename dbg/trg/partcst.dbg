        1   block-level on error undo, throw.
        2   define input parameter p-cst-code  like ub.parts.cst-code  no-undo .
        3   define input parameter p-in-code   like ub.parts.in-code   no-undo .
        4   define input parameter p-artic     like ub.parts.artic     no-undo .
        5   define input parameter p-prod-type like ub.parts.prod-type no-undo .
        6   define input parameter p-prod-code like ub.parts.prod-code no-undo .
        7   define input parameter p-part-code like ub.parts.part-code no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Изменение кода ГТД для партии приходной накладной ".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define buffer buf_gds-obj for ub.gds-obj .
       71   define buffer buf_parts for ub.parts .
       72   define buffer buf_parts-attr for ub.parts-attr .
       73   main-block:
       74   do transaction
       75   on error undo main-block, return error
       76   :
       77     for each ub.gds-obj no-lock
       78       where ub.gds-obj.artic     = p-artic
       79         and ub.gds-obj.prod-type = p-prod-type
       80         and ub.gds-obj.prod-code = p-prod-code
       81     on error undo main-block, return error
       82     :
       83       find first buf_gds-obj exclusive-lock
       84         where recid(buf_gds-obj) = recid(ub.gds-obj)
       85         .
       86     end.
       87     define variable v-gds-code as integer   no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
       90     (input  p-artic
       91     ,input  p-prod-type
       92     ,input  p-prod-code
       93     ,output v-gds-code
       94     )  .
       95     find first buf_parts-attr exclusive-lock
       96       where buf_parts-attr.in-code   = p-in-code
       97         and buf_parts-attr.gds-code  = v-gds-code
       98         and buf_parts-attr.part-code = p-part-code
       99       no-error .
      100     if available buf_parts-attr
      101     then do:
      102       assign
      103         buf_parts-attr.cst-code = p-cst-code
      104       .
      105     end.
      106     for each ub.parts no-lock
      107       where ub.parts.in-code   = p-in-code
      108         and ub.parts.artic     = p-artic
      109         and ub.parts.prod-type = p-prod-type
      110         and ub.parts.prod-code = p-prod-code
      111         and ub.parts.part-code = p-part-code
      112     on error undo main-block, return error
      113     :
      114       if ub.parts.cst-code <> p-cst-code then do:
      115         find first buf_parts exclusive-lock
      116           where recid(buf_parts) = recid(ub.parts)
      117           .
      118         assign
      119           buf_parts.cst-code = p-cst-code
      120         .
      121       end.
      122     end.
      123   end.
