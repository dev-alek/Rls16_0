        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-log-handle  as handle no-undo .
        4   define input parameter p-parameter   as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Обработка изменений группы меню".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
      305   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   DEFINE New SHARED TEMP-TABLE cash-fgrp no-undo
      307   FIELD node-code like ub.fbr-gds-grp.node-code
      308   FIELD upper-code like ub.fbr-gds-grp.upper-code
      309   FIELD out-code like ub.fbr-gds-grp.out-code
      310   FIELD node-name like ub.fbr-gds-grp.node-name
      311   FIELD upper-out-code like ub.fbr-gds-grp.out-code
      312   FIELD lvl-num        like ub.fbr-gds-grp.lvl-num
      313   FIELD stts  as integer
      314   FIELD action-code as integer
      315   index iout-code IS PRIMARY out-code
      316   index istts stts
      317   index ilvl action-code lvl-num
      318   .
      319   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   define variable v-waitfram-action01         as character   no-undo .
      321   define variable v-waitfram-action02         as character   no-undo .
      322   define variable v-waitfram-action03         as character   no-undo .
      323   define variable mWaitFramTextBeg            as character   no-undo.
      324   define variable mWaitFramTextEnd            as character   no-undo.
      325   define variable mWaitFramView               as logical     no-undo.
      326   define variable mWaitProcEvent              as logical     no-undo init yes.
      327   define variable mWaitFramInterval           as integer     no-undo init 1 .
      328   define variable mWaitFramStop               as logical     no-undo.
      329   define variable mWaitFramStopUser           as logical     no-undo.
      330   define variable mWaitFramStopTimeOut        as logical     no-undo.
      331   define variable mWaitFramStartProc          as datetime-tz no-undo.
      332   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      333   define button B-WaitFramStop auto-end-key
      334        label "Стоп"
      335        size 10 by 1 tooltip "Остоновить процесс".
      336   define button B-viewProcInfo
      337        label "Информация"
      338        size 15 by 1 tooltip "Информация о процесс".
      339   define frame waitfram
      340     v-waitfram-action01 format "x(72)" no-label skip
      341     v-waitfram-action02 format "x(72)" no-label skip
      342     v-waitfram-action03 format "x(72)" no-label skip
      343     B-viewProcInfo
      344     B-WaitFramStop at row 4 col 30
      345     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      346     .
      347   define new global shared variable mBatchMode as logical no-undo init ?.
      348   define variable mFramBachModHandle as handle no-undo.
      349   mFramBachModHandle = frame waitfram:handle.
      350   define variable mFameOldVis as logical no-undo.
      351   define variable mVisCUrentVin as logical no-undo.
      352   if session:batch-mode
      353   then
      354      mBatchMode = yes.
      355   if mBatchMode = ? then do:
      356     mVisCUrentVin = current-window:visible.
      357     mFameOldVis = mFramBachModHandle:visible.
      358     mFramBachModHandle:visible  = yes.
      359     mBatchMode = mFramBachModHandle:visible ne yes.
      360     mFramBachModHandle:visible = mFameOldVis.
      361     current-window:visible = mVisCUrentVin.
      362   end.
      363    if  log-manager:logfile-name ne ?
      364     then DO:
      365         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      366         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      367         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      368     end.
      369   on choose of B-WaitFramStop in frame waitfram
      370   do:
      371     mWaitFramStop = yes.
      372     mWaitFramStopUser = yes.
      373   end.
      374   function waitfram-check-timeout returns logical():
      375      define variable vtime as int64 no-undo.
      376      if mWaitFramStopTimeOut
      377      then
      378         return yes.
      379      vtime = ( now - mWaitFramStartProc ) / 1000 .
      380      if     mWaitFramTimeOut ne ?
      381         and mWaitFramTimeOut ne 0
      382         and mWaitFramTimeOut lt vtime
      383      then do:
      384         mWaitFramStopTimeOut = yes.
      385      end.
      386      return mWaitFramStopTimeOut.
      387   end.
      388   procedure waitfram-hide :
      389     if not session:batch-mode
      390     then do
      391     on error undo, return error return-value
      392     :
      393       pause 0 before-hide .
      394       if not mBatchMode then
      395         hide frame waitfram .
      396     if     not mWaitFramView
      397        and mWaitProcEvent
      398     then
      399       process events .
      400     end.
      401   end procedure.
      402   procedure waitfram-show :
      403     define input  parameter p-message as character no-undo .
      404     define variable v-left-margin as integer   no-undo .
      405     if not session:batch-mode
      406     then do
      407     on error undo, return error return-value
      408     :
      409       if length(p-message) <= 70 then do:
      410         assign
      411           v-left-margin = integer((70 - length(p-message)) / 2)
      412         .
      413         assign
      414           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      415         .
      416         assign
      417           v-waitfram-action01 = " "
      418           v-waitfram-action02 = " "
      419                                    + fill(" ", v-left-margin)
      420                                    + p-message
      421           v-waitfram-action03 = " "
      422         .
      423       end.
      424       else do:
      425         define variable vRindex1 as integer no-undo.
      426         define variable vRindex2 as integer no-undo.
      427         vRindex1 = r-index(p-message," ",70).
      428         if vRindex1 = 0
      429         then
      430            vRindex1 = 70.
      431         if length(p-message)  <= vRindex1 + 70 then do:
      432           assign
      433             v-waitfram-action01 = " "
      434             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      435             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      436           .
      437         end.
      438         else do:
      439           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      440           if vRindex2 <= vRindex1
      441           then
      442              vRindex2 = vRindex1 + 70.
      443           assign
      444             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      445             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      446             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      447           .
      448         end.
      449       end.
      450       B-viewProcInfo:visible   in frame waitfram = no.
      451       B-viewProcInfo:sensitive in frame waitfram = no.
      452       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      453       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      454       if  (   mWaitFramView
      455          or  mWaitProcEvent)
      456          and not mBatchMode
      457       then
      458          display
      459             v-waitfram-action01 skip
      460             v-waitfram-action02 skip
      461             v-waitfram-action03 skip
      462          with frame waitfram .
      463       if     mWaitFramView
      464          then do:
      465             if     mWaitFramInterval ne ?
      466                and not mBatchMode
      467             then
      468                wait-for go of frame waitfram pause mWaitFramInterval.
      469          end.
      470          else
      471             if     mWaitProcEvent
      472                and not mBatchMode
      473             then
      474                process events .
      475     end.
      476   end procedure.
      477      procedure waitfram-show-this:
      478         define input  parameter iInterval as int64 no-undo.
      479         define variable vtime as int64 no-undo.
      480         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      481         mWaitFramInterval = iInterval.
      482         run waitfram-show (substitute("&1&2 &3&4" ,
      483                                       mWaitFramTextBeg ,
      484                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      485                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      486                                       mWaitFramTextEnd
      487                                      )
      488                           ).
      489      end.
      490      procedure WaitFramRunPause:
      491         define input  parameter iInterval as dec no-undo.
      492         define variable vStart  as datetime-tz no-undo.
      493         define variable vend    as datetime-tz no-undo.
      494         define variable vint as int64 no-undo.
      495         define variable vOk as logical no-undo.
      496         vStart = now.
      497         vend   = vStart.
      498         publish "WaitFramPause" (iInterval,output vOk).
      499         vend   =  now.
      500         vint = vend - vStart.
      501         vint = iInterval - vint / 1000.
      502         if     not mWaitFramStop
      503            and (   vint > 0
      504                 or (    not vOk
      505                     and iInterval eq ?
      506                     )
      507                 )
      508         then
      509            run waitfram-show-this (iInterval).
      510         vend   =  now.
      511         vint = vend - vStart.
      512         vint = iInterval - vint / 1000.
      513         if     not mWaitFramStop
      514            and vint > 0
      515         then do:
      516            run gbl/pause.p (vint * 1000).
      517         end.
      518         if iInterval ne ?
      519         then
      520            publish "WaitFramStop".
      521         waitfram-check-timeout().
      522      end.
      523      procedure WaitFramWaitFor:
      524         define input  parameter iInterval as dec no-undo.
      525         assign
      526            mWaitFramStartProc   = now
      527            mWaitFramStopUser    = no
      528            mWaitFramStopTimeOut = no
      529         .
      530         block-wait:
      531         do while not mWaitFramStop:
      532            run WaitFramRunPause (iInterval).
      533            if  waitfram-check-timeout()
      534            then do:
      535               leave block-wait.
      536            end.
      537         end.
      538         run waitfram-hide.
      539      end.
      540   procedure waitfram-join :
      541     define input  parameter p-line-1  as character no-undo .
      542     define input  parameter p-line-2  as character no-undo .
      543     define input  parameter p-line-3  as character no-undo .
      544     define output parameter p-message as character no-undo .
      545     do
      546     on error undo, return error return-value
      547     :
      548       assign
      549         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      550                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      551                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      552       .
      553     end.
      554   end procedure.
      555   function waitfram-join-function returns character
      556     (input p-line-1 as character
      557     ,input p-line-2 as character
      558     ,input p-line-3 as character
      559     ).
      560     define variable v-message as character no-undo .
      561     run waitfram-join in this-procedure
      562       (input  p-line-1
      563       ,input  p-line-2
      564       ,input  p-line-3
      565       ,output v-message
      566       ) .
      567     return v-message .
      568   end function .
      569   define temp-table temp-fgrp-list no-undo
      570     field action-num  as integer
      571     field obj-type    like ub.fbr-gds-grp.obj-type
      572     field obj-code    like ub.fbr-gds-grp.obj-code
      573     field node-code   like ub.fbr-gds-grp.node-code
      574     field out-code    like ub.fbr-gds-grp.out-code
      575     field upper-code  like ub.fbr-gds-grp.upper-code
      576     field upper-out-code  like ub.fbr-gds-grp.out-code
      577     field lvl-num      like ub.fbr-gds-grp.lvl-num
      578     field action      as character
      579     field bp_rowid    as rowid
      580     index xpk is primary unique action-num
      581     index iobj obj-type obj-code
      582   .
      583   define variable  p-message-on as logical   no-undo .
      584   define variable log-file-name as character no-undo init "send-cd.txt":U.
      585   define variable v-view-log as logical no-undo .
      586   define variable v-stop as logical no-undo .
      587   main-block:
      588   do
      589   on error undo main-block, return error return-value
      590   :
      591     assign
      592     p-message-on = (if entry(1, p-parameter, chr(4)) = "yes"
      593                     then yes
      594                     else (if entry(1, p-parameter, chr(4)) = "no"
      595                           then no
      596                           else ?)
      597                   )
      598     no-error
      599     .
      600     if error-status:error or p-message-on = ? then return error.
      601     run write-log-and-file in p-log-handle (
      602           input 1
      603         , input log-file-name
      604         , input 1
      605         , input substitute("Ждите... Поиск информации, подлежащей отправке на кассы...")
      606                                               ).
      607     run create-fgrp-list in this-procedure .
      608     run waitfram-hide in this-procedure .
      609     run process-fgrp-list in this-procedure .
      610     run close-fgrp-list in this-procedure .
      611   end.
      612   procedure create-fgrp-list :
      613     define buffer buf_batchprocess for ub.batchprocess .
      614     define buffer buf_temp-fgrp-list for temp-fgrp-list .
      615     do
      616     on error undo, return error return-value
      617     :
      618       for each buf_BatchProcess no-lock
      619         where buf_BatchProcess.bp_type       = 'fgrp':U
      620           and buf_BatchProcess.bp_status     = 'N':U
      621       on error undo, return error return-value
      622       :
      623         create buf_temp-fgrp-list .
      624         assign
      625           buf_temp-fgrp-list.action-num  = buf_BatchProcess.BatchProcess#
      626           buf_temp-fgrp-list.obj-type    = buf_BatchProcess.charkey_one
      627           buf_temp-fgrp-list.obj-code    = buf_BatchProcess.key#_one
      628           buf_temp-fgrp-list.node-code   = buf_BatchProcess.key#_two
      629           buf_temp-fgrp-list.upper-code  = buf_BatchProcess.key#_three
      630           buf_temp-fgrp-list.out-code    = integer(buf_BatchProcess.charkey_two)
      631           buf_temp-fgrp-list.upper-out-code = integer(entry(1, buf_BatchProcess.charkey_three))
      632           buf_temp-fgrp-list.lvl-num     = integer(entry(2, buf_BatchProcess.charkey_three))
      633           buf_temp-fgrp-list.action      = buf_BatchProcess.bp_execsystime
      634           buf_temp-fgrp-list.bp_rowid   = rowid(buf_BatchProcess)
      635         .
      636       end.
      637     end.
      638   end procedure.
      639   procedure process-fgrp-list :
      640     define buffer buf_temp-fgrp-list for temp-fgrp-list .
      641     define buffer cli_shops for ub.clients .
      642     define buffer buf_cash-desk for ub.cash-desk .
      643     define variable lns-cnt as integer no-undo .
      644     define variable line-rec as recid no-undo .
      645     define variable v-db-num like ub.db.db-num no-undo .
      646     define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
      647     define buffer buf_clients for ub.clients.
      648     do
      649     on error undo, return error return-value
      650     :
      651   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      653     (output v-db-num
      654     )  .
      655       _buf_temp-fgrp-list:
      656       for each buf_temp-fgrp-list
      657       break
      658       by buf_temp-fgrp-list.obj-type
      659       by buf_temp-fgrp-list.obj-code
      660       on error undo, return error return-value
      661       :
      662         if first-of(buf_temp-fgrp-list.obj-code) then do:
      663           run get-stop-state in p-log-handle (output v-stop).
      664           if v-stop then do:
      665             run write-log-and-file in p-log-handle (
      666                   input 1
      667                 , input log-file-name
      668                 , input 1
      669                 , input substitute("!!!Процедура пересылки остановлена пользователем"
      670                                     )
      671                                       ).
      672             leave _buf_temp-fgrp-list.
      673           end.
      674           for each cash-fgrp:
      675             delete cash-fgrp.
      676           end.
      677         end.
      678         find first cash-fgrp where
      679                   cash-fgrp.out-code = buf_temp-fgrp-list.out-code no-error .
      680         if not avail cash-fgrp then do:
      681           create cash-fgrp.
      682           assign
      683           cash-fgrp.out-code = buf_temp-fgrp-list.out-code
      684           .
      685         end.
      686         assign
      687         cash-fgrp.node-code = buf_temp-fgrp-list.node-code
      688         cash-fgrp.upper-code = buf_temp-fgrp-list.upper-code
      689         cash-fgrp.upper-out-code = buf_temp-fgrp-list.upper-out-code
      690         cash-fgrp.stts = (if buf_temp-fgrp-list.action = "D":U then 1 else 0)
      691         cash-fgrp.lvl-num = buf_temp-fgrp-list.lvl-num
      692         cash-fgrp.action-code = buf_temp-fgrp-list.action-num
      693         .
      694         if last-of(buf_temp-fgrp-list.obj-code) then do:
      695           if can-find(first cash-fgrp)
      696           and can-find(first buf_cash-desk where
      697                             buf_cash-desk.db-num = v-db-num
      698                         AND buf_cash-desk.OBJ-CODE = buf_temp-fgrp-list.obj-code
      699                         AND buf_cash-desk.pos-type = 'MAGIA-XML':U
      700                             ) then do:
      701              run str/send-fgr.p (
      702                                input parparentproc
      703                               ,input this-procedure
      704                               ,input p-log-handle
      705                               ,input(string(buf_temp-fgrp-list.obj-code) + chr(4) + "U":U + chr(4) + "yes":U)
      706                             ) no-error .
      707             if error-status:error then do:
      708               run set-view-log in p-log-handle(yes).
      709             end.
      710           end.
      711         end.
      712       end.
      713     end.
      714   end procedure.
      715   procedure close-fgrp-list :
      716     define buffer buf_batchprocess for ub.batchprocess .
      717     define buffer buf_temp-fgrp-list for temp-fgrp-list .
      718     do
      719     on error undo, return error return-value
      720     :
      721       for each buf_temp-fgrp-list
      722       on error undo, return error return-value
      723       :
      724         do transaction
      725         on error undo, return error return-value
      726         :
      727     find first buf_batchprocess exclusive-lock
      728       where rowid(buf_batchprocess) = buf_temp-fgrp-list.bp_rowid
      729       no-error .
      730     if not available buf_batchprocess then do:
      731       message
      732         vss-workfile vss-revision vss-description skip
      733         "Не найдена запись пересчета архива" skip
      734         view-as alert-box error .
      735       undo, return error .
      736     end.
      737     if buf_batchprocess.bp_status <> 'N':U then do:
      738       message
      739         vss-workfile vss-revision vss-description skip
      740         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
      741         "BP_Type"       buf_batchprocess.BP_Type       skip
      742         "BP_Status"     buf_batchprocess.BP_Status     skip
      743         "Key#_One"      buf_batchprocess.Key#_One      skip
      744         "Key#_Two"      buf_batchprocess.Key#_Two      skip
      745         "Key#_Three"    buf_batchprocess.Key#_Three    skip
      746         "CharKey_One"   buf_batchprocess.CharKey_One   skip
      747         "CharKey_Two"   buf_batchprocess.CharKey_Two   skip
      748         "CharKey_Three" buf_batchprocess.CharKey_Three skip
      749         view-as alert-box error .
      750       undo, return error .
      751     end.
      752       define variable v-btpr_upd-today-4 as date      no-undo.
      753     define variable v-btpr_upd-time-4  as integer   no-undo.
      754     run cur-time in this-procedure ( output v-btpr_upd-today-4
      755                                    , output v-btpr_upd-time-4
      756                                    ).
      757     assign
      758       buf_batchprocess.bp_status         = 'D':U
      759       buf_batchprocess.bp_execcounttries = buf_batchprocess.bp_execcounttries + 1
      760       buf_batchprocess.bp_execuser_id    = g#userid
      761       buf_batchprocess.bp_execsysdate    = v-btpr_upd-today-4
      762       buf_batchprocess.bp_execsystime    = string(v-btpr_upd-time-4, 'hh:mm')
      763       buf_batchprocess.bp_execsystimeint = v-btpr_upd-time-4
      764     .
      765         end.
      766       end.
      767     end.
      768   end procedure.
