      768       buf_c-gds-grp-hist.subject = 'tax-rate-gds-grp':U
      769       buf_c-gds-grp-hist.is-news = g#news
      770       buf_c-gds-grp-hist.source-type = p-source-type
      771       buf_c-gds-grp-hist.source-ref = p-source-ref
      772       .
      773     end.
      774   end procedure.
      775   define variable p-news as logical no-undo.
      776   main-block:
      777   do
      778   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      779   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      780   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      781   :
      782     run grp-attr-news in this-procedure(input ub.gds-grp-attr.attr-code,
      783                                         output p-news) no-error.
      784     if not p-news then return.
      785     run nws/cmd-del.p
      786       ( input "gds-grp-attr":U
      787        ,input (buffer ub.gds-grp-attr:handle)
      788        ,input "":U
      789       ) no-error .
      790     if error-status :error then do:
      791       undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      792     end.
      793     if not g#news then do:
      794       run gds-grph_write-gds-grp-attr-proc   in this-procedure (
      795                                                         buffer ub.gds-grp-attr
      796                                                         ,integer('99':U)
      797                                                         ,"":U
      798                                                         ,"":U
      799                                                         ).
      800     end.
      801       if g#oxml = yes
      802       then do:
      803       run str/calloxml.p (
      804             input 'delete':U
      805           , input 'gds-grp-attr':U
      806           , input ( buffer ub.gds-grp-attr:handle )
      807       ) no-error.
      808       if error-status :error
      809       then do:
      810           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      811                                , chr(10)
      812                                , vss-workfile
      813                                , return-value
      814                                , error-status :get-message ( 1 ) ).
      815       end.
      816       end.
      817   end.
