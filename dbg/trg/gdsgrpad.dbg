      742                       "Ошибка задания входных параметров:Не определена группы товара на объекте" ).
      743       end.
      744       run cur-time in this-procedure(output v-date, output v-time).
      745       create buf_c-tax-rate-gds-grp.
      746       buffer-copy buf_tax-rate-gds-grp to buf_c-tax-rate-gds-grp
      747       assign
      748       buf_c-tax-rate-gds-grp.node-code          = buf_tax-rate-gds-grp.node-code
      749       buf_c-tax-rate-gds-grp.tax-code           = buf_tax-rate-gds-grp.tax-code
      750       buf_c-tax-rate-gds-grp.host-code          = buf_tax-rate-gds-grp.host-code
      751       buf_c-tax-rate-gds-grp.obj-type           = buf_tax-rate-gds-grp.obj-type
      752       buf_c-tax-rate-gds-grp.obj-code           = buf_tax-rate-gds-grp.obj-code
      753       buf_c-tax-rate-gds-grp.chip-num           = next-value (s-gds-grp-chip, ub)
      754       buf_c-tax-rate-gds-grp.corr-time          = v-time
      755       buf_c-tax-rate-gds-grp.corr-user-db-num   = g#db-num
      756       buf_c-tax-rate-gds-grp.corr-user-name     = (if g#news
      757                                           then (chr(4) +  'СПН':U)
      758                                           else (if g#esys
      759                                                then (chr(4) +  'ВС':U)
      760                                                else g#userid)
      761                                           )
      762       buf_c-tax-rate-gds-grp.corr-date          = v-date
      763       .
      764       create buf_c-gds-grp-hist.
      765       buffer-copy buf_c-tax-rate-gds-grp to buf_c-gds-grp-hist
      766       assign
