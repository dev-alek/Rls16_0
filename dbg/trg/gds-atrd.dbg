      899   define variable v-cntxa-report-num as integer no-undo .
      900   PROCEDURE get-report-num :
      901     define output parameter p-report-num as integer no-undo .
      902     do
      903     on error undo, return error
      904     :
      905       if v-cntxa-report-num = 0 then do:
      906         run gbl/getrpnum.p (output p-report-num).
      907         v-cntxa-report-num = p-report-num.
      908       end.
      909       else do:
      910         assign
      911         p-report-num = v-cntxa-report-num
      912         .
      913       end.
      914     end.
      915   END PROCEDURE.
      916   PROCEDURE get-userid :
      917   do
      918   on error undo, return error
      919   :
      920   define output parameter p-userid  as character    no-undo.
      921       assign
      922           p-userid = g#userid
      923       .
      924   end.
      925   END PROCEDURE.
      926   PROCEDURE get-version-num :
      927   define output parameter p-curr-version as character no-undo .
      928     do
      929     on error undo, return error return-value
      930     :
      931       run gbl/getvern.p
      932         ( output p-curr-version
      933         ) .
      934     end.
      935   END PROCEDURE.
      936   procedure get-news :
      937   define output parameter p-news as logical no-undo .
      938     do
      939     on error undo, return error
      940     :
      941        p-news = g#news.
      942     end.
      943   end procedure.
      944   procedure get-esys :
      945   define output parameter p-esys as logical no-undo .
      946     do
      947     on error undo, return error
      948     :
      949        p-esys = g#esys.
      950     end.
      951   end procedure.
      952   define variable sendGoods2Kassa as logical no-undo init false.
      953   define variable p-news as logical no-undo.
      954   define variable v-date as date no-undo .
      955   define variable v-time as integer no-undo .
      956   define variable v-manual-editing as integer no-undo .
      957   define variable conf-par         as character no-undo .
      958   define variable par-type         as character no-undo .
      959   define variable v-type           as character no-undo .
      960   define variable v-format         as character no-undo .
      961   define variable v-label          as character no-undo .
      962   define variable v-user-can-edit  as logical   no-undo .
      963   define variable v-output-display as logical   no-undo .
      964   define variable v-other          as character no-undo .
      965   define variable jj               as integer no-undo .
      966   define variable v-dop1 as character no-undo .
      967   define variable v-dop2 as character no-undo .
      968   define buffer buf_goods for ub.goods.
      969   define buffer buf_c-goods-attr for ub.c-goods-attr.
      970   define buffer buf_c-goods-attr-any for ub.c-goods-attr-any.
      971   define buffer buf_c-gds-hist for ub.c-gds-hist.
      972   define buffer locked_goods-attr for ub.goods-attr.
      973   main-block:
      974   do
      975   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      976   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      977   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      978   :
      979     if not ub.goods-attr.attr-code = 'lock':U then do:
      980       run gds-attr-manual-edit in this-procedure (
      981                                                       input ub.goods-attr.attr-code
      982                                                       ,output v-manual-editing
      983                                                       ) no-error .
      984       if not error-status:error
      985       and v-manual-editing > 0 then do:
      986       Find first locked_goods-attr exclusive-lock  where
      987               locked_goods-attr.gds-code = ub.goods-attr.gds-code
      988           and locked_goods-attr.attr-code = 'lock':U
      989           no-error no-wait.
      990       if locked locked_goods-attr then
      991       undo main-block, return error substitute("&1&2Атрибут товара &3 &4 занят"
      992                                                 , 'lock':U
      993                                                 , chr(4)
      994                                                 , ub.goods-attr.attr-code
      995                                                 , ub.goods-attr.gds-code
      996                                                    ).
      997        end.
      998     end.
      999     if lookup( ub.goods-attr.attr-code,  '8x50,15x80,6x50,6x50,8x50,8x50,8x50,8x50,8x50':U) > 0
     1000     then do:
     1001       find first buf_goods no-lock where buf_goods.gds-code = ub.goods-attr.gds-code no-error.
     1002       if available buf_goods then do:
     1003   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1004   define variable v-attr-code4 as character no-undo .
     1005   define buffer buf4_gds-prt for ub.gds-prt.
     1006   define buffer buf4_bar-code for ub.bar-code.
     1007   define buffer buf4_scales-gds for ub.scales-gds.
     1008   define buffer buf4_scales for ub.scales.
     1009   find buf4_gds-prt no-lock
     1010     where buf4_gds-prt.upper-code = buf_goods.prt-root
     1011     .
     1012   find first buf4_bar-code no-lock
     1013     where buf4_bar-code.gds-code  = buf_goods.gds-code
     1014       and buf4_bar-code.node-code = buf4_gds-prt.node-code
     1015       and buf4_bar-code.part-code = ""
     1016       and buf4_bar-code.in-code   = ""
     1017       and buf4_bar-code.unit-cli  = buf_goods.unit-base
     1018     no-error .
     1019   if available buf4_bar-code then do:
     1020     for each buf4_scales-gds
     1021       where buf4_scales-gds.db-num = g#db-num
     1022         AND buf4_scales-gds.b-code = buf4_bar-code.b-code
     1023     :
     1024       find first buf4_scales
     1025         where buf4_scales.scales-num = buf4_scales-gds.scales-num
     1026          and buf4_scales.db-num = buf4_scales-gds.db-num
     1027         .
     1028           assign
     1029       v-attr-code4 = entry (lookup (buf4_scales.scales-type, 'CAS_lp-16x,DIGI-SM,CAS_CL5000J,CAS_CL5000,TIGER-SPCT2,TIGER-SPCT1,CAS_LP-15,SHTRIH-M,CAS_LP-15v1.6':U), '8x50,15x80,6x50,6x50,8x50,8x50,8x50,8x50,8x50':U) no-error .
     1030       if lookup(buf4_scales.scales-type, 'CAS_lp-16x,DIGI-SM,CAS_CL5000J,CAS_CL5000,TIGER-SPCT2,TIGER-SPCT1,CAS_LP-15,SHTRIH-M,CAS_LP-15v1.6':U) > 0
     1031       and (ub.goods-attr.attr-code = "struct" or v-attr-code4 = ub.goods-attr.attr-code)
     1032       then do:
     1033       run ref/ves-pbc.p (
     1034                       input ?
     1035                     , input 'ИЗМЕНЕНИЕ':U
     1036                       , input buf4_scales-gds.obj-type
     1037                       , input buf4_scales-gds.obj-code
     1038                       , input ?
     1039                       , input ?
     1040                       , input ?
     1041                       , input ?
     1042                       , buffer buf4_bar-code
     1043                       , buffer buf4_scales) .
     1044         end.
     1045     end.
     1046   end.
     1047       end.
     1048     end.
     1049     if g#news then do:
     1050       define variable v-send as integer no-undo .
     1051       v-send = integer('0':U).
     1052   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1054     (input  g#db-num
     1055     ,input  'goods-attr':U
     1056     ,input  0
     1057     ,input  '':U
     1058     ,input  0
     1059     ,input  '':U
     1060     ,input  '':U
     1061     ,input  '':U
     1062     ,input  0
     1063     ,input  0
     1064     ,input  0
     1065     ,input  'nws-to-hist'
     1066     ,output v-send
     1067     ) no-error .
     1068     end.
     1069     if not g#news
     1070     or v-send >= 0 then do:
     1071       run cur-time in this-procedure(output v-date, output v-time).
     1072       create buf_c-goods-attr.
     1073       buffer-copy ub.goods-attr to buf_c-goods-attr
     1074       assign
     1075       buf_c-goods-attr.chip-num           = next-value (s-gds-chip, ub)
     1076       buf_c-goods-attr.corr-time          = v-time
     1077       buf_c-goods-attr.corr-user-db-num   = g#db-num
     1078       buf_c-goods-attr.corr-user-name     = (if g#news
     1079                                         then (chr(4) +  'СПН':U)
     1080                                         else (if g#esys
     1081                                               then (chr(4) +  'ВС':U)
     1082                                               else g#userid)
     1083                                         )
     1084       buf_c-goods-attr.corr-date          = v-date
     1085       .
     1086       create buf_c-gds-hist.
     1087       buffer-copy buf_c-goods-attr to buf_c-gds-hist
     1088       assign
     1089       buf_c-gds-hist.action = integer('99':U)
     1090       buf_c-gds-hist.subject = 'goods-attr':U
     1091       buf_c-gds-hist.is-news = g#news
     1092       buf_c-gds-hist.source-type = (if g#news
     1093                                     then 'db':U
     1094                                     else (if g#esys
     1095                                           then 'esys':U
     1096                                           else "":U)
     1097                                     )
     1098       buf_c-gds-hist.source-ref = (if g#news
     1099                                     then string(g#news-source-db)
     1100                                     else (if g#esys
     1101                                           then string(g#esys-source-esys)
     1102                                           else "":U)
     1103                                     )
     1104       .
     1105     end.
     1106         if    ub.goods-attr.attr-code eq "operservid"
     1107          or ub.goods-attr.attr-code eq "cashbookid"
     1108       then do:
     1109          if     ub.goods-attr.attr-value ne ""
     1110             and ub.goods-attr.attr-value ne ?
     1111          then do:
     1112             create buf_c-goods-attr-any.
     1113             buffer-copy goods-attr to buf_c-goods-attr-any
     1114             assign
     1115                buf_c-goods-attr-any.gds-code           = ub.goods-attr.gds-code
     1116                buf_c-goods-attr-any.Bush               = if ub.goods-attr.attr-code eq "operservid"
     1117                                                         then
     1118                                                            "operserv"
     1119                                                         else
     1120                                                            "cashbook"
     1121                buf_c-goods-attr-any.chip-num           = if ub.goods-attr.attr-code eq "operservid"
     1122                                                         then
     1123                                                            next-value (s-c-operserv-chip-num, ub)
     1124                                                         else
     1125                                                            next-value (s-c-cashbook-chip-num, ub)
     1126                buf_c-goods-attr-any.attr-code          = ub.goods-attr.attr-code
     1127                buf_c-goods-attr-any.corr-time          = v-time
     1128                buf_c-goods-attr-any.corr-user-db-num   = g#db-num
     1129                buf_c-goods-attr-any.corr-user-name     = (if g#news
     1130                                               then (chr(4) +  'СПН':U)
     1131                                               else (if g#esys
     1132                                                     then (chr(4) +  'ВС':U)
     1133                                                     else g#userid)
     1134                                               )
     1135                buf_c-goods-attr-any.corr-date          = v-date
     1136                buf_c-goods-attr-any.action             = 99
     1137             .
     1138             if ub.goods-attr.attr-code eq "cashbookid"
     1139             then do:
     1140                create c-cashbook-head.
     1141                buffer-copy  buf_c-goods-attr-any to c-cashbook-head
     1142                assign
     1143                   c-cashbook-head.subject = "c-goods-attr-any"
     1144                   c-cashbook-head.cashbookid     = int64(buf_c-goods-attr-any.attr-value)
     1145                   c-cashbook-head.is-news = g#news
     1146                   c-cashbook-head.source-type = (if g#news
     1147                                                  then 'db':U
     1148                                                  else (if g#esys
     1149                                                  then 'esys':U
     1150                                                  else "":U)
     1151                                                 )
     1152                   c-cashbook-head.source-ref = (if g#news
     1153                                                 then string(g#news-source-db)
     1154                                                 else (if g#esys
     1155                                                 then string(g#esys-source-esys)
     1156                                                 else "":U)
     1157                                                )
     1158                .
     1159             end.
     1160          end.
     1161       end.
     1162     run gds-attr-news in this-procedure(input ub.goods-attr.attr-code,
     1163                                         output p-news) no-error.
     1164     if p-news then do:
     1165       run nws/cmd-del.p
     1166         ( input 'goods-attr':U
     1167         ,input (buffer ub.goods-attr:handle)
     1168         ,input "":U
     1169         ) no-error .
     1170       if error-status :error then do:
     1171         undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
     1172       end.
     1173     end.
     1174     if g#oxml = yes
     1175     then do:
     1176       run str/calloxml.p (
     1177             input 'delete':U
     1178           , input 'goods-attr':U
     1179           , input ( buffer ub.goods-attr:handle )
     1180       ) no-error.
     1181       if error-status :error
     1182       then do:
     1183           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
     1184                               , chr(10)
     1185                               , vss-workfile
     1186                               , return-value
     1187                               , error-status :get-message ( 1 ) ).
     1188       end.
     1189     end.
     1190   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   define variable send-ref as logical no-undo.
     1192   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1193     (input  'send-ref'
     1194     ,input  0
     1195     ,input  ''
     1196     ,input  0
     1197     ,input  ''
     1198     ,input  ''
     1199     ,input  ''
     1200     ,input  no
     1201     ,output conf-par
     1202     ,output par-type
     1203     ) no-error .
     1204     send-ref = (IF error-status:error or conf-par <> "yes" then no else yes).
     1205       if send-ref  then do:
     1206          run gds-attr-name in this-procedure (
     1207                                               input  ub.goods-attr.attr-code
     1208                                               ,output v-type
     1209                                               ,output v-format
     1210                                               ,output v-label
     1211                                               ,output v-user-can-edit
     1212                                               ,output v-output-display
     1213                                               ,output v-other
     1214           ) .
     1215          _do:
     1216          do jj = 1 to num-entries(v-other, chr(47)):
     1217            if entry(jj, v-other, chr(47)) = "" then NEXT _do.
     1218            assign
     1219            v-dop1 = entry(1, entry(jj, v-other, chr(47)), '=':U) no-error .
     1220            v-dop2 = entry(2, entry(jj, v-other, chr(47)), '=':U) no-error .
     1221            if v-dop1 = "cd":U then do:
     1222              run trg/nu_gds.p (
     1223                             input  ub.goods-attr.gds-code
     1224                             ,input  0
     1225                             ,input ""
     1226                             ,input  0
     1227                             ,input  "U":U
     1228                           ).
     1229              sendGoods2Kassa = true.
     1230              NEXT _do.
     1231            end.
     1232          end.
     1233          if sendGoods2Kassa then
     1234          run str/diallog.w ( this-procedure
     1235              , this-procedure
     1236              , 'str/sendalcd.p':U
     1237              , ('yes' + chr(4) +
     1238                 'no' + chr(4) +
     1239                 'no' + chr(4) +
     1240                 'no' + chr(4)  +
     1241                 'no' + chr(4)
     1242                 )
     1243              , yes
     1244              , 'Прервать':U
     1245              , 'Отправка информации на кассу') no-error .
     1246       end.
     1247   end.
