      502     define variable vss-description as character no-undo initial "clntattr-get-archive-by-type-01: возвращает список атрибутов для складского архива".
      503     do
      504     on error undo, return error return-value
      505     :
      506           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-get-archive-by-type in g#attr-lib
      507         (input  p-archive-type
      508         ,output p-archive-attr-list
      509         ) no-error .
      510       if error-status :error
      511       then do:
      512         undo, return error return-value .
      513       end.
      514     end.
      515   end procedure.
      516   procedure clntattr-vat-register :
