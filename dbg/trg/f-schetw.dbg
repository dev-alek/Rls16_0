      588   define variable v-date as date      no-undo .
      589   define variable v-time as integer   no-undo .
      590   define variable v-cmp  as character no-undo .
      591   define buffer buf_c-fin-schet for ub.c-fin-schet.
      592   define buffer buf_sysconf     for ub.sysconf.
      593   define variable v-value as character no-undo.
      594   define variable v-ttype as character no-undo.
      595   main-block:
      596   do
      597     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      598     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      599     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      600     :
      601     if not g#news then
      602     do:
      603       run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-ttype) no-error.
      604       if v-value = "no"  then
      605       do:
      606         find first buf_sysconf no-lock where
      607           buf_sysconf.host-code = ub.fin-schet.host-code.
      608         if buf_sysconf.firm-db-num <> g#db-num then
      609         do:
      610           message
      611             vss-workfile vss-revision vss-description skip
      612             "Нельзя изменять запись СЧЕТА в БД, отличной от главной БД фирмы" skip
      613             "Номер текущей БД" g#db-num "Номер главной БД фирмы" buf_sysconf.firm-db-num
      614             view-as alert-box error .
      615           undo main-block, return error .
      616         end.
      617       end.
      618     end.
      619     buffer-compare old_fin-schet
      620       to ub.fin-schet
      621       case-sensitive
      622       save result in v-cmp
      623       .
      624     if not g#news and v-cmp <> "":U then
      625     do:
      626       run cur-time in this-procedure(output v-date, output v-time).
      627       create buf_c-fin-schet.
      628       buffer-copy old_fin-schet to buf_c-fin-schet
      629         assign
      630         buf_c-fin-schet.host-code         =  ub.fin-schet.host-code
      631         buf_c-fin-schet.code-schet         = ub.fin-schet.code-schet
      632         buf_c-fin-schet.chip-num           = next-value (s-corr-chip, ub)
      633         buf_c-fin-schet.corr-time          = v-time
      634         buf_c-fin-schet.corr-user-db-num   = g#db-num
      635         buf_c-fin-schet.corr-user-name     = g#userid
      636         buf_c-fin-schet.corr-date          = v-date
      637         .
      638     end.
      639     if v-cmp <> "":U then
      640       run str/callnews.p
      641         (input "fin-schet"
      642         ,input (buffer ub.fin-schet:handle)
      643         ).
      644     if g#oxml = yes
      645       then
      646     do:
      647       run str/calloxml.p (
      648         input 'update':U
      649         , input 'fin-schet':U
      650         , input ( buffer ub.fin-schet:handle )
      651         ) no-error.
      652       if error-status :error
      653         then
      654       do:
      655         undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      656           , chr(10)
      657           , vss-workfile
      658           , return-value
      659           , error-status :get-message ( 1 ) ).
      660       end.
      661     end.
      662   end.
