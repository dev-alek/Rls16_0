        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.bar-code-obj-attr.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление атрибутов бар-кода по обьъектам".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4':u                              ,ub.bar-code-obj-attr.obj-type                              ,ub.bar-code-obj-attr.obj-code                              ,ub.bar-code-obj-attr.b-code                              ,ub.bar-code-obj-attr.attr-code                              )
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   define new global shared variable g#lib-nws as handle no-undo .
      309   procedure bc-attrh_write-bar-code-obj-attr-trigger :
      310   define input parameter p-new-record as logical no-undo .
      311   define input parameter p-action as integer no-undo .
      312   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      313   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      314   define variable v-date as date      no-undo.
      315   define variable v-time  as integer   no-undo.
      316   define variable v-host-code as integer no-undo .
      317   define buffer buf_c-gds-hist for ub.c-gds-hist.
      318   define buffer buf_c-bar-code-obj-attr for ub.c-bar-code-obj-attr.
      319     do
      320     on error undo, return error
      321     :
      322       if g#news then do:
      323         define variable v-send as integer no-undo .
      324         v-send = integer('0':U).
      325   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      327     (input  g#db-num
      328     ,input  'bar-code-obj-attr':U
      329     ,input  0
      330     ,input  '':U
      331     ,input  0
      332     ,input  '':U
      333     ,input  '':U
      334     ,input  '':U
      335     ,input  0
      336     ,input  0
      337     ,input  0
      338     ,input  'nws-to-hist'
      339     ,output v-send
      340     ) no-error .
      341         if v-send < 0 then return.
      342       end.
      343       run cur-time in this-procedure ( output v-date, output v-time).
      344       if ub.bar-code-obj-attr.obj-type = 'маг':U
      345       or ub.bar-code-obj-attr.obj-type = 'скл':U then do:
      346   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      348     (input  ub.bar-code-obj-attr.obj-type
      349     ,input  ub.bar-code-obj-attr.obj-code
      350     ,output v-host-code
      351     )  .
      352       end.
      353       create buf_c-bar-code-obj-attr.
      354       buffer-copy ub.bar-code-obj-attr to buf_c-bar-code-obj-attr
      355       assign
      356       buf_c-bar-code-obj-attr.gds-code           = (if p-new-record then ub.bar-code-obj-attr.gds-code else ub.bar-code-obj-attr.gds-code)
      357       buf_c-bar-code-obj-attr.b-code             = (if p-new-record then ub.bar-code-obj-attr.b-code else ub.bar-code-obj-attr.b-code)
      358       buf_c-bar-code-obj-attr.attr-code          = (if p-new-record then ub.bar-code-obj-attr.attr-code else ub.bar-code-obj-attr.attr-code)
      359       buf_c-bar-code-obj-attr.obj-type           = (if p-new-record then ub.bar-code-obj-attr.obj-type else ub.bar-code-obj-attr.obj-type)
      360       buf_c-bar-code-obj-attr.obj-code           = (if p-new-record then ub.bar-code-obj-attr.obj-code else ub.bar-code-obj-attr.obj-code)
      361       buf_c-bar-code-obj-attr.chip-num           = next-value (s-gds-chip, ub)
      362       buf_c-bar-code-obj-attr.corr-time          = v-time
      363       buf_c-bar-code-obj-attr.corr-user-db-num   = g#db-num
      364       buf_c-bar-code-obj-attr.corr-user-name     = (if g#news
      365                                            then (chr(4) +  'СПН':U)
      366                                            else (if g#esys
      367                                                  then (chr(4) +  'ВС':U)
      368                                                  else g#userid)
      369                                           )
      370       buf_c-bar-code-obj-attr.corr-date          = v-date
      371       .
      372       create buf_c-gds-hist.
      373       buffer-copy buf_c-bar-code-obj-attr to buf_c-gds-hist
      374       assign
      375       buf_c-gds-hist.gds-code           = buf_c-bar-code-obj-attr.gds-code
      376       buf_c-gds-hist.action = (if p-new-record
      377                                 then integer('1':U)
      378                                 else (if ub.bar-code-obj-attr.gds-code = ub.bar-code-obj-attr.gds-code
      379                                       and ub.bar-code-obj-attr.b-code  = ub.bar-code-obj-attr.b-code
      380                                       then p-action
      381                                       else integer('9':U))
      382                               )
      383       buf_c-gds-hist.b-code             = (if buf_c-gds-hist.action = integer('9':U)
      384                                           and ub.bar-code-obj-attr.b-code  <>  ub.bar-code-obj-attr.b-code
      385                                           then ub.bar-code-obj-attr.b-code
      386                                           else ub.bar-code-obj-attr.b-code)
      387       buf_c-gds-hist.subject = 'bar-code-obj-attr':U
      388       buf_c-gds-hist.host-code = v-host-code
      389       buf_c-gds-hist.is-news = g#news
      390       buf_c-gds-hist.source-type = (if g#news
      391                                     then 'db':U
      392                                     else (if g#esys
      393                                           then 'esys':U
      394                                           else "":U)
      395                                     )
      396       buf_c-gds-hist.source-ref = (if g#news
      397                                    then string(g#news-source-db)
      398                                    else (if g#esys
      399                                          then string(g#esys-source-esys)
      400                                          else "":U)
      401                                    )
      402       .
      403       if p-action = integer('99':U) then do:
      404         if
      405         not g#news
      406         OR (g#news
      407             and not ( g#db-num > 0 )
      408             and buf_c-bar-code-obj-attr.corr-user-name <> (chr(4) +  'СПН':U)
      409             )
      410         or (g#news
      411             and ( g#db-num > 0 )
      412             and buf_c-bar-code-obj-attr.corr-user-name = (chr(4) +  'СПН':U)
      413             )
      414         then
      415         run str/callnews.p
      416           (input 'c-bar-code-obj-attr':U
      417           ,input (buffer buf_c-bar-code-obj-attr:handle)
      418           ).
      419       end.
      420     end.
      421   end procedure.
      422   main-block:
      423   do
      424   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      425   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      426   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      427   :
      428     run bc-attrh_write-bar-code-obj-attr-trigger in this-procedure  (
      429                                           input no
      430                                           ,input integer('99':U)
      431                                           ,input (if g#news
      432                                                   then 'db':U
      433                                                   else (if g#esys
      434                                                         then 'esys':U
      435                                                         else "":U)
      436                                                   )
      437                                           ,input (if g#news
      438                                                   then string(g#news-source-db)
      439                                                   else (if g#esys
      440                                                         then string(g#esys-source-esys)
      441                                                         else "")
      442                                                   )
      443                                         ) .
      444     run nws/cmd-del.p
      445       ( input 'bar-code-obj-attr':U
      446         ,input (buffer ub.bar-code-attr:handle)
      447         ,input "":U
      448       ) no-error .
      449     if error-status :error then do:
      450       undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      451     end.
      452     if g#oxml = yes
      453     then do:
      454       run str/calloxml.p (
      455             input 'delete':U
      456           , input 'bar-code-obj-attr':U
      457           , input ( buffer ub.bar-code-obj-attr:handle )
      458       ) no-error.
      459       if error-status :error
      460       then do:
      461           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      462                               , chr(10)
      463                               , vss-workfile
      464                               , return-value
      465                               , error-status :get-message ( 1 ) ).
      466       end.
      467     end.
      468   end.
