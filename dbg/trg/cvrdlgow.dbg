        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-varianty-delivery-gds-obj.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись в таблице ИСТОРИЯ ВАРИАНТОВ ДОСТАВКИ ДЛЯ ТОВАРА НА ОБЪЕКТЕ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7'
       29                                          , ub.c-varianty-delivery-gds-obj.gds-code
       30                                          , ub.c-varianty-delivery-gds-obj.obj-type
       31                                          , ub.c-varianty-delivery-gds-obj.obj-code
       32                                          , ub.c-varianty-delivery-gds-obj.deliv-type-code
       33                                          , ub.c-varianty-delivery-gds-obj.deliv-subj-code
       34                                          , ub.c-varianty-delivery-gds-obj.corr-user-db-num
       35                                          , ub.c-varianty-delivery-gds-obj.chip-num
       36                                           )
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable v-db-num like ub.db.db-num no-undo .
       90   define buffer buf_clients for ub.clients.
       91   define buffer buf_varianty-delivery-gds-obj for ub.varianty-delivery-gds-obj.
       92   define buffer buf_group-period-validity  for ub.group-period-validity.
       93   define buffer buf_var-deliv-gr-per-val for ub.var-deliv-gr-per-val.
       94   define buffer buf_deliv-type-cond-keep for ub.deliv-type-cond-keep.
       95   define buffer buf_goods for ub.goods.
       96   main-block:
       97   do
       98   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       99   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      100   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      101   :
      102     if not g#news then do:
      103       find first buf_goods no-lock where
      104                  buf_goods.gds-code = ub.c-varianty-delivery-gds-obj.gds-code  no-error .
      105       if not available buf_goods then do:
      106         message
      107         vss-workfile vss-revision vss-description skip
      108         "Неправильная ссылка на ТОВАР" skip
      109         "код товара" ub.c-varianty-delivery-gds-obj.gds-code skip
      110          view-as alert-box error .
      111         undo main-block, return error.
      112       end.
      113       find first buf_clients no-lock where
      114                  buf_clients.obj-type = c-varianty-delivery-gds-obj.obj-type
      115              AND buf_clients.obj-code = c-varianty-delivery-gds-obj.obj-code
      116                  no-error .
      117       if not available buf_clients then do:
      118         message
      119         vss-workfile vss-revision vss-description skip
      120         "Неправильная ссылка на ОБЪЕКТ ДОСТАВКИ" skip
      121         "тип" c-varianty-delivery-gds-obj.obj-type    skip
      122         "код" c-varianty-delivery-gds-obj.obj-code   skip
      123          view-as alert-box error .
      124         undo main-block, return error.
      125       end.
      126       find first buf_deliv-type-cond-keep no-lock where
      127                  buf_deliv-type-cond-keep.deliv-type-code = ub.c-varianty-delivery-gds-obj.deliv-type-code
      128              AND buf_deliv-type-cond-keep.cond-keep-code  = ub.c-varianty-delivery-gds-obj.cond-keep-code
      129                  no-error .
      130       if not available buf_deliv-type-cond-keep then do:
      131         message
      132         vss-workfile vss-revision vss-description skip
      133         "Неправильная ссылка на ТИП ДОСТАВКИ ПО УСЛОВИЯ ХРАНЕНИЯ" skip
      134         "код типа доставки" ub.c-varianty-delivery-gds-obj.deliv-type-code skip
      135         "код условий хранения" ub.c-varianty-delivery-gds-obj.cond-keep-code skip
      136          view-as alert-box error .
      137         undo main-block, return error.
      138       end.
      139       find first buf_var-deliv-gr-per-val no-lock where
      140                  buf_var-deliv-gr-per-val.deliv-type-code = ub.c-varianty-delivery-gds-obj.deliv-type-code
      141              AND buf_var-deliv-gr-per-val.deliv-subj-code = ub.c-varianty-delivery-gds-obj.deliv-subj-code
      142              AND buf_var-deliv-gr-per-val.obj-type        = ub.c-varianty-delivery-gds-obj.obj-type
      143              AND buf_var-deliv-gr-per-val.obj-code        = ub.c-varianty-delivery-gds-obj.obj-code
      144              AND buf_var-deliv-gr-per-val.gr-per-val-code = ub.c-varianty-delivery-gds-obj.gr-per-val-code
      145                  no-error .
      146       if not available buf_var-deliv-gr-per-val then do:
      147         message
      148         vss-workfile vss-revision vss-description skip
      149         "Неправильная ссылка на ВАРИАНТ ДОСТАВКИ ПО ГРУППЕ СРОКОВ ГОДНОСТИ" skip
      150         "код типа доставки" ub.c-varianty-delivery-gds-obj.deliv-type-code skip
      151         "код субъекта доставки" ub.c-varianty-delivery-gds-obj.deliv-subj-code skip
      152         "тип объекта доставки" ub.c-varianty-delivery-gds-obj.obj-type    skip
      153         "код объекта доставки" ub.c-varianty-delivery-gds-obj.obj-code   skip
      154         "код группы сроков годности" ub.c-varianty-delivery-gds-obj.gr-per-val-code   skip
      155          view-as alert-box error .
      156         undo main-block, return error.
      157       end.
      158       find first buf_varianty-delivery-gds-obj no-lock where
      159                  buf_varianty-delivery-gds-obj.gds-code        = c-varianty-delivery-gds-obj.gds-code
      160              AND buf_varianty-delivery-gds-obj.obj-type        = c-varianty-delivery-gds-obj.obj-type
      161              AND buf_varianty-delivery-gds-obj.obj-code        = c-varianty-delivery-gds-obj.obj-code
      162              AND buf_varianty-delivery-gds-obj.deliv-type-code = c-varianty-delivery-gds-obj.deliv-type-code
      163              AND buf_varianty-delivery-gds-obj.deliv-subj-code = c-varianty-delivery-gds-obj.deliv-subj-code
      164                  no-error .
      165       if not available buf_varianty-delivery-gds-obj then do:
      166         message
      167         vss-workfile vss-revision vss-description skip
      168         "Неправильная ссылка на ВАРИАНТ ДОСТАВКИ ДЛЯ ТОВАРА НА ОБЪЕКТЕ" skip
      169         "код товара" c-varianty-delivery-gds-obj.gds-code skip
      170         "код типа доставки" c-varianty-delivery-gds-obj.deliv-type-code skip
      171         "код субъекта доставки" c-varianty-delivery-gds-obj.deliv-subj-code skip
      172         "тип объекта доставки" c-varianty-delivery-gds-obj.obj-type    skip
      173         "код объекта доставки" c-varianty-delivery-gds-obj.obj-code   skip
      174          view-as alert-box error .
      175         undo main-block, return error.
      176       end.
      177     end.
      178     if not g#news then do:
      179   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      181     (input  ub.c-varianty-delivery-gds-obj.obj-type
      182     ,input  ub.c-varianty-delivery-gds-obj.obj-code
      183     ,output v-db-num
      184     )  .
      185       if g#db-num <> v-db-num then do:
      186         message
      187         vss-workfile vss-revision vss-description skip
      188         "Нельзя создавать записи истории ВАРИАНТА ДОСТАВКИ ДЛЯ ТОВАРА НА ОБЪЕТКЕ для объекта другой БД" skip
      189         view-as alert-box error .
      190         undo main-block, return error.
      191       end.
      192     end.
      193   if
      194     not g#news
      195     OR (g#news
      196         and not ( g#db-num > 0 )
      197         and ub.c-varianty-delivery-gds-obj.corr-user-name <> (chr(4) +  'СПН':U)
      198         )
      199     or (g#news
      200         and ( g#db-num > 0 )
      201         and ub.c-varianty-delivery-gds-obj.corr-user-name = (chr(4) +  'СПН':U)
      202         )
      203     then
      204     run str/callnews.p
      205       (input "c-varianty-delivery-gds-obj"
      206       ,input (buffer ub.c-varianty-delivery-gds-obj:handle)
      207       ).
      208       if g#oxml = yes
      209       then do:
      210       run str/calloxml.p (
      211             input 'update':U
      212           , input 'c-varianty-delivery-gds-obj':U
      213           , input ( buffer ub.c-varianty-delivery-gds-obj:handle )
      214       ) no-error.
      215       if error-status :error
      216       then do:
      217           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      218                                , chr(10)
      219                                , vss-workfile
      220                                , return-value
      221                                , error-status :get-message ( 1 ) ).
      222       end.
      223       end.
      224   end.
