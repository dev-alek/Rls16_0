      505           else do:
      506             v-db-list = '':U.
      507           end.
      508           run nws/cmd-del.p
      509             ( input 'dis-dc-rule':U
      510             ,input (buffer ub.dis-dc-rule:handle)
      511             ,input v-db-list
      512             ) no-error .
      513           if error-status :error then do:
      514             undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      515           end.
      516         end.
      517       end.
      518     end.
      519     if g#oxml = yes
      520     then do:
      521       run str/calloxml.p (
      522             input 'delete':U
      523           , input 'dis-dc-rule':U
      524           , input ( buffer ub.dis-dc-rule:handle )
      525       ) no-error.
      526       if error-status :error
      527       then do:
      528           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      529                                , chr(10)
      530                                , vss-workfile
      531                                , return-value
      532                                , error-status :get-message ( 1 ) ).
      533       end.
      534     end.
      535   end.
