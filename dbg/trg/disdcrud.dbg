        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.dis-dc-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление СКИДКИ по ДК ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8'
       29                            , ub.dis-dc-rule.d-card
       30                           , ub.dis-dc-rule.host-code
       31                           , ub.dis-dc-rule.obj-type
       32                           , ub.dis-dc-rule.obj-code
       33                           , ub.dis-dc-rule.pos-type
       34                           , ub.dis-dc-rule.discnt-role
       35                           , ub.dis-dc-rule.nonunique
       36                            )
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure disdcruh_write-dis-dc-rule-proc :
       91   define input parameter p-d-card      like ub.c-dis-dc-rule.d-card no-undo .
       92   define input parameter p-card-num    like ub.c-dis-dc-rule.card-num no-undo .
       93   define input parameter p-host-code   like ub.c-dis-dc-rule.host-code no-undo .
       94   define input parameter p-obj-type    like ub.c-dis-dc-rule.obj-type  no-undo .
       95   define input parameter p-obj-code    like ub.c-dis-dc-rule.obj-code  no-undo .
       96   define input parameter p-pos-type    like ub.c-dis-dc-rule.pos-type  no-undo .
       97   define input parameter p-discnt-role  like ub.c-dis-dc-rule.discnt-role no-undo .
       98   define input parameter p-nonunique   like ub.c-dis-dc-rule.nonunique no-undo .
       99   define input parameter p-action      as integer no-undo .
      100   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      101   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      102   define variable v-date as date      no-undo.
      103   define variable v-time  as integer   no-undo.
      104   define buffer buf_c-dc-hist for ub.c-dc-hist.
      105   define buffer buf_c-dis-dc-rule for ub.c-dis-dc-rule.
      106     do
      107     on error undo, return error
      108     :
      109       run cur-time in this-procedure(output v-date, output v-time).
      110       create buf_c-dis-dc-rule.
      111       assign
      112       buf_c-dis-dc-rule.d-card             = p-d-card
      113       buf_c-dis-dc-rule.card-num           = p-card-num
      114       buf_c-dis-dc-rule.obj-type           = p-obj-type
      115       buf_c-dis-dc-rule.obj-code           = p-obj-code
      116       buf_c-dis-dc-rule.host-code          = p-host-code
      117       buf_c-dis-dc-rule.pos-type           = p-pos-type
      118       buf_c-dis-dc-rule.discnt-role        = p-discnt-role
      119       buf_c-dis-dc-rule.nonunique          = p-nonunique
      120       buf_c-dis-dc-rule.chip-num           = next-value (s-dc-chip, ub)
      121       buf_c-dis-dc-rule.corr-time          = v-time
      122       buf_c-dis-dc-rule.corr-user-db-num   = g#db-num
      123       buf_c-dis-dc-rule.corr-user-name     = (if g#news
      124                                               then (chr(4) +  'СПН':U)
      125                                               else (if g#esys
      126                                                    then (chr(4) +  'ВС':U)
      127                                                    else g#userid
      128                                                    )
      129                                               )
      130       buf_c-dis-dc-rule.corr-date          = v-date
      131       .
      132       create buf_c-dc-hist.
      133       buffer-copy buf_c-dis-dc-rule to buf_c-dc-hist
      134       assign
      135       buf_c-dc-hist.action = p-action
      136       buf_c-dc-hist.subject = 'dis-dc-rule':U
      137       buf_c-dc-hist.is-news  = g#news
      138       buf_c-dc-hist.source-type = p-source-type
      139       buf_c-dc-hist.source-ref =  p-source-ref
      140       .
      141     end.
      142   end procedure.
      143   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   procedure cur-time :
      145      define output parameter p-today as date      no-undo .
      146      define output parameter p-time  as integer   no-undo .
      147     do
      148     on error undo, return error
      149     :
      150       define variable v-date1 as date      no-undo .
      151       define variable v-date2 as date      no-undo .
      152       define variable v-time  as integer   no-undo .
      153       assign
      154         v-date1 = today
      155         v-time  = time
      156         v-date2 = today
      157       .
      158       if v-date1 <> v-date2
      159       then do:
      160         assign
      161           v-date1 = today
      162           v-time  = v-time
      163         .
      164       end.
      165       assign
      166         p-today = v-date1
      167         p-time  = v-time
      168       .
      169     end.
      170   end.
      171   function cur-time-date returns character
      172   :
      173     return string(today, '99/99/9999':U) .
      174   end.
      175   function cur-time-mjd returns decimal
      176   :
      177     define variable v-date as date      no-undo .
      178     define variable v-time as integer   no-undo .
      179     run cur-time in this-procedure
      180       (output v-date
      181       ,output v-time
      182       ) .
      183     return integer(v-date) - 2400002 + (v-time / 86400) .
      184   end.
      185   function cur-time-get-ending-index returns integer
      186   (input p-number as integer
      187   )
      188   :
      189     if p-number < 0
      190     or p-number = ?
      191     then do:
      192       return 1 .
      193     end.
      194     define variable v-rest as integer   no-undo .
      195     assign
      196       p-number = p-number modulo 100
      197     .
      198     if p-number < 20
      199     then do:
      200       assign
      201         v-rest = p-number
      202       .
      203     end.
      204     else do:
      205       assign
      206         v-rest = p-number modulo 10
      207       .
      208     end.
      209     case v-rest :
      210       when 1
      211       then do:
      212         return 2 .
      213       end.
      214       when 2 or
      215       when 3 or
      216       when 4
      217       then do:
      218         return 3 .
      219       end.
      220       otherwise do:
      221         return 1 .
      222       end.
      223     end case .
      224   end.
      225   procedure cur-time-mjd-to-date :
      226      define input  parameter i-mjd-diff as decimal no-undo.
      227      define output parameter o-Date     as date    no-undo.
      228      define output parameter o-Time     as integer no-undo.
      229      define variable v-day-number as integer   no-undo .
      230      if    i-mjd-diff < 0
      231         or i-mjd-diff = ?
      232      then do:
      233         return "?" .
      234      end.
      235      assign
      236         v-day-number = truncate(i-mjd-diff,0).
      237         o-Date = date(v-day-number + 2400002).
      238         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240   end.
      241   function cur-time-mjd-to-string returns character
      242   (input p-mjd-diff as decimal
      243   )
      244   :
      245     define variable v-day-number as integer   no-undo .
      246     define variable v-seconds    as integer   no-undo .
      247     define variable v-hour       as integer   no-undo .
      248     define variable v-min        as integer   no-undo .
      249     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      250     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      251     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      252     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      253     if p-mjd-diff < 0
      254     or p-mjd-diff = ?
      255     then do:
      256       return "?" .
      257     end.
      258     assign
      259       v-day-number = integer(truncate(p-mjd-diff,0))
      260       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      261     .
      262     if v-seconds > 86400
      263     then do:
      264       assign
      265         v-seconds = 86400 - 1
      266       .
      267     end.
      268     if v-seconds < 0
      269     then do:
      270       assign
      271         v-seconds = 0
      272       .
      273     end.
      274     assign
      275       v-hour = truncate(v-seconds / 3600, 0)
      276     .
      277     assign
      278       v-seconds = v-seconds modulo 3600
      279     .
      280     assign
      281       v-min = truncate(v-seconds / 60, 0)
      282     .
      283     assign
      284       v-seconds = v-seconds modulo 60
      285     .
      286     return
      287         (if v-day-number <> 0
      288           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      289           else ""
      290         )
      291       + (if v-day-number <> 0 or v-hour <> 0
      292           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      293           else ""
      294         )
      295       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      296           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      297           else ""
      298         )
      299       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      300       .
      301   end.
      302   function cur-time-string returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      311   end.
      312   function cur-time-string-sec returns character
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      321   end.
      322   function cur-time-custom  returns character
      323   (input p-prefix as character
      324   ,input p-date-format as character
      325   ,input p-delimiter as character
      326   ,input p-time-format as character
      327   ,input p-suffix as character
      328   )
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return
      337       p-prefix
      338       + string(v-date, p-date-format)
      339       + p-delimiter
      340       + string(v-time, p-time-format)
      341       + p-suffix
      342       .
      343   end.
      344   function cur-time-print  returns character
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      353   end.
      354   function cur-time-datetime returns datetime
      355   :
      356     define variable v-char as character no-undo .
      357     define variable v-datetime as datetime no-undo .
      358     v-char = cur-time-string().
      359     v-datetime = datetime(v-char).
      360     return  v-datetime.
      361   end.
      362   function cur-time-string-msec returns character
      363   :
      364     define variable v-date as datetime  no-undo .
      365     v-date = now.
      366     return string(v-date) .
      367   end.
      368   define variable conf-par as character no-undo .
      369   define variable par-type as character no-undo .
      370   define variable v-type           as character no-undo .
      371   define variable v-format         as character no-undo .
      372   define variable v-label          as character no-undo .
      373   define variable v-tooltip        as character no-undo .
      374   define variable v-range          as integer   no-undo .
      375   define variable v-user-can-edit  as logical   no-undo .
      376   define variable v-output-display as logical   no-undo .
      377   define variable v-other          as character no-undo .
      378   define variable jj as integer no-undo .
      379   define variable v-dop1 as character no-undo .
      380   define variable v-dop2 as character no-undo .
      381   define variable v-date as date no-undo .
      382   define variable v-time as integer no-undo .
      383   define variable v-host-code like ub.sysconf.host-code no-undo .
      384   define variable v-db-list as character no-undo .
      385   define variable v-news as logical no-undo .
      386   define variable v-obj-db-num like ub.db.db-num no-undo .
      387   define variable v-manual-editing as integer no-undo .
      388   define buffer buf_c-dis-dc-rule for ub.c-dis-dc-rule.
      389   define buffer buf_c-dc-hist for ub.c-dc-hist.
      390   define buffer new_dis-dc-rule  for ub.dis-dc-rule.
      391   define buffer locked_dis-dc-rule for ub.dis-dc-rule.
      392   main-block:
      393   do
      394   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      395   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      396   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      397   :
      398     if not (     ub.dis-dc-rule.obj-type  = '':U
      399             and ub.dis-dc-rule.obj-code  = 0
      400             and ub.dis-dc-rule.host-code = 0
      401             and ub.dis-dc-rule.pos-type = '':U
      402             and ub.dis-dc-rule.discnt-role = '':U
      403             and ub.dis-dc-rule.nonunique = '')
      404      then do:
      405         Find first locked_dis-dc-rule exclusive-lock  where
      406                 locked_dis-dc-rule.d-card    = ub.dis-dc-rule.d-card
      407             AND locked_dis-dc-rule.obj-type  = '':U
      408             AND locked_dis-dc-rule.obj-code  = 0
      409             AND locked_dis-dc-rule.host-code = 0
      410             and locked_dis-dc-rule.pos-type = '':U
      411             and locked_dis-dc-rule.discnt-role = '':U
      412             and locked_dis-dc-rule.nonunique = '':U
      413             no-error no-wait.
      414       if locked locked_dis-dc-rule then do:
      415         undo main-block, return error substitute("Скидка по ДК: карта &1 занята"
      416                                                  , ub.dis-dc-rule.d-card
      417                                                  ).
      418       end.
      419       if ub.dis-dc-rule.card-num >= 0 then do:
      420   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   define variable send-ref as logical no-undo.
      422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      423     (input  'send-ref'
      424     ,input  0
      425     ,input  ''
      426     ,input  0
      427     ,input  ''
      428     ,input  ''
      429     ,input  ''
      430     ,input  no
      431     ,output conf-par
      432     ,output par-type
      433     ) no-error .
      434     send-ref = (IF error-status:error or conf-par <> "yes" then no else yes).
      435         if send-ref then do:
      436           run trg/nu_dcard.p (
      437                         input  ub.dis-dc-rule.d-card
      438                         ,input  ub.dis-dc-rule.host-code
      439                         ,input  "":U
      440                         ,input  0
      441                         ,input  "U":U
      442                       ).
