      444         run cur-time in this-procedure(output v-date, output v-time).
      445         create buf_c-dis-dc-rule.
      446         buffer-copy ub.dis-dc-rule to buf_c-dis-dc-rule
      447         assign
      448         buf_c-dis-dc-rule.d-card             = ub.dis-dc-rule.d-card
      449         buf_c-dis-dc-rule.obj-type           = ub.dis-dc-rule.obj-type
      450         buf_c-dis-dc-rule.obj-code           = ub.dis-dc-rule.obj-code
      451         buf_c-dis-dc-rule.host-code          = ub.dis-dc-rule.host-code
      452         buf_c-dis-dc-rule.pos-type           = ub.dis-dc-rule.pos-type
      453         buf_c-dis-dc-rule.discnt-role        = ub.dis-dc-rule.discnt-role
      454         buf_c-dis-dc-rule.nonunique          = ub.dis-dc-rule.nonunique
      455         buf_c-dis-dc-rule.chip-num           = next-value (s-dc-chip, ub)
      456         buf_c-dis-dc-rule.corr-time          = v-time
      457         buf_c-dis-dc-rule.corr-user-db-num   = g#db-num
      458         buf_c-dis-dc-rule.corr-user-name     = (if g#news
      459                                                 then (chr(4) +  'СПН':U)
      460                                                 else (if g#esys
      461                                                       then (chr(4) +  'ВС':U)
      462                                                       else g#userid
      463                                                       )
      464                                                 )
      465         buf_c-dis-dc-rule.corr-date          = v-date
      466         .
      467         create buf_c-dc-hist.
      468         buffer-copy buf_c-dis-dc-rule to buf_c-dc-hist
      469         assign
      470         buf_c-dc-hist.action = integer('99':U)
