        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.contract .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись договора".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3', ub.contract.contract-code, ub.contract.host-code, ub.contract.status_)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure gen-b-code :
       83     define input  parameter type-code like ub.code-range.range-type no-undo .
       84     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
       85     do
       86     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       87     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
       88     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
       89     :
       90       define buffer buf_thbj-attr     for ub.thbj-attr .
       91       define buffer buf_sys-ctrl   for ub.sys-ctrl .
       92       define buffer buf_code-range for ub.code-range .
       93       define variable l-code         as   integer              no-undo .
       94       define variable v-db-num       like ub.db.db-num         no-undo .
       95       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
       96       if type-code = 'sslc':U
       97       or type-code = 'ssgb':U
       98       then do:
       99         message
      100           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      101           "Обратитесь к администратору системы."
      102           view-as alert-box error .
      103         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      104       end.
      105       run trg/getpcode.p ( input  type-code
      106                      ,output cfg-param-code
      107                     ).
      108       run get-next-seq( input  type-code,
      109                         output l-code
      110                       ).
      111       find first buf_sys-ctrl no-lock.
      112       if type-code = 'sclc':U
      113       or type-code = 'pglc':U
      114       then do:
      115         assign
      116           v-db-num = 0
      117         .
      118       end.
      119       else do:
      120         assign
      121           v-db-num = buf_sys-ctrl.db-num
      122         .
      123       end.
      124       find first buf_code-range no-lock
      125         where buf_code-range.db-num     = v-db-num
      126           and buf_code-range.range-type = type-code
      127           and buf_code-range.stts       = "a"
      128         use-index stts
      129         no-error .
      130       if available buf_code-range
      131          and l-code <= buf_code-range.last-code
      132          and l-code >= buf_code-range.first-code then do:
      133         assign
      134           p-b-code = l-code
      135         .
      136       end.
      137       else do:
      138         if available buf_code-range
      139            and l-code < buf_code-range.last-code then do:
      140           message
      141             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      142             "Обратитесь к администратору системы."
      143             view-as alert-box error .
      144           undo, return error "sequence":U .
      145         end.
      146         do transaction
      147         on error undo, return error
      148         :
      149           find first buf_thbj-attr exclusive-lock
      150             where buf_thbj-attr.upper-prop-code = 'code-range':U
      151               and buf_thbj-attr.prop-code = cfg-param-code
      152               and buf_thbj-attr.obj-type   = 'БД':U
      153               and buf_thbj-attr.obj-code   = v-db-num
      154             no-error .
      155           if not available buf_thbj-attr then do:
      156             find first buf_thbj-attr exclusive-lock
      157               where buf_thbj-attr.upper-prop-code = 'code-range':U
      158                 and buf_thbj-attr.prop-code = cfg-param-code
      159                 and buf_thbj-attr.obj-type   = ''
      160                 and buf_thbj-attr.obj-code   = 0
      161               no-error .
      162             if not available buf_thbj-attr then do:
      163               if not locked buf_thbj-attr then do:
      164                 message
      165                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      166                   "Обратитесь к администратору системы."
      167                   view-as alert-box error .
      168               end.
      169               undo, return error "config":U .
      170             end.
      171           end.
      172           run get-next-seq( input type-code,
      173                             output l-code
      174                           ).
      175           find first buf_code-range
      176             where buf_code-range.db-num     = v-db-num
      177               and buf_code-range.range-type = type-code
      178               and buf_code-range.stts       = "a"
      179             use-index stts
      180             no-error .
      181           if available buf_code-range
      182           and l-code <= buf_code-range.last-code
      183           and l-code >= buf_code-range.first-code
      184           then do:
      185             assign
      186               p-b-code = l-code
      187             .
      188           end.
      189           else do:
      190             if available buf_code-range then do:
      191               assign
      192                 buf_code-range.stts = "u"
      193               .
      194             end.
      195             find first buf_code-range
      196               where buf_code-range.db-num     = v-db-num
      197                 and buf_code-range.range-type = type-code
      198                 and buf_code-range.stts       = "f"
      199               use-index stts
      200               no-error .
      201             if not available buf_code-range then do:
      202               message
      203                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      204                 "Обратитесь к администратору системы"
      205                 view-as alert-box error .
      206               undo, return error "code-range":U .
      207             end.
      208             assign
      209               buf_code-range.stts           = "a"
      210             .
      211             if buf_code-range.first-code = 1 then do:
      212               run set-seq-cr( input type-code,
      213                               input buf_code-range.first-code
      214                             ).
      215               assign
      216                 p-b-code = 1
      217               .
      218             end.
      219             else do:
      220               run set-seq-cr( input type-code,
      221                               input ( buf_code-range.first-code - 1 )
      222                             ).
      223               run get-next-seq( input type-code,
      224                                 output p-b-code
      225                               ).
      226             end.
      227           end.
      228         end.
      229       end.
      230     end.
      231   end procedure.
      232   procedure get-next-seq :
      233     define input  parameter type-code like ub.code-range.range-type no-undo .
      234     define output parameter next-seq  as   integer                  no-undo .
      235     do
      236     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      237     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      238     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      239     :
      240       case type-code:
      241         when 'bcgb':U then do:
      242           assign
      243             next-seq = next-value(s-bcgb-code, ub)
      244           .
      245         end.
      246         when 'scgb':U then do:
      247           assign
      248             next-seq = next-value(s-scgb-code, ub)
      249           .
      250         end.
      251         when 'sclc':U then do:
      252           assign
      253             next-seq = next-value(s-sclc-code, ub)
      254           .
      255         end.
      256         when 'pglc':U then do:
      257           assign
      258             next-seq = next-value(s-pglc-code, ub)
      259           .
      260         end.
      261         when 'dcgb':U then do:
      262           assign
      263             next-seq = next-value(s-dcgb-code, ub)
      264           .
      265         end.
      266         when 'ctgb':U then do:
      267           assign
      268             next-seq = next-value(s-ctgb-code, ub)
      269           .
      270         end.
      271         when 'drgb':U then do:
      272           assign
      273             next-seq = next-value(s-drgb-code, ub)
      274           .
      275         end.
      276         when 'fmgb':U then do:
      277           assign
      278             next-seq = next-value(s-fmgb-code, ub)
      279           .
      280         end.
      281         when 'pngb':U then do:
      282           assign
      283             next-seq = next-value(s-pngb-code, ub)
      284           .
      285         end.
      286         when 'cagb':U then do:
      287           assign
      288             next-seq = next-value(s-cagb-code, ub)
      289           .
      290         end.
      291         when 'fdgb':U then do:
      292           assign
      293             next-seq = next-value(s-fin-doc, ub)
      294           .
      295         end.
      296       end case.
      297     end.
      298   end procedure.
      299   procedure set-seq-cr :
      300     define input parameter type-code like ub.code-range.range-type no-undo .
      301     define input parameter set-val   like ub.code-range.first-code no-undo .
      302     do
      303     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      304     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      305     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      306     :
      307       case type-code:
      308         when 'bcgb':U then do:
      309           assign
      310             current-value(s-bcgb-code, ub) = set-val
      311           .
      312         end.
      313         when 'scgb':U then do:
      314           assign
      315             current-value(s-scgb-code, ub) = set-val
      316           .
      317         end.
      318         when 'sclc':U then do:
      319           assign
      320             current-value(s-sclc-code, ub) = set-val
      321           .
      322         end.
      323         when 'pglc':U then do:
      324           assign
      325             current-value(s-pglc-code, ub) = set-val
      326           .
      327         end.
      328         when 'dcgb':U then do:
      329           assign
      330             current-value(s-dcgb-code, ub) = set-val
      331           .
      332         end.
      333         when 'ctgb':U then do:
      334           assign
      335             current-value(s-ctgb-code, ub) = set-val
      336           .
      337         end.
      338         when 'drgb':U then do:
      339           assign
      340             current-value(s-drgb-code, ub) = set-val
      341           .
      342         end.
      343         when 'fmgb':U then do:
      344           assign
      345             current-value(s-fmgb-code, ub) = set-val
      346           .
      347         end.
      348         when 'pngb':U then do:
      349           assign
      350             current-value(s-pngb-code, ub) = set-val
      351           .
      352         end.
      353         when 'cagb':U then do:
      354           assign
      355             current-value(s-cagb-code, ub) = set-val
      356           .
      357         end.
      358         when 'fdgb':U then do:
      359           assign
      360             current-value(s-fin-doc, ub) = set-val
      361           .
      362         end.
      363       end case.
      364     end.
      365   end procedure.
      366   procedure new-bcod-gen-code-range :
      367     do
      368     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      369     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      370     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      371     :
      372       define input parameter p-db-num  like ub.db.db-num             no-undo .
      373       define input parameter type-code like ub.code-range.range-type no-undo .
      374       define buffer buf_code-range      for ub.code-range .
      375       define buffer last_code-range     for ub.code-range .
      376       define buffer last-1_code-range   for ub.code-range .
      377       define buffer last-2_code-range   for ub.code-range .
      378       define buffer last-3_code-range   for ub.code-range .
      379       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      380       define variable conf-par       as character no-undo .
      381       define variable par-type       as character no-undo .
      382       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      383       define variable v-cre-cdrg as logical   no-undo .
      384       define variable v-cre-str  as character no-undo .
      385       define variable v-cr1      as integer no-undo .
      386       define variable v-cr2      as integer no-undo .
      387       define variable v-cr3      as integer no-undo .
      388       define variable v-cmax     as integer no-undo .
      389       find first buf_sys-ctrl no-lock .
      390       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      391         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      392                                       ,vss-workfile
      393                                       ,vss-revision
      394                                       ,vss-description
      395                                       ,chr(10)
      396                                       , p-db-num
      397                                      ).
      398       end.
      399       run trg/getpcode.p ( input  type-code
      400                      ,output cfg-param-code
      401                     ).
      402       for each buf_code-range
      403         where buf_code-range.db-num     = -1
      404           and buf_code-range.range-type = type-code
      405           and buf_code-range.stts       = "f"
      406       by buf_code-range.first-code
      407       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      408       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      409       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      410       :
      411         assign
      412           buf_code-range.db-num = p-db-num
      413         .
      414         return .
      415       end.
      416       assign
      417         v-cre-cdrg = TRUE
      418       .
      419       case type-code:
      420         when 'sclc':U
      421         or when 'scgb':U
      422         or when 'pglc':U
      423         then do:
      424           find last last-1_code-range no-lock
      425             where last-1_code-range.range-type = 'sclc':U
      426             no-error .
      427           if available last-1_code-range then do:
      428             v-cr1 = last-1_code-range.last-code.
      429           end.
      430           find last last-2_code-range no-lock
      431             where last-2_code-range.range-type = 'scgb':U
      432             no-error .
      433           if available last-2_code-range then do:
      434             v-cr2 = last-2_code-range.last-code.
      435             end.
      436           find last last-3_code-range no-lock
      437             where last-3_code-range.range-type = 'pglc':U
      438             no-error .
      439           if available last-3_code-range then do:
      440             v-cr3 = last-3_code-range.last-code.
      441           end.
      442           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      443           .
      444           if v-cmax = v-cr1  then do:
      445               find last last_code-range no-lock
      446                 where recid( last_code-range ) = recid( last-1_code-range )
      447                 .
      448             end.
      449           if v-cmax = v-cr2  then do:
      450               find last last_code-range no-lock
      451                 where recid( last_code-range ) = recid( last-2_code-range )
      452                 .
      453             end.
      454           if v-cmax = v-cr3  then do:
      455             find last last_code-range no-lock
      456               where recid( last_code-range ) = recid( last-3_code-range )
      457               .
      458           end.
      459           if last_code-range.last-code + 1 > 99999 then do:
      460             assign
      461               v-cre-cdrg = FALSE
      462             .
      463           end.
      464         end.
      465         when 'bcgb':U
      466         or when 'sslc':U
      467         or when 'ssgb':U
      468         then do:
      469           find last last-1_code-range no-lock
      470             where last-1_code-range.range-type = 'sslc':U
      471             no-error .
      472           if available last-1_code-range then do:
      473             v-cr1 = last-1_code-range.last-code.
      474           end.
      475           find last last-2_code-range no-lock
      476             where last-2_code-range.range-type = 'bcgb':U
      477             no-error .
      478           if available last-2_code-range then do:
      479             v-cr2 = last-2_code-range.last-code.
      480             end.
      481           find last last-3_code-range no-lock
      482             where last-3_code-range.range-type = 'ssgb':U
      483             no-error .
      484           if available last-3_code-range then do:
      485             v-cr3 = last-3_code-range.last-code.
      486           end.
      487           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      488           .
      489           if v-cmax = v-cr1  then do:
      490               find last last_code-range no-lock
      491                 where recid( last_code-range ) = recid( last-1_code-range )
      492                 .
      493             end.
      494           if v-cmax = v-cr2  then do:
      495               find last last_code-range no-lock
      496                 where recid( last_code-range ) = recid( last-2_code-range )
      497                 .
      498             end.
      499           if v-cmax = v-cr3  then do:
      500             find last last_code-range no-lock
      501               where recid( last_code-range ) = recid( last-3_code-range )
      502               .
      503           end.
      504         end.
      505         otherwise do:
      506           find last last_code-range no-lock
      507             where last_code-range.range-type = type-code
      508             no-error .
      509         end.
      510       end case.
      511       if not available last_code-range then do:
      512         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      513                                       ,vss-workfile
      514                                       ,vss-revision
      515                                       ,vss-description
      516                                       , chr(10)
      517                                       , type-code
      518                                      ) .
      519       end.
      520       define variable v-mes0 as character no-undo .
      521       define variable v-param-type0 as character no-undo .
      522       define variable v-value-character0 as INTEGER no-undo .
      523       define variable v-value-date0 as date no-undo .
      524       define variable v-value-decimal0 as decimal no-undo .
      525       define variable v-value-integer0 AS integer no-undo .
      526       define variable v-value-logical0 AS LOGICAL no-undo .
      527       define variable v-tth0 as handle no-undo .
      528       run adm/shattri.p (
      529           input "get":U
      530           ,input  'БД':U
      531           ,input  p-db-num
      532           ,input  'code-range':U
      533           ,input  cfg-param-code
      534           ,output v-value-character0
      535           ,output v-value-date0
      536           ,output v-value-decimal0
      537           ,output v-value-integer0
      538           ,output v-value-logical0
      539           ,output v-param-type0
      540           ,INPUT-OUTPUT table-handle v-tth0
      541           ) no-error .
      542       if error-status :error then do:
      543         delete object v-tth0.
      544         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      545                            , error-status:get-message(1)
      546                            , chr(10)
      547                            , return-value ).
      548         undo, return error v-mes0.
      549       end.
      550       delete object v-tth0.
      551       if v-cre-cdrg = TRUE then do:
      552         create buf_code-range .
      553         assign
      554           buf_code-range.db-num     = p-db-num
      555           buf_code-range.range-type = type-code
      556           buf_code-range.stts       = "f"
      557           buf_code-range.first-code = last_code-range.last-code + 1
      558           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      559           v-cre-str = "Свободный диапазон успешно создан"
      560         .
      561       end.
      562       else do:
      563         assign
      564           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      565                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      566         .
      567       end.
      568     end.
      569     return v-cre-str .
      570   end procedure.
      571   procedure gen-new-code-range-if-neces :
      572     define input parameter v-db-num           like ub.db.db-num             no-undo .
      573     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      574     define input parameter v-cur-code         as   integer                  no-undo .
      575     define input parameter v-g#news           as   logical                  no-undo .
      576     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      577     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      578     do
      579     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      580     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      581     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      582     :
      583       define variable l-code-range-exist as logical   no-undo init false .
      584       define variable v-db-for-send      as character no-undo .
      585       define buffer buf_code-range  for ub.code-range .
      586       define buffer buf1_code-range for ub.code-range .
      587       define buffer buf_db          for ub.db .
      588       find first buf_code-range
      589         where buf_code-range.range-type = v-range-type
      590           and buf_code-range.last-code >= v-cur-code
      591         use-index last-codei
      592         no-error .
      593       if
      594       (
      595          available buf_code-range
      596          and
      597         (buf_code-range.db-num = v-db-num
      598           and
      599         buf_code-range.first-code <= v-cur-code
      600         )
      601       or
      602         (
      603           v-range-type = 'drgb':U
      604           AND
      605           v-cur-code = 0
      606         )
      607      )
      608      then do:
      609         assign
      610           l-code-range-exist = true
      611         .
      612         if v-g#news
      613         and buf_code-range.stts = "f" then do:
      614           assign
      615             buf_code-range.stts = "u"
      616           .
      617         end.
      618       end.
      619       if not l-code-range-exist
      620          and v-g#news-source-db <> 0
      621       then do:
      622         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      623                                       ,vss-workfile
      624                                       ,vss-revision
      625                                       ,vss-description
      626                                       ,chr(10)
      627                                       ,v-db-num
      628                                       ,v-range-type
      629                                       ,v-cur-code
      630                                      ).
      631       end.
      632       if (not l-code-range-exist
      633           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      634          )
      635       and ( not can-find (first buf1_code-range no-lock
      636                           where buf1_code-range.db-num = v-db-num
      637                             and buf1_code-range.range-type = v-range-type
      638                             and buf1_code-range.stts = "f"
      639                          )
      640           )
      641       then do:
      642         if v-g#db-num = 0 then do:
      643           run new-bcod-gen-code-range in this-procedure
      644             (input v-db-num,
      645              input v-range-type
      646             ) no-error .
      647           if error-status :error then do:
      648             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      649                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      650                                           ,v-db-num
      651                                           ,v-range-type
      652                                           ,v-cur-code
      653                                           ,chr(10)
      654                                           ,error-status:get-message(1)
      655                                           ,return-value
      656                                          ).
      657           end.
      658         end.
      659         else do:
      660           if v-range-type = 'sclc':U
      661           or v-range-type = 'pglc':U
      662           then do:
      663             assign
      664               v-db-for-send = "":U
      665             .
      666             if v-g#db-num = 0 then do:
      667               for each buf_db no-lock
      668                 where buf_db.db-num > 0
      669                   and buf_db.db-num <> v-g#news-source-db
      670               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      671               :
      672                 assign
      673                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      674                 .
      675               end.
      676               assign
      677                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      678               .
      679             end.
      680             else do:
      681               if not v-g#news then do:
      682                 assign
      683                   v-db-for-send = "0":U
      684                 .
      685               end.
      686             end.
      687             run nws/cr-route.p ( input 'send-cmd':U
      688                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      689                                  "code-range":U + chr(1) +
      690                                  (if v-range-type = 'sclc':U
      691                                   then string( current-value(s-sclc-code, ub))
      692                                   else string( current-value(s-pglc-code, ub))
      693                                   ) + chr(1) +
      694                                   v-range-type)
      695                           ,input ?
      696                           ,input v-db-for-send
      697                           ) no-error .
      698             if error-status :error then do:
      699               undo, return error return-value.
      700             end.
      701           end.
      702         end.
      703       end.
      704     end.
      705   end procedure.
      706   procedure cre-loc-sc-code-range :
      707     define input parameter v-cur-code as integer no-undo .
      708   define input parameter p-cdrg-type as character no-undo .
      709     do
      710     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      711     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      712     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      713     :
      714       define buffer buf_code-range for ub.code-range .
      715       find first buf_code-range
      716            where buf_code-range.range-type = p-cdrg-type
      717              and buf_code-range.first-code >= v-cur-code
      718            no-error .
      719       if not available buf_code-range then do:
      720         run new-bcod-gen-code-range in this-procedure
      721           ( input 0,
      722             input p-cdrg-type
      723           ) no-error .
      724         if error-status :error then do:
      725           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      726                                          + "Код &2&1&3 &4"
      727                                         , chr(10)
      728                                         , v-cur-code
      729                                         , error-status:get-message(1)
      730                                         , return-value
      731                                        ) .
      732         end.
      733       end.
      734     end.
      735   end procedure.
      736   procedure mark-used-if-need :
      737   define input parameter p-cur-code as integer no-undo .
      738   define input parameter p-range-type like ub.code-range.range-type no-undo .
      739   define input parameter p-db-num like ub.code-range.db-num no-undo .
      740     do
      741     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      742     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      743     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      744     :
      745       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      746       define buffer buf_code-range for ub.code-range .
      747       assign
      748       v-db-num = if p-range-type = 'sclc':U
      749                  then 0
      750                  else p-db-num
      751       .
      752   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      753   define buffer locK-batchprocess1 for ub.batchprocess.
      754   run gbl/lock-prc.p
      755       (input 'lscc':U
      756       ,input 0
      757       ,input 0
      758       ,input 0
      759       ,input ""
      760       ,input ""
      761       ,input ""
      762       ,input (
      763               ",,,Вкл/выкл лок. вес. кодов"
      764              )
      765       ,input true
      766       ,buffer lock-batchprocess1
      767       ) no-error .
      768     if error-status :error then do:
      769       message
      770         vss-workfile vss-revision vss-description skip
      771         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      772         view-as alert-box error .
      773       undo, return error .
      774     end.
      775       find first buf_code-range
      776            where buf_code-range.range-type = p-range-type
      777              and buf_code-range.first-code >= p-cur-code
      778              and buf_code-range.last-code <= p-cur-code
      779              and buf_code-range.db-num = v-db-num
      780            no-error .
      781       if not available buf_code-range then do:
      782         message
      783           vss-workfile vss-revision vss-description skip
      784           "Ошибка при создании поиске диапазона" skip
      785           "База данных" p-db-num skip
      786           "Код" p-cur-code skip
      787           "Тип" p-range-type
      788           error-status :get-message(1) skip
      789           return-value skip
      790           view-as alert-box error .
      791         undo, return error .
      792       end.
      793       if buf_code-range.stts = "f":U then do:
      794         assign
      795         buf_code-range.stts = "u":U
      796         .
      797       end.
      798     end.
      799   end procedure.
      800   DEFINE BUFFER   buf_C-contract FOR c-Contract.
      801   DEFINE VARIABLE v-iUser-Db-Num AS INTEGER   NO-UNDO INITIAL 0.
      802   DEFINE VARIABLE v-cUser-Name   AS CHARACTER NO-UNDO INITIAL "".
      803   DEFINE VARIABLE v-Sys-Date     AS DATE      NO-UNDO INITIAL ?.
      804   DEFINE VARIABLE v-Sys-Time     AS CHARACTER NO-UNDO INITIAL "".
      805   DEFINE VARIABLE v-Sys-Time-Int AS INTEGER   NO-UNDO INITIAL 0.
      806   main-block :
      807   do transaction
      808   on error undo main-block, return error
      809   :
      810     if new(ub.contract) then do:
      811       define variable v-db-num as integer   no-undo .
      812       if g#news then assign v-db-num = g#news-source-db .
      813       else           assign v-db-num = g#db-num .
      814       run gen-new-code-range-if-neces( input v-db-num,
      815                                        input 'ctgb':U,
      816                                        input ub.contract.contract-code,
      817                                        input g#news,
      818                                        input g#db-num,
      819                                        input g#news-source-db
      820                                      ) no-error .
      821       if error-status:error then do:
      822         message
      823           vss-workfile vss-revision vss-description skip
      824           error-status :get-message(1) skip
      825           return-value skip
      826           ""
      827           view-as alert-box error
      828         .
      829         undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ).
      830       end.
      831     end. ELSE DO:
      832   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
      834     (output v-iUser-Db-Num
      835     ,output v-cUser-Name
      836     ,output v-Sys-Date
      837     ,output v-Sys-Time
      838     ,output v-Sys-Time-Int
      839     )  .
      840        CREATE buf_C-contract NO-ERROR.
      841        IF ERROR-STATUS:ERROR THEN DO:                               MESSAGE                                                      vss-workfile vss-revision vss-description SKIP            ERROR-STATUS:GET-MESSAGE(1) SKIP                          RETURN-VALUE SKIP                                         ""                                                        VIEW-AS ALERT-BOX ERROR                                 .                                                         UNDO main-block, RETURN ERROR                                 substitute( "&1. &2&3&4",                                              vss-workfile,                                             return-value,                                             chr(10),                                              ERROR-STATUS :GET-MESSAGE(1)                             ).                                    END.
      842        BUFFER-COPY ub.Contract TO buf_C-contract NO-ERROR.
      843        IF ERROR-STATUS:ERROR THEN DO:                               MESSAGE                                                      vss-workfile vss-revision vss-description SKIP            ERROR-STATUS:GET-MESSAGE(1) SKIP                          RETURN-VALUE SKIP                                         ""                                                        VIEW-AS ALERT-BOX ERROR                                 .                                                         UNDO main-block, RETURN ERROR                                 substitute( "&1. &2&3&4",                                              vss-workfile,                                             return-value,                                             chr(10),                                              ERROR-STATUS :GET-MESSAGE(1)                             ).                                    END.
      844        ASSIGN
      845           buf_C-contract.chip-num          = NEXT-VALUE(s-corr-chip, ub)
      846           buf_c-contract.corr-user-db-num  = ub.contract.user-db-num
      847           buf_c-contract.corr-user-name    = ub.Contract.user-name
      848           buf_c-contract.corr-date         = v-Sys-date
      849           buf_c-contract.corr-time         = v-Sys-time-int
      850           NO-ERROR.
      851        IF ERROR-STATUS:ERROR THEN DO:                               MESSAGE                                                      vss-workfile vss-revision vss-description SKIP            ERROR-STATUS:GET-MESSAGE(1) SKIP                          RETURN-VALUE SKIP                                         ""                                                        VIEW-AS ALERT-BOX ERROR                                 .                                                         UNDO main-block, RETURN ERROR                                 substitute( "&1. &2&3&4",                                              vss-workfile,                                             return-value,                                             chr(10),                                              ERROR-STATUS :GET-MESSAGE(1)                             ).                                    END.
      852     END.
      853     run str/callnews.p (input "contract", input (buffer ub.contract:handle) ) no-error .
      854     if error-status:error then do:
      855       message
      856         vss-workfile vss-revision vss-description skip   "Ошибка при передаче в новости договора" skip
      857         error-status :get-message(1) skip    return-value skip     view-as alert-box error .
      858       undo, return error.
      859     end.
      860       if g#oxml = yes
      861       then do:
      862       run str/calloxml.p (
      863             input 'update':U
      864           , input 'contract':U
      865           , input ( buffer ub.contract:handle )
      866       ) no-error.
      867       if error-status :error
      868       then do:
      869           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      870                                , chr(10)
      871                                , vss-workfile
      872                                , return-value
      873                                , error-status :get-message ( 1 ) ).
      874       end.
      875       end.
      876   end.
