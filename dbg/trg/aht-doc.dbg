     3817       end.
     3818       if varcur-slt-pc = ?
     3819       then do:
     3820         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3821       end.
     3822       v-calcbypart = no.
