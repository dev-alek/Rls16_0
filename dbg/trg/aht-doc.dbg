     4463       end.
     4464       else do:
     4465            in-vatp-have-vat-sltoprl = no.
     4466       end.
     4467     end.
     4468     assign
     4469      price-cli-with-tax-locoprl = out-vatp_partsprl.price-cli
     4470      cli-base-rateoprl          = out-vatp_partsprl.cli-base-rate.
     4471     ASSIGN   road-tax-base-locoprl  = (if out-vatp_partsprl.road-tax-base  = ? then 0 else out-vatp_partsprl.road-tax-base)
     4472              road-tax-rubl-locoprl  = (if out-vatp_partsprl.road-tax-rubl  = ? then 0 else out-vatp_partsprl.road-tax-rubl).
     4473     ASSIGN  transport-base-locoprl = (if out-vatp_partsprl.transport-base = ? then 0 else out-vatp_partsprl.transport-base)
     4474             transport-rubl-locoprl = (if out-vatp_partsprl.transport-rubl = ? then 0 else out-vatp_partsprl.transport-rubl)
     4475             other-base-locoprl     = (if out-vatp_partsprl.other-base     = ? then 0 else out-vatp_partsprl.other-base)
     4476             other-rubl-locoprl     = (if out-vatp_partsprl.other-rubl     = ? then 0 else out-vatp_partsprl.other-rubl)
     4477             vat-pc-locoprl         = (if out-vatp_partsprl.vat-pc         = ? then 0 else out-vatp_partsprl.vat-pc)
     4478             slt-pc-locoprl         = (if out-vatp_partsprl.slt-pc         = ? then 0 else out-vatp_partsprl.slt-pc).
     4479             ASSIGN   slt-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     4480       ASSIGN   slt-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     4481     assign
     4482       exch-rate-cli-locoprl = (out-vatp_partsprl.price-rubl - transport-rubl-locoprl - other-rubl-locoprl - road-tax-rubl-locoprl - (if out-vatp_partsprl.vat-type <> 'в т. ч.':U then vat-rubl-locoprl else 0) - (if out-vatp_partsprl.slt-type <> 'в т. ч.':U then slt-rubl-locoprl else 0)) / out-vatp_partsprl.price-cli .
     4483     assign
     4484       slt-cli-locoprl        = slt-rubl-locoprl       / exch-rate-cli-locoprl
     4485       vat-cli-locoprl        = vat-rubl-locoprl       / exch-rate-cli-locoprl
     4486       road-tax-cli-locoprl   = road-tax-rubl-locoprl  / exch-rate-cli-locoprl
     4487       transport-cli-locoprl  = 0
     4488       other-cli-locoprl      = 0
     4489     .
     4490   ASSIGN
     4491             price-base-without-tax-locoprl = price-base-with-tax-locoprl - vat-base-locoprl - slt-base-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))
     4492       price-rubl-without-tax-locoprl = price-rubl-with-tax-locoprl - vat-rubl-locoprl - slt-rubl-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))
     4493   .
     4494         assign
     4495           varprice-base-consprl = varprice-base-consprl + (price-base-with-tax-locoprl - (if road-tax-base-locoprl = ? then 0 else road-tax-base-locoprl))* out-vatp_partsprl.fact-qnty
     4496           varprice-rubl-consprl = varprice-rubl-consprl + (price-rubl-with-tax-locoprl - (if road-tax-rubl-locoprl = ? then 0 else road-tax-rubl-locoprl))* out-vatp_partsprl.fact-qnty.
     4497         assign
     4498           varis-cons-parts-haveprl = yes
     4499           varcons-qntyprl          = varcons-qntyprl + out-vatp_partsprl.fact-qnty.
     4500       end.
     4501       assign
     4502         varfact-qntyprl = varfact-qntyprl + out-vatp_partsprl.fact-qnty.
     4503     end.
     4504   end.
     4505   assign
     4506     varprice-base-consprl = varprice-base-consprl / varcons-qntyprl
     4507     varprice-rubl-consprl = varprice-rubl-consprl / varcons-qntyprl.
     4508   if varprice-base-consprl = ? then do:
     4509     assign
     4510       varprice-base-consprl = 0.
     4511   end.
     4512   if varprice-rubl-consprl = ? then do:
     4513     assign
     4514       varprice-rubl-consprl = 0.
     4515   end.
     4516   assign
     4517       slt-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc)
     4518     vat-base-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     4519     discnt-base-saleprl            = vardiscnt-base
     4520     price-base-with-tax-saleprl    = (varprice-base - vardiscnt-base)
     4521       slt-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc)
     4522     vat-rubl-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc)
     4523     discnt-rubl-saleprl            = vardiscnt-rubl
     4524     price-rubl-with-tax-saleprl    = (varprice-rubl - vardiscnt-rubl)
     4525     .
     4526   if vardoc-type = 'инв':U then do:
     4527     assign
     4528       varfact-qntyprl = vardoc-qnty.
     4529   end.
     4530   else do:
     4531     assign
     4532       varfact-qntyprl = varfact-qnty.
     4533   end.
     4534   if varis-cons-parts-haveprl = no then do:
     4535     assign
     4536           vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     4537           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
     4538   end.
     4539   else do:
     4540     if vardoc-type = 'инв':U then do:
     4541       assign
     4542               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     4543               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     4544        .
     4545     end.
     4546     else do:
     4547       assign
     4548               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     4549               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     4550        .
     4551     end.
     4552   end.
     4553   assign
     4554   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
     4555   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
     4556     end.
     4557   end procedure.
     4558   define variable v-ind                       as integer   no-undo .
     4559   define variable v-doc-date                  as date      no-undo .
     4560   define variable v-start-time                as integer   no-undo .
     4561   define variable v-current-time              as character no-undo .
     4562   define variable v-current-action            as character no-undo .
     4563   define variable v-message-on                as logical   no-undo .
     4564   define variable v-msgstr                    as character no-undo .
     4565   do transaction
     4566   on error undo, return error
     4567   :
     4568     define frame a
     4569       v-current-action format 'x(40)':u      no-labels skip
     4570       v-ind            format '>>>>>>>9':u   label "Обработано артикулов" skip
     4571       v-current-time   format 'x(8)':u       label "Время расчета документа" skip
     4572       p-doc-code       format 'x(14)':u      label "Документ" skip
     4573       v-doc-date       format '99/99/9999':u label "Дата закрытия документа" skip
     4574       with view-as dialog-box side-labels three-d
     4575       title "Расчет складского архива по типам приобретения"
     4576       .
     4577      define variable mFrameView      as logical   no-undo init yes.
     4578     define variable mFramHandle as handle no-undo.
     4579     mFramHandle = frame a:handle.
     4580     if  log-manager:logfile-name ne ?
     4581     then DO:
     4582         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameoxmError").
     4583         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameoxmError").
     4584     end.
     4585     mFrameView = not session:batch-mode and mFramHandle:visible.
     4586     if mFrameView
     4587     then do:
     4588        view frame a .
     4589        display
     4590           p-doc-code
     4591        with frame a .
     4592     end.
     4593     v-message-on = (not g#auto) .
     4594     run process-trn-doc in this-procedure
     4595       (input p-doc-code
     4596       ,input p-cut-date
     4597       ) no-error .
     4598     if error-status :error
     4599     then do:
     4600       v-msgstr =
     4601         vss-workfile + " " + vss-revision + " " + vss-description + chr(10)
     4602         + "Ошибка при обработке документа" + chr(10)
     4603         + "Документ " + p-doc-code + chr(10)
     4604         + "Ограничение на обновление складского архива " + string(p-cut-date) + chr(10)
     4605         + return-value
     4606       .
     4607       if v-message-on then
     4608         message
     4609           v-msgstr
     4610           view-as alert-box error .
     4611       undo, return error v-msgstr .
     4612     end.
     4613   end.
     4614   procedure process-trn-doc :
     4615     define input  parameter p-doc-code as character no-undo .
     4616     define input  parameter p-cut-date as date      no-undo .
     4617     define variable v-fact-order                as decimal   no-undo .
     4618     define variable v-shift-end-fact-order      as decimal   no-undo .
     4619     define variable v-day-end-fact-order        as decimal   no-undo .
     4620     define variable v-day-cut-fact-order        as decimal   no-undo .
     4621     define variable v-today as date      no-undo .
     4622     define variable v-time  as integer   no-undo .
     4623     define variable v-msgstr as character no-undo .
     4624     define buffer buf_trn-doc for ub.trn-doc .
     4625     do
     4626     on error undo, return error return-value
     4627     :
     4628       find first buf_trn-doc share-lock
     4629         where buf_trn-doc.doc-code = p-doc-code
     4630         no-error .
     4631       if not available buf_trn-doc
     4632       then do:
     4633         v-msgstr = "Не найден документ " + p-doc-code .
     4634         if v-message-on then
     4635           message
     4636             vss-workfile vss-revision vss-description skip
     4637             v-msgstr skip
     4638             view-as alert-box error .
     4639         undo, return error v-msgstr .
     4640       end.
     4641       assign
     4642         v-doc-date = buf_trn-doc.fact-date
     4643       .
     4644     if mFrameView
     4645     then display
     4646         v-doc-date
     4647         with frame a .
     4648       if buf_trn-doc.status_ <> 'факт':U
     4649       then do:
     4650         v-msgstr =
     4651           "Нельзя рассчитать складской архив по типам приобретения для складского документа не закрытого до статуса " + 'факт':U + chr(10)
     4652           + "Документ " + p-doc-code
     4653         .
     4654         if v-message-on then
     4655         message
     4656           vss-workfile vss-revision vss-description skip
     4657           v-msgstr
     4658           view-as alert-box error .
     4659         undo, return error v-msgstr .
     4660       end.
     4661       define variable v-shift-on as logical   no-undo .
     4662   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4664     (input  buf_trn-doc.obj-type
     4665     ,input  buf_trn-doc.obj-code
     4666     ,input  'shift-on=request'
     4667     ,output v-shift-on
     4668     ) no-error .
     4669       if error-status :error
     4670       then do:
     4671         v-msgstr =
     4672           "Ошибка при запуске процедуры objat" + chr(10)
     4673           + "Объект " + buf_trn-doc.obj-type + " " + string(buf_trn-doc.obj-code) + chr(10)
     4674           + error-status:get-message (1) + chr(10)
     4675           + return-value
     4676         .
     4677         message
     4678           vss-workfile vss-revision vss-description skip
     4679           v-msgstr
     4680           view-as alert-box error .
     4681         undo, return error v-msgstr.
     4682       end.
     4683       define variable v-curr-r-b as character no-undo .
     4684   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4685   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4686     (output v-curr-r-b
     4687     )  .
     4688       run factord in this-procedure
     4689         (input  buf_trn-doc.fact-date
     4690         ,input  buf_trn-doc.fact-time
     4691         ,input  buf_trn-doc.fact-num
     4692         ,input  buf_trn-doc.shift-date
     4693         ,input  buf_trn-doc.shift-num
     4694         ,input  v-shift-on
     4695         ,output v-fact-order
     4696         ,output v-shift-end-fact-order
     4697         ,output v-day-end-fact-order
     4698         ) no-error .
     4699       if error-status :error
     4700       or v-fact-order = ?
     4701       or v-fact-order = 0
     4702       then do:
     4703         v-msgstr =
     4704           "Ошибка при определении фактического номера складского документа" + chr(10)
     4705           + "doc-code " +          buf_trn-doc.doc-code   + chr(10)
     4706           + "fact-date " +  string(buf_trn-doc.fact-date) + chr(10)
     4707           + "fact-time " +  string(buf_trn-doc.fact-time, "HH:MM") + chr(10)
     4708           + "fact-num " +   string(buf_trn-doc.fact-num)  + chr(10)
     4709           + "shift-date " + string(buf_trn-doc.shift-date) + chr(10)
     4710           + "shift-num " +  string(buf_trn-doc.shift-num) + chr(10)
     4711           + "v-fact-order " + string(v-fact-order)        + chr(10)
     4712           + "v-shift-end-fact-order " + string(v-shift-end-fact-order) + chr(10)
     4713           + "v-day-end-fact-order" + string(v-day-end-fact-order) + chr(10)
     4714           + error-status:get-message(1) + chr(10)
     4715           + return-value
     4716         .
     4717         if v-message-on then
     4718           message
     4719             vss-workfile vss-revision vss-description skip
     4720             v-msgstr
     4721             view-as alert-box error .
     4722         undo, return error v-msgstr .
     4723       end.
     4724       if p-cut-date = ?
     4725       then do:
     4726         run factord-max-fact-order in this-procedure
     4727           (output v-day-cut-fact-order
     4728           ) .
     4729       end.
     4730       else do:
     4731         if p-cut-date = buf_trn-doc.fact-date
     4732         then do:
     4733           assign
     4734             v-day-end-fact-order   = v-day-end-fact-order   - 0.0000000001
     4735           .
     4736         end.
     4737         assign
     4738           v-day-cut-fact-order   = v-day-end-fact-order
     4739         .
     4740       end.
     4741       run aht_add-document in this-procedure
     4742         (input buf_trn-doc.doc-code
     4743         ,input buf_trn-doc.obj-type
     4744         ,input buf_trn-doc.obj-code
     4745         ,input buf_trn-doc.ext-doc-type
     4746         ,input true
     4747         ,input buf_trn-doc.fact-order
     4748         ,input buf_trn-doc.fact-date
     4749         ,input buf_trn-doc.shift-date
     4750         ,input buf_trn-doc.shift-num
     4751         ) no-error .
     4752       if error-status :error
     4753       then do:
     4754         v-msgstr =
     4755           "Ошибка при добавлении документа в складской архив по типам приобретения" + chr(10)
     4756           + "Документ " + p-doc-code + chr(10)
     4757           + error-status:get-message(1) + chr(10)
     4758           + return-value
     4759         .
     4760         if v-message-on then
     4761           message
     4762             vss-workfile vss-revision vss-description skip
     4763             v-msgstr skip
     4764             view-as alert-box error .
     4765         undo, return error v-msgstr .
     4766       end.
     4767       run aht_add-date in this-procedure
     4768         (input buf_trn-doc.obj-type
     4769         ,input buf_trn-doc.obj-code
     4770         ,input 'n':U
     4771         ,input v-day-end-fact-order
     4772         ,input buf_trn-doc.fact-date
     4773         ,input ?
     4774         ,input 0
     4775         ) no-error .
     4776       if error-status :error
     4777       then do:
     4778         v-msgstr =
     4779           "Ошибка при добавлении даты в складской архив по типам приобретения" + chr(10)
     4780           + "Документ " + p-doc-code + chr(10)
     4781           + error-status:get-message(1) + chr(10)
     4782           + return-value
     4783         .
     4784         if v-message-on then
     4785           message
     4786             vss-workfile vss-revision vss-description skip
     4787             v-msgstr skip
     4788             view-as alert-box error .
     4789         undo, return error v-msgstr .
     4790       end.
     4791       run cur-time in this-procedure ( output v-today
     4792                                     , output v-start-time
     4793                                     ).
     4794       run show-action in this-procedure
     4795         (input "Расчет строк документа"
     4796         ).
     4797       define buffer buf_doc-line for ub.doc-line .
     4798       for each buf_doc-line no-lock
     4799         where buf_doc-line.doc-code = buf_trn-doc.doc-code
     4800       on error undo, return error
     4801       :
     4802         define variable v-gds-code           as integer   no-undo .
     4803   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4804   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4805     (input  buf_doc-line.artic
     4806     ,input  buf_doc-line.prod-type
     4807     ,input  buf_doc-line.prod-code
     4808     ,output v-gds-code
     4809     )  .
     4810         run process-doc-line in this-procedure
     4811           (input recid(buf_doc-line)
     4812           ,input buf_doc-line.doc-code
     4813           ,input buf_doc-line.artic
     4814           ,input buf_doc-line.prod-type
     4815           ,input buf_doc-line.prod-code
     4816           ,input v-gds-code
     4817           ,input buf_trn-doc.obj-type
     4818           ,input buf_trn-doc.obj-code
     4819           ,input buf_trn-doc.fact-order
     4820           ,input buf_trn-doc.ext-doc-type
     4821           ,input v-curr-r-b
     4822           ) no-error .
     4823         if error-status :error
     4824         then do:
     4825           v-msgstr =
     4826             "Ошибка при обработке строки документа" + chr(10)
     4827             + "Документ " + buf_doc-line.doc-code + chr(10)
     4828             + "Артикул " + buf_doc-line.artic + " " + buf_doc-line.prod-type + " " + string(buf_doc-line.prod-code) + chr(10)
     4829             + error-status:get-message(1) + chr(10)
     4830             + return-value
     4831           .
     4832           if v-message-on then
     4833             message
     4834               vss-workfile vss-revision vss-description skip
     4835               v-msgstr skip
     4836               view-as alert-box error .
     4837           undo, return error v-msgstr .
     4838         end.
     4839         assign
     4840           v-ind  = v-ind + 1
     4841         .
     4842         if v-ind modulo 10 = 0
     4843         then do:
     4844           run cur-time in this-procedure ( output v-today
     4845                                         , output v-time
     4846                                         ).
     4847           assign
     4848             v-current-time = string(v-time - v-start-time, "HH:MM:SS")
     4849           .
     4850           if mFrameView
     4851           then display
     4852             v-ind
     4853             v-current-time
     4854             with frame a .
     4855         end.
     4856       end.
     4857       run show-action in this-procedure
     4858         (input "Расчет шапки документа"
     4859         ).
     4860       run aht_update-ot-tot in this-procedure
     4861         (input buf_trn-doc.obj-type
     4862         ,input buf_trn-doc.obj-code
     4863         ,input buf_trn-doc.fact-order
     4864         ,input buf_trn-doc.ext-doc-type
     4865         ) no-error .
     4866       if error-status :error
     4867       then do:
     4868         v-msgstr =
     4869           "Ошибка при расчете оборотов по документу" + chr(10)
     4870           + error-status:get-message(1) + chr(10)
     4871           + return-value
     4872         .
     4873         if v-message-on then
     4874           message
     4875             vss-workfile vss-revision vss-description skip
     4876             v-msgstr skip
     4877             view-as alert-box error .
     4878         undo, return error v-msgstr .
     4879       end.
     4880       run show-action in this-procedure
     4881         (input "Сохранение оборота"
     4882         ).
     4883       run aht_store-ot-table in this-procedure no-error .
     4884       if error-status :error
     4885       then do:
     4886         v-msgstr =
     4887           "Ошибка при сохранении оборотов по документу" + chr(10)
     4888           + error-status:get-message(1) + chr(10)
     4889           + return-value
     4890         .
     4891         if v-message-on then
     4892           message
     4893             vss-workfile vss-revision vss-description skip
     4894             v-msgstr skip
     4895             view-as alert-box error .
     4896         undo, return error v-msgstr .
     4897       end.
     4898       run show-action in this-procedure
     4899         (input "Сохранение остатков"
     4900         ).
     4901       run aht_update-stk-table in this-procedure
     4902         (input v-day-end-fact-order
     4903         ,input v-day-cut-fact-order
     4904         ,input buf_trn-doc.ext-doc-type
     4905         ,input true
     4906         ) no-error .
     4907       if error-status :error
     4908       then do:
     4909         v-msgstr =
     4910           "Ошибка при расчете остатков" + chr(10)
     4911           + error-status:get-message(1) + chr(10)
     4912           + return-value
     4913         .
     4914         if v-message-on then
     4915           message
     4916             vss-workfile vss-revision vss-description skip
     4917             v-msgstr skip
     4918             view-as alert-box error .
     4919         undo, return error v-msgstr .
     4920       end.
     4921       run show-action in this-procedure
     4922         (input "Расчет документа закончен"
     4923         ).
     4924     end.
     4925   end procedure.
     4926   procedure process-doc-line :
     4927     define input  parameter p-doc-line-recid as recid     no-undo .
     4928     define input  parameter p-doc-code       like ub.doc-line.doc-code  no-undo .
     4929     define input  parameter p-artic          like ub.doc-line.artic     no-undo .
     4930     define input  parameter p-prod-type      like ub.doc-line.prod-type no-undo .
     4931     define input  parameter p-prod-code      like ub.doc-line.prod-code no-undo .
     4932     define input  parameter p-gds-code       as integer   no-undo .
     4933     define input  parameter p-obj-type       like ub.trn-doc.obj-type   no-undo .
     4934     define input  parameter p-obj-code       like ub.trn-doc.obj-code   no-undo .
     4935     define input  parameter p-fact-order     like ub.trn-doc.fact-order no-undo .
     4936     define input  parameter p-ext-doc-type   like ub.trn-doc.ext-doc-type no-undo .
     4937     define input  parameter p-curr-r-b       as character no-undo .
     4938     define variable vss-description as character no-undo initial "process-doc-line-01: обработка строки документа".
     4939     define variable v-aht-type-list   as character extent 6 no-undo
     4940       initial ['r':U, 'c':U, 'b':U, 's':U, 'o':U, 'v':U] .
     4941     define variable v-aht-type        as character no-undo .
     4942     define variable v-aht-type-ind    as integer   no-undo .
     4943     define variable v-cost-fact-qnty     as decimal   no-undo .
     4944     define variable v-allsum-sum-type    as character no-undo .
     4945     define variable v-fact-qnty as decimal   no-undo .
     4946             define variable v-cost-sum-base       as decimal   no-undo .     define variable v-cost-sum-rubl       as decimal   no-undo .     define variable v-cost-vat-base       as decimal   no-undo .     define variable v-cost-vat-rubl       as decimal   no-undo .     define variable v-cost-slt-base       as decimal   no-undo .     define variable v-cost-slt-rubl       as decimal   no-undo .     define variable v-cost-road-tax-base  as decimal   no-undo .     define variable v-cost-road-tax-rubl  as decimal   no-undo .     define variable v-cost-excise-base    as decimal   no-undo .     define variable v-cost-excise-rubl    as decimal   no-undo .     define variable v-cost-transport-base as decimal   no-undo .     define variable v-cost-transport-rubl as decimal   no-undo .     define variable v-cost-other-base     as decimal   no-undo .     define variable v-cost-other-rubl     as decimal   no-undo .     define variable v-cost-discnt-base    as decimal   no-undo .     define variable v-cost-discnt-rubl    as decimal   no-undo .
     4947             define variable v-crsa-sum-base       as decimal   no-undo .     define variable v-crsa-sum-rubl       as decimal   no-undo .     define variable v-crsa-vat-base       as decimal   no-undo .     define variable v-crsa-vat-rubl       as decimal   no-undo .     define variable v-crsa-slt-base       as decimal   no-undo .     define variable v-crsa-slt-rubl       as decimal   no-undo .     define variable v-crsa-road-tax-base  as decimal   no-undo .     define variable v-crsa-road-tax-rubl  as decimal   no-undo .     define variable v-crsa-excise-base    as decimal   no-undo .     define variable v-crsa-excise-rubl    as decimal   no-undo .     define variable v-crsa-transport-base as decimal   no-undo .     define variable v-crsa-transport-rubl as decimal   no-undo .     define variable v-crsa-other-base     as decimal   no-undo .     define variable v-crsa-other-rubl     as decimal   no-undo .     define variable v-crsa-discnt-base    as decimal   no-undo .     define variable v-crsa-discnt-rubl    as decimal   no-undo .
     4948             define variable v-sale-sum-base       as decimal   no-undo .     define variable v-sale-sum-rubl       as decimal   no-undo .     define variable v-sale-vat-base       as decimal   no-undo .     define variable v-sale-vat-rubl       as decimal   no-undo .     define variable v-sale-slt-base       as decimal   no-undo .     define variable v-sale-slt-rubl       as decimal   no-undo .     define variable v-sale-road-tax-base  as decimal   no-undo .     define variable v-sale-road-tax-rubl  as decimal   no-undo .     define variable v-sale-excise-base    as decimal   no-undo .     define variable v-sale-excise-rubl    as decimal   no-undo .     define variable v-sale-transport-base as decimal   no-undo .     define variable v-sale-transport-rubl as decimal   no-undo .     define variable v-sale-other-base     as decimal   no-undo .     define variable v-sale-other-rubl     as decimal   no-undo .     define variable v-sale-discnt-base    as decimal   no-undo .     define variable v-sale-discnt-rubl    as decimal   no-undo .
     4949     do
     4950     on error undo, return error
     4951     :
     4952       run clcprtsl_calc-line in this-procedure
     4953         (input p-doc-line-recid
     4954         ) no-error .
     4955       if error-status :error
     4956       then do:
     4957         v-msgstr =
     4958           "Ошибка при вызове процедуры clcprtsl_calc-line" + chr(10)
     4959           + "Документ " + p-doc-code + chr(10)
     4960           + "Артикул " + p-artic + " " + p-prod-type + " " + string(p-prod-code) + chr(10)
     4961           + error-status:get-message(1) + chr(10)
     4962           + return-value
     4963         .
     4964         if v-message-on then
     4965           message
     4966             vss-workfile vss-revision vss-description skip
     4967             v-msgstr skip
     4968             view-as alert-box error .
     4969         undo, return error v-msgstr .
     4970       end.
     4971       aht-type_block:
     4972       do v-aht-type-ind = 1 to extent(v-aht-type-list)
     4973       :
     4974         assign
     4975           v-aht-type = v-aht-type-list[v-aht-type-ind]
     4976         .
     4977         run aht_get-sum-type in this-procedure
     4978           (input  v-aht-type
     4979           ,output v-allsum-sum-type
     4980           ) .
     4981         define buffer buf_tt-allsum-line for tt-allsum-line .
     4982         find first buf_tt-allsum-line
     4983           where buf_tt-allsum-line.sum-type = v-allsum-sum-type
     4984           no-error .
     4985         if not available buf_tt-allsum-line
     4986         then do:
     4987           next aht-type_block .
