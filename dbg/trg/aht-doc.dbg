      397         end.
      398       end.
      399       if p-stk-sum-type <> 'v':U
      400       then do:
      401         for each buf_aht-stk-line exclusive-lock
      402           where buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
      403             and buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
