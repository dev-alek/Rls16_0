     3552   procedure clcprtsl_calc-line :
     3553   define input  parameter parrec-line as recid no-undo.
     3554   define variable v-tax-date         as   date                     no-undo.
     3555   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3556   define variable varr-b             as   character                no-undo.
     3557   define variable varr-btype         as   character                no-undo.
     3558   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3559   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3560   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3561   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3562   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3563   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3564   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3565   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3566   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3567   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3568   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3569   define variable varexcise          like ub.price-list.excise     no-undo.
     3570   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3571   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3572   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3573   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3574   define variable v-varsum           as decimal                  no-undo.
     3575   define variable varprice-salef as decimal   no-undo .
     3576   define buffer bf_trn-doc             for ub.trn-doc.
     3577   define buffer bf_doc-line            for ub.doc-line.
     3578   define buffer bf_gds-dtl             for ub.gds-dtl.
     3579   define buffer bf_goods               for ub.goods.
     3580   define buffer bf_parts               for ub.parts.
     3581   define buffer bf_sysconf             for ub.sysconf.
     3582   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3583   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3584   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3585   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3586   define buffer buf_parts        for ub.parts.
     3587   v-calcbypart = no.
     3588   do on error undo, return error return-value :
     3589   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3590   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3591     (output varr-b
     3592     )  .
     3593     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3594     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3595     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3596                               bf_goods.prod-type = bf_doc-line.prod-type and
     3597                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3598     if bf_trn-doc.fact-date <> ?        then do:
     3599       assign v-tax-date = bf_trn-doc.fact-date.
     3600     end.
     3601     else do:
     3602       assign v-tax-date = ?.
     3603     end.
     3604   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3606     (input  bf_goods.gds-code
     3607     ,input  '1':U
     3608     ,input  v-tax-date
     3609     ,input  bf_trn-doc.host-code
     3610     ,input  bf_trn-doc.obj-type
     3611     ,input  bf_trn-doc.obj-code
     3612     ,output v-vat-pc
     3613     ) no-error .
     3614     if error-status :error
     3615     or v-vat-pc = ? then do:
     3616        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3617     end.
     3618     if bf_goods.gds-type = 'у':U or
     3619        bf_trn-doc.status_ = 'запрос':U then do:
     3620       for each bf_tt-allsum-line
     3621       on error undo, return error return-value
     3622        :
     3623         delete bf_tt-allsum-line.
     3624       end.
     3625       create bf_tt-allsum-line.
     3626       assign
     3627        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3628       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3629                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3630                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3631                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3632         assign
     3633           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3634           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3635           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3636           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3637           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3638           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3639           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3640           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3641           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3642           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3643           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3644           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3645           bf_tt-allsum-line.vat-cli-acc          =  ?
     3646           .
