     3248       bfs_tt-allsum.vat-rubl-buyer-cur  =  - bf_tt-allsum.vat-rubl-buyer-cur
     3249       bfs_tt-allsum.slt-base-cur        =  - bf_tt-allsum.slt-base-cur
     3250       bfs_tt-allsum.slt-rubl-cur        =  - bf_tt-allsum.slt-rubl-cur
     3251       bfs_tt-allsum.road-tax-base-cur   =  - bf_tt-allsum.road-tax-base-cur
     3252       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     3253       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     3254       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
     3255       bfs_tt-allsum.sum-dsc-base-acc    =  - bf_tt-allsum.sum-dsc-base-acc
     3256       bfs_tt-allsum.sum-dsc-rubl-acc    =  - bf_tt-allsum.sum-dsc-rubl-acc
     3257       bfs_tt-allsum.sum-dsc-cli-acc     =  - bf_tt-allsum.sum-dsc-cli-acc
     3258       bfs_tt-allsum.dsc-base-acc        =  - bf_tt-allsum.dsc-base-acc
     3259       bfs_tt-allsum.dsc-rubl-acc        =  - bf_tt-allsum.dsc-rubl-acc
     3260       bfs_tt-allsum.dsc-cli-acc         =  - bf_tt-allsum.dsc-cli-acc
     3261       bfs_tt-allsum.vat-base-acc        =  - bf_tt-allsum.vat-base-acc
     3262       bfs_tt-allsum.vat-rubl-acc        =  - bf_tt-allsum.vat-rubl-acc
     3263       bfs_tt-allsum.vat-cli-acc         =  - bf_tt-allsum.vat-cli-acc
     3264       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     3265       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     3266       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     3267       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     3268       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     3269       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     3270       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     3271       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     3272       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     3273       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     3274       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     3275       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     3276       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     3277       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     3278       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     3279   end.
     3280   create bfpc_tt-allsum.
     3281   create bfspc_tt-allsum.
     3282   case cl_tt-clcparts.purch-code :
     3283   when 1           then do:
     3284     assign
     3285       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     3286       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     3287     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     3288     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     3289   end.
     3290   when 4    then do:
     3291     assign
     3292       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     3293       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     3294     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     3295     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     3296   end.
     3297   when 3 then do:
     3298     assign
     3299       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     3300       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     3301     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     3302     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     3303   end.
     3304   when 2 then do:
     3305     assign
     3306       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     3307       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     3308     assign
     3309       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     3310       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     3311       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     3312       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
     3313       bfpc_tt-allsum.dsc-base-doc        = bf_tt-allsum.dsc-base-doc        - bf_tt-allsum.dsc-base-acc
     3314       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
     3315       bfpc_tt-allsum.vat-base-doc        = bf_tt-allsum.vat-base-doc
     3316       bfpc_tt-allsum.vat-rubl-doc        = bf_tt-allsum.vat-rubl-doc
     3317       bfpc_tt-allsum.vat-base-buyer-doc  = bf_tt-allsum.vat-base-buyer-doc  - bf_tt-allsum.vat-base-acc
     3318       bfpc_tt-allsum.vat-rubl-buyer-doc  = bf_tt-allsum.vat-rubl-buyer-doc  - bf_tt-allsum.vat-rubl-acc
