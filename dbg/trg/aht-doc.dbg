     4390   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4392     (output varoutvprbprl
     4393     )  .
     4394   if varoutvprbprl = "base":u then do:
     4395     assign
     4396           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     4397       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     4398     .
     4399   end.
     4400   else do:
     4401     assign
     4402           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     4403       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     4404     .
     4405   end.
     4406   if varoutvprbprl = "rubl":u then do:
     4407     assign
     4408           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     4409       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     4410   end.
     4411   else do:
     4412     assign
     4413           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     4414       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     4415   end.
     4416   assign
     4417     varis-cons-parts-haveprl =  no.
     4418   assign
     4419     varfact-qntyprl       = 0
     4420     varcons-qntyprl       = 0
     4421     varprice-base-consprl = 0
     4422     varprice-rubl-consprl = 0.
     4423   find first out-vatp_doc-lineprl where
     4424              out-vatp_doc-lineprl.doc-code   = vardoc-num
     4425          and out-vatp_doc-lineprl.artic      = varartic
     4426          and out-vatp_doc-lineprl.prod-type  = varprod-type
     4427          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     4428   if available out-vatp_doc-lineprl           and
     4429     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     4430     assign
     4431       varfact-qntyprl = out-vatp_doc-lineprl.fact-qnty.
     4432   end.
     4433   else do:
