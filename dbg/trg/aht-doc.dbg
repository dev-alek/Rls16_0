     5109           if v-message-on then
     5110             message
     5111               vss-workfile vss-revision vss-description skip
     5112               v-msgstr skip
     5113               view-as alert-box error .
     5114           undo, return error v-msgstr .
     5115         end.
     5116       end.
     5117     end.
     5118   end procedure.
     5119   procedure show-action :
     5120     do
     5121     on error undo, return error
     5122     :
     5123       define input parameter p-action as character no-undo .
     5124       define variable v-today as date      no-undo.
     5125       define variable v-time  as integer   no-undo.
     5126       run cur-time in this-procedure ( output v-today
     5127                                      , output v-time
     5128                                      ).
     5129       assign
     5130         v-current-time = string(v-time - v-start-time, "HH:MM:SS")
     5131         v-current-action = p-action
     5132       .
     5133       if mFrameView
     5134       then display
     5135         v-current-time
     5136         v-current-action
     5137         with frame a.
     5138     end.
     5139   end procedure.
