     1941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1942     (input  buf_gds-dtl.obj-type
     1943     ,input  buf_gds-dtl.obj-code
     1944     ,input  v-prt-b-code
     1945     ,input  0
     1946     ,input  buf_trn-doc.fact-order
     1947     ,output parrecid-prl
     1948     ,output v-cli-base-rate
     1949     ) no-error .
     1950         if error-status :error then do:
     1951           message
     1952             vss-workfile vss-revision vss-description skip
     1953             "Ошибка при поиске строки переоценки для бар-кода" skip
     1954             "Документ" p-doc-code skip
     1955             "Артикул" p-artic p-prod-type p-prod-code skip
     1956             "Объект" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
     1957             "Бар-код" v-prt-b-code skip
     1958             error-status :get-message(1) skip
     1959             return-value skip
     1960             view-as alert-box error .
     1961           undo, return error .
     1962         end.
     1963         if parrecid-prl <> ? then do:
     1964           run prl-vat in this-procedure
     1965             (input  parrecid-prl
     1966             ,output price-rubl-with-tax-sale-prl
     1967             ,output price-base-with-tax-sale-prl
     1968             ,output price-rubl-without-tax-sale-prl
     1969             ,output price-base-without-tax-sale-prl
     1970             ,output vat-base-sale-prl
     1971             ,output vat-rubl-sale-prl
     1972             ,output vat-base-buyer-prl
     1973             ,output vat-rubl-buyer-prl
     1974             ,output slt-base-sale-prl
     1975             ,output slt-rubl-sale-prl
     1976             ,output road-tax-base-sale-prl
     1977             ,output road-tax-rubl-sale-prl
     1978             ,output excise-base-sale-prl
     1979             ,output excise-rubl-sale-prl
     1980             ,output discnt-base-sale-prl
     1981             ,output discnt-rubl-sale-prl
     1982             ) no-error .
     1983           if error-status :error then do:
     1984             message
     1985               vss-workfile vss-revision vss-description skip
     1986               "Ошибка при вызове процеды prl-vat" skip
     1987               "Документ" p-doc-code skip
     1988               "Артикул" p-artic p-prod-type p-prod-code skip
     1989               error-status :get-message(1) skip
     1990               return-value skip
     1991               view-as alert-box error .
     1992             undo, return error .
     1993           end.
     1994         end.
     1995         else do:
     1996           assign
     1997             price-rubl-with-tax-sale-prl    = 0
     1998             price-base-with-tax-sale-prl    = 0
     1999             price-rubl-without-tax-sale-prl = 0
     2000             price-base-without-tax-sale-prl = 0
     2001             vat-base-sale-prl               = 0
     2002             vat-rubl-sale-prl               = 0
     2003             slt-base-sale-prl               = 0
     2004             slt-rubl-sale-prl               = 0
     2005             road-tax-base-sale-prl          = 0
     2006             road-tax-rubl-sale-prl          = 0
     2007             excise-base-sale-prl            = 0
     2008             excise-rubl-sale-prl            = 0
     2009             discnt-base-sale-prl            = 0
     2010             discnt-rubl-sale-prl            = 0
     2011           .
     2012         end.
     2013         define variable v-fact-qnty         as decimal   no-undo .
     2014         define variable v-cur-base          as decimal   no-undo .
     2015         define variable v-cur-VAT-base      as decimal   no-undo .
     2016         define variable v-cur-SLT-base      as decimal   no-undo .
     2017         define variable v-cur-road-tax-base as decimal   no-undo .
     2018         define variable v-cur-excise-base   as decimal   no-undo .
     2019         assign
     2020           v-fact-qnty         = v-fact-qnty
     2021                               + v-gds-dtl-fact-qnty
     2022           v-cur-base          = v-cur-base
     2023                               + (if p-curr-r-b = 'base':U
     2024                                  then price-base-with-tax-sale-prl
     2025                                  else price-rubl-with-tax-sale-prl
     2026                                 )
     2027                               * v-gds-dtl-fact-qnty
     2028           v-cur-VAT-base      = v-cur-VAT-base
     2029                               + (if p-curr-r-b = 'base':U
     2030                                  then vat-base-sale-prl
     2031                                  else vat-rubl-sale-prl
     2032                                 )
     2033                               * v-gds-dtl-fact-qnty
     2034           v-cur-SLT-base      = v-cur-SLT-base
     2035                               + (if p-curr-r-b = 'base':U
     2036                                  then slt-base-sale-prl
     2037                                  else slt-rubl-sale-prl
     2038                                 )
     2039                               * v-gds-dtl-fact-qnty
     2040           v-cur-road-tax-base = v-cur-road-tax-base
     2041                               + (if p-curr-r-b = 'base':U
     2042                                  then road-tax-base-sale-prl
     2043                                  else road-tax-rubl-sale-prl
     2044                                 )
     2045                               * v-gds-dtl-fact-qnty
     2046           v-cur-excise-base   = v-cur-excise-base
     2047                               + (if p-curr-r-b = 'base':U
     2048                                  then excise-base-sale-prl
     2049                                  else excise-rubl-sale-prl
     2050                                 )
     2051                               * v-gds-dtl-fact-qnty
     2052         .
     2053       end.
     2054       assign
     2055         p-fact-qnty = v-fact-qnty
     2056       .
     2057       define variable v-base-rate                 like ub.curr-accnt.exch-rate no-undo .
     2058       define variable v-base-scale                like ub.curr-accnt.exch-scale no-undo .
     2059     assign
     2060       v-base-rate  = buf_trn-doc.base-rate
     2061       v-base-scale = buf_trn-doc.base-scale
     2062     .
     2063       if p-curr-r-b = 'base':U then do:
     2064         assign
     2065           p-sum-base       = v-cur-base
     2066           p-sum-rubl       = v-cur-base     * v-base-rate / v-base-scale
     2067           p-vat-base       = v-cur-VAT-base
     2068           p-vat-rubl       = v-cur-VAT-base * v-base-rate / v-base-scale
     2069           p-slt-base       = v-cur-SLT-base
     2070           p-slt-rubl       = v-cur-SLT-base * v-base-rate / v-base-scale
     2071           p-road-tax-base  = v-cur-road-tax-base
     2072           p-road-tax-rubl  = v-cur-road-tax-base * v-base-rate / v-base-scale
     2073           p-excise-base    = v-cur-excise-base
     2074           p-excise-rubl    = v-cur-excise-base * v-base-rate / v-base-scale
     2075           p-transport-base = 0
     2076           p-transport-rubl = 0
     2077           p-other-base     = 0
     2078           p-other-rubl     = 0
     2079         .
     2080       end.
     2081       else do:
     2082         assign
     2083           p-sum-base       = v-cur-base     / v-base-rate * v-base-scale
     2084           p-sum-rubl       = v-cur-base
     2085           p-vat-base       = v-cur-VAT-base / v-base-rate * v-base-scale
     2086           p-vat-rubl       = v-cur-VAT-base
     2087           p-slt-base       = v-cur-SLT-base / v-base-rate * v-base-scale
     2088           p-slt-rubl       = v-cur-SLT-base
     2089           p-road-tax-base  = v-cur-road-tax-base / v-base-rate * v-base-scale
     2090           p-road-tax-rubl  = v-cur-road-tax-base
     2091           p-excise-base    = v-cur-excise-base / v-base-rate * v-base-scale
     2092           p-excise-rubl    = v-cur-excise-base
     2093           p-transport-base = 0
     2094           p-transport-rubl = 0
     2095           p-other-base     = 0
     2096           p-other-rubl     = 0
     2097         .
     2098       end.
     2099     end.
     2100   end procedure.
