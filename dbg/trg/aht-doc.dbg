     3890       end.
     3891       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3892       assign
     3893         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3894       if varcur-cons-vat-pc = ? then do:
     3895         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3896       end.
     3897       define buffer buf_tt-clcparts for tt-clcparts .
     3898       for each buf_tt-clcparts
     3899       on error undo, return error return-value
     3900       :
     3901         delete buf_tt-clcparts.
     3902       end.
     3903       for each bf_parts no-lock
     3904         where bf_parts.out-code  = bf_doc-line.doc-code
     3905           and bf_parts.obj-type  = bf_doc-line.obj-type
     3906           and bf_parts.obj-code  = bf_doc-line.obj-code
     3907           and bf_parts.artic     = bf_doc-line.artic
     3908           and bf_parts.prod-type = bf_doc-line.prod-type
     3909           and bf_parts.prod-code = bf_doc-line.prod-code
     3910       on error undo, return error return-value
     3911       :
     3912         create buf_tt-clcparts .
     3913         buffer-copy bf_parts to buf_tt-clcparts .
     3914         if v-calcbypart = yes   then do:
     3915   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3916     (buffer bf_parts
     3917     ,output v-b-pcode
     3918     ) no-error .
     3919   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3921     (input  bf_parts.obj-type
     3922     ,input  bf_parts.obj-code
     3923     ,input  v-b-pcode
     3924     ,input  0
     3925     ,input  bf_trn-doc.fact-order
     3926     ,output vardoc-num
     3927     ,output varprice-salef
     3928     ,output varroad-tax
     3929     ,output varexcise
     3930     ) no-error .
     3931             if varprice-sale = ?
     3932             then do:
     3933               assign
     3934                 varprice-salef = 0
     3935                 varroad-tax   = 0
     3936                 varexcise     = 0
     3937               .
     3938             end.
     3939             assign
     3940             part-cur-base  = varprice-salef
     3941             part-cur-road-tax  = varroad-tax
     3942             part-cur-excise = varexcise.
     3943         end.
     3944       end.
     3945       run clcprtsl_calc-ttable in this-procedure
     3946         (input yes,
     3947          input yes,
     3948          input bf_doc-line.road-tax,
     3949          input bf_doc-line.excise,
     3950          input bf_doc-line.vat-pc,
     3951          input bf_doc-line.cons-vat-pc,
     3952          input bf_doc-line.slt-pc,
     3953          input bf_trn-doc.base-rate,
     3954          input bf_trn-doc.base-scale,
     3955          input varr-b,
     3956          input varcur-base,
     3957          input varcur-road-tax,
     3958          input varcur-excise,
     3959          input varcur-vat-pc,
     3960          input varcur-cons-vat-pc,
     3961          input varcur-slt-pc
     3962          ) no-error.
     3963       if error-status:error then do:
     3964         message
     3965           vss-workfile vss-revision vss-description skip
     3966           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3967           return-value skip
     3968           trim(error-status :get-message(1))
     3969           trim(error-status :get-message(2))
     3970           trim(error-status :get-message(3))
     3971           trim(error-status :get-message(4))
     3972           trim(error-status :get-message(5)) skip
     3973           view-as alert-box error.
     3974         undo, return error .
     3975       end.
     3976     end.
     3977   end.
     3978   end.
     3979   procedure clcprtsl_calc-ttable :
     3980   define input parameter paris-doc           as   logical                 no-undo.
     3981   define input parameter paris-cur           as   logical                 no-undo.
     3982   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3983   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3984   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3985   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3986   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3987   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3988   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3989   define input parameter parr-b              as   character               no-undo.
     3990   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3991   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3992   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3993   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3994   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3995   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3996   define buffer bf_tt-allsum      for tt-allsum.
     3997   define buffer bf_tt-clcparts    for tt-clcparts.
     3998   define buffer bf_tt-allsum-line for tt-allsum-line.
     3999   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4000   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4001   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4002   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4003   define variable varexcise          like ub.price-list.excise     no-undo.
     4004   do on error undo, return error return-value :
     4005   for each bf_tt-allsum-line
     4006   on error undo, return error return-value
     4007    :
     4008     delete bf_tt-allsum-line.
     4009   end.
     4010   for each bf_tt-allsum
     4011   on error undo, return error return-value
     4012   :
     4013     delete bf_tt-allsum.
     4014   end.
     4015   for each bf_tt-clcparts
     4016   on error undo, return error return-value
     4017   :
     4018   if v-calcbypart then do:
     4019             assign
     4020             parcur-base =   bf_tt-clcparts.part-cur-base
     4021             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     4022             parcur-excise =   bf_tt-clcparts.part-cur-excise
     4023             .
     4024   end.
     4025      run clcprtsl_calc-parts in this-procedure (
     4026        input recid(bf_tt-clcparts),
     4027        input paris-doc,
     4028        input paris-cur,
     4029        input parroad-tax,
     4030        input parexcise,
     4031        input parvat-pc,
     4032        input parcons-vat-pc,
     4033        input parslt-pc,
     4034        input parbase-rate,
     4035        input parbase-scale,
     4036        input parr-b,
     4037        input parcur-base,
     4038        input parcur-road-tax,
     4039        input parcur-excise,
     4040        input parcur-vat-pc,
     4041        input parcurcons-vat-pc,
     4042        input parcurslt-pc
     4043        ) no-error.
     4044     if error-status:error then do:
     4045       message
     4046         vss-workfile vss-revision vss-description skip
     4047         vss-include-info13 skip
     4048         "Ошибка при обсчете партии" skip
     4049         "Документ партии " bf_tt-clcparts.out-code skip
     4050         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     4051         return-value skip
     4052         error-status:get-message(1) skip
     4053         error-status:get-message(2) skip
     4054         error-status:get-message(3) skip
     4055         view-as alert-box error .
     4056       undo, return error .
     4057     end.
     4058     for each bf_tt-allsum on error undo, return error return-value :
     4059       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     4060       if not available bf_tt-allsum-line then do:
     4061         create bf_tt-allsum-line.
     4062         assign
     4063           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     4064       end.
     4065       assign
     4066         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     4067         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     4068         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     4069         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     4070         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     4071         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     4072         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     4073         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     4074         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     4075         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     4076         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     4077         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     4078         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     4079         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     4080         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     4081         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     4082         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     4083         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     4084         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     4085         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     4086         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     4087         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     4088         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     4089         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     4090         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     4091         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     4092         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     4093         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     4094         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     4095         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     4096         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     4097         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     4098         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     4099         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     4100         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     4101         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     4102         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     4103         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     4104         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     4105         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
