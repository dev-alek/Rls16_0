      382           new-buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
      383           new-buf_aht-stk-line.fact-order = p-fact-order
      384           new-buf_aht-stk-line.sum-type   = p-stk-sum-type
      385         .
      386         if available buf_aht-stk-line then do:
      387           assign
      388             new-buf_aht-stk-line.fact-qnty = buf_aht-stk-line.fact-qnty
