     4156       define variable varroot-nodeprl             as   integer                             no-undo.
     4157       define variable varempty-scaleprl           as   logical                             no-undo.
     4158       define variable varis-cons-parts-haveprl    as   logical                             no-undo.
     4159       define variable varsum-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4160       define variable varslt-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4161       define variable varvat-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4162       define variable varvatcons-base-factovpprl  like ub.gds-dtl.price-base               no-undo.
     4163       define variable vardsc-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4164       define variable varsum-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4165       define variable varslt-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4166       define variable varvat-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4167       define variable varvatcons-base-docovpprl   like ub.gds-dtl.price-base               no-undo.
     4168       define variable vardsc-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4169       define variable varsum-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4170       define variable varslt-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4171       define variable varvat-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4172       define variable varvatcons-rubl-factovpprl  like ub.gds-dtl.price-base               no-undo.
     4173       define variable vardsc-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
