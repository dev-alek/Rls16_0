     1711   end procedure.
     1712   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1713   procedure r-crsa :
     1714     define input parameter  p-doc-code       like ub.doc-line.doc-code  no-undo .
     1715     define input parameter  p-artic          like ub.doc-line.artic     no-undo .
     1716     define input parameter  p-prod-type      like ub.doc-line.prod-type no-undo .
     1717     define input parameter  p-prod-code      like ub.doc-line.prod-code no-undo .
     1718     define input  parameter p-curr-r-b       as character no-undo .
     1719     define output parameter p-fact-qnty      as decimal   no-undo .
     1720     define output parameter p-vat-pc         as decimal   no-undo .
     1721     define output parameter p-slt-pc         as decimal   no-undo .
     1722     define output parameter p-sum-base       as decimal   no-undo .
     1723     define output parameter p-sum-rubl       as decimal   no-undo .
     1724     define output parameter p-vat-base       as decimal   no-undo .
     1725     define output parameter p-vat-rubl       as decimal   no-undo .
     1726     define output parameter p-slt-base       as decimal   no-undo .
     1727     define output parameter p-slt-rubl       as decimal   no-undo .
     1728     define output parameter p-road-tax-base  as decimal   no-undo .
     1729     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1730     define output parameter p-transport-base as decimal   no-undo .
     1731     define output parameter p-transport-rubl as decimal   no-undo .
     1732     define output parameter p-other-base     as decimal   no-undo .
     1733     define output parameter p-other-rubl     as decimal   no-undo .
     1734     define output parameter p-excise-base    as decimal   no-undo .
     1735     define output parameter p-excise-rubl    as decimal   no-undo .
     1736     define variable vss-description as character no-undo initial "r-crsa-01: суммы товара в текущих продажных ценах на момент закрытия документа".
     1737     define buffer buf_gds-dtl  for ub.gds-dtl .
     1738     define buffer buf_doc-line for ub.doc-line .
     1739     define buffer buf_trn-doc  for ub.trn-doc .
     1740     do
     1741     on error undo, return error return-value
     1742     :
     1743       find first buf_doc-line no-lock
     1744         where buf_doc-line.doc-code  = p-doc-code
     1745           and buf_doc-line.artic     = p-artic
     1746           and buf_doc-line.prod-type = p-prod-type
     1747           and buf_doc-line.prod-code = p-prod-code
     1748         no-error .
     1749       if not available buf_doc-line then do:
     1750         message
     1751           vss-workfile vss-revision vss-description skip
     1752           vss-include-info10 skip
     1753           "Ошибка задания входных параметров" skip
     1754           "Не найдена строка документа" skip
     1755           "Документ" p-doc-code skip
     1756           "Артикул" p-artic p-prod-type p-prod-code skip
     1757           view-as alert-box error .
     1758         undo, return error .
     1759       end.
     1760       find first buf_trn-doc no-lock
     1761         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1762         no-error .
     1763       if not available buf_trn-doc then do:
     1764         message
     1765           vss-workfile vss-revision vss-description skip
     1766           vss-include-info10 skip
     1767           "Не найден документ" skip
     1768           "Документ" p-doc-code skip
     1769           "Артикул" p-artic p-prod-type p-prod-code skip
     1770           view-as alert-box error .
     1771         undo, return error .
     1772       end.
     1773       define variable v-gds-dtl-fact-qnty       as decimal   no-undo .
     1774       define variable v-total-gds-dtl-fact-qnty as decimal   no-undo .
     1775       for each buf_gds-dtl no-lock
     1776         where buf_gds-dtl.doc-code  = p-doc-code
     1777           and buf_gds-dtl.artic     = p-artic
     1778           and buf_gds-dtl.prod-type = p-prod-type
     1779           and buf_gds-dtl.prod-code = p-prod-code
     1780       on error undo, return error
     1781       :
     1782         if buf_trn-doc.doc-type <> 'инв':U then do:
     1783           if buf_trn-doc.doc-type = 'при':U
     1784           or buf_trn-doc.doc-type = 'возврат':U
     1785           then do:
     1786             assign
     1787               v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1788             .
     1789           end.
     1790           else do:
     1791             assign
     1792               v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1793             .
     1794           end.
     1795         end.
     1796         else do:
     1797           assign
     1798             v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1799           .
     1800         end.
     1801         assign
     1802           v-total-gds-dtl-fact-qnty = v-total-gds-dtl-fact-qnty
     1803                                     + v-gds-dtl-fact-qnty
     1804         .
     1805         define variable v-gds-code      as integer   no-undo .
     1806         define variable v-prt-b-code    like ub.bar-code.b-code no-undo .
     1807         define variable v-cli-base-rate like ub.bar-code.cli-base-rate no-undo .
     1808   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1810     (input  p-artic
     1811     ,input  p-prod-type
     1812     ,input  p-prod-code
     1813     ,output v-gds-code
     1814     ) no-error .
     1815         if error-status :error then do:
     1816           message
     1817             vss-workfile vss-revision vss-description skip
     1818             "Ошибка при определении кода товара" skip
     1819             "Документ" p-doc-code skip
     1820             "Артикул" p-artic p-prod-type p-prod-code skip
     1821             error-status :get-message(1) skip
     1822             return-value skip
     1823             view-as alert-box error .
     1824           undo, return error .
     1825         end.
     1826   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1827     (input  v-gds-code
     1828     ,input  buf_gds-dtl.prt-code
     1829     ,output v-prt-b-code
     1830     ) no-error .
     1831         if error-status :error then do:
     1832           message
     1833             vss-workfile vss-revision vss-description skip
     1834             "Ошибка при определении бар-кода признака" skip
     1835             "Код товара" v-gds-code  skip
     1836             "Код признака" buf_gds-dtl.prt-code skip
     1837             "Документ" p-doc-code skip
     1838             "Артикул" p-artic p-prod-type p-prod-code skip
     1839             error-status :get-message(1) skip
     1840             return-value skip
     1841             view-as alert-box error .
     1842           undo, return error .
     1843         end.
     1844         define variable parrecid-prl as recid     no-undo .
