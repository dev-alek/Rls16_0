     5026           v-sale-vat-base       = buf_tt-allsum-line.vat-base-doc
     5027           v-sale-vat-rubl       = buf_tt-allsum-line.vat-rubl-doc
     5028           v-sale-slt-base       = buf_tt-allsum-line.slt-base-doc
