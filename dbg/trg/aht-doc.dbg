     1351       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     1352       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     1353       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1354       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1355       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1356       define variable varinvatp-envdo             as   character              no-undo.
     1357       define variable varinvatp-typeo             as   character              no-undo.
     1358       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     1359       define buffer buf_gds-dtl  for ub.gds-dtl .
     1360       define buffer buf_goods    for ub.goods .
     1361       define buffer buf_trn-doc  for ub.trn-doc .
     1362       define buffer buf_doc-line for ub.doc-line .
     1363       find first buf_doc-line no-lock
     1364         where buf_doc-line.doc-code  = p-doc-code
     1365           and buf_doc-line.artic     = p-artic
     1366           and buf_doc-line.prod-type = p-prod-type
     1367           and buf_doc-line.prod-code = p-prod-code
     1368         no-error .
     1369       if not available buf_doc-line then do:
     1370         message
     1371           vss-workfile vss-revision vss-description skip
     1372           vss-include-info6 skip
     1373           "Ошибка задания входных параметров" skip
     1374           "Не найдена строка документа" skip
     1375           "Документ" p-doc-code skip
     1376           "Артикул" p-artic p-prod-type p-prod-code skip
     1377           view-as alert-box error .
     1378         undo, return error .
     1379       end.
     1380       find first buf_trn-doc no-lock
     1381         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1382         no-error .
     1383       if not available buf_trn-doc then do:
     1384         message
     1385           vss-workfile vss-revision vss-description skip
     1386           vss-include-info6 skip
     1387           "Не найден документ" skip
     1388           "Документ" p-doc-code skip
     1389           "Артикул" p-artic p-prod-type p-prod-code skip
     1390           view-as alert-box error .
     1391         undo, return error .
     1392       end.
     1393       for each buf_gds-dtl no-lock
     1394         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     1395           and buf_gds-dtl.artic     = buf_doc-line.artic
     1396           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1397           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1398       on error undo, return error
     1399       :
     1400           if buf_trn-doc.doc-type <> 'инв':U
     1401           then do:
     1402               if buf_trn-doc.doc-type = 'при':U
     1403               or buf_trn-doc.doc-type = 'возврат':U
     1404               then do:
     1405                   assign
     1406                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1407                   .
     1408               end.
     1409               else do:
     1410                   assign
     1411                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1412                   .
     1413               end.
     1414           end.
     1415           else do:
     1416               assign
     1417                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1418               .
     1419           end.
     1420           if v-gds-dtl-fact-qnty <> 0
     1421           then do:
     1422   if buf_trn-doc.ext-doc-type = 'ot':U or
     1423      buf_trn-doc.ext-doc-type = ?                 then do:
     1424     assign
     1425      out-vatp-have-vat-slt = yes.
     1426   end.
     1427   else do:
     1428     find first out-vatp_doc-attr no-lock
     1429       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1430         and out-vatp_doc-attr.attr-code = 'envd':U
     1431         no-error .
     1432     if not available out-vatp_doc-attr then do:
     1433       assign
     1434         out-vatp-have-vat-slt = yes.
     1435     end.
     1436     else do:
     1437        out-vatp-have-vat-slt = no.
     1438     end.
     1439   end.
     1440   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     1441                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     1442                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     1443   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1444   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1445     (input  buf_doc-line.artic
     1446     ,input  buf_doc-line.prod-type
     1447     ,input  buf_doc-line.prod-code
     1448     ,output varroot-node
     1449     ) no-error .
     1450   if error-status :error then do:
     1451     message
     1452       vss-workfile vss-revision vss-description skip
     1453       "Ошибка при определении корневого признака товара" skip
     1454       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1455       error-status :get-message(1) skip
     1456       return-value skip
     1457       view-as alert-box error .
     1458     undo, return error .
     1459   end.
     1460   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1461     (input  varroot-node
     1462     ,input  'empty-scale=request'
     1463     ,output varempty-scale
     1464     ) no-error .
     1465   if error-status :error then do:
     1466     message
     1467       vss-workfile vss-revision vss-description skip
     1468       "Ошибка при определении атрибута признака" skip
     1469       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1470       "Признак" varroot-node skip
     1471       "Запрашивался атрибут" "empty-scale=request" skip
     1472       error-status :get-message(1) skip
     1473       return-value skip
     1474       view-as alert-box error .
     1475     undo, return error .
     1476   end.
     1477   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1479     (output varoutvprb
     1480     )  .
     1481   if varoutvprb = "base":u then do:
     1482     assign
     1483           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1484       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     1485     .
     1486   end.
     1487   else do:
     1488     assign
     1489           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1490       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1491     .
     1492   end.
     1493   if varoutvprb = "rubl":u then do:
     1494     assign
     1495           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1496       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     1497   end.
     1498   else do:
     1499     assign
     1500           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     1501       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     1502   end.
     1503   assign
     1504     varis-cons-parts-have =  no.
     1505   assign
     1506     varfact-qnty       = 0
     1507     varcons-qnty       = 0
     1508     varprice-base-cons = 0
     1509     varprice-rubl-cons = 0.
     1510   find first out-vatp_doc-line where
     1511              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     1512          and out-vatp_doc-line.artic      = buf_doc-line.artic
     1513          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     1514          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     1515   if available out-vatp_doc-line           and
     1516     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1517     assign
     1518       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1519   end.
     1520   else do:
     1521     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     1522                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     1523                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     1524                                  and out-vatp_parts.artic      = buf_doc-line.artic
     1525                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     1526                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     1527       if out-vatp_parts.purch-code = 2 then do:
     1528   assign
     1529     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1530     price-base-with-tax-loco = out-vatp_parts.price-base
     1531   .
     1532   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1533   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1534     (output varinvprbo
     1535     )  .
     1536     if out-vatp_parts.out-code = 'free-zone':U     or
     1537        out-vatp_parts.out-code = 'out-zone':U   or
     1538        out-vatp_parts.doc-type = 'акт':U then do:
     1539       assign
     1540         in-vatp-have-vat-slto = yes.
     1541     end.
     1542     else do:
     1543       find first in-vatp_doc-attro no-lock
     1544         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1545           and in-vatp_doc-attro.attr-code = 'envd':U
     1546         no-error .
     1547       if not available in-vatp_doc-attro then do:
     1548         assign
     1549           in-vatp-have-vat-slto = yes.
     1550       end.
     1551       else do:
     1552            in-vatp-have-vat-slto = no.
     1553       end.
     1554     end.
     1555     assign
     1556      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1557      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1558     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1559              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1560     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     1561             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     1562             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     1563             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     1564             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     1565             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     1566             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1567       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1568     assign
     1569       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     1570     assign
     1571       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     1572       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     1573       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     1574       transport-cli-loco  = 0
     1575       other-cli-loco      = 0
     1576     .
     1577   ASSIGN
     1578             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     1579       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     1580   .
     1581         assign
     1582           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     1583           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     1584         assign
     1585           varis-cons-parts-have = yes
     1586           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     1587       end.
     1588       assign
     1589         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     1590     end.
     1591   end.
     1592   assign
     1593     varprice-base-cons = varprice-base-cons / varcons-qnty
     1594     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     1595   if varprice-base-cons = ? then do:
     1596     assign
     1597       varprice-base-cons = 0.
     1598   end.
     1599   if varprice-rubl-cons = ? then do:
     1600     assign
     1601       varprice-rubl-cons = 0.
     1602   end.
     1603   assign
     1604       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1605     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1606     discnt-base-sale            = buf_gds-dtl.discnt-base
     1607     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1608       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1609     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1610     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     1611     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1612     .
     1613   if buf_trn-doc.doc-type = 'инв':U then do:
     1614     assign
     1615       varfact-qnty = buf_gds-dtl.doc-qnty.
     1616   end.
     1617   else do:
     1618     assign
     1619       varfact-qnty = buf_gds-dtl.fact-qnty.
     1620   end.
     1621   if varis-cons-parts-have = no then do:
     1622     assign
     1623           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1624           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     1625   end.
     1626   else do:
     1627     if buf_trn-doc.doc-type = 'инв':U then do:
     1628       assign
     1629               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1630               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1631        .
     1632     end.
     1633     else do:
     1634       assign
     1635               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1636               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1637        .
     1638     end.
     1639   end.
     1640   assign
     1641   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1642   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1643               ASSIGN
     1644                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1645                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1646                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1647                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1648                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1649                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1650                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1651                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1652                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1653                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1654                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1655                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1656                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1657               .
     1658           end.
     1659       end.
     1660       assign
     1661           p-transport-base      = 0
     1662           p-transport-rubl      = 0
     1663           p-vat-pc              = buf_doc-line.vat-pc
     1664           p-slt-pc              = buf_doc-line.slt-pc
     1665       .
     1666     end.
     1667     if p-fact-qnty      = ?
     1668     or p-vat-pc         = ?
     1669     or p-slt-pc         = ?
     1670     or p-sum-base       = ?
     1671     or p-sum-rubl       = ?
     1672     or p-vat-base       = ?
     1673     or p-vat-rubl       = ?
     1674     or p-slt-base       = ?
     1675     or p-slt-rubl       = ?
     1676     or p-road-tax-base  = ?
     1677     or p-road-tax-rubl  = ?
     1678     or p-transport-base = ?
     1679     or p-transport-rubl = ?
     1680     or p-other-base     = ?
     1681     or p-other-rubl     = ?
     1682     or p-excise-base    = ?
     1683     or p-excise-rubl    = ?
     1684     then do:
     1685       message
     1686         vss-workfile vss-revision vss-description skip
     1687         vss-include-info6 skip
     1688         "Получены неопределенные значения" skip
     1689         "Документ" p-doc-code skip
     1690         "Артикул" p-artic p-prod-type p-prod-code skip
     1691         "fact-qnty     " p-fact-qnty      skip
     1692         "vat-pc        " p-vat-pc         skip
     1693         "slt-pc        " p-slt-pc         skip
     1694         "sum-base      " p-sum-base       skip
     1695         "sum-rubl      " p-sum-rubl       skip
     1696         "vat-base      " p-vat-base       skip
     1697         "vat-rubl      " p-vat-rubl       skip
     1698         "slt-base      " p-slt-base       skip
     1699         "slt-rubl      " p-slt-rubl       skip
     1700         "road-tax-base " p-road-tax-base  skip
     1701         "road-tax-rubl " p-road-tax-rubl  skip
     1702         "transport-base" p-transport-base skip
     1703         "transport-rubl" p-transport-rubl skip
     1704         "other-base    " p-other-base     skip
     1705         "other-rubl    " p-other-rubl     skip
     1706         "excise-base   " p-excise-base    skip
     1707         "excise-rubl   " p-excise-rubl    skip
     1708         view-as alert-box error .
     1709       undo, return error .
