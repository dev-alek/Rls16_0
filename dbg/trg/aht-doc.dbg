     3320       bfpc_tt-allsum.slt-rubl-doc        = bf_tt-allsum.slt-rubl-doc        - bf_tt-allsum.slt-rubl-acc
     3321       bfpc_tt-allsum.road-tax-base-doc   = bf_tt-allsum.road-tax-base-doc   - bf_tt-allsum.road-tax-base-acc
     3322       bfpc_tt-allsum.road-tax-rubl-doc   = bf_tt-allsum.road-tax-rubl-doc   - bf_tt-allsum.road-tax-rubl-acc
     3323       bfpc_tt-allsum.excise-base-doc     = bf_tt-allsum.excise-base-doc
     3324       bfpc_tt-allsum.excise-rubl-doc     = bf_tt-allsum.excise-rubl-doc
