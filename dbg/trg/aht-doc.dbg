     5045           if v-message-on then
     5046           message
     5047             vss-workfile vss-revision vss-description skip
     5048             v-msgstr skip
     5049             "Документ" p-doc-code skip
     5050             "Артикул" p-artic p-prod-type p-prod-code skip
     5051             "Тип суммы" v-allsum-sum-type skip
     5052                                                                         "cost-sum-base"       v-cost-sum-base        skip     "cost-sum-rubl"       v-cost-sum-rubl        skip     "cost-vat-base"       v-cost-vat-base        skip     "cost-vat-rubl"       v-cost-vat-rubl        skip     "cost-slt-base"       v-cost-slt-base        skip     "cost-slt-rubl"       v-cost-slt-rubl        skip     "cost-road-tax-base"  v-cost-road-tax-base   skip     "cost-road-tax-rubl"  v-cost-road-tax-rubl   skip     "cost-excise-base"    v-cost-excise-base     skip     "cost-excise-rubl"    v-cost-excise-rubl     skip     "cost-transport-base" v-cost-transport-base  skip     "cost-transport-rubl" v-cost-transport-rubl  skip     "cost-other-base"     v-cost-other-base      skip     "cost-other-rubl"     v-cost-other-rubl      skip     "cost-discnt-base"    v-cost-discnt-base     skip     "cost-discnt-rubl"    v-cost-discnt-rubl     skip
     5053             view-as alert-box error .
     5054           undo, return error v-msgstr .
     5055         end.
     5056         if
     5057                                 v-crsa-sum-base       = ? or    v-crsa-sum-rubl       = ? or    v-crsa-vat-base       = ? or    v-crsa-vat-rubl       = ? or    v-crsa-slt-base       = ? or    v-crsa-slt-rubl       = ? or    v-crsa-road-tax-base  = ? or    v-crsa-road-tax-rubl  = ? or    v-crsa-excise-base    = ? or    v-crsa-excise-rubl    = ? or    v-crsa-transport-base = ? or    v-crsa-transport-rubl = ? or    v-crsa-other-base     = ? or    v-crsa-other-rubl     = ? or    v-crsa-discnt-base    = ? or    v-crsa-discnt-rubl    = ?
     5058         then do:
