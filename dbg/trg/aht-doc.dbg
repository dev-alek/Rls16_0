     1857       define  variable excise-base-sale-prl            like ub.doc-line.price-base no-undo.
     1858       define  variable excise-rubl-sale-prl            like ub.doc-line.price-rubl no-undo.
     1859       define  variable discnt-base-sale-prl            like ub.gds-dtl.discnt-base no-undo.
     1860       define  variable discnt-rubl-sale-prl            like ub.gds-dtl.discnt-rubl no-undo.
     1861       define buffer out-vatp_gds-dtl-prl     for ub.gds-dtl.
     1862       define buffer buf_out-vatp_gds-dtl-prl for ub.gds-dtl.
     1863       define buffer out-vatp_parts-prl       for ub.parts.
     1864       define buffer out-vatp_sysconf-prl     for ub.sysconf.
