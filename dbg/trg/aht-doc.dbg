     4435                                  and out-vatp_partsprl.obj-type   = varobj-type
     4436                                  and out-vatp_partsprl.obj-code   = varobj-code
     4437                                  and out-vatp_partsprl.artic      = varartic
     4438                                  and out-vatp_partsprl.prod-type  = varprod-type
     4439                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
     4440       if out-vatp_partsprl.purch-code = 2 then do:
     4441   assign
