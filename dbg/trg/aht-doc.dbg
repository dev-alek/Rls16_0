      355   procedure aht_store-stk-line :
      356     define parameter buffer buf_temp-aht-ot-line for temp-aht-ot-line .
      357     define input  parameter p-stk-sum-type   as character no-undo .
      358     define input  parameter p-fact-order     like ub.trn-doc.fact-order   no-undo .
      359     define input  parameter p-cut-fact-order like ub.trn-doc.fact-order   no-undo .
      360     define input  parameter p-ext-doc-type   like ub.trn-doc.ext-doc-type no-undo .
