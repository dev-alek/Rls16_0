     3840     (input  bf_trn-doc.obj-type
     3841     ,input  bf_trn-doc.obj-code
     3842     ,input  varb-code
     3843     ,input  0
     3844     ,input  bf_trn-doc.fact-order
     3845     ,output vardoc-num
     3846     ,output varprice-sale
     3847     ,output varroad-tax
     3848     ,output varexcise
     3849     )  .
     3850             if varprice-sale = ?
     3851             then do:
     3852               assign
     3853                 varprice-sale = 0
     3854                 varroad-tax   = 0
     3855                 varexcise     = 0
     3856               .
     3857             end.
     3858             assign
     3859               varlastcur-base     = varprice-sale
     3860               varlastcur-road-tax = varroad-tax
     3861               varlastcur-excise   = varexcise
     3862               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3863               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3864               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3865               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3866             .
     3867         end.
     3868       end.
     3869       if varcur-fact-qnty = 0 then do:
     3870         assign
     3871           varcur-base      = varlastcur-base
     3872           varcur-road-tax  = varlastcur-road-tax
     3873           varcur-excise    = varlastcur-excise
     3874         .
     3875       end.
     3876       else do:
     3877         assign
     3878           varcur-base      = varcur-base      / varcur-fact-qnty
     3879           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3880           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3881         .
     3882       end.
