     2524     if cl_tt-clcparts.out-code = 'free-zone':U     or
     2525        cl_tt-clcparts.out-code = 'out-zone':U   or
     2526        cl_tt-clcparts.doc-type = 'акт':U then do:
     2527       assign
     2528         in-vatp-have-vat-sltcl = yes.
     2529     end.
     2530     else do:
     2531       find first in-vatp_doc-attrcl no-lock
     2532         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     2533           and in-vatp_doc-attrcl.attr-code = 'envd':U
     2534         no-error .
     2535       if not available in-vatp_doc-attrcl then do:
     2536         assign
     2537           in-vatp-have-vat-sltcl = yes.
     2538       end.
     2539       else do:
     2540            in-vatp-have-vat-sltcl = no.
     2541       end.
     2542     end.
