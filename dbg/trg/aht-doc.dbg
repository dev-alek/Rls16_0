     4296           and bf_parts.obj-type   = bf_price-list.obj-type
     4297           and bf_parts.obj-code   = bf_price-list.obj-code
     4298           and bf_parts.artic      = bf_price-list.artic
     4299           and bf_parts.prod-type  = bf_price-list.prod-type
     4300           and bf_parts.prod-code  = bf_price-list.prod-code
     4301       :
