        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code   as character no-undo .
        3   define input  parameter p-cut-date   as date      no-undo .
        4   define variable vss-revision    as character no-undo initial "$Revision$":U .
        5   define variable vss-author      as character no-undo initial "$Author$":U .
        6   define variable vss-date        as character no-undo initial "$Date$":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        8   define variable vss-archive     as character no-undo initial "$Archive$":U .
        9   define variable vss-description as character no-undo initial "Создание складского архива по типам приобретения по документу".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1|&2':u,p-doc-code,p-cut-date)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define stream ahtlog .
       84   define temp-table temp-aht-ot-tot no-undo like ub.aht-ot-tot .
       85   define temp-table temp-aht-ot-line no-undo like ub.aht-ot-line .
       86   define temp-table temp-aht-stk-tot no-undo like ub.aht-stk-tot .
       87   define temp-table temp-aht-stk-line no-undo like ub.aht-stk-line .
       88   procedure aht_get-sum-type :
       89     define input  parameter p-aht-type        as character no-undo .
       90     define output parameter p-allsum-sum-type as character no-undo .
       91     do
       92     on error undo, return error return-value
       93     :
       94       case p-aht-type :
       95         when 'r':U then do:
       96           assign
       97             p-allsum-sum-type = 'сумма_по_выкупу_со_знаком':U
       98           .
       99         end.
      100         when 'c':U then do:
      101           assign
      102             p-allsum-sum-type = 'сумма_по_консигнации_закупка_со_знаком':U
      103           .
      104         end.
      105         when 'b':U then do:
      106           assign
      107             p-allsum-sum-type = 'сумма_по_консигнации_выгода_со_знаком':U
      108           .
      109         end.
      110         when 's':U then do:
      111           assign
      112             p-allsum-sum-type = 'сумма_по_ответственному_хранению_со_знаком':U
      113           .
      114         end.
      115         when 'o':U then do:
      116           assign
      117             p-allsum-sum-type = 'сумма_по_старой_консигнации_со_знаком':U
      118           .
      119         end.
      120         when 'v':U then do:
      121           assign
      122             p-allsum-sum-type = 'сумма_по_услуге_со_знаком':U
      123           .
      124         end.
      125         otherwise do:
      126           message
      127             vss-workfile vss-revision vss-description skip
      128             vss-include-info0 skip
      129             "Неизвестное значение типа приобретения" skip
      130             "Тип приобретения" p-aht-type skip
      131             view-as alert-box error .
      132           undo, return error .
      133         end.
      134       end.
      135     end.
      136   end procedure.
      137   procedure aht_get-stk-sum-type :
      138     define input  parameter p-ot-sum-type      as character no-undo .
      139     define input  parameter p-ext-doc-type     as character no-undo .
      140     define output parameter p-stk-ext-sum-type as character no-undo .
      141     do
      142     on error undo, return error return-value
      143     :
      144       assign
      145         p-stk-ext-sum-type = p-ot-sum-type + p-ext-doc-type
      146       .
      147     end.
      148   end procedure.
      149   procedure aht_store-ot-line :
      150     define input  parameter p-doc-code       as character no-undo .
      151     define input  parameter p-gds-code       as integer   no-undo .
      152     define input  parameter p-sum-type       as character no-undo .
      153     define input  parameter p-ext-doc-type   as character no-undo .
      154     define input  parameter p-obj-type       as character no-undo .
      155     define input  parameter p-obj-code       as integer   no-undo .
      156     define input  parameter p-fact-order     as decimal   no-undo .
      157     define input  parameter p-fact-qnty      as decimal   no-undo .
      158             define input  parameter p-cost-sum-base       as decimal   no-undo .     define input  parameter p-cost-sum-rubl       as decimal   no-undo .     define input  parameter p-cost-vat-base       as decimal   no-undo .     define input  parameter p-cost-vat-rubl       as decimal   no-undo .     define input  parameter p-cost-slt-base       as decimal   no-undo .     define input  parameter p-cost-slt-rubl       as decimal   no-undo .     define input  parameter p-cost-road-tax-base  as decimal   no-undo .     define input  parameter p-cost-road-tax-rubl  as decimal   no-undo .     define input  parameter p-cost-excise-base    as decimal   no-undo .     define input  parameter p-cost-excise-rubl    as decimal   no-undo .     define input  parameter p-cost-transport-base as decimal   no-undo .     define input  parameter p-cost-transport-rubl as decimal   no-undo .     define input  parameter p-cost-other-base     as decimal   no-undo .     define input  parameter p-cost-other-rubl     as decimal   no-undo .     define input  parameter p-cost-discnt-base    as decimal   no-undo .     define input  parameter p-cost-discnt-rubl    as decimal   no-undo .
      159             define input  parameter p-crsa-sum-base       as decimal   no-undo .     define input  parameter p-crsa-sum-rubl       as decimal   no-undo .     define input  parameter p-crsa-vat-base       as decimal   no-undo .     define input  parameter p-crsa-vat-rubl       as decimal   no-undo .     define input  parameter p-crsa-slt-base       as decimal   no-undo .     define input  parameter p-crsa-slt-rubl       as decimal   no-undo .     define input  parameter p-crsa-road-tax-base  as decimal   no-undo .     define input  parameter p-crsa-road-tax-rubl  as decimal   no-undo .     define input  parameter p-crsa-excise-base    as decimal   no-undo .     define input  parameter p-crsa-excise-rubl    as decimal   no-undo .     define input  parameter p-crsa-transport-base as decimal   no-undo .     define input  parameter p-crsa-transport-rubl as decimal   no-undo .     define input  parameter p-crsa-other-base     as decimal   no-undo .     define input  parameter p-crsa-other-rubl     as decimal   no-undo .     define input  parameter p-crsa-discnt-base    as decimal   no-undo .     define input  parameter p-crsa-discnt-rubl    as decimal   no-undo .
      160             define input  parameter p-sale-sum-base       as decimal   no-undo .     define input  parameter p-sale-sum-rubl       as decimal   no-undo .     define input  parameter p-sale-vat-base       as decimal   no-undo .     define input  parameter p-sale-vat-rubl       as decimal   no-undo .     define input  parameter p-sale-slt-base       as decimal   no-undo .     define input  parameter p-sale-slt-rubl       as decimal   no-undo .     define input  parameter p-sale-road-tax-base  as decimal   no-undo .     define input  parameter p-sale-road-tax-rubl  as decimal   no-undo .     define input  parameter p-sale-excise-base    as decimal   no-undo .     define input  parameter p-sale-excise-rubl    as decimal   no-undo .     define input  parameter p-sale-transport-base as decimal   no-undo .     define input  parameter p-sale-transport-rubl as decimal   no-undo .     define input  parameter p-sale-other-base     as decimal   no-undo .     define input  parameter p-sale-other-rubl     as decimal   no-undo .     define input  parameter p-sale-discnt-base    as decimal   no-undo .     define input  parameter p-sale-discnt-rubl    as decimal   no-undo .
      161     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
      162     do
      163     on error undo, return error return-value
      164     :
      165       find first buf_temp-aht-ot-line
      166         where buf_temp-aht-ot-line.doc-code  = p-doc-code
      167           and buf_temp-aht-ot-line.gds-code  = p-gds-code
      168           and buf_temp-aht-ot-line.sum-type  = p-sum-type
      169         no-error .
      170       if not available buf_temp-aht-ot-line then do:
