     2511   do on error undo, return error return-value :
     2512   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     2513   for each bf_tt-allsum on error undo, return error return-value :
     2514     delete bf_tt-allsum.
     2515   end.
