      493             "Код товара" buf_temp-aht-ot-line.gds-code skip
      494             "Тип суммы" buf_temp-aht-ot-line.sum-type skip
      495             view-as alert-box error .
      496           undo, return error .
      497         end.
      498         find first buf_aht-ot-line exclusive-lock
      499           where buf_aht-ot-line.doc-code  = buf_temp-aht-ot-line.doc-code
      500             and buf_aht-ot-line.gds-code  = buf_temp-aht-ot-line.gds-code
      501             and buf_aht-ot-line.sum-type  = buf_temp-aht-ot-line.sum-type
      502           no-error .
      503         if not available buf_aht-ot-line then do:
      504           create buf_aht-ot-line .
      505         end.
      506                     assign
      507           buf_aht-ot-line.doc-code     = buf_temp-aht-ot-line.doc-code       buf_aht-ot-line.gds-code     = buf_temp-aht-ot-line.gds-code       buf_aht-ot-line.sum-type     = buf_temp-aht-ot-line.sum-type       buf_aht-ot-line.ext-doc-type = buf_temp-aht-ot-line.ext-doc-type   buf_aht-ot-line.obj-type     = buf_temp-aht-ot-line.obj-type       buf_aht-ot-line.obj-code     = buf_temp-aht-ot-line.obj-code       buf_aht-ot-line.fact-order   = buf_temp-aht-ot-line.fact-order
      508         .
      509         assign
      510           buf_aht-ot-line.fact-qnty = buf_temp-aht-ot-line.fact-qnty
      511                                                           buf_aht-ot-line.cost-sum-base       = buf_temp-aht-ot-line.cost-sum-base             buf_aht-ot-line.cost-sum-rubl       = buf_temp-aht-ot-line.cost-sum-rubl             buf_aht-ot-line.cost-vat-base       = buf_temp-aht-ot-line.cost-vat-base             buf_aht-ot-line.cost-vat-rubl       = buf_temp-aht-ot-line.cost-vat-rubl             buf_aht-ot-line.cost-slt-base       = buf_temp-aht-ot-line.cost-slt-base             buf_aht-ot-line.cost-slt-rubl       = buf_temp-aht-ot-line.cost-slt-rubl             buf_aht-ot-line.cost-road-tax-base  = buf_temp-aht-ot-line.cost-road-tax-base        buf_aht-ot-line.cost-road-tax-rubl  = buf_temp-aht-ot-line.cost-road-tax-rubl        buf_aht-ot-line.cost-excise-base    = buf_temp-aht-ot-line.cost-excise-base          buf_aht-ot-line.cost-excise-rubl    = buf_temp-aht-ot-line.cost-excise-rubl          buf_aht-ot-line.cost-transport-base = buf_temp-aht-ot-line.cost-transport-base       buf_aht-ot-line.cost-transport-rubl = buf_temp-aht-ot-line.cost-transport-rubl       buf_aht-ot-line.cost-other-base     = buf_temp-aht-ot-line.cost-other-base           buf_aht-ot-line.cost-other-rubl     = buf_temp-aht-ot-line.cost-other-rubl           buf_aht-ot-line.cost-discnt-base    = buf_temp-aht-ot-line.cost-discnt-base          buf_aht-ot-line.cost-discnt-rubl    = buf_temp-aht-ot-line.cost-discnt-rubl
      512                                                           buf_aht-ot-line.crsa-sum-base       = buf_temp-aht-ot-line.crsa-sum-base             buf_aht-ot-line.crsa-sum-rubl       = buf_temp-aht-ot-line.crsa-sum-rubl             buf_aht-ot-line.crsa-vat-base       = buf_temp-aht-ot-line.crsa-vat-base             buf_aht-ot-line.crsa-vat-rubl       = buf_temp-aht-ot-line.crsa-vat-rubl             buf_aht-ot-line.crsa-slt-base       = buf_temp-aht-ot-line.crsa-slt-base             buf_aht-ot-line.crsa-slt-rubl       = buf_temp-aht-ot-line.crsa-slt-rubl             buf_aht-ot-line.crsa-road-tax-base  = buf_temp-aht-ot-line.crsa-road-tax-base        buf_aht-ot-line.crsa-road-tax-rubl  = buf_temp-aht-ot-line.crsa-road-tax-rubl        buf_aht-ot-line.crsa-excise-base    = buf_temp-aht-ot-line.crsa-excise-base          buf_aht-ot-line.crsa-excise-rubl    = buf_temp-aht-ot-line.crsa-excise-rubl          buf_aht-ot-line.crsa-transport-base = buf_temp-aht-ot-line.crsa-transport-base       buf_aht-ot-line.crsa-transport-rubl = buf_temp-aht-ot-line.crsa-transport-rubl       buf_aht-ot-line.crsa-other-base     = buf_temp-aht-ot-line.crsa-other-base           buf_aht-ot-line.crsa-other-rubl     = buf_temp-aht-ot-line.crsa-other-rubl           buf_aht-ot-line.crsa-discnt-base    = buf_temp-aht-ot-line.crsa-discnt-base          buf_aht-ot-line.crsa-discnt-rubl    = buf_temp-aht-ot-line.crsa-discnt-rubl
      513                                                           buf_aht-ot-line.sale-sum-base       = buf_temp-aht-ot-line.sale-sum-base             buf_aht-ot-line.sale-sum-rubl       = buf_temp-aht-ot-line.sale-sum-rubl             buf_aht-ot-line.sale-vat-base       = buf_temp-aht-ot-line.sale-vat-base             buf_aht-ot-line.sale-vat-rubl       = buf_temp-aht-ot-line.sale-vat-rubl             buf_aht-ot-line.sale-slt-base       = buf_temp-aht-ot-line.sale-slt-base             buf_aht-ot-line.sale-slt-rubl       = buf_temp-aht-ot-line.sale-slt-rubl             buf_aht-ot-line.sale-road-tax-base  = buf_temp-aht-ot-line.sale-road-tax-base        buf_aht-ot-line.sale-road-tax-rubl  = buf_temp-aht-ot-line.sale-road-tax-rubl        buf_aht-ot-line.sale-excise-base    = buf_temp-aht-ot-line.sale-excise-base          buf_aht-ot-line.sale-excise-rubl    = buf_temp-aht-ot-line.sale-excise-rubl          buf_aht-ot-line.sale-transport-base = buf_temp-aht-ot-line.sale-transport-base       buf_aht-ot-line.sale-transport-rubl = buf_temp-aht-ot-line.sale-transport-rubl       buf_aht-ot-line.sale-other-base     = buf_temp-aht-ot-line.sale-other-base           buf_aht-ot-line.sale-other-rubl     = buf_temp-aht-ot-line.sale-other-rubl           buf_aht-ot-line.sale-discnt-base    = buf_temp-aht-ot-line.sale-discnt-base          buf_aht-ot-line.sale-discnt-rubl    = buf_temp-aht-ot-line.sale-discnt-rubl
      514         .
      515       end.
      516     end.
      517   end procedure.
      518   procedure aht_add-document :
      519     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
      520     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
      521     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
      522     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
      523     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
      524     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
      525     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
      526     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
      527     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
      528     define buffer buf_aht-doc for ub.aht-doc .
      529     do
      530     on error undo, return error return-value
      531     :
      532       find first buf_aht-doc exclusive-lock
      533         where buf_aht-doc.doc-code = p-doc-code
      534         no-error .
      535       if available buf_aht-doc then do:
      536         message
      537           vss-workfile vss-revision vss-description skip
      538           vss-include-info0 skip
      539           "Попытка повторного создания записи" skip
      540           "Документ" p-doc-code skip
      541           view-as alert-box error .
      542         undo, return error .
      543       end.
      544       if p-fact-order = ?
      545       or p-fact-order = 0
      546       then do:
      547         message
      548           vss-workfile vss-revision vss-description skip
      549           vss-include-info0 skip
      550           "Ошибка задания входных параметров" skip
      551           "Не задан номер документа" skip
      552           "Документ" p-doc-code skip
      553           "Номер документа" p-fact-order skip
      554           view-as alert-box error .
      555         undo, return error .
      556       end.
      557       create buf_aht-doc .
      558       assign
      559         buf_aht-doc.doc-code     = p-doc-code
      560         buf_aht-doc.obj-type     = p-obj-type
      561         buf_aht-doc.obj-code     = p-obj-code
      562         buf_aht-doc.ext-doc-type = p-ext-doc-type
      563         buf_aht-doc.is-trn-doc   = p-is-trn-doc
      564         buf_aht-doc.fact-order   = p-fact-order
      565         buf_aht-doc.fact-date    = p-fact-date
      566         buf_aht-doc.shift-date   = p-shift-date
      567         buf_aht-doc.shift-num    = p-shift-num
      568       .
      569     end.
      570   end procedure.
      571   procedure aht_add-date :
      572     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
      573     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
      574     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
      575     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
      576     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
      577     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
      578     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
      579     define buffer buf_aht-stk for ub.aht-stk .
      580     do
      581     on error undo, return error return-value
      582     :
      583       find first buf_aht-stk no-lock
      584         where buf_aht-stk.obj-type   = p-obj-type
      585           and buf_aht-stk.obj-code   = p-obj-code
      586           and buf_aht-stk.stk-type   = p-stk-type
      587           and buf_aht-stk.fact-order = p-fact-order
      588         no-error .
      589       if not available buf_aht-stk then do:
      590         create buf_aht-stk .
      591         assign
      592           buf_aht-stk.obj-type   = p-obj-type
      593           buf_aht-stk.obj-code   = p-obj-code
      594           buf_aht-stk.stk-type   = p-stk-type
      595           buf_aht-stk.fact-order = p-fact-order
      596           buf_aht-stk.fact-date  = p-fact-date
      597           buf_aht-stk.shift-date = p-shift-date
      598           buf_aht-stk.shift-num  = p-shift-num
      599         .
      600       end.
      601     end.
      602   end procedure.
      603   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   procedure factord :
      605     define input  parameter p-fact-date            as date    no-undo .
      606     define input  parameter p-fact-time            as integer no-undo .
      607     define input  parameter p-fact-num             as integer no-undo .
      608     define input  parameter p-shift-date           as date    no-undo .
      609     define input  parameter p-shift-num            as integer no-undo .
      610     define input  parameter p-shift-on             as logical no-undo .
      611     define output parameter p-fact-order           as decimal no-undo .
      612     define output parameter p-shift-end-fact-order as decimal no-undo .
      613     define output parameter p-day-end-fact-order   as decimal no-undo .
      614     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      615     if p-fact-date = ?
      616     then do:
      617       return error "Не указана фактическая дата" .
      618     end.
      619     define variable v-fact-date-num as integer no-undo .
      620     assign
      621       v-fact-date-num = integer(p-fact-date)
      622     .
      623     if p-fact-num = ?
      624     or p-fact-num = 0
      625     then do:
      626       return error "Не задан p-fact-num " + string(p-fact-num) .
      627     end.
      628     if p-fact-num < 0
      629     then do:
      630       return error "Отрицательный fact-num " + string(p-fact-num) .
      631     end.
      632     if p-fact-num >= 100000000
      633     then do:
      634       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      635     end.
      636     if p-shift-on = true
      637     then do:
      638       if p-shift-date = ?
      639       then do:
      640         return error "Не задана дата смены" .
      641       end.
      642       if p-shift-num = ?
      643       or p-shift-num = 0
      644       then do:
      645         return error "Не задан номер смены" .
      646       end.
      647     end.
      648     else do:
      649       assign
      650         p-shift-date = p-fact-date
      651         p-shift-num  = 24
      652       .
      653     end.
      654     define variable v-shift-offset as integer no-undo .
      655     if p-shift-date = p-fact-date
      656     then do:
      657       assign
      658         v-shift-offset = 1
      659       .
      660     end.
      661     if p-shift-date < p-fact-date
      662     then do:
      663       assign
      664         v-shift-offset = 0
      665       .
      666     end.
      667     if p-shift-date > p-fact-date
      668     then do:
      669       message
      670         vss-workfile vss-revision vss-description skip
      671         "Неправильная дата закрытия смены" skip
      672         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      673         view-as alert-box error .
      674       undo, return error
      675         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      676           ,string(p-fact-date, '99/99/9999':U)
      677           ,string(p-shift-date, '99/99/9999':U)
      678           )
      679       .
      680     end.
      681     if p-shift-num < 1
      682     or p-shift-num > 24
      683     then do:
      684       message
      685         vss-workfile vss-revision vss-description skip
      686         "Неправильный номер смены" skip
      687         "p-shift-num" p-shift-num skip
      688         view-as alert-box error .
      689       undo, return error return-value .
      690     end.
      691     assign
      692       p-fact-order           = v-fact-date-num
      693                              + v-shift-offset * 0.5
      694                              + p-shift-num    * 0.02 - 0.01
      695                              + p-fact-num     * 0.0000000001
      696       p-shift-end-fact-order = v-fact-date-num
      697                              + v-shift-offset * 0.5
      698                              + p-shift-num    * 0.02
      699       p-day-end-fact-order   = v-fact-date-num
      700                              + 0.99
      701     .
      702     if p-fact-order           <= v-fact-date-num
      703     or p-shift-end-fact-order <= v-fact-date-num
      704     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      705     or p-shift-end-fact-order >= p-day-end-fact-order
      706     then do:
      707       message
      708         vss-workfile vss-revision vss-description skip
      709         "Внутренняя ошибка при генерации фактического номера" skip
      710         "p-fact-date"            p-fact-date            skip
      711         "p-fact-time"            p-fact-time            skip
      712         "p-fact-num"             p-fact-num             skip
      713         "p-shift-date"           p-shift-date           skip
      714         "p-shift-num"            p-shift-num            skip
      715         "p-shift-on"             p-shift-on             skip
      716         "p-shift-end-fact-order" p-shift-end-fact-order skip
      717         "p-day-end-fact-order"   p-day-end-fact-order   skip
      718         "v-fact-date-num"        v-fact-date-num        skip
      719         view-as alert-box error .
      720       undo, return error return-value .
      721     end.
      722   end procedure.
      723   procedure day-begin-fact-order :
      724     define input  parameter p-fact-date            as date    no-undo .
      725     define output parameter p-day-begin-fact-order as decimal no-undo .
      726     do
      727     on error undo, return error return-value
      728     :
      729       if p-fact-date = ?
      730       then do:
      731         assign
      732           p-day-begin-fact-order = 0
      733         .
      734       end.
      735       else do:
      736         assign
      737           p-day-begin-fact-order = integer(p-fact-date)
      738         .
      739       end.
      740     end.
      741   end procedure.
      742   procedure factord-max-fact-order :
      743     define output parameter p-max-fact-order as decimal   no-undo .
      744     do
      745     on error undo, return error return-value
      746     :
      747       run day-begin-fact-order in this-procedure
      748         (input  date(1, 1, 5000)
      749         ,output p-max-fact-order
      750         ) .
      751     end.
      752   end procedure.
      753   procedure factord-cut-archive :
      754     define input  parameter p-obj-type             as character no-undo .
      755     define input  parameter p-obj-code             as integer   no-undo .
      756     define input  parameter p-fact-date            as date      no-undo .
      757     define output parameter p-shift-on             as logical   no-undo .
      758     define output parameter p-shift-date           as date      no-undo .
      759     define output parameter p-shift-num            as integer   no-undo .
      760     define output parameter p-day-end-fact-order   as decimal   no-undo .
      761     define output parameter p-shift-end-fact-order as decimal   no-undo .
      762     define variable v-fact-order as decimal   no-undo .
      763     define buffer buf_shift-obj for ub.shift-obj .
      764     do
      765     on error undo, return error return-value
      766     :
      767   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      769     (input  p-obj-type
      770     ,input  p-obj-code
      771     ,input  'shift-on=request'
      772     ,output p-shift-on
      773     ) no-error .
      774       if error-status :error
      775       then do:
      776         message
      777           vss-workfile vss-revision vss-description skip
      778           "Ошибка при определении атрибута объекта" skip
      779           "Объект" p-obj-type p-obj-code skip
      780           error-status :get-message(1) skip
      781           return-value skip
      782           view-as alert-box error .
      783         undo, return error return-value .
      784       end.
      785       if p-shift-on = false
      786       then do:
      787         assign
      788           p-shift-date               = ?
      789           p-shift-num                = 0
      790         .
      791       end.
      792       else do:
      793         find first buf_shift-obj share-lock
      794           where buf_shift-obj.obj-type   = p-obj-type
      795             and buf_shift-obj.obj-code   = p-obj-code
      796             and buf_shift-obj.shift-date > p-fact-date
      797           use-index pi
      798           no-error .
      799         if not available buf_shift-obj
      800         or buf_shift-obj.status_ <> 'зкр':U
      801         then do:
      802           message
      803             vss-workfile vss-revision vss-description skip
      804             "Невозможно вычислить последнюю смену" skip
      805             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      806             "Объект" p-obj-type p-obj-code skip
      807             "Дата" p-fact-date skip
      808             view-as alert-box error .
      809           undo, return error return-value .
      810         end.
      811         find last buf_shift-obj share-lock
      812           where buf_shift-obj.obj-type = p-obj-type
      813             and buf_shift-obj.obj-code = p-obj-code
      814             and buf_shift-obj.shift-date <= p-fact-date
      815           use-index pi
      816           no-error .
      817         if available buf_shift-obj
      818         then do:
      819           if  buf_shift-obj.status_ = 'зкр':U
      820           then do:
      821             assign
      822               p-shift-date = buf_shift-obj.shift-date
      823               p-shift-num  = buf_shift-obj.shift-num
      824             .
      825           end.
      826           else do:
      827             message
      828               vss-workfile vss-revision vss-description skip
      829               "Невозможно вычислить последнюю смену" skip
      830               "Статус смены отличен от статуса" 'зкр':U skip
      831               "Объект" p-obj-type p-obj-code skip
      832               "Дата" p-fact-date skip
      833               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      834               view-as alert-box error .
      835             undo, return error return-value .
      836           end.
      837         end.
      838         else do:
      839           assign
      840             p-shift-date = p-fact-date - 1
      841             p-shift-num  = 1
      842           .
      843         end.
      844       end.
      845       run factord in this-procedure
      846         (input  p-fact-date
      847         ,input  1
      848         ,input  1
      849         ,input  p-shift-date
      850         ,input  p-shift-num
      851         ,input  p-shift-on
      852         ,output v-fact-order
      853         ,output p-shift-end-fact-order
      854         ,output p-day-end-fact-order
      855         ) no-error .
      856       if error-status :error
      857       then do:
      858         message
      859           vss-workfile vss-revision vss-description skip
      860           "Ошибка при вызове процедуры factord"
      861           error-status :get-message(1) skip
      862           return-value skip
      863           view-as alert-box error .
      864         undo, return error return-value .
      865       end.
      866     end.
      867   end procedure.
      868   procedure factord-lock-shift :
      869     define input  parameter p-obj-type  as character no-undo .
      870     define input  parameter p-obj-code  as integer   no-undo .
      871     define input  parameter p-fact-date as date      no-undo .
      872     define parameter buffer buf_shift-obj for ub.shift-obj .
      873     define variable v-shift-on      as logical   no-undo .
      874     define variable v-extra-message as character no-undo .
      875     define variable v-error as character no-undo .
      876     do
      877     on error undo, return error return-value
      878     :
      879   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      881     (input  p-obj-type
      882     ,input  p-obj-code
      883     ,input  'shift-on=request'
      884     ,output v-shift-on
      885     ) no-error .
      886       if error-status :error
      887       then do:
      888         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      889         undo, return error v-error .
      890       end.
      891       if v-shift-on = true
      892       then do:
      893         find first buf_shift-obj share-lock
      894           where buf_shift-obj.obj-type   = p-obj-type
      895             and buf_shift-obj.obj-code   = p-obj-code
      896             and buf_shift-obj.shift-date > p-fact-date
      897           use-index pi
      898           no-error .
      899         if not available buf_shift-obj
      900         or buf_shift-obj.status_ <> 'зкр':U
      901         then do:
      902           find last buf_shift-obj
      903             where buf_shift-obj.obj-type = p-obj-type
      904               and buf_shift-obj.obj-code = p-obj-code
      905               and buf_shift-obj.status_  = 'зкр':U
      906             use-index stts
      907             no-error .
      908           if available buf_shift-obj
      909           then do:
      910             assign
      911               v-extra-message =
      912                     substitute("Дата начала последеней закрытой смены на объекте &1"
      913                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      914                               )
      915             .
      916           end.
      917           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      918           undo, return error v-error .
      919         end.
      920       end.
      921     end.
      922   end procedure.
      923   procedure factord-end-day :
      924     define input  parameter p-fact-date            as date    no-undo .
      925     define output parameter p-day-end-fact-order   as decimal no-undo .
      926     do
      927     on error undo, return error return-value
      928     :
      929       if p-fact-date = ?
      930       then do:
      931         return error "Не указана фактическая дата" .
      932       end.
      933       assign
      934         p-day-end-fact-order = integer(p-fact-date) + 0.99
      935       .
      936     end.
      937   end procedure.
      938   procedure factord-to-date :
      939     define input  parameter p-fact-order as decimal no-undo .
      940     define output parameter p-fact-date  as date    no-undo .
      941     define variable v-ref-date  as date      no-undo .
      942     define variable v-ref-delta as integer   no-undo .
      943     do
      944     on error undo, return error return-value
      945     :
      946       if p-fact-order = ?
      947       or p-fact-order = 0
      948       then do:
      949         return error "Не указан fact-order" .
      950       end.
      951       assign
      952         v-ref-date  = date(1, 1, 2000)
      953       .
      954       assign
      955         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      956       .
      957       assign
      958         p-fact-date = v-ref-date + v-ref-delta
      959       .
      960     end.
      961   end procedure.
      962   procedure factord-to-fact-num :
      963     define input  parameter p-fact-order as decimal no-undo .
      964     define output parameter p-fact-num   as integer no-undo .
      965     define variable v-fact-order-trunc as decimal no-undo .
      966     do
      967     on error undo, return error return-value
      968     :
      969       if p-fact-order = ?
      970       or p-fact-order = 0
      971       then do:
      972         return error "Не указан fact-order" .
      973       end.
      974       assign
      975        v-fact-order-trunc = truncate(p-fact-order, 2)
      976       .
      977       assign
      978         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      979       .
      980     end.
      981   end procedure.
      982   procedure factord-to-shift-num :
      983     define input  parameter p-fact-order as decimal no-undo .
      984     define output parameter p-shift-num   as integer no-undo .
      985     define variable  p-shift-numd  as decimal   no-undo .
      986     define variable v-fact-order-trunc as decimal no-undo .
      987     do
      988     on error undo, return error return-value
      989     :
      990       if p-fact-order = ?
      991       or p-fact-order = 0
      992       then do:
      993         return error "Не указан fact-order" .
      994       end.
      995       assign
      996        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      997       .
      998       if v-fact-order-trunc < 0.5 then do:
      999         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1000       end.
     1001       assign
     1002         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1003         .
     1004        assign
     1005         p-shift-num = truncate (p-shift-numd , 0)
     1006       .
     1007     end.
     1008   end procedure.
     1009   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010   procedure cur-time :
     1011      define output parameter p-today as date      no-undo .
     1012      define output parameter p-time  as integer   no-undo .
     1013     do
     1014     on error undo, return error
     1015     :
     1016       define variable v-date1 as date      no-undo .
     1017       define variable v-date2 as date      no-undo .
     1018       define variable v-time  as integer   no-undo .
     1019       assign
     1020         v-date1 = today
     1021         v-time  = time
     1022         v-date2 = today
     1023       .
     1024       if v-date1 <> v-date2
     1025       then do:
     1026         assign
     1027           v-date1 = today
     1028           v-time  = v-time
     1029         .
     1030       end.
     1031       assign
     1032         p-today = v-date1
     1033         p-time  = v-time
     1034       .
     1035     end.
     1036   end.
     1037   function cur-time-date returns character
     1038   :
     1039     return string(today, '99/99/9999':U) .
     1040   end.
     1041   function cur-time-mjd returns decimal
     1042   :
     1043     define variable v-date as date      no-undo .
     1044     define variable v-time as integer   no-undo .
     1045     run cur-time in this-procedure
     1046       (output v-date
     1047       ,output v-time
     1048       ) .
     1049     return integer(v-date) - 2400002 + (v-time / 86400) .
     1050   end.
     1051   function cur-time-get-ending-index returns integer
     1052   (input p-number as integer
     1053   )
     1054   :
     1055     if p-number < 0
     1056     or p-number = ?
     1057     then do:
     1058       return 1 .
     1059     end.
     1060     define variable v-rest as integer   no-undo .
     1061     assign
     1062       p-number = p-number modulo 100
     1063     .
     1064     if p-number < 20
     1065     then do:
     1066       assign
     1067         v-rest = p-number
     1068       .
     1069     end.
     1070     else do:
     1071       assign
     1072         v-rest = p-number modulo 10
     1073       .
     1074     end.
     1075     case v-rest :
     1076       when 1
     1077       then do:
     1078         return 2 .
     1079       end.
     1080       when 2 or
     1081       when 3 or
     1082       when 4
     1083       then do:
     1084         return 3 .
     1085       end.
     1086       otherwise do:
     1087         return 1 .
     1088       end.
     1089     end case .
     1090   end.
     1091   procedure cur-time-mjd-to-date :
     1092      define input  parameter i-mjd-diff as decimal no-undo.
     1093      define output parameter o-Date     as date    no-undo.
     1094      define output parameter o-Time     as integer no-undo.
     1095      define variable v-day-number as integer   no-undo .
     1096      if    i-mjd-diff < 0
     1097         or i-mjd-diff = ?
     1098      then do:
     1099         return "?" .
     1100      end.
     1101      assign
     1102         v-day-number = truncate(i-mjd-diff,0).
     1103         o-Date = date(v-day-number + 2400002).
     1104         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1105     .
     1106   end.
     1107   function cur-time-mjd-to-string returns character
     1108   (input p-mjd-diff as decimal
     1109   )
     1110   :
     1111     define variable v-day-number as integer   no-undo .
     1112     define variable v-seconds    as integer   no-undo .
     1113     define variable v-hour       as integer   no-undo .
     1114     define variable v-min        as integer   no-undo .
     1115     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1116     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1117     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1118     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1119     if p-mjd-diff < 0
     1120     or p-mjd-diff = ?
     1121     then do:
     1122       return "?" .
     1123     end.
     1124     assign
     1125       v-day-number = integer(truncate(p-mjd-diff,0))
     1126       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1127     .
     1128     if v-seconds > 86400
     1129     then do:
     1130       assign
     1131         v-seconds = 86400 - 1
     1132       .
     1133     end.
     1134     if v-seconds < 0
     1135     then do:
     1136       assign
     1137         v-seconds = 0
     1138       .
     1139     end.
     1140     assign
     1141       v-hour = truncate(v-seconds / 3600, 0)
     1142     .
     1143     assign
     1144       v-seconds = v-seconds modulo 3600
     1145     .
     1146     assign
     1147       v-min = truncate(v-seconds / 60, 0)
     1148     .
     1149     assign
     1150       v-seconds = v-seconds modulo 60
     1151     .
     1152     return
     1153         (if v-day-number <> 0
     1154           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1155           else ""
     1156         )
     1157       + (if v-day-number <> 0 or v-hour <> 0
     1158           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1159           else ""
     1160         )
     1161       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1162           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1163           else ""
     1164         )
     1165       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1166       .
     1167   end.
     1168   function cur-time-string returns character
     1169   :
     1170     define variable v-date as date      no-undo .
     1171     define variable v-time as integer   no-undo .
     1172     run cur-time in this-procedure
     1173       (output v-date
     1174       ,output v-time
     1175       ) .
     1176     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1177   end.
     1178   function cur-time-string-sec returns character
     1179   :
     1180     define variable v-date as date      no-undo .
     1181     define variable v-time as integer   no-undo .
     1182     run cur-time in this-procedure
     1183       (output v-date
     1184       ,output v-time
     1185       ) .
     1186     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1187   end.
     1188   function cur-time-custom  returns character
     1189   (input p-prefix as character
     1190   ,input p-date-format as character
     1191   ,input p-delimiter as character
     1192   ,input p-time-format as character
     1193   ,input p-suffix as character
     1194   )
     1195   :
     1196     define variable v-date as date      no-undo .
     1197     define variable v-time as integer   no-undo .
     1198     run cur-time in this-procedure
     1199       (output v-date
     1200       ,output v-time
     1201       ) .
     1202     return
     1203       p-prefix
     1204       + string(v-date, p-date-format)
     1205       + p-delimiter
     1206       + string(v-time, p-time-format)
     1207       + p-suffix
     1208       .
     1209   end.
     1210   function cur-time-print  returns character
     1211   :
     1212     define variable v-date as date      no-undo .
     1213     define variable v-time as integer   no-undo .
     1214     run cur-time in this-procedure
     1215       (output v-date
     1216       ,output v-time
     1217       ) .
     1218     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1219   end.
     1220   function cur-time-datetime returns datetime
     1221   :
     1222     define variable v-char as character no-undo .
     1223     define variable v-datetime as datetime no-undo .
     1224     v-char = cur-time-string().
     1225     v-datetime = datetime(v-char).
     1226     return  v-datetime.
     1227   end.
     1228   function cur-time-string-msec returns character
     1229   :
     1230     define variable v-date as datetime  no-undo .
     1231     v-date = now.
     1232     return string(v-date) .
     1233   end.
