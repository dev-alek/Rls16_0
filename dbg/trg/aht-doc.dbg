     1846       define  variable price-base-with-tax-sale-prl    like ub.doc-line.price-base no-undo.
     1847       define  variable price-rubl-without-tax-sale-prl like ub.doc-line.price-rubl no-undo.
     1848       define  variable price-base-without-tax-sale-prl like ub.doc-line.price-base no-undo.
     1849       define  variable vat-base-sale-prl               like ub.doc-line.price-base no-undo.
     1850       define  variable vat-rubl-sale-prl               like ub.doc-line.price-rubl no-undo.
     1851       define  variable vat-base-buyer-prl              like ub.doc-line.price-base no-undo.
     1852       define  variable vat-rubl-buyer-prl              like ub.doc-line.price-rubl no-undo.
     1853       define  variable slt-base-sale-prl               like ub.doc-line.price-base no-undo.
