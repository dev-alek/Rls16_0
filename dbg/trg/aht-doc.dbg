     5080             "Артикул" p-artic p-prod-type p-prod-code skip
     5081             "Тип суммы" v-allsum-sum-type skip
     5082                                                                         "sale-sum-base"       v-sale-sum-base        skip     "sale-sum-rubl"       v-sale-sum-rubl        skip     "sale-vat-base"       v-sale-vat-base        skip     "sale-vat-rubl"       v-sale-vat-rubl        skip     "sale-slt-base"       v-sale-slt-base        skip     "sale-slt-rubl"       v-sale-slt-rubl        skip     "sale-road-tax-base"  v-sale-road-tax-base   skip     "sale-road-tax-rubl"  v-sale-road-tax-rubl   skip     "sale-excise-base"    v-sale-excise-base     skip     "sale-excise-rubl"    v-sale-excise-rubl     skip     "sale-transport-base" v-sale-transport-base  skip     "sale-transport-rubl" v-sale-transport-rubl  skip     "sale-other-base"     v-sale-other-base      skip     "sale-other-rubl"     v-sale-other-rubl      skip     "sale-discnt-base"    v-sale-discnt-base     skip     "sale-discnt-rubl"    v-sale-discnt-rubl     skip
     5083             view-as alert-box error .
