     1889       define variable varvatcons-rubl-factovp-prl  like ub.gds-dtl.price-base               no-undo.
     1890       define variable vardsc-rubl-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     1891       define variable varsum-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     1892       define variable varslt-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     1893       define variable varvat-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     1894       define variable varvatcons-rubl-docovp-prl   like ub.gds-dtl.price-base               no-undo.
     1895       define variable vardsc-rubl-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     1896       define variable varfact-qnty-prl             like ub.parts.fact-qnty                  no-undo.
     1897       define variable varcons-qnty-prl             like ub.parts.fact-qnty                  no-undo.
     1898       define variable varis-one-gds-dtl-prl        as   logical                             no-undo.
     1899       define variable varcur-prlprice-base         like ub.gds-dtl.cur-base                 no-undo.
     1900       define variable varcur-prlprice-rubl         like ub.gds-dtl.price-base               no-undo.
     1901       define variable varcur-prldiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     1902       define variable varcur-prldiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     1903       define variable varoutvprb-prl               as   character                           no-undo.
     1904       define variable out-vatp-have-vat-slt-prl    as   logical initial yes                 no-undo.
     1905       define buffer   in-vatp-trn-doco-prl  for ub.trn-doc .
     1906       define buffer   in-vatp-partso-prl    for ub.parts   .
     1907       define buffer   in-vatp-doco-prl      for ub.trn-doc .
     1908       define buffer   in-vatp-goodso-prl    for ub.goods   .
