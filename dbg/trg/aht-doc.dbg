     3002           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * 1)
     3003       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * 1) .
     3004   end.
     3005   else do:
     3006     assign
     3007           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * parcurbase-rate / parcurbase-scale)
     3008       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * parcurbase-rate / parcurbase-scale) .
