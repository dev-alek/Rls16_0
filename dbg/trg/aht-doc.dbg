     1866       define buffer out-vatp_goods-prl       for ub.goods.
     1867       define buffer out-vatp_trn-doc-prl     for ub.trn-doc.
     1868       define buffer out-vatp_doc-attr-prl    for ub.doc-attr.
     1869       define variable varprice-base-cons-prl      like ub.doc-line.price-base initial 0.00 no-undo.
     1870       define variable varprice-rubl-cons-prl      like ub.doc-line.price-rubl initial 0.00 no-undo.
     1871       define variable varfrm-cnsv-type-prl         as   character                           no-undo.
     1872       define variable varfrm-cnsv-prl              as   character                           no-undo.
     1873       define variable varroot-node-prl             as   integer                             no-undo.
     1874       define variable varempty-scale-prl           as   logical                             no-undo.
     1875       define variable varis-cons-parts-have-prl    as   logical                             no-undo.
     1876       define variable varsum-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     1877       define variable varslt-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     1878       define variable varvat-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     1879       define variable varvatcons-base-factovp-prl  like ub.gds-dtl.price-base               no-undo.
     1880       define variable vardsc-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     1881       define variable varsum-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     1882       define variable varslt-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     1883       define variable varvat-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     1884       define variable varvatcons-base-docovp-prl   like ub.gds-dtl.price-base               no-undo.
     1885       define variable vardsc-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     1886       define variable varsum-rubl-factovp-prl      like ub.gds-dtl.price-base               no-undo.
