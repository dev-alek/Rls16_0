     5065             "Артикул" p-artic p-prod-type p-prod-code skip
     5066             "Тип суммы" v-allsum-sum-type skip
     5067                                                                         "crsa-sum-base"       v-crsa-sum-base        skip     "crsa-sum-rubl"       v-crsa-sum-rubl        skip     "crsa-vat-base"       v-crsa-vat-base        skip     "crsa-vat-rubl"       v-crsa-vat-rubl        skip     "crsa-slt-base"       v-crsa-slt-base        skip     "crsa-slt-rubl"       v-crsa-slt-rubl        skip     "crsa-road-tax-base"  v-crsa-road-tax-base   skip     "crsa-road-tax-rubl"  v-crsa-road-tax-rubl   skip     "crsa-excise-base"    v-crsa-excise-base     skip     "crsa-excise-rubl"    v-crsa-excise-rubl     skip     "crsa-transport-base" v-crsa-transport-base  skip     "crsa-transport-rubl" v-crsa-transport-rubl  skip     "crsa-other-base"     v-crsa-other-base      skip     "crsa-other-rubl"     v-crsa-other-rubl      skip     "crsa-discnt-base"    v-crsa-discnt-base     skip     "crsa-discnt-rubl"    v-crsa-discnt-rubl     skip
     5068             view-as alert-box error .
