     5030           v-sale-road-tax-base  = buf_tt-allsum-line.road-tax-base-doc
     5031           v-sale-road-tax-rubl  = buf_tt-allsum-line.road-tax-rubl-doc
     5032           v-sale-excise-base    = buf_tt-allsum-line.excise-base-doc
     5033           v-sale-excise-rubl    = buf_tt-allsum-line.excise-rubl-doc
