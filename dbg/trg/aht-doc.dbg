      227   procedure aht_update-stk-table :
      228     define input  parameter p-fact-order     like ub.trn-doc.fact-order   no-undo .
      229     define input  parameter p-cut-fact-order like ub.trn-doc.fact-order   no-undo .
      230     define input  parameter p-ext-doc-type   like ub.trn-doc.ext-doc-type no-undo .
      231     define input  parameter p-trn-doc        as logical   no-undo .
      232     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
      233     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
      234     define variable v-stk-ext-sum-type as character no-undo .
      235     do
      236     on error undo, return error
      237     :
      238       for each buf_temp-aht-ot-tot
      239       on error undo, return error
      240       :
      241         run aht_get-stk-sum-type in this-procedure
      242           (input  buf_temp-aht-ot-tot.sum-type
      243           ,input  p-ext-doc-type
      244           ,output v-stk-ext-sum-type
      245           ) .
      246         run aht_store-stk-tot in this-procedure
      247           (buffer buf_temp-aht-ot-tot
      248           ,input buf_temp-aht-ot-tot.sum-type
      249           ,input p-fact-order
      250           ,input p-cut-fact-order
      251           ,input p-ext-doc-type
      252           ,input false
      253           ) .
      254         run aht_store-stk-tot in this-procedure
      255           (buffer buf_temp-aht-ot-tot
      256           ,input v-stk-ext-sum-type
      257           ,input p-fact-order
      258           ,input p-cut-fact-order
      259           ,input p-ext-doc-type
      260           ,input p-trn-doc
      261           ) .
      262       end.
      263       for each buf_temp-aht-ot-line
      264       on error undo, return error
      265       :
      266         run aht_get-stk-sum-type in this-procedure
      267           (input  buf_temp-aht-ot-line.sum-type
      268           ,input  p-ext-doc-type
      269           ,output v-stk-ext-sum-type
      270           ) .
      271         run aht_store-stk-line in this-procedure
      272           (buffer buf_temp-aht-ot-line
      273           ,input buf_temp-aht-ot-line.sum-type
      274           ,input p-fact-order
      275           ,input p-cut-fact-order
      276           ,input p-ext-doc-type
      277           ,input false
      278           ) .
      279         run aht_store-stk-line in this-procedure
      280           (buffer buf_temp-aht-ot-line
      281           ,input v-stk-ext-sum-type
      282           ,input p-fact-order
      283           ,input p-cut-fact-order
      284           ,input p-ext-doc-type
      285           ,input p-trn-doc
      286           ) .
      287       end.
      288     end.
      289   end procedure.
      290   procedure aht_store-stk-tot :
      291     define parameter buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
      292     define input  parameter p-stk-sum-type      as character no-undo .
      293     define input  parameter p-fact-order        like ub.trn-doc.fact-order   no-undo .
      294     define input  parameter p-cut-fact-order    like ub.trn-doc.fact-order   no-undo .
      295     define input  parameter p-ext-doc-type      like ub.trn-doc.ext-doc-type no-undo .
      296     define input  parameter p-update-sale       as logical   no-undo .
      297     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
      298     define buffer new-buf_aht-stk-tot for ub.aht-stk-tot .
      299     do
      300     on error undo, return error return-value
      301     :
      302       find last buf_aht-stk-tot exclusive-lock
      303         where buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
      304           and buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
      305           and buf_aht-stk-tot.sum-type   = p-stk-sum-type
      306           and buf_aht-stk-tot.fact-order <= p-fact-order
      307         use-index category
      308         no-error .
      309       if not available buf_aht-stk-tot
      310       or buf_aht-stk-tot.fact-order <> p-fact-order
      311       then do:
      312         create new-buf_aht-stk-tot .
      313         assign
      314           new-buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
      315           new-buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
      316           new-buf_aht-stk-tot.fact-order = p-fact-order
      317           new-buf_aht-stk-tot.sum-type   = p-stk-sum-type
      318         .
      319         if available buf_aht-stk-tot then do:
      320           assign
      321             new-buf_aht-stk-tot.fact-qnty = buf_aht-stk-tot.fact-qnty
      322                                                                         new-buf_aht-stk-tot.cost-sum-base       = buf_aht-stk-tot.cost-sum-base             new-buf_aht-stk-tot.cost-sum-rubl       = buf_aht-stk-tot.cost-sum-rubl             new-buf_aht-stk-tot.cost-vat-base       = buf_aht-stk-tot.cost-vat-base             new-buf_aht-stk-tot.cost-vat-rubl       = buf_aht-stk-tot.cost-vat-rubl             new-buf_aht-stk-tot.cost-slt-base       = buf_aht-stk-tot.cost-slt-base             new-buf_aht-stk-tot.cost-slt-rubl       = buf_aht-stk-tot.cost-slt-rubl             new-buf_aht-stk-tot.cost-road-tax-base  = buf_aht-stk-tot.cost-road-tax-base        new-buf_aht-stk-tot.cost-road-tax-rubl  = buf_aht-stk-tot.cost-road-tax-rubl        new-buf_aht-stk-tot.cost-excise-base    = buf_aht-stk-tot.cost-excise-base          new-buf_aht-stk-tot.cost-excise-rubl    = buf_aht-stk-tot.cost-excise-rubl          new-buf_aht-stk-tot.cost-transport-base = buf_aht-stk-tot.cost-transport-base       new-buf_aht-stk-tot.cost-transport-rubl = buf_aht-stk-tot.cost-transport-rubl       new-buf_aht-stk-tot.cost-other-base     = buf_aht-stk-tot.cost-other-base           new-buf_aht-stk-tot.cost-other-rubl     = buf_aht-stk-tot.cost-other-rubl           new-buf_aht-stk-tot.cost-discnt-base    = buf_aht-stk-tot.cost-discnt-base          new-buf_aht-stk-tot.cost-discnt-rubl    = buf_aht-stk-tot.cost-discnt-rubl
      323                                                                         new-buf_aht-stk-tot.crsa-sum-base       = buf_aht-stk-tot.crsa-sum-base             new-buf_aht-stk-tot.crsa-sum-rubl       = buf_aht-stk-tot.crsa-sum-rubl             new-buf_aht-stk-tot.crsa-vat-base       = buf_aht-stk-tot.crsa-vat-base             new-buf_aht-stk-tot.crsa-vat-rubl       = buf_aht-stk-tot.crsa-vat-rubl             new-buf_aht-stk-tot.crsa-slt-base       = buf_aht-stk-tot.crsa-slt-base             new-buf_aht-stk-tot.crsa-slt-rubl       = buf_aht-stk-tot.crsa-slt-rubl             new-buf_aht-stk-tot.crsa-road-tax-base  = buf_aht-stk-tot.crsa-road-tax-base        new-buf_aht-stk-tot.crsa-road-tax-rubl  = buf_aht-stk-tot.crsa-road-tax-rubl        new-buf_aht-stk-tot.crsa-excise-base    = buf_aht-stk-tot.crsa-excise-base          new-buf_aht-stk-tot.crsa-excise-rubl    = buf_aht-stk-tot.crsa-excise-rubl          new-buf_aht-stk-tot.crsa-transport-base = buf_aht-stk-tot.crsa-transport-base       new-buf_aht-stk-tot.crsa-transport-rubl = buf_aht-stk-tot.crsa-transport-rubl       new-buf_aht-stk-tot.crsa-other-base     = buf_aht-stk-tot.crsa-other-base           new-buf_aht-stk-tot.crsa-other-rubl     = buf_aht-stk-tot.crsa-other-rubl           new-buf_aht-stk-tot.crsa-discnt-base    = buf_aht-stk-tot.crsa-discnt-base          new-buf_aht-stk-tot.crsa-discnt-rubl    = buf_aht-stk-tot.crsa-discnt-rubl
      324           .
      325           if p-update-sale then do:
      326             assign
      327                                                                                       new-buf_aht-stk-tot.sale-sum-base       = buf_aht-stk-tot.sale-sum-base             new-buf_aht-stk-tot.sale-sum-rubl       = buf_aht-stk-tot.sale-sum-rubl             new-buf_aht-stk-tot.sale-vat-base       = buf_aht-stk-tot.sale-vat-base             new-buf_aht-stk-tot.sale-vat-rubl       = buf_aht-stk-tot.sale-vat-rubl             new-buf_aht-stk-tot.sale-slt-base       = buf_aht-stk-tot.sale-slt-base             new-buf_aht-stk-tot.sale-slt-rubl       = buf_aht-stk-tot.sale-slt-rubl             new-buf_aht-stk-tot.sale-road-tax-base  = buf_aht-stk-tot.sale-road-tax-base        new-buf_aht-stk-tot.sale-road-tax-rubl  = buf_aht-stk-tot.sale-road-tax-rubl        new-buf_aht-stk-tot.sale-excise-base    = buf_aht-stk-tot.sale-excise-base          new-buf_aht-stk-tot.sale-excise-rubl    = buf_aht-stk-tot.sale-excise-rubl          new-buf_aht-stk-tot.sale-transport-base = buf_aht-stk-tot.sale-transport-base       new-buf_aht-stk-tot.sale-transport-rubl = buf_aht-stk-tot.sale-transport-rubl       new-buf_aht-stk-tot.sale-other-base     = buf_aht-stk-tot.sale-other-base           new-buf_aht-stk-tot.sale-other-rubl     = buf_aht-stk-tot.sale-other-rubl           new-buf_aht-stk-tot.sale-discnt-base    = buf_aht-stk-tot.sale-discnt-base          new-buf_aht-stk-tot.sale-discnt-rubl    = buf_aht-stk-tot.sale-discnt-rubl
      328             .
      329           end.
      330         end.
      331       end.
      332       if p-stk-sum-type <> 'v':U
      333       then do:
      334         for each buf_aht-stk-tot exclusive-lock
      335           where buf_aht-stk-tot.obj-type   = buf_temp-aht-ot-tot.obj-type
      336             and buf_aht-stk-tot.obj-code   = buf_temp-aht-ot-tot.obj-code
      337             and buf_aht-stk-tot.sum-type   = p-stk-sum-type
      338             and buf_aht-stk-tot.fact-order >= p-fact-order
      339             and buf_aht-stk-tot.fact-order <= p-cut-fact-order
      340         :
      341           assign
      342             buf_aht-stk-tot.fact-qnty = buf_aht-stk-tot.fact-qnty + buf_temp-aht-ot-tot.fact-qnty
