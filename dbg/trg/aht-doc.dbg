     4123   end.
     4124   end procedure.
     4125   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4126   procedure prl-vat:
     4127     define input parameter parrecid as recid no-undo.
