      362     define buffer buf_aht-stk-line for ub.aht-stk-line .
      363     define buffer new-buf_aht-stk-line for ub.aht-stk-line .
      364     do
      365     on error undo, return error return-value
      366     :
      367       find last buf_aht-stk-line exclusive-lock
      368         where buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
      369           and buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
      370           and buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
      371           and buf_aht-stk-line.sum-type   = p-stk-sum-type
      372           and buf_aht-stk-line.fact-order <= p-fact-order
      373         use-index category
      374         no-error .
      375       if not available buf_aht-stk-line
      376       or buf_aht-stk-line.fact-order <> p-fact-order
      377       then do:
