        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code  as character no-undo .
        3   define input  parameter p-rcv-code  as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Отправка в новости шапки trn-doc".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable p-db-list as character no-undo .
       69   define variable v-rec-ord as integer no-undo .
       70   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
       71   find first buf_ord-doc-rcv  no-lock where
       72              buf_ord-doc-rcv.doc-code = p-doc-code and
       73              buf_ord-doc-rcv.rcv-code = p-rcv-code .
       74   run cus/rcv-db.p
       75     ( input buf_ord-doc-rcv.doc-code ,
       76       input buf_ord-doc-rcv.rcv-code ,
       77       output p-db-list
       78       ).
       79   define variable v-cmd-proc-handle as handle    no-undo .
       80   define variable v-cmd-code        as integer   no-undo .
       81   do
       82   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       83   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       84   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       85   :
       86     run nws/cmd-bush.p persistent set v-cmd-proc-handle
       87       no-error .
       88     if error-status :error
       89     then do:
       90       message
       91         vss-workfile vss-revision vss-description skip
       92         substitute("Ошибка при запуске процедуры cmd-bush.p") skip
       93         error-status :get-message(1) skip
       94         return-value skip
       95         view-as alert-box error .
       96       delete procedure v-cmd-proc-handle .
       97       undo, return error return-value .
       98     end.
       99     define variable v-command as character no-undo .
      100     v-command =  substitute("&2&1&3&1&4"
      101                 , chr(6)
      102                 , 'cmd-rcv-doc-rcv':U
      103                 , p-doc-code
      104                 , p-rcv-code
      105                 ).
      106     run begin-create-command in v-cmd-proc-handle
      107       (input  v-command
      108       ,input  p-db-list
      109       ,output v-cmd-code
      110       ) no-error.
      111     if error-status :error
      112     then do:
      113       message
      114         vss-workfile vss-revision vss-description skip
      115         substitute( "Ошибка при создании команды &1", 'cmd-rcv-doc-rcv':U ) skip
      116         error-status :get-message(1) skip
      117         return-value skip
      118         view-as alert-box error .
      119       delete procedure v-cmd-proc-handle .
      120       undo, return error return-value .
      121     end.
      122     for each buf_ord-doc-rcv exclusive-lock where buf_ord-doc-rcv.doc-code  = p-doc-code
      123     on error undo, return error return-value
      124     :
      125       run add-dump in v-cmd-proc-handle
      126         (input v-cmd-code
      127         ,input 'ord-doc-rcv':U
      128         ,input '+update':U
      129         ,input (buffer buf_ord-doc-rcv :handle)
      130         ,input '':U
      131         ,output v-rec-ord
      132         ) no-error .
      133       if error-status :error
      134       then do:
      135         message
      136           vss-workfile vss-revision vss-description skip
      137           substitute( "Ошибка при добавлении записи &1 в команду с кодом &2", 'ord-doc-rcv':U, v-cmd-code ) skip
      138           error-status :get-message(1) skip
      139           return-value skip
      140           view-as alert-box error .
      141         delete procedure v-cmd-proc-handle .
      142         undo, return error return-value .
      143       end.
      144     end.
      145     run send-command in v-cmd-proc-handle
      146       ( input v-cmd-code
      147        ,input p-db-list
      148       ) no-error .
      149     if error-status :error then do:
      150       message
      151         vss-workfile vss-revision vss-description skip
      152         substitute( "Ошибка при отправке в новости команды с кодом &1", v-cmd-code ) skip
      153         error-status :get-message(1) skip
      154         return-value skip
      155         view-as alert-box error .
      156       delete procedure v-cmd-proc-handle .
      157       undo, return error return-value .
      158     end.
      159     delete procedure v-cmd-proc-handle .
      160   end.
