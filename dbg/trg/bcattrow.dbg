      508       end.
      509     end.
      510   end procedure.
      511   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      513   define new global shared variable g#lib-nws as handle no-undo .
      514   procedure bc-attrh_write-bar-code-obj-attr-trigger :
      515   define input parameter p-new-record as logical no-undo .
      516   define input parameter p-action as integer no-undo .
      517   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      518   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      519   define variable v-date as date      no-undo.
      520   define variable v-time  as integer   no-undo.
      521   define variable v-host-code as integer no-undo .
      522   define buffer buf_c-gds-hist for ub.c-gds-hist.
      523   define buffer buf_c-bar-code-obj-attr for ub.c-bar-code-obj-attr.
      524     do
      525     on error undo, return error
      526     :
      527       if g#news then do:
      528         define variable v-send as integer no-undo .
      529         v-send = integer('0':U).
      530   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      532     (input  g#db-num
      533     ,input  'bar-code-obj-attr':U
      534     ,input  0
      535     ,input  '':U
      536     ,input  0
      537     ,input  '':U
      538     ,input  '':U
      539     ,input  '':U
      540     ,input  0
      541     ,input  0
      542     ,input  0
      543     ,input  'nws-to-hist'
      544     ,output v-send
      545     ) no-error .
      546         if v-send < 0 then return.
      547       end.
      548       run cur-time in this-procedure ( output v-date, output v-time).
      549       if ub.bar-code-obj-attr.obj-type = 'маг':U
      550       or ub.bar-code-obj-attr.obj-type = 'скл':U then do:
      551   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      553     (input  ub.bar-code-obj-attr.obj-type
      554     ,input  ub.bar-code-obj-attr.obj-code
      555     ,output v-host-code
      556     )  .
      557       end.
      558       create buf_c-bar-code-obj-attr.
      559       buffer-copy ub.bar-code-obj-attr to buf_c-bar-code-obj-attr
      560       assign
      561       buf_c-bar-code-obj-attr.gds-code           = (if p-new-record then ub.bar-code-obj-attr.gds-code else ub.bar-code-obj-attr.gds-code)
      562       buf_c-bar-code-obj-attr.b-code             = (if p-new-record then ub.bar-code-obj-attr.b-code else ub.bar-code-obj-attr.b-code)
      563       buf_c-bar-code-obj-attr.attr-code          = (if p-new-record then ub.bar-code-obj-attr.attr-code else ub.bar-code-obj-attr.attr-code)
      564       buf_c-bar-code-obj-attr.obj-type           = (if p-new-record then ub.bar-code-obj-attr.obj-type else ub.bar-code-obj-attr.obj-type)
      565       buf_c-bar-code-obj-attr.obj-code           = (if p-new-record then ub.bar-code-obj-attr.obj-code else ub.bar-code-obj-attr.obj-code)
      566       buf_c-bar-code-obj-attr.chip-num           = next-value (s-gds-chip, ub)
      567       buf_c-bar-code-obj-attr.corr-time          = v-time
      568       buf_c-bar-code-obj-attr.corr-user-db-num   = g#db-num
      569       buf_c-bar-code-obj-attr.corr-user-name     = (if g#news
      570                                            then (chr(4) +  'СПН':U)
      571                                            else (if g#esys
      572                                                  then (chr(4) +  'ВС':U)
      573                                                  else g#userid)
      574                                           )
      575       buf_c-bar-code-obj-attr.corr-date          = v-date
      576       .
      577       create buf_c-gds-hist.
      578       buffer-copy buf_c-bar-code-obj-attr to buf_c-gds-hist
      579       assign
      580       buf_c-gds-hist.gds-code           = buf_c-bar-code-obj-attr.gds-code
      581       buf_c-gds-hist.action = (if p-new-record
      582                                 then integer('1':U)
      583                                 else (if ub.bar-code-obj-attr.gds-code = ub.bar-code-obj-attr.gds-code
      584                                       and ub.bar-code-obj-attr.b-code  = ub.bar-code-obj-attr.b-code
      585                                       then p-action
      586                                       else integer('9':U))
      587                               )
      588       buf_c-gds-hist.b-code             = (if buf_c-gds-hist.action = integer('9':U)
      589                                           and ub.bar-code-obj-attr.b-code  <>  ub.bar-code-obj-attr.b-code
      590                                           then ub.bar-code-obj-attr.b-code
      591                                           else ub.bar-code-obj-attr.b-code)
      592       buf_c-gds-hist.subject = 'bar-code-obj-attr':U
      593       buf_c-gds-hist.host-code = v-host-code
      594       buf_c-gds-hist.is-news = g#news
      595       buf_c-gds-hist.source-type = (if g#news
      596                                     then 'db':U
      597                                     else (if g#esys
      598                                           then 'esys':U
      599                                           else "":U)
      600                                     )
      601       buf_c-gds-hist.source-ref = (if g#news
      602                                    then string(g#news-source-db)
      603                                    else (if g#esys
      604                                          then string(g#esys-source-esys)
      605                                          else "":U)
      606                                    )
      607       .
      608       if p-action = integer('99':U) then do:
      609         if
      610         not g#news
      611         OR (g#news
      612             and not ( g#db-num > 0 )
      613             and buf_c-bar-code-obj-attr.corr-user-name <> (chr(4) +  'СПН':U)
      614             )
      615         or (g#news
      616             and ( g#db-num > 0 )
      617             and buf_c-bar-code-obj-attr.corr-user-name = (chr(4) +  'СПН':U)
      618             )
      619         then
      620         run str/callnews.p
      621           (input 'c-bar-code-obj-attr':U
      622           ,input (buffer buf_c-bar-code-obj-attr:handle)
      623           ).
      624       end.
      625     end.
      626   end procedure.
      627   main-block:
      628   do
      629   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      630   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      631   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      632   :
      633     if not g#news then do:
      634       run check-use-bar-code in this-procedure ( input ub.bar-code-obj-attr.b-code) no-error.
      635       if error-status:error then do:
      636         undo main-block, return error return-value .
      637       end.
      638     end.
      639     if not g#news
      640     and not g#db-num = 0 then do:
      641       define variable attr-type as character no-undo .
      642       define variable attr-format as character no-undo .
      643       define variable attr-label as character no-undo .
      644       define variable attr-range as integer no-undo .
      645       define variable attr-user-can-edit as logical no-undo .
      646       define variable attr-output-display as logical no-undo .
      647       define variable attr-other as char no-undo .
      648       define variable v-obj-db-num as integer no-undo .
      649       run bc-oattr_name (
      650       input  ub.bar-code-obj-attr.attr-code
      651       ,output attr-type
      652       ,output attr-format
      653       ,output attr-label
      654       ,output attr-range
      655       ,output attr-user-can-edit
      656       ,output attr-output-display
      657       ,output attr-other
      658       ) .
      659       if attr-range = integer('2':U) then do:
      660   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      662     (input  ub.bar-code-obj-attr.obj-type
      663     ,input  ub.bar-code-obj-attr.obj-code
      664     ,output v-obj-db-num
      665     )  .
      666         if v-obj-db-num <> g#db-num then do:
      667            undo main-block, return error substitute("Нельзя заводить атрибут бар-кода <&1>, в контексте объекта в чужой УБД", ub.bar-code-obj-attr.attr-code).
      668         end.
      669       end.
      670     end.
      671     run str/callnews.p
      672       (input 'bar-code-obj-attr':U
      673       ,input (buffer ub.bar-code-obj-attr:handle)
      674       ) no-error .
      675     if error-status :error then do:
      676       message
      677         vss-workfile vss-revision vss-description skip
      678         "Невозможно маршрутизировать bar-code-attr для отправки в новости" skip
      679         error-status :get-message(1) skip
      680         return-value skip
      681         view-as alert-box.
      682       undo main-block, return error return-value .
      683     end.
      684     run bc-attrh_write-bar-code-obj-attr-trigger in this-procedure  (
      685                                           input new(ub.bar-code-obj-attr)
      686                                         ,input integer('2':U)
      687                                         ,input (if g#news
      688                                                 then 'db':U
      689                                                 else (if g#esys
      690                                                       then 'esys':U
      691                                                       else "":U
      692                                                       )
      693                                                 )
      694                                         ,input (if g#news
      695                                                 then string(g#news-source-db)
      696                                                 else (if g#esys
      697                                                       then string(g#esys-source-esys)
      698                                                       else  "":U)
      699                                                 )
      700                                       ) .
      701     if g#oxml = yes
      702     then do:
      703       run str/calloxml.p (
      704             input 'update':U
      705           , input 'bar-code-obj-attr':U
      706           , input ( buffer ub.bar-code-obj-attr:handle )
      707       ) no-error.
      708       if error-status :error
      709       then do:
      710           undo main-block, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      711                                , chr(10)
      712                                , vss-workfile
      713                                , return-value
      714                                , error-status :get-message ( 1 ) ).
      715       end.
      716     end.
      717   end.
