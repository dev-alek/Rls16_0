        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-host-code      like ub.fin-doc.host-code no-undo .
        4   define input parameter p-fin-doc-code   like ub.fin-doc.fin-doc-code no-undo .
        5   define input parameter p-close-mode     as character no-undo .
        6   define input parameter p-author         as character no-undo .
        7   define input parameter p-status_        as character no-undo .
        8   define input-output parameter p-status-date    like ub.fin-doc.fact-date no-undo .
        9   define input parameter p-silent                       as logical no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Перевод статусов для платежей".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure cur-time :
       87      define output parameter p-today as date      no-undo .
       88      define output parameter p-time  as integer   no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       define variable v-date1 as date      no-undo .
       93       define variable v-date2 as date      no-undo .
       94       define variable v-time  as integer   no-undo .
       95       assign
       96         v-date1 = today
       97         v-time  = time
       98         v-date2 = today
       99       .
      100       if v-date1 <> v-date2
      101       then do:
      102         assign
      103           v-date1 = today
      104           v-time  = v-time
      105         .
      106       end.
      107       assign
      108         p-today = v-date1
      109         p-time  = v-time
      110       .
      111     end.
      112   end.
      113   function cur-time-date returns character
      114   :
      115     return string(today, '99/99/9999':U) .
      116   end.
      117   function cur-time-mjd returns decimal
      118   :
      119     define variable v-date as date      no-undo .
      120     define variable v-time as integer   no-undo .
      121     run cur-time in this-procedure
      122       (output v-date
      123       ,output v-time
      124       ) .
      125     return integer(v-date) - 2400002 + (v-time / 86400) .
      126   end.
      127   function cur-time-get-ending-index returns integer
      128   (input p-number as integer
      129   )
      130   :
      131     if p-number < 0
      132     or p-number = ?
      133     then do:
      134       return 1 .
      135     end.
      136     define variable v-rest as integer   no-undo .
      137     assign
      138       p-number = p-number modulo 100
      139     .
      140     if p-number < 20
      141     then do:
      142       assign
      143         v-rest = p-number
      144       .
      145     end.
      146     else do:
      147       assign
      148         v-rest = p-number modulo 10
      149       .
      150     end.
      151     case v-rest :
      152       when 1
      153       then do:
      154         return 2 .
      155       end.
      156       when 2 or
      157       when 3 or
      158       when 4
      159       then do:
      160         return 3 .
      161       end.
      162       otherwise do:
      163         return 1 .
      164       end.
      165     end case .
      166   end.
      167   procedure cur-time-mjd-to-date :
      168      define input  parameter i-mjd-diff as decimal no-undo.
      169      define output parameter o-Date     as date    no-undo.
      170      define output parameter o-Time     as integer no-undo.
      171      define variable v-day-number as integer   no-undo .
      172      if    i-mjd-diff < 0
      173         or i-mjd-diff = ?
      174      then do:
      175         return "?" .
      176      end.
      177      assign
      178         v-day-number = truncate(i-mjd-diff,0).
      179         o-Date = date(v-day-number + 2400002).
      180         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      181     .
      182   end.
      183   function cur-time-mjd-to-string returns character
      184   (input p-mjd-diff as decimal
      185   )
      186   :
      187     define variable v-day-number as integer   no-undo .
      188     define variable v-seconds    as integer   no-undo .
      189     define variable v-hour       as integer   no-undo .
      190     define variable v-min        as integer   no-undo .
      191     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      192     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      193     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      194     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      195     if p-mjd-diff < 0
      196     or p-mjd-diff = ?
      197     then do:
      198       return "?" .
      199     end.
      200     assign
      201       v-day-number = integer(truncate(p-mjd-diff,0))
      202       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204     if v-seconds > 86400
      205     then do:
      206       assign
      207         v-seconds = 86400 - 1
      208       .
      209     end.
      210     if v-seconds < 0
      211     then do:
      212       assign
      213         v-seconds = 0
      214       .
      215     end.
      216     assign
      217       v-hour = truncate(v-seconds / 3600, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 3600
      221     .
      222     assign
      223       v-min = truncate(v-seconds / 60, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 60
      227     .
      228     return
      229         (if v-day-number <> 0
      230           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0
      234           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      238           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      239           else ""
      240         )
      241       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      242       .
      243   end.
      244   function cur-time-string returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      253   end.
      254   function cur-time-string-sec returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      263   end.
      264   function cur-time-custom  returns character
      265   (input p-prefix as character
      266   ,input p-date-format as character
      267   ,input p-delimiter as character
      268   ,input p-time-format as character
      269   ,input p-suffix as character
      270   )
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return
      279       p-prefix
      280       + string(v-date, p-date-format)
      281       + p-delimiter
      282       + string(v-time, p-time-format)
      283       + p-suffix
      284       .
      285   end.
      286   function cur-time-print  returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-datetime returns datetime
      297   :
      298     define variable v-char as character no-undo .
      299     define variable v-datetime as datetime no-undo .
      300     v-char = cur-time-string().
      301     v-datetime = datetime(v-char).
      302     return  v-datetime.
      303   end.
      304   function cur-time-string-msec returns character
      305   :
      306     define variable v-date as datetime  no-undo .
      307     v-date = now.
      308     return string(v-date) .
      309   end.
      310   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   procedure factord :
      312     define input  parameter p-fact-date            as date    no-undo .
      313     define input  parameter p-fact-time            as integer no-undo .
      314     define input  parameter p-fact-num             as integer no-undo .
      315     define input  parameter p-shift-date           as date    no-undo .
      316     define input  parameter p-shift-num            as integer no-undo .
      317     define input  parameter p-shift-on             as logical no-undo .
      318     define output parameter p-fact-order           as decimal no-undo .
      319     define output parameter p-shift-end-fact-order as decimal no-undo .
      320     define output parameter p-day-end-fact-order   as decimal no-undo .
      321     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      322     if p-fact-date = ?
      323     then do:
      324       return error "Не указана фактическая дата" .
      325     end.
      326     define variable v-fact-date-num as integer no-undo .
      327     assign
      328       v-fact-date-num = integer(p-fact-date)
      329     .
      330     if p-fact-num = ?
      331     or p-fact-num = 0
      332     then do:
      333       return error "Не задан p-fact-num " + string(p-fact-num) .
      334     end.
      335     if p-fact-num < 0
      336     then do:
      337       return error "Отрицательный fact-num " + string(p-fact-num) .
      338     end.
      339     if p-fact-num >= 100000000
      340     then do:
      341       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      342     end.
      343     if p-shift-on = true
      344     then do:
      345       if p-shift-date = ?
      346       then do:
      347         return error "Не задана дата смены" .
      348       end.
      349       if p-shift-num = ?
      350       or p-shift-num = 0
      351       then do:
      352         return error "Не задан номер смены" .
      353       end.
      354     end.
      355     else do:
      356       assign
      357         p-shift-date = p-fact-date
      358         p-shift-num  = 24
      359       .
      360     end.
      361     define variable v-shift-offset as integer no-undo .
      362     if p-shift-date = p-fact-date
      363     then do:
      364       assign
      365         v-shift-offset = 1
      366       .
      367     end.
      368     if p-shift-date < p-fact-date
      369     then do:
      370       assign
      371         v-shift-offset = 0
      372       .
      373     end.
      374     if p-shift-date > p-fact-date
      375     then do:
      376       message
      377         vss-workfile vss-revision vss-description skip
      378         "Неправильная дата закрытия смены" skip
      379         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      380         view-as alert-box error .
      381       undo, return error
      382         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      383           ,string(p-fact-date, '99/99/9999':U)
      384           ,string(p-shift-date, '99/99/9999':U)
      385           )
      386       .
      387     end.
      388     if p-shift-num < 1
      389     or p-shift-num > 24
      390     then do:
      391       message
      392         vss-workfile vss-revision vss-description skip
      393         "Неправильный номер смены" skip
      394         "p-shift-num" p-shift-num skip
      395         view-as alert-box error .
      396       undo, return error return-value .
      397     end.
      398     assign
      399       p-fact-order           = v-fact-date-num
      400                              + v-shift-offset * 0.5
      401                              + p-shift-num    * 0.02 - 0.01
      402                              + p-fact-num     * 0.0000000001
      403       p-shift-end-fact-order = v-fact-date-num
      404                              + v-shift-offset * 0.5
      405                              + p-shift-num    * 0.02
      406       p-day-end-fact-order   = v-fact-date-num
      407                              + 0.99
      408     .
      409     if p-fact-order           <= v-fact-date-num
      410     or p-shift-end-fact-order <= v-fact-date-num
      411     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      412     or p-shift-end-fact-order >= p-day-end-fact-order
      413     then do:
      414       message
      415         vss-workfile vss-revision vss-description skip
      416         "Внутренняя ошибка при генерации фактического номера" skip
      417         "p-fact-date"            p-fact-date            skip
      418         "p-fact-time"            p-fact-time            skip
      419         "p-fact-num"             p-fact-num             skip
      420         "p-shift-date"           p-shift-date           skip
      421         "p-shift-num"            p-shift-num            skip
      422         "p-shift-on"             p-shift-on             skip
      423         "p-shift-end-fact-order" p-shift-end-fact-order skip
      424         "p-day-end-fact-order"   p-day-end-fact-order   skip
      425         "v-fact-date-num"        v-fact-date-num        skip
      426         view-as alert-box error .
      427       undo, return error return-value .
      428     end.
      429   end procedure.
      430   procedure day-begin-fact-order :
      431     define input  parameter p-fact-date            as date    no-undo .
      432     define output parameter p-day-begin-fact-order as decimal no-undo .
      433     do
      434     on error undo, return error return-value
      435     :
      436       if p-fact-date = ?
      437       then do:
      438         assign
      439           p-day-begin-fact-order = 0
      440         .
      441       end.
      442       else do:
      443         assign
      444           p-day-begin-fact-order = integer(p-fact-date)
      445         .
      446       end.
      447     end.
      448   end procedure.
      449   procedure factord-max-fact-order :
      450     define output parameter p-max-fact-order as decimal   no-undo .
      451     do
      452     on error undo, return error return-value
      453     :
      454       run day-begin-fact-order in this-procedure
      455         (input  date(1, 1, 5000)
      456         ,output p-max-fact-order
      457         ) .
      458     end.
      459   end procedure.
      460   procedure factord-cut-archive :
      461     define input  parameter p-obj-type             as character no-undo .
      462     define input  parameter p-obj-code             as integer   no-undo .
      463     define input  parameter p-fact-date            as date      no-undo .
      464     define output parameter p-shift-on             as logical   no-undo .
      465     define output parameter p-shift-date           as date      no-undo .
      466     define output parameter p-shift-num            as integer   no-undo .
      467     define output parameter p-day-end-fact-order   as decimal   no-undo .
      468     define output parameter p-shift-end-fact-order as decimal   no-undo .
      469     define variable v-fact-order as decimal   no-undo .
      470     define buffer buf_shift-obj for ub.shift-obj .
      471     do
      472     on error undo, return error return-value
      473     :
      474   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      476     (input  p-obj-type
      477     ,input  p-obj-code
      478     ,input  'shift-on=request'
      479     ,output p-shift-on
      480     ) no-error .
      481       if error-status :error
      482       then do:
      483         message
      484           vss-workfile vss-revision vss-description skip
      485           "Ошибка при определении атрибута объекта" skip
      486           "Объект" p-obj-type p-obj-code skip
      487           error-status :get-message(1) skip
      488           return-value skip
      489           view-as alert-box error .
      490         undo, return error return-value .
      491       end.
      492       if p-shift-on = false
      493       then do:
      494         assign
      495           p-shift-date               = ?
      496           p-shift-num                = 0
      497         .
      498       end.
      499       else do:
      500         find first buf_shift-obj share-lock
      501           where buf_shift-obj.obj-type   = p-obj-type
      502             and buf_shift-obj.obj-code   = p-obj-code
      503             and buf_shift-obj.shift-date > p-fact-date
      504           use-index pi
      505           no-error .
      506         if not available buf_shift-obj
      507         or buf_shift-obj.status_ <> 'зкр':U
      508         then do:
      509           message
      510             vss-workfile vss-revision vss-description skip
      511             "Невозможно вычислить последнюю смену" skip
      512             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      513             "Объект" p-obj-type p-obj-code skip
      514             "Дата" p-fact-date skip
      515             view-as alert-box error .
      516           undo, return error return-value .
      517         end.
      518         find last buf_shift-obj share-lock
      519           where buf_shift-obj.obj-type = p-obj-type
      520             and buf_shift-obj.obj-code = p-obj-code
      521             and buf_shift-obj.shift-date <= p-fact-date
      522           use-index pi
      523           no-error .
      524         if available buf_shift-obj
      525         then do:
      526           if  buf_shift-obj.status_ = 'зкр':U
      527           then do:
      528             assign
      529               p-shift-date = buf_shift-obj.shift-date
      530               p-shift-num  = buf_shift-obj.shift-num
      531             .
      532           end.
      533           else do:
      534             message
      535               vss-workfile vss-revision vss-description skip
      536               "Невозможно вычислить последнюю смену" skip
      537               "Статус смены отличен от статуса" 'зкр':U skip
      538               "Объект" p-obj-type p-obj-code skip
      539               "Дата" p-fact-date skip
      540               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      541               view-as alert-box error .
      542             undo, return error return-value .
      543           end.
      544         end.
      545         else do:
      546           assign
      547             p-shift-date = p-fact-date - 1
      548             p-shift-num  = 1
      549           .
      550         end.
      551       end.
      552       run factord in this-procedure
      553         (input  p-fact-date
      554         ,input  1
      555         ,input  1
      556         ,input  p-shift-date
      557         ,input  p-shift-num
      558         ,input  p-shift-on
      559         ,output v-fact-order
      560         ,output p-shift-end-fact-order
      561         ,output p-day-end-fact-order
      562         ) no-error .
      563       if error-status :error
      564       then do:
      565         message
      566           vss-workfile vss-revision vss-description skip
      567           "Ошибка при вызове процедуры factord"
      568           error-status :get-message(1) skip
      569           return-value skip
      570           view-as alert-box error .
      571         undo, return error return-value .
      572       end.
      573     end.
      574   end procedure.
      575   procedure factord-lock-shift :
      576     define input  parameter p-obj-type  as character no-undo .
      577     define input  parameter p-obj-code  as integer   no-undo .
      578     define input  parameter p-fact-date as date      no-undo .
      579     define parameter buffer buf_shift-obj for ub.shift-obj .
      580     define variable v-shift-on      as logical   no-undo .
      581     define variable v-extra-message as character no-undo .
      582     define variable v-error as character no-undo .
      583     do
      584     on error undo, return error return-value
      585     :
      586   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      588     (input  p-obj-type
      589     ,input  p-obj-code
      590     ,input  'shift-on=request'
      591     ,output v-shift-on
      592     ) no-error .
      593       if error-status :error
      594       then do:
      595         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      596         undo, return error v-error .
      597       end.
      598       if v-shift-on = true
      599       then do:
      600         find first buf_shift-obj share-lock
      601           where buf_shift-obj.obj-type   = p-obj-type
      602             and buf_shift-obj.obj-code   = p-obj-code
      603             and buf_shift-obj.shift-date > p-fact-date
      604           use-index pi
      605           no-error .
      606         if not available buf_shift-obj
      607         or buf_shift-obj.status_ <> 'зкр':U
      608         then do:
      609           find last buf_shift-obj
      610             where buf_shift-obj.obj-type = p-obj-type
      611               and buf_shift-obj.obj-code = p-obj-code
      612               and buf_shift-obj.status_  = 'зкр':U
      613             use-index stts
      614             no-error .
      615           if available buf_shift-obj
      616           then do:
      617             assign
      618               v-extra-message =
      619                     substitute("Дата начала последеней закрытой смены на объекте &1"
      620                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      621                               )
      622             .
      623           end.
      624           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      625           undo, return error v-error .
      626         end.
      627       end.
      628     end.
      629   end procedure.
      630   procedure factord-end-day :
      631     define input  parameter p-fact-date            as date    no-undo .
      632     define output parameter p-day-end-fact-order   as decimal no-undo .
      633     do
      634     on error undo, return error return-value
      635     :
      636       if p-fact-date = ?
      637       then do:
      638         return error "Не указана фактическая дата" .
      639       end.
      640       assign
      641         p-day-end-fact-order = integer(p-fact-date) + 0.99
      642       .
      643     end.
      644   end procedure.
      645   procedure factord-to-date :
      646     define input  parameter p-fact-order as decimal no-undo .
      647     define output parameter p-fact-date  as date    no-undo .
      648     define variable v-ref-date  as date      no-undo .
      649     define variable v-ref-delta as integer   no-undo .
      650     do
      651     on error undo, return error return-value
      652     :
      653       if p-fact-order = ?
      654       or p-fact-order = 0
      655       then do:
      656         return error "Не указан fact-order" .
      657       end.
      658       assign
      659         v-ref-date  = date(1, 1, 2000)
      660       .
      661       assign
      662         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      663       .
      664       assign
      665         p-fact-date = v-ref-date + v-ref-delta
      666       .
      667     end.
      668   end procedure.
      669   procedure factord-to-fact-num :
      670     define input  parameter p-fact-order as decimal no-undo .
      671     define output parameter p-fact-num   as integer no-undo .
      672     define variable v-fact-order-trunc as decimal no-undo .
      673     do
      674     on error undo, return error return-value
      675     :
      676       if p-fact-order = ?
      677       or p-fact-order = 0
      678       then do:
      679         return error "Не указан fact-order" .
      680       end.
      681       assign
      682        v-fact-order-trunc = truncate(p-fact-order, 2)
      683       .
      684       assign
      685         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      686       .
      687     end.
      688   end procedure.
      689   procedure factord-to-shift-num :
      690     define input  parameter p-fact-order as decimal no-undo .
      691     define output parameter p-shift-num   as integer no-undo .
      692     define variable  p-shift-numd  as decimal   no-undo .
      693     define variable v-fact-order-trunc as decimal no-undo .
      694     do
      695     on error undo, return error return-value
      696     :
      697       if p-fact-order = ?
      698       or p-fact-order = 0
      699       then do:
      700         return error "Не указан fact-order" .
      701       end.
      702       assign
      703        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      704       .
      705       if v-fact-order-trunc < 0.5 then do:
      706         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      707       end.
      708       assign
      709         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      710         .
      711        assign
      712         p-shift-num = truncate (p-shift-numd , 0)
      713       .
      714     end.
      715   end procedure.
      716   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717   define new global shared variable g#lib-farh as handle no-undo .
      718   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      719   procedure fd-attr-code :
      720     do
      721     on error undo, return error
      722     :
      723       define input  parameter p-code           as character no-undo .
      724       define output parameter p-type           as character no-undo .
      725       define output parameter p-format         as character no-undo .
      726       define output parameter p-label          as character no-undo .
      727       define output parameter p-user-can-edit  as logical   no-undo .
      728       define output parameter p-output-display as logical   no-undo .
      729       define output parameter p-other          as character no-undo .
      730       case p-code :
      731               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      732               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      733               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      734               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      735               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      736               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      737               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
      738               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      739         otherwise do:
      740           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      741         end.
      742       end.
      743     end.
      744   end procedure.
      745   procedure fd-attr-tooltip :
      746     do
      747     on error undo, return error
      748     :
      749       define input  parameter p-code    as character no-undo .
      750       define output parameter p-tooltip as character no-undo .
      751       define output parameter p-label   as character no-undo .
      752       case p-code :
      753               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
      754               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
      755               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
      756               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
      757               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
      758               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
      759               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
      760               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
      761         otherwise do:
      762           undo, return error "неизвестный атрибут платежа" + " " + p-code .
      763         end.
      764       end.
      765     end.
      766   end procedure.
      767   procedure fin-doc-attr-write :
      768    do
      769    on error undo, return error return-value
      770    :
      771   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      772   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      773   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
      774   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
      775   define variable  v-format         as character no-undo .
      776   define variable  v-label          as character no-undo .
      777   define variable  v-user-can-edit  as logical   no-undo .
      778   define variable  v-output-display as logical   no-undo .
      779   define variable  v-other          as character no-undo .
      780   define variable  v-type           as character no-undo .
      781   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
      782   run fd-attr-code in this-procedure
      783                                     (input  p-attr-code
      784                                     ,output v-type
      785                                     ,output v-format
      786                                     ,output v-label
      787                                     ,output v-user-can-edit
      788                                     ,output v-output-display
      789                                     ,output v-other
      790                                     ) no-error .
      791   if error-status :error then do:
      792     undo, return error return-value .
      793   end.
      794   find first buf_fin-doc-attr  exclusive-lock  where
      795             buf_fin-doc-attr.attr-code    = p-attr-code
      796         AND buf_fin-doc-attr.host-code    = p-host-code
      797         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
      798     if not available  buf_fin-doc-attr then do:
      799         create buf_fin-doc-attr.
      800         assign
      801         buf_fin-doc-attr.attr-code    = p-attr-code
      802         buf_fin-doc-attr.attr-value   = p-attr-value
      803         buf_fin-doc-attr.host-code    = p-host-code
      804         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
      805         .
      806     end.
      807     else do:
      808          assign
      809          buf_fin-doc-attr.attr-value = p-attr-value.
      810     end.
      811    end.
      812   end procedure.
      813   procedure fd-attr-exist :
      814     do
      815     on error undo, return error
      816     :
      817       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      818       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      819       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      820       define output parameter p-exist   as logical  no-undo .
      821       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      822       define variable  v-type           as character no-undo .
      823       define variable  v-format         as character no-undo .
      824       define variable  v-label          as character no-undo .
      825       define variable  v-user-can-edit  as logical   no-undo .
      826       define variable  v-output-display as logical   no-undo .
      827       define variable  v-other          as character no-undo .
      828       run fd-attr-code in this-procedure
      829         (input  p-code
      830         ,output v-type
      831         ,output v-format
      832         ,output v-label
      833         ,output v-user-can-edit
      834         ,output v-output-display
      835         ,output v-other
      836         ) no-error .
      837       if error-status :error then do:
      838         undo, return error return-value .
      839       end.
      840       find first buf_fin-doc-attr exclusive-lock
      841         where buf_fin-doc-attr.host-code  = p-host-code
      842           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      843           and buf_fin-doc-attr.attr-code = p-code
      844         no-error .
      845       if  available buf_fin-doc-attr then do:
      846         p-exist = yes.
      847       end.
      848     end.
      849   end procedure.
      850   procedure fd-attr-delete :
      851     do
      852     on error undo, return error
      853     :
      854     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
      855     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
      856     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
      857     define output parameter p-deleted  as logical no-undo.
      858       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
      859       define variable  v-type           as character no-undo .
      860       define variable  v-format         as character no-undo .
      861       define variable  v-label          as character no-undo .
      862       define variable  v-user-can-edit  as logical   no-undo .
      863       define variable  v-output-display as logical   no-undo .
      864       define variable  v-other          as character no-undo .
      865       run fd-attr-code in this-procedure
      866         (input  p-code
      867         ,output v-type
      868         ,output v-format
      869         ,output v-label
      870         ,output v-user-can-edit
      871         ,output v-output-display
      872         ,output v-other
      873         ) no-error .
      874       if error-status :error then do:
      875         undo, return error return-value .
      876       end.
      877       find first buf_fin-doc-attr exclusive-lock
      878         where buf_fin-doc-attr.host-code  = p-host-code
      879           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
      880           and buf_fin-doc-attr.attr-code = p-code
      881         no-error NO-WAIT.
      882       if not available buf_fin-doc-attr then do:
      883         p-deleted = no.
      884       end.
      885       else do:
      886         delete buf_fin-doc-attr no-error .
      887         if error-status:error then do:
      888           undo, return error return-value .
      889         end.
      890         p-deleted = yes.
      891       end.
      892     end.
      893   end procedure.
      894   procedure fin-doc-attr-value :
