      955   procedure c-fin-doc-attr-write :
      956    do
      957    on error undo, return error return-value
      958    :
      959   define input parameter p-host-code     like ub.c-fin-doc-attr.host-code  no-undo .
      960   define input parameter p-fin-doc-code  like ub.c-fin-doc-attr.fin-doc-code   no-undo .
      961   define input parameter p-corr-user-db-num  like ub.c-fin-doc-attr.corr-user-db-num   no-undo .
      962   define input parameter p-chip-num      like ub.c-fin-doc-attr.chip-num   no-undo .
      963   define input parameter p-attr-code     like ub.c-fin-doc-attr.attr-code  no-undo .
      964   define input parameter p-attr-value    like ub.c-fin-doc-attr.attr-value no-undo .
      965   define variable  v-format         as character no-undo .
      966   define variable  v-label          as character no-undo .
      967   define variable  v-user-can-edit  as logical   no-undo .
      968   define variable  v-output-display as logical   no-undo .
      969   define variable  v-other          as character no-undo .
      970   define variable  v-type           as character no-undo .
      971   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      972   run fd-attr-code in this-procedure
      973                                     (input  p-attr-code
      974                                     ,output v-type
      975                                     ,output v-format
      976                                     ,output v-label
      977                                     ,output v-user-can-edit
      978                                     ,output v-output-display
      979                                     ,output v-other
      980                                     ) no-error .
      981   if error-status :error then do:
      982     undo, return error return-value .
      983   end.
      984   find first buf_c-fin-doc-attr  exclusive-lock  where
      985             buf_c-fin-doc-attr.attr-code    = p-attr-code
      986         AND buf_c-fin-doc-attr.host-code    = p-host-code
      987         AND buf_c-fin-doc-attr.fin-doc-code     = p-fin-doc-code
      988         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
      989         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
      990     if not available  buf_c-fin-doc-attr then do:
      991         create buf_c-fin-doc-attr.
      992         assign
      993         buf_c-fin-doc-attr.attr-code    = p-attr-code
      994         buf_c-fin-doc-attr.attr-value   = p-attr-value
      995         buf_c-fin-doc-attr.host-code    = p-host-code
      996         buf_c-fin-doc-attr.fin-doc-code     = p-fin-doc-code
      997         .
      998     end.
      999     else do:
     1000           buf_c-fin-doc-attr.attr-value   = p-attr-value .
     1001     end.
     1002    end.
     1003   end procedure.
     1004   procedure c-fin-doc-attr-value :
     1005    do
