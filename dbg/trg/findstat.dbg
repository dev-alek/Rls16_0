     1386   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1387   procedure gen-key-rec :
     1388     define input  parameter p-tbl-name    as character no-undo.
     1389     define input  parameter p-bh_tbl-name as handle    no-undo.
     1390     define output parameter p-key-rec     as character no-undo.
     1391     do
     1392     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1393     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1394     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1395     :
     1396       define variable fh               as handle    no-undo .
     1397       define variable v-ok             as logical   no-undo .
     1398       define variable v-inform         as character no-undo .
     1399       define variable v-ind            as integer   no-undo .
     1400       define variable v-idx-field-qnty as integer   no-undo .
     1401       if p-tbl-name = ?
     1402         or p-tbl-name = "":U
     1403       then do:
     1404         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
     1405       end.
     1406       if not p-bh_tbl-name:available then do:
     1407         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
     1408       end.
     1409       assign
     1410         p-key-rec = p-tbl-name
     1411         v-inform  = p-bh_tbl-name:index-information(1)
     1412         v-ind     = 2
     1413       .
     1414       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1415       on error undo, return error
     1416       :
     1417         assign
     1418           v-inform = p-bh_tbl-name:index-information( v-ind )
     1419           v-ind    = v-ind + 1
     1420         .
     1421       end.
     1422       if v-inform = ?
     1423         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1424         or entry( 3, v-inform, ",":U ) <> "1":U
     1425       then do:
     1426         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
     1427       end.
     1428       else do:
     1429         assign
     1430           v-idx-field-qnty = num-entries( v-inform ) - 4
     1431         .
     1432         if v-idx-field-qnty < 2 then do:
     1433           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
     1434         end.
     1435         do v-ind = 1 to v-idx-field-qnty by 2
     1436         on error undo, return error
     1437         :
     1438           assign
     1439             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1440             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1441           .
     1442         end.
     1443       end.
     1444       if p-key-rec = ? then do:
     1445         assign
     1446           p-key-rec = "":U
     1447         .
     1448         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
     1449       end.
     1450     end.
     1451     return.
     1452   end procedure.
     1453   procedure gen-where-keyr-tab :
     1454     define input  parameter i-tableSerach as character no-undo.
     1455     define input  parameter i-tablekey   as character  no-undo.
     1456     define input  parameter p-key-rec    as character  no-undo.
     1457     define input  parameter p-key-handle as handle     no-undo .
     1458     define input  parameter p-db-name    as character  no-undo .
     1459     define input  parameter p-tt-handle  as handle     no-undo .
     1460     define output parameter o-Where      as character  no-undo.
     1461     do
     1462     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1463     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1464     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1465     :
     1466       define variable v-full-tbl-name  as character no-undo .
     1467       define variable bh_tbl-name      as handle    no-undo .
     1468       define variable fh_key           as handle    no-undo .
     1469       define variable fh_search        as handle    no-undo .
     1470       define variable v-field-num      as integer   no-undo .
     1471       define variable v-count-fld      as integer   no-undo .
     1472       define variable v-inform         as character no-undo .
     1473       define variable v-ind            as integer   no-undo .
     1474       define variable v-idx-field-qnty as integer   no-undo .
     1475       define variable v-field-name     as character no-undo .
     1476       define variable v-field-val      as character no-undo .
     1477       define variable v-word-link      as character no-undo .
     1478       define variable vTable           as character no-undo.
     1479       define variable bh_tbl-key       as handle    no-undo .
     1480       assign
     1481         p-key-rec = trim( p-key-rec )
     1482       .
     1483       if p-key-handle <> ? then do:
     1484         if not valid-handle(p-key-handle)
     1485            or p-key-handle:type <> "buffer"
     1486         then do:
     1487           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
     1488         end.
     1489         if num-entries( p-key-rec, chr(3) ) > 1
     1490           or p-key-rec = ?
     1491           or p-key-rec = "":U
     1492         then do:
     1493           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
     1494         end.
     1495       end.
     1496       else do:
     1497         if p-key-rec = ?
     1498           or p-key-rec = "":U
     1499         then do:
     1500           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     1501         end.
     1502       end.
     1503       assign
     1504         vTable = entry( 1 , p-key-rec, chr(3) )
     1505       .
     1506       if p-tt-handle <> ?
     1507         and ( not valid-handle(p-tt-handle)
     1508               or p-tt-handle:type <> "buffer"
     1509             )
     1510       then do:
     1511         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
     1512       end.
     1513       if p-tt-handle = ? then do:
     1514         assign
     1515           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1516         .
     1517         create buffer bh_tbl-name for table v-full-tbl-name .
     1518       end.
     1519       else do:
     1520         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1521       end.
     1522       assign
     1523         v-inform = bh_tbl-name:index-information(1)
     1524         v-ind    = 2
     1525       .
     1526       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1527       on error undo, return error
     1528       :
     1529         assign
     1530           v-inform = bh_tbl-name:index-information( v-ind )
     1531           v-ind    = v-ind + 1
     1532         .
     1533       end.
     1534       if v-inform = ?
     1535         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1536         or entry( 3, v-inform, ",":U ) <> "1":U
     1537       then do:
     1538         delete object bh_tbl-name no-error.
     1539         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
     1540       end.
     1541       assign
     1542         v-idx-field-qnty = num-entries( v-inform ) - 4
     1543       .
     1544       if v-idx-field-qnty < 2 then do:
     1545         delete object bh_tbl-name no-error.
     1546         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
     1547       end.
     1548       assign
     1549         o-where     = "where":U
     1550         v-word-link = "":U
     1551         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1552         v-count-fld = 0
     1553       .
     1554       if i-tablekey ne "" and i-tablekey ne ?
     1555       then do:
     1556         assign
     1557           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1558         .
     1559         create buffer bh_tbl-key for table v-full-tbl-name .
     1560       end.
     1561       if i-tableSerach ne "" and i-tableSerach ne ?
     1562       then do:
     1563         delete object bh_tbl-name no-error.
     1564         assign
     1565           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1566         .
     1567         create buffer bh_tbl-name for table v-full-tbl-name .
     1568       end.
     1569       block_where:
     1570       do v-ind = 1 to v-idx-field-qnty by 2
     1571       on error undo, return error
     1572       :
     1573         assign
     1574           v-count-fld = v-count-fld + 1
     1575         .
     1576         if p-key-handle = ?
     1577           and v-count-fld > v-field-num
     1578         then do:
     1579           leave block_where.
     1580         end.
     1581         define variable VfieldKeyTable as handle no-undo.
     1582         assign
     1583           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1584           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1585         .
     1586         if     bh_tbl-key ne ?
     1587         then do:
     1588            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1589            if VfieldKeyTable eq ?
     1590            then next block_where.
     1591         end.
     1592         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1593         then
     1594            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1595         else
     1596            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1597         if p-key-handle = ? then do:
     1598           assign
     1599             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1600           .
     1601         end.
     1602         else do:
     1603           assign
     1604             fh_key = p-key-handle:buffer-field( v-field-name )
     1605           .
     1606           if fh_key = ?
     1607             or not valid-handle( fh_key )
     1608           then do:
     1609             delete object bh_tbl-name.
     1610             if     bh_tbl-key ne ?
     1611             then
     1612                delete object bh_tbl-key.
     1613             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
     1614           end.
     1615           assign
     1616             v-field-val = fh_key:buffer-value
     1617           .
     1618         end.
     1619         if fh_search:data-type ="character":U then do:
     1620           assign
     1621             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1622             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1623             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1624             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1625             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1626             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1627             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1628             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1629             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1630             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1631             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1632             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1633             v-field-val = substitute( '"&1"', v-field-val )
     1634           .
     1635         end.
     1636         assign
     1637           o-where = substitute( "&1 &2", o-where, v-field-val )
     1638         .
     1639         if v-word-link = "":U then do:
     1640           assign
     1641             v-word-link = "and":U
     1642           .
     1643         end.
     1644       end.
     1645       delete object bh_tbl-name.
     1646       if     bh_tbl-key ne ?
     1647       then
     1648          delete object bh_tbl-key.
     1649       if p-key-handle = ?
     1650         and v-count-fld <> v-field-num
     1651       then do:
     1652         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
     1653       end.
     1654     end.
     1655   end procedure.
     1656   procedure gen-hn-keyr-tab :
     1657     define input  parameter i-tableSerach as character no-undo.
     1658     define input  parameter i-tablekey   as character no-undo.
     1659     define input  parameter p-key-rec    as character no-undo.
     1660     define input  parameter p-key-handle as handle    no-undo .
     1661     define input  parameter p-db-name    as character no-undo .
     1662     define input  parameter p-tt-handle  as handle    no-undo .
     1663     define input  parameter p-stts-lock  as integer   no-undo .
     1664     define output parameter o-hn         as handle    no-undo.
     1665     define variable v-full-tbl-name as character no-undo.
     1666     define variable v-where         as character no-undo.
     1667     define variable bh_tbl-name     as handle    no-undo.
     1668     define variable vTable          as character no-undo.
     1669     do
     1670     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1671     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1672     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1673         run gen-where-keyr-tab(i-tableSerach,
     1674                                i-tablekey,
     1675                                p-key-rec,
     1676                                p-key-handle,
     1677                                p-db-name,
     1678                                p-tt-handle,
     1679                                output v-where).
     1680         if i-tableSerach ne "" and i-tableSerach ne ?
     1681         then do:
     1682            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1683            create buffer bh_tbl-name for table v-full-tbl-name .
     1684         end.
     1685         else do:
     1686            if p-tt-handle = ? then do:
     1687               assign
     1688                  vTable = entry( 1 , p-key-rec, chr(3) )
     1689               .
     1690               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1691               create buffer bh_tbl-name for table v-full-tbl-name .
     1692            end.
     1693            else do:
     1694               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1695            end.
     1696         end.
     1697         if p-tt-handle = ? then do:
     1698            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1699         end.
     1700         else do:
     1701            bh_tbl-name:find-first( v-where ) no-error .
     1702         end.
     1703         o-hn = bh_tbl-name.
     1704      end.
     1705   end procedure.
     1706   procedure gen-hn-keyr :
     1707     define input  parameter p-key-rec    as character no-undo.
     1708     define input  parameter p-key-handle as handle    no-undo .
     1709     define input  parameter p-db-name    as character no-undo .
     1710     define input  parameter p-tt-handle  as handle    no-undo .
     1711     define input  parameter p-stts-lock  as integer   no-undo .
     1712     define output parameter o-hn         as handle    no-undo.
     1713     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1714   end.
     1715   procedure gen-row-keyr :
     1716     define input  parameter p-key-rec    as character no-undo.
     1717     define input  parameter p-key-handle as handle    no-undo .
     1718     define input  parameter p-db-name    as character no-undo .
     1719     define input  parameter p-tt-handle  as handle    no-undo .
     1720     define input  parameter p-stts-lock  as integer   no-undo .
     1721     define output parameter p-tbl-row    as rowid     no-undo.
     1722     define output parameter p-tbl-name   as character no-undo.
     1723     define variable vHn as handle no-undo.
     1724       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1725       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1726       p-tbl-name =  vHn:table.
     1727       delete object vHn no-error.
     1728     if p-tbl-row = ? then do:
     1729       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
     1730     end.
     1731     else do:
     1732       return.
     1733     end.
     1734   end procedure.
     1735   procedure gen-key-fv :
     1736     define input  parameter p-key-rec    as character no-undo .
     1737     define output parameter p-field-list as character no-undo .
     1738     define output parameter p-value-list as character no-undo.
     1739     do
     1740     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1741     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1742     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1743     :
     1744       define variable v-full-tbl-name  as character no-undo .
     1745       define variable bh_tbl-name      as handle    no-undo .
     1746       define variable v-tbl-name       as character no-undo .
     1747       define variable v-field-num      as integer   no-undo .
     1748       define variable v-count-fld      as integer   no-undo .
     1749       define variable v-inform         as character no-undo .
     1750       define variable v-ind            as integer   no-undo .
     1751       define variable v-idx-field-qnty as integer   no-undo .
     1752       define variable v-delim-key      as character no-undo .
     1753       if p-key-rec = ?
     1754         or p-key-rec = "":U
     1755       then do:
     1756         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     1757       end.
     1758       assign
     1759         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1760         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1761       .
     1762       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1763       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
     1764       assign
     1765         v-inform = bh_tbl-name:index-information(1)
     1766         v-ind    = 2
     1767       .
     1768       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1769       on error undo, return error
     1770       :
     1771         assign
     1772           v-inform = bh_tbl-name:index-information( v-ind )
     1773           v-ind    = v-ind + 1
     1774         .
     1775       end.
     1776       if v-inform = ?
     1777         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1778         or entry( 3, v-inform, ",":U ) <> "1":U
     1779       then do:
     1780         delete object bh_tbl-name no-error.
     1781         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     1782       end.
     1783       assign
     1784         v-idx-field-qnty = num-entries( v-inform ) - 4
     1785       .
     1786       if v-idx-field-qnty < 2 then do:
     1787         delete object bh_tbl-name no-error.
     1788         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     1789       end.
     1790       assign
     1791         p-field-list = "":U
     1792         p-value-list = "":U
     1793         v-delim-key  = "":U
     1794         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1795         v-count-fld  = 0
     1796       .
     1797       block_where:
     1798       do v-ind = 1 to v-idx-field-qnty by 2
     1799       on error undo, return error
     1800       :
     1801         assign
     1802           v-count-fld = v-count-fld + 1
     1803         .
     1804         if v-count-fld > v-field-num then do:
     1805           leave block_where.
     1806         end.
     1807         assign
     1808           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1809           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1810         .
     1811         if v-ind = 1 then do:
     1812           assign
     1813             v-delim-key = chr(3)
     1814           .
     1815         end.
     1816       end.
     1817       delete object bh_tbl-name.
     1818       if v-count-fld <> v-field-num then do:
     1819         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
     1820       end.
     1821     end.
     1822   end procedure.
     1823   procedure gen-key-field :
     1824     define input  parameter p-table      as character no-undo .
     1825     define output parameter p-field-list as character no-undo .
     1826     do
     1827     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1828     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1829     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1830     :
     1831       define variable v-full-tbl-name  as character no-undo .
     1832       define variable bh_tbl-name      as handle    no-undo .
     1833       define variable v-tbl-name       as character no-undo .
     1834       define variable v-field-num      as integer   no-undo .
     1835       define variable v-count-fld      as integer   no-undo .
     1836       define variable v-inform         as character no-undo .
     1837       define variable v-ind            as integer   no-undo .
     1838       define variable v-idx-field-qnty as integer   no-undo .
     1839       define variable v-delim-key      as character no-undo .
     1840       if p-table = ?
     1841         or p-table = "":U
     1842       then do:
     1843         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
     1844       end.
     1845       assign
     1846         v-tbl-name      = p-table
     1847         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1848       .
     1849       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1850       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
     1851       assign
     1852         v-inform = bh_tbl-name:index-information(1)
     1853         v-ind    = 2
     1854       .
     1855       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1856       on error undo, return error
     1857       :
     1858         assign
     1859           v-inform = bh_tbl-name:index-information( v-ind )
     1860           v-ind    = v-ind + 1
     1861         .
     1862       end.
     1863       if v-inform = ?
     1864         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1865         or entry( 3, v-inform, ",":U ) <> "1":U
     1866       then do:
     1867         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     1868       end.
     1869       assign
     1870         v-idx-field-qnty = num-entries( v-inform ) - 4
     1871       .
     1872       if v-idx-field-qnty < 2 then do:
     1873         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     1874       end.
     1875       assign
     1876         p-field-list = "":U
     1877         v-delim-key  = "":U
     1878         v-count-fld  = 0
     1879       .
     1880       block_where:
     1881       do v-ind = 1 to v-idx-field-qnty by 2
     1882       on error undo, return error
     1883       :
     1884         assign
     1885           v-count-fld = v-count-fld + 1
     1886         .
     1887         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1888         if v-ind = 1 then do:
     1889           assign
     1890             v-delim-key = chr(3)
     1891           .
     1892         end.
     1893       end.
     1894       delete object bh_tbl-name.
     1895     end.
     1896   end procedure.
     1897   define variable v-date as date no-undo .
     1898   define variable v-time as integer no-undo .
     1899   define variable v-fact-order as decimal no-undo .
     1900   define variable v-shift-fact-order as decimal no-undo .
     1901   define variable v-fact-num as integer no-undo .
     1902   define variable v-shift-end-fact-order as decimal no-undo .
     1903   define variable v-day-end-fact-order as decimal no-undo .
     1904   define variable v-pre-status_ as character no-undo .
     1905   define variable v-curr-abbr like ub.currency.curr-abbr no-undo.
     1906   define variable v-status_ as character no-undo .
     1907   define variable v-ask-date as logical no-undo .
     1908   define variable v-ask-message as character no-undo .
     1909   define variable v-correct as logical no-undo .
     1910   define variable v-err-mess as character no-undo .
     1911   define variable v-ret-mess as character no-undo .
     1912   define variable v-datestr as character no-undo .
