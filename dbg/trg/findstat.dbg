      921   find first buf_fin-doc-attr no-lock where
      922             buf_fin-doc-attr.attr-code    = p-attr-code
      923         AND buf_fin-doc-attr.host-code     = p-host-code
      924         AND buf_fin-doc-attr.fin-doc-code = p-fin-doc-code      no-error .
      925     if available  buf_fin-doc-attr then do:
