     1933   main-block:
     1934   do
     1935   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1936   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1937   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1938   :
     1939     find first buf_fin-doc exclusive-lock where
     1940               buf_fin-doc.host-code = p-host-code
     1941            AND buf_fin-doc.fin-doc-code = p-fin-doc-code .
     1942     assign
     1943     v-prn-doc-code = buf_fin-doc.prn-doc-code
     1944     v-fin-doc-type = buf_fin-doc.fin-doc-type
     1945     .
     1946     run trg/findgraf.p (
     1947                     input  buf_fin-doc.host-code
     1948                     ,input  buf_fin-doc.fin-doc-code
     1949                     ,input  p-close-mode
     1950                     ,input  p-author
     1951                     ,input  buf_fin-doc.status_
     1952                     ,input  ?
     1953                     ,output v-status_
     1954                     ,output v-ask-date
     1955                     ,output v-ask-message
     1956                     ) no-error.
     1957     if error-status:error
     1958     or v-status_ <> p-status_
     1959     or (v-ask-date and p-status-date = ?)
     1960     then do:
     1961       run err-mess ("Ошибка при проверке возможности открытия/закрытия/отказа", output v-ret-mess).
     1962       undo main-block, return error v-ret-mess.
     1963     end.
     1964     assign
     1965     v-pre-status_ = buf_fin-doc.status_
     1966     .
     1967     if p-status-date = ? and v-ask-date then do:
     1968       run gbl/d-prompt.w (
     1969         'title=':u + "Дата смены статуса" + '\':u
     1970       + 'text1=':u + "Введите дату" + '\':u
     1971       + 'format=99/99/9999' + '\':u
     1972       + 'type=' + 'T':U + '\':u
     1973       + 'fillin_row=2\':u
     1974       + 'fillin_col=4\':u
     1975       + 'fillin_width=20\':u
     1976       + 'fillin_height=1\':u
     1977       + 'max-chars=70\':u
     1978       + 'readonly=no' + '\':u
     1979       , input-output v-datestr
     1980       ).
     1981       if return-value = 'false':u then undo main-block, return error v-ret-mess.
     1982       assign
     1983       v-date = date(integer(substr(v-datestr, 4, 2))
     1984                   ,integer(substr(v-datestr, 1, 2))
     1985                   ,integer(substr(v-datestr, 7, 4)))
     1986       no-error .
     1987       if error-status:error then do:
     1988         message
     1989         "Вы ввели неверную дату"
     1990         view-as alert-box error .
     1991         undo main-block, return error .
     1992       end.
     1993       assign
     1994       p-status-date = v-date
     1995       .
     1996     end.
     1997     else do:
     1998       if p-status-date = ? then do:
     1999         run cur-time in this-procedure(output v-date, output v-time).
     2000       end.
     2001       if p-status-date <> ? then do:
     2002         assign
     2003         v-date = p-status-date
     2004         .
     2005       end.
     2006     end.
     2007     CASE buf_fin-doc.fin-doc-type:
     2008       when 'пко':U then do:
     2009         run check-income-cash in this-procedure no-error .
     2010         if error-status:error then do:
     2011           run err-mess (input return-value , output v-ret-mess).
     2012           undo main-block, return error  v-ret-mess.
     2013         end.
     2014       end.
     2015       when 'рко':U then do:
     2016         run check-expense-cash in this-procedure no-error .
     2017         if error-status:error then do:
     2018           run err-mess (input return-value , output v-ret-mess).
     2019           undo main-block, return error  v-ret-mess.
     2020         end.
     2021       end.
     2022       when 'ппп':U then do:
     2023         run check-income-cashless in this-procedure no-error .
     2024         if error-status:error then do:
     2025           run err-mess (input return-value , output v-ret-mess).
     2026           undo main-block, return error  v-ret-mess.
     2027         end.
     2028       end.
     2029       when 'рпп':U then do:
