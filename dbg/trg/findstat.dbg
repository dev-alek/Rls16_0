     1914   define variable v-fin-doc-type like ub.fin-doc.fin-doc-type no-undo .
     1915   define variable v-line-rec as recid no-undo .
     1916   define variable v-update-counter-flag as logical no-undo .
     1917   define variable v-update-counter as integer no-undo .
     1918   define variable mValue as character no-undo .
