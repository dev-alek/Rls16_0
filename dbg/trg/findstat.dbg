     2602   PROCEDURE err-mess:
     2603     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
     2604     define output parameter p-ret-mess as character no-undo .
     2605     CASE p-silent:
     2606       when yes then do:
     2607         if available buf_fin-doc then
     2608         assign
     2609         p-ret-mess =  substitute("ПЛАТЕЖ &1: фирма: &2 N: &3,&5вн.код платежа &4 Статус &5&6&7"
     2610                                   , buf_fin-doc.prn-doc-code
     2611                                   , buf_fin-doc.host-code
     2612                                   , buf_fin-doc.fin-doc-type
     2613                                   , buf_fin-doc.fin-doc-code
     2614                                   , buf_fin-doc.status_
     2615                                   , chr(10)
     2616                                   , p-mess
     2617                                   ).
     2618         else
     2619         assign
     2620         p-ret-mess =  substitute("ПЛАТЕЖ &1: фирма: &2 N: &3,&5вн.код платежа &4&5&6"
     2621                                   , v-prn-doc-code
     2622                                   , p-host-code
     2623                                   , v-fin-doc-type
     2624                                   , p-fin-doc-code
     2625                                   , chr(10)
     2626                                   , p-mess
     2627                                   ).
     2628       end.
     2629       when no then do:
     2630         message
     2631         p-mess
     2632         view-as alert-box error .
     2633       end.
     2634     end.
     2635   END PROCEDURE.
     2636   procedure auto-fill-prn-doc-code :
     2637   define output parameter p-update-counter-flag as logical no-undo .
     2638   define output parameter p-update-counter as integer no-undo .
     2639   define variable glog as logical no-undo .
     2640   define variable choice as integer no-undo .
     2641   define variable v-sl as integer no-undo .
     2642   define variable v-pl as integer no-undo .
     2643   define variable v-loc-update-counter-flag as logical no-undo .
     2644   define variable v-my-counter as integer no-undo .
     2645   define variable v-obj-db-num as integer   no-undo .
     2646   define variable mCashBook as class ibs.th.ref.cashbookstorage no-undo .
     2647   if buf_fin-doc.trn-doc-code <> ''
     2648   and not (buf_fin-doc.obj-type = ''
     2649             and
     2650             buf_fin-doc.obj-code = 0)
     2651   then do:
     2652   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2653   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2654     (input  buf_fin-doc.obj-type
     2655     ,input  buf_fin-doc.obj-code
     2656     ,output v-obj-db-num
     2657     )  .
     2658     if    v-obj-db-num <> g#db-num
     2659        or (buf_fin-doc.prn-doc-code <> "" and buf_fin-doc.prn-doc-code <> ? and buf_fin-doc.prn-doc-code <> "тех_")
     2660     then do:
     2661       return.
     2662     end .
     2663     mCashBook = new ibs.th.ref.cashbookstorage () .
     2664     mask-pko = mCashBook:getSinglRule(buf_fin-doc.CashBookId, buf_fin-doc.obj-type, buf_fin-doc.obj-code, "PkoMask") .
     2665     mask-rko = mCashBook:getSinglRule(buf_fin-doc.CashBookId, buf_fin-doc.obj-type, buf_fin-doc.obj-code, "RkoMask") .
     2666     if mask-pko > ""
     2667     then.
     2668     else mask-pko = "[NNNN]/[obj-code]" .
     2669     if mask-rko > ""
     2670     then.
     2671     else mask-rko = "[NNNN]/[obj-code]" .
     2672     MParam = if mCashBook:getSinglRule(buf_fin-doc.cashbookId, buf_fin-doc.obj-type,buf_fin-doc.obj-code, "uchet") eq "1"
     2673              then "year," + string(year(buf_fin-doc.shift-date))
     2674              else "".
     2675     delete object mCashBook no-error .
     2676     subscribe   to "getCounter" anywhere run-procedure "Mycounter".
     2677     case buf_fin-doc.fin-ext-doc-type:
     2678       when 'пко':U then do:
     2679         find first ub.CashBookRule exclusive-lock where ub.CashBookRule.CashBookID = buf_fin-doc.CashBookId
     2680                                              and ub.CashBookRule.Obj-type = buf_fin-doc.obj-type
     2681                                              and ub.CashBookRule.Obj-code = buf_fin-doc.obj-code
     2682                                              and ub.CashBookRule.Code = "currPko"
     2683                                              no-error .
     2684         if not available ub.CashBookRule
     2685         then do :
     2686           create ub.CashBookRule .
     2687           assign
     2688             ub.CashBookRule.CashBookID = buf_fin-doc.CashBookId
     2689             ub.CashBookRule.Obj-type = buf_fin-doc.obj-type
     2690             ub.CashBookRule.Obj-code = buf_fin-doc.obj-code
     2691             ub.CashBookRule.Code = "currPko"
     2692             ub.CashBookRule.Status_ = 0
     2693             ub.CashBookRule.RuleValue = "1"
     2694           .
     2695         end.
     2696         run gen-key-rec in this-procedure ( input 'CashBookRule':U
     2697                                            ,input (buffer CashBookRule:handle)
     2698                                            ,output v-key).
     2699         assign
     2700           current-pko-rko = "currPKO"
     2701           current-ruleID = v-key
     2702         .
     2703         run utl/maskproc.p(parparentproc, mask-pko, "cashbook", buf_fin-doc.CashBookId, output mValue).
     2704       end.
     2705       when 'рко':U then do:
     2706         find first ub.CashBookRule exclusive-lock where ub.CashBookRule.CashBookID = buf_fin-doc.CashBookId
     2707                                              and ub.CashBookRule.Obj-type = buf_fin-doc.obj-type
     2708                                              and ub.CashBookRule.Obj-code = buf_fin-doc.obj-code
     2709                                              and ub.CashBookRule.Code = "currRko"
     2710                                              no-error .
     2711         if not available ub.CashBookRule
     2712         then do :
     2713           create ub.CashBookRule .
     2714           assign
     2715             ub.CashBookRule.CashBookID = buf_fin-doc.CashBookId
     2716             ub.CashBookRule.Obj-type = buf_fin-doc.obj-type
     2717             ub.CashBookRule.Obj-code = buf_fin-doc.obj-code
     2718             ub.CashBookRule.Code = "currRko"
     2719             ub.CashBookRule.Status_ = 0
     2720             ub.CashBookRule.RuleValue = "1"
     2721           .
     2722         end.
     2723         run gen-key-rec in this-procedure ( input 'CashBookRule':U
     2724                                            ,input (buffer CashBookRule:handle)
     2725                                            ,output v-key).
     2726         assign
     2727           current-pko-rko = "currRKO"
     2728           current-ruleID = v-key
     2729         .
     2730         run utl/maskproc.p(parparentproc, mask-rko, "cashbook", buf_fin-doc.CashBookId, output mValue).
     2731       end.
     2732     end case.
     2733     unsubscribe to "getCounter".
     2734     v-prn-doc-code = v-prn-doc-code + mValue.
     2735     if buf_fin-doc.doc-author = 'auto':U then do:
     2736       assign
     2737       buf_fin-doc.prn-doc-code = v-prn-doc-code.
     2738       p-update-counter-flag = yes.
     2739     end.
     2740   end.
     2741   end procedure.
     2742   procedure release-auto-fill-prn-doc-code :
     2743   define input parameter p-update as logical no-undo .
     2744   define input parameter p-counter as integer no-undo .
     2745   end procedure.
     2746   procedure fill-shift :
     2747   define parameter buffer buf_fin-doc for ub.fin-doc.
     2748   define variable v-obj-db-num as integer no-undo .
     2749   define variable l-shift-on as logical no-undo .
     2750   main-block:
     2751   do
     2752   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2753   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2754   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2755   :
     2756   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2757   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2758     (input  buf_fin-doc.obj-type
     2759     ,input  buf_fin-doc.obj-code
     2760     ,output v-obj-db-num
     2761     )  .
     2762     if v-obj-db-num = g#db-num then do:
     2763   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2764   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2765     (input  buf_fin-doc.obj-type
     2766     ,input  buf_fin-doc.obj-code
     2767     ,input  'shift-on=request'
     2768     ,output l-shift-on
     2769     )  .
     2770       if l-shift-on
     2771       and buf_fin-doc.shift-flag = integer('1':U)
     2772       then do:
     2773         if buf_fin-doc.shift-date = ?
     2774         or buf_fin-doc.shift-num = 0
     2775         or buf_fin-doc.shift-name = ''
     2776         then do:
     2777   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2779     (input  buf_fin-doc.obj-type
     2780     ,input  buf_fin-doc.obj-code
     2781     ,output varobj-shift-date
     2782     ,output varobj-shift-num
     2783     ,output varobj-shift-name
     2784     )  .
     2785           run gbl/chk-date.p
     2786           ( input buf_fin-doc.obj-type
     2787           , input buf_fin-doc.obj-code
     2788           , input buf_fin-doc.fact-date
     2789           , input v-time
     2790           , input varobj-shift-date
     2791           , input varobj-shift-num
     2792           , input no) no-error.
     2793           if error-status:error then do:
     2794             undo main-block, return error substitute( "Ошибка при проверке сменной даты&1&2&1&3"
     2795                                               ,chr(10), error-status :get-message (1), return-value  )   .
     2796           end.
     2797           assign
     2798           buf_fin-doc.shift-date = varobj-shift-date
     2799           buf_fin-doc.shift-num = varobj-shift-num
     2800           buf_fin-doc.shift-name = varobj-shift-name
     2801           .
     2802         end.
     2803       end.
     2804       else do:
     2805         l-shift-on = no.
     2806       end.
     2807     end.
     2808   end.
     2809   end procedure.
     2810   procedure get-fact-num :
     2811   define input parameter p-host-code as integer no-undo .
     2812   define output parameter p-fact-num as integer no-undo .
     2813   define buffer buf_sysconf for ub.sysconf.
     2814   find first buf_sysconf no-lock where
     2815             buf_sysconf.host-code = p-host-code.
     2816   do while true:
     2817     p-fact-num =  next-value(s-fin-doc-fact , ub).
     2818     if g#db-num = buf_sysconf.firm-db-num
     2819     and p-fact-num modulo 10 > 0 then do:
     2820       leave.
     2821     end.
     2822     if g#db-num <> buf_sysconf.firm-db-num
     2823     and p-fact-num modulo 10 = 0 then do:
     2824       leave.
     2825     end.
     2826   end.
     2827   end procedure.
     2828   procedure Mycounter:
     2829   define input  parameter iFileName as character no-undo.
     2830   define input  parameter ikey      as character no-undo.
     2831   define input  parameter icode     as character no-undo.
     2832   define output parameter oCount    as int64 no-undo.
     2833   run utl/getnextcount.p ("cashbookrule", current-ruleID, current-pko-rko, mparam  ,output oCount    ).
     2834   end procedure.
