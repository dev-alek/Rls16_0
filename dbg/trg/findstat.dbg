     1920   define variable mask-pko as character no-undo .
     1921   define variable mask-rko as character no-undo .
     1922   define variable current-pko-rko as character no-undo .
     1923   define variable current-ruleID as character no-undo .
     1924   define variable v-current-num as integer no-undo .
     1925   define variable v-prev-prn-doc-code as character no-undo .
     1926   define variable v-matches as character no-undo .
     1927   define variable v-key     as character no-undo.
     1928   define buffer buf_fin-doc for ub.fin-doc.
     1929   define buffer buf_fin-statement-line for ub.fin-statement-line.
     1930   define buffer locked_fin-statement-line for ub.fin-statement-line.
     1931   define buffer buf_payment for ub.payment.
