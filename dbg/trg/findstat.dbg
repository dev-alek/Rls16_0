     1034             buf_c-fin-doc-attr.attr-code    = p-attr-code
     1035         AND buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
     1036         AND buf_c-fin-doc-attr.host-code      = p-host-code
     1037         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
     1038         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
     1039     if available  buf_c-fin-doc-attr then do:
