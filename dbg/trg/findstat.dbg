     2083   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     2084     (input  buf_fin-doc.contract-curr
     2085     ,input  v-date
     2086     ,output buf_fin-doc.actual-contract-rate
     2087     ,output buf_fin-doc.actual-contract-scale
     2088     ,output v-curr-abbr
     2089     ) no-error .
     2090     if error-status:error then do:
     2091       if return-value <> "":U then do:
     2092         if not p-silent then
     2093         message
     2094         return-value view-as alert-box .
     2095         undo main-block, return error  return-value .
     2096       end.
     2097     end.
     2098     if error-status:error then do:
     2099       if return-value <> "":U then do:
     2100         if not p-silent then
     2101         message
     2102         return-value view-as alert-box .
     2103         undo main-block, return error  return-value .
     2104       end.
     2105     end.
     2106     CASE p-status_:
     2107       when 'новый':U then do:
     2108         assign
     2109         buf_fin-doc.status_ = p-status_
     2110         buf_fin-doc.user-db-num-perm = ?
     2111         buf_fin-doc.user-name-perm = "":U
     2112         buf_fin-doc.perm-date = ?
     2113         buf_fin-doc.user-db-num-pl = ?
     2114         buf_fin-doc.user-name-pl = "":U
     2115         buf_fin-doc.pay-date = ?
     2116         buf_fin-doc.user-db-num-fact = ?
     2117         buf_fin-doc.user-name-fact = "":U
     2118         buf_fin-doc.fact-date = ?
     2119         buf_fin-doc.fact-order = 0
     2120         .
     2121       end.
     2122       when 'разрешен':U then do:
     2123         assign
     2124         buf_fin-doc.status_ = p-status_
     2125         buf_fin-doc.user-db-num-perm = g#db-num
     2126         buf_fin-doc.user-name-perm = g#userid
     2127         buf_fin-doc.perm-date = (if p-close-mode = '<открытие документа>':U then buf_fin-doc.perm-date else v-date)
     2128         buf_fin-doc.user-db-num-pl = ?
     2129         buf_fin-doc.user-name-pl = "":U
     2130         buf_fin-doc.pay-date = ?
     2131         buf_fin-doc.user-name-fact = "":U
     2132         buf_fin-doc.user-db-num-fact = ?
     2133         buf_fin-doc.fact-date = ?
     2134         buf_fin-doc.fact-order = 0
     2135         .
     2136         if not (buf_fin-doc.obj-type = ''
     2137         and buf_fin-doc.obj-code = 0)
     2138         and p-close-mode = '<открытие документа>':U
     2139         and lookup(buf_fin-doc.fin-ext-doc-type, 'пко,рко':U) > 0
     2140         then do:
     2141           run fill-shift in this-procedure ( buffer buf_fin-doc
     2142                                           ) no-error.
     2143           if error-status :error then do:
     2144             run err-mess in this-procedure ( substitute( "Ошибка при заполнении даты и номера смены&1&2&1&3"
     2145                                                       ,chr(10), error-status :get-message (1), return-value  )
     2146                                                       ,output v-ret-mess).
     2147             undo main-block, return error v-ret-mess.
     2148           end.
     2149         end.
     2150       end.
     2151       when 'банк':U then do:
     2152         assign
     2153         buf_fin-doc.status_ = p-status_
     2154         buf_fin-doc.user-db-num-pl = g#db-num
     2155         buf_fin-doc.user-name-pl = g#userid
     2156         buf_fin-doc.pay-date = (if p-close-mode = '<открытие документа>':U then buf_fin-doc.pay-date else v-date)
     2157         buf_fin-doc.user-name-fact = "":U
     2158         buf_fin-doc.user-db-num-fact = ?
     2159         buf_fin-doc.fact-date = ?
     2160         buf_fin-doc.fact-order = 0
     2161         buf_fin-doc.fact-author = '':U
     2162         .
     2163         if p-close-mode = '<открытие документа>':U then do:
     2164           for each buf_fin-statement-line no-lock where
     2165                 buf_fin-statement-line.host-code = buf_fin-doc.host-code
     2166             and buf_fin-statement-line.fin-doc-code = buf_fin-doc.fin-doc-code
     2167           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2168           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2169           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2170           :
     2171             find first locked_fin-statement-line exclusive-lock where
     2172                       recid(locked_fin-statement-line) = recid(buf_fin-statement-line).
     2173             v-line-rec = RECID(buf_fin-statement-line).
     2174             run ref/finsttml.p (
     2175                           INPUT NO
     2176                           ,INPUT-OUTPUT v-line-rec
     2177                           ,INPUT 'удаление':U
     2178                           ,INPUT buf_fin-statement-line.host-code
     2179                           ,INPUT buf_fin-statement-line.sttm-code
     2180                           ,INPUT buf_fin-statement-line.fin-doc-code
     2181                           ,INPUT buf_fin-statement-line.pay-date
     2182                           ,INPUT buf_fin-statement-line.prn-doc-code
     2183                           ,INPUT buf_fin-statement-line.fin-ext-doc-type
     2184                           ,input buf_fin-statement-line.rp-bik
     2185                           ,input buf_fin-statement-line.rp-bank-name
     2186                           ,input buf_fin-statement-line.rp-bank-city
     2187                           ,input buf_fin-statement-line.rp-c-schet
     2188                           ,input buf_fin-statement-line.rp-r-schet
     2189                           ,input buf_fin-statement-line.rp-name
     2190                           ,input buf_fin-statement-line.rp-inn
     2191                           ,input buf_fin-statement-line.rp-kpp
     2192                           ,INPUT buf_fin-statement-line.sum-doc
     2193                           ,input p-author
     2194                           ,INPUT buf_fin-statement-line.ps
     2195                             )
     2196                 no-error.
     2197             if error-status:error then do:
     2198               run err-mess in this-procedure ( substitute( "Ошибка при удалении строки банковской выписки &1&2&3"
     2199                                                         ,return-value, chr(10), error-status :get-message (1) )
     2200                                                         ,output v-ret-mess).
     2201               undo main-block, return error v-ret-mess.
     2202             end.
     2203           end.
     2204         end.
     2205       end.
     2206       when 'отказ':U then do:
     2207         run get-fact-num in this-procedure ( input buf_fin-doc.host-code
     2208                                             ,output v-fact-num).
     2209         run factord in this-procedure (
     2210                                          input  v-date
     2211                                         ,input  v-time
     2212                                         ,input  v-fact-num
     2213                                         ,input  ?
     2214                                         ,input  0
     2215                                         ,input  no
     2216                                         ,output v-fact-order
     2217                                         ,output v-shift-end-fact-order
     2218                                         ,output v-day-end-fact-order
     2219                                         ).
     2220         if buf_fin-doc.shift-date <> ? then do:
     2221           run factord in this-procedure (
     2222                                           input  v-date
     2223                                           ,input  v-time
     2224                                           ,input  v-fact-num
     2225                                           ,input  buf_fin-doc.shift-date
     2226                                           ,input  buf_fin-doc.shift-num
     2227                                           ,input  yes
     2228                                           ,output v-shift-fact-order
     2229                                           ,output v-shift-end-fact-order
     2230                                           ,output v-day-end-fact-order
     2231                                           ).
     2232         end.
     2233         assign
     2234         buf_fin-doc.status_ = p-status_
     2235         buf_fin-doc.user-db-num-fact = g#db-num
     2236         buf_fin-doc.user-name-fact = g#userid
     2237         buf_fin-doc.fact-date = v-date
     2238         buf_fin-doc.fact-order = v-fact-order
     2239         buf_fin-doc.fact-order = v-shift-fact-order
     2240         buf_fin-doc.fact-num = v-fact-num
     2241         .
     2242       end.
     2243       when 'факт':U then do:
     2244         run get-fact-num in this-procedure ( input buf_fin-doc.host-code
     2245                                             ,output v-fact-num).
     2246         run factord in this-procedure (
     2247                                          input  v-date
     2248                                         ,input  v-time
     2249                                         ,input  v-fact-num
     2250                                         ,input  ?
     2251                                         ,input  0
     2252                                         ,input  no
     2253                                         ,output v-fact-order
     2254                                         ,output v-shift-end-fact-order
     2255                                         ,output v-day-end-fact-order
     2256                                         ).
     2257         if buf_fin-doc.shift-date <> ? then do:
     2258           run factord in this-procedure (
     2259                                           input  v-date
     2260                                           ,input  v-time
     2261                                           ,input  v-fact-num
     2262                                           ,input  buf_fin-doc.shift-date
     2263                                           ,input  buf_fin-doc.shift-num
     2264                                           ,input  yes
     2265                                           ,output v-shift-fact-order
     2266                                           ,output v-shift-end-fact-order
     2267                                           ,output v-day-end-fact-order
     2268                                           ).
     2269         end.
     2270         define variable varobj-shift-date as date no-undo .
     2271         define variable varobj-shift-num as integer no-undo .
     2272         define variable varobj-shift-name as character no-undo .
     2273         if not (buf_fin-doc.obj-type = ''
     2274         and buf_fin-doc.obj-code = 0)
     2275         and p-close-mode = '<открытие документа>':U
     2276         and lookup(buf_fin-doc.fin-ext-doc-type, 'пко,рко':U) > 0
     2277         then do:
     2278           run fill-shift in this-procedure ( buffer buf_fin-doc
     2279                                           ) no-error.
     2280           if error-status :error then do:
     2281             run err-mess in this-procedure ( substitute( "Ошибка при заполнении даты и номера смены&1&2&1&3"
     2282                                                       ,chr(10), error-status :get-message (1), return-value  )
     2283                                                       ,output v-ret-mess).
     2284             undo main-block, return error v-ret-mess.
     2285           end.
     2286         end.
     2287         assign
     2288         buf_fin-doc.status_ = p-status_
     2289         buf_fin-doc.user-db-num-fact = g#db-num
     2290         buf_fin-doc.user-name-fact = g#userid
     2291         buf_fin-doc.fact-date = v-date
     2292         buf_fin-doc.fact-order = v-fact-order
     2293         buf_fin-doc.shift-fact-order = v-shift-fact-order
     2294         buf_fin-doc.fact-author = p-author
     2295         buf_fin-doc.fact-num = v-fact-num
     2296         .
     2297         define variable v-today as date no-undo .
     2298         run cur-time in this-procedure ( output v-today, output v-time).
     2299         if buf_fin-doc.fact-date < v-today then do:
     2300           assign
