      270   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   procedure cur-time :
      272      define output parameter p-today as date      no-undo .
      273      define output parameter p-time  as integer   no-undo .
      274     do
      275     on error undo, return error
      276     :
      277       define variable v-date1 as date      no-undo .
      278       define variable v-date2 as date      no-undo .
      279       define variable v-time  as integer   no-undo .
      280       assign
      281         v-date1 = today
      282         v-time  = time
      283         v-date2 = today
      284       .
      285       if v-date1 <> v-date2
      286       then do:
      287         assign
      288           v-date1 = today
      289           v-time  = v-time
      290         .
      291       end.
      292       assign
      293         p-today = v-date1
      294         p-time  = v-time
      295       .
      296     end.
      297   end.
      298   function cur-time-date returns character
      299   :
      300     return string(today, '99/99/9999':U) .
      301   end.
      302   function cur-time-mjd returns decimal
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return integer(v-date) - 2400002 + (v-time / 86400) .
      311   end.
      312   function cur-time-get-ending-index returns integer
      313   (input p-number as integer
      314   )
      315   :
      316     if p-number < 0
      317     or p-number = ?
      318     then do:
      319       return 1 .
      320     end.
      321     define variable v-rest as integer   no-undo .
      322     assign
      323       p-number = p-number modulo 100
      324     .
      325     if p-number < 20
      326     then do:
      327       assign
      328         v-rest = p-number
      329       .
      330     end.
      331     else do:
      332       assign
      333         v-rest = p-number modulo 10
      334       .
      335     end.
      336     case v-rest :
      337       when 1
      338       then do:
      339         return 2 .
      340       end.
      341       when 2 or
      342       when 3 or
      343       when 4
      344       then do:
      345         return 3 .
      346       end.
      347       otherwise do:
      348         return 1 .
      349       end.
      350     end case .
      351   end.
      352   procedure cur-time-mjd-to-date :
      353      define input  parameter i-mjd-diff as decimal no-undo.
      354      define output parameter o-Date     as date    no-undo.
      355      define output parameter o-Time     as integer no-undo.
      356      define variable v-day-number as integer   no-undo .
      357      if    i-mjd-diff < 0
      358         or i-mjd-diff = ?
      359      then do:
      360         return "?" .
      361      end.
      362      assign
      363         v-day-number = truncate(i-mjd-diff,0).
      364         o-Date = date(v-day-number + 2400002).
      365         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      366     .
      367   end.
      368   function cur-time-mjd-to-string returns character
      369   (input p-mjd-diff as decimal
      370   )
      371   :
      372     define variable v-day-number as integer   no-undo .
      373     define variable v-seconds    as integer   no-undo .
      374     define variable v-hour       as integer   no-undo .
      375     define variable v-min        as integer   no-undo .
      376     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      377     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      378     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      379     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      380     if p-mjd-diff < 0
      381     or p-mjd-diff = ?
      382     then do:
      383       return "?" .
      384     end.
      385     assign
      386       v-day-number = integer(truncate(p-mjd-diff,0))
      387       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      388     .
      389     if v-seconds > 86400
      390     then do:
      391       assign
      392         v-seconds = 86400 - 1
      393       .
      394     end.
      395     if v-seconds < 0
      396     then do:
      397       assign
      398         v-seconds = 0
      399       .
      400     end.
      401     assign
      402       v-hour = truncate(v-seconds / 3600, 0)
      403     .
      404     assign
      405       v-seconds = v-seconds modulo 3600
      406     .
      407     assign
      408       v-min = truncate(v-seconds / 60, 0)
      409     .
      410     assign
      411       v-seconds = v-seconds modulo 60
      412     .
      413     return
      414         (if v-day-number <> 0
      415           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      416           else ""
      417         )
      418       + (if v-day-number <> 0 or v-hour <> 0
      419           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      420           else ""
      421         )
      422       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      423           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      424           else ""
      425         )
      426       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      427       .
      428   end.
      429   function cur-time-string returns character
      430   :
      431     define variable v-date as date      no-undo .
      432     define variable v-time as integer   no-undo .
      433     run cur-time in this-procedure
      434       (output v-date
      435       ,output v-time
      436       ) .
      437     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      438   end.
      439   function cur-time-string-sec returns character
      440   :
      441     define variable v-date as date      no-undo .
      442     define variable v-time as integer   no-undo .
      443     run cur-time in this-procedure
      444       (output v-date
      445       ,output v-time
      446       ) .
      447     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      448   end.
      449   function cur-time-custom  returns character
      450   (input p-prefix as character
      451   ,input p-date-format as character
      452   ,input p-delimiter as character
      453   ,input p-time-format as character
      454   ,input p-suffix as character
      455   )
      456   :
      457     define variable v-date as date      no-undo .
      458     define variable v-time as integer   no-undo .
      459     run cur-time in this-procedure
      460       (output v-date
      461       ,output v-time
      462       ) .
      463     return
      464       p-prefix
      465       + string(v-date, p-date-format)
      466       + p-delimiter
      467       + string(v-time, p-time-format)
      468       + p-suffix
      469       .
      470   end.
      471   function cur-time-print  returns character
      472   :
      473     define variable v-date as date      no-undo .
      474     define variable v-time as integer   no-undo .
      475     run cur-time in this-procedure
      476       (output v-date
      477       ,output v-time
      478       ) .
      479     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      480   end.
      481   function cur-time-datetime returns datetime
      482   :
      483     define variable v-char as character no-undo .
      484     define variable v-datetime as datetime no-undo .
      485     v-char = cur-time-string().
      486     v-datetime = datetime(v-char).
      487     return  v-datetime.
      488   end.
      489   function cur-time-string-msec returns character
      490   :
      491     define variable v-date as datetime  no-undo .
      492     v-date = now.
      493     return string(v-date) .
      494   end.
      495   define buffer buf_bar-code for ub.bar-code.
      496   define buffer buf_prod-bc-db for ub.prod-bc-db.
      497   main-block:
      498   do
      499   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      500   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      501   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      502   :
      503     find buf_bar-code where buf_bar-code.b-code = ub.prod-bc.b-code no-lock no-error .
      504     if available buf_bar-code then do:
      505       run prod-bch_write-prod-bc-trigger in this-procedure  (
      506                                            input no
      507                                           ,input integer('99':U)
      508                                           ,input buf_bar-code.gds-code
      509                                           ,input (if g#news
      510                                                   then 'db':U
      511                                                   else (if g#esys
      512                                                         then 'esys':U
      513                                                         else "":U)
      514                                                   )
      515                                           ,input (if g#news
      516                                                   then string(g#news-source-db)
      517                                                   else (if g#esys
      518                                                         then string(g#esys-source-esys)
      519                                                         else  "":U)
      520                                                   )
      521                                         ) .
      522     end.
      523     define variable l-prod-bc-global as logical no-undo .
      524   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      525   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      526     (buffer ub.prod-bc
      527     ,input  'global=request':u
      528     ,output l-prod-bc-global
      529     ) no-error .
      530     if error-status :error then do:
      531       message
      532         vss-workfile vss-revision vss-description skip
      533         "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
      534         "Основной бар-код" ub.prod-bc.b-code skip
      535         "Дополнительный бар-код" ub.prod-bc.b-str skip
      536         "Действие global=request" skip
      537         error-status :get-message(1) skip
      538         return-value skip
      539         view-as alert-box error .
      540       undo main-block, return error .
      541     end.
      542     if not g#news
      543     and not l-prod-bc-global then do:
      544     define variable l-prod-bc-weight as logical no-undo .
      545     define variable l-prod-bc-scaleable as logical no-undo .
      546     define variable l-prod-bc-pgweight as logical no-undo .
      547   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      549     (buffer ub.prod-bc
      550     ,input  'weight=request':u
      551     ,output l-prod-bc-weight
      552     ) no-error .
      553       if error-status :error then do:
      554         message
      555           vss-workfile vss-revision vss-description skip
      556           "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
      557           "Основной бар-код" ub.prod-bc.b-code skip
      558           "Дополнительный бар-код" ub.prod-bc.b-str skip
      559           "Действие weight=request" skip
      560           error-status :get-message(1) skip
      561           return-value skip
      562           view-as alert-box error .
      563         undo main-block, return error .
      564       end.
      565       if not l-prod-bc-weight then do:
      566   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      568     (buffer ub.prod-bc
      569     ,input  'scaleable=request':u
      570     ,output l-prod-bc-scaleable
      571     ) no-error .
      572         if error-status :error then do:
      573           message
      574             vss-workfile vss-revision vss-description skip
      575             "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
      576             "Основной бар-код" ub.prod-bc.b-code skip
      577             "Дополнительный бар-код" ub.prod-bc.b-str skip
      578             "Действие scaleable=request" skip
      579             error-status :get-message(1) skip
      580             return-value skip
      581             view-as alert-box error .
      582           undo main-block, return error .
      583         end.
      584       end.
      585       if not g#news
      586       and (l-prod-bc-weight or l-prod-bc-scaleable or ub.prod-bc.bc-on-type = 'pglc':U)
      587       then do:
      588           find first buf_prod-bc-db where
      589                     buf_prod-bc-db.b-str = ub.prod-bc.b-str
      590                 AND  buf_prod-bc-db.b-code = ub.prod-bc.b-code
      591                 AND  buf_prod-bc-db.db-num = g#db-num no-error.
      592           if available buf_prod-bc-db then do:
      593             delete buf_prod-bc-db.
      594           end.
      595         end.
      596       end.
      597     if l-prod-bc-global or prod-bc.bc-on-type eq 'GTIN':U then do:
      598       run nws/cmd-del.p
      599         ( input 'prod-bc':U
      600          ,input (buffer ub.prod-bc:handle)
      601          ,input "":U
      602         ) no-error .
      603       if error-status :error then do:
      604         undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      605       end.
      606     end.
      607   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      608     (input ?
      609     ,input this-procedure:handle
      610     ,input ?
      611     ,input 'delprcode':U
      612     ,input  buffer ub.prod-bc:handle
      613     ,input ?
      614     ,input ''
      615     ,input ''
      616     ) no-error .
      617     if error-status:error
      618     then do:
      619       if not g#news then do:
      620         message
      621           vss-workfile vss-revision vss-description skip
      622           "Ошибка при вызове процедуры rum-runa.i" skip
      623           error-status :get-message(1) skip
      624           return-value skip
      625           view-as alert-box error .
      626       end.
      627       undo main-block,  return error return-value .
      628     end.
      629       if g#oxml = yes
      630       then do:
      631       run str/calloxml.p (
      632             input 'delete':U
      633           , input 'prod-bc':U
      634           , input ( buffer ub.prod-bc:handle )
      635       ) no-error.
      636       if error-status :error
      637       then do:
      638           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      639                                , chr(10)
      640                                , vss-workfile
      641                                , return-value
      642                                , error-status :get-message ( 1 ) ).
      643       end.
      644       end.
      645   end.
      646   for each prod-bc-attr where prod-bc-attr.b-code eq prod-bc.b-code
      647                           and prod-bc-attr.b-str  eq prod-bc.b-str
      648      exclusive-lock:
      649          delete prod-bc-attr.
      650   end.
