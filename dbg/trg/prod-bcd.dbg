      111     ,input  'nws-to-hist'
      112     ,output v-send
      113     ) no-error .
      114         if v-send < 0 then return.
      115       end.
      116       run cur-time in this-procedure(output v-date, output v-time).
      117       create buf_c-prod-bc.
      118       buffer-copy ub.prod-bc to buf_c-prod-bc
      119       assign
      120       buf_c-prod-bc.b-code             = (if p-new-record then ub.prod-bc.b-code else ub.prod-bc.b-code)
      121       buf_c-prod-bc.b-str              = (if p-new-record then ub.prod-bc.b-str  else ub.prod-bc.b-str)
      122       buf_c-prod-bc.chip-num           = next-value (s-gds-chip, ub)
      123       buf_c-prod-bc.corr-time          = v-time
      124       buf_c-prod-bc.corr-user-db-num   = g#db-num
      125       buf_c-prod-bc.corr-user-name     = (if g#news
      126                                           then (chr(4) +  'СПН':U)
      127                                           else (if g#esys
      128                                                then (chr(4) +  'ВС':U)
      129                                                else g#userid)
      130                                          )
      131       buf_c-prod-bc.corr-date          = v-date
      132       .
      133       create buf_c-bar-code.
      134       assign
      135       buf_c-bar-code.b-code             = (if p-new-record then ub.prod-bc.b-code else ub.prod-bc.b-code)
      136       buf_c-bar-code.gds-code           = p-gds-code
      137       buf_c-bar-code.chip-num           = buf_c-prod-bc.chip-num
      138       buf_c-bar-code.corr-time          = v-time
      139       buf_c-bar-code.corr-user-db-num   = g#db-num
      140       buf_c-bar-code.corr-user-name     = (if g#news
      141                                           then (chr(4) +  'СПН':U)
      142                                           else (if g#esys
      143                                                then (chr(4) +  'ВС':U)
      144                                                else g#userid)
      145                                          )
      146       buf_c-bar-code.corr-date          = v-date
      147       .
      148       create buf_c-gds-hist.
      149       buffer-copy buf_c-prod-bc to buf_c-gds-hist
      150       assign
      151       buf_c-gds-hist.gds-code           = p-gds-code
      152       buf_c-gds-hist.action = (if p-new-record
      153                                 then integer('1':U)
      154                                 else p-action
      155                               )
      156       buf_c-gds-hist.subject = 'prod-bc':U
      157       buf_c-gds-hist.is-news = g#news
      158       buf_c-gds-hist.source-type = (if g#news
      159                                     then 'db':U
      160                                     else (if g#esys
      161                                           then 'esys':U
      162                                           else "":U)
      163                                     )
      164       buf_c-gds-hist.source-ref = (if g#news
      165                                     then string(g#news-source-db)
      166                                     else (if g#esys
      167                                           then string(g#esys-source-esys)
      168                                           else "":U)
      169                                     )
      170       .
      171     end.
      172   end procedure.
