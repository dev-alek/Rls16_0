     2255           v-total-price-base = v-total-price-base + parts.fact-qnty * parts.price-base
     2256           v-total-price-rubl = v-total-price-rubl + parts.fact-qnty * parts.price-rubl
     2257         .
     2258       end.
     2259       if v-doc-line-chg-qnty <> v-total-parts-qnty then do:
     2260         message
