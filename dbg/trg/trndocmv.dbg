     2236       define variable v-total-parts-qnty as decimal no-undo .
     2237       define variable v-total-price-base as decimal no-undo .
     2238       define variable v-total-price-rubl as decimal no-undo .
     2239       assign
     2240         v-total-parts-qnty = 0
     2241         v-total-price-base = 0
     2242         v-total-price-rubl = 0
     2243       .
     2244       for each ub.parts
     2245         where ub.parts.obj-type  = buf_doc-line.obj-type
     2246           and ub.parts.obj-code  = buf_doc-line.obj-code
     2247           and ub.parts.artic     = buf_doc-line.artic
