      522   procedure lineattr-write-add-line-cli :
      523   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      524   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      525   define input  parameter p-cli-type      as character no-undo .
      526   define input  parameter p-cli-code      as integer   no-undo .
      527   define input  parameter p-contract-code as integer   no-undo .
      528   define input  parameter p-host-code     as integer   no-undo .
      529   define input  parameter p-exch-code     as integer   no-undo .
      530   define input  parameter p-exch-rate     as decimal   no-undo .
      531   define input  parameter p-exch-scale    as integer   no-undo .
      532   define input  parameter p-sum-cli       as decimal   no-undo .
      533   define input  parameter p-sum-vat       as decimal   no-undo .
      534   define buffer buf_doc-line-attr for ub.doc-line-attr .
      535     do
      536     on error undo, return error return-value
      537     :
      538       find first buf_doc-line-attr exclusive-lock
      539         where buf_doc-line-attr.doc-code  = p-doc-code
      540           and buf_doc-line-attr.gds-code  = p-gds-code
      541           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      542                                             chr(4) + p-cli-type +
      543                                             chr(4) + string(p-cli-code) +
      544                                             chr(4) + string(p-contract-code) +
      545                                             chr(4) + string(p-host-code)
      546         no-error .
      547       if not available buf_doc-line-attr then do:
      548         create buf_doc-line-attr .
      549         assign
      550           buf_doc-line-attr.doc-code  = p-doc-code
      551           buf_doc-line-attr.gds-code  = p-gds-code
      552           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      553                                         chr(4) + p-cli-type +
      554                                         chr(4) + string(p-cli-code) +
      555                                         chr(4) + string(p-contract-code) +
      556                                         chr(4) + string(p-host-code)
      557         .
      558       end.
      559       assign
      560         buf_doc-line-attr.attr-value =
      561         string(p-exch-code)  + chr(4) +
      562         string(p-exch-rate)  + chr(4) +
      563         string(p-exch-scale) + chr(4) +
      564         string(p-sum-cli)    + chr(4) +
      565         string(p-sum-vat)
      566         .
      567     end.
      568   end procedure.
      569   procedure lineattr-value-add-line-cli :
      570   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      571   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      572   define input   parameter p-cli-type      as character no-undo .
      573   define input   parameter p-cli-code      as integer   no-undo .
      574   define input   parameter p-contract-code as integer   no-undo .
      575   define input   parameter p-host-code     as integer   no-undo .
      576   define output  parameter p-exch-code     as integer   no-undo .
      577   define output  parameter p-exch-rate     as decimal   no-undo .
      578   define output  parameter p-exch-scale    as integer   no-undo .
      579   define output  parameter p-sum-cli       as decimal   no-undo .
      580   define output  parameter p-sum-vat       as decimal   no-undo .
      581   define buffer buf_doc-line-attr for ub.doc-line-attr .
      582     do
      583     on error undo, return error return-value
      584     :
      585       find first buf_doc-line-attr exclusive-lock
      586         where buf_doc-line-attr.doc-code  = p-doc-code
      587           and buf_doc-line-attr.gds-code  = p-gds-code
      588           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      589                                             chr(4) + p-cli-type +
      590                                             chr(4) + string(p-cli-code) +
      591                                             chr(4) + string(p-contract-code) +
      592                                             chr(4) + string(p-host-code)
      593         no-error .
      594       if available buf_doc-line-attr then do:
      595        assign
      596           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      597           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      598           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      599           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      600           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      601          .
      602        end.
      603     end.
      604   end procedure.
      605   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      606     define variable v-code as character no-undo .
      607     define variable v-type as character no-undo .
      608     define variable v-gds-code as integer   no-undo .
      609   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      611     (input  local-doc-line.artic
      612     ,input  local-doc-line.prod-type
      613     ,input  local-doc-line.prod-code
      614     ,output v-gds-code
      615     )  .
      616     run lineattr-value (
      617         input   local-doc-line.doc-code ,
      618         input   v-gds-code              ,
      619         input   'reason-code':U ,
      620         output  v-code                  ,
      621         output  v-type ) .
      622     find first ub.trn-reason no-lock where
      623                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      624     if not available ub.trn-reason then do:
      625        return "" .
      626     end.
      627     else do:
      628        return ub.trn-reason.reason-name .
      629     end.
      630   end function.
