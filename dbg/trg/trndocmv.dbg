     2276       if cli_doc-prt <> obj_doc-prt then do:
     2277   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2278   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2279     (input  ub.goods.artic
     2280     ,input  ub.goods.prod-type
     2281     ,input  ub.goods.prod-code
     2282     ,output v-prt-create-n-c
     2283     )  .
     2284         if cli_doc-prt = true then do:
     2285   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2286     (input  v-prt-create-n-c
     2287     ,output v-prt-create-n-c
     2288     )  .
     2289         end.
     2290       end.
     2291       define variable v-gds-dtl-chg-qnty   as decimal no-undo .
     2292       define variable v-total-gds-dtl-qnty as decimal no-undo .
     2293       define variable v-create-n-c like ub.gds-prt.node-code no-undo .
     2294       assign
     2295         v-total-gds-dtl-qnty = 0
     2296       .
     2297       for each ub.gds-dtl no-lock
     2298         where ub.gds-dtl.doc-code  = ub.doc-line.doc-code
     2299           and ub.gds-dtl.prod-type = ub.doc-line.prod-type
     2300           and ub.gds-dtl.prod-code = ub.doc-line.prod-code
     2301           and ub.gds-dtl.artic     = ub.doc-line.artic
     2302       on error undo, return error
     2303       :
     2304         assign
     2305           v-gds-dtl-chg-qnty = 0
     2306         .
     2307         if ub.gds-dtl.fact-qnty < 0 then do:
     2308           message
     2309             vss-workfile vss-revision vss-description skip
     2310             "В документе внутреннего перемещения в строке признака" skip
     2311             "не может быть задано отрицательное количество" skip
     2312             view-as alert-box error .
     2313           undo, return error .
     2314         end.
     2315         if ub.trn-doc.doc-type = 'рас':U
     2316         and ub.gds-dtl.fact-qnty  <> 0
     2317         then do:
     2318           assign
     2319             v-gds-dtl-chg-qnty = ub.gds-dtl.fact-qnty
     2320           .
     2321         end.
     2322         if ub.trn-doc.doc-type = 'при':U then do:
     2323           if  cli_doc-prt = no
     2324           and obj_doc-prt = yes then do:
     2325             if ub.gds-dtl.fact-qnty <> ub.gds-dtl.doc-qnty then do:
     2326               assign
     2327                 v-gds-dtl-chg-qnty = ub.gds-dtl.doc-qnty - ub.gds-dtl.fact-qnty
     2328               .
     2329             end.
     2330           end.
     2331           else do:
     2332             if ub.gds-dtl.fact-qnty > ub.gds-dtl.doc-qnty then do:
     2333               message
     2334                 vss-workfile vss-revision vss-description skip
     2335                 "В приходном документе в строке признака" skip
     2336                 "фактическое количество не может быть больше, чем количество по документу" skip
     2337                 view-as alert-box error .
     2338               undo, return error .
     2339             end.
     2340             if ub.gds-dtl.fact-qnty < ub.gds-dtl.doc-qnty then do:
     2341               assign
     2342                 v-gds-dtl-chg-qnty = ub.gds-dtl.doc-qnty - ub.gds-dtl.fact-qnty
     2343               .
     2344             end.
     2345           end.
     2346         end.
     2347         if v-gds-dtl-chg-qnty = 0 then do:
     2348           next.
     2349         end.
     2350         if cli_doc-prt = obj_doc-prt then do:
     2351           assign
     2352             v-create-n-c = ub.gds-dtl.prt-code
     2353           .
     2354         end.
     2355         else do:
     2356           assign
     2357             v-create-n-c = v-prt-create-n-c
     2358           .
     2359         end.
     2360         find first buf_gds-dtl
     2361           where buf_gds-dtl.doc-code    = buf_trn-doc.doc-code
     2362             and buf_gds-dtl.artic       = ub.doc-line.artic
     2363             and buf_gds-dtl.prod-type   = ub.doc-line.prod-type
     2364             and buf_gds-dtl.prod-code   = ub.doc-line.prod-code
     2365             and buf_gds-dtl.prt-code    = v-create-n-c
     2366           no-error .
     2367         if not available buf_gds-dtl then do:
     2368           create buf_gds-dtl.
     2369           assign
     2370             buf_gds-dtl.doc-code    = buf_trn-doc.doc-code
     2371             buf_gds-dtl.artic       = ub.doc-line.artic
     2372             buf_gds-dtl.prod-type   = ub.doc-line.prod-type
     2373             buf_gds-dtl.prod-code   = ub.doc-line.prod-code
     2374             buf_gds-dtl.prt-code    = v-create-n-c
     2375             buf_gds-dtl.obj-type    = buf_trn-doc.obj-type
     2376             buf_gds-dtl.obj-code    = buf_trn-doc.obj-code
     2377           .
     2378           if cli_doc-prt = obj_doc-prt then do:
     2379             assign
     2380               buf_gds-dtl.discnt-base = ub.gds-dtl.discnt-base
     2381               buf_gds-dtl.discnt-rubl = ub.gds-dtl.discnt-rubl
     2382               buf_gds-dtl.discnt-pc   = ub.gds-dtl.discnt-pc
     2383               buf_gds-dtl.discnt-type = ub.gds-dtl.discnt-type
     2384             .
     2385           end.
     2386           else do:
     2387             assign
     2388               buf_gds-dtl.discnt-base = 0
     2389               buf_gds-dtl.discnt-rubl = 0
     2390               buf_gds-dtl.discnt-pc   = 0
     2391               buf_gds-dtl.discnt-type = ?
     2392             .
     2393           end.
     2394         end.
     2395         assign
     2396           buf_gds-dtl.price-base     = ( buf_gds-dtl.price-base * buf_gds-dtl.fact-qnty
     2397                                     + ub.gds-dtl.price-base * v-gds-dtl-chg-qnty )
     2398                                     / (buf_gds-dtl.fact-qnty + v-gds-dtl-chg-qnty)
     2399           buf_gds-dtl.price-rubl     = ( buf_gds-dtl.price-rubl * buf_gds-dtl.fact-qnty
     2400                                     + ub.gds-dtl.price-rubl * v-gds-dtl-chg-qnty )
     2401                                     / (buf_gds-dtl.fact-qnty + v-gds-dtl-chg-qnty)
     2402           buf_gds-dtl.new-price-sale = ub.gds-dtl.new-price-sale
     2403           buf_gds-dtl.ov             = yes
     2404           buf_gds-dtl.fact-qnty      = buf_gds-dtl.fact-qnty + v-gds-dtl-chg-qnty
     2405           buf_gds-dtl.doc-qnty       = buf_gds-dtl.doc-qnty  + v-gds-dtl-chg-qnty
     2406           v-total-gds-dtl-qnty       = v-total-gds-dtl-qnty + v-gds-dtl-chg-qnty
     2407         .
     2408       end.
     2409       if v-total-gds-dtl-qnty <> v-doc-line-chg-qnty then do:
     2410         message
     2411           vss-workfile vss-revision vss-description skip
     2412           "Количество в признаках не совпадает с количеством в строке документа." skip
     2413           "Количество по документу = " v-doc-line-chg-qnty skip
     2414           "Количество по признакам = " v-total-gds-dtl-qnty skip
     2415           view-as alert-box .
     2416         undo, return error.
     2417       end.
     2418     end.
     2419     if not can-find(first ub.doc-line
     2420       where ub.doc-line.doc-code = buf_trn-doc.doc-code)
     2421     then do:
     2422       delete buf_trn-doc.
     2423       return .
     2424     end.
     2425     assign
     2426       buf_trn-doc.PS          = '@  Строк в документе : ' + string(n_str) + (if substring(ub.trn-doc.ps, 1, 1) = '@' then '' else chr(10) + ub.trn-doc.ps)
     2427       buf_trn-doc.fact-base   = ?
     2428       buf_trn-doc.fact-rubl   = ?
     2429     .
     2430     run gbl/calc-trn.p (input ? , INPUT RECID(buf_trn-doc)).
     2431     run cus/oo-mkrcv.p (
     2432           buffer ub.trn-doc ,
     2433           buffer buf_trn-doc )
     2434           no-error .
     2435      if error-status :error then
     2436      message vss-workfile vss-revision vss-description skip
     2437             "Ошибка oo-mkrcv.p  " skip
     2438              skip
     2439              error-status :get-message(1) skip
     2440              error-status :get-message(2) skip
     2441              return-value skip
     2442              view-as alert-box error
     2443      .
     2444     assign
     2445       buf_trn-doc.flag_ = yes
     2446     .
     2447     for each buf_doc-line where buf_doc-line.doc-code = buf_trn-doc.doc-code on error undo, return error return-value :
     2448       find first ub.goods where
     2449                 ub.goods.artic     = buf_doc-line.artic     and
     2450                 ub.goods.prod-type = buf_doc-line.prod-type and
     2451                 ub.goods.prod-code = buf_doc-line.prod-code no-lock.
     2452       var-ok-assort-pol = true .
     2453       if buf_trn-doc.ext-doc-type = 'iv':U then do:
     2454          v-event-code = substitute("&1" , buf_trn-doc.ext-doc-type ) .
     2455   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2456   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     2457     (input  v-event-code
     2458     ,input  ub.goods.gds-code
     2459     ,input  buf_trn-doc.obj-type
     2460     ,input  buf_trn-doc.obj-code
     2461     ,input  false
     2462     ,output var-ok-assort-pol
     2463     ,output var-mess-assort-pol
     2464     ) .
     2465       end.
     2466       if var-ok-assort-pol = false then do:
     2467           buf_trn-doc.PS = buf_trn-doc.PS + chr(10) + var-mess-assort-pol .
     2468       end.
     2469     end.
     2470     run gbl/calc-trn.p (input ?  , input recid(buf_trn-doc)) no-error.
     2471     if error-status :error then do:
     2472       undo, return error return-value.
     2473     end.
     2474     define variable v-qnty as decimal no-undo .
     2475     if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-gds-attr-value-old) then
     2476     do:
     2477       if buf_trn-doc.ext-doc-type = 'rv':U then
     2478       do:
     2479         for each ub.doc-line no-lock where ub.doc-line.doc-code = buf_trn-doc.doc-code:
     2480           for each ub.marking-lines no-lock where ub.marking-lines.gds-code = ub.goods.gds-code
     2481             and ub.marking-lines.out-code = ub.trn-doc.doc-code
     2482             and ub.marking-lines.obj-code = ub.trn-doc.obj-code
     2483             and ub.marking-lines.obj-type = ub.trn-doc.obj-type,
     2484             first buf_marking exclusive-lock where buf_marking.mark = ub.marking-lines.mark:
     2485             if ub.marking-lines.sts = ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB then
     2486             do:
     2487               assign
     2488                 buf_marking.sts = ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB
     2489                 .
     2490             end.
     2491           end.
     2492         end.
     2493       end.
     2494       if buf_trn-doc.ext-doc-type = 'iv':U then
     2495       do:
     2496         for each buf_doc-line exclusive-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code,
     2497           first buf_gds-dtl exclusive-lock where buf_gds-dtl.doc-code = buf_doc-line.doc-code and buf_gds-dtl.artic = buf_doc-line.artic and
     2498           buf_gds-dtl.prod-code = buf_doc-line.prod-code and buf_gds-dtl.prod-type = buf_doc-line.prod-type:
     2499           v-qnty = v-qnty + buf_doc-line.fact-qnty .
     2500           buf_doc-line.fact-qnty = 0 .
     2501           buf_gds-dtl.fact-qnty = buf_doc-line.fact-qnty .
     2502           for first buf_parts exclusive-lock where buf_parts.out-code = buf_doc-line.doc-code and buf_parts.artic = buf_doc-line.artic and
     2503             buf_parts.prod-code = buf_doc-line.prod-code and buf_parts.prod-type = buf_doc-line.prod-type and buf_parts.obj-code = buf_doc-line.obj-code and
     2504             buf_parts.obj-type = buf_doc-line.obj-type:
     2505             buf_parts.fact-qnty = buf_doc-line.fact-qnty .
     2506           end.
     2507         end.
     2508         buf_trn-doc.fact-qnty = buf_trn-doc.fact-qnty - v-qnty .
     2509       end.
     2510     end.
     2511   end.
     2512   procedure get-country-code :
     2513     define input  parameter p-trn-doc      as character no-undo .
     2514     define input  parameter p-ext-doc-type as character no-undo .
     2515     define input  parameter p-gds-code     as integer   no-undo .
     2516     define output parameter p-country-code as integer   no-undo .
     2517     define buffer buf_goods   for ub.goods .
     2518     define buffer buf_country for ub.country .
     2519     define variable v-read-default-code as logical   no-undo .
     2520     define variable v-attr-value        as character no-undo .
     2521     define variable v-attr-type         as character no-undo .
     2522     do
     2523     on error undo, return error return-value
     2524     :
     2525       assign
     2526         v-read-default-code = true
     2527       .
     2528       if p-ext-doc-type = 'ie':U
     2529       then do:
     2530         run lineattr-value in this-procedure
     2531           (input  p-trn-doc
     2532           ,input  p-gds-code
     2533           ,input  'country-code':U
     2534           ,output v-attr-value
     2535           ,output v-attr-type
     2536           ) .
     2537         if v-attr-value <> ""
     2538         then do:
     2539           assign
     2540             v-read-default-code = false
     2541             p-country-code      = integer(v-attr-value)
     2542           .
     2543         end.
     2544       end.
     2545       if v-read-default-code = true
     2546       then do:
     2547         find first buf_goods no-lock
     2548           where buf_goods.gds-code = p-gds-code
     2549           no-error .
     2550         find first buf_country no-lock
     2551           where buf_country.alpha1 = buf_goods.alpha1
     2552           no-error .
     2553         if available buf_country
     2554         then do:
     2555           assign
     2556             p-country-code = buf_country.num-code
     2557           .
     2558         end.
     2559         else do:
     2560           assign
     2561             p-country-code = 0
     2562           .
     2563         end.
     2564       end.
     2565     end.
     2566   end procedure.
