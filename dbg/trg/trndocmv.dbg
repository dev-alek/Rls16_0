        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.gbl.*.
        4   using ibs.th.gbl.sys.*.
        5   define input parameter v-doc-code like ub.trn-doc.doc-code no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision$":U .
        7   define variable vss-author      as character no-undo initial "$Author$":U .
        8   define variable vss-date        as character no-undo initial "$Date$":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       10   define variable vss-archive     as character no-undo initial "$Archive$":U .
       11   define variable vss-description as character no-undo initial "Создание документов внутреннего перемещения":U .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define new global shared variable g#lib-trn  as handle no-undo .
       82   define new global shared variable g#lib-trn2 as handle no-undo .
       83   define new global shared variable g#lib-trn3 as handle no-undo .
       84   define new global shared variable g#lib-trn4 as handle no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure doc-code:
       87   define input  parameter parmode          as   character           no-undo.
       88   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
       89   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
       90   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
       91   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
       92   define buffer buf_sys-ctrl for ub.sys-ctrl  .
       93   define variable vardb-remote     as   logical             no-undo.
       94   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
       95   define variable v-delimiter as character no-undo .
       96   do
       97   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       98   :
       99   find first buf_sys-ctrl no-lock .
      100   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      101     CASE parmode:
      102       when "main":u then do:
      103         if vardb-remote then do:
      104           assign
      105             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      106         end.
      107         else do:
      108           assign
      109             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      110         end.
      111       end.
      112       when "trio" then do:
      113         assign
      114           pardoc-code = replace (parroot-doc-code, "=", "*").
      115       end.
      116       otherwise do:
      117         assign
      118         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      119         no-error
      120         .
      121         if error-status:error  then do:
      122           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      123                                         ,chr(10)
      124                                         ,parmode
      125                                         ).
      126         end.
      127         if num-entries(parmode) = 1
      128         and parmode <> "chip":U
      129         and parmode <> "chip_s":U
      130         then do:
      131           assign
      132           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      133         end.
      134         else if (lookup("chip":U, parmode) > 0
      135                  or
      136                  lookup("chip_s":U, parmode) > 0) then do:
      137           assign
      138             vartemp-doc-code = parroot-doc-code.
      139           do while true:
      140             if index (vartemp-doc-code , ".") = 0 then
      141               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
      142             else
      143               vartemp-doc-code  =
      144               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
      145               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
      146               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
      147             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
      148           end.
      149           assign
      150             pardoc-code = vartemp-doc-code.
      151         end.
      152       end.
      153     end CASE.
      154     if pardoc-code = '':U
      155     or (parroot-doc-code <> '':U
      156     and pardoc-code = parroot-doc-code) then do:
      157       undo, return error substitute("Ошибка при генерации номера документа&1"
      158                                     ,chr(10)).
      159     end.
      160   end.
      161   end. // procedure/method
      162   function get-doc-code-int64 returns int64
      163     ( input p-doc-code as character ) :
      164     define variable v-ind              as integer   no-undo .
      165     define variable v-num-entries      as integer   no-undo .
      166     define variable v-doc-code-int64   as int64     no-undo .
      167     define variable v-canonic-doc-code as character no-undo .
      168     assign
      169       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
      170       v-canonic-doc-code = p-doc-code
      171     .
      172     do v-ind = 1 to v-num-entries
      173     :
      174       assign
      175         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
      176       .
      177     end.
      178     assign
      179       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
      180     .
      181     return v-doc-code-int64 .
      182   end. // function/method
      183   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   define new global shared variable g#trdcalib as handle no-undo.
      185   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   procedure lineattr-value :
      187     do
      188     on error undo, return error return-value
      189     :
      190       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      191       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      192       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      193       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      194       define output parameter p-type     as character no-undo .
      195       define buffer buf_doc-line-attr for ub.doc-line-attr .
      196       def var v-format         as character no-undo .
      197       def var v-fillin_width   as integer   no-undo .
      198       def var v-fillin_height  as integer   no-undo .
      199       def var v-label          as character no-undo .
      200       def var v-user-can-edit  as logical   no-undo .
      201       def var v-output-display as logical   no-undo .
      202       def var v-other          as character no-undo .
      203       run lineattr-code in this-procedure
      204         (input  p-code
      205         ,output p-type
      206         ,output v-format
      207         ,output v-fillin_width
      208         ,output v-fillin_height
      209         ,output v-label
      210         ,output v-user-can-edit
      211         ,output v-output-display
      212         ,output v-other
      213         ) no-error .
      214       if error-status :error then do:
      215         undo, return error return-value .
      216       end.
      217       find first buf_doc-line-attr no-lock
      218         where buf_doc-line-attr.doc-code  = p-doc-code
      219           and buf_doc-line-attr.gds-code  = p-gds-code
      220           and buf_doc-line-attr.attr-code = p-code
      221         no-error .
      222       if avail buf_doc-line-attr then do:
      223         assign
      224           p-value =  buf_doc-line-attr.attr-value
      225         .
      226       end.
      227       else do:
      228         assign
      229           p-value = if p-type = 'L':U then "no":U else ""
      230         .
      231       end.
      232     end.
      233   end procedure.
      234   procedure lineattr-write :
      235     do
      236     on error undo, return error return-value
      237     :
      238       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      239       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      240       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      241       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      242       define buffer buf_doc-line-attr for ub.doc-line-attr .
      243       def var v-type           as character no-undo .
      244       def var v-format         as character no-undo .
      245       def var v-fillin_width   as integer   no-undo .
      246       def var v-fillin_height  as integer   no-undo .
      247       def var v-label          as character no-undo .
      248       def var v-user-can-edit  as logical   no-undo .
      249       def var v-output-display as logical   no-undo .
      250       def var v-other          as character no-undo .
      251       run lineattr-code in this-procedure
      252         (input  p-code
      253         ,output v-type
      254         ,output v-format
      255         ,output v-fillin_width
      256         ,output v-fillin_height
      257         ,output v-label
      258         ,output v-user-can-edit
      259         ,output v-output-display
      260         ,output v-other
      261         ) no-error .
      262       if error-status :error then do:
      263         undo, return error return-value .
      264       end.
      265       find first buf_doc-line-attr exclusive-lock
      266         where buf_doc-line-attr.doc-code  = p-doc-code
      267           and buf_doc-line-attr.gds-code  = p-gds-code
      268           and buf_doc-line-attr.attr-code = p-code
      269         no-error .
      270       if not available buf_doc-line-attr then do:
      271         create buf_doc-line-attr .
      272         assign
      273           buf_doc-line-attr.doc-code  = p-doc-code
      274           buf_doc-line-attr.gds-code = p-gds-code
      275           buf_doc-line-attr.attr-code = p-code
      276         .
      277       end.
      278       assign
      279         buf_doc-line-attr.attr-value = p-value
      280       .
      281        release buf_doc-line-attr.
      282     end.
      283   end procedure.
      284   procedure lineattr-exist :
      285     do
      286     on error undo, return error return-value
      287     :
      288       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      289       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      290       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      291       define output parameter p-exist   as logical  no-undo .
      292       define buffer buf_doc-line-attr for ub.doc-line-attr .
      293       def var v-type           as character no-undo .
      294       def var v-format         as character no-undo .
      295       def var v-fillin_width   as integer   no-undo .
      296       def var v-fillin_height  as integer   no-undo .
      297       def var v-label          as character no-undo .
      298       def var v-user-can-edit  as logical   no-undo .
      299       def var v-output-display as logical   no-undo .
      300       def var v-other          as character no-undo .
      301       run lineattr-code in this-procedure
      302         (input  p-code
      303         ,output v-type
      304         ,output v-format
      305         ,output v-fillin_width
      306         ,output v-fillin_height
      307         ,output v-label
      308         ,output v-user-can-edit
      309         ,output v-output-display
      310         ,output v-other
      311         ) no-error .
      312       if error-status :error then do:
      313         undo, return error return-value .
      314       end.
      315       find first buf_doc-line-attr no-lock
      316         where buf_doc-line-attr.doc-code  = p-doc-code
      317           and buf_doc-line-attr.gds-code = p-gds-code
      318           and buf_doc-line-attr.attr-code = p-code
      319         no-error .
      320       if  available buf_doc-line-attr then do:
      321         p-exist = yes.
      322       end.
      323     end.
      324   end procedure.
      325   procedure lineattr-delete :
      326     do
      327     on error undo, return error return-value
      328     :
      329       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      330       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      331       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      332       define output parameter p-deleted  as logical no-undo.
      333       define buffer buf_doc-line-attr for ub.doc-line-attr .
      334       def var v-type           as character no-undo .
      335       def var v-format         as character no-undo .
      336       def var v-fillin_width   as integer   no-undo .
      337       def var v-fillin_height  as integer   no-undo .
      338       def var v-label          as character no-undo .
      339       def var v-user-can-edit  as logical   no-undo .
      340       def var v-output-display as logical   no-undo .
      341       def var v-other          as character no-undo .
      342       run lineattr-code in this-procedure
      343         (input  p-code
      344         ,output v-type
      345         ,output v-format
      346         ,output v-fillin_width
      347         ,output v-fillin_height
      348         ,output v-label
      349         ,output v-user-can-edit
      350         ,output v-output-display
      351         ,output v-other
      352         ) no-error .
      353       if error-status :error then do:
      354         undo, return error return-value .
      355       end.
      356       find first buf_doc-line-attr exclusive-lock
      357         where buf_doc-line-attr.doc-code  = p-doc-code
      358           and buf_doc-line-attr.gds-code  = p-gds-code
      359           and buf_doc-line-attr.attr-code = p-code
      360         no-error NO-WAIT.
      361       if not available buf_doc-line-attr then do:
      362         p-deleted = no.
      363       end.
      364       else do:
      365         delete buf_doc-line-attr.
      366         p-deleted = yes.
      367       end.
      368     end.
      369   end procedure.
      370   procedure lineattr-code :
      371     do on error undo, return error return-value
      372     :
      373       define input  parameter p-code           as character no-undo .
      374       define output parameter p-type           as character no-undo .
      375       define output parameter p-format         as character no-undo .
      376       define output parameter p-fillin_width   as integer   no-undo .
      377       define output parameter p-fillin_height  as integer   no-undo .
      378       define output parameter p-label          as character no-undo .
      379       define output parameter p-user-can-edit  as logical   no-undo .
      380       define output parameter p-output-display as logical   no-undo .
      381       define output parameter p-other          as character no-undo .
      382       case p-code :
      383               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      384               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      385               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      386               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      387               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      388               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      389               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      390               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      391               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      392               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      393               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      394         otherwise do:
      395           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      396         end.
      397       end.
      398     end.
      399   end procedure.
      400   procedure lineattr-value-flora-gds :
      401     do
      402     on error undo, return error return-value
      403     :
      404       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      405       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      406       define input  parameter p-prt-code    as integer   no-undo .
