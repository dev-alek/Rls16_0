      303       create buf_parts .
      304       buffer-copy ub.parts to buf_parts
      305       assign
      306         buf_parts.part-code  = v-new-part-code
      307         buf_parts.out-code   = ub.parts.out-code
      308         buf_parts.status_    = ub.parts.status_
      309         buf_parts.doc-type   = ub.parts.doc-type
      310         buf_parts.rsrv-free  = ub.parts.rsrv-free
