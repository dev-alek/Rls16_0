      132         and ub.goods.prod-type = p-prod-type
      133         and ub.goods.prod-code = p-prod-code
      134       no-error .
      135     if not available ub.goods
      136     then do:
      137       message
      138         vss-workfile vss-revision vss-description skip
      139         "Ошибка задания входных параметров" skip
      140         "Не найден товар" skip
      141         "Объект" p-obj-type p-obj-code skip
      142         "Артикул" p-artic p-prod-type p-prod-code skip
      143         "Партия" p-in-code p-part-code skip
      144         "Документ" p-out-code skip
      145         view-as alert-box error .
      146       undo, return error .
      147     end.
