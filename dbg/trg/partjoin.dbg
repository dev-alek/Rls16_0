       96   do
       97   on error undo, return error
       98   :
       99     assign
      100       v-spacial-doc = false
      101     .
      102     if p-out-code <> 'free-zone':U
      103     then do:
      104       find first buf_trn-doc no-lock
      105         where buf_trn-doc.doc-code = p-out-code
      106         no-error .
      107       if available buf_trn-doc
      108         and ( buf_trn-doc.ext-doc-type = 'iv':U
      109               or buf_trn-doc.ext-doc-type = 'rv':U
      110             )
      111       then do:
      112         assign
      113           v-spacial-doc = true
      114         .
      115       end.
      116       else do:
      117         message
      118           vss-workfile vss-revision vss-description skip
      119           "Ошибка задания входных параметров" skip
      120           "Данная версия программы не может склеивать партии" skip
      121           "зарезервированные за документами" skip
      122           "Объект" p-obj-type p-obj-code skip
      123           "Артикул" p-artic p-prod-type p-prod-code skip
      124           "Партия" p-in-code p-part-code skip
      125           "Документ" p-out-code skip
      126           view-as alert-box error .
      127         undo, return error .
      128       end.
