      286     define buffer buf_parts for ub.parts .
      287     define variable v-new-part-code like ub.parts.part-code no-undo .
      288     assign
      289       v-new-part-code = entry(1, ub.parts.part-code, '#':U)
      290     .
      291     find first buf_parts exclusive-lock
      292       where buf_parts.obj-type  = ub.parts.obj-type
      293         and buf_parts.obj-code  = ub.parts.obj-code
      294         and buf_parts.artic     = ub.parts.artic
      295         and buf_parts.prod-type = ub.parts.prod-type
      296         and buf_parts.prod-code = ub.parts.prod-code
      297         and buf_parts.in-code   = ub.parts.in-code
      298         and buf_parts.out-code  = ub.parts.out-code
      299         and buf_parts.part-code = v-new-part-code
      300       no-error.
      301     if not available buf_parts
