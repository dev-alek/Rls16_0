        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.dis-grp-rule old old_dis-grp-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись скидки на группу".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&7|&8'
       29                           ,  ub.dis-grp-rule.classif-type
       30                           ,  ub.dis-grp-rule.node-code
       31                           ,  ub.dis-grp-rule.host-code
       32                           ,  ub.dis-grp-rule.obj-type
       33                           ,  ub.dis-grp-rule.obj-code
       34                           ,  ub.dis-grp-rule.pos-type
       35                           ,  ub.dis-grp-rule.templ-rl-root
       36                           ,  ub.dis-grp-rule.nonunique
       37                           )
       38       .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure cur-time :
       92      define output parameter p-today as date      no-undo .
       93      define output parameter p-time  as integer   no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       define variable v-date1 as date      no-undo .
       98       define variable v-date2 as date      no-undo .
       99       define variable v-time  as integer   no-undo .
      100       assign
      101         v-date1 = today
      102         v-time  = time
      103         v-date2 = today
      104       .
      105       if v-date1 <> v-date2
      106       then do:
      107         assign
      108           v-date1 = today
      109           v-time  = v-time
      110         .
      111       end.
      112       assign
      113         p-today = v-date1
      114         p-time  = v-time
      115       .
      116     end.
      117   end.
      118   function cur-time-date returns character
      119   :
      120     return string(today, '99/99/9999':U) .
      121   end.
      122   function cur-time-mjd returns decimal
      123   :
      124     define variable v-date as date      no-undo .
      125     define variable v-time as integer   no-undo .
      126     run cur-time in this-procedure
      127       (output v-date
      128       ,output v-time
      129       ) .
      130     return integer(v-date) - 2400002 + (v-time / 86400) .
      131   end.
      132   function cur-time-get-ending-index returns integer
      133   (input p-number as integer
      134   )
      135   :
      136     if p-number < 0
      137     or p-number = ?
      138     then do:
      139       return 1 .
      140     end.
      141     define variable v-rest as integer   no-undo .
      142     assign
      143       p-number = p-number modulo 100
      144     .
      145     if p-number < 20
      146     then do:
      147       assign
      148         v-rest = p-number
      149       .
      150     end.
      151     else do:
      152       assign
      153         v-rest = p-number modulo 10
      154       .
      155     end.
      156     case v-rest :
      157       when 1
      158       then do:
      159         return 2 .
      160       end.
      161       when 2 or
      162       when 3 or
      163       when 4
      164       then do:
      165         return 3 .
      166       end.
      167       otherwise do:
      168         return 1 .
      169       end.
      170     end case .
      171   end.
      172   procedure cur-time-mjd-to-date :
      173      define input  parameter i-mjd-diff as decimal no-undo.
      174      define output parameter o-Date     as date    no-undo.
      175      define output parameter o-Time     as integer no-undo.
      176      define variable v-day-number as integer   no-undo .
      177      if    i-mjd-diff < 0
      178         or i-mjd-diff = ?
      179      then do:
      180         return "?" .
      181      end.
      182      assign
      183         v-day-number = truncate(i-mjd-diff,0).
      184         o-Date = date(v-day-number + 2400002).
      185         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187   end.
      188   function cur-time-mjd-to-string returns character
      189   (input p-mjd-diff as decimal
      190   )
      191   :
      192     define variable v-day-number as integer   no-undo .
      193     define variable v-seconds    as integer   no-undo .
      194     define variable v-hour       as integer   no-undo .
      195     define variable v-min        as integer   no-undo .
      196     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      197     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      198     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      199     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      200     if p-mjd-diff < 0
      201     or p-mjd-diff = ?
      202     then do:
      203       return "?" .
      204     end.
      205     assign
      206       v-day-number = integer(truncate(p-mjd-diff,0))
      207       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209     if v-seconds > 86400
      210     then do:
      211       assign
      212         v-seconds = 86400 - 1
      213       .
      214     end.
      215     if v-seconds < 0
      216     then do:
      217       assign
      218         v-seconds = 0
      219       .
      220     end.
      221     assign
      222       v-hour = truncate(v-seconds / 3600, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 3600
      226     .
      227     assign
      228       v-min = truncate(v-seconds / 60, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 60
      232     .
      233     return
      234         (if v-day-number <> 0
      235           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0
      239           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      243           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      244           else ""
      245         )
      246       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      247       .
      248   end.
      249   function cur-time-string returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      258   end.
      259   function cur-time-string-sec returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      268   end.
      269   function cur-time-custom  returns character
      270   (input p-prefix as character
      271   ,input p-date-format as character
      272   ,input p-delimiter as character
      273   ,input p-time-format as character
      274   ,input p-suffix as character
      275   )
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return
      284       p-prefix
      285       + string(v-date, p-date-format)
      286       + p-delimiter
      287       + string(v-time, p-time-format)
      288       + p-suffix
      289       .
      290   end.
      291   function cur-time-print  returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-datetime returns datetime
      302   :
      303     define variable v-char as character no-undo .
      304     define variable v-datetime as datetime no-undo .
      305     v-char = cur-time-string().
      306     v-datetime = datetime(v-char).
      307     return  v-datetime.
      308   end.
      309   function cur-time-string-msec returns character
      310   :
      311     define variable v-date as datetime  no-undo .
      312     v-date = now.
      313     return string(v-date) .
      314   end.
      315   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   define new global shared variable g#lib-nws as handle no-undo .
      317   define variable v-date as date no-undo .
      318   define variable v-time as integer no-undo .
      319   define variable v-obj-db-num as integer no-undo .
      320   define buffer buf_c-dis-grp-rule for ub.c-dis-grp-rule.
      321   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      322   define buffer buf_c-sum-grp for ub.c-sum-grp.
      323   define buffer buf_c-sum-grp-obj for ub.c-sum-grp-obj.
      324   define buffer buf_c-cli-grp for ub.c-cli-grp.
      325   main-block:
      326   do
      327   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      328   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      329   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      330   :
      331     if not g#news
      332     and g#db-num > 0
      333     and (
      334         ub.dis-grp-rule.obj-type  = '':U
      335         or
      336         ub.dis-grp-rule.obj-code = 0
      337         or
      338         ub.dis-grp-rule.host-code  = 0
      339         ) then do:
      340       message
      341       vss-workfile vss-revision vss-description skip
      342       substitute("Фирма &1 &2&3 POS &4 код шаблона &5&6" +
      343                  "Нельзя изменять запись СКИДОК ПО ГРУППАМ в УБД"
      344                  ,ub.dis-grp-rule.host-code
      345                  ,ub.dis-grp-rule.obj-type
      346                  ,ub.dis-grp-rule.obj-code
      347                  ,ub.dis-grp-rule.pos-type
      348                  ,ub.dis-grp-rule.templ-rl-root
      349                  ,chr(10)
      350                  )
      351       view-as alert-box error .
      352       undo main-block, return error .
      353     end.
      354     if ub.dis-grp-rule.obj-type = 'маг':U
      355     or ub.dis-grp-rule.obj-type = 'скл':U then do:
      356   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      358     (input  ub.dis-grp-rule.obj-type
      359     ,input  ub.dis-grp-rule.obj-code
      360     ,output v-obj-db-num
      361     )  .
      362       if v-obj-db-num <> g#db-num
      363       and g#db-num <> 0 then do:
      364         message
      365         vss-workfile vss-revision vss-description skip
      366         substitute("Фирма &1 &2&3 POS &4 код шаблона &5&6" +
      367                   "Нельзя изменять запись СКИДОК ПО ГРУППАМ в чужой БД"
      368                  ,ub.dis-grp-rule.host-code
      369                  ,ub.dis-grp-rule.obj-type
      370                  ,ub.dis-grp-rule.obj-code
      371                  ,ub.dis-grp-rule.pos-type
      372                  ,ub.dis-grp-rule.templ-rl-root
      373                  ,chr(10)
      374                  )
      375         view-as alert-box error .
      376         undo main-block, return error .
      377       end.
      378     end.
      379     run str/callnews.p
      380       ( input 'dis-grp-rule':U
      381         ,input (buffer ub.dis-grp-rule:handle)
      382       ) .
      383     if g#news then do:
      384       define variable v-send as integer no-undo .
      385       v-send = integer('0':U).
      386   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      387   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      388     (input  g#db-num
      389     ,input  'dis-grp-rule':U
      390     ,input  0
      391     ,input  '':U
      392     ,input  0
      393     ,input  '':U
      394     ,input  '':U
      395     ,input  '':U
      396     ,input  0
      397     ,input  0
      398     ,input  0
      399     ,input  'nws-to-hist'
      400     ,output v-send
      401     ) no-error .
      402     end.
      403     if not g#news
      404     or v-send >= 0 then do:
      405       run cur-time in this-procedure(output v-date, output v-time).
      406       create buf_c-dis-grp-rule.
      407       buffer-copy old_dis-grp-rule
      408       except
      409       pos-type
      410       templ-rl-root
      411       host-code
      412       obj-type
      413       obj-code
      414       nonunique
      415       to buf_c-dis-grp-rule
      416       assign
      417       buf_c-dis-grp-rule.obj-type           = ub.dis-grp-rule.obj-type
      418       buf_c-dis-grp-rule.obj-code           = ub.dis-grp-rule.obj-code
      419       buf_c-dis-grp-rule.host-code           = ub.dis-grp-rule.host-code
      420       buf_c-dis-grp-rule.pos-type           = ub.dis-grp-rule.pos-type
      421       buf_c-dis-grp-rule.templ-rl-root      = ub.dis-grp-rule.templ-rl-root
      422       buf_c-dis-grp-rule.node-code          = ub.dis-grp-rule.node-code
      423       buf_c-dis-grp-rule.nonunique          = ub.dis-grp-rule.nonunique
      424       buf_c-dis-grp-rule.classif-type       = ub.dis-grp-rule.classif-type
      425       buf_c-dis-grp-rule.discnt-role        = ub.dis-grp-rule.discnt-role
      426       buf_c-dis-grp-rule.corr-time          = v-time
      427       buf_c-dis-grp-rule.corr-user-db-num   = g#db-num
      428       buf_c-dis-grp-rule.corr-user-name     = (if g#news
      429                                                then (chr(4) +  'СПН':U)
      430                                                else (if g#esys
      431                                                      then (chr(4) +  'ВС':U)
      432                                                      else g#userid)
      433                                                )
      434       buf_c-dis-grp-rule.corr-date          = v-date
      435       .
      436       CASE buf_c-dis-grp-rule.classif-type:
      437         when 'cli-grp':U then do:
      438           assign
      439           buf_c-dis-grp-rule.chip-num           = next-value (s-cli-grp-chip, ub)
      440           .
      441           create buf_c-cli-grp.
      442           buffer-copy buf_c-dis-grp-rule
      443           except obj-type obj-code
      444           to buf_c-cli-grp
      445           assign
      446           buf_c-cli-grp.action = (if new (ub.dis-grp-rule )
      447                                   then integer('1':U)
      448                                   else integer('2':U))
      449           buf_c-cli-grp.subject = 'dis-grp-rule':U
      450           buf_c-cli-grp.source-type = (if g#news
      451                                        then 'db':U
      452                                        else (if g#esys
      453                                              then 'esys':U
      454                                              else "":U)
      455                                       )
      456           buf_c-cli-grp.source-ref = (if g#news
      457                                        then string(g#news-source-db)
      458                                        else (if g#esys
      459                                              then string(g#esys-source-esys)
      460                                              else "":U)
      461                                        )
      462           .
      463         end.
      464         when 'gds-grp':U then do:
      465           assign
      466           buf_c-dis-grp-rule.chip-num           = next-value (s-gds-grp-chip, ub)
      467           .
      468           create buf_c-gds-grp-hist.
      469           buffer-copy buf_c-dis-grp-rule
      470           except obj-type obj-code
      471           to buf_c-gds-grp-hist
      472           assign
      473           buf_c-gds-grp-hist.action = (if new (ub.dis-grp-rule )
      474                                   then integer('1':U)
      475                                   else integer('2':U))
      476           buf_c-gds-grp-hist.subject = 'dis-grp-rule':U
      477           buf_c-gds-grp-hist.obj-type = ub.dis-grp-rule.obj-type
      478           buf_c-gds-grp-hist.obj-code = ub.dis-grp-rule.obj-code
      479           buf_c-gds-grp-hist.host-code = ub.dis-grp-rule.host-code
      480           buf_c-gds-grp-hist.is-news = g#news
      481           buf_c-gds-grp-hist.source-type = (if g#news
      482                                        then 'db':U
      483                                        else (if g#esys
      484                                              then 'esys':U
      485                                              else "":U)
      486                                       )
      487           buf_c-gds-grp-hist.source-ref = (if g#news
      488                                        then string(g#news-source-db)
      489                                        else (if g#esys
      490                                              then string(g#esys-source-esys)
      491                                              else "":U)
      492                                        )
      493           .
      494         end.
      495         when 'sum-grp':U then do:
      496           assign
      497           buf_c-dis-grp-rule.chip-num           = next-value (s-ref-corr-chip, ub)
      498           .
      499           create buf_c-sum-grp.
      500           buffer-copy buf_c-dis-grp-rule
      501           except obj-type obj-code
      502           to buf_c-sum-grp
      503           assign
      504           buf_c-sum-grp.grp-code    = ub.dis-grp-rule.node-code
      505           buf_c-sum-grp.action = (if new (ub.dis-grp-rule )
      506                                   then integer('1':U)
      507                                   else integer('2':U))
      508           buf_c-sum-grp.subject = 'sum-grp':U
      509           .
      510         end.
      511         when 'sum-grp-obj':U then do:
      512           assign
      513           buf_c-dis-grp-rule.chip-num           = next-value (s-ref-obj-corr-chip, ub)
      514           .
      515           create buf_c-sum-grp-obj.
      516           buffer-copy buf_c-dis-grp-rule
      517           except obj-type obj-code
      518           to buf_c-sum-grp-obj
      519           assign
      520           buf_c-sum-grp-obj.grp-code    = ub.dis-grp-rule.node-code
      521           buf_c-sum-grp-obj.obj-type = ub.dis-grp-rule.obj-type
      522           buf_c-sum-grp-obj.obj-code = ub.dis-grp-rule.obj-code
      523           buf_c-sum-grp-obj.action = (if new (ub.dis-grp-rule )
      524                                   then integer('1':U)
      525                                   else integer('2':U))
      526           buf_c-sum-grp-obj.subject = 'dis-grp-rule':U
      527           .
      528         end.
      529       end case.
      530     end.
      531     if g#oxml = yes
      532     then do:
      533       run str/calloxml.p (
      534             input 'update':U
      535           , input 'dis-grp-rule':U
      536           , input ( buffer ub.dis-grp-rule:handle )
      537       ) no-error.
      538       if error-status :error
      539       then do:
      540           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      541                                , chr(10)
      542                                , vss-workfile
      543                                , return-value
      544                                , error-status :get-message ( 1 ) ).
      545       end.
      546     end.
      547   end.
