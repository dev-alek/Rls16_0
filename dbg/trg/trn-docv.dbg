     3794                 then do:
     3795                   message
     3796                     vss-workfile vss-revision vss-description skip
     3797                     vss-include-info8 skip
     3798                     "Запрещено порождение партий," skip
     3799                     "который учитывается по двум единицам измерения" skip
     3800                     "Документ" p-doc-code skip
     3801                     "Объект" p-obj-type p-obj-code skip
     3802                     "Артикул" p-artic p-prod-type p-prod-code skip
     3803                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3804                     "Количество по документу" archive_parts.qnty skip
     3805                     "Фактическое количество" archive_parts.fact-qnty skip
     3806                     "Клиентское количество" archive_parts.cli-qnty skip
     3807                     view-as alert-box error .
     3808                   undo, return error .
     3809                 end.
     3810                 else do:
     3811                   if buf_parts.cli-base-rate <> 0
     3812                   then do:
     3813                     assign
     3814                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3815                     .
     3816                   end.
     3817                   else do:
     3818                     assign
     3819                       buf_parts.cli-qnty = 0
     3820                     .
     3821                   end.
     3822                 end.
     3823             end.
     3824           end.
     3825           get next partcopy-select-parts .
     3826         end.
     3827       end.
     3828     end.
     3829   end procedure.
     3830   procedure partcopy-update-parts-delete :
     3831     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     3832     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     3833     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     3834     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     3835     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     3836     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     3837     define variable objMarks as class excisemarks no-undo.
     3838     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
     3839     define buffer buf_trn-doc    for ub.trn-doc .
     3840     define buffer archive_parts  for ub.parts .
     3841     define buffer buf_parts      for ub.parts .
     3842     define buffer buf_parts-attr for ub.parts-attr .
