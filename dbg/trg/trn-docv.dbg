     3647                 then do:
     3648                   message
     3649                     vss-workfile vss-revision vss-description skip
     3650                     vss-include-info8 skip
     3651                     "Клиентское количество для товара," skip
     3652                     "который учитывается по двум единицам измерения" skip
     3653                     "должно равняться" v-qnty-sign skip
     3654                     "Документ" p-doc-code skip
     3655                     "Объект" p-obj-type p-obj-code skip
     3656                     "Артикул" p-artic p-prod-type p-prod-code skip
     3657                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3658                     "Количество по документу" archive_parts.qnty skip
     3659                     "Фактическое количество" archive_parts.fact-qnty skip
     3660                     "Клиентское количество" archive_parts.cli-qnty skip
     3661                     view-as alert-box error .
     3662                   undo, return error .
     3663                 end.
     3664                 if archive_parts.fact-qnty = archive_parts.qnty
     3665                 then do:
     3666                   assign
     3667                     buf_parts.cli-qnty = buf_parts.cli-qnty + abs(archive_parts.cli-qnty)
     3668                   .
     3669                 end.
     3670                 else do:
     3671                   message
     3672                     vss-workfile vss-revision vss-description skip
     3673                     vss-include-info8 skip
     3674                     "Фактическое количество для товара," skip
     3675                     "который учитывается по двум единицам измерения" skip
     3676                     "должно равняться нулю или количеству по документу" skip
     3677                     "Документ" p-doc-code skip
     3678                     "Объект" p-obj-type p-obj-code skip
     3679                     "Артикул" p-artic p-prod-type p-prod-code skip
     3680                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3681                     "Количество по документу" archive_parts.qnty skip
     3682                     "Фактическое количество" archive_parts.fact-qnty skip
     3683                     "Клиентское количество" archive_parts.cli-qnty skip
     3684                     view-as alert-box error .
     3685                   undo, return error .
     3686                 end.
     3687               end.
     3688               else do:
     3689                 if buf_parts.cli-base-rate <> 0
     3690                 then do:
     3691                   assign
     3692                     buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3693                   .
     3694                 end.
     3695                 else do:
     3696                   assign
     3697                     buf_parts.cli-qnty = 0
     3698                   .
     3699                 end.
     3700               end.
     3701               if  buf_parts.qnty      = 0
     3702               and buf_parts.fact-qnty = 0
     3703               then do:
     3704                 if v-goods-twounit = true
     3705                 then do:
     3706                   if buf_parts.cli-qnty <> 0
     3707                   then do:
     3708                     message
     3709                       vss-workfile vss-revision vss-description skip
     3710                       vss-include-info8 skip
     3711                       "Ошибка при удалении партии" skip
     3712                       "Документ" p-doc-code skip
     3713                       "Объект" p-obj-type p-obj-code skip
     3714                       "Артикул" p-artic p-prod-type p-prod-code skip
     3715                       "Партия" buf_parts.in-code buf_parts.part-code skip
     3716                       "Резерв" buf_parts.out-code skip
     3717                       "qnty" buf_parts.qnty skip
     3718                       "fact-qnty" buf_parts.fact-qnty skip
     3719                       "cli-qnty" buf_parts.cli-qnty skip
     3720                       view-as alert-box error .
     3721                     undo, return error .
     3722                   end.
     3723                 end.
     3724                 delete buf_parts .
     3725               end.
     3726             end.
     3727           end.
     3728           if  ( archive_parts.in-code = buf_trn-doc.doc-code
     3729           and archive_parts.supp-type =
     3730           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     3731           and archive_parts.supp-code =
     3732           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     3733           )
     3734           or buf_trn-doc.ext-doc-type = 'rv':U
     3735           then do:
