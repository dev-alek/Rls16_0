     3508                   .
     3509                 end.
     3510                 else do:
     3511                   assign
     3512                     buf_parts.cli-qnty = 0
     3513                   .
     3514                 end.
     3515               end.
     3516             end.
     3517             if  available buf_parts
     3518             and buf_parts.qnty      = 0
     3519             and buf_parts.fact-qnty = 0
     3520             then do:
     3521               if v-goods-twounit = true
     3522               then do:
     3523                 if buf_parts.cli-qnty <> 0
     3524                 then do:
     3525                   message
     3526                     vss-workfile vss-revision vss-description skip
     3527                     vss-include-info8 skip
     3528                     "Ошибка при удалении партии" skip
     3529                     "Документ" p-doc-code skip
     3530                     "Объект" p-obj-type p-obj-code skip
     3531                     "Артикул" p-artic p-prod-type p-prod-code skip
