     3458               .
     3459               if v-goods-twounit = true
     3460               then do:
     3461                 if archive_parts.cli-qnty <> 1
     3462                 then do:
     3463                   message
     3464                     vss-workfile vss-revision vss-description skip
     3465                     vss-include-info8 skip
     3466                     "Клиентское количество для товара," skip
     3467                     "который учитывается по двум единицам измерения" skip
     3468                     "должно равняться единице" skip
     3469                     "Документ" p-doc-code skip
     3470                     "Объект" p-obj-type p-obj-code skip
     3471                     "Артикул" p-artic p-prod-type p-prod-code skip
     3472                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3473                     "Количество по документу" archive_parts.qnty skip
     3474                     "Фактическое количество" archive_parts.fact-qnty skip
     3475                     "Клиентское количество" archive_parts.cli-qnty skip
     3476                     view-as alert-box error .
     3477                   undo, return error .
     3478                 end.
     3479                 if archive_parts.fact-qnty = 0
     3480                 then do:
     3481                   assign
     3482                     buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     3483                   .
     3484                 end.
     3485                 else do:
     3486                   message
     3487                     vss-workfile vss-revision vss-description skip
     3488                     vss-include-info8 skip
     3489                     "Фактическое количество для товара," skip
     3490                     "который учитывается по двум единицам измерения" skip
     3491                     "должно равняться нулю или количеству по документу" skip
     3492                     "Документ" p-doc-code skip
     3493                     "Объект" p-obj-type p-obj-code skip
     3494                     "Артикул" p-artic p-prod-type p-prod-code skip
     3495                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3496                     "Количество по документу" archive_parts.qnty skip
