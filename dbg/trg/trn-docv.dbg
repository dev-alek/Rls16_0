     3762                     vss-workfile vss-revision vss-description skip
     3763                     vss-include-info8 skip
     3764                     "Ошибка при создании партии" skip
     3765                     "Документ" p-doc-code skip
     3766                     "Объект" p-obj-type p-obj-code skip
     3767                     "Артикул" p-artic p-prod-type p-prod-code skip
     3768                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3769                     "Резерв" v-rsrv-code skip
     3770                     error-status :get-message(1) skip
     3771                     return-value skip
     3772                     view-as alert-box error .
     3773                   undo, return error .
     3774                 end.
     3775                 assign
     3776                   buf_parts.qnty      = buf_parts.qnty - abs(archive_parts.fact-qnty)
     3777                   buf_parts.fact-qnty = buf_parts.qnty
     3778                 .
     3779                 if buf_trn-doc.ext-doc-type = 'rv':U
     3780                 then
     3781                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     3782                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     3783                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     3784                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     3785                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     3786                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     3787                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     3788                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3789                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     3790                   then
     3791                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3792                 end .
