     3389                 "Артикул" p-artic p-prod-type p-prod-code skip
     3390                 error-status :get-message(1) skip
     3391                 return-value skip
     3392                 view-as alert-box error .
     3393               undo, return error .
     3394             end.
     3395             if buf_trn-doc.ext-doc-type = 'vt':U
     3396             or (buf_trn-doc.ext-doc-type = 're':U and v-is-hold = true)
     3397             or buf_trn-doc.ext-doc-type = 'ap':U
     3398             or buf_trn-doc.ext-doc-type = 'pc':U
     3399             or buf_trn-doc.ext-doc-type = 'mp':U
     3400             or  buf_trn-doc.ext-doc-type = 'vp':U
     3401             then do:
     3402               message
     3403                 vss-workfile vss-revision vss-description skip
     3404                 vss-include-info8 skip
     3405                 "Фактическое количество не может отличаться от количества по документу" skip
     3406                 "для документов инвентаризации, внутреннего возврата и автоматического возврата между фирмами" skip
     3407                 "Документ" p-doc-code skip
     3408                 "Объект" p-obj-type p-obj-code skip
     3409                 "Артикул" p-artic p-prod-type p-prod-code skip
     3410                 "Партия" archive_parts.in-code archive_parts.part-code skip
     3411                 "Количество по документу" archive_parts.qnty skip
     3412                 "Фактическое количество" archive_parts.fact-qnty skip
     3413                 "Клиентское количество" archive_parts.cli-qnty skip
     3414                 view-as alert-box error .
     3415               undo, return error .
     3416             end.
     3417             if archive_parts.in-code <> archive_parts.out-code
     3418             then do:
     3419               if can-do('рас,спи':U,buf_trn-doc.doc-type)
     3420               or (buf_trn-doc.doc-type = 'инв':U
     3421                   and archive_parts.fact-qnty < 0)
     3422               then do:
     3423                 assign
     3424                   v-rsrv-code = 'free-zone':U
     3425                 .
     3426               end.
     3427               else do:
     3428                 assign
     3429                   v-rsrv-code = 'out-zone':U
     3430                 .
     3431               end.
     3432               run partcopy in this-procedure
     3433                 (input  true
