     4272                     message objMarks:ReturnMsg view-as alert-box error.
     4273                     delete object objMarks no-error.
     4274                     undo, return error.
     4275                 end.
     4276               end.
     4277               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     4278                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     4279                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     4280                                                           and del_marking-lines.in-code = buf_parts.in-code
     4281                                                           and del_marking-lines.out-code = buf_parts.out-code
     4282                                                           and del_marking-lines.part-code = buf_parts.part-code
     4283                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     4284                 delete del_marking-lines .
     4285               end.
     4286               delete buf_parts .
     4287             end.
     4288           end.
     4289           delete object objMarks no-error.
     4290           if v-need-unrv = true
     4291           then do:
     4292             release buf_parts no-error .
     4293             if archive_parts.out-code <> v-unrv-code and v-unrv-sign = -1 and v-izlcstpr
     4294             then do:
     4295                 find first buf_parts exclusive-lock
     4296                   where buf_parts.obj-type  = archive_parts.obj-type
     4297                     and buf_parts.obj-code  = archive_parts.obj-code
     4298                     and buf_parts.artic     = archive_parts.artic
     4299                     and buf_parts.prod-type = archive_parts.prod-type
     4300                     and buf_parts.prod-code = archive_parts.prod-code
     4301                     and buf_parts.in-code   = archive_parts.out-code
     4302                     and buf_parts.out-code  = v-unrv-code
     4303                     and buf_parts.part-code = archive_parts.part-code
     4304                   no-error.
     4305             end .
     4306             if not available  buf_parts
     4307             then do :
     4308                 run partcopy in this-procedure
     4309                   (input  true
     4310                   ,input  v-unrv-code
     4311                   ,buffer archive_parts
     4312                   ,buffer buf_parts
     4313                   ,input  ""
     4314                   ) no-error .
     4315                 if error-status :error
     4316                 then do:
     4317                   message
     4318                     vss-workfile vss-revision vss-description skip
     4319                     vss-include-info8 skip
     4320                     "Ошибка при создании партии" skip
     4321                     "Документ" p-doc-code skip
     4322                     "Объект" p-obj-type p-obj-code skip
     4323                     "Артикул" p-artic p-prod-type p-prod-code skip
     4324                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4325                     "Необходимо резервировать" v-need-rsrv skip
     4326                     "Резерв" v-rsrv-code skip
     4327                     "Необходимо снятие резервов" v-need-unrv skip
     4328                     "Снятие резервов" v-unrv-code skip
     4329                     error-status :get-message(1) skip
     4330                     return-value skip
     4331                     view-as alert-box error .
     4332                   undo, return error .
     4333                 end.
     4334             end.
     4335             if new(buf_parts)
     4336             then do:
     4337   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4339     (input  p-artic
     4340     ,input  p-prod-type
     4341     ,input  p-prod-code
     4342     ,output v-gds-code
     4343     ) no-error .
     4344               if error-status :error
     4345               then do:
     4346                 message
     4347                   vss-workfile vss-revision vss-description skip
     4348                   vss-include-info8 skip
     4349                   "Ошибка при определении кода товара" skip
     4350                   "Документ" p-doc-code skip
     4351                   "Объект" p-obj-type p-obj-code skip
     4352                   "Артикул" p-artic p-prod-type p-prod-code skip
     4353                   "Партия" archive_parts.in-code archive_parts.part-code skip
     4354                   "Необходимо резервировать" v-need-rsrv skip
     4355                   "Резерв" v-rsrv-code skip
     4356                   "Необходимо снятие резервов" v-need-unrv skip
     4357                   "Снятие резервов" v-unrv-code skip
     4358                   error-status :get-message(1) skip
     4359                   return-value skip
     4360                   view-as alert-box error .
     4361                 undo, return error .
     4362               end.
     4363               find first buf_parts-attr no-lock
     4364                 where buf_parts-attr.in-code   = buf_parts.in-code
     4365                   and buf_parts-attr.gds-code  = v-gds-code
     4366                   and buf_parts-attr.part-code = buf_parts.part-code
     4367                 no-error .
     4368               if not available buf_parts-attr
     4369               then do:
     4370                 message
     4371                   vss-workfile vss-revision vss-description skip
     4372                   vss-include-info8 skip
     4373                   "Не найден атрибут партии" skip
     4374                   "Документ" p-doc-code skip
     4375                   "Объект" p-obj-type p-obj-code skip
     4376                   "Артикул" p-artic p-prod-type p-prod-code skip
     4377                   "Код товара" v-gds-code skip
     4378                   "Партия" archive_parts.in-code archive_parts.part-code skip
     4379                   "Необходимо резервировать" v-need-rsrv skip
     4380                   "Резерв" v-rsrv-code skip
     4381                   "Необходимо снятие резервов" v-need-unrv skip
     4382                   "Снятие резервов" v-unrv-code skip
     4383                   error-status :get-message(1) skip
     4384                   return-value skip
     4385                   view-as alert-box error .
     4386                 undo, return error .
     4387               end.
     4388               run factord-to-fact-num in this-procedure
     4389                 (input  buf_parts-attr.fact-order
     4390                 ,output v-fact-num
     4391                 ) no-error .
     4392               if error-status :error
     4393               then do:
     4394                 message
     4395                   vss-workfile vss-revision vss-description skip
     4396                   vss-include-info8 skip
     4397                   "Ошибка при определении порядкового номера партии" skip
     4398                   "Документ" p-doc-code skip
     4399                   "Объект" p-obj-type p-obj-code skip
     4400                   "Артикул" p-artic p-prod-type p-prod-code skip
     4401                   "Код товара" v-gds-code skip
     4402                   "Партия" archive_parts.in-code archive_parts.part-code skip
     4403                   "Необходимо резервировать" v-need-rsrv skip
     4404                   "Резерв" v-rsrv-code skip
     4405                   "Необходимо снятие резервов" v-need-unrv skip
     4406                   "Снятие резервов" v-unrv-code skip
     4407                   error-status :get-message(1) skip
     4408                   return-value skip
     4409                   view-as alert-box error .
     4410                 undo, return error .
     4411               end.
     4412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run trnextdt in g#library
     4413     (input  buf_parts-attr.ext-doc-type
     4414     ,output v-doc-type
     4415     ) no-error .
     4416               if error-status :error
     4417               then do:
     4418                 message
     4419                   vss-workfile vss-revision vss-description skip
     4420                   vss-include-info8 skip
     4421                   "Ошибка при определении типа документа" skip
     4422                   "Документ" p-doc-code skip
     4423                   "Объект" p-obj-type p-obj-code skip
     4424                   "Артикул" p-artic p-prod-type p-prod-code skip
     4425                   "Код товара" v-gds-code skip
     4426                   "Партия" archive_parts.in-code archive_parts.part-code skip
     4427                   "Необходимо резервировать" v-need-rsrv skip
     4428                   "Резерв" v-rsrv-code skip
     4429                   "Необходимо снятие резервов" v-need-unrv skip
     4430                   "Снятие резервов" v-unrv-code skip
     4431                   error-status :get-message(1) skip
     4432                   return-value skip
     4433                   view-as alert-box error .
     4434                 undo, return error .
     4435               end.
     4436               assign
     4437                 buf_parts.fact-date = buf_parts-attr.fact-date
     4438                 buf_parts.fact-num  = v-fact-num
     4439                 buf_parts.doc-type  = v-doc-type
     4440               .
     4441             end.
     4442             assign
     4443               buf_parts.qnty      = buf_parts.qnty  + v-unrv-sign * archive_parts.fact-qnty
     4444               buf_parts.fact-qnty = buf_parts.qnty
     4445             .
     4446   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4447   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4448     (input  buf_parts.artic
     4449     ,input  buf_parts.prod-type
     4450     ,input  buf_parts.prod-code
     4451     ,output v-gds-code
     4452     ) no-error .
     4453             if buf_parts.out-code = 'free-zone':U
     4454             then
     4455             for each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = v-gds-code
     4456                                                         and buf_marking-lines.obj-type = archive_parts.obj-type
     4457                                                         and buf_marking-lines.obj-code = archive_parts.obj-code
     4458                                                         and buf_marking-lines.in-code  = archive_parts.in-code
     4459                                                         and buf_marking-lines.out-code = archive_parts.out-code
     4460                                                         and buf_marking-lines.part-code = archive_parts.part-code
     4461                                                         and buf_marking-lines.prt-code = archive_parts.prt-code:
     4462               for first buf_marking exclusive-lock where buf_marking.mark = buf_marking-lines.mark :
     4463                 find first free_marking-lines no-lock where free_marking-lines.mark       = buf_marking-lines.mark
     4464                                                         and free_marking-lines.gds-code   = buf_marking-lines.gds-code
     4465                                                         and free_marking-lines.obj-type   = buf_parts.obj-type
     4466                                                         and free_marking-lines.obj-code   = buf_parts.obj-code
     4467                                                         and free_marking-lines.in-code    = buf_parts.in-code
     4468                                                         and free_marking-lines.out-code   = buf_parts.out-code
     4469                                                         and free_marking-lines.part-code  = buf_parts.part-code
     4470                                                         and free_marking-lines.prt-code   = buf_parts.prt-code
     4471                                                         no-error .
     4472                 if not available free_marking-lines
     4473                 then do :
     4474                   create free_marking-lines .
     4475                   assign
     4476                     free_marking-lines.mark       = buf_marking-lines.mark
     4477                     free_marking-lines.doc-level  = buf_marking-lines.doc-level
     4478                     free_marking-lines.gds-code   = buf_marking-lines.gds-code
     4479                     free_marking-lines.obj-type   = buf_parts.obj-type
     4480                     free_marking-lines.obj-code   = buf_parts.obj-code
     4481                     free_marking-lines.in-code    = buf_parts.in-code
     4482                     free_marking-lines.out-code   = buf_parts.out-code
     4483                     free_marking-lines.part-code  = buf_parts.part-code
     4484                     free_marking-lines.prt-code   = buf_parts.prt-code
     4485                   .
     4486                 end .
     4487                 if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_trn-doc.doc-type <> 'спи':U and
     4488                    not (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U)
     4489                   then assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4490                 if buf_trn-doc.ext-doc-type = 'es':U
     4491                 then do :
     4492                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB .
     4493                 end .
     4494                 for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     4495                   assign buf_marking-chk.sts = 0 .
     4496                 end .
     4497               end .
     4498               delete buf_marking-lines .
     4499             end.
     4500             if v-goods-twounit = true
     4501             then do:
     4502               assign
     4503                 buf_parts.cli-qnty = buf_parts.cli-qnty + v-unrv-sign * archive_parts.cli-qnty
     4504               .
     4505             end.
     4506             else do:
     4507               if buf_parts.cli-base-rate <> 0
     4508               then do:
     4509                 assign
     4510                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     4511                 .
     4512               end.
     4513               else do:
     4514                 assign
     4515                   buf_parts.cli-qnty = 0
     4516                 .
     4517               end.
     4518             end.
     4519             if  buf_parts.qnty      = 0
     4520             and buf_parts.fact-qnty = 0
     4521             then do:
     4522               if v-goods-twounit = true
     4523               then do:
     4524                 if buf_parts.cli-qnty <> 0
     4525                 then do:
     4526                   message
     4527                     vss-workfile vss-revision vss-description skip
     4528                     vss-include-info8 skip
     4529                     "Ошибка при удалении партии" skip
     4530                     "Документ" p-doc-code skip
     4531                     "Объект" p-obj-type p-obj-code skip
     4532                     "Артикул" p-artic p-prod-type p-prod-code skip
     4533                     "Партия" buf_parts.in-code buf_parts.part-code skip
     4534                     "Резерв" buf_parts.out-code skip
     4535                     "qnty" buf_parts.qnty skip
     4536                     "fact-qnty" buf_parts.fact-qnty skip
     4537                     "cli-qnty" buf_parts.cli-qnty skip
     4538                     view-as alert-box error .
     4539                   undo, return error .
     4540                 end.
     4541               end.
     4542               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     4543                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     4544                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     4545                                                           and del_marking-lines.in-code = buf_parts.in-code
     4546                                                           and del_marking-lines.out-code = buf_parts.out-code
     4547                                                           and del_marking-lines.part-code = buf_parts.part-code
     4548                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     4549                 delete del_marking-lines .
     4550               end.
     4551               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     4552                                           ,input (buffer buf_parts:handle)
     4553                                           ,output part-key-rec).
     4554               for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     4555                                        and ub.gen-attr.p-key =  part-key-rec
     4556               :
     4557                 find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     4558                 find current buf1_gen-attr exclusive-lock.
     4559                 delete buf1_gen-attr .
     4560               end.
     4561               delete buf_parts .
     4562             end.
     4563           end.
     4564         end.
     4565       end.
     4566     end.
     4567   end procedure.
     4568   procedure partcopy-rsrv-parts :
     4569     define input  parameter p-doc-code-rowid as rowid no-undo .
     4570     define input  parameter p-parts-rowid    as rowid no-undo .
     4571     define input  parameter p-rsrv-direction as logical   no-undo .
     4572     define input  parameter p-goods-twounit  as logical   no-undo .
     4573     define input  parameter p-is-hold        as logical   no-undo .
     4574     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     4575     define buffer buf_trn-doc for ub.trn-doc .
     4576     define buffer archive_parts for ub.parts .
     4577     define buffer buf_parts   for ub.parts .
     4578     define buffer orig_marking-lines for ub.marking-lines .
     4579     define buffer buf_marking-lines for ub.marking-lines .
     4580     define buffer buf_marking   for ub.marking .
     4581     define buffer buf_goods for ub.goods .
     4582     define variable v-rsrv-code as character no-undo .
     4583     do
     4584     on error undo, return error return-value
     4585     :
     4586       find first buf_trn-doc no-lock
     4587         where rowid(buf_trn-doc) = p-doc-code-rowid
     4588         no-error .
     4589       if not available buf_trn-doc
     4590       then do:
     4591         message
     4592           vss-workfile vss-revision vss-description skip
     4593           vss-include-info8 skip
     4594           "Ошибка задания входных параметров" skip
     4595           "Не найден документ" skip
     4596           "Документ" string(p-doc-code-rowid) skip
     4597           "Партия" string(p-parts-rowid) skip
     4598           error-status :get-message(1) skip
     4599           return-value skip
     4600           view-as alert-box error .
     4601         undo, return error .
     4602       end.
     4603       find first archive_parts
     4604         where rowid(archive_parts) = p-parts-rowid
     4605         no-error .
     4606       if not available archive_parts
     4607       then do:
     4608         message
     4609           vss-workfile vss-revision vss-description skip
     4610           vss-include-info8 skip
     4611           "Ошибка задания входных параметров" skip
     4612           "Не найдена партия" skip
     4613           "Документ" string(p-doc-code-rowid) skip
     4614           "Партия" string(p-parts-rowid) skip
     4615           error-status :get-message(1) skip
     4616           return-value skip
     4617           view-as alert-box error .
     4618         undo, return error .
     4619       end.
     4620       if  archive_parts.out-code <> archive_parts.in-code
     4621       and archive_parts.qnty <> 0
     4622       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     4623       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     4624       then do:
     4625         assign
     4626           v-rsrv-code =
     4627           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     4628         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     4629         then 'free-zone':U
     4630         else 'out-zone':U )
     4631         .
     4632         run partcopy in this-procedure
     4633           (input  true
     4634           ,input  v-rsrv-code
     4635           ,buffer archive_parts
     4636           ,buffer buf_parts
     4637           ,input  "news"
     4638           ) no-error .
     4639         if error-status :error
     4640         then do:
     4641           message
     4642             vss-workfile vss-revision vss-description skip
     4643             vss-include-info8 skip
     4644             "Ошибка при создании партии" skip
     4645             "Документ" buf_trn-doc.doc-code skip
     4646             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     4647             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     4648             "Партия" archive_parts.in-code archive_parts.part-code skip
     4649             "Количество" archive_parts.qnty skip
     4650             "Резерв" v-rsrv-code skip
     4651             error-status :get-message(1) skip
     4652             return-value skip
     4653             view-as alert-box error .
     4654           undo, return error .
     4655         end.
     4656         assign
     4657           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     4658                                                     * (if p-rsrv-direction = true
     4659                                                       then 1
     4660                                                       else -1
     4661                                                       )
     4662           buf_parts.fact-qnty = buf_parts.qnty
     4663         .
     4664         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     4665                                        and buf_goods.prod-type = archive_parts.prod-type
     4666                                        and buf_goods.prod-code = archive_parts.prod-code
     4667                                        .
     4668         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4669                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     4670                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     4671                                               and orig_marking-lines.in-code    = archive_parts.in-code
     4672                                               and orig_marking-lines.out-code   = archive_parts.out-code
     4673                                               and orig_marking-lines.part-code  = archive_parts.part-code
     4674                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     4675                                               :
     4676           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     4677                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     4678                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     4679                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     4680                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     4681                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     4682                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     4683                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     4684                                                   no-error .
     4685           if available buf_marking-lines
     4686           then do :
     4687             find current buf_marking-lines exclusive-lock .
     4688             delete buf_marking-lines .
     4689             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4690               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     4691             end .
     4692           end .
     4693           else do :
     4694             create buf_marking-lines .
     4695             assign
     4696               buf_marking-lines.mark       = orig_marking-lines.mark
     4697               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4698               buf_marking-lines.gds-code   = buf_goods.gds-code
     4699               buf_marking-lines.obj-type   = buf_parts.obj-type
     4700               buf_marking-lines.obj-code   = buf_parts.obj-code
     4701               buf_marking-lines.in-code    = buf_parts.in-code
     4702               buf_marking-lines.out-code   = buf_parts.out-code
     4703               buf_marking-lines.part-code  = buf_parts.part-code
     4704               buf_marking-lines.prt-code   = buf_parts.prt-code
     4705             .
     4706             if buf_parts.out-code <> buf_parts.in-code
     4707             and buf_parts.out-code <> 'free-zone':U
     4708             and buf_parts.out-code <> 'out-zone':U
     4709             then do :
     4710               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     4711               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     4712             end .
     4713             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4714               assign
     4715                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     4716                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     4717               .
     4718             end .
     4719           end .
     4720           release buf_marking-lines no-error .
     4721         end.
     4722         if p-goods-twounit = true
     4723         then do:
     4724           assign
     4725             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     4726                                                     * (if p-rsrv-direction = true
     4727                                                       then 1
     4728                                                       else -1
     4729                                                       )
     4730           .
     4731         end.
     4732         if  buf_parts.qnty      = 0
     4733         and buf_parts.fact-qnty = 0
     4734         then do:
     4735           if p-goods-twounit = true
     4736           then do:
     4737             if buf_parts.cli-qnty <> 0
     4738             then do:
     4739               message
     4740                 vss-workfile vss-revision vss-description skip
     4741                 vss-include-info8 skip
     4742                 "Ошибка при удалении партии" skip
     4743                 "Документ" buf_trn-doc.doc-code skip
     4744                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     4745                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4746                 "Партия" buf_parts.in-code buf_parts.part-code skip
     4747                 "Резерв" buf_parts.out-code skip
     4748                 "qnty" buf_parts.qnty skip
     4749                 "fact-qnty" buf_parts.fact-qnty skip
     4750                 "cli-qnty" buf_parts.cli-qnty skip
     4751                 view-as alert-box error .
     4752               undo, return error .
     4753             end.
     4754           end.
     4755           delete buf_parts .
     4756         end.
     4757       end.
     4758     end.
     4759   end procedure.
     4760   procedure partcopy-update-doc-line-tot-fact :
     4761     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4762     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4763     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4764     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4765     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     4766       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     4767     define buffer buf_doc-line for ub.doc-line .
     4768     do
     4769     on error undo, return error return-value
     4770     :
     4771       find first buf_doc-line exclusive-lock
     4772         where buf_doc-line.doc-code  = p-doc-code
     4773           and buf_doc-line.artic     = p-artic
     4774           and buf_doc-line.prod-type = p-prod-type
     4775           and buf_doc-line.prod-code = p-prod-code
     4776         no-error .
     4777       if error-status :error
     4778       then do:
     4779         message
     4780           vss-workfile vss-revision vss-description skip
     4781           vss-include-info8 skip
     4782           "Ошибка задания входных параметров" skip
     4783           "Не найдена строка документа" skip
     4784           "Документ" p-doc-code skip
     4785           "Артикул" p-artic p-prod-type p-prod-code skip
     4786           error-status :get-message(1) skip
     4787           return-value skip
     4788           view-as alert-box error .
     4789         undo, return error .
     4790       end.
     4791       run partrqst in this-procedure
     4792         (input buf_doc-line.doc-code
     4793         ,input buf_doc-line.obj-type
     4794         ,input buf_doc-line.obj-code
     4795         ,input buf_doc-line.artic
     4796         ,input buf_doc-line.prod-type
     4797         ,input buf_doc-line.prod-code
     4798               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     4799         ) no-error .
     4800       if error-status :error
     4801       then do:
     4802         message
     4803           vss-workfile vss-revision vss-description skip
     4804           vss-include-info8 skip
     4805           "Ошибка при сборе информации по партиям" skip
     4806           "Документ" p-doc-code skip
     4807           "Артикул" p-artic p-prod-type p-prod-code skip
     4808           view-as alert-box error .
     4809         undo, return error .
     4810       end.
     4811       if v-total-parts-fact-qnty <> 0
     4812       then do:
     4813         assign
     4814           buf_doc-line.price-base      = v-total-parts-price-base
     4815                                        / v-total-parts-fact-qnty
     4816           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     4817                                        / v-total-parts-fact-qnty
     4818           buf_doc-line.transport-base  = v-total-parts-transport-base
     4819                                        / v-total-parts-fact-qnty
     4820           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     4821                                        / v-total-parts-fact-qnty
     4822           buf_doc-line.other-base      = v-total-parts-other-base
     4823                                        / v-total-parts-fact-qnty
     4824           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     4825                                        / v-total-parts-fact-qnty
     4826         .
     4827       end.
     4828       else do:
     4829       end.
     4830     end.
     4831   end procedure.
     4832   procedure partcopy-change-purch-code :
     4833     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     4834     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     4835     define parameter buffer buf_orig_parts     for ub.parts .
     4836     define parameter buffer buf1_parts         for ub.parts .
     4837     define parameter buffer buf2_parts         for ub.parts .
     4838     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     4839     define variable var-out-code  like ub.parts.out-code no-undo .
     4840     define variable var-part-code like ub.parts.part-code no-undo .
     4841     define buffer buf_goods        for ub.goods .
     4842     define buffer buf_parts-root   for ub.parts-root.
     4843     define buffer buf_trn-doc      for ub.trn-doc.
     4844     define buffer buf-orig_trn-doc for ub.trn-doc.
     4845     define buffer buf_units        for ub.units .
     4846     do
     4847     on error undo, return error return-value
     4848     :
     4849       if buf_orig_parts.out-code = p-in-code
     4850       then do:
     4851         message
     4852           vss-workfile vss-revision vss-description skip
     4853           vss-include-info8 skip
     4854           "Ошибка задания входных параметров процедуры partcopy" skip
     4855           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     4856           "p-in-code" p-in-code skip
     4857           view-as alert-box error .
     4858         undo, return error .
     4859       end.
     4860       find first buf_trn-doc no-lock
     4861         where buf_trn-doc.doc-code = p-in-code
     4862         .
     4863       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     4864       find first buf_goods no-lock
     4865         where buf_goods.artic = buf_orig_parts.artic
     4866           and buf_goods.prod-type = buf_orig_parts.prod-type
     4867           and buf_goods.prod-code = buf_orig_parts.prod-code
     4868         .
     4869       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     4870       find first buf1_parts exclusive-lock
     4871         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     4872           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     4873           and buf1_parts.artic     = buf_orig_parts.artic
     4874           and buf1_parts.prod-type = buf_orig_parts.prod-type
     4875           and buf1_parts.prod-code = buf_orig_parts.prod-code
     4876           and buf1_parts.in-code   = buf_orig_parts.in-code
     4877           and buf1_parts.out-code  = p-in-code
     4878           and buf1_parts.part-code = buf_orig_parts.part-code
     4879         no-error.
     4880       if not available buf1_parts
     4881       then do:
     4882         create buf1_parts .
     4883         buffer-copy buf_orig_parts to buf1_parts
     4884         assign
     4885           buf1_parts.in-code    = buf_orig_parts.in-code
     4886           buf1_parts.out-code   = p-in-code
     4887           buf1_parts.status_    = no
     4888           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     4889           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     4890           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     4891           buf1_parts.purch-code = buf_orig_parts.purch-code
     4892           buf1_parts.rsrv-free  = ?
     4893           buf1_parts.status_    = yes
     4894         .
     4895         validate buf1_parts .
     4896       end.
     4897       if  lookup('сер':U, buf_units.type) > 0
     4898       then do:
     4899          var-part-code = buf_orig_parts.part-code.
     4900       end.
     4901       else do:
     4902           run holdprts-get-part-code in this-procedure
     4903             (input  p-in-code
     4904             ,output var-part-code
     4905             ) no-error .
     4906           if error-status :error
     4907           then dO:
     4908             undo, return error return-value.
     4909           end.
     4910       end.
     4911       find first buf2_parts exclusive-lock
     4912         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     4913           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     4914           and buf2_parts.artic     = buf_orig_parts.artic
     4915           and buf2_parts.prod-type = buf_orig_parts.prod-type
     4916           and buf2_parts.prod-code = buf_orig_parts.prod-code
     4917           and buf2_parts.in-code   = p-in-code
     4918           and buf2_parts.out-code  = p-in-code
     4919           and buf2_parts.part-code = var-part-code
     4920         no-error.
     4921       if not available buf2_parts
     4922       then do:
     4923         create buf2_parts .
     4924         buffer-copy buf_orig_parts to buf2_parts
     4925         assign
     4926           buf2_parts.in-code   = p-in-code
     4927           buf2_parts.out-code  = p-in-code
     4928           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     4929           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     4930           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     4931           buf2_parts.purch-code = p-dest-purch-code
     4932           buf2_parts.part-code  = var-part-code
     4933           buf2_parts.rsrv-free  = ?
     4934           buf2_parts.status_    = yes
     4935         .
     4936         validate buf2_parts .
     4937       end.
     4938       assign
     4939         buf_orig_parts.in-code    = p-in-code
     4940         buf_orig_parts.part-code  = buf2_parts.part-code
     4941         buf_orig_parts.purch-code = buf2_parts.purch-code
     4942       .
     4943       find first buf_parts-root
     4944         where buf_parts-root.doc-code       = p-in-code
     4945           and buf_parts-root.in-code        = p-in-code
     4946           and buf_parts-root.gds-code       = buf_goods.gds-code
     4947           and buf_parts-root.part-code      = buf2_parts.part-code
     4948           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     4949           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     4950           and buf_parts-root.orig-part-code = buf1_parts.part-code
     4951         no-error .
     4952       if not available buf_parts-root
     4953       then do:
     4954         create buf_parts-root.
     4955         assign
     4956         buf_parts-root.doc-code       = p-in-code
     4957         buf_parts-root.in-code        = p-in-code
     4958         buf_parts-root.gds-code       = buf_goods.gds-code
     4959         buf_parts-root.part-code      = buf2_parts.part-code
     4960         buf_parts-root.orig-in-code   = buf1_parts.in-code
     4961         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     4962         buf_parts-root.orig-part-code = buf1_parts.part-code
     4963         .
     4964       end.
     4965     end.
     4966   end procedure.
     4967   procedure addChildMarkingLines:
     4968     define input parameter iMark as character no-undo.
     4969     define input parameter iSts  as integer   no-undo.
     4970     define parameter buffer buf_marking-lines  for ub.marking-lines.
     4971     define parameter buffer buf_parts          for ub.parts.
     4972     define parameter buffer orig_marking-lines for ub.marking-lines.
     4973     define parameter buffer buf_orig_parts     for ub.parts.
     4974     define parameter buffer buf_goods          for ub.goods.
     4975     define buffer buf_marking-childs        for ub.marking.
     4976     define buffer buf_marking-lines-childs  for ub.marking-lines.
     4977     define buffer buf_marking-chk           for ub.marking-chk.
     4978     define buffer buf_chk-doc               for ub.chk-doc.
     4979     define buffer orig_marking-lines-childs for ub.marking-lines.
     4980     for each buf_marking-childs exclusive-lock where
     4981              buf_marking-childs.mark-parent = iMark :
     4982         find first buf_marking-lines-childs no-lock where
     4983                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     4984                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     4985                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     4986                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     4987                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     4988                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     4989                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     4990                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     4991         no-error .
     4992         if not available buf_marking-lines-childs then
     4993         do:
     4994           create buf_marking-lines-childs .
     4995           assign
     4996             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     4997             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     4998             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     4999             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     5000             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     5001             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     5002             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     5003             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     5004             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     5005             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     5006           .
     5007           validate buf_marking-childs.
     5008         end .
     5009         buf_marking-childs.sts = iSts .
     5010         for each buf_marking-chk exclusive-lock where
     5011                  buf_marking-chk.mark begins buf_marking-childs.mark
     5012         :
     5013           for first buf_chk-doc no-lock where
     5014                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     5015                 and buf_chk-doc.out-code = buf_parts.out-code
     5016           :
     5017             buf_marking-chk.sts = 0 .
     5018             validate buf_marking-chk.
     5019           end .
     5020         end .
     5021         if available orig_marking-lines
     5022         then do :
     5023           find first orig_marking-lines-childs exclusive-lock where
     5024                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     5025                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     5026                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     5027                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     5028                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     5029                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     5030                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     5031                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     5032           no-error .
     5033           if available orig_marking-lines-childs then
     5034             delete orig_marking-lines-childs .
     5035         end.
     5036         run addChildMarkingLines in this-procedure (
     5037           buf_marking-childs.mark,
     5038           iSts,
     5039           buffer buf_marking-lines,
     5040           buffer buf_parts,
     5041           buffer orig_marking-lines,
     5042           buffer buf_orig_parts,
     5043           buffer buf_goods
     5044         ).
     5045     end .
     5046   end.
     5047   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5048   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5049   define new global shared variable g#trdcalib as handle no-undo.
     5050   function stsMarkWhenDeleteGoods returns integer
     5051       (input iDocCode as character,
     5052        input iMark as character):
     5053     define variable vValue as character no-undo.
     5054     define variable vType as character no-undo.
     5055     define buffer buf_trn-doc for ub.trn-doc.
     5056     define buffer buf_c-marking for ub.c-marking.
     5057     if iDocCode <> ? then
     5058     do:
     5059         find first buf_trn-doc no-lock where
     5060                    buf_trn-doc.doc-code = iDocCode no-error.
     5061         if avail buf_trn-doc then
     5062         do:
     5063   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     5064                           input 'is-return':U ,
     5065                          output vValue ,
     5066                          output vType ) no-error .
     5067            if buf_trn-doc.ext-doc-type = 'we':U or
     5068               buf_trn-doc.ext-doc-type = 'ev':U or
     5069               vValue = "yes" then
     5070            do:
     5071              find last buf_c-marking no-lock where
     5072                        buf_c-marking.mark = iMark
     5073                   use-index pi-2 no-error.
     5074              if avail buf_c-marking and
     5075                      (buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB or
     5076                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB or
     5077                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB or
     5078                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:Moved:KeyIntDB or
     5079                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB) then
     5080                return buf_c-marking.sts .
     5081            end.
     5082         end.
     5083     end.
     5084     return objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5085   end function.
     5086   procedure partrsrv :
     5087     define input parameter  p-chg-qnty      as decimal   no-undo .
     5088     define input parameter  p-goods-serial  as logical   no-undo .
     5089     define input parameter  p-goods-twounit as logical   no-undo .
     5090     define input parameter  p-unreserv-only as logical   no-undo .
     5091     define parameter buffer buf_orig_parts  for ub.parts .
     5092     define parameter buffer buf_trn-doc     for ub.trn-doc .
     5093     define output parameter p-real-chg-qnty as decimal   no-undo .
     5094     define output parameter p-parts-recid   as recid     no-undo .
     5095     define input  parameter p-mark          as character  no-undo .
     5096     define variable vss-description as character no-undo init "$Workfile$ Резервирование и снятие резервов по одной партии".
     5097     define buffer buf_parts  for ub.parts .
     5098     define buffer rsrv-parts for ub.parts .
     5099     define buffer unrsrv-parts for ub.parts .
     5100     define buffer buf_parts-attr for ub.parts-attr .
     5101     define buffer free_marking-lines for ub.marking-lines .
     5102     define variable lok                as logical   no-undo .
     5103     define variable v-sign-chg-qnty    as integer   no-undo .
     5104     define variable v-sign-rsrv-qnty   as integer   no-undo .
     5105     define variable v-rsrv-qnty        as decimal   no-undo .
     5106     define variable v-orig-unrsrv-code as character no-undo .
     5107     define variable v-new-rsrv-code    as character no-undo .
     5108     define variable v-new-unrsrv-code  as character no-undo .
     5109     define variable v-unrsrv-qnty      as decimal   no-undo .
     5110     define variable v-value-character as character no-undo .
     5111     define variable v-value-date      as date no-undo .
     5112     define variable v-value-decimal   as decimal no-undo .
     5113     define variable v-value-integer   as integer no-undo .
     5114     define variable v-izlcstpr        as logical no-undo .
     5115     define variable v-tth             as handle no-undo .
     5116     define variable v-type            as character no-undo .
     5117     define variable part-key-rec      as character no-undo .
     5118     define variable v-part-code-int   as integer no-undo .
     5119     define variable v-old-part-code   as character no-undo .
     5120     define variable v-part-gds-code   as integer   no-undo .
     5121     do transaction
     5122     on error undo, return error
     5123     :
     5124       if buf_trn-doc.ext-doc-type = 'vt':U
     5125       then do :
     5126           delete object v-tth no-error.
     5127           run adm/shattri.p (
     5128              input "get":U
     5129             ,input buf_orig_parts.obj-type
     5130             ,input buf_orig_parts.obj-code
     5131             ,input 'inv-obj':U
     5132             ,input  "izlcstpr"
     5133             ,output v-value-character
     5134             ,output v-value-date
     5135             ,output v-value-decimal
     5136             ,output v-value-integer
     5137             ,output v-izlcstpr
     5138             ,output v-type
     5139             ,INPUT-OUTPUT table-handle v-tth
     5140             ) no-error .
     5141             delete object v-tth no-error.
     5142           if error-status:error then do:
     5143             v-izlcstpr = false .
     5144           end.
     5145       end.
     5146       else do :
     5147           v-izlcstpr = false .
     5148       end.
     5149       assign
     5150         p-parts-recid = ?
     5151       .
     5152       if p-chg-qnty = 0 then do:
     5153         assign
     5154           p-parts-recid = recid(buf_orig_parts)
     5155         .
     5156         return .
     5157       end.
     5158       assign
     5159         v-sign-chg-qnty = 0
     5160       .
     5161       if p-chg-qnty < 0 then do:
     5162         assign
     5163           v-sign-chg-qnty = -1
     5164         .
     5165       end.
     5166       if p-chg-qnty > 0 then do:
     5167         assign
     5168           v-sign-chg-qnty = 1
     5169         .
     5170       end.
     5171       assign
     5172         v-sign-rsrv-qnty = v-sign-chg-qnty
     5173       .
     5174       if lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 then do:
     5175         assign
     5176           v-sign-rsrv-qnty = - v-sign-chg-qnty
     5177         .
     5178       end.
     5179       run partcopy in this-procedure
     5180         (input  false
     5181         ,input  buf_trn-doc.doc-code
     5182         ,buffer buf_orig_parts
     5183         ,buffer buf_parts
     5184         ,input  p-mark
     5185         ) no-error .
     5186       if error-status :error then do:
     5187         message
     5188           vss-workfile vss-revision vss-description skip
     5189           "Ошибка при создании партии" skip
     5190           "Объект" buf_orig_parts.obj-type buf_orig_parts.obj-code skip
     5191           "Артикул" buf_orig_parts.artic buf_orig_parts.prod-type buf_orig_parts.prod-code skip
     5192           "Партия" buf_orig_parts.in-code buf_orig_parts.part-code skip
     5193           "Резерв" buf_trn-doc.doc-code skip
     5194           error-status :get-message(1) skip
     5195           return-value skip
     5196           view-as alert-box error .
     5197         undo, return error .
     5198       end.
     5199       if buf_parts.in-code = buf_parts.out-code then do:
     5200         assign
     5201           v-rsrv-qnty = abs(p-chg-qnty)
     5202         .
     5203         if buf_trn-doc.doc-type <> 'инв':U then do:
     5204           if buf_parts.qnty < 0
     5205           or buf_parts.fact-qnty < 0 then do:
     5206             message
     5207               vss-workfile vss-revision vss-description skip
     5208               "Резервирование невозможно" skip
     5209               "Партия зарезервированная за обычным документом имеет отрицательное количество" skip
     5210               view-as alert-box error .
     5211             undo, return error .
     5212           end.
     5213           if v-sign-rsrv-qnty < 0 then do:
     5214             assign
     5215               v-rsrv-qnty = min(abs(buf_parts.qnty), v-rsrv-qnty)
     5216             .
     5217           end.
     5218         end.
     5219         assign
     5220           buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     5221           buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     5222         .
     5223         if p-goods-twounit = true
     5224         then do:
     5225           if buf_parts.qnty < 0 then do:
     5226             message
     5227               "Порожденная партия ювелирных изделий не может иметь отрицательное количество" skip
     5228               "Количество" buf_parts.qnty skip
     5229               view-as alert-box error .
     5230             undo, return error .
     5231           end.
     5232           if buf_parts.qnty = 0 then do:
     5233             assign
     5234               buf_parts.cli-qnty = 0
     5235             .
     5236           end.
     5237           if  buf_parts.qnty <> 0
     5238           and buf_parts.cli-qnty <> 1
     5239           then do:
     5240             message
     5241               vss-workfile vss-revision vss-description skip
     5242               "Порожденная партия ювелирных изделий должна иметь определенное клиентское количество" skip
     5243               "qnty" buf_parts.qnty skip
     5244               "cli-qnty" buf_parts.cli-qnty skip
     5245               view-as alert-box error .
     5246             undo, return error .
     5247           end.
     5248         end.
     5249         else do:
     5250           if buf_parts.cli-base-rate <> 0
     5251           then do:
     5252             assign
     5253               buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5254             .
     5255           end.
     5256           else do:
     5257             assign
     5258               buf_parts.cli-qnty = 0
     5259             .
     5260           end.
     5261         end.
     5262         assign
     5263           p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     5264           p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     5265         .
     5266       end.
     5267       else do:
     5268         assign
     5269           v-orig-unrsrv-code =
     5270           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     5271         or (buf_trn-doc.doc-type = 'инв':U and buf_parts.qnty < 0)
     5272         then 'free-zone':U
     5273         else 'out-zone':U )
     5274           v-new-rsrv-code    =  ( if p-chg-qnty > 0
     5275                                   then 'free-zone':U
     5276                                   else 'out-zone':U
     5277                                 )
     5278           v-new-unrsrv-code  =  ( if p-chg-qnty > 0
     5279                                   then 'out-zone':U
     5280                                   else 'free-zone':U
     5281                                 )
     5282         .
     5283         if v-new-rsrv-code = v-orig-unrsrv-code then do:
     5284           assign
     5285             v-rsrv-qnty = min(abs(buf_parts.qnty), abs(p-chg-qnty) )
     5286           .
     5287           if v-izlcstpr and buf_parts.out-code <> v-new-rsrv-code and p-chg-qnty > 0
     5288           then do :
     5289               find first rsrv-parts exclusive-lock
     5290                   where rsrv-parts.obj-type  = buf_parts.obj-type
     5291                     and rsrv-parts.obj-code  = buf_parts.obj-code
     5292                     and rsrv-parts.artic     = buf_parts.artic
     5293                     and rsrv-parts.prod-type = buf_parts.prod-type
     5294                     and rsrv-parts.prod-code = buf_parts.prod-code
     5295                     and rsrv-parts.in-code   = buf_parts.out-code
     5296                     and rsrv-parts.out-code  = v-new-rsrv-code
     5297                     and rsrv-parts.part-code = buf_parts.part-code
     5298                   no-error.
     5299           end.
     5300           if not available rsrv-parts
     5301           then do :
     5302               run partcopy in this-procedure
     5303                 (input  true
     5304                 ,input  v-new-rsrv-code
     5305                 ,buffer buf_parts
     5306                 ,buffer rsrv-parts
     5307                 ,input p-mark
     5308                 ) no-error .
     5309               if error-status :error then do:
     5310                 message
     5311                   vss-workfile vss-revision vss-description skip
     5312                   "Ошибка при создании партии" skip
     5313                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     5314                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     5315                   "Партия" buf_parts.in-code buf_parts.part-code skip
     5316                   "Резерв" v-new-rsrv-code skip
     5317                   error-status :get-message(1) skip
     5318                   return-value skip
     5319                   view-as alert-box error .
     5320                 undo, return error .
     5321               end.
     5322           end.
     5323           if not v-izlcstpr or (v-izlcstpr and p-chg-qnty > 0)
     5324           then
     5325           assign
     5326             rsrv-parts.qnty      = rsrv-parts.qnty      + v-rsrv-qnty
     5327             rsrv-parts.fact-qnty = rsrv-parts.fact-qnty + v-rsrv-qnty
     5328           .
     5329           if p-goods-twounit = true then do:
     5330             assign
     5331               rsrv-parts.cli-qnty = rsrv-parts.cli-qnty + abs(buf_parts.cli-qnty)
     5332             .
     5333           end.
     5334           else do:
     5335             if rsrv-parts.cli-base-rate <> 0
     5336             then do:
     5337               assign
     5338                 rsrv-parts.cli-qnty = rsrv-parts.fact-qnty / rsrv-parts.cli-base-rate
     5339               .
     5340             end.
     5341             else do:
     5342               assign
     5343                 rsrv-parts.cli-qnty = 0
     5344               .
     5345             end.
     5346           end.
     5347           assign
     5348             buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     5349             buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     5350           .
     5351           if p-goods-twounit = true then do:
     5352             assign
     5353               buf_parts.cli-qnty = 0
     5354             .
     5355           end.
     5356           else do:
     5357             if buf_parts.cli-base-rate <> 0
     5358             then do:
     5359               assign
     5360                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5361               .
     5362             end.
     5363             else do:
     5364               assign
     5365                 buf_parts.cli-qnty = 0
     5366               .
     5367             end.
     5368           end.
     5369           assign
     5370             p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     5371             p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     5372           .
     5373         end.
     5374         if p-chg-qnty <> 0
     5375         and (
     5376              (buf_trn-doc.doc-type = 'инв':U
     5377              and p-unreserv-only = false
     5378              )
     5379             or v-new-unrsrv-code = v-orig-unrsrv-code
     5380             )
     5381         then do:
     5382           if v-izlcstpr and buf_parts.out-code <> v-new-unrsrv-code and p-chg-qnty < 0
     5383           then do :
     5384               find first unrsrv-parts exclusive-lock
     5385                   where unrsrv-parts.obj-type  = buf_parts.obj-type
     5386                     and unrsrv-parts.obj-code  = buf_parts.obj-code
     5387                     and unrsrv-parts.artic     = buf_parts.artic
     5388                     and unrsrv-parts.prod-type = buf_parts.prod-type
     5389                     and unrsrv-parts.prod-code = buf_parts.prod-code
     5390                     and unrsrv-parts.in-code   = buf_parts.in-code
     5391                     and unrsrv-parts.out-code  = v-new-unrsrv-code
     5392                     and unrsrv-parts.part-code = buf_parts.part-code
     5393                   no-error.
     5394           end.
     5395           if not available unrsrv-parts
     5396           then do :
     5397               run partcopy in this-procedure
     5398                 (input  true
     5399                 ,input  v-new-unrsrv-code
     5400                 ,buffer buf_parts
     5401                 ,buffer unrsrv-parts
     5402                 ,input  p-mark
     5403                 ) no-error .
     5404               if error-status :error then do:
     5405                 message
     5406                   vss-workfile vss-revision vss-description skip
     5407                   "Ошибка при создании партии" skip
     5408                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     5409                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     5410                   "Партия" buf_parts.in-code buf_parts.part-code skip
     5411                   "Резерв" v-new-rsrv-code skip
     5412                   error-status :get-message(1) skip
     5413                   return-value skip
     5414                   view-as alert-box error .
     5415                 undo, return error .
     5416               end.
     5417           end.
     5418           assign
     5419             v-unrsrv-qnty = min( (if unrsrv-parts.qnty > 0
     5420                                   then unrsrv-parts.qnty
     5421                                   else 0
     5422                                   )
     5423                             , abs(p-chg-qnty))
     5424           .
     5425           assign
     5426             buf_parts.qnty      = buf_parts.qnty      + v-unrsrv-qnty * v-sign-rsrv-qnty
     5427             buf_parts.fact-qnty = buf_parts.fact-qnty + v-unrsrv-qnty * v-sign-rsrv-qnty
     5428           .
     5429           if p-goods-twounit = true then do:
     5430             assign
     5431               buf_parts.cli-qnty = buf_parts.cli-qnty + unrsrv-parts.cli-qnty * v-sign-rsrv-qnty
     5432             .
     5433           end.
     5434           else do:
     5435             if buf_parts.cli-base-rate <> 0
     5436             then do:
     5437               assign
     5438                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5439               .
     5440             end.
     5441             else do:
     5442               assign
     5443                 buf_parts.cli-qnty = 0
     5444               .
     5445             end.
     5446           end.
     5447           if num-entries(buf_parts.part-code, "_") = 2
     5448           and buf_parts.qnty > 0
     5449           and buf_parts.out-code <> 'free-zone':U
     5450           and buf_parts.out-code <> 'out-zone':U
     5451           and buf_trn-doc.ext-doc-type = 'vt':U
     5452           then do :
     5453             v-old-part-code = buf_parts.part-code .
     5454             v-part-code-int = 0 .
     5455             buf_parts.part-code = entry(2, buf_parts.part-code, "_") no-error .
     5456             do while error-status:error :
     5457               v-part-code-int = v-part-code-int + 1 .
     5458               buf_parts.part-code = string(integer(entry(2, buf_parts.part-code, "_")) + v-part-code-int) no-error .
     5459             end .
     5460   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5461   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5462     (input  buf_parts.artic
     5463     ,input  buf_parts.prod-type
     5464     ,input  buf_parts.prod-code
     5465     ,output v-part-gds-code
     5466     )  .
     5467             find first buf_parts-attr exclusive-lock where buf_parts-attr.in-code   = buf_parts.in-code
     5468                                                        and buf_parts-attr.gds-code  = v-part-gds-code
     5469                                                        and buf_parts-attr.part-code = buf_parts.part-code
     5470                                                        no-error.
     5471             if not available buf_parts-attr then do:
     5472               find first ub.parts-attr no-lock where ub.parts-attr.in-code   = buf_parts.in-code
     5473                                                  and ub.parts-attr.gds-code  = v-part-gds-code
     5474                                                  and ub.parts-attr.part-code = v-old-part-code
     5475                                                  no-error.
     5476               if available ub.parts-attr then do:
     5477                 create buf_parts-attr.
     5478                 buffer-copy ub.parts-attr to buf_parts-attr
     5479                 assign
     5480                   buf_parts-attr.part-code = buf_parts.part-code
     5481                 .
     5482               end.
     5483             end.
     5484           end .
     5485           if not v-izlcstpr or (v-izlcstpr and p-chg-qnty < 0)
     5486           then
     5487           assign
     5488             unrsrv-parts.qnty      = unrsrv-parts.qnty      - v-unrsrv-qnty
     5489             unrsrv-parts.fact-qnty = unrsrv-parts.fact-qnty - v-unrsrv-qnty
     5490           .
     5491           if p-goods-twounit = true
     5492           then do:
     5493             assign
     5494               unrsrv-parts.cli-qnty = 0
     5495             .
     5496           end.
     5497           else do:
     5498             if unrsrv-parts.cli-base-rate <> 0
     5499             then do:
     5500               assign
     5501                 unrsrv-parts.cli-qnty = unrsrv-parts.fact-qnty / unrsrv-parts.cli-base-rate
     5502               .
     5503             end.
     5504             else do:
     5505               assign
     5506                 unrsrv-parts.cli-qnty = 0
     5507               .
     5508             end.
     5509           end.
     5510           assign
     5511             p-chg-qnty      = p-chg-qnty      - v-unrsrv-qnty * v-sign-chg-qnty
     5512             p-real-chg-qnty = p-real-chg-qnty + v-unrsrv-qnty * v-sign-chg-qnty
     5513           .
     5514         end.
     5515       end.
     5516       if available unrsrv-parts
     5517       and unrsrv-parts.qnty      = 0
     5518       and unrsrv-parts.fact-qnty = 0
     5519       then do:
     5520         if p-goods-twounit = true then do:
     5521           if unrsrv-parts.cli-qnty <> 0 then do:
     5522             message
     5523               vss-workfile vss-revision vss-description skip
     5524               "Ошибка при удалении партии" skip
     5525               "Объект" unrsrv-parts.obj-type unrsrv-parts.obj-code skip
     5526               "Артикул" unrsrv-parts.artic unrsrv-parts.prod-type unrsrv-parts.prod-code skip
     5527               "Партия" unrsrv-parts.in-code unrsrv-parts.part-code skip
     5528               "Резерв" unrsrv-parts.out-code skip
     5529               "qnty" unrsrv-parts.qnty skip
     5530               "fact-qnty" unrsrv-parts.fact-qnty skip
     5531               "cli-qnty" unrsrv-parts.cli-qnty skip
     5532               view-as alert-box error .
     5533             undo, return error .
     5534           end.
     5535         end.
     5536         define variable origpart-key-rec as character no-undo .
     5537         define buffer buf_gen-attr for ub.gen-attr .
     5538         define buffer buf1_gen-attr for ub.gen-attr .
     5539         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     5540                                           ,input (buffer unrsrv-parts:handle)
     5541                                           ,output part-key-rec).
     5542         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     5543                                           ,input (buffer buf_parts:handle)
     5544                                           ,output origpart-key-rec).
     5545         if  v-new-rsrv-code <> 'out-zone':U then do:
     5546           for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     5547                                               and ub.gen-attr.p-key =  part-key-rec :
     5548             find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     5549                                               and buf_gen-attr.p-key =  origpart-key-rec
     5550                                               and buf_gen-attr.attr-code = ub.gen-attr.attr-code no-error .
     5551           if not available (buf_gen-attr) then do:
     5552               create buf_gen-attr .
     5553               buffer-copy ub.gen-attr to buf_gen-attr
     5554               assign
     5555                   buf_gen-attr.p-key = origpart-key-rec
     5556               no-error .
     5557           end.
     5558             find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     5559             find current buf1_gen-attr exclusive-lock.
     5560             delete buf1_gen-attr .
     5561         end.
     5562         end.
     5563         define variable v-gds-code as integer   no-undo .
     5564   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5565   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5566     (input  unrsrv-parts.artic
