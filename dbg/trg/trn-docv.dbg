        1   block-level on error undo, throw.
        2   using ibs.th.str.alcohol.*.
        3   using ibs.th.gbl.sys.*.
        4   define input  parameter p-doc-code  like ub.trn-doc.doc-code no-undo .
        5   define output parameter p-err       as logical   no-undo .
        6   define output parameter p-mess      as character no-undo .
        7   define variable chg-qnty      as   decimal no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Дополнительные проверки по документу перед отсылкой по новостям".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define new global shared variable g#lib-trn  as handle no-undo .
       84   define new global shared variable g#lib-trn2 as handle no-undo .
       85   define new global shared variable g#lib-trn3 as handle no-undo .
       86   define new global shared variable g#lib-trn4 as handle no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
       89     field prt-code         like ub.gds-dtl.prt-code
       90     field rsrv-qnty        like ub.gds-dtl.fact-qnty
       91     field rsrv-out-qnty    like ub.gds-dtl.fact-qnty
       92     index xpk is primary unique prt-code
       93   .
       94   define temp-table temp-trndocrs-pl-gds-rsrv no-undo
       95     field pl-code          like ub.pl-gds.pl-code
       96     field rsrv-qnty        like ub.pl-gds.free-qnty
       97     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
       98     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
       99     field before-free-qnty like ub.pl-gds.fact-qnty
      100     field before-out-qnty  like ub.pl-gds.fact-qnty
      101     field after-free-qnty  like ub.pl-gds.fact-qnty
      102     field after-out-qnty   like ub.pl-gds.fact-qnty
      103     field fact-qnty        like ub.pl-gds.fact-qnty
      104     field cli-qnty         like ub.pl-gds.cli-qnty
      105     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
      106     index xpk is primary unique pl-code
      107   .
      108   procedure trndocrs-gds-dtl-clear :
      109     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      110     do
      111     on error undo, return error return-value
      112     :
      113       for each buf_temp-trndocrs-gds-dtl-rsrv
      114       on error undo, return error return-value
      115       :
      116         delete buf_temp-trndocrs-gds-dtl-rsrv .
      117       end.
      118     end.
      119   end procedure.
      120   procedure trndocrs-pl-gds-clear :
      121     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      122     do
      123     on error undo, return error return-value
      124     :
      125       for each buf_temp-trndocrs-pl-gds-rsrv
      126       on error undo, return error return-value
      127       :
      128         delete buf_temp-trndocrs-pl-gds-rsrv .
      129       end.
      130     end.
      131   end procedure.
      132   procedure trndocrs-clear :
      133     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      134     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      135     do
      136     on error undo, return error return-value
      137     :
      138       for each buf_temp-trndocrs-gds-dtl-rsrv
      139       on error undo, return error return-value
      140       :
      141         delete buf_temp-trndocrs-gds-dtl-rsrv .
      142       end.
      143       for each buf_temp-trndocrs-pl-gds-rsrv
      144       on error undo, return error return-value
      145       :
      146         delete buf_temp-trndocrs-pl-gds-rsrv .
      147       end.
      148     end.
      149   end procedure.
      150   procedure trndocrs-pl-gds-accum :
      151     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
      152     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
      153     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
      154     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
      155     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
      156     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      157     do
      158     on error undo, return error return-value
      159     :
      160       find first buf_temp-trndocrs-pl-gds-rsrv
      161         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      162         no-error .
      163       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      164         create buf_temp-trndocrs-pl-gds-rsrv .
      165         assign
      166           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      167         .
      168       end.
      169       assign
      170         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
      171         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
      172         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
      173         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
      174       .
      175     end.
      176   end procedure.
      177   procedure trndocrs-gds-dtl-accum :
      178     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
      179     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
      180     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
      181     do
      182     on error undo, return error return-value
      183     :
      184       find first buf_temp-trndocrs-gds-dtl-rsrv
      185         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      186         no-error .
      187       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
      188         create buf_temp-trndocrs-gds-dtl-rsrv .
      189         assign
      190           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      191         .
      192       end.
      193       assign
      194         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      195                                                + p-rsrv-qnty
      196       .
      197     end.
      198   end procedure.
      199   procedure trndocrs-pl-gds-request :
      200     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      201     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
      202     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
      203     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
      204     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
      205     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
      206     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
      207     define input parameter p-field-accum            as character no-undo .
      208     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
      209     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      210     do
      211     on error undo, return error return-value
      212     :
      213       if lookup(p-field-accum, "before,after":u ) = 0 then do:
      214         message
      215           vss-workfile vss-revision vss-description skip
      216           vss-include-info0 skip
      217           "Ошибка задания входных параметров параметров" skip
      218           "Неизвестное значение параметра" skip
      219           "p-field-accum" p-field-accum skip
      220           view-as alert-box error .
      221         undo, return error return-value .
      222       end.
      223       case p-field-accum :
      224         when "before":u then do:
      225           for each buf_temp-trndocrs-pl-gds-rsrv
      226           on error undo, return error return-value
      227           :
      228             assign
      229               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
      230               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
      231             .
      232           end.
      233         end.
      234         when "after":u then do:
      235           for each buf_temp-trndocrs-pl-gds-rsrv
      236           on error undo, return error return-value
      237           :
      238             assign
      239               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
      240               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
      241             .
      242           end.
      243         end.
      244         otherwise do:
      245           message
      246             vss-workfile vss-revision vss-description skip
      247             vss-include-info0 skip
      248             "Ошибка задания входных параметров параметров" skip
      249             "Неизвестное значение параметра" skip
      250             "p-field-accum" p-field-accum skip
      251             view-as alert-box error .
      252           undo, return error return-value .
      253         end.
      254       end.
      255       define buffer buf_parts for ub.parts.
      256       for each buf_parts no-lock
      257         where buf_parts.out-code  = p-doc-code
      258           and buf_parts.obj-type  = p-obj-type
      259           and buf_parts.obj-code  = p-obj-code
      260           and buf_parts.artic     = p-artic
      261           and buf_parts.prod-type = p-prod-type
      262           and buf_parts.prod-code = p-prod-code
      263       on error undo, return error return-value
      264       :
      265         find first buf_temp-trndocrs-pl-gds-rsrv
      266           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      267           no-error .
      268         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      269           create buf_temp-trndocrs-pl-gds-rsrv .
      270           assign
      271             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      272           .
      273         end.
      274         if can-do('при,рас,спи':U, p-doc-type)
      275         or (p-doc-type = 'инв':U
      276             and buf_parts.fact-qnty < 0)
      277         then do:
      278           case p-field-accum :
      279             when "before":u then do:
      280               assign
      281                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      282                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      283                   + abs(buf_parts.fact-qnty)
      284               .
      285             end.
      286             when "after":u then do:
      287               assign
      288                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      289                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      290                   + abs(buf_parts.fact-qnty)
      291               .
      292             end.
      293             otherwise do:
      294               message
      295                 vss-workfile vss-revision vss-description skip
      296                 vss-include-info0 skip
      297                 "Ошибка задания входных параметров параметров" skip
      298                 "Неизвестное значение параметра" skip
      299                 "p-field-accum" p-field-accum skip
      300                 view-as alert-box error .
      301               undo, return error return-value .
      302             end.
      303           end.
      304         end.
      305         else do:
      306           case p-field-accum :
      307             when "before":u then do:
      308               assign
      309                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      310                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      311                   + abs(buf_parts.fact-qnty)
      312               .
      313             end.
      314             when "after":u then do:
      315               assign
      316                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      317                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      318                   + abs(buf_parts.fact-qnty)
      319               .
      320             end.
      321             otherwise do:
      322               message
      323                 vss-workfile vss-revision vss-description skip
      324                 vss-include-info0 skip
      325                 "Ошибка задания входных параметров параметров" skip
      326                 "Неизвестное значение параметра" skip
      327                 "p-field-accum" p-field-accum skip
      328                 view-as alert-box error .
      329               undo, return error return-value .
      330             end.
      331           end.
      332         end.
      333       end.
      334     end.
      335   end procedure.
      336   procedure trndocrs-pl-gds-calc-rsrv :
      337     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
      338     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      339     do
      340     on error undo, return error return-value
      341     :
      342       for each buf_temp-trndocrs-pl-gds-rsrv
      343       on error undo, return error return-value
      344       :
      345         assign
      346           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      347             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      348             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      349           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
      350             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      351             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      352         .
      353       end.
      354     end.
      355   end procedure.
      356   procedure trndocrs-need-rsrv :
      357     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
      358     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
      359     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
      360     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
      361     define output parameter p-need-rsrv    as logical   no-undo .
      362     define buffer buf_goods   for ub.goods .
      363     do
      364     on error undo, return error return-value
      365     :
      366       find first buf_goods no-lock
      367         where buf_goods.artic     = p-artic
      368           and buf_goods.prod-type = p-prod-type
      369           and buf_goods.prod-code = p-prod-code
      370         .
      371       if buf_goods.gds-type = 'т':U
      372       and ( p-doc-type = 'рас':U
      373             or p-doc-type = 'спи':U
      374           )
      375       then do:
      376         assign
      377           p-need-rsrv = true
      378         .
      379       end.
      380       else do:
      381         assign
      382           p-need-rsrv = false
      383         .
      384       end.
      385     end.
      386   end procedure.
      387   procedure trndocrs-need-create-doc-pl :
      388     define input  parameter p-extended-doc-type  as character no-undo .
      389     define input  parameter p-news               as logical   no-undo .
      390     define input  parameter p-sale-auto          as logical   no-undo .
      391     define output parameter p-need-create-doc-pl as logical   no-undo .
      392     do
      393     on error undo, return error return-value
      394     :
      395       if  not p-news
      396       and p-extended-doc-type <> 'ie':U
      397       and p-extended-doc-type <> 'es':U
      398       and p-extended-doc-type <> 'rs':U
      399       and not p-sale-auto
      400       then do:
      401         assign
      402           p-need-create-doc-pl = true
      403         .
      404       end.
      405       else do:
      406         assign
      407           p-need-create-doc-pl = false
      408         .
      409       end.
      410     end.
      411   end procedure.
      412   procedure trndocrs-validate :
      413     define input parameter p-place-rsrv as logical no-undo .
      414     define input parameter p-chg-qnty   as decimal no-undo .
      415     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      416     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      417     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
      418     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
      419     assign
      420       v-total-gds-dtl-rsrv-qnty = 0
      421       v-total-pl-gds-rsrv-qnty  = 0
      422     .
      423     do
      424     on error undo, return error return-value
      425     :
      426       for each buf_temp-trndocrs-gds-dtl-rsrv
      427       on error undo, return error return-value
      428       :
      429         assign
      430           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
      431                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      432         .
      433       end.
      434       for each buf_temp-trndocrs-pl-gds-rsrv
      435       on error undo, return error return-value
      436       :
      437         assign
      438           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
      439                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      440         .
      441       end.
      442       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      443         message
      444           vss-workfile vss-revision vss-description skip
      445           vss-include-info0 skip
      446           "Ошибка при резервировании свободных количеств" skip
      447           "Запрошено резервирование:" skip
      448           "По товару" p-chg-qnty skip
      449           "По признакам" v-total-gds-dtl-rsrv-qnty skip
      450           "По складским местам" v-total-pl-gds-rsrv-qnty skip
      451           view-as alert-box error .
      452         undo, return error return-value .
      453       end.
      454       if p-place-rsrv then do:
      455         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      456           message
      457             vss-workfile vss-revision vss-description skip
      458             vss-include-info0 skip
      459             "Ошибка при резервировании свободных количеств" skip
      460             "Запрошено резервирование:" skip
      461             "По товару" p-chg-qnty skip
      462             "По признакам" v-total-gds-dtl-rsrv-qnty skip
      463             "По складским местам" v-total-pl-gds-rsrv-qnty skip
      464             view-as alert-box error .
      465           undo, return error return-value .
      466         end.
      467       end.
      468     end.
      469   end procedure.
      470   procedure trndocrs :
      471     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
      472     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
      473     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
      474     define input parameter p-artic      like ub.doc-line.artic     no-undo .
      475     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
      476     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
      477     define input parameter p-chg-qnty   as decimal no-undo .
      478     define buffer buf_db         for ub.db .
      479     define buffer buf_gds-obj    for ub.gds-obj .
      480     define buffer buf_prt-obj    for ub.prt-obj .
      481     define buffer buf_gds-prt    for ub.gds-prt .
      482     define buffer buf_goods      for ub.goods .
      483     define buffer buf_pl-gds     for ub.pl-gds .
      484     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      485     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      486     define variable v-node-code   like ub.gds-prt.node-code no-undo .
      487     define variable v-curr-db-num like ub.db.db-num         no-undo .
      488     define variable v-cmd         as   character            no-undo .
      489     do
      490     on error undo, return error return-value
      491     :
      492   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      493   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      494     (input  p-obj-type
      495     ,input  p-obj-code
      496     ,input  p-artic
      497     ,input  p-prod-type
      498     ,input  p-prod-code
      499     ,buffer buf_gds-obj
      500     ) no-error .
      501       if error-status :error then do:
      502         message
      503           vss-workfile vss-revision vss-description skip
      504           vss-include-info0 skip
      505           "Ошибка при поиске товара на объекте" skip
      506           "p-obj-type"  p-obj-type  skip
      507           "p-obj-code"  p-obj-code  skip
      508           "p-artic"     p-artic     skip
      509           "p-prod-type" p-prod-type skip
      510           "p-prod-code" p-prod-code skip
      511           error-status :get-message(1) skip
      512           return-value skip
      513           view-as alert-box error .
      514         undo, return error return-value .
      515       end.
      516       find current buf_gds-obj exclusive-lock .
      517       run trndocrs-validate in this-procedure
      518         (input buf_gds-obj.place-rsrv
      519         ,input p-chg-qnty
      520         ) no-error .
      521       if error-status :error then do:
      522         message
      523           vss-workfile vss-revision vss-description skip
      524           vss-include-info0 skip
      525           "Противоречивые данные для резервирования" skip
      526           error-status :get-message(1) skip
      527           return-value skip
      528           view-as alert-box error .
      529         undo, return error return-value .
      530       end.
      531       assign
      532         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
      533         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
      534       .
      535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      536     (input ?
      537     ,input this-procedure:handle
      538     ,input ?
      539     ,input  'rest-update':U
      540     ,input ?
      541     ,input  buffer buf_gds-obj:handle
      542     ,input 'fact-qnty,free-qnty'
      543     ,input ''
      544     ) no-error .
      545   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      546   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      547     (output v-curr-db-num
      548     )  .
      549       find first buf_db no-lock
      550         where buf_db.db-num = v-curr-db-num
      551         .
      552       if buf_db.db-num <> 0
      553         and buf_db.on-line-rest = true
      554       then do:
      555         assign
      556           v-cmd = "command":U + chr(1)
      557                   + "create":U + chr(1)
      558                   + "on-line-rest":U + chr(1)
      559                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
      560                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
      561                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
      562                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
      563                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
      564                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
      565         .
      566         run nws/cr-route.p
      567           ( input 'send-cmd':U
      568             ,input v-cmd
      569             ,input ?
      570             ,input "0":U
      571           ).
      572       end.
      573       if buf_gds-obj.place-rsrv = true then do:
      574         for each buf_temp-trndocrs-pl-gds-rsrv
      575         on error undo, return error return-value
      576         :
      577           find first buf_goods no-lock
      578             where buf_goods.artic     = p-artic
      579               and buf_goods.prod-type = p-prod-type
      580               and buf_goods.prod-code = p-prod-code
      581             no-error .
      582           if not available buf_goods then do:
      583             message
      584               vss-workfile vss-revision vss-description skip
      585               vss-include-info0 skip
      586               "Не найдена товар" skip
      587               "Артикул" p-artic p-prod-type p-prod-code skip
      588               view-as alert-box error .
      589             undo, return error return-value .
      590           end.
      591           find first buf_pl-gds exclusive-lock
      592             where buf_pl-gds.obj-type = p-obj-type
      593               and buf_pl-gds.obj-code = p-obj-code
      594               and buf_pl-gds.gds-code = buf_goods.gds-code
      595               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
      596             no-error .
      597           if not available buf_pl-gds then do:
      598             message
      599               vss-workfile vss-revision vss-description skip
      600               vss-include-info0 skip
      601               "Не найдена привязка товара к складскому месту" skip
      602               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
      603               view-as alert-box error .
      604             undo, return error return-value .
      605           end.
      606           assign
      607             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      608             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
      609           .
      610           if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
      611             and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
      612           then do:
      613             assign
      614               buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
      615             .
      616           end.
      617         end.
      618       end.
      619       for each buf_temp-trndocrs-gds-dtl-rsrv
      620       on error undo, return error return-value
      621       :
      622   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
      623     (input  buf_temp-trndocrs-gds-dtl-rsrv.prt-code
      624     ,output v-node-code
      625     ) no-error .
      626         if error-status :error then do:
      627           message
      628             vss-workfile vss-revision vss-description skip
      629             vss-include-info0 skip
      630             "Ошибка при определении первого терминального признака" skip
      631             "prt-code" buf_temp-trndocrs-gds-dtl-rsrv.prt-code skip
      632             view-as alert-box error .
      633           undo, return error return-value .
      634         end.
      635         find first buf_gds-prt no-lock
      636           where buf_gds-prt.node-code = v-node-code
      637           .
      638         do while available buf_gds-prt
      639         on error undo, return error return-value
      640         :
      641   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      642   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
      643     (input  p-obj-type
      644     ,input  p-obj-code
      645     ,input  p-artic
      646     ,input  p-prod-type
      647     ,input  p-prod-code
      648     ,input  buf_gds-prt.node-code
      649     ,buffer buf_prt-obj
      650     )  .
      651           find current buf_prt-obj exclusive-lock .
      652           assign
      653             buf_prt-obj.free-qnty = buf_prt-obj.free-qnty - buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      654           .
      655           assign
      656             v-node-code = buf_gds-prt.upper-code
      657           .
      658           find first buf_gds-prt no-lock
      659             where buf_gds-prt.node-code = v-node-code
      660             no-error .
      661         end.
      662       end.
      663     end.
      664   end procedure.
      665   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   procedure partrqst :
      667     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
      668     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
      669     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
      670     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
      671     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
      672     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
      673     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
      674     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
      675     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
      676     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
      677     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
      678     define output parameter p-total-parts-price-base     as decimal                 no-undo .
      679     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
      680     define output parameter p-total-parts-transport-base as decimal                 no-undo .
      681     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
      682     define output parameter p-total-parts-other-base     as decimal                 no-undo .
      683     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
      684     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
      685     do
      686     on error undo, return error return-value
      687     :
      688       assign
      689         p-total-parts-qnty           = 0
      690         p-total-parts-fact-qnty      = 0
      691         p-total-parts-cli-qnty       = 0
      692         p-total-parts-fact-cli-qnty  = 0
      693         p-total-parts-price-cli      = 0
      694         p-total-parts-price-base     = 0
      695         p-total-parts-price-rubl     = 0
      696         p-total-parts-transport-base = 0
      697         p-total-parts-transport-rubl = 0
      698         p-total-parts-other-base     = 0
      699         p-total-parts-other-rubl     = 0
      700       .
      701       define buffer buf_parts for ub.parts .
      702       for each buf_parts no-lock
      703         where buf_parts.out-code  = p-doc-code
      704           and buf_parts.obj-type  = p-obj-type
      705           and buf_parts.obj-code  = p-obj-code
      706           and buf_parts.artic     = p-artic
      707           and buf_parts.prod-type = p-prod-type
      708           and buf_parts.prod-code = p-prod-code
      709       on error undo, return error return-value
      710       :
      711         define variable v-parts-fact-multiplier as decimal   no-undo .
      712         assign
      713           v-parts-fact-multiplier = 1
      714         .
      715         if buf_parts.qnty <> 0 then do:
      716           assign
      717             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      718           .
      719         end.
      720         assign
      721           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      722           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      723           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      724           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      725                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      726           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      727           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      728           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      729           p-total-parts-transport-base  = p-total-parts-transport-base
      730                                         + buf_parts.fact-qnty
      731                                           * (if   buf_parts.transport-base <> ?
      732                                             then buf_parts.transport-base
      733                                             else 0
      734                                             )
      735           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      736                                         + buf_parts.fact-qnty
      737                                           * (if   buf_parts.transport-rubl <> ?
      738                                             then buf_parts.transport-rubl
      739                                             else 0
      740                                             )
      741           p-total-parts-other-base      = p-total-parts-other-base
      742                                         + buf_parts.fact-qnty
      743                                           * (if   buf_parts.other-base <> ?
      744                                             then buf_parts.other-base
      745                                             else 0
      746                                             )
      747           p-total-parts-other-rubl      = p-total-parts-other-rubl
      748                                         + buf_parts.fact-qnty
      749                                           * (if   buf_parts.other-rubl <> ?
      750                                             then buf_parts.other-rubl
      751                                             else 0
      752                                             )
      753         .
      754       end.
      755     end.
      756   end procedure.
      757   function hvrdtax return logical (input parrecid as recid):
      758   define variable varresult as logical no-undo.
      759   run hvrdtax-proc (input parrecid, output varresult).
      760   return varresult.
      761   end function.
      762   procedure hvrdtax-proc:
      763   define input  parameter parrecid  as recid   no-undo.
      764   define output parameter parresult as logical no-undo.
      765   define buffer bf_goods for ub.goods.
      766   define buffer bf_units for ub.units.
      767   define buffer rt_tax   for ub.tax.
      768   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      769   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      770   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      771   if available rt_tax and
      772       can-find(first ub.tax-units No-LOCK WHERE
      773                      ub.tax-units.tax-code = rt_tax.tax-code AND
      774                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      775                                                       else assign parresult = no.
      776   end procedure.
      777   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      778   procedure gen-key-rec :
      779     define input  parameter p-tbl-name    as character no-undo.
      780     define input  parameter p-bh_tbl-name as handle    no-undo.
      781     define output parameter p-key-rec     as character no-undo.
      782     do
      783     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      784     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      785     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      786     :
      787       define variable fh               as handle    no-undo .
      788       define variable v-ok             as logical   no-undo .
      789       define variable v-inform         as character no-undo .
      790       define variable v-ind            as integer   no-undo .
      791       define variable v-idx-field-qnty as integer   no-undo .
      792       if p-tbl-name = ?
      793         or p-tbl-name = "":U
      794       then do:
      795         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      796       end.
      797       if not p-bh_tbl-name:available then do:
      798         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      799       end.
      800       assign
      801         p-key-rec = p-tbl-name
      802         v-inform  = p-bh_tbl-name:index-information(1)
      803         v-ind     = 2
      804       .
      805       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      806       on error undo, return error
      807       :
      808         assign
      809           v-inform = p-bh_tbl-name:index-information( v-ind )
      810           v-ind    = v-ind + 1
      811         .
      812       end.
      813       if v-inform = ?
      814         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      815         or entry( 3, v-inform, ",":U ) <> "1":U
      816       then do:
      817         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      818       end.
      819       else do:
      820         assign
      821           v-idx-field-qnty = num-entries( v-inform ) - 4
      822         .
      823         if v-idx-field-qnty < 2 then do:
      824           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      825         end.
      826         do v-ind = 1 to v-idx-field-qnty by 2
      827         on error undo, return error
      828         :
      829           assign
      830             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      831             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      832           .
      833         end.
      834       end.
      835       if p-key-rec = ? then do:
      836         assign
      837           p-key-rec = "":U
      838         .
      839         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      840       end.
      841     end.
      842     return.
      843   end procedure.
      844   procedure gen-where-keyr-tab :
      845     define input  parameter i-tableSerach as character no-undo.
      846     define input  parameter i-tablekey   as character  no-undo.
      847     define input  parameter p-key-rec    as character  no-undo.
      848     define input  parameter p-key-handle as handle     no-undo .
      849     define input  parameter p-db-name    as character  no-undo .
      850     define input  parameter p-tt-handle  as handle     no-undo .
      851     define output parameter o-Where      as character  no-undo.
      852     do
      853     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      854     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      855     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      856     :
      857       define variable v-full-tbl-name  as character no-undo .
      858       define variable bh_tbl-name      as handle    no-undo .
      859       define variable fh_key           as handle    no-undo .
      860       define variable fh_search        as handle    no-undo .
      861       define variable v-field-num      as integer   no-undo .
      862       define variable v-count-fld      as integer   no-undo .
      863       define variable v-inform         as character no-undo .
      864       define variable v-ind            as integer   no-undo .
      865       define variable v-idx-field-qnty as integer   no-undo .
      866       define variable v-field-name     as character no-undo .
      867       define variable v-field-val      as character no-undo .
      868       define variable v-word-link      as character no-undo .
      869       define variable vTable           as character no-undo.
      870       define variable bh_tbl-key       as handle    no-undo .
      871       assign
      872         p-key-rec = trim( p-key-rec )
      873       .
      874       if p-key-handle <> ? then do:
      875         if not valid-handle(p-key-handle)
      876            or p-key-handle:type <> "buffer"
      877         then do:
      878           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      879         end.
      880         if num-entries( p-key-rec, chr(3) ) > 1
      881           or p-key-rec = ?
      882           or p-key-rec = "":U
      883         then do:
      884           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      885         end.
      886       end.
      887       else do:
      888         if p-key-rec = ?
      889           or p-key-rec = "":U
      890         then do:
      891           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      892         end.
      893       end.
      894       assign
      895         vTable = entry( 1 , p-key-rec, chr(3) )
      896       .
      897       if p-tt-handle <> ?
      898         and ( not valid-handle(p-tt-handle)
      899               or p-tt-handle:type <> "buffer"
      900             )
      901       then do:
      902         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      903       end.
      904       if p-tt-handle = ? then do:
      905         assign
      906           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      907         .
      908         create buffer bh_tbl-name for table v-full-tbl-name .
      909       end.
      910       else do:
      911         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      912       end.
      913       assign
      914         v-inform = bh_tbl-name:index-information(1)
      915         v-ind    = 2
      916       .
      917       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      918       on error undo, return error
      919       :
      920         assign
      921           v-inform = bh_tbl-name:index-information( v-ind )
      922           v-ind    = v-ind + 1
      923         .
      924       end.
      925       if v-inform = ?
      926         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      927         or entry( 3, v-inform, ",":U ) <> "1":U
      928       then do:
      929         delete object bh_tbl-name no-error.
      930         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      931       end.
      932       assign
      933         v-idx-field-qnty = num-entries( v-inform ) - 4
      934       .
      935       if v-idx-field-qnty < 2 then do:
      936         delete object bh_tbl-name no-error.
      937         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      938       end.
      939       assign
      940         o-where     = "where":U
      941         v-word-link = "":U
      942         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      943         v-count-fld = 0
      944       .
      945       if i-tablekey ne "" and i-tablekey ne ?
      946       then do:
      947         assign
      948           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      949         .
      950         create buffer bh_tbl-key for table v-full-tbl-name .
      951       end.
      952       if i-tableSerach ne "" and i-tableSerach ne ?
      953       then do:
      954         delete object bh_tbl-name no-error.
      955         assign
      956           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      957         .
      958         create buffer bh_tbl-name for table v-full-tbl-name .
      959       end.
      960       block_where:
      961       do v-ind = 1 to v-idx-field-qnty by 2
      962       on error undo, return error
      963       :
      964         assign
      965           v-count-fld = v-count-fld + 1
      966         .
      967         if p-key-handle = ?
      968           and v-count-fld > v-field-num
      969         then do:
      970           leave block_where.
      971         end.
      972         define variable VfieldKeyTable as handle no-undo.
      973         assign
      974           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      975           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      976         .
      977         if     bh_tbl-key ne ?
      978         then do:
      979            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      980            if VfieldKeyTable eq ?
      981            then next block_where.
      982         end.
      983         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      984         then
      985            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      986         else
      987            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      988         if p-key-handle = ? then do:
      989           assign
      990             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      991           .
      992         end.
      993         else do:
      994           assign
      995             fh_key = p-key-handle:buffer-field( v-field-name )
      996           .
      997           if fh_key = ?
      998             or not valid-handle( fh_key )
      999           then do:
     1000             delete object bh_tbl-name.
     1001             if     bh_tbl-key ne ?
     1002             then
     1003                delete object bh_tbl-key.
     1004             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
     1005           end.
     1006           assign
     1007             v-field-val = fh_key:buffer-value
     1008           .
     1009         end.
     1010         if fh_search:data-type ="character":U then do:
     1011           assign
     1012             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1013             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1014             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1015             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1016             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1017             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1018             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1019             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1020             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1021             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1022             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1023             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1024             v-field-val = substitute( '"&1"', v-field-val )
     1025           .
     1026         end.
     1027         assign
     1028           o-where = substitute( "&1 &2", o-where, v-field-val )
     1029         .
     1030         if v-word-link = "":U then do:
     1031           assign
     1032             v-word-link = "and":U
     1033           .
     1034         end.
     1035       end.
     1036       delete object bh_tbl-name.
     1037       if     bh_tbl-key ne ?
     1038       then
     1039          delete object bh_tbl-key.
     1040       if p-key-handle = ?
     1041         and v-count-fld <> v-field-num
     1042       then do:
     1043         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
     1044       end.
     1045     end.
     1046   end procedure.
     1047   procedure gen-hn-keyr-tab :
     1048     define input  parameter i-tableSerach as character no-undo.
     1049     define input  parameter i-tablekey   as character no-undo.
     1050     define input  parameter p-key-rec    as character no-undo.
     1051     define input  parameter p-key-handle as handle    no-undo .
     1052     define input  parameter p-db-name    as character no-undo .
     1053     define input  parameter p-tt-handle  as handle    no-undo .
     1054     define input  parameter p-stts-lock  as integer   no-undo .
     1055     define output parameter o-hn         as handle    no-undo.
     1056     define variable v-full-tbl-name as character no-undo.
     1057     define variable v-where         as character no-undo.
     1058     define variable bh_tbl-name     as handle    no-undo.
     1059     define variable vTable          as character no-undo.
     1060     do
     1061     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1062     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1063     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1064         run gen-where-keyr-tab(i-tableSerach,
     1065                                i-tablekey,
     1066                                p-key-rec,
     1067                                p-key-handle,
     1068                                p-db-name,
     1069                                p-tt-handle,
     1070                                output v-where).
     1071         if i-tableSerach ne "" and i-tableSerach ne ?
     1072         then do:
     1073            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1074            create buffer bh_tbl-name for table v-full-tbl-name .
     1075         end.
     1076         else do:
     1077            if p-tt-handle = ? then do:
     1078               assign
     1079                  vTable = entry( 1 , p-key-rec, chr(3) )
     1080               .
     1081               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1082               create buffer bh_tbl-name for table v-full-tbl-name .
     1083            end.
     1084            else do:
     1085               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1086            end.
     1087         end.
     1088         if p-tt-handle = ? then do:
     1089            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1090         end.
     1091         else do:
     1092            bh_tbl-name:find-first( v-where ) no-error .
     1093         end.
     1094         o-hn = bh_tbl-name.
     1095      end.
     1096   end procedure.
     1097   procedure gen-hn-keyr :
     1098     define input  parameter p-key-rec    as character no-undo.
     1099     define input  parameter p-key-handle as handle    no-undo .
     1100     define input  parameter p-db-name    as character no-undo .
     1101     define input  parameter p-tt-handle  as handle    no-undo .
     1102     define input  parameter p-stts-lock  as integer   no-undo .
     1103     define output parameter o-hn         as handle    no-undo.
     1104     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1105   end.
     1106   procedure gen-row-keyr :
     1107     define input  parameter p-key-rec    as character no-undo.
     1108     define input  parameter p-key-handle as handle    no-undo .
     1109     define input  parameter p-db-name    as character no-undo .
     1110     define input  parameter p-tt-handle  as handle    no-undo .
     1111     define input  parameter p-stts-lock  as integer   no-undo .
     1112     define output parameter p-tbl-row    as rowid     no-undo.
     1113     define output parameter p-tbl-name   as character no-undo.
     1114     define variable vHn as handle no-undo.
     1115       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1116       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1117       p-tbl-name =  vHn:table.
     1118       delete object vHn no-error.
     1119     if p-tbl-row = ? then do:
     1120       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1121     end.
     1122     else do:
     1123       return.
     1124     end.
     1125   end procedure.
     1126   procedure gen-key-fv :
     1127     define input  parameter p-key-rec    as character no-undo .
     1128     define output parameter p-field-list as character no-undo .
     1129     define output parameter p-value-list as character no-undo.
     1130     do
     1131     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1132     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1133     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1134     :
     1135       define variable v-full-tbl-name  as character no-undo .
     1136       define variable bh_tbl-name      as handle    no-undo .
     1137       define variable v-tbl-name       as character no-undo .
     1138       define variable v-field-num      as integer   no-undo .
     1139       define variable v-count-fld      as integer   no-undo .
     1140       define variable v-inform         as character no-undo .
     1141       define variable v-ind            as integer   no-undo .
     1142       define variable v-idx-field-qnty as integer   no-undo .
     1143       define variable v-delim-key      as character no-undo .
     1144       if p-key-rec = ?
     1145         or p-key-rec = "":U
     1146       then do:
     1147         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1148       end.
     1149       assign
     1150         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1151         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1152       .
     1153       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1154       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1155       assign
     1156         v-inform = bh_tbl-name:index-information(1)
     1157         v-ind    = 2
     1158       .
     1159       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1160       on error undo, return error
     1161       :
     1162         assign
     1163           v-inform = bh_tbl-name:index-information( v-ind )
     1164           v-ind    = v-ind + 1
     1165         .
     1166       end.
     1167       if v-inform = ?
     1168         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1169         or entry( 3, v-inform, ",":U ) <> "1":U
     1170       then do:
     1171         delete object bh_tbl-name no-error.
     1172         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1173       end.
     1174       assign
     1175         v-idx-field-qnty = num-entries( v-inform ) - 4
     1176       .
     1177       if v-idx-field-qnty < 2 then do:
     1178         delete object bh_tbl-name no-error.
     1179         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1180       end.
     1181       assign
     1182         p-field-list = "":U
     1183         p-value-list = "":U
     1184         v-delim-key  = "":U
     1185         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1186         v-count-fld  = 0
     1187       .
     1188       block_where:
     1189       do v-ind = 1 to v-idx-field-qnty by 2
     1190       on error undo, return error
     1191       :
     1192         assign
     1193           v-count-fld = v-count-fld + 1
     1194         .
     1195         if v-count-fld > v-field-num then do:
     1196           leave block_where.
     1197         end.
     1198         assign
     1199           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1200           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1201         .
     1202         if v-ind = 1 then do:
     1203           assign
     1204             v-delim-key = chr(3)
     1205           .
     1206         end.
     1207       end.
     1208       delete object bh_tbl-name.
     1209       if v-count-fld <> v-field-num then do:
     1210         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1211       end.
     1212     end.
     1213   end procedure.
     1214   procedure gen-key-field :
     1215     define input  parameter p-table      as character no-undo .
     1216     define output parameter p-field-list as character no-undo .
     1217     do
     1218     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1219     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1220     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1221     :
     1222       define variable v-full-tbl-name  as character no-undo .
     1223       define variable bh_tbl-name      as handle    no-undo .
     1224       define variable v-tbl-name       as character no-undo .
     1225       define variable v-field-num      as integer   no-undo .
     1226       define variable v-count-fld      as integer   no-undo .
     1227       define variable v-inform         as character no-undo .
     1228       define variable v-ind            as integer   no-undo .
     1229       define variable v-idx-field-qnty as integer   no-undo .
     1230       define variable v-delim-key      as character no-undo .
     1231       if p-table = ?
     1232         or p-table = "":U
     1233       then do:
     1234         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1235       end.
     1236       assign
     1237         v-tbl-name      = p-table
     1238         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1239       .
     1240       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1241       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1242       assign
     1243         v-inform = bh_tbl-name:index-information(1)
     1244         v-ind    = 2
     1245       .
     1246       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1247       on error undo, return error
     1248       :
     1249         assign
     1250           v-inform = bh_tbl-name:index-information( v-ind )
     1251           v-ind    = v-ind + 1
     1252         .
     1253       end.
     1254       if v-inform = ?
     1255         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1256         or entry( 3, v-inform, ",":U ) <> "1":U
     1257       then do:
     1258         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1259       end.
     1260       assign
     1261         v-idx-field-qnty = num-entries( v-inform ) - 4
     1262       .
     1263       if v-idx-field-qnty < 2 then do:
     1264         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1265       end.
     1266       assign
     1267         p-field-list = "":U
     1268         v-delim-key  = "":U
     1269         v-count-fld  = 0
     1270       .
     1271       block_where:
     1272       do v-ind = 1 to v-idx-field-qnty by 2
     1273       on error undo, return error
     1274       :
     1275         assign
     1276           v-count-fld = v-count-fld + 1
     1277         .
     1278         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1279         if v-ind = 1 then do:
     1280           assign
     1281             v-delim-key = chr(3)
     1282           .
     1283         end.
     1284       end.
     1285       delete object bh_tbl-name.
     1286     end.
     1287   end procedure.
     1288   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289   define variable vss-include-info7 as character format "X(65)" no-undo
     1290   initial "@(#)$Workfile$ $Revision$".
     1291   procedure xmlchar-test :
     1292   define input parameter p-in-string          as character        no-undo.
     1293   define output parameter p-out-string-enc    as character        no-undo.
     1294   define output parameter p-out-string-dec    as character        no-undo.
     1295   do
     1296   on error undo, return error
     1297   :
     1298          run xmlchar-encode in this-procedure
     1299       (
     1300             input p-in-string
     1301           , output p-out-string-enc
     1302       ).
     1303          run xmlchar-decode in this-procedure
     1304       (
     1305             input p-out-string-enc
     1306           , output p-out-string-dec
     1307       ).
     1308   end.
     1309   end .
     1310   procedure xmlchar-encode :
     1311   define input parameter p-in-string      as character        no-undo.
     1312   define output parameter p-out-string    as character        no-undo.
     1313       define variable v-position      as integer      no-undo.
     1314       define variable v-current-char  as character    no-undo.
     1315   do
     1316   on error undo, return error
     1317   :
     1318       assign
     1319           p-out-string = "":U
     1320       .
     1321       case p-in-string
     1322       :
     1323           when ?
     1324           then do:
     1325               assign
     1326                   p-out-string = "?":U
     1327               .
     1328           end.
     1329           when "?":U
     1330           then do:
     1331               assign
     1332                   p-out-string = "&#63;":U
     1333               .
     1334           end.
     1335           otherwise do:
     1336               do v-position = 1 to length( p-in-string )
     1337               :
     1338                   assign
     1339                       v-current-char = substring( p-in-string, v-position, 1 )
     1340                   .
     1341                   case v-current-char
     1342                   :
     1343                       when "&":U
     1344                       then do:
     1345                           assign
     1346                               p-out-string = p-out-string + "&amp;":U
     1347                           .
     1348                       end.
     1349                       when ">":U
     1350                       then do:
     1351                           assign
     1352                               p-out-string = p-out-string + "&gt;":U
     1353                           .
     1354                       end.
     1355                       when "<":U
     1356                       then do:
     1357                           assign
     1358                               p-out-string = p-out-string + "&lt;":U
     1359                           .
     1360                       end.
     1361                       when "'":U
     1362                       then do:
     1363                           assign
     1364                               p-out-string = p-out-string + "&apos;":U
     1365                           .
     1366                       end.
     1367                       when '"':U
     1368                       then do:
     1369                           assign
     1370                               p-out-string = p-out-string + "&quot;":U
     1371                           .
     1372                       end.
     1373                       when chr(1)
     1374                       then do:
     1375                           assign
     1376                               p-out-string = p-out-string + "":U
     1377                           .
     1378                       end.
     1379                       when chr(2)
     1380                       then do:
     1381                           assign
     1382                               p-out-string = p-out-string + "":U
     1383                           .
     1384                       end.
     1385                       when chr(3)
     1386                       then do:
     1387                           assign
     1388                               p-out-string = p-out-string + "":U
     1389                           .
     1390                       end.
     1391                       when chr(4)
     1392                       then do:
     1393                           assign
     1394                               p-out-string = p-out-string + "":U
     1395                           .
     1396                       end.
     1397                       when chr(5)
     1398                       then do:
     1399                           assign
     1400                               p-out-string = p-out-string + "":U
     1401                           .
     1402                       end.
     1403                       when chr(6)
     1404                       then do:
     1405                           assign
     1406                               p-out-string = p-out-string + "":U
     1407                           .
     1408                       end.
     1409                       when chr(7)
     1410                       then do:
     1411                           assign
     1412                               p-out-string = p-out-string + "":U
     1413                           .
     1414                       end.
     1415                       when chr(8)
     1416                       then do:
     1417                           assign
     1418                               p-out-string = p-out-string + "":U
     1419                           .
     1420                       end.
     1421                       when chr(9)
     1422                       then do:
     1423                           assign
     1424                               p-out-string = p-out-string + "":U
     1425                           .
     1426                       end.
     1427                       when chr(29)
     1428                       then do:
     1429                           assign
     1430                               p-out-string = p-out-string + "":U
     1431                           .
     1432                       end.
     1433                       when chr(10)
     1434                       then do:
     1435                           assign
     1436                               p-out-string = p-out-string + "&#10;":U
     1437                           .
     1438                       end.
     1439                       when chr(13)
     1440                       then do:
     1441                           assign
     1442                               p-out-string = p-out-string + "&#13;":U
     1443                           .
     1444                       end.
     1445                       otherwise do:
     1446                           assign
     1447                               p-out-string = p-out-string + v-current-char
     1448                           .
     1449                       end.
     1450                   end case.
     1451               end.
     1452           end.
     1453       end case.
     1454   end.
     1455   end .
     1456   procedure xmlchar-encode-1c :
     1457   define input parameter p-in-string      as character        no-undo.
     1458   define output parameter p-out-string    as character        no-undo.
     1459       define variable v-position      as integer      no-undo.
     1460       define variable v-current-char  as character    no-undo.
     1461   do
     1462   on error undo, return error
     1463   :
     1464       assign
     1465           p-out-string = "":U
     1466       .
     1467       case p-in-string
     1468       :
     1469           when ?
     1470           then do:
     1471               assign
     1472                   p-out-string = "?":U
     1473               .
     1474           end.
     1475           otherwise do:
     1476               do v-position = 1 to length( p-in-string )
     1477               :
     1478                   assign
     1479                       v-current-char = substring( p-in-string, v-position, 1 )
     1480                   .
     1481                   case v-current-char
     1482                   :
     1483                       when chr(1)
     1484                       then do:
     1485                           assign
     1486                               p-out-string = p-out-string + " ":U
     1487                           .
     1488                       end.
     1489                       when chr(2)
     1490                       then do:
     1491                           assign
     1492                               p-out-string = p-out-string + " ":U
     1493                           .
     1494                       end.
     1495                       when chr(3)
     1496                       then do:
     1497                           assign
     1498                               p-out-string = p-out-string + " ":U
     1499                           .
     1500                       end.
     1501                       when chr(4)
     1502                       then do:
     1503                           assign
     1504                               p-out-string = p-out-string + " ":U
     1505                           .
     1506                       end.
     1507                       when chr(5)
     1508                       then do:
     1509                           assign
     1510                               p-out-string = p-out-string + " ":U
     1511                           .
     1512                       end.
     1513                       when chr(6)
     1514                       then do:
     1515                           assign
     1516                               p-out-string = p-out-string + " ":U
     1517                           .
     1518                       end.
     1519                       when chr(7)
     1520                       then do:
     1521                           assign
     1522                               p-out-string = p-out-string + " ":U
     1523                           .
     1524                       end.
     1525                       when chr(8)
     1526                       then do:
     1527                           assign
     1528                               p-out-string = p-out-string + " ":U
     1529                           .
     1530                       end.
     1531                       when chr(9)
     1532                       then do:
     1533                           assign
     1534                               p-out-string = p-out-string + " ":U
     1535                           .
     1536                       end.
     1537                       when chr(29)
     1538                       then do:
     1539                           assign
     1540                               p-out-string = p-out-string + " ":U
     1541                           .
     1542                       end.
     1543                       when chr(10)
     1544                       then do:
     1545                           assign
     1546                               p-out-string = p-out-string + " ":U
     1547                           .
     1548                       end.
     1549                       when chr(13)
     1550                       then do:
     1551                           assign
     1552                               p-out-string = p-out-string + " ":U
     1553                           .
     1554                       end.
     1555                       otherwise do:
     1556                           assign
     1557                               p-out-string = p-out-string + v-current-char
     1558                           .
     1559                       end.
     1560                   end case.
     1561               end.
     1562           end.
     1563       end case.
     1564   end.
     1565   end .
     1566   procedure xmlchar-decode :
     1567   define input parameter p-in-string      as character        no-undo.
     1568   define output parameter p-out-string    as character        no-undo.
     1569       define variable v-position      as integer      no-undo.
     1570       define variable v-last-position as integer      no-undo.
     1571       define variable v-temp-integer  as integer      no-undo.
     1572       define variable v-current-char  as character    no-undo.
     1573       define variable v-next-char     as character    no-undo.
     1574       define variable v-success       as logical      no-undo.
     1575   do
     1576   on error undo, return error
     1577   :
     1578       assign
     1579           p-out-string = "":U
     1580           v-position   = 0
     1581       .
     1582       replace-cycle:
     1583       do while yes
     1584       on error undo, return error
     1585       :
     1586           assign
     1587               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1588           .
     1589           if v-last-position <= v-position
     1590           then do:
     1591               if v-position = 0
     1592               then do:
     1593                   assign
     1594                       p-out-string = p-in-string
     1595                   .
     1596               end.
     1597               else do:
     1598                   assign
     1599                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1600                   .
     1601               end.
     1602               leave replace-cycle.
     1603           end.
     1604           else do:
     1605               assign
     1606                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1607                   v-position      = v-last-position
     1608                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1609               .
     1610               if v-current-char = "#":U
     1611               then do:
     1612                   assign
     1613                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1614                   .
     1615                   if v-last-position > 0
     1616                   then do:
     1617                       run xmlchar-read-integer in this-procedure
     1618                        (
     1619                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1620                           , output v-temp-integer
     1621                           , output v-success
     1622                       ).
     1623                       if v-success = yes
     1624                       and v-temp-integer >= 1
     1625                       and v-temp-integer <= 255
     1626                       then do:
     1627                           assign
     1628                               p-out-string = p-out-string + chr( v-temp-integer )
     1629                               v-position   = v-last-position + 1
     1630                           .
     1631                       end.
     1632                       else do:
     1633                           assign
     1634                               p-out-string = p-out-string + "&":U
     1635                               v-position   = v-position   + 1
     1636                           .
     1637                       end.
     1638                   end.
     1639                   else do:
     1640                       assign
     1641                           p-out-string = p-out-string + "&":U
     1642                           v-position   = v-position   + 1
     1643                       .
     1644                   end.
     1645               end.
     1646               else do:
     1647                   case substring( p-in-string, v-position + 1, 3 )
     1648                   :
     1649                       when "lt;":U
     1650                       then do:
     1651                           assign
     1652                               p-out-string = p-out-string + "<":U
     1653                               v-position   = v-position   + 3
     1654                           .
     1655                       end.
     1656                       when "gt;":U
     1657                       then do:
     1658                           assign
     1659                               p-out-string = p-out-string + ">":U
     1660                               v-position   = v-position   + 3
     1661                           .
     1662                       end.
     1663                       otherwise do:
     1664                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1665                           then do:
     1666                               assign
     1667                                   p-out-string = p-out-string + "&":U
     1668                                   v-position   = v-position   + 4
     1669                               .
     1670                           end.
     1671                           else do:
     1672                               case substring( p-in-string, v-position + 1, 5 )
     1673                               :
     1674                                   when "quot;":U
     1675                                   then do:
     1676                                       assign
     1677                                           p-out-string = p-out-string + '"':U
     1678                                           v-position   = v-position   + 5
     1679                                       .
     1680                                   end.
     1681                                   when "apos;":U
     1682                                   then do:
     1683                                       assign
     1684                                           p-out-string = p-out-string + "'":U
     1685                                           v-position   = v-position   + 5
     1686                                       .
     1687                                   end.
     1688                                   otherwise do:
     1689                                       assign
     1690                                           p-out-string = p-out-string + "&":U
     1691                                       .
     1692                                   end.
     1693                               end case.
     1694                           end.
     1695                       end.
     1696                   end case.
     1697               end.
     1698           end.
     1699       end.
     1700   end.
     1701   end .
     1702   procedure xmlchar-read-integer :
     1703   define input parameter p-input-string      as character        no-undo.
     1704   define output parameter p-output-integer   as integer          no-undo.
     1705   define output parameter p-success       as logical          no-undo.
     1706   do
     1707   on error undo, return error
     1708   :
     1709       assign
     1710           p-output-integer = integer( p-input-string )
     1711       no-error.
     1712       if error-status :error
     1713       then do:
     1714           assign
     1715               p-success           = no
     1716               p-output-integer    = 0
     1717           .
     1718       end.
     1719       else do:
     1720           assign
     1721               p-success           = yes
     1722           .
     1723       end.
     1724   end.
     1725   end.
     1726   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1727   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1728   define new global shared variable g#attr-lib  as handle no-undo .
     1729   define variable v-attr-lib-variable as handle no-undo .
     1730   define variable mMRCCode  as logical    no-undo.
     1731   define variable mTypeMark as character  no-undo.
     1732   function IS-NeedMark returns logical
     1733   ( input ib-code as integer  ,
     1734     input ib-str as character ):
     1735      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1736      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1737                                    and buf_prod-bc-attr.b-str  eq ib-str
     1738                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1739        no-lock no-error.
     1740      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1741   end.
     1742   function repTegforDm return char
     1743   (iDM as char ):
     1744       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1745       define variable vteg as character no-undo.
     1746       define variable oDM as character no-undo.
     1747       define variable vi as integer no-undo.
     1748       oDM = iDm.
     1749       do vi = 1 to num-entries(vTeglist):
     1750          vTeg = entry(vi,vTeglist).
     1751          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1752       end.
     1753       return oDM.
     1754   end.
     1755   function repSpecSimbforDm return char
     1756   (iDM as char ):
     1757       define variable oDM as character no-undo.
     1758     run
     1759       xmlchar-decode(iDM, output oDM).
     1760     return repTegforDm (oDM).
     1761   end.
     1762   function CheckGtin return logical
     1763   (iGtin as char):
     1764      define variable bar_code as character no-undo.
     1765      define variable vGtin as logical no-undo init "yes".
     1766      if length(iGtin) eq 14
     1767      then do:
     1768         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1769         run str/chk-sum.p
     1770          (input-output bar_code ) no-error .
     1771         if iGtin ne  bar_code
     1772         then
     1773            vGtin = no.
     1774      end.
     1775      else
     1776         vGtin = no.
     1777      return vgtin.
     1778   end.
     1779   function repSpecSimbforXlm return char
     1780   (iDM as char ):
     1781       iDM = replace(iDM,chr(29),"").
     1782       return iDM.
     1783   end.
     1784   function getGtinByDM return char
     1785   (IDM as char):
     1786      define variable VTXT as char no-undo.
     1787      define variable vGtin as char no-undo.
     1788      vTXt = IdM.
     1789      vGtin = IDM.
     1790      if    length(vtxt) > 14
     1791      then do:
     1792         if   vtxt begins "(01)"
     1793                or vtxt begins "(02)"
     1794         then
     1795            vGtin = substring(vtxt,5,14).
     1796         else if   (vtxt begins "01"
     1797                or vtxt begins "02" )
     1798                and (   (    substring(iDm,17,2) eq "21"
     1799                         and length(vtxt) >= 21)
     1800                     or substring(iDm,17,2) eq "37"
     1801                     or substring(iDm,17,4) eq "(37)" )
     1802         then do:
     1803            vGtin = substring(vtxt,3,14).
     1804            if not checkGtin(vGtin)
     1805            then
     1806               vGtin = substring(vtxt,1,14).
     1807         end.
     1808         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1809             or length(vtxt) eq 14 + 7 + 4
     1810             or length(vtxt) eq 14 + 7
     1811         then
     1812            vGtin = substring(vtxt,1,14).
     1813      end.
     1814      if not checkGtin(vGtin)
     1815      then
     1816         vGtin = "".
     1817      return vgtin.
     1818   end.
     1819   function getGdsCodeByGtin return int
     1820   (iGtin as char):
     1821      define buffer prod-bc  for ub.prod-bc.
     1822      define buffer bar-code for ub.bar-code.
     1823      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1824      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1825      return if avail bar-code then bar-code.gds-code else ?.
     1826   end.
     1827   function getQntyCodeByGtin return decimal
     1828   (iGtin as char):
     1829      define buffer prod-bc  for ub.prod-bc.
     1830      define buffer bar-code for ub.bar-code.
     1831      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1832      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1833      return if avail bar-code then bar-code.cli-base-rate else ?.
     1834   end.
     1835   function getGdsCodeByDM return int
     1836   (iDm as char):
     1837      define variable vGtin as char no-undo.
     1838      define buffer prod-bc for ub.prod-bc.
     1839      vGtin  = getGtinByDM (IDM ).
     1840      return getGdsCodeByGtin (vGtin).
     1841   end.
     1842   function ChekTypeMarkByGds return logical
     1843   (iGds-code as integer ):
     1844      define buffer goods-attr for ub.goods-attr.
     1845      find first goods-attr where goods-attr.gds-code   = iGds-code
     1846                              and goods-attr.attr-code  = 'mark-type':U
     1847      no-lock no-error.
     1848      if available goods-attr
     1849      then do:
     1850         mTypeMark = goods-attr.attr-value.
     1851         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1852           .
     1853      end.
     1854      else
     1855         return no.
     1856   end.
     1857   function ChekTypeMarkByDm return logical
     1858   (iDM as char ):
     1859      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1860   end.
     1861   function ChekTypeMarkByGtin return logical
     1862   (iGtin as char ):
     1863      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1864   end.
     1865   function GetNextElement return character
     1866     (input iAllTeg        as logical
     1867     ,output oteg          as character
     1868     ,output otegval       as character
     1869     ,input-output pstr    as character
     1870      ):
     1871        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1872        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1873        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1874        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1875        define variable vTeg as character no-undo.
     1876        define variable vLength as integer no-undo.
     1877        define variable vi as integer no-undo.
     1878        define variable vj as integer no-undo.
     1879        define buffer code for ub.code.
     1880        find first code where Code.parent eq "MarkType"
     1881                          and Code.CodeValue   eq mTypeMark
     1882                          no-lock no-error.
     1883        if     available code
     1884           and Code.misc1 ne ""
     1885           and Code.misc1 ne ?
     1886        then do:
     1887           integer (Code.misc1) no-error.
     1888           if not error-status:error
     1889           then
     1890             entry (4,vlistleng) = Code.misc1.
     1891        end.
     1892        if iAllTeg
     1893        then
     1894           assign
     1895              vlistElem     = vlistElem    + vlistElemDop
     1896              vlistleng     = vlistleng    + vlistlengDop
     1897           .
     1898        else if mMRCCode
     1899        then
     1900           assign
     1901              vlistElem     = vlistElem    + ",(8005),8005"
     1902              vlistleng     = vlistleng    + ",000006,0006"
     1903           .
     1904       block-elem:
     1905       do vi = 1 to num-entries(vlistElem):
     1906          vTeg = entry(vi,vlistElem).
     1907          if pstr begins vTeg
     1908          then do:
     1909             if    vTeg eq "21"
     1910             then
     1911                vLength = index(pstr,chr(29)) - 2 no-error.
     1912             if vLength  <= 0
     1913             then
     1914                vLength = int(entry(vi,vlistleng)).
     1915             otegval = substring (pstr,length(vteg) + 1, vLength).
     1916             oteg = replace(replace(vteg,")",""),"(","").
     1917             vTeg = vteg + otegval.
     1918             otegval = replace(otegval,chr(29),"").
     1919             oteg = replace(replace(oteg,")",""),"(","").
     1920             pstr = substring (pstr,length(vTeg)+ 1).
     1921             vTeg = replace(vTeg,chr(29),"").
     1922             leave block-elem.
     1923          end.
     1924          else
     1925             vTeg = "".
     1926       end.
     1927       return vteg.
     1928   end.
     1929   function GetCodeIdent return character
     1930   (iDm as char):
     1931      define variable Velement   as character no-undo init "first".
     1932      define variable oCodeIdent as character no-undo.
     1933      define variable vteg as character no-undo.
     1934      define variable vtegval as character no-undo.
     1935      define variable vGtin as character no-undo.
     1936      define buffer marking for ub.marking.
     1937      for first marking no-lock where
     1938                marking.mark eq iDm
     1939            and marking.unit-ext = "LEVEL2"
     1940      :
     1941        return iDm.
     1942      end.
     1943      vGtin  = getGtinByDM (iDm ).
     1944      ChekTypeMarkByDm(idm).
     1945      if iDm begins 'tech_':U
     1946      then
     1947         oCodeIdent = iDm.
     1948      else if length(iDm) < 21
     1949      then do:
     1950         find first marking where marking.mark eq idm
     1951         no-lock no-error.
     1952         oCodeIdent = if available marking then marking.mark else  ?.
     1953      end.
     1954      else if     length(iDm) eq 29
     1955         and not iDm begins "01"
     1956         and not iDm begins "02"
     1957      then
     1958         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1959      else  if     length(iDm) >= 24
     1960               and (  iDm begins "01"
     1961                   or iDm begins "02")
     1962               and  substring(iDm,17,2) ne "21"
     1963      then do:
     1964         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1965                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1966         then
     1967            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1968         else
     1969            oCodeIdent = iDM.
     1970      end.
     1971      else  if     (   length(iDm) eq 25
     1972                    or length(iDm) eq 21)
     1973               and (not iDm begins "01"
     1974               and  not iDm begins "02")
     1975      then
     1976         oCodeIdent = substring(iDm,1,21).
     1977      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1978      then
     1979         oCodeIdent = substring(iDm,1,21).
     1980      else do while Velement ne "" and idm ne "":
     1981         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1982         oCodeIdent = oCodeIdent + Velement.
     1983      end.
     1984      return oCodeIdent.
     1985   end.
     1986   function GetTegCod return character
     1987   (icodeIdent as char, iTeg as char):
     1988      define variable Velement   as character no-undo init "first".
     1989      define variable oTeg as character no-undo init ?.
     1990      define variable vteg as character no-undo.
     1991      define variable vtegval as character no-undo.
     1992      if     ((length(icodeIdent) eq 21
     1993         and not icodeIdent begins "01"
     1994         and not icodeIdent begins "02")
     1995         or
     1996             ( length(icodeIdent) eq 25
     1997               and not icodeIdent begins "01"
     1998               and not icodeIdent begins "02"))
     1999      then do:
     2000         if iTeg eq "01" or iTeg eq "02"
     2001         then
     2002            oTeg = substring(icodeIdent,1,21).
     2003         else  if  iTeg eq "21"
     2004         then
     2005            oTeg = substring(icodeIdent,15,7).
     2006      end.
     2007      else do:
     2008         ChekTypeMarkByDm(icodeIdent).
     2009         block-teg:
     2010            do while Velement ne "" and icodeIdent ne "":
     2011            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2012            if    Velement begins iTeg
     2013               or Velement begins "(" + iTeg + ")"
     2014            then do:
     2015               oTeg = vtegval.
     2016               leave block-teg.
     2017            end.
     2018         end.
     2019      end.
     2020      return oTeg.
     2021   end.
     2022   function isOAD return logical
     2023   (icodeIdent as character):
     2024      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2025   end.
     2026   function isMark return logical
     2027   (icodeIdent as character):
     2028      define buffer buf_marking for ub.marking.
     2029      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2030             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2031   end.
     2032   function addBracketForCode return character
     2033   (icodeIdent as char):
     2034      define variable Velement   as character no-undo init "first".
     2035      define variable oTeg as character no-undo.
     2036      define variable vteg as character no-undo.
     2037      define variable vtegval as character no-undo.
     2038      define buffer marking for ub.marking.
     2039      find first marking no-lock where
     2040                 marking.mark begins icodeIdent no-error.
     2041      if    not ChekTypeMarkByDm(icodeIdent)
     2042         or length(icodeIdent) le 24
     2043         or (avail marking and marking.unit-ext = "LEVEL2")
     2044      then
     2045         oTeg = icodeIdent.
     2046      else do:
     2047         if (  icodeIdent begins "01"
     2048            or icodeIdent begins "02"
     2049            ) and CheckGtin(substring (icodeIdent,3,14))
     2050            and substring (icodeIdent,17,2) eq "21"
     2051         then do:
     2052            mMRCCode = yes.
     2053            ChekTypeMarkByDm(icodeIdent).
     2054            block-teg:
     2055            do while Velement ne "" and icodeIdent ne "":
     2056               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2057               if vteg ne ""
     2058               then
     2059                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2060            end.
     2061            mMRCCode = no.
     2062         end.
     2063         else do:
     2064            oTeg = icodeIdent.
     2065         end.
     2066      end.
     2067      return oTeg.
     2068   end.
     2069   function getlevelByCodId return int
     2070   (iCode as char):
     2071      define variable vLength as int no-undo.
     2072      define variable vLevel  as int no-undo.
     2073      if not ChekTypeMarkByDM (icode) then return ?.
     2074      vLength = length(iCode).
     2075      if    vLength eq 18
     2076         or vLength eq 20
     2077      then
     2078         Vlevel = 4.
     2079      else if vLength eq 21
     2080      then
     2081         Vlevel = 1.
     2082      else if vLength eq 25
     2083      then do:
     2084         if  iCode begins "01"
     2085         then
     2086            Vlevel = 3.
     2087         else
     2088            Vlevel = 1.
     2089      end.
     2090      else if     vLength >= 26
     2091              and vLength <= 46
     2092      then do:
     2093         if    substring(iCode,17,2) eq "11"
     2094            or substring(iCode,17,2) eq "13"
     2095            or (    substring(iCode,17,2) eq "21"
     2096                and vLength >= 33
     2097                and substring(iCode,26,4) ne "8005")
     2098         then
     2099            Vlevel = 4.
     2100         else if    vLength eq 31
     2101                 or vLength eq 38
     2102                 or vLength eq 39
     2103                 or vLength eq 45
     2104         then
     2105            Vlevel = 1.
     2106         else if    vLength eq 35
     2107                 or vLength eq 43
     2108         then
     2109            Vlevel = 3.
     2110         else
     2111            Vlevel = ?.
     2112      end.
     2113      else
     2114         Vlevel = ?.
     2115      return Vlevel.
     2116   end.
     2117   function getLevelMotpBycodid return character
     2118   (iDm as char):
     2119      define variable vLevel as integer no-undo.
     2120      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2121      vLevel = getlevelByCodId(iDm).
     2122      if    vLevel eq ?
     2123         or vLevel < 1
     2124         or vLevel > 6
     2125      then
     2126         return ?.
     2127      else
     2128         return entry(vlevel,vList).
     2129   end.
     2130   function getLevelUTDByLevelMotp return character
     2131   (iUnit as char):
     2132      define variable vLevel as integer no-undo.
     2133      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2134      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2135      vLevel = lookup(iUnit,vListMOTP).
     2136      if    vLevel eq ?
     2137         or vLevel < 1
     2138         or vLevel > 4
     2139      then
     2140         return ?.
     2141      else
     2142         return entry(vlevel,vListutd).
     2143   end.
     2144   function getLevelMotpByDM return character
     2145   (iDm as char):
     2146      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2147   end.
     2148   function getLevelUTDByCodId return character
     2149   (iDm as char):
     2150      define variable vLevel as integer no-undo.
     2151      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2152      vLevel = getlevelByCodId(iDm).
     2153      if    vLevel eq ?
     2154         or vLevel < 1
     2155         or vLevel > 4
     2156      then
     2157         return ?.
     2158      else
     2159         return entry(vlevel,vList).
     2160   end.
     2161   function getLevelUTDByDM return character
     2162   (iDm as char):
     2163      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2164   end.
     2165   define variable mNotMarkQnty as logical no-undo.
     2166   function getQntyUTDByCodId return decimal
     2167   (iDM as char):
     2168      define variable vLevel as integer no-undo.
     2169      define variable vList as character no-undo init "1,5,10,500".
     2170      define variable vGtin as character no-undo.
     2171      define variable vqnty as decimal no-undo init ?.
     2172      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2173      if vqnty eq ?
     2174      then do:
     2175         if not mNotMarkQnty
     2176         then do:
     2177            define buffer marking for ub.marking.
     2178            define variable vCodident as character no-undo.
     2179            vCodident = GetCodeIdent(idm).
     2180            find first marking where marking.mark begins vCodident no-lock no-error.
     2181            if     available marking
     2182               and marking.box-qnty ne ?
     2183            then
     2184               return marking.box-qnty.
     2185         end.
     2186         vGtin = getGtinByDm(iDM).
     2187         if ChekTypeMarkByGtin (vGtin)
     2188         then do:
     2189            vLevel = getlevelByCodId(iDM).
     2190            if     vLevel >= 1
     2191               and vLevel <= 4
     2192            then
     2193               vqnty = int(entry(vlevel,vList)).
     2194         end.
     2195         else
     2196            vqnty = getQntyCodeByGtin(vgtin).
     2197      end.
     2198      return vqnty.
     2199   end.
     2200   function getQntyUTDByDM return decimal
     2201   (iDm as char):
     2202      define variable vDM as character no-undo.
     2203      if     length (iDm) ne 25
     2204         and length (iDm) ne 29
     2205         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2206      then
     2207         vDM = substring (iDm,1,length (iDm) - 6 ).
     2208      else
     2209         vDM = substring (iDm,1,length (iDm) - 4 ).
     2210      return getQntyUTDByCodId(vDM).
     2211   end.
     2212   function getMRC4 return decimal
     2213   (iMRC as char):
     2214      define variable oMrc     as decimal no-undo init ?.
     2215      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2216      define variable vi       as integer no-undo.
     2217      define variable vfound   as integer no-undo.
     2218      define variable vposStart   as integer no-undo.
     2219      do:
     2220      OMRc = 0.
     2221      do vi = 1 to 4:
     2222         define variable vsimb as character no-undo.
     2223         vsimb = substring(iMRC,vi,1).
     2224         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2225         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2226         if vfound > 0
     2227         then
     2228            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2229         end.
     2230         OMRc = OMRc / 100.
     2231      end.
     2232      return OMRc.
     2233   end.
     2234   function getMRCByDM return decimal
     2235   (iDm as char):
     2236      define variable vMRC     as character no-undo.
     2237      define variable oMrc     as decimal no-undo init ?.
     2238      define variable Velement as character no-undo init "empty".
     2239      define variable vteg as character no-undo.
     2240      define variable vtegval as character no-undo.
     2241      if    length(idm) eq 14 + 7 + 4 + 4
     2242         or length(idm) eq 14 + 7 + 4
     2243      then do:
     2244         vMRC = substring(idm,22,4).
     2245         omrc = getMRC4(vMRC).
     2246      end.
     2247      else do:
     2248          ChekTypeMarkByDm(iDm).
     2249          block-mrc:
     2250          do while Velement ne "" and idm ne "":
     2251             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2252             if Velement begins "8005"
     2253             then do:
     2254                vMRC = substring(Velement,5,6).
     2255                leave block-mrc.
     2256             end.
     2257             else if Velement begins "(8005)"
     2258             then do:
     2259                vMRC = substring(Velement,7,6).
     2260                leave block-mrc.
     2261             end.
     2262          end.
     2263          if vMRC ne ""
     2264          then
     2265             OMRc = dec(vmrc) / 100 no-error.
     2266      end.
     2267      return OMRc.
     2268   end.
     2269   function MoveDate return Date
     2270   (idate as date,
     2271    iMonth as int64):
     2272      define variable vMonth   as int64 no-undo.
     2273      define variable vYear    as int64 no-undo.
     2274      define variable vDateNew as date  no-undo.
     2275       define variable vDay     as int64 no-undo.
     2276       vMonth = month(iDate) + iMonth.
     2277       vYear =  year(iDate).
     2278       if vMonth <= 0
     2279       then assign
     2280          vMonth = vMonth + 12
     2281           vYear  = vYear - 1
     2282       .
     2283       else if vMonth > 12
     2284       then assign
     2285          vMonth = vMonth - 12
     2286           vYear  = vYear + 1
     2287       .
     2288       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2289       do while error-status:error eq yes:
     2290          VDay = vDay + 1.
     2291          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2292       end.
     2293       if VDay > 0
     2294       then
     2295          vDateNew + 1.
     2296       return vDateNew.
     2297   end.
     2298   procedure checkEMRC:
     2299   define input  parameter iDm as character no-undo.
     2300   define output parameter vok as logical   no-undo init yes.
     2301      define variable v-value-emrc as character no-undo.
     2302      define variable v-type-emrc  as character no-undo.
     2303      define variable vDateIso     as character no-undo.
     2304      define variable vMRC         as decimal no-undo.
     2305      define variable vqnty        as decimal no-undo.
     2306      define variable vPrice       as decimal no-undo.
     2307      define variable vparent      as character no-undo.
     2308      define variable vgds-code    as integer no-undo.
     2309      define buffer code for ub.code.
     2310      vMRC = getMRCByDM(iDm).
     2311      if vMRC > 0
     2312      then do:
     2313         vgds-code = getGdsCodeByDM(iDm).
     2314         vqnty     = getQntyUTDByDM(iDm).
     2315               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2316            (
     2317             input   vgds-code
     2318            ,input   'emrc-type':U
     2319            ,output   v-value-emrc
     2320            ,output   v-type-emrc
     2321          ) no-error.
     2322          if     v-value-emrc ne ""
     2323             and v-value-emrc ne ?
     2324          then do:
     2325             vDateIso = iso-date(today).
     2326             vPrice = vMRC / vqnty.
     2327             vparent ="emc" + chr(4) + v-value-emrc.
     2328             find last code where Code.parent      eq vparent
     2329                              and Code.code        le vDateIso
     2330                              and code.status_  eq 0
     2331             no-lock no-error.
     2332             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2333             then
     2334                vOk = true .
     2335             else do:
     2336                 define variable vText      as character no-undo.
     2337                 define variable vDate      as date no-undo.
     2338                 define variable vDateLast  as character no-undo.
     2339                 define variable vDateFirst as character no-undo.
     2340                 define variable vDate3     as date no-undo.
     2341                 vdate = date(code.misc1).
     2342                 vDateLast = code.misc1.
     2343                 vDate3 = MoveDate(today, - 3 ).
     2344                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2345                                      string(vDate3  , "99/99/9999"),
     2346                                      string(vDate   , "99/99/9999")
     2347                                      ).
     2348                 vdateIso = iso-date(vdate3).
     2349                 find last code  where Code.parent      eq vparent
     2350                                   and Code.code        le vDateIso
     2351                                   and code.status_  eq 0 no-lock no-error.
     2352                 if available code
     2353                 then
     2354                    vDateIso = code.code.
     2355                 vDateFirst = vDateIso.
     2356                 vDateLast = iso-date(vdate).
     2357                 define variable vGood as logical no-undo.
     2358                 define variable vDateSale as date no-undo.
     2359                 define buffer bcode for code.
     2360                 for last code where Code.parent   eq vparent
     2361                                 and code.status_  eq 0
     2362                                 and code.code     < vDateLast
     2363                                 and code.code     >= vDateFirst
     2364                 no-lock:
     2365                    find first bcode where bCode.parent   eq vparent
     2366                                       and bcode.status_  eq 0
     2367                                       and bcode.code     > code.code no-lock no-error.
     2368                    if available bcode
     2369                    then do:
     2370                       if vPrice < dec(Code.CodeValue)
     2371                       then
     2372                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2373                                                     chr(10),
     2374                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2375                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2376                                                     ).
     2377                       else do:
     2378                          vGood = yes.
     2379                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2380                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2381                                                     chr(10),
     2382                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2383                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2384                                                     string(         vDateSale            ,"99/99/9999"),
     2385                                                     string(vDateSale - today)
     2386                                                     ).
     2387                       end.
     2388                    end.
     2389                 end.
     2390                 if vgood
     2391                 then do:
     2392                    define variable choice as integer no-undo .
     2393                    run gbl/d-askw.w (input "Уточнение"
     2394                           ,input  vText
     2395                           ,input "|"
     2396                           ,input "Принять|Вернуть"
     2397                           ,input "Принять данный товар|Вернуть товар постащику"
     2398                           ,input 1
     2399                           ,input 2
     2400                           ,output choice) no-error.
     2401                    vok = choice eq 1.
     2402                 end.
     2403                 else
     2404                    vok =false.
     2405             end.
     2406          end.
     2407      end.
     2408   end.
     2409   function addGs2Mark return character
     2410   (iMark as char):
     2411      define variable vDM   as character no-undo.
     2412      define variable vIdx  as integer   no-undo.
     2413      if index(iMark,chr(29),1) > 0
     2414      then return iMark.
     2415      if substring(iMark,26,4) = "8005" then
     2416      do:
     2417        vIdx = index(iMark,"93",26 + 4 + 5).
     2418        if vIdx > 1 then do:
     2419          vDM = substitute("&1&4&2&4&3",
     2420                           substring(iMark,1,25),
     2421                           substring(iMark,26,vIdx - 25 - 1),
     2422                           substring(iMark,vIdx),
     2423                           chr(29)) no-error.
     2424          vIdx = index(vDm,"240",vIdx + 4).
     2425          if vIdx > 0 then
     2426          do:
     2427            vDM = substitute("&1&3&2",
     2428                             substring(vDm,1,vIdx - 1),
     2429                             substring(vDm,vIdx),
     2430                             chr(29)) no-error.
     2431          end.
     2432        end.
     2433        else
     2434          vDM = substitute("&1&3&2",
     2435                           substring(iMark,1,25),
     2436                           substring(iMark,26),
     2437                           chr(29)) no-error.
     2438      end.
     2439      else if substring(iMark,32,2) = "91" then
     2440      do:
     2441        vIdx = index(iMark,"92",32).
     2442        if vIdx > 1 then
     2443          vDM = substitute("&1&4&2&4&3",
     2444                           substring(iMark,1,31),
     2445                           substring(iMark,32,vIdx - 31 - 1),
     2446                           substring(iMark,vIdx),
     2447                           chr(29)) no-error.
     2448        else
     2449          vDM = substitute("&1&3&2",
     2450                           substring(iMark,1,31),
     2451                           substring(iMark,32),
     2452                           chr(29)) no-error.
     2453      end.
     2454      else if substring(iMark,39,2) = "91" then
     2455      do:
     2456        vIdx = index(iMark,"92",38).
     2457        if vIdx > 1 then
     2458          vDM = substitute("&1&4&2&4&3",
     2459                           substring(iMark,1,38),
     2460                           substring(iMark,39,vIdx - 38 - 1),
     2461                           substring(iMark,vIdx),
     2462                           chr(29)) no-error.
     2463        else
     2464          vDM = substitute("&1&3&2",
     2465                           substring(iMark,1,38),
     2466                           substring(iMark,39),
     2467                           chr(29)) no-error.
     2468      end.
     2469      else if substring(iMark,25,2) = "93" then
     2470      do:
     2471        vIdx = index(iMark,"92",25).
     2472        if vIdx > 1 then
     2473          vDM = substitute("&1&4&2&4&3",
     2474                           substring(iMark,1,24),
     2475                           substring(iMark,25,vIdx - 24 - 1),
     2476                           substring(iMark,vIdx),
     2477                           chr(29)) no-error.
     2478        else
     2479          vIdx = index(iMark,"3103",25).
     2480          if vIdx > 0 then
     2481          vDM = substitute("&1&4&2&4&3",
     2482                           substring(iMark,1,24),
     2483                           substring(iMark,25,vIdx - 24 - 1),
     2484                           substring(iMark,vIdx),
     2485                           chr(29)) no-error.
     2486          else
     2487            vDM = substitute("&1&3&2",
     2488                             substring(iMark,1,24),
     2489                             substring(iMark,25),
     2490                             chr(29)) no-error.
     2491      end.
     2492      else if substring(iMark,32,2) = "93" then
     2493      do:
     2494        vDM = substitute("&1&3&2",
     2495              substring(iMark,1,31),
     2496              substring(iMark,32),
     2497              chr(29)) no-error.
     2498      end.
     2499      return if vDM <> "" then vDm else iMark.
     2500   end.
     2501   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2502   procedure partcopy :
     2503     define input parameter  p-free-output-copy as logical   no-undo .
     2504     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     2505     define parameter buffer buf_orig_parts     for ub.parts .
     2506     define parameter buffer buf_parts          for ub.parts .
     2507     define input parameter  p-mark             as character no-undo .
     2508     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     2509     define variable v-value-character as character no-undo .
     2510     define variable v-value-date      as date no-undo .
     2511     define variable v-value-decimal   as decimal no-undo .
     2512     define variable v-value-integer   as integer no-undo .
     2513     define variable v-izlcstpr        as logical no-undo .
     2514     define variable v-tth             as handle no-undo .
     2515     define variable v-type            as character no-undo .
     2516     define variable part-key-rec      as character no-undo .
     2517     define variable orig-part-key-rec as character no-undo .
     2518     define variable del-part-key-rec  as character no-undo .
     2519     define variable objMarks as class excisemarks  no-undo .
     2520     define variable v-parent-mark-sts as integer   no-undo .
     2521     define variable v-mark-sts-list   as character no-undo .
     2522     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     2523     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     2524     define buffer buf_gen-attr for ub.gen-attr .
     2525     define buffer buf1_gen-attr for ub.gen-attr .
     2526     define buffer buf_doc-line  for ub.doc-line .
     2527     define buffer buf_marking for ub.marking .
     2528     define buffer buf_marking-childs for ub.marking .
     2529     define buffer orig_marking-lines for ub.marking-lines .
     2530     define buffer orig_marking-lines-childs for ub.marking-lines .
     2531     define buffer buf_marking-lines for ub.marking-lines .
     2532     define buffer buf_marking-lines-childs for ub.marking-lines .
     2533     define buffer buf_marking-pack for ub.marking .
     2534     define buffer buf_marking-chk for ub.marking-chk .
     2535     define buffer buf_goods for ub.goods .
     2536     define buffer buf_trn-doc for ub.trn-doc .
     2537     define buffer pri_trn-doc for ub.trn-doc .
     2538     define buffer buf_chk-doc for ub.chk-doc .
     2539     do
     2540     on error undo, return error return-value
     2541     :
     2542       if p-free-output-copy = true
     2543       then do:
     2544         if  p-out-code <> 'free-zone':U
     2545         and p-out-code <> 'out-zone':U
     2546         then do:
     2547           message
     2548             vss-workfile vss-revision vss-description skip
     2549             vss-include-info8 skip
     2550             "Ошибка задания входных параметров процедуры partcopy" skip
     2551             "p-free-output-copy" p-free-output-copy skip
     2552             "p-out-code" p-out-code skip
     2553             view-as alert-box error .
     2554           undo, return error .
     2555         end.
     2556       end.
     2557       if buf_orig_parts.out-code <> p-out-code
     2558       then do:
     2559         find first buf_parts exclusive-lock
     2560           where buf_parts.obj-type  = buf_orig_parts.obj-type
     2561             and buf_parts.obj-code  = buf_orig_parts.obj-code
     2562             and buf_parts.artic     = buf_orig_parts.artic
     2563             and buf_parts.prod-type = buf_orig_parts.prod-type
     2564             and buf_parts.prod-code = buf_orig_parts.prod-code
     2565             and buf_parts.in-code   = buf_orig_parts.in-code
     2566             and buf_parts.out-code  = p-out-code
     2567             and buf_parts.part-code = buf_orig_parts.part-code
     2568           no-error.
     2569         if not available buf_parts
     2570         then do:
     2571           define variable v-rsrv-free as logical   no-undo .
     2572           if p-out-code = 'free-zone':U
     2573           or p-out-code = 'out-zone':U
     2574           then do:
     2575             assign
     2576               v-rsrv-free =
     2577          (if p-out-code = 'free-zone':U then yes else no)
     2578             .
     2579           end.
     2580           else do:
     2581             assign
     2582               v-rsrv-free = ?
     2583             .
     2584           end.
     2585           create buf_parts .
     2586           buffer-copy buf_orig_parts to buf_parts
     2587           assign
     2588             buf_parts.out-code  = p-out-code
     2589             buf_parts.status_   = no
     2590             buf_parts.rsrv-free = v-rsrv-free
     2591             buf_parts.qnty      = 0
     2592             buf_parts.fact-qnty = 0
     2593             buf_parts.real-qnty = 0
     2594             buf_parts.cli-qnty  = 0
     2595           .
     2596           validate buf_parts .
     2597         end.
     2598         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2599                                           ,input (buffer buf_orig_parts:handle)
     2600                                           ,output orig-part-key-rec).
     2601         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2602                                           ,input (buffer buf_parts:handle)
     2603                                           ,output part-key-rec).
     2604         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     2605               and ub.gen-attr.p-key =  orig-part-key-rec:
     2606             if not valid-object (objMarks)
     2607               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     2608               if p-out-code = 'free-zone':U
     2609               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     2610                then
     2611               do:
     2612                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     2613                   if objMarks:StatusErr
     2614                       then
     2615                   do:
     2616                       message objMarks:ReturnMsg view-as alert-box error.
     2617                       delete object objMarks no-error.
     2618                       undo, return error.
     2619                   end.
     2620               end.
     2621             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     2622             do:
     2623                 if p-mark <> "" then do:
     2624                 if p-out-code = 'free-zone':U then do:
     2625                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     2626                 end.
     2627                 else do:
     2628                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     2629                 end.
     2630                 if objMarks:StatusErr
     2631                   then
     2632                 do:
     2633                   message objMarks:ReturnMsg view-as alert-box error.
     2634                   delete object objMarks no-error.
     2635                   undo, return error.
     2636                 end.
     2637               end.
     2638             end.
     2639             if p-out-code = 'out-zone':U then
     2640             do:
     2641                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     2642                 if objMarks:StatusErr
     2643                     then
     2644                 do:
     2645                     message objMarks:ReturnMsg view-as alert-box error.
     2646                     delete object objMarks no-error.
     2647                     undo, return error.
     2648                 end.
     2649             end.
     2650         end.
     2651         delete object objMarks no-error.
     2652         if p-mark = "news" then return .
     2653         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     2654         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     2655         if not available buf_trn-doc
     2656         then
     2657            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     2658         if (
     2659             p-out-code = 'free-zone':U
     2660             and buf_orig_parts.in-code = buf_orig_parts.out-code
     2661            )
     2662         or
     2663            (
     2664             p-out-code = 'free-zone':U
     2665             and available pri_trn-doc
     2666             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     2667            )
     2668         or
     2669            (
     2670             available buf_trn-doc
     2671             and p-out-code = buf_trn-doc.doc-code
     2672             and buf_trn-doc.ext-doc-type = 'vt':U
     2673            )
     2674         or
     2675            (
     2676             p-mark = ""
     2677             and available buf_trn-doc
     2678             and p-out-code = 'free-zone':U
     2679             and buf_trn-doc.ext-doc-type = 'vt':U
     2680            )
     2681         or
     2682            (
     2683             p-mark = ""
     2684             and available buf_trn-doc
     2685             and p-out-code = 'free-zone':U
     2686             and buf_trn-doc.ext-doc-type = 'rs':U
     2687            )
     2688         then do :
     2689           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     2690             and ub.goods.prod-type = buf_parts.prod-type
     2691             and ub.goods.prod-code = buf_parts.prod-code.
     2692           def buffer buf_orig_ml for ub.marking-lines.
     2693           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
     2694             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     2695             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     2696             and buf_orig_ml.in-code = buf_orig_parts.in-code
     2697             and buf_orig_ml.out-code = buf_orig_parts.out-code
     2698             and buf_orig_ml.part-code = buf_orig_parts.part-code
     2699             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     2700             if available pri_trn-doc
     2701             and pri_trn-doc.ext-doc-type = 'iv':U
     2702             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     2703             then do :
     2704               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     2705                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     2706               end .
     2707               next .
     2708             end .
     2709             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     2710                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     2711                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     2712                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     2713                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     2714                                                   and ub.marking-lines.out-code = p-out-code
     2715                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     2716                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     2717                                                   no-error .
     2718             if not available ub.marking-lines
     2719             then do :
     2720               create ub.marking-lines.
     2721               buffer-copy buf_orig_ml to ub.marking-lines
     2722               assign
     2723                 ub.marking-lines.out-code  = p-out-code
     2724                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     2725               .
     2726               validate ub.marking-lines.
     2727             end .
     2728             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     2729             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     2730               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     2731               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     2732                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     2733                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     2734                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     2735                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     2736               then do:
     2737                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2738                 validate buf_marking.
     2739               end.
     2740             end .
     2741           end .
     2742           end.
     2743         end .
     2744         define variable v-doc-type  as character no-undo .
     2745         define variable   v-status    as character no-undo .
     2746         define variable v-fact-qnty   as  decimal no-undo .
     2747         define variable ii    as integer no-undo .
     2748         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     2749                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     2750                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     2751                                        .
     2752         if available pri_trn-doc
     2753         and pri_trn-doc.ext-doc-type = 'rs':U
     2754         then do :
     2755           if p-mark <> ""
     2756           then do :
     2757           end .
     2758           else do :
     2759           end .
     2760         end .
     2761         else do :
     2762           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     2763           and p-mark <> ""
     2764           then do :
     2765             if p-out-code = 'free-zone':U
     2766             then do:
     2767                 if chg-qnty < 0
     2768                 then do :
     2769                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     2770                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     2771                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2772                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2773                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2774                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2775                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2776                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2777                                                           no-error .
     2778                   if available orig_marking-lines
     2779                   then do :
     2780                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     2781                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     2782                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     2783                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     2784                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     2785                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     2786                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     2787                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     2788                                                            no-error .
     2789                     if not available buf_marking-lines
     2790                     then do :
     2791                       create buf_marking-lines .
     2792                       assign
     2793                         buf_marking-lines.mark       = p-mark
     2794                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2795                         buf_marking-lines.gds-code   = buf_goods.gds-code
     2796                         buf_marking-lines.obj-type   = buf_parts.obj-type
     2797                         buf_marking-lines.obj-code   = buf_parts.obj-code
     2798                         buf_marking-lines.in-code    = buf_parts.in-code
     2799                         buf_marking-lines.out-code   = buf_parts.out-code
     2800                         buf_marking-lines.part-code  = buf_parts.part-code
     2801                         buf_marking-lines.prt-code   = buf_parts.prt-code
     2802                       .
     2803                       validate buf_marking-lines.
     2804                     end .
     2805                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     2806                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2807                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     2808                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     2809                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     2810                                                         :
     2811                           assign buf_marking-chk.sts = 0 .
     2812                           validate buf_marking-chk.
     2813                         end .
     2814                       end .
     2815                       if buf_marking.unit-ext <> "UNIT" or
     2816                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     2817                       then do :
     2818                         run addChildMarkingLines in this-procedure (
     2819                           buf_marking.mark,
     2820                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     2821                           buffer buf_marking-lines,
     2822                           buffer buf_parts,
     2823                           buffer orig_marking-lines,
     2824                           buffer buf_orig_parts,
     2825                           buffer buf_goods
     2826                         ).
     2827                       end .
     2828                     end.
     2829                     find current orig_marking-lines exclusive-lock .
     2830                     delete orig_marking-lines .
     2831                   end .
     2832                 end .
     2833             end.
     2834             else do:
     2835               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     2836                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     2837                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2838                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2839                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2840                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2841                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2842                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2843                                                              no-error .
     2844                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     2845                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     2846                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     2847                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     2848                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     2849                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     2850                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     2851                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     2852                                                         no-error .
     2853                 if not available buf_marking-lines
     2854                 then do :
     2855                   create buf_marking-lines .
     2856                   assign
     2857                     buf_marking-lines.mark       = p-mark
     2858                     buf_marking-lines.doc-level  = 1
     2859                     buf_marking-lines.gds-code   = buf_goods.gds-code
     2860                     buf_marking-lines.obj-type   = buf_parts.obj-type
     2861                     buf_marking-lines.obj-code   = buf_parts.obj-code
     2862                     buf_marking-lines.in-code    = buf_parts.in-code
     2863                     buf_marking-lines.out-code   = buf_parts.out-code
     2864                     buf_marking-lines.part-code  = buf_parts.part-code
     2865                     buf_marking-lines.prt-code   = buf_parts.prt-code
     2866                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     2867                   .
     2868                   validate buf_marking-lines.
     2869                 end .
     2870                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     2871                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     2872                   validate buf_marking.
     2873                   for first buf_marking-childs exclusive-lock where
     2874                             buf_marking-childs.mark = buf_marking.mark-parent:
     2875                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     2876                     validate buf_marking-childs.
     2877                   end.
     2878                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     2879                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     2880                                                     and buf_chk-doc.out-code = buf_parts.out-code
     2881                                                     :
     2882                       if buf_marking-chk.sts <> 2 then
     2883                       do:
     2884                          assign buf_marking-chk.sts = 1 .
     2885                          validate buf_marking-chk.
     2886                       end.
     2887                     end .
     2888                   end .
     2889                   if buf_marking.unit-ext <> "UNIT" or
     2890                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     2891                   then do :
     2892                     run addChildMarkingLines in this-procedure (
     2893                       buf_marking.mark,
     2894                       buf_marking.sts,
     2895                       buffer buf_marking-lines,
     2896                       buffer buf_parts,
     2897                       buffer orig_marking-lines,
     2898                       buffer buf_orig_parts,
     2899                       buffer buf_goods
     2900                     ).
     2901                   end .
     2902                 end.
     2903                 if available orig_marking-lines then
     2904                   delete orig_marking-lines .
     2905             end.
     2906           end.
     2907         end .
     2908         if p-out-code = 'out-zone':U
     2909         and trim(p-mark) = ""
     2910         then do :
     2911           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     2912                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2913                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2914                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2915                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2916                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2917                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2918                                                 :
     2919             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     2920                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     2921                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     2922                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     2923                                                     and buf_marking-lines.out-code   = p-out-code
     2924                                                     no-error .
     2925             if available buf_marking-lines
     2926             then do :
     2927               find current buf_marking-lines exclusive-lock .
     2928               delete buf_marking-lines .
     2929               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     2930                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     2931                 then do :
     2932                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2933                   validate buf_marking.
     2934                 end.
     2935               end .
     2936             end .
     2937             else do :
     2938               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     2939               create buf_marking-lines .
     2940               assign
     2941                 buf_marking-lines.mark       = orig_marking-lines.mark
     2942                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2943                 buf_marking-lines.gds-code   = buf_goods.gds-code
     2944                 buf_marking-lines.obj-type   = buf_parts.obj-type
     2945                 buf_marking-lines.obj-code   = buf_parts.obj-code
     2946                 buf_marking-lines.in-code    = buf_parts.in-code
     2947                 buf_marking-lines.out-code   = buf_parts.out-code
     2948                 buf_marking-lines.part-code  = buf_parts.part-code
     2949                 buf_marking-lines.prt-code   = buf_parts.prt-code
     2950               .
     2951               validate buf_marking-lines.
     2952               if buf_parts.out-code <> buf_parts.in-code
     2953               and buf_parts.out-code <> 'free-zone':U
     2954               and buf_parts.out-code <> 'out-zone':U
     2955               then do :
     2956                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     2957                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     2958               end .
     2959               end.
     2960             end .
     2961             release buf_marking-lines no-error .
     2962           end.
     2963         end .
     2964         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     2965         then do:
     2966           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     2967                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     2968                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2969                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2970                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2971                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2972                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2973                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2974                                                   .
     2975             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     2976                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     2977                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     2978                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     2979                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     2980                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     2981                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     2982                                                    no-error .
     2983             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     2984               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     2985                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     2986               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     2987                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     2988               validate ub.marking.
     2989             end.
     2990             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     2991             if available (buf_marking-lines)
     2992             then do:
     2993               assign
     2994                 buf_marking-lines.mark       = p-mark
     2995                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2996                 buf_marking-lines.gds-code   = buf_goods.gds-code
     2997                 buf_marking-lines.obj-type   = buf_parts.obj-type
     2998                 buf_marking-lines.obj-code   = buf_parts.obj-code
     2999                 buf_marking-lines.in-code    = buf_parts.in-code
     3000                 buf_marking-lines.out-code   = buf_parts.out-code
     3001                 buf_marking-lines.part-code  = buf_parts.part-code
     3002               .
     3003               validate buf_marking-lines.
     3004             end.
     3005           end.
     3006         end.
     3007       end.
     3008       else do:
     3009         find first buf_parts exclusive-lock
     3010           where recid(buf_parts) = recid(buf_orig_parts)
     3011           .
     3012       end.
     3013       if p-out-code = 'free-zone':U
     3014       or p-out-code = 'out-zone':U
     3015       then do:
     3016         if buf_parts.rsrv-free <>
     3017          (if buf_parts.out-code = 'free-zone':U then yes else no)
     3018         then do:
     3019           message
     3020             vss-workfile vss-revision vss-description skip
     3021             vss-include-info8 skip
     3022             "Ошибка типа резерва партии" skip
     3023             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     3024             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     3025             "Партия" buf_parts.in-code buf_parts.part-code skip
     3026             "Резерв" buf_parts.out-code skip
     3027             "Статус" buf_parts.status_ skip
     3028             "Тип резерва" buf_parts.rsrv-free skip
     3029             view-as alert-box error .
     3030           undo, return error .
     3031         end.
     3032       end.
     3033     end.
     3034   end procedure.
     3035   procedure partcopy-to-childs-mark :
     3036     define parameter buffer buf_ml for ub.marking-lines .
     3037     define parameter buffer buf_orig-ml for ub.marking-lines .
     3038     define input parameter p-out-code as character no-undo .
     3039     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     3040     define buffer buf_ml-childs for ub.marking-lines .
     3041     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     3042       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     3043         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     3044       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     3045         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     3046       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     3047         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     3048         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     3049         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     3050         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     3051         and buf_ml-childs.part-code = buf_orig-ml.part-code
     3052         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     3053         :
     3054         assign
     3055           buf_ml-childs.out-code  = p-out-code
     3056         .
     3057         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     3058       end.
     3059     end.
     3060   end.
     3061   procedure partcopy-update-parts :
     3062     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     3063     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     3064     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     3065     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     3066     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     3067     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     3068     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     3069     define buffer buf_trn-doc for ub.trn-doc .
     3070     define buffer archive_parts for ub.parts .
     3071     define buffer buf_parts   for ub.parts .
     3072     define buffer orig_marking-lines for ub.marking-lines .
     3073     define buffer buf_marking for ub.marking .
     3074     define buffer buf_goods for ub.goods .
     3075     define variable v-rsrv-code     as character no-undo .
     3076     define variable v-goods-twounit as logical   no-undo .
     3077     define variable v-value-character as character no-undo .
     3078     define variable v-value-date      as date no-undo .
     3079     define variable v-value-decimal   as decimal no-undo .
     3080     define variable v-value-integer   as integer no-undo .
     3081     define variable v-izlcstpr        as logical no-undo .
     3082     define variable v-tth             as handle no-undo .
     3083     define variable v-type            as character no-undo .
     3084     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     3085     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     3086     do
     3087     on error undo, return error return-value
     3088     :
     3089       find first buf_trn-doc no-lock
     3090         where buf_trn-doc.doc-code = p-doc-code
     3091         no-error .
     3092       if not available buf_trn-doc
     3093       then do:
     3094         message
     3095           vss-workfile vss-revision vss-description skip
     3096           vss-include-info8 skip
     3097           "Ошибка задания входных параметров" skip
     3098           "Не найден документ" skip
     3099           "Документ" p-doc-code skip
     3100           "Объект" p-obj-type p-obj-code skip
     3101           "Артикул" p-artic p-prod-type p-prod-code skip
     3102           error-status :get-message(1) skip
     3103           return-value skip
     3104           view-as alert-box error .
     3105         undo, return error .
     3106       end.
     3107       find first buf_goods no-lock where buf_goods.artic = p-artic
     3108                                      and buf_goods.prod-type = p-prod-type
     3109                                      and buf_goods.prod-code = p-prod-code
     3110                                      no-error .
     3111       if not available buf_goods
     3112       then do:
     3113         message
     3114           vss-workfile vss-revision vss-description skip
     3115           vss-include-info8 skip
     3116           "Ошибка задания входных параметров" skip
     3117           "Не найден товар" skip
     3118           "Документ" p-doc-code skip
     3119           "Объект" p-obj-type p-obj-code skip
     3120           "Артикул" p-artic p-prod-type p-prod-code skip
     3121           error-status :get-message(1) skip
     3122           return-value skip
     3123           view-as alert-box error .
     3124         undo, return error .
     3125       end.
     3126       if buf_trn-doc.ext-doc-type = 'vt':U
     3127       then do :
     3128           delete object v-tth no-error.
     3129           run adm/shattri.p (
     3130              input "get":U
     3131             ,input buf_trn-doc.obj-type
     3132             ,input buf_trn-doc.obj-code
     3133             ,input 'inv-obj':U
     3134             ,input  "izlcstpr"
     3135             ,output v-value-character
     3136             ,output v-value-date
     3137             ,output v-value-decimal
     3138             ,output v-value-integer
     3139             ,output v-izlcstpr
     3140             ,output v-type
     3141             ,INPUT-OUTPUT table-handle v-tth
     3142             ) no-error .
     3143             delete object v-tth no-error.
     3144           if error-status:error then do:
     3145             v-izlcstpr = false .
     3146           end.
     3147       end.
     3148       else do :
     3149           v-izlcstpr = false .
     3150       end.
     3151   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3152   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     3153     (input  p-artic
     3154     ,input  p-prod-type
     3155     ,input  p-prod-code
     3156     ,input  'twounit=request':u
     3157     ,output v-goods-twounit
     3158     ) no-error .
     3159       if error-status :error
     3160       then do:
     3161         message
     3162           vss-workfile vss-revision vss-description skip
     3163           vss-include-info8 skip
     3164           "Ошибка при определении атрибута товара" skip
     3165           "Артикул" p-artic p-prod-type p-prod-code skip
     3166           error-status :get-message(1) skip
     3167           return-value skip
     3168           view-as alert-box error .
     3169         undo, return error .
     3170       end.
     3171       define query partcopy-select-parts for archive_parts .
     3172       open query partcopy-select-parts preselect each archive_parts
     3173         where archive_parts.obj-type  = p-obj-type
     3174           and archive_parts.obj-code  = p-obj-code
     3175           and archive_parts.artic     = p-artic
     3176           and archive_parts.prod-type = p-prod-type
     3177           and archive_parts.prod-code = p-prod-code
     3178           and archive_parts.out-code  = p-doc-code
     3179         .
     3180       get first partcopy-select-parts .
     3181       if buf_trn-doc.doc-type = 'при':U
     3182       then do:
     3183         do while available archive_parts
     3184         on error undo, return error return-value
     3185         :
     3186           if can-do('рас,спи':U, buf_trn-doc.doc-type)
     3187           or (buf_trn-doc.doc-type = 'инв':U
     3188               and archive_parts.fact-qnty < 0)
     3189           then do:
     3190             assign
     3191               v-rsrv-code = 'out-zone':U
     3192             .
     3193           end.
     3194           else do:
     3195             assign
     3196               v-rsrv-code = 'free-zone':U
     3197             .
     3198           end.
     3199           assign
     3200             archive_parts.status_   = yes
     3201             archive_parts.rsrv-free = ?
     3202           .
     3203           if archive_parts.in-code = p-doc-code
     3204           then do:
     3205             assign
     3206               archive_parts.fact-num  = buf_trn-doc.fact-num
     3207               archive_parts.fact-date = buf_trn-doc.fact-date
     3208               archive_parts.doc-type  = buf_trn-doc.doc-type
     3209             .
     3210           end.
     3211           if archive_parts.fact-qnty <> 0
     3212           then do:
     3213             run partcopy in this-procedure
     3214               (input  true
     3215               ,input  v-rsrv-code
     3216               ,buffer archive_parts
     3217               ,buffer buf_parts
     3218               ,input  ""
     3219               ) no-error .
     3220             if error-status :error
     3221             then do:
     3222               message
     3223                 vss-workfile vss-revision vss-description skip
     3224                 vss-include-info8 skip
     3225                 "Ошибка при создании партии" skip
     3226                 "Документ" p-doc-code skip
     3227                 "Объект" p-obj-type p-obj-code skip
     3228                 "Артикул" p-artic p-prod-type p-prod-code skip
     3229                 "Партия" archive_parts.in-code archive_parts.part-code skip
     3230                 "Резерв" v-rsrv-code skip
     3231                 error-status :get-message(1) skip
     3232                 return-value skip
     3233                 view-as alert-box error .
     3234               undo, return error .
     3235             end.
     3236             assign
     3237               buf_parts.qnty      = buf_parts.qnty     + archive_parts.fact-qnty
     3238               buf_parts.fact-qnty = buf_parts.qnty
     3239             .
     3240             if v-goods-twounit = true
     3241             then do:
     3242               assign
     3243                 buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     3244               .
     3245               case buf_trn-doc.ext-doc-type :
     3246                 when 'ie':U
     3247                 then do:
     3248                   if archive_parts.cli-qnty <> truncate(archive_parts.cli-qnty, 0 )
     3249                   then do:
     3250                     message
     3251                       vss-workfile vss-revision vss-description skip
     3252                       vss-include-info8 skip
     3253                       "Клиентское количество для товара," skip
     3254                       "который учитывается по двум единицам измерения" skip
     3255                       "должно равняться единице" skip
     3256                       "Документ" p-doc-code skip
     3257                       "Объект" p-obj-type p-obj-code skip
     3258                       "Артикул" p-artic p-prod-type p-prod-code skip
     3259                       "Партия" archive_parts.in-code archive_parts.part-code skip
     3260                       "Количество по документу" archive_parts.qnty skip
     3261                       "Фактическое количество" archive_parts.fact-qnty skip
     3262                       "Клиентское количество" archive_parts.cli-qnty skip
     3263                       view-as alert-box error .
     3264                     undo, return error .
     3265                   end.
     3266                 end.
     3267                 when 'iv':U
     3268                 then do:
     3269                   if archive_parts.cli-qnty <> 1
     3270                   then do:
     3271                     message
     3272                       vss-workfile vss-revision vss-description skip
     3273                       vss-include-info8 skip
     3274                       "Клиентское количество для товара," skip
     3275                       "который учитывается по двум единицам измерения" skip
     3276                       "должно равняться единице" skip
     3277                       "Документ" p-doc-code skip
     3278                       "Объект" p-obj-type p-obj-code skip
     3279                       "Артикул" p-artic p-prod-type p-prod-code skip
     3280                       "Партия" archive_parts.in-code archive_parts.part-code skip
     3281                       "Количество по документу" archive_parts.qnty skip
     3282                       "Фактическое количество" archive_parts.fact-qnty skip
     3283                       "Клиентское количество" archive_parts.cli-qnty skip
     3284                       view-as alert-box error .
     3285                     undo, return error .
     3286                   end.
     3287                 end.
     3288                 otherwise do:
     3289                   message
     3290                     vss-workfile vss-revision vss-description skip
     3291                     vss-include-info8 skip
     3292                     "Товар учитывается по двум единицам измерения" skip
     3293                     "Для приходов разрешен только внешний приход или приход перемещение" skip
     3294                     "Документ" p-doc-code skip
     3295                     "Объект" p-obj-type p-obj-code skip
     3296                     "Артикул" p-artic p-prod-type archive_parts.prod-code skip
     3297                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3298                     "Количество по документу" archive_parts.qnty skip
     3299                     "Фактическое количество" archive_parts.fact-qnty skip
     3300                     "Клиентское количество" archive_parts.cli-qnty skip
     3301                     view-as alert-box error .
     3302                   undo, return error .
     3303                 end.
     3304               end.
     3305             end.
     3306             else do:
     3307               if buf_parts.cli-base-rate <> 0
     3308               then do:
     3309                 assign
     3310                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3311                 .
     3312               end.
     3313               else do:
     3314                 assign
     3315                   buf_parts.cli-qnty = 0
     3316                 .
     3317               end.
     3318             end.
     3319             if  buf_parts.qnty      = 0
     3320             and buf_parts.fact-qnty = 0
     3321             then do:
     3322               if v-goods-twounit = true
     3323               then do:
     3324                 if buf_parts.cli-qnty <> 0
     3325                 then do:
     3326                   message
     3327                     vss-workfile vss-revision vss-description skip
     3328                     vss-include-info8 skip
     3329                     "Ошибка при удалении партии" skip
     3330                     "Документ" p-doc-code skip
     3331                     "Объект" p-obj-type p-obj-code skip
     3332                     "Артикул" p-artic p-prod-type p-prod-code skip
     3333                     "Партия" buf_parts.in-code buf_parts.part-code skip
     3334                     "Резерв" buf_parts.out-code skip
     3335                     "qnty" buf_parts.qnty skip
     3336                     "fact-qnty" buf_parts.fact-qnty skip
     3337                     "cli-qnty" buf_parts.cli-qnty skip
     3338                     view-as alert-box error .
     3339                   undo, return error .
     3340                 end.
     3341               end.
     3342               delete buf_parts .
     3343             end.
     3344           end.
     3345           else do :
     3346             if buf_trn-doc.ext-doc-type = 'iv':U
     3347             then
     3348             for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     3349                                                   and orig_marking-lines.obj-type   = archive_parts.obj-type
     3350                                                   and orig_marking-lines.obj-code   = archive_parts.obj-code
     3351                                                   and orig_marking-lines.in-code    = archive_parts.in-code
     3352                                                   and orig_marking-lines.out-code   = archive_parts.out-code
     3353                                                   and orig_marking-lines.part-code  = archive_parts.part-code,
     3354             first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3355               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     3356             end .
     3357           end .
     3358           get next partcopy-select-parts .
     3359         end.
     3360       end.
     3361       if buf_trn-doc.doc-type = 'рас':U
     3362       or buf_trn-doc.doc-type = 'спи':U
     3363       or buf_trn-doc.doc-type = 'возврат':U
     3364       or buf_trn-doc.doc-type = 'инв':U
     3365       then do:
     3366         do while available archive_parts
     3367         on error undo, return error return-value
     3368         :
     3369           assign
     3370             archive_parts.status_   = yes
     3371             archive_parts.rsrv-free = ?
     3372           .
     3373           if archive_parts.fact-qnty <> archive_parts.qnty
     3374           then do:
     3375             define variable v-is-hold as logical   no-undo .
     3376   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3378     (input  buf_trn-doc.doc-code
     3379     ,output v-is-hold
     3380     ) no-error .
     3381             if error-status :error
     3382             then do:
     3383               message
     3384                 vss-workfile vss-revision vss-description skip
     3385                 vss-include-info8
     3386                 "Ошибка при определении типа документа hold-doc.i" skip
     3387                 "Документ" p-doc-code skip
