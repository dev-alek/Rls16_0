     6515       v-fact-qnty-p = 0 .
     6516       v-doc-qnty-p = 0 .
     6517       for each buf_parts no-lock
     6518         where buf_parts.obj-type  = buf_doc-line.obj-type
     6519           and buf_parts.obj-code  = buf_doc-line.obj-code
     6520           and buf_parts.artic     = buf_doc-line.artic
     6521           and buf_parts.prod-type = buf_doc-line.prod-type
     6522           and buf_parts.prod-code = buf_doc-line.prod-code
     6523           and buf_parts.out-code  = buf_doc-line.doc-code :
     6524           v-doc-qnty-p  = v-doc-qnty-p + buf_parts.qnty .
     6525           v-fact-qnty-p = v-fact-qnty-p + buf_parts.fact-qnty .
     6526       end.
     6527       v-fact-qnty = 0 .
     6528       v-doc-qnty = 0 .
     6529       for each buf_gds-dtl no-lock
     6530         where buf_gds-dtl.artic     = buf_doc-line.artic
     6531           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     6532           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     6533           and buf_gds-dtl.doc-code  = buf_doc-line.doc-code :
