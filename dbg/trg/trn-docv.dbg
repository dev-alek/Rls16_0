     5764   procedure partrsrv-need-rsrv :
     5765     define input  parameter p-parts-in-code   as character no-undo .
     5766     define input  parameter p-parts-out-code  as character no-undo .
     5767     define output parameter p-need-rsrv-parts as logical   no-undo .
     5768     do
     5769     on error undo, return error return-value
     5770     :
     5771       if p-parts-out-code <> p-parts-in-code
     5772       then do:
     5773         assign
     5774           p-need-rsrv-parts = true
     5775         .
     5776       end.
     5777       else do:
     5778         assign
     5779           p-need-rsrv-parts = false
     5780         .
     5781       end.
     5782     end.
     5783   end procedure.
