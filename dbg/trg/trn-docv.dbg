     3534                     "qnty" buf_parts.qnty skip
     3535                     "fact-qnty" buf_parts.fact-qnty skip
     3536                     "cli-qnty" buf_parts.cli-qnty skip
     3537                     view-as alert-box error .
     3538                   undo, return error .
     3539                 end.
     3540               end.
     3541               delete buf_parts .
     3542             end.
     3543           end.
     3544           if archive_parts.in-code = buf_trn-doc.doc-code
     3545           then do:
     3546             assign
     3547               archive_parts.fact-num  = buf_trn-doc.fact-num
     3548               archive_parts.fact-date = buf_trn-doc.fact-date
     3549               archive_parts.doc-type  = buf_trn-doc.doc-type
     3550             .
     3551           end.
     3552           if archive_parts.fact-qnty <> 0
     3553           then do:
     3554             if can-do('рас,спи':U, buf_trn-doc.doc-type)
     3555             or (buf_trn-doc.doc-type = 'инв':U
     3556                 and archive_parts.fact-qnty < 0
     3557               )
     3558             then do:
     3559   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3560   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3561     (input  buf_trn-doc.doc-code
     3562     ,output v-is-hold
     3563     ) no-error .
     3564               if error-status :error
     3565               then do:
     3566                 message
     3567                   vss-workfile vss-revision vss-description skip
     3568                   vss-include-info8
     3569                   "Ошибка при определении типа документа hold-doc.i" skip
     3570                   "Документ" p-doc-code skip
     3571                   "Объект" p-obj-type p-obj-code skip
     3572                   "Артикул" p-artic p-prod-type p-prod-code skip
     3573                   error-status :get-message(1) skip
     3574                   return-value skip
     3575                   view-as alert-box error .
     3576                 undo, return error .
     3577               end.
     3578               assign
     3579                 v-rsrv-code = 'out-zone':U
     3580               .
     3581               if buf_trn-doc.ext-doc-type  = 'ep':U
     3582               or (buf_trn-doc.ext-doc-type = 'ap':U )
     3583               or (buf_trn-doc.ext-doc-type = 'pc':U )
     3584               then do:
     3585                 assign
     3586                   v-rsrv-code = ""
     3587                 .
     3588                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     3589                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     3590                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     3591                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     3592                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     3593                                                       and orig_marking-lines.part-code  = archive_parts.part-code,
     3594                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3595                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB .
     3596                 end .
     3597               end.
     3598             end.
     3599             else do:
     3600               assign
     3601                 v-rsrv-code = 'free-zone':U
     3602               .
     3603             end.
     3604             if v-rsrv-code <> ""
     3605             then do:
     3606               run partcopy in this-procedure
     3607                 (input  true
     3608                 ,input  v-rsrv-code
     3609                 ,buffer archive_parts
     3610                 ,buffer buf_parts
     3611                 ,input  ""
     3612                 ) no-error .
     3613               if error-status :error
     3614               then do:
     3615                 message
     3616                   vss-workfile vss-revision vss-description skip
     3617                   vss-include-info8 skip
     3618                   "Ошибка при создании партии" skip
     3619                   "Документ" buf_trn-doc.doc-code skip
     3620                   "Объект" archive_parts.obj-type archive_parts.obj-code skip
     3621                   "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     3622                   "Партия" archive_parts.in-code archive_parts.part-code skip
     3623                   "Резерв" v-rsrv-code skip
     3624                   error-status :get-message(1) skip
     3625                   return-value skip
     3626                   view-as alert-box error .
     3627                 undo, return error .
