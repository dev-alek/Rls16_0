        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.dis-time-rule OLD old_dis-time-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись для таблицы расписания скидок".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1', ub.dis-time-rule.time-rule-num)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure dtr-code :
      308     do
      309     on error undo, return error
      310     :
      311       define input  parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
      312       define output parameter  p-des               like ub.dis-time-rule.des               no-undo .
      313       define output parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
      314       define output parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
      315       define output parameter  p-level-1 as character no-undo .
      316       define output parameter  p-level-2 as character no-undo .
      317       define output parameter  p-output-display as logical   no-undo .
      318       define output parameter  p-tree           as char  no-undo .
      319       define output parameter  p-other          as character no-undo .
      320       define variable v-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
      321       define buffer buf_dis-time-rule for ub.dis-time-rule .
      322       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      323       if p-templ-rl-root < 50000 then
      324       v-templ-rl-root = (p-templ-rl-root + 50000).
      325       else v-templ-rl-root = p-templ-rl-root.
      326       find first buf_dis-time-rule no-lock where
      327                 buf_dis-time-rule.time-rule-num = v-templ-rl-root no-error .
      328       if not available buf_dis-time-rule then do:
      329         undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root) .
      330       end.
      331       find first buf_dis-cfg-rule no-lock where
      332               buf_dis-cfg-rule.templ-rl-root = 0
      333           and buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      334           and buf_dis-cfg-rule.pos-type = '':U
      335           and buf_dis-cfg-rule.table-name = '':U
      336           and buf_dis-cfg-rule.discnt-role = '':U
      337           and buf_dis-cfg-rule.self-nonunique = '':U
      338               no-error.
      339       if not available buf_Dis-cfg-rule then do:
      340           undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root ).
      341       end.
      342       assign
      343       p-des = buf_dis-time-rule.des
      344       p-upper-time-rule-num = (buf_dis-time-rule.upper-time-rule-num - 50000)
      345       p-value-type = buf_dis-time-rule.value-type
      346       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      347       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      348                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      349                    else '')
      350       p-output-display = (buf_dis-time-rule.sts = integer('0':U))
      351       p-tree = buf_dis-time-rule.uniq-field
      352       p-other = buf_dis-time-rule.other-inf
      353       .
      354     end.
      355   end procedure.
      356   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   procedure gen-b-code :
      358     define input  parameter type-code like ub.code-range.range-type no-undo .
      359     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      360     do
      361     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      362     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      363     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      364     :
      365       define buffer buf_thbj-attr     for ub.thbj-attr .
      366       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      367       define buffer buf_code-range for ub.code-range .
      368       define variable l-code         as   integer              no-undo .
      369       define variable v-db-num       like ub.db.db-num         no-undo .
      370       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      371       if type-code = 'sslc':U
      372       or type-code = 'ssgb':U
      373       then do:
      374         message
      375           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      376           "Обратитесь к администратору системы."
      377           view-as alert-box error .
      378         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      379       end.
      380       run trg/getpcode.p ( input  type-code
      381                      ,output cfg-param-code
      382                     ).
      383       run get-next-seq( input  type-code,
      384                         output l-code
      385                       ).
      386       find first buf_sys-ctrl no-lock.
      387       if type-code = 'sclc':U
      388       or type-code = 'pglc':U
      389       then do:
      390         assign
      391           v-db-num = 0
      392         .
      393       end.
      394       else do:
      395         assign
      396           v-db-num = buf_sys-ctrl.db-num
      397         .
      398       end.
      399       find first buf_code-range no-lock
      400         where buf_code-range.db-num     = v-db-num
      401           and buf_code-range.range-type = type-code
      402           and buf_code-range.stts       = "a"
      403         use-index stts
      404         no-error .
      405       if available buf_code-range
      406          and l-code <= buf_code-range.last-code
      407          and l-code >= buf_code-range.first-code then do:
      408         assign
      409           p-b-code = l-code
      410         .
      411       end.
      412       else do:
      413         if available buf_code-range
      414            and l-code < buf_code-range.last-code then do:
      415           message
      416             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      417             "Обратитесь к администратору системы."
      418             view-as alert-box error .
      419           undo, return error "sequence":U .
      420         end.
      421         do transaction
      422         on error undo, return error
      423         :
      424           find first buf_thbj-attr exclusive-lock
      425             where buf_thbj-attr.upper-prop-code = 'code-range':U
      426               and buf_thbj-attr.prop-code = cfg-param-code
      427               and buf_thbj-attr.obj-type   = 'БД':U
      428               and buf_thbj-attr.obj-code   = v-db-num
      429             no-error .
      430           if not available buf_thbj-attr then do:
      431             find first buf_thbj-attr exclusive-lock
      432               where buf_thbj-attr.upper-prop-code = 'code-range':U
      433                 and buf_thbj-attr.prop-code = cfg-param-code
      434                 and buf_thbj-attr.obj-type   = ''
      435                 and buf_thbj-attr.obj-code   = 0
      436               no-error .
      437             if not available buf_thbj-attr then do:
      438               if not locked buf_thbj-attr then do:
      439                 message
      440                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      441                   "Обратитесь к администратору системы."
      442                   view-as alert-box error .
      443               end.
      444               undo, return error "config":U .
      445             end.
      446           end.
      447           run get-next-seq( input type-code,
      448                             output l-code
      449                           ).
      450           find first buf_code-range
      451             where buf_code-range.db-num     = v-db-num
      452               and buf_code-range.range-type = type-code
      453               and buf_code-range.stts       = "a"
      454             use-index stts
      455             no-error .
      456           if available buf_code-range
      457           and l-code <= buf_code-range.last-code
      458           and l-code >= buf_code-range.first-code
      459           then do:
      460             assign
      461               p-b-code = l-code
      462             .
      463           end.
      464           else do:
      465             if available buf_code-range then do:
      466               assign
      467                 buf_code-range.stts = "u"
      468               .
      469             end.
      470             find first buf_code-range
      471               where buf_code-range.db-num     = v-db-num
      472                 and buf_code-range.range-type = type-code
      473                 and buf_code-range.stts       = "f"
      474               use-index stts
      475               no-error .
      476             if not available buf_code-range then do:
      477               message
      478                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      479                 "Обратитесь к администратору системы"
      480                 view-as alert-box error .
      481               undo, return error "code-range":U .
      482             end.
      483             assign
      484               buf_code-range.stts           = "a"
      485             .
      486             if buf_code-range.first-code = 1 then do:
      487               run set-seq-cr( input type-code,
      488                               input buf_code-range.first-code
      489                             ).
      490               assign
      491                 p-b-code = 1
      492               .
      493             end.
      494             else do:
      495               run set-seq-cr( input type-code,
      496                               input ( buf_code-range.first-code - 1 )
      497                             ).
      498               run get-next-seq( input type-code,
      499                                 output p-b-code
      500                               ).
      501             end.
      502           end.
      503         end.
      504       end.
      505     end.
      506   end procedure.
      507   procedure get-next-seq :
      508     define input  parameter type-code like ub.code-range.range-type no-undo .
      509     define output parameter next-seq  as   integer                  no-undo .
      510     do
      511     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      512     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      513     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      514     :
      515       case type-code:
      516         when 'bcgb':U then do:
      517           assign
      518             next-seq = next-value(s-bcgb-code, ub)
      519           .
      520         end.
      521         when 'scgb':U then do:
      522           assign
      523             next-seq = next-value(s-scgb-code, ub)
      524           .
      525         end.
      526         when 'sclc':U then do:
      527           assign
      528             next-seq = next-value(s-sclc-code, ub)
      529           .
      530         end.
      531         when 'pglc':U then do:
      532           assign
      533             next-seq = next-value(s-pglc-code, ub)
      534           .
      535         end.
      536         when 'dcgb':U then do:
      537           assign
      538             next-seq = next-value(s-dcgb-code, ub)
      539           .
      540         end.
      541         when 'ctgb':U then do:
      542           assign
      543             next-seq = next-value(s-ctgb-code, ub)
      544           .
      545         end.
      546         when 'drgb':U then do:
      547           assign
      548             next-seq = next-value(s-drgb-code, ub)
      549           .
      550         end.
      551         when 'fmgb':U then do:
      552           assign
      553             next-seq = next-value(s-fmgb-code, ub)
      554           .
      555         end.
      556         when 'pngb':U then do:
      557           assign
      558             next-seq = next-value(s-pngb-code, ub)
      559           .
      560         end.
      561         when 'cagb':U then do:
      562           assign
      563             next-seq = next-value(s-cagb-code, ub)
      564           .
      565         end.
      566         when 'fdgb':U then do:
      567           assign
      568             next-seq = next-value(s-fin-doc, ub)
      569           .
      570         end.
      571       end case.
      572     end.
      573   end procedure.
      574   procedure set-seq-cr :
      575     define input parameter type-code like ub.code-range.range-type no-undo .
      576     define input parameter set-val   like ub.code-range.first-code no-undo .
      577     do
      578     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      579     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      580     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      581     :
      582       case type-code:
      583         when 'bcgb':U then do:
      584           assign
      585             current-value(s-bcgb-code, ub) = set-val
      586           .
      587         end.
      588         when 'scgb':U then do:
      589           assign
      590             current-value(s-scgb-code, ub) = set-val
      591           .
      592         end.
      593         when 'sclc':U then do:
      594           assign
      595             current-value(s-sclc-code, ub) = set-val
      596           .
      597         end.
      598         when 'pglc':U then do:
      599           assign
      600             current-value(s-pglc-code, ub) = set-val
      601           .
      602         end.
      603         when 'dcgb':U then do:
      604           assign
      605             current-value(s-dcgb-code, ub) = set-val
      606           .
      607         end.
      608         when 'ctgb':U then do:
      609           assign
      610             current-value(s-ctgb-code, ub) = set-val
      611           .
      612         end.
      613         when 'drgb':U then do:
      614           assign
      615             current-value(s-drgb-code, ub) = set-val
      616           .
      617         end.
      618         when 'fmgb':U then do:
      619           assign
      620             current-value(s-fmgb-code, ub) = set-val
      621           .
      622         end.
      623         when 'pngb':U then do:
      624           assign
      625             current-value(s-pngb-code, ub) = set-val
      626           .
      627         end.
      628         when 'cagb':U then do:
      629           assign
      630             current-value(s-cagb-code, ub) = set-val
      631           .
      632         end.
      633         when 'fdgb':U then do:
      634           assign
      635             current-value(s-fin-doc, ub) = set-val
      636           .
      637         end.
      638       end case.
      639     end.
      640   end procedure.
      641   procedure new-bcod-gen-code-range :
      642     do
      643     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      644     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      645     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      646     :
      647       define input parameter p-db-num  like ub.db.db-num             no-undo .
      648       define input parameter type-code like ub.code-range.range-type no-undo .
      649       define buffer buf_code-range      for ub.code-range .
      650       define buffer last_code-range     for ub.code-range .
      651       define buffer last-1_code-range   for ub.code-range .
      652       define buffer last-2_code-range   for ub.code-range .
      653       define buffer last-3_code-range   for ub.code-range .
      654       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      655       define variable conf-par       as character no-undo .
      656       define variable par-type       as character no-undo .
      657       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      658       define variable v-cre-cdrg as logical   no-undo .
      659       define variable v-cre-str  as character no-undo .
      660       define variable v-cr1      as integer no-undo .
      661       define variable v-cr2      as integer no-undo .
      662       define variable v-cr3      as integer no-undo .
      663       define variable v-cmax     as integer no-undo .
      664       find first buf_sys-ctrl no-lock .
      665       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      666         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      667                                       ,vss-workfile
      668                                       ,vss-revision
      669                                       ,vss-description
      670                                       ,chr(10)
      671                                       , p-db-num
      672                                      ).
      673       end.
      674       run trg/getpcode.p ( input  type-code
      675                      ,output cfg-param-code
      676                     ).
      677       for each buf_code-range
      678         where buf_code-range.db-num     = -1
      679           and buf_code-range.range-type = type-code
      680           and buf_code-range.stts       = "f"
      681       by buf_code-range.first-code
      682       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      683       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      684       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      685       :
      686         assign
      687           buf_code-range.db-num = p-db-num
      688         .
      689         return .
      690       end.
      691       assign
      692         v-cre-cdrg = TRUE
      693       .
      694       case type-code:
      695         when 'sclc':U
      696         or when 'scgb':U
      697         or when 'pglc':U
      698         then do:
      699           find last last-1_code-range no-lock
      700             where last-1_code-range.range-type = 'sclc':U
      701             no-error .
      702           if available last-1_code-range then do:
      703             v-cr1 = last-1_code-range.last-code.
      704           end.
      705           find last last-2_code-range no-lock
      706             where last-2_code-range.range-type = 'scgb':U
      707             no-error .
      708           if available last-2_code-range then do:
      709             v-cr2 = last-2_code-range.last-code.
      710             end.
      711           find last last-3_code-range no-lock
      712             where last-3_code-range.range-type = 'pglc':U
      713             no-error .
      714           if available last-3_code-range then do:
      715             v-cr3 = last-3_code-range.last-code.
      716           end.
      717           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      718           .
      719           if v-cmax = v-cr1  then do:
      720               find last last_code-range no-lock
      721                 where recid( last_code-range ) = recid( last-1_code-range )
      722                 .
      723             end.
      724           if v-cmax = v-cr2  then do:
      725               find last last_code-range no-lock
      726                 where recid( last_code-range ) = recid( last-2_code-range )
      727                 .
      728             end.
      729           if v-cmax = v-cr3  then do:
      730             find last last_code-range no-lock
      731               where recid( last_code-range ) = recid( last-3_code-range )
      732               .
      733           end.
      734           if last_code-range.last-code + 1 > 99999 then do:
      735             assign
      736               v-cre-cdrg = FALSE
      737             .
      738           end.
      739         end.
      740         when 'bcgb':U
      741         or when 'sslc':U
      742         or when 'ssgb':U
      743         then do:
      744           find last last-1_code-range no-lock
      745             where last-1_code-range.range-type = 'sslc':U
      746             no-error .
      747           if available last-1_code-range then do:
      748             v-cr1 = last-1_code-range.last-code.
      749           end.
      750           find last last-2_code-range no-lock
      751             where last-2_code-range.range-type = 'bcgb':U
      752             no-error .
      753           if available last-2_code-range then do:
      754             v-cr2 = last-2_code-range.last-code.
      755             end.
      756           find last last-3_code-range no-lock
      757             where last-3_code-range.range-type = 'ssgb':U
      758             no-error .
      759           if available last-3_code-range then do:
      760             v-cr3 = last-3_code-range.last-code.
      761           end.
      762           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      763           .
      764           if v-cmax = v-cr1  then do:
      765               find last last_code-range no-lock
      766                 where recid( last_code-range ) = recid( last-1_code-range )
      767                 .
      768             end.
      769           if v-cmax = v-cr2  then do:
      770               find last last_code-range no-lock
      771                 where recid( last_code-range ) = recid( last-2_code-range )
      772                 .
      773             end.
      774           if v-cmax = v-cr3  then do:
      775             find last last_code-range no-lock
      776               where recid( last_code-range ) = recid( last-3_code-range )
      777               .
      778           end.
      779         end.
      780         otherwise do:
      781           find last last_code-range no-lock
      782             where last_code-range.range-type = type-code
      783             no-error .
      784         end.
      785       end case.
      786       if not available last_code-range then do:
      787         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      788                                       ,vss-workfile
      789                                       ,vss-revision
      790                                       ,vss-description
      791                                       , chr(10)
      792                                       , type-code
      793                                      ) .
      794       end.
      795       define variable v-mes2 as character no-undo .
      796       define variable v-param-type2 as character no-undo .
      797       define variable v-value-character2 as INTEGER no-undo .
      798       define variable v-value-date2 as date no-undo .
      799       define variable v-value-decimal2 as decimal no-undo .
      800       define variable v-value-integer2 AS integer no-undo .
      801       define variable v-value-logical2 AS LOGICAL no-undo .
      802       define variable v-tth2 as handle no-undo .
      803       run adm/shattri.p (
      804           input "get":U
      805           ,input  'БД':U
      806           ,input  p-db-num
      807           ,input  'code-range':U
      808           ,input  cfg-param-code
      809           ,output v-value-character2
      810           ,output v-value-date2
      811           ,output v-value-decimal2
      812           ,output v-value-integer2
      813           ,output v-value-logical2
      814           ,output v-param-type2
      815           ,INPUT-OUTPUT table-handle v-tth2
      816           ) no-error .
      817       if error-status :error then do:
      818         delete object v-tth2.
      819         v-mes2 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      820                            , error-status:get-message(1)
      821                            , chr(10)
      822                            , return-value ).
      823         undo, return error v-mes2.
      824       end.
      825       delete object v-tth2.
      826       if v-cre-cdrg = TRUE then do:
      827         create buf_code-range .
      828         assign
      829           buf_code-range.db-num     = p-db-num
      830           buf_code-range.range-type = type-code
      831           buf_code-range.stts       = "f"
      832           buf_code-range.first-code = last_code-range.last-code + 1
      833           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer2)
      834           v-cre-str = "Свободный диапазон успешно создан"
      835         .
      836       end.
      837       else do:
      838         assign
      839           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      840                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      841         .
      842       end.
      843     end.
      844     return v-cre-str .
      845   end procedure.
      846   procedure gen-new-code-range-if-neces :
      847     define input parameter v-db-num           like ub.db.db-num             no-undo .
      848     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      849     define input parameter v-cur-code         as   integer                  no-undo .
      850     define input parameter v-g#news           as   logical                  no-undo .
      851     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      852     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      853     do
      854     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      855     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      856     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      857     :
      858       define variable l-code-range-exist as logical   no-undo init false .
      859       define variable v-db-for-send      as character no-undo .
      860       define buffer buf_code-range  for ub.code-range .
      861       define buffer buf1_code-range for ub.code-range .
      862       define buffer buf_db          for ub.db .
      863       find first buf_code-range
      864         where buf_code-range.range-type = v-range-type
      865           and buf_code-range.last-code >= v-cur-code
      866         use-index last-codei
      867         no-error .
      868       if
      869       (
      870          available buf_code-range
      871          and
      872         (buf_code-range.db-num = v-db-num
      873           and
      874         buf_code-range.first-code <= v-cur-code
      875         )
      876       or
      877         (
      878           v-range-type = 'drgb':U
      879           AND
      880           v-cur-code = 0
      881         )
      882      )
      883      then do:
      884         assign
      885           l-code-range-exist = true
      886         .
      887         if v-g#news
      888         and buf_code-range.stts = "f" then do:
      889           assign
      890             buf_code-range.stts = "u"
      891           .
      892         end.
      893       end.
      894       if not l-code-range-exist
      895          and v-g#news-source-db <> 0
      896       then do:
      897         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      898                                       ,vss-workfile
      899                                       ,vss-revision
      900                                       ,vss-description
      901                                       ,chr(10)
      902                                       ,v-db-num
      903                                       ,v-range-type
      904                                       ,v-cur-code
      905                                      ).
      906       end.
      907       if (not l-code-range-exist
      908           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      909          )
      910       and ( not can-find (first buf1_code-range no-lock
      911                           where buf1_code-range.db-num = v-db-num
      912                             and buf1_code-range.range-type = v-range-type
      913                             and buf1_code-range.stts = "f"
      914                          )
      915           )
      916       then do:
      917         if v-g#db-num = 0 then do:
      918           run new-bcod-gen-code-range in this-procedure
      919             (input v-db-num,
      920              input v-range-type
      921             ) no-error .
      922           if error-status :error then do:
      923             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      924                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      925                                           ,v-db-num
      926                                           ,v-range-type
      927                                           ,v-cur-code
      928                                           ,chr(10)
      929                                           ,error-status:get-message(1)
      930                                           ,return-value
      931                                          ).
      932           end.
      933         end.
      934         else do:
      935           if v-range-type = 'sclc':U
      936           or v-range-type = 'pglc':U
      937           then do:
      938             assign
      939               v-db-for-send = "":U
      940             .
      941             if v-g#db-num = 0 then do:
      942               for each buf_db no-lock
      943                 where buf_db.db-num > 0
      944                   and buf_db.db-num <> v-g#news-source-db
      945               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      946               :
      947                 assign
      948                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      949                 .
      950               end.
      951               assign
      952                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      953               .
      954             end.
      955             else do:
      956               if not v-g#news then do:
      957                 assign
      958                   v-db-for-send = "0":U
      959                 .
      960               end.
      961             end.
      962             run nws/cr-route.p ( input 'send-cmd':U
      963                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      964                                  "code-range":U + chr(1) +
      965                                  (if v-range-type = 'sclc':U
      966                                   then string( current-value(s-sclc-code, ub))
      967                                   else string( current-value(s-pglc-code, ub))
      968                                   ) + chr(1) +
      969                                   v-range-type)
      970                           ,input ?
      971                           ,input v-db-for-send
      972                           ) no-error .
      973             if error-status :error then do:
      974               undo, return error return-value.
      975             end.
      976           end.
      977         end.
      978       end.
      979     end.
      980   end procedure.
      981   procedure cre-loc-sc-code-range :
      982     define input parameter v-cur-code as integer no-undo .
      983   define input parameter p-cdrg-type as character no-undo .
      984     do
      985     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      986     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      987     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      988     :
      989       define buffer buf_code-range for ub.code-range .
      990       find first buf_code-range
      991            where buf_code-range.range-type = p-cdrg-type
      992              and buf_code-range.first-code >= v-cur-code
      993            no-error .
      994       if not available buf_code-range then do:
      995         run new-bcod-gen-code-range in this-procedure
      996           ( input 0,
      997             input p-cdrg-type
      998           ) no-error .
      999         if error-status :error then do:
     1000           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1001                                          + "Код &2&1&3 &4"
     1002                                         , chr(10)
     1003                                         , v-cur-code
     1004                                         , error-status:get-message(1)
     1005                                         , return-value
     1006                                        ) .
     1007         end.
     1008       end.
     1009     end.
     1010   end procedure.
     1011   procedure mark-used-if-need :
     1012   define input parameter p-cur-code as integer no-undo .
     1013   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1014   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1015     do
     1016     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1017     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1018     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1019     :
     1020       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1021       define buffer buf_code-range for ub.code-range .
     1022       assign
     1023       v-db-num = if p-range-type = 'sclc':U
     1024                  then 0
     1025                  else p-db-num
     1026       .
     1027   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   define buffer locK-batchprocess3 for ub.batchprocess.
     1029   run gbl/lock-prc.p
     1030       (input 'lscc':U
     1031       ,input 0
     1032       ,input 0
     1033       ,input 0
     1034       ,input ""
     1035       ,input ""
     1036       ,input ""
     1037       ,input (
     1038               ",,,Вкл/выкл лок. вес. кодов"
     1039              )
     1040       ,input true
     1041       ,buffer lock-batchprocess3
     1042       ) no-error .
     1043     if error-status :error then do:
     1044       message
     1045         vss-workfile vss-revision vss-description skip
     1046         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1047         view-as alert-box error .
     1048       undo, return error .
     1049     end.
     1050       find first buf_code-range
     1051            where buf_code-range.range-type = p-range-type
     1052              and buf_code-range.first-code >= p-cur-code
     1053              and buf_code-range.last-code <= p-cur-code
     1054              and buf_code-range.db-num = v-db-num
     1055            no-error .
     1056       if not available buf_code-range then do:
     1057         message
     1058           vss-workfile vss-revision vss-description skip
     1059           "Ошибка при создании поиске диапазона" skip
     1060           "База данных" p-db-num skip
     1061           "Код" p-cur-code skip
     1062           "Тип" p-range-type
     1063           error-status :get-message(1) skip
     1064           return-value skip
     1065           view-as alert-box error .
     1066         undo, return error .
     1067       end.
     1068       if buf_code-range.stts = "f":U then do:
     1069         assign
     1070         buf_code-range.stts = "u":U
     1071         .
     1072       end.
     1073     end.
     1074   end procedure.
     1075   define variable v-date as date no-undo .
     1076   define variable v-time as integer no-undo .
     1077   define variable v-chr as character no-undo .
     1078   define variable v-changed as logical no-undo .
     1079   define variable v-ii as integer no-undo .
     1080   define variable v-confirmed as logical no-undo .
     1081   define variable v-start-level as integer no-undo .
     1082   define variable level as integer no-undo .
     1083   define variable v-p as character no-undo .
     1084   define buffer buf_c-dis-time-rule for ub.c-dis-time-rule.
     1085   main-block:
     1086   do
     1087   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1088   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1089   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1090   :
     1091     buffer-compare ub.dis-time-rule to old_dis-time-rule
     1092     case-sensitive
     1093     save result in v-chr.
     1094     if ub.dis-time-rule.time-rule-num <= 99999 then do:
     1095         _ii:
     1096         do v-ii = 1 to num-entries(v-chr):
     1097           if lookup(entry(v-ii, v-chr), "other-inf,uniq-field,des,sts") = 0 then do:
     1098             assign
     1099             v-changed = yes.
     1100             leave _ii.
     1101           end.
     1102         end.
     1103       if not ( g#db-num > 0 ) then do:
     1104         if (v-chr <> "sts" and v-changed
     1105             AND old_dis-time-rule.sts <> integer('1':U)
     1106             and not new(ub.dis-time-rule)
     1107             ) then do:
     1108           assign
     1109           v-changed = yes.
     1110         end.
     1111       end.
     1112       if (( g#db-num > 0 ) and not g#news and v-changed and not new(ub.dis-time-rule))
     1113       or (not ( g#db-num > 0 ) and v-changed and not new(ub.dis-time-rule))
     1114       then do:
     1115         assign
     1116         v-start-level = 2
     1117         .
     1118         assign
     1119           level = v-start-level
     1120         .
     1121         _repeat:
     1122         repeat while program-name( level ) <> ? :
     1123           v-p = program-name( level ).
     1124           if substring(v-p, length(v-p) - length("fixdr.p") + 1) = "fixdr.p":U
     1125           or substring(v-p, length(v-p) - length("fixdr.p") + 1) = "fixdr.r":U
     1126           or substring(v-p, length(v-p) - length("distrul0.p") + 1) = "distrul0.p":U
     1127           or substring(v-p, length(v-p) - length("distrul0.p") + 1) = "distrul0.r":U
     1128           then do:
     1129             v-confirmed = yes.
     1130             leave _repeat.
     1131           end.
     1132           assign
     1133             level = level + 1
     1134           .
     1135         end.
     1136         if not v-confirmed then do:
     1137           message
     1138           vss-workfile vss-revision vss-description skip
     1139           "Для используемых записей ШАБЛОНОВ РАСПИСАНИЙ можно менять только статус записи и только в ГБД"
     1140           view-as alert-box error .
     1141           undo main-block, return error .
     1142         end.
     1143       end.
     1144     end.
     1145     if new(ub.dis-time-rule) then do:
     1146       run gen-new-code-range-if-neces( input (if g#news then g#news-source-db else g#db-num),
     1147                                        input 'drgb':U,
     1148                                        input ub.dis-time-rule.time-rule-num,
     1149                                        input g#news,
     1150                                        input g#db-num,
     1151                                        input g#news-source-db
     1152                                      ) .
     1153     end.
     1154     if ub.dis-time-rule.upper-time-rule-num <= 99999 then do:
     1155       run str/callnews.p
     1156         (input 'dis-time-rule':U
     1157         ,input (buffer ub.dis-time-rule:handle)
     1158         ).
     1159     end.
     1160     run cur-time in this-procedure(output v-date, output v-time).
     1161     create buf_c-dis-time-rule.
     1162     buffer-copy old_dis-time-rule
     1163     except time-rule-num upper-time-rule-num
     1164     templ-rl-root
     1165     rl-root
     1166     to buf_c-dis-time-rule
     1167     assign
     1168     buf_c-dis-time-rule.date-from          = (if new(ub.dis-time-rule)
     1169                                               then (if ub.dis-time-rule.date-from = 12/31/1989
     1170                                                     then  ub.dis-time-rule.date-from
     1171                                                     else 01/01/1990 )
     1172                                               else old_dis-time-rule.date-from)
     1173     buf_c-dis-time-rule.date-to          = (if new(ub.dis-time-rule)
     1174                                               then (if ub.dis-time-rule.date-to = 12/31/1989
     1175                                                     then  ub.dis-time-rule.date-to
     1176                                                     else 01/01/1990 )
     1177                                               else old_dis-time-rule.date-to)
     1178     buf_c-dis-time-rule.time-rule-num      = ub.dis-time-rule.time-rule-num
     1179     buf_c-dis-time-rule.upper-time-rule-num = ub.dis-time-rule.upper-time-rule-num
     1180     buf_c-dis-time-rule.rl-root            = ub.dis-time-rule.rl-root
     1181     buf_c-dis-time-rule.templ-rl-root      = ub.dis-time-rule.templ-rl-root
     1182     buf_c-dis-time-rule.chip-num           = next-value (s-dc-chip, ub)
     1183     buf_c-dis-time-rule.corr-time          = v-time
     1184     buf_c-dis-time-rule.corr-user-db-num   = g#db-num
     1185     buf_c-dis-time-rule.corr-user-name     = g#userid
     1186     buf_c-dis-time-rule.corr-date          = v-date
     1187     buF_c-dis-time-rule.action             = (if new(ub.dis-time-rule) then integer('1':U) else integer('2':U))
     1188     buf_c-dis-time-rule.is-news            = g#news
     1189     .
     1190     if g#oxml = yes
     1191     then do:
     1192       run str/calloxml.p (
     1193             input 'update':U
     1194           , input 'dis-time-rule':U
     1195           , input ( buffer ub.dis-time-rule:handle )
     1196       ) no-error.
     1197       if error-status :error
     1198       then do:
     1199           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1200                                , chr(10)
     1201                                , vss-workfile
     1202                                , return-value
     1203                                , error-status :get-message ( 1 ) ).
     1204       end.
     1205     end.
     1206   end.
