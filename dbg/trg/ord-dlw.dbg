        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.ord-line OLD BUFFER old_ord-line.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Изменение строки заказа".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define new global shared variable g#lib-trn  as handle no-undo .
       79   define new global shared variable g#lib-trn2 as handle no-undo .
       80   define new global shared variable g#lib-trn3 as handle no-undo .
       81   define new global shared variable g#lib-trn4 as handle no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   define buffer buf_ord-doc for ub.ord-doc  .
      308   define buffer buf_c-ord-line for ub.c-ord-line  .
      309   define buffer buf_goods for ub.goods  .
      310   define variable v-today     as date      no-undo.
      311   define variable start-time  as integer   no-undo .
      312   define variable var-r-b as character no-undo .
      313   define variable     varprice-cli                    like ub.doc-line.price-base no-undo .
      314   define variable     varprice-cli-unit-base          like ub.doc-line.price-base no-undo .
      315   define variable     varprice-road-tax               like ub.doc-line.price-base no-undo .
      316   define variable     varprice-other-exp              like ub.doc-line.price-base no-undo .
      317   define variable     varprice-transport-exp          like ub.doc-line.price-base no-undo .
      318   define variable     varprice-without-abs            like ub.doc-line.price-base no-undo .
      319   define variable     varprice-slt                    like ub.doc-line.price-base no-undo .
      320   define variable     varprice-no-slt                 like ub.doc-line.price-base no-undo .
      321   define variable     varprice-vat                    like ub.doc-line.price-base no-undo .
      322   define variable     varprice-no-vat-slt             like ub.doc-line.price-base no-undo .
      323   define variable     varprice-rubl                   like ub.doc-line.price-base no-undo .
      324   define variable     varprice-road-tax-rubl          like ub.doc-line.price-base no-undo .
      325   define variable     varprice-other-exp-rubl         like ub.doc-line.price-base no-undo .
      326   define variable     varprice-transport-exp-rubl     like ub.doc-line.price-base no-undo .
      327   define variable     varprice-without-abs-rubl       like ub.doc-line.price-base no-undo .
      328   define variable     varprice-slt-rubl               like ub.doc-line.price-base no-undo .
      329   define variable     varprice-no-slt-rubl            like ub.doc-line.price-base no-undo .
      330   define variable     varprice-vat-rubl               like ub.doc-line.price-base no-undo .
      331   define variable     varprice-no-vat-slt-rubl        like ub.doc-line.price-base no-undo .
      332   define variable     varprice-base                   like ub.doc-line.price-base no-undo .
      333   define variable     varprice-road-tax-base          like ub.doc-line.price-base no-undo .
      334   define variable     varprice-other-exp-base         like ub.doc-line.price-base no-undo .
      335   define variable     varprice-transport-exp-base     like ub.doc-line.price-base no-undo .
      336   define variable     varprice-without-abs-base       like ub.doc-line.price-base no-undo .
      337   define variable     varprice-slt-base               like ub.doc-line.price-base no-undo .
      338   define variable     varprice-no-slt-base            like ub.doc-line.price-base no-undo .
      339   define variable     varprice-vat-base               like ub.doc-line.price-base no-undo .
      340   define variable     varprice-no-vat-slt-base        like ub.doc-line.price-base no-undo .
      341   main-block :
      342   do transaction
      343   on error undo main-block, return error
      344   :
      345   run cur-time in this-procedure(output v-today, output start-time).
      346   find first buf_ord-doc no-lock   where  buf_ord-doc.doc-code  =  ub.ord-line.doc-code no-error .
      347   if available buf_ord-doc then do:
      348       if not  g#news
      349       and not g#auto
      350       and not g#esys
      351       then do:
      352           find first ub.units no-lock where
      353                       ub.units.unit-name = ub.ord-line.unit-cli  and
      354                       lookup('шту':U, ub.units.type) > 0 no-error .
      355           if available ub.units then do:
      356               if ub.ord-line.cli-qnty - truncate(ub.ord-line.cli-qnty,0) > 0 then do:
      357                   message "Количество в единицах поставщика " ub.ord-line.unit-cli
      358                   "получилось дробным ! Исправить в меньшую сторону ? " view-as alert-box question
      359                   buttons  yes-no
      360                   update trg-ok as logical
      361                   .
      362                   if trg-ok then ub.ord-line.cli-qnty = truncate(ub.ord-line.cli-qnty,0) .
      363                   else return .
      364               end.
      365           end.
      366       end.
      367       assign
      368         ub.ord-line.qnty       =   ub.ord-line.cli-qnty * ub.ord-line.cli-base-rate
      369         ub.ord-line.price-base =   ub.ord-line.price-rubl / buf_ord-doc.base-rate * buf_ord-doc.base-scale
      370         ub.ord-line.sum-rubl   =   ub.ord-line.price-rubl * ub.ord-line.qnty
      371         ub.ord-line.sum-base   =   ub.ord-line.price-base * ub.ord-line.qnty
      372         ub.ord-line.sum-cli    =   ub.ord-line.price-cli  * ub.ord-line.cli-qnty
      373       .
      374       if ub.ord-line.sum-vat = ? then ub.ord-line.sum-vat = 0.
      375       if buf_ord-doc.vat-type = 'без':U then  do:
      376          if ub.ord-line.vat-pc <> 0 then ub.ord-line.vat-pc = 0.
      377       end.
      378       if buf_ord-doc.slt-type = 'без':U then  do:
      379          if ub.ord-line.slt-pc <> 0 then ub.ord-line.slt-pc = 0.
      380       end.
      381      if buf_ord-doc.vat-type <> 'без':U and
      382         ub.ord-line.vat-pc <> 0 and
      383         ub.ord-line.sum-vat = 0 and
      384         ub.ord-line.qnty <> 0
      385      then do:
      386   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      387   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      388     (output var-r-b
      389     )  .
      390   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
      391     (
      392      input   'zakaz':u
      393     ,input   buf_ord-doc.base-rate
      394     ,input   buf_ord-doc.base-scale
      395     ,input   buf_ord-doc.exch-rate
      396     ,input   buf_ord-doc.exch-scale
      397     ,input   buf_ord-doc.vat-type
      398     ,input   buf_ord-doc.slt-type
      399     ,input   ub.ord-line.artic
      400     ,input   ub.ord-line.prod-type
      401     ,input   ub.ord-line.prod-code
      402     ,input   ub.ord-line.price-cli
      403     ,input   ub.ord-line.cli-base-rate
      404     ,input   ub.ord-line.price-rubl
      405     ,input   ub.ord-line.vat-pc
      406     ,input   ub.ord-line.slt-pc
      407     ,input   ub.ord-line.road-tax
      408     ,input   ub.ord-line.transport-rubl
      409     ,input   ub.ord-line.other-rubl
      410     ,output  varprice-cli
      411     ,output  varprice-cli-unit-base
      412     ,output  varprice-road-tax
      413     ,output  varprice-other-exp
      414     ,output  varprice-transport-exp
      415     ,output  varprice-without-abs
      416     ,output  varprice-slt
      417     ,output  varprice-no-slt
      418     ,output  varprice-vat
      419     ,output  varprice-no-vat-slt
      420     ,output  varprice-rubl
      421     ,output  varprice-road-tax-rubl
      422     ,output  varprice-other-exp-rubl
      423     ,output  varprice-transport-exp-rubl
      424     ,output  varprice-without-abs-rubl
      425     ,output  varprice-slt-rubl
      426     ,output  varprice-no-slt-rubl
      427     ,output  varprice-vat-rubl
      428     ,output  varprice-no-vat-slt-rubl
      429     ,output  varprice-base
      430     ,output  varprice-road-tax-base
      431     ,output  varprice-other-exp-base
      432     ,output  varprice-transport-exp-base
      433     ,output  varprice-without-abs-base
      434     ,output  varprice-slt-base
      435     ,output  varprice-no-slt-base
      436     ,output  varprice-vat-base
      437     ,output  varprice-no-vat-slt-base
      438     ) no-error.
      439           ub.ord-line.sum-vat    = if var-r-b = "rubl" then round(varprice-vat-rubl,2)
      440                                                        else round(varprice-vat-base,2)
      441           .
      442      end.
      443   end.
      444   find first buf_goods no-lock where
      445              buf_goods.artic = ub.ord-line.artic and
      446              buf_goods.prod-type = ub.ord-line.prod-type  and
      447              buf_goods.prod-code = ub.ord-line.prod-code no-error .
      448   if available buf_goods then
      449   assign
      450     ub.ord-line.gds-code = buf_goods.gds-code
      451   .
      452     if new(ub.ORD-line) then do:
      453         create ub.c-ord-line.
      454         BUFFER-COPY ub.ord-line  TO ub.c-ord-line
      455         assign
      456           ub.c-ord-line.chip-num           = next-value (s-corr-chip, ub)
      457           ub.c-ord-line.corr-time          = start-time
      458           ub.c-ord-line.corr-user-db-num   = g#db-num
      459           ub.c-ord-line.corr-user-name     = g#userid
      460           ub.c-ord-line.corr-date          = v-today
      461       .
      462     end.
      463   define buffer old_c-ord-doc for ub.c-ord-doc.
      464     find first old_c-ord-doc no-lock  where
      465                old_c-ord-doc.doc-code  =  old_ord-line.doc-code
      466                no-error .
      467     if not error-status :error  then do:
      468     if old_ord-line.qnty <> ub.ord-line.qnty or
      469        old_ord-line.cli-qnty <> ub.ord-line.cli-qnty or
      470        old_ord-line.cli-base-rate <> ub.ord-line.cli-base-rate or
      471        old_ord-line.price-base <> ub.ord-line.price-base or
      472        old_ord-line.price-rubl <> ub.ord-line.price-rubl or
      473        old_ord-line.price-cli <> ub.ord-line.price-cli
      474        then do:
      475           run cur-time in this-procedure ( output v-today
      476                                          , output start-time ) .
      477             create ub.c-ord-line.
      478             BUFFER-COPY old_ord-line  TO ub.c-ord-line
      479             assign
      480               ub.c-ord-line.chip-num           = next-value (s-corr-chip, ub)
      481               ub.c-ord-line.corr-time          = start-time
      482               ub.c-ord-line.corr-user-db-num   = g#db-num
      483               ub.c-ord-line.corr-user-name     = g#userid
      484               ub.c-ord-line.corr-date          = v-today
      485           .
      486            if available buf_ord-doc then do:
      487             create ub.c-ord-doc.
      488             BUFFER-COPY buf_ord-doc  TO ub.c-ord-doc
      489             assign
      490               ub.c-ord-doc.chip-num           = ub.c-ord-line.chip-num
      491               ub.c-ord-doc.corr-time          = start-time
      492               ub.c-ord-doc.corr-user-db-num   = g#db-num
      493               ub.c-ord-doc.corr-user-name     = g#userid
      494               ub.c-ord-doc.corr-date          = v-today
      495           .
      496           end.
      497           else do:
      498             create ub.c-ord-doc.
      499             BUFFER-COPY old_ord-line TO ub.c-ord-doc
      500             assign
      501               ub.c-ord-doc.chip-num           = ub.c-ord-line.chip-num
      502               ub.c-ord-doc.corr-time          = start-time
      503               ub.c-ord-doc.corr-user-db-num   = g#db-num
      504               ub.c-ord-doc.corr-user-name     = g#userid
      505               ub.c-ord-doc.corr-date          = v-today
      506           .
      507           end.
      508        end.
      509     end.
      510       if g#oxml = yes
      511       then do:
      512       run str/calloxml.p (
      513             input 'update':U
      514           , input 'ord-line':U
      515           , input ( buffer ub.ord-line:handle )
      516       ) no-error.
      517       if error-status :error
      518       then do:
      519           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      520                                , chr(10)
      521                                , vss-workfile
      522                                , return-value
      523                                , error-status :get-message ( 1 ) ).
      524       end.
      525       end.
      526   end.
