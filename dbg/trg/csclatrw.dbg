        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-scales-attr.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись истории атрибутов весов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                                             , ub.c-scales-attr.db-num
       30                                             , ub.c-scales-attr.scales-num
       31                                             , ub.c-scales-attr.attr-code
       32                                             , ub.c-scales-attr.corr-user-db-num
       33                                             , ub.c-scales-attr.chip-num)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure cur-time :
       89      define output parameter p-today as date      no-undo .
       90      define output parameter p-time  as integer   no-undo .
       91     do
       92     on error undo, return error
       93     :
       94       define variable v-date1 as date      no-undo .
       95       define variable v-date2 as date      no-undo .
       96       define variable v-time  as integer   no-undo .
       97       assign
       98         v-date1 = today
       99         v-time  = time
      100         v-date2 = today
      101       .
      102       if v-date1 <> v-date2
      103       then do:
      104         assign
      105           v-date1 = today
      106           v-time  = v-time
      107         .
      108       end.
      109       assign
      110         p-today = v-date1
      111         p-time  = v-time
      112       .
      113     end.
      114   end.
      115   function cur-time-date returns character
      116   :
      117     return string(today, '99/99/9999':U) .
      118   end.
      119   function cur-time-mjd returns decimal
      120   :
      121     define variable v-date as date      no-undo .
      122     define variable v-time as integer   no-undo .
      123     run cur-time in this-procedure
      124       (output v-date
      125       ,output v-time
      126       ) .
      127     return integer(v-date) - 2400002 + (v-time / 86400) .
      128   end.
      129   function cur-time-get-ending-index returns integer
      130   (input p-number as integer
      131   )
      132   :
      133     if p-number < 0
      134     or p-number = ?
      135     then do:
      136       return 1 .
      137     end.
      138     define variable v-rest as integer   no-undo .
      139     assign
      140       p-number = p-number modulo 100
      141     .
      142     if p-number < 20
      143     then do:
      144       assign
      145         v-rest = p-number
      146       .
      147     end.
      148     else do:
      149       assign
      150         v-rest = p-number modulo 10
      151       .
      152     end.
      153     case v-rest :
      154       when 1
      155       then do:
      156         return 2 .
      157       end.
      158       when 2 or
      159       when 3 or
      160       when 4
      161       then do:
      162         return 3 .
      163       end.
      164       otherwise do:
      165         return 1 .
      166       end.
      167     end case .
      168   end.
      169   procedure cur-time-mjd-to-date :
      170      define input  parameter i-mjd-diff as decimal no-undo.
      171      define output parameter o-Date     as date    no-undo.
      172      define output parameter o-Time     as integer no-undo.
      173      define variable v-day-number as integer   no-undo .
      174      if    i-mjd-diff < 0
      175         or i-mjd-diff = ?
      176      then do:
      177         return "?" .
      178      end.
      179      assign
      180         v-day-number = truncate(i-mjd-diff,0).
      181         o-Date = date(v-day-number + 2400002).
      182         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184   end.
      185   function cur-time-mjd-to-string returns character
      186   (input p-mjd-diff as decimal
      187   )
      188   :
      189     define variable v-day-number as integer   no-undo .
      190     define variable v-seconds    as integer   no-undo .
      191     define variable v-hour       as integer   no-undo .
      192     define variable v-min        as integer   no-undo .
      193     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      194     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      195     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      196     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      197     if p-mjd-diff < 0
      198     or p-mjd-diff = ?
      199     then do:
      200       return "?" .
      201     end.
      202     assign
      203       v-day-number = integer(truncate(p-mjd-diff,0))
      204       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206     if v-seconds > 86400
      207     then do:
      208       assign
      209         v-seconds = 86400 - 1
      210       .
      211     end.
      212     if v-seconds < 0
      213     then do:
      214       assign
      215         v-seconds = 0
      216       .
      217     end.
      218     assign
      219       v-hour = truncate(v-seconds / 3600, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 3600
      223     .
      224     assign
      225       v-min = truncate(v-seconds / 60, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 60
      229     .
      230     return
      231         (if v-day-number <> 0
      232           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0
      236           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      240           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      241           else ""
      242         )
      243       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      244       .
      245   end.
      246   function cur-time-string returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      255   end.
      256   function cur-time-string-sec returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      265   end.
      266   function cur-time-custom  returns character
      267   (input p-prefix as character
      268   ,input p-date-format as character
      269   ,input p-delimiter as character
      270   ,input p-time-format as character
      271   ,input p-suffix as character
      272   )
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return
      281       p-prefix
      282       + string(v-date, p-date-format)
      283       + p-delimiter
      284       + string(v-time, p-time-format)
      285       + p-suffix
      286       .
      287   end.
      288   function cur-time-print  returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-datetime returns datetime
      299   :
      300     define variable v-char as character no-undo .
      301     define variable v-datetime as datetime no-undo .
      302     v-char = cur-time-string().
      303     v-datetime = datetime(v-char).
      304     return  v-datetime.
      305   end.
      306   function cur-time-string-msec returns character
      307   :
      308     define variable v-date as datetime  no-undo .
      309     v-date = now.
      310     return string(v-date) .
      311   end.
      312   procedure scl-attr-code :
      313     do
      314     on error undo, return error
      315     :
      316       define input  parameter p-code           as character no-undo .
      317       define output parameter p-type           as character no-undo .
      318       define output parameter p-format         as character no-undo .
      319       define output parameter p-label          as character no-undo .
      320       define output parameter p-user-can-edit  as logical   no-undo .
      321       define output parameter p-output-display as logical   no-undo .
      322       define output parameter p-other          as character no-undo .
      323       case p-code :
      324               when 'tare-weight':U then do:     assign     p-label = "Веса и коды тары"     p-type = 'C':U      p-format = "X(32)"     p-label = "Веса и коды тары"     p-user-can-edit  = yes     p-output-display = true     p-other = 'scl=TIGER,MIRA,TIGER2,TIGER-SPCT2/spr=scl-attr-tare-weight':u      .   end.
      325         otherwise do:
      326           undo, return error "неизвестный атрибут весов" + " " + p-code .
      327         end.
      328       end.
      329     end.
      330   end procedure.
      331   procedure scl-attr-tooltip :
      332     do
      333     on error undo, return error
      334     :
      335       define input  parameter p-code    as character no-undo .
      336       define output parameter p-tooltip as character no-undo .
      337       define output parameter p-label   as character no-undo .
      338       case p-code :
      339               when 'tare-weight':U then do:     assign     p-tooltip = "Веса и коды тары"     p-label = "Веса и коды тары" .   end.
      340         otherwise do:
      341           undo, return error "неизвестный атрибут весов" + " " + p-code .
      342         end.
      343       end.
      344     end.
      345   end procedure.
      346   procedure scl-attr-value :
      347     do
      348     on error undo, return error
      349     :
      350       define input  parameter p-db-num   like ub.scales-attr.db-num        no-undo .
      351       define input  parameter p-scales-num like ub.scales-attr.scales-num      no-undo .
      352       define input  parameter p-code     like ub.scales-attr.attr-code      no-undo .
      353       define output parameter p-value    like ub.scales-attr.attr-value    no-undo .
      354       define output parameter p-type     as character no-undo .
      355       define buffer buf_scales-attr for ub.scales-attr .
      356       define variable v-format         as character no-undo .
      357       define variable v-label          as character no-undo .
      358       define variable v-user-can-edit  as logical   no-undo .
      359       define variable v-output-display as logical   no-undo .
      360       define variable v-other          as character no-undo .
      361       run scl-attr-code in this-procedure
      362         (input  p-code
      363         ,output p-type
      364         ,output v-format
      365         ,output v-label
      366         ,output v-user-can-edit
      367         ,output v-output-display
      368         ,output v-other
      369         ) no-error .
      370       if error-status :error then do:
      371         undo, return error return-value .
      372       end.
      373       find first buf_scales-attr no-lock
      374         where buf_scales-attr.db-num    = p-db-num
      375           and buf_scales-attr.scales-num  = p-scales-num
      376           and buf_scales-attr.attr-code = p-code
      377         no-error .
      378       if avail buf_scales-attr then do:
      379         assign
      380           p-value =  buf_scales-attr.attr-value
      381         .
      382       end.
      383       else do:
      384         assign
      385           p-value = if p-type = 'L':U then "no":U else ""
      386         .
      387       end.
      388     end.
      389   end procedure.
      390   procedure scl-attr-write :
      391     do
      392     on error undo, return error
      393     :
      394       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      395       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      396       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      397       define input parameter p-value    like ub.scales-attr.attr-value no-undo .
      398       define buffer buf_scales-attr for ub.scales-attr .
      399       define variable v-type           as character no-undo .
      400       define variable v-format         as character no-undo .
      401       define variable v-label          as character no-undo .
      402       define variable v-user-can-edit  as logical   no-undo .
      403       define variable v-output-display as logical   no-undo .
      404       define variable v-other          as character no-undo .
      405       run scl-attr-code in this-procedure
      406         (input  p-code
      407         ,output v-type
      408         ,output v-format
      409         ,output v-label
      410         ,output v-user-can-edit
      411         ,output v-output-display
      412         ,output v-other
      413         ) no-error .
      414       if error-status :error then do:
      415         undo, return error return-value .
      416       end.
      417       find first buf_scales-attr exclusive-lock
      418         where buf_scales-attr.db-num  = p-db-num
      419           and buf_scales-attr.scales-num  = p-scales-num
      420           and buf_scales-attr.attr-code = p-code
      421         no-error .
      422       if not available buf_scales-attr then do:
      423         create buf_scales-attr .
      424         assign
      425           buf_scales-attr.db-num    = p-db-num
      426           buf_scales-attr.scales-num  = p-scales-num
      427           buf_scales-attr.attr-code = p-code
      428         .
      429       end.
      430       assign
      431         buf_scales-attr.attr-value = p-value
      432       .
      433       release buf_scales-attr no-error .
      434       if error-status:error then do:
      435         undo, return error return-value .
      436       end.
      437     end.
      438   end procedure.
      439   procedure scl-attr-exist :
      440     do
      441     on error undo, return error
      442     :
      443       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      444       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      445       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      446       define output parameter p-exist   as logical  no-undo .
      447       define buffer buf_scales-attr for ub.scales-attr .
      448       define variable v-type           as character no-undo .
      449       define variable v-format         as character no-undo .
      450       define variable v-label          as character no-undo .
      451       define variable v-user-can-edit  as logical   no-undo .
      452       define variable v-output-display as logical   no-undo .
      453       define variable v-other          as character no-undo .
      454       run scl-attr-code in this-procedure
      455         (input  p-code
      456         ,output v-type
      457         ,output v-format
      458         ,output v-label
      459         ,output v-user-can-edit
      460         ,output v-output-display
      461         ,output v-other
      462         ) no-error .
      463       if error-status :error then do:
      464         undo, return error return-value .
      465       end.
      466       find first buf_scales-attr exclusive-lock
      467         where buf_scales-attr.db-num  = p-db-num
      468           and buf_scales-attr.scales-num  = p-scales-num
      469           and buf_scales-attr.attr-code = p-code
      470         no-error .
      471       if  available buf_scales-attr then do:
      472         p-exist = yes.
      473       end.
      474     end.
      475   end procedure.
      476   procedure scl-attr-delete :
      477     do
      478     on error undo, return error
      479     :
      480       define input parameter p-db-num   like ub.scales-attr.db-num     no-undo .
      481       define input parameter p-scales-num like ub.scales-attr.scales-num   no-undo .
      482       define input parameter p-code     like ub.scales-attr.attr-code  no-undo .
      483       define output parameter p-deleted  as logical no-undo.
      484       define buffer buf_scales-attr for ub.scales-attr .
      485       define variable v-type           as character no-undo .
      486       define variable v-format         as character no-undo .
      487       define variable v-label          as character no-undo .
      488       define variable v-user-can-edit  as logical   no-undo .
      489       define variable v-output-display as logical   no-undo .
      490       define variable v-other          as character no-undo .
      491       run scl-attr-code in this-procedure
      492         (input  p-code
      493         ,output v-type
      494         ,output v-format
      495         ,output v-label
      496         ,output v-user-can-edit
      497         ,output v-output-display
      498         ,output v-other
      499         ) no-error .
      500       if error-status :error then do:
      501         undo, return error return-value .
      502       end.
      503       find first buf_scales-attr exclusive-lock
      504         where buf_scales-attr.db-num  = p-db-num
      505           and buf_scales-attr.scales-num  = p-scales-num
      506           and buf_scales-attr.attr-code = p-code
      507         no-error NO-WAIT.
      508       if not available buf_scales-attr then do:
      509         p-deleted = no.
      510       end.
      511       else do:
      512         delete buf_scales-attr no-error .
      513         if error-status:error then do:
      514           undo, return error return-value .
      515         end.
      516         p-deleted = yes.
      517       end.
      518     end.
      519   end procedure.
      520   procedure scl-attr-news :
      521     do
      522     on error undo, return error
      523     :
      524       define input  parameter p-code           as character no-undo .
      525       define output parameter p-news           as logical   no-undo .
      526       case p-code :
      527               when 'tare-weight':U then do:     assign     p-news = yes.   end.
      528         otherwise do:
      529           p-news = no.
      530         end.
      531       end.
      532     end.
      533   end procedure.
      534   procedure scl-attr-hist :
      535     do
      536     on error undo, return error
      537     :
      538       define input  parameter p-code           as character no-undo .
      539       define output parameter p-hist           as logical   no-undo .
      540       case p-code :
      541               when 'tare-weight':U then do:     assign     p-hist = yes.   end.
      542         otherwise do:
      543           p-hist = no.
      544         end.
      545       end.
      546     end.
      547   end procedure.
      548   define variable p-news as logical no-undo .
      549   define buffer buf_scales for ub.scales.
      550   main-block:
      551   do
      552   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      553   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      554   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      555   :
      556     run scl-attr-news in this-procedure (
      557                                          input ub.c-scales-attr.attr-code
      558                                          ,output p-news) no-error.
      559     if p-news
      560     and (not g#news
      561     or (g#news
      562         and ( g#db-num > 0 )
      563         and ub.c-scales-attr.corr-user-name = (chr(4) +  'СПН':U)
      564         )
      565     )
      566     then do:
      567       run str/callnews.p
      568         (input 'c-scales-attr':U
      569         ,input (buffer ub.c-scales-attr:handle)
      570         ).
      571     end.
      572       if g#oxml = yes
      573       then do:
      574       run str/calloxml.p (
      575             input 'update':U
      576           , input 'c-scales-attr':U
      577           , input ( buffer ub.c-scales-attr:handle )
      578       ) no-error.
      579       if error-status :error
      580       then do:
      581           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      582                                , chr(10)
      583                                , vss-workfile
      584                                , return-value
      585                                , error-status :get-message ( 1 ) ).
      586       end.
      587       end.
      588   end.
