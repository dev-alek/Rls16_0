        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-var-deliv-gr-per-val.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись в таблице ИСТОРИЯ ВАРИАНТОВ ДОСТАВКИ ПО ГРУППАМ СРОКОВ ГОДНОСТИ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7', ub.c-var-deliv-gr-per-val.deliv-type-code,
       29                                                   ub.c-var-deliv-gr-per-val.deliv-subj-code,
       30                                                 ub.c-var-deliv-gr-per-val.obj-type,
       31                                                 ub.c-var-deliv-gr-per-val.obj-code,
       32                                                 ub.c-var-deliv-gr-per-val.gr-per-val-code,
       33                                                 ub.c-var-deliv-gr-per-val.corr-user-db-num,
       34                                                 ub.c-var-deliv-gr-per-val.chip-num
       35                                                 )
       36       .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define buffer buf_delivery-type for ub.delivery-type.
       89   define buffer buf_delivery-subject for ub.delivery-subject.
       90   define buffer buf_group-period-validity for ub.group-period-validity.
       91   define buffer buf_clients for ub.clients.
       92   define buffer buf_var-deliv-gr-per-val for ub.var-deliv-gr-per-val.
       93   main-block:
       94   do
       95   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       96   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       97   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       98   :
       99     if not g#news then do:
      100       find first buf_delivery-type no-lock where
      101                  buf_delivery-type.deliv-type-code = c-var-deliv-gr-per-val.deliv-type-code  no-error .
      102       if not available buf_delivery-type then do:
      103         message
      104         vss-workfile vss-revision vss-description skip
      105         "Неправильная ссылка на ТИП ДОСТАВКИ" skip
      106         "код" c-var-deliv-gr-per-val.deliv-type-code skip
      107          view-as alert-box error .
      108         undo main-block, return error.
      109       end.
      110       find first buf_delivery-subject no-lock where
      111                  buf_delivery-subject.deliv-subj-code = c-var-deliv-gr-per-val.deliv-subj-code  no-error .
      112       if not available buf_delivery-subject then do:
      113         message
      114         vss-workfile vss-revision vss-description skip
      115         "Неправильная ссылка на СУБЪЕКТ ДОСТАВКИ" skip
      116         "код" c-var-deliv-gr-per-val.deliv-subj-code skip
      117          view-as alert-box error .
      118         undo main-block, return error.
      119       end.
      120       find first buf_group-period-validity no-lock where
      121                  buf_group-period-validity.gr-per-val-code = c-var-deliv-gr-per-val.gr-per-val-code  no-error .
      122       if not available buf_delivery-type then do:
      123         message
      124         vss-workfile vss-revision vss-description skip
      125         "Неправильная ссылка на ГРУППУ СРОКОВ ГОДНОСТИ" skip
      126         "код" c-var-deliv-gr-per-val.deliv-type-code skip
      127          view-as alert-box error .
      128         undo main-block, return error.
      129       end.
      130       find first buf_clients no-lock where
      131                  buf_clients.obj-type = c-var-deliv-gr-per-val.obj-type
      132              AND buf_clients.obj-code = c-var-deliv-gr-per-val.obj-code
      133                  no-error .
      134       if not available buf_clients then do:
      135         message
      136         vss-workfile vss-revision vss-description skip
      137         "Неправильная ссылка на ОБЪЕКТ ДОСТАВКИ" skip
      138         "тип" c-var-deliv-gr-per-val.obj-type    skip
      139         "код" c-var-deliv-gr-per-val.obj-code   skip
      140          view-as alert-box error .
      141         undo main-block, return error.
      142       end.
      143       find first buf_var-deliv-gr-per-val no-lock where
      144                  buf_var-deliv-gr-per-val.deliv-type-code = c-var-deliv-gr-per-val.deliv-type-code
      145              AND buf_var-deliv-gr-per-val.deliv-subj-code = c-var-deliv-gr-per-val.deliv-subj-code
      146                  no-error .
      147       if not available buf_var-deliv-gr-per-val then do:
      148         message
      149         vss-workfile vss-revision vss-description skip
      150         "Неправильная ссылка на ВАРИАНТ ДОСТАВКИ" skip
      151         "код типа доставки" c-var-deliv-gr-per-val.deliv-type-code skip
      152         "код субъекта доставки" c-var-deliv-gr-per-val.deliv-subj-code skip
      153         "тип объекта доставки" c-var-deliv-gr-per-val.obj-type    skip
      154         "код объекта доставки" c-var-deliv-gr-per-val.obj-code   skip
      155         "код группы сроков годности" c-var-deliv-gr-per-val.gr-per-val-code skip
      156          view-as alert-box error .
      157         undo main-block, return error.
      158       end.
      159     end.
      160     if not g#news then do:
      161       if ( g#db-num > 0 ) then do:
      162         message
      163         vss-workfile vss-revision vss-description skip
      164         "Нельзя создавать записи истории ВАРИАНТА ДОСТАВКИ ПО СРОКАМ ГОДНОСТИ в УБД" skip
      165         view-as alert-box error .
      166         undo main-block, return error.
      167       end.
      168     end.
      169     run str/callnews.p
      170       (input "c-var-deliv-gr-per-val"
      171       ,input (buffer ub.c-var-deliv-gr-per-val:handle)
      172       ).
      173       if g#oxml = yes
      174       then do:
      175       run str/calloxml.p (
      176             input 'update':U
      177           , input 'c-var-deliv-gr-per-val':U
      178           , input ( buffer ub.c-var-deliv-gr-per-val:handle )
      179       ) no-error.
      180       if error-status :error
      181       then do:
      182           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      183                                , chr(10)
      184                                , vss-workfile
      185                                , return-value
      186                                , error-status :get-message ( 1 ) ).
      187       end.
      188       end.
      189   end.
