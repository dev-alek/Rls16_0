        1   block-level on error undo, throw.
        2   define input  parameter p-in-code    as character no-undo .
        3   define input  parameter p-gds-code   as integer   no-undo .
        4   define input  parameter p-part-code  as character no-undo .
        5   define input  parameter p-last-date  as date      no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Изменение срока годности для партии приходной накладной".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define buffer buf_gds-obj for ub.gds-obj .
       69   define buffer buf_parts for ub.parts .
       70   define buffer buf_parts-attr for ub.parts-attr .
       71   define variable v-artic     as character no-undo .
       72   define variable v-prod-type as character no-undo .
       73   define variable v-prod-code as integer   no-undo .
       74   main-block:
       75   do transaction
       76   on error undo main-block, return error
       77   :
       78     for each ub.gds-obj no-lock
       79       where ub.gds-obj.gds-code = p-gds-code
       80     on error undo main-block, return error
       81     :
       82       find first buf_gds-obj exclusive-lock
       83         where recid(buf_gds-obj) = recid(ub.gds-obj)
       84         .
       85     end.
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run arptpc in g#library
       88     (input  p-gds-code
       89     ,output v-artic
       90     ,output v-prod-type
       91     ,output v-prod-code
       92     )  .
       93     find first buf_parts-attr exclusive-lock
       94       where buf_parts-attr.in-code   = p-in-code
       95         and buf_parts-attr.gds-code  = p-gds-code
       96         and buf_parts-attr.part-code = p-part-code
       97       no-error .
       98     if available buf_parts-attr
       99     then do:
      100       assign
      101         buf_parts-attr.last-date = p-last-date
      102       .
      103     end.
      104     for each ub.parts share-lock
      105       where ub.parts.in-code   = p-in-code
      106         and ub.parts.artic     = v-artic
      107         and ub.parts.prod-type = v-prod-type
      108         and ub.parts.prod-code = v-prod-code
      109         and ub.parts.part-code = p-part-code
      110     on error undo main-block, return error
      111     :
      112       if ub.parts.last-date <> p-last-date
      113       then do:
      114         find first buf_parts exclusive-lock
      115           where recid(buf_parts) = recid(ub.parts)
      116           .
      117         assign
      118           buf_parts.last-date = p-last-date
      119         .
      120       end.
      121     end.
      122   end.
