        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.inkas OLD old-inkas .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись inkas".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2', ub.inkas.inkas-code, ub.inkas.status_)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure write-inkas-history :
      308   define parameter buffer buf_inkas for ub.inkas.
      309   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
      310   define input parameter p-host-code like ub.inkas.host-code no-undo .
      311   define input parameter p-obj-type like ub.inkas.obj-type no-undo .
      312   define input parameter p-obj-code like ub.inkas.obj-code no-undo .
      313   define variable v-date as date no-undo .
      314   define variable v-time as integer no-undo .
      315   define variable v-message as character no-undo .
      316   define variable varobj-date as date no-undo .
      317   define variable varshift-date as date no-undo .
      318   define variable varshift-num as integer no-undo .
      319   define variable v-shift-name as character no-undo.
      320   define variable l-shift-on as logical no-undo .
      321   define variable varshift-name as character no-undo .
      322   define buffer buf_c-inkas for ub.c-inkas.
      323   define buffer buf_c-inkas-pay for ub.c-inkas-pay.
      324   define buffer buf_c-inkas-pay-desk for ub.c-inkas-pay-desk.
      325   define buffer buf_c-inkas-pay-wth for ub.c-inkas-pay-wth.
      326     do
      327     on error undo, return error
      328     :
      329       run cur-time in this-procedure(output v-date, output v-time).
      330   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      332     (input  p-obj-type
      333     ,input  p-obj-code
      334     ,output varobj-date
      335     ) no-error .
      336     if error-status :error
      337     or varobj-date = ?
      338     then do:
      339      v-message = substitute("Нет текущей даты на объекте продажи &1 &2&3&4&5 &6"
      340                   , buf_inkas.inkas-code
      341                   , p-obj-type
      342                   , p-obj-code
      343                   , chr(10)
      344                   , error-status:get-message(1)
      345                   , return-value
      346                   ).
      347       undo, return error v-message.
      348     end.
      349   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      351     (input  p-obj-type
      352     ,input  p-obj-code
      353     ,input  'shift-on=request'
      354     ,output l-shift-on
      355     )  .
      356     if l-shift-on then do:
      357   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
      359     (input  p-obj-type
      360     ,input  p-obj-code
      361     ,output varshift-date
      362     ,output varshift-num
      363     ,output varshift-name
      364     ) no-error .
      365     end.
      366     else do:
      367       assign
      368         varshift-date = ?
      369         varshift-num  = ?
      370       .
      371     end.
      372       create buf_c-inkas.
      373       buffer-copy buf_inkas to buf_c-inkas
      374       assign
      375       buf_c-inkas.inkas-code         = p-inkas-code
      376       buf_c-inkas.obj-type           = p-obj-type
      377       buf_c-inkas.obj-code           = p-obj-code
      378       buf_c-inkas.host-code          = p-host-code
      379       buf_c-inkas.chip-num           = next-value (s-corr-chip, ub)
      380       buf_c-inkas.corr-time          = v-time
      381       buf_c-inkas.corr-user-name     = g#userid
      382       buf_c-inkas.real-corr-date     = v-date
      383       buf_c-inkas.corr-date          = varobj-date
      384       buf_c-inkas.corr-shift-date    = varshift-date
      385       buf_c-inkas.corr-shift-num     = varshift-num
      386       buf_c-inkas.corr-shift-name    = varshift-name
      387       buf_c-inkas.corr-user-db-num   = g#db-num
      388       .
      389       release buf_c-inkas.
      390     end.
      391   end procedure.
      392   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   define new global shared variable g#trdcalib as handle no-undo.
      394   define variable conf-par        as character no-undo .
      395   define variable par-type        as character no-undo .
      396   define variable v-creating-hist as logical   no-undo .
      397   define variable v-cmp           as character no-undo .
      398   define variable varshift-name   as character no-undo .
      399   define variable v-attr-value    as character no-undo .
      400   define variable v-attr-type     as character no-undo .
      401   define variable v-send          as logical   no-undo .
      402   define buffer buf_sysconf  for ub.sysconf .
      403   define buffer buf_cash-pay for ub.cash-pay.
      404   define buffer buf_trn-doc  for ub.trn-doc.
      405   main-block:
      406   do
      407       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      408       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      409       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      410       :
      411       if not g#news
      412           then
      413       do:
      414   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
      416     (output ub.inkas.user-db-num
      417     ,output ub.inkas.user-name
      418     ,output ub.inkas.sys-date
      419     ,output ub.inkas.sys-time
      420     ,output ub.inkas.sys-time-int
      421     )  .
      422       end.
      423       if  not new ub.inkas
      424           and (old-inkas.status_ = 'факт':U or old-inkas.status_ = 'запрос':U)
      425           and ub.inkas.status_  <> old-inkas.status_ then
      426       do:
      427           message
      428               vss-workfile vss-revision vss-description skip
      429               "Изменение статуса продажи невозможно" skip
      430               "Продажа" ub.inkas.inkas-code skip
      431               "Продажа закрыта до статуса" 'факт':U skip
      432               "Нельзя изменить статус продажи на" ub.inkas.status_ skip
      433               view-as alert-box error .
      434           undo main-block, return error.
      435       end.
      436       if not g#news then
      437       do:
      438           buffer-compare old-INKAS
      439               to ub.inkas
      440               case-sensitive
      441               save result in v-cmp
      442               .
      443           if v-cmp <> "":U
      444               and (lookup('status_':U, v-cmp) > 0
      445               or
      446               lookup('sale-filter':U, v-cmp) > 0
      447               or
      448               lookup('is-auto-born':U, v-cmp) > 0
      449               or
      450               lookup('is-auto-close':U, v-cmp) > 0
      451               or
      452               lookup('is-auto-get':U, v-cmp) > 0
      453               or
      454               lookup('is-auto-rsrv':U, v-cmp) > 0
      455               or
      456               lookup('doc-date':U, v-cmp) > 0
      457               or
      458               lookup('fact-date':U, v-cmp) > 0
      459               or
      460               lookup('flag_':U, v-cmp) > 0
      461               or
      462               lookup('shift-date':U, v-cmp) > 0
      463               or
      464               lookup('shift-num':U, v-cmp) > 0
      465               or
      466               lookup('shift-name':U, v-cmp) > 0
      467               or
      468               lookup('acc-date':U, v-cmp) > 0
      469               or
      470               lookup('user-name':U, v-cmp) > 0
      471               )
      472               then
      473           do:
      474               assign
      475                   v-creating-hist = yes
      476                   .
      477               run write-inkas-history in this-procedure (buffer old-INKAS
      478                   ,ub.inkas.inkas-code
      479                   ,ub.inkas.host-code
      480                   ,ub.inkas.obj-type
      481                   ,ub.inkas.obj-code).
      482           end.
      483       end.
      484       if old-inkas.status_ = ub.inkas.status_ then
      485       do:
      486           return .
      487       end.
      488       if  not g#news
      489           and ub.inkas.status_ = 'запрос':U
      490           then
      491       do:
      492           assign
      493               v-send = no
      494               .
      495           define buffer buf_Sale-doc for ub.sale-doc.
      496           _trn-doc:
      497           for each buf_sale-doc no-lock where
      498               buf_sale-doc.inkas-code = ub.inkas.inkas-code,
      499               first buf_trn-doc no-lock where
      500               buf_trn-doc.doc-code = buf_Sale-doc.doc-code
      501               or buf_trn-doc.out-code = ub.inkas.inkas-code
      502               on error
      503               undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) ):
      504               if buf_trn-doc.ext-doc-type = 'es':U
      505                   or buf_trn-doc.ext-doc-type = 'rs':U
      506                   or buf_sale-doc.order > 0
      507                   then
      508               do:
      509                   v-send = yes.
      510               end.
      511               if v-send then
      512               do:
      513                   run str/callnews.p (
      514                       input 'trn-doc':U
      515                       ,input (buffer buf_trn-doc:handle)
      516                       ) no-error .
      517                   if error-status :error then
      518                   do:
      519                       message
      520                           vss-workfile vss-revision vss-description skip
      521                           "Невозможно маршрутизировать запрос для продажи для отправки в новости" skip
      522                           "Документ" buf_trn-doc.doc-code skip
      523                           error-status :get-message(1) skip
      524                           return-value skip
      525                           view-as alert-box error .
      526                       undo, return error .
      527                   end.
      528               end.
      529           end.
      530       end.
      531       if  not g#news
      532           and (ub.inkas.status_ = 'факт':U
      533           or
      534           ub.inkas.status_ = 'запрос':U)
      535           then
      536       do:
      537           run str/callnews.p
      538               (input 'inkas':U
      539               ,input (buffer ub.inkas:handle)
      540               ) no-error .
      541           if error-status :error then
      542           do:
      543               message
      544                   vss-workfile vss-revision vss-description skip
      545                   "Невозможно маршрутизировать inkas для отправки в новости" skip
      546                   "Документ" ub.inkas.inkas-code skip
      547                   error-status :get-message(1) skip
      548                   return-value skip
      549                   view-as alert-box error .
      550               undo, return error .
      551           end.
      552       end.
      553       run trg/userlog.p (
      554           input 'create':U
      555           , input 'inkas':U
      556           , input ( buffer ub.inkas :handle )
      557           , input ?
      558           , input ""
      559           ) no-error.
      560       if error-status :error
      561           then
      562       do:
      563           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      564               , chr(10)
      565               , vss-workfile
      566               , return-value
      567               , error-status :get-message ( 1 ) ).
      568       end.
      569       if g#oxml = yes
      570           then
      571       do:
      572           run str/calloxml.p (
      573               input 'update':U
      574               , input 'inkas':U
      575               , input ( buffer ub.inkas:handle )
      576               ) no-error.
      577           if error-status :error
      578               then
      579           do:
      580               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      581                   , chr(10)
      582                   , vss-workfile
      583                   , return-value
      584                   , error-status :get-message ( 1 ) ).
      585           end.
      586       end.
      587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      588     (input ?
      589     ,input this-procedure:handle
      590     ,input ?
      591     ,input 'event_inkas':U
      592     ,input  buffer old-inkas:handle
      593     ,input  buffer ub.inkas:handle
      594     ,input ''
      595     ,input ''
      596     ) no-error .
      597       if error-status :error
      598           then
      599       do:
      600           return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
      601               , chr(10)
      602               , vss-workfile
      603               , return-value
      604               , error-status :get-message ( 1 ) ).
      605       end.
      606   end.
