        1   block-level on error undo, throw.
        2   define input parameter p-silent                       as logical no-undo .
        3   define input parameter pardoc-code like ub.wth-doc.doc-code no-undo .
        4   define input parameter parhost-code like ub.wth-doc.host-code no-undo .
