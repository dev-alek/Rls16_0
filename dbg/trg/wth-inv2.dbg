      362   DEFINE VARIABLE varpsn-code-list as character no-undo .
      363   define variable v-mes     as character no-undo .
      364   define variable v-file    as logical no-undo .
      365   DEFINE VARIABLE var-entry as character no-undo .
      366   define variable v-type as character no-undo .
      367   define buffer buf_wth-line for ub.wth-line .
      368   define buffer buf_wth-line-exist for ub.wth-line .
      369   define buffer buf_clients for ub.clients .
      370   define buffer buf_person1 for ub.clients .
      371   define buffer buf_person2 for ub.clients .
      372   define buffer buf_person3 for ub.clients .
      373   define buffer buf_person4 for ub.clients .
      374   define buffer buf_person5 for ub.clients .
      375   _main:
      376   do
      377   on error undo, return error return-value
      378   :
      379   if parauto-fill and parobj-type = 'скл':U then do:
      380     v-mes = substitute("Для автоматического документа объект документа &1&2 должен быть магазином", parobj-type, parobj-code).
      381     run err-mess(input-output v-mes).
      382     var-entry = "obj-code":U.
      383     undo _main, return error (if p-silent then v-mes else var-entry).
      384   end.
      385   FIND FIRST buf_wth-line No-LOCK WHERE
      386              buf_wth-line.doc-code = pardoc-code No-ERROR.
      387   if not avail buf_wth-line and  parlines-exist then do:
      388     v-mes = substitute("Нет строк в документе!").
      389     run err-mess(input-output v-mes).
      390     var-entry = "b-add":U.
      391     undo _main, return error (if p-silent then v-mes else var-entry).
      392   end.
      393   if parstaff-exist OR par-operator <> 0 then do:
      394     FIND FIRST buf_person1 NO-LOCK WHERE
      395       buf_person1.obj-type = 'чел':U         AND
      396       buf_person1.obj-code = par-operator NO-ERROR.
      397     IF NOT AVAIL buf_person1 THEN DO:
      398       v-mes = substitute("Не найден оператор &1 в справочнике клиентов!", par-operator).
      399       run err-mess(input-output v-mes).
      400       var-entry = "operator":U.
      401       undo _main, return error (if p-silent then v-mes else var-entry).
      402     END.
      403     varpsn-code-list = varpsn-code-list + string(buf_person1.obj-code) + chr(44).
      404   end.
      405   if parstaff-exist OR par-deliver <> 0 then do:
      406     FIND FIRST buf_person2 NO-LOCK WHERE
      407       buf_person2.obj-type = 'чел':U         AND
      408       buf_person2.obj-code = par-deliver NO-ERROR.
      409     IF NOT AVAIL buf_person2 THEN DO:
      410       v-mes = substitute("Не найден оператор &1 в справочнике клиентов!", par-deliver).
      411       run err-mess(input-output v-mes).
      412       var-entry = "deliver":U.
      413       undo _main, return error (if p-silent then v-mes else var-entry).
      414     END.
      415     if not parauto-fill and lookup(string(buf_person2.obj-code), varpsn-code-list) > 0 then do:
      416       v-mes = substitute("Неверный состав членов инвентаризационной комиссии!").
      417       run err-mess(input-output v-mes).
      418       var-entry = "deliver":U.
      419       undo _main, return error (if p-silent then v-mes else var-entry).
      420     end.
      421     varpsn-code-list = varpsn-code-list + string(buf_person2.obj-code) + chr(44).
      422   end.
      423   if parstaff-exist OR  par-receiver <> 0 then do:
      424     FIND FIRST buf_person3 NO-LOCK WHERE
      425       buf_person3.obj-type = 'чел':U         AND
      426       buf_person3.obj-code = par-receiver NO-ERROR.
      427     IF NOT AVAIL buf_person3 THEN DO:
      428       v-mes = substitute("Не найден оператор &1 в справочнике клиентов!", par-receiver).
      429       run err-mess(input-output v-mes).
      430       var-entry = "receiver":U.
      431       undo _main, return error (if p-silent then v-mes else var-entry).
      432     END.
      433     if not parauto-fill and lookup(string(buf_person3.obj-code), varpsn-code-list) > 0 then do:
      434       v-mes = substitute("Неверный состав членов инвентаризационной комиссии!").
      435       run err-mess(input-output v-mes).
      436       var-entry = "receiver":U.
      437       undo _main, return error (if p-silent then v-mes else var-entry).
      438     end.
      439     varpsn-code-list = varpsn-code-list + string(buf_person3.obj-code) + chr(44).
      440   end.
      441   if parstaff-exist OR  par-inv-prs4 <> 0 then do:
      442     FIND FIRST buf_person4 NO-LOCK WHERE
      443       buf_person4.obj-type = 'чел':U         AND
      444       buf_person4.obj-code = par-inv-prs4 NO-ERROR.
      445     IF NOT AVAIL buf_person4 THEN DO:
      446       v-mes = substitute("Не найден &1 в справочнике клиентов!", par-inv-prs4).
      447       run err-mess(input-output v-mes).
      448       var-entry = "inv-prs4":U.
      449       undo _main, return error (if p-silent then v-mes else var-entry).
      450     END.
      451     if not parauto-fill and lookup(string(buf_person4.obj-code), varpsn-code-list) > 0 then do:
      452       v-mes = substitute("Неверный состав членов инвентаризационной комиссии!").
      453       run err-mess(input-output v-mes).
      454       var-entry = "inv-prs4":U.
      455       undo _main, return error (if p-silent then v-mes else var-entry).
      456     end.
      457     varpsn-code-list = varpsn-code-list + string(buf_person4.obj-code) + chr(44).
      458   end.
      459   if parstaff-exist OR  par-inv-prs5 <> 0 then do:
      460     FIND FIRST buf_person5 NO-LOCK WHERE
      461       buf_person5.obj-type = 'чел':U         AND
      462       buf_person5.obj-code = par-inv-prs5 NO-ERROR.
      463     IF NOT AVAIL buf_person5 THEN DO:
      464       v-mes = substitute("Не найден &1 в справочнике клиентов!", par-inv-prs5).
      465       run err-mess(input-output v-mes).
      466       var-entry = "inv-prs5":U.
      467       undo _main, return error (if p-silent then v-mes else var-entry).
      468     END.
      469     if not parauto-fill and lookup(string(buf_person5.obj-code), varpsn-code-list) > 0 then do:
      470       v-mes = substitute("Неверный состав членов инвентаризационной комиссии!").
      471       run err-mess(input-output v-mes).
      472       var-entry = "inv-prs5":U.
      473       undo _main, return error (if p-silent then v-mes else var-entry).
      474     end.
      475     varpsn-code-list = varpsn-code-list + string(buf_person5.obj-code) + chr(44).
      476   end.
      477   FIND FIRST buf_clients No-LOCK WHERE
      478              buf_clients.obj-type = 'орг':U AND
      479              buf_clients.obj-code = parhost-code No-ERROR.
      480   if not avail buf_clients then do:
      481     v-mes = substitute("Не найдена фирма &1", parhost-code).
      482     run err-mess(input-output v-mes).
      483     undo _main, return error v-mes.
      484   end.
      485   parcli-name = buf_clients.obj-name.
      486   end.
      487   PROCEDURE err-mess:
      488     DEFINE INPUT-output PARAMETER p-mes as character No-UNDO.
      489     p-mes = substitute("Документ МЦ №&1: &2&3&4&5", pardoc-code, parobj-type, parobj-code, chr(10), p-mes).
      490     if not p-silent then
      491     message p-mes view-as alert-box .
      492   END PROCEDURE.
