     3728               error-status :get-message(1) skip
     3729               return-value skip
     3730               view-as alert-box error .
     3731             undo, return error return-value .
     3732           end.
     3733           assign
     3734             temp-ot-line.cat-id    = trim(string(v-goods-vat-pc, ">99")) + ","
     3735                                    + trim(string(v-goods-slt-pc, ">99"))
     3736           .
     3737           if temp-ot-line.cat-id = ?
