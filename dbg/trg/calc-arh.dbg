     6549   procedure check-valid-archives :
     6550     define buffer day_stk-tot   for ub.stk-tot .
     6551     define buffer shift_stk-tot for ub.stk-tot .
     6552     define variable v-different-fields as character no-undo .
     6553     do
     6554     on error undo, return error
     6555     :
     6556       find last day_stk-tot no-lock
     6557         where day_stk-tot.obj-type   = ub.trn-doc.obj-type
     6558           and day_stk-tot.obj-code   = ub.trn-doc.obj-code
     6559           and day_stk-tot.sum-type   = 'crsa':U
     6560           and day_stk-tot.shift-date = ?
     6561         .
     6562       find last shift_stk-tot no-lock
     6563         where shift_stk-tot.obj-type   = ub.trn-doc.obj-type
     6564           and shift_stk-tot.obj-code   = ub.trn-doc.obj-code
     6565           and shift_stk-tot.sum-type   = 'crsa':U
     6566           and shift_stk-tot.shift-date <> ?
     6567         .
     6568       buffer-compare
     6569         day_stk-tot
     6570         except fact-order shift-date shift-num
     6571         to shift_stk-tot
     6572         case-sensitive
     6573         save result in v-different-fields .
     6574       if v-different-fields <> ""
     6575       then do:
     6576         output stream slog to calc-arh.err append .
     6577         export stream slog v-different-fields .
     6578         export stream slog "day_stk-tot" .
     6579         export stream slog day_stk-tot .
     6580         export stream slog "shift_stk-tot" .
     6581         export stream slog shift_stk-tot .
     6582         output stream slog close .
     6583         message
     6584           vss-workfile vss-revision vss-description skip
     6585           "Внутренняя ошибка расчета складского архива по товарам" skip
     6586           v-different-fields skip
     6587           view-as alert-box error .
     6588         undo, return error .
     6589       end.
     6590     end.
     6591   end procedure.
     6592   procedure show-action :
     6593     do
     6594     on error undo, return error
     6595     :
     6596       define input parameter p-action as character no-undo .
     6597       define variable v-today as date      no-undo.
     6598       define variable v-time  as integer   no-undo.
     6599       run cur-time in this-procedure ( output v-today
     6600                                      , output v-time
     6601                                      ).
     6602       assign
     6603         current-time = string(v-time - start-time, "HH:MM:SS")
     6604         current-action = p-action
     6605       .
     6606       if mFrameView
     6607       then display
     6608         current-time
     6609         current-action
     6610         with frame inf.
     6611     end.
     6612   end procedure.
