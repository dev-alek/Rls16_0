     2544       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     2545       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     2546       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     2547       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     2548       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     2549       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     2550       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     2551       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     2552       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     2553       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     2554       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     2555       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     2556       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     2557       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     2558       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     2559       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     2560       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     2561       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     2562       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     2563       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     2564       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     2565       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     2566       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     2567       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     2568       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     2569       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     2570       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     2571       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     2572       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2573       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2574       .
     2575   end.
     2576   otherwise do:
     2577     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2578                              cl_tt-clcparts.purch-code,
     2579                              cl_tt-clcparts.part-code,
     2580                              cl_tt-clcparts.out-code,
     2581                              cl_tt-clcparts.in-code,
     2582                              cl_tt-clcparts.artic,
     2583                              cl_tt-clcparts.prod-type,
     2584                              cl_tt-clcparts.prod-code).
     2585   end.
     2586   end case.
     2587   end.
     2588   end procedure.
     2589   procedure clcprtsl_calc-line :
     2590   define input  parameter parrec-line as recid no-undo.
     2591   define variable v-tax-date         as   date                     no-undo.
     2592   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2593   define variable varr-b             as   character                no-undo.
     2594   define variable varr-btype         as   character                no-undo.
     2595   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2596   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2597   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2598   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2599   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2600   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2601   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2602   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2603   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2604   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2605   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2606   define variable varexcise          like ub.price-list.excise     no-undo.
     2607   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2608   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2609   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2610   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2611   define variable v-varsum           as decimal                  no-undo.
     2612   define variable varprice-salef as decimal   no-undo .
     2613   define buffer bf_trn-doc             for ub.trn-doc.
     2614   define buffer bf_doc-line            for ub.doc-line.
     2615   define buffer bf_gds-dtl             for ub.gds-dtl.
     2616   define buffer bf_goods               for ub.goods.
     2617   define buffer bf_parts               for ub.parts.
     2618   define buffer bf_sysconf             for ub.sysconf.
     2619   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2620   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2621   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2622   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2623   define buffer buf_parts        for ub.parts.
     2624   v-calcbypart = no.
     2625   do on error undo, return error return-value :
     2626   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2627   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2628     (output varr-b
     2629     )  .
     2630     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2631     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2632     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2633                               bf_goods.prod-type = bf_doc-line.prod-type and
     2634                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2635     if bf_trn-doc.fact-date <> ?        then do:
     2636       assign v-tax-date = bf_trn-doc.fact-date.
     2637     end.
     2638     else do:
     2639       assign v-tax-date = ?.
     2640     end.
     2641   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2642   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2643     (input  bf_goods.gds-code
     2644     ,input  '1':U
     2645     ,input  v-tax-date
     2646     ,input  bf_trn-doc.host-code
     2647     ,input  bf_trn-doc.obj-type
     2648     ,input  bf_trn-doc.obj-code
     2649     ,output v-vat-pc
     2650     ) no-error .
     2651     if error-status :error
     2652     or v-vat-pc = ? then do:
     2653        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2654     end.
     2655     if bf_goods.gds-type = 'у':U or
     2656        bf_trn-doc.status_ = 'запрос':U then do:
     2657       for each bf_tt-allsum-line
     2658       on error undo, return error return-value
     2659        :
     2660         delete bf_tt-allsum-line.
     2661       end.
     2662       create bf_tt-allsum-line.
     2663       assign
     2664        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2665       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2666                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2667                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2668                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2669         assign
     2670           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2671           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2672           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2673           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2674           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2675           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2676           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2677           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2678           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2679           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2680           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2681           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2682           bf_tt-allsum-line.vat-cli-acc          =  ?
     2683           .
     2684       end.
     2685       assign
     2686         bf_tt-allsum-line.cli-qnty             =  ?
     2687         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2688         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2689         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2690         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2691         bf_tt-allsum-line.road-tax-base-doc    =  0
     2692         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2693         bf_tt-allsum-line.excise-base-doc      =  0
     2694         bf_tt-allsum-line.excise-rubl-doc      =  0
     2695         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2696         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2697         bf_tt-allsum-line.dsc-base-cur         =  0
     2698         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2699         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2700         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2701         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2702         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2703         bf_tt-allsum-line.road-tax-base-cur    =  0
     2704         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2705         bf_tt-allsum-line.excise-base-cur      =  0
     2706         bf_tt-allsum-line.excise-rubl-cur      =  0
     2707         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2708         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2709         bf_tt-allsum-line.dsc-base-acc         =  0
     2710         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2711         bf_tt-allsum-line.dsc-cli-acc          =  0
     2712         bf_tt-allsum-line.slt-base-acc         =  0
     2713         bf_tt-allsum-line.slt-rubl-acc         =  0
     2714         bf_tt-allsum-line.slt-cli-acc          =  0
     2715         bf_tt-allsum-line.road-tax-base-acc    =  0
     2716         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2717         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2718         bf_tt-allsum-line.excise-base-acc      =  0
     2719         bf_tt-allsum-line.excise-rubl-acc      =  0
     2720         bf_tt-allsum-line.excise-cli-acc       =  0
     2721         bf_tt-allsum-line.transport-base-acc   =  0
     2722         bf_tt-allsum-line.transport-rubl-acc   =  0
     2723         bf_tt-allsum-line.transport-cli-acc    =  0
     2724         bf_tt-allsum-line.other-base-acc       =  0
     2725         bf_tt-allsum-line.other-rubl-acc       =  0
     2726         bf_tt-allsum-line.other-cli-acc        =  0
     2727         .
     2728       create bfs_tt-allsum-line.
     2729       assign
     2730       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2731       if bf_trn-doc.doc-type = 'инв':U or
     2732          bf_trn-doc.doc-type = 'при':U    or
     2733          bf_trn-doc.doc-type = 'возврат':U    then do:
     2734          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2735       end.
     2736       else do:
     2737         assign
     2738           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2739           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2740           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2741           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2742           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2743           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2744           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2745           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2746           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2747           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2748           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2749           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2750           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2751           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2752           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2753           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2754           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2755           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2756           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2757           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2758           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2759           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2760           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2761           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2762           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2763           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2764           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2765           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2766           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2767           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2768           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2769           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2770           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2771           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2772           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2773           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2774           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2775           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2776           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2777           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2778           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2779           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2780           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
