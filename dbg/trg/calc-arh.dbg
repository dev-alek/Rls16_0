     3538             .
     3539             assign
     3540                                                                                       temp-ot-tot.fact-qnty      = ub.ot-tot.fact-qnty            temp-ot-tot.sum-base       = ub.ot-tot.sum-base             temp-ot-tot.sum-rubl       = ub.ot-tot.sum-rubl             temp-ot-tot.vat-base       = ub.ot-tot.vat-base             temp-ot-tot.vat-rubl       = ub.ot-tot.vat-rubl             temp-ot-tot.slt-base       = ub.ot-tot.slt-base             temp-ot-tot.slt-rubl       = ub.ot-tot.slt-rubl             temp-ot-tot.road-tax-base  = ub.ot-tot.road-tax-base        temp-ot-tot.road-tax-rubl  = ub.ot-tot.road-tax-rubl        temp-ot-tot.excise-base    = ub.ot-tot.excise-base          temp-ot-tot.excise-rubl    = ub.ot-tot.excise-rubl          temp-ot-tot.transport-base = ub.ot-tot.transport-base       temp-ot-tot.transport-rubl = ub.ot-tot.transport-rubl       temp-ot-tot.other-base     = ub.ot-tot.other-base           temp-ot-tot.other-rubl     = ub.ot-tot.other-rubl
     3541             .
     3542           end.
     3543         end.
     3544       end.
