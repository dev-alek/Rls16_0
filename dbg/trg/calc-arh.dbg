     3594             v-sum-type = 'cgsr':U
     3595             v-doc-line-ot-sum-type[1] = 'sasr':U
     3596             v-doc-line-ot-sum-type[2] = 'cgsr':U
     3597             v-doc-line-ot-sum-type[3] = 'cssr':U
     3598           .
     3599         end.
     3600         find first ub.ot-line no-lock
     3601           where ub.ot-line.doc-code  = ub.doc-line.doc-code
     3602             and ub.ot-line.artic     = ub.doc-line.artic
     3603             and ub.ot-line.prod-type = ub.doc-line.prod-type
     3604             and ub.ot-line.prod-code = ub.doc-line.prod-code
     3605             and ub.ot-line.sum-type  = v-sum-type
     3606           no-error .
     3607         if available ub.ot-line
     3608         then do:
     3609           do v-doc-line-ot-sum-type-ind-ext = 1 to extent(v-doc-line-ot-sum-type)
     3610           :
     3611             for each ub.ot-line no-lock
     3612               where ub.ot-line.doc-code  = ub.doc-line.doc-code
     3613                 and ub.ot-line.artic     = ub.doc-line.artic
     3614                 and ub.ot-line.prod-type = ub.doc-line.prod-type
     3615                 and ub.ot-line.prod-code = ub.doc-line.prod-code
