     3192   def var v-fact-qnty      like ub.ot-tot.fact-qnty       no-undo .     def var v-sum-base       like ub.ot-tot.sum-base        no-undo .     def var v-sum-rubl       like ub.ot-tot.sum-rubl        no-undo .     def var v-vat-base       like ub.ot-tot.vat-base        no-undo .     def var v-vat-rubl       like ub.ot-tot.vat-rubl        no-undo .     def var v-slt-base       like ub.ot-tot.slt-base        no-undo .     def var v-slt-rubl       like ub.ot-tot.slt-rubl        no-undo .     def var v-road-tax-base  like ub.ot-tot.road-tax-base   no-undo .     def var v-road-tax-rubl  like ub.ot-tot.road-tax-rubl   no-undo .     def var v-excise-base    like ub.ot-tot.excise-base     no-undo .     def var v-excise-rubl    like ub.ot-tot.excise-rubl     no-undo .     def var v-transport-base like ub.ot-tot.transport-base  no-undo .     def var v-transport-rubl like ub.ot-tot.transport-rubl  no-undo .     def var v-other-base     like ub.ot-tot.other-base      no-undo .     def var v-other-rubl     like ub.ot-tot.other-rubl      no-undo .
     3193   main-block :
     3194   do transaction
     3195   on error undo main-block, return error
     3196   :
     3197     find first ub.trn-doc share-lock
     3198       where ub.trn-doc.doc-code = p-doc-code
     3199       no-error .
     3200     if not available ub.trn-doc
     3201     then do:
     3202       message
     3203         vss-workfile vss-revision vss-description skip
     3204         "Не найден документ" p-doc-code skip
     3205         view-as alert-box error .
     3206       undo main-block, return error .
     3207     end.
     3208     if ub.trn-doc.status_ <> 'факт':U
     3209     then do:
     3210       message
     3211         vss-workfile vss-revision vss-description skip
     3212         "Нельзя рассчитать складской архив по товарам для складского документа не закрытого до статуса" 'факт':U skip
     3213         "Документ" p-doc-code skip
     3214         view-as alert-box error .
     3215       undo main-block, return error .
     3216     end.
     3217   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3219     (input  ub.trn-doc.obj-type
     3220     ,input  ub.trn-doc.obj-code
     3221     ,input  'shift-on=request'
     3222     ,output v-shift-on
     3223     ) no-error .
     3224     if error-status :error
     3225     then do:
     3226       message
     3227         vss-workfile vss-revision vss-description skip
     3228         "Ошибка при запуске процедуры objat" skip
     3229         error-status :get-message(1) skip
     3230         return-value skip
     3231         view-as alert-box error .
     3232       undo main-block, return error .
     3233     end.
     3234     define variable v-curr-r-b as character no-undo .
     3235   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3237     (output v-curr-r-b
     3238     )  .
     3239     run factord in this-procedure
     3240       (input  ub.trn-doc.fact-date
     3241       ,input  ub.trn-doc.fact-time
     3242       ,input  ub.trn-doc.fact-num
     3243       ,input  ub.trn-doc.shift-date
     3244       ,input  ub.trn-doc.shift-num
     3245       ,input  v-shift-on
     3246       ,output v-fact-order
     3247       ,output v-shift-end-fact-order
     3248       ,output v-day-end-fact-order
     3249       ) no-error .
     3250     if error-status :error
     3251     or v-fact-order = ?
     3252     or v-fact-order = 0
     3253     then do:
     3254       message
     3255         vss-workfile vss-revision vss-description skip
     3256         "Ошибка при определении фактического номера складского документа" skip
     3257         "doc-code"                ub.trn-doc.doc-code    skip
     3258         "fact-date"               ub.trn-doc.fact-date   skip
     3259         "fact-time"               ub.trn-doc.fact-time   skip
     3260         "fact-num"                ub.trn-doc.fact-num    skip
     3261         "shift-date"              ub.trn-doc.shift-date  skip
     3262         "shift-num"               ub.trn-doc.shift-num   skip
     3263         "v-fact-order"            v-fact-order           skip
     3264         "v-shift-end-fact-order"  v-shift-end-fact-order skip
     3265         "v-day-end-fact-order"    v-day-end-fact-order   skip
     3266         error-status :get-message(1) skip
     3267         return-value skip
     3268         view-as alert-box error .
     3269       undo, return error .
     3270     end.
     3271     if p-cut-date = ?
     3272     then do:
     3273       run factord-max-fact-order in this-procedure
     3274         (output v-shift-cut-fact-order
     3275         ) .
     3276       run factord-max-fact-order in this-procedure
     3277         (output v-day-cut-fact-order
     3278         ) .
     3279     end.
     3280     else do:
     3281       if p-cut-date = ub.trn-doc.fact-date
     3282       then do:
     3283         assign
     3284           v-day-end-fact-order = v-day-end-fact-order - 0.0000000001
     3285         .
     3286         if v-shift-on = true
     3287         then do:
     3288           define buffer buf_shift-obj for ub.shift-obj .
     3289           find last buf_shift-obj
     3290             where buf_shift-obj.obj-type    = ub.trn-doc.obj-type
     3291               and buf_shift-obj.obj-code    = ub.trn-doc.obj-code
     3292               and buf_shift-obj.shift-date <= p-cut-date
     3293             use-index pi
     3294             no-error .
     3295           if not available buf_shift-obj
     3296           or buf_shift-obj.status_ <> 'зкр':U
     3297           then do:
     3298             message
     3299               vss-workfile vss-revision vss-description skip
     3300               "Ошибка при поиске последней смены" skip
     3301               "Объект" ub.trn-doc.obj-type ub.trn-doc.obj-code skip
     3302               "Дата" p-cut-date skip
     3303               view-as alert-box error .
     3304             undo, return error return-value .
     3305           end.
     3306           if  ub.trn-doc.shift-date = buf_shift-obj.shift-date
     3307           and ub.trn-doc.shift-num  = buf_shift-obj.shift-num
     3308           then do:
     3309             assign
     3310               v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     3311             .
     3312           end.
     3313         end.
     3314       end.
     3315       assign
     3316         v-shift-cut-fact-order = v-shift-end-fact-order
     3317         v-day-cut-fact-order   = v-day-end-fact-order
     3318       .
     3319     end.
     3320     def frame inf
     3321       ub.trn-doc.doc-code                      label "Документ" skip
     3322       ub.trn-doc.obj-type                      label "Объект"
     3323       ub.trn-doc.obj-code                      no-label skip
     3324       ub.trn-doc.fact-date format "99/99/9999" label "Дата закрытия" skip
     3325       current-action       format "x(40)"      no-label skip
     3326       ind                  format ">>>>>>>9"   label "Обработано артикулов" skip
     3327       ub.doc-line.artic                        label "Текущий артикул" skip
     3328       current-time         format "x(8)"       label "Время расчета документа" skip
     3329       with view-as dialog-box side-labels three-d
     3330       title "Расчет складского архива по товарам"
     3331       .
     3332     define variable mFrameView      as logical   no-undo init yes.
     3333     define variable mFramHandle as handle no-undo.
     3334     mFramHandle = frame inf:handle.
     3335     if  log-manager:logfile-name ne ?
     3336     then DO:
     3337         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameArhError").
     3338         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameArhError").
     3339     end.
     3340     mFrameView = not session:batch-mode and mFramHandle:visible.
     3341     run cur-time in this-procedure ( output v-today
     3342                                    , output start-time
     3343                                    ).
     3344     if mFrameView
     3345     then do:
     3346        view frame inf .
     3347        display
     3348           ub.trn-doc.doc-code
     3349           ub.trn-doc.obj-type
     3350           ub.trn-doc.obj-code
     3351           ub.trn-doc.fact-date
     3352        with frame inf .
     3353     end.
     3354     run show-action in this-procedure
     3355       (input "Обработка строк документа"
     3356       ).
     3357     assign
     3358       v-ot-fact-order             = v-fact-order
     3359       v-stk-tot-fact-order        = v-day-end-fact-order
     3360       v-stk-line-fact-order       = v-day-end-fact-order
     3361       v-shift-stk-tot-fact-order  = v-shift-end-fact-order
     3362       v-shift-stk-line-fact-order = v-shift-end-fact-order
     3363     .
     3364     assign
     3365       v-base-rate  = ub.trn-doc.base-rate
     3366       v-base-scale = ub.trn-doc.base-scale
     3367     .
     3368     run init-temp-tables in this-procedure no-error .
     3369     if error-status :error
     3370     then do:
     3371       message
     3372         vss-workfile vss-revision vss-description skip
     3373         "Ошибка при вызове процедуры init-temp-tables" skip
     3374         error-status :get-message(1) skip
     3375         return-value skip
     3376         view-as alert-box error .
     3377       undo main-block, return error .
     3378     end.
     3379     for each ub.doc-line no-lock
     3380       where ub.doc-line.doc-code = ub.trn-doc.doc-code
     3381     on error undo main-block, return error
     3382     :
     3383       run process-doc-line in this-procedure no-error .
     3384       if error-status :error
     3385       then do:
     3386         message
     3387           vss-workfile vss-revision vss-description skip
     3388           "Ошибка при вызове процедуры process-doc-line" skip
     3389           error-status :get-message(1) skip
     3390           return-value skip
     3391           view-as alert-box error .
     3392         undo main-block, return error .
     3393       end.
     3394       assign
     3395         ind  = ind + 1
     3396       .
     3397       if ind mod 10 = 0
     3398       then do:
     3399         run cur-time in this-procedure ( output v-today
     3400                                        , output v-time
     3401                                        ).
     3402         assign
     3403           current-time = string(v-time - start-time, "HH:MM:SS")
     3404         .
     3405         if mFrameView
     3406         then display
     3407           ind
     3408           ub.doc-line.artic
     3409           current-time
     3410           with frame inf .
     3411       end.
     3412     end.
     3413     run update-ot-tot in this-procedure no-error .
     3414     if error-status :error
     3415     then do:
     3416       message
     3417         vss-workfile vss-revision vss-description skip
     3418         "Ошибка при вызове процедуры update-ot-tot" skip
     3419         error-status :get-message(1) skip
     3420         return-value skip
     3421         view-as alert-box error .
     3422       undo main-block, return error .
     3423     end.
     3424     run update-stk-table in this-procedure no-error .
     3425     if error-status :error
     3426     then do:
     3427       message
     3428         vss-workfile vss-revision vss-description skip
     3429         "Ошибка при вызове процедуры update-stk-table" skip
     3430         error-status :get-message(1) skip
     3431         return-value skip
     3432         view-as alert-box error .
     3433       undo main-block, return error .
     3434     end.
     3435     run show-action in this-procedure
     3436       (input "Сохранение складского архива по товарам в базу данных"
     3437       ).
     3438     run store-temp-table in this-procedure no-error .
     3439     if error-status :error
     3440     then do:
     3441       message
     3442         vss-workfile vss-revision vss-description skip
     3443         "Ошибка при вызове процедуры store-temp-table" skip
     3444         error-status :get-message(1) skip
     3445         return-value skip
     3446         view-as alert-box error .
     3447       undo main-block, return error .
     3448     end.
     3449     if v-shift-on
     3450     then do:
