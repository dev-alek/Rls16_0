     3508       assign
     3509         v-root-sum-type[1] = 'crsa':U
     3510         v-root-sum-type[2] = 'cost':U
     3511         v-root-sum-type[3] = 'sadt':U         + ub.trn-doc.ext-doc-type
     3512         v-root-sum-type[4] = 'cgdt':U         + ub.trn-doc.ext-doc-type
     3513         v-root-sum-type[5] = 'csdt':U         + ub.trn-doc.ext-doc-type
     3514         v-root-sum-type[6] = 'adsr':U + ub.trn-doc.ext-doc-type
     3515         v-root-sum-type[7] = 'gdsr':U + ub.trn-doc.ext-doc-type
     3516         v-root-sum-type[8] = 'sdsr':U + ub.trn-doc.ext-doc-type
     3517       .
     3518       run show-action in this-procedure
     3519         (input "Считывается оборот по документу"
     3520         ).
     3521       find first ub.ot-tot no-lock
