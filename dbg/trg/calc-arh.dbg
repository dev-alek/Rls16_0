     3954           find last ub.stk-line no-lock
     3955             where ub.stk-line.obj-type   = ub.doc-line.obj-type
     3956               and ub.stk-line.obj-code   = ub.doc-line.obj-code
     3957               and ub.stk-line.artic      = ub.doc-line.artic
     3958               and ub.stk-line.prod-type  = ub.doc-line.prod-type
     3959               and ub.stk-line.prod-code  = ub.doc-line.prod-code
     3960               and ub.stk-line.sum-type   = v-doc-line-root-sum-type[v-doc-line-root-sum-type-ind-ext]
     3961               and ub.stk-line.fact-order <= v-stk-line-fact-order
     3962               and ub.stk-line.shift-date = ?
