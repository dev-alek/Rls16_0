      604     define variable vardoc-type     as   character              no-undo.
      605     do
      606     on error undo, return error "Ошибка при вызове процедуры prl-vat."
      607     :
      608       find first bf_price-list no-lock
      609         where recid(bf_price-list) = parrecid
      610         no-error .
      611       if not available bf_price-list
      612       then do:
      613         return error "Ошибка во входящих параметрах prl-vat.i" .
      614       end.
      615       find first bf_goods no-lock
      616         where bf_goods.artic     = bf_price-list.artic
      617           and bf_goods.prod-type = bf_price-list.prod-type
      618           and bf_goods.prod-code = bf_price-list.prod-code
      619         no-error .
      620       if not available bf_goods
      621       then do:
      622         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
      623       end.
      624       assign
      625         varvat-pc = bf_price-list.vat-pc
      626         varslt-pc = bf_price-list.slt-pc
      627       .
      628       if varvat-pc = ?
      629       then do:
      630         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
      631       end.
      632       if varslt-pc = ?
      633       then do:
      634         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
      635       end.
      636       assign
      637         varbase-rate   = 1
      638         varbase-scale  = 1
      639         varroad-tax    = bf_price-list.road-tax
      640         varexcise      = bf_price-list.excise
      641         varprice-base  = bf_price-list.price-sale
      642         varprice-rubl  = bf_price-list.price-sale
      643         vardiscnt-base = 0
      644         vardiscnt-rubl = 0
      645       .
      646       assign
      647         varfact-qnty = 0
      648       .
      649       for each bf_parts no-lock
      650         where bf_parts.out-code   = bf_price-list.doc-num
      651           and bf_parts.obj-type   = bf_price-list.obj-type
      652           and bf_parts.obj-code   = bf_price-list.obj-code
      653           and bf_parts.artic      = bf_price-list.artic
      654           and bf_parts.prod-type  = bf_price-list.prod-type
      655           and bf_parts.prod-code  = bf_price-list.prod-code
      656       :
      657         assign
      658           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
      659         .
      660       end.
      661       assign
      662         vardoc-num   = bf_price-list.doc-num
      663         vardoc-code  = bf_price-list.doc-num
      664         varobj-type  = bf_price-list.obj-type
      665         varobj-code  = bf_price-list.obj-code
      666         varartic     = bf_price-list.artic
      667         varprod-type = bf_price-list.prod-type
      668         varprod-code = bf_price-list.prod-code
      669         vardoc-qnty  = varfact-qnty
      670         varext-doc-type = 'ot':U
      671       .
      672   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      673   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      674     (input  bf_price-list.obj-type
      675     ,input  bf_price-list.obj-code
      676     ,output v-host-code
      677     )  .
      678       find first bf_sysconf no-lock
      679         where bf_sysconf.host-code = v-host-code
      680         .
      681       if bf_sysconf.cons-vat-pc = ?
      682       then do:
      683         return error "Не задан консигнационный НДС по фирме." .
      684       end.
      685       else do:
      686         assign
      687           varcons-vat-pc = bf_sysconf.cons-vat-pc
      688         .
      689       end.
      690   if varext-doc-type = 'ot':U or
      691      varext-doc-type = ?                 then do:
      692     assign
      693      out-vatp-have-vat-sltprl = yes.
      694   end.
      695   else do:
      696     find first out-vatp_doc-attrprl no-lock
      697       where out-vatp_doc-attrprl.doc-code  = vardoc-code
      698         and out-vatp_doc-attrprl.attr-code = 'envd':U
      699         no-error .
      700     if not available out-vatp_doc-attrprl then do:
      701       assign
      702         out-vatp-have-vat-sltprl = yes.
      703     end.
      704     else do:
      705        out-vatp-have-vat-sltprl = no.
      706     end.
      707   end.
      708   find first out-vatp_goodsprl where out-vatp_goodsprl.artic     = varartic     and
      709                                      out-vatp_goodsprl.prod-type = varprod-type and
      710                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
      711   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      712   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      713     (input  varartic
      714     ,input  varprod-type
      715     ,input  varprod-code
      716     ,output varroot-nodeprl
      717     ) no-error .
      718   if error-status :error then do:
      719     message
      720       vss-workfile vss-revision vss-description skip
      721       "Ошибка при определении корневого признака товара" skip
      722       "Артикул" varartic varprod-type varprod-code skip
      723       error-status :get-message(1) skip
      724       return-value skip
      725       view-as alert-box error .
      726     undo, return error .
      727   end.
      728   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      729     (input  varroot-nodeprl
      730     ,input  'empty-scale=request'
      731     ,output varempty-scaleprl
      732     ) no-error .
      733   if error-status :error then do:
      734     message
      735       vss-workfile vss-revision vss-description skip
      736       "Ошибка при определении атрибута признака" skip
      737       "Артикул" varartic varprod-type varprod-code skip
      738       "Признак" varroot-nodeprl skip
      739       "Запрашивался атрибут" "empty-scale=request" skip
      740       error-status :get-message(1) skip
      741       return-value skip
      742       view-as alert-box error .
      743     undo, return error .
      744   end.
      745   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      746   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      747     (output varoutvprbprl
      748     )  .
      749   if varoutvprbprl = "base":u then do:
      750     assign
      751           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
      752       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
      753     .
      754   end.
      755   else do:
      756     assign
      757           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
      758       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
      759     .
      760   end.
      761   if varoutvprbprl = "rubl":u then do:
      762     assign
      763           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
      764       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
      765   end.
      766   else do:
      767     assign
      768           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
      769       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
      770   end.
      771   assign
      772     varis-cons-parts-haveprl =  no.
      773   assign
      774     varfact-qntyprl       = 0
      775     varcons-qntyprl       = 0
      776     varprice-base-consprl = 0
      777     varprice-rubl-consprl = 0.
      778   find first out-vatp_doc-lineprl where
      779              out-vatp_doc-lineprl.doc-code   = vardoc-num
      780          and out-vatp_doc-lineprl.artic      = varartic
      781          and out-vatp_doc-lineprl.prod-type  = varprod-type
      782          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
      783   if available out-vatp_doc-lineprl           and
      784     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
      785     assign
      786       varfact-qntyprl = out-vatp_doc-lineprl.fact-qnty.
      787   end.
      788   else do:
      789     for each out-vatp_partsprl where out-vatp_partsprl.out-code   = vardoc-num
      790                                  and out-vatp_partsprl.obj-type   = varobj-type
      791                                  and out-vatp_partsprl.obj-code   = varobj-code
      792                                  and out-vatp_partsprl.artic      = varartic
      793                                  and out-vatp_partsprl.prod-type  = varprod-type
      794                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
      795       if out-vatp_partsprl.purch-code = 2 then do:
      796   assign
      797     price-rubl-with-tax-locoprl = out-vatp_partsprl.price-rubl
      798     price-base-with-tax-locoprl = out-vatp_partsprl.price-base
      799   .
      800   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      801   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      802     (output varinvprboprl
      803     )  .
      804     if out-vatp_partsprl.out-code = 'free-zone':U     or
      805        out-vatp_partsprl.out-code = 'out-zone':U   or
      806        out-vatp_partsprl.doc-type = 'акт':U then do:
      807       assign
      808         in-vatp-have-vat-sltoprl = yes.
      809     end.
      810     else do:
      811       find first in-vatp_doc-attroprl no-lock
      812         where in-vatp_doc-attroprl.doc-code  = out-vatp_partsprl.out-code
      813           and in-vatp_doc-attroprl.attr-code = 'envd':U
      814         no-error .
      815       if not available in-vatp_doc-attroprl then do:
      816         assign
      817           in-vatp-have-vat-sltoprl = yes.
      818       end.
      819       else do:
      820            in-vatp-have-vat-sltoprl = no.
      821       end.
      822     end.
      823     assign
      824      price-cli-with-tax-locoprl = out-vatp_partsprl.price-cli
      825      cli-base-rateoprl          = out-vatp_partsprl.cli-base-rate.
      826     ASSIGN   road-tax-base-locoprl  = (if out-vatp_partsprl.road-tax-base  = ? then 0 else out-vatp_partsprl.road-tax-base)
      827              road-tax-rubl-locoprl  = (if out-vatp_partsprl.road-tax-rubl  = ? then 0 else out-vatp_partsprl.road-tax-rubl).
      828     ASSIGN  transport-base-locoprl = (if out-vatp_partsprl.transport-base = ? then 0 else out-vatp_partsprl.transport-base)
      829             transport-rubl-locoprl = (if out-vatp_partsprl.transport-rubl = ? then 0 else out-vatp_partsprl.transport-rubl)
      830             other-base-locoprl     = (if out-vatp_partsprl.other-base     = ? then 0 else out-vatp_partsprl.other-base)
      831             other-rubl-locoprl     = (if out-vatp_partsprl.other-rubl     = ? then 0 else out-vatp_partsprl.other-rubl)
      832             vat-pc-locoprl         = (if out-vatp_partsprl.vat-pc         = ? then 0 else out-vatp_partsprl.vat-pc)
      833             slt-pc-locoprl         = (if out-vatp_partsprl.slt-pc         = ? then 0 else out-vatp_partsprl.slt-pc).
      834             ASSIGN   slt-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
      835       ASSIGN   slt-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
      836     assign
      837       exch-rate-cli-locoprl = (out-vatp_partsprl.price-rubl - transport-rubl-locoprl - other-rubl-locoprl - road-tax-rubl-locoprl - (if out-vatp_partsprl.vat-type <> 'в т. ч.':U then vat-rubl-locoprl else 0) - (if out-vatp_partsprl.slt-type <> 'в т. ч.':U then slt-rubl-locoprl else 0)) / out-vatp_partsprl.price-cli .
      838     assign
