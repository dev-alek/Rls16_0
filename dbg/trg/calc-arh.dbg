     3452         no-error .
     3453       if error-status :error
     3454       then do:
     3455         message
     3456           vss-workfile vss-revision vss-description skip
     3457           "Ошибка при проверке целостности складского архива по товарам" skip
     3458           "Дополнительная информация выведена в файл calc-arh.err" skip
     3459           "Переоценка" ub.trn-doc.doc-code skip
     3460           error-status :get-message(1) skip
     3461           return-value skip
     3462           view-as alert-box error .
     3463         undo main-block, return error .
     3464       end.
     3465     end.
     3466     run show-action in this-procedure
     3467       (input "Расчет документа закончен"
     3468       ).
     3469   end.
     3470   procedure init-temp-tables :
     3471     do
     3472     on error undo, return error
     3473     :
     3474       define variable v-root-sum-type                  as character no-undo extent 8 .
     3475       define variable v-line-sum-type                  as character no-undo extent 8 .
     3476       define variable v-root-sum-type-ind-ext          as integer   no-undo .
     3477       define variable v-prev-stk-tot-fact-order        like ub.stk-tot.fact-order     no-undo .
