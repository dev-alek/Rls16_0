     3479       define variable v-prev-shift-stk-tot-fact-order  like ub.stk-tot.fact-order     no-undo .
     3480       define variable v-prev-shift-stk-line-fact-order like ub.stk-line.fact-order    no-undo .
     3481       define variable v-goods-vat-pc                   like ub.doc-line.vat-pc           no-undo.
     3482       define variable v-goods-slt-pc                   like ub.doc-line.slt-pc           no-undo.
     3483       define variable v-host-code                      like ub.sysconf.host-code         no-undo.
     3484   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3485   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3486     (input  ub.trn-doc.obj-type
