     4135   procedure process-doc-line :
     4136     define variable v-host-code like ub.sysconf.host-code         no-undo.
     4137     define variable v-cur-dn  as character no-undo .
     4138     define variable v-price as decimal   no-undo .
     4139     define variable v-cur-rt as decimal   no-undo .
     4140     define variable v-cur-ex as decimal   no-undo .
     4141     define variable v-b-pcode as integer   no-undo .
     4142     define variable v-is-part-price as logical   no-undo .
     4143     define buffer buf_tt-clcparts for tt-clcparts .
     4144     define buffer buf_tt-allsum-line for tt-allsum-line .
     4145     do
     4146     on error undo, return error
     4147     :
     4148   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4149   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4150     (input  ub.doc-line.obj-type
     4151     ,input  ub.doc-line.obj-code
     4152     ,output v-host-code
     4153     )  .
     4154       find first ub.goods no-lock
     4155         where ub.goods.artic     = ub.doc-line.artic
     4156           and ub.goods.prod-type = ub.doc-line.prod-type
     4157           and ub.goods.prod-code = ub.doc-line.prod-code
     4158         no-error .
     4159       if not available goods
     4160       then do:
     4161         message
     4162           vss-workfile vss-revision vss-description skip
     4163           "Не найден товар" skip
     4164           "Документ" ub.doc-line.doc-code skip
     4165           "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     4166           view-as alert-box error .
     4167         undo, return error .
     4168       end.
     4169       if ub.goods.gds-type = 'т':U
     4170       then do:
     4171         define variable v-doc-sign as integer   no-undo .
     4172         if ub.trn-doc.doc-type = 'рас':U
     4173         or ub.trn-doc.doc-type = 'спи':U
     4174         then do:
     4175           assign
     4176             v-doc-sign = -1
     4177           .
     4178         end.
     4179         else do:
     4180           assign
     4181             v-doc-sign = 1
     4182           .
     4183         end.
     4184         for each ub.parts no-lock
     4185           where ub.parts.out-code  = ub.trn-doc.doc-code
     4186             and ub.parts.obj-type  = ub.trn-doc.obj-type
     4187             and ub.parts.obj-code  = ub.trn-doc.obj-code
     4188             and ub.parts.artic     = ub.doc-line.artic
     4189             and ub.parts.prod-type = ub.doc-line.prod-type
     4190             and ub.parts.prod-code = ub.doc-line.prod-code
     4191         on error undo, return error
     4192         :
