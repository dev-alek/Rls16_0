     3016   procedure clcprtsl_calc-ttable :
     3017   define input parameter paris-doc           as   logical                 no-undo.
     3018   define input parameter paris-cur           as   logical                 no-undo.
     3019   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3020   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3021   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3022   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3023   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3024   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3025   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3026   define input parameter parr-b              as   character               no-undo.
     3027   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3028   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3029   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3030   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3031   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3032   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3033   define buffer bf_tt-allsum      for tt-allsum.
     3034   define buffer bf_tt-clcparts    for tt-clcparts.
     3035   define buffer bf_tt-allsum-line for tt-allsum-line.
     3036   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3037   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3038   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3039   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3040   define variable varexcise          like ub.price-list.excise     no-undo.
     3041   do on error undo, return error return-value :
     3042   for each bf_tt-allsum-line
     3043   on error undo, return error return-value
     3044    :
     3045     delete bf_tt-allsum-line.
     3046   end.
     3047   for each bf_tt-allsum
     3048   on error undo, return error return-value
     3049   :
     3050     delete bf_tt-allsum.
     3051   end.
     3052   for each bf_tt-clcparts
     3053   on error undo, return error return-value
     3054   :
     3055   if v-calcbypart then do:
     3056             assign
     3057             parcur-base =   bf_tt-clcparts.part-cur-base
     3058             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3059             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3060             .
     3061   end.
     3062      run clcprtsl_calc-parts in this-procedure (
     3063        input recid(bf_tt-clcparts),
     3064        input paris-doc,
     3065        input paris-cur,
     3066        input parroad-tax,
     3067        input parexcise,
     3068        input parvat-pc,
     3069        input parcons-vat-pc,
     3070        input parslt-pc,
     3071        input parbase-rate,
     3072        input parbase-scale,
     3073        input parr-b,
     3074        input parcur-base,
     3075        input parcur-road-tax,
     3076        input parcur-excise,
     3077        input parcur-vat-pc,
     3078        input parcurcons-vat-pc,
     3079        input parcurslt-pc
     3080        ) no-error.
     3081     if error-status:error then do:
     3082       message
     3083         vss-workfile vss-revision vss-description skip
     3084         vss-include-info10 skip
     3085         "Ошибка при обсчете партии" skip
     3086         "Документ партии " bf_tt-clcparts.out-code skip
     3087         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3088         return-value skip
     3089         error-status:get-message(1) skip
     3090         error-status:get-message(2) skip
     3091         error-status:get-message(3) skip
     3092         view-as alert-box error .
     3093       undo, return error .
     3094     end.
     3095     for each bf_tt-allsum on error undo, return error return-value :
     3096       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3097       if not available bf_tt-allsum-line then do:
     3098         create bf_tt-allsum-line.
     3099         assign
     3100           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3101       end.
     3102       assign
     3103         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3104         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3105         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3106         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3107         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3108         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3109         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3110         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3111         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3112         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3113         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3114         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3115         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3116         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3117         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3118         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3119         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3120         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3121         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3122         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3123         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3124         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
