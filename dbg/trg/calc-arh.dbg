     3971               where ub.stk-line.obj-type   = ub.doc-line.obj-type
     3972                 and ub.stk-line.obj-code   = ub.doc-line.obj-code
     3973                 and ub.stk-line.artic      = ub.doc-line.artic
     3974                 and ub.stk-line.prod-type  = ub.doc-line.prod-type
     3975                 and ub.stk-line.prod-code  = ub.doc-line.prod-code
