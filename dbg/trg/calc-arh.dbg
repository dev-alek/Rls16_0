     3577             view-as alert-box error .
     3578           undo, return error .
     3579         end.
     3580         define variable v-doc-line-ot-sum-type as character no-undo extent 3 .
     3581         define variable v-doc-line-ot-sum-type-ind-ext as integer   no-undo .
     3582         define variable v-sum-type as character no-undo .
     3583         if buf_goods.gds-type = 'т':U
     3584         then do:
     3585           assign
     3586             v-sum-type = 'crsa':U
     3587             v-doc-line-ot-sum-type[1] = 'sale':U
     3588             v-doc-line-ot-sum-type[2] = 'crsa':U
     3589             v-doc-line-ot-sum-type[3] = 'cost':U
     3590           .
     3591         end.
     3592         else do:
