     2877     (input  bf_trn-doc.obj-type
     2878     ,input  bf_trn-doc.obj-code
     2879     ,input  varb-code
     2880     ,input  0
     2881     ,input  bf_trn-doc.fact-order
     2882     ,output vardoc-num
     2883     ,output varprice-sale
     2884     ,output varroad-tax
     2885     ,output varexcise
     2886     )  .
     2887             if varprice-sale = ?
     2888             then do:
     2889               assign
     2890                 varprice-sale = 0
     2891                 varroad-tax   = 0
     2892                 varexcise     = 0
     2893               .
     2894             end.
     2895             assign
     2896               varlastcur-base     = varprice-sale
     2897               varlastcur-road-tax = varroad-tax
     2898               varlastcur-excise   = varexcise
     2899               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2900               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2901               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2902               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2903             .
     2904         end.
     2905       end.
     2906       if varcur-fact-qnty = 0 then do:
     2907         assign
     2908           varcur-base      = varlastcur-base
     2909           varcur-road-tax  = varlastcur-road-tax
     2910           varcur-excise    = varlastcur-excise
     2911         .
     2912       end.
     2913       else do:
     2914         assign
     2915           varcur-base      = varcur-base      / varcur-fact-qnty
     2916           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2917           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2918         .
     2919       end.
     2920       if varcur-vat-pc = ?
     2921       then do:
     2922         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2923       end.
     2924       if varcur-slt-pc = ?
