     3828       end.
     3829     end.
     3830   end procedure.
     3831   procedure partcopy-update-parts-delete :
     3832     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     3833     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     3834     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     3835     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     3836     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     3837     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     3838     define variable objMarks as class excisemarks no-undo.
     3839     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
     3840     define buffer buf_trn-doc    for ub.trn-doc .
     3841     define buffer archive_parts  for ub.parts .
     3842     define buffer buf_parts      for ub.parts .
     3843     define buffer buf_parts-attr for ub.parts-attr .
