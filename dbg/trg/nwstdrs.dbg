     3396             if buf_trn-doc.ext-doc-type = 'vt':U
     3397             or (buf_trn-doc.ext-doc-type = 're':U and v-is-hold = true)
     3398             or buf_trn-doc.ext-doc-type = 'ap':U
     3399             or buf_trn-doc.ext-doc-type = 'pc':U
     3400             or buf_trn-doc.ext-doc-type = 'mp':U
     3401             or  buf_trn-doc.ext-doc-type = 'vp':U
     3402             then do:
     3403               message
     3404                 vss-workfile vss-revision vss-description skip
     3405                 vss-include-info8 skip
     3406                 "Фактическое количество не может отличаться от количества по документу" skip
     3407                 "для документов инвентаризации, внутреннего возврата и автоматического возврата между фирмами" skip
     3408                 "Документ" p-doc-code skip
     3409                 "Объект" p-obj-type p-obj-code skip
     3410                 "Артикул" p-artic p-prod-type p-prod-code skip
     3411                 "Партия" archive_parts.in-code archive_parts.part-code skip
