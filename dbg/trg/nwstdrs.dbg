     5803     define variable v-gds-dtl-rsrv-qnty as decimal   no-undo .
     5804     define variable v-real-chg-qnty     as decimal   no-undo .
     5805     define variable v-parts-recid       as integer   no-undo .
     5806     define variable v-is-hold           as integer   no-undo .
     5807     find first buf_trn-doc exclusive-lock
     5808       where buf_trn-doc.doc-code = p-doc-code
     5809       no-error .
     5810     if error-status :error then do:
     5811       message
     5812         vss-workfile vss-revision vss-description skip
     5813         "Ошибка задания входных параметров" skip
     5814         "Не найден документ" skip
     5815         "Документ" p-doc-code skip
     5816         view-as alert-box error .
     5817       undo, return error .
     5818     end.
     5819     if buf_trn-doc.status_ = 'запрос':U
     5820     or buf_trn-doc.status_ = 'готов':U
     5821     or buf_trn-doc.status_ = 'отказ':U
     5822       then do:
     5823       return .
     5824     end.
