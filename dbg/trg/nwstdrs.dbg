     5765   procedure partrsrv-need-rsrv :
     5766     define input  parameter p-parts-in-code   as character no-undo .
     5767     define input  parameter p-parts-out-code  as character no-undo .
     5768     define output parameter p-need-rsrv-parts as logical   no-undo .
     5769     do
     5770     on error undo, return error return-value
     5771     :
     5772       if p-parts-out-code <> p-parts-in-code
     5773       then do:
     5774         assign
     5775           p-need-rsrv-parts = true
     5776         .
     5777       end.
     5778       else do:
     5779         assign
     5780           p-need-rsrv-parts = false
     5781         .
     5782       end.
     5783     end.
     5784   end procedure.
     5785   do
     5786   on error undo, return error return-value
     5787   :
     5788     define buffer buf_trn-doc  for ub.trn-doc .
     5789     define buffer buf_doc-line for ub.doc-line .
     5790     define buffer buf_goods    for ub.goods .
     5791     define buffer buf_parts    for ub.parts .
