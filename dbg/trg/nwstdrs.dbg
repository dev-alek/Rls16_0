     3708                   then do:
     3709                     message
     3710                       vss-workfile vss-revision vss-description skip
     3711                       vss-include-info8 skip
     3712                       "Ошибка при удалении партии" skip
     3713                       "Документ" p-doc-code skip
     3714                       "Объект" p-obj-type p-obj-code skip
     3715                       "Артикул" p-artic p-prod-type p-prod-code skip
     3716                       "Партия" buf_parts.in-code buf_parts.part-code skip
     3717                       "Резерв" buf_parts.out-code skip
     3718                       "qnty" buf_parts.qnty skip
     3719                       "fact-qnty" buf_parts.fact-qnty skip
     3720                       "cli-qnty" buf_parts.cli-qnty skip
     3721                       view-as alert-box error .
     3722                     undo, return error .
     3723                   end.
     3724                 end.
     3725                 delete buf_parts .
     3726               end.
     3727             end.
     3728           end.
     3729           if  ( archive_parts.in-code = buf_trn-doc.doc-code
     3730           and archive_parts.supp-type =
