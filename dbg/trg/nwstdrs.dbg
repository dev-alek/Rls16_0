     3650                     vss-workfile vss-revision vss-description skip
     3651                     vss-include-info8 skip
     3652                     "Клиентское количество для товара," skip
     3653                     "который учитывается по двум единицам измерения" skip
     3654                     "должно равняться" v-qnty-sign skip
     3655                     "Документ" p-doc-code skip
     3656                     "Объект" p-obj-type p-obj-code skip
     3657                     "Артикул" p-artic p-prod-type p-prod-code skip
