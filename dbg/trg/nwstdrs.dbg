     4273                     message objMarks:ReturnMsg view-as alert-box error.
     4274                     delete object objMarks no-error.
     4275                     undo, return error.
     4276                 end.
     4277               end.
     4278               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     4279                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     4280                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     4281                                                           and del_marking-lines.in-code = buf_parts.in-code
     4282                                                           and del_marking-lines.out-code = buf_parts.out-code
     4283                                                           and del_marking-lines.part-code = buf_parts.part-code
     4284                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     4285                 delete del_marking-lines .
     4286               end.
     4287               delete buf_parts .
     4288             end.
     4289           end.
     4290           delete object objMarks no-error.
     4291           if v-need-unrv = true
     4292           then do:
     4293             release buf_parts no-error .
     4294             if archive_parts.out-code <> v-unrv-code and v-unrv-sign = -1 and v-izlcstpr
     4295             then do:
     4296                 find first buf_parts exclusive-lock
     4297                   where buf_parts.obj-type  = archive_parts.obj-type
     4298                     and buf_parts.obj-code  = archive_parts.obj-code
     4299                     and buf_parts.artic     = archive_parts.artic
     4300                     and buf_parts.prod-type = archive_parts.prod-type
     4301                     and buf_parts.prod-code = archive_parts.prod-code
     4302                     and buf_parts.in-code   = archive_parts.out-code
     4303                     and buf_parts.out-code  = v-unrv-code
     4304                     and buf_parts.part-code = archive_parts.part-code
     4305                   no-error.
     4306             end .
     4307             if not available  buf_parts
     4308             then do :
     4309                 run partcopy in this-procedure
     4310                   (input  true
     4311                   ,input  v-unrv-code
     4312                   ,buffer archive_parts
     4313                   ,buffer buf_parts
     4314                   ,input  ""
     4315                   ) no-error .
     4316                 if error-status :error
     4317                 then do:
     4318                   message
     4319                     vss-workfile vss-revision vss-description skip
     4320                     vss-include-info8 skip
     4321                     "Ошибка при создании партии" skip
     4322                     "Документ" p-doc-code skip
     4323                     "Объект" p-obj-type p-obj-code skip
     4324                     "Артикул" p-artic p-prod-type p-prod-code skip
     4325                     "Партия" archive_parts.in-code archive_parts.part-code skip
     4326                     "Необходимо резервировать" v-need-rsrv skip
     4327                     "Резерв" v-rsrv-code skip
     4328                     "Необходимо снятие резервов" v-need-unrv skip
     4329                     "Снятие резервов" v-unrv-code skip
     4330                     error-status :get-message(1) skip
     4331                     return-value skip
     4332                     view-as alert-box error .
     4333                   undo, return error .
     4334                 end.
     4335             end.
     4336             if new(buf_parts)
     4337             then do:
     4338   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4339   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4340     (input  p-artic
     4341     ,input  p-prod-type
     4342     ,input  p-prod-code
     4343     ,output v-gds-code
     4344     ) no-error .
     4345               if error-status :error
     4346               then do:
     4347                 message
     4348                   vss-workfile vss-revision vss-description skip
     4349                   vss-include-info8 skip
     4350                   "Ошибка при определении кода товара" skip
     4351                   "Документ" p-doc-code skip
     4352                   "Объект" p-obj-type p-obj-code skip
     4353                   "Артикул" p-artic p-prod-type p-prod-code skip
     4354                   "Партия" archive_parts.in-code archive_parts.part-code skip
     4355                   "Необходимо резервировать" v-need-rsrv skip
     4356                   "Резерв" v-rsrv-code skip
     4357                   "Необходимо снятие резервов" v-need-unrv skip
     4358                   "Снятие резервов" v-unrv-code skip
     4359                   error-status :get-message(1) skip
     4360                   return-value skip
     4361                   view-as alert-box error .
     4362                 undo, return error .
     4363               end.
     4364               find first buf_parts-attr no-lock
     4365                 where buf_parts-attr.in-code   = buf_parts.in-code
     4366                   and buf_parts-attr.gds-code  = v-gds-code
     4367                   and buf_parts-attr.part-code = buf_parts.part-code
     4368                 no-error .
     4369               if not available buf_parts-attr
     4370               then do:
     4371                 message
     4372                   vss-workfile vss-revision vss-description skip
     4373                   vss-include-info8 skip
     4374                   "Не найден атрибут партии" skip
     4375                   "Документ" p-doc-code skip
     4376                   "Объект" p-obj-type p-obj-code skip
     4377                   "Артикул" p-artic p-prod-type p-prod-code skip
     4378                   "Код товара" v-gds-code skip
     4379                   "Партия" archive_parts.in-code archive_parts.part-code skip
     4380                   "Необходимо резервировать" v-need-rsrv skip
     4381                   "Резерв" v-rsrv-code skip
     4382                   "Необходимо снятие резервов" v-need-unrv skip
     4383                   "Снятие резервов" v-unrv-code skip
     4384                   error-status :get-message(1) skip
     4385                   return-value skip
     4386                   view-as alert-box error .
     4387                 undo, return error .
     4388               end.
     4389               run factord-to-fact-num in this-procedure
     4390                 (input  buf_parts-attr.fact-order
     4391                 ,output v-fact-num
     4392                 ) no-error .
     4393               if error-status :error
     4394               then do:
     4395                 message
     4396                   vss-workfile vss-revision vss-description skip
     4397                   vss-include-info8 skip
     4398                   "Ошибка при определении порядкового номера партии" skip
     4399                   "Документ" p-doc-code skip
     4400                   "Объект" p-obj-type p-obj-code skip
     4401                   "Артикул" p-artic p-prod-type p-prod-code skip
     4402                   "Код товара" v-gds-code skip
     4403                   "Партия" archive_parts.in-code archive_parts.part-code skip
     4404                   "Необходимо резервировать" v-need-rsrv skip
     4405                   "Резерв" v-rsrv-code skip
     4406                   "Необходимо снятие резервов" v-need-unrv skip
     4407                   "Снятие резервов" v-unrv-code skip
     4408                   error-status :get-message(1) skip
     4409                   return-value skip
     4410                   view-as alert-box error .
     4411                 undo, return error .
     4412               end.
     4413   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run trnextdt in g#library
     4414     (input  buf_parts-attr.ext-doc-type
     4415     ,output v-doc-type
     4416     ) no-error .
     4417               if error-status :error
     4418               then do:
     4419                 message
     4420                   vss-workfile vss-revision vss-description skip
     4421                   vss-include-info8 skip
     4422                   "Ошибка при определении типа документа" skip
     4423                   "Документ" p-doc-code skip
     4424                   "Объект" p-obj-type p-obj-code skip
     4425                   "Артикул" p-artic p-prod-type p-prod-code skip
     4426                   "Код товара" v-gds-code skip
     4427                   "Партия" archive_parts.in-code archive_parts.part-code skip
     4428                   "Необходимо резервировать" v-need-rsrv skip
     4429                   "Резерв" v-rsrv-code skip
     4430                   "Необходимо снятие резервов" v-need-unrv skip
     4431                   "Снятие резервов" v-unrv-code skip
     4432                   error-status :get-message(1) skip
     4433                   return-value skip
     4434                   view-as alert-box error .
     4435                 undo, return error .
     4436               end.
     4437               assign
     4438                 buf_parts.fact-date = buf_parts-attr.fact-date
     4439                 buf_parts.fact-num  = v-fact-num
     4440                 buf_parts.doc-type  = v-doc-type
     4441               .
     4442             end.
     4443             assign
     4444               buf_parts.qnty      = buf_parts.qnty  + v-unrv-sign * archive_parts.fact-qnty
     4445               buf_parts.fact-qnty = buf_parts.qnty
     4446             .
     4447   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4449     (input  buf_parts.artic
     4450     ,input  buf_parts.prod-type
     4451     ,input  buf_parts.prod-code
     4452     ,output v-gds-code
     4453     ) no-error .
     4454             if buf_parts.out-code = 'free-zone':U
     4455             then
     4456             for each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = v-gds-code
     4457                                                         and buf_marking-lines.obj-type = archive_parts.obj-type
     4458                                                         and buf_marking-lines.obj-code = archive_parts.obj-code
     4459                                                         and buf_marking-lines.in-code  = archive_parts.in-code
     4460                                                         and buf_marking-lines.out-code = archive_parts.out-code
     4461                                                         and buf_marking-lines.part-code = archive_parts.part-code
     4462                                                         and buf_marking-lines.prt-code = archive_parts.prt-code:
     4463               for first buf_marking exclusive-lock where buf_marking.mark = buf_marking-lines.mark :
     4464                 find first free_marking-lines no-lock where free_marking-lines.mark       = buf_marking-lines.mark
     4465                                                         and free_marking-lines.gds-code   = buf_marking-lines.gds-code
     4466                                                         and free_marking-lines.obj-type   = buf_parts.obj-type
     4467                                                         and free_marking-lines.obj-code   = buf_parts.obj-code
     4468                                                         and free_marking-lines.in-code    = buf_parts.in-code
     4469                                                         and free_marking-lines.out-code   = buf_parts.out-code
     4470                                                         and free_marking-lines.part-code  = buf_parts.part-code
     4471                                                         and free_marking-lines.prt-code   = buf_parts.prt-code
     4472                                                         no-error .
     4473                 if not available free_marking-lines
     4474                 then do :
     4475                   create free_marking-lines .
     4476                   assign
     4477                     free_marking-lines.mark       = buf_marking-lines.mark
     4478                     free_marking-lines.doc-level  = buf_marking-lines.doc-level
     4479                     free_marking-lines.gds-code   = buf_marking-lines.gds-code
     4480                     free_marking-lines.obj-type   = buf_parts.obj-type
     4481                     free_marking-lines.obj-code   = buf_parts.obj-code
     4482                     free_marking-lines.in-code    = buf_parts.in-code
     4483                     free_marking-lines.out-code   = buf_parts.out-code
     4484                     free_marking-lines.part-code  = buf_parts.part-code
     4485                     free_marking-lines.prt-code   = buf_parts.prt-code
     4486                   .
     4487                 end .
     4488                 if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_trn-doc.doc-type <> 'спи':U and
     4489                    not (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U)
     4490                   then assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     4491                 if buf_trn-doc.ext-doc-type = 'es':U
     4492                 then do :
     4493                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB .
     4494                 end .
     4495                 for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     4496                   assign buf_marking-chk.sts = 0 .
     4497                 end .
     4498               end .
     4499               delete buf_marking-lines .
     4500             end.
     4501             if v-goods-twounit = true
     4502             then do:
     4503               assign
     4504                 buf_parts.cli-qnty = buf_parts.cli-qnty + v-unrv-sign * archive_parts.cli-qnty
     4505               .
     4506             end.
     4507             else do:
     4508               if buf_parts.cli-base-rate <> 0
     4509               then do:
     4510                 assign
     4511                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     4512                 .
     4513               end.
     4514               else do:
     4515                 assign
     4516                   buf_parts.cli-qnty = 0
     4517                 .
     4518               end.
     4519             end.
     4520             if  buf_parts.qnty      = 0
     4521             and buf_parts.fact-qnty = 0
     4522             then do:
     4523               if v-goods-twounit = true
     4524               then do:
     4525                 if buf_parts.cli-qnty <> 0
     4526                 then do:
     4527                   message
     4528                     vss-workfile vss-revision vss-description skip
     4529                     vss-include-info8 skip
     4530                     "Ошибка при удалении партии" skip
     4531                     "Документ" p-doc-code skip
     4532                     "Объект" p-obj-type p-obj-code skip
     4533                     "Артикул" p-artic p-prod-type p-prod-code skip
     4534                     "Партия" buf_parts.in-code buf_parts.part-code skip
     4535                     "Резерв" buf_parts.out-code skip
     4536                     "qnty" buf_parts.qnty skip
     4537                     "fact-qnty" buf_parts.fact-qnty skip
     4538                     "cli-qnty" buf_parts.cli-qnty skip
     4539                     view-as alert-box error .
     4540                   undo, return error .
     4541                 end.
     4542               end.
     4543               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     4544                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     4545                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     4546                                                           and del_marking-lines.in-code = buf_parts.in-code
     4547                                                           and del_marking-lines.out-code = buf_parts.out-code
     4548                                                           and del_marking-lines.part-code = buf_parts.part-code
     4549                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     4550                 delete del_marking-lines .
     4551               end.
     4552               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     4553                                           ,input (buffer buf_parts:handle)
     4554                                           ,output part-key-rec).
     4555               for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     4556                                        and ub.gen-attr.p-key =  part-key-rec
     4557               :
     4558                 find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     4559                 find current buf1_gen-attr exclusive-lock.
     4560                 delete buf1_gen-attr .
     4561               end.
     4562               delete buf_parts .
     4563             end.
     4564           end.
     4565         end.
     4566       end.
     4567     end.
     4568   end procedure.
     4569   procedure partcopy-rsrv-parts :
     4570     define input  parameter p-doc-code-rowid as rowid no-undo .
     4571     define input  parameter p-parts-rowid    as rowid no-undo .
     4572     define input  parameter p-rsrv-direction as logical   no-undo .
     4573     define input  parameter p-goods-twounit  as logical   no-undo .
     4574     define input  parameter p-is-hold        as logical   no-undo .
     4575     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     4576     define buffer buf_trn-doc for ub.trn-doc .
     4577     define buffer archive_parts for ub.parts .
     4578     define buffer buf_parts   for ub.parts .
     4579     define buffer orig_marking-lines for ub.marking-lines .
     4580     define buffer buf_marking-lines for ub.marking-lines .
     4581     define buffer buf_marking   for ub.marking .
     4582     define buffer buf_goods for ub.goods .
     4583     define variable v-rsrv-code as character no-undo .
     4584     do
     4585     on error undo, return error return-value
     4586     :
     4587       find first buf_trn-doc no-lock
     4588         where rowid(buf_trn-doc) = p-doc-code-rowid
     4589         no-error .
     4590       if not available buf_trn-doc
     4591       then do:
     4592         message
     4593           vss-workfile vss-revision vss-description skip
     4594           vss-include-info8 skip
     4595           "Ошибка задания входных параметров" skip
     4596           "Не найден документ" skip
     4597           "Документ" string(p-doc-code-rowid) skip
     4598           "Партия" string(p-parts-rowid) skip
     4599           error-status :get-message(1) skip
     4600           return-value skip
     4601           view-as alert-box error .
     4602         undo, return error .
     4603       end.
     4604       find first archive_parts
     4605         where rowid(archive_parts) = p-parts-rowid
     4606         no-error .
     4607       if not available archive_parts
     4608       then do:
     4609         message
     4610           vss-workfile vss-revision vss-description skip
     4611           vss-include-info8 skip
     4612           "Ошибка задания входных параметров" skip
     4613           "Не найдена партия" skip
     4614           "Документ" string(p-doc-code-rowid) skip
     4615           "Партия" string(p-parts-rowid) skip
     4616           error-status :get-message(1) skip
     4617           return-value skip
     4618           view-as alert-box error .
     4619         undo, return error .
     4620       end.
     4621       if  archive_parts.out-code <> archive_parts.in-code
     4622       and archive_parts.qnty <> 0
     4623       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     4624       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     4625       then do:
     4626         assign
     4627           v-rsrv-code =
     4628           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     4629         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     4630         then 'free-zone':U
     4631         else 'out-zone':U )
     4632         .
     4633         run partcopy in this-procedure
     4634           (input  true
     4635           ,input  v-rsrv-code
     4636           ,buffer archive_parts
     4637           ,buffer buf_parts
     4638           ,input  "news"
     4639           ) no-error .
     4640         if error-status :error
     4641         then do:
     4642           message
     4643             vss-workfile vss-revision vss-description skip
     4644             vss-include-info8 skip
     4645             "Ошибка при создании партии" skip
     4646             "Документ" buf_trn-doc.doc-code skip
     4647             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     4648             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     4649             "Партия" archive_parts.in-code archive_parts.part-code skip
     4650             "Количество" archive_parts.qnty skip
     4651             "Резерв" v-rsrv-code skip
     4652             error-status :get-message(1) skip
     4653             return-value skip
     4654             view-as alert-box error .
     4655           undo, return error .
     4656         end.
     4657         assign
     4658           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     4659                                                     * (if p-rsrv-direction = true
     4660                                                       then 1
     4661                                                       else -1
     4662                                                       )
     4663           buf_parts.fact-qnty = buf_parts.qnty
     4664         .
     4665         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     4666                                        and buf_goods.prod-type = archive_parts.prod-type
     4667                                        and buf_goods.prod-code = archive_parts.prod-code
     4668                                        .
     4669         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4670                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     4671                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     4672                                               and orig_marking-lines.in-code    = archive_parts.in-code
     4673                                               and orig_marking-lines.out-code   = archive_parts.out-code
     4674                                               and orig_marking-lines.part-code  = archive_parts.part-code
     4675                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     4676                                               :
     4677           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     4678                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     4679                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     4680                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     4681                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     4682                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     4683                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     4684                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     4685                                                   no-error .
     4686           if available buf_marking-lines
     4687           then do :
     4688             find current buf_marking-lines exclusive-lock .
     4689             delete buf_marking-lines .
     4690             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4691               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     4692             end .
     4693           end .
     4694           else do :
     4695             create buf_marking-lines .
     4696             assign
     4697               buf_marking-lines.mark       = orig_marking-lines.mark
     4698               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4699               buf_marking-lines.gds-code   = buf_goods.gds-code
     4700               buf_marking-lines.obj-type   = buf_parts.obj-type
     4701               buf_marking-lines.obj-code   = buf_parts.obj-code
     4702               buf_marking-lines.in-code    = buf_parts.in-code
     4703               buf_marking-lines.out-code   = buf_parts.out-code
     4704               buf_marking-lines.part-code  = buf_parts.part-code
     4705               buf_marking-lines.prt-code   = buf_parts.prt-code
     4706             .
     4707             if buf_parts.out-code <> buf_parts.in-code
     4708             and buf_parts.out-code <> 'free-zone':U
     4709             and buf_parts.out-code <> 'out-zone':U
     4710             then do :
     4711               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     4712               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     4713             end .
     4714             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4715               assign
     4716                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     4717                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     4718               .
     4719             end .
     4720           end .
     4721           release buf_marking-lines no-error .
     4722         end.
     4723         if p-goods-twounit = true
     4724         then do:
     4725           assign
     4726             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     4727                                                     * (if p-rsrv-direction = true
     4728                                                       then 1
     4729                                                       else -1
     4730                                                       )
     4731           .
     4732         end.
     4733         if  buf_parts.qnty      = 0
     4734         and buf_parts.fact-qnty = 0
     4735         then do:
     4736           if p-goods-twounit = true
     4737           then do:
     4738             if buf_parts.cli-qnty <> 0
     4739             then do:
     4740               message
     4741                 vss-workfile vss-revision vss-description skip
     4742                 vss-include-info8 skip
     4743                 "Ошибка при удалении партии" skip
     4744                 "Документ" buf_trn-doc.doc-code skip
     4745                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     4746                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4747                 "Партия" buf_parts.in-code buf_parts.part-code skip
     4748                 "Резерв" buf_parts.out-code skip
     4749                 "qnty" buf_parts.qnty skip
     4750                 "fact-qnty" buf_parts.fact-qnty skip
     4751                 "cli-qnty" buf_parts.cli-qnty skip
     4752                 view-as alert-box error .
     4753               undo, return error .
     4754             end.
     4755           end.
     4756           delete buf_parts .
     4757         end.
     4758       end.
     4759     end.
     4760   end procedure.
     4761   procedure partcopy-update-doc-line-tot-fact :
     4762     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4763     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4764     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4765     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4766     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     4767       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     4768     define buffer buf_doc-line for ub.doc-line .
     4769     do
     4770     on error undo, return error return-value
     4771     :
     4772       find first buf_doc-line exclusive-lock
     4773         where buf_doc-line.doc-code  = p-doc-code
     4774           and buf_doc-line.artic     = p-artic
     4775           and buf_doc-line.prod-type = p-prod-type
     4776           and buf_doc-line.prod-code = p-prod-code
     4777         no-error .
     4778       if error-status :error
     4779       then do:
     4780         message
     4781           vss-workfile vss-revision vss-description skip
     4782           vss-include-info8 skip
     4783           "Ошибка задания входных параметров" skip
     4784           "Не найдена строка документа" skip
     4785           "Документ" p-doc-code skip
     4786           "Артикул" p-artic p-prod-type p-prod-code skip
     4787           error-status :get-message(1) skip
     4788           return-value skip
     4789           view-as alert-box error .
     4790         undo, return error .
     4791       end.
     4792       run partrqst in this-procedure
     4793         (input buf_doc-line.doc-code
     4794         ,input buf_doc-line.obj-type
     4795         ,input buf_doc-line.obj-code
     4796         ,input buf_doc-line.artic
     4797         ,input buf_doc-line.prod-type
     4798         ,input buf_doc-line.prod-code
     4799               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     4800         ) no-error .
     4801       if error-status :error
     4802       then do:
     4803         message
     4804           vss-workfile vss-revision vss-description skip
     4805           vss-include-info8 skip
     4806           "Ошибка при сборе информации по партиям" skip
     4807           "Документ" p-doc-code skip
     4808           "Артикул" p-artic p-prod-type p-prod-code skip
     4809           view-as alert-box error .
     4810         undo, return error .
     4811       end.
     4812       if v-total-parts-fact-qnty <> 0
     4813       then do:
     4814         assign
     4815           buf_doc-line.price-base      = v-total-parts-price-base
     4816                                        / v-total-parts-fact-qnty
     4817           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     4818                                        / v-total-parts-fact-qnty
     4819           buf_doc-line.transport-base  = v-total-parts-transport-base
     4820                                        / v-total-parts-fact-qnty
     4821           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     4822                                        / v-total-parts-fact-qnty
     4823           buf_doc-line.other-base      = v-total-parts-other-base
     4824                                        / v-total-parts-fact-qnty
     4825           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     4826                                        / v-total-parts-fact-qnty
     4827         .
     4828       end.
     4829       else do:
     4830       end.
     4831     end.
     4832   end procedure.
     4833   procedure partcopy-change-purch-code :
     4834     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     4835     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     4836     define parameter buffer buf_orig_parts     for ub.parts .
     4837     define parameter buffer buf1_parts         for ub.parts .
     4838     define parameter buffer buf2_parts         for ub.parts .
     4839     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     4840     define variable var-out-code  like ub.parts.out-code no-undo .
     4841     define variable var-part-code like ub.parts.part-code no-undo .
     4842     define buffer buf_goods        for ub.goods .
     4843     define buffer buf_parts-root   for ub.parts-root.
     4844     define buffer buf_trn-doc      for ub.trn-doc.
     4845     define buffer buf-orig_trn-doc for ub.trn-doc.
     4846     define buffer buf_units        for ub.units .
     4847     do
     4848     on error undo, return error return-value
     4849     :
     4850       if buf_orig_parts.out-code = p-in-code
     4851       then do:
     4852         message
     4853           vss-workfile vss-revision vss-description skip
     4854           vss-include-info8 skip
     4855           "Ошибка задания входных параметров процедуры partcopy" skip
     4856           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     4857           "p-in-code" p-in-code skip
     4858           view-as alert-box error .
     4859         undo, return error .
     4860       end.
     4861       find first buf_trn-doc no-lock
     4862         where buf_trn-doc.doc-code = p-in-code
     4863         .
     4864       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     4865       find first buf_goods no-lock
     4866         where buf_goods.artic = buf_orig_parts.artic
     4867           and buf_goods.prod-type = buf_orig_parts.prod-type
     4868           and buf_goods.prod-code = buf_orig_parts.prod-code
     4869         .
     4870       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     4871       find first buf1_parts exclusive-lock
     4872         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     4873           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     4874           and buf1_parts.artic     = buf_orig_parts.artic
     4875           and buf1_parts.prod-type = buf_orig_parts.prod-type
     4876           and buf1_parts.prod-code = buf_orig_parts.prod-code
     4877           and buf1_parts.in-code   = buf_orig_parts.in-code
     4878           and buf1_parts.out-code  = p-in-code
     4879           and buf1_parts.part-code = buf_orig_parts.part-code
     4880         no-error.
     4881       if not available buf1_parts
     4882       then do:
     4883         create buf1_parts .
     4884         buffer-copy buf_orig_parts to buf1_parts
     4885         assign
     4886           buf1_parts.in-code    = buf_orig_parts.in-code
     4887           buf1_parts.out-code   = p-in-code
     4888           buf1_parts.status_    = no
     4889           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     4890           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     4891           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     4892           buf1_parts.purch-code = buf_orig_parts.purch-code
     4893           buf1_parts.rsrv-free  = ?
     4894           buf1_parts.status_    = yes
     4895         .
     4896         validate buf1_parts .
     4897       end.
     4898       if  lookup('сер':U, buf_units.type) > 0
     4899       then do:
     4900          var-part-code = buf_orig_parts.part-code.
     4901       end.
     4902       else do:
     4903           run holdprts-get-part-code in this-procedure
     4904             (input  p-in-code
     4905             ,output var-part-code
     4906             ) no-error .
     4907           if error-status :error
     4908           then dO:
     4909             undo, return error return-value.
     4910           end.
     4911       end.
     4912       find first buf2_parts exclusive-lock
     4913         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     4914           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     4915           and buf2_parts.artic     = buf_orig_parts.artic
     4916           and buf2_parts.prod-type = buf_orig_parts.prod-type
     4917           and buf2_parts.prod-code = buf_orig_parts.prod-code
     4918           and buf2_parts.in-code   = p-in-code
     4919           and buf2_parts.out-code  = p-in-code
     4920           and buf2_parts.part-code = var-part-code
     4921         no-error.
     4922       if not available buf2_parts
     4923       then do:
     4924         create buf2_parts .
     4925         buffer-copy buf_orig_parts to buf2_parts
     4926         assign
     4927           buf2_parts.in-code   = p-in-code
     4928           buf2_parts.out-code  = p-in-code
     4929           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     4930           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     4931           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     4932           buf2_parts.purch-code = p-dest-purch-code
     4933           buf2_parts.part-code  = var-part-code
     4934           buf2_parts.rsrv-free  = ?
     4935           buf2_parts.status_    = yes
     4936         .
     4937         validate buf2_parts .
     4938       end.
     4939       assign
     4940         buf_orig_parts.in-code    = p-in-code
     4941         buf_orig_parts.part-code  = buf2_parts.part-code
     4942         buf_orig_parts.purch-code = buf2_parts.purch-code
     4943       .
     4944       find first buf_parts-root
     4945         where buf_parts-root.doc-code       = p-in-code
     4946           and buf_parts-root.in-code        = p-in-code
     4947           and buf_parts-root.gds-code       = buf_goods.gds-code
     4948           and buf_parts-root.part-code      = buf2_parts.part-code
     4949           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     4950           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     4951           and buf_parts-root.orig-part-code = buf1_parts.part-code
     4952         no-error .
     4953       if not available buf_parts-root
     4954       then do:
     4955         create buf_parts-root.
     4956         assign
     4957         buf_parts-root.doc-code       = p-in-code
     4958         buf_parts-root.in-code        = p-in-code
     4959         buf_parts-root.gds-code       = buf_goods.gds-code
     4960         buf_parts-root.part-code      = buf2_parts.part-code
     4961         buf_parts-root.orig-in-code   = buf1_parts.in-code
     4962         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     4963         buf_parts-root.orig-part-code = buf1_parts.part-code
     4964         .
     4965       end.
     4966     end.
     4967   end procedure.
     4968   procedure addChildMarkingLines:
     4969     define input parameter iMark as character no-undo.
     4970     define input parameter iSts  as integer   no-undo.
     4971     define parameter buffer buf_marking-lines  for ub.marking-lines.
     4972     define parameter buffer buf_parts          for ub.parts.
     4973     define parameter buffer orig_marking-lines for ub.marking-lines.
     4974     define parameter buffer buf_orig_parts     for ub.parts.
     4975     define parameter buffer buf_goods          for ub.goods.
     4976     define buffer buf_marking-childs        for ub.marking.
     4977     define buffer buf_marking-lines-childs  for ub.marking-lines.
     4978     define buffer buf_marking-chk           for ub.marking-chk.
     4979     define buffer buf_chk-doc               for ub.chk-doc.
     4980     define buffer orig_marking-lines-childs for ub.marking-lines.
     4981     for each buf_marking-childs exclusive-lock where
     4982              buf_marking-childs.mark-parent = iMark :
     4983         find first buf_marking-lines-childs no-lock where
     4984                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     4985                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     4986                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     4987                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     4988                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     4989                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     4990                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     4991                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     4992         no-error .
     4993         if not available buf_marking-lines-childs then
     4994         do:
     4995           create buf_marking-lines-childs .
     4996           assign
     4997             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     4998             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     4999             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     5000             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     5001             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     5002             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     5003             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     5004             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     5005             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     5006             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     5007           .
     5008           validate buf_marking-childs.
     5009         end .
     5010         buf_marking-childs.sts = iSts .
     5011         for each buf_marking-chk exclusive-lock where
     5012                  buf_marking-chk.mark begins buf_marking-childs.mark
     5013         :
     5014           for first buf_chk-doc no-lock where
     5015                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     5016                 and buf_chk-doc.out-code = buf_parts.out-code
     5017           :
     5018             buf_marking-chk.sts = 0 .
     5019             validate buf_marking-chk.
     5020           end .
     5021         end .
     5022         if available orig_marking-lines
     5023         then do :
     5024           find first orig_marking-lines-childs exclusive-lock where
     5025                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     5026                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     5027                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     5028                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     5029                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     5030                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     5031                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     5032                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     5033           no-error .
     5034           if available orig_marking-lines-childs then
     5035             delete orig_marking-lines-childs .
     5036         end.
     5037         run addChildMarkingLines in this-procedure (
     5038           buf_marking-childs.mark,
     5039           iSts,
     5040           buffer buf_marking-lines,
     5041           buffer buf_parts,
     5042           buffer orig_marking-lines,
     5043           buffer buf_orig_parts,
     5044           buffer buf_goods
     5045         ).
     5046     end .
     5047   end.
     5048   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5049   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5050   define new global shared variable g#trdcalib as handle no-undo.
     5051   function stsMarkWhenDeleteGoods returns integer
     5052       (input iDocCode as character,
     5053        input iMark as character):
     5054     define variable vValue as character no-undo.
     5055     define variable vType as character no-undo.
     5056     define buffer buf_trn-doc for ub.trn-doc.
     5057     define buffer buf_c-marking for ub.c-marking.
     5058     if iDocCode <> ? then
     5059     do:
     5060         find first buf_trn-doc no-lock where
     5061                    buf_trn-doc.doc-code = iDocCode no-error.
     5062         if avail buf_trn-doc then
     5063         do:
     5064   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     5065                           input 'is-return':U ,
     5066                          output vValue ,
     5067                          output vType ) no-error .
     5068            if buf_trn-doc.ext-doc-type = 'we':U or
     5069               buf_trn-doc.ext-doc-type = 'ev':U or
     5070               vValue = "yes" then
     5071            do:
     5072              find last buf_c-marking no-lock where
     5073                        buf_c-marking.mark = iMark
     5074                   use-index pi-2 no-error.
     5075              if avail buf_c-marking and
     5076                      (buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB or
     5077                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB or
     5078                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB or
     5079                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:Moved:KeyIntDB or
     5080                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB) then
     5081                return buf_c-marking.sts .
     5082            end.
     5083         end.
     5084     end.
     5085     return objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5086   end function.
     5087   procedure partrsrv :
     5088     define input parameter  p-chg-qnty      as decimal   no-undo .
     5089     define input parameter  p-goods-serial  as logical   no-undo .
     5090     define input parameter  p-goods-twounit as logical   no-undo .
     5091     define input parameter  p-unreserv-only as logical   no-undo .
     5092     define parameter buffer buf_orig_parts  for ub.parts .
     5093     define parameter buffer buf_trn-doc     for ub.trn-doc .
     5094     define output parameter p-real-chg-qnty as decimal   no-undo .
     5095     define output parameter p-parts-recid   as recid     no-undo .
     5096     define input  parameter p-mark          as character  no-undo .
     5097     define variable vss-description as character no-undo init "$Workfile$ Резервирование и снятие резервов по одной партии".
     5098     define buffer buf_parts  for ub.parts .
     5099     define buffer rsrv-parts for ub.parts .
     5100     define buffer unrsrv-parts for ub.parts .
     5101     define buffer buf_parts-attr for ub.parts-attr .
     5102     define buffer free_marking-lines for ub.marking-lines .
     5103     define variable lok                as logical   no-undo .
     5104     define variable v-sign-chg-qnty    as integer   no-undo .
     5105     define variable v-sign-rsrv-qnty   as integer   no-undo .
     5106     define variable v-rsrv-qnty        as decimal   no-undo .
     5107     define variable v-orig-unrsrv-code as character no-undo .
     5108     define variable v-new-rsrv-code    as character no-undo .
     5109     define variable v-new-unrsrv-code  as character no-undo .
     5110     define variable v-unrsrv-qnty      as decimal   no-undo .
     5111     define variable v-value-character as character no-undo .
     5112     define variable v-value-date      as date no-undo .
     5113     define variable v-value-decimal   as decimal no-undo .
     5114     define variable v-value-integer   as integer no-undo .
     5115     define variable v-izlcstpr        as logical no-undo .
     5116     define variable v-tth             as handle no-undo .
     5117     define variable v-type            as character no-undo .
     5118     define variable part-key-rec      as character no-undo .
     5119     define variable v-part-code-int   as integer no-undo .
     5120     define variable v-old-part-code   as character no-undo .
     5121     define variable v-part-gds-code   as integer   no-undo .
     5122     do transaction
     5123     on error undo, return error
     5124     :
     5125       if buf_trn-doc.ext-doc-type = 'vt':U
     5126       then do :
     5127           delete object v-tth no-error.
     5128           run adm/shattri.p (
     5129              input "get":U
     5130             ,input buf_orig_parts.obj-type
     5131             ,input buf_orig_parts.obj-code
     5132             ,input 'inv-obj':U
     5133             ,input  "izlcstpr"
     5134             ,output v-value-character
     5135             ,output v-value-date
     5136             ,output v-value-decimal
     5137             ,output v-value-integer
     5138             ,output v-izlcstpr
     5139             ,output v-type
     5140             ,INPUT-OUTPUT table-handle v-tth
     5141             ) no-error .
     5142             delete object v-tth no-error.
     5143           if error-status:error then do:
     5144             v-izlcstpr = false .
     5145           end.
     5146       end.
     5147       else do :
     5148           v-izlcstpr = false .
     5149       end.
     5150       assign
     5151         p-parts-recid = ?
     5152       .
     5153       if p-chg-qnty = 0 then do:
     5154         assign
     5155           p-parts-recid = recid(buf_orig_parts)
     5156         .
     5157         return .
     5158       end.
     5159       assign
     5160         v-sign-chg-qnty = 0
     5161       .
     5162       if p-chg-qnty < 0 then do:
     5163         assign
     5164           v-sign-chg-qnty = -1
     5165         .
     5166       end.
     5167       if p-chg-qnty > 0 then do:
     5168         assign
     5169           v-sign-chg-qnty = 1
     5170         .
     5171       end.
     5172       assign
     5173         v-sign-rsrv-qnty = v-sign-chg-qnty
     5174       .
     5175       if lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 then do:
     5176         assign
     5177           v-sign-rsrv-qnty = - v-sign-chg-qnty
     5178         .
     5179       end.
     5180       run partcopy in this-procedure
     5181         (input  false
     5182         ,input  buf_trn-doc.doc-code
     5183         ,buffer buf_orig_parts
     5184         ,buffer buf_parts
     5185         ,input  p-mark
     5186         ) no-error .
     5187       if error-status :error then do:
     5188         message
     5189           vss-workfile vss-revision vss-description skip
     5190           "Ошибка при создании партии" skip
     5191           "Объект" buf_orig_parts.obj-type buf_orig_parts.obj-code skip
     5192           "Артикул" buf_orig_parts.artic buf_orig_parts.prod-type buf_orig_parts.prod-code skip
     5193           "Партия" buf_orig_parts.in-code buf_orig_parts.part-code skip
     5194           "Резерв" buf_trn-doc.doc-code skip
     5195           error-status :get-message(1) skip
     5196           return-value skip
     5197           view-as alert-box error .
     5198         undo, return error .
     5199       end.
     5200       if buf_parts.in-code = buf_parts.out-code then do:
     5201         assign
     5202           v-rsrv-qnty = abs(p-chg-qnty)
     5203         .
     5204         if buf_trn-doc.doc-type <> 'инв':U then do:
     5205           if buf_parts.qnty < 0
     5206           or buf_parts.fact-qnty < 0 then do:
     5207             message
     5208               vss-workfile vss-revision vss-description skip
     5209               "Резервирование невозможно" skip
     5210               "Партия зарезервированная за обычным документом имеет отрицательное количество" skip
     5211               view-as alert-box error .
     5212             undo, return error .
     5213           end.
     5214           if v-sign-rsrv-qnty < 0 then do:
     5215             assign
     5216               v-rsrv-qnty = min(abs(buf_parts.qnty), v-rsrv-qnty)
     5217             .
     5218           end.
     5219         end.
     5220         assign
     5221           buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     5222           buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     5223         .
     5224         if p-goods-twounit = true
     5225         then do:
     5226           if buf_parts.qnty < 0 then do:
     5227             message
     5228               "Порожденная партия ювелирных изделий не может иметь отрицательное количество" skip
     5229               "Количество" buf_parts.qnty skip
     5230               view-as alert-box error .
     5231             undo, return error .
     5232           end.
     5233           if buf_parts.qnty = 0 then do:
     5234             assign
     5235               buf_parts.cli-qnty = 0
     5236             .
     5237           end.
     5238           if  buf_parts.qnty <> 0
     5239           and buf_parts.cli-qnty <> 1
     5240           then do:
     5241             message
     5242               vss-workfile vss-revision vss-description skip
     5243               "Порожденная партия ювелирных изделий должна иметь определенное клиентское количество" skip
     5244               "qnty" buf_parts.qnty skip
     5245               "cli-qnty" buf_parts.cli-qnty skip
     5246               view-as alert-box error .
     5247             undo, return error .
     5248           end.
     5249         end.
     5250         else do:
     5251           if buf_parts.cli-base-rate <> 0
     5252           then do:
     5253             assign
     5254               buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5255             .
     5256           end.
     5257           else do:
     5258             assign
     5259               buf_parts.cli-qnty = 0
     5260             .
     5261           end.
     5262         end.
     5263         assign
     5264           p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     5265           p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     5266         .
     5267       end.
     5268       else do:
     5269         assign
     5270           v-orig-unrsrv-code =
     5271           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     5272         or (buf_trn-doc.doc-type = 'инв':U and buf_parts.qnty < 0)
     5273         then 'free-zone':U
     5274         else 'out-zone':U )
     5275           v-new-rsrv-code    =  ( if p-chg-qnty > 0
     5276                                   then 'free-zone':U
     5277                                   else 'out-zone':U
     5278                                 )
     5279           v-new-unrsrv-code  =  ( if p-chg-qnty > 0
     5280                                   then 'out-zone':U
     5281                                   else 'free-zone':U
     5282                                 )
     5283         .
     5284         if v-new-rsrv-code = v-orig-unrsrv-code then do:
     5285           assign
     5286             v-rsrv-qnty = min(abs(buf_parts.qnty), abs(p-chg-qnty) )
     5287           .
     5288           if v-izlcstpr and buf_parts.out-code <> v-new-rsrv-code and p-chg-qnty > 0
     5289           then do :
     5290               find first rsrv-parts exclusive-lock
     5291                   where rsrv-parts.obj-type  = buf_parts.obj-type
     5292                     and rsrv-parts.obj-code  = buf_parts.obj-code
     5293                     and rsrv-parts.artic     = buf_parts.artic
     5294                     and rsrv-parts.prod-type = buf_parts.prod-type
     5295                     and rsrv-parts.prod-code = buf_parts.prod-code
     5296                     and rsrv-parts.in-code   = buf_parts.out-code
     5297                     and rsrv-parts.out-code  = v-new-rsrv-code
     5298                     and rsrv-parts.part-code = buf_parts.part-code
     5299                   no-error.
     5300           end.
     5301           if not available rsrv-parts
     5302           then do :
     5303               run partcopy in this-procedure
     5304                 (input  true
     5305                 ,input  v-new-rsrv-code
     5306                 ,buffer buf_parts
     5307                 ,buffer rsrv-parts
     5308                 ,input p-mark
     5309                 ) no-error .
     5310               if error-status :error then do:
     5311                 message
     5312                   vss-workfile vss-revision vss-description skip
     5313                   "Ошибка при создании партии" skip
     5314                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     5315                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     5316                   "Партия" buf_parts.in-code buf_parts.part-code skip
     5317                   "Резерв" v-new-rsrv-code skip
     5318                   error-status :get-message(1) skip
     5319                   return-value skip
     5320                   view-as alert-box error .
     5321                 undo, return error .
     5322               end.
     5323           end.
     5324           if not v-izlcstpr or (v-izlcstpr and p-chg-qnty > 0)
     5325           then
     5326           assign
     5327             rsrv-parts.qnty      = rsrv-parts.qnty      + v-rsrv-qnty
     5328             rsrv-parts.fact-qnty = rsrv-parts.fact-qnty + v-rsrv-qnty
     5329           .
     5330           if p-goods-twounit = true then do:
     5331             assign
     5332               rsrv-parts.cli-qnty = rsrv-parts.cli-qnty + abs(buf_parts.cli-qnty)
     5333             .
     5334           end.
     5335           else do:
     5336             if rsrv-parts.cli-base-rate <> 0
     5337             then do:
     5338               assign
     5339                 rsrv-parts.cli-qnty = rsrv-parts.fact-qnty / rsrv-parts.cli-base-rate
     5340               .
     5341             end.
     5342             else do:
     5343               assign
     5344                 rsrv-parts.cli-qnty = 0
     5345               .
     5346             end.
     5347           end.
     5348           assign
     5349             buf_parts.qnty      = buf_parts.qnty      + v-rsrv-qnty * v-sign-rsrv-qnty
     5350             buf_parts.fact-qnty = buf_parts.fact-qnty + v-rsrv-qnty * v-sign-rsrv-qnty
     5351           .
     5352           if p-goods-twounit = true then do:
     5353             assign
     5354               buf_parts.cli-qnty = 0
     5355             .
     5356           end.
     5357           else do:
     5358             if buf_parts.cli-base-rate <> 0
     5359             then do:
     5360               assign
     5361                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5362               .
     5363             end.
     5364             else do:
     5365               assign
     5366                 buf_parts.cli-qnty = 0
     5367               .
     5368             end.
     5369           end.
     5370           assign
     5371             p-chg-qnty      = p-chg-qnty      - v-rsrv-qnty * v-sign-chg-qnty
     5372             p-real-chg-qnty = p-real-chg-qnty + v-rsrv-qnty * v-sign-chg-qnty
     5373           .
     5374         end.
     5375         if p-chg-qnty <> 0
     5376         and (
     5377              (buf_trn-doc.doc-type = 'инв':U
     5378              and p-unreserv-only = false
     5379              )
     5380             or v-new-unrsrv-code = v-orig-unrsrv-code
     5381             )
     5382         then do:
     5383           if v-izlcstpr and buf_parts.out-code <> v-new-unrsrv-code and p-chg-qnty < 0
     5384           then do :
     5385               find first unrsrv-parts exclusive-lock
     5386                   where unrsrv-parts.obj-type  = buf_parts.obj-type
     5387                     and unrsrv-parts.obj-code  = buf_parts.obj-code
     5388                     and unrsrv-parts.artic     = buf_parts.artic
     5389                     and unrsrv-parts.prod-type = buf_parts.prod-type
     5390                     and unrsrv-parts.prod-code = buf_parts.prod-code
     5391                     and unrsrv-parts.in-code   = buf_parts.in-code
     5392                     and unrsrv-parts.out-code  = v-new-unrsrv-code
     5393                     and unrsrv-parts.part-code = buf_parts.part-code
     5394                   no-error.
     5395           end.
     5396           if not available unrsrv-parts
     5397           then do :
     5398               run partcopy in this-procedure
     5399                 (input  true
     5400                 ,input  v-new-unrsrv-code
     5401                 ,buffer buf_parts
     5402                 ,buffer unrsrv-parts
     5403                 ,input  p-mark
     5404                 ) no-error .
     5405               if error-status :error then do:
     5406                 message
     5407                   vss-workfile vss-revision vss-description skip
     5408                   "Ошибка при создании партии" skip
     5409                   "Объект" buf_parts.obj-type buf_parts.obj-code skip
     5410                   "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     5411                   "Партия" buf_parts.in-code buf_parts.part-code skip
     5412                   "Резерв" v-new-rsrv-code skip
     5413                   error-status :get-message(1) skip
     5414                   return-value skip
     5415                   view-as alert-box error .
     5416                 undo, return error .
     5417               end.
     5418           end.
     5419           assign
     5420             v-unrsrv-qnty = min( (if unrsrv-parts.qnty > 0
     5421                                   then unrsrv-parts.qnty
     5422                                   else 0
     5423                                   )
     5424                             , abs(p-chg-qnty))
     5425           .
     5426           assign
     5427             buf_parts.qnty      = buf_parts.qnty      + v-unrsrv-qnty * v-sign-rsrv-qnty
     5428             buf_parts.fact-qnty = buf_parts.fact-qnty + v-unrsrv-qnty * v-sign-rsrv-qnty
     5429           .
     5430           if p-goods-twounit = true then do:
     5431             assign
     5432               buf_parts.cli-qnty = buf_parts.cli-qnty + unrsrv-parts.cli-qnty * v-sign-rsrv-qnty
     5433             .
     5434           end.
     5435           else do:
     5436             if buf_parts.cli-base-rate <> 0
     5437             then do:
     5438               assign
     5439                 buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     5440               .
     5441             end.
     5442             else do:
     5443               assign
     5444                 buf_parts.cli-qnty = 0
     5445               .
     5446             end.
     5447           end.
     5448           if num-entries(buf_parts.part-code, "_") = 2
     5449           and buf_parts.qnty > 0
     5450           and buf_parts.out-code <> 'free-zone':U
     5451           and buf_parts.out-code <> 'out-zone':U
     5452           and buf_trn-doc.ext-doc-type = 'vt':U
     5453           then do :
     5454             v-old-part-code = buf_parts.part-code .
     5455             v-part-code-int = 0 .
     5456             buf_parts.part-code = entry(2, buf_parts.part-code, "_") no-error .
     5457             do while error-status:error :
     5458               v-part-code-int = v-part-code-int + 1 .
     5459               buf_parts.part-code = string(integer(entry(2, buf_parts.part-code, "_")) + v-part-code-int) no-error .
     5460             end .
     5461   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5462   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5463     (input  buf_parts.artic
     5464     ,input  buf_parts.prod-type
     5465     ,input  buf_parts.prod-code
     5466     ,output v-part-gds-code
     5467     )  .
     5468             find first buf_parts-attr exclusive-lock where buf_parts-attr.in-code   = buf_parts.in-code
     5469                                                        and buf_parts-attr.gds-code  = v-part-gds-code
     5470                                                        and buf_parts-attr.part-code = buf_parts.part-code
     5471                                                        no-error.
     5472             if not available buf_parts-attr then do:
     5473               find first ub.parts-attr no-lock where ub.parts-attr.in-code   = buf_parts.in-code
     5474                                                  and ub.parts-attr.gds-code  = v-part-gds-code
     5475                                                  and ub.parts-attr.part-code = v-old-part-code
     5476                                                  no-error.
     5477               if available ub.parts-attr then do:
     5478                 create buf_parts-attr.
     5479                 buffer-copy ub.parts-attr to buf_parts-attr
     5480                 assign
     5481                   buf_parts-attr.part-code = buf_parts.part-code
     5482                 .
     5483               end.
     5484             end.
     5485           end .
     5486           if not v-izlcstpr or (v-izlcstpr and p-chg-qnty < 0)
     5487           then
     5488           assign
     5489             unrsrv-parts.qnty      = unrsrv-parts.qnty      - v-unrsrv-qnty
     5490             unrsrv-parts.fact-qnty = unrsrv-parts.fact-qnty - v-unrsrv-qnty
     5491           .
     5492           if p-goods-twounit = true
     5493           then do:
     5494             assign
     5495               unrsrv-parts.cli-qnty = 0
     5496             .
     5497           end.
     5498           else do:
     5499             if unrsrv-parts.cli-base-rate <> 0
     5500             then do:
     5501               assign
     5502                 unrsrv-parts.cli-qnty = unrsrv-parts.fact-qnty / unrsrv-parts.cli-base-rate
     5503               .
     5504             end.
     5505             else do:
     5506               assign
     5507                 unrsrv-parts.cli-qnty = 0
     5508               .
     5509             end.
     5510           end.
     5511           assign
     5512             p-chg-qnty      = p-chg-qnty      - v-unrsrv-qnty * v-sign-chg-qnty
     5513             p-real-chg-qnty = p-real-chg-qnty + v-unrsrv-qnty * v-sign-chg-qnty
     5514           .
     5515         end.
     5516       end.
     5517       if available unrsrv-parts
     5518       and unrsrv-parts.qnty      = 0
     5519       and unrsrv-parts.fact-qnty = 0
     5520       then do:
     5521         if p-goods-twounit = true then do:
     5522           if unrsrv-parts.cli-qnty <> 0 then do:
     5523             message
     5524               vss-workfile vss-revision vss-description skip
     5525               "Ошибка при удалении партии" skip
     5526               "Объект" unrsrv-parts.obj-type unrsrv-parts.obj-code skip
     5527               "Артикул" unrsrv-parts.artic unrsrv-parts.prod-type unrsrv-parts.prod-code skip
     5528               "Партия" unrsrv-parts.in-code unrsrv-parts.part-code skip
     5529               "Резерв" unrsrv-parts.out-code skip
     5530               "qnty" unrsrv-parts.qnty skip
     5531               "fact-qnty" unrsrv-parts.fact-qnty skip
     5532               "cli-qnty" unrsrv-parts.cli-qnty skip
     5533               view-as alert-box error .
     5534             undo, return error .
     5535           end.
     5536         end.
     5537         define variable origpart-key-rec as character no-undo .
     5538         define buffer buf_gen-attr for ub.gen-attr .
     5539         define buffer buf1_gen-attr for ub.gen-attr .
     5540         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     5541                                           ,input (buffer unrsrv-parts:handle)
     5542                                           ,output part-key-rec).
     5543         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     5544                                           ,input (buffer buf_parts:handle)
     5545                                           ,output origpart-key-rec).
     5546         if  v-new-rsrv-code <> 'out-zone':U then do:
     5547           for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     5548                                               and ub.gen-attr.p-key =  part-key-rec :
     5549             find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     5550                                               and buf_gen-attr.p-key =  origpart-key-rec
     5551                                               and buf_gen-attr.attr-code = ub.gen-attr.attr-code no-error .
     5552           if not available (buf_gen-attr) then do:
     5553               create buf_gen-attr .
     5554               buffer-copy ub.gen-attr to buf_gen-attr
     5555               assign
     5556                   buf_gen-attr.p-key = origpart-key-rec
     5557               no-error .
     5558           end.
     5559             find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     5560             find current buf1_gen-attr exclusive-lock.
     5561             delete buf1_gen-attr .
     5562         end.
     5563         end.
     5564         define variable v-gds-code as integer   no-undo .
     5565   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5567     (input  unrsrv-parts.artic
