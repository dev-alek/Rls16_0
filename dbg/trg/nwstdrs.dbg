     3669                   .
     3670                 end.
     3671                 else do:
     3672                   message
     3673                     vss-workfile vss-revision vss-description skip
     3674                     vss-include-info8 skip
     3675                     "Фактическое количество для товара," skip
     3676                     "который учитывается по двум единицам измерения" skip
     3677                     "должно равняться нулю или количеству по документу" skip
     3678                     "Документ" p-doc-code skip
     3679                     "Объект" p-obj-type p-obj-code skip
     3680                     "Артикул" p-artic p-prod-type p-prod-code skip
     3681                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3682                     "Количество по документу" archive_parts.qnty skip
