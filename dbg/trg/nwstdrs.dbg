     3538                     view-as alert-box error .
     3539                   undo, return error .
     3540                 end.
     3541               end.
     3542               delete buf_parts .
     3543             end.
     3544           end.
     3545           if archive_parts.in-code = buf_trn-doc.doc-code
     3546           then do:
     3547             assign
     3548               archive_parts.fact-num  = buf_trn-doc.fact-num
     3549               archive_parts.fact-date = buf_trn-doc.fact-date
     3550               archive_parts.doc-type  = buf_trn-doc.doc-type
     3551             .
     3552           end.
     3553           if archive_parts.fact-qnty <> 0
     3554           then do:
     3555             if can-do('рас,спи':U, buf_trn-doc.doc-type)
     3556             or (buf_trn-doc.doc-type = 'инв':U
     3557                 and archive_parts.fact-qnty < 0
     3558               )
     3559             then do:
     3560   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3561   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3562     (input  buf_trn-doc.doc-code
     3563     ,output v-is-hold
     3564     ) no-error .
     3565               if error-status :error
     3566               then do:
     3567                 message
     3568                   vss-workfile vss-revision vss-description skip
     3569                   vss-include-info8
     3570                   "Ошибка при определении типа документа hold-doc.i" skip
     3571                   "Документ" p-doc-code skip
     3572                   "Объект" p-obj-type p-obj-code skip
     3573                   "Артикул" p-artic p-prod-type p-prod-code skip
     3574                   error-status :get-message(1) skip
     3575                   return-value skip
     3576                   view-as alert-box error .
     3577                 undo, return error .
     3578               end.
     3579               assign
     3580                 v-rsrv-code = 'out-zone':U
     3581               .
     3582               if buf_trn-doc.ext-doc-type  = 'ep':U
     3583               or (buf_trn-doc.ext-doc-type = 'ap':U )
     3584               or (buf_trn-doc.ext-doc-type = 'pc':U )
     3585               then do:
     3586                 assign
     3587                   v-rsrv-code = ""
     3588                 .
     3589                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     3590                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     3591                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     3592                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     3593                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     3594                                                       and orig_marking-lines.part-code  = archive_parts.part-code,
     3595                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3596                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB .
     3597                 end .
     3598               end.
     3599             end.
     3600             else do:
     3601               assign
     3602                 v-rsrv-code = 'free-zone':U
     3603               .
     3604             end.
     3605             if v-rsrv-code <> ""
     3606             then do:
     3607               run partcopy in this-procedure
     3608                 (input  true
     3609                 ,input  v-rsrv-code
     3610                 ,buffer archive_parts
     3611                 ,buffer buf_parts
     3612                 ,input  ""
     3613                 ) no-error .
     3614               if error-status :error
     3615               then do:
     3616                 message
     3617                   vss-workfile vss-revision vss-description skip
     3618                   vss-include-info8 skip
     3619                   "Ошибка при создании партии" skip
