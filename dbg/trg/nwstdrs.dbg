     3807                     "Клиентское количество" archive_parts.cli-qnty skip
     3808                     view-as alert-box error .
     3809                   undo, return error .
     3810                 end.
     3811                 else do:
     3812                   if buf_parts.cli-base-rate <> 0
     3813                   then do:
     3814                     assign
     3815                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3816                     .
     3817                   end.
     3818                   else do:
     3819                     assign
     3820                       buf_parts.cli-qnty = 0
     3821                     .
     3822                   end.
     3823                 end.
     3824             end.
     3825           end.
     3826           get next partcopy-select-parts .
