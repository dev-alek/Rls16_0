     3768                     "Артикул" p-artic p-prod-type p-prod-code skip
     3769                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3770                     "Резерв" v-rsrv-code skip
     3771                     error-status :get-message(1) skip
     3772                     return-value skip
     3773                     view-as alert-box error .
     3774                   undo, return error .
     3775                 end.
     3776                 assign
