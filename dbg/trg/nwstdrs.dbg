     3492                     "должно равняться нулю или количеству по документу" skip
     3493                     "Документ" p-doc-code skip
     3494                     "Объект" p-obj-type p-obj-code skip
     3495                     "Артикул" p-artic p-prod-type p-prod-code skip
     3496                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3497                     "Количество по документу" archive_parts.qnty skip
