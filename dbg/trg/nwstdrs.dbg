     3476                     "Клиентское количество" archive_parts.cli-qnty skip
     3477                     view-as alert-box error .
     3478                   undo, return error .
     3479                 end.
     3480                 if archive_parts.fact-qnty = 0
     3481                 then do:
     3482                   assign
     3483                     buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     3484                   .
