     3514                   .
     3515                 end.
     3516               end.
     3517             end.
     3518             if  available buf_parts
     3519             and buf_parts.qnty      = 0
     3520             and buf_parts.fact-qnty = 0
     3521             then do:
     3522               if v-goods-twounit = true
     3523               then do:
     3524                 if buf_parts.cli-qnty <> 0
     3525                 then do:
     3526                   message
     3527                     vss-workfile vss-revision vss-description skip
     3528                     vss-include-info8 skip
