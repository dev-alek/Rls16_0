     3465                     vss-workfile vss-revision vss-description skip
     3466                     vss-include-info8 skip
     3467                     "Клиентское количество для товара," skip
     3468                     "который учитывается по двум единицам измерения" skip
     3469                     "должно равняться единице" skip
     3470                     "Документ" p-doc-code skip
     3471                     "Объект" p-obj-type p-obj-code skip
     3472                     "Артикул" p-artic p-prod-type p-prod-code skip
     3473                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3474                     "Количество по документу" archive_parts.qnty skip
