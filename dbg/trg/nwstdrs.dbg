     5663                                               and ub.gen-attr.p-key =  part-key-rec :
     5664           if (entry (8,part-key-rec,chr(3)) <> 'free-zone':U) and (entry (8,part-key-rec,chr(3)) <> entry (7,part-key-rec,chr(3))) then do:
     5665           part-key-rec_free = part-key-rec .
     5666           entry (8,part-key-rec_free,chr(3)) = 'free-zone':U .
