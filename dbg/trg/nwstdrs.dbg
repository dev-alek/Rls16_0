     3787                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     3788                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     3789                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3790                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     3791                   then
