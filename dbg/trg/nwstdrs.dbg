     5953   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     5954     (input  buf_doc-line.artic
     5955     ,input  buf_doc-line.prod-type
     5956     ,input  buf_doc-line.prod-code
     5957     ,input  'twounit=request':u
     5958     ,output v-goods-twounit
     5959     ) no-error .
     5960       if error-status :error then do:
     5961         message
     5962           vss-workfile vss-revision vss-description skip
     5963           "Ошибка при определении атрибута товара" skip
     5964           "Двойная единица измерения" skip
     5965           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     5966           "Документ" buf_doc-line.doc-code skip
     5967           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     5968           error-status :get-message(1) skip
     5969           return-value skip
     5970           view-as alert-box error .
     5971         undo, return error .
     5972       end.
     5973   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5974   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     5975     (input  buf_doc-line.obj-type
     5976     ,input  buf_doc-line.obj-code
     5977     ,input  buf_doc-line.artic
     5978     ,input  buf_doc-line.prod-type
     5979     ,input  buf_doc-line.prod-code
     5980     ,input  'place-rsrv=request'
     5981     ,output v-place-rsrv
     5982     ) no-error .
     5983       if error-status :error then do:
     5984         message
     5985           vss-workfile vss-revision vss-description skip
     5986           "Ошибка при определении атрибута на объекта" skip
     5987           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     5988           "Документ" buf_doc-line.doc-code skip
     5989           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     5990           error-status :get-message(1) skip
     5991           return-value skip
     5992           view-as alert-box error .
     5993         undo, return error .
     5994       end.
     5995       run trndocrs-clear in this-procedure
     5996         .
     5997       define query partcopy-select-parts for buf_parts .
     5998       open query partcopy-select-parts preselect each buf_parts
     5999         where buf_parts.obj-type  = buf_doc-line.obj-type
     6000           and buf_parts.obj-code  = buf_doc-line.obj-code
     6001           and buf_parts.artic     = buf_doc-line.artic
     6002           and buf_parts.prod-type = buf_doc-line.prod-type
     6003           and buf_parts.prod-code = buf_doc-line.prod-code
     6004           and buf_parts.out-code  = buf_doc-line.doc-code
     6005         .
     6006       get first partcopy-select-parts .
     6007       assign
     6008         v-total-rsrv-qnty = 0
     6009       .
     6010       do while available buf_parts
     6011       on error undo, return error
     6012       :
     6013         assign
     6014           v-parts-rsrv-qnty = buf_parts.qnty
     6015                     * ( if lookup(buf_trn-doc.doc-type, 'рас,спи':U ) > 0
     6016                         then -1
     6017                         else 1
     6018                       )
     6019         .
     6020         if p-rsrv-direction = true then do:
     6021           assign
     6022             buf_parts.status_   = no
     6023             buf_parts.rsrv-free =
     6024           ( (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     6025         or (buf_trn-doc.doc-type = 'инв':U and buf_parts.qnty < 0))
     6026           .
     6027         end.
     6028         else do:
     6029           assign
     6030             buf_parts.status_   = yes
     6031             buf_parts.rsrv-free = ?
     6032           .
     6033         end.
     6034         if p-rsrv-direction = true
     6035         then do:
     6036           assign
     6037             v-parts-rsrv-qnty = - v-parts-rsrv-qnty
     6038           .
     6039         end.
     6040         assign
     6041           v-total-rsrv-qnty = v-total-rsrv-qnty + v-parts-rsrv-qnty
     6042         .
     6043         run partcopy-rsrv-parts in this-procedure
     6044           (input rowid(buf_trn-doc)
     6045           ,input rowid(buf_parts)
     6046           ,input p-rsrv-direction
     6047           ,input v-goods-twounit
     6048           ,input v-is-hold
     6049           ) no-error .
     6050         if error-status :error then do:
     6051           message
     6052             vss-workfile vss-revision vss-description skip
     6053             "Ошибка при обработке партий" skip
     6054             "Документ" buf_doc-line.doc-code skip
     6055             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     6056             "Логический номер документа" buf_doc-line.fact-order skip
     6057             error-status :get-message(1) skip
     6058             return-value skip
     6059             view-as alert-box error .
     6060           undo, return error .
     6061         end.
     6062         if  v-need-rsrv = true
     6063         and v-place-rsrv = true
     6064         then do:
     6065           run trndocrs-pl-gds-accum in this-procedure
     6066             (input buf_parts.pl-code
     6067             ,input v-parts-rsrv-qnty
     6068             ,input 0.0
     6069             ,input 0.0
     6070             ,input 0.0
     6071             ) no-error .
     6072           if error-status :error then do:
     6073             message
     6074               vss-workfile vss-revision vss-description skip
     6075               "Ошибка при изменении зарезервированных количеств trndocrs-pl-code-accum" skip
     6076               "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     6077               "Документ" buf_doc-line.doc-code skip
     6078               "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     6079               error-status :get-message(1) skip
     6080               return-value skip
     6081               view-as alert-box error .
     6082             undo, return error .
     6083           end.
     6084         end.
     6085         get next partcopy-select-parts .
     6086       end.
     6087       if v-need-rsrv = true then do:
     6088         for each buf_gds-dtl
     6089           where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     6090             and buf_gds-dtl.artic     = buf_doc-line.artic
     6091             and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     6092             and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     6093         on error undo, return error return-value
     6094         :
     6095           case buf_trn-doc.doc-type :
     6096             when 'при':U or
     6097             when 'возврат':U then do:
     6098               assign
     6099                 v-gds-dtl-rsrv-qnty = buf_gds-dtl.doc-qnty
     6100               .
     6101             end.
     6102             when 'рас':U or
     6103             when 'спи':U then do:
     6104               assign
     6105                 v-gds-dtl-rsrv-qnty = - buf_gds-dtl.doc-qnty
     6106               .
     6107             end.
     6108             when 'инв':U then do:
     6109               assign
     6110                 v-gds-dtl-rsrv-qnty = 0
     6111               .
     6112             end.
     6113           end.
     6114           if p-rsrv-direction = true
     6115           then do:
     6116             assign
     6117               v-gds-dtl-rsrv-qnty = - v-gds-dtl-rsrv-qnty
     6118             .
     6119           end.
     6120           run trndocrs-gds-dtl-accum in this-procedure
     6121             (input buf_gds-dtl.prt-code
     6122             ,input v-gds-dtl-rsrv-qnty
     6123             ) no-error .
     6124           if error-status :error then do:
     6125             message
     6126               vss-workfile vss-revision vss-description skip
     6127               "Ошибка при изменении зарезервированных количеств trndocrs-gds-dtl-accum" skip
     6128               "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     6129               "Документ" buf_doc-line.doc-code skip
     6130               "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     6131               error-status :get-message(1) skip
     6132               return-value skip
     6133               view-as alert-box error .
     6134             undo, return error .
     6135           end.
     6136         end.
     6137         if v-place-rsrv = true then do:
     6138           for each buf_doc-pl no-lock
     6139             where buf_doc-pl.out-code = buf_doc-line.doc-code
     6140               and buf_doc-pl.gds-code = buf_goods.gds-code
     6141               and buf_doc-pl.obj-type = buf_doc-line.obj-type
     6142               and buf_doc-pl.obj-code = buf_doc-line.obj-code
     6143           on error undo, return error return-value
     6144           :
     6145             run trndocrs-pl-gds-accum in this-procedure
     6146               (input buf_doc-pl.pl-code
     6147               ,input 0.0
     6148               ,input buf_doc-pl.cli-doc-qnty
     6149                      * (if p-rsrv-direction = true then - 1.0 else 1.0)
     6150                      * (if lookup(buf_trn-doc.doc-type, 'рас,спи':U ) <> 0 then -1.0 else 1.0)
     6151               ,input 0.0
     6152               ,input 0.0
     6153               ) no-error .
     6154             if error-status :error then do:
     6155               message
     6156                 vss-workfile vss-revision vss-description skip
     6157                 "Ошибка при изменении зарезервированных количеств trndocrs-pl-code-accum" skip
     6158                 "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     6159                 "Документ" buf_doc-line.doc-code skip
     6160                 "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     6161                 error-status :get-message(1) skip
     6162                 return-value skip
     6163                 view-as alert-box error .
     6164               undo, return error .
     6165             end.
     6166           end.
     6167         end.
     6168         run trndocrs in this-procedure
     6169           (input buf_doc-line.doc-code
     6170           ,input buf_doc-line.obj-type
     6171           ,input buf_doc-line.obj-code
     6172           ,input buf_doc-line.artic
     6173           ,input buf_doc-line.prod-type
     6174           ,input buf_doc-line.prod-code
     6175           ,input v-total-rsrv-qnty
     6176           ) no-error .
     6177         if error-status :error then do:
     6178           message
     6179             vss-workfile vss-revision vss-description skip
     6180             "Ошибка при изменении зарезервированных количеств trndocrs" skip
     6181             "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     6182             "Документ" buf_doc-line.doc-code skip
     6183             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     6184             error-status :get-message(1) skip
     6185             return-value skip
     6186             view-as alert-box error .
     6187           undo, return error .
     6188         end.
     6189       end.
     6190   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
     6192     (input buf_doc-line.obj-type
     6193     ,input buf_doc-line.obj-code
     6194     ,input buf_doc-line.artic
     6195     ,input buf_doc-line.prod-type
     6196     ,input buf_doc-line.prod-code
     6197     ,input v-root-node
     6198     ,input ''
     6199     ) no-error .
     6200       if error-status :error then do:
     6201         message
     6202           vss-workfile vss-revision vss-description skip
     6203           "Ошибка при проверке целостности товара" skip
     6204           "ПОСЛЕ резервирования" skip
     6205           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     6206           "Документ" buf_doc-line.doc-code skip
     6207           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     6208           "Проверка целостности товара после резервирования" skip
     6209           error-status :get-message(1) skip
     6210           return-value skip
     6211           view-as alert-box .
     6212         undo, return error .
     6213       end.
     6214     end.
     6215   end.
