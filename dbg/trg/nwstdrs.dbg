        1   block-level on error undo, throw.
        2   using ibs.th.str.alcohol.*.
        3   define input  parameter p-doc-code       like ub.trn-doc.doc-code no-undo .
        4   define input  parameter p-rsrv-direction as logical   no-undo .
        5   define variable chg-qnty      as   decimal no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Резервирование и снятие резервов по документу".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2':u,p-doc-code,p-rsrv-direction)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define new global shared variable g#lib-trn  as handle no-undo .
       85   define new global shared variable g#lib-trn2 as handle no-undo .
       86   define new global shared variable g#lib-trn3 as handle no-undo .
       87   define new global shared variable g#lib-trn4 as handle no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
       90     field prt-code         like ub.gds-dtl.prt-code
       91     field rsrv-qnty        like ub.gds-dtl.fact-qnty
       92     field rsrv-out-qnty    like ub.gds-dtl.fact-qnty
       93     index xpk is primary unique prt-code
       94   .
       95   define temp-table temp-trndocrs-pl-gds-rsrv no-undo
       96     field pl-code          like ub.pl-gds.pl-code
       97     field rsrv-qnty        like ub.pl-gds.free-qnty
       98     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
       99     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
      100     field before-free-qnty like ub.pl-gds.fact-qnty
      101     field before-out-qnty  like ub.pl-gds.fact-qnty
      102     field after-free-qnty  like ub.pl-gds.fact-qnty
      103     field after-out-qnty   like ub.pl-gds.fact-qnty
      104     field fact-qnty        like ub.pl-gds.fact-qnty
      105     field cli-qnty         like ub.pl-gds.cli-qnty
      106     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
      107     index xpk is primary unique pl-code
      108   .
      109   procedure trndocrs-gds-dtl-clear :
      110     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      111     do
      112     on error undo, return error return-value
      113     :
      114       for each buf_temp-trndocrs-gds-dtl-rsrv
      115       on error undo, return error return-value
      116       :
      117         delete buf_temp-trndocrs-gds-dtl-rsrv .
      118       end.
      119     end.
      120   end procedure.
      121   procedure trndocrs-pl-gds-clear :
      122     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      123     do
      124     on error undo, return error return-value
      125     :
      126       for each buf_temp-trndocrs-pl-gds-rsrv
      127       on error undo, return error return-value
      128       :
      129         delete buf_temp-trndocrs-pl-gds-rsrv .
      130       end.
      131     end.
      132   end procedure.
      133   procedure trndocrs-clear :
      134     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      135     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      136     do
      137     on error undo, return error return-value
      138     :
      139       for each buf_temp-trndocrs-gds-dtl-rsrv
      140       on error undo, return error return-value
      141       :
      142         delete buf_temp-trndocrs-gds-dtl-rsrv .
      143       end.
      144       for each buf_temp-trndocrs-pl-gds-rsrv
      145       on error undo, return error return-value
      146       :
      147         delete buf_temp-trndocrs-pl-gds-rsrv .
      148       end.
      149     end.
      150   end procedure.
      151   procedure trndocrs-pl-gds-accum :
      152     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
      153     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
      154     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
      155     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
      156     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
      157     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      158     do
      159     on error undo, return error return-value
      160     :
      161       find first buf_temp-trndocrs-pl-gds-rsrv
      162         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      163         no-error .
      164       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      165         create buf_temp-trndocrs-pl-gds-rsrv .
      166         assign
      167           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      168         .
      169       end.
      170       assign
      171         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
      172         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
      173         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
      174         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
      175       .
      176     end.
      177   end procedure.
      178   procedure trndocrs-gds-dtl-accum :
      179     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
      180     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
      181     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
      182     do
      183     on error undo, return error return-value
      184     :
      185       find first buf_temp-trndocrs-gds-dtl-rsrv
      186         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      187         no-error .
      188       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
      189         create buf_temp-trndocrs-gds-dtl-rsrv .
      190         assign
      191           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      192         .
      193       end.
      194       assign
      195         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      196                                                + p-rsrv-qnty
      197       .
      198     end.
      199   end procedure.
      200   procedure trndocrs-pl-gds-request :
      201     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      202     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
      203     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
      204     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
      205     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
      206     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
      207     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
      208     define input parameter p-field-accum            as character no-undo .
      209     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
      210     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      211     do
      212     on error undo, return error return-value
      213     :
      214       if lookup(p-field-accum, "before,after":u ) = 0 then do:
      215         message
      216           vss-workfile vss-revision vss-description skip
      217           vss-include-info0 skip
      218           "Ошибка задания входных параметров параметров" skip
      219           "Неизвестное значение параметра" skip
      220           "p-field-accum" p-field-accum skip
      221           view-as alert-box error .
      222         undo, return error return-value .
      223       end.
      224       case p-field-accum :
      225         when "before":u then do:
      226           for each buf_temp-trndocrs-pl-gds-rsrv
      227           on error undo, return error return-value
      228           :
      229             assign
      230               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
      231               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
      232             .
      233           end.
      234         end.
      235         when "after":u then do:
      236           for each buf_temp-trndocrs-pl-gds-rsrv
      237           on error undo, return error return-value
      238           :
      239             assign
      240               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
      241               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
      242             .
      243           end.
      244         end.
      245         otherwise do:
      246           message
      247             vss-workfile vss-revision vss-description skip
      248             vss-include-info0 skip
      249             "Ошибка задания входных параметров параметров" skip
      250             "Неизвестное значение параметра" skip
      251             "p-field-accum" p-field-accum skip
      252             view-as alert-box error .
      253           undo, return error return-value .
      254         end.
      255       end.
      256       define buffer buf_parts for ub.parts.
      257       for each buf_parts no-lock
      258         where buf_parts.out-code  = p-doc-code
      259           and buf_parts.obj-type  = p-obj-type
      260           and buf_parts.obj-code  = p-obj-code
      261           and buf_parts.artic     = p-artic
      262           and buf_parts.prod-type = p-prod-type
      263           and buf_parts.prod-code = p-prod-code
      264       on error undo, return error return-value
      265       :
      266         find first buf_temp-trndocrs-pl-gds-rsrv
      267           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      268           no-error .
      269         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      270           create buf_temp-trndocrs-pl-gds-rsrv .
      271           assign
      272             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      273           .
      274         end.
      275         if can-do('при,рас,спи':U, p-doc-type)
      276         or (p-doc-type = 'инв':U
      277             and buf_parts.fact-qnty < 0)
      278         then do:
      279           case p-field-accum :
      280             when "before":u then do:
      281               assign
      282                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      283                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      284                   + abs(buf_parts.fact-qnty)
      285               .
      286             end.
      287             when "after":u then do:
      288               assign
      289                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      290                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      291                   + abs(buf_parts.fact-qnty)
      292               .
      293             end.
      294             otherwise do:
      295               message
      296                 vss-workfile vss-revision vss-description skip
      297                 vss-include-info0 skip
      298                 "Ошибка задания входных параметров параметров" skip
      299                 "Неизвестное значение параметра" skip
      300                 "p-field-accum" p-field-accum skip
      301                 view-as alert-box error .
      302               undo, return error return-value .
      303             end.
      304           end.
      305         end.
      306         else do:
      307           case p-field-accum :
      308             when "before":u then do:
      309               assign
      310                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      311                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      312                   + abs(buf_parts.fact-qnty)
      313               .
      314             end.
      315             when "after":u then do:
      316               assign
      317                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      318                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      319                   + abs(buf_parts.fact-qnty)
      320               .
      321             end.
      322             otherwise do:
      323               message
      324                 vss-workfile vss-revision vss-description skip
      325                 vss-include-info0 skip
      326                 "Ошибка задания входных параметров параметров" skip
      327                 "Неизвестное значение параметра" skip
      328                 "p-field-accum" p-field-accum skip
      329                 view-as alert-box error .
      330               undo, return error return-value .
      331             end.
      332           end.
      333         end.
      334       end.
      335     end.
      336   end procedure.
      337   procedure trndocrs-pl-gds-calc-rsrv :
      338     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
      339     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      340     do
      341     on error undo, return error return-value
      342     :
      343       for each buf_temp-trndocrs-pl-gds-rsrv
      344       on error undo, return error return-value
      345       :
      346         assign
      347           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      348             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      349             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      350           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
      351             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      352             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      353         .
      354       end.
      355     end.
      356   end procedure.
      357   procedure trndocrs-need-rsrv :
      358     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
      359     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
      360     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
      361     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
      362     define output parameter p-need-rsrv    as logical   no-undo .
      363     define buffer buf_goods   for ub.goods .
      364     do
      365     on error undo, return error return-value
      366     :
      367       find first buf_goods no-lock
      368         where buf_goods.artic     = p-artic
      369           and buf_goods.prod-type = p-prod-type
      370           and buf_goods.prod-code = p-prod-code
      371         .
      372       if buf_goods.gds-type = 'т':U
      373       and ( p-doc-type = 'рас':U
      374             or p-doc-type = 'спи':U
      375           )
      376       then do:
      377         assign
      378           p-need-rsrv = true
      379         .
      380       end.
      381       else do:
      382         assign
      383           p-need-rsrv = false
      384         .
      385       end.
      386     end.
      387   end procedure.
      388   procedure trndocrs-need-create-doc-pl :
      389     define input  parameter p-extended-doc-type  as character no-undo .
      390     define input  parameter p-news               as logical   no-undo .
      391     define input  parameter p-sale-auto          as logical   no-undo .
      392     define output parameter p-need-create-doc-pl as logical   no-undo .
      393     do
      394     on error undo, return error return-value
      395     :
      396       if  not p-news
      397       and p-extended-doc-type <> 'ie':U
      398       and p-extended-doc-type <> 'es':U
      399       and p-extended-doc-type <> 'rs':U
      400       and not p-sale-auto
      401       then do:
      402         assign
      403           p-need-create-doc-pl = true
      404         .
      405       end.
      406       else do:
      407         assign
      408           p-need-create-doc-pl = false
      409         .
      410       end.
      411     end.
      412   end procedure.
      413   procedure trndocrs-validate :
      414     define input parameter p-place-rsrv as logical no-undo .
      415     define input parameter p-chg-qnty   as decimal no-undo .
      416     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      417     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      418     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
      419     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
      420     assign
      421       v-total-gds-dtl-rsrv-qnty = 0
      422       v-total-pl-gds-rsrv-qnty  = 0
      423     .
      424     do
      425     on error undo, return error return-value
      426     :
      427       for each buf_temp-trndocrs-gds-dtl-rsrv
      428       on error undo, return error return-value
      429       :
      430         assign
      431           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
      432                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      433         .
      434       end.
      435       for each buf_temp-trndocrs-pl-gds-rsrv
      436       on error undo, return error return-value
      437       :
      438         assign
      439           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
      440                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      441         .
      442       end.
      443       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      444         message
      445           vss-workfile vss-revision vss-description skip
      446           vss-include-info0 skip
      447           "Ошибка при резервировании свободных количеств" skip
      448           "Запрошено резервирование:" skip
      449           "По товару" p-chg-qnty skip
      450           "По признакам" v-total-gds-dtl-rsrv-qnty skip
      451           "По складским местам" v-total-pl-gds-rsrv-qnty skip
      452           view-as alert-box error .
      453         undo, return error return-value .
      454       end.
      455       if p-place-rsrv then do:
      456         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      457           message
      458             vss-workfile vss-revision vss-description skip
      459             vss-include-info0 skip
      460             "Ошибка при резервировании свободных количеств" skip
      461             "Запрошено резервирование:" skip
      462             "По товару" p-chg-qnty skip
      463             "По признакам" v-total-gds-dtl-rsrv-qnty skip
      464             "По складским местам" v-total-pl-gds-rsrv-qnty skip
      465             view-as alert-box error .
      466           undo, return error return-value .
      467         end.
      468       end.
      469     end.
      470   end procedure.
      471   procedure trndocrs :
      472     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
      473     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
      474     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
      475     define input parameter p-artic      like ub.doc-line.artic     no-undo .
      476     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
      477     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
      478     define input parameter p-chg-qnty   as decimal no-undo .
      479     define buffer buf_db         for ub.db .
      480     define buffer buf_gds-obj    for ub.gds-obj .
      481     define buffer buf_prt-obj    for ub.prt-obj .
      482     define buffer buf_gds-prt    for ub.gds-prt .
      483     define buffer buf_goods      for ub.goods .
      484     define buffer buf_pl-gds     for ub.pl-gds .
      485     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      486     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      487     define variable v-node-code   like ub.gds-prt.node-code no-undo .
      488     define variable v-curr-db-num like ub.db.db-num         no-undo .
      489     define variable v-cmd         as   character            no-undo .
      490     do
      491     on error undo, return error return-value
      492     :
      493   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      495     (input  p-obj-type
      496     ,input  p-obj-code
      497     ,input  p-artic
      498     ,input  p-prod-type
      499     ,input  p-prod-code
      500     ,buffer buf_gds-obj
      501     ) no-error .
      502       if error-status :error then do:
      503         message
      504           vss-workfile vss-revision vss-description skip
      505           vss-include-info0 skip
      506           "Ошибка при поиске товара на объекте" skip
      507           "p-obj-type"  p-obj-type  skip
      508           "p-obj-code"  p-obj-code  skip
      509           "p-artic"     p-artic     skip
      510           "p-prod-type" p-prod-type skip
      511           "p-prod-code" p-prod-code skip
      512           error-status :get-message(1) skip
      513           return-value skip
      514           view-as alert-box error .
      515         undo, return error return-value .
      516       end.
      517       find current buf_gds-obj exclusive-lock .
      518       run trndocrs-validate in this-procedure
      519         (input buf_gds-obj.place-rsrv
      520         ,input p-chg-qnty
      521         ) no-error .
      522       if error-status :error then do:
      523         message
      524           vss-workfile vss-revision vss-description skip
      525           vss-include-info0 skip
      526           "Противоречивые данные для резервирования" skip
      527           error-status :get-message(1) skip
      528           return-value skip
      529           view-as alert-box error .
      530         undo, return error return-value .
      531       end.
      532       assign
      533         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
      534         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
      535       .
      536   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      537     (input ?
      538     ,input this-procedure:handle
      539     ,input ?
      540     ,input  'rest-update':U
      541     ,input ?
      542     ,input  buffer buf_gds-obj:handle
      543     ,input 'fact-qnty,free-qnty'
      544     ,input ''
      545     ) no-error .
      546   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      548     (output v-curr-db-num
      549     )  .
      550       find first buf_db no-lock
      551         where buf_db.db-num = v-curr-db-num
      552         .
      553       if buf_db.db-num <> 0
      554         and buf_db.on-line-rest = true
      555       then do:
      556         assign
      557           v-cmd = "command":U + chr(1)
      558                   + "create":U + chr(1)
      559                   + "on-line-rest":U + chr(1)
      560                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
      561                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
      562                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
      563                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
      564                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
      565                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
      566         .
      567         run nws/cr-route.p
      568           ( input 'send-cmd':U
      569             ,input v-cmd
      570             ,input ?
      571             ,input "0":U
      572           ).
      573       end.
      574       if buf_gds-obj.place-rsrv = true then do:
      575         for each buf_temp-trndocrs-pl-gds-rsrv
      576         on error undo, return error return-value
      577         :
      578           find first buf_goods no-lock
      579             where buf_goods.artic     = p-artic
      580               and buf_goods.prod-type = p-prod-type
      581               and buf_goods.prod-code = p-prod-code
      582             no-error .
      583           if not available buf_goods then do:
      584             message
      585               vss-workfile vss-revision vss-description skip
      586               vss-include-info0 skip
      587               "Не найдена товар" skip
      588               "Артикул" p-artic p-prod-type p-prod-code skip
      589               view-as alert-box error .
      590             undo, return error return-value .
      591           end.
      592           find first buf_pl-gds exclusive-lock
      593             where buf_pl-gds.obj-type = p-obj-type
      594               and buf_pl-gds.obj-code = p-obj-code
      595               and buf_pl-gds.gds-code = buf_goods.gds-code
      596               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
      597             no-error .
      598           if not available buf_pl-gds then do:
      599             message
      600               vss-workfile vss-revision vss-description skip
      601               vss-include-info0 skip
      602               "Не найдена привязка товара к складскому месту" skip
      603               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
      604               view-as alert-box error .
      605             undo, return error return-value .
      606           end.
      607           assign
      608             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      609             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
      610           .
      611           if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
      612             and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
      613           then do:
      614             assign
      615               buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
      616             .
      617           end.
      618         end.
      619       end.
      620       for each buf_temp-trndocrs-gds-dtl-rsrv
      621       on error undo, return error return-value
      622       :
      623   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
      624     (input  buf_temp-trndocrs-gds-dtl-rsrv.prt-code
      625     ,output v-node-code
      626     ) no-error .
      627         if error-status :error then do:
      628           message
      629             vss-workfile vss-revision vss-description skip
      630             vss-include-info0 skip
      631             "Ошибка при определении первого терминального признака" skip
      632             "prt-code" buf_temp-trndocrs-gds-dtl-rsrv.prt-code skip
      633             view-as alert-box error .
      634           undo, return error return-value .
      635         end.
      636         find first buf_gds-prt no-lock
      637           where buf_gds-prt.node-code = v-node-code
      638           .
      639         do while available buf_gds-prt
      640         on error undo, return error return-value
      641         :
      642   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      643   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
      644     (input  p-obj-type
      645     ,input  p-obj-code
      646     ,input  p-artic
      647     ,input  p-prod-type
      648     ,input  p-prod-code
      649     ,input  buf_gds-prt.node-code
      650     ,buffer buf_prt-obj
      651     )  .
      652           find current buf_prt-obj exclusive-lock .
      653           assign
      654             buf_prt-obj.free-qnty = buf_prt-obj.free-qnty - buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      655           .
      656           assign
      657             v-node-code = buf_gds-prt.upper-code
      658           .
      659           find first buf_gds-prt no-lock
      660             where buf_gds-prt.node-code = v-node-code
      661             no-error .
      662         end.
      663       end.
      664     end.
      665   end procedure.
      666   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   procedure partrqst :
      668     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
      669     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
      670     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
      671     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
      672     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
      673     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
      674     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
      675     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
      676     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
      677     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
      678     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
      679     define output parameter p-total-parts-price-base     as decimal                 no-undo .
      680     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
      681     define output parameter p-total-parts-transport-base as decimal                 no-undo .
      682     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
      683     define output parameter p-total-parts-other-base     as decimal                 no-undo .
      684     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
      685     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
      686     do
      687     on error undo, return error return-value
      688     :
      689       assign
      690         p-total-parts-qnty           = 0
      691         p-total-parts-fact-qnty      = 0
      692         p-total-parts-cli-qnty       = 0
      693         p-total-parts-fact-cli-qnty  = 0
      694         p-total-parts-price-cli      = 0
      695         p-total-parts-price-base     = 0
      696         p-total-parts-price-rubl     = 0
      697         p-total-parts-transport-base = 0
      698         p-total-parts-transport-rubl = 0
      699         p-total-parts-other-base     = 0
      700         p-total-parts-other-rubl     = 0
      701       .
      702       define buffer buf_parts for ub.parts .
      703       for each buf_parts no-lock
      704         where buf_parts.out-code  = p-doc-code
      705           and buf_parts.obj-type  = p-obj-type
      706           and buf_parts.obj-code  = p-obj-code
      707           and buf_parts.artic     = p-artic
      708           and buf_parts.prod-type = p-prod-type
      709           and buf_parts.prod-code = p-prod-code
      710       on error undo, return error return-value
      711       :
      712         define variable v-parts-fact-multiplier as decimal   no-undo .
      713         assign
      714           v-parts-fact-multiplier = 1
      715         .
      716         if buf_parts.qnty <> 0 then do:
      717           assign
      718             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      719           .
      720         end.
      721         assign
      722           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      723           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      724           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      725           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      726                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      727           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      728           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      729           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      730           p-total-parts-transport-base  = p-total-parts-transport-base
      731                                         + buf_parts.fact-qnty
      732                                           * (if   buf_parts.transport-base <> ?
      733                                             then buf_parts.transport-base
      734                                             else 0
      735                                             )
      736           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      737                                         + buf_parts.fact-qnty
      738                                           * (if   buf_parts.transport-rubl <> ?
      739                                             then buf_parts.transport-rubl
      740                                             else 0
      741                                             )
      742           p-total-parts-other-base      = p-total-parts-other-base
      743                                         + buf_parts.fact-qnty
      744                                           * (if   buf_parts.other-base <> ?
      745                                             then buf_parts.other-base
      746                                             else 0
      747                                             )
      748           p-total-parts-other-rubl      = p-total-parts-other-rubl
      749                                         + buf_parts.fact-qnty
      750                                           * (if   buf_parts.other-rubl <> ?
      751                                             then buf_parts.other-rubl
      752                                             else 0
      753                                             )
      754         .
      755       end.
      756     end.
      757   end procedure.
      758   function hvrdtax return logical (input parrecid as recid):
      759   define variable varresult as logical no-undo.
      760   run hvrdtax-proc (input parrecid, output varresult).
      761   return varresult.
      762   end function.
      763   procedure hvrdtax-proc:
      764   define input  parameter parrecid  as recid   no-undo.
      765   define output parameter parresult as logical no-undo.
      766   define buffer bf_goods for ub.goods.
      767   define buffer bf_units for ub.units.
      768   define buffer rt_tax   for ub.tax.
      769   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      770   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      771   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      772   if available rt_tax and
      773       can-find(first ub.tax-units No-LOCK WHERE
      774                      ub.tax-units.tax-code = rt_tax.tax-code AND
      775                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      776                                                       else assign parresult = no.
      777   end procedure.
      778   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779   procedure gen-key-rec :
      780     define input  parameter p-tbl-name    as character no-undo.
      781     define input  parameter p-bh_tbl-name as handle    no-undo.
      782     define output parameter p-key-rec     as character no-undo.
      783     do
      784     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      785     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      786     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      787     :
      788       define variable fh               as handle    no-undo .
      789       define variable v-ok             as logical   no-undo .
      790       define variable v-inform         as character no-undo .
      791       define variable v-ind            as integer   no-undo .
      792       define variable v-idx-field-qnty as integer   no-undo .
      793       if p-tbl-name = ?
      794         or p-tbl-name = "":U
      795       then do:
      796         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
      797       end.
      798       if not p-bh_tbl-name:available then do:
      799         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
      800       end.
      801       assign
      802         p-key-rec = p-tbl-name
      803         v-inform  = p-bh_tbl-name:index-information(1)
      804         v-ind     = 2
      805       .
      806       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      807       on error undo, return error
      808       :
      809         assign
      810           v-inform = p-bh_tbl-name:index-information( v-ind )
      811           v-ind    = v-ind + 1
      812         .
      813       end.
      814       if v-inform = ?
      815         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      816         or entry( 3, v-inform, ",":U ) <> "1":U
      817       then do:
      818         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
      819       end.
      820       else do:
      821         assign
      822           v-idx-field-qnty = num-entries( v-inform ) - 4
      823         .
      824         if v-idx-field-qnty < 2 then do:
      825           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
      826         end.
      827         do v-ind = 1 to v-idx-field-qnty by 2
      828         on error undo, return error
      829         :
      830           assign
      831             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      832             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      833           .
      834         end.
      835       end.
      836       if p-key-rec = ? then do:
      837         assign
      838           p-key-rec = "":U
      839         .
      840         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
      841       end.
      842     end.
      843     return.
      844   end procedure.
      845   procedure gen-where-keyr-tab :
      846     define input  parameter i-tableSerach as character no-undo.
      847     define input  parameter i-tablekey   as character  no-undo.
      848     define input  parameter p-key-rec    as character  no-undo.
      849     define input  parameter p-key-handle as handle     no-undo .
      850     define input  parameter p-db-name    as character  no-undo .
      851     define input  parameter p-tt-handle  as handle     no-undo .
      852     define output parameter o-Where      as character  no-undo.
      853     do
      854     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      855     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      856     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      857     :
      858       define variable v-full-tbl-name  as character no-undo .
      859       define variable bh_tbl-name      as handle    no-undo .
      860       define variable fh_key           as handle    no-undo .
      861       define variable fh_search        as handle    no-undo .
      862       define variable v-field-num      as integer   no-undo .
      863       define variable v-count-fld      as integer   no-undo .
      864       define variable v-inform         as character no-undo .
      865       define variable v-ind            as integer   no-undo .
      866       define variable v-idx-field-qnty as integer   no-undo .
      867       define variable v-field-name     as character no-undo .
      868       define variable v-field-val      as character no-undo .
      869       define variable v-word-link      as character no-undo .
      870       define variable vTable           as character no-undo.
      871       define variable bh_tbl-key       as handle    no-undo .
      872       assign
      873         p-key-rec = trim( p-key-rec )
      874       .
      875       if p-key-handle <> ? then do:
      876         if not valid-handle(p-key-handle)
      877            or p-key-handle:type <> "buffer"
      878         then do:
      879           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
      880         end.
      881         if num-entries( p-key-rec, chr(3) ) > 1
      882           or p-key-rec = ?
      883           or p-key-rec = "":U
      884         then do:
      885           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
      886         end.
      887       end.
      888       else do:
      889         if p-key-rec = ?
      890           or p-key-rec = "":U
      891         then do:
      892           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
      893         end.
      894       end.
      895       assign
      896         vTable = entry( 1 , p-key-rec, chr(3) )
      897       .
      898       if p-tt-handle <> ?
      899         and ( not valid-handle(p-tt-handle)
      900               or p-tt-handle:type <> "buffer"
      901             )
      902       then do:
      903         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
      904       end.
      905       if p-tt-handle = ? then do:
      906         assign
      907           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      908         .
      909         create buffer bh_tbl-name for table v-full-tbl-name .
      910       end.
      911       else do:
      912         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      913       end.
      914       assign
      915         v-inform = bh_tbl-name:index-information(1)
      916         v-ind    = 2
      917       .
      918       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      919       on error undo, return error
      920       :
      921         assign
      922           v-inform = bh_tbl-name:index-information( v-ind )
      923           v-ind    = v-ind + 1
      924         .
      925       end.
      926       if v-inform = ?
      927         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      928         or entry( 3, v-inform, ",":U ) <> "1":U
      929       then do:
      930         delete object bh_tbl-name no-error.
      931         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
      932       end.
      933       assign
      934         v-idx-field-qnty = num-entries( v-inform ) - 4
      935       .
      936       if v-idx-field-qnty < 2 then do:
      937         delete object bh_tbl-name no-error.
      938         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
      939       end.
      940       assign
      941         o-where     = "where":U
      942         v-word-link = "":U
      943         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      944         v-count-fld = 0
      945       .
      946       if i-tablekey ne "" and i-tablekey ne ?
      947       then do:
      948         assign
      949           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      950         .
      951         create buffer bh_tbl-key for table v-full-tbl-name .
      952       end.
      953       if i-tableSerach ne "" and i-tableSerach ne ?
      954       then do:
      955         delete object bh_tbl-name no-error.
      956         assign
      957           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      958         .
      959         create buffer bh_tbl-name for table v-full-tbl-name .
      960       end.
      961       block_where:
      962       do v-ind = 1 to v-idx-field-qnty by 2
      963       on error undo, return error
      964       :
      965         assign
      966           v-count-fld = v-count-fld + 1
      967         .
      968         if p-key-handle = ?
      969           and v-count-fld > v-field-num
      970         then do:
      971           leave block_where.
      972         end.
      973         define variable VfieldKeyTable as handle no-undo.
      974         assign
      975           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      976           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      977         .
      978         if     bh_tbl-key ne ?
      979         then do:
      980            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      981            if VfieldKeyTable eq ?
      982            then next block_where.
      983         end.
      984         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      985         then
      986            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      987         else
      988            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      989         if p-key-handle = ? then do:
      990           assign
      991             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      992           .
      993         end.
      994         else do:
      995           assign
      996             fh_key = p-key-handle:buffer-field( v-field-name )
      997           .
      998           if fh_key = ?
      999             or not valid-handle( fh_key )
     1000           then do:
     1001             delete object bh_tbl-name.
     1002             if     bh_tbl-key ne ?
     1003             then
     1004                delete object bh_tbl-key.
     1005             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
     1006           end.
     1007           assign
     1008             v-field-val = fh_key:buffer-value
     1009           .
     1010         end.
     1011         if fh_search:data-type ="character":U then do:
     1012           assign
     1013             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1014             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1015             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1016             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1017             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1018             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1019             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1020             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1021             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1022             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1023             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1024             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1025             v-field-val = substitute( '"&1"', v-field-val )
     1026           .
     1027         end.
     1028         assign
     1029           o-where = substitute( "&1 &2", o-where, v-field-val )
     1030         .
     1031         if v-word-link = "":U then do:
     1032           assign
     1033             v-word-link = "and":U
     1034           .
     1035         end.
     1036       end.
     1037       delete object bh_tbl-name.
     1038       if     bh_tbl-key ne ?
     1039       then
     1040          delete object bh_tbl-key.
     1041       if p-key-handle = ?
     1042         and v-count-fld <> v-field-num
     1043       then do:
     1044         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
     1045       end.
     1046     end.
     1047   end procedure.
     1048   procedure gen-hn-keyr-tab :
     1049     define input  parameter i-tableSerach as character no-undo.
     1050     define input  parameter i-tablekey   as character no-undo.
     1051     define input  parameter p-key-rec    as character no-undo.
     1052     define input  parameter p-key-handle as handle    no-undo .
     1053     define input  parameter p-db-name    as character no-undo .
     1054     define input  parameter p-tt-handle  as handle    no-undo .
     1055     define input  parameter p-stts-lock  as integer   no-undo .
     1056     define output parameter o-hn         as handle    no-undo.
     1057     define variable v-full-tbl-name as character no-undo.
     1058     define variable v-where         as character no-undo.
     1059     define variable bh_tbl-name     as handle    no-undo.
     1060     define variable vTable          as character no-undo.
     1061     do
     1062     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1063     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1064     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1065         run gen-where-keyr-tab(i-tableSerach,
     1066                                i-tablekey,
     1067                                p-key-rec,
     1068                                p-key-handle,
     1069                                p-db-name,
     1070                                p-tt-handle,
     1071                                output v-where).
     1072         if i-tableSerach ne "" and i-tableSerach ne ?
     1073         then do:
     1074            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1075            create buffer bh_tbl-name for table v-full-tbl-name .
     1076         end.
     1077         else do:
     1078            if p-tt-handle = ? then do:
     1079               assign
     1080                  vTable = entry( 1 , p-key-rec, chr(3) )
     1081               .
     1082               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1083               create buffer bh_tbl-name for table v-full-tbl-name .
     1084            end.
     1085            else do:
     1086               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1087            end.
     1088         end.
     1089         if p-tt-handle = ? then do:
     1090            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1091         end.
     1092         else do:
     1093            bh_tbl-name:find-first( v-where ) no-error .
     1094         end.
     1095         o-hn = bh_tbl-name.
     1096      end.
     1097   end procedure.
     1098   procedure gen-hn-keyr :
     1099     define input  parameter p-key-rec    as character no-undo.
     1100     define input  parameter p-key-handle as handle    no-undo .
     1101     define input  parameter p-db-name    as character no-undo .
     1102     define input  parameter p-tt-handle  as handle    no-undo .
     1103     define input  parameter p-stts-lock  as integer   no-undo .
     1104     define output parameter o-hn         as handle    no-undo.
     1105     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1106   end.
     1107   procedure gen-row-keyr :
     1108     define input  parameter p-key-rec    as character no-undo.
     1109     define input  parameter p-key-handle as handle    no-undo .
     1110     define input  parameter p-db-name    as character no-undo .
     1111     define input  parameter p-tt-handle  as handle    no-undo .
     1112     define input  parameter p-stts-lock  as integer   no-undo .
     1113     define output parameter p-tbl-row    as rowid     no-undo.
     1114     define output parameter p-tbl-name   as character no-undo.
     1115     define variable vHn as handle no-undo.
     1116       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1117       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1118       p-tbl-name =  vHn:table.
     1119       delete object vHn no-error.
     1120     if p-tbl-row = ? then do:
     1121       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1122     end.
     1123     else do:
     1124       return.
     1125     end.
     1126   end procedure.
     1127   procedure gen-key-fv :
     1128     define input  parameter p-key-rec    as character no-undo .
     1129     define output parameter p-field-list as character no-undo .
     1130     define output parameter p-value-list as character no-undo.
     1131     do
     1132     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1133     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1134     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1135     :
     1136       define variable v-full-tbl-name  as character no-undo .
     1137       define variable bh_tbl-name      as handle    no-undo .
     1138       define variable v-tbl-name       as character no-undo .
     1139       define variable v-field-num      as integer   no-undo .
     1140       define variable v-count-fld      as integer   no-undo .
     1141       define variable v-inform         as character no-undo .
     1142       define variable v-ind            as integer   no-undo .
     1143       define variable v-idx-field-qnty as integer   no-undo .
     1144       define variable v-delim-key      as character no-undo .
     1145       if p-key-rec = ?
     1146         or p-key-rec = "":U
     1147       then do:
     1148         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1149       end.
     1150       assign
     1151         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1152         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1153       .
     1154       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1155       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1156       assign
     1157         v-inform = bh_tbl-name:index-information(1)
     1158         v-ind    = 2
     1159       .
     1160       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1161       on error undo, return error
     1162       :
     1163         assign
     1164           v-inform = bh_tbl-name:index-information( v-ind )
     1165           v-ind    = v-ind + 1
     1166         .
     1167       end.
     1168       if v-inform = ?
     1169         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1170         or entry( 3, v-inform, ",":U ) <> "1":U
     1171       then do:
     1172         delete object bh_tbl-name no-error.
     1173         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1174       end.
     1175       assign
     1176         v-idx-field-qnty = num-entries( v-inform ) - 4
     1177       .
     1178       if v-idx-field-qnty < 2 then do:
     1179         delete object bh_tbl-name no-error.
     1180         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1181       end.
     1182       assign
     1183         p-field-list = "":U
     1184         p-value-list = "":U
     1185         v-delim-key  = "":U
     1186         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1187         v-count-fld  = 0
     1188       .
     1189       block_where:
     1190       do v-ind = 1 to v-idx-field-qnty by 2
     1191       on error undo, return error
     1192       :
     1193         assign
     1194           v-count-fld = v-count-fld + 1
     1195         .
     1196         if v-count-fld > v-field-num then do:
     1197           leave block_where.
     1198         end.
     1199         assign
     1200           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1201           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1202         .
     1203         if v-ind = 1 then do:
     1204           assign
     1205             v-delim-key = chr(3)
     1206           .
     1207         end.
     1208       end.
     1209       delete object bh_tbl-name.
     1210       if v-count-fld <> v-field-num then do:
     1211         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1212       end.
     1213     end.
     1214   end procedure.
     1215   procedure gen-key-field :
     1216     define input  parameter p-table      as character no-undo .
     1217     define output parameter p-field-list as character no-undo .
     1218     do
     1219     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1220     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1221     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1222     :
     1223       define variable v-full-tbl-name  as character no-undo .
     1224       define variable bh_tbl-name      as handle    no-undo .
     1225       define variable v-tbl-name       as character no-undo .
     1226       define variable v-field-num      as integer   no-undo .
     1227       define variable v-count-fld      as integer   no-undo .
     1228       define variable v-inform         as character no-undo .
     1229       define variable v-ind            as integer   no-undo .
     1230       define variable v-idx-field-qnty as integer   no-undo .
     1231       define variable v-delim-key      as character no-undo .
     1232       if p-table = ?
     1233         or p-table = "":U
     1234       then do:
     1235         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1236       end.
     1237       assign
     1238         v-tbl-name      = p-table
     1239         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1240       .
     1241       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1242       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1243       assign
     1244         v-inform = bh_tbl-name:index-information(1)
     1245         v-ind    = 2
     1246       .
     1247       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1248       on error undo, return error
     1249       :
     1250         assign
     1251           v-inform = bh_tbl-name:index-information( v-ind )
     1252           v-ind    = v-ind + 1
     1253         .
     1254       end.
     1255       if v-inform = ?
     1256         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1257         or entry( 3, v-inform, ",":U ) <> "1":U
     1258       then do:
     1259         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1260       end.
     1261       assign
     1262         v-idx-field-qnty = num-entries( v-inform ) - 4
     1263       .
     1264       if v-idx-field-qnty < 2 then do:
     1265         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1266       end.
     1267       assign
     1268         p-field-list = "":U
     1269         v-delim-key  = "":U
     1270         v-count-fld  = 0
     1271       .
     1272       block_where:
     1273       do v-ind = 1 to v-idx-field-qnty by 2
     1274       on error undo, return error
     1275       :
     1276         assign
     1277           v-count-fld = v-count-fld + 1
     1278         .
     1279         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1280         if v-ind = 1 then do:
     1281           assign
     1282             v-delim-key = chr(3)
     1283           .
     1284         end.
     1285       end.
     1286       delete object bh_tbl-name.
     1287     end.
     1288   end procedure.
     1289   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1290   define variable vss-include-info7 as character format "X(65)" no-undo
     1291   initial "@(#)$Workfile$ $Revision$".
     1292   procedure xmlchar-test :
     1293   define input parameter p-in-string          as character        no-undo.
     1294   define output parameter p-out-string-enc    as character        no-undo.
     1295   define output parameter p-out-string-dec    as character        no-undo.
     1296   do
     1297   on error undo, return error
     1298   :
     1299          run xmlchar-encode in this-procedure
     1300       (
     1301             input p-in-string
     1302           , output p-out-string-enc
     1303       ).
     1304          run xmlchar-decode in this-procedure
     1305       (
     1306             input p-out-string-enc
     1307           , output p-out-string-dec
     1308       ).
     1309   end.
     1310   end .
     1311   procedure xmlchar-encode :
     1312   define input parameter p-in-string      as character        no-undo.
     1313   define output parameter p-out-string    as character        no-undo.
     1314       define variable v-position      as integer      no-undo.
     1315       define variable v-current-char  as character    no-undo.
     1316   do
     1317   on error undo, return error
     1318   :
     1319       assign
     1320           p-out-string = "":U
     1321       .
     1322       case p-in-string
     1323       :
     1324           when ?
     1325           then do:
     1326               assign
     1327                   p-out-string = "?":U
     1328               .
     1329           end.
     1330           when "?":U
     1331           then do:
     1332               assign
     1333                   p-out-string = "&#63;":U
     1334               .
     1335           end.
     1336           otherwise do:
     1337               do v-position = 1 to length( p-in-string )
     1338               :
     1339                   assign
     1340                       v-current-char = substring( p-in-string, v-position, 1 )
     1341                   .
     1342                   case v-current-char
     1343                   :
     1344                       when "&":U
     1345                       then do:
     1346                           assign
     1347                               p-out-string = p-out-string + "&amp;":U
     1348                           .
     1349                       end.
     1350                       when ">":U
     1351                       then do:
     1352                           assign
     1353                               p-out-string = p-out-string + "&gt;":U
     1354                           .
     1355                       end.
     1356                       when "<":U
     1357                       then do:
     1358                           assign
     1359                               p-out-string = p-out-string + "&lt;":U
     1360                           .
     1361                       end.
     1362                       when "'":U
     1363                       then do:
     1364                           assign
     1365                               p-out-string = p-out-string + "&apos;":U
     1366                           .
     1367                       end.
     1368                       when '"':U
     1369                       then do:
     1370                           assign
     1371                               p-out-string = p-out-string + "&quot;":U
     1372                           .
     1373                       end.
     1374                       when chr(1)
     1375                       then do:
     1376                           assign
     1377                               p-out-string = p-out-string + "":U
     1378                           .
     1379                       end.
     1380                       when chr(2)
     1381                       then do:
     1382                           assign
     1383                               p-out-string = p-out-string + "":U
     1384                           .
     1385                       end.
     1386                       when chr(3)
     1387                       then do:
     1388                           assign
     1389                               p-out-string = p-out-string + "":U
     1390                           .
     1391                       end.
     1392                       when chr(4)
     1393                       then do:
     1394                           assign
     1395                               p-out-string = p-out-string + "":U
     1396                           .
     1397                       end.
     1398                       when chr(5)
     1399                       then do:
     1400                           assign
     1401                               p-out-string = p-out-string + "":U
     1402                           .
     1403                       end.
     1404                       when chr(6)
     1405                       then do:
     1406                           assign
     1407                               p-out-string = p-out-string + "":U
     1408                           .
     1409                       end.
     1410                       when chr(7)
     1411                       then do:
     1412                           assign
     1413                               p-out-string = p-out-string + "":U
     1414                           .
     1415                       end.
     1416                       when chr(8)
     1417                       then do:
     1418                           assign
     1419                               p-out-string = p-out-string + "":U
     1420                           .
     1421                       end.
     1422                       when chr(9)
     1423                       then do:
     1424                           assign
     1425                               p-out-string = p-out-string + "":U
     1426                           .
     1427                       end.
     1428                       when chr(29)
     1429                       then do:
     1430                           assign
     1431                               p-out-string = p-out-string + "":U
     1432                           .
     1433                       end.
     1434                       when chr(10)
     1435                       then do:
     1436                           assign
     1437                               p-out-string = p-out-string + "&#10;":U
     1438                           .
     1439                       end.
     1440                       when chr(13)
     1441                       then do:
     1442                           assign
     1443                               p-out-string = p-out-string + "&#13;":U
     1444                           .
     1445                       end.
     1446                       otherwise do:
     1447                           assign
     1448                               p-out-string = p-out-string + v-current-char
     1449                           .
     1450                       end.
     1451                   end case.
     1452               end.
     1453           end.
     1454       end case.
     1455   end.
     1456   end .
     1457   procedure xmlchar-encode-1c :
     1458   define input parameter p-in-string      as character        no-undo.
     1459   define output parameter p-out-string    as character        no-undo.
     1460       define variable v-position      as integer      no-undo.
     1461       define variable v-current-char  as character    no-undo.
     1462   do
     1463   on error undo, return error
     1464   :
     1465       assign
     1466           p-out-string = "":U
     1467       .
     1468       case p-in-string
     1469       :
     1470           when ?
     1471           then do:
     1472               assign
     1473                   p-out-string = "?":U
     1474               .
     1475           end.
     1476           otherwise do:
     1477               do v-position = 1 to length( p-in-string )
     1478               :
     1479                   assign
     1480                       v-current-char = substring( p-in-string, v-position, 1 )
     1481                   .
     1482                   case v-current-char
     1483                   :
     1484                       when chr(1)
     1485                       then do:
     1486                           assign
     1487                               p-out-string = p-out-string + " ":U
     1488                           .
     1489                       end.
     1490                       when chr(2)
     1491                       then do:
     1492                           assign
     1493                               p-out-string = p-out-string + " ":U
     1494                           .
     1495                       end.
     1496                       when chr(3)
     1497                       then do:
     1498                           assign
     1499                               p-out-string = p-out-string + " ":U
     1500                           .
     1501                       end.
     1502                       when chr(4)
     1503                       then do:
     1504                           assign
     1505                               p-out-string = p-out-string + " ":U
     1506                           .
     1507                       end.
     1508                       when chr(5)
     1509                       then do:
     1510                           assign
     1511                               p-out-string = p-out-string + " ":U
     1512                           .
     1513                       end.
     1514                       when chr(6)
     1515                       then do:
     1516                           assign
     1517                               p-out-string = p-out-string + " ":U
     1518                           .
     1519                       end.
     1520                       when chr(7)
     1521                       then do:
     1522                           assign
     1523                               p-out-string = p-out-string + " ":U
     1524                           .
     1525                       end.
     1526                       when chr(8)
     1527                       then do:
     1528                           assign
     1529                               p-out-string = p-out-string + " ":U
     1530                           .
     1531                       end.
     1532                       when chr(9)
     1533                       then do:
     1534                           assign
     1535                               p-out-string = p-out-string + " ":U
     1536                           .
     1537                       end.
     1538                       when chr(29)
     1539                       then do:
     1540                           assign
     1541                               p-out-string = p-out-string + " ":U
     1542                           .
     1543                       end.
     1544                       when chr(10)
     1545                       then do:
     1546                           assign
     1547                               p-out-string = p-out-string + " ":U
     1548                           .
     1549                       end.
     1550                       when chr(13)
     1551                       then do:
     1552                           assign
     1553                               p-out-string = p-out-string + " ":U
     1554                           .
     1555                       end.
     1556                       otherwise do:
     1557                           assign
     1558                               p-out-string = p-out-string + v-current-char
     1559                           .
     1560                       end.
     1561                   end case.
     1562               end.
     1563           end.
     1564       end case.
     1565   end.
     1566   end .
     1567   procedure xmlchar-decode :
     1568   define input parameter p-in-string      as character        no-undo.
     1569   define output parameter p-out-string    as character        no-undo.
     1570       define variable v-position      as integer      no-undo.
     1571       define variable v-last-position as integer      no-undo.
     1572       define variable v-temp-integer  as integer      no-undo.
     1573       define variable v-current-char  as character    no-undo.
     1574       define variable v-next-char     as character    no-undo.
     1575       define variable v-success       as logical      no-undo.
     1576   do
     1577   on error undo, return error
     1578   :
     1579       assign
     1580           p-out-string = "":U
     1581           v-position   = 0
     1582       .
     1583       replace-cycle:
     1584       do while yes
     1585       on error undo, return error
     1586       :
     1587           assign
     1588               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1589           .
     1590           if v-last-position <= v-position
     1591           then do:
     1592               if v-position = 0
     1593               then do:
     1594                   assign
     1595                       p-out-string = p-in-string
     1596                   .
     1597               end.
     1598               else do:
     1599                   assign
     1600                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1601                   .
     1602               end.
     1603               leave replace-cycle.
     1604           end.
     1605           else do:
     1606               assign
     1607                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1608                   v-position      = v-last-position
     1609                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1610               .
     1611               if v-current-char = "#":U
     1612               then do:
     1613                   assign
     1614                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1615                   .
     1616                   if v-last-position > 0
     1617                   then do:
     1618                       run xmlchar-read-integer in this-procedure
     1619                        (
     1620                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1621                           , output v-temp-integer
     1622                           , output v-success
     1623                       ).
     1624                       if v-success = yes
     1625                       and v-temp-integer >= 1
     1626                       and v-temp-integer <= 255
     1627                       then do:
     1628                           assign
     1629                               p-out-string = p-out-string + chr( v-temp-integer )
     1630                               v-position   = v-last-position + 1
     1631                           .
     1632                       end.
     1633                       else do:
     1634                           assign
     1635                               p-out-string = p-out-string + "&":U
     1636                               v-position   = v-position   + 1
     1637                           .
     1638                       end.
     1639                   end.
     1640                   else do:
     1641                       assign
     1642                           p-out-string = p-out-string + "&":U
     1643                           v-position   = v-position   + 1
     1644                       .
     1645                   end.
     1646               end.
     1647               else do:
     1648                   case substring( p-in-string, v-position + 1, 3 )
     1649                   :
     1650                       when "lt;":U
     1651                       then do:
     1652                           assign
     1653                               p-out-string = p-out-string + "<":U
     1654                               v-position   = v-position   + 3
     1655                           .
     1656                       end.
     1657                       when "gt;":U
     1658                       then do:
     1659                           assign
     1660                               p-out-string = p-out-string + ">":U
     1661                               v-position   = v-position   + 3
     1662                           .
     1663                       end.
     1664                       otherwise do:
     1665                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1666                           then do:
     1667                               assign
     1668                                   p-out-string = p-out-string + "&":U
     1669                                   v-position   = v-position   + 4
     1670                               .
     1671                           end.
     1672                           else do:
     1673                               case substring( p-in-string, v-position + 1, 5 )
     1674                               :
     1675                                   when "quot;":U
     1676                                   then do:
     1677                                       assign
     1678                                           p-out-string = p-out-string + '"':U
     1679                                           v-position   = v-position   + 5
     1680                                       .
     1681                                   end.
     1682                                   when "apos;":U
     1683                                   then do:
     1684                                       assign
     1685                                           p-out-string = p-out-string + "'":U
     1686                                           v-position   = v-position   + 5
     1687                                       .
     1688                                   end.
     1689                                   otherwise do:
     1690                                       assign
     1691                                           p-out-string = p-out-string + "&":U
     1692                                       .
     1693                                   end.
     1694                               end case.
     1695                           end.
     1696                       end.
     1697                   end case.
     1698               end.
     1699           end.
     1700       end.
     1701   end.
     1702   end .
     1703   procedure xmlchar-read-integer :
     1704   define input parameter p-input-string      as character        no-undo.
     1705   define output parameter p-output-integer   as integer          no-undo.
     1706   define output parameter p-success       as logical          no-undo.
     1707   do
     1708   on error undo, return error
     1709   :
     1710       assign
     1711           p-output-integer = integer( p-input-string )
     1712       no-error.
     1713       if error-status :error
     1714       then do:
     1715           assign
     1716               p-success           = no
     1717               p-output-integer    = 0
     1718           .
     1719       end.
     1720       else do:
     1721           assign
     1722               p-success           = yes
     1723           .
     1724       end.
     1725   end.
     1726   end.
     1727   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1728   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1729   define new global shared variable g#attr-lib  as handle no-undo .
     1730   define variable v-attr-lib-variable as handle no-undo .
     1731   define variable mMRCCode  as logical    no-undo.
     1732   define variable mTypeMark as character  no-undo.
     1733   function IS-NeedMark returns logical
     1734   ( input ib-code as integer  ,
     1735     input ib-str as character ):
     1736      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1737      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1738                                    and buf_prod-bc-attr.b-str  eq ib-str
     1739                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1740        no-lock no-error.
     1741      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1742   end.
     1743   function repTegforDm return char
     1744   (iDM as char ):
     1745       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1746       define variable vteg as character no-undo.
     1747       define variable oDM as character no-undo.
     1748       define variable vi as integer no-undo.
     1749       oDM = iDm.
     1750       do vi = 1 to num-entries(vTeglist):
     1751          vTeg = entry(vi,vTeglist).
     1752          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1753       end.
     1754       return oDM.
     1755   end.
     1756   function repSpecSimbforDm return char
     1757   (iDM as char ):
     1758       define variable oDM as character no-undo.
     1759     run
     1760       xmlchar-decode(iDM, output oDM).
     1761     return repTegforDm (oDM).
     1762   end.
     1763   function CheckGtin return logical
     1764   (iGtin as char):
     1765      define variable bar_code as character no-undo.
     1766      define variable vGtin as logical no-undo init "yes".
     1767      if length(iGtin) eq 14
     1768      then do:
     1769         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1770         run str/chk-sum.p
     1771          (input-output bar_code ) no-error .
     1772         if iGtin ne  bar_code
     1773         then
     1774            vGtin = no.
     1775      end.
     1776      else
     1777         vGtin = no.
     1778      return vgtin.
     1779   end.
     1780   function repSpecSimbforXlm return char
     1781   (iDM as char ):
     1782       iDM = replace(iDM,chr(29),"").
     1783       return iDM.
     1784   end.
     1785   function getGtinByDM return char
     1786   (IDM as char):
     1787      define variable VTXT as char no-undo.
     1788      define variable vGtin as char no-undo.
     1789      vTXt = IdM.
     1790      vGtin = IDM.
     1791      if    length(vtxt) > 14
     1792      then do:
     1793         if   vtxt begins "(01)"
     1794                or vtxt begins "(02)"
     1795         then
     1796            vGtin = substring(vtxt,5,14).
     1797         else if   (vtxt begins "01"
     1798                or vtxt begins "02" )
     1799                and (   (    substring(iDm,17,2) eq "21"
     1800                         and length(vtxt) >= 21)
     1801                     or substring(iDm,17,2) eq "37"
     1802                     or substring(iDm,17,4) eq "(37)" )
     1803         then do:
     1804            vGtin = substring(vtxt,3,14).
     1805            if not checkGtin(vGtin)
     1806            then
     1807               vGtin = substring(vtxt,1,14).
     1808         end.
     1809         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1810             or length(vtxt) eq 14 + 7 + 4
     1811             or length(vtxt) eq 14 + 7
     1812         then
     1813            vGtin = substring(vtxt,1,14).
     1814      end.
     1815      if not checkGtin(vGtin)
     1816      then
     1817         vGtin = "".
     1818      return vgtin.
     1819   end.
     1820   function getGdsCodeByGtin return int
     1821   (iGtin as char):
     1822      define buffer prod-bc  for ub.prod-bc.
     1823      define buffer bar-code for ub.bar-code.
     1824      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1825      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1826      return if avail bar-code then bar-code.gds-code else ?.
     1827   end.
     1828   function getQntyCodeByGtin return decimal
     1829   (iGtin as char):
     1830      define buffer prod-bc  for ub.prod-bc.
     1831      define buffer bar-code for ub.bar-code.
     1832      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1833      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1834      return if avail bar-code then bar-code.cli-base-rate else ?.
     1835   end.
     1836   function getGdsCodeByDM return int
     1837   (iDm as char):
     1838      define variable vGtin as char no-undo.
     1839      define buffer prod-bc for ub.prod-bc.
     1840      vGtin  = getGtinByDM (IDM ).
     1841      return getGdsCodeByGtin (vGtin).
     1842   end.
     1843   function ChekTypeMarkByGds return logical
     1844   (iGds-code as integer ):
     1845      define buffer goods-attr for ub.goods-attr.
     1846      find first goods-attr where goods-attr.gds-code   = iGds-code
     1847                              and goods-attr.attr-code  = 'mark-type':U
     1848      no-lock no-error.
     1849      if available goods-attr
     1850      then do:
     1851         mTypeMark = goods-attr.attr-value.
     1852         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1853           .
     1854      end.
     1855      else
     1856         return no.
     1857   end.
     1858   function ChekTypeMarkByDm return logical
     1859   (iDM as char ):
     1860      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1861   end.
     1862   function ChekTypeMarkByGtin return logical
     1863   (iGtin as char ):
     1864      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1865   end.
     1866   function GetNextElement return character
     1867     (input iAllTeg        as logical
     1868     ,output oteg          as character
     1869     ,output otegval       as character
     1870     ,input-output pstr    as character
     1871      ):
     1872        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1873        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1874        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1875        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1876        define variable vTeg as character no-undo.
     1877        define variable vLength as integer no-undo.
     1878        define variable vi as integer no-undo.
     1879        define variable vj as integer no-undo.
     1880        define buffer code for ub.code.
     1881        find first code where Code.parent eq "MarkType"
     1882                          and Code.CodeValue   eq mTypeMark
     1883                          no-lock no-error.
     1884        if     available code
     1885           and Code.misc1 ne ""
     1886           and Code.misc1 ne ?
     1887        then do:
     1888           integer (Code.misc1) no-error.
     1889           if not error-status:error
     1890           then
     1891             entry (4,vlistleng) = Code.misc1.
     1892        end.
     1893        if iAllTeg
     1894        then
     1895           assign
     1896              vlistElem     = vlistElem    + vlistElemDop
     1897              vlistleng     = vlistleng    + vlistlengDop
     1898           .
     1899        else if mMRCCode
     1900        then
     1901           assign
     1902              vlistElem     = vlistElem    + ",(8005),8005"
     1903              vlistleng     = vlistleng    + ",000006,0006"
     1904           .
     1905       block-elem:
     1906       do vi = 1 to num-entries(vlistElem):
     1907          vTeg = entry(vi,vlistElem).
     1908          if pstr begins vTeg
     1909          then do:
     1910             if    vTeg eq "21"
     1911             then
     1912                vLength = index(pstr,chr(29)) - 2 no-error.
     1913             if vLength  <= 0
     1914             then
     1915                vLength = int(entry(vi,vlistleng)).
     1916             otegval = substring (pstr,length(vteg) + 1, vLength).
     1917             oteg = replace(replace(vteg,")",""),"(","").
     1918             vTeg = vteg + otegval.
     1919             otegval = replace(otegval,chr(29),"").
     1920             oteg = replace(replace(oteg,")",""),"(","").
     1921             pstr = substring (pstr,length(vTeg)+ 1).
     1922             vTeg = replace(vTeg,chr(29),"").
     1923             leave block-elem.
     1924          end.
     1925          else
     1926             vTeg = "".
     1927       end.
     1928       return vteg.
     1929   end.
     1930   function GetCodeIdent return character
     1931   (iDm as char):
     1932      define variable Velement   as character no-undo init "first".
     1933      define variable oCodeIdent as character no-undo.
     1934      define variable vteg as character no-undo.
     1935      define variable vtegval as character no-undo.
     1936      define variable vGtin as character no-undo.
     1937      define buffer marking for ub.marking.
     1938      for first marking no-lock where
     1939                marking.mark eq iDm
     1940            and marking.unit-ext = "LEVEL2"
     1941      :
     1942        return iDm.
     1943      end.
     1944      vGtin  = getGtinByDM (iDm ).
     1945      ChekTypeMarkByDm(idm).
     1946      if iDm begins 'tech_':U
     1947      then
     1948         oCodeIdent = iDm.
     1949      else if length(iDm) < 21
     1950      then do:
     1951         find first marking where marking.mark eq idm
     1952         no-lock no-error.
     1953         oCodeIdent = if available marking then marking.mark else  ?.
     1954      end.
     1955      else if     length(iDm) eq 29
     1956         and not iDm begins "01"
     1957         and not iDm begins "02"
     1958      then
     1959         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1960      else  if     length(iDm) >= 24
     1961               and (  iDm begins "01"
     1962                   or iDm begins "02")
     1963               and  substring(iDm,17,2) ne "21"
     1964      then do:
     1965         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1966                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1967         then
     1968            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1969         else
     1970            oCodeIdent = iDM.
     1971      end.
     1972      else  if     (   length(iDm) eq 25
     1973                    or length(iDm) eq 21)
     1974               and (not iDm begins "01"
     1975               and  not iDm begins "02")
     1976      then
     1977         oCodeIdent = substring(iDm,1,21).
     1978      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1979      then
     1980         oCodeIdent = substring(iDm,1,21).
     1981      else do while Velement ne "" and idm ne "":
     1982         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1983         oCodeIdent = oCodeIdent + Velement.
     1984      end.
     1985      return oCodeIdent.
     1986   end.
     1987   function GetTegCod return character
     1988   (icodeIdent as char, iTeg as char):
     1989      define variable Velement   as character no-undo init "first".
     1990      define variable oTeg as character no-undo init ?.
     1991      define variable vteg as character no-undo.
     1992      define variable vtegval as character no-undo.
     1993      if     ((length(icodeIdent) eq 21
     1994         and not icodeIdent begins "01"
     1995         and not icodeIdent begins "02")
     1996         or
     1997             ( length(icodeIdent) eq 25
     1998               and not icodeIdent begins "01"
     1999               and not icodeIdent begins "02"))
     2000      then do:
     2001         if iTeg eq "01" or iTeg eq "02"
     2002         then
     2003            oTeg = substring(icodeIdent,1,21).
     2004         else  if  iTeg eq "21"
     2005         then
     2006            oTeg = substring(icodeIdent,15,7).
     2007      end.
     2008      else do:
     2009         ChekTypeMarkByDm(icodeIdent).
     2010         block-teg:
     2011            do while Velement ne "" and icodeIdent ne "":
     2012            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     2013            if    Velement begins iTeg
     2014               or Velement begins "(" + iTeg + ")"
     2015            then do:
     2016               oTeg = vtegval.
     2017               leave block-teg.
     2018            end.
     2019         end.
     2020      end.
     2021      return oTeg.
     2022   end.
     2023   function isOAD return logical
     2024   (icodeIdent as character):
     2025      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     2026   end.
     2027   function isMark return logical
     2028   (icodeIdent as character):
     2029      define buffer buf_marking for ub.marking.
     2030      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     2031             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     2032   end.
     2033   function addBracketForCode return character
     2034   (icodeIdent as char):
     2035      define variable Velement   as character no-undo init "first".
     2036      define variable oTeg as character no-undo.
     2037      define variable vteg as character no-undo.
     2038      define variable vtegval as character no-undo.
     2039      define buffer marking for ub.marking.
     2040      find first marking no-lock where
     2041                 marking.mark begins icodeIdent no-error.
     2042      if    not ChekTypeMarkByDm(icodeIdent)
     2043         or length(icodeIdent) le 24
     2044         or (avail marking and marking.unit-ext = "LEVEL2")
     2045      then
     2046         oTeg = icodeIdent.
     2047      else do:
     2048         if (  icodeIdent begins "01"
     2049            or icodeIdent begins "02"
     2050            ) and CheckGtin(substring (icodeIdent,3,14))
     2051            and substring (icodeIdent,17,2) eq "21"
     2052         then do:
     2053            mMRCCode = yes.
     2054            ChekTypeMarkByDm(icodeIdent).
     2055            block-teg:
     2056            do while Velement ne "" and icodeIdent ne "":
     2057               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     2058               if vteg ne ""
     2059               then
     2060                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     2061            end.
     2062            mMRCCode = no.
     2063         end.
     2064         else do:
     2065            oTeg = icodeIdent.
     2066         end.
     2067      end.
     2068      return oTeg.
     2069   end.
     2070   function getlevelByCodId return int
     2071   (iCode as char):
     2072      define variable vLength as int no-undo.
     2073      define variable vLevel  as int no-undo.
     2074      if not ChekTypeMarkByDM (icode) then return ?.
     2075      vLength = length(iCode).
     2076      if    vLength eq 18
     2077         or vLength eq 20
     2078      then
     2079         Vlevel = 4.
     2080      else if vLength eq 21
     2081      then
     2082         Vlevel = 1.
     2083      else if vLength eq 25
     2084      then do:
     2085         if  iCode begins "01"
     2086         then
     2087            Vlevel = 3.
     2088         else
     2089            Vlevel = 1.
     2090      end.
     2091      else if     vLength >= 26
     2092              and vLength <= 46
     2093      then do:
     2094         if    substring(iCode,17,2) eq "11"
     2095            or substring(iCode,17,2) eq "13"
     2096            or (    substring(iCode,17,2) eq "21"
     2097                and vLength >= 33
     2098                and substring(iCode,26,4) ne "8005")
     2099         then
     2100            Vlevel = 4.
     2101         else if    vLength eq 31
     2102                 or vLength eq 38
     2103                 or vLength eq 39
     2104                 or vLength eq 45
     2105         then
     2106            Vlevel = 1.
     2107         else if    vLength eq 35
     2108                 or vLength eq 43
     2109         then
     2110            Vlevel = 3.
     2111         else
     2112            Vlevel = ?.
     2113      end.
     2114      else
     2115         Vlevel = ?.
     2116      return Vlevel.
     2117   end.
     2118   function getLevelMotpBycodid return character
     2119   (iDm as char):
     2120      define variable vLevel as integer no-undo.
     2121      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2122      vLevel = getlevelByCodId(iDm).
     2123      if    vLevel eq ?
     2124         or vLevel < 1
     2125         or vLevel > 6
     2126      then
     2127         return ?.
     2128      else
     2129         return entry(vlevel,vList).
     2130   end.
     2131   function getLevelUTDByLevelMotp return character
     2132   (iUnit as char):
     2133      define variable vLevel as integer no-undo.
     2134      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     2135      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2136      vLevel = lookup(iUnit,vListMOTP).
     2137      if    vLevel eq ?
     2138         or vLevel < 1
     2139         or vLevel > 4
     2140      then
     2141         return ?.
     2142      else
     2143         return entry(vlevel,vListutd).
     2144   end.
     2145   function getLevelMotpByDM return character
     2146   (iDm as char):
     2147      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     2148   end.
     2149   function getLevelUTDByCodId return character
     2150   (iDm as char):
     2151      define variable vLevel as integer no-undo.
     2152      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     2153      vLevel = getlevelByCodId(iDm).
     2154      if    vLevel eq ?
     2155         or vLevel < 1
     2156         or vLevel > 4
     2157      then
     2158         return ?.
     2159      else
     2160         return entry(vlevel,vList).
     2161   end.
     2162   function getLevelUTDByDM return character
     2163   (iDm as char):
     2164      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     2165   end.
     2166   define variable mNotMarkQnty as logical no-undo.
     2167   function getQntyUTDByCodId return decimal
     2168   (iDM as char):
     2169      define variable vLevel as integer no-undo.
     2170      define variable vList as character no-undo init "1,5,10,500".
     2171      define variable vGtin as character no-undo.
     2172      define variable vqnty as decimal no-undo init ?.
     2173      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     2174      if vqnty eq ?
     2175      then do:
     2176         if not mNotMarkQnty
     2177         then do:
     2178            define buffer marking for ub.marking.
     2179            define variable vCodident as character no-undo.
     2180            vCodident = GetCodeIdent(idm).
     2181            find first marking where marking.mark begins vCodident no-lock no-error.
     2182            if     available marking
     2183               and marking.box-qnty ne ?
     2184            then
     2185               return marking.box-qnty.
     2186         end.
     2187         vGtin = getGtinByDm(iDM).
     2188         if ChekTypeMarkByGtin (vGtin)
     2189         then do:
     2190            vLevel = getlevelByCodId(iDM).
     2191            if     vLevel >= 1
     2192               and vLevel <= 4
     2193            then
     2194               vqnty = int(entry(vlevel,vList)).
     2195         end.
     2196         else
     2197            vqnty = getQntyCodeByGtin(vgtin).
     2198      end.
     2199      return vqnty.
     2200   end.
     2201   function getQntyUTDByDM return decimal
     2202   (iDm as char):
     2203      define variable vDM as character no-undo.
     2204      if     length (iDm) ne 25
     2205         and length (iDm) ne 29
     2206         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     2207      then
     2208         vDM = substring (iDm,1,length (iDm) - 6 ).
     2209      else
     2210         vDM = substring (iDm,1,length (iDm) - 4 ).
     2211      return getQntyUTDByCodId(vDM).
     2212   end.
     2213   function getMRC4 return decimal
     2214   (iMRC as char):
     2215      define variable oMrc     as decimal no-undo init ?.
     2216      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     2217      define variable vi       as integer no-undo.
     2218      define variable vfound   as integer no-undo.
     2219      define variable vposStart   as integer no-undo.
     2220      do:
     2221      OMRc = 0.
     2222      do vi = 1 to 4:
     2223         define variable vsimb as character no-undo.
     2224         vsimb = substring(iMRC,vi,1).
     2225         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     2226         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     2227         if vfound > 0
     2228         then
     2229            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     2230         end.
     2231         OMRc = OMRc / 100.
     2232      end.
     2233      return OMRc.
     2234   end.
     2235   function getMRCByDM return decimal
     2236   (iDm as char):
     2237      define variable vMRC     as character no-undo.
     2238      define variable oMrc     as decimal no-undo init ?.
     2239      define variable Velement as character no-undo init "empty".
     2240      define variable vteg as character no-undo.
     2241      define variable vtegval as character no-undo.
     2242      if    length(idm) eq 14 + 7 + 4 + 4
     2243         or length(idm) eq 14 + 7 + 4
     2244      then do:
     2245         vMRC = substring(idm,22,4).
     2246         omrc = getMRC4(vMRC).
     2247      end.
     2248      else do:
     2249          ChekTypeMarkByDm(iDm).
     2250          block-mrc:
     2251          do while Velement ne "" and idm ne "":
     2252             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     2253             if Velement begins "8005"
     2254             then do:
     2255                vMRC = substring(Velement,5,6).
     2256                leave block-mrc.
     2257             end.
     2258             else if Velement begins "(8005)"
     2259             then do:
     2260                vMRC = substring(Velement,7,6).
     2261                leave block-mrc.
     2262             end.
     2263          end.
     2264          if vMRC ne ""
     2265          then
     2266             OMRc = dec(vmrc) / 100 no-error.
     2267      end.
     2268      return OMRc.
     2269   end.
     2270   function MoveDate return Date
     2271   (idate as date,
     2272    iMonth as int64):
     2273      define variable vMonth   as int64 no-undo.
     2274      define variable vYear    as int64 no-undo.
     2275      define variable vDateNew as date  no-undo.
     2276       define variable vDay     as int64 no-undo.
     2277       vMonth = month(iDate) + iMonth.
     2278       vYear =  year(iDate).
     2279       if vMonth <= 0
     2280       then assign
     2281          vMonth = vMonth + 12
     2282           vYear  = vYear - 1
     2283       .
     2284       else if vMonth > 12
     2285       then assign
     2286          vMonth = vMonth - 12
     2287           vYear  = vYear + 1
     2288       .
     2289       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2290       do while error-status:error eq yes:
     2291          VDay = vDay + 1.
     2292          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2293       end.
     2294       if VDay > 0
     2295       then
     2296          vDateNew + 1.
     2297       return vDateNew.
     2298   end.
     2299   procedure checkEMRC:
     2300   define input  parameter iDm as character no-undo.
     2301   define output parameter vok as logical   no-undo init yes.
     2302      define variable v-value-emrc as character no-undo.
     2303      define variable v-type-emrc  as character no-undo.
     2304      define variable vDateIso     as character no-undo.
     2305      define variable vMRC         as decimal no-undo.
     2306      define variable vqnty        as decimal no-undo.
     2307      define variable vPrice       as decimal no-undo.
     2308      define variable vparent      as character no-undo.
     2309      define variable vgds-code    as integer no-undo.
     2310      define buffer code for ub.code.
     2311      vMRC = getMRCByDM(iDm).
     2312      if vMRC > 0
     2313      then do:
     2314         vgds-code = getGdsCodeByDM(iDm).
     2315         vqnty     = getQntyUTDByDM(iDm).
     2316               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2317            (
     2318             input   vgds-code
     2319            ,input   'emrc-type':U
     2320            ,output   v-value-emrc
     2321            ,output   v-type-emrc
     2322          ) no-error.
     2323          if     v-value-emrc ne ""
     2324             and v-value-emrc ne ?
     2325          then do:
     2326             vDateIso = iso-date(today).
     2327             vPrice = vMRC / vqnty.
     2328             vparent ="emc" + chr(4) + v-value-emrc.
     2329             find last code where Code.parent      eq vparent
     2330                              and Code.code        le vDateIso
     2331                              and code.status_  eq 0
     2332             no-lock no-error.
     2333             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2334             then
     2335                vOk = true .
     2336             else do:
     2337                 define variable vText      as character no-undo.
     2338                 define variable vDate      as date no-undo.
     2339                 define variable vDateLast  as character no-undo.
     2340                 define variable vDateFirst as character no-undo.
     2341                 define variable vDate3     as date no-undo.
     2342                 vdate = date(code.misc1).
     2343                 vDateLast = code.misc1.
     2344                 vDate3 = MoveDate(today, - 3 ).
     2345                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2346                                      string(vDate3  , "99/99/9999"),
     2347                                      string(vDate   , "99/99/9999")
     2348                                      ).
     2349                 vdateIso = iso-date(vdate3).
     2350                 find last code  where Code.parent      eq vparent
     2351                                   and Code.code        le vDateIso
     2352                                   and code.status_  eq 0 no-lock no-error.
     2353                 if available code
     2354                 then
     2355                    vDateIso = code.code.
     2356                 vDateFirst = vDateIso.
     2357                 vDateLast = iso-date(vdate).
     2358                 define variable vGood as logical no-undo.
     2359                 define variable vDateSale as date no-undo.
     2360                 define buffer bcode for code.
     2361                 for last code where Code.parent   eq vparent
     2362                                 and code.status_  eq 0
     2363                                 and code.code     < vDateLast
     2364                                 and code.code     >= vDateFirst
     2365                 no-lock:
     2366                    find first bcode where bCode.parent   eq vparent
     2367                                       and bcode.status_  eq 0
     2368                                       and bcode.code     > code.code no-lock no-error.
     2369                    if available bcode
     2370                    then do:
     2371                       if vPrice < dec(Code.CodeValue)
     2372                       then
     2373                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2374                                                     chr(10),
     2375                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2376                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2377                                                     ).
     2378                       else do:
     2379                          vGood = yes.
     2380                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2381                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2382                                                     chr(10),
     2383                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2384                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2385                                                     string(         vDateSale            ,"99/99/9999"),
     2386                                                     string(vDateSale - today)
     2387                                                     ).
     2388                       end.
     2389                    end.
     2390                 end.
     2391                 if vgood
     2392                 then do:
     2393                    define variable choice as integer no-undo .
     2394                    run gbl/d-askw.w (input "Уточнение"
     2395                           ,input  vText
     2396                           ,input "|"
     2397                           ,input "Принять|Вернуть"
     2398                           ,input "Принять данный товар|Вернуть товар постащику"
     2399                           ,input 1
     2400                           ,input 2
     2401                           ,output choice) no-error.
     2402                    vok = choice eq 1.
     2403                 end.
     2404                 else
     2405                    vok =false.
     2406             end.
     2407          end.
     2408      end.
     2409   end.
     2410   function addGs2Mark return character
     2411   (iMark as char):
     2412      define variable vDM   as character no-undo.
     2413      define variable vIdx  as integer   no-undo.
     2414      if index(iMark,chr(29),1) > 0
     2415      then return iMark.
     2416      if substring(iMark,26,4) = "8005" then
     2417      do:
     2418        vIdx = index(iMark,"93",26 + 4 + 5).
     2419        if vIdx > 1 then do:
     2420          vDM = substitute("&1&4&2&4&3",
     2421                           substring(iMark,1,25),
     2422                           substring(iMark,26,vIdx - 25 - 1),
     2423                           substring(iMark,vIdx),
     2424                           chr(29)) no-error.
     2425          vIdx = index(vDm,"240",vIdx + 4).
     2426          if vIdx > 0 then
     2427          do:
     2428            vDM = substitute("&1&3&2",
     2429                             substring(vDm,1,vIdx - 1),
     2430                             substring(vDm,vIdx),
     2431                             chr(29)) no-error.
     2432          end.
     2433        end.
     2434        else
     2435          vDM = substitute("&1&3&2",
     2436                           substring(iMark,1,25),
     2437                           substring(iMark,26),
     2438                           chr(29)) no-error.
     2439      end.
     2440      else if substring(iMark,32,2) = "91" then
     2441      do:
     2442        vIdx = index(iMark,"92",32).
     2443        if vIdx > 1 then
     2444          vDM = substitute("&1&4&2&4&3",
     2445                           substring(iMark,1,31),
     2446                           substring(iMark,32,vIdx - 31 - 1),
     2447                           substring(iMark,vIdx),
     2448                           chr(29)) no-error.
     2449        else
     2450          vDM = substitute("&1&3&2",
     2451                           substring(iMark,1,31),
     2452                           substring(iMark,32),
     2453                           chr(29)) no-error.
     2454      end.
     2455      else if substring(iMark,39,2) = "91" then
     2456      do:
     2457        vIdx = index(iMark,"92",38).
     2458        if vIdx > 1 then
     2459          vDM = substitute("&1&4&2&4&3",
     2460                           substring(iMark,1,38),
     2461                           substring(iMark,39,vIdx - 38 - 1),
     2462                           substring(iMark,vIdx),
     2463                           chr(29)) no-error.
     2464        else
     2465          vDM = substitute("&1&3&2",
     2466                           substring(iMark,1,38),
     2467                           substring(iMark,39),
     2468                           chr(29)) no-error.
     2469      end.
     2470      else if substring(iMark,25,2) = "93" then
     2471      do:
     2472        vIdx = index(iMark,"92",25).
     2473        if vIdx > 1 then
     2474          vDM = substitute("&1&4&2&4&3",
     2475                           substring(iMark,1,24),
     2476                           substring(iMark,25,vIdx - 24 - 1),
     2477                           substring(iMark,vIdx),
     2478                           chr(29)) no-error.
     2479        else
     2480          vIdx = index(iMark,"3103",25).
     2481          if vIdx > 0 then
     2482          vDM = substitute("&1&4&2&4&3",
     2483                           substring(iMark,1,24),
     2484                           substring(iMark,25,vIdx - 24 - 1),
     2485                           substring(iMark,vIdx),
     2486                           chr(29)) no-error.
     2487          else
     2488            vDM = substitute("&1&3&2",
     2489                             substring(iMark,1,24),
     2490                             substring(iMark,25),
     2491                             chr(29)) no-error.
     2492      end.
     2493      else if substring(iMark,32,2) = "93" then
     2494      do:
     2495        vDM = substitute("&1&3&2",
     2496              substring(iMark,1,31),
     2497              substring(iMark,32),
     2498              chr(29)) no-error.
     2499      end.
     2500      return if vDM <> "" then vDm else iMark.
     2501   end.
     2502   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2503   procedure partcopy :
     2504     define input parameter  p-free-output-copy as logical   no-undo .
     2505     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     2506     define parameter buffer buf_orig_parts     for ub.parts .
     2507     define parameter buffer buf_parts          for ub.parts .
     2508     define input parameter  p-mark             as character no-undo .
     2509     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     2510     define variable v-value-character as character no-undo .
     2511     define variable v-value-date      as date no-undo .
     2512     define variable v-value-decimal   as decimal no-undo .
     2513     define variable v-value-integer   as integer no-undo .
     2514     define variable v-izlcstpr        as logical no-undo .
     2515     define variable v-tth             as handle no-undo .
     2516     define variable v-type            as character no-undo .
     2517     define variable part-key-rec      as character no-undo .
     2518     define variable orig-part-key-rec as character no-undo .
     2519     define variable del-part-key-rec  as character no-undo .
     2520     define variable objMarks as class excisemarks  no-undo .
     2521     define variable v-parent-mark-sts as integer   no-undo .
     2522     define variable v-mark-sts-list   as character no-undo .
     2523     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     2524     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     2525     define buffer buf_gen-attr for ub.gen-attr .
     2526     define buffer buf1_gen-attr for ub.gen-attr .
     2527     define buffer buf_doc-line  for ub.doc-line .
     2528     define buffer buf_marking for ub.marking .
     2529     define buffer buf_marking-childs for ub.marking .
     2530     define buffer orig_marking-lines for ub.marking-lines .
     2531     define buffer orig_marking-lines-childs for ub.marking-lines .
     2532     define buffer buf_marking-lines for ub.marking-lines .
     2533     define buffer buf_marking-lines-childs for ub.marking-lines .
     2534     define buffer buf_marking-pack for ub.marking .
     2535     define buffer buf_marking-chk for ub.marking-chk .
     2536     define buffer buf_goods for ub.goods .
     2537     define buffer buf_trn-doc for ub.trn-doc .
     2538     define buffer pri_trn-doc for ub.trn-doc .
     2539     define buffer buf_chk-doc for ub.chk-doc .
     2540     do
     2541     on error undo, return error return-value
     2542     :
     2543       if p-free-output-copy = true
     2544       then do:
     2545         if  p-out-code <> 'free-zone':U
     2546         and p-out-code <> 'out-zone':U
     2547         then do:
     2548           message
     2549             vss-workfile vss-revision vss-description skip
     2550             vss-include-info8 skip
     2551             "Ошибка задания входных параметров процедуры partcopy" skip
     2552             "p-free-output-copy" p-free-output-copy skip
     2553             "p-out-code" p-out-code skip
     2554             view-as alert-box error .
     2555           undo, return error .
     2556         end.
     2557       end.
     2558       if buf_orig_parts.out-code <> p-out-code
     2559       then do:
     2560         find first buf_parts exclusive-lock
     2561           where buf_parts.obj-type  = buf_orig_parts.obj-type
     2562             and buf_parts.obj-code  = buf_orig_parts.obj-code
     2563             and buf_parts.artic     = buf_orig_parts.artic
     2564             and buf_parts.prod-type = buf_orig_parts.prod-type
     2565             and buf_parts.prod-code = buf_orig_parts.prod-code
     2566             and buf_parts.in-code   = buf_orig_parts.in-code
     2567             and buf_parts.out-code  = p-out-code
     2568             and buf_parts.part-code = buf_orig_parts.part-code
     2569           no-error.
     2570         if not available buf_parts
     2571         then do:
     2572           define variable v-rsrv-free as logical   no-undo .
     2573           if p-out-code = 'free-zone':U
     2574           or p-out-code = 'out-zone':U
     2575           then do:
     2576             assign
     2577               v-rsrv-free =
     2578          (if p-out-code = 'free-zone':U then yes else no)
     2579             .
     2580           end.
     2581           else do:
     2582             assign
     2583               v-rsrv-free = ?
     2584             .
     2585           end.
     2586           create buf_parts .
     2587           buffer-copy buf_orig_parts to buf_parts
     2588           assign
     2589             buf_parts.out-code  = p-out-code
     2590             buf_parts.status_   = no
     2591             buf_parts.rsrv-free = v-rsrv-free
     2592             buf_parts.qnty      = 0
     2593             buf_parts.fact-qnty = 0
     2594             buf_parts.real-qnty = 0
     2595             buf_parts.cli-qnty  = 0
     2596           .
     2597           validate buf_parts .
     2598         end.
     2599         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2600                                           ,input (buffer buf_orig_parts:handle)
     2601                                           ,output orig-part-key-rec).
     2602         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2603                                           ,input (buffer buf_parts:handle)
     2604                                           ,output part-key-rec).
     2605         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     2606               and ub.gen-attr.p-key =  orig-part-key-rec:
     2607             if not valid-object (objMarks)
     2608               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     2609               if p-out-code = 'free-zone':U
     2610               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     2611                then
     2612               do:
     2613                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     2614                   if objMarks:StatusErr
     2615                       then
     2616                   do:
     2617                       message objMarks:ReturnMsg view-as alert-box error.
     2618                       delete object objMarks no-error.
     2619                       undo, return error.
     2620                   end.
     2621               end.
     2622             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     2623             do:
     2624                 if p-mark <> "" then do:
     2625                 if p-out-code = 'free-zone':U then do:
     2626                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     2627                 end.
     2628                 else do:
     2629                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     2630                 end.
     2631                 if objMarks:StatusErr
     2632                   then
     2633                 do:
     2634                   message objMarks:ReturnMsg view-as alert-box error.
     2635                   delete object objMarks no-error.
     2636                   undo, return error.
     2637                 end.
     2638               end.
     2639             end.
     2640             if p-out-code = 'out-zone':U then
     2641             do:
     2642                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     2643                 if objMarks:StatusErr
     2644                     then
     2645                 do:
     2646                     message objMarks:ReturnMsg view-as alert-box error.
     2647                     delete object objMarks no-error.
     2648                     undo, return error.
     2649                 end.
     2650             end.
     2651         end.
     2652         delete object objMarks no-error.
     2653         if p-mark = "news" then return .
     2654         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     2655         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     2656         if not available buf_trn-doc
     2657         then
     2658            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     2659         if (
     2660             p-out-code = 'free-zone':U
     2661             and buf_orig_parts.in-code = buf_orig_parts.out-code
     2662            )
     2663         or
     2664            (
     2665             p-out-code = 'free-zone':U
     2666             and available pri_trn-doc
     2667             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     2668            )
     2669         or
     2670            (
     2671             available buf_trn-doc
     2672             and p-out-code = buf_trn-doc.doc-code
     2673             and buf_trn-doc.ext-doc-type = 'vt':U
     2674            )
     2675         or
     2676            (
     2677             p-mark = ""
     2678             and available buf_trn-doc
     2679             and p-out-code = 'free-zone':U
     2680             and buf_trn-doc.ext-doc-type = 'vt':U
     2681            )
     2682         or
     2683            (
     2684             p-mark = ""
     2685             and available buf_trn-doc
     2686             and p-out-code = 'free-zone':U
     2687             and buf_trn-doc.ext-doc-type = 'rs':U
     2688            )
     2689         then do :
     2690           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     2691             and ub.goods.prod-type = buf_parts.prod-type
     2692             and ub.goods.prod-code = buf_parts.prod-code.
     2693           def buffer buf_orig_ml for ub.marking-lines.
     2694           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
     2695             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     2696             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     2697             and buf_orig_ml.in-code = buf_orig_parts.in-code
     2698             and buf_orig_ml.out-code = buf_orig_parts.out-code
     2699             and buf_orig_ml.part-code = buf_orig_parts.part-code
     2700             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     2701             if available pri_trn-doc
     2702             and pri_trn-doc.ext-doc-type = 'iv':U
     2703             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     2704             then do :
     2705               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     2706                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     2707               end .
     2708               next .
     2709             end .
     2710             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     2711                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     2712                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     2713                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     2714                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     2715                                                   and ub.marking-lines.out-code = p-out-code
     2716                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     2717                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     2718                                                   no-error .
     2719             if not available ub.marking-lines
     2720             then do :
     2721               create ub.marking-lines.
     2722               buffer-copy buf_orig_ml to ub.marking-lines
     2723               assign
     2724                 ub.marking-lines.out-code  = p-out-code
     2725                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     2726               .
     2727               validate ub.marking-lines.
     2728             end .
     2729             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     2730             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     2731               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     2732               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     2733                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     2734                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     2735                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     2736                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     2737               then do:
     2738                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2739                 validate buf_marking.
     2740               end.
     2741             end .
     2742           end .
     2743           end.
     2744         end .
     2745         define variable v-doc-type  as character no-undo .
     2746         define variable   v-status    as character no-undo .
     2747         define variable v-fact-qnty   as  decimal no-undo .
     2748         define variable ii    as integer no-undo .
     2749         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     2750                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     2751                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     2752                                        .
     2753         if available pri_trn-doc
     2754         and pri_trn-doc.ext-doc-type = 'rs':U
     2755         then do :
     2756           if p-mark <> ""
     2757           then do :
     2758           end .
     2759           else do :
     2760           end .
     2761         end .
     2762         else do :
     2763           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     2764           and p-mark <> ""
     2765           then do :
     2766             if p-out-code = 'free-zone':U
     2767             then do:
     2768                 if chg-qnty < 0
     2769                 then do :
     2770                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     2771                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     2772                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2773                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2774                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2775                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2776                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2777                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2778                                                           no-error .
     2779                   if available orig_marking-lines
     2780                   then do :
     2781                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     2782                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     2783                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     2784                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     2785                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     2786                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     2787                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     2788                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     2789                                                            no-error .
     2790                     if not available buf_marking-lines
     2791                     then do :
     2792                       create buf_marking-lines .
     2793                       assign
     2794                         buf_marking-lines.mark       = p-mark
     2795                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2796                         buf_marking-lines.gds-code   = buf_goods.gds-code
     2797                         buf_marking-lines.obj-type   = buf_parts.obj-type
     2798                         buf_marking-lines.obj-code   = buf_parts.obj-code
     2799                         buf_marking-lines.in-code    = buf_parts.in-code
     2800                         buf_marking-lines.out-code   = buf_parts.out-code
     2801                         buf_marking-lines.part-code  = buf_parts.part-code
     2802                         buf_marking-lines.prt-code   = buf_parts.prt-code
     2803                       .
     2804                       validate buf_marking-lines.
     2805                     end .
     2806                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     2807                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2808                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     2809                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     2810                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     2811                                                         :
     2812                           assign buf_marking-chk.sts = 0 .
     2813                           validate buf_marking-chk.
     2814                         end .
     2815                       end .
     2816                       if buf_marking.unit-ext <> "UNIT" or
     2817                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     2818                       then do :
     2819                         run addChildMarkingLines in this-procedure (
     2820                           buf_marking.mark,
     2821                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     2822                           buffer buf_marking-lines,
     2823                           buffer buf_parts,
     2824                           buffer orig_marking-lines,
     2825                           buffer buf_orig_parts,
     2826                           buffer buf_goods
     2827                         ).
     2828                       end .
     2829                     end.
     2830                     find current orig_marking-lines exclusive-lock .
     2831                     delete orig_marking-lines .
     2832                   end .
     2833                 end .
     2834             end.
     2835             else do:
     2836               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     2837                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     2838                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2839                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2840                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2841                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2842                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2843                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2844                                                              no-error .
     2845                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     2846                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     2847                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     2848                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     2849                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     2850                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     2851                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     2852                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     2853                                                         no-error .
     2854                 if not available buf_marking-lines
     2855                 then do :
     2856                   create buf_marking-lines .
     2857                   assign
     2858                     buf_marking-lines.mark       = p-mark
     2859                     buf_marking-lines.doc-level  = 1
     2860                     buf_marking-lines.gds-code   = buf_goods.gds-code
     2861                     buf_marking-lines.obj-type   = buf_parts.obj-type
     2862                     buf_marking-lines.obj-code   = buf_parts.obj-code
     2863                     buf_marking-lines.in-code    = buf_parts.in-code
     2864                     buf_marking-lines.out-code   = buf_parts.out-code
     2865                     buf_marking-lines.part-code  = buf_parts.part-code
     2866                     buf_marking-lines.prt-code   = buf_parts.prt-code
     2867                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     2868                   .
     2869                   validate buf_marking-lines.
     2870                 end .
     2871                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     2872                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     2873                   validate buf_marking.
     2874                   for first buf_marking-childs exclusive-lock where
     2875                             buf_marking-childs.mark = buf_marking.mark-parent:
     2876                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     2877                     validate buf_marking-childs.
     2878                   end.
     2879                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     2880                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     2881                                                     and buf_chk-doc.out-code = buf_parts.out-code
     2882                                                     :
     2883                       if buf_marking-chk.sts <> 2 then
     2884                       do:
     2885                          assign buf_marking-chk.sts = 1 .
     2886                          validate buf_marking-chk.
     2887                       end.
     2888                     end .
     2889                   end .
     2890                   if buf_marking.unit-ext <> "UNIT" or
     2891                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     2892                   then do :
     2893                     run addChildMarkingLines in this-procedure (
     2894                       buf_marking.mark,
     2895                       buf_marking.sts,
     2896                       buffer buf_marking-lines,
     2897                       buffer buf_parts,
     2898                       buffer orig_marking-lines,
     2899                       buffer buf_orig_parts,
     2900                       buffer buf_goods
     2901                     ).
     2902                   end .
     2903                 end.
     2904                 if available orig_marking-lines then
     2905                   delete orig_marking-lines .
     2906             end.
     2907           end.
     2908         end .
     2909         if p-out-code = 'out-zone':U
     2910         and trim(p-mark) = ""
     2911         then do :
     2912           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     2913                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2914                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2915                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2916                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2917                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2918                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2919                                                 :
     2920             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     2921                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     2922                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     2923                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     2924                                                     and buf_marking-lines.out-code   = p-out-code
     2925                                                     no-error .
     2926             if available buf_marking-lines
     2927             then do :
     2928               find current buf_marking-lines exclusive-lock .
     2929               delete buf_marking-lines .
     2930               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     2931                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     2932                 then do :
     2933                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2934                   validate buf_marking.
     2935                 end.
     2936               end .
     2937             end .
     2938             else do :
     2939               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     2940               create buf_marking-lines .
     2941               assign
     2942                 buf_marking-lines.mark       = orig_marking-lines.mark
     2943                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2944                 buf_marking-lines.gds-code   = buf_goods.gds-code
     2945                 buf_marking-lines.obj-type   = buf_parts.obj-type
     2946                 buf_marking-lines.obj-code   = buf_parts.obj-code
     2947                 buf_marking-lines.in-code    = buf_parts.in-code
     2948                 buf_marking-lines.out-code   = buf_parts.out-code
     2949                 buf_marking-lines.part-code  = buf_parts.part-code
     2950                 buf_marking-lines.prt-code   = buf_parts.prt-code
     2951               .
     2952               validate buf_marking-lines.
     2953               if buf_parts.out-code <> buf_parts.in-code
     2954               and buf_parts.out-code <> 'free-zone':U
     2955               and buf_parts.out-code <> 'out-zone':U
     2956               then do :
     2957                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     2958                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     2959               end .
     2960               end.
     2961             end .
     2962             release buf_marking-lines no-error .
     2963           end.
     2964         end .
     2965         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     2966         then do:
     2967           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     2968                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     2969                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2970                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2971                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2972                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2973                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2974                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2975                                                   .
     2976             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     2977                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     2978                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     2979                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     2980                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     2981                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     2982                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     2983                                                    no-error .
     2984             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     2985               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     2986                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     2987               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     2988                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     2989               validate ub.marking.
     2990             end.
     2991             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     2992             if available (buf_marking-lines)
     2993             then do:
     2994               assign
     2995                 buf_marking-lines.mark       = p-mark
     2996                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2997                 buf_marking-lines.gds-code   = buf_goods.gds-code
     2998                 buf_marking-lines.obj-type   = buf_parts.obj-type
     2999                 buf_marking-lines.obj-code   = buf_parts.obj-code
     3000                 buf_marking-lines.in-code    = buf_parts.in-code
     3001                 buf_marking-lines.out-code   = buf_parts.out-code
     3002                 buf_marking-lines.part-code  = buf_parts.part-code
     3003               .
     3004               validate buf_marking-lines.
     3005             end.
     3006           end.
     3007         end.
     3008       end.
     3009       else do:
     3010         find first buf_parts exclusive-lock
     3011           where recid(buf_parts) = recid(buf_orig_parts)
     3012           .
     3013       end.
     3014       if p-out-code = 'free-zone':U
     3015       or p-out-code = 'out-zone':U
     3016       then do:
     3017         if buf_parts.rsrv-free <>
     3018          (if buf_parts.out-code = 'free-zone':U then yes else no)
     3019         then do:
     3020           message
     3021             vss-workfile vss-revision vss-description skip
     3022             vss-include-info8 skip
     3023             "Ошибка типа резерва партии" skip
     3024             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     3025             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     3026             "Партия" buf_parts.in-code buf_parts.part-code skip
     3027             "Резерв" buf_parts.out-code skip
     3028             "Статус" buf_parts.status_ skip
     3029             "Тип резерва" buf_parts.rsrv-free skip
     3030             view-as alert-box error .
     3031           undo, return error .
     3032         end.
     3033       end.
     3034     end.
     3035   end procedure.
     3036   procedure partcopy-to-childs-mark :
     3037     define parameter buffer buf_ml for ub.marking-lines .
     3038     define parameter buffer buf_orig-ml for ub.marking-lines .
     3039     define input parameter p-out-code as character no-undo .
     3040     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     3041     define buffer buf_ml-childs for ub.marking-lines .
     3042     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     3043       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     3044         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     3045       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     3046         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     3047       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     3048         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     3049         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     3050         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     3051         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     3052         and buf_ml-childs.part-code = buf_orig-ml.part-code
     3053         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     3054         :
     3055         assign
     3056           buf_ml-childs.out-code  = p-out-code
     3057         .
     3058         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     3059       end.
     3060     end.
     3061   end.
     3062   procedure partcopy-update-parts :
     3063     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     3064     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     3065     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     3066     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     3067     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     3068     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     3069     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     3070     define buffer buf_trn-doc for ub.trn-doc .
     3071     define buffer archive_parts for ub.parts .
     3072     define buffer buf_parts   for ub.parts .
     3073     define buffer orig_marking-lines for ub.marking-lines .
     3074     define buffer buf_marking for ub.marking .
     3075     define buffer buf_goods for ub.goods .
     3076     define variable v-rsrv-code     as character no-undo .
     3077     define variable v-goods-twounit as logical   no-undo .
     3078     define variable v-value-character as character no-undo .
     3079     define variable v-value-date      as date no-undo .
     3080     define variable v-value-decimal   as decimal no-undo .
     3081     define variable v-value-integer   as integer no-undo .
     3082     define variable v-izlcstpr        as logical no-undo .
     3083     define variable v-tth             as handle no-undo .
     3084     define variable v-type            as character no-undo .
     3085     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     3086     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     3087     do
     3088     on error undo, return error return-value
     3089     :
     3090       find first buf_trn-doc no-lock
     3091         where buf_trn-doc.doc-code = p-doc-code
     3092         no-error .
     3093       if not available buf_trn-doc
     3094       then do:
     3095         message
     3096           vss-workfile vss-revision vss-description skip
     3097           vss-include-info8 skip
     3098           "Ошибка задания входных параметров" skip
     3099           "Не найден документ" skip
     3100           "Документ" p-doc-code skip
     3101           "Объект" p-obj-type p-obj-code skip
     3102           "Артикул" p-artic p-prod-type p-prod-code skip
     3103           error-status :get-message(1) skip
     3104           return-value skip
     3105           view-as alert-box error .
     3106         undo, return error .
     3107       end.
     3108       find first buf_goods no-lock where buf_goods.artic = p-artic
     3109                                      and buf_goods.prod-type = p-prod-type
     3110                                      and buf_goods.prod-code = p-prod-code
     3111                                      no-error .
     3112       if not available buf_goods
     3113       then do:
     3114         message
     3115           vss-workfile vss-revision vss-description skip
     3116           vss-include-info8 skip
     3117           "Ошибка задания входных параметров" skip
     3118           "Не найден товар" skip
     3119           "Документ" p-doc-code skip
     3120           "Объект" p-obj-type p-obj-code skip
     3121           "Артикул" p-artic p-prod-type p-prod-code skip
     3122           error-status :get-message(1) skip
     3123           return-value skip
     3124           view-as alert-box error .
     3125         undo, return error .
     3126       end.
     3127       if buf_trn-doc.ext-doc-type = 'vt':U
     3128       then do :
     3129           delete object v-tth no-error.
     3130           run adm/shattri.p (
     3131              input "get":U
     3132             ,input buf_trn-doc.obj-type
     3133             ,input buf_trn-doc.obj-code
     3134             ,input 'inv-obj':U
     3135             ,input  "izlcstpr"
     3136             ,output v-value-character
     3137             ,output v-value-date
     3138             ,output v-value-decimal
     3139             ,output v-value-integer
     3140             ,output v-izlcstpr
     3141             ,output v-type
     3142             ,INPUT-OUTPUT table-handle v-tth
     3143             ) no-error .
     3144             delete object v-tth no-error.
     3145           if error-status:error then do:
     3146             v-izlcstpr = false .
     3147           end.
     3148       end.
     3149       else do :
     3150           v-izlcstpr = false .
     3151       end.
     3152   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     3154     (input  p-artic
     3155     ,input  p-prod-type
     3156     ,input  p-prod-code
     3157     ,input  'twounit=request':u
     3158     ,output v-goods-twounit
     3159     ) no-error .
     3160       if error-status :error
     3161       then do:
     3162         message
     3163           vss-workfile vss-revision vss-description skip
     3164           vss-include-info8 skip
     3165           "Ошибка при определении атрибута товара" skip
     3166           "Артикул" p-artic p-prod-type p-prod-code skip
     3167           error-status :get-message(1) skip
     3168           return-value skip
     3169           view-as alert-box error .
     3170         undo, return error .
     3171       end.
     3172       define query partcopy-select-parts for archive_parts .
     3173       open query partcopy-select-parts preselect each archive_parts
     3174         where archive_parts.obj-type  = p-obj-type
     3175           and archive_parts.obj-code  = p-obj-code
     3176           and archive_parts.artic     = p-artic
     3177           and archive_parts.prod-type = p-prod-type
     3178           and archive_parts.prod-code = p-prod-code
     3179           and archive_parts.out-code  = p-doc-code
     3180         .
     3181       get first partcopy-select-parts .
     3182       if buf_trn-doc.doc-type = 'при':U
     3183       then do:
     3184         do while available archive_parts
     3185         on error undo, return error return-value
     3186         :
     3187           if can-do('рас,спи':U, buf_trn-doc.doc-type)
     3188           or (buf_trn-doc.doc-type = 'инв':U
     3189               and archive_parts.fact-qnty < 0)
     3190           then do:
     3191             assign
     3192               v-rsrv-code = 'out-zone':U
     3193             .
     3194           end.
     3195           else do:
     3196             assign
     3197               v-rsrv-code = 'free-zone':U
     3198             .
     3199           end.
     3200           assign
     3201             archive_parts.status_   = yes
     3202             archive_parts.rsrv-free = ?
     3203           .
     3204           if archive_parts.in-code = p-doc-code
     3205           then do:
     3206             assign
     3207               archive_parts.fact-num  = buf_trn-doc.fact-num
     3208               archive_parts.fact-date = buf_trn-doc.fact-date
     3209               archive_parts.doc-type  = buf_trn-doc.doc-type
     3210             .
     3211           end.
     3212           if archive_parts.fact-qnty <> 0
     3213           then do:
     3214             run partcopy in this-procedure
     3215               (input  true
     3216               ,input  v-rsrv-code
     3217               ,buffer archive_parts
     3218               ,buffer buf_parts
     3219               ,input  ""
     3220               ) no-error .
     3221             if error-status :error
     3222             then do:
     3223               message
     3224                 vss-workfile vss-revision vss-description skip
     3225                 vss-include-info8 skip
     3226                 "Ошибка при создании партии" skip
     3227                 "Документ" p-doc-code skip
     3228                 "Объект" p-obj-type p-obj-code skip
     3229                 "Артикул" p-artic p-prod-type p-prod-code skip
     3230                 "Партия" archive_parts.in-code archive_parts.part-code skip
     3231                 "Резерв" v-rsrv-code skip
     3232                 error-status :get-message(1) skip
     3233                 return-value skip
     3234                 view-as alert-box error .
     3235               undo, return error .
     3236             end.
     3237             assign
     3238               buf_parts.qnty      = buf_parts.qnty     + archive_parts.fact-qnty
     3239               buf_parts.fact-qnty = buf_parts.qnty
     3240             .
     3241             if v-goods-twounit = true
     3242             then do:
     3243               assign
     3244                 buf_parts.cli-qnty = buf_parts.cli-qnty + archive_parts.cli-qnty
     3245               .
     3246               case buf_trn-doc.ext-doc-type :
     3247                 when 'ie':U
     3248                 then do:
     3249                   if archive_parts.cli-qnty <> truncate(archive_parts.cli-qnty, 0 )
     3250                   then do:
     3251                     message
     3252                       vss-workfile vss-revision vss-description skip
     3253                       vss-include-info8 skip
     3254                       "Клиентское количество для товара," skip
     3255                       "который учитывается по двум единицам измерения" skip
     3256                       "должно равняться единице" skip
     3257                       "Документ" p-doc-code skip
     3258                       "Объект" p-obj-type p-obj-code skip
     3259                       "Артикул" p-artic p-prod-type p-prod-code skip
     3260                       "Партия" archive_parts.in-code archive_parts.part-code skip
     3261                       "Количество по документу" archive_parts.qnty skip
     3262                       "Фактическое количество" archive_parts.fact-qnty skip
     3263                       "Клиентское количество" archive_parts.cli-qnty skip
     3264                       view-as alert-box error .
     3265                     undo, return error .
     3266                   end.
     3267                 end.
     3268                 when 'iv':U
     3269                 then do:
     3270                   if archive_parts.cli-qnty <> 1
     3271                   then do:
     3272                     message
     3273                       vss-workfile vss-revision vss-description skip
     3274                       vss-include-info8 skip
     3275                       "Клиентское количество для товара," skip
     3276                       "который учитывается по двум единицам измерения" skip
     3277                       "должно равняться единице" skip
     3278                       "Документ" p-doc-code skip
     3279                       "Объект" p-obj-type p-obj-code skip
     3280                       "Артикул" p-artic p-prod-type p-prod-code skip
     3281                       "Партия" archive_parts.in-code archive_parts.part-code skip
     3282                       "Количество по документу" archive_parts.qnty skip
     3283                       "Фактическое количество" archive_parts.fact-qnty skip
     3284                       "Клиентское количество" archive_parts.cli-qnty skip
     3285                       view-as alert-box error .
     3286                     undo, return error .
     3287                   end.
     3288                 end.
     3289                 otherwise do:
     3290                   message
     3291                     vss-workfile vss-revision vss-description skip
     3292                     vss-include-info8 skip
     3293                     "Товар учитывается по двум единицам измерения" skip
     3294                     "Для приходов разрешен только внешний приход или приход перемещение" skip
     3295                     "Документ" p-doc-code skip
     3296                     "Объект" p-obj-type p-obj-code skip
     3297                     "Артикул" p-artic p-prod-type archive_parts.prod-code skip
     3298                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3299                     "Количество по документу" archive_parts.qnty skip
     3300                     "Фактическое количество" archive_parts.fact-qnty skip
     3301                     "Клиентское количество" archive_parts.cli-qnty skip
     3302                     view-as alert-box error .
     3303                   undo, return error .
     3304                 end.
     3305               end.
     3306             end.
     3307             else do:
     3308               if buf_parts.cli-base-rate <> 0
     3309               then do:
     3310                 assign
     3311                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3312                 .
     3313               end.
     3314               else do:
     3315                 assign
     3316                   buf_parts.cli-qnty = 0
     3317                 .
     3318               end.
     3319             end.
     3320             if  buf_parts.qnty      = 0
     3321             and buf_parts.fact-qnty = 0
     3322             then do:
     3323               if v-goods-twounit = true
     3324               then do:
     3325                 if buf_parts.cli-qnty <> 0
     3326                 then do:
     3327                   message
     3328                     vss-workfile vss-revision vss-description skip
     3329                     vss-include-info8 skip
     3330                     "Ошибка при удалении партии" skip
     3331                     "Документ" p-doc-code skip
     3332                     "Объект" p-obj-type p-obj-code skip
     3333                     "Артикул" p-artic p-prod-type p-prod-code skip
     3334                     "Партия" buf_parts.in-code buf_parts.part-code skip
     3335                     "Резерв" buf_parts.out-code skip
     3336                     "qnty" buf_parts.qnty skip
     3337                     "fact-qnty" buf_parts.fact-qnty skip
     3338                     "cli-qnty" buf_parts.cli-qnty skip
     3339                     view-as alert-box error .
     3340                   undo, return error .
     3341                 end.
     3342               end.
     3343               delete buf_parts .
     3344             end.
     3345           end.
     3346           else do :
     3347             if buf_trn-doc.ext-doc-type = 'iv':U
     3348             then
     3349             for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     3350                                                   and orig_marking-lines.obj-type   = archive_parts.obj-type
     3351                                                   and orig_marking-lines.obj-code   = archive_parts.obj-code
     3352                                                   and orig_marking-lines.in-code    = archive_parts.in-code
     3353                                                   and orig_marking-lines.out-code   = archive_parts.out-code
     3354                                                   and orig_marking-lines.part-code  = archive_parts.part-code,
     3355             first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3356               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     3357             end .
     3358           end .
     3359           get next partcopy-select-parts .
     3360         end.
     3361       end.
     3362       if buf_trn-doc.doc-type = 'рас':U
     3363       or buf_trn-doc.doc-type = 'спи':U
     3364       or buf_trn-doc.doc-type = 'возврат':U
     3365       or buf_trn-doc.doc-type = 'инв':U
     3366       then do:
     3367         do while available archive_parts
     3368         on error undo, return error return-value
     3369         :
     3370           assign
     3371             archive_parts.status_   = yes
     3372             archive_parts.rsrv-free = ?
     3373           .
     3374           if archive_parts.fact-qnty <> archive_parts.qnty
     3375           then do:
     3376             define variable v-is-hold as logical   no-undo .
     3377   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3379     (input  buf_trn-doc.doc-code
     3380     ,output v-is-hold
     3381     ) no-error .
     3382             if error-status :error
     3383             then do:
     3384               message
     3385                 vss-workfile vss-revision vss-description skip
