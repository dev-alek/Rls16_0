        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.bar-code .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление записи bar-code".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   on write of ub.c-bar-code override do: end.
      304   define buffer buf_bar-code-attr for ub.bar-code-attr.
      305   define buffer buf_bar-code-obj-attr for ub.bar-code-obj-attr.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   define new global shared variable g#lib-nws as handle no-undo .
      309   procedure bar-codh_write-bar-code-trigger :
      310   define input parameter p-new-record as logical no-undo .
      311   define input parameter p-action as integer no-undo .
      312   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      313   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      314   define variable v-date as date      no-undo.
      315   define variable v-time  as integer   no-undo.
      316   define buffer buf_c-gds-hist for ub.c-gds-hist.
      317   define buffer buf_c-bar-code for ub.c-bar-code.
      318     do
      319     on error undo, return error
      320     :
      321       if g#news then do:
      322         define variable v-send as integer no-undo .
      323         v-send = integer('0':U).
      324   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      325   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      326     (input  g#db-num
      327     ,input  'bar-code':U
      328     ,input  0
      329     ,input  '':U
      330     ,input  0
      331     ,input  '':U
      332     ,input  '':U
      333     ,input  '':U
      334     ,input  0
      335     ,input  0
      336     ,input  0
      337     ,input  'nws-to-hist'
      338     ,output v-send
      339     ) no-error .
      340         if v-send < 0 then return.
      341       end.
      342       run cur-time in this-procedure ( output v-date, output v-time).
      343       create buf_c-bar-code.
      344       buffer-copy ub.bar-code to buf_c-bar-code
      345       assign
      346       buf_c-bar-code.gds-code           = (if p-new-record then ub.bar-code.gds-code else ub.bar-code.gds-code)
      347       buf_c-bar-code.b-code             = (if p-new-record then ub.bar-code.b-code else ub.bar-code.b-code)
      348       buf_c-bar-code.chip-num           = next-value (s-gds-chip, ub)
      349       buf_c-bar-code.corr-time          = v-time
      350       buf_c-bar-code.corr-user-db-num   = g#db-num
      351       buf_c-bar-code.corr-user-name     = (if g#news
      352                                            then (chr(4) +  'СПН':U)
      353                                            else (if g#esys
      354                                                  then (chr(4) +  'ВС':U)
      355                                                  else g#userid)
      356                                           )
      357       buf_c-bar-code.corr-date          = v-date
      358       .
      359       create buf_c-gds-hist.
      360       buffer-copy buf_c-bar-code to buf_c-gds-hist
      361       assign
      362       buf_c-gds-hist.gds-code           = buf_c-bar-code.gds-code
      363       buf_c-gds-hist.action = (if p-new-record
      364                                 then integer('1':U)
      365                                 else (if ub.bar-code.gds-code = ub.bar-code.gds-code
      366                                       and ub.bar-code.b-code  = ub.bar-code.b-code
      367                                       then p-action
      368                                       else integer('9':U))
      369                               )
      370       buf_c-gds-hist.b-code             = (if buf_c-gds-hist.action = integer('9':U)
      371                                           and ub.bar-code.b-code  <>  ub.bar-code.b-code
      372                                           then ub.bar-code.b-code
      373                                           else ub.bar-code.b-code)
      374       buf_c-gds-hist.subject = 'bar-code':U
      375       buf_c-gds-hist.is-news = g#news
      376       buf_c-gds-hist.source-type = (if g#news
      377                                     then 'db':U
      378                                     else (if g#esys
      379                                           then 'esys':U
      380                                           else "":U)
      381                                     )
      382       buf_c-gds-hist.source-ref = (if g#news
      383                                    then string(g#news-source-db)
      384                                    else (if g#esys
      385                                          then string(g#esys-source-esys)
      386                                          else "":U)
      387                                    )
      388       .
      389       if p-action = integer('99':U) then do:
      390         if
      391         not g#news
      392         OR (g#news
      393             and not ( g#db-num > 0 )
      394             and buf_c-bar-code.corr-user-name <> (chr(4) +  'СПН':U)
      395             )
      396         or (g#news
      397             and ( g#db-num > 0 )
      398             and buf_c-bar-code.corr-user-name = (chr(4) +  'СПН':U)
      399             )
      400         then
      401         run str/callnews.p
      402           (input 'c-bar-code':U
      403           ,input (buffer buf_c-bar-code:handle)
      404           ).
      405       end.
      406     end.
      407   end procedure.
      408   procedure bar-codh_write-bar-code-proc  :
      409   define parameter buffer buf_bar-code for ub.bar-code .
      410   define input parameter p-action as integer no-undo .
      411   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      412   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      413   define variable v-date as date      no-undo.
      414   define variable v-time  as integer   no-undo.
      415   define buffer buf_c-gds-hist for ub.c-gds-hist.
      416   define buffer buf_c-bar-code for ub.c-bar-code.
      417     do
      418     on error undo, return error
      419     :
      420       if not available buf_bar-code then do:
      421         message
      422           vss-workfile vss-revision vss-description skip
      423           "Ошибка задания входных параметров" skip
      424           "Не определен БАР-КОД" skip
      425           view-as alert-box error .
      426         undo, return error .
      427       end.
      428       if g#news then do:
      429         define variable v-send as integer no-undo .
      430         v-send = integer('0':U).
      431   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      433     (input  g#db-num
      434     ,input  'bar-code':U
      435     ,input  0
      436     ,input  '':U
      437     ,input  0
      438     ,input  '':U
      439     ,input  '':U
      440     ,input  '':U
      441     ,input  0
      442     ,input  0
      443     ,input  0
      444     ,input  'nws-to-hist'
      445     ,output v-send
      446     ) no-error .
      447         if v-send < 0 then return.
      448       end.
      449       run cur-time in this-procedure(output v-date, output v-time).
      450       create buf_c-bar-code.
      451       if p-action = integer('1':U) then do:
      452         assign
      453         buf_c-bar-code.b-code             = buf_bar-code.b-code
      454         buf_c-bar-code.gds-code           = buf_bar-code.gds-code
      455         buf_c-bar-code.chip-num           = next-value (s-gds-chip, ub)
      456         buf_c-bar-code.corr-time          = v-time
      457         buf_c-bar-code.corr-user-db-num   = g#db-num
      458         buf_c-bar-code.corr-user-name     = (if g#news
      459                                             then (chr(4) +  'СПН':U)
      460                                             else (if g#esys
      461                                                   then (chr(4) +  'ВС':U)
      462                                                   else g#userid)
      463                                             )
      464         buf_c-bar-code.corr-date          = v-date
      465        .
      466       end.
      467       else do:
      468         buffer-copy buf_bar-code to buf_c-bar-code
      469         assign
      470         buf_c-bar-code.gds-code           = buf_bar-code.gds-code
      471         buf_c-bar-code.chip-num           = next-value (s-gds-chip, ub)
      472         buf_c-bar-code.corr-time          = v-time
      473         buf_c-bar-code.corr-user-db-num   = g#db-num
      474         buf_c-bar-code.corr-user-name     = (if g#news
      475                                             then (chr(4) +  'СПН':U)
      476                                             else (if g#esys
      477                                                   then (chr(4) +  'ВС':U)
      478                                                   else g#userid)
      479                                             )
      480         buf_c-bar-code.corr-date          = v-date
      481         .
      482       end.
      483       create buf_c-gds-hist.
      484       buffer-copy buf_c-bar-code to buf_c-gds-hist
      485       assign
      486       buf_c-gds-hist.gds-code           = buf_c-bar-code.gds-code
      487       buf_c-gds-hist.action = integer(p-action)
      488       buf_c-gds-hist.subject = 'bar-code':U
      489       buf_c-gds-hist.is-news = g#news
      490       buf_c-gds-hist.source-type = (if g#news then 'db':U
      491                                     else (if g#esys
      492                                           then 'esys':U
      493                                           else "":U
      494                                           )
      495                                    )
      496       buf_c-gds-hist.source-ref = (if g#news
      497                                    then string(g#news-source-db)
      498                                     else (if g#esys
      499                                           then string(g#esys-source-esys)
      500                                           else "":U
      501                                           )
      502                                    )
      503       .
      504     end.
      505   end procedure.
      506   define buffer buf_prod-bc for ub.prod-bc .
      507   MAIN-BLOCK:
      508   do
      509   on error   undo main-block, return error
      510   on end-key undo main-block, return error
      511   :
      512     find first ub.prod-bc no-lock
      513       where ub.prod-bc.b-code = ub.bar-code.b-code
      514       no-error .
      515     if available ub.prod-bc then do:
      516       message
      517         vss-workfile vss-revision vss-description skip
      518         "Нельзя удалить основной бар-код, для которого существуют дополнительные бар-коды" skip
      519         "Основной бар-код" ub.bar-code.b-code skip
      520         "Дополнительный бар-код" ub.prod-bc.b-str skip
      521         view-as alert-box error .
      522       undo, return error .
      523     end.
      524    run bar-codh_write-bar-code-trigger in this-procedure  (
      525                                          input no
      526                                         ,input integer('99':U)
      527                                         ,input (if g#news
      528                                                 then 'db':U
      529                                                 else (if g#esys
      530                                                       then 'esys':U
      531                                                       else "":U)
      532                                                 )
      533                                         ,input (if g#news
      534                                                 then string(g#news-source-db)
      535                                                 else (if g#esys
      536                                                       then string(g#esys-source-esys)
      537                                                       else "")
      538                                                 )
      539                                       ) .
      540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      541     (input ?
      542     ,input this-procedure:handle
      543     ,input ?
      544     ,input 'dellcode':U
      545     ,input  buffer ub.bar-code:handle
      546     ,input ?
      547     ,input ''
      548     ,input ''
      549     ) no-error .
      550       if error-status:error
      551       then do:
      552         if not g#news then do:
      553           message
      554             vss-workfile vss-revision vss-description skip
      555             "Ошибка при вызове процедуры rum-runa.i" skip
      556             error-status :get-message(1) skip
      557             return-value skip
      558             view-as alert-box error .
      559         end.
      560         undo main-block,  return error return-value .
      561       end.
      562     if ub.bar-code.stts_ <> integer('99':U) then do:
      563       for each buf_bar-code-attr share-lock where
      564               buf_bar-code-attr.b-code = ub.bar-code.b-code
      565       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      566       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      567       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      568       :
      569         delete buf_bar-code-attr.
      570       end.
      571       for each buf_bar-code-obj-attr share-lock where
      572               buf_bar-code-obj-attr.b-code = ub.bar-code.b-code
      573       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      574       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      575       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      576       :
      577         delete buf_bar-code-obj-attr.
      578       end.
      579       run nws/cmd-del.p
      580         ( input 'bar-code':U
      581          ,input (buffer ub.bar-code:handle)
      582          ,input "":U
      583         ) no-error .
      584       if error-status :error then do:
      585         return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      586       end.
      587     end.
      588     if g#oxml = yes
      589     then do:
      590       run str/calloxml.p (
      591             input 'delete':U
      592           , input 'bar-code':U
      593           , input ( buffer ub.bar-code:handle )
      594       ) no-error.
      595       if error-status :error
      596       then do:
      597           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      598                               , chr(10)
      599                               , vss-workfile
      600                               , return-value
      601                               , error-status :get-message ( 1 ) ).
      602       end.
      603     end.
      604   end.
