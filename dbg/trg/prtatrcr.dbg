     1029   end.
     1030   procedure get-country-code :
     1031     define input  parameter p-trn-doc      as character no-undo .
     1032     define input  parameter p-ext-doc-type as character no-undo .
     1033     define input  parameter p-gds-code     as integer   no-undo .
     1034     define output parameter p-country-code as integer   no-undo .
     1035     define buffer buf_goods   for ub.goods .
     1036     define buffer buf_country for ub.country .
     1037     define variable v-read-default-code as logical   no-undo .
     1038     define variable v-attr-value        as character no-undo .
     1039     define variable v-attr-type         as character no-undo .
     1040     do
     1041     on error undo, return error return-value
     1042     :
     1043       assign
     1044         v-read-default-code = true
     1045       .
     1046       if p-ext-doc-type = 'ie':U
     1047       then do:
     1048         run lineattr-value in this-procedure
     1049           (input  p-doc-code
     1050           ,input  p-gds-code
     1051           ,input  'country-code':U
     1052           ,output v-attr-value
     1053           ,output v-attr-type
     1054           ) .
     1055         if v-attr-value <> ""
     1056         then do:
     1057           assign
     1058             v-read-default-code = false
     1059             p-country-code      = integer(v-attr-value)
     1060           .
     1061         end.
     1062       end.
     1063       if v-read-default-code = true
     1064       then do:
     1065         find first buf_goods no-lock
     1066           where buf_goods.gds-code = p-gds-code
     1067           no-error .
     1068         find first buf_country no-lock
     1069           where buf_country.alpha1 = buf_goods.alpha1
     1070           no-error .
     1071         if available buf_country
     1072         then do:
     1073           assign
     1074             p-country-code = buf_country.num-code
     1075           .
     1076         end.
     1077         else do:
     1078           assign
     1079             p-country-code = 0
     1080           .
     1081         end.
     1082       end.
     1083     end.
     1084   end procedure.
