        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code   as character no-undo .
        3   define input  parameter p-create-all as logical   no-undo .
        4   define variable vss-revision    as character no-undo initial "$Revision$":U .
        5   define variable vss-author      as character no-undo initial "$Author$":U .
        6   define variable vss-date        as character no-undo initial "$Date$":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        8   define variable vss-archive     as character no-undo initial "$Archive$":U .
        9   define variable vss-description as character no-undo initial "Создание атрибутов партий для документа".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28       assign
       29         p-vss-parameters = substitute('&1':u,p-doc-code)
       30       .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure lineattr-value :
       84     do
       85     on error undo, return error return-value
       86     :
       87       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
       88       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
       89       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
       90       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
       91       define output parameter p-type     as character no-undo .
       92       define buffer buf_doc-line-attr for ub.doc-line-attr .
       93       def var v-format         as character no-undo .
       94       def var v-fillin_width   as integer   no-undo .
       95       def var v-fillin_height  as integer   no-undo .
       96       def var v-label          as character no-undo .
       97       def var v-user-can-edit  as logical   no-undo .
       98       def var v-output-display as logical   no-undo .
       99       def var v-other          as character no-undo .
      100       run lineattr-code in this-procedure
      101         (input  p-code
      102         ,output p-type
      103         ,output v-format
      104         ,output v-fillin_width
      105         ,output v-fillin_height
      106         ,output v-label
      107         ,output v-user-can-edit
      108         ,output v-output-display
      109         ,output v-other
      110         ) no-error .
      111       if error-status :error then do:
      112         undo, return error return-value .
      113       end.
      114       find first buf_doc-line-attr no-lock
      115         where buf_doc-line-attr.doc-code  = p-doc-code
      116           and buf_doc-line-attr.gds-code  = p-gds-code
      117           and buf_doc-line-attr.attr-code = p-code
      118         no-error .
      119       if avail buf_doc-line-attr then do:
      120         assign
      121           p-value =  buf_doc-line-attr.attr-value
      122         .
      123       end.
      124       else do:
      125         assign
      126           p-value = if p-type = 'L':U then "no":U else ""
      127         .
      128       end.
      129     end.
      130   end procedure.
      131   procedure lineattr-write :
      132     do
      133     on error undo, return error return-value
      134     :
      135       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      136       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      137       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      138       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      139       define buffer buf_doc-line-attr for ub.doc-line-attr .
      140       def var v-type           as character no-undo .
      141       def var v-format         as character no-undo .
      142       def var v-fillin_width   as integer   no-undo .
      143       def var v-fillin_height  as integer   no-undo .
      144       def var v-label          as character no-undo .
      145       def var v-user-can-edit  as logical   no-undo .
      146       def var v-output-display as logical   no-undo .
      147       def var v-other          as character no-undo .
      148       run lineattr-code in this-procedure
      149         (input  p-code
      150         ,output v-type
      151         ,output v-format
      152         ,output v-fillin_width
      153         ,output v-fillin_height
      154         ,output v-label
      155         ,output v-user-can-edit
      156         ,output v-output-display
      157         ,output v-other
      158         ) no-error .
      159       if error-status :error then do:
      160         undo, return error return-value .
      161       end.
      162       find first buf_doc-line-attr exclusive-lock
      163         where buf_doc-line-attr.doc-code  = p-doc-code
      164           and buf_doc-line-attr.gds-code  = p-gds-code
      165           and buf_doc-line-attr.attr-code = p-code
      166         no-error .
      167       if not available buf_doc-line-attr then do:
      168         create buf_doc-line-attr .
      169         assign
      170           buf_doc-line-attr.doc-code  = p-doc-code
      171           buf_doc-line-attr.gds-code = p-gds-code
      172           buf_doc-line-attr.attr-code = p-code
      173         .
      174       end.
      175       assign
      176         buf_doc-line-attr.attr-value = p-value
      177       .
      178        release buf_doc-line-attr.
      179     end.
      180   end procedure.
      181   procedure lineattr-exist :
      182     do
      183     on error undo, return error return-value
      184     :
      185       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      186       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      187       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      188       define output parameter p-exist   as logical  no-undo .
      189       define buffer buf_doc-line-attr for ub.doc-line-attr .
      190       def var v-type           as character no-undo .
      191       def var v-format         as character no-undo .
      192       def var v-fillin_width   as integer   no-undo .
      193       def var v-fillin_height  as integer   no-undo .
      194       def var v-label          as character no-undo .
      195       def var v-user-can-edit  as logical   no-undo .
      196       def var v-output-display as logical   no-undo .
      197       def var v-other          as character no-undo .
      198       run lineattr-code in this-procedure
      199         (input  p-code
      200         ,output v-type
      201         ,output v-format
      202         ,output v-fillin_width
      203         ,output v-fillin_height
      204         ,output v-label
      205         ,output v-user-can-edit
      206         ,output v-output-display
      207         ,output v-other
      208         ) no-error .
      209       if error-status :error then do:
      210         undo, return error return-value .
      211       end.
      212       find first buf_doc-line-attr no-lock
      213         where buf_doc-line-attr.doc-code  = p-doc-code
      214           and buf_doc-line-attr.gds-code = p-gds-code
      215           and buf_doc-line-attr.attr-code = p-code
      216         no-error .
      217       if  available buf_doc-line-attr then do:
      218         p-exist = yes.
      219       end.
      220     end.
      221   end procedure.
      222   procedure lineattr-delete :
      223     do
      224     on error undo, return error return-value
      225     :
      226       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      227       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      228       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      229       define output parameter p-deleted  as logical no-undo.
      230       define buffer buf_doc-line-attr for ub.doc-line-attr .
      231       def var v-type           as character no-undo .
      232       def var v-format         as character no-undo .
      233       def var v-fillin_width   as integer   no-undo .
      234       def var v-fillin_height  as integer   no-undo .
      235       def var v-label          as character no-undo .
      236       def var v-user-can-edit  as logical   no-undo .
      237       def var v-output-display as logical   no-undo .
      238       def var v-other          as character no-undo .
      239       run lineattr-code in this-procedure
      240         (input  p-code
      241         ,output v-type
      242         ,output v-format
      243         ,output v-fillin_width
      244         ,output v-fillin_height
      245         ,output v-label
      246         ,output v-user-can-edit
      247         ,output v-output-display
      248         ,output v-other
      249         ) no-error .
      250       if error-status :error then do:
      251         undo, return error return-value .
      252       end.
      253       find first buf_doc-line-attr exclusive-lock
      254         where buf_doc-line-attr.doc-code  = p-doc-code
      255           and buf_doc-line-attr.gds-code  = p-gds-code
      256           and buf_doc-line-attr.attr-code = p-code
      257         no-error NO-WAIT.
      258       if not available buf_doc-line-attr then do:
      259         p-deleted = no.
      260       end.
      261       else do:
      262         delete buf_doc-line-attr.
      263         p-deleted = yes.
      264       end.
      265     end.
      266   end procedure.
      267   procedure lineattr-code :
      268     do on error undo, return error return-value
      269     :
      270       define input  parameter p-code           as character no-undo .
      271       define output parameter p-type           as character no-undo .
      272       define output parameter p-format         as character no-undo .
      273       define output parameter p-fillin_width   as integer   no-undo .
      274       define output parameter p-fillin_height  as integer   no-undo .
      275       define output parameter p-label          as character no-undo .
      276       define output parameter p-user-can-edit  as logical   no-undo .
      277       define output parameter p-output-display as logical   no-undo .
      278       define output parameter p-other          as character no-undo .
      279       case p-code :
      280               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      281               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      282               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      283               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      284               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      285               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      286               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      287               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      288               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      289               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      290               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      291         otherwise do:
      292           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      293         end.
      294       end.
      295     end.
      296   end procedure.
      297   procedure lineattr-value-flora-gds :
      298     do
      299     on error undo, return error return-value
      300     :
      301       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      302       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      303       define input  parameter p-prt-code    as integer   no-undo .
      304       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      305       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      306       define output parameter p-value       as    decimal   no-undo .
      307       define buffer buf_doc-line-attr for ub.doc-line-attr .
      308       find first buf_doc-line-attr no-lock
      309         where buf_doc-line-attr.doc-code  = p-doc-code
      310           and buf_doc-line-attr.gds-code  = p-gds-code
      311           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      312         no-error .
      313       if avail buf_doc-line-attr then do:
      314         assign
      315           p-value = decimal( buf_doc-line-attr.attr-value)
      316         .
      317       end.
      318       else do:
      319         assign
      320           p-value = 0
      321         .
      322       end.
      323     end.
      324   end procedure.
      325   procedure lineattr-write-flora-gds :
      326     do
      327     on error undo, return error return-value
      328     :
      329       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      330       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      331       define input parameter p-prt-code    as integer   no-undo .
      332       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      333       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      334       define input parameter p-value    as decimal   no-undo .
      335       define buffer buf_doc-line-attr for ub.doc-line-attr .
      336       find first buf_doc-line-attr exclusive-lock
      337         where buf_doc-line-attr.doc-code  = p-doc-code
      338           and buf_doc-line-attr.gds-code  = p-gds-code
      339           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      340         no-error .
      341       if not available buf_doc-line-attr then do:
      342         create buf_doc-line-attr .
      343         assign
      344           buf_doc-line-attr.doc-code  = p-doc-code
      345           buf_doc-line-attr.gds-code  = p-gds-code
      346           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      347         .
      348       end.
      349       assign
      350         buf_doc-line-attr.attr-value = string( p-value )
      351       .
      352     end.
      353   end procedure.
      354   procedure lineattr-delete-flora-gds :
      355     do
      356     on error undo, return error return-value
      357     :
      358       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      359       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      360       define input  parameter p-prt-code    as integer   no-undo .
      361       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      362       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      363       define output parameter p-deleted  as logical no-undo.
      364       define buffer buf_doc-line-attr for ub.doc-line-attr .
      365       find first buf_doc-line-attr exclusive-lock
      366         where buf_doc-line-attr.doc-code  = p-doc-code
      367           and buf_doc-line-attr.gds-code  = p-gds-code
      368           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      369         no-error NO-WAIT.
      370       if not available buf_doc-line-attr then do:
      371         p-deleted = no.
      372       end.
      373       else do:
      374         delete buf_doc-line-attr.
      375         p-deleted = yes.
      376       end.
      377     end.
      378   end procedure.
      379   procedure lineattr-delete-flora-all :
      380     do
      381     on error undo, return error return-value
      382     :
      383       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      384       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      385       define input  parameter p-prt-code    as integer   no-undo .
      386       define buffer buf_doc-line-attr for ub.doc-line-attr .
      387       for each buf_doc-line-attr exclusive-lock
      388         where buf_doc-line-attr.doc-code  = p-doc-code
      389           and buf_doc-line-attr.gds-code  = p-gds-code
      390           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      391        :
      392         delete buf_doc-line-attr.
      393       end.
      394    end.
      395   end procedure.
      396   procedure lineattr-exist-flora-gds :
      397     do
      398     on error undo, return error return-value
      399     :
      400       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      401       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      402       define input  parameter p-prt-code    as integer   no-undo .
      403       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      404       define output parameter p-exist as logical   no-undo .
      405       define buffer buf_doc-line-attr for ub.doc-line-attr .
      406       p-exist = false .
      407       find first buf_doc-line-attr no-lock
      408         where buf_doc-line-attr.doc-code  = p-doc-code
      409           and buf_doc-line-attr.gds-code  = p-gds-code
      410           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      411         no-error .
      412       if avail buf_doc-line-attr then do:
      413         assign
      414          p-exist = true
      415         .
      416       end.
      417     end.
      418   end procedure.
      419   procedure lineattr-write-add-line-cli :
      420   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      421   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      422   define input  parameter p-cli-type      as character no-undo .
      423   define input  parameter p-cli-code      as integer   no-undo .
      424   define input  parameter p-contract-code as integer   no-undo .
      425   define input  parameter p-host-code     as integer   no-undo .
      426   define input  parameter p-exch-code     as integer   no-undo .
      427   define input  parameter p-exch-rate     as decimal   no-undo .
      428   define input  parameter p-exch-scale    as integer   no-undo .
      429   define input  parameter p-sum-cli       as decimal   no-undo .
      430   define input  parameter p-sum-vat       as decimal   no-undo .
      431   define buffer buf_doc-line-attr for ub.doc-line-attr .
      432     do
      433     on error undo, return error return-value
      434     :
      435       find first buf_doc-line-attr exclusive-lock
      436         where buf_doc-line-attr.doc-code  = p-doc-code
      437           and buf_doc-line-attr.gds-code  = p-gds-code
      438           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      439                                             chr(4) + p-cli-type +
      440                                             chr(4) + string(p-cli-code) +
      441                                             chr(4) + string(p-contract-code) +
      442                                             chr(4) + string(p-host-code)
      443         no-error .
      444       if not available buf_doc-line-attr then do:
      445         create buf_doc-line-attr .
      446         assign
      447           buf_doc-line-attr.doc-code  = p-doc-code
      448           buf_doc-line-attr.gds-code  = p-gds-code
      449           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      450                                         chr(4) + p-cli-type +
      451                                         chr(4) + string(p-cli-code) +
      452                                         chr(4) + string(p-contract-code) +
      453                                         chr(4) + string(p-host-code)
      454         .
      455       end.
      456       assign
      457         buf_doc-line-attr.attr-value =
      458         string(p-exch-code)  + chr(4) +
      459         string(p-exch-rate)  + chr(4) +
      460         string(p-exch-scale) + chr(4) +
      461         string(p-sum-cli)    + chr(4) +
      462         string(p-sum-vat)
      463         .
      464     end.
      465   end procedure.
      466   procedure lineattr-value-add-line-cli :
      467   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      468   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      469   define input   parameter p-cli-type      as character no-undo .
      470   define input   parameter p-cli-code      as integer   no-undo .
      471   define input   parameter p-contract-code as integer   no-undo .
      472   define input   parameter p-host-code     as integer   no-undo .
      473   define output  parameter p-exch-code     as integer   no-undo .
      474   define output  parameter p-exch-rate     as decimal   no-undo .
      475   define output  parameter p-exch-scale    as integer   no-undo .
      476   define output  parameter p-sum-cli       as decimal   no-undo .
      477   define output  parameter p-sum-vat       as decimal   no-undo .
      478   define buffer buf_doc-line-attr for ub.doc-line-attr .
      479     do
      480     on error undo, return error return-value
      481     :
      482       find first buf_doc-line-attr exclusive-lock
      483         where buf_doc-line-attr.doc-code  = p-doc-code
      484           and buf_doc-line-attr.gds-code  = p-gds-code
      485           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      486                                             chr(4) + p-cli-type +
      487                                             chr(4) + string(p-cli-code) +
      488                                             chr(4) + string(p-contract-code) +
      489                                             chr(4) + string(p-host-code)
      490         no-error .
      491       if available buf_doc-line-attr then do:
      492        assign
      493           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      494           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      495           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      496           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      497           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      498          .
      499        end.
      500     end.
      501   end procedure.
      502   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      503     define variable v-code as character no-undo .
      504     define variable v-type as character no-undo .
      505     define variable v-gds-code as integer   no-undo .
      506   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      508     (input  local-doc-line.artic
      509     ,input  local-doc-line.prod-type
      510     ,input  local-doc-line.prod-code
      511     ,output v-gds-code
      512     )  .
      513     run lineattr-value (
      514         input   local-doc-line.doc-code ,
      515         input   v-gds-code              ,
      516         input   'reason-code':U ,
      517         output  v-code                  ,
      518         output  v-type ) .
      519     find first ub.trn-reason no-lock where
      520                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      521     if not available ub.trn-reason then do:
      522        return "" .
      523     end.
      524     else do:
      525        return ub.trn-reason.reason-name .
      526     end.
      527   end function.
      528   procedure lineattr-value-parts :
      529     do
      530     on error undo, return error return-value
      531     :
      532       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      533       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      534       define input  parameter p-part-code   as character no-undo .
      535       define input  parameter p_in-code     as character no-undo .
      536       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      537       define output parameter p-value       as    decimal   no-undo .
      538       define buffer buf_doc-line-attr for ub.doc-line-attr .
      539       find first buf_doc-line-attr no-lock
      540         where buf_doc-line-attr.doc-code  = p-doc-code
      541           and buf_doc-line-attr.gds-code  = p-gds-code
      542           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      543         no-error .
      544       if avail buf_doc-line-attr then do:
      545         assign
      546           p-value = decimal( buf_doc-line-attr.attr-value)
      547         .
      548       end.
      549       else do:
      550         assign
      551           p-value = 0
      552         .
      553       end.
      554     end.
      555   end procedure.
      556   procedure lineattr-write-parts :
      557     do
      558     on error undo, return error return-value
      559     :
      560       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      561       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      562       define input parameter p-part-code  as character no-undo .
      563       define input parameter p_in-code    as character no-undo .
      564       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      565       define input parameter p-value      as decimal   no-undo .
      566       define buffer buf_doc-line-attr for ub.doc-line-attr .
      567       find first buf_doc-line-attr exclusive-lock
      568         where buf_doc-line-attr.doc-code  = p-doc-code
      569           and buf_doc-line-attr.gds-code  = p-gds-code
      570           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      571         no-error .
      572       if not available buf_doc-line-attr then do:
      573         create buf_doc-line-attr .
      574         assign
      575           buf_doc-line-attr.doc-code  = p-doc-code
      576           buf_doc-line-attr.gds-code  = p-gds-code
      577           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      578         .
      579       end.
      580       assign
      581         buf_doc-line-attr.attr-value = string( p-value )
      582       .
      583     end.
      584   end procedure.
      585   define buffer buf_trn-doc        for ub.trn-doc .
      586   define buffer buf_parts          for ub.parts .
      587   define buffer buf_doc-line       for ub.doc-line .
      588   define buffer buf_parts-attr     for ub.parts-attr .
      589   define buffer new_parts-attr     for ub.parts-attr .
      590   define buffer buf_parts-root     for ub.parts-root .
      591   define buffer buf_income_trn-doc for ub.trn-doc .
      592       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      593       define buffer   in-vatp-parts    for ub.parts   .
      594       define buffer   in-vatp-doc      for ub.trn-doc .
      595       define buffer   in-vatp-goods    for ub.goods   .
      596       define buffer   in-vatp-sysconf  for ub.sysconf .
      597       define buffer   in-vatp_doc-attr for ub.doc-attr.
      598       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      599       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      600       define variable varinvprb                  as   character              no-undo.
      601       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      602       define variable cli-base-rate              as   decimal                no-undo.
      603       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      604       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      605       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      606       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      607       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      608       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      609       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      610       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      611       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      612       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      613       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      614       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      615       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      616       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      617       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      618       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      619       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      620       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      621       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      622       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      623       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      624       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      625       define variable varinvatp-envd             as   character              no-undo.
      626       define variable varinvatp-type             as   character              no-undo.
      627   define stream sout .
      628   do
      629   on error undo, return error return-value
      630   :
      631     find first buf_trn-doc
      632       where buf_trn-doc.doc-code = p-doc-code
      633       no-error .
      634     if not available buf_trn-doc
      635     then do:
      636       message
      637         vss-workfile vss-revision vss-description skip
      638         "Ошибка задания входных параметров" skip
      639         "Не найден документ" skip
      640         "Документ" p-doc-code skip
      641         view-as alert-box error .
      642       undo, return error return-value .
      643     end.
      644     for each buf_doc-line
      645       where buf_doc-line.doc-code = p-doc-code
      646     on error undo, return error return-value
      647     :
      648       define variable v-gds-code as integer   no-undo .
      649   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run doclicod in g#library
      651     (input  recid(buf_doc-line)
      652     ,output v-gds-code
      653     )  .
      654       define variable v-country-code as integer   no-undo .
      655       run get-country-code in this-procedure
      656         (input  buf_trn-doc.doc-code
      657         ,input  buf_trn-doc.ext-doc-type
      658         ,input  v-gds-code
      659         ,output v-country-code
      660         ) .
      661       define variable v-obj-type  as character no-undo .
      662       define variable v-obj-code  as integer   no-undo .
      663       define variable v-artic     as character no-undo .
      664       define variable v-prod-type as character no-undo .
      665       define variable v-prod-code as integer   no-undo .
      666       assign
      667         v-obj-type  = buf_doc-line.obj-type
      668         v-obj-code  = buf_doc-line.obj-code
      669         v-artic     = buf_doc-line.artic
      670         v-prod-type = buf_doc-line.prod-type
      671         v-prod-code = buf_doc-line.prod-code
      672       .
      673       for each buf_parts
      674         where buf_parts.out-code  = p-doc-code
      675           and buf_parts.obj-type  = v-obj-type
      676           and buf_parts.obj-code  = v-obj-code
      677           and buf_parts.artic     = v-artic
      678           and buf_parts.prod-type = v-prod-type
      679           and buf_parts.prod-code = v-prod-code
      680           and buf_parts.status_   = true
      681       on error undo, return error return-value
      682       :
      683         find first buf_parts-attr no-lock
      684           where buf_parts-attr.in-code   = buf_parts.in-code
      685             and buf_parts-attr.gds-code  = v-gds-code
      686             and buf_parts-attr.part-code = buf_parts.part-code
      687           no-error .
      688         if not available buf_parts-attr
      689         then do:
      690           if buf_parts.in-code = buf_parts.out-code
      691           or (buf_trn-doc.ext-doc-type = 'ie':U and index(buf_trn-doc.doc-code, "=") > 0 and p-create-all = false)
      692           then do:
      693             if buf_trn-doc.ext-doc-type = 'ap':U
      694             or buf_trn-doc.ext-doc-type = 'pc':U
      695             then do:
      696               find first buf_parts-root
      697                 where buf_parts-root.in-code   = buf_parts.in-code
      698                   and buf_parts-root.gds-code  = v-gds-code
      699                   and buf_parts-root.part-code = buf_parts.part-code
      700                 no-error .
      701               if not available buf_parts-root
      702               then do:
      703                 message
      704                   vss-workfile vss-revision vss-description skip
      705                   "Не найдена информация об исходной партии" skip
      706                   "Документ" p-doc-code skip
      707                   "Код товара" v-gds-code skip
      708                   "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      709                   "Код партии" buf_parts.in-code buf_parts.part-code skip
      710                   view-as alert-box error .
      711                 undo, return error return-value .
      712               end.
      713               find first buf_parts-attr
      714                 where buf_parts-attr.in-code   = buf_parts-root.orig-in-code
      715                   and buf_parts-attr.gds-code  = buf_parts-root.orig-gds-code
      716                   and buf_parts-attr.part-code = buf_parts-root.orig-part-code
      717                 no-error .
      718               if not available buf_parts-attr
      719               then do:
      720                 find first buf_income_trn-doc no-lock
      721                   where buf_income_trn-doc.doc-code = buf_parts-root.orig-in-code
      722                   no-error .
      723                 if available buf_income_trn-doc
      724                 then do:
      725                   run trg/prtatrcr.p
      726                     (input buf_income_trn-doc.doc-code
      727                     ,input true
      728                     ) .
      729                 end.
      730                 find first buf_parts-attr
      731                   where buf_parts-attr.in-code   = buf_parts-root.orig-in-code
      732                     and buf_parts-attr.gds-code  = buf_parts-root.orig-gds-code
      733                     and buf_parts-attr.part-code = buf_parts-root.orig-part-code
      734                   no-error .
      735               end.
      736               if available buf_parts-attr
      737               then do:
      738                 create new_parts-attr .
      739                 buffer-copy buf_parts-attr to new_parts-attr
      740                 assign
      741                   new_parts-attr.in-code        = buf_parts.in-code
      742                   new_parts-attr.gds-code       = v-gds-code
      743                   new_parts-attr.part-code      = buf_parts.part-code
      744                   new_parts-attr.orig-in-code   = buf_parts-attr.in-code
      745                   new_parts-attr.orig-gds-code  = buf_parts-attr.gds-code
      746                   new_parts-attr.orig-part-code = buf_parts-attr.part-code
      747                 .
      748                 if buf_trn-doc.ext-doc-type = 'ap':U
      749                 then do:
      750                   assign
      751                     new_parts-attr.base-scale = 1
      752                   .
      753                   if buf_parts.price-base <> 0
      754                   then do:
      755                     assign
      756                       new_parts-attr.base-rate = (buf_parts.price-rubl * new_parts-attr.base-scale) / buf_parts.price-base
      757                     .
      758                   end.
      759                   else do:
      760                     assign
      761                       new_parts-attr.base-rate = 1
      762                     .
      763                   end.
      764                   assign
      765                     new_parts-attr.cli-qnty         = buf_parts.cli-qnty
      766                     new_parts-attr.price-cli        = buf_parts.price-cli
      767                     new_parts-attr.price-base       = buf_parts.price-base
      768                     new_parts-attr.price-rubl       = buf_parts.price-rubl
      769                     new_parts-attr.vat-type         = buf_parts.vat-type
      770                     new_parts-attr.vat-pc           = buf_parts.vat-pc
      771                     new_parts-attr.SLT-type         = buf_parts.SLT-type
      772                     new_parts-attr.SLT-pc           = buf_parts.SLT-pc
      773                     new_parts-attr.road-tax-base    = buf_parts.road-tax-base
      774                     new_parts-attr.road-tax-rubl    = buf_parts.road-tax-rubl
      775                     new_parts-attr.transport-base   = buf_parts.transport-base
      776                     new_parts-attr.transport-rubl   = buf_parts.transport-rubl
      777                     new_parts-attr.other-base       = buf_parts.other-base
      778                     new_parts-attr.other-rubl       = buf_parts.other-rubl
      779                   .
      780   assign
      781     price-rubl-with-tax-loc = buf_parts.price-rubl
      782     price-base-with-tax-loc = buf_parts.price-base
      783   .
      784   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      785   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      786     (output varinvprb
      787     )  .
      788     if buf_parts.out-code = 'free-zone':U     or
      789        buf_parts.out-code = 'out-zone':U   or
      790        buf_parts.doc-type = 'акт':U then do:
      791       assign
      792         in-vatp-have-vat-slt = yes.
      793     end.
      794     else do:
      795       find first in-vatp_doc-attr no-lock
      796         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      797           and in-vatp_doc-attr.attr-code = 'envd':U
      798         no-error .
      799       if not available in-vatp_doc-attr then do:
      800         assign
      801           in-vatp-have-vat-slt = yes.
      802       end.
      803       else do:
      804            in-vatp-have-vat-slt = no.
      805       end.
      806     end.
      807     assign
      808      price-cli-with-tax-loc = buf_parts.price-cli
      809      cli-base-rate          = buf_parts.cli-base-rate.
      810     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      811              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      812     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      813             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      814             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      815             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      816             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      817             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      818             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      819       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      820     assign
