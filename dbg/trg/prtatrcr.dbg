      948   assign
      949     price-rubl-with-tax-loc = buf_parts.price-rubl
      950     price-base-with-tax-loc = buf_parts.price-base
      951   .
      952   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      953   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      954     (output varinvprb
      955     )  .
      956     if buf_parts.out-code = 'free-zone':U     or
      957        buf_parts.out-code = 'out-zone':U   or
      958        buf_parts.doc-type = 'акт':U then do:
      959       assign
      960         in-vatp-have-vat-slt = yes.
      961     end.
      962     else do:
      963       find first in-vatp_doc-attr no-lock
      964         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      965           and in-vatp_doc-attr.attr-code = 'envd':U
      966         no-error .
      967       if not available in-vatp_doc-attr then do:
      968         assign
      969           in-vatp-have-vat-slt = yes.
      970       end.
      971       else do:
      972            in-vatp-have-vat-slt = no.
      973       end.
      974     end.
      975     assign
      976      price-cli-with-tax-loc = buf_parts.price-cli
      977      cli-base-rate          = buf_parts.cli-base-rate.
      978     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      979              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      980     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      981             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      982             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      983             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      984             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      985             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      986             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      987       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      988     assign
