        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.place.
        3   define variable vss-revision    as character no-undo initial "$Revision: 72f0e5104d0d, 1337, rls $":U.
        4   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U.
        5   define variable vss-date        as character no-undo initial "$Date: Sat Apr 28 13:31:57 2018 +0300 $":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile: placed.p $":U.
        7   define variable vss-archive     as character no-undo initial "$Archive: trg/placed.p $":U.
        8   define variable vss-description as character no-undo initial "Триггер на удаление place":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3'
       29                            , ub.place.obj-type
       30                            , ub.place.obj-code
       31                            , ub.place.pl-code
       32                            )
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure cur-time :
       87      define output parameter p-today as date      no-undo .
       88      define output parameter p-time  as integer   no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       define variable v-date1 as date      no-undo .
       93       define variable v-date2 as date      no-undo .
       94       define variable v-time  as integer   no-undo .
       95       assign
       96         v-date1 = today
       97         v-time  = time
       98         v-date2 = today
       99       .
      100       if v-date1 <> v-date2
      101       then do:
      102         assign
      103           v-date1 = today
      104           v-time  = v-time
      105         .
      106       end.
      107       assign
      108         p-today = v-date1
      109         p-time  = v-time
      110       .
      111     end.
      112   end.
      113   function cur-time-date returns character
      114   :
      115     return string(today, '99/99/9999':U) .
      116   end.
      117   function cur-time-mjd returns decimal
      118   :
      119     define variable v-date as date      no-undo .
      120     define variable v-time as integer   no-undo .
      121     run cur-time in this-procedure
      122       (output v-date
      123       ,output v-time
      124       ) .
      125     return integer(v-date) - 2400002 + (v-time / 86400) .
      126   end.
      127   function cur-time-get-ending-index returns integer
      128   (input p-number as integer
      129   )
      130   :
      131     if p-number < 0
      132     or p-number = ?
      133     then do:
      134       return 1 .
      135     end.
      136     define variable v-rest as integer   no-undo .
      137     assign
      138       p-number = p-number modulo 100
      139     .
      140     if p-number < 20
      141     then do:
      142       assign
      143         v-rest = p-number
      144       .
      145     end.
      146     else do:
      147       assign
      148         v-rest = p-number modulo 10
      149       .
      150     end.
      151     case v-rest :
      152       when 1
      153       then do:
      154         return 2 .
      155       end.
      156       when 2 or
      157       when 3 or
      158       when 4
      159       then do:
      160         return 3 .
      161       end.
      162       otherwise do:
      163         return 1 .
      164       end.
      165     end case .
      166   end.
      167   procedure cur-time-mjd-to-date :
      168      define input  parameter i-mjd-diff as decimal no-undo.
      169      define output parameter o-Date     as date    no-undo.
      170      define output parameter o-Time     as integer no-undo.
      171      define variable v-day-number as integer   no-undo .
      172      if    i-mjd-diff < 0
      173         or i-mjd-diff = ?
      174      then do:
      175         return "?" .
      176      end.
      177      assign
      178         v-day-number = truncate(i-mjd-diff,0).
      179         o-Date = date(v-day-number + 2400002).
      180         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      181     .
      182   end.
      183   function cur-time-mjd-to-string returns character
      184   (input p-mjd-diff as decimal
      185   )
      186   :
      187     define variable v-day-number as integer   no-undo .
      188     define variable v-seconds    as integer   no-undo .
      189     define variable v-hour       as integer   no-undo .
      190     define variable v-min        as integer   no-undo .
      191     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      192     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      193     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      194     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      195     if p-mjd-diff < 0
      196     or p-mjd-diff = ?
      197     then do:
      198       return "?" .
      199     end.
      200     assign
      201       v-day-number = integer(truncate(p-mjd-diff,0))
      202       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204     if v-seconds > 86400
      205     then do:
      206       assign
      207         v-seconds = 86400 - 1
      208       .
      209     end.
      210     if v-seconds < 0
      211     then do:
      212       assign
      213         v-seconds = 0
      214       .
      215     end.
      216     assign
      217       v-hour = truncate(v-seconds / 3600, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 3600
      221     .
      222     assign
      223       v-min = truncate(v-seconds / 60, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 60
      227     .
      228     return
      229         (if v-day-number <> 0
      230           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0
      234           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      238           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      239           else ""
      240         )
      241       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      242       .
      243   end.
      244   function cur-time-string returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      253   end.
      254   function cur-time-string-sec returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      263   end.
      264   function cur-time-custom  returns character
      265   (input p-prefix as character
      266   ,input p-date-format as character
      267   ,input p-delimiter as character
      268   ,input p-time-format as character
      269   ,input p-suffix as character
      270   )
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return
      279       p-prefix
      280       + string(v-date, p-date-format)
      281       + p-delimiter
      282       + string(v-time, p-time-format)
      283       + p-suffix
      284       .
      285   end.
      286   function cur-time-print  returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-datetime returns datetime
      297   :
      298     define variable v-char as character no-undo .
      299     define variable v-datetime as datetime no-undo .
      300     v-char = cur-time-string().
      301     v-datetime = datetime(v-char).
      302     return  v-datetime.
      303   end.
      304   function cur-time-string-msec returns character
      305   :
      306     define variable v-date as datetime  no-undo .
      307     v-date = now.
      308     return string(v-date) .
      309   end.
      310   define variable str1    as character no-undo.
      311   define variable jj      as integer   no-undo.
      312   DEFINE VARIABLE v-today as date      no-undo .
      313   DEFINE VARIABLE v-time  as integer   no-undo .
      314   define buffer buf_c-place    for ub.c-place.
      315   define buffer buf_c-plc-hist for ub.c-plc-hist.
      316   main-block:
      317   do
      318       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      319       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      320       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      321       :
      322       do on error   undo Main-Block, return error return-value
      323           on end-key undo Main-Block, return error return-value
      324           on stop    undo Main-Block, return error return-value :
      325           find first ub.pl-gds where
      326               ub.pl-gds.obj-type  =  ub.place.obj-type and
      327               ub.pl-gds.obj-code  =  ub.place.obj-code and
      328               ub.pl-gds.pl-code   =  ub.place.pl-code  and
      329               ( ub.pl-gds.fact-qnty <> 0                 or
      330               ub.pl-gds.free-qnty <> 0 )               no-error.
      331           if available ub.pl-gds then
      332           do:
      333               message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      334                   "На месте хранения имеется товар!" skip
      335                   "Удаление невозможно!" skip
      336                   "Объект" ub.place.obj-type ub.place.obj-code skip
      337                   "Код места хранения" ub.place.pl-code skip
      338                   "Внутренний код товара" ub.pl-gds.gds-code skip
      339                   view-as alert-box error.
      340               undo Main-Block, return error.
      341           end.
      342           for each ub.pl-gds where
      343               ub.pl-gds.pl-code  = ub.place.pl-code  and
      344               ub.pl-gds.obj-type = ub.place.obj-type and
      345               ub.pl-gds.obj-code = ub.place.obj-code
      346               on error   undo Main-Block, return error
      347               on end-key undo Main-Block, return error
      348               on stop    undo Main-Block, return error :
      349               delete ub.pl-gds.
      350           end.
      351           for each ub.pl-pump where
      352               ub.pl-pump.pl-code  = ub.place.pl-code  and
      353               ub.pl-pump.obj-type = ub.place.obj-type and
      354               ub.pl-pump.obj-code = ub.place.obj-code
      355               on error   undo Main-Block, return error
      356               on end-key undo Main-Block, return error
      357               on stop    undo Main-Block, return error :
      358               delete ub.pl-pump.
      359           end.
      360           if not g#news then
      361           do:
      362               run nws/cmd-del.p ( input 'place':U
      363                   , input ( buffer ub.place :handle )
      364                   , input "":U ) no-error.
      365               if error-status :error then
      366               do:
      367                   assign
      368                       str1 = chr(10).
      369                   do jj = 1 to error-status :num-messages :
      370                       assign
      371                           str1 = str1 + chr(10) + error-status :get-message ( jj ).
      372                   end.
      373                   undo Main-Block, return error
      374                       substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&4",
      375                       vss-workfile, chr(10), return-value, str1 ).
      376               end.
      377           end.
      378       end.
      379       if not g#news then
      380       do:
      381           run cur-time in this-procedure(output v-today, output v-time).
      382           create buf_c-place.
      383           buffer-copy ub.place to buf_c-place.
      384           assign
      385               buf_c-place.chip-num         = next-value (s-plc-chip, ub)
      386               buf_c-place.corr-time        = v-time
      387               buf_c-place.corr-user-db-num = g#db-num
      388               buf_c-place.corr-user-name   = g#userid
      389               buf_c-place.corr-date        = v-today
      390               .
      391           create buf_c-plc-hist.
      392           buffer-copy buf_c-place to buf_c-plc-hist
      393               assign
      394               buf_c-plc-hist.action =  integer('99':U)
      395               buf_c-plc-hist.subject = 'place':U
      396               buf_c-plc-hist.is-news = g#news
      397               buf_c-plc-hist.gds-code = ?
      398               .
      399       end.
      400       run trg/userlog.p (
      401           input 'delete':U
      402           , input 'c-place':U
      403           , input ( buffer buf_c-place :handle )
      404           , input ?
      405           , input ""
      406           ) no-error.
      407       if error-status :error
      408           then
      409       do:
      410           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      411               , chr(10)
      412               , vss-workfile
      413               , return-value
      414               , error-status :get-message ( 1 ) ).
      415       end.
      416       if g#oxml = yes
      417           then
      418       do:
      419           run str/calloxml.p (
      420               input 'delete':U
      421               , input 'place':U
      422               , input ( buffer ub.place:handle )
      423               ) no-error.
      424           if error-status :error
      425               then
      426           do:
      427               undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      428                   , chr(10)
      429                   , vss-workfile
      430                   , return-value
      431                   , error-status :get-message ( 1 ) ).
      432           end.
      433       end.
      434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      435     (input ?
      436     ,input this-procedure:handle
      437     ,input ?
      438     ,input 'ref-event':U
      439     ,input  buffer ub.place:handle
      440     ,input ''
      441     ,input ''
      442     ,input ''
      443     ) no-error .
      444       if error-status :error
      445           then
      446       do:
      447           return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
      448               , chr(10)
      449               , vss-workfile
      450               , return-value
      451               , error-status :get-message ( 1 ) ).
      452       end.
      453   define buffer buf_place-attr for ub.place-attr .
      454   for each buf_place-attr exclusive-lock where
      455               buf_place-attr.pl-code  = ub.place.pl-code  and
      456               buf_place-attr.obj-type = ub.place.obj-type and
      457               buf_place-attr.obj-code = ub.place.obj-code:
      458               delete buf_place-attr.
      459   end.
      460   end.
