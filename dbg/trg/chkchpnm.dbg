        1   block-level on error undo, throw.
        2   define input parameter p-doc-code   as character no-undo .
        3   define input parameter p-chip-num   as integer   no-undo .
        4   define input parameter p-table-name as character no-undo .
        5   define input parameter p-recid      as integer   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Проверка уникальности кода скорректированного документа".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2|&3|&4',p-doc-code,p-chip-num,p-table-name,p-recid)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   main-block:
       70   do
       71   on error undo main-block, return error
       72   :
       73     if lookup(p-table-name, "c-trn-doc,c-price-doc,c-rvs-doc":u) = 0 then do:
       74       message
       75         vss-workfile vss-revision vss-description skip
       76         "Ошибка задания входных параметров" skip
       77         "Неизвестный тип таблицы p-table-name" skip
       78         "p-doc-code"    p-doc-code   skip
       79         "p-chip-num"    p-chip-num   skip
       80         "p-table-name"  p-table-name skip
       81         "p-recid"       p-recid      skip
       82         view-as alert-box error .
       83       undo main-block, return error .
       84     end.
       85     find first ub.c-trn-doc no-lock
       86       where ub.c-trn-doc.doc-code = p-doc-code
       87         and ub.c-trn-doc.chip-num = p-chip-num
       88         and recid(ub.c-trn-doc) <> p-recid
       89       no-error .
       90     if available ub.c-trn-doc then do:
       91       message
       92         vss-workfile vss-revision vss-description skip
       93         "Неправильный номер документа" skip
       94         "Уже существует скорректированый складской документ " ub.c-trn-doc.doc-code  " " ub.c-trn-doc.chip-num
       95         " с физическим номером " recid(ub.c-trn-doc) skip
       96         "p-table-name" p-table-name skip
       97         "p-recid" p-recid skip
       98         view-as alert-box error .
       99       undo, return error .
      100     end.
      101     find first ub.c-price-doc no-lock
      102       where ub.c-price-doc.doc-num  = p-doc-code
      103         and ub.c-price-doc.chip-num = p-chip-num
      104         and recid(ub.c-price-doc) <> p-recid
      105       no-error .
      106     if available ub.c-price-doc then do:
      107       message
      108         vss-workfile vss-revision vss-description skip
      109         "Неправильный номер документа" skip
      110         "Уже существует скорректированная переоценка " ub.c-price-doc.doc-num " " ub.c-price-doc.chip-num
      111         " с физическим номером " recid(ub.c-price-doc) skip
      112         "p-table-name" p-table-name skip
      113         "p-recid" p-recid skip
      114         view-as alert-box error .
      115       undo, return error .
      116     end.
      117     find first ub.c-rvs-doc no-lock
      118       where ub.c-rvs-doc.rvs-code = p-doc-code
      119         and ub.c-rvs-doc.chip-num = p-chip-num
      120         and recid(ub.c-rvs-doc) <> p-recid
      121       no-error .
      122     if available ub.c-rvs-doc then do:
      123       message
      124         vss-workfile vss-revision vss-description skip
      125         "Неправильный номер документа" skip
      126         "Уже существует скорректированная сверка " ub.c-rvs-doc.rvs-code " " ub.c-rvs-doc.chip-num
      127         " с физическим номером " recid(ub.c-rvs-doc) skip
      128         "p-table-name" p-table-name skip
      129         "p-recid" p-recid skip
      130         view-as alert-box error .
      131       undo, return error .
      132     end.
      133   end.
