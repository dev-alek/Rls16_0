        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-s-coeff.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Òğèããåğ íà çàïèñü èñòîğèè ÑÅÇÎÍÍÛÕ ÊÎİÔÔÈÖÈÅÍÒÎÂ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7'
       29                            , ub.c-s-coeff.gds-code
       30                            , ub.c-s-coeff.host-code
       31                            , ub.c-s-coeff.obj-type
       32                            , ub.c-s-coeff.obj-code
       33                            , ub.c-s-coeff.s-date
       34                            , ub.c-s-coeff.corr-user-db-num
       35                            , ub.c-s-coeff.chip-num
       36                            )
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable v-db-num like ub.db.db-num no-undo .
       90   define buffer buf_s-coeff for ub.s-coeff.
       91   define buffer buf_c-gds-hist for ub.c-gds-hist.
       92   main-block:
       93   do
       94   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       95   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       96   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       97   :
       98     if not g#news then do:
       99       find first buf_c-gds-hist no-lock where
      100                 buf_c-gds-hist.gds-code = c-s-coeff.gds-code
      101              AND buf_c-gds-hist.obj-type = c-s-coeff.obj-type
      102              AND buf_c-gds-hist.obj-code = c-s-coeff.obj-code
      103              AND buf_c-gds-hist.host-code = c-s-coeff.host-code
      104              AND buf_c-gds-hist.chip-num = c-s-coeff.chip-num
      105              AND buf_c-gds-hist.corr-user-db-num = c-s-coeff.corr-user-db-num no-error .
      106       if buf_c-gds-hist.action <> integer('99':U) then do:
      107         find first buf_s-coeff no-lock where
      108                   buf_s-coeff.obj-type = c-s-coeff.obj-type
      109               AND buf_s-coeff.obj-code = c-s-coeff.obj-code
      110               AND buf_s-coeff.host-code = c-s-coeff.host-code
      111               AND buf_s-coeff.gds-code = c-s-coeff.gds-code
      112               AND buf_s-coeff.s-date = c-s-coeff.s-date
      113                   no-error .
      114         if not available buf_s-coeff then do:
      115           message
      116           vss-workfile vss-revision vss-description skip
      117           "Íåïğàâèëüíàÿ ññûëêà íà ÑÅÇÎÍÍÛÉ ÊÎİÔÔÈÖÈÅÍÒ ÒÎÂÀĞÀ" skip
      118           "Ôèğìà" c-s-coeff.host-code
      119           "îáúåêò" c-s-coeff.obj-type  c-s-coeff.obj-code
      120           "Òîâàğ" c-s-coeff.gds-code
      121           "Äàòà" c-s-coeff.s-date
      122           view-as alert-box error .
      123           undo main-block, return error.
      124         end.
      125       end.
      126     end.
      127     if NOT (c-s-coeff.obj-type  = "":U
      128             AND c-s-coeff.obj-code = 0) then do:
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      131     (input  ub.c-s-coeff.obj-type
      132     ,input  ub.c-s-coeff.obj-code
      133     ,output v-db-num
      134     )  .
      135      if not g#news and g#db-num <> v-db-num and g#db-num <> 0 then do:
      136         message
      137         vss-workfile vss-revision vss-description skip
      138         "Íåëüçÿ èçìåíÿòü çàïèñü ÈÑÒÎĞÈÈ ÑÅÇÎÍÍÎÃÎ ÊÎİÔÔÈÖÈÅÍÒÀ ÒÎÂÀĞÀ ÍÀ ÎÁÚÅÊÒÅ â ÁÄ, îòëè÷íîé îò ÁÄ îáúåêòà, åñëè îíà íå ÃÁÄ" skip
      139         "Íîìåğ òåêóùåé ÁÄ" g#db-num "Íîìåğ ÁÄ îáúåêòà" v-db-num
      140         view-as alert-box error .
      141         undo, return error .
      142       end.
      143     end.
      144    if
      145     not g#news
      146     OR (g#news
      147         and not ( g#db-num > 0 )
      148         and ub.c-s-coeff.corr-user-name <> (chr(4) +  'ÑÏÍ':U)
      149         )
      150     or (g#news
      151         and ( g#db-num > 0 )
      152         and ub.c-s-coeff.corr-user-name = (chr(4) +  'ÑÏÍ':U)
      153         )
      154     then do:
      155       run str/callnews.p
      156         (input "c-s-coeff"
      157         ,input (buffer ub.c-s-coeff:handle)
      158         ).
      159     end.
      160       if g#oxml = yes
      161       then do:
      162       run str/calloxml.p (
      163             input 'update':U
      164           , input 'c-s-coeff':U
      165           , input ( buffer ub.c-s-coeff:handle )
      166       ) no-error.
      167       if error-status :error
      168       then do:
      169           undo, return error substitute( "&2&1Îøèáêà ïğè îòïğàâêå çàïèñè â ñèñòåìó OpenXML&1&3&1&4"
      170                                , chr(10)
      171                                , vss-workfile
      172                                , return-value
      173                                , error-status :get-message ( 1 ) ).
      174       end.
      175       end.
      176   end.
