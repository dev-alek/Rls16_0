      415     define input  parameter p-code     like ub.goods.gds-code   no-undo .
      416     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
      417     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
      418     define output parameter p-gds-code like ub.goods.gds-code   no-undo .
      419     define output parameter p-dt-code  as   integer             no-undo .
      420     do
      421     on error undo, return error
      422     :
      423           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-code-dt-seasons in g#attr-lib
      424         (input p-code
      425         ,input p-obj-type
      426         ,input p-obj-code
      427         ,output p-gds-code
      428         ,output p-dt-code
      429         ) no-error .
      430       if error-status :error
      431       then do:
      432         undo, return error return-value .
      433       end.
      434     end.
      435   end.
      436   do
      437   on error undo, return error
      438   :
      439     find first buf_sys-ctrl no-lock .
      440     assign
      441     v-db-num = buf_sys-ctrl.db-num
      442     .
      443     find first buf_goods No-LOCK where
      444                buf_goods.gds-code = p-gds-code.
      445     find first buf_units No-lock where
      446                buf_units.unit-name = buf_goods.unit-base.
      447     if lookup('вес':U, buf_units.type) = 0
      448     and lookup('шту':U, buf_units.type) = 0
      449     then do:
      450       assign
      451       v-msg = substitute("Товар код товара: &1 не весовой и не штучный", buf_goods.gds-code)
      452       .
      453       run log-msg in this-procedure ( input-output (v-msg)).
      454       return error v-msg.
      455     end.
      456   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      457     (input  buf_goods.gds-code
      458     ,input  ?
      459     ,output v-main-b-code
      460     )  .
      461     find first buf_prod-bc share-lock where
      462                buf_prod-bc.b-str = p-b-str.
      463   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      464   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      465     (buffer buf_prod-bc
      466     ,input  'glogbal=request':u
      467     ,output l-prod-bc-glob
      468     ) no-error .
      469     if error-status:error or
      470     not l-prod-bc-glob then do:
      471       assign
      472       v-msg = substitute("Товар код товара: &1 ДопБК &2 ГЛОБАЛЬНЫЙ", buf_goods.gds-code, buf_prod-bc.b-str)
      473       .
      474       run log-msg in this-procedure ( input-output (v-msg)).
      475       return error v-msg.
      476     end.
      477     if lookup('вес':U, buf_units.type) > 0 then do:
      478   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      480     (buffer buf_prod-bc
      481     ,input  'weight=request':u
      482     ,output l-prod-bc-weight
      483     ) no-error .
      484       if error-status:error or
      485       not l-prod-bc-weight then do:
      486         assign
      487         v-msg = substitute("Товар код товара: &1 ДопБК &2 не весовой", buf_goods.gds-code, buf_prod-bc.b-str)
      488         .
      489         run log-msg in this-procedure ( input-output (v-msg)).
      490         return error v-msg.
      491       end.
      492     end.
      493     if lookup('шту':U, buf_units.type) > 0 then do:
      494   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      495   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      496     (buffer buf_prod-bc
      497     ,input  'pgweight=request':u
      498     ,output l-prod-bc-pgweight
      499     ) no-error .
      500       if error-status:error or
      501       not l-prod-bc-weight then do:
      502         assign
      503         v-msg = substitute("Товар код товара: &1 ДопБК &2 не штучный для весов", buf_goods.gds-code, buf_prod-bc.b-str)
      504         .
      505         run log-msg in this-procedure ( input-output (v-msg)).
      506         return error v-msg.
      507       end.
      508     end.
      509     if buf_prod-bc.b-code <>  v-main-b-code then do:
      510       assign
      511       v-msg = substitute("Товар код товара: &1 не имеет ДопБК &2"
      512                           ,buf_goods.gds-code
      513                          ,buf_prod-bc.b-str)
      514       .
      515       run log-msg in this-procedure ( input-output (v-msg)).
      516       return error v-msg.
      517     end.
      518     if buf_prod-bc.bc-on = false
      519     and p-action = "off"
      520     then do:
      521       assign
      522       v-msg = substitute("Товар код товара: &1 ДопБк &2 уже выключен"
      523                          ,buf_goods.gds-code
      524                          ,buf_prod-bc.b-str)
      525       .
      526       run log-msg in this-procedure ( input-output (v-msg)).
      527       return error v-msg.
      528     end.
      529     if buf_prod-bc.bc-on = true
      530     and p-action = "del"
      531     then do:
      532       assign
      533       v-msg = substitute("Товар код товара: &1 ДопБк &2 еще не выключен"
      534                         , buf_goods.gds-code
      535                          ,buf_prod-bc.b-str)
      536       .
      537       run log-msg in this-procedure ( input-output (v-msg)).
      538       return error v-msg.
      539     end.
      540     for each buf_clients no-lock where
      541             buf_clients.db-num = v-db-num:
      542       assign
      543       v-deleted = no
      544       .
      545       run gdsoattr-value in this-procedure (
      546        input  'scales-code':U
      547       ,input buf_goods.gds-code
      548       ,input buf_clients.obj-type
      549       ,input buf_clients.obj-code
      550       ,output v-attr-value
      551       ,output v-attr-type
      552       ).
      553       if v-attr-value = p-b-str then do:
      554         find first buf_scales-gds No-lock where
      555                   buf_scales-gds.b-code = v-main-b-code
      556               and buf_scales-gds.obj-type = buf_clients.obj-type
      557               and buf_scales-gds.obj-code = buf_clients.obj-code
      558               AND buf_scales-gds.db-num = v-db-num
      559                   no-error .
      560         if available buf_scales-gds then do:
      561           assign
      562           v-msg = substitute("Товар код товара: &1 есть товар на весах &2 БД № &3 &4&5"
      563                             , buf_goods.gds-code
      564                             , buf_scales-gds.scales-num
      565                             , buf_scales-gds.db-num
      566                             , buf_scales-gds.obj-type
      567                             , buf_scales-gds.obj-code
      568                             )
      569           .
      570           run log-msg in this-procedure ( input-output (v-msg)).
      571           return error v-msg.
      572         end.
      573           run gdsoattr-delete in this-procedure (
      574         input buf_goods.gds-code
      575         ,input buf_clients.obj-type
      576         ,input buf_clients.obj-code
      577         ,input 'scales-code':U
      578         ,output v-deleted
      579         ).
      580         if not v-deleted then do:
      581           assign
      582           v-msg = substitute("Товар код товара: &1 объект: &2 &3 не удалось удалить атрибут товара на объекте &4"
      583                             ,buf_goods.gds-code
      584                             ,buf_clients.obj-type
      585                             ,buf_clients.obj-code
      586                             ,'scales-code':U)
      587           .
      588           run log-msg in this-procedure ( input-output (v-msg)).
      589           return error v-msg.
      590         end.
      591       end.
      592     end.
      593     run trg/bc-upd.p (
      594                   input parparentproc
      595                  ,input buf_prod-bc.b-code
      596                  ,input buf_prod-bc.b-str
      597                  ,input no
      598                  ,input p-silence
      599                  ,input yes
      600                  ,input ?
      601                  ,input ?
      602                 ) no-error.
      603     if error-status:error then do:
      604       assign
      605       v-msg = substitute("Товар код товара: &1 лок. вес. код: &2 не удалось выключить"
      606                          , buf_goods.gds-code
      607                          , buf_prod-bc.b-str)
      608       .
      609       run log-msg in this-procedure ( input-output (v-msg)).
      610       return error v-msg.
      611     end.
      612     assign
      613     v-msg = substitute("Товар код товара: &1 лок. вес. код:  &2 успешно выключен"
      614                      ,buf_goods.gds-code
      615                      ,buf_prod-bc.b-str)
      616     .
      617     run log-msg in this-procedure ( input-output (v-msg)).
      618   end.
      619   procedure log-msg :
      620   define input-output parameter p-msg as character no-undo .
      621     do
      622     on error undo, return error
      623     :
      624       if not p-silence then do:
      625         message
      626         p-msg
      627         view-as alert-box error .
      628       end.
      629       p-msg = substitute("&1&2&3"
      630                            , return-value
      631                            , chr(10)
      632                            , p-msg).
      633     end.
      634   end procedure.
