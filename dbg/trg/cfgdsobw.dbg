        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-fbr-gds-obj.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись истории АТРИБУТА ТОВАРА РЕСТОРАН".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                           , ub.c-fbr-gds-obj.obj-type
       30                           , ub.c-fbr-gds-obj.obj-code
       31                           , ub.c-fbr-gds-obj.gds-code
       32                           , ub.c-fbr-gds-obj.corr-user-db-num
       33                           , ub.c-fbr-gds-obj.chip-num
       34                           )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable v-db-num like ub.db.db-num no-undo .
       88   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
       89   main-block:
       90   do
       91   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       92   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       93   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       94   :
       95       find first buf_fbr-gds-obj no-lock where
       96                  buf_fbr-gds-obj.obj-type = c-fbr-gds-obj.obj-type
       97              AND buf_fbr-gds-obj.obj-code = c-fbr-gds-obj.obj-code
       98              AND buf_fbr-gds-obj.gds-code = c-fbr-gds-obj.gds-code
       99                 no-error .
      100       if not available buf_fbr-gds-obj then do:
      101         message
      102         vss-workfile vss-revision vss-description skip
      103         "Неправильная ссылка на АТРИБУТ РЕСТОРАН для товара" skip
      104         "магазин" c-fbr-gds-obj.obj-code
      105         "Товар" c-fbr-gds-obj.gds-code
      106         view-as alert-box error .
      107         undo main-block, return error.
      108       end.
      109   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      110   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      111     (input  ub.c-fbr-gds-obj.obj-type
      112     ,input  ub.c-fbr-gds-obj.obj-code
      113     ,output v-db-num
      114     )  .
      115      if not g#news and g#db-num <> v-db-num then do:
      116         message
      117         vss-workfile vss-revision vss-description skip
      118         "Нельзя изменять запись ИСТОРИИ АТРИБУТА РЕСТОРАН в БД, отличной от БД объекта" skip
      119         "Номер текущей БД" g#db-num "Номер БД объекта" v-db-num
      120         view-as alert-box error .
      121         undo, return error .
      122       end.
      123     if
      124     not g#news
      125     OR (g#news
      126         and g#db-num = 0
      127         and ub.c-fbr-gds-obj.corr-user-name <> (chr(4) +  'СПН':U)
      128         )
      129     or (g#news
      130         and g#db-num > 0
      131         and ub.c-fbr-gds-obj.corr-user-name = (chr(4) +  'СПН':U)
      132         )
      133     then do:
      134       run str/callnews.p (
      135                           input 'c-fbr-gds-obj':U
      136                           ,input (buffer ub.c-fbr-gds-obj:handle)
      137                           ).
      138     end.
      139       if g#oxml = yes
      140       then do:
      141       run str/calloxml.p (
      142             input 'update':U
      143           , input 'c-fbr-gds-obj':U
      144           , input ( buffer ub.c-fbr-gds-obj:handle )
      145       ) no-error.
      146       if error-status :error
      147       then do:
      148           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      149                                , chr(10)
      150                                , vss-workfile
      151                                , return-value
      152                                , error-status :get-message ( 1 ) ).
      153       end.
      154       end.
      155   end.
