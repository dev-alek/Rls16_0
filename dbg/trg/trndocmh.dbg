     1735         return error return-value.
     1736       end.
     1737       if cli_doc-prt = true then do:
     1738   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     1739     (input  varprt-create-n-c
     1740     ,output varprt-create-n-c
     1741     ) no-error .
     1742         if error-status:error then do:
     1743           return error return-value.
     1744         end.
     1745       end.
     1746     end.
     1747     assign
     1748       vartotal-gds-dtl-qnty = 0
     1749     .
     1750     for each lib-trn_ret-dtl no-lock
     1751       where lib-trn_ret-dtl.doc-code  = lib-trn_ret-line.doc-code
     1752         and lib-trn_ret-dtl.prod-type = lib-trn_ret-line.prod-type
     1753         and lib-trn_ret-dtl.prod-code = lib-trn_ret-line.prod-code
     1754         and lib-trn_ret-dtl.artic     = lib-trn_ret-line.artic
     1755     on error undo, return error
     1756     :
     1757       if lib-trn_ret-dtl.fact-qnty < 0 then do:
     1758         undo, return error "В документе межфирменного перемещения в строке признака не может быть задано отрицательное количество".
     1759       end.
     1760       if lib-trn_ret-dtl.fact-qnty = 0 then do:
     1761         next.
     1762       end.
     1763       if cli_doc-prt = obj_doc-prt then do:
     1764         assign
     1765           varcreate-n-c = lib-trn_ret-dtl.prt-code
     1766         .
     1767       end.
     1768       else do:
     1769         assign
     1770           varcreate-n-c = varprt-create-n-c
     1771         .
     1772       end.
     1773       create bf_gds-dtl.
     1774       assign
     1775         bf_gds-dtl.doc-code    = bf_trn-doc.doc-code
     1776         bf_gds-dtl.artic       = lib-trn_ret-dtl.artic
     1777         bf_gds-dtl.prod-type   = lib-trn_ret-dtl.prod-type
     1778         bf_gds-dtl.prod-code   = lib-trn_ret-dtl.prod-code
     1779         bf_gds-dtl.prt-code    = varcreate-n-c
     1780         bf_gds-dtl.obj-type    = bf_trn-doc.obj-type
     1781         bf_gds-dtl.obj-code    = bf_trn-doc.obj-code
     1782         bf_gds-dtl.discnt-base = lib-trn_ret-dtl.discnt-base
     1783         bf_gds-dtl.discnt-rubl = lib-trn_ret-dtl.discnt-rubl
     1784         bf_gds-dtl.discnt-pc   = lib-trn_ret-dtl.discnt-pc
     1785         bf_gds-dtl.discnt-type = lib-trn_ret-dtl.discnt-type
     1786         bf_gds-dtl.price-base  = lib-trn_ret-dtl.price-base
     1787         bf_gds-dtl.price-rubl  = lib-trn_ret-dtl.price-rubl
     1788         bf_gds-dtl.fact-qnty   = lib-trn_ret-dtl.fact-qnty
     1789         bf_gds-dtl.doc-qnty    = lib-trn_ret-dtl.doc-qnty
     1790         bf_gds-dtl.ov          = yes
     1791         vartotal-gds-dtl-qnty  = vartotal-gds-dtl-qnty + bf_gds-dtl.fact-qnty
     1792       .
     1793     end.
     1794     if vartotal-gds-dtl-qnty <> bf_doc-line.fact-qnty then do:
     1795       undo, return error substitute ("Количество в признаках не совпадает с количеством в строке документа. Количество по строкам документа = &1 Количество по признакам = &2", bf_doc-line.fact-qnty, vartotal-gds-dtl-qnty).
     1796     end.
     1797   end.
     1798   find first bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code no-error.
     1799   if not available bf_doc-line then do:
     1800     delete bf_trn-doc.
     1801   end.
     1802   end.
     1803   end procedure.
