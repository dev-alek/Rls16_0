     1840   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1841   define variable v-waitfram-action01         as character   no-undo .
     1842   define variable v-waitfram-action02         as character   no-undo .
     1843   define variable v-waitfram-action03         as character   no-undo .
     1844   define variable mWaitFramTextBeg            as character   no-undo.
     1845   define variable mWaitFramTextEnd            as character   no-undo.
     1846   define variable mWaitFramView               as logical     no-undo.
     1847   define variable mWaitProcEvent              as logical     no-undo init yes.
     1848   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1849   define variable mWaitFramStop               as logical     no-undo.
     1850   define variable mWaitFramStopUser           as logical     no-undo.
     1851   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1852   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1853   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1854   define button B-WaitFramStop auto-end-key
     1855        label "Стоп"
     1856        size 10 by 1 tooltip "Остоновить процесс".
     1857   define button B-viewProcInfo
     1858        label "Информация"
     1859        size 15 by 1 tooltip "Информация о процесс".
     1860   define frame waitfram
     1861     v-waitfram-action01 format "x(72)" no-label skip
     1862     v-waitfram-action02 format "x(72)" no-label skip
     1863     v-waitfram-action03 format "x(72)" no-label skip
     1864     B-viewProcInfo
     1865     B-WaitFramStop at row 4 col 30
     1866     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1867     .
     1868   define new global shared variable mBatchMode as logical no-undo init ?.
     1869   define variable mFramBachModHandle as handle no-undo.
     1870   mFramBachModHandle = frame waitfram:handle.
     1871   define variable mFameOldVis as logical no-undo.
     1872   define variable mVisCUrentVin as logical no-undo.
     1873   if session:batch-mode
     1874   then
     1875      mBatchMode = yes.
     1876   if mBatchMode = ? then do:
     1877     mVisCUrentVin = current-window:visible.
     1878     mFameOldVis = mFramBachModHandle:visible.
     1879     mFramBachModHandle:visible  = yes.
     1880     mBatchMode = mFramBachModHandle:visible ne yes.
     1881     mFramBachModHandle:visible = mFameOldVis.
     1882     current-window:visible = mVisCUrentVin.
     1883   end.
     1884    if  log-manager:logfile-name ne ?
     1885     then DO:
     1886         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1887         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1888         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1889     end.
     1890   on choose of B-WaitFramStop in frame waitfram
     1891   do:
     1892     mWaitFramStop = yes.
     1893     mWaitFramStopUser = yes.
     1894   end.
     1895   function waitfram-check-timeout returns logical():
     1896      define variable vtime as int64 no-undo.
     1897      if mWaitFramStopTimeOut
     1898      then
     1899         return yes.
     1900      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1901      if     mWaitFramTimeOut ne ?
     1902         and mWaitFramTimeOut ne 0
     1903         and mWaitFramTimeOut lt vtime
     1904      then do:
     1905         mWaitFramStopTimeOut = yes.
     1906      end.
     1907      return mWaitFramStopTimeOut.
     1908   end.
     1909   procedure waitfram-hide :
     1910     if not session:batch-mode
     1911     then do
     1912     on error undo, return error return-value
     1913     :
     1914       pause 0 before-hide .
     1915       if not mBatchMode then
     1916         hide frame waitfram .
     1917     if     not mWaitFramView
     1918        and mWaitProcEvent
     1919     then
     1920       process events .
     1921     end.
     1922   end procedure.
     1923   procedure waitfram-show :
     1924     define input  parameter p-message as character no-undo .
     1925     define variable v-left-margin as integer   no-undo .
     1926     if not session:batch-mode
     1927     then do
     1928     on error undo, return error return-value
     1929     :
     1930       if length(p-message) <= 70 then do:
     1931         assign
     1932           v-left-margin = integer((70 - length(p-message)) / 2)
     1933         .
     1934         assign
     1935           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1936         .
     1937         assign
     1938           v-waitfram-action01 = " "
     1939           v-waitfram-action02 = " "
     1940                                    + fill(" ", v-left-margin)
     1941                                    + p-message
     1942           v-waitfram-action03 = " "
     1943         .
     1944       end.
     1945       else do:
     1946         define variable vRindex1 as integer no-undo.
     1947         define variable vRindex2 as integer no-undo.
     1948         vRindex1 = r-index(p-message," ",70).
     1949         if vRindex1 = 0
     1950         then
     1951            vRindex1 = 70.
     1952         if length(p-message)  <= vRindex1 + 70 then do:
     1953           assign
     1954             v-waitfram-action01 = " "
     1955             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1956             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1957           .
     1958         end.
     1959         else do:
     1960           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1961           if vRindex2 <= vRindex1
     1962           then
     1963              vRindex2 = vRindex1 + 70.
     1964           assign
     1965             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1966             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1967             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1968           .
     1969         end.
     1970       end.
     1971       B-viewProcInfo:visible   in frame waitfram = no.
     1972       B-viewProcInfo:sensitive in frame waitfram = no.
     1973       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1974       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1975       if  (   mWaitFramView
     1976          or  mWaitProcEvent)
     1977          and not mBatchMode
     1978       then
     1979          display
     1980             v-waitfram-action01 skip
     1981             v-waitfram-action02 skip
     1982             v-waitfram-action03 skip
     1983          with frame waitfram .
     1984       if     mWaitFramView
     1985          then do:
     1986             if     mWaitFramInterval ne ?
     1987                and not mBatchMode
     1988             then
     1989                wait-for go of frame waitfram pause mWaitFramInterval.
     1990          end.
     1991          else
     1992             if     mWaitProcEvent
     1993                and not mBatchMode
     1994             then
     1995                process events .
     1996     end.
     1997   end procedure.
     1998      procedure waitfram-show-this:
     1999         define input  parameter iInterval as int64 no-undo.
     2000         define variable vtime as int64 no-undo.
     2001         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2002         mWaitFramInterval = iInterval.
     2003         run waitfram-show (substitute("&1&2 &3&4" ,
     2004                                       mWaitFramTextBeg ,
     2005                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2006                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2007                                       mWaitFramTextEnd
     2008                                      )
     2009                           ).
     2010      end.
     2011      procedure WaitFramRunPause:
     2012         define input  parameter iInterval as dec no-undo.
     2013         define variable vStart  as datetime-tz no-undo.
     2014         define variable vend    as datetime-tz no-undo.
     2015         define variable vint as int64 no-undo.
     2016         define variable vOk as logical no-undo.
     2017         vStart = now.
     2018         vend   = vStart.
     2019         publish "WaitFramPause" (iInterval,output vOk).
     2020         vend   =  now.
     2021         vint = vend - vStart.
     2022         vint = iInterval - vint / 1000.
     2023         if     not mWaitFramStop
     2024            and (   vint > 0
     2025                 or (    not vOk
     2026                     and iInterval eq ?
     2027                     )
     2028                 )
     2029         then
     2030            run waitfram-show-this (iInterval).
     2031         vend   =  now.
     2032         vint = vend - vStart.
     2033         vint = iInterval - vint / 1000.
     2034         if     not mWaitFramStop
     2035            and vint > 0
     2036         then do:
     2037            run gbl/pause.p (vint * 1000).
     2038         end.
     2039         if iInterval ne ?
     2040         then
     2041            publish "WaitFramStop".
     2042         waitfram-check-timeout().
     2043      end.
     2044      procedure WaitFramWaitFor:
     2045         define input  parameter iInterval as dec no-undo.
     2046         assign
     2047            mWaitFramStartProc   = now
     2048            mWaitFramStopUser    = no
     2049            mWaitFramStopTimeOut = no
     2050         .
     2051         block-wait:
     2052         do while not mWaitFramStop:
     2053            run WaitFramRunPause (iInterval).
     2054            if  waitfram-check-timeout()
     2055            then do:
     2056               leave block-wait.
     2057            end.
     2058         end.
     2059         run waitfram-hide.
     2060      end.
     2061   procedure waitfram-join :
     2062     define input  parameter p-line-1  as character no-undo .
     2063     define input  parameter p-line-2  as character no-undo .
     2064     define input  parameter p-line-3  as character no-undo .
     2065     define output parameter p-message as character no-undo .
     2066     do
     2067     on error undo, return error return-value
     2068     :
     2069       assign
     2070         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2071                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2072                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2073       .
     2074     end.
     2075   end procedure.
     2076   function waitfram-join-function returns character
     2077     (input p-line-1 as character
     2078     ,input p-line-2 as character
     2079     ,input p-line-3 as character
     2080     ).
     2081     define variable v-message as character no-undo .
     2082     run waitfram-join in this-procedure
     2083       (input  p-line-1
     2084       ,input  p-line-2
     2085       ,input  p-line-3
     2086       ,output v-message
     2087       ) .
     2088     return v-message .
     2089   end function .
