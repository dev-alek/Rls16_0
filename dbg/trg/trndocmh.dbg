     2128   if retry then do:
     2129     message "Несанкционированное завершение транзакции progress." skip
     2130             "Отправьте, пожалуйста, экран с этим сообщением в отдел сопровождения компании IBS." skip
     2131             "return-value"                 return-value                 skip
     2132             "error-status :error"          error-status :error          skip
     2133             "error-status :get-message(1)" error-status :get-message(1) skip
     2134             "error-status :get-message(2)" error-status :get-message(2) skip
     2135             "error-status :get-message(3)" error-status :get-message(3) skip
     2136             "error-status :get-message(4)" error-status :get-message(4) skip
     2137             "error-status :get-message(5)" error-status :get-message(5) skip
     2138             "конец сообщения"
     2139     view-as alert-box error.
     2140     return error return-value.
     2141   end.
     2142   main-block:
     2143   do for bf-src_trn-doc       ,
     2144          bf-src_doc-line      ,
     2145          bf-src_doc-line-attr ,
     2146          bf-src_goods         ,
     2147          bf-src_gds-dtl       ,
     2148          bf-src_parts         ,
     2149          bf-src_units         ,
     2150          bf_trn-doc           ,
     2151          bf-cur-obj_clients   ,
     2152          bf-hold-obj_clients  ,
     2153          bf-hold_sysconf      ,
     2154          bf-hold_firm         ,
     2155          bf-cur-firm_clients  ,
     2156          bf-cur_sysconf       ,
     2157          bf_doc-line          ,
     2158          bf_doc-line-attr     ,
     2159          bf_gds-dtl           ,
     2160          bf_parts             ,
     2161          bf_contract          ,
     2162          bf_currency
     2163   transaction
     2164   on error undo main-block, return error return-value
     2165   :
     2166     find first bf-src_trn-doc
     2167       where bf-src_trn-doc.doc-code = v-doc-code
     2168       no-error .
     2169     if not available bf-src_trn-doc then do:
     2170       message
     2171         vss-workfile vss-revision vss-description skip
     2172         "Ошибка задания входных параметров" skip
     2173         "Не найден документ" skip
     2174         "Документ " v-doc-code
     2175         view-as alert-box .
