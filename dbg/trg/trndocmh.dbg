        1   block-level on error undo, throw.
        2   define input parameter v-doc-code like ub.trn-doc.doc-code no-undo .
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo initial "Создание документов межфирменного перемещения":U .
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1':u,v-doc-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define new global shared variable g#lib-trn  as handle no-undo .
       82   define new global shared variable g#lib-trn2 as handle no-undo .
       83   define new global shared variable g#lib-trn3 as handle no-undo .
       84   define new global shared variable g#lib-trn4 as handle no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define new global shared variable g#trdcalib as handle no-undo.
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure holdprts-create-parts-supp :
       89     define input  parameter p-orig-in-code   like ub.parts-supp.orig-in-code   no-undo .
       90     define input  parameter p-orig-part-code like ub.parts-supp.orig-part-code no-undo .
       91     define input  parameter p-in-code        like ub.parts-supp.in-code        no-undo .
       92     define input  parameter p-artic          like ub.parts-supp.artic          no-undo .
       93     define input  parameter p-prod-type      like ub.parts-supp.prod-type      no-undo .
       94     define input  parameter p-prod-code      like ub.parts-supp.prod-code      no-undo .
       95     define input  parameter p-part-code      like ub.parts-supp.part-code      no-undo .
       96     define variable vss-description as character no-undo init "holdprts-create-parts-supp-01: скопировать атрибут партии".
       97     define buffer buf_parent_trn-doc  for ub.trn-doc .
       98     define buffer buf_child_trn-doc   for ub.trn-doc .
       99     define buffer buf_parts           for ub.parts .
      100     define buffer buf_parts-supp      for ub.parts-supp .
      101     define buffer buf_orig_parts-supp for ub.parts-supp .
      102     define buffer buf_income_trn-doc  for ub.trn-doc .
      103     define buffer buf_income_doc-line for ub.doc-line .
      104     define buffer buf_goods           for ub.goods .
      105       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      106       define buffer   in-vatp-parts    for ub.parts   .
      107       define buffer   in-vatp-doc      for ub.trn-doc .
      108       define buffer   in-vatp-goods    for ub.goods   .
      109       define buffer   in-vatp-sysconf  for ub.sysconf .
      110       define buffer   in-vatp_doc-attr for ub.doc-attr.
      111       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      112       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      113       define variable varinvprb                  as   character              no-undo.
      114       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      115       define variable cli-base-rate              as   decimal                no-undo.
      116       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      117       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      118       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      119       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      120       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      121       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      122       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      123       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      124       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      125       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      126       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      127       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      128       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      129       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      130       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      131       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      132       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      133       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      134       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      135       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      136       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      137       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      138       define variable varinvatp-envd             as   character              no-undo.
      139       define variable varinvatp-type             as   character              no-undo.
      140     do
      141     on error undo, return error return-value
      142     :
      143       find first buf_child_trn-doc no-lock
      144         where buf_child_trn-doc.doc-code = p-in-code
      145         no-error .
      146       if not available buf_child_trn-doc
      147       then do:
      148         return substitute("Не найден исходный документ &1", p-in-code) .
      149       end.
      150       find first buf_parent_trn-doc no-lock
      151         where buf_parent_trn-doc.doc-code = buf_child_trn-doc.hold-doc-code-parent
      152         no-error .
      153       if not available buf_parent_trn-doc
      154       then do:
      155         return substitute("Не найден приходный документ &1", buf_child_trn-doc.hold-doc-code-parent) .
      156       end.
      157       find first buf_parts-supp exclusive-lock
      158         where buf_parts-supp.in-code   = p-in-code
      159           and buf_parts-supp.artic     = p-artic
      160           and buf_parts-supp.prod-type = p-prod-type
      161           and buf_parts-supp.prod-code = p-prod-code
      162           and buf_parts-supp.part-code = p-part-code
      163         no-error .
      164       if available buf_parts-supp
      165       then do:
      166         message
      167           vss-workfile vss-revision vss-description skip
      168           vss-include-info1 skip
      169           "Попытка повторного создания партии атрибутов" skip
      170           "Документ прихода" p-in-code skip
      171           "Артикул" p-artic p-prod-type p-prod-code skip
      172           "Код партии" p-part-code skip
      173           "Исходный код партии" p-orig-in-code skip
      174           "Исходный код документа" p-orig-part-code skip
      175           view-as alert-box error .
      176         undo, return error .
      177       end.
      178       create buf_parts-supp .
      179       assign
      180         buf_parts-supp.in-code   = p-in-code
      181         buf_parts-supp.artic     = p-artic
      182         buf_parts-supp.prod-type = p-prod-type
      183         buf_parts-supp.prod-code = p-prod-code
      184         buf_parts-supp.part-code = p-part-code
      185       .
      186       assign
      187         buf_parts-supp.orig-in-code   = p-orig-in-code
      188         buf_parts-supp.orig-part-code = p-orig-part-code
      189       .
      190       find first buf_orig_parts-supp share-lock
      191         where buf_orig_parts-supp.in-code   = p-orig-in-code
      192           and buf_orig_parts-supp.artic     = p-artic
      193           and buf_orig_parts-supp.prod-type = p-prod-type
      194           and buf_orig_parts-supp.prod-code = p-prod-code
      195           and buf_orig_parts-supp.part-code = p-orig-part-code
      196         no-error .
      197       if available buf_orig_parts-supp
      198       then do:
      199         buffer-copy buf_orig_parts-supp
      200         except
      201           buf_orig_parts-supp.in-code
      202           buf_orig_parts-supp.artic
      203           buf_orig_parts-supp.prod-type
      204           buf_orig_parts-supp.prod-code
      205           buf_orig_parts-supp.part-code
      206           buf_orig_parts-supp.orig-in-code
      207           buf_orig_parts-supp.orig-part-code
      208         to buf_parts-supp.
      209       end.
      210       else do:
      211         find first buf_parts share-lock
      212           where buf_parts.obj-type  = buf_parent_trn-doc.obj-type
      213             and buf_parts.obj-code  = buf_parent_trn-doc.obj-code
      214             and buf_parts.artic     = p-artic
      215             and buf_parts.prod-type = p-prod-type
      216             and buf_parts.prod-code = p-prod-code
      217             and buf_parts.in-code   = p-orig-in-code
      218             and buf_parts.out-code  = buf_parent_trn-doc.doc-code
      219             and buf_parts.part-code = p-orig-part-code
      220           no-error .
      221         if not available buf_parts
      222         then do:
      223           message
      224             vss-workfile vss-revision vss-description skip
      225             vss-include-info1 skip
      226             "Ошибка задания входных параметров" skip
      227             "Не найдена исходная партия" skip
      228             "Исходный документ" p-orig-in-code skip
      229             "Артикул" p-artic p-prod-type p-prod-code skip
      230             "Код партии" p-orig-part-code skip
      231             view-as alert-box error .
      232           undo, return error .
      233         end.
      234         define variable v-base-rate         as decimal   no-undo .
      235         define variable v-base-scale        as integer   no-undo .
      236         define variable v-exch-rate         as decimal   no-undo .
      237         define variable v-exch-scale        as integer   no-undo .
      238         define variable v-extended-doc-type as character no-undo .
      239         define variable v-unit-cli          as character no-undo .
      240         find first buf_income_trn-doc no-lock
      241           where buf_income_trn-doc.doc-code = p-orig-in-code
      242           no-error .
      243         if available buf_income_trn-doc
      244         then do:
      245           find first buf_income_doc-line no-lock
      246             where buf_income_doc-line.doc-code  = p-orig-in-code
      247               and buf_income_doc-line.artic     = p-artic
      248               and buf_income_doc-line.prod-type = p-prod-type
      249               and buf_income_doc-line.prod-code = p-prod-code
      250             no-error .
      251           if not available buf_income_doc-line
      252           then do:
      253             message
      254               vss-workfile vss-revision vss-description skip
      255               vss-include-info1 skip
      256               "Не найдена исходная строка документа прихода" skip
      257               "Исходный документ" p-orig-in-code skip
      258               "Артикул" p-artic p-prod-type p-prod-code skip
      259               "Код партии" p-orig-part-code skip
      260               view-as alert-box error .
      261             undo, return error .
      262           end.
      263           assign
      264             v-base-rate         = buf_income_trn-doc.base-rate
      265             v-base-scale        = buf_income_trn-doc.base-scale
      266             v-exch-rate         = buf_income_trn-doc.exch-rate
      267             v-exch-scale        = buf_income_trn-doc.exch-scale
      268             v-extended-doc-type = buf_income_trn-doc.ext-doc-type
      269             v-unit-cli          = buf_income_doc-line.unit-cli
      270           .
      271         end.
      272         else do:
      273           find first buf_goods no-lock
      274             where buf_goods.artic     = buf_parts.artic
      275               and buf_goods.prod-type = buf_parts.prod-type
      276               and buf_goods.prod-code = buf_parts.prod-code
      277             .
      278           assign
      279             v-base-rate         = buf_parts.price-rubl / buf_parts.price-base
      280             v-base-scale        = 1
      281             v-exch-rate         = buf_parts.price-rubl / (buf_parts.price-cli * buf_parts.cli-base-rate)
      282             v-exch-scale        = 1
      283             v-extended-doc-type = 'ie':U
      284             v-unit-cli          = buf_goods.unit-cli
      285           .
      286         end.
      287          if v-base-rate = ? then v-base-rate = 1.
      288          if v-exch-rate = ? then v-exch-rate = 1.
      289   assign
      290     price-rubl-with-tax-loc = buf_parts.price-rubl
      291     price-base-with-tax-loc = buf_parts.price-base
      292   .
      293   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      294   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      295     (output varinvprb
      296     )  .
      297     if buf_parts.out-code = 'free-zone':U     or
      298        buf_parts.out-code = 'out-zone':U   or
      299        buf_parts.doc-type = 'акт':U then do:
      300       assign
      301         in-vatp-have-vat-slt = yes.
      302     end.
      303     else do:
      304       find first in-vatp_doc-attr no-lock
      305         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      306           and in-vatp_doc-attr.attr-code = 'envd':U
      307         no-error .
      308       if not available in-vatp_doc-attr then do:
      309         assign
      310           in-vatp-have-vat-slt = yes.
      311       end.
      312       else do:
      313            in-vatp-have-vat-slt = no.
      314       end.
      315     end.
      316     assign
      317      price-cli-with-tax-loc = buf_parts.price-cli
      318      cli-base-rate          = buf_parts.cli-base-rate.
      319     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      320              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      321     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      322             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      323             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      324             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      325             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      326             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      327             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      328       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      329     assign
      330       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      331     assign
      332       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      333       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      334       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      335       transport-cli-loc  = 0
      336       other-cli-loc      = 0
      337     .
      338   ASSIGN
      339             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      340       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      341   .
      342         assign
      343           buf_parts-supp.PS                = buf_parts.PS
      344           buf_parts-supp.SLT-type          = buf_parts.SLT-type
      345           buf_parts-supp.VAT-type          = buf_parts.VAT-type
      346           buf_parts-supp.base-rate         = v-base-rate
      347           buf_parts-supp.base-scale        = v-base-scale
      348           buf_parts-supp.cli-qnty          = buf_parts.cli-qnty
      349           buf_parts-supp.cst-code          = buf_parts.cst-code
      350           buf_parts-supp.doc-qnty          = buf_parts.qnty
      351           buf_parts-supp.exch-code         = buf_parts.exch-code
      352           buf_parts-supp.exch-rate         = v-exch-rate
      353           buf_parts-supp.exch-scale        = v-exch-scale
      354           buf_parts-supp.extended-doc-type = v-extended-doc-type
      355           buf_parts-supp.fact-date         = buf_parts.fact-date
      356           buf_parts-supp.fact-qnty         = buf_parts.fact-qnty
      357           buf_parts-supp.last-date         = buf_parts.last-date
      358           buf_parts-supp.pay-code          = buf_parts.pay-code
      359           buf_parts-supp.price-cli         = buf_parts.price-cli
      360           buf_parts-supp.purch-code        = buf_parts.purch-code
      361           buf_parts-supp.supp-code         = buf_parts.supp-code
      362           buf_parts-supp.supp-type         = buf_parts.supp-type
      363           buf_parts-supp.unit-cli          = v-unit-cli
      364         .
      365         assign
      366           buf_parts-supp.vat-pc         = vat-pc-loc
      367           buf_parts-supp.slt-pc         = slt-pc-loc
      368           buf_parts-supp.price-base     = price-base-with-tax-loc
      369           buf_parts-supp.price-rubl     = price-rubl-with-tax-loc
      370           buf_parts-supp.vat-base       = vat-base-loc
      371           buf_parts-supp.vat-rubl       = vat-rubl-loc
      372           buf_parts-supp.slt-base       = slt-base-loc
      373           buf_parts-supp.slt-rubl       = slt-rubl-loc
      374           buf_parts-supp.road-tax-base  = road-tax-base-loc
      375           buf_parts-supp.road-tax-rubl  = road-tax-rubl-loc
      376           buf_parts-supp.transport-base = transport-base-loc
      377           buf_parts-supp.transport-rubl = transport-rubl-loc
      378           buf_parts-supp.other-base     = other-base-loc
      379           buf_parts-supp.other-rubl     = other-rubl-loc
      380         .
      381       end.
      382     end.
      383   end procedure.
      384   procedure holdprts-get-part-code :
      385     define input  parameter p-doc-code       as character no-undo .
      386     define output parameter p-hold-part-code as integer   no-undo .
      387     define variable vss-description as character no-undo init "holdprts-get-part-code-01: создать уникальный код партии внутри документа".
      388     define variable v-attr-value as character no-undo .
      389     define variable v-attr-type  as character no-undo .
      390     define buffer buf_trn-doc for ub.trn-doc .
      391     do
      392     on error undo, return error return-value
      393     :
      394       find first buf_trn-doc exclusive-lock
      395         where buf_trn-doc.doc-code = p-doc-code
      396         no-error .
      397       if not available buf_trn-doc
      398       then do:
      399         message
      400           vss-workfile vss-revision vss-description skip
      401           vss-include-info1 skip
      402           "Ошибка задания входных параметров" skip
      403           "Не найден документ" p-doc-code skip
      404           view-as alert-box error .
      405         undo, return error .
      406       end.
      407   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
      408                           input 'hold-part-code':U ,
      409                          output v-attr-value ,
      410                          output v-attr-type )  .
      411       assign
      412         p-hold-part-code = integer(v-attr-value) + 1
      413       .
      414   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
      415                          input 'hold-part-code':U ,
      416                          input string(p-hold-part-code) )  .
      417     end.
      418   end procedure.
      419   procedure holdprts-validate-document :
      420     define input  parameter p-doc-code as character no-undo .
      421     define variable vss-description as character no-undo init "holdprts-validate-document-01: проверить правильность документа".
      422     define buffer buf_trn-doc    for ub.trn-doc .
      423     define buffer parent_trn-doc for ub.trn-doc .
      424     define buffer buf_parts      for ub.parts .
      425     define buffer buf_parts-supp for ub.parts-supp .
      426     do
      427     on error undo, return error return-value
      428     :
      429       find first buf_trn-doc exclusive-lock
      430         where buf_trn-doc.doc-code = p-doc-code
      431         no-error .
      432       if not available buf_trn-doc
      433       then do:
      434         message
      435           vss-workfile vss-revision vss-description skip
      436           vss-include-info1 skip
      437           "Ошибка задания входных параметров" skip
      438           "Не найден документ" p-doc-code skip
      439           view-as alert-box error .
      440         undo, return error .
      441       end.
      442       find first parent_trn-doc exclusive-lock
      443         where parent_trn-doc.doc-code = buf_trn-doc.hold-doc-code-parent
      444         no-error .
      445       if not available parent_trn-doc
      446       then do:
      447         message
      448           vss-workfile vss-revision vss-description skip
      449           vss-include-info1 skip
      450           "Не найден родительский документ" skip
      451           "Документ" buf_trn-doc.doc-code skip
      452           "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
      453           view-as alert-box error .
      454         undo, return error .
      455       end.
      456       if buf_trn-doc.ext-doc-type <> 'ie':U
      457       then do:
      458         return .
      459       end.
      460       for each buf_parts share-lock
      461         where buf_parts.out-code = buf_trn-doc.doc-code
      462       on error undo, return error
      463       :
      464         find first buf_parts-supp share-lock
      465           where buf_parts-supp.in-code   = buf_parts.in-code
      466             and buf_parts-supp.artic     = buf_parts.artic
      467             and buf_parts-supp.prod-type = buf_parts.prod-type
      468             and buf_parts-supp.prod-code = buf_parts.prod-code
      469             and buf_parts-supp.part-code = buf_parts.part-code
      470           no-error .
      471         if not available buf_parts-supp
      472         then do:
      473           message
      474             vss-workfile vss-revision vss-description skip
      475             vss-include-info1 skip
      476             "Не найдена информация о поставщике" skip
      477             "Документ" buf_trn-doc.doc-code skip
      478             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
      479             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
      480             "Номер партии" buf_parts.part-code skip
      481             view-as alert-box error .
      482           undo, return error .
      483         end.
      484       end.
      485       for each buf_parts-supp share-lock
      486         where buf_parts-supp.in-code = buf_trn-doc.doc-code
      487       on error undo, return error
      488       :
      489         find first buf_parts share-lock
      490           where buf_parts.out-code  = buf_parts-supp.in-code
      491             and buf_parts.obj-type  = buf_trn-doc.obj-type
      492             and buf_parts.obj-code  = buf_trn-doc.obj-code
      493             and buf_parts.artic     = buf_parts-supp.artic
      494             and buf_parts.prod-type = buf_parts-supp.prod-type
      495             and buf_parts.prod-code = buf_parts-supp.prod-code
      496             and buf_parts.part-code = buf_parts-supp.part-code
      497           no-error .
      498         if not available buf_parts
      499         then do:
      500           message
      501             vss-workfile vss-revision vss-description skip
      502             vss-include-info1 skip
      503             "Задана информация о поставщике для неизвестной партии" skip
      504             "Документ" buf_trn-doc.doc-code skip
      505             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
      506             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
      507             "Номер партии" buf_parts.part-code skip
      508             view-as alert-box error .
      509           undo, return error .
      510         end.
      511       end.
      512       for each buf_parts share-lock
      513         where buf_parts.out-code = buf_trn-doc.hold-doc-code-parent
      514       on error undo, return error
      515       :
      516         if  buf_trn-doc.doc-type = 'при':U
      517         and buf_parts.qnty = buf_parts.fact-qnty
      518         then do:
      519           next.
      520         end.
      521         find first buf_parts-supp share-lock
      522           where buf_parts-supp.orig-in-code   = buf_parts.in-code
      523             and buf_parts-supp.artic          = buf_parts.artic
      524             and buf_parts-supp.prod-type      = buf_parts.prod-type
      525             and buf_parts-supp.prod-code      = buf_parts.prod-code
      526             and buf_parts-supp.orig-part-code = buf_parts.part-code
      527           no-error .
      528         if not available buf_parts-supp
      529         then do:
      530           message
      531             vss-workfile vss-revision vss-description skip
      532             vss-include-info1 skip
      533             "Не найдена информация о поставщике для исходной накладной" skip
      534             "Документ" buf_trn-doc.doc-code skip
      535             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
      536             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
      537             "Номер партии" buf_parts.part-code skip
      538             view-as alert-box error .
      539           undo, return error .
      540         end.
      541       end.
      542     end.
      543   end procedure.
      544   procedure holdprts-doc-type :
      545     define input  parameter p-cat-code as integer   no-undo .
      546     define input  parameter p-doc-code as character no-undo .
      547     define output parameter p-is-sale  as logical   no-undo .
      548     define output parameter p-is-purch as logical   no-undo .
      549     define variable vss-description as character no-undo init "holdprts-doc-type-01: определение типа документа для межфирменного архива".
      550     define buffer buf_trn-doc for ub.trn-doc .
      551     do
      552     on error undo, return error return-value
      553     :
      554       find first buf_trn-doc no-lock
      555         where buf_trn-doc.doc-code = p-doc-code
      556         no-error .
      557       if not available buf_trn-doc
      558       then do:
      559         message
      560           vss-workfile vss-revision vss-description skip
      561           vss-include-info1 skip
      562           "Ошибка задания входных параметров" skip
      563           "Не найден документ" skip
      564           "Документ" p-doc-code skip
      565           "Тип архива" p-cat-code skip
      566           view-as alert-box error .
      567         undo, return error .
      568       end.
      569       case p-cat-code :
      570         when 1
      571         then do:
      572           define variable v-is-hold as logical   no-undo .
      573   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
      575     (input  buf_trn-doc.doc-code
      576     ,output v-is-hold
      577     )  .
      578           if v-is-hold = true
      579           then do:
      580             assign
      581               p-is-sale  = false
      582               p-is-purch = false
      583             .
      584           end.
      585           else do:
      586             case buf_trn-doc.ext-doc-type :
      587               when 'ie':U or
      588               when 'ep':U
      589               then do:
      590                 assign
      591                   p-is-sale  = false
      592                   p-is-purch = true
      593                 .
      594               end.
      595               when 'ee':U or
      596               when 'es':U or
      597               when 're':U or
      598               when 'rs':U
      599               then do:
      600                 assign
      601                   p-is-sale  = true
      602                   p-is-purch = false
      603                 .
      604               end.
      605               when 'we':U or
      606               when 'vt':U or
      607               when 'vp':U or
      608               when 'ap':U or
      609               when 'mp':U or
      610               when 'pc':U or
      611               when 'iv':U or
      612               when 'ev':U or
      613               when 'io':U or
      614               when 'eo':U or
      615               when 'rv':U or
      616               when 'em':U or
      617               when 'wm':U or
      618               when 'im':U
      619               then do:
      620                 assign
      621                   p-is-sale  = false
      622                   p-is-purch = false
      623                 .
      624               end.
      625               otherwise do:
      626                 message
      627                   vss-workfile vss-revision vss-description skip
      628                   vss-include-info1 skip
      629                   "Неизвестный тип документа" skip
      630                   "Документ" buf_trn-doc.doc-code skip
      631                   "Тип документа" buf_trn-doc.ext-doc-type skip
      632                   "Тип архива" p-cat-code skip
      633                   view-as alert-box error .
      634                 undo, return error .
      635               end.
      636             end.
      637           end.
      638         end.
      639         when 2
      640         then do:
      641           case buf_trn-doc.ext-doc-type :
      642             when 'vt':U or
      643             when 'vp':U
      644             then do:
      645               assign
      646                 p-is-sale  = false
      647                 p-is-purch = true
      648               .
      649             end.
      650             otherwise do:
      651               assign
      652                 p-is-sale  = false
      653                 p-is-purch = false
      654               .
      655             end.
      656           end.
      657         end.
      658         when 3
      659         then do:
      660           case buf_trn-doc.ext-doc-type :
      661             when 'we':U
      662             then do:
      663               assign
      664                 p-is-sale  = false
      665                 p-is-purch = true
      666               .
      667             end.
      668             otherwise do:
      669               assign
      670                 p-is-sale  = false
      671                 p-is-purch = false
      672               .
      673             end.
      674           end.
      675         end.
      676         otherwise do:
      677           message
      678             vss-workfile vss-revision vss-description skip
      679             "Неизвестный тип архивов" skip
      680             "Документ" buf_trn-doc.doc-code skip
      681             "Тип документа" buf_trn-doc.ext-doc-type skip
      682             "Тип архива" p-cat-code skip
      683             view-as alert-box error .
      684           undo, return error return-value .
      685         end.
      686       end.
      687     end.
      688   end procedure.
      689   procedure holdprts-purch-values :
      690     define input  parameter p-doc-code             like ub.doc-line.doc-code  no-undo .
      691     define input  parameter p-artic                like ub.doc-line.artic     no-undo .
      692     define input  parameter p-prod-type            like ub.doc-line.prod-type no-undo .
      693     define input  parameter p-prod-code            like ub.doc-line.prod-code no-undo .
      694     define output parameter p-fact-qnty            as decimal   no-undo .
      695     define output parameter p-purch-sum-base       as decimal   no-undo .
      696     define output parameter p-purch-sum-rubl       as decimal   no-undo .
      697     define output parameter p-purch-VAT-base       as decimal   no-undo .
      698     define output parameter p-purch-VAT-rubl       as decimal   no-undo .
      699     define output parameter p-purch-SLT-base       as decimal   no-undo .
      700     define output parameter p-purch-SLT-rubl       as decimal   no-undo .
      701     define output parameter p-purch-road-tax-base  as decimal   no-undo .
      702     define output parameter p-purch-road-tax-rubl  as decimal   no-undo .
      703     define output parameter p-purch-excise-base    as decimal   no-undo .
      704     define output parameter p-purch-excise-rubl    as decimal   no-undo .
      705     define output parameter p-purch-transport-base as decimal   no-undo .
      706     define output parameter p-purch-transport-rubl as decimal   no-undo .
      707     define output parameter p-purch-other-base     as decimal   no-undo .
      708     define output parameter p-purch-other-rubl     as decimal   no-undo .
      709     define output parameter p-purch-discnt-base    as decimal   no-undo .
      710     define output parameter p-purch-discnt-rubl    as decimal   no-undo .
      711     define variable vss-description as character no-undo init "holdprts-purch-values-01: параметры закупки товара".
      712     define variable v-price-base     as decimal   no-undo .
      713     define variable v-price-rubl     as decimal   no-undo .
      714     define variable v-VAT-base       as decimal   no-undo .
      715     define variable v-VAT-rubl       as decimal   no-undo .
      716     define variable v-SLT-base       as decimal   no-undo .
      717     define variable v-SLT-rubl       as decimal   no-undo .
      718     define variable v-road-tax-base  as decimal   no-undo .
      719     define variable v-road-tax-rubl  as decimal   no-undo .
      720     define variable v-transport-base as decimal   no-undo .
      721     define variable v-transport-rubl as decimal   no-undo .
      722     define variable v-other-base     as decimal   no-undo .
      723     define variable v-other-rubl     as decimal   no-undo .
      724     define buffer buf_trn-doc        for ub.trn-doc .
      725     define buffer buf_parts          for ub.parts .
      726     define buffer buf_parts-supp     for ub.parts-supp .
      727     define buffer buf_doc-line       for ub.doc-line .
      728     define buffer buf_income_trn-doc for ub.trn-doc .
      729     do
      730     on error undo, return error return-value
      731     :
      732       find first buf_trn-doc no-lock
      733         where buf_trn-doc.doc-code = p-doc-code
      734         no-error .
      735       if not available buf_trn-doc
      736       then do:
      737         message
      738           vss-workfile vss-revision vss-description skip
      739           vss-include-info1 skip
      740           "Ошибка задания входных параметров" skip
      741           "Не найден документ" skip
      742           "Документ" p-doc-code skip
      743           view-as alert-box error .
      744         undo, return error .
      745       end.
      746       find first buf_doc-line no-lock
      747         where buf_doc-line.doc-code  = p-doc-code
      748           and buf_doc-line.artic     = p-artic
      749           and buf_doc-line.prod-type = p-prod-type
      750           and buf_doc-line.prod-code = p-prod-code
      751         no-error .
      752       if not available buf_doc-line
      753       then do:
      754         message
      755           vss-workfile vss-revision vss-description skip
      756           vss-include-info1 skip
      757           "Ошибка задания входных параметров" skip
      758           "Не найдена строка документа" skip
      759           "Документ" p-doc-code skip
      760           "Артикул" p-artic p-prod-type p-prod-code skip
      761           view-as alert-box error .
      762         undo, return error .
      763       end.
      764       assign
      765         p-fact-qnty            = 0
      766         p-purch-sum-base       = 0
      767         p-purch-sum-rubl       = 0
      768         p-purch-VAT-base       = 0
      769         p-purch-VAT-rubl       = 0
      770         p-purch-SLT-base       = 0
      771         p-purch-SLT-rubl       = 0
      772         p-purch-road-tax-base  = 0
      773         p-purch-road-tax-rubl  = 0
      774         p-purch-excise-base    = 0
      775         p-purch-excise-rubl    = 0
      776         p-purch-transport-base = 0
      777         p-purch-transport-rubl = 0
      778         p-purch-other-base     = 0
      779         p-purch-other-rubl     = 0
      780         p-purch-discnt-base    = 0
      781         p-purch-discnt-rubl    = 0
      782       .
      783       for each buf_parts no-lock
      784         where buf_parts.out-code  = buf_doc-line.doc-code
      785           and buf_parts.obj-type  = buf_doc-line.obj-type
      786           and buf_parts.obj-code  = buf_doc-line.obj-code
      787           and buf_parts.artic     = buf_doc-line.artic
      788           and buf_parts.prod-type = buf_doc-line.prod-type
      789           and buf_parts.prod-code = buf_doc-line.prod-code
      790       on error undo, return error
      791       :
      792         define variable v-parts-qnty as decimal   no-undo .
      793         assign
      794           v-parts-qnty = buf_parts.fact-qnty
      795                        * ( if lookup(buf_trn-doc.doc-type, 'рас,спи':U ) > 0
      796                            then -1
      797                            else 1
      798                          )
      799         .
      800         find first buf_parts-supp no-lock
      801           where buf_parts-supp.in-code   = buf_parts.in-code
      802             and buf_parts-supp.artic     = buf_parts.artic
      803             and buf_parts-supp.prod-type = buf_parts.prod-type
      804             and buf_parts-supp.prod-code = buf_parts.prod-code
      805             and buf_parts-supp.part-code = buf_parts.part-code
      806           no-error .
      807         if available buf_parts-supp
      808         then do:
      809           assign
      810             v-price-base     = buf_parts-supp.price-base
      811             v-price-rubl     = buf_parts-supp.price-rubl
      812             v-VAT-base       = buf_parts-supp.VAT-base
      813             v-VAT-rubl       = buf_parts-supp.VAT-rubl
      814             v-SLT-base       = buf_parts-supp.SLT-base
      815             v-SLT-rubl       = buf_parts-supp.SLT-rubl
      816             v-road-tax-base  = buf_parts-supp.road-tax-base
      817             v-road-tax-rubl  = buf_parts-supp.road-tax-rubl
      818             v-transport-base = buf_parts-supp.transport-base
      819             v-transport-rubl = buf_parts-supp.transport-rubl
      820             v-other-base     = buf_parts-supp.other-base
      821             v-other-rubl     = buf_parts-supp.other-rubl
      822           .
      823         end.
      824         else do:
      825       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      826       define buffer   in-vatp-parts    for ub.parts   .
      827       define buffer   in-vatp-doc      for ub.trn-doc .
      828       define buffer   in-vatp-goods    for ub.goods   .
      829       define buffer   in-vatp-sysconf  for ub.sysconf .
      830       define buffer   in-vatp_doc-attr for ub.doc-attr.
      831       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      832       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      833       define variable varinvprb                  as   character              no-undo.
      834       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      835       define variable cli-base-rate              as   decimal                no-undo.
      836       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      837       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      838       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      839       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      840       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      841       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      842       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      843       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      844       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      845       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      846       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      847       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      848       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      849       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      850       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      851       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      852       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      853       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      854       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      855       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      856       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      857       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      858       define variable varinvatp-envd             as   character              no-undo.
      859       define variable varinvatp-type             as   character              no-undo.
      860   assign
      861     price-rubl-with-tax-loc = buf_parts.price-rubl
      862     price-base-with-tax-loc = buf_parts.price-base
      863   .
      864   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      865   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      866     (output varinvprb
      867     )  .
      868     if buf_parts.out-code = 'free-zone':U     or
      869        buf_parts.out-code = 'out-zone':U   or
      870        buf_parts.doc-type = 'акт':U then do:
      871       assign
      872         in-vatp-have-vat-slt = yes.
      873     end.
      874     else do:
      875       find first in-vatp_doc-attr no-lock
      876         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      877           and in-vatp_doc-attr.attr-code = 'envd':U
      878         no-error .
      879       if not available in-vatp_doc-attr then do:
      880         assign
      881           in-vatp-have-vat-slt = yes.
      882       end.
      883       else do:
      884            in-vatp-have-vat-slt = no.
      885       end.
      886     end.
      887     assign
      888      price-cli-with-tax-loc = buf_parts.price-cli
      889      cli-base-rate          = buf_parts.cli-base-rate.
      890     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      891              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      892     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      893             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      894             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      895             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      896             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      897             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      898             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      899       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      900     assign
      901       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
      902     assign
      903       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      904       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      905       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      906       transport-cli-loc  = 0
      907       other-cli-loc      = 0
      908     .
      909   ASSIGN
      910             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      911       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      912   .
      913           assign
      914             v-price-base     = price-base-with-tax-loc
      915             v-price-rubl     = price-rubl-with-tax-loc
      916             v-VAT-base       = vat-base-loc
      917             v-VAT-rubl       = vat-rubl-loc
      918             v-SLT-base       = slt-base-loc
      919             v-SLT-rubl       = slt-rubl-loc
      920             v-road-tax-base  = road-tax-base-loc
      921             v-road-tax-rubl  = road-tax-rubl-loc
      922             v-transport-base = transport-base-loc
      923             v-transport-rubl = transport-rubl-loc
      924             v-other-base     = other-base-loc
      925             v-other-rubl     = other-rubl-loc
      926           .
      927         end.
      928         assign
      929           p-fact-qnty            = p-fact-qnty            + v-parts-qnty
      930           p-purch-sum-base       = p-purch-sum-base       + v-price-base     * v-parts-qnty
      931           p-purch-sum-rubl       = p-purch-sum-rubl       + v-price-rubl     * v-parts-qnty
      932           p-purch-VAT-base       = p-purch-VAT-base       + v-VAT-base       * v-parts-qnty
      933           p-purch-VAT-rubl       = p-purch-VAT-rubl       + v-VAT-rubl       * v-parts-qnty
      934           p-purch-SLT-base       = p-purch-SLT-base       + v-SLT-base       * v-parts-qnty
      935           p-purch-SLT-rubl       = p-purch-SLT-rubl       + v-SLT-rubl       * v-parts-qnty
      936           p-purch-road-tax-base  = p-purch-road-tax-base  + v-road-tax-base  * v-parts-qnty
      937           p-purch-road-tax-rubl  = p-purch-road-tax-rubl  + v-road-tax-rubl  * v-parts-qnty
      938           p-purch-excise-base    = p-purch-excise-base    + 0
      939           p-purch-excise-rubl    = p-purch-excise-rubl    + 0
      940           p-purch-transport-base = p-purch-transport-base + v-transport-base * v-parts-qnty
      941           p-purch-transport-rubl = p-purch-transport-rubl + v-transport-rubl * v-parts-qnty
      942           p-purch-other-base     = p-purch-other-base     + v-other-base     * v-parts-qnty
      943           p-purch-other-rubl     = p-purch-other-rubl     + v-other-rubl     * v-parts-qnty
      944           p-purch-discnt-base    = p-purch-discnt-base    + 0
      945           p-purch-discnt-rubl    = p-purch-discnt-rubl    + 0
      946         .
      947       end.
      948     end.
      949   end procedure.
      950   procedure holdprts-sale-values :
      951     define input  parameter p-doc-code            like ub.doc-line.doc-code  no-undo .
      952     define input  parameter p-artic               like ub.doc-line.artic     no-undo .
      953     define input  parameter p-prod-type           like ub.doc-line.prod-type no-undo .
      954     define input  parameter p-prod-code           like ub.doc-line.prod-code no-undo .
      955     define output parameter p-fact-qnty           as decimal   no-undo .
      956     define output parameter p-sale-sum-base       as decimal   no-undo .
      957     define output parameter p-sale-sum-rubl       as decimal   no-undo .
      958     define output parameter p-sale-VAT-base       as decimal   no-undo .
      959     define output parameter p-sale-VAT-rubl       as decimal   no-undo .
      960     define output parameter p-sale-SLT-base       as decimal   no-undo .
      961     define output parameter p-sale-SLT-rubl       as decimal   no-undo .
      962     define output parameter p-sale-road-tax-base  as decimal   no-undo .
      963     define output parameter p-sale-road-tax-rubl  as decimal   no-undo .
      964     define output parameter p-sale-excise-base    as decimal   no-undo .
      965     define output parameter p-sale-excise-rubl    as decimal   no-undo .
      966     define output parameter p-sale-transport-base as decimal   no-undo .
      967     define output parameter p-sale-transport-rubl as decimal   no-undo .
      968     define output parameter p-sale-other-base     as decimal   no-undo .
      969     define output parameter p-sale-other-rubl     as decimal   no-undo .
      970     define output parameter p-sale-discnt-base    as decimal   no-undo .
      971     define output parameter p-sale-discnt-rubl    as decimal   no-undo .
      972     define variable vss-description as character no-undo init "holdprts-sale-values-01: параметры продажи товара".
      973     define variable v-gds-dtl-fact-qnty as decimal   no-undo .
      974     define buffer buf_doc-line for ub.doc-line .
      975     define buffer buf_gds-dtl  for ub.gds-dtl.
      976     define buffer buf_goods    for ub.goods.
      977     define buffer buf_trn-doc  for ub.trn-doc.
      978       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
      979       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
      980       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
      981       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
      982       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
      983       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
      984       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
      985       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
      986       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
      987       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
      988       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
      989       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
      990       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
      991       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
      992       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
      993       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
      994       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
      995       define buffer buf_out-vatp_gds-dtl for ub.gds-dtl.
      996       define buffer out-vatp_parts       for ub.parts.
      997       define buffer out-vatp_sysconf     for ub.sysconf.
      998       define buffer out-vatp_doc-line    for ub.doc-line.
      999       define buffer out-vatp_goods       for ub.goods.
     1000       define buffer out-vatp_trn-doc     for ub.trn-doc.
     1001       define buffer out-vatp_doc-attr    for ub.doc-attr.
     1002       define variable varprice-base-cons      like ub.doc-line.price-base initial 0.00 no-undo.
     1003       define variable varprice-rubl-cons      like ub.doc-line.price-rubl initial 0.00 no-undo.
     1004       define variable varfrm-cnsv-type         as   character                           no-undo.
     1005       define variable varfrm-cnsv              as   character                           no-undo.
     1006       define variable varroot-node             as   integer                             no-undo.
     1007       define variable varempty-scale           as   logical                             no-undo.
     1008       define variable varis-cons-parts-have    as   logical                             no-undo.
     1009       define variable varsum-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1010       define variable varslt-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1011       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1012       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
     1013       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1014       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1015       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1016       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1017       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
     1018       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1019       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1020       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1021       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1022       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
     1023       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1024       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1025       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1026       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1027       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
     1028       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1029       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
     1030       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     1031       define variable varis-one-gds-dtl        as   logical                             no-undo.
     1032       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
     1033       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
     1034       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     1035       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     1036       define variable varoutvprb               as   character                           no-undo.
     1037       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
     1038       define buffer   in-vatp-trn-doco  for ub.trn-doc .
     1039       define buffer   in-vatp-partso    for ub.parts   .
     1040       define buffer   in-vatp-doco      for ub.trn-doc .
     1041       define buffer   in-vatp-goodso    for ub.goods   .
     1042       define buffer   in-vatp-sysconfo  for ub.sysconf .
     1043       define buffer   in-vatp_doc-attro for ub.doc-attr.
     1044       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     1045       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     1046       define variable varinvprbo                  as   character              no-undo.
     1047       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     1048       define variable cli-base-rateo              as   decimal                no-undo.
     1049       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     1050       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     1051       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     1052       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     1053       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     1054       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     1055       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     1056       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1057       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     1058       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     1059       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1060       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     1061       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     1062       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     1063       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     1064       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     1065       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     1066       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     1067       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     1068       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1069       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1070       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1071       define variable varinvatp-envdo             as   character              no-undo.
     1072       define variable varinvatp-typeo             as   character              no-undo.
     1073     do
     1074     on error undo, return error return-value
     1075     :
     1076       find first buf_trn-doc no-lock
     1077         where buf_trn-doc.doc-code = p-doc-code
     1078       no-error .
     1079       if not available buf_trn-doc
     1080       then do:
     1081         message
     1082           vss-workfile vss-revision vss-description skip
     1083           vss-include-info1 skip
     1084           "Ошибка задания входных параметров" skip
     1085           "Не найден документ" skip
     1086           "Документ" p-doc-code skip
     1087           "Артикул" p-artic p-prod-type p-prod-code skip
     1088           view-as alert-box error .
     1089         undo, return error .
     1090       end.
     1091       find first buf_doc-line no-lock
     1092         where buf_doc-line.doc-code  = p-doc-code
     1093           and buf_doc-line.artic     = p-artic
     1094           and buf_doc-line.prod-type = p-prod-type
     1095           and buf_doc-line.prod-code = p-prod-code
     1096         no-error .
     1097       if not available buf_doc-line
     1098       then do:
     1099         message
     1100           vss-workfile vss-revision vss-description skip
     1101           vss-include-info1 skip
     1102           "Ошибка задания входных параметров" skip
     1103           "Не найдена строка документа" skip
     1104           "Документ" p-doc-code skip
     1105           "Артикул" p-artic p-prod-type p-prod-code skip
     1106           view-as alert-box error .
     1107         undo, return error .
     1108       end.
     1109       for each buf_gds-dtl no-lock
     1110         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     1111           and buf_gds-dtl.artic     = buf_doc-line.artic
     1112           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1113           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1114       on error undo, return error
     1115       :
     1116         if buf_trn-doc.doc-type <> 'инв':U
     1117         then do:
     1118           if buf_trn-doc.doc-type = 'при':U
     1119           or buf_trn-doc.doc-type = 'возврат':U
     1120           then do:
     1121             assign
     1122               v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1123             .
     1124           end.
     1125           else do:
     1126             assign
     1127               v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1128             .
     1129           end.
     1130         end.
     1131         else do:
     1132           assign
     1133             v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1134           .
     1135         end.
     1136         if v-gds-dtl-fact-qnty <> 0
     1137         then do:
     1138   if buf_trn-doc.ext-doc-type = 'ot':U or
     1139      buf_trn-doc.ext-doc-type = ?                 then do:
     1140     assign
     1141      out-vatp-have-vat-slt = yes.
     1142   end.
     1143   else do:
     1144     find first out-vatp_doc-attr no-lock
     1145       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1146         and out-vatp_doc-attr.attr-code = 'envd':U
     1147         no-error .
     1148     if not available out-vatp_doc-attr then do:
     1149       assign
     1150         out-vatp-have-vat-slt = yes.
     1151     end.
     1152     else do:
     1153        out-vatp-have-vat-slt = no.
     1154     end.
     1155   end.
     1156   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     1157                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     1158                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
