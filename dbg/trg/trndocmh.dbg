     1368             p-sale-road-tax-rubl  = p-sale-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1369             p-sale-excise-base    = p-sale-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1370             p-sale-excise-rubl    = p-sale-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1371             p-sale-discnt-base    = p-sale-discnt-base   + discnt-base-sale          * v-gds-dtl-fact-qnty
     1372             p-sale-discnt-rubl    = p-sale-discnt-rubl   + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1373           .
     1374         end.
     1375       end.
     1376       assign
     1377         p-sale-transport-base = 0
     1378         p-sale-transport-rubl = 0
     1379         p-sale-other-base     = 0
     1380         p-sale-other-rubl     = 0
     1381       .
     1382     end.
     1383   end procedure.
     1384   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
     1386   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
     1387     field cst-code                like ub.trn-doc.cst-code
     1388     field part-code               like ub.parts.part-code
     1389     .
     1390   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
     1391   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
     1392   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
     1393   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1394   procedure doc-code:
     1395   define input  parameter parmode          as   character           no-undo.
     1396   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1397   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1398   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1399   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1400   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1401   define variable vardb-remote     as   logical             no-undo.
     1402   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1403   define variable v-delimiter as character no-undo .
     1404   do
     1405   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1406   :
     1407   find first buf_sys-ctrl no-lock .
     1408   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1409     CASE parmode:
     1410       when "main":u then do:
     1411         if vardb-remote then do:
     1412           assign
     1413             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1414         end.
     1415         else do:
     1416           assign
     1417             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1418         end.
     1419       end.
     1420       when "trio" then do:
     1421         assign
     1422           pardoc-code = replace (parroot-doc-code, "=", "*").
     1423       end.
     1424       otherwise do:
     1425         assign
     1426         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1427         no-error
     1428         .
     1429         if error-status:error  then do:
     1430           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1431                                         ,chr(10)
     1432                                         ,parmode
     1433                                         ).
     1434         end.
     1435         if num-entries(parmode) = 1
     1436         and parmode <> "chip":U
     1437         and parmode <> "chip_s":U
     1438         then do:
     1439           assign
     1440           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1441         end.
     1442         else if (lookup("chip":U, parmode) > 0
     1443                  or
     1444                  lookup("chip_s":U, parmode) > 0) then do:
     1445           assign
     1446             vartemp-doc-code = parroot-doc-code.
     1447           do while true:
     1448             if index (vartemp-doc-code , ".") = 0 then
     1449               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1450             else
     1451               vartemp-doc-code  =
     1452               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1453               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1454               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1455             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1456           end.
     1457           assign
     1458             pardoc-code = vartemp-doc-code.
     1459         end.
     1460       end.
     1461     end CASE.
     1462     if pardoc-code = '':U
     1463     or (parroot-doc-code <> '':U
     1464     and pardoc-code = parroot-doc-code) then do:
     1465       undo, return error substitute("Ошибка при генерации номера документа&1"
     1466                                     ,chr(10)).
     1467     end.
     1468   end.
     1469   end. // procedure/method
     1470   function get-doc-code-int64 returns int64
     1471     ( input p-doc-code as character ) :
     1472     define variable v-ind              as integer   no-undo .
     1473     define variable v-num-entries      as integer   no-undo .
     1474     define variable v-doc-code-int64   as int64     no-undo .
     1475     define variable v-canonic-doc-code as character no-undo .
     1476     assign
     1477       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1478       v-canonic-doc-code = p-doc-code
     1479     .
     1480     do v-ind = 1 to v-num-entries
     1481     :
     1482       assign
     1483         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1484       .
     1485     end.
     1486     assign
     1487       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1488     .
     1489     return v-doc-code-int64 .
     1490   end. // function/method
     1491   procedure hold-ret :
     1492     define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     1493     define buffer bf_trn-doc    for ub.trn-doc.
     1494     define buffer bf_doc-line   for ub.doc-line.
     1495     define buffer bf_gds-dtl    for ub.gds-dtl.
     1496     define buffer bf_parts      for ub.parts.
     1497     define buffer bf_goods      for ub.goods.
     1498     define buffer bf_sysconf    for ub.sysconf.
     1499     define buffer bf_parts-supp for ub.parts-supp.
     1500     define buffer bf-in_trn-doc for ub.trn-doc.
     1501     define buffer bf-orig_parts for ub.parts.
     1502     define variable vartotal-parts-qnty   like ub.parts.fact-qnty      no-undo.
     1503     define variable vartotal-price-base   like ub.parts.price-base     no-undo.
     1504     define variable vartotal-price-rubl   like ub.parts.price-rubl     no-undo.
     1505     define variable vartotal-road-tax     like ub.parts.road-tax-base  no-undo.
     1506     define variable cli_doc-prt           as   logical                 no-undo.
     1507     define variable obj_doc-prt           as   logical                 no-undo.
     1508     define variable varprt-create-n-c     like ub.gds-prt.node-code    no-undo.
     1509     define variable vargds-dtl-chg-qnty   as   decimal                 no-undo.
     1510     define variable vartotal-gds-dtl-qnty as   decimal                 no-undo.
     1511     define variable varcreate-n-c         like ub.gds-prt.node-code    no-undo.
     1512     define variable varcash-pay           like ub.sysconf.cash-pay     no-undo.
     1513     define variable varr-b                as   character               no-undo.
     1514   do transaction on error undo, return error return-value :
     1515   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1516   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1517     (output varr-b
     1518     )  .
     1519   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-error.
     1520   if not available bf_trn-doc then do:
     1521     return error substitute ("Не найден документ с номером &1.", pardoc-code).
     1522   end.
     1523   for each lib-trn_ret-line on error undo, return error return-value :
     1524     find first bf_goods where bf_goods.artic     = lib-trn_ret-line.artic     and
     1525                               bf_goods.prod-type = lib-trn_ret-line.prod-type and
     1526                               bf_goods.prod-code = lib-trn_ret-line.prod-code no-lock.
     1527     create bf_doc-line.
     1528     assign
     1529       bf_doc-line.doc-code       = bf_trn-doc.doc-code
     1530       bf_doc-line.obj-type       = bf_trn-doc.obj-type
     1531       bf_doc-line.obj-code       = bf_trn-doc.obj-code
     1532       bf_doc-line.artic          = lib-trn_ret-line.artic
     1533       bf_doc-line.prod-type      = lib-trn_ret-line.prod-type
     1534       bf_doc-line.prod-code      = lib-trn_ret-line.prod-code
     1535       bf_doc-line.cli-qnty       = lib-trn_ret-line.cli-qnty
     1536       bf_doc-line.doc-qnty       = lib-trn_ret-line.doc-qnty
     1537       bf_doc-line.fact-qnty      = lib-trn_ret-line.fact-qnty
     1538       bf_doc-line.SLT-pc         = lib-trn_ret-line.slt-pc
     1539       bf_doc-line.VAT-pc         = lib-trn_ret-line.vat-pc
     1540       bf_doc-line.cons-vat-pc    = lib-trn_ret-line.cons-vat-pc
     1541       bf_doc-line.cons-slt-pc    = lib-trn_ret-line.cons-slt-pc
     1542       bf_doc-line.transport-base = 0
     1543       bf_doc-line.transport-rubl = 0
     1544       bf_doc-line.other-base     = 0
     1545       bf_doc-line.other-rubl     = 0
     1546       bf_doc-line.unit-cli       = lib-trn_ret-line.unit-cli
     1547       bf_doc-line.prt-root       = lib-trn_ret-line.prt-root
     1548       bf_doc-line.prt-OK         = yes
     1549       bf_doc-line.fact-order     = 0
     1550       bf_doc-line.cli-base-rate  = lib-trn_ret-line.cli-base-rate
     1551       bf_doc-line.doc-density    = lib-trn_ret-line.fact-density
     1552       bf_doc-line.fact-density   = lib-trn_ret-line.fact-density
     1553       bf_doc-line.num-place      = lib-trn_ret-line.num-place
     1554       bf_doc-line.wt-brutto      = lib-trn_ret-line.wt-brutto.
     1555     for each lib-trn_ret-parts
     1556       where lib-trn_ret-parts.obj-type  = lib-trn_ret-line.obj-type
     1557         and lib-trn_ret-parts.obj-code  = lib-trn_ret-line.obj-code
     1558         and lib-trn_ret-parts.artic     = lib-trn_ret-line.artic
     1559         and lib-trn_ret-parts.prod-type = lib-trn_ret-line.prod-type
     1560         and lib-trn_ret-parts.prod-code = lib-trn_ret-line.prod-code
     1561         and lib-trn_ret-parts.out-code  = lib-trn_ret-line.doc-code
     1562       on error undo, return error return-value
     1563       :
     1564       if lib-trn_ret-parts.fact-qnty < 0 then do:
     1565          undo, return error "В документе межфирменного перемещения. Фактическое количество в партии не может быть отрицательным." .
     1566       end.
     1567       find first bf_parts-supp where bf_parts-supp.in-code   = lib-trn_ret-parts.in-code   and
     1568                                      bf_parts-supp.artic     = lib-trn_ret-parts.artic     and
     1569                                      bf_parts-supp.prod-type = lib-trn_ret-parts.prod-type and
     1570                                      bf_parts-supp.prod-code = lib-trn_ret-parts.prod-code and
     1571                                      bf_parts-supp.part-code = lib-trn_ret-parts.part-code no-error.
     1572       if not available bf_parts-supp then do:
     1573         undo, return error substitute ("Не найдена информация о поставщике по партии &1 &2 &3 &4 &5.",
     1574                                        lib-trn_ret-parts.in-code  ,
     1575                                        lib-trn_ret-parts.artic    ,
     1576                                        lib-trn_ret-parts.prod-type,
     1577                                        lib-trn_ret-parts.prod-code,
     1578                                        lib-trn_ret-parts.part-code ).
     1579       end.
     1580       find first bf-in_trn-doc where bf-in_trn-doc.doc-code = lib-trn_ret-parts.in-code no-lock no-error.
     1581       if not available bf-in_trn-doc then do:
     1582         undo, return error substitute ("Не найден документ с номером &1 породивший партию документа &2.", lib-trn_ret-parts.in-code, bf_trn-doc.doc-code).
     1583       end.
     1584       find first bf-orig_parts  where bf-orig_parts.obj-type  = bf_trn-doc.obj-type                and
     1585                                       bf-orig_parts.obj-code  = bf_trn-doc.obj-code                and
     1586                                       bf-orig_parts.artic     = bf_parts-supp.artic                and
     1587                                       bf-orig_parts.prod-type = bf_parts-supp.prod-type            and
     1588                                       bf-orig_parts.prod-code = bf_parts-supp.prod-code            and
     1589                                       bf-orig_parts.in-code   = bf_parts-supp.orig-in-code         and
     1590                                       bf-orig_parts.out-code  = bf-in_trn-doc.hold-doc-code-parent and
     1591                                       bf-orig_parts.part-code = bf_parts-supp.orig-part-code       no-error.
     1592       if not available bf-orig_parts then do:
     1593         undo, return error substitute ("Для формирования документа необходимо наличие партии документа межфирменного расхода на наш объект. Не найдена партия: объект &1 &2 товар &3 &4 &5 документ &6 партия &7 &8.",
     1594                                        bf_trn-doc.obj-type,
     1595                                        bf_trn-doc.obj-code,
     1596                                        bf_parts-supp.artic,
     1597                                        bf_parts-supp.prod-type,
     1598                                        bf_parts-supp.prod-code,
     1599                                        bf-in_trn-doc.hold-doc-code-parent,
     1600                                        bf_parts-supp.orig-in-code,
     1601                                        bf_parts-supp.orig-part-code).
     1602       end.
     1603       find first bf_parts where bf_parts.obj-type  = bf-orig_parts.obj-type
     1604                             and bf_parts.obj-code  = bf-orig_parts.obj-code
     1605                             and bf_parts.artic     = bf-orig_parts.artic
     1606                             and bf_parts.prod-type = bf-orig_parts.prod-type
     1607                             and bf_parts.prod-code = bf-orig_parts.prod-code
     1608                             and bf_parts.in-code   = bf-orig_parts.in-code
     1609                             and bf_parts.out-code  = bf_trn-doc.doc-code
     1610                             and bf_parts.part-code = bf-orig_parts.part-code no-error.
     1611       if not available bf_parts then do:
     1612         create bf_parts .
     1613         assign
     1614           bf_parts.obj-type        = bf-orig_parts.obj-type
     1615           bf_parts.obj-code        = bf-orig_parts.obj-code
     1616           bf_parts.artic           = bf-orig_parts.artic
     1617           bf_parts.prod-type       = bf-orig_parts.prod-type
     1618           bf_parts.prod-code       = bf-orig_parts.prod-code
     1619           bf_parts.in-code         = bf-orig_parts.in-code
     1620           bf_parts.out-code        = bf_trn-doc.doc-code
     1621           bf_parts.part-code       = bf-orig_parts.part-code
     1622           bf_parts.price-base      = bf-orig_parts.price-base
     1623           bf_parts.price-rubl      = bf-orig_parts.price-rubl
     1624           bf_parts.vat-pc          = bf-orig_parts.vat-pc
     1625           bf_parts.pay-code        = bf-orig_parts.pay-code
     1626           bf_parts.status_         = no
     1627           bf_parts.supp-type       = bf-orig_parts.supp-type
     1628           bf_parts.supp-code       = bf-orig_parts.supp-code
     1629           bf_parts.rsrv-free       = ?
     1630           bf_parts.doc-type        = bf_trn-doc.doc-type
     1631           bf_parts.pl-code         = bf-orig_parts.pl-code
     1632           bf_parts.vat-type        = bf-orig_parts.vat-type
     1633           bf_parts.exch-code       = bf-orig_parts.exch-code
     1634           bf_parts.price-cli       = bf-orig_parts.price-cli
     1635           bf_parts.cli-base-rate   = bf-orig_parts.cli-base-rate
     1636           bf_parts.slt-pc          = bf-orig_parts.slt-pc
     1637           bf_parts.host-code       = bf-orig_parts.host-code
     1638           bf_parts.is-supp         = bf-orig_parts.is-supp
     1639           bf_parts.slt-type        = bf-orig_parts.slt-type
     1640           bf_parts.cst-code        = bf-orig_parts.cst-code
     1641           bf_parts.last-date       = bf-orig_parts.last-date
     1642           bf_parts.road-tax-base   = bf-orig_parts.road-tax-base
     1643           bf_parts.road-tax-rubl   = bf-orig_parts.road-tax-rubl
     1644           bf_parts.transport-base  = bf-orig_parts.transport-base
     1645           bf_parts.transport-rubl  = bf-orig_parts.transport-rubl
     1646           bf_parts.other-base      = bf-orig_parts.other-base
     1647           bf_parts.other-rubl      = bf-orig_parts.other-rubl
     1648           bf_parts.purch-code      = bf-orig_parts.purch-code
     1649           bf_parts.cli-qnty        = lib-trn_ret-parts.cli-qnty
     1650           bf_parts.real-qnty       = bf-orig_parts.real-qnty
     1651           bf_parts.qnty            = lib-trn_ret-parts.qnty
     1652           bf_parts.fact-qnty       = lib-trn_ret-parts.fact-qnty
     1653           .
     1654       end.
     1655       else do:
     1656         assign
     1657           bf_parts.cli-qnty        = bf_parts.cli-qnty  + lib-trn_ret-parts.cli-qnty
     1658           bf_parts.real-qnty       = bf_parts.real-qnty + bf-orig_parts.real-qnty
     1659           bf_parts.qnty            = bf_parts.qnty      + lib-trn_ret-parts.qnty
     1660           bf_parts.fact-qnty       = bf_parts.fact-qnty + lib-trn_ret-parts.fact-qnty
     1661           .
     1662       end.
     1663     end.
     1664     assign
     1665       vartotal-parts-qnty = 0
     1666       vartotal-price-base = 0
     1667       vartotal-price-rubl = 0
     1668       vartotal-road-tax   = 0
     1669     .
     1670     for each bf_parts
     1671       where bf_parts.obj-type  = bf_doc-line.obj-type
     1672         and bf_parts.obj-code  = bf_doc-line.obj-code
     1673         and bf_parts.artic     = bf_doc-line.artic
     1674         and bf_parts.prod-type = bf_doc-line.prod-type
     1675         and bf_parts.prod-code = bf_doc-line.prod-code
     1676         and bf_parts.out-code  = bf_doc-line.doc-code
     1677     on error undo, return error return-value
     1678     :
     1679       assign
     1680         vartotal-parts-qnty = vartotal-parts-qnty + bf_parts.fact-qnty
     1681         vartotal-price-base = vartotal-price-base + bf_parts.fact-qnty * bf_parts.price-base
     1682         vartotal-price-rubl = vartotal-price-rubl + bf_parts.fact-qnty * bf_parts.price-rubl
     1683       .
     1684       if varr-b = "rubl":u then do:
     1685         assign
     1686           vartotal-road-tax   = vartotal-road-tax   + bf_parts.fact-qnty * bf_parts.road-tax-rubl
     1687         .
     1688       end.
     1689       else do:
     1690         assign
     1691           vartotal-road-tax   = vartotal-road-tax   + bf_parts.fact-qnty * bf_parts.road-tax-rubl
     1692         .
     1693       end.
     1694     end.
     1695     if bf_doc-line.fact-qnty <> vartotal-parts-qnty then do:
     1696       undo, return error substitute ("Количество в партиях не совпадает с количеством в строке документа. Количество по документу = &1 Количество по партиям = &2 ", bf_doc-line.fact-qnty, vartotal-parts-qnty).
     1697     end.
     1698     if vartotal-parts-qnty <> 0 then do:
     1699       assign
     1700         bf_doc-line.price-rubl = vartotal-price-rubl / vartotal-parts-qnty
     1701         bf_doc-line.price-base = vartotal-price-base / vartotal-parts-qnty
     1702         bf_doc-line.price-cli  = vartotal-price-base / vartotal-parts-qnty
     1703         bf_doc-line.road-tax   = vartotal-road-tax   / vartotal-parts-qnty
     1704       .
     1705     end.
     1706   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1707   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1708     (input  bf_trn-doc.hold-obj-type
     1709     ,input  bf_trn-doc.hold-obj-code
     1710     ,input  'doc-prt=request':u
     1711     ,output cli_doc-prt
