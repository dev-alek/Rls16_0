        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type   as character no-undo .
        3   define input  parameter p-obj-code   as integer   no-undo .
        4   define input  parameter p-in-code    as character no-undo .
        5   define input  parameter p-gds-code   as integer   no-undo .
        6   define input  parameter p-part-code  as character no-undo .
        7   define input  parameter p-last-date  as date      no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Изменение срока годности для партии приходной накладной".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define buffer buf_gds-obj for ub.gds-obj .
       71   define buffer buf_parts for ub.parts .
       72   define buffer buf_parts-attr for ub.parts-attr .
       73   define variable v-artic     as character no-undo .
       74   define variable v-prod-type as character no-undo .
       75   define variable v-prod-code as integer   no-undo .
       76   main-block:
       77   do transaction
       78   on error undo main-block, return error
       79   :
       80     find first buf_gds-obj exclusive-lock
       81       where buf_gds-obj.gds-code = p-gds-code
       82         and buf_gds-obj.obj-type = p-obj-type
       83         and buf_gds-obj.obj-code = p-obj-code
       84       no-error .
       85     if not available buf_gds-obj
       86     then do:
       87       message
       88         vss-workfile vss-revision vss-description skip
       89         "Ошибка задания входных параметров" skip
       90         "Не найдена запись товар на объекте" skip
       91         "Объект" p-obj-type p-obj-code skip
       92         "Код товара" p-gds-code skip
       93         view-as alert-box error .
       94       undo, return error return-value .
       95     end.
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run arptpc in g#library
       98     (input  p-gds-code
       99     ,output v-artic
      100     ,output v-prod-type
      101     ,output v-prod-code
      102     )  .
      103     for each ub.parts share-lock
      104       where ub.parts.in-code   = p-in-code
      105         and ub.parts.artic     = v-artic
      106         and ub.parts.prod-type = v-prod-type
      107         and ub.parts.prod-code = v-prod-code
      108         and ub.parts.part-code = p-part-code
      109         and ub.parts.obj-type  = p-obj-type
      110         and ub.parts.obj-code  = p-obj-code
      111     on error undo main-block, return error
      112     :
      113       if ub.parts.last-date <> p-last-date
      114       then do:
      115         find first buf_parts exclusive-lock
      116           where recid(buf_parts) = recid(ub.parts)
      117           .
      118         assign
      119           buf_parts.last-date = p-last-date
      120         .
      121       end.
      122     end.
      123   end.
