        1   block-level on error undo, throw.
        2   define input  parameter p-obj-type          as character no-undo .
        3   define input  parameter p-obj-code          as integer   no-undo .
        4   define input  parameter p-check-act         as logical   no-undo .
        5   define input  parameter p-check-act-db-num  as integer   no-undo .
        6   define input  parameter p-check-act-user-id as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Перерасчет переоценок, которые изменились в связи с закрытием или удалением документов".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3':u,p-obj-type,p-obj-code,p-check-act)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure cur-time :
       87      define output parameter p-today as date      no-undo .
       88      define output parameter p-time  as integer   no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       define variable v-date1 as date      no-undo .
       93       define variable v-date2 as date      no-undo .
       94       define variable v-time  as integer   no-undo .
       95       assign
       96         v-date1 = today
       97         v-time  = time
       98         v-date2 = today
       99       .
      100       if v-date1 <> v-date2
      101       then do:
      102         assign
      103           v-date1 = today
      104           v-time  = v-time
      105         .
      106       end.
      107       assign
      108         p-today = v-date1
      109         p-time  = v-time
      110       .
      111     end.
      112   end.
      113   function cur-time-date returns character
      114   :
      115     return string(today, '99/99/9999':U) .
      116   end.
      117   function cur-time-mjd returns decimal
      118   :
      119     define variable v-date as date      no-undo .
      120     define variable v-time as integer   no-undo .
      121     run cur-time in this-procedure
      122       (output v-date
      123       ,output v-time
      124       ) .
      125     return integer(v-date) - 2400002 + (v-time / 86400) .
      126   end.
      127   function cur-time-get-ending-index returns integer
      128   (input p-number as integer
      129   )
      130   :
      131     if p-number < 0
      132     or p-number = ?
      133     then do:
      134       return 1 .
      135     end.
      136     define variable v-rest as integer   no-undo .
      137     assign
      138       p-number = p-number modulo 100
      139     .
      140     if p-number < 20
      141     then do:
      142       assign
      143         v-rest = p-number
      144       .
      145     end.
      146     else do:
      147       assign
      148         v-rest = p-number modulo 10
      149       .
      150     end.
      151     case v-rest :
      152       when 1
      153       then do:
      154         return 2 .
      155       end.
      156       when 2 or
      157       when 3 or
      158       when 4
      159       then do:
      160         return 3 .
      161       end.
      162       otherwise do:
      163         return 1 .
      164       end.
      165     end case .
      166   end.
      167   procedure cur-time-mjd-to-date :
      168      define input  parameter i-mjd-diff as decimal no-undo.
      169      define output parameter o-Date     as date    no-undo.
      170      define output parameter o-Time     as integer no-undo.
      171      define variable v-day-number as integer   no-undo .
      172      if    i-mjd-diff < 0
      173         or i-mjd-diff = ?
      174      then do:
      175         return "?" .
      176      end.
      177      assign
      178         v-day-number = truncate(i-mjd-diff,0).
      179         o-Date = date(v-day-number + 2400002).
      180         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      181     .
      182   end.
      183   function cur-time-mjd-to-string returns character
      184   (input p-mjd-diff as decimal
      185   )
      186   :
      187     define variable v-day-number as integer   no-undo .
      188     define variable v-seconds    as integer   no-undo .
      189     define variable v-hour       as integer   no-undo .
      190     define variable v-min        as integer   no-undo .
      191     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      192     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      193     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      194     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      195     if p-mjd-diff < 0
      196     or p-mjd-diff = ?
      197     then do:
      198       return "?" .
      199     end.
      200     assign
      201       v-day-number = integer(truncate(p-mjd-diff,0))
      202       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204     if v-seconds > 86400
      205     then do:
      206       assign
      207         v-seconds = 86400 - 1
      208       .
      209     end.
      210     if v-seconds < 0
      211     then do:
      212       assign
      213         v-seconds = 0
      214       .
      215     end.
      216     assign
      217       v-hour = truncate(v-seconds / 3600, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 3600
      221     .
      222     assign
      223       v-min = truncate(v-seconds / 60, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 60
      227     .
      228     return
      229         (if v-day-number <> 0
      230           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0
      234           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      238           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      239           else ""
      240         )
      241       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      242       .
      243   end.
      244   function cur-time-string returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      253   end.
      254   function cur-time-string-sec returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      263   end.
      264   function cur-time-custom  returns character
      265   (input p-prefix as character
      266   ,input p-date-format as character
      267   ,input p-delimiter as character
      268   ,input p-time-format as character
      269   ,input p-suffix as character
      270   )
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return
      279       p-prefix
      280       + string(v-date, p-date-format)
      281       + p-delimiter
      282       + string(v-time, p-time-format)
      283       + p-suffix
      284       .
      285   end.
      286   function cur-time-print  returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-datetime returns datetime
      297   :
      298     define variable v-char as character no-undo .
      299     define variable v-datetime as datetime no-undo .
      300     v-char = cur-time-string().
      301     v-datetime = datetime(v-char).
      302     return  v-datetime.
      303   end.
      304   function cur-time-string-msec returns character
      305   :
      306     define variable v-date as datetime  no-undo .
      307     v-date = now.
      308     return string(v-date) .
      309   end.
      310   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   procedure get-ro_get-read-only :
      312     define output parameter p-ro-set as logical   no-undo .
      313     do
      314     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info1, return-value, error-status :get-message( 1 ) )
      315     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info1 )
      316     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info1 )
      317     :
      318       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      319       then do:
      320         assign
      321           p-ro-set = true
      322         .
      323       end.
      324       else do:
      325         assign
      326           p-ro-set = false
      327         .
      328       end.
      329     end.
      330   end procedure.
      331   define buffer buf_batchprocess for ub.batchprocess .
      332   define buffer exec_batchprocess for ub.batchprocess .
      333   define buffer buf_price-doc for ub.price-doc .
      334   define variable v-was-processing as logical   no-undo .
      335   define variable v-get-ro_read-only      as logical   no-undo .
      336   do
      337   on error undo, return error return-value
      338   :
      339     define buffer calc-prc-lock_batchprocess for ub.batchprocess .
      340     run get-ro_get-read-only in this-procedure
      341       (output v-get-ro_read-only
      342       ) .
      343     if v-get-ro_read-only = false
      344     then do:
      345       run gbl/lock-prc.p
      346         (input  'ahpr':U
      347         ,input  p-obj-code
      348         ,input  0
      349         ,input  0
      350         ,input  p-obj-type
      351         ,input  ""
      352         ,input  ""
      353         ,input  "Объект,,, ,,,Перерасчет переоценок"
      354         ,input  false
      355         ,buffer calc-prc-lock_batchprocess
      356         ) no-error .
      357       if error-status :error then do:
      358         if error-status :get-message(1) <> ""
      359         then do:
      360           message
      361             vss-workfile vss-revision vss-description skip
      362             "В данный момент рассчитываются переоценки" skip
      363             error-status :get-message(1) skip
      364             return-value skip
      365             view-as alert-box error .
      366         end.
      367         undo, return error "В данный момент рассчитываются переоценки" .
      368       end.
      369     end.
      370     for each buf_BatchProcess no-lock
      371       where buf_BatchProcess.bp_type       = 'prc':U
      372         and buf_BatchProcess.bp_status     = 'N':U
      373         and buf_BatchProcess.CharKey_Three = p-obj-type
      374         and buf_BatchProcess.Key#_One      = p-obj-code
      375     on error undo, return error
      376     :
      377       if p-check-act = true
      378       then do:
      379         define variable v-ok as logical   no-undo .
      380         define variable v-chk-act-host-code as integer   no-undo .
      381   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      383     (input  p-obj-type
      384     ,input  p-obj-code
      385     ,output v-chk-act-host-code
      386     )  .
      387   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388   do:
      389     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      390       (input  p-check-act-db-num
      391       ,input  p-check-act-user-id
      392       ,input  0
      393       ,input  'actn_archive-prc_update':U
      394       ,input  'object':U
      395       ,input  v-chk-act-host-code
      396       ,input  p-obj-type
      397       ,input  p-obj-code
      398       ,input  0
      399       ,input  0
      400       ,input  0
      401       ,input  false
      402       ,output v-ok
      403       )  .
      404   end.
      405         if v-ok <> true
      406         then do:
      407           undo, return error substitute("Отсутствуют права на перерасчёт переоценок. &1"
      408                                        ,return-value
      409                                        ) .
      410         end.
      411       end.
      412       if v-get-ro_read-only = false
      413       then do:
      414         find first buf_price-doc no-lock
      415           where buf_price-doc.doc-num = buf_batchprocess.charkey_one
      416           no-error .
      417         if not available buf_price-doc then do:
      418           message
      419             vss-workfile vss-revision vss-description skip
      420             "Не найден документ переоценки" skip
      421             "Переоценка" buf_batchprocess.charkey_one skip
      422             view-as alert-box error .
      423           undo, return error .
      424         end.
      425         assign
      426           v-was-processing = true
      427         .
      428         do transaction
      429         on error undo, return error return-value
      430         :
      431     find first exec_batchprocess exclusive-lock
      432       where rowid(exec_batchprocess) = rowid(buf_batchprocess)
      433       no-error .
      434     if not available exec_batchprocess then do:
      435       message
      436         vss-workfile vss-revision vss-description skip
      437         "Не найдена запись пересчета архива" skip
      438         view-as alert-box error .
      439       undo, return error .
      440     end.
      441     if exec_batchprocess.bp_status <> 'N':U then do:
      442       message
      443         vss-workfile vss-revision vss-description skip
      444         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
      445         "BP_Type"       exec_batchprocess.BP_Type       skip
      446         "BP_Status"     exec_batchprocess.BP_Status     skip
      447         "Key#_One"      exec_batchprocess.Key#_One      skip
      448         "Key#_Two"      exec_batchprocess.Key#_Two      skip
      449         "Key#_Three"    exec_batchprocess.Key#_Three    skip
      450         "CharKey_One"   exec_batchprocess.CharKey_One   skip
      451         "CharKey_Two"   exec_batchprocess.CharKey_Two   skip
      452         "CharKey_Three" exec_batchprocess.CharKey_Three skip
      453         view-as alert-box error .
      454       undo, return error .
      455     end.
      456       define variable v-btpr_upd-today-4 as date      no-undo.
      457     define variable v-btpr_upd-time-4  as integer   no-undo.
      458     run cur-time in this-procedure ( output v-btpr_upd-today-4
      459                                    , output v-btpr_upd-time-4
      460                                    ).
      461     assign
      462       exec_batchprocess.bp_status         = 'D':U
      463       exec_batchprocess.bp_execcounttries = exec_batchprocess.bp_execcounttries + 1
      464       exec_batchprocess.bp_execuser_id    = g#userid
      465       exec_batchprocess.bp_execsysdate    = v-btpr_upd-today-4
      466       exec_batchprocess.bp_execsystime    = string(v-btpr_upd-time-4, 'hh:mm')
      467       exec_batchprocess.bp_execsystimeint = v-btpr_upd-time-4
      468     .
      469           run str/pr-oldd.p
      470             (input buf_price-doc.doc-num
      471             ) no-error .
      472           if error-status :error then do:
      473             message
      474               vss-workfile vss-revision vss-description skip
      475               "Ошибка при перерасчете переоценки" skip
      476               "Переоценка" buf_price-doc.doc-num skip
      477               error-status :get-message(1) skip
      478               return-value skip
      479               view-as alert-box error .
      480             undo, return error .
      481           end.
      482         end.
      483       end.
      484       else do:
      485         undo, return error substitute("Перерасчет переоценок. Объект &1 &2. Имеются нерассчитанные переоценки. Переценки невозможно рассчитать при подключении только_для_чтения"
      486                                      ,p-obj-type
      487                                      ,p-obj-code
      488                                      ) .
      489       end.
      490     end.
      491   end.
      492   if v-was-processing then do:
      493     return "true":u .
      494   end.
      495   else do:
      496     return "":u .
      497   end.
