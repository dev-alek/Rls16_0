        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code like ub.ord-doc.doc-code no-undo .
        3   define input  parameter parphchip-num      as   integer                      no-undo.
        4   define output parameter parchip-num        as   integer                      no-undo.
        5   define variable vss-revision    as character no-undo initial "$Revision$":U .
        6   define variable vss-author      as character no-undo initial "$Author$":U .
        7   define variable vss-date        as character no-undo initial "$Date$":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        9   define variable vss-archive     as character no-undo initial "$Archive$":U .
       10   define variable vss-description as character no-undo initial "Удаление документа матценностей".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1':u,p-doc-code)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   do
       84   on error undo, return error return-value
       85   :
       86     define buffer buf_ord-doc for ub.ord-doc .
       87     define variable l-shift-on      as logical   no-undo .
       88     define variable varobj-date     as date                      no-undo.
       89     define variable varshift-date   like ub.shift-obj.shift-date no-undo.
       90     define variable varshift-num    like ub.shift-obj.shift-num  no-undo.
       91     find first buf_ord-doc exclusive-lock
       92       where buf_ord-doc.doc-code = p-doc-code
       93       no-error .
       94     if not available buf_ord-doc then do:
       95       message
       96         vss-workfile vss-revision vss-description skip
       97         "Ошибка задания входных параметров" skip
       98         "ЗАКАЗ" p-doc-code skip
       99         view-as alert-box error .
      100       undo, return error .
      101     end.
      102   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      104     (input  buf_ord-doc.cli-type
      105     ,input  buf_ord-doc.cli-code
      106     ,output varobj-date
      107     ) no-error .
      108     if error-status :error
      109     or varobj-date = ?
      110     then do:
      111       message
      112         vss-workfile vss-revision vss-description skip
      113         "Нет текущей даты на объекте"  skip
      114         view-as alert-box error .
      115       undo, return error .
      116     end.
      117     if not g#news then do:
      118       run hstc-ord-doc in this-procedure
      119         (input recid(buf_ord-doc)
      120         ,input varobj-date
      121         ,input g#userid
      122         ,input parphchip-num
      123         ,output parchip-num
      124         ) no-error .
      125       if error-status :error then do:
      126         message
      127           vss-workfile vss-revision vss-description skip
      128           "Ошибка при копировании в историю удаляемых заказов" skip
      129           view-as alert-box error .
      130         undo, return error.
      131       end.
      132     end.
      133     define variable v-obj-type   as character no-undo .
      134     define variable v-obj-code   as integer   no-undo .
      135     define variable v-fact-order as decimal   no-undo .
      136     assign
      137       v-obj-type   = buf_ord-doc.cli-type
      138       v-obj-code   = buf_ord-doc.cli-code
      139       v-fact-order = buf_ord-doc.fact-order
      140     .
      141     delete buf_ord-doc .
      142   end.
      143   procedure hstc-ord-doc :
      144     define input parameter parrec-ord-doc as   recid                 no-undo.
      145     define input parameter parobj-date    as   date                    no-undo.
      146     define input parameter paruserid      as   character               no-undo.
      147     define input  parameter parphchip-num      as   integer                      no-undo.
      148     define output parameter parchip-num        as   integer                      no-undo.
      149     define buffer hstc_ord-doc          for ub.ord-doc.
      150     define buffer hstc_ord-line         for ub.ord-line.
      151     define buffer hstc_ord-dtl          for ub.ord-dtl.
      152     define buffer hstc_c-ord-doc        for ub.c-ord-doc.
      153     define buffer hstc_c-ord-line       for ub.c-ord-line.
      154     do
      155     on error undo, return error return-value
      156     :
      157       find first hstc_ord-doc
      158         where recid (hstc_ord-doc) = parrec-ord-doc
      159         .
      160       create hstc_c-ord-doc .
      161       buffer-copy hstc_ord-doc to hstc_c-ord-doc .
      162       assign
      163         hstc_c-ord-doc.chip-num        = (if parphchip-num <> ?
      164                                          then parphchip-num
      165                                          else next-value(s-corr-chip, ub))
      166         hstc_c-ord-doc.corr-date       = parobj-date
      167         hstc_c-ord-doc.corr-user-name       = paruserid
      168       .
      169       for each hstc_ord-line
      170         where hstc_ord-line.doc-code = hstc_ord-doc.doc-code
      171       on error undo, return error
      172       :
      173         create hstc_c-ord-line.
      174         buffer-copy hstc_ord-line to hstc_c-ord-line.
      175         assign
      176           hstc_c-ord-line.chip-num = hstc_c-ord-doc.chip-num
      177         .
      178       end.
      179       assign
      180       parchip-num = hstc_c-ord-doc.chip-num
      181       .
      182     end.
      183   end procedure.
