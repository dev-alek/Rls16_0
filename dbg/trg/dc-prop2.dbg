        1   block-level on error undo, throw.
        2   define input parameter p-range  as integer no-undo .
        3   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
        4   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
        5   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
        6   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
        7   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
        8   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
        9   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Проверка валидности записи свойства ДК".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define buffer buf_sysconf for ub.sysconf.
       71   define buffer buf_clients for ub.clients.
       72   define buffer buf_dis-card for ub.dis-card.
       73   define buffer buf_attr-prop for ub.attr-prop.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable v-message as character no-undo .
       90   if p-host-code > 0 then do:
       91     FIND FIRST buf_sysconf No-LOCK WHERE
       92               buf_sysconf.host-code = p-host-code No-ERROR.
       93     IF NOT AVAIL buf_sysconf THEN DO:
       94       run err-mess  in this-procedure (substitute("Не найдена фирма &1", p-host-code)).
       95       RETURN ERROR v-message.
       96     END.
       97   end.
       98   if p-obj-type <> "":U or
       99       p-obj-code <> 0 then do:
      100     find first buf_clients No-LOCK WHERE
      101                buf_clients.obj-type = p-obj-type AND
      102                buf_clients.obj-code = p-obj-code no-error .
      103     if not available buf_clients then do:
      104       run err-mess in this-procedure ( input substitute("Не найден объект &1&2", p-obj-type, p-obj-code)).
      105       RETURN ERROR v-message.
      106     end.
      107   end.
      108   else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
      109     run err-mess in this-procedure ( input  substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
      110                             , p-obj-type
      111                             , p-obj-code
      112                             , p-host-code)).
      113     RETURN ERROR v-message.
      114   end.
      115   if p-d-card <> "":U then do:
      116     find first buf_dis-card No-LOCK WHERE
      117                 buf_dis-card.d-card = p-d-card No-ERROR.
      118       if not avail buf_dis-card then do:
      119       run err-mess in this-procedure ( input  substitute("Не найдена ДК")).
      120       return error  v-message.
      121     end.
      122     if buf_dis-card.emitent-host-code <> 0
      123     and p-host-code <> buf_dis-card.emitent-host-code then do:
      124       run err-mess in this-procedure ( input  substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту")).
      125       return error v-message.
      126     end.
      127     if buf_dis-card.emitent-host-code = 0
      128     and p-range = 1
      129     and p-host-code <> 0 then do:
      130       run err-mess in this-procedure ( input  substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
      131                              "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
      132                               , chr(10)
      133                              )).
      134       return error v-message.
      135     end.
      136   end.
      137    PROCEDURE err-mess:
      138     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      139     assign
      140     v-message =  substitute("Карта №&1: свойство &2.&3 срез &4 для фирмы &5 объект &6&7&8"
      141                    , p-d-card
      142                    , p-dtm-code
      143                    , p-node-code
      144                    , p-dt-code
      145                    , p-host-code
      146                    , p-obj-type
      147                    , p-obj-code
      148                    , chr(10)
      149                    )    +
      150                  p-mess
      151     .
      152   END PROCEDURE.
