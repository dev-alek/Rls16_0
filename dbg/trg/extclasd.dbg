        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.ext-classif .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись ext-classif".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8|&9'
       29                           , ub.ext-classif.classif-subject
       30                           , ub.ext-classif.classif-name
       31                           , ub.ext-classif.key#_one
       32                           , ub.ext-classif.key#_two
       33                           , ub.ext-classif.key#_three
       34                           , ub.ext-classif.charkey_one
       35                           , ub.ext-classif.charkey_two
       36                           , ub.ext-classif.charkey_three
       37                           , ub.ext-classif.nonunique
       38                           )
       39       .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define   shared variable g#auto as logical no-undo.
       83   define   shared variable g#news as logical no-undo.
       84   define   shared variable g#oxml as logical no-undo.
       85   define   shared variable g#esys as logical no-undo.
       86   define   shared variable g#news-source-db as integer no-undo.
       87   define   shared variable g#esys-source-esys as integer no-undo.
       88   define   shared variable g#db-num as integer   no-undo .
       89   define   shared variable g#userid as character no-undo .
       90   define   shared variable g#passwd as character no-undo .
       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   procedure cur-time :
       93      define output parameter p-today as date      no-undo .
       94      define output parameter p-time  as integer   no-undo .
       95     do
       96     on error undo, return error
       97     :
       98       define variable v-date1 as date      no-undo .
       99       define variable v-date2 as date      no-undo .
      100       define variable v-time  as integer   no-undo .
      101       assign
      102         v-date1 = today
      103         v-time  = time
      104         v-date2 = today
      105       .
      106       if v-date1 <> v-date2
      107       then do:
      108         assign
      109           v-date1 = today
      110           v-time  = v-time
      111         .
      112       end.
      113       assign
      114         p-today = v-date1
      115         p-time  = v-time
      116       .
      117     end.
      118   end.
      119   function cur-time-date returns character
      120   :
      121     return string(today, '99/99/9999':U) .
      122   end.
      123   function cur-time-mjd returns decimal
      124   :
      125     define variable v-date as date      no-undo .
      126     define variable v-time as integer   no-undo .
      127     run cur-time in this-procedure
      128       (output v-date
      129       ,output v-time
      130       ) .
      131     return integer(v-date) - 2400002 + (v-time / 86400) .
      132   end.
      133   function cur-time-get-ending-index returns integer
      134   (input p-number as integer
      135   )
      136   :
      137     if p-number < 0
      138     or p-number = ?
      139     then do:
      140       return 1 .
      141     end.
      142     define variable v-rest as integer   no-undo .
      143     assign
      144       p-number = p-number modulo 100
      145     .
      146     if p-number < 20
      147     then do:
      148       assign
      149         v-rest = p-number
      150       .
      151     end.
      152     else do:
      153       assign
      154         v-rest = p-number modulo 10
      155       .
      156     end.
      157     case v-rest :
      158       when 1
      159       then do:
      160         return 2 .
      161       end.
      162       when 2 or
      163       when 3 or
      164       when 4
      165       then do:
      166         return 3 .
      167       end.
      168       otherwise do:
      169         return 1 .
      170       end.
      171     end case .
      172   end.
      173   procedure cur-time-mjd-to-date :
      174      define input  parameter i-mjd-diff as decimal no-undo.
      175      define output parameter o-Date     as date    no-undo.
      176      define output parameter o-Time     as integer no-undo.
      177      define variable v-day-number as integer   no-undo .
      178      if    i-mjd-diff < 0
      179         or i-mjd-diff = ?
      180      then do:
      181         return "?" .
      182      end.
      183      assign
      184         v-day-number = truncate(i-mjd-diff,0).
      185         o-Date = date(v-day-number + 2400002).
      186         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188   end.
      189   function cur-time-mjd-to-string returns character
      190   (input p-mjd-diff as decimal
      191   )
      192   :
      193     define variable v-day-number as integer   no-undo .
      194     define variable v-seconds    as integer   no-undo .
      195     define variable v-hour       as integer   no-undo .
      196     define variable v-min        as integer   no-undo .
      197     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      198     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      199     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      200     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      201     if p-mjd-diff < 0
      202     or p-mjd-diff = ?
      203     then do:
      204       return "?" .
      205     end.
      206     assign
      207       v-day-number = integer(truncate(p-mjd-diff,0))
      208       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      209     .
      210     if v-seconds > 86400
      211     then do:
      212       assign
      213         v-seconds = 86400 - 1
      214       .
      215     end.
      216     if v-seconds < 0
      217     then do:
      218       assign
      219         v-seconds = 0
      220       .
      221     end.
      222     assign
      223       v-hour = truncate(v-seconds / 3600, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 3600
      227     .
      228     assign
      229       v-min = truncate(v-seconds / 60, 0)
      230     .
      231     assign
      232       v-seconds = v-seconds modulo 60
      233     .
      234     return
      235         (if v-day-number <> 0
      236           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0
      240           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      241           else ""
      242         )
      243       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      244           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      245           else ""
      246         )
      247       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      248       .
      249   end.
      250   function cur-time-string returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      259   end.
      260   function cur-time-string-sec returns character
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      269   end.
      270   function cur-time-custom  returns character
      271   (input p-prefix as character
      272   ,input p-date-format as character
      273   ,input p-delimiter as character
      274   ,input p-time-format as character
      275   ,input p-suffix as character
      276   )
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return
      285       p-prefix
      286       + string(v-date, p-date-format)
      287       + p-delimiter
      288       + string(v-time, p-time-format)
      289       + p-suffix
      290       .
      291   end.
      292   function cur-time-print  returns character
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      301   end.
      302   function cur-time-datetime returns datetime
      303   :
      304     define variable v-char as character no-undo .
      305     define variable v-datetime as datetime no-undo .
      306     v-char = cur-time-string().
      307     v-datetime = datetime(v-char).
      308     return  v-datetime.
      309   end.
      310   function cur-time-string-msec returns character
      311   :
      312     define variable v-date as datetime  no-undo .
      313     v-date = now.
      314     return string(v-date) .
      315   end.
      316   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      317   define new global shared variable g#lib-nws as handle no-undo .
      318   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      319   procedure gen-key-rec :
      320     define input  parameter p-tbl-name    as character no-undo.
      321     define input  parameter p-bh_tbl-name as handle    no-undo.
      322     define output parameter p-key-rec     as character no-undo.
      323     do
      324     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      325     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      326     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      327     :
      328       define variable fh               as handle    no-undo .
      329       define variable v-ok             as logical   no-undo .
      330       define variable v-inform         as character no-undo .
      331       define variable v-ind            as integer   no-undo .
      332       define variable v-idx-field-qnty as integer   no-undo .
      333       if p-tbl-name = ?
      334         or p-tbl-name = "":U
      335       then do:
      336         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      337       end.
      338       if not p-bh_tbl-name:available then do:
      339         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      340       end.
      341       assign
      342         p-key-rec = p-tbl-name
      343         v-inform  = p-bh_tbl-name:index-information(1)
      344         v-ind     = 2
      345       .
      346       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      347       on error undo, return error
      348       :
      349         assign
      350           v-inform = p-bh_tbl-name:index-information( v-ind )
      351           v-ind    = v-ind + 1
      352         .
      353       end.
      354       if v-inform = ?
      355         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      356         or entry( 3, v-inform, ",":U ) <> "1":U
      357       then do:
      358         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      359       end.
      360       else do:
      361         assign
      362           v-idx-field-qnty = num-entries( v-inform ) - 4
      363         .
      364         if v-idx-field-qnty < 2 then do:
      365           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      366         end.
      367         do v-ind = 1 to v-idx-field-qnty by 2
      368         on error undo, return error
      369         :
      370           assign
      371             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      372             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      373           .
      374         end.
      375       end.
      376       if p-key-rec = ? then do:
      377         assign
      378           p-key-rec = "":U
      379         .
      380         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      381       end.
      382     end.
      383     return.
      384   end procedure.
      385   procedure gen-where-keyr-tab :
      386     define input  parameter i-tableSerach as character no-undo.
      387     define input  parameter i-tablekey   as character  no-undo.
      388     define input  parameter p-key-rec    as character  no-undo.
      389     define input  parameter p-key-handle as handle     no-undo .
      390     define input  parameter p-db-name    as character  no-undo .
      391     define input  parameter p-tt-handle  as handle     no-undo .
      392     define output parameter o-Where      as character  no-undo.
      393     do
      394     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      395     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      396     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      397     :
      398       define variable v-full-tbl-name  as character no-undo .
      399       define variable bh_tbl-name      as handle    no-undo .
      400       define variable fh_key           as handle    no-undo .
      401       define variable fh_search        as handle    no-undo .
      402       define variable v-field-num      as integer   no-undo .
      403       define variable v-count-fld      as integer   no-undo .
      404       define variable v-inform         as character no-undo .
      405       define variable v-ind            as integer   no-undo .
      406       define variable v-idx-field-qnty as integer   no-undo .
      407       define variable v-field-name     as character no-undo .
      408       define variable v-field-val      as character no-undo .
      409       define variable v-word-link      as character no-undo .
      410       define variable vTable           as character no-undo.
      411       define variable bh_tbl-key       as handle    no-undo .
      412       assign
      413         p-key-rec = trim( p-key-rec )
      414       .
      415       if p-key-handle <> ? then do:
      416         if not valid-handle(p-key-handle)
      417            or p-key-handle:type <> "buffer"
      418         then do:
      419           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      420         end.
      421         if num-entries( p-key-rec, chr(3) ) > 1
      422           or p-key-rec = ?
      423           or p-key-rec = "":U
      424         then do:
      425           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      426         end.
      427       end.
      428       else do:
      429         if p-key-rec = ?
      430           or p-key-rec = "":U
      431         then do:
      432           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      433         end.
      434       end.
      435       assign
      436         vTable = entry( 1 , p-key-rec, chr(3) )
      437       .
      438       if p-tt-handle <> ?
      439         and ( not valid-handle(p-tt-handle)
      440               or p-tt-handle:type <> "buffer"
      441             )
      442       then do:
      443         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      444       end.
      445       if p-tt-handle = ? then do:
      446         assign
      447           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      448         .
      449         create buffer bh_tbl-name for table v-full-tbl-name .
      450       end.
      451       else do:
      452         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      453       end.
      454       assign
      455         v-inform = bh_tbl-name:index-information(1)
      456         v-ind    = 2
      457       .
      458       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      459       on error undo, return error
      460       :
      461         assign
      462           v-inform = bh_tbl-name:index-information( v-ind )
      463           v-ind    = v-ind + 1
      464         .
      465       end.
      466       if v-inform = ?
      467         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      468         or entry( 3, v-inform, ",":U ) <> "1":U
      469       then do:
      470         delete object bh_tbl-name no-error.
      471         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      472       end.
      473       assign
      474         v-idx-field-qnty = num-entries( v-inform ) - 4
      475       .
      476       if v-idx-field-qnty < 2 then do:
      477         delete object bh_tbl-name no-error.
      478         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      479       end.
      480       assign
      481         o-where     = "where":U
      482         v-word-link = "":U
      483         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      484         v-count-fld = 0
      485       .
      486       if i-tablekey ne "" and i-tablekey ne ?
      487       then do:
      488         assign
      489           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      490         .
      491         create buffer bh_tbl-key for table v-full-tbl-name .
      492       end.
      493       if i-tableSerach ne "" and i-tableSerach ne ?
      494       then do:
      495         delete object bh_tbl-name no-error.
      496         assign
      497           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      498         .
      499         create buffer bh_tbl-name for table v-full-tbl-name .
      500       end.
      501       block_where:
      502       do v-ind = 1 to v-idx-field-qnty by 2
      503       on error undo, return error
      504       :
      505         assign
      506           v-count-fld = v-count-fld + 1
      507         .
      508         if p-key-handle = ?
      509           and v-count-fld > v-field-num
      510         then do:
      511           leave block_where.
      512         end.
      513         define variable VfieldKeyTable as handle no-undo.
      514         assign
      515           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      516           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      517         .
      518         if     bh_tbl-key ne ?
      519         then do:
      520            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      521            if VfieldKeyTable eq ?
      522            then next block_where.
      523         end.
      524         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      525         then
      526            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      527         else
      528            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      529         if p-key-handle = ? then do:
      530           assign
      531             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      532           .
      533         end.
      534         else do:
      535           assign
      536             fh_key = p-key-handle:buffer-field( v-field-name )
      537           .
      538           if fh_key = ?
      539             or not valid-handle( fh_key )
      540           then do:
      541             delete object bh_tbl-name.
      542             if     bh_tbl-key ne ?
      543             then
      544                delete object bh_tbl-key.
      545             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      546           end.
      547           assign
      548             v-field-val = fh_key:buffer-value
      549           .
      550         end.
      551         if fh_search:data-type ="character":U then do:
      552           assign
      553             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      554             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      555             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      556             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      557             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      558             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      559             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      560             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      561             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      562             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      563             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      564             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      565             v-field-val = substitute( '"&1"', v-field-val )
      566           .
      567         end.
      568         assign
      569           o-where = substitute( "&1 &2", o-where, v-field-val )
      570         .
      571         if v-word-link = "":U then do:
      572           assign
      573             v-word-link = "and":U
      574           .
      575         end.
      576       end.
      577       delete object bh_tbl-name.
      578       if     bh_tbl-key ne ?
      579       then
      580          delete object bh_tbl-key.
      581       if p-key-handle = ?
      582         and v-count-fld <> v-field-num
      583       then do:
      584         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      585       end.
      586     end.
      587   end procedure.
      588   procedure gen-hn-keyr-tab :
      589     define input  parameter i-tableSerach as character no-undo.
      590     define input  parameter i-tablekey   as character no-undo.
      591     define input  parameter p-key-rec    as character no-undo.
      592     define input  parameter p-key-handle as handle    no-undo .
      593     define input  parameter p-db-name    as character no-undo .
      594     define input  parameter p-tt-handle  as handle    no-undo .
      595     define input  parameter p-stts-lock  as integer   no-undo .
      596     define output parameter o-hn         as handle    no-undo.
      597     define variable v-full-tbl-name as character no-undo.
      598     define variable v-where         as character no-undo.
      599     define variable bh_tbl-name     as handle    no-undo.
      600     define variable vTable          as character no-undo.
      601     do
      602     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      603     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      604     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      605         run gen-where-keyr-tab(i-tableSerach,
      606                                i-tablekey,
      607                                p-key-rec,
      608                                p-key-handle,
      609                                p-db-name,
      610                                p-tt-handle,
      611                                output v-where).
      612         if i-tableSerach ne "" and i-tableSerach ne ?
      613         then do:
      614            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      615            create buffer bh_tbl-name for table v-full-tbl-name .
      616         end.
      617         else do:
      618            if p-tt-handle = ? then do:
      619               assign
      620                  vTable = entry( 1 , p-key-rec, chr(3) )
      621               .
      622               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      623               create buffer bh_tbl-name for table v-full-tbl-name .
      624            end.
      625            else do:
      626               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      627            end.
      628         end.
      629         if p-tt-handle = ? then do:
      630            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      631         end.
      632         else do:
      633            bh_tbl-name:find-first( v-where ) no-error .
      634         end.
      635         o-hn = bh_tbl-name.
      636      end.
      637   end procedure.
      638   procedure gen-hn-keyr :
      639     define input  parameter p-key-rec    as character no-undo.
      640     define input  parameter p-key-handle as handle    no-undo .
      641     define input  parameter p-db-name    as character no-undo .
      642     define input  parameter p-tt-handle  as handle    no-undo .
      643     define input  parameter p-stts-lock  as integer   no-undo .
      644     define output parameter o-hn         as handle    no-undo.
      645     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      646   end.
      647   procedure gen-row-keyr :
      648     define input  parameter p-key-rec    as character no-undo.
      649     define input  parameter p-key-handle as handle    no-undo .
      650     define input  parameter p-db-name    as character no-undo .
      651     define input  parameter p-tt-handle  as handle    no-undo .
      652     define input  parameter p-stts-lock  as integer   no-undo .
      653     define output parameter p-tbl-row    as rowid     no-undo.
      654     define output parameter p-tbl-name   as character no-undo.
      655     define variable vHn as handle no-undo.
      656       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      657       p-tbl-row = if vHn:available then vHn:rowid else ?.
      658       p-tbl-name =  vHn:table.
      659       delete object vHn no-error.
      660     if p-tbl-row = ? then do:
      661       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      662     end.
      663     else do:
      664       return.
      665     end.
      666   end procedure.
      667   procedure gen-key-fv :
      668     define input  parameter p-key-rec    as character no-undo .
      669     define output parameter p-field-list as character no-undo .
      670     define output parameter p-value-list as character no-undo.
      671     do
      672     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      673     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      674     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      675     :
      676       define variable v-full-tbl-name  as character no-undo .
      677       define variable bh_tbl-name      as handle    no-undo .
      678       define variable v-tbl-name       as character no-undo .
      679       define variable v-field-num      as integer   no-undo .
      680       define variable v-count-fld      as integer   no-undo .
      681       define variable v-inform         as character no-undo .
      682       define variable v-ind            as integer   no-undo .
      683       define variable v-idx-field-qnty as integer   no-undo .
      684       define variable v-delim-key      as character no-undo .
      685       if p-key-rec = ?
      686         or p-key-rec = "":U
      687       then do:
      688         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      689       end.
      690       assign
      691         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      692         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      693       .
      694       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      695       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      696       assign
      697         v-inform = bh_tbl-name:index-information(1)
      698         v-ind    = 2
      699       .
      700       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      701       on error undo, return error
      702       :
      703         assign
      704           v-inform = bh_tbl-name:index-information( v-ind )
      705           v-ind    = v-ind + 1
      706         .
      707       end.
      708       if v-inform = ?
      709         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      710         or entry( 3, v-inform, ",":U ) <> "1":U
      711       then do:
      712         delete object bh_tbl-name no-error.
      713         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      714       end.
      715       assign
      716         v-idx-field-qnty = num-entries( v-inform ) - 4
      717       .
      718       if v-idx-field-qnty < 2 then do:
      719         delete object bh_tbl-name no-error.
      720         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      721       end.
      722       assign
      723         p-field-list = "":U
      724         p-value-list = "":U
      725         v-delim-key  = "":U
      726         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      727         v-count-fld  = 0
      728       .
      729       block_where:
      730       do v-ind = 1 to v-idx-field-qnty by 2
      731       on error undo, return error
      732       :
      733         assign
      734           v-count-fld = v-count-fld + 1
      735         .
      736         if v-count-fld > v-field-num then do:
      737           leave block_where.
      738         end.
      739         assign
      740           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      741           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      742         .
      743         if v-ind = 1 then do:
      744           assign
      745             v-delim-key = chr(3)
      746           .
      747         end.
      748       end.
      749       delete object bh_tbl-name.
      750       if v-count-fld <> v-field-num then do:
      751         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      752       end.
      753     end.
      754   end procedure.
      755   procedure gen-key-field :
      756     define input  parameter p-table      as character no-undo .
      757     define output parameter p-field-list as character no-undo .
      758     do
      759     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      760     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      761     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      762     :
      763       define variable v-full-tbl-name  as character no-undo .
      764       define variable bh_tbl-name      as handle    no-undo .
      765       define variable v-tbl-name       as character no-undo .
      766       define variable v-field-num      as integer   no-undo .
      767       define variable v-count-fld      as integer   no-undo .
      768       define variable v-inform         as character no-undo .
      769       define variable v-ind            as integer   no-undo .
      770       define variable v-idx-field-qnty as integer   no-undo .
      771       define variable v-delim-key      as character no-undo .
      772       if p-table = ?
      773         or p-table = "":U
      774       then do:
      775         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      776       end.
      777       assign
      778         v-tbl-name      = p-table
      779         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      780       .
      781       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      782       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      783       assign
      784         v-inform = bh_tbl-name:index-information(1)
      785         v-ind    = 2
      786       .
      787       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      788       on error undo, return error
      789       :
      790         assign
      791           v-inform = bh_tbl-name:index-information( v-ind )
      792           v-ind    = v-ind + 1
      793         .
      794       end.
      795       if v-inform = ?
      796         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      797         or entry( 3, v-inform, ",":U ) <> "1":U
      798       then do:
      799         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      800       end.
      801       assign
      802         v-idx-field-qnty = num-entries( v-inform ) - 4
      803       .
      804       if v-idx-field-qnty < 2 then do:
      805         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      806       end.
      807       assign
      808         p-field-list = "":U
      809         v-delim-key  = "":U
      810         v-count-fld  = 0
      811       .
      812       block_where:
      813       do v-ind = 1 to v-idx-field-qnty by 2
      814       on error undo, return error
      815       :
      816         assign
      817           v-count-fld = v-count-fld + 1
      818         .
      819         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      820         if v-ind = 1 then do:
      821           assign
      822             v-delim-key = chr(3)
      823           .
      824         end.
      825       end.
      826       delete object bh_tbl-name.
      827     end.
      828   end procedure.
      829   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      830   define variable v-date as date no-undo .
      831   define variable v-time as integer no-undo .
      832   define variable v-gds-code as integer no-undo .
      833   define variable v-obj-type as character no-undo .
      834   define variable v-obj-code as integer no-undo .
      835   define variable v-field-list as character no-undo .
      836   define variable v-value-list as character no-undo .
      837   define buffer buf_c-ext-classif for ub.c-ext-classif.
      838   define buffer buf_c-gds-hist for ub.c-gds-hist.
      839   define buffer buf_c-cli-hist for ub.c-cli-hist.
      840   main-block:
      841   do
      842   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      843   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      844   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      845   :
      846     if lookup(ub.ext-classif.classif-name, 'th-th150_clients,th-th14_clients,th-th150_goods,th-th14_goods,gds-grp,th-th_gds-grp,gds-grp,th-th_gds-grp,goods_fibegais-transId,FormF1-esys':U) > 0
      847     and lookup(ub.ext-classif.classif-name, 'th-th150_clients,th-th14_clients,th-th150_goods,th-th14_goods,gds-grp,th-th_gds-grp,rpm_gds-grp,goods_fib':U) > 0
      848     then return.
      849     if g#news then do:
      850       define variable v-send as integer no-undo .
      851       v-send = integer('0':U).
      852   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      854     (input  g#db-num
      855     ,input  'ext-classif':U
      856     ,input  0
      857     ,input  '':U
      858     ,input  0
      859     ,input  '':U
      860     ,input  '':U
      861     ,input  '':U
      862     ,input  0
      863     ,input  0
      864     ,input  0
      865     ,input  'nws-to-hist'
      866     ,output v-send
      867     ) no-error .
      868     end.
      869     if (not g#news
      870     or v-send >= 0 )
      871     and lookup(ub.ext-classif.classif-name, 'th-th150_clients,th-th14_clients,th-th150_goods,th-th14_goods,gds-grp,th-th_gds-grp,gds-grp,th-th_gds-grp,goods_fibegais-transId,FormF1-esys':U) = 0
      872     then do:
      873       run cur-time in this-procedure(output v-date, output v-time).
      874       create buf_c-ext-classif.
      875       buffer-copy ub.ext-classif to buf_c-ext-classif
      876       assign
      877       buf_c-ext-classif.corr-time          = v-time
      878       buf_c-ext-classif.corr-user-db-num   = g#db-num
      879       buf_c-ext-classif.corr-user-name     = (if g#news
      880                                               then (chr(4) +  'СПН':U)
      881                                               else (if g#esys
      882                                                    then (chr(4) +  'ВС':U)
      883                                                    else g#userid)
      884                                               )
      885       buf_c-ext-classif.corr-date          = v-date
      886       .
      887       if lookup(ub.ext-classif.classif-name, 'oss-ref,rvd-reason,reasons-suspicious-check,egais-transId,FormF1-esys':U) = 0 then
      888           do:
      889               run gen-key-fv in this-procedure ( input ub.ext-classif.uniq-key-rec
      890                                                   , output v-field-list
      891                                                   , output v-value-list
      892                                                   ).
      893               end.
      894       case ub.ext-classif.classif-subject :
      895         when 'clients':U then do:
      896           assign
      897           v-obj-type = entry(lookup("obj-type":U
      898                                             , v-field-list
      899                                             , chr(3))
      900                                       , v-value-list, chr(3))
      901           v-obj-code = integer(entry(lookup("obj-code":U
      902                                             , v-field-list
      903                                             , chr(3))
      904                                       , v-value-list, chr(3)))
      905           no-error .
      906           buf_c-ext-classif.chip-num           = next-value (s-cli-chip, ub).
      907           create buf_c-cli-hist.
      908           buffer-copy buf_c-ext-classif
      909           to buf_c-cli-hist
      910           assign
      911           buf_c-cli-hist.subject  = 'ext-classif':U
      912           buf_c-cli-hist.obj-type = v-obj-type
      913           buf_c-cli-hist.obj-code = v-obj-code
      914           buf_c-cli-hist.action   = integer( '99':U )
      915           .
      916         end.
      917         when 'goods':U then do:
      918           if ub.ext-classif.uniq-key-rec begins 'goods':U then
      919           do:
      920             assign
      921               v-gds-code = integer(entry(lookup("gds-code":U
      922                                                 , v-field-list
      923                                                 , chr(3))
      924                                           , v-value-list, chr(3)))
      925               buf_c-ext-classif.chip-num           = next-value (s-gds-chip, ub)
      926             .
      927             create buf_c-gds-hist.
      928             buffer-copy buf_c-ext-classif
      929               to buf_c-gds-hist
      930               assign
      931               buf_c-gds-hist.subject = 'ext-classif':U
      932               buf_c-gds-hist.gds-code = v-gds-code
      933             .
      934           end.
      935           else
      936             buf_c-ext-classif.chip-num = next-value (s-ref-corr-chip, ub).
      937         end.
      938         otherwise do:
      939           buf_c-ext-classif.chip-num           = next-value (s-ref-corr-chip, ub).
      940         end.
      941       end case.
      942     end.
      943     if lookup(ub.ext-classif.classif-name, 'th-th150_clients,th-th14_clients,th-th150_goods,th-th14_goods,gds-grp,th-th_gds-grp,rpm_gds-grp,goods_fib':U) = 0 then do:
      944     run nws/cmd-del.p
      945       ( input 'ext-classif':U
      946         ,input (buffer ub.ext-classif:handle)
      947         ,input "":U
      948       ) no-error .
      949     if error-status :error then do:
      950       undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      951     end.
      952     if g#oxml = yes
      953     then do:
      954       run str/calloxml.p (
      955             input 'delete':U
      956           , input 'ext-classif':U
      957           , input ( buffer ub.ext-classif:handle )
      958       ) no-error.
      959       if error-status :error
      960       then do:
      961           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      962                                , chr(10)
      963                                , vss-workfile
      964                                , return-value
      965                                , error-status :get-message ( 1 ) ).
      966       end.
      967     end.
      968     end.
