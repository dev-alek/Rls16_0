        1   block-level on error undo, throw.
        2   define input  parameter p-trn-doc    as logical   no-undo .
        3   define input  parameter p-doc-code   as character no-undo .
        4   define input  parameter p-delete-doc as logical   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Передача информации об остатках в УБД".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2|&3':u,p-trn-doc,p-doc-code,p-delete-doc)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define buffer buf_trn-doc    for ub.trn-doc .
       84   define buffer buf_price-doc  for ub.price-doc .
       85   define buffer buf_clients    for ub.clients .
       86   define buffer buf_db         for ub.db .
       87   define buffer buf_doc-line   for ub.doc-line .
       88   define buffer buf_prt-obj    for ub.prt-obj .
       89   define buffer buf_price-list for ub.price-list .
       90   define variable v-obj-type  like ub.clients.obj-type no-undo .
       91   define variable v-obj-code  like ub.clients.obj-code no-undo .
       92   do
       93   on error undo, return error return-value
       94   :
       95     if p-trn-doc = ?
       96     then do:
       97       message
       98         vss-workfile vss-revision vss-description skip
       99         "Ошибка задания входных параметров" skip
      100         "p-trn-doc" p-trn-doc skip
      101         "Документ" p-doc-code skip
      102         view-as alert-box error .
      103       undo, return error .
      104     end.
      105     if p-trn-doc = true
      106     then do:
      107       find first buf_trn-doc no-lock
      108         where buf_trn-doc.doc-code = p-doc-code
      109         no-error .
      110       if not available buf_trn-doc
      111       then do:
      112         message
      113           vss-workfile vss-revision vss-description skip
      114           "Ошибка задания входных параметров" skip
      115           "Не найден складской документ" skip
      116           "p-trn-doc" p-trn-doc skip
      117           "Документ" p-doc-code skip
      118           view-as alert-box error .
      119         undo, return error .
      120       end.
      121       define variable v-need-send-prt-obj-not-fact as logical   no-undo .
      122       define variable v-parameter-value            as character no-undo .
      123       define variable v-parameter-type             as character no-undo .
      124       assign
      125         v-need-send-prt-obj-not-fact = false
      126       .
      127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      128     (input  'remorsrv':U
      129     ,input  0
      130     ,input  '':U
      131     ,input  0
      132     ,input  '':U
      133     ,input  '':U
      134     ,input  '':U
      135     ,input  false
      136     ,output v-parameter-value
      137     ,output v-parameter-type
      138     ) no-error .
      139       if error-status :error
      140       then do:
      141       end.
      142       else do:
      143         if  v-parameter-value = 'all':u
      144         and g#db-num = 0
      145         then do:
      146           assign
      147             v-need-send-prt-obj-not-fact = true
      148           .
      149         end.
      150       end.
      151       if ( v-need-send-prt-obj-not-fact = true
      152            and p-delete-doc = true
      153          )
      154       or ( v-need-send-prt-obj-not-fact = true
      155            and buf_trn-doc.status_ = 'накл':U
      156            and buf_trn-doc.flag_ = true
      157          )
      158       or ( v-need-send-prt-obj-not-fact = true
      159            and buf_trn-doc.status_ = 'разрешен':U
      160            and buf_trn-doc.flag_ = true
      161          )
      162       or ( v-need-send-prt-obj-not-fact = true
      163            and buf_trn-doc.status_ = 'готов':U
      164          )
      165       or ( v-need-send-prt-obj-not-fact = true
      166            and buf_trn-doc.status_ = 'отказ':U
      167           )
      168       or (buf_trn-doc.status_ = 'факт':U)
      169       then do:
      170       end.
      171       else do:
      172         return .
      173       end.
      174       assign
      175         v-obj-type  = buf_trn-doc.obj-type
      176         v-obj-code  = buf_trn-doc.obj-code
      177       .
      178     end.
      179     if p-trn-doc = false
      180     then do:
      181       find first buf_price-doc no-lock
      182         where buf_price-doc.doc-num = p-doc-code
      183         no-error .
      184       if not available buf_price-doc
      185       then do:
      186         message
      187           vss-workfile vss-revision vss-description skip
      188           "Ошибка задания входных параметров" skip
      189           "Не найдена переоценка" skip
      190           "p-trn-doc" p-trn-doc skip
      191           "Документ" p-doc-code skip
      192           view-as alert-box error .
      193         undo, return error .
      194       end.
      195       if buf_price-doc.status_ <> 'акт':U
      196       then do:
      197         return .
      198       end.
      199       assign
      200         v-obj-type  = buf_price-doc.obj-type
      201         v-obj-code  = buf_price-doc.obj-code
      202       .
      203     end.
      204     find first buf_clients no-lock
      205       where buf_clients.obj-type = v-obj-type
      206         and buf_clients.obj-code = v-obj-code
      207       .
      208     if g#db-num = 0
      209     then do:
      210       define variable list-remote-db as character no-undo .
      211       assign
      212         list-remote-db = ""
      213       .
      214       for each buf_db no-lock
      215         where buf_db.remote-stock = yes
      216           and buf_db.db-num    <> g#db-num
      217           and buf_db.db-num    <> buf_clients.db-num
      218           and buf_db.db-num    <> 0
      219       on error undo, return error return-value
      220       :
      221         assign
      222           list-remote-db = list-remote-db
      223                          + (if list-remote-db <> "" then chr(1) else "")
      224                          + string(buf_db.db-num)
      225         .
      226       end.
      227       if list-remote-db <> ""
      228       then do:
      229         if p-trn-doc = true
      230         then do:
      231           for each buf_doc-line no-lock
      232             where buf_doc-line.doc-code = p-doc-code
      233           on error undo, return error
      234           :
      235             for each buf_prt-obj no-lock
      236               where buf_prt-obj.obj-type  = buf_doc-line.obj-type
      237                 and buf_prt-obj.obj-code  = buf_doc-line.obj-code
      238                 and buf_prt-obj.artic     = buf_doc-line.artic
      239                 and buf_prt-obj.prod-type = buf_doc-line.prod-type
      240                 and buf_prt-obj.prod-code = buf_doc-line.prod-code
      241             on error undo, return error
      242             :
      243               run nws/cr-route.p
      244                 (input 'send-tbl':U
      245                 ,input 'prt-obj':U
      246                 ,input (buffer buf_prt-obj:handle)
      247                 ,input list-remote-db
      248                 ) no-error .
      249               if error-status :error
      250               then do:
      251                 message
      252                   vss-workfile vss-revision vss-description skip
      253                   "Ошибка при отправке остатков по товару в новости" skip
      254                   "Документ" p-doc-code skip
      255                   error-status :get-message(1) skip
      256                   return-value skip
      257                   view-as alert-box error .
      258                 undo, return error .
      259               end.
      260             end.
      261           end.
      262         end.
      263         else do:
      264           for each buf_price-list no-lock
      265             where buf_price-list.doc-num    = p-doc-code
      266               and buf_price-list.main-price = true
      267           on error undo, return error
      268           :
      269             for each buf_prt-obj no-lock
      270               where buf_prt-obj.obj-type  = buf_price-list.obj-type
      271                 and buf_prt-obj.obj-code  = buf_price-list.obj-code
      272                 and buf_prt-obj.artic     = buf_price-list.artic
      273                 and buf_prt-obj.prod-type = buf_price-list.prod-type
      274                 and buf_prt-obj.prod-code = buf_price-list.prod-code
      275             on error undo, return error
      276             :
      277               run nws/cr-route.p
      278                 (input 'send-tbl':U
      279                 ,input 'prt-obj':U
      280                 ,input (buffer buf_prt-obj:handle)
      281                 ,input list-remote-db
      282                 ) no-error .
      283               if error-status :error
      284               then do:
      285                 message
      286                   vss-workfile vss-revision vss-description skip
      287                   "Ошибка при отправке остатков по товару в новости" skip
      288                   "Документ" p-doc-code skip
      289                   error-status :get-message(1) skip
      290                   return-value skip
      291                   view-as alert-box error .
      292                 undo, return error .
      293               end.
      294             end.
      295           end.
      296         end.
      297       end.
      298     end.
      299   end.
