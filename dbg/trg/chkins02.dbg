        1   block-level on error undo, throw.
        2   define input parameter pardoc-code like ub.chk-pay.doc-code no-undo .
        3   define input parameter pardoc-type as integer no-undo .
        4   define input parameter parchk-type like ub.chk-doc.chk-type no-undo .
        5   define input parameter parobj-type like ub.clients.obj-type no-undo .
        6   define input parameter parobj-code like ub.clients.obj-code no-undo .
        7   define input parameter parchk-date like ub.chk-doc.chk-date no-undo .
        8   define input parameter parchk-time like ub.chk-doc.chk-time no-undo .
        9   define input parameter parpay-code like ub.chk-pay.pay-code no-undo .
       10   define input parameter parcurr-code like ub.chk-pay.curr-code no-undo .
       11   define input parameter parbase-code like ub.sysconf.base-code no-undo .
       12   define input parameter r-b as character no-undo .
       13   define input parameter parcas-curs as logical no-undo .
       14   define input-output parameter parcash-rate like ub.chk-pay.cash-rate no-undo .
       15   define input-output parameter parbank-rate like ub.chk-pay.bank-rate no-undo .
       16   define input-output parameter parbank-scale like ub.chk-pay.bank-scale no-undo .
       17   define input parameter par-rid as recid no-undo .
       18   define output parameter parbase-curs as decimal no-undo .
       19   define output parameter paropl-curs as decimal no-undo .
       20   define output parameter p-par-code as integer   no-undo .
       21   define variable vss-revision    as character no-undo init "$Revision$":U .
       22   define variable vss-author      as character no-undo init "$Author$":U .
       23   define variable vss-date        as character no-undo init "$Date$":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       25   define variable vss-archive     as character no-undo init "$Archive$":U .
       26   define variable vss-description as character no-undo init "Проверка корректности строки оплат чека".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define   shared variable g#auto as logical no-undo.
       88   define   shared variable g#news as logical no-undo.
       89   define   shared variable g#oxml as logical no-undo.
       90   define   shared variable g#esys as logical no-undo.
       91   define   shared variable g#news-source-db as integer no-undo.
       92   define   shared variable g#esys-source-esys as integer no-undo.
       93   define   shared variable g#db-num as integer   no-undo .
       94   define   shared variable g#userid as character no-undo .
       95   define   shared variable g#passwd as character no-undo .
       96   DEFINE VARIABLE v-base-curs as character no-undo .
       97   DEFINE VARIABLE v-bank-curs as character no-undo .
       98   DEFINE VARIABLE v-opl-curs as character no-undo .
       99   DEFINE VARIABLE varcash-rate like ub.chk-pay.cash-rate no-undo .
      100   DEFINE VARIABLE varbank-rate like ub.chk-pay.bank-rate no-undo .
      101   DEFINE VARIABLE varbank-scale like ub.chk-pay.bank-scale no-undo .
      102   define buffer buf_cash-pay for ub.cash-pay.
      103   define buffer buf_curr-shop for ub.curr-shop.
      104   define buffer buf_curr-bank for ub.curr-bank.
      105   define buffer buf_wealth for ub.wealth.
      106   assign
      107   varbank-rate = parbank-rate
      108   varbank-scale = parbank-scale
      109   .
      110   if parbase-code = 0 then
      111   assign
      112   parbase-curs = 1
      113   .
      114   if parcurr-code = 0 then
      115   assign
      116   paropl-curs = 1
      117   .
      118   if r-b = "rubl":U and parcurr-code = 0 then
      119   varcash-rate = 1
      120   .
      121   FIND FIRST buf_cash-pay WHERE
      122              buf_cash-pay.cdpay-code = parpay-code AND
      123              buf_cash-pay.curr-code = parcurr-code NO-LOCK NO-ERROR.
      124   IF not avail buf_cash-pay then do:
      125      message
      126      substitute("Нет типа кассового платежа с кодом &1 и кодом валюты &2",  parpay-code, parcurr-code)
      127      view-as alert-box ERROR .
      128      return error.
      129   end.
      130   if r-b = "base":U and
      131     parbase-code <> 0 then do:
      132     FIND LAST buf_curr-shop NO-LOCK Where
      133               buf_curr-shop.obj-type = parobj-type AND
      134               buf_curr-shop.obj-code  = parobj-code AND
      135               buf_curr-shop.curr-code = parbase-code AND
      136               ( ( buf_curr-shop.exch-date = parchk-date AND
      137                   buf_curr-shop.exch-time <= parchk-time ) OR
      138                   buf_curr-shop.exch-date < parchk-date ) NO-ERROR .
      139           IF NOT AVAIL buf_curr-shop then do:
      140             if not parcas-curs or parcash-rate = 0 then do:
      141               message
      142               "Нет магазинного курса базовой валюты на дату и время чека!" skip
      143               "(чек " pardoc-code  " - дата " string(parchk-date, "99/99/9999")
      144               " время - " string(parchk-time, "hh:mm")
      145               view-as alert-box ERROR.
      146               return error.
      147             end.
      148           end.
      149           if avail buf_curr-shop then
      150           parbase-curs = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale.
      151     if parcurr-code = parbase-code then
      152     paropl-curs = parbase-curs.
      153   end.
      154   if paropl-curs = 0 then do:
      155         FIND LAST buf_curr-shop NO-LOCK Where
      156                   buf_curr-shop.obj-type = parobj-type AND
      157                   buf_curr-shop.obj-code  = parobj-code AND
      158                   buf_curr-shop.curr-code = buf_cash-pay.curr-code AND
      159                   ( ( buf_curr-shop.exch-date = parchk-date AND
      160                       buf_curr-shop.exch-time <= parchk-time ) OR
      161                     buf_curr-shop.exch-date < parchk-date ) NO-ERROR .
      162         IF not avail buf_curr-shop then do:
      163           if not parcas-curs or parcash-rate = 0 then do:
      164             message
      165             substitute("Нет магазинного курса валюты с кодом &1 на дату и время чека!&2" +
      166                        "(чек &3  - дата &4 время - &5)"
      167                        , buf_cash-pay.curr-code
      168                        , chr(10)
      169                        , pardoc-code
      170                        ,string(parchk-date, "99/99/9999")
      171                        ,string(parchk-time, "hh:mm")
      172                        )
      173             view-as alert-box ERROR.
      174             return error.
      175           end.
      176         end.
      177         if avail BUF_curr-shop then
      178         paropl-curs = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale.
      179   end.
      180   if r-b = "rubl":U then
      181   varcash-rate = paropl-curs.
      182   if varcash-rate = 0 then
      183   assign
      184   varcash-rate = paropl-curs / parbase-curs
      185   .
      186   if parcurr-code = 0 then do:
      187     assign
      188     varbank-rate = 1
      189     varbank-scale = 1
      190     .
      191   end.
      192   else do:
      193     FIND FIRST buf_curr-bank No-LOCK WHERE
      194                 buf_curr-bank.curr-code = parcurr-code AND
      195                 buf_curr-bank.exch-date <= parchk-date  NO-ERROR .
      196     if not avail buf_curr-bank then do:
      197       if not parcas-curs or varbank-rate = 0 then do:
      198         message
      199         substitute( "Нет курса ЦБ для валюты с кодом &1 на дату чека!&2" +
      200                    "(чек &3  - дата  &4)"
      201                    , buf_cash-pay.curr-code
      202                    , chr(10)
      203                    , pardoc-code
      204                    , string(parchk-date, "99/99/9999")
      205                    )
      206         view-as alert-box ERROR.
      207         return error.
      208       end.
      209     end.
      210     if avail buf_curr-bank then
      211     assign
      212     varbank-rate = buf_curr-bank.exch-rate
      213     varbank-scale = buf_curr-bank.exch-scale
      214     .
      215   end.
      216   if not parcas-curs and
      217     NOT (parcash-rate = 0 AND
      218          parbank-rate = 0 AND
      219          parbank-scale = 0 ) and
      220     not (parcash-rate = varcash-rate AND
      221          parbank-rate = varbank-rate AND
      222          parbank-scale = varbank-scale) then do:
      223     message
      224     substitute("Неверный курс валюты оплаты в магазине и/или &1"  +
      225                "неверный курс валюты ЦБ РФ"
      226                , chr(10))
      227     view-as alert-box error .
      228     return error.
      229   end.
      230   if parcas-curs then do:
      231     if  parcash-rate = 0 then
      232     parcash-rate = varcash-rate.
      233     if (parbank-rate = 0 AND
      234          parbank-scale = 0 ) then
      235     assign
      236     parbank-rate = varbank-rate
      237     parbank-scale = varbank-scale
      238     .
      239     return.
      240   end.
      241   assign
      242   parcash-rate = varcash-rate
      243   parbank-rate = varbank-rate
      244   parbank-scale = varbank-scale
      245   .
