        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.chk-doc.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление записи chk-doc".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable v-is-update as logical no-undo .
       79   define variable v-chip-num as integer no-undo .
       80   define buffer buf_chk-gds for ub.chk-gds.
       81   define buffer buf_chk-gds-attr for ub.chk-gds-attr.
       82   define buffer buf_chk-pay for ub.chk-pay.
       83   define buffer buf_chk-pay-attr for ub.chk-pay-attr .
       84   define buffer buf_chk-discnt for ub.chk-discnt.
       85   define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
       86   define buffer buf_chk-doc-attr for ub.chk-doc-attr.
       87   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
       88   define buffer buf_marking-chk for ub.marking-chk.
       89   _main:
       90   do
       91   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       92   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
       93   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ):
       94       if ub.chk-doc.out-code <> ? and not g#news then
       95       return error substitute("Чек &1 привязан к продаже &2 - удаление невозможно"
       96                               , ub.chk-doc.doc-code
       97                               , ub.chk-doc.out-code ).
       98       if ub.chk-doc.out-2-code <> ? and not g#news then
       99       return error substitute("Чек &1 привязан к док-ту &2 - удаление невозможно"
      100                               , ub.chk-doc.doc-code
      101                               , ub.chk-doc.out-2-code).
      102       if not g#news then
      103       run trg/chk-doch.p (
      104                       buffer ub.chk-doc
      105                     ,input no
      106                     ,input no
      107                     ,input yes
      108                     ,input-output v-chip-num
      109                     ,output v-is-update
      110                     ).
      111       for each buf_chk-gds where
      112              buf_chk-gds.doc-code = ub.chk-doc.doc-code :
      113           delete buf_chk-gds.
      114       end.
      115       for each buf_marking-chk where
      116              buf_marking-chk.doc-code = ub.chk-doc.doc-code :
      117           delete buf_marking-chk.
      118       end.
      119       for each buf_chk-pay where
      120              buf_chk-pay.doc-code = ub.chk-doc.doc-code :
      121           delete buf_chk-pay.
      122       end.
      123       for each buf_chk-discnt where
      124               buf_chk-discnt.doc-code = ub.chk-doc.doc-code :
      125           delete buf_chk-discnt.
      126       end.
      127       for each buf_chk-discnt-attr where
      128               buf_chk-discnt-attr.doc-code = ub.chk-doc.doc-code :
      129           delete buf_chk-discnt-attr.
      130       end.
      131       for each buf_chk-gds-pay where
      132               buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code :
      133           delete buf_chk-gds-pay.
      134       end.
      135       if g#oxml = yes
      136       then do:
      137         run str/calloxml.p (
      138               input 'delete':U
      139             , input 'chk-doc':U
      140             , input ( buffer ub.chk-doc:handle )
      141         ) no-error.
      142         if error-status :error
      143         then do:
      144             undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      145                                 , chr(10)
      146                                 , vss-workfile
      147                                 , return-value
      148                                 , error-status :get-message ( 1 ) ).
      149         end.
      150       end.
      151          run bge\send1cerp.p (?,
      152                       this-procedure,
      153                       this-procedure,
      154                       "delChk-doc",
      155                       (buffer chk-doc:handle),
      156                       (buffer c-chk-doc:handle),
      157                       ?) no-error.
      158          if error-status:error
      159          then do:
      160             message return-value view-as alert-box.
      161          end.
      162     end.
