        1   block-level on error undo, throw.
        2   define input  parameter p-calc-method    as character                no-undo .
        3   define input  parameter p-doc-code       as character                no-undo .
        4   define input  parameter p-gds-code       as integer                  no-undo .
        5   define input  parameter p-price-cli      like ub.doc-line.price-cli  no-undo .
        6   define input  parameter p-price-base     like ub.doc-line.price-base no-undo .
        7   define input  parameter p-price-rubl     like ub.doc-line.price-rubl no-undo .
        8   define output parameter p-new-price-cli  like ub.doc-line.price-cli  no-undo .
        9   define output parameter p-new-price-base like ub.doc-line.price-base no-undo .
       10   define output parameter p-new-price-rubl like ub.doc-line.price-rubl no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Пересчет цен разного типа друг в друга".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35       assign
       36         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6':u,p-calc-method,p-doc-code,p-gds-code,p-price-cli,p-price-base,p-price-rubl)
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define new global shared variable g#lib-trn  as handle no-undo .
       90   define new global shared variable g#lib-trn2 as handle no-undo .
       91   define new global shared variable g#lib-trn3 as handle no-undo .
       92   define new global shared variable g#lib-trn4 as handle no-undo .
       93   define variable p-new-price-cli-unit-base      like ub.doc-line.price-rubl no-undo.
       94   define variable p-new-price-road-tax           like ub.doc-line.price-rubl no-undo.
       95   define variable p-new-price-other-exp          like ub.doc-line.price-rubl no-undo.
       96   define variable p-new-price-transport-exp      like ub.doc-line.price-rubl no-undo.
       97   define variable p-new-price-without-abs        like ub.doc-line.price-rubl no-undo.
       98   define variable p-new-price-slt                like ub.doc-line.price-rubl no-undo.
       99   define variable p-new-price-no-slt             like ub.doc-line.price-rubl no-undo.
      100   define variable p-new-price-vat                like ub.doc-line.price-rubl no-undo.
      101   define variable p-new-price-no-vat-slt         like ub.doc-line.price-rubl no-undo.
      102   define variable p-new-price-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
      103   define variable p-new-price-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
      104   define variable p-new-price-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
      105   define variable p-new-price-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
      106   define variable p-new-price-slt-rubl           like ub.doc-line.price-rubl no-undo.
      107   define variable p-new-price-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
      108   define variable p-new-price-vat-rubl           like ub.doc-line.price-rubl no-undo.
      109   define variable p-new-price-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
      110   define variable p-new-price-road-tax-base      like ub.doc-line.price-base no-undo.
      111   define variable p-new-price-other-exp-base     like ub.doc-line.price-base no-undo.
      112   define variable p-new-price-transport-exp-base like ub.doc-line.price-base no-undo.
      113   define variable p-new-price-without-abs-base   like ub.doc-line.price-base no-undo.
      114   define variable p-new-price-slt-base           like ub.doc-line.price-base no-undo.
      115   define variable p-new-price-no-slt-base        like ub.doc-line.price-base no-undo.
      116   define variable p-new-price-vat-base           like ub.doc-line.price-base no-undo.
      117   define variable p-new-price-no-vat-slt-base    like ub.doc-line.price-base no-undo.
      118   define buffer buf_doc-line for ub.doc-line .
      119   define buffer t-doc        for ub.trn-doc .
      120   define buffer buf_goods    for ub.goods .
      121   find first t-doc no-lock
      122     where t-doc.doc-code = p-doc-code
      123     .
      124   find first buf_goods no-lock
      125     where buf_goods.gds-code = p-gds-code
      126     .
      127   find first buf_doc-line no-lock
      128     where buf_doc-line.doc-code  = p-doc-code
      129       and buf_doc-line.artic     = buf_goods.artic
      130       and buf_doc-line.prod-type = buf_goods.prod-type
      131       and buf_doc-line.prod-code = buf_goods.prod-code
      132     .
      133   define variable p-artic          like ub.doc-line.artic         no-undo.
      134   define variable p-prod-type      like ub.doc-line.prod-type     no-undo.
      135   define variable p-prod-code      like ub.doc-line.prod-code     no-undo.
      136   define variable p-SLT-PC         like ub.doc-line.SLT-PC        no-undo.
      137   define variable p-VAT-PC         like ub.doc-line.VAT-PC        no-undo.
      138   define variable p-cli-base-rate  like ub.doc-line.cli-base-rate no-undo.
      139   define variable p-doc-qnty       like ub.doc-line.doc-qnty      no-undo.
      140   define variable p-fact-qnty      like ub.doc-line.fact-qnty     no-undo.
      141   define variable p-road-tax       like ub.doc-line.road-tax      no-undo.
      142   define variable p-other-base     like ub.doc-line.road-tax      no-undo.
      143   define variable p-other-rubl     like ub.doc-line.road-tax      no-undo.
      144   define variable p-transport-base like ub.doc-line.road-tax      no-undo.
      145   define variable p-transport-rubl like ub.doc-line.road-tax      no-undo.
      146   case p-calc-method :
      147     when "price-cli":U then do:
      148      assign
      149        p-artic          = buf_doc-line.artic
      150        p-prod-type      = buf_doc-line.prod-type
      151        p-prod-code      = buf_doc-line.prod-code
      152        p-new-price-cli  = p-price-cli
      153        p-SLT-PC         = buf_doc-line.SLT-pc
      154        p-VAT-PC         = buf_doc-line.VAT-pc
      155        p-cli-base-rate  = buf_doc-line.cli-base-rate
      156        p-doc-qnty       = buf_doc-line.doc-qnty
      157        p-fact-qnty      = buf_doc-line.fact-qnty
      158        p-road-tax       = buf_doc-line.road-tax
      159      .
      160   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
      161     (
      162      input   t-doc.doc-code
      163     ,input   t-doc.base-rate
      164     ,input   t-doc.base-scale
      165     ,input   t-doc.exch-rate
      166     ,input   t-doc.exch-scale
      167     ,input   t-doc.vat-type
      168     ,input   t-doc.slt-type
      169     ,input   buf_doc-line.artic
      170     ,input   buf_doc-line.prod-type
      171     ,input   buf_doc-line.prod-code
      172     ,input   p-price-cli
      173     ,input   buf_doc-line.cli-base-rate
      174     ,input   buf_doc-line.price-rubl
      175     ,input   buf_doc-line.vat-pc
      176     ,input   buf_doc-line.slt-pc
      177     ,input   buf_doc-line.road-tax
      178     ,input   buf_doc-line.transport-rubl
      179     ,input   buf_doc-line.other-rubl
      180     ,output  p-new-price-cli
      181     ,output  p-new-price-cli-unit-base
      182     ,output  p-new-price-road-tax
      183     ,output  p-new-price-other-exp
      184     ,output  p-new-price-transport-exp
      185     ,output  p-new-price-without-abs
      186     ,output  p-new-price-slt
      187     ,output  p-new-price-no-slt
      188     ,output  p-new-price-vat
      189     ,output  p-new-price-no-vat-slt
      190     ,output  p-new-price-rubl
      191     ,output  p-new-price-road-tax-rubl
      192     ,output  p-new-price-other-exp-rubl
      193     ,output  p-new-price-transport-exp-rubl
      194     ,output  p-new-price-without-abs-rubl
      195     ,output  p-new-price-slt-rubl
      196     ,output  p-new-price-no-slt-rubl
      197     ,output  p-new-price-vat-rubl
      198     ,output  p-new-price-no-vat-slt-rubl
      199     ,output  p-new-price-base
      200     ,output  p-new-price-road-tax-base
      201     ,output  p-new-price-other-exp-base
      202     ,output  p-new-price-transport-exp-base
      203     ,output  p-new-price-without-abs-base
      204     ,output  p-new-price-slt-base
      205     ,output  p-new-price-no-slt-base
      206     ,output  p-new-price-vat-base
      207     ,output  p-new-price-no-vat-slt-base
      208     ) no-error.
      209       if error-status:error then do:
      210         return error "Ошибка при пересчете линии документа".
      211       end.
      212     end.
      213     when "price-base":U then do:
      214       assign
      215         p-new-price-cli  = p-price-cli
      216         p-new-price-base = p-price-base
      217       .
      218       assign
      219         p-new-price-rubl = p-price-base * t-doc.base-rate / t-doc.base-scale
      220       .
      221     end.
      222     when "price-rubl":U then do:
      223       assign
      224         p-new-price-cli  = p-price-cli
      225         p-new-price-rubl = p-price-rubl
      226       .
      227       assign
      228         p-new-price-base = p-price-rubl / t-doc.base-rate * t-doc.base-scale
      229       .
      230     end.
      231     otherwise do:
      232       message
      233         vss-workfile vss-revision vss-description skip
      234         "Неизвестное значение параметра" skip
      235         "p-calc-method":U p-calc-method skip
      236         view-as alert-box error .
      237       undo, return error .
      238     end.
      239   end case .
