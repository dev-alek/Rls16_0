        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.tax-rate-value OLD old-tax-rate-value.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись для таблицы значение ставки налога".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7'
       29                            , ub.tax-rate-value.tax-code
       30                            , ub.tax-rate-value.rate-code
       31                            , ub.tax-rate-value.corr-user-db-num
       32                            , ub.tax-rate-value.chip-num
       33                            , ub.tax-rate-value.host-code
       34                            , ub.tax-rate-value.obj-type
       35                            , ub.tax-rate-value.obj-code
       36                            )
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure cur-time :
       91      define output parameter p-today as date      no-undo .
       92      define output parameter p-time  as integer   no-undo .
       93     do
       94     on error undo, return error
       95     :
       96       define variable v-date1 as date      no-undo .
       97       define variable v-date2 as date      no-undo .
       98       define variable v-time  as integer   no-undo .
       99       assign
      100         v-date1 = today
      101         v-time  = time
      102         v-date2 = today
      103       .
      104       if v-date1 <> v-date2
      105       then do:
      106         assign
      107           v-date1 = today
      108           v-time  = v-time
      109         .
      110       end.
      111       assign
      112         p-today = v-date1
      113         p-time  = v-time
      114       .
      115     end.
      116   end.
      117   function cur-time-date returns character
      118   :
      119     return string(today, '99/99/9999':U) .
      120   end.
      121   function cur-time-mjd returns decimal
      122   :
      123     define variable v-date as date      no-undo .
      124     define variable v-time as integer   no-undo .
      125     run cur-time in this-procedure
      126       (output v-date
      127       ,output v-time
      128       ) .
      129     return integer(v-date) - 2400002 + (v-time / 86400) .
      130   end.
      131   function cur-time-get-ending-index returns integer
      132   (input p-number as integer
      133   )
      134   :
      135     if p-number < 0
      136     or p-number = ?
      137     then do:
      138       return 1 .
      139     end.
      140     define variable v-rest as integer   no-undo .
      141     assign
      142       p-number = p-number modulo 100
      143     .
      144     if p-number < 20
      145     then do:
      146       assign
      147         v-rest = p-number
      148       .
      149     end.
      150     else do:
      151       assign
      152         v-rest = p-number modulo 10
      153       .
      154     end.
      155     case v-rest :
      156       when 1
      157       then do:
      158         return 2 .
      159       end.
      160       when 2 or
      161       when 3 or
      162       when 4
      163       then do:
      164         return 3 .
      165       end.
      166       otherwise do:
      167         return 1 .
      168       end.
      169     end case .
      170   end.
      171   procedure cur-time-mjd-to-date :
      172      define input  parameter i-mjd-diff as decimal no-undo.
      173      define output parameter o-Date     as date    no-undo.
      174      define output parameter o-Time     as integer no-undo.
      175      define variable v-day-number as integer   no-undo .
      176      if    i-mjd-diff < 0
      177         or i-mjd-diff = ?
      178      then do:
      179         return "?" .
      180      end.
      181      assign
      182         v-day-number = truncate(i-mjd-diff,0).
      183         o-Date = date(v-day-number + 2400002).
      184         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186   end.
      187   function cur-time-mjd-to-string returns character
      188   (input p-mjd-diff as decimal
      189   )
      190   :
      191     define variable v-day-number as integer   no-undo .
      192     define variable v-seconds    as integer   no-undo .
      193     define variable v-hour       as integer   no-undo .
      194     define variable v-min        as integer   no-undo .
      195     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      196     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      197     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      198     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      199     if p-mjd-diff < 0
      200     or p-mjd-diff = ?
      201     then do:
      202       return "?" .
      203     end.
      204     assign
      205       v-day-number = integer(truncate(p-mjd-diff,0))
      206       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      207     .
      208     if v-seconds > 86400
      209     then do:
      210       assign
      211         v-seconds = 86400 - 1
      212       .
      213     end.
      214     if v-seconds < 0
      215     then do:
      216       assign
      217         v-seconds = 0
      218       .
      219     end.
      220     assign
      221       v-hour = truncate(v-seconds / 3600, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 3600
      225     .
      226     assign
      227       v-min = truncate(v-seconds / 60, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 60
      231     .
      232     return
      233         (if v-day-number <> 0
      234           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0
      238           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      239           else ""
      240         )
      241       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      242           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      243           else ""
      244         )
      245       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      246       .
      247   end.
      248   function cur-time-string returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      257   end.
      258   function cur-time-string-sec returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      267   end.
      268   function cur-time-custom  returns character
      269   (input p-prefix as character
      270   ,input p-date-format as character
      271   ,input p-delimiter as character
      272   ,input p-time-format as character
      273   ,input p-suffix as character
      274   )
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return
      283       p-prefix
      284       + string(v-date, p-date-format)
      285       + p-delimiter
      286       + string(v-time, p-time-format)
      287       + p-suffix
      288       .
      289   end.
      290   function cur-time-print  returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-datetime returns datetime
      301   :
      302     define variable v-char as character no-undo .
      303     define variable v-datetime as datetime no-undo .
      304     v-char = cur-time-string().
      305     v-datetime = datetime(v-char).
      306     return  v-datetime.
      307   end.
      308   function cur-time-string-msec returns character
      309   :
      310     define variable v-date as datetime  no-undo .
      311     v-date = now.
      312     return string(v-date) .
      313   end.
      314   define variable v-date as date      no-undo.
      315   define variable v-time  as integer   no-undo.
      316   DEFINE buffer b_sysconf for ub.sysconf.
      317   DEFINE buffer b_shop    for ub.shop.
      318   DEFINE buffer b_store   for ub.store.
      319   DEFINE buffer b_clients   for ub.clients.
      320   define buffer b_tax-rate-value for ub.tax-rate-value .
      321   define buffer buf_c-tax-hist for ub.c-tax-hist.
      322   main-block:
      323   do
      324   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      325   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      326   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      327   :
      328       if not g#news and
      329       ( g#db-num > 0 ) and
      330       (ub.tax-rate-value.host-code = 0 OR
      331       (ub.tax-rate-value.obj-type = '':U AND
      332         ub.tax-rate-value.obj-code = 0)
      333       ) then do:
      334         message
      335         "Нельзя заводить значения налога по фирме и/или" skip
      336         "глобальное значение налога в УБД"
      337         view-as alert-box error .
      338         undo main-block, return error .
      339       end.
      340    if (ub.tax-rate-value.host-code = 0 and
      341        (ub.tax-rate-value.obj-type  <> "":U OR
      342         ub.tax-rate-value.obj-code  <> 0)
      343       ) OR
      344       (ub.tax-rate-value.obj-type = "":U  AND
      345        ub.tax-rate-value.obj-code  <> 0) OR
      346       (ub.tax-rate-value.obj-type <> "":U  AND
      347        ub.tax-rate-value.obj-code  = 0)  then do:
      348      message
      349         vss-workfile vss-revision vss-description skip
      350         "Ошибка при задании кода фирмы и/или объекта при записи значения ставки налога" skip
      351         "Код налога" ub.tax-rate-value.tax-code skip
      352         "Код ставки" ub.tax-rate-value.rate-code skip
      353         "Код фирмы" ub.tax-rate-value.host-code skip
      354         "Тип объекта" ub.tax-rate-value.obj-type skip
      355         "Код объекта" ub.tax-rate-value.obj-code skip
      356         "Факт. дата" ub.tax-rate-value.fact-date skip
      357         "Статус" ub.tax-rate-value.status_
      358         view-as alert-box error .
      359       undo main-block, return error .
      360    end.
      361    if ub.tax-rate-value.host-code <> 0 then do:
      362     find first b_sysconf No-LOCK WHERe
      363                b_sysconf.host-code = ub.tax-rate-value.host-code No-ERROR.
      364     if not avail b_sysconf then dO:
      365      message
      366         vss-workfile vss-revision vss-description skip
      367         "Не найдена фирма при записи значения ставки налога" skip
      368         "Код налога" ub.tax-rate-value.tax-code skip
      369         "Код ставки" ub.tax-rate-value.rate-code skip
      370         "Код фирмы" ub.tax-rate-value.host-code skip
      371         "Тип объекта" ub.tax-rate-value.obj-type skip
      372         "Код объекта" ub.tax-rate-value.obj-code skip
      373         "Факт. дата" ub.tax-rate-value.fact-date skip
      374         "Статус" ub.tax-rate-value.status_
      375         view-as alert-box error .
      376       undo main-block, return error .
      377     end.
      378    end.
      379    if ub.tax-rate-value.obj-code <> 0 then do:
      380     FIND FIRST b_clients No-LOCK WHERE
      381                b_clients.obj-type = ub.tax-rate-value.obj-type AND
      382                b_clients.obj-code = ub.tax-rate-value.obj-code No-ERROR.
      383     if not avail b_clients then do:
      384       message
      385         vss-workfile vss-revision vss-description skip
      386         "Не найден объект при записи значения ставки налога" skip
      387         "Код налога" ub.tax-rate-value.tax-code skip
      388         "Код ставки" ub.tax-rate-value.rate-code skip
      389         "Код фирмы" ub.tax-rate-value.host-code skip
      390         "Тип объекта" ub.tax-rate-value.obj-type skip
      391         "Код объекта" ub.tax-rate-value.obj-code skip
      392         "Факт. дата" ub.tax-rate-value.fact-date skip
      393         "Статус" ub.tax-rate-value.status_ skip
      394         "Номер БД для объекта" b_clients.db-num skip
      395         "Номер текущей БД" g#db-num
      396         view-as alert-box error .
      397       undo main-block, return error .
      398     end.
      399     CASE ub.tax-rate-value.obj-type:
      400       when 'маг':U then do:
      401         fiND FIRST B_SHOP NO-lock where
      402                     B_SHOP.OBJ-CODE = UB.TAX-RATE-value.obj-code No-ERROR.
      403         if not avail b_shop then do:
      404           message
      405               vss-workfile vss-revision vss-description skip
      406               "Не найден магазин при записи значения ставки налога" skip
      407               "Код налога" ub.tax-rate-value.tax-code skip
      408               "Код ставки" ub.tax-rate-value.rate-code skip
      409               "Код фирмы" ub.tax-rate-value.host-code skip
      410               "Тип объекта" ub.tax-rate-value.obj-type skip
      411               "Код объекта" ub.tax-rate-value.obj-code skip
      412               "Факт. дата" ub.tax-rate-value.fact-date skip
      413               "Статус" ub.tax-rate-value.status_
      414            view-as alert-box error .
      415            undo main-block, return error .
      416         end.
      417       end.
      418       when 'скл':U then do:
      419         fiND FIRST B_Store NO-lock where
      420                     B_Store.OBJ-CODE = UB.TAX-RATE-value.obj-code No-ERROR.
      421         if not avail b_store then do:
      422           message
      423               vss-workfile vss-revision vss-description skip
      424               "Не найден склад при записи значения ставки налога" skip
      425               "Код налога" ub.tax-rate-value.tax-code skip
      426               "Код ставки" ub.tax-rate-value.rate-code skip
      427               "Код фирмы" ub.tax-rate-value.host-code skip
      428               "Тип объекта" ub.tax-rate-value.obj-type skip
      429               "Код объекта" ub.tax-rate-value.obj-code skip
      430               "Факт. дата" ub.tax-rate-value.fact-date skip
      431               "Статус" ub.tax-rate-value.status_
      432            view-as alert-box error .
      433            undo main-block, return error .
      434         end.
      435       end.
      436     end CASE.
      437     if not g#news then do:
      438       if ( g#db-num > 0 ) = yes and g#db-num <> b_clients.db-num then do:
      439           message
      440               vss-workfile vss-revision vss-description skip
      441               "Попытка определеить значения ставки налога на объекте в чужой БД" skip
      442               "Код налога" ub.tax-rate-value.tax-code skip
      443               "Код ставки" ub.tax-rate-value.rate-code skip
      444               "Код фирмы" ub.tax-rate-value.host-code skip
      445               "Тип объекта" ub.tax-rate-value.obj-type skip
      446               "Код объекта" ub.tax-rate-value.obj-code skip
      447               "Факт. дата" ub.tax-rate-value.fact-date skip
      448               "Статус" ub.tax-rate-value.status_
      449            view-as alert-box error .
      450            undo main-block, return error .
      451       end.
      452     end.
      453    end.
      454    find first ub.tax No-LOCK WHERE
      455               ub.tax.tax-code = ub.tax-rate-value.tax-code No-ERROR.
      456    if not avail ub.tax then do:
      457       message
      458           vss-workfile vss-revision vss-description skip
      459           "Не найден налог при записи значения ставки налога" skip
      460           "Код налога" ub.tax-rate-value.tax-code skip
      461           "Код ставки" ub.tax-rate-value.rate-code skip
      462           "Код фирмы" ub.tax-rate-value.host-code skip
      463           "Тип объекта" ub.tax-rate-value.obj-type skip
      464           "Код объекта" ub.tax-rate-value.obj-code skip
      465           "Факт. дата" ub.tax-rate-value.fact-date skip
      466           "Статус" ub.tax-rate-value.status_
      467           view-as alert-box error .
      468         undo main-block, return error .
      469    end.
      470    find first ub.tax-rate Exclusive-LOCK WHERE
      471               ub.tax-rate.tax-code = ub.tax-rate-value.tax-code AND
      472               ub.tax-rate.rate-code = ub.tax-rate-value.rate-code No-WAIT No-ERROR.
      473    if locked ub.tax-rate then do:
      474       message
      475           vss-workfile vss-revision vss-description skip
      476           "Занята запись ставки при записи значения ставки налога" skip
      477           "Код налога" ub.tax-rate-value.tax-code skip
      478           "Код ставки" ub.tax-rate-value.rate-code skip
      479           "Код фирмы" ub.tax-rate-value.host-code skip
      480           "Тип объекта" ub.tax-rate-value.obj-type skip
      481           "Код объекта" ub.tax-rate-value.obj-code skip
      482           "Факт. дата" ub.tax-rate-value.fact-date skip
      483           "Статус" ub.tax-rate-value.status_
      484           view-as alert-box error .
      485         undo main-block, return error .
      486    end.
      487    if not avail ub.tax then do:
      488       message
      489           vss-workfile vss-revision vss-description skip
      490           "Не найдена ставка при записи значения ставки налога" skip
      491           "Код налога" ub.tax-rate-value.tax-code skip
      492           "Код ставки" ub.tax-rate-value.rate-code skip
      493           "Код фирмы" ub.tax-rate-value.host-code skip
      494           "Тип объекта" ub.tax-rate-value.obj-type skip
      495           "Код объекта" ub.tax-rate-value.obj-code skip
      496           "Факт. дата" ub.tax-rate-value.fact-date skip
      497           "Статус" ub.tax-rate-value.status_
      498           view-as alert-box error .
      499         undo main-block, return error .
      500    end.
      501   if ub.tax-rate.status_ = 'удал':U and
      502      not g#news and
      503      ub.tax-rate-value.status_ <> 'удал':U then do:
      504      message
      505       vss-workfile vss-revision vss-description skip
      506       "Нельзя добавлять/или изменятьзначение ставки налога для удаленной ставки" skip
      507       "Код налога" ub.tax-rate-value.tax-code skip
      508       "Код ставки" ub.tax-rate-value.rate-code skip
      509       "Код фирмы" ub.tax-rate-value.host-code skip
      510       "Тип объекта" ub.tax-rate-value.obj-type skip
      511       "Код объекта" ub.tax-rate-value.obj-code skip
      512       "Факт. дата" ub.tax-rate-value.fact-date SKIP
      513       "Статус" ub.tax-rate-value.status_
      514       "Значение" ub.tax-rate-value.rate-value
      515       view-as alert-box error .
      516     undo main-block, return error .
      517   end.
      518   if not g#news then do:
      519     FIND LAST  b_tax-rate-value No-LOCK WHERE
      520                 b_tax-rate-value.tax-code = ub.tax-rate-value.tax-code AND
      521                 b_tax-rate-value.rate-code = ub.tax-rate-value.rate-code AND
      522                 b_tax-rate-value.host-code = ub.tax-rate-value.host-code AND
      523                 b_tax-rate-value.obj-type =  ub.tax-rate-value.obj-type AND
      524                 b_tax-rate-value.obj-code =  ub.tax-rate-value.obj-code AND
      525                 b_tax-rate-value.fact-order <=  ub.tax-rate-value.fact-order AND
      526                 b_tax-rate-value.status_ =  ub.tax-rate-value.status_ AND
      527                 ub.tax-rate-value.status_ = 'тек':U AND
      528                 recid(b_tax-rate-value) <> recid(ub.tax-rate-value) NO-ERROR.
      529     if avail b_tax-rate-value and b_tax-rate-value.rate-value = ub.tax-rate-value.rate-value then do:
      530         message
      531             vss-workfile vss-revision vss-description skip
      532             "На выбранную дату уже есть такое же значение ставки налога" skip
      533             "Код налога" ub.tax-rate-value.tax-code skip
      534             "Код ставки" ub.tax-rate-value.rate-code skip
      535             "Код фирмы" ub.tax-rate-value.host-code skip
      536             "Тип объекта" ub.tax-rate-value.obj-type skip
      537             "Код объекта" ub.tax-rate-value.obj-code skip
      538             "Факт. дата" ub.tax-rate-value.fact-date SKIP
      539             "Статус" ub.tax-rate-value.status_
      540             "Значение" ub.tax-rate-value.rate-value
      541             view-as alert-box error .
      542           undo main-block, return error .
      543     end.
      544   end.
      545     assign
      546     ub.tax-rate-value.status_ = (if ub.tax-rate.status_ = 'удал':U and g#news
      547                                  then 'удал':U
      548                                  else ub.tax-rate-value.status_
      549                                 )
      550     .
      551     if not g#news then do:
      552       run cur-time in this-procedure(output v-date, output v-time).
      553       assign
      554       ub.tax-rate-value.chip-num           = next-value(s-corr-chip, ub)
      555       ub.tax-rate-value.corr-time          = v-time
      556       ub.tax-rate-value.corr-user-db-num   = g#db-num
      557       ub.tax-rate-value.corr-user-name     = g#userid
      558       ub.tax-rate-value.corr-date          = v-date
      559       .
      560       create buf_c-tax-hist.
      561       buffer-copy tax-rate-value to buf_c-tax-hist
      562       assign
      563       buf_c-tax-hist.action = (if new (ub.tax-rate-value )
      564                               then integer('1':U)
      565                               else integer('2':U))
      566       buf_c-tax-hist.subject = 'tax-rate-value':U
      567       buf_c-tax-hist.is-news = no
      568       .
      569     end.
      570     run str/callnews.p
      571       (input 'tax-rate-value':U
      572       ,input (buffer ub.tax-rate-value:handle)
      573       ).
      574       if g#oxml = yes
      575       then do:
      576       run str/calloxml.p (
      577             input 'update':U
      578           , input 'tax-rate-value':U
      579           , input ( buffer ub.tax-rate-value:handle )
      580       ) no-error.
      581       if error-status :error
      582       then do:
      583           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      584                                , chr(10)
      585                                , vss-workfile
      586                                , return-value
      587                                , error-status :get-message ( 1 ) ).
      588       end.
      589       end.
      590   end.
