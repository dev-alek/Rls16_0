        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.inkas .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление записи продажа".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable conf-par as character no-undo .
       79   define variable par-type as character no-undo .
       80   define buffer buf_sysconf  for ub.sysconf .
       81   define buffer buf_cash-pay for ub.cash-pay.
       82   main-block:
       83   do
       84       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       85       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       86       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       87       :
       88       if  (ub.inkas.status_ = 'факт':U
       89           or
       90           ub.inkas.status_ = 'запрос':U )
       91           and ub.inkas.is-del = no
       92           then
       93       do:
       94           message
       95               vss-workfile vss-revision vss-description skip
       96               "Нельзя удалять продажу, закрытую до статуса" ub.inkas.status_ skip
       97               "Номер продажи" ub.inkas.inkas-code skip
       98               "Статус продажи" ub.inkas.status_ skip
       99               view-as alert-box error .
      100           undo main-block, return error .
      101       end.
      102       find first ub.inkas-pay no-lock
      103           where ub.inkas-pay.inkas-code = ub.inkas.inkas-code
      104           no-error .
      105       if available ub.inkas-pay then
      106       do:
      107           message
      108               vss-workfile vss-revision vss-description skip
      109               "Ошибка при удалении документа продажи" skip
      110               "Найдена строка документа продажи" skip
      111               "Продажа" ub.inkas-pay.inkas-code skip
      112               "pay-code" ub.inkas-pay.pay-code skip
      113               "curr-code" ub.inkas-pay.curr-code skip
      114               view-as alert-box error .
      115           undo main-block, return error .
      116       end.
      117       find first ub.inkas-pay-desk no-lock
      118           where ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code
      119           no-error .
      120       if available ub.inkas-pay-desk then
      121       do:
      122           message
      123               vss-workfile vss-revision vss-description skip
      124               "Ошибка при удалении документа продажи" skip
      125               "Найдена строка документа продажи - выручка по кассе" skip
      126               "Продажа" ub.inkas-pay-desk.inkas-code skip
      127               "pay-code" ub.inkas-pay-desk.pay-code skip
      128               "curr-code" ub.inkas-pay-desk.curr-code skip
      129               "pay-desk" ub.inkas-pay-desk.pay-desk skip
      130               "doc-type" ub.inkas-pay-desk.doc-type skip
      131               "cashier" ub.inkas-pay-desk.cashier skip
      132               view-as alert-box error .
      133           undo main-block, return error .
      134       end.
      135       find first ub.inkas-pay-wth no-lock
      136           where ub.inkas-pay-wth.inkas-code = ub.inkas.inkas-code
      137           no-error .
      138       if available ub.inkas-pay-wth then
      139       do:
      140           message
      141               vss-workfile vss-revision vss-description skip
      142               "Ошибка при удалении документа продажи" skip
      143               "Найдена строка документа продажи - выручка по кассе с номиналами" skip
      144               "Продажа" ub.inkas-pay-wth.inkas-code skip
      145               "pay-code" ub.inkas-pay-wth.pay-code skip
      146               "curr-code" ub.inkas-pay-wth.curr-code skip
      147               "wth-code" ub.inkas-pay-wth.wth-code skip
      148               "par-code" ub.inkas-pay-wth.par-code skip
      149               "pay-desk" ub.inkas-pay-wth.pay-desk skip
      150               "chk-type" ub.inkas-pay-wth.chk-type skip
      151               "cashier" ub.inkas-pay-wth.cashier skip
      152               view-as alert-box error .
      153           undo main-block, return error .
      154       end.
      155       if not g#news then
      156       do:
      157           find first ub.chk-doc no-lock
      158               where ub.chk-doc.out-code = ub.inkas.inkas-code
      159               no-error .
      160           if available ub.chk-doc then
      161           do:
      162               message
      163                   vss-workfile vss-revision vss-description skip
      164                   "Ошибка при удалении документа продажи" skip
      165                   "Найдена чек привязанный к продаже" skip
      166                   "Продажа" ub.inkas.inkas-code skip
      167                   "Код чека" ub.chk-doc.doc-code skip
      168                   view-as alert-box error .
      169               undo main-block, return error .
      170           end.
      171           find first ub.chk-gds no-lock
      172               where ub.chk-gds.out-code = ub.inkas.inkas-code
      173               no-error .
      174           if available ub.chk-gds then
      175           do:
      176               message
      177                   vss-workfile vss-revision vss-description skip
      178                   "Ошибка при удалении документа продажи" skip
      179                   "Найдена строка чека привязанная к продаже" skip
      180                   "Продажа" ub.inkas.inkas-code skip
      181                   "Код чека" ub.chk-gds.doc-code skip
      182                   view-as alert-box error .
      183               undo main-block, return error .
      184           end.
      185           find first ub.chk-pay no-lock
      186               where ub.chk-pay.out-code = ub.inkas.inkas-code
      187               no-error .
      188           if available ub.chk-pay then
      189           do:
      190               message
      191                   vss-workfile vss-revision vss-description skip
      192                   "Ошибка при удалении документа продажи" skip
      193                   "Найдена строка оплаты, привязанная к продаже" skip
      194                   "Продажа" ub.inkas.inkas-code skip
      195                   "Код чека" ub.chk-pay.doc-code skip
      196                   view-as alert-box error .
      197               undo main-block, return error .
      198           end.
      199           find first ub.chk-discnt no-lock
      200               where ub.chk-discnt.out-code = ub.inkas.inkas-code
      201               no-error .
      202           if available ub.chk-discnt then
      203           do:
      204               message
      205                   vss-workfile vss-revision vss-description skip
      206                   "Ошибка при удалении документа продажи" skip
      207                   "Найдена строка скидки привязанная к продаже" skip
      208                   "Продажа" ub.inkas.inkas-code skip
      209                   "Код чека" ub.chk-discnt.doc-code skip
      210                   view-as alert-box error .
      211               undo main-block, return error .
      212           end.
      213       end.
      214       if not g#news
      215           and (ub.inkas.status_ = 'факт':U
      216           or
      217           ub.inkas.status_ = 'запрос':U
      218           )
      219           then
      220       do:
      221           run nws/cmd-del.p
      222               ( input "inkas":U
      223               ,input (buffer ub.inkas:handle)
      224               ,input "":U
      225               ) no-error .
      226           if error-status :error then
      227           do:
      228               undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      229           end.
      230       end.
      231       if g#oxml = yes
      232           then
      233       do:
      234           run str/calloxml.p (
      235               input 'delete':U
      236               , input 'inkas':U
      237               , input ( buffer ub.inkas:handle )
      238               ) no-error.
      239           if error-status :error
      240               then
      241           do:
      242               undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      243                   , chr(10)
      244                   , vss-workfile
      245                   , return-value
      246                   , error-status :get-message ( 1 ) ).
      247           end.
      248       end.
      249   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      250     (input ?
      251     ,input this-procedure:handle
      252     ,input ?
      253     ,input 'event_inkas':U
      254     ,input  buffer ub.inkas:handle
      255     ,input ''
      256     ,input ''
      257     ,input ''
      258     ) no-error .
      259       if error-status :error
      260           then
      261       do:
      262           return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
      263               , chr(10)
      264               , vss-workfile
      265               , return-value
      266               , error-status :get-message ( 1 ) ).
      267       end.
      268       run trg/userlog.p (
      269           input 'delete':U
      270           , input 'inkas':U
      271           , input ( buffer ub.inkas :handle )
      272           , input ?
      273           , input ""
      274           ) no-error.
      275       if error-status :error
      276           then
      277       do:
      278           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      279               , chr(10)
      280               , vss-workfile
      281               , return-value
      282               , error-status :get-message ( 1 ) ).
      283       end.
      284   end.
