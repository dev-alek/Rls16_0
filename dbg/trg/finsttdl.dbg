        1   block-level on error undo, throw.
        2   define input parameter p-host-code like ub.fin-statement.host-code no-undo .
        3   define input parameter p-sttm-code like ub.fin-statement.sttm-code no-undo .
        4   define input parameter p-fact-delete as logical no-undo .
        5   define input parameter p-silence as logical no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Удаление выписки закрытой до факт ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure fs-attr-code :
      308     do
      309     on error undo, return error
      310     :
      311       define input  parameter p-code           as character no-undo .
      312       define output parameter p-type           as character no-undo .
      313       define output parameter p-format         as character no-undo .
      314       define output parameter p-label          as character no-undo .
      315       define output parameter p-user-can-edit  as logical   no-undo .
      316       define output parameter p-output-display as logical   no-undo .
      317       define output parameter p-other          as character no-undo .
      318       case p-code :
      319         otherwise do:
      320           undo, return error "неизвестный атрибут выписки" + " " + p-code .
      321         end.
      322       end.
      323     end.
      324   end procedure.
      325   procedure fs-attr-tooltip :
      326     do
      327     on error undo, return error
      328     :
      329       define input  parameter p-code    as character no-undo .
      330       define output parameter p-tooltip as character no-undo .
      331       define output parameter p-label   as character no-undo .
      332       case p-code :
      333         otherwise do:
      334           undo, return error "неизвестный атрибут выписки" + " " + p-code .
      335         end.
      336       end.
      337     end.
      338   end procedure.
      339   procedure fin-statement-attr-write :
      340    do
      341    on error undo, return error return-value
      342    :
      343   define input parameter p-host-code     like ub.fin-statement-attr.host-code  no-undo .
      344   define input parameter p-sttm-code  like ub.fin-statement-attr.sttm-code   no-undo .
      345   define input parameter p-attr-code     like ub.fin-statement-attr.attr-code  no-undo .
      346   define input parameter p-attr-value    like ub.fin-statement-attr.attr-value no-undo .
      347   define variable  v-format         as character no-undo .
      348   define variable  v-label          as character no-undo .
      349   define variable  v-user-can-edit  as logical   no-undo .
      350   define variable  v-output-display as logical   no-undo .
      351   define variable  v-other          as character no-undo .
      352   define variable  v-type           as character no-undo .
      353   define buffer buf_fin-statement-attr for ub.fin-statement-attr.
      354   run fs-attr-code in this-procedure
      355                                     (input  p-attr-code
      356                                     ,output v-type
      357                                     ,output v-format
      358                                     ,output v-label
      359                                     ,output v-user-can-edit
      360                                     ,output v-output-display
      361                                     ,output v-other
      362                                     ) no-error .
      363   if error-status :error then do:
      364     undo, return error return-value .
      365   end.
      366   find first buf_fin-statement-attr  exclusive-lock  where
      367             buf_fin-statement-attr.attr-code    = p-attr-code
      368         AND buf_fin-statement-attr.host-code    = p-host-code
      369         AND buf_fin-statement-attr.sttm-code     = p-sttm-code  no-error .
      370     if not available  buf_fin-statement-attr then do:
      371         create buf_fin-statement-attr.
      372         assign
      373         buf_fin-statement-attr.attr-code    = p-attr-code
      374         buf_fin-statement-attr.attr-value   = p-attr-value
      375         buf_fin-statement-attr.host-code    = p-host-code
      376         buf_fin-statement-attr.sttm-code     = p-sttm-code
      377         .
      378     end.
      379     else do:
      380           buf_fin-statement-attr.attr-value   = p-attr-value .
      381     end.
      382    end.
      383   end procedure.
      384   procedure fs-attr-exist :
      385     do
      386     on error undo, return error
      387     :
      388       define input parameter p-host-code     like ub.fin-statement-attr.host-code  no-undo .
      389       define input parameter p-sttm-code  like ub.fin-statement-attr.sttm-code   no-undo .
      390       define input parameter p-code          like ub.fin-statement-attr.attr-code  no-undo .
      391       define output parameter p-exist   as logical  no-undo .
      392       define buffer buf_fin-statement-attr for ub.fin-statement-attr .
      393       def var v-type           as character no-undo .
      394       def var v-format         as character no-undo .
      395       def var v-label          as character no-undo .
      396       def var v-user-can-edit  as logical   no-undo .
      397       def var v-output-display as logical   no-undo .
      398       def var v-other          as character no-undo .
      399       run fs-attr-code in this-procedure
      400         (input  p-code
      401         ,output v-type
      402         ,output v-format
      403         ,output v-label
      404         ,output v-user-can-edit
      405         ,output v-output-display
      406         ,output v-other
      407         ) no-error .
      408       if error-status :error then do:
      409         undo, return error return-value .
      410       end.
      411       find first buf_fin-statement-attr exclusive-lock
      412         where buf_fin-statement-attr.host-code  = p-host-code
      413           and buf_fin-statement-attr.sttm-code  = p-sttm-code
      414           and buf_fin-statement-attr.attr-code = p-code
      415         no-error .
      416       if  available buf_fin-statement-attr then do:
      417         p-exist = yes.
      418       end.
      419     end.
      420   end procedure.
      421   procedure fs-attr-delete :
      422     do
      423     on error undo, return error
      424     :
      425     define input parameter p-host-code     like ub.fin-statement-attr.host-code  no-undo .
      426     define input parameter p-sttm-code  like ub.fin-statement-attr.sttm-code   no-undo .
      427     define input parameter p-code          like ub.fin-statement-attr.attr-code  no-undo .
      428     define output parameter p-deleted  as logical no-undo.
      429       define buffer buf_fin-statement-attr for ub.fin-statement-attr .
      430       def var v-type           as character no-undo .
      431       def var v-format         as character no-undo .
      432       def var v-label          as character no-undo .
      433       def var v-user-can-edit  as logical   no-undo .
      434       def var v-output-display as logical   no-undo .
      435       def var v-other          as character no-undo .
      436       run fs-attr-code in this-procedure
      437         (input  p-code
      438         ,output v-type
      439         ,output v-format
      440         ,output v-label
      441         ,output v-user-can-edit
      442         ,output v-output-display
      443         ,output v-other
      444         ) no-error .
      445       if error-status :error then do:
      446         undo, return error return-value .
      447       end.
      448       find first buf_fin-statement-attr exclusive-lock
      449         where buf_fin-statement-attr.host-code  = p-host-code
      450           and buf_fin-statement-attr.sttm-code  = p-sttm-code
      451           and buf_fin-statement-attr.attr-code = p-code
      452         no-error NO-WAIT.
      453       if not available buf_fin-statement-attr then do:
      454         p-deleted = no.
      455       end.
      456       else do:
      457         delete buf_fin-statement-attr no-error .
      458         if error-status:error then do:
      459           undo, return error return-value .
      460         end.
      461         p-deleted = yes.
      462       end.
      463     end.
      464   end procedure.
      465   procedure fin-statement-attr-value :
      466    do
      467    on error undo, return error return-value
      468    :
      469   define input  parameter p-host-code    like ub.fin-statement-attr.host-code    no-undo .
      470   define input  parameter p-sttm-code like ub.fin-statement-attr.sttm-code     no-undo .
      471   define input  parameter p-attr-code    like ub.fin-statement-attr.attr-code    no-undo .
      472   define output parameter p-attr-value   like ub.fin-statement-attr.attr-value   no-undo .
      473   define variable  v-format         as character no-undo .
      474   define variable  v-label          as character no-undo .
      475   define variable  v-user-can-edit  as logical   no-undo .
      476   define variable  v-output-display as logical   no-undo .
      477   define variable  v-other          as character no-undo .
      478   define variable  v-type           as character no-undo .
      479   define buffer buf_fin-statement-attr for ub.fin-statement-attr.
      480   run fs-attr-code in this-procedure
      481     (input  p-attr-code
      482     ,output v-type
      483     ,output v-format
      484     ,output v-label
      485     ,output v-user-can-edit
      486     ,output v-output-display
      487     ,output v-other
      488     ) no-error .
      489   if error-status :error then do:
      490     undo, return error return-value .
      491   end.
      492   find first buf_fin-statement-attr no-lock where
      493             buf_fin-statement-attr.attr-code    = p-attr-code
      494         AND buf_fin-statement-attr.host-code     = p-host-code
      495         AND buf_fin-statement-attr.sttm-code = p-sttm-code      no-error .
      496     if available  buf_fin-statement-attr then do:
      497       assign
      498       p-attr-value = buf_fin-statement-attr.attr-value
      499       .
      500     end.
      501     else do:
      502       p-attr-value = ? .
      503     end.
      504    end.
      505   end procedure.
      506   procedure fs-attr-news :
      507     do
      508     on error undo, return error
      509     :
      510       define input  parameter p-code           as character no-undo .
      511       define output parameter p-news           as logical   no-undo .
      512       case p-code :
      513         otherwise do:
      514           undo, return error "неизвестный атрибут выписки " + " " + p-code .
      515         end.
      516       end.
      517     end.
      518   end procedure.
      519   procedure c-fin-statement-attr-write :
      520    do
      521    on error undo, return error return-value
      522    :
      523   define input parameter p-host-code     like ub.c-fin-statement-attr.host-code  no-undo .
      524   define input parameter p-sttm-code  like ub.c-fin-statement-attr.sttm-code   no-undo .
      525   define input parameter p-corr-user-db-num  like ub.c-fin-statement-attr.corr-user-db-num   no-undo .
      526   define input parameter p-chip-num      like ub.c-fin-statement-attr.chip-num   no-undo .
      527   define input parameter p-attr-code     like ub.c-fin-statement-attr.attr-code  no-undo .
      528   define input parameter p-attr-value    like ub.c-fin-statement-attr.attr-value no-undo .
      529   define variable  v-format         as character no-undo .
      530   define variable  v-label          as character no-undo .
      531   define variable  v-user-can-edit  as logical   no-undo .
      532   define variable  v-output-display as logical   no-undo .
      533   define variable  v-other          as character no-undo .
      534   define variable  v-type           as character no-undo .
      535   define buffer buf_c-fin-statement-attr for ub.c-fin-statement-attr.
      536   run fs-attr-code in this-procedure
      537                                     (input  p-attr-code
      538                                     ,output v-type
      539                                     ,output v-format
      540                                     ,output v-label
      541                                     ,output v-user-can-edit
      542                                     ,output v-output-display
      543                                     ,output v-other
      544                                     ) no-error .
      545   if error-status :error then do:
      546     undo, return error return-value .
      547   end.
      548   find first buf_c-fin-statement-attr  exclusive-lock  where
      549             buf_c-fin-statement-attr.attr-code    = p-attr-code
      550         AND buf_c-fin-statement-attr.host-code    = p-host-code
      551         AND buf_c-fin-statement-attr.sttm-code     = p-sttm-code
      552         AND buf_c-fin-statement-attr.corr-user-db-num = p-corr-user-db-num
      553         AND buf_c-fin-statement-attr.chip-num         = p-chip-num      no-error .
      554     if not available  buf_c-fin-statement-attr then do:
      555         create buf_c-fin-statement-attr.
      556         assign
      557         buf_c-fin-statement-attr.attr-code    = p-attr-code
      558         buf_c-fin-statement-attr.attr-value   = p-attr-value
      559         buf_c-fin-statement-attr.host-code    = p-host-code
      560         buf_c-fin-statement-attr.sttm-code     = p-sttm-code
      561         .
      562     end.
      563     else do:
      564           buf_c-fin-statement-attr.attr-value   = p-attr-value .
      565     end.
      566    end.
      567   end procedure.
      568   procedure c-fin-statement-attr-value :
      569    do
      570    on error undo, return error return-value
      571    :
      572   define input  parameter p-host-code    like ub.c-fin-statement-attr.host-code    no-undo .
      573   define input  parameter p-sttm-code like ub.c-fin-statement-attr.sttm-code     no-undo .
      574   define input parameter  p-corr-user-db-num  like ub.c-fin-statement-attr.corr-user-db-num   no-undo .
      575   define input parameter  p-chip-num      like ub.c-fin-statement-attr.chip-num   no-undo .
      576   define input  parameter p-attr-code    like ub.c-fin-statement-attr.attr-code    no-undo .
      577   define output parameter p-attr-value   like ub.c-fin-statement-attr.attr-value   no-undo .
      578   define variable  v-format         as character no-undo .
      579   define variable  v-label          as character no-undo .
      580   define variable  v-user-can-edit  as logical   no-undo .
      581   define variable  v-output-display as logical   no-undo .
      582   define variable  v-other          as character no-undo .
      583   define variable  v-type           as character no-undo .
      584   define buffer buf_c-fin-statement-attr for ub.c-fin-statement-attr.
      585   run fs-attr-code in this-procedure
      586     (input  p-attr-code
      587     ,output v-type
      588     ,output v-format
      589     ,output v-label
      590     ,output v-user-can-edit
      591     ,output v-output-display
      592     ,output v-other
      593     ) no-error .
      594   if error-status :error then do:
      595     undo, return error return-value .
      596   end.
      597   find first buf_c-fin-statement-attr no-lock where
      598             buf_c-fin-statement-attr.attr-code    = p-attr-code
      599         AND buf_c-fin-statement-attr.sttm-code      = p-sttm-code
      600         AND buf_c-fin-statement-attr.host-code      = p-host-code
      601         AND buf_c-fin-statement-attr.corr-user-db-num = p-corr-user-db-num
      602         AND buf_c-fin-statement-attr.chip-num         = p-chip-num      no-error .
      603     if available  buf_c-fin-statement-attr then do:
      604       assign
      605       p-attr-value = buf_c-fin-statement-attr.attr-value
      606       .
      607     end.
      608     else do:
      609       p-attr-value = ? .
      610     end.
      611    end.
      612   end procedure.
      613   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614   procedure write-fin-statement-history :
      615   define parameter buffer buf_fin-statement for ub.fin-statement.
      616   define variable v-date as date no-undo .
      617   define variable v-time as integer no-undo .
      618   define buffer buf_c-fin-statement for ub.c-fin-statement.
      619   define buffer buf_c-fin-statement-line for ub.c-fin-statement-line.
      620   define buffer buf_c-fin-statement-attr for ub.c-fin-statement-attr.
      621     do
      622     on error undo, return error
      623     :
      624       run cur-time in this-procedure(output v-date, output v-time).
      625       create buf_c-fin-statement.
      626       buffer-copy buf_fin-statement to buf_c-fin-statement
      627       assign
      628       buf_c-fin-statement.chip-num           = next-value (s-fin-corr-chip, ub)
      629       buf_c-fin-statement.corr-time          = v-time
      630       buf_c-fin-statement.corr-user-db-num   = g#db-num
      631       buf_c-fin-statement.corr-user-name     = g#userid
      632       buf_c-fin-statement.corr-date          = v-date
      633       buf_c-fin-statement.corr-doc-code      = "":U
      634       .
      635       for each ub.fin-statement-line where
      636                ub.fin-statement-line.host-code = buf_fin-statement.host-code
      637            AND ub.fin-statement-line.sttm-code = buf_fin-statement.sttm-code:
      638         create buf_c-fin-statement-line.
      639         buffer-copy ub.fin-statement-line to buf_c-fin-statement-line
      640         assign
      641         buf_c-fin-statement-line.chip-num           = buf_c-fin-statement.chip-num
      642         buf_c-fin-statement-line.corr-user-db-num   = buf_c-fin-statement.corr-user-db-num
      643         .
      644       end.
      645       for each ub.fin-statement-attr where
      646                ub.fin-statement-attr.host-code = buf_fin-statement.host-code
      647            AND ub.fin-statement-attr.sttm-code = buf_fin-statement.sttm-code:
      648         create buf_c-fin-statement-attr.
      649         buffer-copy ub.fin-statement-attr to buf_c-fin-statement-attr
      650         assign
      651         buf_c-fin-statement-attr.chip-num           = buf_c-fin-statement.chip-num
      652         buf_c-fin-statement-attr.corr-user-db-num   = buf_c-fin-statement.corr-user-db-num
      653         buf_c-fin-statement-attr.attr-value         = buf_c-fin-statement-attr.attr-value
      654         .
      655       end.
      656       release buf_c-fin-statement.
      657     end.
      658   end procedure.
      659   do
      660   on error undo, return error return-value
      661   :
      662     define variable v-mes as character no-undo .
      663     define variable v-status_ like ub.fin-statement.status_ no-undo .
      664     define buffer buf_fin-statement for ub.fin-statement .
      665     find first buf_fin-statement exclusive-lock where
      666               buf_fin-statement.host-code = p-host-code
      667           AND buf_fin-statement.sttm-code = p-sttm-code
      668       no-error .
      669     if not available buf_fin-statement then do:
      670       message
      671         vss-workfile vss-revision vss-description skip
      672         "Ошибка задания входных параметров" skip
      673         "Фирма" p-host-code
      674         "Выписка" p-sttm-code skip
      675         view-as alert-box error .
      676       undo, return error .
      677     end.
      678     if (buf_fin-statement.status_ = 'факт':U
      679     and p-fact-delete = no)
      680     or
      681       (buf_fin-statement.status_ <> 'факт':U
      682     and p-fact-delete = yes)
      683     or (not g#news and p-fact-delete = ?)
      684       then do:
      685       message
      686         vss-workfile vss-revision vss-description skip
      687         "Ошибка задания входных параметров" skip
      688         "Фирма" p-host-code
      689         "Платеж" p-sttm-code skip
      690         "Статус" buf_fin-statement.status_
      691         "Параметр p-fact-delete" p-fact-delete
      692         view-as alert-box error .
      693       undo, return error .
      694     end.
      695     if p-fact-delete = yes then do:
      696       assign
      697       buf_fin-statement.is-del = true
      698       .
      699       if not g#news then do:
      700         run write-fin-statement-history in this-procedure ( buffer buf_fin-statement) no-error .
      701         if error-status :error then do:
      702           message
      703             vss-workfile vss-revision vss-description skip
      704             "Ошибка при копировании в историю удаляемых выписок" skip
      705             view-as alert-box error .
      706           undo, return error.
      707         end.
      708       end.
      709     end.
      710     delete buf_fin-statement no-error .
      711     if error-status:error then do:
      712       assign
      713       v-mes =  substitute("Выписка: код фирмы &1, вн № &2, статус &3: &4"
      714                                    , p-host-code
      715                                    , p-sttm-code
      716                                    , v-status_
      717                                    ,  return-value ).
      718       if not p-silence then
      719       message v-mes
      720       view-as alert-box error .
      721       undo, return error v-mes.
      722     end.
      723   end.
