     2644                 "Артикул" p-artic p-prod-type p-prod-code skip
     2645                 "Партия" archive_parts.in-code archive_parts.part-code skip
     2646                 "Резерв" v-rsrv-code skip
     2647                 error-status :get-message(1) skip
     2648                 return-value skip
     2649                 view-as alert-box error .
     2650               undo, return error .
     2651             end.
     2652             assign
