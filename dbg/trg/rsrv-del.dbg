     2971             or (buf_trn-doc.doc-type = 'инв':U
     2972                 and archive_parts.fact-qnty < 0
     2973               )
     2974             then do:
     2975   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     2977     (input  buf_trn-doc.doc-code
     2978     ,output v-is-hold
     2979     ) no-error .
     2980               if error-status :error
     2981               then do:
     2982                 message
     2983                   vss-workfile vss-revision vss-description skip
     2984                   vss-include-info4
     2985                   "Ошибка при определении типа документа hold-doc.i" skip
     2986                   "Документ" p-doc-code skip
     2987                   "Объект" p-obj-type p-obj-code skip
     2988                   "Артикул" p-artic p-prod-type p-prod-code skip
     2989                   error-status :get-message(1) skip
     2990                   return-value skip
     2991                   view-as alert-box error .
     2992                 undo, return error .
     2993               end.
     2994               assign
     2995                 v-rsrv-code = 'out-zone':U
     2996               .
     2997               if buf_trn-doc.ext-doc-type  = 'ep':U
     2998               or (buf_trn-doc.ext-doc-type = 'ap':U )
     2999               or (buf_trn-doc.ext-doc-type = 'pc':U )
     3000               then do:
     3001                 assign
     3002                   v-rsrv-code = ""
     3003                 .
     3004                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     3005                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     3006                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     3007                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     3008                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     3009                                                       and orig_marking-lines.part-code  = archive_parts.part-code,
     3010                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3011                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB .
     3012                 end .
     3013               end.
     3014             end.
     3015             else do:
     3016               assign
     3017                 v-rsrv-code = 'free-zone':U
     3018               .
     3019             end.
     3020             if v-rsrv-code <> ""
     3021             then do:
     3022               run partcopy in this-procedure
     3023                 (input  true
     3024                 ,input  v-rsrv-code
     3025                 ,buffer archive_parts
     3026                 ,buffer buf_parts
     3027                 ,input  ""
     3028                 ) no-error .
     3029               if error-status :error
     3030               then do:
     3031                 message
     3032                   vss-workfile vss-revision vss-description skip
     3033                   vss-include-info4 skip
     3034                   "Ошибка при создании партии" skip
     3035                   "Документ" buf_trn-doc.doc-code skip
     3036                   "Объект" archive_parts.obj-type archive_parts.obj-code skip
     3037                   "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
