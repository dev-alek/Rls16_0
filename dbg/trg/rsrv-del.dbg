     5477             error-status :get-message(1) skip
     5478             return-value skip
     5479             view-as alert-box error .
     5480           undo, return error .
     5481         end.
     5482         find current buf_gds-obj exclusive-lock .
     5483       end.
     5484       run partslib-init-temp-parts in this-procedure
     5485         (input p-obj-type
     5486         ,input p-obj-code
     5487         ,input p-artic
     5488         ,input p-prod-type
     5489         ,input p-prod-code
     5490         ) no-error .
     5491       if error-status :error
     5492       then do:
     5493         message
     5494           vss-workfile vss-revision vss-description skip
     5495           vss-include-info22 skip
     5496           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     5497           "Объект" p-obj-type p-obj-code skip
     5498           "Артикул" p-artic p-prod-type p-prod-code skip
