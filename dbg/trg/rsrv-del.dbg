     5216   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5217     (input  buf_doc-parts.artic
     5218     ,input  buf_doc-parts.prod-type
     5219     ,input  buf_doc-parts.prod-code
     5220     ,output v-gds-code
     5221     ) no-error .
     5222         if error-status :error
     5223         then do:
     5224           message
     5225             vss-workfile vss-revision vss-description skip
     5226             "Ошибка при кода товара" skip
     5227             "Документ" p-doc-code skip
     5228             "Артикул" p-artic p-prod-type p-prod-code skip
     5229             view-as alert-box error .
     5230           undo, return error .
     5231         end.
     5232         for each orig_marking-lines exclusive-lock where orig_marking-lines.gds-code = v-gds-code
     5233                                                     and orig_marking-lines.obj-type = buf_doc-parts.obj-type
     5234                                                     and orig_marking-lines.obj-code = buf_doc-parts.obj-code
     5235                                                     and orig_marking-lines.in-code  = buf_doc-parts.in-code
     5236                                                     and orig_marking-lines.out-code = buf_doc-parts.out-code
     5237                                                     and orig_marking-lines.part-code = buf_doc-parts.part-code
     5238                                                     and orig_marking-lines.prt-code = buf_doc-parts.prt-code:
     5239           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     5240                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     5241                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     5242                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     5243                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     5244                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     5245                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     5246                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     5247                                                   no-error .
     5248           if not available buf_marking-lines
     5249           then do :
     5250             create buf_marking-lines .
     5251             assign
     5252               buf_marking-lines.mark       = orig_marking-lines.mark
     5253               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     5254               buf_marking-lines.gds-code   = buf_goods.gds-code
     5255               buf_marking-lines.obj-type   = buf_parts.obj-type
     5256               buf_marking-lines.obj-code   = buf_parts.obj-code
     5257               buf_marking-lines.in-code    = buf_parts.in-code
     5258               buf_marking-lines.out-code   = buf_parts.out-code
     5259               buf_marking-lines.part-code  = buf_parts.part-code
     5260               buf_marking-lines.prt-code   = buf_parts.prt-code
     5261             .
     5262           end .
     5263           for first buf_marking exclusive-lock where buf_marking.mark = buf_marking-lines.mark
     5264             and not (available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     5265             buf_marking.sts = stsMarkWhenDeleteGoods(if avail buf_trn-doc then buf_trn-doc.doc-code else ?,
     5266                                                      buf_marking-lines.mark).
     5267           end .
     5268           delete orig_marking-lines .
     5269         end.
     5270         delete buf_doc-parts .
     5271       end.
     5272       if p-reserv-pl-code  then do:
     5273         for each buf_doc-pl
     5274           where buf_doc-pl.out-code = buf_doc-line.doc-code
     5275             and buf_doc-pl.gds-code = buf_goods.gds-code
     5276             and buf_doc-pl.obj-type = buf_doc-line.obj-type
     5277             and buf_doc-pl.obj-code = buf_doc-line.obj-code
     5278         on error undo, return error
     5279         :
