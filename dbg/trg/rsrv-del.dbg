     2519           return-value skip
     2520           view-as alert-box error .
     2521         undo, return error .
     2522       end.
     2523       find first buf_goods no-lock where buf_goods.artic = p-artic
     2524                                      and buf_goods.prod-type = p-prod-type
     2525                                      and buf_goods.prod-code = p-prod-code
     2526                                      no-error .
     2527       if not available buf_goods
     2528       then do:
     2529         message
     2530           vss-workfile vss-revision vss-description skip
     2531           vss-include-info4 skip
     2532           "Ошибка задания входных параметров" skip
     2533           "Не найден товар" skip
     2534           "Документ" p-doc-code skip
     2535           "Объект" p-obj-type p-obj-code skip
