     5550   procedure partslib-update-by-factord :
     5551     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     5552     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     5553     define input parameter p-artic              like ub.parts.artic     no-undo .
     5554     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     5555     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     5556     define input parameter p-start-fact-order   as decimal   no-undo .
     5557     define input parameter p-end-fact-order     as decimal   no-undo .
     5558     define input parameter p-lock-gds-obj       as logical   no-undo .
     5559     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     5560     define buffer buf_gds-obj  for ub.gds-obj .
     5561     define buffer buf_doc-line for ub.doc-line .
     5562     define variable v-total-parts-qnty as decimal   no-undo .
     5563     define variable v-goods-gds-goods  as logical   no-undo .
     5564     define variable v-goods-twounit    as logical   no-undo .
     5565     do
     5566     on error undo, return error
     5567     :
     5568       if p-start-fact-order > p-end-fact-order
     5569       then do:
     5570         message
     5571           vss-workfile vss-revision vss-description skip
     5572           vss-include-info22 skip
     5573           "Ошибка задания входных параметров" skip
     5574           "Начало интервала превышает конец интервала" skip
     5575           "Объект" p-obj-type p-obj-code skip
     5576           "Артикул" p-artic p-prod-type p-prod-code skip
     5577           "p-start-fact-order" p-start-fact-order skip
     5578           "p-end-fact-order"   p-end-fact-order skip
     5579           view-as alert-box error .
     5580         undo, return error .
     5581       end.
     5582       if p-lock-gds-obj = true
     5583       then do:
     5584         do transaction
     5585         on error undo, return error
     5586         :
     5587   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     5589     (input  p-obj-type
     5590     ,input  p-obj-code
     5591     ,input  p-artic
     5592     ,input  p-prod-type
     5593     ,input  p-prod-code
     5594     ,buffer buf_gds-obj
     5595     ) no-error .
     5596           if error-status :error
     5597           then do:
     5598             message
     5599               vss-workfile vss-revision vss-description skip
     5600               vss-include-info22 skip
     5601               "Невозможно найти gds-obj" skip
     5602               error-status :get-message(1) skip
     5603               return-value skip
     5604               view-as alert-box error .
     5605             undo, return error .
     5606           end.
     5607           find current buf_gds-obj exclusive-lock .
     5608         end.
     5609       end.
     5610   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     5612     (input  p-artic
     5613     ,input  p-prod-type
     5614     ,input  p-prod-code
     5615     ,input  'gds-goods=request':u
     5616     ,output v-goods-gds-goods
     5617     ) no-error .
     5618       if error-status :error
     5619       then do:
     5620         message
     5621           vss-workfile vss-revision vss-description skip
     5622           vss-include-info22 skip
     5623           "Ошибка при определении атрибута товара" skip
     5624           "Артикул" p-artic p-prod-type p-prod-code skip
     5625           "gds-goods=request" skip
     5626           error-status :get-message(1) skip
     5627           return-value skip
     5628           view-as alert-box error .
     5629         undo, return error return-value .
     5630       end.
     5631   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5632   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     5633     (input  p-artic
     5634     ,input  p-prod-type
     5635     ,input  p-prod-code
     5636     ,input  'twounit=request':u
     5637     ,output v-goods-twounit
     5638     ) no-error .
     5639       if error-status :error
     5640       then do:
     5641         message
     5642           vss-workfile vss-revision vss-description skip
     5643           vss-include-info22 skip
     5644           "Ошибка при определении атрибута товара" skip
     5645           "Артикул" p-artic p-prod-type p-prod-code skip
     5646           "twounit=request" skip
     5647           error-status :get-message(1) skip
     5648           return-value skip
     5649           view-as alert-box error .
     5650         undo, return error return-value .
     5651       end.
     5652       for each buf_doc-line no-lock
     5653         where buf_doc-line.obj-type   = p-obj-type
     5654           and buf_doc-line.obj-code   = p-obj-code
     5655           and buf_doc-line.artic      = p-artic
     5656           and buf_doc-line.prod-type  = p-prod-type
     5657           and buf_doc-line.prod-code  = p-prod-code
     5658           and buf_doc-line.status_    = 'факт':U
     5659           and buf_doc-line.fact-order > p-start-fact-order
     5660           and buf_doc-line.fact-order <= p-end-fact-order
     5661       on error undo, return error
     5662       :
     5663         run partslib-process-document in this-procedure
     5664           (input  buf_doc-line.doc-code
     5665           ,input  p-obj-type
     5666           ,input  p-obj-code
     5667           ,input  p-artic
     5668           ,input  p-prod-type
     5669           ,input  p-prod-code
     5670           ,input  v-goods-gds-goods
     5671           ,input  v-goods-twounit
     5672           ,output v-total-parts-qnty
     5673           ) no-error .
     5674         if error-status :error
     5675         then do:
     5676           message
     5677             vss-workfile vss-revision vss-description skip
     5678             vss-include-info22 skip
     5679             "Ошибка при вызове процедуры partslib-process-document" skip
     5680             "Документ" buf_doc-line.doc-code skip
     5681             "Объект" p-obj-type p-obj-code skip
     5682             "Артикул" p-artic p-prod-type p-prod-code skip
     5683             "p-start-fact-order" p-start-fact-order skip
     5684             "p-end-fact-order" p-end-fact-order skip
     5685             error-status :get-message(1) skip
     5686             return-value skip
     5687             view-as alert-box error .
     5688           undo, return error return-value .
     5689         end.
     5690       end.
     5691     end.
     5692   end procedure.
     5693   procedure partslib-process-document :
     5694     define input  parameter p-doc-code         as character no-undo .
     5695     define input  parameter p-obj-type         as character no-undo .
     5696     define input  parameter p-obj-code         as integer   no-undo .
     5697     define input  parameter p-artic            as character no-undo .
     5698     define input  parameter p-prod-type        as character no-undo .
     5699     define input  parameter p-prod-code        as integer   no-undo .
     5700     define input  parameter p-goods-gds-goods  as logical   no-undo .
     5701     define input  parameter p-goods-twounit    as logical   no-undo .
     5702     define output parameter p-total-parts-qnty as decimal   no-undo .
     5703     define variable v-parts-sign as integer   no-undo .
     5704     define buffer buf_trn-doc    for ub.trn-doc .
     5705     define buffer buf_doc-line   for ub.doc-line .
     5706     define buffer buf_parts      for ub.parts .
     5707     define buffer buf_temp-parts for temp-parts .
     5708     do
     5709     on error undo, return error return-value
     5710     :
     5711       find first buf_trn-doc no-lock
     5712         where buf_trn-doc.doc-code = p-doc-code
     5713         no-error .
     5714       if not available buf_trn-doc
     5715       then do:
     5716         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     5717                                      ,p-doc-code
     5718                                      ) .
     5719       end.
     5720       case buf_trn-doc.doc-type
     5721       :
     5722         when 'при':U or
     5723         when 'возврат':U or
     5724         when 'инв':U
     5725         then do:
     5726           assign
     5727             v-parts-sign = -1
     5728           .
     5729         end.
     5730         when 'рас':U or
     5731         when 'спи':U
     5732         then do:
     5733           assign
     5734             v-parts-sign = 1
     5735           .
     5736         end.
     5737         otherwise do:
     5738           undo, return error substitute("Неизвестный тип документа &1"
     5739                                       ,buf_trn-doc.doc-type
     5740                                       ) .
     5741         end.
     5742       end.
     5743       find first buf_doc-line no-lock
     5744         where buf_doc-line.doc-code  = p-doc-code
     5745           and buf_doc-line.artic     = p-artic
     5746           and buf_doc-line.prod-type = p-prod-type
     5747           and buf_doc-line.prod-code = p-prod-code
     5748         no-error .
     5749       if not available buf_doc-line
     5750       then do:
     5751         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     5752                                      ,p-doc-code
     5753                                      ,artic
     5754                                      ,prod-type
     5755                                      ,prod-code
     5756                                      ) .
     5757       end.
     5758       assign
     5759         p-total-parts-qnty = 0
     5760       .
     5761       if p-goods-gds-goods = true
     5762       then do:
     5763         for each buf_parts no-lock
     5764           where buf_parts.out-code  = p-doc-code
     5765             and buf_parts.obj-type  = p-obj-type
     5766             and buf_parts.obj-code  = p-obj-code
     5767             and buf_parts.artic     = p-artic
     5768             and buf_parts.prod-type = p-prod-type
     5769             and buf_parts.prod-code = p-prod-code
     5770         on error undo, return error
     5771         :
     5772           run partslib-create-temp-parts in this-procedure
     5773             (buffer buf_parts
     5774             ,buffer buf_temp-parts
     5775             ,input  p-goods-twounit
     5776             ) .
     5777           assign
     5778             p-total-parts-qnty        = p-total-parts-qnty
     5779                                       + v-parts-sign * buf_parts.fact-qnty
     5780             buf_temp-parts.qnty       = buf_temp-parts.qnty
     5781                                       + v-parts-sign * buf_parts.fact-qnty
     5782             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     5783                                       + v-parts-sign * buf_parts.fact-qnty
     5784             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     5785                                       + v-parts-sign * buf_parts.cli-qnty
     5786           .
     5787           if buf_temp-parts.qnty = 0
     5788           then do:
     5789             delete buf_temp-parts .
     5790           end.
     5791         end.
     5792       end.
     5793       else do:
     5794         assign
     5795           p-total-parts-qnty = p-total-parts-qnty
     5796                              + v-parts-sign * buf_doc-line.fact-qnty
     5797         .
     5798       end.
     5799     end.
     5800   end procedure.
     5801   procedure partslib-init-temp-parts-by-date :
     5802     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     5803     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     5804     define input parameter p-artic           like ub.parts.artic     no-undo .
     5805     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     5806     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     5807     define input parameter p-fact-date       as date      no-undo .
     5808     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     5809     do
     5810     on error undo, return error
     5811     :
     5812       define variable v-fact-order                as decimal   no-undo .
     5813       define variable v-shift-end-fact-order      as decimal   no-undo .
     5814       define variable v-day-end-fact-order        as decimal   no-undo .
     5815       run factord in this-procedure
     5816         (input  p-fact-date
     5817         ,input  1
     5818         ,input  1
     5819         ,input  ?
     5820         ,input  0
     5821         ,input  false
     5822         ,output v-fact-order
     5823         ,output v-shift-end-fact-order
     5824         ,output v-day-end-fact-order
     5825         ) no-error .
     5826       if error-status :error
     5827       then do:
     5828         message
     5829           vss-workfile vss-revision vss-description skip
     5830           vss-include-info22 skip
     5831           "Ошибка при определении момента времени, на который требуется остаток" skip
     5832           "Объект" p-obj-type p-obj-code skip
     5833           "Артикул" p-artic p-prod-type p-prod-code skip
     5834           "Дата" p-fact-date skip
     5835           view-as alert-box error .
     5836         undo, return error .
     5837       end.
     5838       run partslib-init-temp-parts-by-factord in this-procedure
     5839         (input p-obj-type
     5840         ,input p-obj-code
     5841         ,input p-artic
     5842         ,input p-prod-type
     5843         ,input p-prod-code
     5844         ,input v-day-end-fact-order
     5845         ,input false
     5846         ) no-error .
     5847       if error-status :error
     5848       then do:
     5849         message
     5850           vss-workfile vss-revision vss-description skip
     5851           vss-include-info22 skip
     5852           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     5853           "Объект" p-obj-type p-obj-code skip
     5854           "Артикул" p-artic p-prod-type p-prod-code skip
     5855           "Дата" p-fact-date skip
     5856           view-as alert-box error .
     5857         undo, return error .
     5858       end.
     5859     end.
     5860   end procedure.
     5861   procedure partslib-calc-cost :
     5862     define output parameter p-fact-qnty      as decimal   no-undo .
     5863     define output parameter p-vat-pc         as decimal   no-undo .
     5864     define output parameter p-slt-pc         as decimal   no-undo .
     5865     define output parameter p-sum-base       as decimal   no-undo .
     5866     define output parameter p-sum-rubl       as decimal   no-undo .
     5867     define output parameter p-vat-base       as decimal   no-undo .
     5868     define output parameter p-vat-rubl       as decimal   no-undo .
     5869     define output parameter p-slt-base       as decimal   no-undo .
     5870     define output parameter p-slt-rubl       as decimal   no-undo .
     5871     define output parameter p-road-tax-base  as decimal   no-undo .
     5872     define output parameter p-road-tax-rubl  as decimal   no-undo .
     5873     define output parameter p-transport-base as decimal   no-undo .
     5874     define output parameter p-transport-rubl as decimal   no-undo .
     5875     define output parameter p-other-base     as decimal   no-undo .
     5876     define output parameter p-other-rubl     as decimal   no-undo .
     5877     define output parameter p-excise-base    as decimal   no-undo .
     5878     define output parameter p-excise-rubl    as decimal   no-undo .
     5879     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     5880     do
     5881     on error undo, return error return-value
     5882     :
     5883       define buffer buf_temp-parts for temp-parts .
     5884       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     5885       define buffer   in-vatp-parts    for ub.parts   .
     5886       define buffer   in-vatp-doc      for ub.trn-doc .
     5887       define buffer   in-vatp-goods    for ub.goods   .
     5888       define buffer   in-vatp-sysconf  for ub.sysconf .
     5889       define buffer   in-vatp_doc-attr for ub.doc-attr.
     5890       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     5891       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     5892       define variable varinvprb                  as   character              no-undo.
     5893       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     5894       define variable cli-base-rate              as   decimal                no-undo.
     5895       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     5896       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     5897       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     5898       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     5899       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     5900       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     5901       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     5902       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     5903       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     5904       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     5905       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     5906       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     5907       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     5908       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     5909       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     5910       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     5911       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     5912       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     5913       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     5914       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     5915       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     5916       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     5917       define variable varinvatp-envd             as   character              no-undo.
     5918       define variable varinvatp-type             as   character              no-undo.
     5919       for each buf_temp-parts
     5920       on error undo, return error
     5921       :
     5922   assign
     5923     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     5924     price-base-with-tax-loc = buf_temp-parts.price-base
     5925   .
     5926   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5927   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5928     (output varinvprb
     5929     )  .
     5930     if buf_temp-parts.out-code = 'free-zone':U     or
     5931        buf_temp-parts.out-code = 'out-zone':U   or
     5932        buf_temp-parts.doc-type = 'акт':U then do:
     5933       assign
     5934         in-vatp-have-vat-slt = yes.
     5935     end.
     5936     else do:
     5937       find first in-vatp_doc-attr no-lock
     5938         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     5939           and in-vatp_doc-attr.attr-code = 'envd':U
     5940         no-error .
     5941       if not available in-vatp_doc-attr then do:
     5942         assign
     5943           in-vatp-have-vat-slt = yes.
     5944       end.
     5945       else do:
     5946            in-vatp-have-vat-slt = no.
     5947       end.
     5948     end.
     5949     assign
     5950      price-cli-with-tax-loc = buf_temp-parts.price-cli
     5951      cli-base-rate          = buf_temp-parts.cli-base-rate.
     5952     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     5953              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     5954     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     5955             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     5956             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     5957             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     5958             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     5959             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     5960             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5961       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5962     assign
     5963       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     5964     assign
     5965       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     5966       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     5967       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     5968       transport-cli-loc  = 0
     5969       other-cli-loc      = 0
     5970     .
     5971   ASSIGN
     5972             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     5973       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     5974   .
     5975         assign
     5976           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     5977           p-vat-pc         = p-vat-pc         + vat-pc-loc
     5978           p-slt-pc         = p-slt-pc         + slt-pc-loc
     5979           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     5980           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     5981           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     5982           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     5983           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     5984           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     5985           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     5986           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     5987           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     5988           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     5989           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     5990           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     5991           p-excise-base    = p-excise-base    + 0
     5992           p-excise-rubl    = p-excise-rubl    + 0
     5993         .
     5994       end.
     5995       if p-fact-qnty      = ?
     5996       or p-sum-base       = ?
     5997       or p-sum-rubl       = ?
     5998       or p-vat-base       = ?
     5999       or p-vat-rubl       = ?
     6000       or p-slt-base       = ?
     6001       or p-slt-rubl       = ?
     6002       or p-road-tax-base  = ?
     6003       or p-road-tax-rubl  = ?
     6004       or p-transport-base = ?
     6005       or p-transport-rubl = ?
     6006       or p-other-base     = ?
     6007       or p-other-rubl     = ?
     6008       or p-excise-base    = ?
     6009       or p-excise-rubl    = ?
     6010       then do:
     6011         message
     6012           vss-workfile vss-revision vss-description skip
     6013           vss-include-info22 skip
     6014           "Программа in-vatp.i вернула неопределенные значения" skip
     6015           "p-fact-qnty"      p-fact-qnty      skip
     6016           "p-sum-base"       p-sum-base       skip
     6017           "p-sum-rubl"       p-sum-rubl       skip
     6018           "p-vat-base"       p-vat-base       skip
     6019           "p-vat-rubl"       p-vat-rubl       skip
     6020           "p-slt-base"       p-slt-base       skip
     6021           "p-slt-rubl"       p-slt-rubl       skip
     6022           "p-road-tax-base"  p-road-tax-base  skip
     6023           "p-road-tax-rubl"  p-road-tax-rubl  skip
     6024           "p-transport-base" p-transport-base skip
     6025           "p-transport-rubl" p-transport-rubl skip
     6026           "p-other-base"     p-other-base     skip
     6027           "p-other-rubl"     p-other-rubl     skip
     6028           "p-excise-base"    p-excise-base    skip
     6029           "p-excise-rubl"    p-excise-rubl    skip
     6030           view-as alert-box error .
     6031         undo, return error .
     6032       end.
     6033     end.
     6034   end procedure.
     6035   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6036   procedure factord :
     6037     define input  parameter p-fact-date            as date    no-undo .
     6038     define input  parameter p-fact-time            as integer no-undo .
     6039     define input  parameter p-fact-num             as integer no-undo .
     6040     define input  parameter p-shift-date           as date    no-undo .
     6041     define input  parameter p-shift-num            as integer no-undo .
     6042     define input  parameter p-shift-on             as logical no-undo .
     6043     define output parameter p-fact-order           as decimal no-undo .
     6044     define output parameter p-shift-end-fact-order as decimal no-undo .
     6045     define output parameter p-day-end-fact-order   as decimal no-undo .
     6046     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     6047     if p-fact-date = ?
     6048     then do:
     6049       return error "Не указана фактическая дата" .
     6050     end.
     6051     define variable v-fact-date-num as integer no-undo .
     6052     assign
     6053       v-fact-date-num = integer(p-fact-date)
     6054     .
     6055     if p-fact-num = ?
     6056     or p-fact-num = 0
     6057     then do:
     6058       return error "Не задан p-fact-num " + string(p-fact-num) .
     6059     end.
     6060     if p-fact-num < 0
     6061     then do:
     6062       return error "Отрицательный fact-num " + string(p-fact-num) .
     6063     end.
     6064     if p-fact-num >= 100000000
     6065     then do:
     6066       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     6067     end.
     6068     if p-shift-on = true
     6069     then do:
     6070       if p-shift-date = ?
     6071       then do:
     6072         return error "Не задана дата смены" .
     6073       end.
     6074       if p-shift-num = ?
     6075       or p-shift-num = 0
     6076       then do:
     6077         return error "Не задан номер смены" .
     6078       end.
     6079     end.
     6080     else do:
     6081       assign
     6082         p-shift-date = p-fact-date
     6083         p-shift-num  = 24
     6084       .
     6085     end.
     6086     define variable v-shift-offset as integer no-undo .
     6087     if p-shift-date = p-fact-date
     6088     then do:
     6089       assign
     6090         v-shift-offset = 1
     6091       .
     6092     end.
     6093     if p-shift-date < p-fact-date
     6094     then do:
     6095       assign
     6096         v-shift-offset = 0
     6097       .
     6098     end.
     6099     if p-shift-date > p-fact-date
     6100     then do:
     6101       message
     6102         vss-workfile vss-revision vss-description skip
     6103         "Неправильная дата закрытия смены" skip
     6104         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     6105         view-as alert-box error .
     6106       undo, return error
     6107         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     6108           ,string(p-fact-date, '99/99/9999':U)
     6109           ,string(p-shift-date, '99/99/9999':U)
     6110           )
     6111       .
     6112     end.
     6113     if p-shift-num < 1
     6114     or p-shift-num > 24
     6115     then do:
     6116       message
     6117         vss-workfile vss-revision vss-description skip
     6118         "Неправильный номер смены" skip
     6119         "p-shift-num" p-shift-num skip
     6120         view-as alert-box error .
     6121       undo, return error return-value .
     6122     end.
     6123     assign
     6124       p-fact-order           = v-fact-date-num
     6125                              + v-shift-offset * 0.5
     6126                              + p-shift-num    * 0.02 - 0.01
     6127                              + p-fact-num     * 0.0000000001
     6128       p-shift-end-fact-order = v-fact-date-num
     6129                              + v-shift-offset * 0.5
     6130                              + p-shift-num    * 0.02
     6131       p-day-end-fact-order   = v-fact-date-num
     6132                              + 0.99
     6133     .
     6134     if p-fact-order           <= v-fact-date-num
     6135     or p-shift-end-fact-order <= v-fact-date-num
     6136     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     6137     or p-shift-end-fact-order >= p-day-end-fact-order
     6138     then do:
     6139       message
     6140         vss-workfile vss-revision vss-description skip
     6141         "Внутренняя ошибка при генерации фактического номера" skip
     6142         "p-fact-date"            p-fact-date            skip
     6143         "p-fact-time"            p-fact-time            skip
     6144         "p-fact-num"             p-fact-num             skip
     6145         "p-shift-date"           p-shift-date           skip
     6146         "p-shift-num"            p-shift-num            skip
     6147         "p-shift-on"             p-shift-on             skip
     6148         "p-shift-end-fact-order" p-shift-end-fact-order skip
     6149         "p-day-end-fact-order"   p-day-end-fact-order   skip
     6150         "v-fact-date-num"        v-fact-date-num        skip
     6151         view-as alert-box error .
     6152       undo, return error return-value .
     6153     end.
     6154   end procedure.
     6155   procedure day-begin-fact-order :
     6156     define input  parameter p-fact-date            as date    no-undo .
     6157     define output parameter p-day-begin-fact-order as decimal no-undo .
     6158     do
     6159     on error undo, return error return-value
     6160     :
     6161       if p-fact-date = ?
     6162       then do:
     6163         assign
     6164           p-day-begin-fact-order = 0
     6165         .
     6166       end.
     6167       else do:
     6168         assign
     6169           p-day-begin-fact-order = integer(p-fact-date)
     6170         .
     6171       end.
     6172     end.
     6173   end procedure.
     6174   procedure factord-max-fact-order :
     6175     define output parameter p-max-fact-order as decimal   no-undo .
     6176     do
     6177     on error undo, return error return-value
     6178     :
     6179       run day-begin-fact-order in this-procedure
     6180         (input  date(1, 1, 5000)
     6181         ,output p-max-fact-order
     6182         ) .
     6183     end.
     6184   end procedure.
     6185   procedure factord-cut-archive :
     6186     define input  parameter p-obj-type             as character no-undo .
     6187     define input  parameter p-obj-code             as integer   no-undo .
     6188     define input  parameter p-fact-date            as date      no-undo .
     6189     define output parameter p-shift-on             as logical   no-undo .
     6190     define output parameter p-shift-date           as date      no-undo .
     6191     define output parameter p-shift-num            as integer   no-undo .
     6192     define output parameter p-day-end-fact-order   as decimal   no-undo .
     6193     define output parameter p-shift-end-fact-order as decimal   no-undo .
     6194     define variable v-fact-order as decimal   no-undo .
     6195     define buffer buf_shift-obj for ub.shift-obj .
     6196     do
     6197     on error undo, return error return-value
     6198     :
     6199   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6200   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6201     (input  p-obj-type
     6202     ,input  p-obj-code
     6203     ,input  'shift-on=request'
     6204     ,output p-shift-on
     6205     ) no-error .
     6206       if error-status :error
     6207       then do:
     6208         message
     6209           vss-workfile vss-revision vss-description skip
     6210           "Ошибка при определении атрибута объекта" skip
     6211           "Объект" p-obj-type p-obj-code skip
     6212           error-status :get-message(1) skip
     6213           return-value skip
     6214           view-as alert-box error .
     6215         undo, return error return-value .
     6216       end.
     6217       if p-shift-on = false
     6218       then do:
     6219         assign
     6220           p-shift-date               = ?
     6221           p-shift-num                = 0
     6222         .
     6223       end.
     6224       else do:
     6225         find first buf_shift-obj share-lock
     6226           where buf_shift-obj.obj-type   = p-obj-type
     6227             and buf_shift-obj.obj-code   = p-obj-code
     6228             and buf_shift-obj.shift-date > p-fact-date
     6229           use-index pi
     6230           no-error .
     6231         if not available buf_shift-obj
     6232         or buf_shift-obj.status_ <> 'зкр':U
     6233         then do:
     6234           message
     6235             vss-workfile vss-revision vss-description skip
     6236             "Невозможно вычислить последнюю смену" skip
     6237             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     6238             "Объект" p-obj-type p-obj-code skip
     6239             "Дата" p-fact-date skip
     6240             view-as alert-box error .
     6241           undo, return error return-value .
     6242         end.
     6243         find last buf_shift-obj share-lock
     6244           where buf_shift-obj.obj-type = p-obj-type
     6245             and buf_shift-obj.obj-code = p-obj-code
     6246             and buf_shift-obj.shift-date <= p-fact-date
     6247           use-index pi
     6248           no-error .
     6249         if available buf_shift-obj
     6250         then do:
     6251           if  buf_shift-obj.status_ = 'зкр':U
     6252           then do:
     6253             assign
     6254               p-shift-date = buf_shift-obj.shift-date
     6255               p-shift-num  = buf_shift-obj.shift-num
     6256             .
     6257           end.
     6258           else do:
     6259             message
     6260               vss-workfile vss-revision vss-description skip
     6261               "Невозможно вычислить последнюю смену" skip
     6262               "Статус смены отличен от статуса" 'зкр':U skip
     6263               "Объект" p-obj-type p-obj-code skip
     6264               "Дата" p-fact-date skip
     6265               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     6266               view-as alert-box error .
     6267             undo, return error return-value .
     6268           end.
     6269         end.
     6270         else do:
     6271           assign
     6272             p-shift-date = p-fact-date - 1
     6273             p-shift-num  = 1
     6274           .
     6275         end.
     6276       end.
     6277       run factord in this-procedure
     6278         (input  p-fact-date
     6279         ,input  1
     6280         ,input  1
     6281         ,input  p-shift-date
     6282         ,input  p-shift-num
     6283         ,input  p-shift-on
     6284         ,output v-fact-order
     6285         ,output p-shift-end-fact-order
     6286         ,output p-day-end-fact-order
     6287         ) no-error .
     6288       if error-status :error
     6289       then do:
     6290         message
     6291           vss-workfile vss-revision vss-description skip
     6292           "Ошибка при вызове процедуры factord"
     6293           error-status :get-message(1) skip
     6294           return-value skip
     6295           view-as alert-box error .
     6296         undo, return error return-value .
     6297       end.
     6298     end.
     6299   end procedure.
     6300   procedure factord-lock-shift :
     6301     define input  parameter p-obj-type  as character no-undo .
     6302     define input  parameter p-obj-code  as integer   no-undo .
     6303     define input  parameter p-fact-date as date      no-undo .
     6304     define parameter buffer buf_shift-obj for ub.shift-obj .
     6305     define variable v-shift-on      as logical   no-undo .
     6306     define variable v-extra-message as character no-undo .
     6307     define variable v-error as character no-undo .
     6308     do
     6309     on error undo, return error return-value
     6310     :
     6311   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6312   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6313     (input  p-obj-type
     6314     ,input  p-obj-code
     6315     ,input  'shift-on=request'
     6316     ,output v-shift-on
     6317     ) no-error .
     6318       if error-status :error
     6319       then do:
     6320         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     6321         undo, return error v-error .
     6322       end.
     6323       if v-shift-on = true
     6324       then do:
     6325         find first buf_shift-obj share-lock
     6326           where buf_shift-obj.obj-type   = p-obj-type
     6327             and buf_shift-obj.obj-code   = p-obj-code
     6328             and buf_shift-obj.shift-date > p-fact-date
     6329           use-index pi
     6330           no-error .
     6331         if not available buf_shift-obj
     6332         or buf_shift-obj.status_ <> 'зкр':U
     6333         then do:
     6334           find last buf_shift-obj
     6335             where buf_shift-obj.obj-type = p-obj-type
     6336               and buf_shift-obj.obj-code = p-obj-code
     6337               and buf_shift-obj.status_  = 'зкр':U
     6338             use-index stts
     6339             no-error .
     6340           if available buf_shift-obj
     6341           then do:
     6342             assign
     6343               v-extra-message =
     6344                     substitute("Дата начала последеней закрытой смены на объекте &1"
     6345                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     6346                               )
     6347             .
     6348           end.
     6349           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     6350           undo, return error v-error .
     6351         end.
     6352       end.
     6353     end.
     6354   end procedure.
     6355   procedure factord-end-day :
     6356     define input  parameter p-fact-date            as date    no-undo .
     6357     define output parameter p-day-end-fact-order   as decimal no-undo .
     6358     do
     6359     on error undo, return error return-value
     6360     :
     6361       if p-fact-date = ?
     6362       then do:
     6363         return error "Не указана фактическая дата" .
     6364       end.
     6365       assign
     6366         p-day-end-fact-order = integer(p-fact-date) + 0.99
     6367       .
     6368     end.
     6369   end procedure.
     6370   procedure factord-to-date :
     6371     define input  parameter p-fact-order as decimal no-undo .
     6372     define output parameter p-fact-date  as date    no-undo .
     6373     define variable v-ref-date  as date      no-undo .
     6374     define variable v-ref-delta as integer   no-undo .
     6375     do
     6376     on error undo, return error return-value
     6377     :
     6378       if p-fact-order = ?
     6379       or p-fact-order = 0
     6380       then do:
     6381         return error "Не указан fact-order" .
     6382       end.
     6383       assign
     6384         v-ref-date  = date(1, 1, 2000)
     6385       .
     6386       assign
     6387         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     6388       .
     6389       assign
     6390         p-fact-date = v-ref-date + v-ref-delta
     6391       .
     6392     end.
     6393   end procedure.
     6394   procedure factord-to-fact-num :
     6395     define input  parameter p-fact-order as decimal no-undo .
     6396     define output parameter p-fact-num   as integer no-undo .
     6397     define variable v-fact-order-trunc as decimal no-undo .
     6398     do
     6399     on error undo, return error return-value
     6400     :
     6401       if p-fact-order = ?
     6402       or p-fact-order = 0
     6403       then do:
     6404         return error "Не указан fact-order" .
     6405       end.
     6406       assign
     6407        v-fact-order-trunc = truncate(p-fact-order, 2)
     6408       .
     6409       assign
     6410         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     6411       .
     6412     end.
     6413   end procedure.
     6414   procedure factord-to-shift-num :
     6415     define input  parameter p-fact-order as decimal no-undo .
     6416     define output parameter p-shift-num   as integer no-undo .
     6417     define variable  p-shift-numd  as decimal   no-undo .
     6418     define variable v-fact-order-trunc as decimal no-undo .
     6419     do
     6420     on error undo, return error return-value
     6421     :
     6422       if p-fact-order = ?
     6423       or p-fact-order = 0
     6424       then do:
     6425         return error "Не указан fact-order" .
     6426       end.
     6427       assign
     6428        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     6429       .
     6430       if v-fact-order-trunc < 0.5 then do:
     6431         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     6432       end.
     6433       assign
     6434         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     6435         .
     6436        assign
     6437         p-shift-num = truncate (p-shift-numd , 0)
     6438       .
     6439     end.
     6440   end procedure.
