     5500           view-as alert-box error .
     5501         undo, return error .
     5502       end.
     5503       if p-include-fact-order = true
     5504       then do:
     5505         assign
     5506           p-fact-order = p-fact-order - 0.0000000001
     5507         .
     5508       end.
     5509       define variable v-max-fact-order as character no-undo .
     5510       run factord-max-fact-order in this-procedure
     5511         (output v-max-fact-order
     5512         ) no-error .
     5513       if error-status :error
     5514       then do:
     5515         message
     5516           vss-workfile vss-revision vss-description skip
     5517           vss-include-info22 skip
     5518           "Ошибка при вызове процедуры factord-max-fact-order" skip
     5519           "Объект" p-obj-type p-obj-code skip
     5520           "Артикул" p-artic p-prod-type p-prod-code skip
     5521           "p-fact-order" p-fact-order skip
     5522           view-as alert-box error .
     5523         undo, return error .
     5524       end.
     5525       run partslib-update-by-factord in this-procedure
     5526         (input p-obj-type
     5527         ,input p-obj-code
     5528         ,input p-artic
     5529         ,input p-prod-type
     5530         ,input p-prod-code
     5531         ,input p-fact-order
     5532         ,input v-max-fact-order
     5533         ,input false
     5534         ) no-error .
     5535       if error-status :error
     5536       then do:
     5537         message
