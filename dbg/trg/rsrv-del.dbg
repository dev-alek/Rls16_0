     3299           return-value skip
     3300           view-as alert-box error .
     3301         undo, return error .
     3302       end.
     3303       if buf_trn-doc.ext-doc-type = 'vt':U
     3304       then do :
     3305           delete object v-tth no-error.
     3306           run adm/shattri.p (
     3307              input "get":U
     3308             ,input buf_trn-doc.obj-type
     3309             ,input buf_trn-doc.obj-code
     3310             ,input 'inv-obj':U
     3311             ,input  "izlcstpr"
     3312             ,output v-value-character
