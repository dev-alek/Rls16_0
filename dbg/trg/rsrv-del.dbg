     5302   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5303   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     5304   procedure partslib-clear-temp-parts :
     5305     define buffer buf_temp-parts for temp-parts .
     5306     do
     5307     on error undo, return error
     5308     :
     5309       for each buf_temp-parts
     5310       on error undo, return error
     5311       :
     5312         delete buf_temp-parts .
     5313       end.
     5314     end.
     5315   end procedure.
     5316   procedure partslib-create-temp-parts :
     5317     define parameter buffer buf_parts       for ub.parts .
     5318     define parameter buffer buf_temp-parts  for temp-parts .
     5319     define input  parameter p-goods-twounit as logical   no-undo .
     5320     define variable v-base-part-code as character no-undo .
     5321     do
     5322     on error undo, return error
     5323     :
     5324       if p-goods-twounit = true
     5325       then do:
     5326         assign
     5327           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     5328         .
     5329       end.
     5330       else do:
     5331         assign
     5332           v-base-part-code = buf_parts.part-code
     5333         .
     5334       end.
     5335       find first buf_temp-parts exclusive-lock
     5336         where buf_temp-parts.obj-type  = buf_parts.obj-type
     5337           and buf_temp-parts.obj-code  = buf_parts.obj-code
     5338           and buf_temp-parts.artic     = buf_parts.artic
     5339           and buf_temp-parts.prod-type = buf_parts.prod-type
     5340           and buf_temp-parts.prod-code = buf_parts.prod-code
     5341           and buf_temp-parts.in-code   = buf_parts.in-code
     5342           and buf_temp-parts.out-code  = 'free-zone':U
     5343           and buf_temp-parts.part-code = v-base-part-code
     5344         no-error.
     5345       if not available buf_temp-parts
     5346       then do:
     5347         create buf_temp-parts .
     5348         buffer-copy buf_parts to buf_temp-parts
     5349         assign
     5350           buf_temp-parts.out-code  = 'free-zone':U
     5351           buf_temp-parts.part-code = v-base-part-code
     5352           buf_temp-parts.rsrv-free = yes
     5353           buf_temp-parts.status_   = no
     5354           buf_temp-parts.qnty      = 0
     5355           buf_temp-parts.fact-qnty = 0
     5356           buf_temp-parts.real-qnty = 0
     5357           buf_temp-parts.cli-qnty  = 0
     5358         .
     5359       end.
     5360     end.
     5361   end procedure.
     5362   procedure partslib-init-temp-parts :
     5363     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     5364     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     5365     define input parameter p-artic           like ub.parts.artic     no-undo .
     5366     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     5367     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     5368     define buffer buf_parts      for ub.parts .
     5369     define buffer buf_temp-parts for temp-parts .
     5370     define variable v-goods-twounit    as logical   no-undo .
     5371     do
     5372     on error undo, return error
     5373     :
     5374   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     5376     (input  p-artic
     5377     ,input  p-prod-type
     5378     ,input  p-prod-code
     5379     ,input  'twounit=request':u
     5380     ,output v-goods-twounit
     5381     ) no-error .
     5382       if error-status :error
     5383       then do:
     5384         message
     5385           vss-workfile vss-revision vss-description skip
     5386           vss-include-info22 skip
     5387           "Ошибка при определении атрибута товара" skip
     5388           "Артикул" p-artic p-prod-type p-prod-code skip
     5389           "twounit=request" skip
     5390           error-status :get-message(1) skip
     5391           return-value skip
     5392           view-as alert-box error .
     5393         undo, return error return-value .
     5394       end.
     5395       run partslib-clear-temp-parts in this-procedure .
     5396       for each buf_parts
     5397         where buf_parts.obj-type  = p-obj-type
     5398           and buf_parts.obj-code  = p-obj-code
     5399           and buf_parts.artic     = p-artic
     5400           and buf_parts.prod-type = p-prod-type
     5401           and buf_parts.prod-code = p-prod-code
     5402           and buf_parts.rsrv-free = yes
     5403           and buf_parts.status_   = no
     5404           and buf_parts.in-code   <> buf_parts.out-code
     5405       on error undo, return error
     5406       :
     5407         run partslib-create-temp-parts in this-procedure
     5408           (buffer buf_parts
     5409           ,buffer buf_temp-parts
     5410           ,input  v-goods-twounit
     5411           ) .
     5412         define variable v-parts-qnty          as decimal   no-undo .
     5413         define variable v-parts-cli-qnty      as decimal   no-undo .
     5414         define variable v-parts-free-qnty     as decimal   no-undo .
     5415         define variable v-parts-free-cli-qnty as decimal   no-undo .
     5416         if buf_parts.out-code = 'free-zone':U
     5417         then do:
     5418           assign
     5419             v-parts-qnty          = buf_parts.qnty
     5420             v-parts-cli-qnty      = buf_parts.cli-qnty
     5421             v-parts-free-qnty     = buf_parts.qnty
     5422             v-parts-free-cli-qnty = buf_parts.cli-qnty
     5423           .
     5424         end.
     5425         else do:
     5426           assign
     5427             v-parts-qnty          = abs(buf_parts.qnty)
     5428             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     5429             v-parts-free-qnty     = 0
     5430             v-parts-free-cli-qnty = 0
     5431           .
     5432         end.
     5433         assign
     5434           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     5435           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     5436           buf_temp-parts.real-qnty     = 0
     5437           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     5438           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     5439           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     5440         .
     5441       end.
     5442     end.
     5443   end procedure.
     5444   procedure partslib-init-temp-parts-by-factord :
     5445     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     5446     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     5447     define input parameter p-artic              like ub.parts.artic     no-undo .
