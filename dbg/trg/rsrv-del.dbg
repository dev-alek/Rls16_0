     3198                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
     3199                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
     3200                                                       and orig_marking-lines.in-code    = archive_parts.in-code
     3201                                                       and orig_marking-lines.out-code   = archive_parts.out-code
     3202                                                       and orig_marking-lines.part-code  = archive_parts.part-code
     3203                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
     3204                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     3205                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
