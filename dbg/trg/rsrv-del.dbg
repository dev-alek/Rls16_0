     3131                       "Партия" buf_parts.in-code buf_parts.part-code skip
     3132                       "Резерв" buf_parts.out-code skip
     3133                       "qnty" buf_parts.qnty skip
     3134                       "fact-qnty" buf_parts.fact-qnty skip
     3135                       "cli-qnty" buf_parts.cli-qnty skip
     3136                       view-as alert-box error .
     3137                     undo, return error .
     3138                   end.
     3139                 end.
