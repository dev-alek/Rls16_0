     3216                     "Документ" p-doc-code skip
     3217                     "Объект" p-obj-type p-obj-code skip
     3218                     "Артикул" p-artic p-prod-type p-prod-code skip
     3219                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3220                     "Количество по документу" archive_parts.qnty skip
     3221                     "Фактическое количество" archive_parts.fact-qnty skip
     3222                     "Клиентское количество" archive_parts.cli-qnty skip
     3223                     view-as alert-box error .
     3224                   undo, return error .
     3225                 end.
     3226                 else do:
     3227                   if buf_parts.cli-base-rate <> 0
     3228                   then do:
