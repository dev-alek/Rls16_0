     3071                     "Объект" p-obj-type p-obj-code skip
     3072                     "Артикул" p-artic p-prod-type p-prod-code skip
     3073                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3074                     "Количество по документу" archive_parts.qnty skip
