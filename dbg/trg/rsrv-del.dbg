     3077                     view-as alert-box error .
     3078                   undo, return error .
     3079                 end.
     3080                 if archive_parts.fact-qnty = archive_parts.qnty
     3081                 then do:
     3082                   assign
     3083                     buf_parts.cli-qnty = buf_parts.cli-qnty + abs(archive_parts.cli-qnty)
     3084                   .
     3085                 end.
     3086                 else do:
     3087                   message
     3088                     vss-workfile vss-revision vss-description skip
     3089                     vss-include-info4 skip
     3090                     "Фактическое количество для товара," skip
     3091                     "который учитывается по двум единицам измерения" skip
     3092                     "должно равняться нулю или количеству по документу" skip
     3093                     "Документ" p-doc-code skip
     3094                     "Объект" p-obj-type p-obj-code skip
     3095                     "Артикул" p-artic p-prod-type p-prod-code skip
     3096                     "Партия" archive_parts.in-code archive_parts.part-code skip
     3097                     "Количество по документу" archive_parts.qnty skip
     3098                     "Фактическое количество" archive_parts.fact-qnty skip
     3099                     "Клиентское количество" archive_parts.cli-qnty skip
     3100                     view-as alert-box error .
     3101                   undo, return error .
     3102                 end.
     3103               end.
     3104               else do:
     3105                 if buf_parts.cli-base-rate <> 0
     3106                 then do:
     3107                   assign
     3108                     buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3109                   .
     3110                 end.
     3111                 else do:
     3112                   assign
     3113                     buf_parts.cli-qnty = 0
     3114                   .
     3115                 end.
     3116               end.
     3117               if  buf_parts.qnty      = 0
     3118               and buf_parts.fact-qnty = 0
     3119               then do:
     3120                 if v-goods-twounit = true
     3121                 then do:
     3122                   if buf_parts.cli-qnty <> 0
     3123                   then do:
     3124                     message
     3125                       vss-workfile vss-revision vss-description skip
     3126                       vss-include-info4 skip
     3127                       "Ошибка при удалении партии" skip
     3128                       "Документ" p-doc-code skip
