     2660               .
     2661               case buf_trn-doc.ext-doc-type :
     2662                 when 'ie':U
     2663                 then do:
     2664                   if archive_parts.cli-qnty <> truncate(archive_parts.cli-qnty, 0 )
     2665                   then do:
     2666                     message
     2667                       vss-workfile vss-revision vss-description skip
     2668                       vss-include-info4 skip
     2669                       "Клиентское количество для товара," skip
     2670                       "который учитывается по двум единицам измерения" skip
     2671                       "должно равняться единице" skip
     2672                       "Документ" p-doc-code skip
     2673                       "Объект" p-obj-type p-obj-code skip
     2674                       "Артикул" p-artic p-prod-type p-prod-code skip
     2675                       "Партия" archive_parts.in-code archive_parts.part-code skip
