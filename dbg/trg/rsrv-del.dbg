     6826             error-status :get-message(1) skip
     6827             return-value skip
     6828             view-as alert-box error .
     6829           undo, return error .
     6830         end.
     6831       end.
     6832     end.
     6833     if buf_trn-doc.doc-type = 'инв':U then do:
     6834       for each buf_gds-dtl
     6835         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     6836           and buf_gds-dtl.artic     = buf_doc-line.artic
     6837           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     6838           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     6839       on error undo, return error return-value
     6840       :
     6841         delete buf_gds-dtl .
     6842       end.
     6843       find buf_gds-obj no-lock
     6844         where buf_gds-obj.obj-type  = buf_doc-line.obj-type
     6845           and buf_gds-obj.obj-code  = buf_doc-line.obj-code
     6846           and buf_gds-obj.artic     = buf_doc-line.artic
     6847           and buf_gds-obj.prod-type = buf_doc-line.prod-type
     6848           and buf_gds-obj.prod-code = buf_doc-line.prod-code
     6849         no-error.
     6850       if available buf_gds-obj then do:
     6851         if buf_trn-doc.fact-date = ? then do:
     6852           assign
     6853             buf_doc-line.doc-qnty = buf_gds-obj.fact-qnty
     6854           .
     6855           if available buf_inv-line then do:
     6856             run get-after-cli-qnty in this-procedure
     6857               ( input buf_doc-line.obj-type
     6858                ,input buf_doc-line.obj-code
     6859                ,input buf_doc-line.artic
     6860                ,input buf_doc-line.prod-type
     6861                ,input buf_doc-line.prod-code
     6862                ,input ?
     6863                ,output v-before-cli-qnty
     6864               ).
     6865           end.
     6866         end.
     6867         else do:
     6868            run doc-qnty-by-factord in this-procedure
     6869             ( input buf_doc-line.obj-type
     6870              ,input buf_doc-line.obj-code
     6871              ,input buf_doc-line.artic
     6872              ,input buf_doc-line.prod-type
     6873              ,input buf_doc-line.prod-code
     6874              ,output buf_doc-line.doc-qnty
     6875              ,output v-before-cli-qnty
     6876             ) .
     6877         end.
     6878         if available buf_inv-line then do:
     6879           assign
     6880             buf_inv-line.before-cli-qnty = v-before-cli-qnty
     6881             buf_inv-line.wast-cli-qnty   = buf_inv-line.before-cli-qnty
     6882             buf_inv-line.after-cli-qnty  = buf_inv-line.wast-cli-qnty
     6883           .
     6884         end.
     6885       end.
     6886       else do:
     6887         assign
     6888           buf_doc-line.doc-qnty = 0
     6889         .
     6890         if available buf_inv-line then do:
     6891           assign
     6892             buf_inv-line.before-cli-qnty = 0.0
     6893             buf_inv-line.wast-cli-qnty   = 0.0
     6894             buf_inv-line.after-cli-qnty  = 0.0
     6895           .
     6896         end.
     6897       end.
     6898       assign
     6899         buf_doc-line.fact-qnty = 0.0
     6900         buf_doc-line.prt-OK = ?
     6901       .
     6902       if available buf_inv-line then do:
     6903         assign
     6904           buf_doc-line.cli-qnty = 0.0
     6905         .
     6906       end.
     6907     end.
     6908     else do:
     6909       assign
     6910         buf_doc-line.doc-qnty = 0
     6911       .
     6912     end.
     6913   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6914   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
     6915     (input buf_doc-line.obj-type
     6916     ,input buf_doc-line.obj-code
     6917     ,input buf_doc-line.artic
     6918     ,input buf_doc-line.prod-type
     6919     ,input buf_doc-line.prod-code
     6920     ,input v-root-node
     6921     ,input ''
     6922     ) no-error .
     6923     if error-status :error then do:
     6924       message
     6925         vss-workfile vss-revision vss-description skip
     6926         "Ошибка при проверке целостности товара" skip
     6927         "Документ" p-doc-code skip
     6928         "Артикул" p-artic p-prod-type p-prod-code skip
     6929         "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
     6930         "Проверка целостности товара после удаления резервов" skip
     6931         error-status :get-message(1) skip
     6932         return-value skip
     6933         view-as alert-box error .
     6934       undo, return error .
     6935     end.
     6936   end.
     6937   procedure get-after-cli-qnty :
     6938     define input  parameter par-obj-type     like ub.doc-line.obj-type  no-undo .
     6939     define input  parameter par-obj-code     like ub.doc-line.obj-code  no-undo .
     6940     define input  parameter par-artic        like ub.doc-line.artic     no-undo .
     6941     define input  parameter par-prod-type    like ub.doc-line.prod-type no-undo .
     6942     define input  parameter par-prod-code    like ub.doc-line.prod-code no-undo .
     6943     define input  parameter p-fact-order-end as decimal   no-undo .
     6944     define output parameter p-fact-qty-kg    as decimal no-undo initial 0.0.
     6945     define buffer bufloc_inv-line for ub.inv-line.
     6946     do
     6947     on error undo, return error return-value
     6948     :
     6949       if p-fact-order-end = ? then do:
     6950         find last bufloc_inv-line no-lock
     6951           where bufloc_inv-line.obj-type   = par-obj-type
     6952             and bufloc_inv-line.obj-code   = par-obj-code
     6953             and bufloc_inv-line.prod-type  = par-prod-type
     6954             and bufloc_inv-line.prod-code  = par-prod-code
     6955             and bufloc_inv-line.artic      = par-artic
     6956             and bufloc_inv-line.status_    = 'факт':U
     6957             and bufloc_inv-line.fact-order > 0
     6958           use-index fact-order
     6959           no-error.
     6960       end.
     6961       else do:
     6962         find last bufloc_inv-line no-lock
     6963           where bufloc_inv-line.obj-type   = par-obj-type
     6964             and bufloc_inv-line.obj-code   = par-obj-code
     6965             and bufloc_inv-line.prod-type  = par-prod-type
     6966             and bufloc_inv-line.prod-code  = par-prod-code
     6967             and bufloc_inv-line.artic      = par-artic
     6968             and bufloc_inv-line.status_    = 'факт':U
     6969             and bufloc_inv-line.fact-order <= p-fact-order-end
     6970           use-index fact-order
     6971           no-error.
     6972       end.
     6973       if available bufloc_inv-line then do:
     6974         assign
     6975           p-fact-qty-kg = bufloc_inv-line.after-cli-qnty
     6976         .
     6977       end.
     6978     end.
     6979   end procedure.
     6980   procedure doc-qnty-by-factord :
     6981     define input  parameter par-obj-type   like ub.doc-line.obj-type  no-undo .
     6982     define input  parameter par-obj-code   like ub.doc-line.obj-code  no-undo .
     6983     define input  parameter par-artic      like ub.doc-line.artic     no-undo .
     6984     define input  parameter par-prod-type  like ub.doc-line.prod-type no-undo .
     6985     define input  parameter par-prod-code  like ub.doc-line.prod-code no-undo .
     6986     define output parameter v-doc-qnty     as decimal   no-undo .
     6987     define output parameter v-cli-doc-qnty as decimal   no-undo .
     6988     do
     6989     on error undo, return error return-value
     6990     :
     6991       define variable v-shift-on  as logical   no-undo .
     6992       define variable v-fact-order-end as decimal   no-undo .
     6993       define variable v-shift-end-fact-order as decimal   no-undo .
     6994       define variable v-day-end-fact-order   as decimal   no-undo .
     6995   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6996   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6997     (input  buf_trn-doc.obj-type
     6998     ,input  buf_trn-doc.obj-code
     6999     ,input  'shift-on=request'
     7000     ,output v-shift-on
     7001     ) no-error .
     7002       if error-status :error then do:
     7003         message
     7004             vss-workfile vss-revision vss-description
     7005             skip "Ошибка при запросе, включены ли смены"
     7006             skip error-status :get-message(1)
     7007             skip return-value
     7008         view-as alert-box error .
     7009         undo, return error .
     7010       end.
     7011       run factord in this-procedure (
     7012             input  buf_trn-doc.fact-date
     7013           , input  buf_trn-doc.fact-time
     7014           , input  buf_trn-doc.fact-time
     7015           , input  buf_trn-doc.shift-date
     7016           , input  buf_trn-doc.shift-num
     7017           , input  v-shift-on
     7018           , output v-fact-order-end
     7019           , output v-shift-end-fact-order
     7020           , output v-day-end-fact-order
     7021       ) no-error .
     7022       if v-shift-on = true then
     7023         v-fact-order-end = v-shift-end-fact-order .
     7024       else
     7025         v-fact-order-end = v-day-end-fact-order .
     7026       run partslib-init-temp-parts-by-factord in this-procedure
     7027         ( input par-obj-type
     7028          ,input par-obj-code
     7029          ,input par-artic
     7030          ,input par-prod-type
     7031          ,input par-prod-code
     7032          ,input v-fact-order-end
     7033          ,input false
     7034         ) .
     7035       assign
     7036         v-doc-qnty = 0
     7037       .
     7038       for each temp-parts
     7039       on error undo, return error return-value
     7040       :
     7041         assign
     7042           v-doc-qnty = v-doc-qnty + temp-parts.fact-qnty
     7043         .
     7044       end.
     7045       run get-after-cli-qnty in this-procedure
     7046         ( input par-obj-type
     7047          ,input par-obj-code
     7048          ,input par-artic
     7049          ,input par-prod-type
     7050          ,input par-prod-code
     7051          ,input v-fact-order-end
     7052          ,output v-cli-doc-qnty
     7053         ).
     7054     end.
     7055   end procedure.
