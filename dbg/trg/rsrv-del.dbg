     3252     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     3253     define variable objMarks as class excisemarks no-undo.
     3254     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
     3255     define buffer buf_trn-doc    for ub.trn-doc .
