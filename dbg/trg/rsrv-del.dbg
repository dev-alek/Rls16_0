        1   block-level on error undo, throw.
        2   using ibs.th.str.alcohol.*.
        3   define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
        4   define input  parameter p-artic     like ub.doc-line.artic     no-undo .
        5   define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
        6   define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
        7   define variable chg-qnty      as   decimal no-undo .
        8   define variable vss-revision    as character no-undo initial "$Revision$":U.
        9   define variable vss-author      as character no-undo initial "$Author$":U.
       10   define variable vss-date        as character no-undo initial "$Date$":U.
       11   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       12   define variable vss-archive     as character no-undo initial "$Archive$":U.
       13   define variable vss-description as character no-undo initial "Снятие резервирования по строке для любого документа":U.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32       assign
       33         p-vss-parameters = substitute( '&1|&2|&3|&4', p-doc-code, p-artic, p-prod-type, p-prod-code )
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define new global shared variable g#lib-trn  as handle no-undo .
       78   define new global shared variable g#lib-trn2 as handle no-undo .
       79   define new global shared variable g#lib-trn3 as handle no-undo .
       80   define new global shared variable g#lib-trn4 as handle no-undo .
       81   function hvrdtax return logical (input parrecid as recid):
       82   define variable varresult as logical no-undo.
       83   run hvrdtax-proc (input parrecid, output varresult).
       84   return varresult.
       85   end function.
       86   procedure hvrdtax-proc:
       87   define input  parameter parrecid  as recid   no-undo.
       88   define output parameter parresult as logical no-undo.
       89   define buffer bf_goods for ub.goods.
       90   define buffer bf_units for ub.units.
       91   define buffer rt_tax   for ub.tax.
       92   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
       93   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
       94   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
       95   if available rt_tax and
       96       can-find(first ub.tax-units No-LOCK WHERE
       97                      ub.tax-units.tax-code = rt_tax.tax-code AND
       98                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
       99                                                       else assign parresult = no.
      100   end procedure.
      101   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   procedure partrqst :
      103     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
      104     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
      105     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
      106     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
      107     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
      108     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
      109     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
      110     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
      111     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
      112     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
      113     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
      114     define output parameter p-total-parts-price-base     as decimal                 no-undo .
      115     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
      116     define output parameter p-total-parts-transport-base as decimal                 no-undo .
      117     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
      118     define output parameter p-total-parts-other-base     as decimal                 no-undo .
      119     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
      120     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
      121     do
      122     on error undo, return error return-value
      123     :
      124       assign
      125         p-total-parts-qnty           = 0
      126         p-total-parts-fact-qnty      = 0
      127         p-total-parts-cli-qnty       = 0
      128         p-total-parts-fact-cli-qnty  = 0
      129         p-total-parts-price-cli      = 0
      130         p-total-parts-price-base     = 0
      131         p-total-parts-price-rubl     = 0
      132         p-total-parts-transport-base = 0
      133         p-total-parts-transport-rubl = 0
      134         p-total-parts-other-base     = 0
      135         p-total-parts-other-rubl     = 0
      136       .
      137       define buffer buf_parts for ub.parts .
      138       for each buf_parts no-lock
      139         where buf_parts.out-code  = p-doc-code
      140           and buf_parts.obj-type  = p-obj-type
      141           and buf_parts.obj-code  = p-obj-code
      142           and buf_parts.artic     = p-artic
      143           and buf_parts.prod-type = p-prod-type
      144           and buf_parts.prod-code = p-prod-code
      145       on error undo, return error return-value
      146       :
      147         define variable v-parts-fact-multiplier as decimal   no-undo .
      148         assign
      149           v-parts-fact-multiplier = 1
      150         .
      151         if buf_parts.qnty <> 0 then do:
      152           assign
      153             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      154           .
      155         end.
      156         assign
      157           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      158           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      159           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      160           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      161                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      162           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      163           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      164           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      165           p-total-parts-transport-base  = p-total-parts-transport-base
      166                                         + buf_parts.fact-qnty
      167                                           * (if   buf_parts.transport-base <> ?
      168                                             then buf_parts.transport-base
      169                                             else 0
      170                                             )
      171           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      172                                         + buf_parts.fact-qnty
      173                                           * (if   buf_parts.transport-rubl <> ?
      174                                             then buf_parts.transport-rubl
      175                                             else 0
      176                                             )
      177           p-total-parts-other-base      = p-total-parts-other-base
      178                                         + buf_parts.fact-qnty
      179                                           * (if   buf_parts.other-base <> ?
      180                                             then buf_parts.other-base
      181                                             else 0
      182                                             )
      183           p-total-parts-other-rubl      = p-total-parts-other-rubl
      184                                         + buf_parts.fact-qnty
      185                                           * (if   buf_parts.other-rubl <> ?
      186                                             then buf_parts.other-rubl
      187                                             else 0
      188                                             )
      189         .
      190       end.
      191     end.
      192   end procedure.
      193   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194   procedure gen-key-rec :
      195     define input  parameter p-tbl-name    as character no-undo.
      196     define input  parameter p-bh_tbl-name as handle    no-undo.
      197     define output parameter p-key-rec     as character no-undo.
      198     do
      199     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      200     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      201     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      202     :
      203       define variable fh               as handle    no-undo .
      204       define variable v-ok             as logical   no-undo .
      205       define variable v-inform         as character no-undo .
      206       define variable v-ind            as integer   no-undo .
      207       define variable v-idx-field-qnty as integer   no-undo .
      208       if p-tbl-name = ?
      209         or p-tbl-name = "":U
      210       then do:
      211         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      212       end.
      213       if not p-bh_tbl-name:available then do:
      214         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      215       end.
      216       assign
      217         p-key-rec = p-tbl-name
      218         v-inform  = p-bh_tbl-name:index-information(1)
      219         v-ind     = 2
      220       .
      221       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      222       on error undo, return error
      223       :
      224         assign
      225           v-inform = p-bh_tbl-name:index-information( v-ind )
      226           v-ind    = v-ind + 1
      227         .
      228       end.
      229       if v-inform = ?
      230         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      231         or entry( 3, v-inform, ",":U ) <> "1":U
      232       then do:
      233         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      234       end.
      235       else do:
      236         assign
      237           v-idx-field-qnty = num-entries( v-inform ) - 4
      238         .
      239         if v-idx-field-qnty < 2 then do:
      240           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      241         end.
      242         do v-ind = 1 to v-idx-field-qnty by 2
      243         on error undo, return error
      244         :
      245           assign
      246             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      247             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      248           .
      249         end.
      250       end.
      251       if p-key-rec = ? then do:
      252         assign
      253           p-key-rec = "":U
      254         .
      255         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      256       end.
      257     end.
      258     return.
      259   end procedure.
      260   procedure gen-where-keyr-tab :
      261     define input  parameter i-tableSerach as character no-undo.
      262     define input  parameter i-tablekey   as character  no-undo.
      263     define input  parameter p-key-rec    as character  no-undo.
      264     define input  parameter p-key-handle as handle     no-undo .
      265     define input  parameter p-db-name    as character  no-undo .
      266     define input  parameter p-tt-handle  as handle     no-undo .
      267     define output parameter o-Where      as character  no-undo.
      268     do
      269     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      270     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      271     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      272     :
      273       define variable v-full-tbl-name  as character no-undo .
      274       define variable bh_tbl-name      as handle    no-undo .
      275       define variable fh_key           as handle    no-undo .
      276       define variable fh_search        as handle    no-undo .
      277       define variable v-field-num      as integer   no-undo .
      278       define variable v-count-fld      as integer   no-undo .
      279       define variable v-inform         as character no-undo .
      280       define variable v-ind            as integer   no-undo .
      281       define variable v-idx-field-qnty as integer   no-undo .
      282       define variable v-field-name     as character no-undo .
      283       define variable v-field-val      as character no-undo .
      284       define variable v-word-link      as character no-undo .
      285       define variable vTable           as character no-undo.
      286       define variable bh_tbl-key       as handle    no-undo .
      287       assign
      288         p-key-rec = trim( p-key-rec )
      289       .
      290       if p-key-handle <> ? then do:
      291         if not valid-handle(p-key-handle)
      292            or p-key-handle:type <> "buffer"
      293         then do:
      294           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      295         end.
      296         if num-entries( p-key-rec, chr(3) ) > 1
      297           or p-key-rec = ?
      298           or p-key-rec = "":U
      299         then do:
      300           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      301         end.
      302       end.
      303       else do:
      304         if p-key-rec = ?
      305           or p-key-rec = "":U
      306         then do:
      307           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      308         end.
      309       end.
      310       assign
      311         vTable = entry( 1 , p-key-rec, chr(3) )
      312       .
      313       if p-tt-handle <> ?
      314         and ( not valid-handle(p-tt-handle)
      315               or p-tt-handle:type <> "buffer"
      316             )
      317       then do:
      318         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      319       end.
      320       if p-tt-handle = ? then do:
      321         assign
      322           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      323         .
      324         create buffer bh_tbl-name for table v-full-tbl-name .
      325       end.
      326       else do:
      327         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      328       end.
      329       assign
      330         v-inform = bh_tbl-name:index-information(1)
      331         v-ind    = 2
      332       .
      333       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      334       on error undo, return error
      335       :
      336         assign
      337           v-inform = bh_tbl-name:index-information( v-ind )
      338           v-ind    = v-ind + 1
      339         .
      340       end.
      341       if v-inform = ?
      342         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      343         or entry( 3, v-inform, ",":U ) <> "1":U
      344       then do:
      345         delete object bh_tbl-name no-error.
      346         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      347       end.
      348       assign
      349         v-idx-field-qnty = num-entries( v-inform ) - 4
      350       .
      351       if v-idx-field-qnty < 2 then do:
      352         delete object bh_tbl-name no-error.
      353         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      354       end.
      355       assign
      356         o-where     = "where":U
      357         v-word-link = "":U
      358         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      359         v-count-fld = 0
      360       .
      361       if i-tablekey ne "" and i-tablekey ne ?
      362       then do:
      363         assign
      364           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      365         .
      366         create buffer bh_tbl-key for table v-full-tbl-name .
      367       end.
      368       if i-tableSerach ne "" and i-tableSerach ne ?
      369       then do:
      370         delete object bh_tbl-name no-error.
      371         assign
      372           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      373         .
      374         create buffer bh_tbl-name for table v-full-tbl-name .
      375       end.
      376       block_where:
      377       do v-ind = 1 to v-idx-field-qnty by 2
      378       on error undo, return error
      379       :
      380         assign
      381           v-count-fld = v-count-fld + 1
      382         .
      383         if p-key-handle = ?
      384           and v-count-fld > v-field-num
      385         then do:
      386           leave block_where.
      387         end.
      388         define variable VfieldKeyTable as handle no-undo.
      389         assign
      390           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      391           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      392         .
      393         if     bh_tbl-key ne ?
      394         then do:
      395            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      396            if VfieldKeyTable eq ?
      397            then next block_where.
      398         end.
      399         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      400         then
      401            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      402         else
      403            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      404         if p-key-handle = ? then do:
      405           assign
      406             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      407           .
      408         end.
      409         else do:
      410           assign
      411             fh_key = p-key-handle:buffer-field( v-field-name )
      412           .
      413           if fh_key = ?
      414             or not valid-handle( fh_key )
      415           then do:
      416             delete object bh_tbl-name.
      417             if     bh_tbl-key ne ?
      418             then
      419                delete object bh_tbl-key.
      420             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      421           end.
      422           assign
      423             v-field-val = fh_key:buffer-value
      424           .
      425         end.
      426         if fh_search:data-type ="character":U then do:
      427           assign
      428             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      429             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      430             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      431             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      432             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      433             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      434             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      435             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      436             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      437             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      438             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      439             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      440             v-field-val = substitute( '"&1"', v-field-val )
      441           .
      442         end.
      443         assign
      444           o-where = substitute( "&1 &2", o-where, v-field-val )
      445         .
      446         if v-word-link = "":U then do:
      447           assign
      448             v-word-link = "and":U
      449           .
      450         end.
      451       end.
      452       delete object bh_tbl-name.
      453       if     bh_tbl-key ne ?
      454       then
      455          delete object bh_tbl-key.
      456       if p-key-handle = ?
      457         and v-count-fld <> v-field-num
      458       then do:
      459         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      460       end.
      461     end.
      462   end procedure.
      463   procedure gen-hn-keyr-tab :
      464     define input  parameter i-tableSerach as character no-undo.
      465     define input  parameter i-tablekey   as character no-undo.
      466     define input  parameter p-key-rec    as character no-undo.
      467     define input  parameter p-key-handle as handle    no-undo .
      468     define input  parameter p-db-name    as character no-undo .
      469     define input  parameter p-tt-handle  as handle    no-undo .
      470     define input  parameter p-stts-lock  as integer   no-undo .
      471     define output parameter o-hn         as handle    no-undo.
      472     define variable v-full-tbl-name as character no-undo.
      473     define variable v-where         as character no-undo.
      474     define variable bh_tbl-name     as handle    no-undo.
      475     define variable vTable          as character no-undo.
      476     do
      477     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      478     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      479     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      480         run gen-where-keyr-tab(i-tableSerach,
      481                                i-tablekey,
      482                                p-key-rec,
      483                                p-key-handle,
      484                                p-db-name,
      485                                p-tt-handle,
      486                                output v-where).
      487         if i-tableSerach ne "" and i-tableSerach ne ?
      488         then do:
      489            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      490            create buffer bh_tbl-name for table v-full-tbl-name .
      491         end.
      492         else do:
      493            if p-tt-handle = ? then do:
      494               assign
      495                  vTable = entry( 1 , p-key-rec, chr(3) )
      496               .
      497               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      498               create buffer bh_tbl-name for table v-full-tbl-name .
      499            end.
      500            else do:
      501               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      502            end.
      503         end.
      504         if p-tt-handle = ? then do:
      505            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      506         end.
      507         else do:
      508            bh_tbl-name:find-first( v-where ) no-error .
      509         end.
      510         o-hn = bh_tbl-name.
      511      end.
      512   end procedure.
      513   procedure gen-hn-keyr :
      514     define input  parameter p-key-rec    as character no-undo.
      515     define input  parameter p-key-handle as handle    no-undo .
      516     define input  parameter p-db-name    as character no-undo .
      517     define input  parameter p-tt-handle  as handle    no-undo .
      518     define input  parameter p-stts-lock  as integer   no-undo .
      519     define output parameter o-hn         as handle    no-undo.
      520     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      521   end.
      522   procedure gen-row-keyr :
      523     define input  parameter p-key-rec    as character no-undo.
      524     define input  parameter p-key-handle as handle    no-undo .
      525     define input  parameter p-db-name    as character no-undo .
      526     define input  parameter p-tt-handle  as handle    no-undo .
      527     define input  parameter p-stts-lock  as integer   no-undo .
      528     define output parameter p-tbl-row    as rowid     no-undo.
      529     define output parameter p-tbl-name   as character no-undo.
      530     define variable vHn as handle no-undo.
      531       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      532       p-tbl-row = if vHn:available then vHn:rowid else ?.
      533       p-tbl-name =  vHn:table.
      534       delete object vHn no-error.
      535     if p-tbl-row = ? then do:
      536       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      537     end.
      538     else do:
      539       return.
      540     end.
      541   end procedure.
      542   procedure gen-key-fv :
      543     define input  parameter p-key-rec    as character no-undo .
      544     define output parameter p-field-list as character no-undo .
      545     define output parameter p-value-list as character no-undo.
      546     do
      547     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      548     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      549     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      550     :
      551       define variable v-full-tbl-name  as character no-undo .
      552       define variable bh_tbl-name      as handle    no-undo .
      553       define variable v-tbl-name       as character no-undo .
      554       define variable v-field-num      as integer   no-undo .
      555       define variable v-count-fld      as integer   no-undo .
      556       define variable v-inform         as character no-undo .
      557       define variable v-ind            as integer   no-undo .
      558       define variable v-idx-field-qnty as integer   no-undo .
      559       define variable v-delim-key      as character no-undo .
      560       if p-key-rec = ?
      561         or p-key-rec = "":U
      562       then do:
      563         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      564       end.
      565       assign
      566         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      567         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      568       .
      569       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      570       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      571       assign
      572         v-inform = bh_tbl-name:index-information(1)
      573         v-ind    = 2
      574       .
      575       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      576       on error undo, return error
      577       :
      578         assign
      579           v-inform = bh_tbl-name:index-information( v-ind )
      580           v-ind    = v-ind + 1
      581         .
      582       end.
      583       if v-inform = ?
      584         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      585         or entry( 3, v-inform, ",":U ) <> "1":U
      586       then do:
      587         delete object bh_tbl-name no-error.
      588         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      589       end.
      590       assign
      591         v-idx-field-qnty = num-entries( v-inform ) - 4
      592       .
      593       if v-idx-field-qnty < 2 then do:
      594         delete object bh_tbl-name no-error.
      595         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      596       end.
      597       assign
      598         p-field-list = "":U
      599         p-value-list = "":U
      600         v-delim-key  = "":U
      601         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      602         v-count-fld  = 0
      603       .
      604       block_where:
      605       do v-ind = 1 to v-idx-field-qnty by 2
      606       on error undo, return error
      607       :
      608         assign
      609           v-count-fld = v-count-fld + 1
      610         .
      611         if v-count-fld > v-field-num then do:
      612           leave block_where.
      613         end.
      614         assign
      615           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      616           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      617         .
      618         if v-ind = 1 then do:
      619           assign
      620             v-delim-key = chr(3)
      621           .
      622         end.
      623       end.
      624       delete object bh_tbl-name.
      625       if v-count-fld <> v-field-num then do:
      626         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      627       end.
      628     end.
      629   end procedure.
      630   procedure gen-key-field :
      631     define input  parameter p-table      as character no-undo .
      632     define output parameter p-field-list as character no-undo .
      633     do
      634     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      635     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      636     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      637     :
      638       define variable v-full-tbl-name  as character no-undo .
      639       define variable bh_tbl-name      as handle    no-undo .
      640       define variable v-tbl-name       as character no-undo .
      641       define variable v-field-num      as integer   no-undo .
      642       define variable v-count-fld      as integer   no-undo .
      643       define variable v-inform         as character no-undo .
      644       define variable v-ind            as integer   no-undo .
      645       define variable v-idx-field-qnty as integer   no-undo .
      646       define variable v-delim-key      as character no-undo .
      647       if p-table = ?
      648         or p-table = "":U
      649       then do:
      650         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      651       end.
      652       assign
      653         v-tbl-name      = p-table
      654         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      655       .
      656       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      657       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      658       assign
      659         v-inform = bh_tbl-name:index-information(1)
      660         v-ind    = 2
      661       .
      662       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      663       on error undo, return error
      664       :
      665         assign
      666           v-inform = bh_tbl-name:index-information( v-ind )
      667           v-ind    = v-ind + 1
      668         .
      669       end.
      670       if v-inform = ?
      671         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      672         or entry( 3, v-inform, ",":U ) <> "1":U
      673       then do:
      674         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      675       end.
      676       assign
      677         v-idx-field-qnty = num-entries( v-inform ) - 4
      678       .
      679       if v-idx-field-qnty < 2 then do:
      680         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      681       end.
      682       assign
      683         p-field-list = "":U
      684         v-delim-key  = "":U
      685         v-count-fld  = 0
      686       .
      687       block_where:
      688       do v-ind = 1 to v-idx-field-qnty by 2
      689       on error undo, return error
      690       :
      691         assign
      692           v-count-fld = v-count-fld + 1
      693         .
      694         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      695         if v-ind = 1 then do:
      696           assign
      697             v-delim-key = chr(3)
      698           .
      699         end.
      700       end.
      701       delete object bh_tbl-name.
      702     end.
      703   end procedure.
      704   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      705   define variable vss-include-info3 as character format "X(65)" no-undo
      706   initial "@(#)$Workfile$ $Revision$".
      707   procedure xmlchar-test :
      708   define input parameter p-in-string          as character        no-undo.
      709   define output parameter p-out-string-enc    as character        no-undo.
      710   define output parameter p-out-string-dec    as character        no-undo.
      711   do
      712   on error undo, return error
      713   :
      714          run xmlchar-encode in this-procedure
      715       (
      716             input p-in-string
      717           , output p-out-string-enc
      718       ).
      719          run xmlchar-decode in this-procedure
      720       (
      721             input p-out-string-enc
      722           , output p-out-string-dec
      723       ).
      724   end.
      725   end .
      726   procedure xmlchar-encode :
      727   define input parameter p-in-string      as character        no-undo.
      728   define output parameter p-out-string    as character        no-undo.
      729       define variable v-position      as integer      no-undo.
      730       define variable v-current-char  as character    no-undo.
      731   do
      732   on error undo, return error
      733   :
      734       assign
      735           p-out-string = "":U
      736       .
      737       case p-in-string
      738       :
      739           when ?
      740           then do:
      741               assign
      742                   p-out-string = "?":U
      743               .
      744           end.
      745           when "?":U
      746           then do:
      747               assign
      748                   p-out-string = "&#63;":U
      749               .
      750           end.
      751           otherwise do:
      752               do v-position = 1 to length( p-in-string )
      753               :
      754                   assign
      755                       v-current-char = substring( p-in-string, v-position, 1 )
      756                   .
      757                   case v-current-char
      758                   :
      759                       when "&":U
      760                       then do:
      761                           assign
      762                               p-out-string = p-out-string + "&amp;":U
      763                           .
      764                       end.
      765                       when ">":U
      766                       then do:
      767                           assign
      768                               p-out-string = p-out-string + "&gt;":U
      769                           .
      770                       end.
      771                       when "<":U
      772                       then do:
      773                           assign
      774                               p-out-string = p-out-string + "&lt;":U
      775                           .
      776                       end.
      777                       when "'":U
      778                       then do:
      779                           assign
      780                               p-out-string = p-out-string + "&apos;":U
      781                           .
      782                       end.
      783                       when '"':U
      784                       then do:
      785                           assign
      786                               p-out-string = p-out-string + "&quot;":U
      787                           .
      788                       end.
      789                       when chr(1)
      790                       then do:
      791                           assign
      792                               p-out-string = p-out-string + "":U
      793                           .
      794                       end.
      795                       when chr(2)
      796                       then do:
      797                           assign
      798                               p-out-string = p-out-string + "":U
      799                           .
      800                       end.
      801                       when chr(3)
      802                       then do:
      803                           assign
      804                               p-out-string = p-out-string + "":U
      805                           .
      806                       end.
      807                       when chr(4)
      808                       then do:
      809                           assign
      810                               p-out-string = p-out-string + "":U
      811                           .
      812                       end.
      813                       when chr(5)
      814                       then do:
      815                           assign
      816                               p-out-string = p-out-string + "":U
      817                           .
      818                       end.
      819                       when chr(6)
      820                       then do:
      821                           assign
      822                               p-out-string = p-out-string + "":U
      823                           .
      824                       end.
      825                       when chr(7)
      826                       then do:
      827                           assign
      828                               p-out-string = p-out-string + "":U
      829                           .
      830                       end.
      831                       when chr(8)
      832                       then do:
      833                           assign
      834                               p-out-string = p-out-string + "":U
      835                           .
      836                       end.
      837                       when chr(9)
      838                       then do:
      839                           assign
      840                               p-out-string = p-out-string + "":U
      841                           .
      842                       end.
      843                       when chr(29)
      844                       then do:
      845                           assign
      846                               p-out-string = p-out-string + "":U
      847                           .
      848                       end.
      849                       when chr(10)
      850                       then do:
      851                           assign
      852                               p-out-string = p-out-string + "&#10;":U
      853                           .
      854                       end.
      855                       when chr(13)
      856                       then do:
      857                           assign
      858                               p-out-string = p-out-string + "&#13;":U
      859                           .
      860                       end.
      861                       otherwise do:
      862                           assign
      863                               p-out-string = p-out-string + v-current-char
      864                           .
      865                       end.
      866                   end case.
      867               end.
      868           end.
      869       end case.
      870   end.
      871   end .
