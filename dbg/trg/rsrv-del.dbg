     3238                 end.
     3239             end.
     3240           end.
     3241           get next partcopy-select-parts .
     3242         end.
     3243       end.
     3244     end.
     3245   end procedure.
     3246   procedure partcopy-update-parts-delete :
     3247     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     3248     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
