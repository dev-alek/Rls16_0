     3141               end.
     3142             end.
     3143           end.
     3144           if  ( archive_parts.in-code = buf_trn-doc.doc-code
     3145           and archive_parts.supp-type =
     3146           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     3147           and archive_parts.supp-code =
