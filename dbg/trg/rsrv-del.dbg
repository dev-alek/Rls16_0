     3852               assign
     3853                 buf_parts.fact-date = buf_parts-attr.fact-date
     3854                 buf_parts.fact-num  = v-fact-num
     3855                 buf_parts.doc-type  = v-doc-type
     3856               .
     3857             end.
     3858             assign
     3859               buf_parts.qnty      = buf_parts.qnty  + v-unrv-sign * archive_parts.fact-qnty
     3860               buf_parts.fact-qnty = buf_parts.qnty
     3861             .
     3862   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3863   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     3864     (input  buf_parts.artic
     3865     ,input  buf_parts.prod-type
     3866     ,input  buf_parts.prod-code
     3867     ,output v-gds-code
     3868     ) no-error .
     3869             if buf_parts.out-code = 'free-zone':U
     3870             then
     3871             for each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = v-gds-code
     3872                                                         and buf_marking-lines.obj-type = archive_parts.obj-type
     3873                                                         and buf_marking-lines.obj-code = archive_parts.obj-code
     3874                                                         and buf_marking-lines.in-code  = archive_parts.in-code
     3875                                                         and buf_marking-lines.out-code = archive_parts.out-code
     3876                                                         and buf_marking-lines.part-code = archive_parts.part-code
     3877                                                         and buf_marking-lines.prt-code = archive_parts.prt-code:
     3878               for first buf_marking exclusive-lock where buf_marking.mark = buf_marking-lines.mark :
     3879                 find first free_marking-lines no-lock where free_marking-lines.mark       = buf_marking-lines.mark
     3880                                                         and free_marking-lines.gds-code   = buf_marking-lines.gds-code
     3881                                                         and free_marking-lines.obj-type   = buf_parts.obj-type
     3882                                                         and free_marking-lines.obj-code   = buf_parts.obj-code
     3883                                                         and free_marking-lines.in-code    = buf_parts.in-code
     3884                                                         and free_marking-lines.out-code   = buf_parts.out-code
     3885                                                         and free_marking-lines.part-code  = buf_parts.part-code
     3886                                                         and free_marking-lines.prt-code   = buf_parts.prt-code
     3887                                                         no-error .
     3888                 if not available free_marking-lines
     3889                 then do :
     3890                   create free_marking-lines .
     3891                   assign
     3892                     free_marking-lines.mark       = buf_marking-lines.mark
     3893                     free_marking-lines.doc-level  = buf_marking-lines.doc-level
     3894                     free_marking-lines.gds-code   = buf_marking-lines.gds-code
     3895                     free_marking-lines.obj-type   = buf_parts.obj-type
     3896                     free_marking-lines.obj-code   = buf_parts.obj-code
     3897                     free_marking-lines.in-code    = buf_parts.in-code
     3898                     free_marking-lines.out-code   = buf_parts.out-code
     3899                     free_marking-lines.part-code  = buf_parts.part-code
     3900                     free_marking-lines.prt-code   = buf_parts.prt-code
     3901                   .
     3902                 end .
     3903                 if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_trn-doc.doc-type <> 'спи':U and
     3904                    not (buf_marking.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U)
     3905                   then assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     3906                 if buf_trn-doc.ext-doc-type = 'es':U
     3907                 then do :
     3908                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB .
     3909                 end .
     3910                 for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     3911                   assign buf_marking-chk.sts = 0 .
     3912                 end .
     3913               end .
     3914               delete buf_marking-lines .
     3915             end.
     3916             if v-goods-twounit = true
     3917             then do:
     3918               assign
     3919                 buf_parts.cli-qnty = buf_parts.cli-qnty + v-unrv-sign * archive_parts.cli-qnty
     3920               .
     3921             end.
     3922             else do:
     3923               if buf_parts.cli-base-rate <> 0
     3924               then do:
     3925                 assign
     3926                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     3927                 .
     3928               end.
     3929               else do:
     3930                 assign
     3931                   buf_parts.cli-qnty = 0
     3932                 .
     3933               end.
     3934             end.
     3935             if  buf_parts.qnty      = 0
     3936             and buf_parts.fact-qnty = 0
     3937             then do:
     3938               if v-goods-twounit = true
     3939               then do:
     3940                 if buf_parts.cli-qnty <> 0
     3941                 then do:
     3942                   message
     3943                     vss-workfile vss-revision vss-description skip
     3944                     vss-include-info4 skip
     3945                     "Ошибка при удалении партии" skip
     3946                     "Документ" p-doc-code skip
     3947                     "Объект" p-obj-type p-obj-code skip
     3948                     "Артикул" p-artic p-prod-type p-prod-code skip
     3949                     "Партия" buf_parts.in-code buf_parts.part-code skip
     3950                     "Резерв" buf_parts.out-code skip
     3951                     "qnty" buf_parts.qnty skip
     3952                     "fact-qnty" buf_parts.fact-qnty skip
     3953                     "cli-qnty" buf_parts.cli-qnty skip
     3954                     view-as alert-box error .
     3955                   undo, return error .
     3956                 end.
     3957               end.
     3958               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
     3959                                                           and del_marking-lines.obj-type = buf_parts.obj-type
     3960                                                           and del_marking-lines.obj-code = buf_parts.obj-code
     3961                                                           and del_marking-lines.in-code = buf_parts.in-code
     3962                                                           and del_marking-lines.out-code = buf_parts.out-code
     3963                                                           and del_marking-lines.part-code = buf_parts.part-code
     3964                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
     3965                 delete del_marking-lines .
     3966               end.
     3967               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     3968                                           ,input (buffer buf_parts:handle)
     3969                                           ,output part-key-rec).
     3970               for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     3971                                        and ub.gen-attr.p-key =  part-key-rec
     3972               :
     3973                 find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     3974                 find current buf1_gen-attr exclusive-lock.
     3975                 delete buf1_gen-attr .
     3976               end.
     3977               delete buf_parts .
     3978             end.
     3979           end.
     3980         end.
     3981       end.
     3982     end.
     3983   end procedure.
     3984   procedure partcopy-rsrv-parts :
     3985     define input  parameter p-doc-code-rowid as rowid no-undo .
     3986     define input  parameter p-parts-rowid    as rowid no-undo .
     3987     define input  parameter p-rsrv-direction as logical   no-undo .
     3988     define input  parameter p-goods-twounit  as logical   no-undo .
     3989     define input  parameter p-is-hold        as logical   no-undo .
     3990     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
     3991     define buffer buf_trn-doc for ub.trn-doc .
     3992     define buffer archive_parts for ub.parts .
     3993     define buffer buf_parts   for ub.parts .
     3994     define buffer orig_marking-lines for ub.marking-lines .
     3995     define buffer buf_marking-lines for ub.marking-lines .
     3996     define buffer buf_marking   for ub.marking .
     3997     define buffer buf_goods for ub.goods .
     3998     define variable v-rsrv-code as character no-undo .
     3999     do
     4000     on error undo, return error return-value
     4001     :
     4002       find first buf_trn-doc no-lock
     4003         where rowid(buf_trn-doc) = p-doc-code-rowid
     4004         no-error .
     4005       if not available buf_trn-doc
     4006       then do:
     4007         message
     4008           vss-workfile vss-revision vss-description skip
     4009           vss-include-info4 skip
     4010           "Ошибка задания входных параметров" skip
     4011           "Не найден документ" skip
     4012           "Документ" string(p-doc-code-rowid) skip
     4013           "Партия" string(p-parts-rowid) skip
     4014           error-status :get-message(1) skip
     4015           return-value skip
     4016           view-as alert-box error .
     4017         undo, return error .
     4018       end.
     4019       find first archive_parts
     4020         where rowid(archive_parts) = p-parts-rowid
     4021         no-error .
     4022       if not available archive_parts
     4023       then do:
     4024         message
     4025           vss-workfile vss-revision vss-description skip
     4026           vss-include-info4 skip
     4027           "Ошибка задания входных параметров" skip
     4028           "Не найдена партия" skip
     4029           "Документ" string(p-doc-code-rowid) skip
     4030           "Партия" string(p-parts-rowid) skip
     4031           error-status :get-message(1) skip
     4032           return-value skip
     4033           view-as alert-box error .
     4034         undo, return error .
     4035       end.
     4036       if  archive_parts.out-code <> archive_parts.in-code
     4037       and archive_parts.qnty <> 0
     4038       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
     4039       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
     4040       then do:
     4041         assign
     4042           v-rsrv-code =
     4043           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     4044         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
     4045         then 'free-zone':U
     4046         else 'out-zone':U )
     4047         .
     4048         run partcopy in this-procedure
     4049           (input  true
     4050           ,input  v-rsrv-code
     4051           ,buffer archive_parts
     4052           ,buffer buf_parts
     4053           ,input  "news"
     4054           ) no-error .
     4055         if error-status :error
     4056         then do:
     4057           message
     4058             vss-workfile vss-revision vss-description skip
     4059             vss-include-info4 skip
     4060             "Ошибка при создании партии" skip
     4061             "Документ" buf_trn-doc.doc-code skip
     4062             "Объект" archive_parts.obj-type archive_parts.obj-code skip
     4063             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
     4064             "Партия" archive_parts.in-code archive_parts.part-code skip
     4065             "Количество" archive_parts.qnty skip
     4066             "Резерв" v-rsrv-code skip
     4067             error-status :get-message(1) skip
     4068             return-value skip
     4069             view-as alert-box error .
     4070           undo, return error .
     4071         end.
     4072         assign
     4073           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
     4074                                                     * (if p-rsrv-direction = true
     4075                                                       then 1
     4076                                                       else -1
     4077                                                       )
     4078           buf_parts.fact-qnty = buf_parts.qnty
     4079         .
     4080         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
     4081                                        and buf_goods.prod-type = archive_parts.prod-type
     4082                                        and buf_goods.prod-code = archive_parts.prod-code
     4083                                        .
     4084         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     4085                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
     4086                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
     4087                                               and orig_marking-lines.in-code    = archive_parts.in-code
     4088                                               and orig_marking-lines.out-code   = archive_parts.out-code
     4089                                               and orig_marking-lines.part-code  = archive_parts.part-code
     4090                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
     4091                                               :
     4092           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     4093                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
     4094                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
     4095                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
     4096                                                   and buf_marking-lines.in-code    = buf_parts.in-code
     4097                                                   and buf_marking-lines.out-code   = buf_parts.out-code
     4098                                                   and buf_marking-lines.part-code  = buf_parts.part-code
     4099                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
     4100                                                   no-error .
     4101           if available buf_marking-lines
     4102           then do :
     4103             find current buf_marking-lines exclusive-lock .
     4104             delete buf_marking-lines .
     4105             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4106               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     4107             end .
     4108           end .
     4109           else do :
     4110             create buf_marking-lines .
     4111             assign
     4112               buf_marking-lines.mark       = orig_marking-lines.mark
     4113               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     4114               buf_marking-lines.gds-code   = buf_goods.gds-code
     4115               buf_marking-lines.obj-type   = buf_parts.obj-type
     4116               buf_marking-lines.obj-code   = buf_parts.obj-code
     4117               buf_marking-lines.in-code    = buf_parts.in-code
     4118               buf_marking-lines.out-code   = buf_parts.out-code
     4119               buf_marking-lines.part-code  = buf_parts.part-code
     4120               buf_marking-lines.prt-code   = buf_parts.prt-code
     4121             .
     4122             if buf_parts.out-code <> buf_parts.in-code
     4123             and buf_parts.out-code <> 'free-zone':U
     4124             and buf_parts.out-code <> 'out-zone':U
     4125             then do :
     4126               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     4127               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     4128             end .
     4129             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     4130               assign
     4131                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
     4132                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
     4133               .
     4134             end .
     4135           end .
     4136           release buf_marking-lines no-error .
     4137         end.
     4138         if p-goods-twounit = true
     4139         then do:
     4140           assign
     4141             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
     4142                                                     * (if p-rsrv-direction = true
     4143                                                       then 1
     4144                                                       else -1
     4145                                                       )
     4146           .
     4147         end.
     4148         if  buf_parts.qnty      = 0
     4149         and buf_parts.fact-qnty = 0
     4150         then do:
     4151           if p-goods-twounit = true
     4152           then do:
     4153             if buf_parts.cli-qnty <> 0
     4154             then do:
     4155               message
     4156                 vss-workfile vss-revision vss-description skip
     4157                 vss-include-info4 skip
     4158                 "Ошибка при удалении партии" skip
     4159                 "Документ" buf_trn-doc.doc-code skip
     4160                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
     4161                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     4162                 "Партия" buf_parts.in-code buf_parts.part-code skip
     4163                 "Резерв" buf_parts.out-code skip
     4164                 "qnty" buf_parts.qnty skip
     4165                 "fact-qnty" buf_parts.fact-qnty skip
     4166                 "cli-qnty" buf_parts.cli-qnty skip
     4167                 view-as alert-box error .
     4168               undo, return error .
     4169             end.
     4170           end.
     4171           delete buf_parts .
     4172         end.
     4173       end.
     4174     end.
     4175   end procedure.
     4176   procedure partcopy-update-doc-line-tot-fact :
     4177     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     4178     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     4179     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     4180     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     4181     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
     4182       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     4183     define buffer buf_doc-line for ub.doc-line .
     4184     do
     4185     on error undo, return error return-value
     4186     :
     4187       find first buf_doc-line exclusive-lock
     4188         where buf_doc-line.doc-code  = p-doc-code
     4189           and buf_doc-line.artic     = p-artic
     4190           and buf_doc-line.prod-type = p-prod-type
     4191           and buf_doc-line.prod-code = p-prod-code
     4192         no-error .
     4193       if error-status :error
     4194       then do:
     4195         message
     4196           vss-workfile vss-revision vss-description skip
     4197           vss-include-info4 skip
     4198           "Ошибка задания входных параметров" skip
     4199           "Не найдена строка документа" skip
     4200           "Документ" p-doc-code skip
     4201           "Артикул" p-artic p-prod-type p-prod-code skip
     4202           error-status :get-message(1) skip
     4203           return-value skip
     4204           view-as alert-box error .
     4205         undo, return error .
     4206       end.
     4207       run partrqst in this-procedure
     4208         (input buf_doc-line.doc-code
     4209         ,input buf_doc-line.obj-type
     4210         ,input buf_doc-line.obj-code
     4211         ,input buf_doc-line.artic
     4212         ,input buf_doc-line.prod-type
     4213         ,input buf_doc-line.prod-code
     4214               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     4215         ) no-error .
     4216       if error-status :error
     4217       then do:
     4218         message
     4219           vss-workfile vss-revision vss-description skip
     4220           vss-include-info4 skip
     4221           "Ошибка при сборе информации по партиям" skip
     4222           "Документ" p-doc-code skip
     4223           "Артикул" p-artic p-prod-type p-prod-code skip
     4224           view-as alert-box error .
     4225         undo, return error .
     4226       end.
     4227       if v-total-parts-fact-qnty <> 0
     4228       then do:
     4229         assign
     4230           buf_doc-line.price-base      = v-total-parts-price-base
     4231                                        / v-total-parts-fact-qnty
     4232           buf_doc-line.price-rubl      = v-total-parts-price-rubl
     4233                                        / v-total-parts-fact-qnty
     4234           buf_doc-line.transport-base  = v-total-parts-transport-base
     4235                                        / v-total-parts-fact-qnty
     4236           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
     4237                                        / v-total-parts-fact-qnty
     4238           buf_doc-line.other-base      = v-total-parts-other-base
     4239                                        / v-total-parts-fact-qnty
     4240           buf_doc-line.other-rubl      = v-total-parts-other-rubl
     4241                                        / v-total-parts-fact-qnty
     4242         .
     4243       end.
     4244       else do:
     4245       end.
     4246     end.
     4247   end procedure.
     4248   procedure partcopy-change-purch-code :
     4249     define input parameter  p-in-code          like ub.parts.in-code no-undo .
     4250     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
     4251     define parameter buffer buf_orig_parts     for ub.parts .
     4252     define parameter buffer buf1_parts         for ub.parts .
     4253     define parameter buffer buf2_parts         for ub.parts .
     4254     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
     4255     define variable var-out-code  like ub.parts.out-code no-undo .
     4256     define variable var-part-code like ub.parts.part-code no-undo .
     4257     define buffer buf_goods        for ub.goods .
     4258     define buffer buf_parts-root   for ub.parts-root.
     4259     define buffer buf_trn-doc      for ub.trn-doc.
     4260     define buffer buf-orig_trn-doc for ub.trn-doc.
     4261     define buffer buf_units        for ub.units .
     4262     do
     4263     on error undo, return error return-value
     4264     :
     4265       if buf_orig_parts.out-code = p-in-code
     4266       then do:
     4267         message
     4268           vss-workfile vss-revision vss-description skip
     4269           vss-include-info4 skip
     4270           "Ошибка задания входных параметров процедуры partcopy" skip
     4271           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
     4272           "p-in-code" p-in-code skip
     4273           view-as alert-box error .
     4274         undo, return error .
     4275       end.
     4276       find first buf_trn-doc no-lock
     4277         where buf_trn-doc.doc-code = p-in-code
     4278         .
     4279       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
     4280       find first buf_goods no-lock
     4281         where buf_goods.artic = buf_orig_parts.artic
     4282           and buf_goods.prod-type = buf_orig_parts.prod-type
     4283           and buf_goods.prod-code = buf_orig_parts.prod-code
     4284         .
     4285       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
     4286       find first buf1_parts exclusive-lock
     4287         where buf1_parts.obj-type  = buf_orig_parts.obj-type
     4288           and buf1_parts.obj-code  = buf_orig_parts.obj-code
     4289           and buf1_parts.artic     = buf_orig_parts.artic
     4290           and buf1_parts.prod-type = buf_orig_parts.prod-type
     4291           and buf1_parts.prod-code = buf_orig_parts.prod-code
     4292           and buf1_parts.in-code   = buf_orig_parts.in-code
     4293           and buf1_parts.out-code  = p-in-code
     4294           and buf1_parts.part-code = buf_orig_parts.part-code
     4295         no-error.
     4296       if not available buf1_parts
     4297       then do:
     4298         create buf1_parts .
     4299         buffer-copy buf_orig_parts to buf1_parts
     4300         assign
     4301           buf1_parts.in-code    = buf_orig_parts.in-code
     4302           buf1_parts.out-code   = p-in-code
     4303           buf1_parts.status_    = no
     4304           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     4305           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
     4306           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
     4307           buf1_parts.purch-code = buf_orig_parts.purch-code
     4308           buf1_parts.rsrv-free  = ?
     4309           buf1_parts.status_    = yes
     4310         .
     4311         validate buf1_parts .
     4312       end.
     4313       if  lookup('сер':U, buf_units.type) > 0
     4314       then do:
     4315          var-part-code = buf_orig_parts.part-code.
     4316       end.
     4317       else do:
     4318           run holdprts-get-part-code in this-procedure
     4319             (input  p-in-code
     4320             ,output var-part-code
     4321             ) no-error .
     4322           if error-status :error
     4323           then dO:
     4324             undo, return error return-value.
     4325           end.
     4326       end.
     4327       find first buf2_parts exclusive-lock
     4328         where buf2_parts.obj-type  = buf_orig_parts.obj-type
     4329           and buf2_parts.obj-code  = buf_orig_parts.obj-code
     4330           and buf2_parts.artic     = buf_orig_parts.artic
     4331           and buf2_parts.prod-type = buf_orig_parts.prod-type
     4332           and buf2_parts.prod-code = buf_orig_parts.prod-code
     4333           and buf2_parts.in-code   = p-in-code
     4334           and buf2_parts.out-code  = p-in-code
     4335           and buf2_parts.part-code = var-part-code
     4336         no-error.
     4337       if not available buf2_parts
     4338       then do:
     4339         create buf2_parts .
     4340         buffer-copy buf_orig_parts to buf2_parts
     4341         assign
     4342           buf2_parts.in-code   = p-in-code
     4343           buf2_parts.out-code  = p-in-code
     4344           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     4345           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
     4346           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
     4347           buf2_parts.purch-code = p-dest-purch-code
     4348           buf2_parts.part-code  = var-part-code
     4349           buf2_parts.rsrv-free  = ?
     4350           buf2_parts.status_    = yes
     4351         .
     4352         validate buf2_parts .
     4353       end.
     4354       assign
     4355         buf_orig_parts.in-code    = p-in-code
     4356         buf_orig_parts.part-code  = buf2_parts.part-code
     4357         buf_orig_parts.purch-code = buf2_parts.purch-code
     4358       .
     4359       find first buf_parts-root
     4360         where buf_parts-root.doc-code       = p-in-code
     4361           and buf_parts-root.in-code        = p-in-code
     4362           and buf_parts-root.gds-code       = buf_goods.gds-code
     4363           and buf_parts-root.part-code      = buf2_parts.part-code
     4364           and buf_parts-root.orig-in-code   = buf1_parts.in-code
     4365           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
     4366           and buf_parts-root.orig-part-code = buf1_parts.part-code
     4367         no-error .
     4368       if not available buf_parts-root
     4369       then do:
     4370         create buf_parts-root.
     4371         assign
     4372         buf_parts-root.doc-code       = p-in-code
     4373         buf_parts-root.in-code        = p-in-code
     4374         buf_parts-root.gds-code       = buf_goods.gds-code
     4375         buf_parts-root.part-code      = buf2_parts.part-code
     4376         buf_parts-root.orig-in-code   = buf1_parts.in-code
     4377         buf_parts-root.orig-gds-code  = buf_goods.gds-code
     4378         buf_parts-root.orig-part-code = buf1_parts.part-code
     4379         .
     4380       end.
     4381     end.
     4382   end procedure.
     4383   procedure addChildMarkingLines:
     4384     define input parameter iMark as character no-undo.
     4385     define input parameter iSts  as integer   no-undo.
     4386     define parameter buffer buf_marking-lines  for ub.marking-lines.
     4387     define parameter buffer buf_parts          for ub.parts.
     4388     define parameter buffer orig_marking-lines for ub.marking-lines.
     4389     define parameter buffer buf_orig_parts     for ub.parts.
     4390     define parameter buffer buf_goods          for ub.goods.
     4391     define buffer buf_marking-childs        for ub.marking.
     4392     define buffer buf_marking-lines-childs  for ub.marking-lines.
     4393     define buffer buf_marking-chk           for ub.marking-chk.
     4394     define buffer buf_chk-doc               for ub.chk-doc.
     4395     define buffer orig_marking-lines-childs for ub.marking-lines.
     4396     for each buf_marking-childs exclusive-lock where
     4397              buf_marking-childs.mark-parent = iMark :
     4398         find first buf_marking-lines-childs no-lock where
     4399                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
     4400                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     4401                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     4402                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     4403                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     4404                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     4405                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     4406                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     4407         no-error .
     4408         if not available buf_marking-lines-childs then
     4409         do:
     4410           create buf_marking-lines-childs .
     4411           assign
     4412             buf_marking-lines-childs.mark       = buf_marking-childs.mark
     4413             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
     4414             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
     4415             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
     4416             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
     4417             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
     4418             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
     4419             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
     4420             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
     4421             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
     4422           .
     4423           validate buf_marking-childs.
     4424         end .
     4425         buf_marking-childs.sts = iSts .
     4426         for each buf_marking-chk exclusive-lock where
     4427                  buf_marking-chk.mark begins buf_marking-childs.mark
     4428         :
     4429           for first buf_chk-doc no-lock where
     4430                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
     4431                 and buf_chk-doc.out-code = buf_parts.out-code
     4432           :
     4433             buf_marking-chk.sts = 0 .
     4434             validate buf_marking-chk.
     4435           end .
     4436         end .
     4437         if available orig_marking-lines
     4438         then do :
     4439           find first orig_marking-lines-childs exclusive-lock where
     4440                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
     4441                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
     4442                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
     4443                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
     4444                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
     4445                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
     4446                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
     4447                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
     4448           no-error .
     4449           if available orig_marking-lines-childs then
     4450             delete orig_marking-lines-childs .
     4451         end.
     4452         run addChildMarkingLines in this-procedure (
     4453           buf_marking-childs.mark,
     4454           iSts,
     4455           buffer buf_marking-lines,
     4456           buffer buf_parts,
     4457           buffer orig_marking-lines,
     4458           buffer buf_orig_parts,
     4459           buffer buf_goods
     4460         ).
     4461     end .
     4462   end.
     4463   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4464   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
     4465     field prt-code         like ub.gds-dtl.prt-code
     4466     field rsrv-qnty        like ub.gds-dtl.fact-qnty
     4467     field rsrv-out-qnty    like ub.gds-dtl.fact-qnty
     4468     index xpk is primary unique prt-code
     4469   .
     4470   define temp-table temp-trndocrs-pl-gds-rsrv no-undo
     4471     field pl-code          like ub.pl-gds.pl-code
     4472     field rsrv-qnty        like ub.pl-gds.free-qnty
     4473     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
     4474     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
     4475     field before-free-qnty like ub.pl-gds.fact-qnty
     4476     field before-out-qnty  like ub.pl-gds.fact-qnty
     4477     field after-free-qnty  like ub.pl-gds.fact-qnty
     4478     field after-out-qnty   like ub.pl-gds.fact-qnty
     4479     field fact-qnty        like ub.pl-gds.fact-qnty
     4480     field cli-qnty         like ub.pl-gds.cli-qnty
     4481     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
     4482     index xpk is primary unique pl-code
     4483   .
     4484   procedure trndocrs-gds-dtl-clear :
     4485     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     4486     do
     4487     on error undo, return error return-value
     4488     :
     4489       for each buf_temp-trndocrs-gds-dtl-rsrv
     4490       on error undo, return error return-value
     4491       :
     4492         delete buf_temp-trndocrs-gds-dtl-rsrv .
     4493       end.
     4494     end.
     4495   end procedure.
     4496   procedure trndocrs-pl-gds-clear :
     4497     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     4498     do
     4499     on error undo, return error return-value
     4500     :
     4501       for each buf_temp-trndocrs-pl-gds-rsrv
     4502       on error undo, return error return-value
     4503       :
     4504         delete buf_temp-trndocrs-pl-gds-rsrv .
     4505       end.
     4506     end.
     4507   end procedure.
     4508   procedure trndocrs-clear :
     4509     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     4510     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     4511     do
     4512     on error undo, return error return-value
     4513     :
     4514       for each buf_temp-trndocrs-gds-dtl-rsrv
     4515       on error undo, return error return-value
     4516       :
     4517         delete buf_temp-trndocrs-gds-dtl-rsrv .
     4518       end.
     4519       for each buf_temp-trndocrs-pl-gds-rsrv
     4520       on error undo, return error return-value
     4521       :
     4522         delete buf_temp-trndocrs-pl-gds-rsrv .
     4523       end.
     4524     end.
     4525   end procedure.
     4526   procedure trndocrs-pl-gds-accum :
     4527     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
     4528     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
     4529     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
     4530     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
     4531     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
     4532     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     4533     do
     4534     on error undo, return error return-value
     4535     :
     4536       find first buf_temp-trndocrs-pl-gds-rsrv
     4537         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
     4538         no-error .
     4539       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
     4540         create buf_temp-trndocrs-pl-gds-rsrv .
     4541         assign
     4542           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
     4543         .
     4544       end.
     4545       assign
     4546         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
     4547         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
     4548         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
     4549         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
     4550       .
     4551     end.
     4552   end procedure.
     4553   procedure trndocrs-gds-dtl-accum :
     4554     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
     4555     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
     4556     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
     4557     do
     4558     on error undo, return error return-value
     4559     :
     4560       find first buf_temp-trndocrs-gds-dtl-rsrv
     4561         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
     4562         no-error .
     4563       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
     4564         create buf_temp-trndocrs-gds-dtl-rsrv .
     4565         assign
     4566           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
     4567         .
     4568       end.
     4569       assign
     4570         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     4571                                                + p-rsrv-qnty
     4572       .
     4573     end.
     4574   end procedure.
     4575   procedure trndocrs-pl-gds-request :
     4576     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
     4577     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
     4578     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
     4579     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
     4580     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
     4581     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
     4582     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
     4583     define input parameter p-field-accum            as character no-undo .
     4584     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
     4585     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
     4586     do
     4587     on error undo, return error return-value
     4588     :
     4589       if lookup(p-field-accum, "before,after":u ) = 0 then do:
     4590         message
     4591           vss-workfile vss-revision vss-description skip
     4592           vss-include-info15 skip
     4593           "Ошибка задания входных параметров параметров" skip
     4594           "Неизвестное значение параметра" skip
     4595           "p-field-accum" p-field-accum skip
     4596           view-as alert-box error .
     4597         undo, return error return-value .
     4598       end.
     4599       case p-field-accum :
     4600         when "before":u then do:
     4601           for each buf_temp-trndocrs-pl-gds-rsrv
     4602           on error undo, return error return-value
     4603           :
     4604             assign
     4605               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
     4606               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
     4607             .
     4608           end.
     4609         end.
     4610         when "after":u then do:
     4611           for each buf_temp-trndocrs-pl-gds-rsrv
     4612           on error undo, return error return-value
     4613           :
     4614             assign
     4615               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
     4616               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
     4617             .
     4618           end.
     4619         end.
     4620         otherwise do:
     4621           message
     4622             vss-workfile vss-revision vss-description skip
     4623             vss-include-info15 skip
     4624             "Ошибка задания входных параметров параметров" skip
     4625             "Неизвестное значение параметра" skip
     4626             "p-field-accum" p-field-accum skip
     4627             view-as alert-box error .
     4628           undo, return error return-value .
     4629         end.
     4630       end.
     4631       define buffer buf_parts for ub.parts.
     4632       for each buf_parts no-lock
     4633         where buf_parts.out-code  = p-doc-code
     4634           and buf_parts.obj-type  = p-obj-type
     4635           and buf_parts.obj-code  = p-obj-code
     4636           and buf_parts.artic     = p-artic
     4637           and buf_parts.prod-type = p-prod-type
     4638           and buf_parts.prod-code = p-prod-code
     4639       on error undo, return error return-value
     4640       :
     4641         find first buf_temp-trndocrs-pl-gds-rsrv
     4642           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
     4643           no-error .
     4644         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
     4645           create buf_temp-trndocrs-pl-gds-rsrv .
     4646           assign
     4647             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
     4648           .
     4649         end.
     4650         if can-do('при,рас,спи':U, p-doc-type)
     4651         or (p-doc-type = 'инв':U
     4652             and buf_parts.fact-qnty < 0)
     4653         then do:
     4654           case p-field-accum :
     4655             when "before":u then do:
     4656               assign
     4657                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     4658                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     4659                   + abs(buf_parts.fact-qnty)
     4660               .
     4661             end.
     4662             when "after":u then do:
     4663               assign
     4664                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     4665                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     4666                   + abs(buf_parts.fact-qnty)
     4667               .
     4668             end.
     4669             otherwise do:
     4670               message
     4671                 vss-workfile vss-revision vss-description skip
     4672                 vss-include-info15 skip
     4673                 "Ошибка задания входных параметров параметров" skip
     4674                 "Неизвестное значение параметра" skip
     4675                 "p-field-accum" p-field-accum skip
     4676                 view-as alert-box error .
     4677               undo, return error return-value .
     4678             end.
     4679           end.
     4680         end.
     4681         else do:
     4682           case p-field-accum :
     4683             when "before":u then do:
     4684               assign
     4685                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     4686                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     4687                   + abs(buf_parts.fact-qnty)
     4688               .
     4689             end.
     4690             when "after":u then do:
     4691               assign
     4692                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     4693                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     4694                   + abs(buf_parts.fact-qnty)
     4695               .
     4696             end.
     4697             otherwise do:
     4698               message
     4699                 vss-workfile vss-revision vss-description skip
     4700                 vss-include-info15 skip
     4701                 "Ошибка задания входных параметров параметров" skip
     4702                 "Неизвестное значение параметра" skip
     4703                 "p-field-accum" p-field-accum skip
     4704                 view-as alert-box error .
     4705               undo, return error return-value .
     4706             end.
     4707           end.
     4708         end.
     4709       end.
     4710     end.
     4711   end procedure.
     4712   procedure trndocrs-pl-gds-calc-rsrv :
     4713     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
     4714     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
     4715     do
     4716     on error undo, return error return-value
     4717     :
     4718       for each buf_temp-trndocrs-pl-gds-rsrv
     4719       on error undo, return error return-value
     4720       :
     4721         assign
     4722           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     4723             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     4724             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     4725           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
     4726             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     4727             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     4728         .
     4729       end.
     4730     end.
     4731   end procedure.
     4732   procedure trndocrs-need-rsrv :
     4733     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
     4734     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
     4735     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
     4736     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
     4737     define output parameter p-need-rsrv    as logical   no-undo .
     4738     define buffer buf_goods   for ub.goods .
     4739     do
     4740     on error undo, return error return-value
     4741     :
     4742       find first buf_goods no-lock
     4743         where buf_goods.artic     = p-artic
     4744           and buf_goods.prod-type = p-prod-type
     4745           and buf_goods.prod-code = p-prod-code
     4746         .
     4747       if buf_goods.gds-type = 'т':U
     4748       and ( p-doc-type = 'рас':U
     4749             or p-doc-type = 'спи':U
     4750           )
     4751       then do:
     4752         assign
     4753           p-need-rsrv = true
     4754         .
     4755       end.
     4756       else do:
     4757         assign
     4758           p-need-rsrv = false
     4759         .
     4760       end.
     4761     end.
     4762   end procedure.
     4763   procedure trndocrs-need-create-doc-pl :
     4764     define input  parameter p-extended-doc-type  as character no-undo .
     4765     define input  parameter p-news               as logical   no-undo .
     4766     define input  parameter p-sale-auto          as logical   no-undo .
     4767     define output parameter p-need-create-doc-pl as logical   no-undo .
     4768     do
     4769     on error undo, return error return-value
     4770     :
     4771       if  not p-news
     4772       and p-extended-doc-type <> 'ie':U
     4773       and p-extended-doc-type <> 'es':U
     4774       and p-extended-doc-type <> 'rs':U
     4775       and not p-sale-auto
     4776       then do:
     4777         assign
     4778           p-need-create-doc-pl = true
     4779         .
     4780       end.
     4781       else do:
     4782         assign
     4783           p-need-create-doc-pl = false
     4784         .
     4785       end.
     4786     end.
     4787   end procedure.
     4788   procedure trndocrs-validate :
     4789     define input parameter p-place-rsrv as logical no-undo .
     4790     define input parameter p-chg-qnty   as decimal no-undo .
     4791     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     4792     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     4793     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
     4794     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
     4795     assign
     4796       v-total-gds-dtl-rsrv-qnty = 0
     4797       v-total-pl-gds-rsrv-qnty  = 0
     4798     .
     4799     do
     4800     on error undo, return error return-value
     4801     :
     4802       for each buf_temp-trndocrs-gds-dtl-rsrv
     4803       on error undo, return error return-value
     4804       :
     4805         assign
     4806           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
     4807                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     4808         .
     4809       end.
     4810       for each buf_temp-trndocrs-pl-gds-rsrv
     4811       on error undo, return error return-value
     4812       :
     4813         assign
     4814           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
     4815                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     4816         .
     4817       end.
     4818       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     4819         message
     4820           vss-workfile vss-revision vss-description skip
     4821           vss-include-info15 skip
     4822           "Ошибка при резервировании свободных количеств" skip
     4823           "Запрошено резервирование:" skip
     4824           "По товару" p-chg-qnty skip
     4825           "По признакам" v-total-gds-dtl-rsrv-qnty skip
     4826           "По складским местам" v-total-pl-gds-rsrv-qnty skip
     4827           view-as alert-box error .
     4828         undo, return error return-value .
     4829       end.
     4830       if p-place-rsrv then do:
     4831         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     4832           message
     4833             vss-workfile vss-revision vss-description skip
     4834             vss-include-info15 skip
     4835             "Ошибка при резервировании свободных количеств" skip
     4836             "Запрошено резервирование:" skip
     4837             "По товару" p-chg-qnty skip
     4838             "По признакам" v-total-gds-dtl-rsrv-qnty skip
     4839             "По складским местам" v-total-pl-gds-rsrv-qnty skip
     4840             view-as alert-box error .
     4841           undo, return error return-value .
     4842         end.
     4843       end.
     4844     end.
     4845   end procedure.
     4846   procedure trndocrs :
     4847     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
     4848     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
     4849     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
     4850     define input parameter p-artic      like ub.doc-line.artic     no-undo .
     4851     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
     4852     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
     4853     define input parameter p-chg-qnty   as decimal no-undo .
     4854     define buffer buf_db         for ub.db .
     4855     define buffer buf_gds-obj    for ub.gds-obj .
     4856     define buffer buf_prt-obj    for ub.prt-obj .
     4857     define buffer buf_gds-prt    for ub.gds-prt .
     4858     define buffer buf_goods      for ub.goods .
     4859     define buffer buf_pl-gds     for ub.pl-gds .
     4860     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     4861     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     4862     define variable v-node-code   like ub.gds-prt.node-code no-undo .
     4863     define variable v-curr-db-num like ub.db.db-num         no-undo .
     4864     define variable v-cmd         as   character            no-undo .
     4865     do
     4866     on error undo, return error return-value
     4867     :
     4868   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4869   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4870     (input  p-obj-type
     4871     ,input  p-obj-code
     4872     ,input  p-artic
     4873     ,input  p-prod-type
     4874     ,input  p-prod-code
     4875     ,buffer buf_gds-obj
     4876     ) no-error .
     4877       if error-status :error then do:
     4878         message
     4879           vss-workfile vss-revision vss-description skip
     4880           vss-include-info15 skip
     4881           "Ошибка при поиске товара на объекте" skip
     4882           "p-obj-type"  p-obj-type  skip
     4883           "p-obj-code"  p-obj-code  skip
     4884           "p-artic"     p-artic     skip
     4885           "p-prod-type" p-prod-type skip
     4886           "p-prod-code" p-prod-code skip
     4887           error-status :get-message(1) skip
     4888           return-value skip
     4889           view-as alert-box error .
     4890         undo, return error return-value .
     4891       end.
     4892       find current buf_gds-obj exclusive-lock .
     4893       run trndocrs-validate in this-procedure
     4894         (input buf_gds-obj.place-rsrv
     4895         ,input p-chg-qnty
     4896         ) no-error .
     4897       if error-status :error then do:
     4898         message
     4899           vss-workfile vss-revision vss-description skip
     4900           vss-include-info15 skip
     4901           "Противоречивые данные для резервирования" skip
     4902           error-status :get-message(1) skip
     4903           return-value skip
     4904           view-as alert-box error .
     4905         undo, return error return-value .
     4906       end.
     4907       assign
     4908         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
     4909         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
     4910       .
     4911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     4912     (input ?
     4913     ,input this-procedure:handle
     4914     ,input ?
     4915     ,input  'rest-update':U
     4916     ,input ?
     4917     ,input  buffer buf_gds-obj:handle
     4918     ,input 'fact-qnty,free-qnty'
     4919     ,input ''
     4920     ) no-error .
     4921   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4922   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4923     (output v-curr-db-num
     4924     )  .
     4925       find first buf_db no-lock
     4926         where buf_db.db-num = v-curr-db-num
     4927         .
     4928       if buf_db.db-num <> 0
     4929         and buf_db.on-line-rest = true
     4930       then do:
     4931         assign
     4932           v-cmd = "command":U + chr(1)
     4933                   + "create":U + chr(1)
     4934                   + "on-line-rest":U + chr(1)
     4935                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
     4936                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
     4937                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
     4938                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
     4939                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
     4940                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
     4941         .
     4942         run nws/cr-route.p
     4943           ( input 'send-cmd':U
     4944             ,input v-cmd
     4945             ,input ?
     4946             ,input "0":U
     4947           ).
     4948       end.
     4949       if buf_gds-obj.place-rsrv = true then do:
     4950         for each buf_temp-trndocrs-pl-gds-rsrv
     4951         on error undo, return error return-value
     4952         :
     4953           find first buf_goods no-lock
     4954             where buf_goods.artic     = p-artic
     4955               and buf_goods.prod-type = p-prod-type
     4956               and buf_goods.prod-code = p-prod-code
     4957             no-error .
     4958           if not available buf_goods then do:
     4959             message
     4960               vss-workfile vss-revision vss-description skip
     4961               vss-include-info15 skip
     4962               "Не найдена товар" skip
     4963               "Артикул" p-artic p-prod-type p-prod-code skip
     4964               view-as alert-box error .
     4965             undo, return error return-value .
     4966           end.
     4967           find first buf_pl-gds exclusive-lock
     4968             where buf_pl-gds.obj-type = p-obj-type
     4969               and buf_pl-gds.obj-code = p-obj-code
     4970               and buf_pl-gds.gds-code = buf_goods.gds-code
     4971               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
     4972             no-error .
     4973           if not available buf_pl-gds then do:
     4974             message
     4975               vss-workfile vss-revision vss-description skip
     4976               vss-include-info15 skip
     4977               "Не найдена привязка товара к складскому месту" skip
     4978               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
     4979               view-as alert-box error .
     4980             undo, return error return-value .
     4981           end.
     4982           assign
     4983             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     4984             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
     4985           .
     4986           if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
     4987             and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
     4988           then do:
     4989             assign
     4990               buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
     4991             .
     4992           end.
     4993         end.
     4994       end.
     4995       for each buf_temp-trndocrs-gds-dtl-rsrv
     4996       on error undo, return error return-value
     4997       :
     4998   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     4999     (input  buf_temp-trndocrs-gds-dtl-rsrv.prt-code
     5000     ,output v-node-code
     5001     ) no-error .
     5002         if error-status :error then do:
     5003           message
     5004             vss-workfile vss-revision vss-description skip
     5005             vss-include-info15 skip
     5006             "Ошибка при определении первого терминального признака" skip
     5007             "prt-code" buf_temp-trndocrs-gds-dtl-rsrv.prt-code skip
     5008             view-as alert-box error .
     5009           undo, return error return-value .
     5010         end.
     5011         find first buf_gds-prt no-lock
     5012           where buf_gds-prt.node-code = v-node-code
     5013           .
     5014         do while available buf_gds-prt
     5015         on error undo, return error return-value
     5016         :
     5017   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5018   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
     5019     (input  p-obj-type
     5020     ,input  p-obj-code
     5021     ,input  p-artic
     5022     ,input  p-prod-type
     5023     ,input  p-prod-code
     5024     ,input  buf_gds-prt.node-code
     5025     ,buffer buf_prt-obj
     5026     )  .
     5027           find current buf_prt-obj exclusive-lock .
     5028           assign
     5029             buf_prt-obj.free-qnty = buf_prt-obj.free-qnty - buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     5030           .
     5031           assign
     5032             v-node-code = buf_gds-prt.upper-code
     5033           .
     5034           find first buf_gds-prt no-lock
     5035             where buf_gds-prt.node-code = v-node-code
     5036             no-error .
     5037         end.
     5038       end.
     5039     end.
     5040   end procedure.
     5041   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile: rsrvindl.i $ $Revision: f29df1d5f130, 3104, rls $".
     5042   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5043   define new global shared variable g#trdcalib as handle no-undo.
     5044   function stsMarkWhenDeleteGoods returns integer
     5045       (input iDocCode as character,
     5046        input iMark as character):
     5047     define variable vValue as character no-undo.
     5048     define variable vType as character no-undo.
     5049     define buffer buf_trn-doc for ub.trn-doc.
     5050     define buffer buf_c-marking for ub.c-marking.
     5051     if iDocCode <> ? then
     5052     do:
     5053         find first buf_trn-doc no-lock where
     5054                    buf_trn-doc.doc-code = iDocCode no-error.
     5055         if avail buf_trn-doc then
     5056         do:
     5057   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     5058                           input 'is-return':U ,
     5059                          output vValue ,
     5060                          output vType ) no-error .
     5061            if buf_trn-doc.ext-doc-type = 'we':U or
     5062               buf_trn-doc.ext-doc-type = 'ev':U or
     5063               vValue = "yes" then
     5064            do:
     5065              find last buf_c-marking no-lock where
     5066                        buf_c-marking.mark = iMark
     5067                   use-index pi-2 no-error.
     5068              if avail buf_c-marking and
     5069                      (buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB or
     5070                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB or
     5071                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB or
     5072                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:Moved:KeyIntDB or
     5073                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB) then
     5074                return buf_c-marking.sts .
     5075            end.
     5076         end.
     5077     end.
     5078     return objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     5079   end function.
     5080   procedure rsrvindl :
     5081     define input  parameter p-trn-doc-recid  as recid     no-undo .
     5082     define input  parameter p-doc-line-recid as recid     no-undo .
     5083     define input  parameter p-reserv-pl-code as logical   no-undo .
     5084     define variable v-sign as decimal no-undo .
     5085     define variable v-gds-code as integer no-undo .
     5086     define buffer buf_doc-parts for ub.parts .
     5087     define buffer buf_parts     for ub.parts .
     5088     define buffer buf_trn-doc   for ub.trn-doc .
     5089     define buffer buf_doc-line  for ub.doc-line .
     5090     define buffer buf_doc-pl    for ub.doc-pl .
     5091     define buffer buf_goods     for ub.goods .
     5092     define buffer orig_marking-lines for ub.marking-lines .
     5093     define buffer buf_marking-lines for ub.marking-lines .
     5094     define buffer buf_marking   for ub.marking .
     5095     do
     5096     on error undo, return error return-value
     5097     :
     5098       find first buf_trn-doc no-lock
     5099         where recid(buf_trn-doc) = p-trn-doc-recid
     5100         no-error .
     5101       if not available buf_trn-doc then do:
     5102         message
