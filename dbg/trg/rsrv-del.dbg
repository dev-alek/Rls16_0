     5154             view-as alert-box error .
     5155           undo, return error .
     5156         end.
     5157         if buf_doc-parts.in-code <> buf_doc-parts.out-code then do:
     5158           if p-reserv-pl-code  then do:
     5159             run trndocrs-pl-gds-accum in this-procedure
     5160               (input buf_doc-parts.pl-code
     5161               ,input (- buf_doc-parts.qnty)
     5162               ,input 0.0
     5163               ,input 0.0
     5164               ,input 0.0
     5165               ) no-error .
     5166             if error-status :error then do:
     5167               message
     5168                 vss-workfile vss-revision vss-description skip
     5169                 "Ошибка при изменении зарезервированных количеств trndocrs-pl-gds-accum" skip
     5170                 "Документ"  buf_doc-line.doc-code skip
     5171                 "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     5172                 error-status :get-message(1) skip
     5173                 return-value skip
     5174                 view-as alert-box error .
     5175               undo, return error .
     5176             end.
     5177           end.
     5178           assign
     5179             v-rsrv-code =
     5180           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     5181         or (buf_trn-doc.doc-type = 'инв':U and buf_doc-parts.fact-qnty < 0)
     5182         then 'free-zone':U
     5183         else 'out-zone':U )
     5184           .
     5185           run partcopy in this-procedure
     5186             (input  true
