     3314             ,output v-value-decimal
     3315             ,output v-value-integer
     3316             ,output v-izlcstpr
     3317             ,output v-type
     3318             ,INPUT-OUTPUT table-handle v-tth
     3319             ) no-error .
     3320             delete object v-tth no-error.
     3321           if error-status:error then do:
     3322             v-izlcstpr = false .
