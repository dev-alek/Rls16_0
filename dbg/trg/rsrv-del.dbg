     3379           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     3380             or archive_parts.supp-code <>
     3381           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     3382             then do:
     3383               assign
     3384                 v-old-return = true
     3385               .
     3386             end.
     3387           end.
     3388           define variable v-is-hold as logical   no-undo .
     3389   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     3391     (input  buf_trn-doc.doc-code
     3392     ,output v-is-hold
     3393     ) no-error .
     3394           if error-status :error
     3395           then do:
     3396             message
     3397               vss-workfile vss-revision vss-description skip
     3398               vss-include-info4
     3399               "Ошибка при определении типа документа hold-doc.i" skip
     3400               "Документ" p-doc-code skip
     3401               "Объект" p-obj-type p-obj-code skip
     3402               "Артикул" p-artic p-prod-type p-prod-code skip
     3403               error-status :get-message(1) skip
     3404               return-value skip
     3405               view-as alert-box error .
     3406             undo, return error .
     3407           end.
     3408   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partcond in g#library
     3409     (input  buf_trn-doc.ext-doc-type
     3410     ,input  v-is-hold
     3411     ,input  archive_parts.fact-qnty
     3412     ,input  v-create-part
     3413     ,input  v-old-return
     3414     ,output v-rsrv-code
     3415     ,output v-unrv-code
     3416     ,output v-need-rsrv
     3417     ,output v-need-unrv
     3418     ,output v-rsrv-sign
     3419     ,output v-unrv-sign
     3420     ) no-error .
     3421           if error-status :error
     3422           then do:
     3423             message
