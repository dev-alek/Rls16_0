     3348       define variable v-gds-code as integer   no-undo .
     3349   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3350   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     3351     (input  p-artic
     3352     ,input  p-prod-type
     3353     ,input  p-prod-code
     3354     ,output v-gds-code
     3355     ) no-error .
     3356       for each archive_parts
     3357         where archive_parts.obj-type  = p-obj-type
     3358           and archive_parts.obj-code  = p-obj-code
     3359           and archive_parts.artic     = p-artic
     3360           and archive_parts.prod-type = p-prod-type
     3361           and archive_parts.prod-code = p-prod-code
     3362           and archive_parts.out-code  = p-doc-code
     3363       on error undo, return error return-value
     3364       :
