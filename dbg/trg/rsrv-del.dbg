     5141           and buf_doc-parts.artic     = buf_doc-line.artic
     5142           and buf_doc-parts.prod-type = buf_doc-line.prod-type
     5143           and buf_doc-parts.prod-code = buf_doc-line.prod-code
     5144       on error undo, return error
