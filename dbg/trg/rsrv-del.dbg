     3280     define variable part-key-rec_arhive   as character no-undo .
     3281     define buffer buf1_gen-attr for ub.gen-attr .
     3282     do
     3283     on error undo, return error return-value
     3284     :
     3285       find first buf_trn-doc no-lock
     3286         where buf_trn-doc.doc-code = p-doc-code
     3287         no-error .
     3288       if not available buf_trn-doc
     3289       then do:
     3290         message
