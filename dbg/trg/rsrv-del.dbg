      918                       then do:
      919                           assign
      920                               p-out-string = p-out-string + " ":U
      921                           .
      922                       end.
      923                       when chr(5)
      924                       then do:
      925                           assign
      926                               p-out-string = p-out-string + " ":U
      927                           .
      928                       end.
      929                       when chr(6)
      930                       then do:
      931                           assign
      932                               p-out-string = p-out-string + " ":U
      933                           .
      934                       end.
      935                       when chr(7)
      936                       then do:
      937                           assign
      938                               p-out-string = p-out-string + " ":U
      939                           .
      940                       end.
      941                       when chr(8)
      942                       then do:
      943                           assign
      944                               p-out-string = p-out-string + " ":U
      945                           .
      946                       end.
      947                       when chr(9)
      948                       then do:
      949                           assign
      950                               p-out-string = p-out-string + " ":U
      951                           .
      952                       end.
      953                       when chr(29)
      954                       then do:
      955                           assign
      956                               p-out-string = p-out-string + " ":U
      957                           .
      958                       end.
      959                       when chr(10)
      960                       then do:
      961                           assign
      962                               p-out-string = p-out-string + " ":U
      963                           .
      964                       end.
      965                       when chr(13)
      966                       then do:
      967                           assign
      968                               p-out-string = p-out-string + " ":U
      969                           .
      970                       end.
      971                       otherwise do:
      972                           assign
      973                               p-out-string = p-out-string + v-current-char
      974                           .
      975                       end.
      976                   end case.
      977               end.
      978           end.
      979       end case.
      980   end.
      981   end .
      982   procedure xmlchar-decode :
      983   define input parameter p-in-string      as character        no-undo.
      984   define output parameter p-out-string    as character        no-undo.
      985       define variable v-position      as integer      no-undo.
      986       define variable v-last-position as integer      no-undo.
      987       define variable v-temp-integer  as integer      no-undo.
      988       define variable v-current-char  as character    no-undo.
      989       define variable v-next-char     as character    no-undo.
      990       define variable v-success       as logical      no-undo.
      991   do
      992   on error undo, return error
      993   :
      994       assign
      995           p-out-string = "":U
      996           v-position   = 0
      997       .
      998       replace-cycle:
      999       do while yes
     1000       on error undo, return error
     1001       :
     1002           assign
     1003               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1004           .
     1005           if v-last-position <= v-position
     1006           then do:
     1007               if v-position = 0
     1008               then do:
     1009                   assign
     1010                       p-out-string = p-in-string
     1011                   .
     1012               end.
     1013               else do:
     1014                   assign
     1015                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1016                   .
     1017               end.
     1018               leave replace-cycle.
     1019           end.
     1020           else do:
     1021               assign
     1022                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1023                   v-position      = v-last-position
     1024                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1025               .
     1026               if v-current-char = "#":U
     1027               then do:
     1028                   assign
     1029                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1030                   .
     1031                   if v-last-position > 0
     1032                   then do:
     1033                       run xmlchar-read-integer in this-procedure
     1034                        (
     1035                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1036                           , output v-temp-integer
     1037                           , output v-success
     1038                       ).
     1039                       if v-success = yes
     1040                       and v-temp-integer >= 1
     1041                       and v-temp-integer <= 255
     1042                       then do:
     1043                           assign
     1044                               p-out-string = p-out-string + chr( v-temp-integer )
     1045                               v-position   = v-last-position + 1
     1046                           .
     1047                       end.
     1048                       else do:
     1049                           assign
     1050                               p-out-string = p-out-string + "&":U
     1051                               v-position   = v-position   + 1
     1052                           .
     1053                       end.
     1054                   end.
     1055                   else do:
     1056                       assign
     1057                           p-out-string = p-out-string + "&":U
     1058                           v-position   = v-position   + 1
     1059                       .
     1060                   end.
     1061               end.
     1062               else do:
     1063                   case substring( p-in-string, v-position + 1, 3 )
     1064                   :
     1065                       when "lt;":U
     1066                       then do:
     1067                           assign
     1068                               p-out-string = p-out-string + "<":U
     1069                               v-position   = v-position   + 3
     1070                           .
     1071                       end.
     1072                       when "gt;":U
     1073                       then do:
     1074                           assign
     1075                               p-out-string = p-out-string + ">":U
     1076                               v-position   = v-position   + 3
     1077                           .
     1078                       end.
     1079                       otherwise do:
     1080                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1081                           then do:
     1082                               assign
     1083                                   p-out-string = p-out-string + "&":U
     1084                                   v-position   = v-position   + 4
     1085                               .
     1086                           end.
     1087                           else do:
     1088                               case substring( p-in-string, v-position + 1, 5 )
     1089                               :
     1090                                   when "quot;":U
     1091                                   then do:
     1092                                       assign
     1093                                           p-out-string = p-out-string + '"':U
     1094                                           v-position   = v-position   + 5
     1095                                       .
     1096                                   end.
     1097                                   when "apos;":U
     1098                                   then do:
     1099                                       assign
     1100                                           p-out-string = p-out-string + "'":U
     1101                                           v-position   = v-position   + 5
     1102                                       .
     1103                                   end.
     1104                                   otherwise do:
     1105                                       assign
     1106                                           p-out-string = p-out-string + "&":U
     1107                                       .
     1108                                   end.
     1109                               end case.
     1110                           end.
     1111                       end.
     1112                   end case.
     1113               end.
     1114           end.
     1115       end.
     1116   end.
     1117   end .
     1118   procedure xmlchar-read-integer :
     1119   define input parameter p-input-string      as character        no-undo.
     1120   define output parameter p-output-integer   as integer          no-undo.
     1121   define output parameter p-success       as logical          no-undo.
     1122   do
     1123   on error undo, return error
     1124   :
     1125       assign
     1126           p-output-integer = integer( p-input-string )
     1127       no-error.
     1128       if error-status :error
     1129       then do:
     1130           assign
     1131               p-success           = no
     1132               p-output-integer    = 0
     1133           .
     1134       end.
     1135       else do:
     1136           assign
     1137               p-success           = yes
     1138           .
     1139       end.
     1140   end.
     1141   end.
     1142   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1143   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1144   define new global shared variable g#attr-lib  as handle no-undo .
     1145   define variable v-attr-lib-variable as handle no-undo .
     1146   define variable mMRCCode  as logical    no-undo.
     1147   define variable mTypeMark as character  no-undo.
     1148   function IS-NeedMark returns logical
     1149   ( input ib-code as integer  ,
     1150     input ib-str as character ):
     1151      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1152      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1153                                    and buf_prod-bc-attr.b-str  eq ib-str
     1154                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1155        no-lock no-error.
     1156      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1157   end.
     1158   function repTegforDm return char
     1159   (iDM as char ):
     1160       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1161       define variable vteg as character no-undo.
     1162       define variable oDM as character no-undo.
     1163       define variable vi as integer no-undo.
     1164       oDM = iDm.
     1165       do vi = 1 to num-entries(vTeglist):
     1166          vTeg = entry(vi,vTeglist).
     1167          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1168       end.
     1169       return oDM.
     1170   end.
     1171   function repSpecSimbforDm return char
     1172   (iDM as char ):
     1173       define variable oDM as character no-undo.
     1174     run
     1175       xmlchar-decode(iDM, output oDM).
     1176     return repTegforDm (oDM).
     1177   end.
     1178   function CheckGtin return logical
     1179   (iGtin as char):
     1180      define variable bar_code as character no-undo.
     1181      define variable vGtin as logical no-undo init "yes".
     1182      if length(iGtin) eq 14
     1183      then do:
     1184         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1185         run str/chk-sum.p
     1186          (input-output bar_code ) no-error .
     1187         if iGtin ne  bar_code
     1188         then
     1189            vGtin = no.
     1190      end.
     1191      else
     1192         vGtin = no.
     1193      return vgtin.
     1194   end.
     1195   function repSpecSimbforXlm return char
     1196   (iDM as char ):
     1197       iDM = replace(iDM,chr(29),"").
     1198       return iDM.
     1199   end.
     1200   function getGtinByDM return char
     1201   (IDM as char):
     1202      define variable VTXT as char no-undo.
     1203      define variable vGtin as char no-undo.
     1204      vTXt = IdM.
     1205      vGtin = IDM.
     1206      if    length(vtxt) > 14
     1207      then do:
     1208         if   vtxt begins "(01)"
     1209                or vtxt begins "(02)"
     1210         then
     1211            vGtin = substring(vtxt,5,14).
     1212         else if   (vtxt begins "01"
     1213                or vtxt begins "02" )
     1214                and (   (    substring(iDm,17,2) eq "21"
     1215                         and length(vtxt) >= 21)
     1216                     or substring(iDm,17,2) eq "37"
     1217                     or substring(iDm,17,4) eq "(37)" )
     1218         then do:
     1219            vGtin = substring(vtxt,3,14).
     1220            if not checkGtin(vGtin)
     1221            then
     1222               vGtin = substring(vtxt,1,14).
     1223         end.
     1224         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1225             or length(vtxt) eq 14 + 7 + 4
     1226             or length(vtxt) eq 14 + 7
     1227         then
     1228            vGtin = substring(vtxt,1,14).
     1229      end.
     1230      if not checkGtin(vGtin)
     1231      then
     1232         vGtin = "".
     1233      return vgtin.
     1234   end.
     1235   function getGdsCodeByGtin return int
     1236   (iGtin as char):
     1237      define buffer prod-bc  for ub.prod-bc.
     1238      define buffer bar-code for ub.bar-code.
     1239      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1240      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1241      return if avail bar-code then bar-code.gds-code else ?.
     1242   end.
     1243   function getQntyCodeByGtin return decimal
     1244   (iGtin as char):
     1245      define buffer prod-bc  for ub.prod-bc.
     1246      define buffer bar-code for ub.bar-code.
     1247      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1248      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1249      return if avail bar-code then bar-code.cli-base-rate else ?.
     1250   end.
     1251   function getGdsCodeByDM return int
     1252   (iDm as char):
     1253      define variable vGtin as char no-undo.
     1254      define buffer prod-bc for ub.prod-bc.
     1255      vGtin  = getGtinByDM (IDM ).
     1256      return getGdsCodeByGtin (vGtin).
     1257   end.
     1258   function ChekTypeMarkByGds return logical
     1259   (iGds-code as integer ):
     1260      define buffer goods-attr for ub.goods-attr.
     1261      find first goods-attr where goods-attr.gds-code   = iGds-code
     1262                              and goods-attr.attr-code  = 'mark-type':U
     1263      no-lock no-error.
     1264      if available goods-attr
     1265      then do:
     1266         mTypeMark = goods-attr.attr-value.
     1267         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1268           .
     1269      end.
     1270      else
     1271         return no.
     1272   end.
     1273   function ChekTypeMarkByDm return logical
     1274   (iDM as char ):
     1275      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1276   end.
     1277   function ChekTypeMarkByGtin return logical
     1278   (iGtin as char ):
     1279      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1280   end.
     1281   function GetNextElement return character
     1282     (input iAllTeg        as logical
     1283     ,output oteg          as character
     1284     ,output otegval       as character
     1285     ,input-output pstr    as character
     1286      ):
     1287        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1288        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1289        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1290        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1291        define variable vTeg as character no-undo.
     1292        define variable vLength as integer no-undo.
     1293        define variable vi as integer no-undo.
     1294        define variable vj as integer no-undo.
     1295        define buffer code for ub.code.
     1296        find first code where Code.parent eq "MarkType"
     1297                          and Code.CodeValue   eq mTypeMark
     1298                          no-lock no-error.
     1299        if     available code
     1300           and Code.misc1 ne ""
     1301           and Code.misc1 ne ?
     1302        then do:
     1303           integer (Code.misc1) no-error.
     1304           if not error-status:error
     1305           then
     1306             entry (4,vlistleng) = Code.misc1.
     1307        end.
     1308        if iAllTeg
     1309        then
     1310           assign
     1311              vlistElem     = vlistElem    + vlistElemDop
     1312              vlistleng     = vlistleng    + vlistlengDop
     1313           .
     1314        else if mMRCCode
     1315        then
     1316           assign
     1317              vlistElem     = vlistElem    + ",(8005),8005"
     1318              vlistleng     = vlistleng    + ",000006,0006"
     1319           .
     1320       block-elem:
     1321       do vi = 1 to num-entries(vlistElem):
     1322          vTeg = entry(vi,vlistElem).
     1323          if pstr begins vTeg
     1324          then do:
     1325             if    vTeg eq "21"
     1326             then
     1327                vLength = index(pstr,chr(29)) - 2 no-error.
     1328             if vLength  <= 0
     1329             then
     1330                vLength = int(entry(vi,vlistleng)).
     1331             otegval = substring (pstr,length(vteg) + 1, vLength).
     1332             oteg = replace(replace(vteg,")",""),"(","").
     1333             vTeg = vteg + otegval.
     1334             otegval = replace(otegval,chr(29),"").
     1335             oteg = replace(replace(oteg,")",""),"(","").
     1336             pstr = substring (pstr,length(vTeg)+ 1).
     1337             vTeg = replace(vTeg,chr(29),"").
     1338             leave block-elem.
     1339          end.
     1340          else
     1341             vTeg = "".
     1342       end.
     1343       return vteg.
     1344   end.
     1345   function GetCodeIdent return character
     1346   (iDm as char):
     1347      define variable Velement   as character no-undo init "first".
     1348      define variable oCodeIdent as character no-undo.
     1349      define variable vteg as character no-undo.
     1350      define variable vtegval as character no-undo.
     1351      define variable vGtin as character no-undo.
     1352      define buffer marking for ub.marking.
     1353      for first marking no-lock where
     1354                marking.mark eq iDm
     1355            and marking.unit-ext = "LEVEL2"
     1356      :
     1357        return iDm.
     1358      end.
     1359      vGtin  = getGtinByDM (iDm ).
     1360      ChekTypeMarkByDm(idm).
     1361      if iDm begins 'tech_':U
     1362      then
     1363         oCodeIdent = iDm.
     1364      else if length(iDm) < 21
     1365      then do:
     1366         find first marking where marking.mark eq idm
     1367         no-lock no-error.
     1368         oCodeIdent = if available marking then marking.mark else  ?.
     1369      end.
     1370      else if     length(iDm) eq 29
     1371         and not iDm begins "01"
     1372         and not iDm begins "02"
     1373      then
     1374         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1375      else  if     length(iDm) >= 24
     1376               and (  iDm begins "01"
     1377                   or iDm begins "02")
     1378               and  substring(iDm,17,2) ne "21"
     1379      then do:
     1380         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1381                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1382         then
     1383            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1384         else
     1385            oCodeIdent = iDM.
     1386      end.
     1387      else  if     (   length(iDm) eq 25
     1388                    or length(iDm) eq 21)
     1389               and (not iDm begins "01"
     1390               and  not iDm begins "02")
     1391      then
     1392         oCodeIdent = substring(iDm,1,21).
     1393      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1394      then
     1395         oCodeIdent = substring(iDm,1,21).
     1396      else do while Velement ne "" and idm ne "":
     1397         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1398         oCodeIdent = oCodeIdent + Velement.
     1399      end.
     1400      return oCodeIdent.
     1401   end.
     1402   function GetTegCod return character
     1403   (icodeIdent as char, iTeg as char):
     1404      define variable Velement   as character no-undo init "first".
     1405      define variable oTeg as character no-undo init ?.
     1406      define variable vteg as character no-undo.
     1407      define variable vtegval as character no-undo.
     1408      if     ((length(icodeIdent) eq 21
     1409         and not icodeIdent begins "01"
     1410         and not icodeIdent begins "02")
     1411         or
     1412             ( length(icodeIdent) eq 25
     1413               and not icodeIdent begins "01"
     1414               and not icodeIdent begins "02"))
     1415      then do:
     1416         if iTeg eq "01" or iTeg eq "02"
     1417         then
     1418            oTeg = substring(icodeIdent,1,21).
     1419         else  if  iTeg eq "21"
     1420         then
     1421            oTeg = substring(icodeIdent,15,7).
     1422      end.
     1423      else do:
     1424         ChekTypeMarkByDm(icodeIdent).
     1425         block-teg:
     1426            do while Velement ne "" and icodeIdent ne "":
     1427            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1428            if    Velement begins iTeg
     1429               or Velement begins "(" + iTeg + ")"
     1430            then do:
     1431               oTeg = vtegval.
     1432               leave block-teg.
     1433            end.
     1434         end.
     1435      end.
     1436      return oTeg.
     1437   end.
     1438   function isOAD return logical
     1439   (icodeIdent as character):
     1440      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1441   end.
     1442   function isMark return logical
     1443   (icodeIdent as character):
     1444      define buffer buf_marking for ub.marking.
     1445      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1446             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1447   end.
     1448   function addBracketForCode return character
     1449   (icodeIdent as char):
     1450      define variable Velement   as character no-undo init "first".
     1451      define variable oTeg as character no-undo.
     1452      define variable vteg as character no-undo.
     1453      define variable vtegval as character no-undo.
     1454      define buffer marking for ub.marking.
     1455      find first marking no-lock where
     1456                 marking.mark begins icodeIdent no-error.
     1457      if    not ChekTypeMarkByDm(icodeIdent)
     1458         or length(icodeIdent) le 24
     1459         or (avail marking and marking.unit-ext = "LEVEL2")
     1460      then
     1461         oTeg = icodeIdent.
     1462      else do:
     1463         if (  icodeIdent begins "01"
     1464            or icodeIdent begins "02"
     1465            ) and CheckGtin(substring (icodeIdent,3,14))
     1466            and substring (icodeIdent,17,2) eq "21"
     1467         then do:
     1468            mMRCCode = yes.
     1469            ChekTypeMarkByDm(icodeIdent).
     1470            block-teg:
     1471            do while Velement ne "" and icodeIdent ne "":
     1472               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1473               if vteg ne ""
     1474               then
     1475                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1476            end.
     1477            mMRCCode = no.
     1478         end.
     1479         else do:
     1480            oTeg = icodeIdent.
     1481         end.
     1482      end.
     1483      return oTeg.
     1484   end.
     1485   function getlevelByCodId return int
     1486   (iCode as char):
     1487      define variable vLength as int no-undo.
     1488      define variable vLevel  as int no-undo.
     1489      if not ChekTypeMarkByDM (icode) then return ?.
     1490      vLength = length(iCode).
     1491      if    vLength eq 18
     1492         or vLength eq 20
     1493      then
     1494         Vlevel = 4.
     1495      else if vLength eq 21
     1496      then
     1497         Vlevel = 1.
     1498      else if vLength eq 25
     1499      then do:
     1500         if  iCode begins "01"
     1501         then
     1502            Vlevel = 3.
     1503         else
     1504            Vlevel = 1.
     1505      end.
     1506      else if     vLength >= 26
     1507              and vLength <= 46
     1508      then do:
     1509         if    substring(iCode,17,2) eq "11"
     1510            or substring(iCode,17,2) eq "13"
     1511            or (    substring(iCode,17,2) eq "21"
     1512                and vLength >= 33
     1513                and substring(iCode,26,4) ne "8005")
     1514         then
     1515            Vlevel = 4.
     1516         else if    vLength eq 31
     1517                 or vLength eq 38
     1518                 or vLength eq 39
     1519                 or vLength eq 45
     1520         then
     1521            Vlevel = 1.
     1522         else if    vLength eq 35
     1523                 or vLength eq 43
     1524         then
     1525            Vlevel = 3.
     1526         else
     1527            Vlevel = ?.
     1528      end.
     1529      else
     1530         Vlevel = ?.
     1531      return Vlevel.
     1532   end.
     1533   function getLevelMotpBycodid return character
     1534   (iDm as char):
     1535      define variable vLevel as integer no-undo.
     1536      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1537      vLevel = getlevelByCodId(iDm).
     1538      if    vLevel eq ?
     1539         or vLevel < 1
     1540         or vLevel > 6
     1541      then
     1542         return ?.
     1543      else
     1544         return entry(vlevel,vList).
     1545   end.
     1546   function getLevelUTDByLevelMotp return character
     1547   (iUnit as char):
     1548      define variable vLevel as integer no-undo.
     1549      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1550      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1551      vLevel = lookup(iUnit,vListMOTP).
     1552      if    vLevel eq ?
     1553         or vLevel < 1
     1554         or vLevel > 4
     1555      then
     1556         return ?.
     1557      else
     1558         return entry(vlevel,vListutd).
     1559   end.
     1560   function getLevelMotpByDM return character
     1561   (iDm as char):
     1562      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1563   end.
     1564   function getLevelUTDByCodId return character
     1565   (iDm as char):
     1566      define variable vLevel as integer no-undo.
     1567      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1568      vLevel = getlevelByCodId(iDm).
     1569      if    vLevel eq ?
     1570         or vLevel < 1
     1571         or vLevel > 4
     1572      then
     1573         return ?.
     1574      else
     1575         return entry(vlevel,vList).
     1576   end.
     1577   function getLevelUTDByDM return character
     1578   (iDm as char):
     1579      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1580   end.
     1581   define variable mNotMarkQnty as logical no-undo.
     1582   function getQntyUTDByCodId return decimal
     1583   (iDM as char):
     1584      define variable vLevel as integer no-undo.
     1585      define variable vList as character no-undo init "1,5,10,500".
     1586      define variable vGtin as character no-undo.
     1587      define variable vqnty as decimal no-undo init ?.
     1588      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1589      if vqnty eq ?
     1590      then do:
     1591         if not mNotMarkQnty
     1592         then do:
     1593            define buffer marking for ub.marking.
     1594            define variable vCodident as character no-undo.
     1595            vCodident = GetCodeIdent(idm).
     1596            find first marking where marking.mark begins vCodident no-lock no-error.
     1597            if     available marking
     1598               and marking.box-qnty ne ?
     1599            then
     1600               return marking.box-qnty.
     1601         end.
     1602         vGtin = getGtinByDm(iDM).
     1603         if ChekTypeMarkByGtin (vGtin)
     1604         then do:
     1605            vLevel = getlevelByCodId(iDM).
     1606            if     vLevel >= 1
     1607               and vLevel <= 4
     1608            then
     1609               vqnty = int(entry(vlevel,vList)).
     1610         end.
     1611         else
     1612            vqnty = getQntyCodeByGtin(vgtin).
     1613      end.
     1614      return vqnty.
     1615   end.
     1616   function getQntyUTDByDM return decimal
     1617   (iDm as char):
     1618      define variable vDM as character no-undo.
     1619      if     length (iDm) ne 25
     1620         and length (iDm) ne 29
     1621         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1622      then
     1623         vDM = substring (iDm,1,length (iDm) - 6 ).
     1624      else
     1625         vDM = substring (iDm,1,length (iDm) - 4 ).
     1626      return getQntyUTDByCodId(vDM).
     1627   end.
     1628   function getMRC4 return decimal
     1629   (iMRC as char):
     1630      define variable oMrc     as decimal no-undo init ?.
     1631      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1632      define variable vi       as integer no-undo.
     1633      define variable vfound   as integer no-undo.
     1634      define variable vposStart   as integer no-undo.
     1635      do:
     1636      OMRc = 0.
     1637      do vi = 1 to 4:
     1638         define variable vsimb as character no-undo.
     1639         vsimb = substring(iMRC,vi,1).
     1640         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1641         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1642         if vfound > 0
     1643         then
     1644            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1645         end.
     1646         OMRc = OMRc / 100.
     1647      end.
     1648      return OMRc.
     1649   end.
     1650   function getMRCByDM return decimal
     1651   (iDm as char):
     1652      define variable vMRC     as character no-undo.
     1653      define variable oMrc     as decimal no-undo init ?.
     1654      define variable Velement as character no-undo init "empty".
     1655      define variable vteg as character no-undo.
     1656      define variable vtegval as character no-undo.
     1657      if    length(idm) eq 14 + 7 + 4 + 4
     1658         or length(idm) eq 14 + 7 + 4
     1659      then do:
     1660         vMRC = substring(idm,22,4).
     1661         omrc = getMRC4(vMRC).
     1662      end.
     1663      else do:
     1664          ChekTypeMarkByDm(iDm).
     1665          block-mrc:
     1666          do while Velement ne "" and idm ne "":
     1667             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1668             if Velement begins "8005"
     1669             then do:
     1670                vMRC = substring(Velement,5,6).
     1671                leave block-mrc.
     1672             end.
     1673             else if Velement begins "(8005)"
     1674             then do:
     1675                vMRC = substring(Velement,7,6).
     1676                leave block-mrc.
     1677             end.
     1678          end.
     1679          if vMRC ne ""
     1680          then
     1681             OMRc = dec(vmrc) / 100 no-error.
     1682      end.
     1683      return OMRc.
     1684   end.
     1685   function MoveDate return Date
     1686   (idate as date,
     1687    iMonth as int64):
     1688      define variable vMonth   as int64 no-undo.
     1689      define variable vYear    as int64 no-undo.
     1690      define variable vDateNew as date  no-undo.
     1691       define variable vDay     as int64 no-undo.
     1692       vMonth = month(iDate) + iMonth.
     1693       vYear =  year(iDate).
     1694       if vMonth <= 0
     1695       then assign
     1696          vMonth = vMonth + 12
     1697           vYear  = vYear - 1
     1698       .
     1699       else if vMonth > 12
     1700       then assign
     1701          vMonth = vMonth - 12
     1702           vYear  = vYear + 1
     1703       .
     1704       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1705       do while error-status:error eq yes:
     1706          VDay = vDay + 1.
     1707          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1708       end.
     1709       if VDay > 0
     1710       then
     1711          vDateNew + 1.
     1712       return vDateNew.
     1713   end.
     1714   procedure checkEMRC:
     1715   define input  parameter iDm as character no-undo.
     1716   define output parameter vok as logical   no-undo init yes.
     1717      define variable v-value-emrc as character no-undo.
     1718      define variable v-type-emrc  as character no-undo.
     1719      define variable vDateIso     as character no-undo.
     1720      define variable vMRC         as decimal no-undo.
     1721      define variable vqnty        as decimal no-undo.
     1722      define variable vPrice       as decimal no-undo.
     1723      define variable vparent      as character no-undo.
     1724      define variable vgds-code    as integer no-undo.
     1725      define buffer code for ub.code.
     1726      vMRC = getMRCByDM(iDm).
     1727      if vMRC > 0
     1728      then do:
     1729         vgds-code = getGdsCodeByDM(iDm).
     1730         vqnty     = getQntyUTDByDM(iDm).
     1731               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1732            (
     1733             input   vgds-code
     1734            ,input   'emrc-type':U
     1735            ,output   v-value-emrc
     1736            ,output   v-type-emrc
     1737          ) no-error.
     1738          if     v-value-emrc ne ""
     1739             and v-value-emrc ne ?
     1740          then do:
     1741             vDateIso = iso-date(today).
     1742             vPrice = vMRC / vqnty.
     1743             vparent ="emc" + chr(4) + v-value-emrc.
     1744             find last code where Code.parent      eq vparent
     1745                              and Code.code        le vDateIso
     1746                              and code.status_  eq 0
     1747             no-lock no-error.
     1748             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1749             then
     1750                vOk = true .
     1751             else do:
     1752                 define variable vText      as character no-undo.
     1753                 define variable vDate      as date no-undo.
     1754                 define variable vDateLast  as character no-undo.
     1755                 define variable vDateFirst as character no-undo.
     1756                 define variable vDate3     as date no-undo.
     1757                 vdate = date(code.misc1).
     1758                 vDateLast = code.misc1.
     1759                 vDate3 = MoveDate(today, - 3 ).
     1760                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1761                                      string(vDate3  , "99/99/9999"),
     1762                                      string(vDate   , "99/99/9999")
     1763                                      ).
     1764                 vdateIso = iso-date(vdate3).
     1765                 find last code  where Code.parent      eq vparent
     1766                                   and Code.code        le vDateIso
     1767                                   and code.status_  eq 0 no-lock no-error.
     1768                 if available code
     1769                 then
     1770                    vDateIso = code.code.
     1771                 vDateFirst = vDateIso.
     1772                 vDateLast = iso-date(vdate).
     1773                 define variable vGood as logical no-undo.
     1774                 define variable vDateSale as date no-undo.
     1775                 define buffer bcode for code.
     1776                 for last code where Code.parent   eq vparent
     1777                                 and code.status_  eq 0
     1778                                 and code.code     < vDateLast
     1779                                 and code.code     >= vDateFirst
     1780                 no-lock:
     1781                    find first bcode where bCode.parent   eq vparent
     1782                                       and bcode.status_  eq 0
     1783                                       and bcode.code     > code.code no-lock no-error.
     1784                    if available bcode
     1785                    then do:
     1786                       if vPrice < dec(Code.CodeValue)
     1787                       then
     1788                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1789                                                     chr(10),
     1790                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1791                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1792                                                     ).
     1793                       else do:
     1794                          vGood = yes.
     1795                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1796                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1797                                                     chr(10),
     1798                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1799                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1800                                                     string(         vDateSale            ,"99/99/9999"),
     1801                                                     string(vDateSale - today)
     1802                                                     ).
     1803                       end.
     1804                    end.
     1805                 end.
     1806                 if vgood
     1807                 then do:
     1808                    define variable choice as integer no-undo .
     1809                    run gbl/d-askw.w (input "Уточнение"
     1810                           ,input  vText
     1811                           ,input "|"
     1812                           ,input "Принять|Вернуть"
     1813                           ,input "Принять данный товар|Вернуть товар постащику"
     1814                           ,input 1
     1815                           ,input 2
     1816                           ,output choice) no-error.
     1817                    vok = choice eq 1.
     1818                 end.
     1819                 else
     1820                    vok =false.
     1821             end.
     1822          end.
     1823      end.
     1824   end.
     1825   function addGs2Mark return character
     1826   (iMark as char):
     1827      define variable vDM   as character no-undo.
     1828      define variable vIdx  as integer   no-undo.
     1829      if index(iMark,chr(29),1) > 0
     1830      then return iMark.
     1831      if substring(iMark,26,4) = "8005" then
     1832      do:
     1833        vIdx = index(iMark,"93",26 + 4 + 5).
     1834        if vIdx > 1 then do:
     1835          vDM = substitute("&1&4&2&4&3",
     1836                           substring(iMark,1,25),
     1837                           substring(iMark,26,vIdx - 25 - 1),
     1838                           substring(iMark,vIdx),
     1839                           chr(29)) no-error.
     1840          vIdx = index(vDm,"240",vIdx + 4).
     1841          if vIdx > 0 then
     1842          do:
     1843            vDM = substitute("&1&3&2",
     1844                             substring(vDm,1,vIdx - 1),
     1845                             substring(vDm,vIdx),
     1846                             chr(29)) no-error.
     1847          end.
     1848        end.
     1849        else
     1850          vDM = substitute("&1&3&2",
     1851                           substring(iMark,1,25),
     1852                           substring(iMark,26),
     1853                           chr(29)) no-error.
     1854      end.
     1855      else if substring(iMark,32,2) = "91" then
     1856      do:
     1857        vIdx = index(iMark,"92",32).
     1858        if vIdx > 1 then
     1859          vDM = substitute("&1&4&2&4&3",
     1860                           substring(iMark,1,31),
     1861                           substring(iMark,32,vIdx - 31 - 1),
     1862                           substring(iMark,vIdx),
     1863                           chr(29)) no-error.
     1864        else
     1865          vDM = substitute("&1&3&2",
     1866                           substring(iMark,1,31),
     1867                           substring(iMark,32),
     1868                           chr(29)) no-error.
     1869      end.
     1870      else if substring(iMark,39,2) = "91" then
     1871      do:
     1872        vIdx = index(iMark,"92",38).
     1873        if vIdx > 1 then
     1874          vDM = substitute("&1&4&2&4&3",
     1875                           substring(iMark,1,38),
     1876                           substring(iMark,39,vIdx - 38 - 1),
     1877                           substring(iMark,vIdx),
     1878                           chr(29)) no-error.
     1879        else
     1880          vDM = substitute("&1&3&2",
     1881                           substring(iMark,1,38),
     1882                           substring(iMark,39),
     1883                           chr(29)) no-error.
     1884      end.
     1885      else if substring(iMark,25,2) = "93" then
     1886      do:
     1887        vIdx = index(iMark,"92",25).
     1888        if vIdx > 1 then
     1889          vDM = substitute("&1&4&2&4&3",
     1890                           substring(iMark,1,24),
     1891                           substring(iMark,25,vIdx - 24 - 1),
     1892                           substring(iMark,vIdx),
     1893                           chr(29)) no-error.
     1894        else
     1895          vIdx = index(iMark,"3103",25).
     1896          if vIdx > 0 then
     1897          vDM = substitute("&1&4&2&4&3",
     1898                           substring(iMark,1,24),
     1899                           substring(iMark,25,vIdx - 24 - 1),
     1900                           substring(iMark,vIdx),
     1901                           chr(29)) no-error.
     1902          else
     1903            vDM = substitute("&1&3&2",
     1904                             substring(iMark,1,24),
     1905                             substring(iMark,25),
     1906                             chr(29)) no-error.
     1907      end.
     1908      else if substring(iMark,32,2) = "93" then
     1909      do:
     1910        vDM = substitute("&1&3&2",
     1911              substring(iMark,1,31),
     1912              substring(iMark,32),
     1913              chr(29)) no-error.
     1914      end.
     1915      return if vDM <> "" then vDm else iMark.
     1916   end.
     1917   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1918   procedure partcopy :
     1919     define input parameter  p-free-output-copy as logical   no-undo .
     1920     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     1921     define parameter buffer buf_orig_parts     for ub.parts .
     1922     define parameter buffer buf_parts          for ub.parts .
     1923     define input parameter  p-mark             as character no-undo .
     1924     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     1925     define variable v-value-character as character no-undo .
     1926     define variable v-value-date      as date no-undo .
     1927     define variable v-value-decimal   as decimal no-undo .
     1928     define variable v-value-integer   as integer no-undo .
     1929     define variable v-izlcstpr        as logical no-undo .
     1930     define variable v-tth             as handle no-undo .
     1931     define variable v-type            as character no-undo .
     1932     define variable part-key-rec      as character no-undo .
     1933     define variable orig-part-key-rec as character no-undo .
     1934     define variable del-part-key-rec  as character no-undo .
     1935     define variable objMarks as class excisemarks  no-undo .
     1936     define variable v-parent-mark-sts as integer   no-undo .
     1937     define variable v-mark-sts-list   as character no-undo .
     1938     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     1939     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     1940     define buffer buf_gen-attr for ub.gen-attr .
     1941     define buffer buf1_gen-attr for ub.gen-attr .
     1942     define buffer buf_doc-line  for ub.doc-line .
     1943     define buffer buf_marking for ub.marking .
     1944     define buffer buf_marking-childs for ub.marking .
     1945     define buffer orig_marking-lines for ub.marking-lines .
     1946     define buffer orig_marking-lines-childs for ub.marking-lines .
     1947     define buffer buf_marking-lines for ub.marking-lines .
     1948     define buffer buf_marking-lines-childs for ub.marking-lines .
     1949     define buffer buf_marking-pack for ub.marking .
     1950     define buffer buf_marking-chk for ub.marking-chk .
     1951     define buffer buf_goods for ub.goods .
     1952     define buffer buf_trn-doc for ub.trn-doc .
     1953     define buffer pri_trn-doc for ub.trn-doc .
     1954     define buffer buf_chk-doc for ub.chk-doc .
     1955     do
     1956     on error undo, return error return-value
     1957     :
     1958       if p-free-output-copy = true
     1959       then do:
     1960         if  p-out-code <> 'free-zone':U
     1961         and p-out-code <> 'out-zone':U
     1962         then do:
     1963           message
     1964             vss-workfile vss-revision vss-description skip
     1965             vss-include-info4 skip
     1966             "Ошибка задания входных параметров процедуры partcopy" skip
     1967             "p-free-output-copy" p-free-output-copy skip
     1968             "p-out-code" p-out-code skip
     1969             view-as alert-box error .
     1970           undo, return error .
     1971         end.
     1972       end.
     1973       if buf_orig_parts.out-code <> p-out-code
     1974       then do:
     1975         find first buf_parts exclusive-lock
     1976           where buf_parts.obj-type  = buf_orig_parts.obj-type
     1977             and buf_parts.obj-code  = buf_orig_parts.obj-code
     1978             and buf_parts.artic     = buf_orig_parts.artic
     1979             and buf_parts.prod-type = buf_orig_parts.prod-type
     1980             and buf_parts.prod-code = buf_orig_parts.prod-code
     1981             and buf_parts.in-code   = buf_orig_parts.in-code
     1982             and buf_parts.out-code  = p-out-code
     1983             and buf_parts.part-code = buf_orig_parts.part-code
     1984           no-error.
     1985         if not available buf_parts
     1986         then do:
     1987           define variable v-rsrv-free as logical   no-undo .
     1988           if p-out-code = 'free-zone':U
     1989           or p-out-code = 'out-zone':U
     1990           then do:
     1991             assign
     1992               v-rsrv-free =
     1993          (if p-out-code = 'free-zone':U then yes else no)
     1994             .
     1995           end.
     1996           else do:
     1997             assign
     1998               v-rsrv-free = ?
     1999             .
     2000           end.
     2001           create buf_parts .
     2002           buffer-copy buf_orig_parts to buf_parts
     2003           assign
     2004             buf_parts.out-code  = p-out-code
     2005             buf_parts.status_   = no
     2006             buf_parts.rsrv-free = v-rsrv-free
     2007             buf_parts.qnty      = 0
     2008             buf_parts.fact-qnty = 0
     2009             buf_parts.real-qnty = 0
     2010             buf_parts.cli-qnty  = 0
     2011           .
     2012           validate buf_parts .
     2013         end.
     2014         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2015                                           ,input (buffer buf_orig_parts:handle)
     2016                                           ,output orig-part-key-rec).
     2017         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     2018                                           ,input (buffer buf_parts:handle)
     2019                                           ,output part-key-rec).
     2020         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     2021               and ub.gen-attr.p-key =  orig-part-key-rec:
     2022             if not valid-object (objMarks)
     2023               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     2024               if p-out-code = 'free-zone':U
     2025               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     2026                then
     2027               do:
     2028                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     2029                   if objMarks:StatusErr
     2030                       then
     2031                   do:
     2032                       message objMarks:ReturnMsg view-as alert-box error.
     2033                       delete object objMarks no-error.
     2034                       undo, return error.
     2035                   end.
     2036               end.
     2037             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     2038             do:
     2039                 if p-mark <> "" then do:
     2040                 if p-out-code = 'free-zone':U then do:
     2041                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     2042                 end.
     2043                 else do:
     2044                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     2045                 end.
     2046                 if objMarks:StatusErr
     2047                   then
     2048                 do:
     2049                   message objMarks:ReturnMsg view-as alert-box error.
     2050                   delete object objMarks no-error.
     2051                   undo, return error.
     2052                 end.
     2053               end.
     2054             end.
     2055             if p-out-code = 'out-zone':U then
     2056             do:
     2057                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     2058                 if objMarks:StatusErr
     2059                     then
     2060                 do:
     2061                     message objMarks:ReturnMsg view-as alert-box error.
     2062                     delete object objMarks no-error.
     2063                     undo, return error.
     2064                 end.
     2065             end.
     2066         end.
     2067         delete object objMarks no-error.
     2068         if p-mark = "news" then return .
     2069         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     2070         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     2071         if not available buf_trn-doc
     2072         then
     2073            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     2074         if (
     2075             p-out-code = 'free-zone':U
     2076             and buf_orig_parts.in-code = buf_orig_parts.out-code
     2077            )
     2078         or
     2079            (
     2080             p-out-code = 'free-zone':U
     2081             and available pri_trn-doc
     2082             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     2083            )
     2084         or
     2085            (
     2086             available buf_trn-doc
     2087             and p-out-code = buf_trn-doc.doc-code
     2088             and buf_trn-doc.ext-doc-type = 'vt':U
     2089            )
     2090         or
     2091            (
     2092             p-mark = ""
     2093             and available buf_trn-doc
     2094             and p-out-code = 'free-zone':U
     2095             and buf_trn-doc.ext-doc-type = 'vt':U
     2096            )
     2097         or
     2098            (
     2099             p-mark = ""
     2100             and available buf_trn-doc
     2101             and p-out-code = 'free-zone':U
     2102             and buf_trn-doc.ext-doc-type = 'rs':U
     2103            )
     2104         then do :
     2105           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     2106             and ub.goods.prod-type = buf_parts.prod-type
     2107             and ub.goods.prod-code = buf_parts.prod-code.
     2108           def buffer buf_orig_ml for ub.marking-lines.
     2109           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
     2110             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
     2111             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
     2112             and buf_orig_ml.in-code = buf_orig_parts.in-code
     2113             and buf_orig_ml.out-code = buf_orig_parts.out-code
     2114             and buf_orig_ml.part-code = buf_orig_parts.part-code
     2115             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
     2116             if available pri_trn-doc
     2117             and pri_trn-doc.ext-doc-type = 'iv':U
     2118             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     2119             then do :
     2120               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
     2121                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
     2122               end .
     2123               next .
     2124             end .
     2125             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
     2126                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
     2127                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
     2128                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
     2129                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
     2130                                                   and ub.marking-lines.out-code = p-out-code
     2131                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
     2132                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
     2133                                                   no-error .
     2134             if not available ub.marking-lines
     2135             then do :
     2136               create ub.marking-lines.
     2137               buffer-copy buf_orig_ml to ub.marking-lines
     2138               assign
     2139                 ub.marking-lines.out-code  = p-out-code
     2140                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
     2141               .
     2142               validate ub.marking-lines.
     2143             end .
     2144             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
     2145             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
     2146               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
     2147               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
     2148                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
     2149                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
     2150                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
     2151                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     2152               then do:
     2153                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2154                 validate buf_marking.
     2155               end.
     2156             end .
     2157           end .
     2158           end.
     2159         end .
     2160         define variable v-doc-type  as character no-undo .
     2161         define variable   v-status    as character no-undo .
     2162         define variable v-fact-qnty   as  decimal no-undo .
     2163         define variable ii    as integer no-undo .
     2164         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
     2165                                        and buf_goods.prod-type = buf_orig_parts.prod-type
     2166                                        and buf_goods.prod-code = buf_orig_parts.prod-code
     2167                                        .
     2168         if available pri_trn-doc
     2169         and pri_trn-doc.ext-doc-type = 'rs':U
     2170         then do :
     2171           if p-mark <> ""
     2172           then do :
     2173           end .
     2174           else do :
     2175           end .
     2176         end .
     2177         else do :
     2178           if buf_orig_parts.in-code <> buf_orig_parts.out-code
     2179           and p-mark <> ""
     2180           then do :
     2181             if p-out-code = 'free-zone':U
     2182             then do:
     2183                 if chg-qnty < 0
     2184                 then do :
     2185                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
     2186                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
     2187                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2188                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2189                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2190                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2191                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2192                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2193                                                           no-error .
     2194                   if available orig_marking-lines
     2195                   then do :
     2196                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     2197                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
     2198                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
     2199                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
     2200                                                            and buf_marking-lines.in-code    = buf_parts.in-code
     2201                                                            and buf_marking-lines.out-code   = buf_parts.out-code
     2202                                                            and buf_marking-lines.part-code  = buf_parts.part-code
     2203                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
     2204                                                            no-error .
     2205                     if not available buf_marking-lines
     2206                     then do :
     2207                       create buf_marking-lines .
     2208                       assign
     2209                         buf_marking-lines.mark       = p-mark
     2210                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2211                         buf_marking-lines.gds-code   = buf_goods.gds-code
     2212                         buf_marking-lines.obj-type   = buf_parts.obj-type
     2213                         buf_marking-lines.obj-code   = buf_parts.obj-code
     2214                         buf_marking-lines.in-code    = buf_parts.in-code
     2215                         buf_marking-lines.out-code   = buf_parts.out-code
     2216                         buf_marking-lines.part-code  = buf_parts.part-code
     2217                         buf_marking-lines.prt-code   = buf_parts.prt-code
     2218                       .
     2219                       validate buf_marking-lines.
     2220                     end .
     2221                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     2222                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2223                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     2224                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     2225                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
     2226                                                         :
     2227                           assign buf_marking-chk.sts = 0 .
     2228                           validate buf_marking-chk.
     2229                         end .
     2230                       end .
     2231                       if buf_marking.unit-ext <> "UNIT" or
     2232                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     2233                       then do :
     2234                         run addChildMarkingLines in this-procedure (
     2235                           buf_marking.mark,
     2236                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
     2237                           buffer buf_marking-lines,
     2238                           buffer buf_parts,
     2239                           buffer orig_marking-lines,
     2240                           buffer buf_orig_parts,
     2241                           buffer buf_goods
     2242                         ).
     2243                       end .
     2244                     end.
     2245                     find current orig_marking-lines exclusive-lock .
     2246                     delete orig_marking-lines .
     2247                   end .
     2248                 end .
     2249             end.
     2250             else do:
     2251               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
     2252                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
     2253                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2254                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2255                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2256                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2257                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2258                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2259                                                              no-error .
     2260                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
     2261                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
     2262                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
     2263                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
     2264                                                         and buf_marking-lines.in-code    = buf_parts.in-code
     2265                                                         and buf_marking-lines.out-code   = buf_parts.out-code
     2266                                                         and buf_marking-lines.part-code  = buf_parts.part-code
     2267                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
     2268                                                         no-error .
     2269                 if not available buf_marking-lines
     2270                 then do :
     2271                   create buf_marking-lines .
     2272                   assign
     2273                     buf_marking-lines.mark       = p-mark
     2274                     buf_marking-lines.doc-level  = 1
     2275                     buf_marking-lines.gds-code   = buf_goods.gds-code
     2276                     buf_marking-lines.obj-type   = buf_parts.obj-type
     2277                     buf_marking-lines.obj-code   = buf_parts.obj-code
     2278                     buf_marking-lines.in-code    = buf_parts.in-code
     2279                     buf_marking-lines.out-code   = buf_parts.out-code
     2280                     buf_marking-lines.part-code  = buf_parts.part-code
     2281                     buf_marking-lines.prt-code   = buf_parts.prt-code
     2282                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
     2283                   .
     2284                   validate buf_marking-lines.
     2285                 end .
     2286                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
     2287                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
     2288                   validate buf_marking.
     2289                   for first buf_marking-childs exclusive-lock where
     2290                             buf_marking-childs.mark = buf_marking.mark-parent:
     2291                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
     2292                     validate buf_marking-childs.
     2293                   end.
     2294                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
     2295                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
     2296                                                     and buf_chk-doc.out-code = buf_parts.out-code
     2297                                                     :
     2298                       if buf_marking-chk.sts <> 2 then
     2299                       do:
     2300                          assign buf_marking-chk.sts = 1 .
     2301                          validate buf_marking-chk.
     2302                       end.
     2303                     end .
     2304                   end .
     2305                   if buf_marking.unit-ext <> "UNIT" or
     2306                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
     2307                   then do :
     2308                     run addChildMarkingLines in this-procedure (
     2309                       buf_marking.mark,
     2310                       buf_marking.sts,
     2311                       buffer buf_marking-lines,
     2312                       buffer buf_parts,
     2313                       buffer orig_marking-lines,
     2314                       buffer buf_orig_parts,
     2315                       buffer buf_goods
     2316                     ).
     2317                   end .
     2318                 end.
     2319                 if available orig_marking-lines then
     2320                   delete orig_marking-lines .
     2321             end.
     2322           end.
     2323         end .
     2324         if p-out-code = 'out-zone':U
     2325         and trim(p-mark) = ""
     2326         then do :
     2327           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
     2328                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2329                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2330                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2331                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2332                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2333                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2334                                                 :
     2335             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
     2336                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
     2337                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
     2338                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
     2339                                                     and buf_marking-lines.out-code   = p-out-code
     2340                                                     no-error .
     2341             if available buf_marking-lines
     2342             then do :
     2343               find current buf_marking-lines exclusive-lock .
     2344               delete buf_marking-lines .
     2345               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
     2346                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
     2347                 then do :
     2348                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     2349                   validate buf_marking.
     2350                 end.
     2351               end .
     2352             end .
     2353             else do :
     2354               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
     2355               create buf_marking-lines .
     2356               assign
     2357                 buf_marking-lines.mark       = orig_marking-lines.mark
     2358                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2359                 buf_marking-lines.gds-code   = buf_goods.gds-code
     2360                 buf_marking-lines.obj-type   = buf_parts.obj-type
     2361                 buf_marking-lines.obj-code   = buf_parts.obj-code
     2362                 buf_marking-lines.in-code    = buf_parts.in-code
     2363                 buf_marking-lines.out-code   = buf_parts.out-code
     2364                 buf_marking-lines.part-code  = buf_parts.part-code
     2365                 buf_marking-lines.prt-code   = buf_parts.prt-code
     2366               .
     2367               validate buf_marking-lines.
     2368               if buf_parts.out-code <> buf_parts.in-code
     2369               and buf_parts.out-code <> 'free-zone':U
     2370               and buf_parts.out-code <> 'out-zone':U
     2371               then do :
     2372                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
     2373                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
     2374               end .
     2375               end.
     2376             end .
     2377             release buf_marking-lines no-error .
     2378           end.
     2379         end .
     2380         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
     2381         then do:
     2382           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
     2383                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
     2384                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
     2385                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
     2386                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
     2387                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
     2388                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
     2389                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
     2390                                                   .
     2391             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
     2392                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
     2393                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
     2394                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
     2395                                                    and buf_marking-lines.in-code    = buf_parts.in-code
     2396                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
     2397                                                    and buf_marking-lines.part-code  = buf_parts.part-code
     2398                                                    no-error .
     2399             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
     2400               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     2401                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
     2402               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
     2403                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
     2404               validate ub.marking.
     2405             end.
     2406             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
     2407             if available (buf_marking-lines)
     2408             then do:
     2409               assign
     2410                 buf_marking-lines.mark       = p-mark
     2411                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
     2412                 buf_marking-lines.gds-code   = buf_goods.gds-code
     2413                 buf_marking-lines.obj-type   = buf_parts.obj-type
     2414                 buf_marking-lines.obj-code   = buf_parts.obj-code
     2415                 buf_marking-lines.in-code    = buf_parts.in-code
     2416                 buf_marking-lines.out-code   = buf_parts.out-code
     2417                 buf_marking-lines.part-code  = buf_parts.part-code
     2418               .
     2419               validate buf_marking-lines.
     2420             end.
     2421           end.
     2422         end.
     2423       end.
     2424       else do:
     2425         find first buf_parts exclusive-lock
     2426           where recid(buf_parts) = recid(buf_orig_parts)
     2427           .
     2428       end.
     2429       if p-out-code = 'free-zone':U
     2430       or p-out-code = 'out-zone':U
     2431       then do:
     2432         if buf_parts.rsrv-free <>
     2433          (if buf_parts.out-code = 'free-zone':U then yes else no)
     2434         then do:
     2435           message
     2436             vss-workfile vss-revision vss-description skip
     2437             vss-include-info4 skip
     2438             "Ошибка типа резерва партии" skip
     2439             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
     2440             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     2441             "Партия" buf_parts.in-code buf_parts.part-code skip
     2442             "Резерв" buf_parts.out-code skip
     2443             "Статус" buf_parts.status_ skip
     2444             "Тип резерва" buf_parts.rsrv-free skip
     2445             view-as alert-box error .
     2446           undo, return error .
     2447         end.
     2448       end.
     2449     end.
     2450   end procedure.
     2451   procedure partcopy-to-childs-mark :
     2452     define parameter buffer buf_ml for ub.marking-lines .
     2453     define parameter buffer buf_orig-ml for ub.marking-lines .
     2454     define input parameter p-out-code as character no-undo .
     2455     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
     2456     define buffer buf_ml-childs for ub.marking-lines .
     2457     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
     2458       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     2459         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
     2460       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
     2461         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
     2462       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
     2463         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
     2464         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
     2465         and buf_ml-childs.in-code   = buf_orig-ml.in-code
     2466         and buf_ml-childs.out-code  = buf_orig-ml.out-code
     2467         and buf_ml-childs.part-code = buf_orig-ml.part-code
     2468         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
     2469         :
     2470         assign
     2471           buf_ml-childs.out-code  = p-out-code
     2472         .
     2473         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
     2474       end.
     2475     end.
     2476   end.
     2477   procedure partcopy-update-parts :
     2478     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
     2479     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
     2480     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
     2481     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
     2482     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
     2483     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
     2484     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
     2485     define buffer buf_trn-doc for ub.trn-doc .
     2486     define buffer archive_parts for ub.parts .
     2487     define buffer buf_parts   for ub.parts .
     2488     define buffer orig_marking-lines for ub.marking-lines .
     2489     define buffer buf_marking for ub.marking .
     2490     define buffer buf_goods for ub.goods .
     2491     define variable v-rsrv-code     as character no-undo .
     2492     define variable v-goods-twounit as logical   no-undo .
     2493     define variable v-value-character as character no-undo .
     2494     define variable v-value-date      as date no-undo .
     2495     define variable v-value-decimal   as decimal no-undo .
     2496     define variable v-value-integer   as integer no-undo .
     2497     define variable v-izlcstpr        as logical no-undo .
     2498     define variable v-tth             as handle no-undo .
     2499     define variable v-type            as character no-undo .
     2500     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     2501     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     2502     do
     2503     on error undo, return error return-value
     2504     :
     2505       find first buf_trn-doc no-lock
     2506         where buf_trn-doc.doc-code = p-doc-code
     2507         no-error .
     2508       if not available buf_trn-doc
     2509       then do:
     2510         message
     2511           vss-workfile vss-revision vss-description skip
     2512           vss-include-info4 skip
     2513           "Ошибка задания входных параметров" skip
     2514           "Не найден документ" skip
