     3264     define variable v-unrv-sign as integer   no-undo .
     3265     define variable v-goods-twounit as logical   no-undo .
     3266     define variable v-value-character as character no-undo .
     3267     define variable v-value-date      as date no-undo .
     3268     define variable v-value-decimal   as decimal no-undo .
     3269     define variable v-value-integer   as integer no-undo .
