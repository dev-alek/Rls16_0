     2586       end.
     2587       define query partcopy-select-parts for archive_parts .
     2588       open query partcopy-select-parts preselect each archive_parts
     2589         where archive_parts.obj-type  = p-obj-type
     2590           and archive_parts.obj-code  = p-obj-code
     2591           and archive_parts.artic     = p-artic
     2592           and archive_parts.prod-type = p-prod-type
     2593           and archive_parts.prod-code = p-prod-code
     2594           and archive_parts.out-code  = p-doc-code
     2595         .
     2596       get first partcopy-select-parts .
     2597       if buf_trn-doc.doc-type = 'при':U
     2598       then do:
     2599         do while available archive_parts
     2600         on error undo, return error return-value
     2601         :
     2602           if can-do('рас,спи':U, buf_trn-doc.doc-type)
     2603           or (buf_trn-doc.doc-type = 'инв':U
     2604               and archive_parts.fact-qnty < 0)
     2605           then do:
     2606             assign
     2607               v-rsrv-code = 'out-zone':U
     2608             .
     2609           end.
     2610           else do:
     2611             assign
     2612               v-rsrv-code = 'free-zone':U
     2613             .
     2614           end.
     2615           assign
     2616             archive_parts.status_   = yes
     2617             archive_parts.rsrv-free = ?
     2618           .
     2619           if archive_parts.in-code = p-doc-code
     2620           then do:
     2621             assign
     2622               archive_parts.fact-num  = buf_trn-doc.fact-num
     2623               archive_parts.fact-date = buf_trn-doc.fact-date
     2624               archive_parts.doc-type  = buf_trn-doc.doc-type
     2625             .
     2626           end.
     2627           if archive_parts.fact-qnty <> 0
     2628           then do:
     2629             run partcopy in this-procedure
     2630               (input  true
     2631               ,input  v-rsrv-code
     2632               ,buffer archive_parts
     2633               ,buffer buf_parts
