     5281             (input buf_doc-pl.pl-code
     5282             ,input 0.0
     5283             ,input (- buf_doc-pl.cli-doc-qnty)
     5284             ,input 0.0
     5285             ,input 0.0
     5286             ) no-error .
     5287           if error-status :error then do:
