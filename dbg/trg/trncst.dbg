        1   block-level on error undo, throw.
        2   define input parameter p-doc-code like ub.trn-doc.doc-code no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Простановка кода ГТД во все партии приходной накладной".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable v-is-hold       as logical   no-undo .
       79   define variable v-orig-is-hold  as logical   no-undo .
       80   define variable v-process-parts as logical   no-undo .
       81   define variable v-cst-code      as character no-undo .
       82   define variable v-in-code       as character no-undo .
       83   define variable v-part-code     as character no-undo .
       84   define buffer buf_trn-doc    for ub.trn-doc .
       85   define buffer buf_parts      for ub.parts .
       86   define buffer buf_parts-attr for ub.parts-attr .
       87   define buffer buf_parts-supp for ub.parts-supp .
       88   main-block:
       89   do
       90   on error undo main-block, return error return-value
       91   :
       92     find first buf_trn-doc no-lock
       93       where buf_trn-doc.doc-code = p-doc-code
       94       no-error .
       95     if not available buf_trn-doc then do:
       96       message
       97         vss-workfile vss-revision vss-description skip
       98         "Ошибка задания входных параметров" skip
       99         "Не найден документ" p-doc-code skip
      100         view-as alert-box error .
      101       undo main-block, return error return-value .
      102     end.
      103   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
      105     (input  buf_trn-doc.doc-code
      106     ,output v-is-hold
      107     ) no-error .
      108     if error-status :error
      109     then do:
      110       message
      111         vss-workfile vss-revision vss-description skip
      112         "Ошибка при определении типа документа" skip
      113         "Документ" buf_trn-doc.doc-code skip
      114         "Расширенный тип документа" buf_trn-doc.ext-doc-type skip
      115         view-as alert-box error .
      116       undo, return error return-value .
      117     end.
      118     for each buf_parts no-lock
      119       where buf_parts.out-code = p-doc-code
      120     on error undo main-block, return error return-value
      121     :
      122       assign
      123         v-process-parts = false
      124       .
      125       if v-is-hold = false
      126       then do:
      127         assign
      128           v-process-parts = true
      129           v-cst-code      = buf_trn-doc.cst-code
      130         .
      131       end.
      132       else do:
      133         assign
      134           v-in-code   = buf_parts.in-code
      135           v-part-code = buf_parts.part-code
      136         .
      137         scan_cycle:
      138         do while true
      139         :
      140           find first buf_parts-supp share-lock
      141             where buf_parts-supp.in-code   = v-in-code
      142               and buf_parts-supp.artic     = buf_parts.artic
      143               and buf_parts-supp.prod-type = buf_parts.prod-type
      144               and buf_parts-supp.prod-code = buf_parts.prod-code
      145               and buf_parts-supp.part-code = v-part-code
      146             no-error .
      147           if available buf_parts-supp
      148           then do:
      149             assign
      150               v-in-code   = buf_parts-supp.orig-in-code
      151               v-part-code = buf_parts-supp.orig-part-code
      152             .
      153   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
      155     (input  v-in-code
      156     ,output v-orig-is-hold
      157     ) no-error .
      158             if v-orig-is-hold = true
      159             then do:
      160               next scan_cycle .
      161             end.
      162             else do:
      163               define variable v-gds-code as integer   no-undo .
      164   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      166     (input  buf_parts.artic
      167     ,input  buf_parts.prod-type
      168     ,input  buf_parts.prod-code
      169     ,output v-gds-code
      170     )  .
      171               find first buf_parts-attr no-lock
      172                 where buf_parts-attr.in-code   = v-in-code
      173                   and buf_parts-attr.gds-code  = v-gds-code
      174                   and buf_parts-attr.part-code = v-part-code
      175                 no-error .
      176               if available buf_parts-attr
      177               then do:
      178                 assign
      179                   v-process-parts = true
      180                   v-cst-code      = buf_parts-attr.cst-code
      181                 .
      182                 leave scan_cycle .
      183               end.
      184             end.
      185           end.
      186           else do:
      187             leave scan_cycle .
      188           end.
      189         end.
      190       end.
      191       if v-process-parts = true
      192       then do:
      193         run trg/partcst.p
      194           (input v-cst-code
      195           ,input buf_parts.in-code
      196           ,input buf_parts.artic
      197           ,input buf_parts.prod-type
      198           ,input buf_parts.prod-code
      199           ,input buf_parts.part-code
      200           ) no-error .
      201         if error-status :error then do:
      202           message
      203             vss-workfile vss-revision vss-description skip
      204             "Ошибка при вызове процедуры partcst.p" skip
      205             error-status :get-message(1) skip
      206             return-value skip
      207             view-as alert-box error .
      208           undo, return error return-value .
      209         end.
      210       end.
      211     end.
      212   end.
