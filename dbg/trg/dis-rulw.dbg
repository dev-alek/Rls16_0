        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.dis-rule OLD old_dis-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись для таблицы правила скидок".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1', ub.dis-rule.rule-num)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure dr-code :
      308     do
      309     on error undo, return error
      310     :
      311       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      312       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      313       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      314       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      315       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      316       define output parameter  p-level-1           as character no-undo .
      317       define output parameter  p-level-2           as character no-undo .
      318       define output parameter  p-global             as integer no-undo .
      319       define output parameter  p-host               as integer no-undo .
      320       define output parameter  p-object             as integer no-undo .
      321       define output parameter  p-output-display as logical   no-undo .
      322       define output parameter  p-tree           as char  no-undo .
      323       define output parameter  p-other          as character no-undo .
      324       define variable v-other as character no-undo .
      325       define buffer buf_dis-rule for ub.dis-rule .
      326       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      327       find first buf_dis-rule no-lock where
      328                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      329       find first buf_dis-cfg-rule no-lock where
      330               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      331           and buf_dis-cfg-rule.pos-type = '':U
      332           and buf_dis-cfg-rule.table-name = '':U
      333           and buf_dis-cfg-rule.discnt-role = '':U
      334           and buf_dis-cfg-rule.self-nonunique = '':U
      335               no-error.
      336       if not available buf_Dis-cfg-rule then do:
      337           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      338       end.
      339       assign
      340       p-des = buf_dis-rule.des
      341       p-discnt-type = buf_dis-rule.discnt-type
      342       p-subject-type = buf_dis-rule.subject-type
      343       p-value-type = buf_dis-rule.value-type
      344       p-global = (if available buf_dis-cfg-rule
      345                   then buf_dis-cfg-rule.has-global
      346                   else 0)
      347       p-host = (if available buf_dis-cfg-rule
      348                 then buf_dis-cfg-rule.has-host
      349                 else 0)
      350       p-object = (if available buf_dis-cfg-rule
      351                 then buf_dis-cfg-rule.has-obj
      352                 else 0)
      353       p-output-display = (buf_dis-rule.sts = integer('0':U))
      354       p-tree = buf_Dis-rule.uniq-field
      355       p-other = buf_dis-rule.other-inf
      356       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      357       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      358                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      359                    else '')
      360       .
      361     end.
      362   end procedure.
      363   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      364   procedure disrules-fill-properties:
      365   define input  parameter p-templ-rl-root as integer   no-undo .
      366   define buffer buf_drt-prop for ub.drt-prop.
      367   define buffer buf_temp-drt-prop for temp-drt-prop.
      368   do
      369   on error undo, return error return-value
      370   :
      371     for each buf_temp-drt-prop:
      372       delete buf_temp-drt-prop.
      373     end.
      374     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      375       create buf_temp-drt-prop.
      376       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      377     end.
      378   end.
      379   end procedure.
      380   procedure disrules-get-interface-form :
      381   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      382   define output parameter p-form-name as character no-undo .
      383   define buffer buf_temp-drt-prop for temp-drt-prop.
      384   define buffer buf_drt-prop for ub.drt-prop.
      385   find first buf_temp-drt-prop where
      386             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      387         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      388         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      389   if not available buf_temp-drt-prop then do:
      390     find first buf_drt-prop where
      391               buf_drt-prop.templ-rl-root = p-templ-rl-root
      392           and buf_drt-prop.upper-prop-code = "InputForm"
      393           and buf_drt-prop.prop-code = "FormName" no-error.
      394     if available buf_drt-prop then do:
      395       p-form-name = buf_drt-prop.property-value.
      396     end.
      397     else do:
      398       p-form-name = "ref/dis-ruli.w".
      399     end.
      400   end.
      401   else do:
      402     p-form-name = buf_temp-drt-prop.property-value.
      403   end.
      404   end procedure.
      405   ~
      406   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      407   procedure gen-b-code :
      408     define input  parameter type-code like ub.code-range.range-type no-undo .
      409     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      410     do
      411     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      412     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      413     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      414     :
      415       define buffer buf_thbj-attr     for ub.thbj-attr .
      416       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      417       define buffer buf_code-range for ub.code-range .
      418       define variable l-code         as   integer              no-undo .
      419       define variable v-db-num       like ub.db.db-num         no-undo .
      420       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      421       if type-code = 'sslc':U
      422       or type-code = 'ssgb':U
      423       then do:
      424         message
      425           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      426           "Обратитесь к администратору системы."
      427           view-as alert-box error .
      428         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      429       end.
      430       run trg/getpcode.p ( input  type-code
      431                      ,output cfg-param-code
      432                     ).
      433       run get-next-seq( input  type-code,
      434                         output l-code
      435                       ).
      436       find first buf_sys-ctrl no-lock.
      437       if type-code = 'sclc':U
      438       or type-code = 'pglc':U
      439       then do:
      440         assign
      441           v-db-num = 0
      442         .
      443       end.
      444       else do:
      445         assign
      446           v-db-num = buf_sys-ctrl.db-num
      447         .
      448       end.
      449       find first buf_code-range no-lock
      450         where buf_code-range.db-num     = v-db-num
      451           and buf_code-range.range-type = type-code
      452           and buf_code-range.stts       = "a"
      453         use-index stts
      454         no-error .
      455       if available buf_code-range
      456          and l-code <= buf_code-range.last-code
      457          and l-code >= buf_code-range.first-code then do:
      458         assign
      459           p-b-code = l-code
      460         .
      461       end.
      462       else do:
      463         if available buf_code-range
      464            and l-code < buf_code-range.last-code then do:
      465           message
      466             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      467             "Обратитесь к администратору системы."
      468             view-as alert-box error .
      469           undo, return error "sequence":U .
      470         end.
      471         do transaction
      472         on error undo, return error
      473         :
      474           find first buf_thbj-attr exclusive-lock
      475             where buf_thbj-attr.upper-prop-code = 'code-range':U
      476               and buf_thbj-attr.prop-code = cfg-param-code
      477               and buf_thbj-attr.obj-type   = 'БД':U
      478               and buf_thbj-attr.obj-code   = v-db-num
      479             no-error .
      480           if not available buf_thbj-attr then do:
      481             find first buf_thbj-attr exclusive-lock
      482               where buf_thbj-attr.upper-prop-code = 'code-range':U
      483                 and buf_thbj-attr.prop-code = cfg-param-code
      484                 and buf_thbj-attr.obj-type   = ''
      485                 and buf_thbj-attr.obj-code   = 0
      486               no-error .
      487             if not available buf_thbj-attr then do:
      488               if not locked buf_thbj-attr then do:
      489                 message
      490                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      491                   "Обратитесь к администратору системы."
      492                   view-as alert-box error .
      493               end.
      494               undo, return error "config":U .
      495             end.
      496           end.
      497           run get-next-seq( input type-code,
      498                             output l-code
      499                           ).
      500           find first buf_code-range
      501             where buf_code-range.db-num     = v-db-num
      502               and buf_code-range.range-type = type-code
      503               and buf_code-range.stts       = "a"
      504             use-index stts
      505             no-error .
      506           if available buf_code-range
      507           and l-code <= buf_code-range.last-code
      508           and l-code >= buf_code-range.first-code
      509           then do:
      510             assign
      511               p-b-code = l-code
      512             .
      513           end.
      514           else do:
      515             if available buf_code-range then do:
      516               assign
      517                 buf_code-range.stts = "u"
      518               .
      519             end.
      520             find first buf_code-range
      521               where buf_code-range.db-num     = v-db-num
      522                 and buf_code-range.range-type = type-code
      523                 and buf_code-range.stts       = "f"
      524               use-index stts
      525               no-error .
      526             if not available buf_code-range then do:
      527               message
      528                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      529                 "Обратитесь к администратору системы"
      530                 view-as alert-box error .
      531               undo, return error "code-range":U .
      532             end.
      533             assign
      534               buf_code-range.stts           = "a"
      535             .
      536             if buf_code-range.first-code = 1 then do:
      537               run set-seq-cr( input type-code,
      538                               input buf_code-range.first-code
      539                             ).
      540               assign
      541                 p-b-code = 1
      542               .
      543             end.
      544             else do:
      545               run set-seq-cr( input type-code,
      546                               input ( buf_code-range.first-code - 1 )
      547                             ).
      548               run get-next-seq( input type-code,
      549                                 output p-b-code
      550                               ).
      551             end.
      552           end.
      553         end.
      554       end.
      555     end.
      556   end procedure.
      557   procedure get-next-seq :
      558     define input  parameter type-code like ub.code-range.range-type no-undo .
      559     define output parameter next-seq  as   integer                  no-undo .
      560     do
      561     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      562     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      563     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      564     :
      565       case type-code:
      566         when 'bcgb':U then do:
      567           assign
      568             next-seq = next-value(s-bcgb-code, ub)
      569           .
      570         end.
      571         when 'scgb':U then do:
      572           assign
      573             next-seq = next-value(s-scgb-code, ub)
      574           .
      575         end.
      576         when 'sclc':U then do:
      577           assign
      578             next-seq = next-value(s-sclc-code, ub)
      579           .
      580         end.
      581         when 'pglc':U then do:
      582           assign
      583             next-seq = next-value(s-pglc-code, ub)
      584           .
      585         end.
      586         when 'dcgb':U then do:
      587           assign
      588             next-seq = next-value(s-dcgb-code, ub)
      589           .
      590         end.
      591         when 'ctgb':U then do:
      592           assign
      593             next-seq = next-value(s-ctgb-code, ub)
      594           .
      595         end.
      596         when 'drgb':U then do:
      597           assign
      598             next-seq = next-value(s-drgb-code, ub)
      599           .
      600         end.
      601         when 'fmgb':U then do:
      602           assign
      603             next-seq = next-value(s-fmgb-code, ub)
      604           .
      605         end.
      606         when 'pngb':U then do:
      607           assign
      608             next-seq = next-value(s-pngb-code, ub)
      609           .
      610         end.
      611         when 'cagb':U then do:
      612           assign
      613             next-seq = next-value(s-cagb-code, ub)
      614           .
      615         end.
      616         when 'fdgb':U then do:
      617           assign
      618             next-seq = next-value(s-fin-doc, ub)
      619           .
      620         end.
      621       end case.
      622     end.
      623   end procedure.
      624   procedure set-seq-cr :
      625     define input parameter type-code like ub.code-range.range-type no-undo .
      626     define input parameter set-val   like ub.code-range.first-code no-undo .
      627     do
      628     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      629     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      630     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      631     :
      632       case type-code:
      633         when 'bcgb':U then do:
      634           assign
      635             current-value(s-bcgb-code, ub) = set-val
      636           .
      637         end.
      638         when 'scgb':U then do:
      639           assign
      640             current-value(s-scgb-code, ub) = set-val
      641           .
      642         end.
      643         when 'sclc':U then do:
      644           assign
      645             current-value(s-sclc-code, ub) = set-val
      646           .
      647         end.
      648         when 'pglc':U then do:
      649           assign
      650             current-value(s-pglc-code, ub) = set-val
      651           .
      652         end.
      653         when 'dcgb':U then do:
      654           assign
      655             current-value(s-dcgb-code, ub) = set-val
      656           .
      657         end.
      658         when 'ctgb':U then do:
      659           assign
      660             current-value(s-ctgb-code, ub) = set-val
      661           .
      662         end.
      663         when 'drgb':U then do:
      664           assign
      665             current-value(s-drgb-code, ub) = set-val
      666           .
      667         end.
      668         when 'fmgb':U then do:
      669           assign
      670             current-value(s-fmgb-code, ub) = set-val
      671           .
      672         end.
      673         when 'pngb':U then do:
      674           assign
      675             current-value(s-pngb-code, ub) = set-val
      676           .
      677         end.
      678         when 'cagb':U then do:
      679           assign
      680             current-value(s-cagb-code, ub) = set-val
      681           .
      682         end.
      683         when 'fdgb':U then do:
      684           assign
      685             current-value(s-fin-doc, ub) = set-val
      686           .
      687         end.
      688       end case.
      689     end.
      690   end procedure.
      691   procedure new-bcod-gen-code-range :
      692     do
      693     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      694     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      695     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      696     :
      697       define input parameter p-db-num  like ub.db.db-num             no-undo .
      698       define input parameter type-code like ub.code-range.range-type no-undo .
      699       define buffer buf_code-range      for ub.code-range .
      700       define buffer last_code-range     for ub.code-range .
      701       define buffer last-1_code-range   for ub.code-range .
      702       define buffer last-2_code-range   for ub.code-range .
      703       define buffer last-3_code-range   for ub.code-range .
      704       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      705       define variable conf-par       as character no-undo .
      706       define variable par-type       as character no-undo .
      707       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      708       define variable v-cre-cdrg as logical   no-undo .
      709       define variable v-cre-str  as character no-undo .
      710       define variable v-cr1      as integer no-undo .
      711       define variable v-cr2      as integer no-undo .
      712       define variable v-cr3      as integer no-undo .
      713       define variable v-cmax     as integer no-undo .
      714       find first buf_sys-ctrl no-lock .
      715       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      716         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      717                                       ,vss-workfile
      718                                       ,vss-revision
      719                                       ,vss-description
      720                                       ,chr(10)
      721                                       , p-db-num
      722                                      ).
      723       end.
      724       run trg/getpcode.p ( input  type-code
      725                      ,output cfg-param-code
      726                     ).
      727       for each buf_code-range
      728         where buf_code-range.db-num     = -1
      729           and buf_code-range.range-type = type-code
      730           and buf_code-range.stts       = "f"
      731       by buf_code-range.first-code
      732       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      733       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      734       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      735       :
      736         assign
      737           buf_code-range.db-num = p-db-num
      738         .
      739         return .
      740       end.
      741       assign
      742         v-cre-cdrg = TRUE
      743       .
      744       case type-code:
      745         when 'sclc':U
      746         or when 'scgb':U
      747         or when 'pglc':U
      748         then do:
      749           find last last-1_code-range no-lock
      750             where last-1_code-range.range-type = 'sclc':U
      751             no-error .
      752           if available last-1_code-range then do:
      753             v-cr1 = last-1_code-range.last-code.
      754           end.
      755           find last last-2_code-range no-lock
      756             where last-2_code-range.range-type = 'scgb':U
      757             no-error .
      758           if available last-2_code-range then do:
      759             v-cr2 = last-2_code-range.last-code.
      760             end.
      761           find last last-3_code-range no-lock
      762             where last-3_code-range.range-type = 'pglc':U
      763             no-error .
      764           if available last-3_code-range then do:
      765             v-cr3 = last-3_code-range.last-code.
      766           end.
      767           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      768           .
      769           if v-cmax = v-cr1  then do:
      770               find last last_code-range no-lock
      771                 where recid( last_code-range ) = recid( last-1_code-range )
      772                 .
      773             end.
      774           if v-cmax = v-cr2  then do:
      775               find last last_code-range no-lock
      776                 where recid( last_code-range ) = recid( last-2_code-range )
      777                 .
      778             end.
      779           if v-cmax = v-cr3  then do:
      780             find last last_code-range no-lock
      781               where recid( last_code-range ) = recid( last-3_code-range )
      782               .
      783           end.
      784           if last_code-range.last-code + 1 > 99999 then do:
      785             assign
      786               v-cre-cdrg = FALSE
      787             .
      788           end.
      789         end.
      790         when 'bcgb':U
      791         or when 'sslc':U
      792         or when 'ssgb':U
      793         then do:
      794           find last last-1_code-range no-lock
      795             where last-1_code-range.range-type = 'sslc':U
      796             no-error .
      797           if available last-1_code-range then do:
      798             v-cr1 = last-1_code-range.last-code.
      799           end.
      800           find last last-2_code-range no-lock
      801             where last-2_code-range.range-type = 'bcgb':U
      802             no-error .
      803           if available last-2_code-range then do:
      804             v-cr2 = last-2_code-range.last-code.
      805             end.
      806           find last last-3_code-range no-lock
      807             where last-3_code-range.range-type = 'ssgb':U
      808             no-error .
      809           if available last-3_code-range then do:
      810             v-cr3 = last-3_code-range.last-code.
      811           end.
      812           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      813           .
      814           if v-cmax = v-cr1  then do:
      815               find last last_code-range no-lock
      816                 where recid( last_code-range ) = recid( last-1_code-range )
      817                 .
      818             end.
      819           if v-cmax = v-cr2  then do:
      820               find last last_code-range no-lock
      821                 where recid( last_code-range ) = recid( last-2_code-range )
      822                 .
      823             end.
      824           if v-cmax = v-cr3  then do:
      825             find last last_code-range no-lock
      826               where recid( last_code-range ) = recid( last-3_code-range )
      827               .
      828           end.
      829         end.
      830         otherwise do:
      831           find last last_code-range no-lock
      832             where last_code-range.range-type = type-code
      833             no-error .
      834         end.
      835       end case.
      836       if not available last_code-range then do:
      837         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      838                                       ,vss-workfile
      839                                       ,vss-revision
      840                                       ,vss-description
      841                                       , chr(10)
      842                                       , type-code
      843                                      ) .
      844       end.
      845       define variable v-mes2 as character no-undo .
      846       define variable v-param-type2 as character no-undo .
      847       define variable v-value-character2 as INTEGER no-undo .
      848       define variable v-value-date2 as date no-undo .
      849       define variable v-value-decimal2 as decimal no-undo .
      850       define variable v-value-integer2 AS integer no-undo .
      851       define variable v-value-logical2 AS LOGICAL no-undo .
      852       define variable v-tth2 as handle no-undo .
      853       run adm/shattri.p (
      854           input "get":U
      855           ,input  'БД':U
      856           ,input  p-db-num
      857           ,input  'code-range':U
      858           ,input  cfg-param-code
      859           ,output v-value-character2
      860           ,output v-value-date2
      861           ,output v-value-decimal2
      862           ,output v-value-integer2
      863           ,output v-value-logical2
      864           ,output v-param-type2
      865           ,INPUT-OUTPUT table-handle v-tth2
      866           ) no-error .
      867       if error-status :error then do:
      868         delete object v-tth2.
      869         v-mes2 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      870                            , error-status:get-message(1)
      871                            , chr(10)
      872                            , return-value ).
      873         undo, return error v-mes2.
      874       end.
      875       delete object v-tth2.
      876       if v-cre-cdrg = TRUE then do:
      877         create buf_code-range .
      878         assign
      879           buf_code-range.db-num     = p-db-num
      880           buf_code-range.range-type = type-code
      881           buf_code-range.stts       = "f"
      882           buf_code-range.first-code = last_code-range.last-code + 1
      883           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer2)
      884           v-cre-str = "Свободный диапазон успешно создан"
      885         .
      886       end.
      887       else do:
      888         assign
      889           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      890                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      891         .
      892       end.
      893     end.
      894     return v-cre-str .
      895   end procedure.
      896   procedure gen-new-code-range-if-neces :
      897     define input parameter v-db-num           like ub.db.db-num             no-undo .
      898     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      899     define input parameter v-cur-code         as   integer                  no-undo .
      900     define input parameter v-g#news           as   logical                  no-undo .
      901     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      902     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      903     do
      904     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      905     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      906     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      907     :
      908       define variable l-code-range-exist as logical   no-undo init false .
      909       define variable v-db-for-send      as character no-undo .
      910       define buffer buf_code-range  for ub.code-range .
      911       define buffer buf1_code-range for ub.code-range .
      912       define buffer buf_db          for ub.db .
      913       find first buf_code-range
      914         where buf_code-range.range-type = v-range-type
      915           and buf_code-range.last-code >= v-cur-code
      916         use-index last-codei
      917         no-error .
      918       if
      919       (
      920          available buf_code-range
      921          and
      922         (buf_code-range.db-num = v-db-num
      923           and
      924         buf_code-range.first-code <= v-cur-code
      925         )
      926       or
      927         (
      928           v-range-type = 'drgb':U
      929           AND
      930           v-cur-code = 0
      931         )
      932      )
      933      then do:
      934         assign
      935           l-code-range-exist = true
      936         .
      937         if v-g#news
      938         and buf_code-range.stts = "f" then do:
      939           assign
      940             buf_code-range.stts = "u"
      941           .
      942         end.
      943       end.
      944       if not l-code-range-exist
      945          and v-g#news-source-db <> 0
      946       then do:
      947         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      948                                       ,vss-workfile
      949                                       ,vss-revision
      950                                       ,vss-description
      951                                       ,chr(10)
      952                                       ,v-db-num
      953                                       ,v-range-type
      954                                       ,v-cur-code
      955                                      ).
      956       end.
      957       if (not l-code-range-exist
      958           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      959          )
      960       and ( not can-find (first buf1_code-range no-lock
      961                           where buf1_code-range.db-num = v-db-num
      962                             and buf1_code-range.range-type = v-range-type
      963                             and buf1_code-range.stts = "f"
      964                          )
      965           )
      966       then do:
      967         if v-g#db-num = 0 then do:
      968           run new-bcod-gen-code-range in this-procedure
      969             (input v-db-num,
      970              input v-range-type
      971             ) no-error .
      972           if error-status :error then do:
      973             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      974                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      975                                           ,v-db-num
      976                                           ,v-range-type
      977                                           ,v-cur-code
      978                                           ,chr(10)
      979                                           ,error-status:get-message(1)
      980                                           ,return-value
      981                                          ).
      982           end.
      983         end.
      984         else do:
      985           if v-range-type = 'sclc':U
      986           or v-range-type = 'pglc':U
      987           then do:
      988             assign
      989               v-db-for-send = "":U
      990             .
      991             if v-g#db-num = 0 then do:
      992               for each buf_db no-lock
      993                 where buf_db.db-num > 0
      994                   and buf_db.db-num <> v-g#news-source-db
      995               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      996               :
      997                 assign
      998                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      999                 .
     1000               end.
     1001               assign
     1002                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1003               .
     1004             end.
     1005             else do:
     1006               if not v-g#news then do:
     1007                 assign
     1008                   v-db-for-send = "0":U
     1009                 .
     1010               end.
     1011             end.
     1012             run nws/cr-route.p ( input 'send-cmd':U
     1013                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1014                                  "code-range":U + chr(1) +
     1015                                  (if v-range-type = 'sclc':U
     1016                                   then string( current-value(s-sclc-code, ub))
     1017                                   else string( current-value(s-pglc-code, ub))
     1018                                   ) + chr(1) +
     1019                                   v-range-type)
     1020                           ,input ?
     1021                           ,input v-db-for-send
     1022                           ) no-error .
     1023             if error-status :error then do:
     1024               undo, return error return-value.
     1025             end.
     1026           end.
     1027         end.
     1028       end.
     1029     end.
     1030   end procedure.
     1031   procedure cre-loc-sc-code-range :
     1032     define input parameter v-cur-code as integer no-undo .
     1033   define input parameter p-cdrg-type as character no-undo .
     1034     do
     1035     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1036     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1037     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1038     :
     1039       define buffer buf_code-range for ub.code-range .
     1040       find first buf_code-range
     1041            where buf_code-range.range-type = p-cdrg-type
     1042              and buf_code-range.first-code >= v-cur-code
     1043            no-error .
     1044       if not available buf_code-range then do:
     1045         run new-bcod-gen-code-range in this-procedure
     1046           ( input 0,
     1047             input p-cdrg-type
     1048           ) no-error .
     1049         if error-status :error then do:
     1050           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1051                                          + "Код &2&1&3 &4"
     1052                                         , chr(10)
     1053                                         , v-cur-code
     1054                                         , error-status:get-message(1)
     1055                                         , return-value
     1056                                        ) .
     1057         end.
     1058       end.
     1059     end.
     1060   end procedure.
     1061   procedure mark-used-if-need :
     1062   define input parameter p-cur-code as integer no-undo .
     1063   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1064   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1065     do
     1066     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1067     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1068     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1069     :
     1070       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1071       define buffer buf_code-range for ub.code-range .
     1072       assign
     1073       v-db-num = if p-range-type = 'sclc':U
     1074                  then 0
     1075                  else p-db-num
     1076       .
     1077   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1078   define buffer locK-batchprocess3 for ub.batchprocess.
     1079   run gbl/lock-prc.p
     1080       (input 'lscc':U
     1081       ,input 0
     1082       ,input 0
     1083       ,input 0
     1084       ,input ""
     1085       ,input ""
     1086       ,input ""
     1087       ,input (
     1088               ",,,Вкл/выкл лок. вес. кодов"
     1089              )
     1090       ,input true
     1091       ,buffer lock-batchprocess3
     1092       ) no-error .
     1093     if error-status :error then do:
     1094       message
     1095         vss-workfile vss-revision vss-description skip
     1096         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1097         view-as alert-box error .
     1098       undo, return error .
     1099     end.
     1100       find first buf_code-range
     1101            where buf_code-range.range-type = p-range-type
     1102              and buf_code-range.first-code >= p-cur-code
     1103              and buf_code-range.last-code <= p-cur-code
     1104              and buf_code-range.db-num = v-db-num
     1105            no-error .
     1106       if not available buf_code-range then do:
     1107         message
     1108           vss-workfile vss-revision vss-description skip
     1109           "Ошибка при создании поиске диапазона" skip
     1110           "База данных" p-db-num skip
     1111           "Код" p-cur-code skip
     1112           "Тип" p-range-type
     1113           error-status :get-message(1) skip
     1114           return-value skip
     1115           view-as alert-box error .
     1116         undo, return error .
     1117       end.
     1118       if buf_code-range.stts = "f":U then do:
     1119         assign
     1120         buf_code-range.stts = "u":U
     1121         .
     1122       end.
     1123     end.
     1124   end procedure.
     1125   define variable v-date as date no-undo .
     1126   define variable v-time as integer no-undo .
     1127   define variable v-db-num like ub.db.db-num no-undo .
     1128   define variable v-chr as character no-undo .
     1129   define variable v-changed as logical no-undo .
     1130   define variable v-confirmed as logical no-undo .
     1131   define variable v-start-level as integer no-undo .
     1132   define variable level as integer no-undo .
     1133   define variable v-ii as integer no-undo .
     1134   define variable v-p as character no-undo .
     1135   define buffer buf_c-dis-rule for ub.c-dis-rule.
     1136   main-block:
     1137   do
     1138   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1139   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1140   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1141   :
     1142     buffer-compare ub.dis-rule to old_dis-rule
     1143     case-sensitive
     1144     save result in v-chr.
     1145       if ub.dis-rule.rule-num <= 99999 then do:
     1146         _ii:
     1147         do v-ii = 1 to num-entries(v-chr):
     1148           if lookup(entry(v-ii, v-chr), "other-inf,uniq-field,des,sts,dis-kat,doc-qnty,tot-sum,":U +
     1149                                         "charkey_one,charkey_two,charkey_three":U +
     1150                                         "deckey_one,deckey_two,deckey_three":U +
     1151                                         "key#_one,key#_two,key_#three":U
     1152                                         ) = 0
     1153           then do:
     1154             assign
     1155             v-changed = yes
     1156             .
     1157             leave _ii.
     1158           end.
     1159        end.
     1160        if lookup("dis-kat":U, v-chr) > 0 then do:
     1161          if ub.dis-rule.discnt-type = integer('12':U) then
     1162          assign
     1163          v-changed = yes.
     1164        end.
     1165        if lookup("doc-qnty":U, v-chr) > 0 then do:
     1166          if ub.dis-rule.discnt-type = integer('4':U) then
     1167          assign
     1168          v-changed = yes.
     1169        end.
     1170        if not ( g#db-num > 0 ) then do:
     1171         if (v-chr <> "sts" and v-changed
     1172             AND old_dis-rule.sts <> integer('1':U)
     1173             and not new(ub.dis-rule)
     1174             ) then do:
     1175           assign
     1176           v-changed = yes.
     1177         end.
     1178       end.
     1179       if (( g#db-num > 0 ) and not g#news and v-changed and not new(ub.dis-rule))
     1180       or (not ( g#db-num > 0 ) and v-changed and not new(ub.dis-rule))
     1181       then do:
     1182         assign
     1183         v-start-level = 2
     1184         .
     1185         assign
     1186           level = v-start-level
     1187         .
     1188         _repeat:
     1189         repeat while program-name( level ) <> ? :
     1190           v-p = program-name( level ).
     1191           if substring(v-p, length(v-p) - length("fixdr.p") + 1) = "fixdr.p":U
     1192           or substring(v-p, length(v-p) - length("fixdr.p") + 1) = "fixdr.r":U
     1193           or substring(v-p, length(v-p) - length("disrul0.p") + 1) = "disrul0.p":U
     1194           or substring(v-p, length(v-p) - length("disrul0.p") + 1) = "disrul0.r":U
     1195           then do:
     1196             v-confirmed = yes.
     1197             leave _repeat.
     1198           end.
     1199           assign
     1200             level = level + 1
     1201           .
     1202         end.
     1203         if not v-confirmed then do:
     1204           message
     1205           vss-workfile vss-revision vss-description skip
     1206           substitute("Правило №&1", ub.dis-rule.rule-num) skip
     1207           "Для используемых записей ШАБЛОНОВ СКИДОК можно менять только статус записи и только в ГБД"
     1208           view-as alert-box error .
     1209           undo main-block, return error .
     1210         end.
     1211       end.
     1212     end.
     1213     if new(ub.dis-rule)
     1214     and ub.dis-rule.rule-num > 99999
     1215     then do:
     1216       run gen-new-code-range-if-neces
     1217                                      (  input (if g#news then g#news-source-db else g#db-num)
     1218                                        ,input 'drgb':U
     1219                                        ,input ub.dis-rule.rule-num
     1220                                        ,input g#news
     1221                                        ,input g#db-num
     1222                                        ,input g#news-source-db
     1223                                      ) no-error .
     1224      if error-status:error then do:
     1225         if g#news
     1226         then do:
     1227           find first buf_c-dis-rule no-lock where
     1228                     buf_c-dis-rule.rule-num = ub.dis-rule.rule-num
     1229                 and buf_c-dis-rule.corr-user-db-num = g#news-source-db no-error.
     1230         end.
     1231         else do:
     1232           find first buf_c-dis-rule no-lock where
     1233                     buf_c-dis-rule.rule-num = ub.dis-rule.rule-num
     1234                 and buf_c-dis-rule.corr-user-db-num = g#db-num no-error.
     1235         end.
     1236         if not available buf_c-dis-rule
     1237         and ub.dis-rule.upper-rule-num > 99999
     1238         and g#news then do:
     1239           find first buf_c-dis-rule no-lock where
     1240                     buf_c-dis-rule.rule-num = ub.dis-rule.rule-num
     1241                 and buf_c-dis-rule.corr-user-db-num = g#db-num no-error.
     1242         end.
     1243         if available buf_c-dis-rule then do:
     1244           define buffer buf_code-range for ub.code-range.
     1245           find first buf_code-range no-lock where
     1246                     buf_code-range.range-type = 'drgb':U
     1247                and  buf_code-range.first-code <= ub.dis-rule.rule-num
     1248                and  buf_code-range.last-code >= ub.dis-rule.rule-num
     1249                and  (buf_code-range.stts = "u":U
     1250                      or
     1251                      buf_code-range.stts = "a":U  )
     1252                no-error.
     1253           if available buf_Code-range then do:
     1254           end.
     1255           else do:
     1256             undo main-block, return error substitute("&2&1&3&1&4&1&5&1&6&1"
     1257                                                     , chr(10)
     1258                                                     , vss-workfile
     1259                                                     , vss-revision
     1260                                                     ,vss-description
     1261                                                     , error-status:get-message(1)
     1262                                                     , return-value ).
     1263           end.
     1264         end.
     1265         else do:
     1266          undo main-block, return error substitute("&2&1&3&1&4&1&5&1&6&1"
     1267                                                  , chr(10)
     1268                                                  , vss-workfile
     1269                                                  , vss-revision
     1270                                                  ,vss-description
     1271                                                  , error-status:get-message(1)
     1272                                                  , return-value ).
     1273        end.
     1274      end.
     1275     end.
     1276     if not g#news then do:
     1277       if ( g#db-num > 0 )   then do:
     1278         if (ub.dis-rule.host-code = 0
     1279         or ub.dis-rule.obj-code = 0 )
     1280         and v-changed and not new(ub.dis-rule)
     1281         then do:
     1282           message
     1283           vss-workfile vss-revision vss-description skip
     1284           substitute("Правило №&1", ub.dis-rule.rule-num) skip
     1285           "Нельзя изменять глобальную запись ПРАВИЛА СКИДОК  или запись ПРАВИЛА СКИДОК по фирме в УБД"
     1286           view-as alert-box error .
     1287           undo main-block, return error .
     1288         end.
     1289       end.
     1290       if ub.dis-rule.obj-code > 0 then do:
     1291   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1293     (input  ub.dis-rule.obj-type
     1294     ,input  ub.dis-rule.obj-code
     1295     ,output v-db-num
     1296     )  .
     1297         if v-db-num <> g#db-num and ( g#db-num > 0 ) then do:
     1298           message
     1299           vss-workfile vss-revision vss-description skip
     1300           substitute("Правило №&1", ub.dis-rule.rule-num) skip
     1301           "Нельзя изменять запись ПРАВИЛА СКИДОК на объекте в чужой УБД"
     1302           view-as alert-box error .
     1303           undo main-block, return error .
     1304         end.
     1305       end.
     1306     end.
     1307     run cur-time in this-procedure(output v-date, output v-time).
     1308     if new(ub.dis-rule) then do:
     1309       create buf_c-dis-rule.
     1310       buffer-copy old_dis-rule
     1311       except
     1312       rule-num
     1313       upper-rule-num
     1314       templ-rl-root
     1315       rl-root
     1316       host-code
     1317       obj-type
     1318       obj-code
     1319       to buf_c-dis-rule
     1320       assign
     1321       buf_c-dis-rule.rule-num           = ub.dis-rule.rule-num
     1322       buf_c-dis-rule.upper-rule-num     = ub.dis-rule.upper-rule-num
     1323       buf_c-dis-rule.templ-rl-root      = ub.dis-rule.templ-rl-root
     1324       buf_c-dis-rule.rl-root            = ub.dis-rule.rl-root
     1325       buf_c-dis-rule.host-code          = ub.dis-rule.host-code
     1326       buf_c-dis-rule.obj-type           = ub.dis-rule.obj-type
     1327       buf_c-dis-rule.obj-code           = ub.dis-rule.obj-code
     1328       buf_c-dis-rule.chip-num           = next-value (s-dc-chip, ub)
     1329       buf_c-dis-rule.corr-time          = v-time
     1330       buf_c-dis-rule.corr-user-db-num   = g#db-num
     1331       buf_c-dis-rule.corr-user-name     = (if g#news
     1332                                            then (chr(4) +  'СПН':U)
     1333                                            else (if g#esys
     1334                                                  then (chr(4) +  'ВС':U)
     1335                                                  else g#userid)
     1336                                           )
     1337       buf_c-dis-rule.corr-date          = v-date
     1338       buF_c-dis-rule.action             = (if new(ub.dis-rule) then integer('1':U) else integer('2':U))
     1339       buf_c-dis-rule.is-news            = g#news
     1340       .
     1341     end.
     1342     else do:
     1343       if v-chr <> '':U then do:
     1344         create buf_c-dis-rule.
     1345         buffer-copy old_dis-rule
     1346         except
     1347         rule-num  to buf_c-dis-rule
     1348         assign
     1349         buf_c-dis-rule.rule-num           = ub.dis-rule.rule-num
     1350         buf_c-dis-rule.chip-num           = next-value (s-dc-chip, ub)
     1351         buf_c-dis-rule.corr-time          = v-time
     1352         buf_c-dis-rule.corr-user-db-num   = g#db-num
     1353         buf_c-dis-rule.corr-user-name     = (if g#news
     1354                                             then (chr(4) +  'СПН':U)
     1355                                             else (if g#esys
     1356                                                   then (chr(4) +  'ВС':U)
     1357                                                   else g#userid)
     1358                                             )
     1359         buf_c-dis-rule.corr-date          = v-date
     1360         buF_c-dis-rule.action             = (if new(ub.dis-rule) then integer('1':U) else integer('2':U))
     1361         buf_c-dis-rule.is-news            = g#news
     1362         .
     1363       end.
     1364     end.
     1365     if g#db-num = 0
     1366     and old_dis-rule.sts = integer('99':U)
     1367     and ub.dis-rule.sts <> integer('99':U) then do:
     1368       create buf_c-dis-rule.
     1369       buffer-copy ub.dis-rule
     1370       except
     1371       rule-num  to buf_c-dis-rule
     1372       assign
     1373       buf_c-dis-rule.rule-num           = ub.dis-rule.rule-num
     1374       buf_c-dis-rule.chip-num           = next-value (s-dc-chip, ub)
     1375       buf_c-dis-rule.corr-time          = v-time
     1376       buf_c-dis-rule.corr-user-db-num   = g#db-num
     1377       buf_c-dis-rule.corr-user-name     = (if g#news
     1378                                           then (chr(4) +  'СПН':U)
     1379                                           else (if g#esys
     1380                                                 then (chr(4) +  'ВС':U)
     1381                                                 else g#userid)
     1382                                           )
     1383       buf_c-dis-rule.corr-date          = v-date
     1384       buF_c-dis-rule.action             = integer('3':U)
     1385       buf_c-dis-rule.is-news            = g#news
     1386       .
     1387     end.
     1388     if (new(ub.dis-rule)
     1389     or v-chr <> '':U )
     1390     AND (ub.dis-rule.obj-code = 0 or not g#news)
     1391     and ub.dis-rule.upper-rule-num <= 99999
     1392     and not (v-chr = 'sts' and ub.dis-rule.sts = integer('99':U))
     1393       then do:
     1394       run str/callnews.p
     1395         (input 'dis-rule':U
     1396         ,input (buffer ub.dis-rule:handle)
     1397         ).
     1398     end.
     1399       if g#oxml = yes
     1400       then do:
     1401       run str/calloxml.p (
     1402             input 'update':U
     1403           , input 'dis-rule':U
     1404           , input ( buffer ub.dis-rule:handle )
     1405       ) no-error.
     1406       if error-status :error
     1407       then do:
     1408           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1409                                , chr(10)
     1410                                , vss-workfile
     1411                                , return-value
     1412                                , error-status :get-message ( 1 ) ).
     1413       end.
     1414       end.
     1415   end.
