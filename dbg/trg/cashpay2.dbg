        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter parobj-code like ub.cash-pay.cdpay-code no-undo .
        4   define input parameter parobj-name like ub.cash-pay.obj-name no-undo .
        5   define input parameter parcurr-code like ub.cash-pay.curr-code no-undo .
        6   define input parameter parpay-code like ub.cash-pay.pay-code no-undo .
        7   define input parameter parwth-code like ub.cash-pay.wth-code no-undo .
        8   define input parameter parpay-limit like ub.cash-pay.pay-limit no-undo .
        9   define input parameter parpay-card-view like ub.cash-pay.pay-card-view no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Проверка корректности при сохранении изменений в типе кассовых платежей".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   DEFINE VARIABLE is-wth as logical no-undo .
       86   DEFINE VARIABLE conf-par as character no-undo .
       87   DEFINE VARIABLE par-type as character no-undo .
       88   DEFINE VARIABLE var-entry as character no-undo .
       89   define variable v-int as integer no-undo .
       90   define variable ii as integer no-undo .
       91   define variable v-mess as character no-undo .
       92   define buffer buf_pay-type for ub.pay-type.
       93   define buffer buf_wealth for ub.wealth.
       94   if (parobj-code <= 0 ) OR ( parobj-code = ? ) then do:
       95     v-mess = "Код платежа должен быть больше 0 !".
       96     run err-mess in this-procedure ( input-output v-mess).
       97     return error (if p-silent = yes then v-mess else 'cdpay-code':U).
       98   end.
       99   if parobj-name = ""  then do:
      100     v-mess = "Не определено название типа кассового платежа!".
      101     run err-mess in this-procedure ( input-output v-mess).
      102     return error (if p-silent = yes then v-mess else 'obj-name':U).
      103   end.
      104   if  NOT can-find( FIRST ub.currency No-LOCK WHERE
      105                           ub.currency.curr-code = parcurr-code ) then do:
      106     v-mess = substitute("Неверный код валюты &1", parcurr-code).
      107     run err-mess in this-procedure ( input-output v-mess).
      108     return error (if p-silent = yes then v-mess else 'curr-code':U).
      109   end.
      110   if parpay-limit = ? then do:
      111     v-mess = "Лимит для типа кассового платежа не может иметь неопределенное значение !".
      112     run err-mess in this-procedure ( input-output v-mess).
      113     return error (if p-silent = yes then v-mess else 'pay-limit':U).
      114   end.
      115   find first buf_pay-type NO-LOCK where
      116              buf_pay-type.obj-code = parpay-code NO-ERROR.
      117   if not avail buf_pay-type then do:
      118     v-mess = substitute( "Неверный вид оплаты &1", parpay-code).
      119     run err-mess in this-procedure ( input-output v-mess).
      120     return error (if p-silent = yes then v-mess else 'pay-code':U).
      121   end.
      122   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      123     (input  'is-wth'
      124     ,input  0
      125     ,input  ''
      126     ,input  0
      127     ,input  ''
      128     ,input  ''
      129     ,input  ''
      130     ,input  yes
      131     ,output conf-par
      132     ,output par-type
      133     ) no-error .
      134   IF not error-status:error then
      135   assign
      136   is-wth = (conf-par = "yes":U).
      137   if is-wth
      138   and parwth-code > 0 then do:
      139     find first buf_wealth NO-LOCK where
      140                buf_wealth.wth-code = parwth-code NO-ERROR.
      141     if not avail buf_wealth then do:
      142       v-mess = substitute("Неверный код МЦ &1", parwth-code).
      143       run err-mess in this-procedure ( input-output v-mess).
      144       return error (if p-silent = yes then v-mess else 'wth-code':U).
      145     end.
      146     if buf_wealth.is-money
      147     and buf_wealth.curr-code <> parcurr-code then do:
      148       v-mess = substitute("Не совпадают валюты МЦ &1 (код валюты &2) и типа кассового платежа &3 (код валюты &4)!"
      149                   ,parwth-code
      150                   ,buf_wealth.curr-code
      151                   ,parobj-code
      152                   ,parcurr-code).
      153       run err-mess in this-procedure ( input-output v-mess).
      154       return error (if p-silent = yes then v-mess else 'wth-code':U).
      155     end.
      156     if not (buf_wealth.is-money = yes
      157            or buf_wealth.is-ser = 1) then do:
      158       v-mess = substitute("МЦ с кодом &1 не имеет ДЕНЕЖНОГО ЭКВИВАЛЕНТА и не является СЕРИЙНОЙ!"
      159                   ,buf_wealth.wth-code).
      160       run err-mess in this-procedure ( input-output v-mess).
      161       return error (if p-silent = yes then v-mess else 'wth-code':U).
      162     end.
      163     if parobj-code = 1
      164     and buf_wealth.get-qnty-method <> '=sum':U
      165     then do:
      166         v-mess = substitute("Тип кассового платежа с кодом 1 не может быть связан с МЦ с методом определения кол-ва МЦ = &1"
      167                            ,entry (lookup (buf_wealth.get-qnty-method, '=sum,=1,=val-qnty':U) + 1, ',' + '=Сумма,=1,По номиналу и кол-ву':U)).
      168       run err-mess in this-procedure ( input-output v-mess).
      169       return error (if p-silent = yes then v-mess else 'wth-code':U).
      170     end.
      171   end.
      172   if parpay-card-view <> "":u then do:
      173     do ii = 1 to num-entries(parpay-card-view):
      174       assign
      175       v-int = integer(entry(ii, parpay-card-view))
      176       no-error
      177       .
      178       if error-status:error
      179       or entry(ii, parpay-card-view) = "":U then do:
      180         v-mess =  "Неверное значение поля <СПИСОК ПРЕФИКСОВ НОМЕРОВ ПЛАТЕЖНЫХ КАРТ ДЛЯ ПРОСМОТРА>".
      181         run err-mess in this-procedure ( input-output v-mess).
      182         return error (if p-silent = yes then v-mess else 'pay-card-view':U).
      183       end.
      184     end.
      185   end.
      186   PROCEDURE err-mess:
      187     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      188     CASE p-silent:
      189       when yes then do:
      190         assign
      191         p-mess = substitute("Тип касс.платежа с кодом &1 и кодом валюты &2&3&4"
      192                            , parobj-code
      193                            , parcurr-code
      194                            , chr(10)
      195                            , p-mess)
      196         .
      197       end.
      198       when no then do:
      199         message
      200         p-mess
      201         view-as alert-box error .
      202       end.
      203     end.
      204   END PROCEDURE.
