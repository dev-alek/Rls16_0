        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.clob-data.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись CLOB-data".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable v-send as logical   no-undo .
       79   define variable v-call-handle as handle no-undo .
       80   define buffer buf_clob-bind for ub.clob-bind.
       81   main-block:
       82   do
       83   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       84   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       85   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       86   :
       87       if lookup(ub.clob-data.resource-type, 'data,gate,upgrade,report,report-xml,list,list-macro,ref,egais-wb,egais-ref-b,egais-ab,egais-awo,egais-wb-act,egais-ticket,egais-wb-ticket,egais-ab_shop,egais-awo_shop,egais-tts,egais-tfs,egais-qb':U) = 0 then do:
       88         message
       89         substitute("Неизвестный resource-type = &1 для clob-data", ub.clob-data.resource-type)
       90         view-as alert-box error .
       91         undo main-block, return error .
       92       end.
       93       if not g#news then do:
       94   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
       96     (output ub.clob-data.user-db-num
       97     ,output ub.clob-data.user-name
       98     ,output ub.clob-data.sys-date
       99     ,output ub.clob-data.sys-time
      100     ,output ub.clob-data.sys-time-int
      101     )  .
      102         if ub.clob-data.crc-field <> '':U then do:
      103           v-call-handle = this-procedure:instantiating-procedure.
      104           if lookup("cb_set-send-nws", v-call-handle:internal-entries) > 0 then do:
      105             run cb_set-send-nws in v-call-handle ( output v-send) .
      106           end.
      107           else do:
      108             v-send = yes.
      109           end.
      110           if v-send then do:
      111           run str/callnews.p
      112             (input 'clob-data':U
      113             ,input (buffer ub.clob-data:handle)
      114             ) no-error .
      115           if error-status:error then do:
      116             if error-status :get-message(1) <> ""
      117             then do:
      118               message
      119                 vss-workfile vss-revision vss-description skip
      120                 "Ошибка при вызове процедуры callnews.p" skip
      121                 error-status :get-message(1) skip
      122                 return-value skip
      123                 view-as alert-box error .
      124             end.
      125             undo main-block,  return error return-value .
      126           end.
      127         end.
      128      end.
      129      end.
      130      else do:
      131         find first buf_clob-bind no-lock where
      132           buf_clob-bind.db-num = ub.clob-data.db-num
      133           and buf_clob-bind.int64-id = ub.clob-data.int64-id no-error.
      134        if ub.clob-data.is-cs = yes
      135        and g#db-num = 0
      136        and ub.clob-data.crc-field <> '':U
      137        and not
      138         (available (buf_clob-bind)
      139             and (buf_clob-bind.resource-type = 'egais-wb':U
      140             or buf_clob-bind.resource-type = 'egais-ref-b':U
      141             or buf_clob-bind.resource-type = 'egais-wb-act':U
      142             or buf_clob-bind.resource-type = 'egais-ticket':U
      143             or buf_clob-bind.resource-type = 'egais-wb-ticket':U
      144             or buf_clob-bind.resource-type = 'egais-ab':U
      145             or buf_clob-bind.resource-type = 'egais-awo':U
      146             or buf_clob-bind.resource-type = 'egais-ab_shop':U
      147             or buf_clob-bind.resource-type = 'egais-awo_shop':U
      148             or buf_clob-bind.resource-type = 'egais-tts':U
      149             or buf_clob-bind.resource-type = 'egais-tfs':U
      150             or buf_clob-bind.resource-type = 'egais-qb':U))
      151        then do:
      152         run str/callnews.p ( input 'clob-data':U
      153                           ,input (buffer ub.clob-data:handle)
      154                           ) no-error .
      155         if error-status:error then do:
      156           if error-status :get-message(1) <> ""
      157           then do:
      158             message
      159               vss-workfile vss-revision vss-description skip
      160               "Ошибка при вызове callnews.p" skip
      161               error-status :get-message(1) skip
      162               return-value skip
      163               view-as alert-box error .
      164           end.
      165           undo main-block,  return error return-value .
      166         end.
      167       end.
      168     end.
      169   end.
