        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Резервирования товара по партиям":U .
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define new global shared variable g#library  as handle no-undo .
       13   define new global shared variable g#library2 as handle no-undo .
       14   define   shared variable g#auto as logical no-undo.
       15   define   shared variable g#news as logical no-undo.
       16   define   shared variable g#oxml as logical no-undo.
       17   define   shared variable g#esys as logical no-undo.
       18   define   shared variable g#news-source-db as integer no-undo.
       19   define   shared variable g#esys-source-esys as integer no-undo.
       20   define   shared variable g#db-num as integer   no-undo .
       21   define   shared variable g#userid as character no-undo .
       22   define   shared variable g#passwd as character no-undo .
       23   define new global shared variable g#lib-trn  as handle no-undo .
       24   define new global shared variable g#lib-trn2 as handle no-undo .
       25   define new global shared variable g#lib-trn3 as handle no-undo .
       26   define new global shared variable g#lib-trn4 as handle no-undo .
       27   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       28   procedure partrqst :
       29     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
       30     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
       31     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
       32     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
       33     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
       34     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
       35     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
       36     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
       37     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
       38     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
       39     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
       40     define output parameter p-total-parts-price-base     as decimal                 no-undo .
       41     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
       42     define output parameter p-total-parts-transport-base as decimal                 no-undo .
       43     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
       44     define output parameter p-total-parts-other-base     as decimal                 no-undo .
       45     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
       46     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
       47     do
       48     on error undo, return error return-value
       49     :
       50       assign
       51         p-total-parts-qnty           = 0
       52         p-total-parts-fact-qnty      = 0
       53         p-total-parts-cli-qnty       = 0
       54         p-total-parts-fact-cli-qnty  = 0
       55         p-total-parts-price-cli      = 0
       56         p-total-parts-price-base     = 0
       57         p-total-parts-price-rubl     = 0
       58         p-total-parts-transport-base = 0
       59         p-total-parts-transport-rubl = 0
       60         p-total-parts-other-base     = 0
       61         p-total-parts-other-rubl     = 0
       62       .
       63       define buffer buf_parts for ub.parts .
       64       for each buf_parts no-lock
       65         where buf_parts.out-code  = p-doc-code
       66           and buf_parts.obj-type  = p-obj-type
       67           and buf_parts.obj-code  = p-obj-code
       68           and buf_parts.artic     = p-artic
       69           and buf_parts.prod-type = p-prod-type
       70           and buf_parts.prod-code = p-prod-code
       71       on error undo, return error return-value
       72       :
       73         define variable v-parts-fact-multiplier as decimal   no-undo .
       74         assign
       75           v-parts-fact-multiplier = 1
       76         .
       77         if buf_parts.qnty <> 0 then do:
       78           assign
       79             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
       80           .
       81         end.
       82         assign
       83           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
       84           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
       85           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
       86           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
       87                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
       88           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
       89           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
       90           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
       91           p-total-parts-transport-base  = p-total-parts-transport-base
       92                                         + buf_parts.fact-qnty
       93                                           * (if   buf_parts.transport-base <> ?
       94                                             then buf_parts.transport-base
       95                                             else 0
       96                                             )
       97           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
       98                                         + buf_parts.fact-qnty
       99                                           * (if   buf_parts.transport-rubl <> ?
      100                                             then buf_parts.transport-rubl
      101                                             else 0
      102                                             )
      103           p-total-parts-other-base      = p-total-parts-other-base
      104                                         + buf_parts.fact-qnty
      105                                           * (if   buf_parts.other-base <> ?
      106                                             then buf_parts.other-base
      107                                             else 0
      108                                             )
      109           p-total-parts-other-rubl      = p-total-parts-other-rubl
      110                                         + buf_parts.fact-qnty
      111                                           * (if   buf_parts.other-rubl <> ?
      112                                             then buf_parts.other-rubl
      113                                             else 0
      114                                             )
      115         .
      116       end.
      117     end.
      118   end procedure.
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
      121     field prt-code         like ub.gds-dtl.prt-code
      122     field rsrv-qnty        like ub.gds-dtl.fact-qnty
      123     field rsrv-out-qnty    like ub.gds-dtl.fact-qnty
      124     index xpk is primary unique prt-code
      125   .
      126   define temp-table temp-trndocrs-pl-gds-rsrv no-undo
      127     field pl-code          like ub.pl-gds.pl-code
      128     field rsrv-qnty        like ub.pl-gds.free-qnty
      129     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
      130     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
      131     field before-free-qnty like ub.pl-gds.fact-qnty
      132     field before-out-qnty  like ub.pl-gds.fact-qnty
      133     field after-free-qnty  like ub.pl-gds.fact-qnty
      134     field after-out-qnty   like ub.pl-gds.fact-qnty
      135     field fact-qnty        like ub.pl-gds.fact-qnty
      136     field cli-qnty         like ub.pl-gds.cli-qnty
      137     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
      138     index xpk is primary unique pl-code
      139   .
      140   procedure trndocrs-gds-dtl-clear :
      141     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      142     do
      143     on error undo, return error return-value
      144     :
      145       for each buf_temp-trndocrs-gds-dtl-rsrv
      146       on error undo, return error return-value
      147       :
      148         delete buf_temp-trndocrs-gds-dtl-rsrv .
      149       end.
      150     end.
      151   end procedure.
      152   procedure trndocrs-pl-gds-clear :
      153     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      154     do
      155     on error undo, return error return-value
      156     :
      157       for each buf_temp-trndocrs-pl-gds-rsrv
      158       on error undo, return error return-value
      159       :
      160         delete buf_temp-trndocrs-pl-gds-rsrv .
      161       end.
      162     end.
      163   end procedure.
      164   procedure trndocrs-clear :
      165     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      166     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      167     do
      168     on error undo, return error return-value
      169     :
      170       for each buf_temp-trndocrs-gds-dtl-rsrv
      171       on error undo, return error return-value
      172       :
      173         delete buf_temp-trndocrs-gds-dtl-rsrv .
      174       end.
      175       for each buf_temp-trndocrs-pl-gds-rsrv
      176       on error undo, return error return-value
      177       :
      178         delete buf_temp-trndocrs-pl-gds-rsrv .
      179       end.
      180     end.
      181   end procedure.
      182   procedure trndocrs-pl-gds-accum :
      183     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
      184     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
      185     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
      186     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
      187     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
      188     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      189     do
      190     on error undo, return error return-value
      191     :
      192       find first buf_temp-trndocrs-pl-gds-rsrv
      193         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      194         no-error .
      195       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      196         create buf_temp-trndocrs-pl-gds-rsrv .
      197         assign
      198           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
      199         .
      200       end.
      201       assign
      202         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
      203         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
      204         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
      205         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
      206       .
      207     end.
      208   end procedure.
      209   procedure trndocrs-gds-dtl-accum :
      210     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
      211     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
      212     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
      213     do
      214     on error undo, return error return-value
      215     :
      216       find first buf_temp-trndocrs-gds-dtl-rsrv
      217         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      218         no-error .
      219       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
      220         create buf_temp-trndocrs-gds-dtl-rsrv .
      221         assign
      222           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
      223         .
      224       end.
      225       assign
      226         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      227                                                + p-rsrv-qnty
      228       .
      229     end.
      230   end procedure.
      231   procedure trndocrs-pl-gds-request :
      232     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      233     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
      234     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
      235     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
      236     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
      237     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
      238     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
      239     define input parameter p-field-accum            as character no-undo .
      240     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
      241     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      242     do
      243     on error undo, return error return-value
      244     :
      245       if lookup(p-field-accum, "before,after":u ) = 0 then do:
      246         message
      247           vss-workfile vss-revision vss-description skip
      248           vss-include-info1 skip
      249           "Ошибка задания входных параметров параметров" skip
      250           "Неизвестное значение параметра" skip
      251           "p-field-accum" p-field-accum skip
      252           view-as alert-box error .
      253         undo, return error return-value .
      254       end.
      255       case p-field-accum :
      256         when "before":u then do:
      257           for each buf_temp-trndocrs-pl-gds-rsrv
      258           on error undo, return error return-value
      259           :
      260             assign
      261               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
      262               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
      263             .
      264           end.
      265         end.
      266         when "after":u then do:
      267           for each buf_temp-trndocrs-pl-gds-rsrv
      268           on error undo, return error return-value
      269           :
      270             assign
      271               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
      272               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
      273             .
      274           end.
      275         end.
      276         otherwise do:
      277           message
      278             vss-workfile vss-revision vss-description skip
      279             vss-include-info1 skip
      280             "Ошибка задания входных параметров параметров" skip
      281             "Неизвестное значение параметра" skip
      282             "p-field-accum" p-field-accum skip
      283             view-as alert-box error .
      284           undo, return error return-value .
      285         end.
      286       end.
      287       define buffer buf_parts for ub.parts.
      288       for each buf_parts no-lock
      289         where buf_parts.out-code  = p-doc-code
      290           and buf_parts.obj-type  = p-obj-type
      291           and buf_parts.obj-code  = p-obj-code
      292           and buf_parts.artic     = p-artic
      293           and buf_parts.prod-type = p-prod-type
      294           and buf_parts.prod-code = p-prod-code
      295       on error undo, return error return-value
      296       :
      297         find first buf_temp-trndocrs-pl-gds-rsrv
      298           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      299           no-error .
      300         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
      301           create buf_temp-trndocrs-pl-gds-rsrv .
      302           assign
      303             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
      304           .
      305         end.
      306         if can-do('при,рас,спи':U, p-doc-type)
      307         or (p-doc-type = 'инв':U
      308             and buf_parts.fact-qnty < 0)
      309         then do:
      310           case p-field-accum :
      311             when "before":u then do:
      312               assign
      313                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      314                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      315                   + abs(buf_parts.fact-qnty)
      316               .
      317             end.
      318             when "after":u then do:
      319               assign
      320                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      321                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      322                   + abs(buf_parts.fact-qnty)
      323               .
      324             end.
      325             otherwise do:
      326               message
      327                 vss-workfile vss-revision vss-description skip
      328                 vss-include-info1 skip
      329                 "Ошибка задания входных параметров параметров" skip
      330                 "Неизвестное значение параметра" skip
      331                 "p-field-accum" p-field-accum skip
      332                 view-as alert-box error .
      333               undo, return error return-value .
      334             end.
      335           end.
      336         end.
      337         else do:
      338           case p-field-accum :
      339             when "before":u then do:
      340               assign
      341                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      342                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      343                   + abs(buf_parts.fact-qnty)
      344               .
      345             end.
      346             when "after":u then do:
      347               assign
      348                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      349                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      350                   + abs(buf_parts.fact-qnty)
      351               .
      352             end.
      353             otherwise do:
      354               message
      355                 vss-workfile vss-revision vss-description skip
      356                 vss-include-info1 skip
      357                 "Ошибка задания входных параметров параметров" skip
      358                 "Неизвестное значение параметра" skip
      359                 "p-field-accum" p-field-accum skip
      360                 view-as alert-box error .
      361               undo, return error return-value .
      362             end.
      363           end.
      364         end.
      365       end.
      366     end.
      367   end procedure.
      368   procedure trndocrs-pl-gds-calc-rsrv :
      369     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
      370     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
      371     do
      372     on error undo, return error return-value
      373     :
      374       for each buf_temp-trndocrs-pl-gds-rsrv
      375       on error undo, return error return-value
      376       :
      377         assign
      378           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      379             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
      380             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
      381           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
      382             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
      383             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
      384         .
      385       end.
      386     end.
      387   end procedure.
      388   procedure trndocrs-need-rsrv :
      389     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
      390     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
      391     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
      392     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
      393     define output parameter p-need-rsrv    as logical   no-undo .
      394     define buffer buf_goods   for ub.goods .
      395     do
      396     on error undo, return error return-value
      397     :
      398       find first buf_goods no-lock
      399         where buf_goods.artic     = p-artic
      400           and buf_goods.prod-type = p-prod-type
      401           and buf_goods.prod-code = p-prod-code
      402         .
      403       if buf_goods.gds-type = 'т':U
      404       and ( p-doc-type = 'рас':U
      405             or p-doc-type = 'спи':U
      406           )
      407       then do:
      408         assign
      409           p-need-rsrv = true
      410         .
      411       end.
      412       else do:
      413         assign
      414           p-need-rsrv = false
      415         .
      416       end.
      417     end.
      418   end procedure.
      419   procedure trndocrs-need-create-doc-pl :
      420     define input  parameter p-extended-doc-type  as character no-undo .
      421     define input  parameter p-news               as logical   no-undo .
      422     define input  parameter p-sale-auto          as logical   no-undo .
      423     define output parameter p-need-create-doc-pl as logical   no-undo .
      424     do
      425     on error undo, return error return-value
      426     :
      427       if  not p-news
      428       and p-extended-doc-type <> 'ie':U
      429       and p-extended-doc-type <> 'es':U
      430       and p-extended-doc-type <> 'rs':U
      431       and not p-sale-auto
      432       then do:
      433         assign
      434           p-need-create-doc-pl = true
      435         .
      436       end.
      437       else do:
      438         assign
      439           p-need-create-doc-pl = false
      440         .
      441       end.
      442     end.
      443   end procedure.
      444   procedure trndocrs-validate :
      445     define input parameter p-place-rsrv as logical no-undo .
      446     define input parameter p-chg-qnty   as decimal no-undo .
      447     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      448     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      449     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
      450     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
      451     assign
      452       v-total-gds-dtl-rsrv-qnty = 0
      453       v-total-pl-gds-rsrv-qnty  = 0
      454     .
      455     do
      456     on error undo, return error return-value
      457     :
      458       for each buf_temp-trndocrs-gds-dtl-rsrv
      459       on error undo, return error return-value
      460       :
      461         assign
      462           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
      463                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      464         .
      465       end.
      466       for each buf_temp-trndocrs-pl-gds-rsrv
      467       on error undo, return error return-value
      468       :
      469         assign
      470           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
      471                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      472         .
      473       end.
      474       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      475         message
      476           vss-workfile vss-revision vss-description skip
      477           vss-include-info1 skip
      478           "Ошибка при резервировании свободных количеств" skip
      479           "Запрошено резервирование:" skip
      480           "По товару" p-chg-qnty skip
      481           "По признакам" v-total-gds-dtl-rsrv-qnty skip
      482           "По складским местам" v-total-pl-gds-rsrv-qnty skip
      483           view-as alert-box error .
      484         undo, return error return-value .
      485       end.
      486       if p-place-rsrv then do:
      487         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
      488           message
      489             vss-workfile vss-revision vss-description skip
      490             vss-include-info1 skip
      491             "Ошибка при резервировании свободных количеств" skip
      492             "Запрошено резервирование:" skip
      493             "По товару" p-chg-qnty skip
      494             "По признакам" v-total-gds-dtl-rsrv-qnty skip
      495             "По складским местам" v-total-pl-gds-rsrv-qnty skip
      496             view-as alert-box error .
      497           undo, return error return-value .
      498         end.
      499       end.
      500     end.
      501   end procedure.
      502   procedure trndocrs :
      503     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
      504     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
      505     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
      506     define input parameter p-artic      like ub.doc-line.artic     no-undo .
      507     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
      508     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
      509     define input parameter p-chg-qnty   as decimal no-undo .
      510     define buffer buf_db         for ub.db .
      511     define buffer buf_gds-obj    for ub.gds-obj .
      512     define buffer buf_prt-obj    for ub.prt-obj .
      513     define buffer buf_gds-prt    for ub.gds-prt .
      514     define buffer buf_goods      for ub.goods .
      515     define buffer buf_pl-gds     for ub.pl-gds .
      516     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
      517     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
      518     define variable v-node-code   like ub.gds-prt.node-code no-undo .
      519     define variable v-curr-db-num like ub.db.db-num         no-undo .
      520     define variable v-cmd         as   character            no-undo .
      521     do
      522     on error undo, return error return-value
      523     :
      524   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      525   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      526     (input  p-obj-type
      527     ,input  p-obj-code
      528     ,input  p-artic
      529     ,input  p-prod-type
      530     ,input  p-prod-code
      531     ,buffer buf_gds-obj
      532     ) no-error .
      533       if error-status :error then do:
      534         message
      535           vss-workfile vss-revision vss-description skip
      536           vss-include-info1 skip
      537           "Ошибка при поиске товара на объекте" skip
      538           "p-obj-type"  p-obj-type  skip
      539           "p-obj-code"  p-obj-code  skip
      540           "p-artic"     p-artic     skip
      541           "p-prod-type" p-prod-type skip
      542           "p-prod-code" p-prod-code skip
      543           error-status :get-message(1) skip
      544           return-value skip
      545           view-as alert-box error .
      546         undo, return error return-value .
      547       end.
      548       find current buf_gds-obj exclusive-lock .
      549       run trndocrs-validate in this-procedure
      550         (input buf_gds-obj.place-rsrv
      551         ,input p-chg-qnty
      552         ) no-error .
      553       if error-status :error then do:
      554         message
      555           vss-workfile vss-revision vss-description skip
      556           vss-include-info1 skip
      557           "Противоречивые данные для резервирования" skip
      558           error-status :get-message(1) skip
      559           return-value skip
      560           view-as alert-box error .
      561         undo, return error return-value .
      562       end.
      563       assign
      564         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
      565         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
      566       .
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      568     (input ?
      569     ,input this-procedure:handle
      570     ,input ?
      571     ,input  'rest-update':U
      572     ,input ?
      573     ,input  buffer buf_gds-obj:handle
      574     ,input 'fact-qnty,free-qnty'
      575     ,input ''
      576     ) no-error .
      577   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      579     (output v-curr-db-num
      580     )  .
      581       find first buf_db no-lock
      582         where buf_db.db-num = v-curr-db-num
      583         .
      584       if buf_db.db-num <> 0
      585         and buf_db.on-line-rest = true
      586       then do:
      587         assign
      588           v-cmd = "command":U + chr(1)
      589                   + "create":U + chr(1)
      590                   + "on-line-rest":U + chr(1)
      591                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
      592                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
      593                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
      594                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
      595                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
      596                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
      597         .
      598         run nws/cr-route.p
      599           ( input 'send-cmd':U
      600             ,input v-cmd
      601             ,input ?
      602             ,input "0":U
      603           ).
      604       end.
      605       if buf_gds-obj.place-rsrv = true then do:
      606         for each buf_temp-trndocrs-pl-gds-rsrv
      607         on error undo, return error return-value
      608         :
      609           find first buf_goods no-lock
      610             where buf_goods.artic     = p-artic
      611               and buf_goods.prod-type = p-prod-type
      612               and buf_goods.prod-code = p-prod-code
      613             no-error .
      614           if not available buf_goods then do:
      615             message
      616               vss-workfile vss-revision vss-description skip
      617               vss-include-info1 skip
      618               "Не найдена товар" skip
      619               "Артикул" p-artic p-prod-type p-prod-code skip
      620               view-as alert-box error .
      621             undo, return error return-value .
      622           end.
      623           find first buf_pl-gds exclusive-lock
      624             where buf_pl-gds.obj-type = p-obj-type
      625               and buf_pl-gds.obj-code = p-obj-code
      626               and buf_pl-gds.gds-code = buf_goods.gds-code
      627               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
      628             no-error .
      629           if not available buf_pl-gds then do:
      630             message
      631               vss-workfile vss-revision vss-description skip
      632               vss-include-info1 skip
      633               "Не найдена привязка товара к складскому месту" skip
      634               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
      635               view-as alert-box error .
      636             undo, return error return-value .
      637           end.
      638           assign
      639             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
      640             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
      641           .
      642           if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
      643             and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
      644           then do:
      645             assign
      646               buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
      647             .
      648           end.
      649         end.
      650       end.
      651       for each buf_temp-trndocrs-gds-dtl-rsrv
      652       on error undo, return error return-value
      653       :
      654   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
      655     (input  buf_temp-trndocrs-gds-dtl-rsrv.prt-code
      656     ,output v-node-code
      657     ) no-error .
      658         if error-status :error then do:
      659           message
      660             vss-workfile vss-revision vss-description skip
      661             vss-include-info1 skip
      662             "Ошибка при определении первого терминального признака" skip
      663             "prt-code" buf_temp-trndocrs-gds-dtl-rsrv.prt-code skip
      664             view-as alert-box error .
      665           undo, return error return-value .
      666         end.
      667         find first buf_gds-prt no-lock
      668           where buf_gds-prt.node-code = v-node-code
      669           .
      670         do while available buf_gds-prt
      671         on error undo, return error return-value
      672         :
      673   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      674   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
      675     (input  p-obj-type
      676     ,input  p-obj-code
      677     ,input  p-artic
      678     ,input  p-prod-type
      679     ,input  p-prod-code
      680     ,input  buf_gds-prt.node-code
      681     ,buffer buf_prt-obj
      682     )  .
      683           find current buf_prt-obj exclusive-lock .
      684           assign
      685             buf_prt-obj.free-qnty = buf_prt-obj.free-qnty - buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
      686           .
      687           assign
      688             v-node-code = buf_gds-prt.upper-code
      689           .
      690           find first buf_gds-prt no-lock
      691             where buf_gds-prt.node-code = v-node-code
      692             no-error .
      693         end.
      694       end.
      695     end.
      696   end procedure.
      697   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      698   define new global shared variable g#lib-calc as handle no-undo .
      699   define input parameter parparentproc AS WIDGET-HANDLE NO-UNDO.
      700   define parameter buffer buf_doc-line        for ub.doc-line.
      701   define input parameter  v-chg-free-qnty as decimal no-undo .
      702   define input parameter  v-chg-out-qnty  as decimal no-undo .
      703   define input parameter table for temp-trndocrs-gds-dtl-rsrv .
      704   define input parameter table for temp-trndocrs-pl-gds-rsrv .
      705   procedure vss-get-info :
      706     define output parameter p-vss-revision    like vss-revision    no-undo .
      707     define output parameter p-vss-author      like vss-author      no-undo .
      708     define output parameter p-vss-date        like vss-date        no-undo .
      709     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      710     define output parameter p-vss-archive     like vss-archive     no-undo .
      711     define output parameter p-vss-description like vss-description no-undo .
      712     assign
      713       p-vss-revision    = vss-revision
      714       p-vss-author      = vss-author
      715       p-vss-date        = vss-date
      716       p-vss-workfile    = vss-workfile
      717       p-vss-archive     = vss-archive
      718       p-vss-description = vss-description
      719     .
      720   end procedure.
      721   procedure vss-get-parameters :
      722     define output parameter p-vss-parameters as character no-undo .
      723       assign
      724         p-vss-parameters = substitute('&1|&2',v-chg-free-qnty,v-chg-out-qnty)
      725       .
      726   end procedure.
      727   define new global shared variable g#vssrevis-logger as handle    no-undo .
      728   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      729   define variable v-vssrevis-logger                   as handle    no-undo .
      730   procedure vss-logevent :
      731     define input  parameter p-extra-paramters as character no-undo .
      732     define variable v-vssrevis-parameters as character no-undo .
      733     do
      734     on error undo, return error return-value
      735     :
      736       if  valid-handle(v-vssrevis-logger)
      737       and v-vssrevis-logger :get-signature("logevent") <> ""
      738       then do:
      739         run vss-get-parameters in this-procedure
      740           (output v-vssrevis-parameters
      741           ).
      742         run logevent in v-vssrevis-logger
      743           (input vss-workfile
      744           ,input vss-revision
      745           ,input v-vssrevis-parameters
      746           ,input p-extra-paramters
      747           ).
      748       end.
      749     end.
      750   end procedure.
      751   assign
      752     v-vssrevis-logger = g#vssrevis-logger
      753   .
      754   if  valid-handle(v-vssrevis-logger)
      755   and v-vssrevis-logger :get-signature("logevent") <> ""
      756   then do:
      757     assign
      758       v-vssrevis-logevent = true
      759     .
      760     run vss-logevent in this-procedure (input vss-description) .
      761   end.
      762   define variable v-root-node             like ub.gds-dtl.prt-code no-undo .
      763   define variable l-cr-root-gds-dtl       as   logical             no-undo .
      764   define variable l-need-update-inventory as   logical             no-undo .
      765   define variable l-goods-twounit         as   logical             no-undo .
      766   main-block:
      767   do
      768   on error undo main-block, return error
      769   :
      770     define variable v-check-qnty like ub.doc-line.doc-qnty no-undo .
      771     assign
      772       v-check-qnty = v-chg-free-qnty
      773     .
      774     if v-check-qnty <> v-chg-free-qnty then do:
      775       message
      776         vss-workfile vss-revision vss-description skip
      777         "Запрошено резервирование дробного количества" skip
      778         "Запрошено резервирование v-chg-free-qnty" v-chg-free-qnty skip
      779         "После округления это составит" v-check-qnty skip
      780         view-as alert-box .
      781       undo, return error .
      782     end.
      783     assign
      784       v-check-qnty = v-chg-out-qnty
      785     .
      786     if v-check-qnty <> v-chg-out-qnty then do:
      787       message
      788         vss-workfile vss-revision vss-description skip
      789         "Запрошено резервирование дробного количества" skip
      790         "Запрошено резервирование v-chg-out-qnty" v-chg-out-qnty skip
      791         "После округления это составит" v-check-qnty skip
      792         view-as alert-box .
      793       undo, return error .
      794     end.
      795     find first ub.goods no-lock
      796       where ub.goods.artic     = buf_doc-line.artic
      797         and ub.goods.prod-type = buf_doc-line.prod-type
      798         and ub.goods.prod-code = buf_doc-line.prod-code
      799       .
      800     find first ub.trn-doc no-lock
      801       where ub.trn-doc.doc-code = buf_doc-line.doc-code
      802       .
      803   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      805     (input  ub.goods.artic
      806     ,input  ub.goods.prod-type
      807     ,input  ub.goods.prod-code
      808     ,output v-root-node
      809     ) no-error .
      810     if error-status :error then do:
      811       message
      812         vss-workfile vss-revision vss-description skip
      813         "Ошибка при определении корневого признака шкалы" skip
      814         "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      815         error-status :get-message(1) skip
      816         return-value skip
      817         view-as alert-box error .
      818       undo, return error .
      819     end.
      820   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      822     (input  ub.trn-doc.obj-type
      823     ,input  ub.trn-doc.obj-code
      824     ,input  ub.goods.artic
      825     ,input  ub.goods.prod-type
      826     ,input  ub.goods.prod-code
      827     ,input  'cr-root-gds-dtl=request':u
      828     ,output l-cr-root-gds-dtl
      829     ) no-error .
      830     if error-status :error then do:
      831       message
      832         vss-workfile vss-revision vss-description skip
      833         "Ошибка при определении признака товара на объекте" skip
      834         "Объект" ub.trn-doc.obj-type ub.trn-doc.obj-code skip
      835         "Артикул" ub.goods.artic ub.goods.prod-type ub.goods.prod-code skip
      836         "Запрашиваемый атрибут" 'cr-root-gds-dtl=request':u skip
      837         error-status :get-message(1) skip
      838         return-value skip
      839         view-as alert-box error .
      840       undo, return error .
      841     end.
      842     if ub.trn-doc.status_ = 'запрос':U then do:
      843       if v-chg-free-qnty <> 0
      844       or v-chg-out-qnty <> 0
      845       then do:
      846         message
      847           vss-workfile vss-revision vss-description skip
      848           "Резервирование товара недопустимо для документов в статусе" 'запрос':U skip
      849           view-as alert-box error .
      850         undo, return error .
      851       end.
      852       else do:
      853         return .
      854       end.
      855     end.
      856       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
      857     run partrqst in this-procedure
      858       (input  buf_doc-line.doc-code
      859       ,input  buf_doc-line.obj-type
      860       ,input  buf_doc-line.obj-code
      861       ,input  buf_doc-line.artic
      862       ,input  buf_doc-line.prod-type
      863       ,input  buf_doc-line.prod-code
      864           ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
      865       ) no-error .
      866     if error-status :error then do:
