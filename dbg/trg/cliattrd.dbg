      363   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   procedure cur-time :
      365      define output parameter p-today as date      no-undo .
      366      define output parameter p-time  as integer   no-undo .
      367     do
      368     on error undo, return error
      369     :
      370       define variable v-date1 as date      no-undo .
      371       define variable v-date2 as date      no-undo .
      372       define variable v-time  as integer   no-undo .
      373       assign
      374         v-date1 = today
      375         v-time  = time
      376         v-date2 = today
      377       .
      378       if v-date1 <> v-date2
      379       then do:
      380         assign
      381           v-date1 = today
      382           v-time  = v-time
      383         .
      384       end.
      385       assign
      386         p-today = v-date1
      387         p-time  = v-time
      388       .
      389     end.
      390   end.
      391   function cur-time-date returns character
      392   :
      393     return string(today, '99/99/9999':U) .
      394   end.
      395   function cur-time-mjd returns decimal
      396   :
      397     define variable v-date as date      no-undo .
      398     define variable v-time as integer   no-undo .
      399     run cur-time in this-procedure
      400       (output v-date
      401       ,output v-time
      402       ) .
      403     return integer(v-date) - 2400002 + (v-time / 86400) .
      404   end.
      405   function cur-time-get-ending-index returns integer
      406   (input p-number as integer
      407   )
      408   :
      409     if p-number < 0
      410     or p-number = ?
      411     then do:
      412       return 1 .
      413     end.
      414     define variable v-rest as integer   no-undo .
      415     assign
      416       p-number = p-number modulo 100
      417     .
      418     if p-number < 20
      419     then do:
      420       assign
      421         v-rest = p-number
      422       .
      423     end.
      424     else do:
      425       assign
      426         v-rest = p-number modulo 10
      427       .
      428     end.
      429     case v-rest :
      430       when 1
      431       then do:
      432         return 2 .
      433       end.
      434       when 2 or
      435       when 3 or
      436       when 4
      437       then do:
      438         return 3 .
      439       end.
      440       otherwise do:
      441         return 1 .
      442       end.
      443     end case .
      444   end.
      445   procedure cur-time-mjd-to-date :
      446      define input  parameter i-mjd-diff as decimal no-undo.
      447      define output parameter o-Date     as date    no-undo.
      448      define output parameter o-Time     as integer no-undo.
      449      define variable v-day-number as integer   no-undo .
      450      if    i-mjd-diff < 0
      451         or i-mjd-diff = ?
      452      then do:
      453         return "?" .
      454      end.
      455      assign
      456         v-day-number = truncate(i-mjd-diff,0).
      457         o-Date = date(v-day-number + 2400002).
      458         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      459     .
      460   end.
      461   function cur-time-mjd-to-string returns character
      462   (input p-mjd-diff as decimal
      463   )
      464   :
      465     define variable v-day-number as integer   no-undo .
      466     define variable v-seconds    as integer   no-undo .
      467     define variable v-hour       as integer   no-undo .
      468     define variable v-min        as integer   no-undo .
      469     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      470     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      471     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      472     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      473     if p-mjd-diff < 0
      474     or p-mjd-diff = ?
      475     then do:
      476       return "?" .
      477     end.
      478     assign
      479       v-day-number = integer(truncate(p-mjd-diff,0))
      480       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      481     .
      482     if v-seconds > 86400
      483     then do:
      484       assign
      485         v-seconds = 86400 - 1
      486       .
      487     end.
      488     if v-seconds < 0
      489     then do:
      490       assign
      491         v-seconds = 0
      492       .
      493     end.
      494     assign
      495       v-hour = truncate(v-seconds / 3600, 0)
      496     .
      497     assign
      498       v-seconds = v-seconds modulo 3600
      499     .
      500     assign
      501       v-min = truncate(v-seconds / 60, 0)
      502     .
      503     assign
      504       v-seconds = v-seconds modulo 60
      505     .
      506     return
      507         (if v-day-number <> 0
      508           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      509           else ""
      510         )
      511       + (if v-day-number <> 0 or v-hour <> 0
      512           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      513           else ""
      514         )
      515       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      516           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      517           else ""
      518         )
      519       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      520       .
      521   end.
      522   function cur-time-string returns character
      523   :
      524     define variable v-date as date      no-undo .
      525     define variable v-time as integer   no-undo .
      526     run cur-time in this-procedure
      527       (output v-date
      528       ,output v-time
      529       ) .
      530     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      531   end.
      532   function cur-time-string-sec returns character
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      541   end.
      542   function cur-time-custom  returns character
      543   (input p-prefix as character
      544   ,input p-date-format as character
      545   ,input p-delimiter as character
      546   ,input p-time-format as character
      547   ,input p-suffix as character
      548   )
      549   :
      550     define variable v-date as date      no-undo .
      551     define variable v-time as integer   no-undo .
      552     run cur-time in this-procedure
      553       (output v-date
      554       ,output v-time
      555       ) .
      556     return
      557       p-prefix
      558       + string(v-date, p-date-format)
      559       + p-delimiter
      560       + string(v-time, p-time-format)
      561       + p-suffix
      562       .
      563   end.
      564   function cur-time-print  returns character
      565   :
      566     define variable v-date as date      no-undo .
      567     define variable v-time as integer   no-undo .
      568     run cur-time in this-procedure
      569       (output v-date
      570       ,output v-time
      571       ) .
      572     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      573   end.
      574   function cur-time-datetime returns datetime
      575   :
      576     define variable v-char as character no-undo .
      577     define variable v-datetime as datetime no-undo .
      578     v-char = cur-time-string().
      579     v-datetime = datetime(v-char).
      580     return  v-datetime.
      581   end.
      582   function cur-time-string-msec returns character
      583   :
      584     define variable v-date as datetime  no-undo .
      585     v-date = now.
      586     return string(v-date) .
      587   end.
      588   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   define new global shared variable g#lib-nws as handle no-undo .
      590   define variable p-news as logical no-undo.
      591   define variable v-archive-attr-list as character no-undo .
      592   define variable v-date as date no-undo .
      593   define variable v-time as integer no-undo .
      594   define variable v-host-code like ub.sysconf.host-code no-undo .
      595   define buffer buf_c-clients-attr for ub.c-clients-attr.
      596   define buffer buf_c-cli-hist for ub.c-cli-hist.
      597   main-block:
      598   do
      599   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      600   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      601   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      602   :
      603     run clntattr-news in this-procedure(input ub.clients-attr.attr-code,
      604                                         output p-news) no-error.
      605     run clntattr-get-archive-attr in this-procedure (output v-archive-attr-list ) .
      606     if LOOKUP(ub.clients-attr.attr-code, v-archive-attr-list) = 0  then do:
      607       if g#news then do:
      608         define variable v-send as integer no-undo .
      609         v-send = integer('0':U).
      610   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      612     (input  g#db-num
      613     ,input  'clients-attr':U
      614     ,input  0
      615     ,input  '':U
      616     ,input  0
      617     ,input  '':U
      618     ,input  '':U
      619     ,input  '':U
      620     ,input  0
      621     ,input  0
      622     ,input  0
      623     ,input  'nws-to-hist'
      624     ,output v-send
      625     ) no-error .
      626       end.
      627       if not g#news
      628       or v-send >= 0 then do:
      629         run cur-time in this-procedure(output v-date, output v-time).
      630         create buf_c-clients-attr.
      631         buffer-copy ub.clients-attr to buf_c-clients-attr
      632         assign
      633         buf_c-clients-attr.chip-num           = next-value (s-cli-chip, ub)
      634         buf_c-clients-attr.corr-time          = v-time
      635         buf_c-clients-attr.corr-user-db-num   = g#db-num
      636         buf_c-clients-attr.corr-user-name     = (if g#news
      637                                          then (chr(4) +  'СПН':U)
      638                                          else (if g#esys
      639                                                then (chr(4) +  'ВС':U)
      640                                                else g#userid)
      641                                          )
      642         buf_c-clients-attr.corr-date          = v-date
      643         .
      644         if ub.clients-attr.obj-type = 'маг':U
      645         or ub.clients-attr.obj-type = 'скл':U then do:
      646   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      647   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      648     (input  ub.clients-attr.obj-type
      649     ,input  ub.clients-attr.obj-code
      650     ,output v-host-code
      651     )  .
      652         end.
      653         create buf_c-cli-hist.
      654         buffer-copy buf_c-clients-attr to buf_c-cli-hist
      655         assign
      656         buf_c-cli-hist.action = integer('99':U)
      657         buf_c-cli-hist.subject = 'clients-attr':U
      658         buf_c-cli-hist.host-code = v-host-code
      659         buf_c-cli-hist.is-news = g#news
      660         buf_c-cli-hist.source-type = (if g#news
      661                                       then 'db':U
      662                                       else (if g#esys
      663                                             then 'esys':U
      664                                             else "":U)
      665                                       )
      666         buf_c-cli-hist.source-ref = (if g#news
      667                                      then string(g#news-source-db)
      668                                      else (if g#esys
      669                                            then string(g#esys-source-esys)
      670                                            else "":U)
      671                                      )
      672         .
      673       end.
      674     end.
      675     if p-news then do:
      676       run nws/cmd-del.p
      677         ( input 'clients-attr':U
      678          ,input (buffer ub.clients-attr:handle)
      679          ,input "":U
      680         ) no-error .
      681       if error-status :error then do:
      682         return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      683       end.
      684     end.
      685       if g#oxml = yes
      686       then do:
      687       run str/calloxml.p (
      688             input 'delete':U
      689           , input 'clients-attr':U
      690           , input ( buffer ub.clients-attr:handle )
      691       ) no-error.
      692       if error-status :error
      693       then do:
      694           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      695                               , chr(10)
      696                               , vss-workfile
      697                               , return-value
      698                               , error-status :get-message ( 1 ) ).
      699       end.
      700       end.
      701   end.
