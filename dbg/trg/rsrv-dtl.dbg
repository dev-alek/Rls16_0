     7450           then do:
     7451             assign
     7452               v-iteration-chg-qnty = p-chg-qnty
     7453             .
     7454             if v-find-first = true
     7455             then do:
     7456               assign
     7457                 v-find-first = false
     7458               .
     7459               if p-mark <> ""
     7460               or v-mark-alchol
     7461               then do :
     7462                 find first tt-marks no-error .
     7463                 assign
     7464                   v-iteration-chg-qnty = v-chg-qnty-sign
     7465                 .
     7466                 find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     7467                                                   and buf_gen-attr.attr-code = (if available tt-marks then tt-marks.mark else p-mark)
     7468                                                   and num-entries(buf_gen-attr.p-key, chr(3)) >= 8
     7469                                                   and entry(8, buf_gen-attr.p-key, chr(3)) = v-rsrv-code
     7470                                                   and entry(2, buf_gen-attr.p-key, chr(3)) = buf_doc-line.obj-type
     7471                                                   and integer(entry(3, buf_gen-attr.p-key, chr(3))) = buf_doc-line.obj-code
     7472                                                   no-error .
