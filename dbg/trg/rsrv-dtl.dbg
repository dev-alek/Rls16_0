     1799           buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
     1800         .
     1801       end.
     1802       assign
     1803         buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty = buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     1804                                                + p-rsrv-qnty
     1805       .
     1806     end.
     1807   end procedure.
     1808   procedure trndocrs-pl-gds-request :
     1809     define input parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
     1810     define input parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
     1811     define input parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
     1812     define input parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
     1813     define input parameter p-artic                  like ub.doc-line.artic     no-undo .
     1814     define input parameter p-prod-type              like ub.doc-line.prod-type no-undo .
     1815     define input parameter p-prod-code              like ub.doc-line.prod-code no-undo .
     1816     define input parameter p-field-accum            as character no-undo .
     1817     define variable vss-description as character no-undo init "trndocrs-pl-gds-request: Сбор информации о партиях на складских местах".
     1818     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
     1819     do
     1820     on error undo, return error return-value
     1821     :
     1822       if lookup(p-field-accum, "before,after":u ) = 0 then do:
     1823         message
     1824           vss-workfile vss-revision vss-description skip
     1825           vss-include-info20 skip
     1826           "Ошибка задания входных параметров параметров" skip
     1827           "Неизвестное значение параметра" skip
     1828           "p-field-accum" p-field-accum skip
     1829           view-as alert-box error .
     1830         undo, return error return-value .
     1831       end.
     1832       case p-field-accum :
     1833         when "before":u then do:
     1834           for each buf_temp-trndocrs-pl-gds-rsrv
     1835           on error undo, return error return-value
     1836           :
     1837             assign
     1838               buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty = 0
     1839               buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty  = 0
     1840             .
     1841           end.
     1842         end.
     1843         when "after":u then do:
     1844           for each buf_temp-trndocrs-pl-gds-rsrv
     1845           on error undo, return error return-value
     1846           :
     1847             assign
     1848               buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty  = 0
     1849               buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty   = 0
     1850             .
     1851           end.
     1852         end.
     1853         otherwise do:
     1854           message
     1855             vss-workfile vss-revision vss-description skip
     1856             vss-include-info20 skip
     1857             "Ошибка задания входных параметров параметров" skip
     1858             "Неизвестное значение параметра" skip
     1859             "p-field-accum" p-field-accum skip
     1860             view-as alert-box error .
     1861           undo, return error return-value .
     1862         end.
     1863       end.
     1864       define buffer buf_parts for ub.parts.
     1865       for each buf_parts no-lock
     1866         where buf_parts.out-code  = p-doc-code
     1867           and buf_parts.obj-type  = p-obj-type
     1868           and buf_parts.obj-code  = p-obj-code
     1869           and buf_parts.artic     = p-artic
     1870           and buf_parts.prod-type = p-prod-type
     1871           and buf_parts.prod-code = p-prod-code
     1872       on error undo, return error return-value
     1873       :
     1874         find first buf_temp-trndocrs-pl-gds-rsrv
     1875           where buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
     1876           no-error .
     1877         if not available buf_temp-trndocrs-pl-gds-rsrv then do:
     1878           create buf_temp-trndocrs-pl-gds-rsrv .
     1879           assign
     1880             buf_temp-trndocrs-pl-gds-rsrv.pl-code = buf_parts.pl-code
     1881           .
     1882         end.
     1883         if can-do('при,рас,спи':U, p-doc-type)
     1884         or (p-doc-type = 'инв':U
     1885             and buf_parts.fact-qnty < 0)
     1886         then do:
     1887           case p-field-accum :
     1888             when "before":u then do:
     1889               assign
     1890                 buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     1891                   = buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     1892                   + abs(buf_parts.fact-qnty)
     1893               .
     1894             end.
     1895             when "after":u then do:
     1896               assign
     1897                 buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     1898                   = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     1899                   + abs(buf_parts.fact-qnty)
     1900               .
     1901             end.
     1902             otherwise do:
     1903               message
     1904                 vss-workfile vss-revision vss-description skip
     1905                 vss-include-info20 skip
     1906                 "Ошибка задания входных параметров параметров" skip
     1907                 "Неизвестное значение параметра" skip
     1908                 "p-field-accum" p-field-accum skip
     1909                 view-as alert-box error .
     1910               undo, return error return-value .
     1911             end.
     1912           end.
     1913         end.
     1914         else do:
     1915           case p-field-accum :
     1916             when "before":u then do:
     1917               assign
     1918                 buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     1919                   = buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     1920                   + abs(buf_parts.fact-qnty)
     1921               .
     1922             end.
     1923             when "after":u then do:
     1924               assign
     1925                 buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     1926                   = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     1927                   + abs(buf_parts.fact-qnty)
     1928               .
     1929             end.
     1930             otherwise do:
     1931               message
     1932                 vss-workfile vss-revision vss-description skip
     1933                 vss-include-info20 skip
     1934                 "Ошибка задания входных параметров параметров" skip
     1935                 "Неизвестное значение параметра" skip
     1936                 "p-field-accum" p-field-accum skip
     1937                 view-as alert-box error .
     1938               undo, return error return-value .
     1939             end.
     1940           end.
     1941         end.
     1942       end.
     1943     end.
     1944   end procedure.
     1945   procedure trndocrs-pl-gds-calc-rsrv :
     1946     define variable vss-description as character no-undo init "trndocrs-pl-gds-calc-rsrv: Сбор информации о партиях на складских местах".
     1947     define buffer buf_temp-trndocrs-pl-gds-rsrv for temp-trndocrs-pl-gds-rsrv .
     1948     do
     1949     on error undo, return error return-value
     1950     :
     1951       for each buf_temp-trndocrs-pl-gds-rsrv
     1952       on error undo, return error return-value
     1953       :
     1954         assign
     1955           buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     1956             = buf_temp-trndocrs-pl-gds-rsrv.after-free-qnty
     1957             - buf_temp-trndocrs-pl-gds-rsrv.before-free-qnty
     1958           buf_temp-trndocrs-pl-gds-rsrv.rsrv-out-qnty
     1959             = buf_temp-trndocrs-pl-gds-rsrv.after-out-qnty
     1960             - buf_temp-trndocrs-pl-gds-rsrv.before-out-qnty
     1961         .
     1962       end.
     1963     end.
     1964   end procedure.
     1965   procedure trndocrs-need-rsrv :
     1966     define input  parameter p-doc-type     like ub.trn-doc.doc-type no-undo .
     1967     define input  parameter p-artic        like ub.doc-line.artic     no-undo .
     1968     define input  parameter p-prod-type    like ub.doc-line.prod-type no-undo .
     1969     define input  parameter p-prod-code    like ub.doc-line.prod-code no-undo .
     1970     define output parameter p-need-rsrv    as logical   no-undo .
     1971     define buffer buf_goods   for ub.goods .
     1972     do
     1973     on error undo, return error return-value
     1974     :
     1975       find first buf_goods no-lock
     1976         where buf_goods.artic     = p-artic
     1977           and buf_goods.prod-type = p-prod-type
     1978           and buf_goods.prod-code = p-prod-code
     1979         .
     1980       if buf_goods.gds-type = 'т':U
     1981       and ( p-doc-type = 'рас':U
     1982             or p-doc-type = 'спи':U
     1983           )
     1984       then do:
     1985         assign
     1986           p-need-rsrv = true
     1987         .
     1988       end.
     1989       else do:
     1990         assign
     1991           p-need-rsrv = false
     1992         .
     1993       end.
     1994     end.
     1995   end procedure.
     1996   procedure trndocrs-need-create-doc-pl :
     1997     define input  parameter p-extended-doc-type  as character no-undo .
     1998     define input  parameter p-news               as logical   no-undo .
     1999     define input  parameter p-sale-auto          as logical   no-undo .
     2000     define output parameter p-need-create-doc-pl as logical   no-undo .
     2001     do
     2002     on error undo, return error return-value
     2003     :
     2004       if  not p-news
     2005       and p-extended-doc-type <> 'ie':U
     2006       and p-extended-doc-type <> 'es':U
     2007       and p-extended-doc-type <> 'rs':U
     2008       and not p-sale-auto
     2009       then do:
     2010         assign
     2011           p-need-create-doc-pl = true
     2012         .
     2013       end.
     2014       else do:
     2015         assign
     2016           p-need-create-doc-pl = false
     2017         .
     2018       end.
     2019     end.
     2020   end procedure.
     2021   procedure trndocrs-validate :
     2022     define input parameter p-place-rsrv as logical no-undo .
     2023     define input parameter p-chg-qnty   as decimal no-undo .
     2024     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     2025     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     2026     define variable v-total-gds-dtl-rsrv-qnty as decimal no-undo .
     2027     define variable v-total-pl-gds-rsrv-qnty as decimal no-undo .
     2028     assign
     2029       v-total-gds-dtl-rsrv-qnty = 0
     2030       v-total-pl-gds-rsrv-qnty  = 0
     2031     .
     2032     do
     2033     on error undo, return error return-value
     2034     :
     2035       for each buf_temp-trndocrs-gds-dtl-rsrv
     2036       on error undo, return error return-value
     2037       :
     2038         assign
     2039           v-total-gds-dtl-rsrv-qnty = v-total-gds-dtl-rsrv-qnty
     2040                                     + buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     2041         .
     2042       end.
     2043       for each buf_temp-trndocrs-pl-gds-rsrv
     2044       on error undo, return error return-value
     2045       :
     2046         assign
     2047           v-total-pl-gds-rsrv-qnty = v-total-pl-gds-rsrv-qnty
     2048                                    + buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     2049         .
     2050       end.
     2051       if round(v-total-gds-dtl-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     2052         message
     2053           vss-workfile vss-revision vss-description skip
     2054           vss-include-info20 skip
     2055           "Ошибка при резервировании свободных количеств" skip
     2056           "Запрошено резервирование:" skip
     2057           "По товару" p-chg-qnty skip
     2058           "По признакам" v-total-gds-dtl-rsrv-qnty skip
     2059           "По складским местам" v-total-pl-gds-rsrv-qnty skip
     2060           view-as alert-box error .
     2061         undo, return error return-value .
     2062       end.
     2063       if p-place-rsrv then do:
     2064         if round(v-total-pl-gds-rsrv-qnty, 0) <> round(p-chg-qnty, 0) then do:
     2065           message
     2066             vss-workfile vss-revision vss-description skip
     2067             vss-include-info20 skip
     2068             "Ошибка при резервировании свободных количеств" skip
     2069             "Запрошено резервирование:" skip
     2070             "По товару" p-chg-qnty skip
     2071             "По признакам" v-total-gds-dtl-rsrv-qnty skip
     2072             "По складским местам" v-total-pl-gds-rsrv-qnty skip
     2073             view-as alert-box error .
     2074           undo, return error return-value .
     2075         end.
     2076       end.
     2077     end.
     2078   end procedure.
     2079   procedure trndocrs :
     2080     define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
     2081     define input parameter p-obj-type   like ub.doc-line.obj-type  no-undo .
     2082     define input parameter p-obj-code   like ub.doc-line.obj-code  no-undo .
     2083     define input parameter p-artic      like ub.doc-line.artic     no-undo .
     2084     define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
     2085     define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
     2086     define input parameter p-chg-qnty   as decimal no-undo .
     2087     define buffer buf_db         for ub.db .
     2088     define buffer buf_gds-obj    for ub.gds-obj .
     2089     define buffer buf_prt-obj    for ub.prt-obj .
     2090     define buffer buf_gds-prt    for ub.gds-prt .
     2091     define buffer buf_goods      for ub.goods .
     2092     define buffer buf_pl-gds     for ub.pl-gds .
     2093     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     2094     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     2095     define variable v-node-code   like ub.gds-prt.node-code no-undo .
     2096     define variable v-curr-db-num like ub.db.db-num         no-undo .
     2097     define variable v-cmd         as   character            no-undo .
     2098     do
     2099     on error undo, return error return-value
     2100     :
     2101   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2102   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2103     (input  p-obj-type
     2104     ,input  p-obj-code
     2105     ,input  p-artic
     2106     ,input  p-prod-type
     2107     ,input  p-prod-code
     2108     ,buffer buf_gds-obj
     2109     ) no-error .
     2110       if error-status :error then do:
     2111         message
     2112           vss-workfile vss-revision vss-description skip
     2113           vss-include-info20 skip
     2114           "Ошибка при поиске товара на объекте" skip
     2115           "p-obj-type"  p-obj-type  skip
     2116           "p-obj-code"  p-obj-code  skip
     2117           "p-artic"     p-artic     skip
     2118           "p-prod-type" p-prod-type skip
     2119           "p-prod-code" p-prod-code skip
     2120           error-status :get-message(1) skip
     2121           return-value skip
     2122           view-as alert-box error .
     2123         undo, return error return-value .
     2124       end.
     2125       find current buf_gds-obj exclusive-lock .
     2126       run trndocrs-validate in this-procedure
     2127         (input buf_gds-obj.place-rsrv
     2128         ,input p-chg-qnty
     2129         ) no-error .
     2130       if error-status :error then do:
     2131         message
     2132           vss-workfile vss-revision vss-description skip
     2133           vss-include-info20 skip
     2134           "Противоречивые данные для резервирования" skip
     2135           error-status :get-message(1) skip
     2136           return-value skip
     2137           view-as alert-box error .
     2138         undo, return error return-value .
     2139       end.
     2140       assign
     2141         buf_gds-obj.free-qnty   = buf_gds-obj.free-qnty - p-chg-qnty
     2142         buf_gds-obj.on-line-rest = buf_gds-obj.free-qnty
     2143       .
     2144   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     2145     (input ?
     2146     ,input this-procedure:handle
     2147     ,input ?
     2148     ,input  'rest-update':U
     2149     ,input ?
     2150     ,input  buffer buf_gds-obj:handle
     2151     ,input 'fact-qnty,free-qnty'
     2152     ,input ''
     2153     ) no-error .
     2154   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2155   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2156     (output v-curr-db-num
     2157     )  .
     2158       find first buf_db no-lock
     2159         where buf_db.db-num = v-curr-db-num
     2160         .
     2161       if buf_db.db-num <> 0
     2162         and buf_db.on-line-rest = true
     2163       then do:
     2164         assign
     2165           v-cmd = "command":U + chr(1)
     2166                   + "create":U + chr(1)
     2167                   + "on-line-rest":U + chr(1)
     2168                   + substitute( "&1", buf_gds-obj.obj-type ) + chr(1)
     2169                   + substitute( "&1", buf_gds-obj.obj-code ) + chr(1)
     2170                   + substitute( "&1", buf_gds-obj.artic ) + chr(1)
     2171                   + substitute( "&1", buf_gds-obj.prod-type ) + chr(1)
     2172                   + substitute( "&1", buf_gds-obj.prod-code ) + chr(1)
     2173                   + substitute( "&1", buf_gds-obj.free-qnty ) + chr(1)
     2174         .
     2175         run nws/cr-route.p
     2176           ( input 'send-cmd':U
     2177             ,input v-cmd
     2178             ,input ?
     2179             ,input "0":U
     2180           ).
     2181       end.
     2182       if buf_gds-obj.place-rsrv = true then do:
     2183         for each buf_temp-trndocrs-pl-gds-rsrv
     2184         on error undo, return error return-value
     2185         :
     2186           find first buf_goods no-lock
     2187             where buf_goods.artic     = p-artic
     2188               and buf_goods.prod-type = p-prod-type
     2189               and buf_goods.prod-code = p-prod-code
     2190             no-error .
     2191           if not available buf_goods then do:
     2192             message
     2193               vss-workfile vss-revision vss-description skip
     2194               vss-include-info20 skip
     2195               "Не найдена товар" skip
     2196               "Артикул" p-artic p-prod-type p-prod-code skip
     2197               view-as alert-box error .
     2198             undo, return error return-value .
     2199           end.
     2200           find first buf_pl-gds exclusive-lock
     2201             where buf_pl-gds.obj-type = p-obj-type
     2202               and buf_pl-gds.obj-code = p-obj-code
     2203               and buf_pl-gds.gds-code = buf_goods.gds-code
     2204               and buf_pl-gds.pl-code  = buf_temp-trndocrs-pl-gds-rsrv.pl-code
     2205             no-error .
     2206           if not available buf_pl-gds then do:
     2207             message
     2208               vss-workfile vss-revision vss-description skip
     2209               vss-include-info20 skip
     2210               "Не найдена привязка товара к складскому месту" skip
     2211               "Код товара" buf_temp-trndocrs-pl-gds-rsrv.pl-code skip
     2212               view-as alert-box error .
     2213             undo, return error return-value .
     2214           end.
     2215           assign
     2216             buf_pl-gds.free-qnty     = buf_pl-gds.free-qnty     - buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty
     2217             buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-free-qnty - buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty
     2218           .
     2219           if buf_pl-gds.free-qnty = buf_pl-gds.fact-qnty
     2220             and absolute( buf_pl-gds.cli-free-qnty - buf_pl-gds.cli-fact-qnty ) <= 0.01
     2221           then do:
     2222             assign
     2223               buf_pl-gds.cli-free-qnty = buf_pl-gds.cli-fact-qnty
     2224             .
     2225           end.
     2226         end.
     2227       end.
     2228       for each buf_temp-trndocrs-gds-dtl-rsrv
     2229       on error undo, return error return-value
     2230       :
     2231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2232     (input  buf_temp-trndocrs-gds-dtl-rsrv.prt-code
     2233     ,output v-node-code
     2234     ) no-error .
     2235         if error-status :error then do:
     2236           message
     2237             vss-workfile vss-revision vss-description skip
     2238             vss-include-info20 skip
     2239             "Ошибка при определении первого терминального признака" skip
     2240             "prt-code" buf_temp-trndocrs-gds-dtl-rsrv.prt-code skip
     2241             view-as alert-box error .
     2242           undo, return error return-value .
     2243         end.
     2244         find first buf_gds-prt no-lock
     2245           where buf_gds-prt.node-code = v-node-code
     2246           .
     2247         do while available buf_gds-prt
     2248         on error undo, return error return-value
     2249         :
     2250   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2251   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
     2252     (input  p-obj-type
     2253     ,input  p-obj-code
     2254     ,input  p-artic
     2255     ,input  p-prod-type
     2256     ,input  p-prod-code
     2257     ,input  buf_gds-prt.node-code
     2258     ,buffer buf_prt-obj
     2259     )  .
     2260           find current buf_prt-obj exclusive-lock .
     2261           assign
     2262             buf_prt-obj.free-qnty = buf_prt-obj.free-qnty - buf_temp-trndocrs-gds-dtl-rsrv.rsrv-qnty
     2263           .
     2264           assign
     2265             v-node-code = buf_gds-prt.upper-code
     2266           .
     2267           find first buf_gds-prt no-lock
     2268             where buf_gds-prt.node-code = v-node-code
     2269             no-error .
     2270         end.
     2271       end.
     2272     end.
     2273   end procedure.
     2274   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2275   function octal-to-char return character
     2276   ( p-string as character ) :
     2277     def var v-asc     as integer no-undo .
     2278     def var v-new-asc as integer no-undo .
     2279     def var ind       as integer no-undo .
     2280     if length(p-string) <> 3 then do:
     2281       return ? .
     2282     end.
     2283     assign
     2284       v-asc = 0
     2285     .
     2286     do ind = 1 to length(p-string)
     2287     :
     2288       assign
     2289         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
     2290       .
     2291       if v-new-asc < 0 or v-new-asc >= 8 then do:
     2292         return ? .
     2293       end.
     2294       assign
     2295         v-asc = v-asc * 8 + v-new-asc
     2296       .
     2297     end.
     2298     return chr(v-asc) .
     2299   end function .
     2300   function char-to-octal return character
     2301   ( p-chr as character ) :
     2302     def var v-asc    as integer   no-undo .
     2303     def var ind      as integer   no-undo .
     2304     def var v-string as character no-undo .
     2305     if length(p-chr) <> 1 then do:
     2306       return ? .
     2307     end.
     2308     assign
     2309       v-asc    = asc(p-chr)
     2310       v-string = ""
     2311     .
     2312     do ind = 1 to 3
     2313     :
     2314       assign
     2315         v-string = chr( v-asc mod 8 + asc('0')) + v-string
     2316       .
     2317       assign
     2318         v-asc = truncate(v-asc / 8, 0)
     2319       .
     2320     end.
     2321     return v-string .
     2322   end.
     2323   function str-encode return character
     2324   (   p-init-string       as character
     2325     , p-encode-char       as character
     2326     , p-special-char-list as character
     2327   ) :
     2328     def var p-encode-string as character no-undo .
     2329     def var ind                as integer no-undo .
     2330     def var v-num-special-char as integer no-undo .
     2331     def var v-special-char     as character no-undo .
     2332     if p-encode-char = ?
     2333     or p-encode-char = "" then do:
     2334       assign
     2335         p-encode-char = "~~"
     2336       .
     2337     end.
     2338     if p-init-string = ? then do:
     2339       return "?" .
     2340     end.
     2341     if p-init-string = "?" then do:
     2342       return p-encode-char + char-to-octal("?") .
     2343     end.
     2344     assign
     2345       v-num-special-char = length(p-special-char-list)
     2346       p-encode-string    = replace(p-init-string
     2347                                   ,p-encode-char
     2348                                   ,p-encode-char + char-to-octal(p-encode-char)
     2349                                   )
     2350     .
     2351     do ind = 1 to v-num-special-char
     2352     :
     2353       assign
     2354         v-special-char = substring(p-special-char-list, ind, 1)
     2355       .
     2356       if v-special-char <> p-encode-char then do:
     2357         assign
     2358           p-encode-string = replace (p-encode-string
     2359                                     ,v-special-char
     2360                                     ,p-encode-char + char-to-octal(v-special-char)
     2361                                     )
     2362         .
     2363       end.
     2364     end.
     2365     return p-encode-string .
     2366   end.
     2367   function str-decode returns character
     2368     (p-init-string   as character
     2369     ,p-encode-char   as character
     2370     ) :
     2371     def var p-decode-string as character no-undo .
     2372     def var ind                       as integer no-undo .
     2373     def var v-num-entries-init-string as integer no-undo .
     2374     def var v-sub-phrase              as character no-undo .
     2375     def var v-special-char            as character no-undo .
     2376     if p-encode-char = ?
     2377     or p-encode-char = "" then do:
     2378       assign
     2379         p-encode-char = "~~"
     2380       .
     2381     end.
     2382     if p-init-string = "?" then do:
     2383       return ? .
     2384     end.
     2385     assign
     2386       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
     2387     .
     2388     if v-num-entries-init-string > 1 then do:
     2389       assign
     2390         p-decode-string = entry(1, p-init-string, p-encode-char)
     2391       .
     2392       do ind = 2 to v-num-entries-init-string
     2393       :
     2394         assign
     2395           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
     2396         .
     2397         assign
     2398           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
     2399         .
     2400         if v-special-char <> ? then do:
     2401           assign
     2402             p-decode-string = p-decode-string
     2403                             + v-special-char
     2404                             + substring(v-sub-phrase, 4)
     2405           .
     2406         end.
     2407         else do:
     2408           assign
     2409             p-decode-string = p-decode-string
     2410                             + p-encode-char
     2411                             + v-sub-phrase
     2412           .
     2413         end.
     2414       end.
     2415     end.
     2416     else do:
     2417       assign
     2418         p-decode-string = p-init-string
     2419       .
     2420     end.
     2421     return p-decode-string .
     2422   end.
     2423   define   shared variable g#auto as logical no-undo.
     2424   define   shared variable g#news as logical no-undo.
     2425   define   shared variable g#oxml as logical no-undo.
     2426   define   shared variable g#esys as logical no-undo.
     2427   define   shared variable g#news-source-db as integer no-undo.
     2428   define   shared variable g#esys-source-esys as integer no-undo.
     2429   define   shared variable g#db-num as integer   no-undo .
     2430   define   shared variable g#userid as character no-undo .
     2431   define   shared variable g#passwd as character no-undo .
     2432   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2433   procedure lineattr-value :
     2434     do
     2435     on error undo, return error return-value
     2436     :
     2437       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2438       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2439       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2440       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     2441       define output parameter p-type     as character no-undo .
     2442       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2443       def var v-format         as character no-undo .
     2444       def var v-fillin_width   as integer   no-undo .
     2445       def var v-fillin_height  as integer   no-undo .
     2446       def var v-label          as character no-undo .
     2447       def var v-user-can-edit  as logical   no-undo .
     2448       def var v-output-display as logical   no-undo .
     2449       def var v-other          as character no-undo .
     2450       run lineattr-code in this-procedure
     2451         (input  p-code
     2452         ,output p-type
     2453         ,output v-format
     2454         ,output v-fillin_width
     2455         ,output v-fillin_height
     2456         ,output v-label
     2457         ,output v-user-can-edit
     2458         ,output v-output-display
     2459         ,output v-other
     2460         ) no-error .
     2461       if error-status :error then do:
     2462         undo, return error return-value .
     2463       end.
     2464       find first buf_doc-line-attr no-lock
     2465         where buf_doc-line-attr.doc-code  = p-doc-code
     2466           and buf_doc-line-attr.gds-code  = p-gds-code
     2467           and buf_doc-line-attr.attr-code = p-code
     2468         no-error .
     2469       if avail buf_doc-line-attr then do:
     2470         assign
     2471           p-value =  buf_doc-line-attr.attr-value
     2472         .
     2473       end.
     2474       else do:
     2475         assign
     2476           p-value = if p-type = 'L':U then "no":U else ""
     2477         .
     2478       end.
     2479     end.
     2480   end procedure.
     2481   procedure lineattr-write :
     2482     do
     2483     on error undo, return error return-value
     2484     :
     2485       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2486       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2487       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2488       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     2489       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2490       def var v-type           as character no-undo .
     2491       def var v-format         as character no-undo .
     2492       def var v-fillin_width   as integer   no-undo .
     2493       def var v-fillin_height  as integer   no-undo .
     2494       def var v-label          as character no-undo .
     2495       def var v-user-can-edit  as logical   no-undo .
     2496       def var v-output-display as logical   no-undo .
     2497       def var v-other          as character no-undo .
     2498       run lineattr-code in this-procedure
     2499         (input  p-code
     2500         ,output v-type
     2501         ,output v-format
     2502         ,output v-fillin_width
     2503         ,output v-fillin_height
     2504         ,output v-label
     2505         ,output v-user-can-edit
     2506         ,output v-output-display
     2507         ,output v-other
     2508         ) no-error .
     2509       if error-status :error then do:
     2510         undo, return error return-value .
     2511       end.
     2512       find first buf_doc-line-attr exclusive-lock
     2513         where buf_doc-line-attr.doc-code  = p-doc-code
     2514           and buf_doc-line-attr.gds-code  = p-gds-code
     2515           and buf_doc-line-attr.attr-code = p-code
     2516         no-error .
     2517       if not available buf_doc-line-attr then do:
     2518         create buf_doc-line-attr .
     2519         assign
     2520           buf_doc-line-attr.doc-code  = p-doc-code
     2521           buf_doc-line-attr.gds-code = p-gds-code
     2522           buf_doc-line-attr.attr-code = p-code
     2523         .
     2524       end.
     2525       assign
     2526         buf_doc-line-attr.attr-value = p-value
     2527       .
     2528        release buf_doc-line-attr.
     2529     end.
     2530   end procedure.
     2531   procedure lineattr-exist :
     2532     do
     2533     on error undo, return error return-value
     2534     :
     2535       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2536       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2537       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2538       define output parameter p-exist   as logical  no-undo .
     2539       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2540       def var v-type           as character no-undo .
     2541       def var v-format         as character no-undo .
     2542       def var v-fillin_width   as integer   no-undo .
     2543       def var v-fillin_height  as integer   no-undo .
     2544       def var v-label          as character no-undo .
     2545       def var v-user-can-edit  as logical   no-undo .
     2546       def var v-output-display as logical   no-undo .
     2547       def var v-other          as character no-undo .
     2548       run lineattr-code in this-procedure
     2549         (input  p-code
     2550         ,output v-type
     2551         ,output v-format
     2552         ,output v-fillin_width
     2553         ,output v-fillin_height
     2554         ,output v-label
     2555         ,output v-user-can-edit
     2556         ,output v-output-display
     2557         ,output v-other
     2558         ) no-error .
     2559       if error-status :error then do:
     2560         undo, return error return-value .
     2561       end.
     2562       find first buf_doc-line-attr no-lock
     2563         where buf_doc-line-attr.doc-code  = p-doc-code
     2564           and buf_doc-line-attr.gds-code = p-gds-code
     2565           and buf_doc-line-attr.attr-code = p-code
     2566         no-error .
     2567       if  available buf_doc-line-attr then do:
     2568         p-exist = yes.
     2569       end.
     2570     end.
     2571   end procedure.
     2572   procedure lineattr-delete :
     2573     do
     2574     on error undo, return error return-value
     2575     :
     2576       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2577       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2578       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2579       define output parameter p-deleted  as logical no-undo.
     2580       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2581       def var v-type           as character no-undo .
     2582       def var v-format         as character no-undo .
     2583       def var v-fillin_width   as integer   no-undo .
     2584       def var v-fillin_height  as integer   no-undo .
     2585       def var v-label          as character no-undo .
     2586       def var v-user-can-edit  as logical   no-undo .
     2587       def var v-output-display as logical   no-undo .
     2588       def var v-other          as character no-undo .
     2589       run lineattr-code in this-procedure
     2590         (input  p-code
     2591         ,output v-type
     2592         ,output v-format
     2593         ,output v-fillin_width
     2594         ,output v-fillin_height
     2595         ,output v-label
     2596         ,output v-user-can-edit
     2597         ,output v-output-display
     2598         ,output v-other
     2599         ) no-error .
     2600       if error-status :error then do:
     2601         undo, return error return-value .
     2602       end.
     2603       find first buf_doc-line-attr exclusive-lock
     2604         where buf_doc-line-attr.doc-code  = p-doc-code
     2605           and buf_doc-line-attr.gds-code  = p-gds-code
     2606           and buf_doc-line-attr.attr-code = p-code
     2607         no-error NO-WAIT.
     2608       if not available buf_doc-line-attr then do:
     2609         p-deleted = no.
     2610       end.
     2611       else do:
     2612         delete buf_doc-line-attr.
     2613         p-deleted = yes.
     2614       end.
     2615     end.
     2616   end procedure.
     2617   procedure lineattr-code :
     2618     do on error undo, return error return-value
     2619     :
     2620       define input  parameter p-code           as character no-undo .
     2621       define output parameter p-type           as character no-undo .
     2622       define output parameter p-format         as character no-undo .
     2623       define output parameter p-fillin_width   as integer   no-undo .
     2624       define output parameter p-fillin_height  as integer   no-undo .
     2625       define output parameter p-label          as character no-undo .
     2626       define output parameter p-user-can-edit  as logical   no-undo .
     2627       define output parameter p-output-display as logical   no-undo .
     2628       define output parameter p-other          as character no-undo .
     2629       case p-code :
     2630               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2631               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2632               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2633               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2634               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2635               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2636               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2637               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2638               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2639               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2640               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2641         otherwise do:
     2642           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     2643         end.
     2644       end.
     2645     end.
     2646   end procedure.
     2647   procedure lineattr-value-flora-gds :
     2648     do
     2649     on error undo, return error return-value
     2650     :
     2651       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2652       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     2653       define input  parameter p-prt-code    as integer   no-undo .
     2654       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     2655       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     2656       define output parameter p-value       as    decimal   no-undo .
     2657       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2658       find first buf_doc-line-attr no-lock
     2659         where buf_doc-line-attr.doc-code  = p-doc-code
     2660           and buf_doc-line-attr.gds-code  = p-gds-code
     2661           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2662         no-error .
     2663       if avail buf_doc-line-attr then do:
     2664         assign
     2665           p-value = decimal( buf_doc-line-attr.attr-value)
     2666         .
     2667       end.
     2668       else do:
     2669         assign
     2670           p-value = 0
     2671         .
     2672       end.
     2673     end.
     2674   end procedure.
     2675   procedure lineattr-write-flora-gds :
     2676     do
     2677     on error undo, return error return-value
     2678     :
     2679       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2680       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2681       define input parameter p-prt-code    as integer   no-undo .
     2682       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2683       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2684       define input parameter p-value    as decimal   no-undo .
     2685       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2686       find first buf_doc-line-attr exclusive-lock
     2687         where buf_doc-line-attr.doc-code  = p-doc-code
     2688           and buf_doc-line-attr.gds-code  = p-gds-code
     2689           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2690         no-error .
     2691       if not available buf_doc-line-attr then do:
     2692         create buf_doc-line-attr .
     2693         assign
     2694           buf_doc-line-attr.doc-code  = p-doc-code
     2695           buf_doc-line-attr.gds-code  = p-gds-code
     2696           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2697         .
     2698       end.
     2699       assign
     2700         buf_doc-line-attr.attr-value = string( p-value )
     2701       .
     2702     end.
     2703   end procedure.
     2704   procedure lineattr-delete-flora-gds :
     2705     do
     2706     on error undo, return error return-value
     2707     :
     2708       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2709       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2710       define input  parameter p-prt-code    as integer   no-undo .
     2711       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2712       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2713       define output parameter p-deleted  as logical no-undo.
     2714       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2715       find first buf_doc-line-attr exclusive-lock
     2716         where buf_doc-line-attr.doc-code  = p-doc-code
     2717           and buf_doc-line-attr.gds-code  = p-gds-code
     2718           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2719         no-error NO-WAIT.
     2720       if not available buf_doc-line-attr then do:
     2721         p-deleted = no.
     2722       end.
     2723       else do:
     2724         delete buf_doc-line-attr.
     2725         p-deleted = yes.
     2726       end.
     2727     end.
     2728   end procedure.
     2729   procedure lineattr-delete-flora-all :
     2730     do
     2731     on error undo, return error return-value
     2732     :
     2733       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2734       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2735       define input  parameter p-prt-code    as integer   no-undo .
     2736       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2737       for each buf_doc-line-attr exclusive-lock
     2738         where buf_doc-line-attr.doc-code  = p-doc-code
     2739           and buf_doc-line-attr.gds-code  = p-gds-code
     2740           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     2741        :
     2742         delete buf_doc-line-attr.
     2743       end.
     2744    end.
     2745   end procedure.
