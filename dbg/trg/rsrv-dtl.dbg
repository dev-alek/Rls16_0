     9627           and ub.marking-lines.obj-code = rsrv-parts.obj-code
     9628           and ub.marking-lines.in-code = rsrv-parts.in-code
     9629           and ub.marking-lines.out-code = rsrv-parts.out-code
     9630           and ub.marking-lines.part-code = rsrv-parts.part-code
     9631           and ub.marking-lines.prt-code = rsrv-parts.prt-code:
     9632             delete ub.marking-lines.
     9633         end.
     9634         delete rsrv-parts .
     9635       end.
     9636       else do:
     9637         assign
     9638           p-parts-recid = recid(rsrv-parts)
     9639         .
     9640       end.
     9641       if  buf_parts.qnty      = 0
     9642       and buf_parts.fact-qnty = 0 then do:
     9643         if p-goods-twounit = true then do:
     9644           if buf_parts.cli-qnty <> 0 then do:
     9645             message
     9646               vss-workfile vss-revision vss-description skip
     9647               "Ошибка при удалении партии" skip
     9648               "Объект" buf_parts.obj-type buf_parts.obj-code skip
     9649               "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     9650               "Партия" buf_parts.in-code buf_parts.part-code skip
     9651               "Резерв" buf_parts.out-code skip
     9652               "qnty" buf_parts.qnty skip
     9653               "fact-qnty" buf_parts.fact-qnty skip
     9654               "cli-qnty" buf_parts.cli-qnty skip
     9655               view-as alert-box error .
     9656             undo, return error .
     9657           end.
     9658         end.
     9659         define variable part-key-rec_free as character no-undo .
     9660         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     9661                                           ,input (buffer buf_parts:handle)
     9662                                           ,output part-key-rec).
     9663         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     9664                                               and ub.gen-attr.p-key =  part-key-rec :
     9665           if (entry (8,part-key-rec,chr(3)) <> 'free-zone':U) and (entry (8,part-key-rec,chr(3)) <> entry (7,part-key-rec,chr(3))) then do:
     9666           part-key-rec_free = part-key-rec .
     9667           entry (8,part-key-rec_free,chr(3)) = 'free-zone':U .
     9668           find first buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U
     9669                       and buf_gen-attr.attr-code = ub.gen-attr.attr-code
     9670                       and num-entries (buf_gen-attr.p-key, chr(3)) >= 8
     9671                       and entry(8, buf_gen-attr.p-key, chr(3)) = 'free-zone':U
     9672                       no-error .
     9673                   if not available (buf_gen-attr) then
     9674                   do:
     9675                       create buf_gen-attr.
     9676                       buffer-copy ub.gen-attr except ub.gen-attr.p-key to buf_gen-attr .
     9677                       assign
     9678                           buf_gen-attr.p-key = part-key-rec_free
     9679                           .
     9680                   end.
     9681           end.
     9682           find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
     9683           find current buf1_gen-attr exclusive-lock.
     9684           delete buf1_gen-attr .
     9685         end.
     9686         release buf_gen-attr.
     9687   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9688   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     9689     (input  buf_parts.artic
     9690     ,input  buf_parts.prod-type
     9691     ,input  buf_parts.prod-code
     9692     ,output v-gds-code
     9693     ) no-error .
     9694         for each ub.marking-lines where ub.marking-lines.gds-code = v-gds-code
     9695           and ub.marking-lines.obj-type = buf_parts.obj-type
     9696           and ub.marking-lines.obj-code = buf_parts.obj-code
     9697           and ub.marking-lines.in-code = buf_parts.in-code
     9698           and ub.marking-lines.out-code = buf_parts.out-code
     9699           and ub.marking-lines.part-code = buf_parts.part-code
     9700           and ub.marking-lines.prt-code = buf_parts.prt-code:
     9701             if chg-qnty < 0
     9702             then do :
     9703               for first ub.marking exclusive-lock where ub.marking.mark = ub.marking-lines.mark :
     9704                 find first free_marking-lines no-lock where free_marking-lines.mark       = ub.marking-lines.mark
     9705                                                         and free_marking-lines.gds-code   = ub.marking-lines.gds-code
     9706                                                         and free_marking-lines.obj-type   = ub.marking-lines.obj-type
     9707                                                         and free_marking-lines.obj-code   = ub.marking-lines.obj-code
     9708                                                         and free_marking-lines.in-code    = ub.marking-lines.in-code
     9709                                                         and free_marking-lines.out-code   = 'free-zone':U
     9710                                                         and free_marking-lines.part-code  = ub.marking-lines.part-code
     9711                                                         and free_marking-lines.prt-code   = ub.marking-lines.prt-code
     9712                                                         no-error .
     9713                 if not available free_marking-lines
     9714                 then do :
     9715                   create free_marking-lines .
     9716                   assign
     9717                     free_marking-lines.mark       = ub.marking-lines.mark
     9718                     free_marking-lines.doc-level  = ub.marking-lines.doc-level
     9719                     free_marking-lines.gds-code   = ub.marking-lines.gds-code
     9720                     free_marking-lines.obj-type   = ub.marking-lines.obj-type
     9721                     free_marking-lines.obj-code   = ub.marking-lines.obj-code
     9722                     free_marking-lines.in-code    = ub.marking-lines.in-code
     9723                     free_marking-lines.out-code   = 'free-zone':U
     9724                     free_marking-lines.part-code  = ub.marking-lines.part-code
     9725                     free_marking-lines.prt-code   = ub.marking-lines.prt-code
     9726                   .
     9727                 end .
     9728                 ub.marking.sts = stsMarkWhenDeleteGoods(if avail buf_trn-doc then buf_trn-doc.doc-code else ?,
     9729                                                         ub.marking-lines.mark).
     9730               end .
     9731             end .
     9732             delete ub.marking-lines.
     9733         end.
     9734         delete buf_parts .
     9735       end.
     9736       else do:
     9737         assign
     9738           buf_parts.rsrv-free =
     9739           ( (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
     9740         or (buf_trn-doc.doc-type = 'инв':U and buf_parts.qnty < 0))
     9741         .
     9742         if  buf_trn-doc.doc-type <> 'инв':U
     9743         and (buf_parts.qnty < 0
     9744              or buf_parts.fact-qnty < 0
     9745             )
     9746         then do:
     9747           message
     9748             vss-workfile vss-revision vss-description skip
     9749             "Партии с отрицательным количеством допустимы" skip
     9750             "только для документа инвентаризации" skip
     9751             "Объект" buf_parts.obj-type buf_parts.obj-code skip
     9752             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     9753             "Партия" buf_parts.in-code buf_parts.part-code skip
     9754             "Резерв" buf_trn-doc.doc-code skip
     9755             "Количество по документу" buf_parts.qnty skip
     9756             "Фактическое количество" buf_parts.fact-qnty skip
     9757             view-as alert-box error .
     9758           undo, return error .
     9759         end.
     9760         assign
     9761           p-parts-recid = recid(buf_parts)
     9762         .
     9763       end.
     9764     end.
     9765   end procedure.
     9766   procedure partrsrv-need-rsrv :
     9767     define input  parameter p-parts-in-code   as character no-undo .
     9768     define input  parameter p-parts-out-code  as character no-undo .
     9769     define output parameter p-need-rsrv-parts as logical   no-undo .
     9770     do
     9771     on error undo, return error return-value
     9772     :
     9773       if p-parts-out-code <> p-parts-in-code
     9774       then do:
     9775         assign
     9776           p-need-rsrv-parts = true
     9777         .
     9778       end.
     9779       else do:
     9780         assign
     9781           p-need-rsrv-parts = false
     9782         .
     9783       end.
     9784     end.
     9785   end procedure.
     9786   function hvrdtax return logical (input parrecid as recid):
     9787   define variable varresult as logical no-undo.
     9788   run hvrdtax-proc (input parrecid, output varresult).
     9789   return varresult.
     9790   end function.
     9791   procedure hvrdtax-proc:
     9792   define input  parameter parrecid  as recid   no-undo.
     9793   define output parameter parresult as logical no-undo.
     9794   define buffer bf_goods for ub.goods.
     9795   define buffer bf_units for ub.units.
     9796   define buffer rt_tax   for ub.tax.
     9797   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     9798   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     9799   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     9800   if available rt_tax and
     9801       can-find(first ub.tax-units No-LOCK WHERE
     9802                      ub.tax-units.tax-code = rt_tax.tax-code AND
     9803                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     9804                                                       else assign parresult = no.
     9805   end procedure.
     9806   def var vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9807   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9808   procedure partcopy :
     9809     define input parameter  p-free-output-copy as logical   no-undo .
     9810     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     9811     define parameter buffer buf_orig_parts     for ub.parts .
     9812     define parameter buffer buf_parts          for ub.parts .
     9813     define input parameter  p-mark             as character no-undo .
     9814     define variable vss-description as character no-undo init "partcopy-01: процедура копирования партии".
     9815     define variable v-value-character as character no-undo .
     9816     define variable v-value-date      as date no-undo .
     9817     define variable v-value-decimal   as decimal no-undo .
     9818     define variable v-value-integer   as integer no-undo .
     9819     define variable v-izlcstpr        as logical no-undo .
     9820     define variable v-tth             as handle no-undo .
     9821     define variable v-type            as character no-undo .
     9822     define variable part-key-rec      as character no-undo .
     9823     define variable orig-part-key-rec as character no-undo .
     9824     define variable del-part-key-rec  as character no-undo .
     9825     define variable objMarks as class excisemarks  no-undo .
     9826     define variable v-parent-mark-sts as integer   no-undo .
     9827     define variable v-mark-sts-list   as character no-undo .
     9828     define variable oMarkSts as class ibs.th.str.marking.sts.mark .
     9829     oMarkSts = objSrv:Env:Marking:Sts:Mark.
     9830     define buffer buf_gen-attr for ub.gen-attr .
     9831     define buffer buf1_gen-attr for ub.gen-attr .
     9832     define buffer buf_doc-line  for ub.doc-line .
     9833     define buffer buf_marking for ub.marking .
     9834     define buffer buf_marking-childs for ub.marking .
     9835     define buffer orig_marking-lines for ub.marking-lines .
     9836     define buffer orig_marking-lines-childs for ub.marking-lines .
     9837     define buffer buf_marking-lines for ub.marking-lines .
     9838     define buffer buf_marking-lines-childs for ub.marking-lines .
     9839     define buffer buf_marking-pack for ub.marking .
     9840     define buffer buf_marking-chk for ub.marking-chk .
     9841     define buffer buf_goods for ub.goods .
     9842     define buffer buf_trn-doc for ub.trn-doc .
     9843     define buffer pri_trn-doc for ub.trn-doc .
     9844     define buffer buf_chk-doc for ub.chk-doc .
     9845     do
     9846     on error undo, return error return-value
     9847     :
     9848       if p-free-output-copy = true
     9849       then do:
     9850         if  p-out-code <> 'free-zone':U
     9851         and p-out-code <> 'out-zone':U
     9852         then do:
     9853           message
     9854             vss-workfile vss-revision vss-description skip
     9855             vss-include-info48 skip
     9856             "Ошибка задания входных параметров процедуры partcopy" skip
     9857             "p-free-output-copy" p-free-output-copy skip
     9858             "p-out-code" p-out-code skip
     9859             view-as alert-box error .
     9860           undo, return error .
     9861         end.
     9862       end.
     9863       if buf_orig_parts.out-code <> p-out-code
     9864       then do:
     9865         find first buf_parts exclusive-lock
     9866           where buf_parts.obj-type  = buf_orig_parts.obj-type
     9867             and buf_parts.obj-code  = buf_orig_parts.obj-code
     9868             and buf_parts.artic     = buf_orig_parts.artic
     9869             and buf_parts.prod-type = buf_orig_parts.prod-type
     9870             and buf_parts.prod-code = buf_orig_parts.prod-code
     9871             and buf_parts.in-code   = buf_orig_parts.in-code
     9872             and buf_parts.out-code  = p-out-code
     9873             and buf_parts.part-code = buf_orig_parts.part-code
     9874           no-error.
     9875         if not available buf_parts
     9876         then do:
     9877           define variable v-rsrv-free as logical   no-undo .
     9878           if p-out-code = 'free-zone':U
     9879           or p-out-code = 'out-zone':U
     9880           then do:
     9881             assign
     9882               v-rsrv-free =
     9883          (if p-out-code = 'free-zone':U then yes else no)
     9884             .
     9885           end.
     9886           else do:
     9887             assign
     9888               v-rsrv-free = ?
     9889             .
     9890           end.
     9891           create buf_parts .
     9892           buffer-copy buf_orig_parts to buf_parts
     9893           assign
     9894             buf_parts.out-code  = p-out-code
     9895             buf_parts.status_   = no
     9896             buf_parts.rsrv-free = v-rsrv-free
     9897             buf_parts.qnty      = 0
     9898             buf_parts.fact-qnty = 0
     9899             buf_parts.real-qnty = 0
     9900             buf_parts.cli-qnty  = 0
     9901           .
     9902           validate buf_parts .
     9903         end.
     9904         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     9905                                           ,input (buffer buf_orig_parts:handle)
     9906                                           ,output orig-part-key-rec).
     9907         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     9908                                           ,input (buffer buf_parts:handle)
     9909                                           ,output part-key-rec).
     9910         for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
     9911               and ub.gen-attr.p-key =  orig-part-key-rec:
     9912             if not valid-object (objMarks)
     9913               then objMarks = new excisemarks (buf_parts.obj-type, buf_parts.obj-code).
     9914               if p-out-code = 'free-zone':U
     9915               and (entry(7,orig-part-key-rec,chr(3)) = entry(8,orig-part-key-rec,chr(3)) )
     9916                then
     9917               do:
     9918                   objMarks:CrFreeMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     9919                   if objMarks:StatusErr
     9920                       then
     9921                   do:
     9922                       message objMarks:ReturnMsg view-as alert-box error.
     9923                       delete object objMarks no-error.
     9924                       undo, return error.
     9925                   end.
     9926               end.
     9927             if (entry(7,orig-part-key-rec,chr(3)) <> entry(8,orig-part-key-rec,chr(3)) ) then
     9928             do:
     9929                 if p-mark <> "" then do:
     9930                 if p-out-code = 'free-zone':U then do:
     9931                   objMarks:RezervMarkForParts(buffer buf_parts, buffer buf_orig_parts, p-mark) .
     9932                 end.
     9933                 else do:
     9934                   objMarks:RezervMarkForParts(buffer buf_orig_parts, buffer buf_parts, p-mark) .
     9935                 end.
     9936                 if objMarks:StatusErr
     9937                   then
     9938                 do:
     9939                   message objMarks:ReturnMsg view-as alert-box error.
     9940                   delete object objMarks no-error.
     9941                   undo, return error.
     9942                 end.
     9943               end.
     9944             end.
     9945             if p-out-code = 'out-zone':U then
     9946             do:
     9947                 objMarks:CrOutMarkForParts(buffer buf_orig_parts, buffer buf_parts, ub.gen-attr.attr-code) .
     9948                 if objMarks:StatusErr
     9949                     then
     9950                 do:
     9951                     message objMarks:ReturnMsg view-as alert-box error.
     9952                     delete object objMarks no-error.
     9953                     undo, return error.
     9954                 end.
     9955             end.
     9956         end.
     9957         delete object objMarks no-error.
     9958         if p-mark = "news" then return .
     9959         find first pri_trn-doc no-lock where pri_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     9960         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-out-code no-error.
     9961         if not available buf_trn-doc
     9962         then
     9963            find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_orig_parts.out-code no-error .
     9964         if (
     9965             p-out-code = 'free-zone':U
     9966             and buf_orig_parts.in-code = buf_orig_parts.out-code
     9967            )
     9968         or
     9969            (
     9970             p-out-code = 'free-zone':U
     9971             and available pri_trn-doc
     9972             and (pri_trn-doc.ext-doc-type = 'iv':U or pri_trn-doc.ext-doc-type = 'rv':U)
     9973            )
     9974         or
     9975            (
     9976             available buf_trn-doc
     9977             and p-out-code = buf_trn-doc.doc-code
     9978             and buf_trn-doc.ext-doc-type = 'vt':U
     9979            )
     9980         or
     9981            (
     9982             p-mark = ""
     9983             and available buf_trn-doc
     9984             and p-out-code = 'free-zone':U
     9985             and buf_trn-doc.ext-doc-type = 'vt':U
     9986            )
     9987         or
     9988            (
     9989             p-mark = ""
     9990             and available buf_trn-doc
     9991             and p-out-code = 'free-zone':U
     9992             and buf_trn-doc.ext-doc-type = 'rs':U
     9993            )
     9994         then do :
     9995           find first ub.goods no-lock where ub.goods.artic = buf_parts.artic
     9996             and ub.goods.prod-type = buf_parts.prod-type
     9997             and ub.goods.prod-code = buf_parts.prod-code.
     9998           def buffer buf_orig_ml for ub.marking-lines.
     9999           for each buf_orig_ml where buf_orig_ml.gds-code = ub.goods.gds-code
    10000             and buf_orig_ml.obj-type = buf_orig_parts.obj-type
    10001             and buf_orig_ml.obj-code = buf_orig_parts.obj-code
    10002             and buf_orig_ml.in-code = buf_orig_parts.in-code
    10003             and buf_orig_ml.out-code = buf_orig_parts.out-code
    10004             and buf_orig_ml.part-code = buf_orig_parts.part-code
    10005             and buf_orig_ml.prt-code = buf_orig_parts.prt-code:
    10006             if available pri_trn-doc
    10007             and pri_trn-doc.ext-doc-type = 'iv':U
    10008             and buf_orig_ml.sts <> objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
    10009             then do :
    10010               for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark :
    10011                 assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB .
    10012               end .
    10013               next .
    10014             end .
    10015             find first ub.marking-lines no-lock where ub.marking-lines.mark     = buf_orig_ml.mark
    10016                                                   and ub.marking-lines.gds-code = buf_orig_ml.gds-code
    10017                                                   and ub.marking-lines.obj-type = buf_orig_ml.obj-type
    10018                                                   and ub.marking-lines.obj-code = buf_orig_ml.obj-code
    10019                                                   and ub.marking-lines.in-code  = buf_orig_ml.in-code
    10020                                                   and ub.marking-lines.out-code = p-out-code
    10021                                                   and ub.marking-lines.part-code = buf_orig_ml.part-code
    10022                                                   and ub.marking-lines.prt-code = buf_orig_ml.prt-code
    10023                                                   no-error .
    10024             if not available ub.marking-lines
    10025             then do :
    10026               create ub.marking-lines.
    10027               buffer-copy buf_orig_ml to ub.marking-lines
    10028               assign
    10029                 ub.marking-lines.out-code  = p-out-code
    10030                 ub.marking-lines.fact-order = pri_trn-doc.fact-order when available pri_trn-doc
    10031               .
    10032               validate ub.marking-lines.
    10033             end .
    10034             if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U then do:
    10035             for first buf_marking exclusive-lock where buf_marking.mark = buf_orig_ml.mark
    10036               and not (buf_marking.sts = oMarkSts:MarkError:KeyIntDB and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U):
    10037               if buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB and
    10038                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB and
    10039                  not can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) and
    10040                  not can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) and
    10041                  buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
    10042               then do:
    10043                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
    10044                 validate buf_marking.
    10045               end.
    10046             end .
    10047           end .
    10048           end.
    10049         end .
    10050         define variable v-doc-type  as character no-undo .
    10051         define variable   v-status    as character no-undo .
    10052         define variable v-fact-qnty   as  decimal no-undo .
    10053         define variable ii    as integer no-undo .
    10054         find first buf_goods no-lock where buf_goods.artic = buf_orig_parts.artic
    10055                                        and buf_goods.prod-type = buf_orig_parts.prod-type
    10056                                        and buf_goods.prod-code = buf_orig_parts.prod-code
    10057                                        .
    10058         if available pri_trn-doc
    10059         and pri_trn-doc.ext-doc-type = 'rs':U
    10060         then do :
    10061           if p-mark <> ""
    10062           then do :
    10063           end .
    10064           else do :
    10065           end .
    10066         end .
    10067         else do :
    10068           if buf_orig_parts.in-code <> buf_orig_parts.out-code
    10069           and p-mark <> ""
    10070           then do :
    10071             if p-out-code = 'free-zone':U
    10072             then do:
    10073                 if chg-qnty < 0
    10074                 then do :
    10075                   find first orig_marking-lines no-lock where orig_marking-lines.mark       = p-mark
    10076                                                           and orig_marking-lines.gds-code   = buf_goods.gds-code
    10077                                                           and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
    10078                                                           and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
    10079                                                           and orig_marking-lines.in-code    = buf_orig_parts.in-code
    10080                                                           and orig_marking-lines.out-code   = buf_orig_parts.out-code
    10081                                                           and orig_marking-lines.part-code  = buf_orig_parts.part-code
    10082                                                           and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
    10083                                                           no-error .
    10084                   if available orig_marking-lines
    10085                   then do :
    10086                     find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
    10087                                                            and buf_marking-lines.gds-code   = buf_goods.gds-code
    10088                                                            and buf_marking-lines.obj-type   = buf_parts.obj-type
    10089                                                            and buf_marking-lines.obj-code   = buf_parts.obj-code
    10090                                                            and buf_marking-lines.in-code    = buf_parts.in-code
    10091                                                            and buf_marking-lines.out-code   = buf_parts.out-code
    10092                                                            and buf_marking-lines.part-code  = buf_parts.part-code
    10093                                                            and buf_marking-lines.prt-code   = buf_parts.prt-code
    10094                                                            no-error .
    10095                     if not available buf_marking-lines
    10096                     then do :
    10097                       create buf_marking-lines .
    10098                       assign
    10099                         buf_marking-lines.mark       = p-mark
    10100                         buf_marking-lines.doc-level  = orig_marking-lines.doc-level
    10101                         buf_marking-lines.gds-code   = buf_goods.gds-code
    10102                         buf_marking-lines.obj-type   = buf_parts.obj-type
    10103                         buf_marking-lines.obj-code   = buf_parts.obj-code
    10104                         buf_marking-lines.in-code    = buf_parts.in-code
    10105                         buf_marking-lines.out-code   = buf_parts.out-code
    10106                         buf_marking-lines.part-code  = buf_parts.part-code
    10107                         buf_marking-lines.prt-code   = buf_parts.prt-code
    10108                       .
    10109                       validate buf_marking-lines.
    10110                     end .
    10111                     for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
    10112                       assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
    10113                       for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
    10114                         for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
    10115                                                         and buf_chk-doc.out-code = buf_orig_parts.out-code
    10116                                                         :
    10117                           assign buf_marking-chk.sts = 0 .
    10118                           validate buf_marking-chk.
    10119                         end .
    10120                       end .
    10121                       if buf_marking.unit-ext <> "UNIT" or
    10122                          (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
    10123                       then do :
    10124                         run addChildMarkingLines in this-procedure (
    10125                           buf_marking.mark,
    10126                           objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB,
    10127                           buffer buf_marking-lines,
    10128                           buffer buf_parts,
    10129                           buffer orig_marking-lines,
    10130                           buffer buf_orig_parts,
    10131                           buffer buf_goods
    10132                         ).
    10133                       end .
    10134                     end.
    10135                     find current orig_marking-lines exclusive-lock .
    10136                     delete orig_marking-lines .
    10137                   end .
    10138                 end .
    10139             end.
    10140             else do:
    10141               find first orig_marking-lines exclusive-lock where orig_marking-lines.mark       = p-mark
    10142                                                              and orig_marking-lines.gds-code   = buf_goods.gds-code
    10143                                                              and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
    10144                                                              and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
    10145                                                              and orig_marking-lines.in-code    = buf_orig_parts.in-code
    10146                                                              and orig_marking-lines.out-code   = buf_orig_parts.out-code
    10147                                                              and orig_marking-lines.part-code  = buf_orig_parts.part-code
    10148                                                              and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
    10149                                                              no-error .
    10150                 find first buf_marking-lines no-lock where  buf_marking-lines.mark       = p-mark
    10151                                                         and buf_marking-lines.gds-code   = buf_goods.gds-code
    10152                                                         and buf_marking-lines.obj-type   = buf_parts.obj-type
    10153                                                         and buf_marking-lines.obj-code   = buf_parts.obj-code
    10154                                                         and buf_marking-lines.in-code    = buf_parts.in-code
    10155                                                         and buf_marking-lines.out-code   = buf_parts.out-code
    10156                                                         and buf_marking-lines.part-code  = buf_parts.part-code
    10157                                                         and buf_marking-lines.prt-code   = buf_parts.prt-code
    10158                                                         no-error .
    10159                 if not available buf_marking-lines
    10160                 then do :
    10161                   create buf_marking-lines .
    10162                   assign
    10163                     buf_marking-lines.mark       = p-mark
    10164                     buf_marking-lines.doc-level  = 1
    10165                     buf_marking-lines.gds-code   = buf_goods.gds-code
    10166                     buf_marking-lines.obj-type   = buf_parts.obj-type
    10167                     buf_marking-lines.obj-code   = buf_parts.obj-code
    10168                     buf_marking-lines.in-code    = buf_parts.in-code
    10169                     buf_marking-lines.out-code   = buf_parts.out-code
    10170                     buf_marking-lines.part-code  = buf_parts.part-code
    10171                     buf_marking-lines.prt-code   = buf_parts.prt-code
    10172                     buf_marking-lines.sts        = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB
    10173                   .
    10174                   validate buf_marking-lines.
    10175                 end .
    10176                 for first buf_marking exclusive-lock where buf_marking.mark = p-mark :
    10177                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
    10178                   validate buf_marking.
    10179                   for first buf_marking-childs exclusive-lock where
    10180                             buf_marking-childs.mark = buf_marking.mark-parent:
    10181                     buf_marking-childs.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB .
    10182                     validate buf_marking-childs.
    10183                   end.
    10184                   for each buf_marking-chk exclusive-lock where buf_marking-chk.mark begins buf_marking.mark :
    10185                     for first buf_chk-doc no-lock where buf_chk-doc.doc-code = buf_marking-chk.doc-code
    10186                                                     and buf_chk-doc.out-code = buf_parts.out-code
    10187                                                     :
    10188                       if buf_marking-chk.sts <> 2 then
    10189                       do:
    10190                          assign buf_marking-chk.sts = 1 .
    10191                          validate buf_marking-chk.
    10192                       end.
    10193                     end .
    10194                   end .
    10195                   if buf_marking.unit-ext <> "UNIT" or
    10196                      (buf_marking.unit-ext = ? and buf_marking.box-qnty > 1)
    10197                   then do :
    10198                     run addChildMarkingLines in this-procedure (
    10199                       buf_marking.mark,
    10200                       buf_marking.sts,
    10201                       buffer buf_marking-lines,
    10202                       buffer buf_parts,
    10203                       buffer orig_marking-lines,
    10204                       buffer buf_orig_parts,
    10205                       buffer buf_goods
    10206                     ).
    10207                   end .
    10208                 end.
    10209                 if available orig_marking-lines then
    10210                   delete orig_marking-lines .
    10211             end.
    10212           end.
    10213         end .
    10214         if p-out-code = 'out-zone':U
    10215         and trim(p-mark) = ""
    10216         then do :
    10217           for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
    10218                                                 and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
    10219                                                 and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
    10220                                                 and orig_marking-lines.in-code    = buf_orig_parts.in-code
    10221                                                 and orig_marking-lines.out-code   = buf_orig_parts.out-code
    10222                                                 and orig_marking-lines.part-code  = buf_orig_parts.part-code
    10223                                                 and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
    10224                                                 :
    10225             find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
    10226                                                     and buf_marking-lines.gds-code   = buf_goods.gds-code
    10227                                                     and buf_marking-lines.obj-type   = buf_parts.obj-type
    10228                                                     and buf_marking-lines.obj-code   = buf_parts.obj-code
    10229                                                     and buf_marking-lines.out-code   = p-out-code
    10230                                                     no-error .
    10231             if available buf_marking-lines
    10232             then do :
    10233               find current buf_marking-lines exclusive-lock .
    10234               delete buf_marking-lines .
    10235               for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
    10236                 if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
    10237                 then do :
    10238                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
    10239                   validate buf_marking.
    10240                 end.
    10241               end .
    10242             end .
    10243             else do :
    10244               if avail buf_trn-doc and buf_trn-doc.doc-type <> 'инв':U and buf_parts.out-code <> 'out-zone':U then do:
    10245               create buf_marking-lines .
    10246               assign
    10247                 buf_marking-lines.mark       = orig_marking-lines.mark
    10248                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
    10249                 buf_marking-lines.gds-code   = buf_goods.gds-code
    10250                 buf_marking-lines.obj-type   = buf_parts.obj-type
    10251                 buf_marking-lines.obj-code   = buf_parts.obj-code
    10252                 buf_marking-lines.in-code    = buf_parts.in-code
    10253                 buf_marking-lines.out-code   = buf_parts.out-code
    10254                 buf_marking-lines.part-code  = buf_parts.part-code
    10255                 buf_marking-lines.prt-code   = buf_parts.prt-code
    10256               .
    10257               validate buf_marking-lines.
    10258               if buf_parts.out-code <> buf_parts.in-code
    10259               and buf_parts.out-code <> 'free-zone':U
    10260               and buf_parts.out-code <> 'out-zone':U
    10261               then do :
    10262                 find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
    10263                 if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
    10264               end .
    10265               end.
    10266             end .
    10267             release buf_marking-lines no-error .
    10268           end.
    10269         end .
    10270         if p-mark <> "" and available (buf_trn-doc) and buf_trn-doc.ext-doc-type = 'vt':U
    10271         then do:
    10272           for each orig_marking-lines no-lock where orig_marking-lines.mark         = p-mark
    10273                                                   and orig_marking-lines.gds-code   = buf_goods.gds-code
    10274                                                   and orig_marking-lines.obj-type   = buf_orig_parts.obj-type
    10275                                                   and orig_marking-lines.obj-code   = buf_orig_parts.obj-code
    10276                                                   and orig_marking-lines.in-code    = buf_orig_parts.in-code
    10277                                                   and orig_marking-lines.out-code   = buf_orig_parts.out-code
    10278                                                   and orig_marking-lines.part-code  = buf_orig_parts.part-code
    10279                                                   and orig_marking-lines.prt-code   = buf_orig_parts.prt-code
    10280                                                   .
    10281             find first buf_marking-lines no-lock where buf_marking-lines.mark       = p-mark
    10282                                                    and buf_marking-lines.gds-code   = buf_goods.gds-code
    10283                                                    and buf_marking-lines.obj-type   = buf_parts.obj-type
    10284                                                    and buf_marking-lines.obj-code   = buf_parts.obj-code
    10285                                                    and buf_marking-lines.in-code    = buf_parts.in-code
    10286                                                    and buf_marking-lines.out-code   = buf_orig_parts.out-code
    10287                                                    and buf_marking-lines.part-code  = buf_parts.part-code
    10288                                                    no-error .
    10289             for each ub.marking where ub.marking.mark = buf_marking-lines.mark:
    10290               if p-out-code = 'free-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
    10291                 then assign ub.marking.sts = oMarkSts:FreeZone:KeyIntDB.
    10292               if p-out-code = 'out-zone':U and not ub.marking.sts = oMarkSts:MarkError:KeyIntDB
    10293                 then assign ub.marking.sts = oMarkSts:OutZone:KeyIntDB.
    10294               validate ub.marking.
    10295             end.
    10296             run partcopy-to-childs-mark (buffer buf_marking-lines, buffer orig_marking-lines, input buf_parts.out-code, oMarkSts).
    10297             if available (buf_marking-lines)
    10298             then do:
    10299               assign
    10300                 buf_marking-lines.mark       = p-mark
    10301                 buf_marking-lines.doc-level  = orig_marking-lines.doc-level
    10302                 buf_marking-lines.gds-code   = buf_goods.gds-code
    10303                 buf_marking-lines.obj-type   = buf_parts.obj-type
    10304                 buf_marking-lines.obj-code   = buf_parts.obj-code
    10305                 buf_marking-lines.in-code    = buf_parts.in-code
    10306                 buf_marking-lines.out-code   = buf_parts.out-code
    10307                 buf_marking-lines.part-code  = buf_parts.part-code
    10308               .
    10309               validate buf_marking-lines.
    10310             end.
    10311           end.
    10312         end.
    10313       end.
    10314       else do:
    10315         find first buf_parts exclusive-lock
    10316           where recid(buf_parts) = recid(buf_orig_parts)
    10317           .
    10318       end.
    10319       if p-out-code = 'free-zone':U
    10320       or p-out-code = 'out-zone':U
    10321       then do:
    10322         if buf_parts.rsrv-free <>
    10323          (if buf_parts.out-code = 'free-zone':U then yes else no)
    10324         then do:
    10325           message
    10326             vss-workfile vss-revision vss-description skip
    10327             vss-include-info48 skip
    10328             "Ошибка типа резерва партии" skip
    10329             "Объект" buf_parts.obj-type buf_parts.obj-code  skip
    10330             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
    10331             "Партия" buf_parts.in-code buf_parts.part-code skip
    10332             "Резерв" buf_parts.out-code skip
    10333             "Статус" buf_parts.status_ skip
    10334             "Тип резерва" buf_parts.rsrv-free skip
    10335             view-as alert-box error .
    10336           undo, return error .
    10337         end.
    10338       end.
    10339     end.
    10340   end procedure.
    10341   procedure partcopy-to-childs-mark :
    10342     define parameter buffer buf_ml for ub.marking-lines .
    10343     define parameter buffer buf_orig-ml for ub.marking-lines .
    10344     define input parameter p-out-code as character no-undo .
    10345     define input parameter THMarkSts as class ibs.th.str.marking.sts.mark no-undo .
    10346     define buffer buf_ml-childs for ub.marking-lines .
    10347     for each ub.marking where ub.marking.mark-parent = buf_ml.mark:
    10348       if p-out-code = 'free-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
    10349         then assign ub.marking.sts = THMarkSts:FreeZone:KeyIntDB.
    10350       if p-out-code = 'out-zone':U and not ub.marking.sts = THMarkSts:MarkError:KeyIntDB
    10351         then assign ub.marking.sts = THMarkSts:OutZone:KeyIntDB.
    10352       for each buf_ml-childs exclusive-lock where buf_ml-childs.mark = ub.marking.mark
    10353         and buf_ml-childs.obj-type  = buf_orig-ml.obj-type
    10354         and buf_ml-childs.obj-code  = buf_orig-ml.obj-code
    10355         and buf_ml-childs.in-code   = buf_orig-ml.in-code
    10356         and buf_ml-childs.out-code  = buf_orig-ml.out-code
    10357         and buf_ml-childs.part-code = buf_orig-ml.part-code
    10358         and buf_ml-childs.prt-code  = buf_orig-ml.prt-code
    10359         :
    10360         assign
    10361           buf_ml-childs.out-code  = p-out-code
    10362         .
    10363         run partcopy-to-childs-mark (buffer buf_ml-childs, buffer buf_orig-ml, input p-out-code, input THMarkSts).
    10364       end.
    10365     end.
    10366   end.
    10367   procedure partcopy-update-parts :
    10368     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
    10369     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
    10370     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
    10371     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
    10372     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
    10373     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
    10374     define variable vss-description as character no-undo init "partcopy-update-parts-01: процедура обработки партий при закрытии документа".
    10375     define buffer buf_trn-doc for ub.trn-doc .
    10376     define buffer archive_parts for ub.parts .
    10377     define buffer buf_parts   for ub.parts .
    10378     define buffer orig_marking-lines for ub.marking-lines .
    10379     define buffer buf_marking for ub.marking .
    10380     define buffer buf_goods for ub.goods .
    10381     define variable v-rsrv-code     as character no-undo .
    10382     define variable v-goods-twounit as logical   no-undo .
    10383     define variable v-value-character as character no-undo .
    10384     define variable v-value-date      as date no-undo .
    10385     define variable v-value-decimal   as decimal no-undo .
    10386     define variable v-value-integer   as integer no-undo .
    10387     define variable v-izlcstpr        as logical no-undo .
    10388     define variable v-tth             as handle no-undo .
    10389     define variable v-type            as character no-undo .
    10390     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
    10391     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
    10392     do
    10393     on error undo, return error return-value
    10394     :
    10395       find first buf_trn-doc no-lock
    10396         where buf_trn-doc.doc-code = p-doc-code
    10397         no-error .
    10398       if not available buf_trn-doc
    10399       then do:
    10400         message
    10401           vss-workfile vss-revision vss-description skip
    10402           vss-include-info48 skip
    10403           "Ошибка задания входных параметров" skip
    10404           "Не найден документ" skip
    10405           "Документ" p-doc-code skip
    10406           "Объект" p-obj-type p-obj-code skip
    10407           "Артикул" p-artic p-prod-type p-prod-code skip
    10408           error-status :get-message(1) skip
    10409           return-value skip
    10410           view-as alert-box error .
    10411         undo, return error .
    10412       end.
    10413       find first buf_goods no-lock where buf_goods.artic = p-artic
    10414                                      and buf_goods.prod-type = p-prod-type
    10415                                      and buf_goods.prod-code = p-prod-code
    10416                                      no-error .
    10417       if not available buf_goods
    10418       then do:
    10419         message
    10420           vss-workfile vss-revision vss-description skip
    10421           vss-include-info48 skip
    10422           "Ошибка задания входных параметров" skip
    10423           "Не найден товар" skip
    10424           "Документ" p-doc-code skip
    10425           "Объект" p-obj-type p-obj-code skip
    10426           "Артикул" p-artic p-prod-type p-prod-code skip
    10427           error-status :get-message(1) skip
    10428           return-value skip
    10429           view-as alert-box error .
    10430         undo, return error .
    10431       end.
    10432       if buf_trn-doc.ext-doc-type = 'vt':U
    10433       then do :
    10434           delete object v-tth no-error.
    10435           run adm/shattri.p (
    10436              input "get":U
    10437             ,input buf_trn-doc.obj-type
    10438             ,input buf_trn-doc.obj-code
    10439             ,input 'inv-obj':U
    10440             ,input  "izlcstpr"
    10441             ,output v-value-character
    10442             ,output v-value-date
    10443             ,output v-value-decimal
    10444             ,output v-value-integer
    10445             ,output v-izlcstpr
    10446             ,output v-type
    10447             ,INPUT-OUTPUT table-handle v-tth
    10448             ) no-error .
    10449             delete object v-tth no-error.
    10450           if error-status:error then do:
    10451             v-izlcstpr = false .
    10452           end.
    10453       end.
    10454       else do :
    10455           v-izlcstpr = false .
    10456       end.
    10457   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10458   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
    10459     (input  p-artic
    10460     ,input  p-prod-type
    10461     ,input  p-prod-code
    10462     ,input  'twounit=request':u
    10463     ,output v-goods-twounit
    10464     ) no-error .
    10465       if error-status :error
    10466       then do:
    10467         message
    10468           vss-workfile vss-revision vss-description skip
    10469           vss-include-info48 skip
    10470           "Ошибка при определении атрибута товара" skip
    10471           "Артикул" p-artic p-prod-type p-prod-code skip
