    16404             assign
    16405               v-option-value = entry(2, v-option, "=" )
    16406             .
    16407             assign
    16408               v-create-part-code = str-decode(v-option-value, "")
    16409               was-created-part-code = yes
    16410             .
    16411           end.
    16412           when 'cli-qnty':U
    16413           then do:
    16414             if num-entries(v-option, "=") <> 2
    16415             then do:
    16416               message
    16417                 vss-workfile vss-revision vss-description skip
    16418                 "Ошибка при задании параметров вызова резервирования" skip
    16419                 "Для указания клиентского количества необходимо указать строку" skip
    16420                 "" 'cst-code':U + "=Код ГТД" skip
    16421                 "v-option" v-option skip
    16422                 "p-action" p-action skip
    16423                 view-as alert-box error .
    16424               undo, return error return-value .
    16425             end.
    16426             assign
    16427               v-option-value = entry(2, v-option, "=" )
    16428             .
    16429             assign
    16430               v-cli-qnty = decimal(v-option-value)
    16431             .
    16432           end.
    16433           when 'hold-code-parent':U
    16434           then do:
    16435             if num-entries(v-option, "=") <> 2
    16436             then do:
    16437               message
    16438                 vss-workfile vss-revision vss-description skip
    16439                 "Ошибка при задании параметров вызова резервирования" skip
    16440                 "Для указания кода партии необходимо указать строку" skip
    16441                 "" 'hold-code-parent':U + "=Код партии" skip
    16442                 "v-option" v-option skip
    16443                 "p-action" p-action skip
    16444                 view-as alert-box error .
    16445               undo, return error return-value .
    16446             end.
    16447             assign
    16448               v-option-value = entry(2, v-option, "=" )
    16449             .
    16450             assign
    16451               v-hold-code-parent = str-decode(v-option-value, "")
    16452             .
    16453             if v-hold-code-parent <> ""
    16454             then do:
    16455               run holdprts-get-part-code in this-procedure
    16456                 (input  buf_trn-doc.doc-code
    16457                 ,output v-create-part-code
    16458                 ) no-error .
    16459               if error-status :error
    16460               then do:
    16461                 message
    16462                   vss-workfile vss-revision vss-description skip
    16463                   "Ошибка при определении номера партии" skip
    16464                   error-status :get-message(1) skip
    16465                   return-value skip
    16466                   view-as alert-box error .
    16467                 undo, return error return-value .
    16468               end.
    16469             end.
    16470           end.
    16471           when 'part-code-parent':U
    16472           then do:
    16473             if num-entries(v-option, "=") <> 2
    16474             then do:
    16475               message
    16476                 vss-workfile vss-revision vss-description skip
    16477                 "Ошибка при задании параметров вызова резервирования" skip
    16478                 "Для указания кода партии необходимо указать строку" skip
    16479                 "" 'part-code-parent':U + "=Код партии" skip
    16480                 "v-option" v-option skip
    16481                 "p-action" p-action skip
    16482                 view-as alert-box error .
    16483               undo, return error return-value .
    16484             end.
    16485             assign
    16486               v-option-value = entry(2, v-option, "=" )
    16487             .
    16488             assign
    16489               v-hold-part-code = str-decode(v-option-value, "")
    16490             .
    16491           end.
    16492           when 'purch-code-list':U
    16493           then do:
    16494             if num-entries(v-option, "=") <> 2
    16495             then do:
    16496               message
    16497                 vss-workfile vss-revision vss-description skip
    16498                 "Ошибка при задании параметров вызова резервирования" skip
    16499                 "Для указания списка типов приобретения необходимо указать строку" skip
    16500                 "" 'purch-code-list':U + "=Список типов приобретения" skip
    16501                 "v-option" v-option skip
    16502                 "p-action" p-action skip
    16503                 view-as alert-box error .
    16504               undo, return error return-value .
    16505             end.
    16506             assign
    16507               v-option-value = entry(2, v-option, "=" )
    16508             .
    16509             assign
    16510               v-purch-code-list = str-decode(v-option-value, "")
    16511             .
    16512           end.
    16513           when 'last-date':U
    16514           then do:
    16515             if num-entries(v-option, "=") <> 2
    16516             then do:
    16517               message
    16518                 vss-workfile vss-revision vss-description skip
    16519                 "Ошибка при задании параметров вызова резервирования" skip
    16520                 "Для указания списка типов приобретения необходимо указать строку" skip
    16521                 "" 'last-date':U + "=Дата срока годности до" skip
    16522                 "v-option" v-option skip
    16523                 "p-action" p-action skip
    16524                 view-as alert-box error .
    16525               undo, return error return-value .
    16526             end.
    16527             assign
    16528               v-option-value = entry(2, v-option, "=" )
    16529             .
    16530             assign
    16531               v-last-date = date(v-option-value)
    16532             .
    16533           end.
    16534           when 'hold-date':U
    16535           then do:
    16536             if num-entries(v-option, "=") <> 2
    16537             then do:
    16538               message
    16539                 vss-workfile vss-revision vss-description skip
    16540                 "Ошибка при задании параметров вызова резервирования" skip
    16541                 "Для указания списка типов приобретения необходимо указать строку" skip
    16542                 "" 'hold-date':U + "=Дата прихода МФ" skip
    16543                 "v-option" v-option skip
    16544                 "p-action" p-action skip
    16545                 view-as alert-box error .
    16546               undo, return error return-value .
    16547             end.
    16548             assign
    16549               v-option-value = entry(2, v-option, "=" )
    16550             .
    16551             assign
    16552               v-hold-date = date(v-option-value)
    16553             .
    16554           end.
    16555           when 'negative-check':U
    16556           then do:
    16557             if num-entries(v-option, "=") <> 2
    16558             then do:
    16559               message
    16560                 vss-workfile vss-revision vss-description skip
    16561                 "Ошибка при задании параметров вызова резервирования" skip
    16562                 "Для указания типа отрицательной проверки необходимо указать строку" skip
    16563                 "" 'part-code-parent':U + "=Тип проверки" skip
    16564                 "v-option" v-option skip
    16565                 "p-action" p-action skip
    16566                 view-as alert-box error .
    16567               undo, return error return-value .
    16568             end.
    16569             assign
    16570               v-option-value = entry(2, v-option, "=" )
    16571             .
    16572             define variable v-ind as integer   no-undo .
    16573             if  v-option-value <> "1"
    16574             and v-option-value <> "2"
    16575             and v-option-value <> "3"
    16576             then do:
    16577               message
    16578                 vss-workfile vss-revision vss-description skip
    16579                 "Ошибка при задании параметров вызова резервирования" skip
    16580                 "Неизвестное значение типа отрицательной проверки" skip
    16581                 "Допустимые значения 1,2,3" skip
    16582                 "" 'part-code-parent':U + "=Тип проверки" skip
    16583                 "v-option" v-option skip
    16584                 "p-action" p-action skip
    16585                 view-as alert-box error .
    16586               undo, return error return-value .
    16587             end.
    16588             assign
    16589               v-negative-check = integer(v-option-value)
    16590             .
    16591           end.
    16592           when 'sale-negative-check-on':u
    16593           then do:
    16594             assign
    16595               v-option-sale-negative-check-on = true
    16596             .
    16597           end.
    16598           otherwise do:
    16599             message
    16600               vss-workfile vss-revision vss-description skip
    16601               "Ошибка при задании параметров вызова резервирования" skip
    16602               "Неизвестная опция." v-option skip
    16603               "p-action" p-action skip
    16604               view-as alert-box error .
    16605             undo, return error return-value .
    16606           end.
    16607         end.
    16608       end.
    16609       if  p-b-code <> ?
    16610       and p-b-code <> 0
    16611       and p-b-code <> -1
    16612       then do:
    16613         find ub.bar-code no-lock
    16614           where ub.bar-code.b-code = p-b-code
    16615           no-error.
    16616         if not available ub.bar-code
    16617         then do:
    16618           message
    16619             vss-workfile vss-revision vss-description skip
    16620             "Ошибка при задании параметров вызова резервирования" skip
    16621             "Недопустимый параметр вызова бар-код партии." skip
    16622             "Документ" v-doc-code skip
    16623             "Артикул" v-artic v-prod-type v-prod-code skip
    16624             "b-code" p-b-code skip
    16625             view-as alert-box error .
    16626           undo, return error return-value .
    16627         end.
    16628         assign
    16629           v-reserv-single-part = true
    16630           v-in-code            = ub.bar-code.in-code
    16631           v-part-code          = ub.bar-code.part-code
    16632         .
    16633         define buffer buf_parts-attr for ub.parts-attr  .
    16634             find first buf_parts-attr no-lock where
    16635                  buf_parts-attr.gds-code  = ub.bar-code.gds-code  and
    16636                  buf_parts-attr.part-code = ub.bar-code.part-code  and
    16637                  buf_parts-attr.in-code =   ub.bar-code.in-code
    16638                  no-error .
    16639                   if error-status :error then DO:
    16640                       message
    16641                         vss-workfile vss-revision vss-description skip
    16642                         error-status :get-message(1) skip
    16643                         return-value skip
    16644                         "Нет атрибута партиии для"
    16645                         ub.bar-code.gds-code  skip
    16646                         ub.bar-code.part-code skip
    16647                         ub.bar-code.in-code   skip
    16648                         view-as alert-box error
    16649                       .
    16650                   end.
    16651              else do:
    16652              assign
    16653               v-in-code   = buf_parts-attr.orig-in-code
    16654               v-part-code = buf_parts-attr.orig-part-code
    16655              .
    16656              end.
    16657       end.
    16658       assign
    16659         p-action = entry(1, p-action)
    16660       .
    16661       if  p-action <> 'reserv':U
    16662       and p-action <> 'reserv-create':U
    16663       then do:
    16664         message
    16665           vss-workfile vss-revision vss-description skip
    16666           "Ошибка при задании параметров вызова резервирования" skip
    16667           "Недопустимый параметр вызова p-action." skip
    16668           "Значение p-action: "  p-action  skip
    16669           "Допустимые значения:" skip
    16670           "" 'reserv':U skip
    16671           "" 'reserv-create':U skip
    16672           view-as alert-box error .
    16673         assign
    16674           chg-qnty = 0
    16675         .
    16676         undo, return error return-value .
    16677       end.
    16678       if chg-qnty = ?
    16679       then do:
    16680         message
    16681           vss-workfile vss-revision vss-description skip
    16682           "Ошибка при задании параметров вызова резервирования" skip
    16683           "Количество для резервирования имеет неопределенное значение" skip
    16684           view-as alert-box error .
    16685         undo, return error return-value .
    16686       end.
    16687       define variable v-check-qnty like ub.doc-line.doc-qnty no-undo .
    16688       assign
    16689         v-check-qnty = chg-qnty
    16690       .
    16691       if v-check-qnty <> chg-qnty
    16692       then do:
    16693         message
    16694           vss-workfile vss-revision vss-description skip
    16695           "Ошибка при задании параметров вызова резервирования" skip
    16696           "Запрошено резервирование дробного количества" skip
    16697           "Запрошено резервирование" chg-qnty skip
    16698           "После округления это составит" v-check-qnty skip
    16699           view-as alert-box error .
    16700         undo, return error return-value .
    16701       end.
    16702     end.
    16703   end procedure.
