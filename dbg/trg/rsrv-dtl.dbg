    13651   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ Список партий для резервирования".
    13652   define variable v-partlist-use       as logical   no-undo .
    13653   define variable v-partlist-total-num as integer   no-undo .
    13654   define temp-table temp-part-list no-undo
    13655     field ord-num   as integer
    13656     field in-code   as character
    13657     field part-code as character
    13658     field qnty      as decimal
    13659     index xpk is primary unique ord-num
    13660     index ie1 in-code part-code
    13661     .
    13662   procedure partlist_clear :
    13663     define buffer buf_temp-part-list for temp-part-list .
    13664     do
    13665     on error undo, return error return-value
    13666     :
    13667       assign
    13668         v-partlist-total-num = 0
    13669       .
    13670       for each buf_temp-part-list
    13671       on error undo, return error return-value
    13672       :
    13673         delete buf_temp-part-list .
    13674       end.
    13675     end.
    13676   end procedure.
    13677   procedure partlist_use-set :
    13678     define input  parameter p-use as logical   no-undo .
    13679     do
    13680     on error undo, return error return-value
    13681     :
    13682       assign
    13683         v-partlist-use = p-use
    13684       .
    13685     end.
    13686   end procedure.
    13687   procedure partlist_use-get :
    13688     define output parameter p-use as logical   no-undo .
    13689     do
    13690     on error undo, return error return-value
    13691     :
    13692       assign
    13693         p-use = v-partlist-use
    13694       .
    13695     end.
    13696   end procedure.
    13697   procedure partlist_append_part :
    13698     define input  parameter p-in-code   as character no-undo .
    13699     define input  parameter p-part-code as character no-undo .
    13700     define input  parameter p-qnty      as decimal   no-undo .
    13701     define buffer buf_temp-part-list for temp-part-list .
    13702     do
    13703     on error undo, return error return-value
    13704     :
    13705       assign
    13706         v-partlist-total-num = v-partlist-total-num + 1
    13707       .
    13708       create buf_temp-part-list .
    13709       assign
    13710         buf_temp-part-list.ord-num   = v-partlist-total-num
    13711         buf_temp-part-list.in-code   = p-in-code
    13712         buf_temp-part-list.part-code = p-part-code
    13713         buf_temp-part-list.qnty      = p-qnty
    13714       .
    13715     end.
    13716   end procedure.
    13717   procedure partlist_get-total-num :
    13718     define output parameter p-total-num as integer   no-undo .
    13719     do
    13720     on error undo, return error return-value
    13721     :
    13722       assign
    13723         p-total-num = v-partlist-total-num
    13724       .
    13725     end.
    13726   end procedure.
    13727   procedure partlist_get-part-qnty :
    13728     define input  parameter p-ord-num   as integer   no-undo .
    13729     define output parameter p-in-code   as character no-undo .
    13730     define output parameter p-part-code as character no-undo .
    13731     define output parameter p-qnty      as decimal   no-undo .
    13732     define buffer buf_temp-part-list for temp-part-list .
    13733     do
    13734     on error undo, return error return-value
    13735     :
    13736       find first buf_temp-part-list
    13737         where buf_temp-part-list.ord-num = p-ord-num
    13738         no-error .
    13739       if not available buf_temp-part-list
    13740       then do:
    13741         undo, return error substitute("Не найдена партия с номером &1. Текущее количество партий &2"
    13742                                      ,p-ord-num
    13743                                      ,v-partlist-total-num
    13744                                      )
    13745           .
    13746       end.
    13747       assign
    13748         p-in-code   = buf_temp-part-list.in-code
    13749         p-part-code = buf_temp-part-list.part-code
    13750         p-qnty      = buf_temp-part-list.qnty
    13751       .
    13752     end.
    13753   end procedure.
    13754   procedure partlist_check-part-qnty :
    13755     define input  parameter p-in-code    as character no-undo .
    13756     define input  parameter p-part-code  as character no-undo .
    13757     define output parameter p-part-qnty  as decimal   no-undo .
    13758     define buffer buf_temp-part-list for temp-part-list .
    13759     do
    13760     on error undo, return error return-value
    13761     :
    13762       find first buf_temp-part-list
    13763         where buf_temp-part-list.in-code   = p-in-code
    13764           and buf_temp-part-list.part-code = p-part-code
    13765         no-error .
    13766       if available buf_temp-part-list
    13767       then do:
    13768         assign
    13769           p-part-qnty = buf_temp-part-list.qnty
    13770         .
    13771       end.
    13772       else do:
    13773         assign
    13774           p-part-qnty = 0
    13775         .
    13776       end.
    13777     end.
    13778   end procedure.
