     1370                                         )
     1371                 buf_parts.is-supp       = ( if l-create-old-return then yes else no )
     1372                 buf_parts.pay-code      = buf_trn-doc.pay-code
     1373                 buf_parts.purch-code    = integer('1':U)
     1374                 buf_parts.price-base    = p-part-reserv-base
     1375                 buf_parts.price-rubl    = p-part-reserv-rubl
     1376                 buf_parts.road-tax-base = 0
     1377                 buf_parts.road-tax-rubl = 0
     1378                 buf_parts.cli-base-rate = buf_doc-line.cli-base-rate
     1379                 buf_parts.exch-code     = 0
     1380                 buf_parts.price-cli     = buf_parts.price-rubl
     1381               .
     1382             end.
     1383             validate buf_parts .
     1384           end.
     1385           when "quit":u
     1386           then do:
     1387           end.
     1388         end case .
     1389       end.
     1390       if available buf_parts
     1391       then do:
     1392         if l-fact-qnty
     1393         then do:
     1394           assign
     1395             buf_parts.fact-qnty = buf_parts.fact-qnty + p-change-qnty
     1396           .
     1397         end.
     1398         else do:
     1399           assign
     1400             buf_parts.qnty      = buf_parts.qnty + p-change-qnty
     1401             buf_parts.fact-qnty = buf_parts.qnty
     1402           .
     1403           if buf_trn-doc.doc-type = 'инв':U
     1404           then do:
     1405             assign
     1406               buf_parts.rsrv-free     = ( if buf_parts.qnty < 0
     1407                                           then true
     1408                                           else false
     1409                                         )
     1410             .
     1411           end.
     1412         end.
     1413         if l-goods-twounit = true
     1414         then do:
     1415           if p-cli-qnty <> 0
     1416           then do:
     1417             assign
     1418               buf_parts.cli-qnty = p-cli-qnty
     1419             .
     1420             assign
     1421               buf_parts.cli-base-rate = buf_parts.qnty / buf_parts.cli-qnty
     1422             .
     1423           end.
     1424         end.
     1425         else do:
     1426           if buf_parts.cli-base-rate <> 0
     1427           then do:
     1428             assign
     1429               buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
     1430             .
     1431           end.
     1432           else do:
     1433             assign
     1434               buf_parts.cli-qnty = 0
     1435             .
     1436           end.
     1437           if abs(buf_parts.cli-qnty - p-cli-qnty) < 0.0011
     1438           then do :
     1439             assign
     1440               buf_parts.cli-qnty = p-cli-qnty
     1441             .
     1442           end .
     1443         end.
     1444         if l-goods-twounit = false
     1445         then do:
     1446   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run qntycalc in g#library
     1447     (input  'cli-qnty'
     1448     ,input  buf_parts.cli-base-rate
     1449     ,input  buf_parts.cli-qnty
     1450     ,input  buf_parts.qnty
     1451     ,output buf_parts.cli-qnty
     1452     ,output buf_parts.qnty
     1453     ) no-error .
     1454           if error-status :error
     1455           then do:
     1456             message
     1457               "Невозможно пересчитать количество по ТТН" skip
     1458               "Документ" buf_parts.out-code skip
     1459               'Артикул':U buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     1460               "Партия" + string(buf_parts.part-code) skip
     1461               return-value skip
     1462               view-as alert-box .
     1463             undo, return error .
     1464           end.
     1465         end.
     1466         if l-goods-serial
     1467         then do:
     1468           if  buf_parts.qnty <> 0
     1469           and buf_parts.qnty <> 1
     1470           then do:
     1471             message
     1472               "Товар серийный." skip
     1473               "Невозможно порождение партии с количеством, отличным от 1."
     1474               view-as alert-box .
     1475             undo, return error .
     1476           end.
     1477         end.
     1478       end.
     1479       return .
     1480     end.
     1481   end procedure.
     1482   procedure partscr_check-valid-supp :
     1483     define input parameter  p-supp-type         like ub.parts.supp-type no-undo .
     1484     define input parameter  p-supp-code         like ub.parts.supp-code no-undo .
     1485     define input parameter  p-trn-doc-supp-type like ub.parts.supp-type no-undo .
     1486     define input parameter  p-trn-doc-supp-code like ub.parts.supp-code no-undo .
     1487     define input parameter  p-extended-doc-type as character no-undo .
     1488     define output parameter p-old-return        as logical no-undo .
     1489     define output parameter p-reason            as character no-undo .
     1490     assign
     1491       p-old-return = false
     1492       p-reason     = ""
     1493     .
     1494     if p-supp-type <> p-trn-doc-supp-type
     1495     or p-supp-code <> p-trn-doc-supp-code
     1496     then do:
     1497       if p-extended-doc-type = 're':U
     1498       or p-extended-doc-type = 'rs':U
     1499       or p-extended-doc-type = 'vt':U
     1500       or p-extended-doc-type = 'vp':U
     1501       then do:
     1502         if p-supp-type = 'чел':U
     1503         or p-supp-type = 'орг':U
     1504         then do:
     1505           assign
     1506             p-old-return = true
     1507           .
     1508         end.
     1509         else do:
     1510           assign
     1511             p-reason = "Поставщиком партии старого возврата может быть только человек или организация"
     1512           .
     1513           return .
     1514         end.
     1515       end.
     1516       else do:
     1517         assign
     1518           p-reason = "Поставщиком порожденной партии может быть только объект документа"
     1519         .
     1520         return .
     1521       end.
     1522     end.
     1523     return .
     1524   end procedure.
     1525   procedure partscr_get-default-values :
     1526     define parameter buffer buf_doc-line for ub.doc-line .
     1527     define output parameter p-vat-type   as character no-undo .
     1528     define output parameter p-vat-pc     as decimal   no-undo .
     1529     define output parameter p-slt-type   as character no-undo .
     1530     define output parameter p-slt-pc     as decimal   no-undo .
     1531     define buffer buf_trn-doc for ub.trn-doc .
     1532     define buffer buf_goods for ub.goods .
     1533     define variable v-vat-pc as decimal   no-undo .
     1534     define variable v-host-code as integer   no-undo .
     1535     do
     1536     on error undo, return error return-value
     1537     :
     1538       if not available buf_doc-line
     1539       then do:
     1540         message
     1541           vss-workfile vss-revision vss-description skip
     1542           "Ошибка задания входных параметров" skip
     1543           "Не задана строка документа" skip
     1544           view-as alert-box error .
     1545         undo, return error return-value .
     1546       end.
     1547       find first buf_trn-doc no-lock
     1548         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1549         no-error .
     1550       if not available buf_trn-doc
     1551       then do:
     1552         message
     1553           vss-workfile vss-revision vss-description skip
     1554           "Не найден документ" skip
     1555           "Код документа" buf_doc-line.doc-code skip
     1556           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1557           view-as alert-box error .
     1558         undo, return error return-value .
     1559       end.
     1560       find first buf_goods no-lock
     1561         where buf_goods.artic     = buf_doc-line.artic
     1562           and buf_goods.prod-type = buf_doc-line.prod-type
     1563           and buf_goods.prod-code = buf_doc-line.prod-code
     1564         no-error .
     1565       if not available buf_goods
     1566       then do:
     1567         message
     1568           vss-workfile vss-revision vss-description skip
     1569           "Ошибка поиска товара" skip
     1570           "Товар" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1571           view-as alert-box error .
     1572         undo, return error return-value .
     1573       end.
     1574       if buf_trn-doc.ext-doc-type = 'ie':U
     1575       or buf_trn-doc.ext-doc-type = 'im':U
     1576       then do:
     1577         assign
     1578           p-vat-type = buf_trn-doc.vat-type
     1579           p-vat-pc   = buf_doc-line.vat-pc
     1580           p-slt-type = buf_trn-doc.slt-type
     1581           p-slt-pc   = buf_doc-line.slt-pc
     1582         .
     1583       end.
     1584       else do:
     1585   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1587     (input  buf_doc-line.obj-type
     1588     ,input  buf_doc-line.obj-code
     1589     ,output v-host-code
     1590     )  .
     1591   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1592   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1593     (input  buf_goods.gds-code
     1594     ,input  '1':U
     1595     ,input  ?
     1596     ,input  v-host-code
     1597     ,input  buf_trn-doc.obj-type
     1598     ,input  buf_trn-doc.obj-code
     1599     ,output v-vat-pc
     1600     ) no-error .
     1601         assign
     1602           p-vat-type = 'в т. ч.':U
     1603           p-vat-pc   = v-vat-pc
     1604           p-slt-type = 'без':U
     1605           p-slt-pc   = 0
     1606         .
     1607       end.
     1608     end.
     1609   end procedure.
     1610   procedure plgdsfnd :
     1611     define input  parameter p-chk-and-chs    as logical               no-undo .
     1612     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
     1613     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
     1614     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
     1615     define output parameter p-reserv-pl-code as   logical             no-undo .
     1616     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
     1617     define buffer buf_goods         for ub.goods .
     1618     define buffer buf_pl-gds        for ub.pl-gds .
     1619     define buffer buf_second_pl-gds for ub.pl-gds .
     1620     find first buf_goods no-lock where
     1621                buf_goods.gds-code = p-gds-code no-error .
     1622     if not available buf_goods
     1623     then do:
     1624       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
     1625     end.
     1626   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1627   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     1628     (input  p-obj-type
     1629     ,input  p-obj-code
     1630     ,input  buf_goods.artic
     1631     ,input  buf_goods.prod-type
     1632     ,input  buf_goods.prod-code
     1633     ,input  'place-rsrv=request'
     1634     ,output p-reserv-pl-code
     1635     ) no-error .
     1636     if error-status :error
     1637     then do:
     1638       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
     1639     end.
     1640     if p-reserv-pl-code = no
     1641     then do:
     1642       return .
     1643     end.
     1644     if p-chk-and-chs <> yes
     1645     then do:
     1646       return .
     1647     end.
     1648     find first buf_pl-gds no-lock where
     1649                buf_pl-gds.obj-type = p-obj-type and
     1650                buf_pl-gds.obj-code = p-obj-code and
     1651                buf_pl-gds.gds-code = p-gds-code no-error .
     1652     if not available buf_pl-gds
     1653     then do:
     1654       return error "К товару не привязано ни одного места хранения" .
     1655     end.
     1656     find first buf_second_pl-gds no-lock where
     1657                buf_second_pl-gds.obj-type  = p-obj-type          and
     1658                buf_second_pl-gds.obj-code  = p-obj-code          and
     1659                buf_second_pl-gds.gds-code  = p-gds-code          and
     1660                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
     1661     if not available buf_second_pl-gds
     1662     then do:
     1663       assign
     1664         p-pl-code = buf_pl-gds.pl-code
     1665       .
     1666     end.
     1667     else do:
     1668       if not valid-handle( parparentproc )
     1669       then do:
     1670         return error "Не выбрано место хранения " + chr(10) .
     1671       end.
     1672       run str/plgdssel.p
     1673         (
     1674            input parparentproc
     1675         ,  input p-obj-type
     1676         ,  input p-obj-code
     1677         ,  input p-gds-code
     1678         , output p-pl-code
     1679         ) no-error .
     1680       if error-status :error
     1681       then do:
     1682         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
     1683                                , 'plgdssel.p':U
     1684                                , chr(10)
     1685                                , error-status :get-message( 1 )
     1686                                , return-value
     1687                                ) .
     1688       end.
     1689       if p-pl-code = ? or
     1690          p-pl-code = 0
     1691       then do:
     1692         return error "Не выбрано место хранения " + chr(10) .
     1693       end.
     1694     end.
     1695   end procedure.
     1696   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1697   define temp-table temp-trndocrs-gds-dtl-rsrv no-undo
     1698     field prt-code         like ub.gds-dtl.prt-code
     1699     field rsrv-qnty        like ub.gds-dtl.fact-qnty
     1700     field rsrv-out-qnty    like ub.gds-dtl.fact-qnty
     1701     index xpk is primary unique prt-code
     1702   .
     1703   define temp-table temp-trndocrs-pl-gds-rsrv no-undo
     1704     field pl-code          like ub.pl-gds.pl-code
     1705     field rsrv-qnty        like ub.pl-gds.free-qnty
     1706     field cli-rsrv-qnty    like ub.pl-gds.cli-free-qnty
     1707     field rsrv-out-qnty    like ub.pl-gds.fact-qnty
     1708     field before-free-qnty like ub.pl-gds.fact-qnty
     1709     field before-out-qnty  like ub.pl-gds.fact-qnty
     1710     field after-free-qnty  like ub.pl-gds.fact-qnty
     1711     field after-out-qnty   like ub.pl-gds.fact-qnty
     1712     field fact-qnty        like ub.pl-gds.fact-qnty
     1713     field cli-qnty         like ub.pl-gds.cli-qnty
     1714     field cli-fact-qnty    like ub.pl-gds.cli-fact-qnty
     1715     index xpk is primary unique pl-code
     1716   .
     1717   procedure trndocrs-gds-dtl-clear :
     1718     define buffer buf_temp-trndocrs-gds-dtl-rsrv for temp-trndocrs-gds-dtl-rsrv .
     1719     do
     1720     on error undo, return error return-value
     1721     :
