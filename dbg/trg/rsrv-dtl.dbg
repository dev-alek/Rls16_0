    14907           run trndocrs in this-procedure
    14908             (input ub.doc-line.doc-code
    14909             ,input ub.doc-line.obj-type
    14910             ,input ub.doc-line.obj-code
    14911             ,input ub.doc-line.artic
    14912             ,input ub.doc-line.prod-type
    14913             ,input ub.doc-line.prod-code
    14914             ,input chg-qnty
    14915             ) no-error .
    14916           if error-status :error
    14917           then do:
    14918             message
    14919               vss-workfile vss-revision vss-description skip
    14920               "Ошибка при изменении зарезервированных количеств trndocrs" skip
    14921               "Документ ub.trn-doc.doc-code: " ub.trn-doc.doc-code skip
    14922               "Артикул" ub.goods.artic ub.goods.gds-name skip
    14923               "производитель" ub.goods.prod-type ub.goods.prod-code skip
    14924               error-status :get-message(1) skip
    14925               return-value skip
    14926               view-as alert-box error .
    14927             assign
    14928               chg-qnty = 0
    14929             .
    14930             undo, return error return-value .
    14931           end.
    14932         end.
    14933       end.
    14934       when 'reserv-create':U
    14935       then do:
    14936         if ub.trn-doc.doc-type <> 'инв':U
    14937         then do:
    14938           message
    14939             vss-workfile vss-revision vss-description skip
    14940             "Создание резервов компенсации отрицательных партий возможно только для документа инвентаризации." skip
    14941             "Документ ub.trn-doc.doc-code: " ub.trn-doc.doc-code skip
    14942             "Тип документа ub.trn-doc.doc-type:" ub.trn-doc.doc-type skip
    14943             "Действие p-action:" p-action skip
    14944             view-as alert-box .
    14945           assign
    14946             chg-qnty = 0
    14947           .
    14948           undo, return error return-value .
    14949         end.
    14950         assign
    14951           chg-qnty = 0
    14952         .
    14953         define variable v-abs-reserv-qnty as decimal no-undo .
    14954   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14955   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    14956     (input  v-obj-type
