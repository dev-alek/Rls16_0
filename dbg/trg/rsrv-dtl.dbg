     7435       define variable v-msg                as character no-undo .
     7436       assign
     7437         v-find-first = true
     7438         v-rsrv-index = 1
     7439         v-rsrv-entry = entry(v-rsrv-index, v-partlist-order, chr(44))
     7440       .
     7441       output stream alc-rsrv to value ("alc-rsrv.log") .
     7442       rsrv_cycle:
     7443       do while p-chg-qnty <> 0
     7444       :
     7445         assign
     7446           v-iteration-chg-qnty = 0
     7447         .
