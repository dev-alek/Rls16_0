     1759   procedure trndocrs-pl-gds-accum :
     1760     define input parameter p-pl-code       like ub.pl-gds.pl-code       no-undo .
     1761     define input parameter p-rsrv-qnty     like ub.pl-gds.free-qnty     no-undo .
     1762     define input parameter p-cli-rsrv-qnty like ub.pl-gds.cli-free-qnty no-undo .
     1763     define input parameter p-fact-qnty     like ub.pl-gds.fact-qnty     no-undo .
     1764     define input parameter p-cli-fact-qnty like ub.pl-gds.cli-fact-qnty no-undo .
     1765     define buffer buf_temp-trndocrs-pl-gds-rsrv  for temp-trndocrs-pl-gds-rsrv .
     1766     do
     1767     on error undo, return error return-value
     1768     :
     1769       find first buf_temp-trndocrs-pl-gds-rsrv
     1770         where buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
     1771         no-error .
     1772       if not available buf_temp-trndocrs-pl-gds-rsrv then do:
     1773         create buf_temp-trndocrs-pl-gds-rsrv .
     1774         assign
     1775           buf_temp-trndocrs-pl-gds-rsrv.pl-code = p-pl-code
     1776         .
     1777       end.
     1778       assign
     1779         buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     = buf_temp-trndocrs-pl-gds-rsrv.rsrv-qnty     + p-rsrv-qnty
     1780         buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-rsrv-qnty + p-cli-rsrv-qnty
     1781         buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     = buf_temp-trndocrs-pl-gds-rsrv.fact-qnty     + p-fact-qnty
     1782         buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty = buf_temp-trndocrs-pl-gds-rsrv.cli-fact-qnty + p-cli-fact-qnty
     1783       .
     1784     end.
     1785   end procedure.
     1786   procedure trndocrs-gds-dtl-accum :
     1787     define input parameter p-prt-code   like ub.gds-dtl.prt-code   no-undo .
     1788     define input parameter p-rsrv-qnty like ub.gds-dtl.fact-qnty no-undo .
     1789     define buffer buf_temp-trndocrs-gds-dtl-rsrv  for temp-trndocrs-gds-dtl-rsrv .
     1790     do
     1791     on error undo, return error return-value
     1792     :
     1793       find first buf_temp-trndocrs-gds-dtl-rsrv
     1794         where buf_temp-trndocrs-gds-dtl-rsrv.prt-code = p-prt-code
     1795         no-error .
     1796       if not available buf_temp-trndocrs-gds-dtl-rsrv then do:
