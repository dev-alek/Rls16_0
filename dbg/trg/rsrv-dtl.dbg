     7413               v-partlist-order = 'parts':u
     7414             .
     7415           end.
     7416         end.
     7417       end.
     7418       if  v-partlist-use = false
     7419       and v-partlist-order <> 'parts':u
     7420       then do:
     7421         message
     7422           vss-workfile vss-revision vss-description skip
     7423           "Внутренняя ошибка резервирования" skip
     7424           view-as alert-box error .
     7425       end.
     7426       define variable v-find-first         as logical   no-undo .
     7427       define variable v-rsrv-index         as integer   no-undo .
     7428       define variable v-rsrv-entry         as character no-undo .
     7429       define variable v-iteration-chg-qnty as decimal   no-undo .
     7430       define variable v-part-index         as integer   no-undo .
