     2769   procedure lineattr-write-add-line-cli :
     2770   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2771   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2772   define input  parameter p-cli-type      as character no-undo .
     2773   define input  parameter p-cli-code      as integer   no-undo .
     2774   define input  parameter p-contract-code as integer   no-undo .
     2775   define input  parameter p-host-code     as integer   no-undo .
     2776   define input  parameter p-exch-code     as integer   no-undo .
     2777   define input  parameter p-exch-rate     as decimal   no-undo .
     2778   define input  parameter p-exch-scale    as integer   no-undo .
     2779   define input  parameter p-sum-cli       as decimal   no-undo .
     2780   define input  parameter p-sum-vat       as decimal   no-undo .
     2781   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2782     do
     2783     on error undo, return error return-value
     2784     :
     2785       find first buf_doc-line-attr exclusive-lock
     2786         where buf_doc-line-attr.doc-code  = p-doc-code
     2787           and buf_doc-line-attr.gds-code  = p-gds-code
     2788           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2789                                             chr(4) + p-cli-type +
     2790                                             chr(4) + string(p-cli-code) +
     2791                                             chr(4) + string(p-contract-code) +
     2792                                             chr(4) + string(p-host-code)
     2793         no-error .
     2794       if not available buf_doc-line-attr then do:
     2795         create buf_doc-line-attr .
     2796         assign
     2797           buf_doc-line-attr.doc-code  = p-doc-code
     2798           buf_doc-line-attr.gds-code  = p-gds-code
     2799           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     2800                                         chr(4) + p-cli-type +
     2801                                         chr(4) + string(p-cli-code) +
     2802                                         chr(4) + string(p-contract-code) +
     2803                                         chr(4) + string(p-host-code)
     2804         .
     2805       end.
     2806       assign
     2807         buf_doc-line-attr.attr-value =
     2808         string(p-exch-code)  + chr(4) +
     2809         string(p-exch-rate)  + chr(4) +
     2810         string(p-exch-scale) + chr(4) +
     2811         string(p-sum-cli)    + chr(4) +
     2812         string(p-sum-vat)
     2813         .
     2814     end.
     2815   end procedure.
     2816   procedure lineattr-value-add-line-cli :
     2817   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2818   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2819   define input   parameter p-cli-type      as character no-undo .
     2820   define input   parameter p-cli-code      as integer   no-undo .
     2821   define input   parameter p-contract-code as integer   no-undo .
     2822   define input   parameter p-host-code     as integer   no-undo .
     2823   define output  parameter p-exch-code     as integer   no-undo .
     2824   define output  parameter p-exch-rate     as decimal   no-undo .
     2825   define output  parameter p-exch-scale    as integer   no-undo .
     2826   define output  parameter p-sum-cli       as decimal   no-undo .
     2827   define output  parameter p-sum-vat       as decimal   no-undo .
     2828   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2829     do
     2830     on error undo, return error return-value
     2831     :
     2832       find first buf_doc-line-attr exclusive-lock
     2833         where buf_doc-line-attr.doc-code  = p-doc-code
     2834           and buf_doc-line-attr.gds-code  = p-gds-code
     2835           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2836                                             chr(4) + p-cli-type +
     2837                                             chr(4) + string(p-cli-code) +
     2838                                             chr(4) + string(p-contract-code) +
     2839                                             chr(4) + string(p-host-code)
     2840         no-error .
     2841       if available buf_doc-line-attr then do:
     2842        assign
     2843           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     2844           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     2845           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     2846           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     2847           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     2848          .
     2849        end.
     2850     end.
     2851   end procedure.
     2852   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     2853     define variable v-code as character no-undo .
     2854     define variable v-type as character no-undo .
     2855     define variable v-gds-code as integer   no-undo .
     2856   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2858     (input  local-doc-line.artic
     2859     ,input  local-doc-line.prod-type
     2860     ,input  local-doc-line.prod-code
     2861     ,output v-gds-code
     2862     )  .
     2863     run lineattr-value (
     2864         input   local-doc-line.doc-code ,
     2865         input   v-gds-code              ,
     2866         input   'reason-code':U ,
     2867         output  v-code                  ,
     2868         output  v-type ) .
     2869     find first ub.trn-reason no-lock where
     2870                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     2871     if not available ub.trn-reason then do:
     2872        return "" .
     2873     end.
     2874     else do:
     2875        return ub.trn-reason.reason-name .
     2876     end.
     2877   end function.
     2878   procedure lineattr-value-parts :
