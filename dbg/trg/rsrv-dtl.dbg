    15047   procedure rename-part-code :
    15048     define input  parameter p-obj-type      as character no-undo .
    15049     define input  parameter p-obj-code      as integer   no-undo .
    15050     define input  parameter p-artic         as character no-undo .
    15051     define input  parameter p-prod-type     as character no-undo .
    15052     define input  parameter p-prod-code     as integer   no-undo .
    15053     define input  parameter p-in-code       as character no-undo .
    15054     define input  parameter p-out-code      as character no-undo .
    15055     define input  parameter p-old-part-code as character no-undo .
    15056     define input  parameter p-new-part-code as character no-undo .
    15057     define buffer buf_new_parts for ub.parts .
    15058     define buffer buf_old_parts for ub.parts .
    15059     do
    15060     on error undo, return error return-value
    15061     :
    15062       find first buf_new_parts
    15063         where buf_new_parts.obj-type   = p-obj-type
    15064           and buf_new_parts.obj-code   = p-obj-code
    15065           and buf_new_parts.artic      = p-artic
    15066           and buf_new_parts.prod-type  = p-prod-type
    15067           and buf_new_parts.prod-code  = p-prod-code
    15068           and buf_new_parts.in-code    = p-in-code
    15069           and buf_new_parts.out-code   = p-out-code
    15070           and buf_new_parts.part-code  = p-new-part-code
    15071         no-error .
    15072       if available buf_new_parts
    15073       then do:
    15074         undo, return error substitute("Уже существует партия с кодом &1"
    15075                                      ,p-new-part-code
    15076                                      )
    15077           .
    15078       end.
    15079       find first buf_old_parts
    15080         where buf_old_parts.obj-type   = p-obj-type
    15081           and buf_old_parts.obj-code   = p-obj-code
    15082           and buf_old_parts.artic      = p-artic
    15083           and buf_old_parts.prod-type  = p-prod-type
    15084           and buf_old_parts.prod-code  = p-prod-code
    15085           and buf_old_parts.in-code    = p-in-code
    15086           and buf_old_parts.out-code   = p-out-code
    15087           and buf_old_parts.part-code  = p-old-part-code
    15088         no-error .
    15089       if not available buf_old_parts
    15090       then do:
    15091         undo, return error substitute("Не найдена партия с кодом &1"
    15092                                      ,p-old-part-code
    15093                                      )
    15094           .
    15095       end.
    15096       assign
    15097         buf_old_parts.part-code = p-new-part-code
    15098       .
    15099     end.
    15100   end procedure.
    15101   procedure delete-empty-parts :
    15102     define buffer buf_parts        for ub.parts .
    15103     define buffer buf_free-parts   for ub.parts .
    15104     define buffer buf_output-parts for ub.parts .
    15105     do
    15106     on error undo, return error return-value
    15107     :
    15108       for each buf_parts
    15109         where buf_parts.obj-type  = ub.doc-line.obj-type
    15110           and buf_parts.obj-code  = ub.doc-line.obj-code
    15111           and buf_parts.artic     = ub.doc-line.artic
    15112           and buf_parts.prod-type = ub.doc-line.prod-type
    15113           and buf_parts.prod-code = ub.doc-line.prod-code
    15114           and buf_parts.out-code  = ub.doc-line.doc-code
    15115       on error undo, return error return-value
    15116       :
    15117         find first buf_free-parts
    15118           where buf_free-parts.obj-type   = buf_parts.obj-type
    15119             and buf_free-parts.obj-code   = buf_parts.obj-code
    15120             and buf_free-parts.artic      = buf_parts.artic
    15121             and buf_free-parts.prod-type  = buf_parts.prod-type
    15122             and buf_free-parts.prod-code  = buf_parts.prod-code
    15123             and buf_free-parts.in-code    = buf_parts.in-code
    15124             and buf_free-parts.out-code   = 'free-zone':U
    15125             and buf_free-parts.part-code  = buf_parts.part-code
    15126           no-error .
    15127         find first buf_output-parts
    15128           where buf_output-parts.obj-type   = buf_parts.obj-type
    15129             and buf_output-parts.obj-code   = buf_parts.obj-code
    15130             and buf_output-parts.artic      = buf_parts.artic
    15131             and buf_output-parts.prod-type  = buf_parts.prod-type
    15132             and buf_output-parts.prod-code  = buf_parts.prod-code
    15133             and buf_output-parts.in-code    = buf_parts.in-code
    15134             and buf_output-parts.out-code   = 'out-zone':U
    15135             and buf_output-parts.part-code  = buf_parts.part-code
    15136           no-error .
    15137         if  available buf_free-parts
    15138         and buf_free-parts.qnty      = 0
    15139         and buf_free-parts.fact-qnty = 0
    15140         then do:
    15141           delete buf_free-parts .
    15142         end.
    15143         if available buf_output-parts
    15144         and buf_output-parts.qnty      = 0
    15145         and buf_output-parts.fact-qnty = 0
    15146         then do:
    15147           delete buf_output-parts .
    15148         end.
    15149         if  buf_parts.qnty        = 0
    15150         and buf_parts.fact-qnty   = 0
    15151         then do:
    15152           delete buf_parts .
    15153         end.
    15154       end.
    15155     end.
    15156   end procedure.
    15157   procedure rsrv-pri-doc :
    15158     define variable v-vat-type as character no-undo .
    15159     define variable v-vat-pc   as decimal   no-undo .
    15160     define variable v-slt-type as character no-undo .
    15161     define variable v-slt-pc   as decimal   no-undo .
    15162     define variable out-rest   as decimal   no-undo .
    15163     do
    15164     on error undo, return error return-value
    15165     :
    15166       if v-goods-serial = true
    15167       then do:
    15168         return .
    15169       end.
    15170       if (chg-qnty > 0
    15171       or v-goods-twounit = true)
    15172       and not is-gas(ub.goods.gds-code)
    15173       then do:
    15174         if v-goods-twounit = true
    15175         then do:
    15176           if v-cli-qnty = ?
    15177           then do:
    15178             message
    15179               vss-workfile vss-revision vss-description skip
    15180               "Ошибка задания входных параметров" skip
    15181               "Для ювелирных изделий необходимо задать клиентское количество" skip
    15182               "Документ" v-doc-code skip
    15183               "Артикул" v-artic v-prod-type v-prod-code skip
    15184               "v-cli-qnty" v-cli-qnty skip
    15185               view-as alert-box error .
    15186             undo, return error return-value .
    15187           end.
    15188         end.
    15189         run partscr_get-default-values in this-procedure
    15190           (buffer ub.doc-line
    15191           ,output v-vat-type
    15192           ,output v-vat-pc
    15193           ,output v-slt-type
    15194           ,output v-slt-pc
    15195           ) .
    15196         if v-vat-type = 'без':U then
    15197         assign
    15198           ub.doc-line.vat-pc = 0
    15199           v-vat-pc = 0
    15200         .
    15201         if v-slt-type = 'без':U then
    15202         assign
    15203           ub.doc-line.slt-pc = 0
    15204           v-slt-pc = 0
    15205         .
    15206         run partscr in this-procedure
    15207           (input  parparentproc
    15208           ,input  v-cntxt-db-num
    15209           ,input  v-cntxt-userid
    15210           ,input
    15211           ( if ub.trn-doc.doc-type = 'при':U then ub.trn-doc.cli-type else ub.trn-doc.obj-type )
    15212           ,input
    15213           ( if ub.trn-doc.doc-type = 'при':U then ub.trn-doc.cli-code else ub.trn-doc.obj-code )
    15214           ,input  v-create-part-code
    15215           ,input  v-create-cst-code
    15216           ,input  v-create-ps
    15217           ,input  v-create-dop
    15218           ,input  v-reserv-base
    15219           ,input  v-reserv-rubl
    15220           ,input  v-vat-type
    15221           ,input  v-vat-pc
    15222           ,input  v-slt-type
    15223           ,input  v-slt-pc
    15224           ,input  chg-qnty
    15225           ,input  v-partscr-prompt-price
    15226           ,input  v-cli-qnty
    15227           ,input  v-last-date
    15228           ,input  v-hold-date
    15229           ,input  v-pl-code
    15230           ,buffer ub.doc-line
    15231           ,buffer ub.parts
    15232           ) no-error .
    15233         if error-status :error
    15234         then do:
    15235           if error-status :get-message(1) <> ""
    15236           then do:
    15237             message
    15238               vss-workfile vss-revision vss-description skip
    15239               "Ошибка при создании партии" skip
    15240               "Документ" ub.doc-line.doc-code skip
    15241               "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
    15242               error-status :get-message(1) skip
    15243               return-value skip
    15244               view-as alert-box error .
    15245           end.
    15246           undo, return error return-value .
    15247         end.
    15248         if v-hold-code-parent <> ""
    15249         then do:
    15250           run holdprts-create-parts-supp in this-procedure
    15251             (input v-hold-code-parent
    15252             ,input v-hold-part-code
    15253             ,input ub.parts.in-code
    15254             ,input ub.parts.artic
    15255             ,input ub.parts.prod-type
    15256             ,input ub.parts.prod-code
    15257             ,input ub.parts.part-code
    15258             ) no-error .
    15259           if error-status :error
    15260           then do:
    15261             message
    15262               vss-workfile vss-revision vss-description skip
    15263               "Ошибка при копировании атрибутов партии" skip
    15264               "Документ" ub.doc-line.doc-code skip
    15265               "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
    15266               error-status :get-message(1) skip
    15267               return-value skip
    15268               view-as alert-box error .
    15269             undo, return error return-value .
    15270           end.
    15271         end.
    15272       end.
    15273       else do:
    15274         if was-created-part-code = yes then do:
    15275           find first ub.parts
    15276                where ub.parts.obj-type  = ub.doc-line.obj-type
    15277                  and ub.parts.obj-code  = ub.doc-line.obj-code
    15278                  and ub.parts.artic     = ub.doc-line.artic
    15279                  and ub.parts.prod-type = ub.doc-line.prod-type
    15280                  and ub.parts.prod-code = ub.doc-line.prod-code
    15281                  and ub.parts.in-code   = ub.doc-line.doc-code
    15282                  and ub.parts.out-code  = ub.doc-line.doc-code
    15283                  and ub.parts.part-code = v-create-part-code    no-error.
    15284           if available ub.parts then do:
    15285             assign
    15286               out-rest = abs( chg-qnty )
    15287             .
    15288             if ub.parts.qnty      >= abs( chg-qnty ) and
    15289                ub.parts.fact-qnty >= abs( chg-qnty ) then do:
    15290               assign
    15291                 ub.parts.qnty      = ub.parts.qnty - out-rest
    15292                 ub.parts.fact-qnty = ub.parts.qnty
    15293                 chg-qnty           = chg-qnty      + out-rest
    15294               .
    15295   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run qntycalc in g#library
    15296     (input  'cli-qnty'
    15297     ,input  ub.parts.cli-base-rate
    15298     ,input  ub.parts.cli-qnty
    15299     ,input  ub.parts.qnty
    15300     ,output ub.parts.cli-qnty
    15301     ,output ub.parts.qnty
    15302     ) no-error .
    15303               if error-status :error
    15304               then do:
    15305                 message
    15306                   "Невозможно пересчитать количество по ТТН" skip
    15307                   "Документ" ub.parts.out-code skip
    15308                   "Артикул" ub.parts.artic ub.parts.prod-type ub.parts.prod-code skip
    15309                   "Партия" ub.parts.part-code skip
    15310                   error-status :get-message(1) skip
    15311                   return-value skip
    15312                   view-as alert-box error .
    15313                 undo, return error return-value .
    15314               end.
    15315             end.
    15316             else do:
    15317               message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
    15318                       "Невозможно выполнить резервирование по партии" skip( 0 )
    15319                       "Объект" ub.parts.obj-type ub.parts.obj-code skip( 0 )
    15320                       "Документ" ub.parts.out-code skip( 0 )
    15321                       "Артикул" ub.parts.artic ub.parts.prod-type ub.parts.prod-code skip( 0 )
    15322                       "Партия" ub.parts.part-code "  (" ub.parts.in-code ")" skip( 0 )
    15323                       "Запрошенное количество для резервирования:" chg-qnty skip( 0 )
    15324                       "Количество товара в партии:" ub.parts.fact-qnty skip( 1 )
    15325               view-as alert-box error .
    15326               undo, return error return-value .
    15327             end.
    15328           end.
    15329         end.
    15330         if abs( chg-qnty ) > 0 then do:
    15331           for each ub.parts
    15332             where ub.parts.obj-type  = ub.doc-line.obj-type
    15333               and ub.parts.obj-code  = ub.doc-line.obj-code
    15334               and ub.parts.artic     = ub.doc-line.artic
    15335               and ub.parts.prod-type = ub.doc-line.prod-type
    15336               and ub.parts.prod-code = ub.doc-line.prod-code
    15337               and ub.parts.in-code   = ub.doc-line.doc-code
    15338               and ub.parts.out-code  = ub.doc-line.doc-code
    15339           on error undo, return error return-value
    15340           :
    15341             assign
    15342               out-rest = min(ub.parts.qnty, abs(chg-qnty) )
    15343             .
    15344             assign
    15345               ub.parts.qnty      = ub.parts.qnty - out-rest
    15346               ub.parts.fact-qnty = ub.parts.qnty
    15347               chg-qnty           = chg-qnty      + out-rest
    15348             .
    15349   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run qntycalc in g#library
    15350     (input  'cli-qnty'
    15351     ,input  ub.parts.cli-base-rate
    15352     ,input  ub.parts.cli-qnty
    15353     ,input  ub.parts.qnty
    15354     ,output ub.parts.cli-qnty
    15355     ,output ub.parts.qnty
    15356     ) no-error .
    15357             if error-status :error
    15358             then do:
    15359               message
    15360                 "Невозможно пересчитать количество по ТТН" skip
    15361                 "Документ" ub.parts.out-code skip
    15362                 "Артикул" ub.parts.artic ub.parts.prod-type ub.parts.prod-code skip
    15363                 "Партия" + string(ub.parts.part-code) skip
    15364                 error-status :get-message(1) skip
    15365                 return-value skip
    15366                 view-as alert-box error .
    15367               undo, return error return-value .
    15368             end.
    15369             if chg-qnty = 0
    15370             then do:
    15371               leave.
    15372             end.
    15373           end.
    15374         end.
    15375       end.
    15376     end.
    15377   end procedure.
    15378   procedure rsrv-pri-fact :
    15379     define variable v-vat-type as character no-undo .
    15380     define variable v-vat-pc   as decimal   no-undo .
    15381     define variable v-slt-type as character no-undo .
    15382     define variable v-slt-pc   as decimal   no-undo .
    15383     define variable out-rest   as decimal   no-undo .
    15384     do
    15385     on error undo, return error return-value
    15386     :
    15387       if chg-qnty = 0
    15388       then do:
    15389         return.
    15390       end.
    15391       if v-goods-serial = true
    15392       then do:
    15393         return .
    15394       end.
    15395       if v-goods-twounit = true
    15396       then do:
    15397       end.
    15398       if chg-qnty > 0
    15399       then do:
    15400         for each ub.parts
    15401           where ub.parts.obj-type  = ub.doc-line.obj-type
    15402             and ub.parts.obj-code  = ub.doc-line.obj-code
    15403             and ub.parts.artic     = ub.doc-line.artic
    15404             and ub.parts.prod-type = ub.doc-line.prod-type
    15405             and ub.parts.prod-code = ub.doc-line.prod-code
    15406             and ub.parts.in-code   = ub.doc-line.doc-code
    15407             and ub.parts.out-code  = ub.doc-line.doc-code
    15408             and ub.parts.fact-qnty < ub.parts.qnty
    15409         on error undo, return error return-value
    15410         :
    15411           if  v-reserv-pl-code = yes
    15412           and v-pl-code <> ?
    15413           and v-pl-code <> 0
    15414           and v-pl-code <> ub.parts.pl-code
    15415           then do:
    15416             next .
    15417           end.
    15418           assign
    15419             out-rest = min(ub.parts.qnty - ub.parts.fact-qnty, abs(chg-qnty))
    15420           .
    15421           assign
    15422             ub.parts.fact-qnty = ub.parts.fact-qnty + out-rest
    15423             chg-qnty           = chg-qnty           - out-rest
    15424           .
    15425           if chg-qnty = 0
    15426           then do:
    15427             leave.
    15428           end.
    15429         end.
    15430         if chg-qnty > 0
    15431         and not is-gas(ub.goods.gds-code)
    15432         then do:
    15433           run partscr_get-default-values in this-procedure
    15434             (buffer ub.doc-line
    15435             ,output v-vat-type
    15436             ,output v-vat-pc
    15437             ,output v-slt-type
    15438             ,output v-slt-pc
    15439             ) .
    15440           run partscr in this-procedure
    15441             (input  parparentproc
    15442             ,input  v-cntxt-db-num
    15443             ,input  v-cntxt-userid
    15444             ,input
    15445           ( if ub.trn-doc.doc-type = 'при':U then ub.trn-doc.cli-type else ub.trn-doc.obj-type )
    15446             ,input
    15447           ( if ub.trn-doc.doc-type = 'при':U then ub.trn-doc.cli-code else ub.trn-doc.obj-code )
    15448             ,input  v-create-part-code
    15449             ,input  v-create-cst-code
    15450             ,input  v-create-ps
    15451             ,input  v-create-dop
    15452             ,input  v-reserv-base
    15453             ,input  v-reserv-rubl
    15454             ,input  v-vat-type
    15455             ,input  v-vat-pc
    15456             ,input  v-slt-type
    15457             ,input  v-slt-pc
    15458             ,input  chg-qnty
    15459             ,input  v-partscr-prompt-price
    15460             ,input  0
    15461             ,input  v-last-date
    15462             ,input  v-hold-date
    15463             ,input  v-pl-code
    15464             ,buffer ub.doc-line
    15465             ,buffer ub.parts
    15466             ) no-error .
    15467           if error-status :error
    15468           then do:
    15469             message
    15470               vss-workfile vss-revision vss-description skip
    15471               "Ошибка при создании партии" skip
    15472               "Документ" ub.doc-line.doc-code skip
    15473               "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
    15474               error-status :get-message(1) skip
    15475               return-value skip
    15476               view-as alert-box error .
    15477             undo, return error return-value .
    15478           end.
    15479         end.
    15480       end.
    15481       else do:
    15482         for each ub.parts
    15483           where ub.parts.obj-type  = ub.doc-line.obj-type
    15484             and ub.parts.obj-code  = ub.doc-line.obj-code
    15485             and ub.parts.artic     = ub.doc-line.artic
    15486             and ub.parts.prod-type = ub.doc-line.prod-type
    15487             and ub.parts.prod-code = ub.doc-line.prod-code
    15488             and ub.parts.in-code   = ub.doc-line.doc-code
    15489             and ub.parts.out-code  = ub.doc-line.doc-code
    15490             and ub.parts.fact-qnty > 0
    15491         on error undo, return error return-value
    15492         :
    15493           if  v-reserv-pl-code = yes
    15494           and v-pl-code <> ?
    15495           and v-pl-code <> 0
    15496           and v-pl-code <> ub.parts.pl-code
    15497           then do:
    15498             next .
    15499           end.
    15500           assign
    15501             out-rest = min(ub.parts.fact-qnty, abs(chg-qnty))
    15502           .
    15503           assign
    15504             ub.parts.fact-qnty = ub.parts.fact-qnty - out-rest
    15505             chg-qnty           = chg-qnty           + out-rest
    15506           .
    15507           if chg-qnty = 0
    15508           then do:
    15509             leave.
    15510           end.
    15511         end.
    15512       end.
    15513     end.
    15514   end procedure.
    15515   procedure cost-calc :
    15516       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
    15517     do
    15518     on error undo, return error return-value
    15519     :
    15520       run partrqst in this-procedure
    15521         (input  ub.doc-line.doc-code
    15522         ,input  ub.doc-line.obj-type
    15523         ,input  ub.doc-line.obj-code
    15524         ,input  ub.doc-line.artic
    15525         ,input  ub.doc-line.prod-type
    15526         ,input  ub.doc-line.prod-code
    15527               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
    15528         ) no-error .
    15529       if error-status :error
    15530       then do:
    15531         message
    15532           vss-workfile vss-revision vss-description skip
    15533           "Ошибка при сборе информации по партиям" skip
    15534           "Документ" ub.doc-line.doc-code skip
    15535           "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
    15536           error-status :get-message(1) skip
    15537           return-value skip
    15538           view-as alert-box error .
    15539         undo, return error return-value .
    15540       end.
    15541       if v-total-parts-fact-qnty <> 0
    15542       then do:
    15543         assign
    15544           cost-base = v-total-parts-price-base / v-total-parts-fact-qnty
    15545           cost-rubl = v-total-parts-price-rubl / v-total-parts-fact-qnty
    15546         .
    15547       end.
    15548       else do:
    15549         assign
    15550           cost-base = v-reserv-base
    15551           cost-rubl = v-reserv-rubl
    15552         .
    15553       end.
    15554     end.
    15555   end procedure.
    15556   procedure rsrv-fact :
    15557     do
    15558     on error undo, return error return-value
    15559     :
    15560       if chg-qnty = 0
    15561       then do:
    15562         return.
    15563       end.
    15564       if chg-qnty < 0
    15565       then do:
    15566         for each ub.parts
    15567           where ub.parts.obj-type  = ub.doc-line.obj-type
    15568             and ub.parts.obj-code  = ub.doc-line.obj-code
    15569             and ub.parts.artic     = ub.doc-line.artic
    15570             and ub.parts.prod-type = ub.doc-line.prod-type
    15571             and ub.parts.prod-code = ub.doc-line.prod-code
    15572             and ub.parts.out-code  = ub.doc-line.doc-code
    15573             and ub.parts.status_ = no
    15574             and ub.parts.fact-qnty > ub.parts.qnty
    15575         on error undo, return error return-value
    15576         :
    15577           if  v-reserv-pl-code = yes
    15578           and v-pl-code <> ?
    15579           and v-pl-code <> 0
    15580           and v-pl-code <> ub.parts.pl-code
    15581           then do:
    15582             next .
    15583           end.
    15584           if ub.parts.fact-qnty - ub.parts.qnty >= abs(chg-qnty)
    15585           then do:
    15586             assign
    15587               ub.parts.fact-qnty = ub.parts.fact-qnty - abs(chg-qnty)
    15588               chg-qnty           = 0
    15589             .
    15590             if v-goods-twounit <> true
    15591             then do:
    15592               if ub.parts.cli-base-rate <> 0
    15593               then do:
    15594                 assign
    15595                   ub.parts.cli-qnty = ub.parts.fact-qnty / ub.parts.cli-base-rate
    15596                 .
    15597               end.
    15598               else do:
    15599                 assign
    15600                   ub.parts.cli-qnty = 0
    15601                 .
    15602               end.
    15603             end.
    15604             return.
    15605           end.
    15606           else do:
    15607             assign
    15608               chg-qnty           = chg-qnty  + ( ub.parts.fact-qnty - ub.parts.qnty)
    15609               ub.parts.fact-qnty = ub.parts.qnty
    15610             .
    15611             if v-goods-twounit <> true
    15612             then do:
    15613               if ub.parts.cli-base-rate <> 0
    15614               then do:
    15615                 assign
    15616                   ub.parts.cli-qnty = ub.parts.fact-qnty / ub.parts.cli-base-rate
    15617                 .
    15618               end.
    15619               else do:
    15620                 assign
    15621                   ub.parts.cli-qnty = 0
    15622                 .
    15623               end.
    15624             end.
    15625           end.
    15626         end.
    15627         if  v-reserv-pl-code = yes
    15628         and v-pl-code <> ?
    15629         and v-pl-code <> 0
    15630         then do:
    15631           find last ub.parts
    15632             where ub.parts.obj-type  = ub.doc-line.obj-type
    15633               and ub.parts.obj-code  = ub.doc-line.obj-code
    15634               and ub.parts.artic     = ub.doc-line.artic
    15635               and ub.parts.prod-type = ub.doc-line.prod-type
    15636               and ub.parts.prod-code = ub.doc-line.prod-code
    15637               and ub.parts.out-code  = ub.doc-line.doc-code
    15638               and ub.parts.pl-code   = v-pl-code
    15639               and ub.parts.status_   = no
    15640               and ub.parts.fact-qnty > 0
    15641           use-index pi
    15642           no-error .
    15643         end.
    15644         else do:
    15645           release ub.parts .
    15646         end.
    15647         if not available ub.parts
    15648         then do:
    15649           find last ub.parts
    15650             where ub.parts.obj-type  = ub.doc-line.obj-type
    15651               and ub.parts.obj-code  = ub.doc-line.obj-code
    15652               and ub.parts.artic     = ub.doc-line.artic
    15653               and ub.parts.prod-type = ub.doc-line.prod-type
    15654               and ub.parts.prod-code = ub.doc-line.prod-code
    15655               and ub.parts.out-code  = ub.doc-line.doc-code
    15656               and ub.parts.status_   = no
    15657               and ub.parts.fact-qnty > 0
    15658             use-index pi
    15659             .
    15660         end.
    15661         do while chg-qnty < 0
    15662         :
    15663           if ub.parts.fact-qnty >= abs(chg-qnty)
    15664           then do:
    15665             assign
    15666               ub.parts.fact-qnty = ub.parts.fact-qnty - abs(chg-qnty)
    15667               chg-qnty           = 0
    15668             .
    15669             if v-goods-twounit <> true
    15670             then do:
    15671               if ub.parts.cli-base-rate <> 0
    15672               then do:
    15673                 assign
    15674                   ub.parts.cli-qnty = ub.parts.fact-qnty / ub.parts.cli-base-rate
    15675                 .
    15676               end.
    15677               else do:
    15678                 assign
    15679                   ub.parts.cli-qnty = 0
    15680                 .
    15681               end.
    15682             end.
    15683             leave.
    15684           end.
    15685           else do:
    15686             assign
    15687               chg-qnty           = chg-qnty  + ub.parts.fact-qnty
    15688               ub.parts.fact-qnty = 0
    15689             .
    15690             if v-goods-twounit <> true
    15691             then do:
    15692               if ub.parts.cli-base-rate <> 0
    15693               then do:
    15694                 assign
    15695                   ub.parts.cli-qnty = ub.parts.fact-qnty / ub.parts.cli-base-rate
    15696                 .
    15697               end.
    15698               else do:
    15699                 assign
    15700                   ub.parts.cli-qnty = 0
    15701                 .
    15702               end.
    15703             end.
    15704           end.
    15705           if  v-reserv-pl-code = yes
    15706           and v-pl-code <> ?
    15707           and v-pl-code <> 0
    15708           then do:
    15709             find prev ub.parts
    15710               where ub.parts.obj-type  = ub.doc-line.obj-type
    15711                 and ub.parts.obj-code  = ub.doc-line.obj-code
    15712                 and ub.parts.artic     = ub.doc-line.artic
    15713                 and ub.parts.prod-type = ub.doc-line.prod-type
    15714                 and ub.parts.prod-code = ub.doc-line.prod-code
    15715                 and ub.parts.out-code  = ub.doc-line.doc-code
    15716                 and ub.parts.pl-code   = v-pl-code
    15717                 and ub.parts.status_   = no
    15718                 and ub.parts.fact-qnty > 0
    15719               use-index pi
    15720               no-error .
    15721           end.
    15722           else do:
    15723             release ub.parts .
    15724           end.
    15725           if not available ub.parts
    15726           then do:
    15727             find prev ub.parts
    15728               where ub.parts.obj-type  = ub.doc-line.obj-type
    15729                 and ub.parts.obj-code  = ub.doc-line.obj-code
    15730                 and ub.parts.artic     = ub.doc-line.artic
    15731                 and ub.parts.prod-type = ub.doc-line.prod-type
    15732                 and ub.parts.prod-code = ub.doc-line.prod-code
    15733                 and ub.parts.out-code  = ub.doc-line.doc-code
    15734                 and ub.parts.status_   = no
    15735                 and ub.parts.fact-qnty > 0
    15736               use-index pi
    15737               .
    15738           end.
    15739         end.
    15740       end.
    15741       else do:
    15742         if  v-reserv-pl-code = yes
    15743         and v-pl-code <> ?
    15744         and v-pl-code <> 0
    15745         then do:
    15746           find first ub.parts
    15747             where ub.parts.obj-type  = ub.doc-line.obj-type
    15748               and ub.parts.obj-code  = ub.doc-line.obj-code
    15749               and ub.parts.artic     = ub.doc-line.artic
    15750               and ub.parts.prod-type = ub.doc-line.prod-type
    15751               and ub.parts.prod-code = ub.doc-line.prod-code
    15752               and ub.parts.out-code  = ub.doc-line.doc-code
    15753               and ub.parts.pl-code   = v-pl-code
    15754               and ub.parts.status_   = no
    15755               and ub.parts.fact-qnty < ub.parts.qnty
    15756           use-index pi
    15757           no-error .
    15758         end.
    15759         else do:
    15760           find first ub.parts
    15761             where ub.parts.obj-type  = ub.doc-line.obj-type
    15762               and ub.parts.obj-code  = ub.doc-line.obj-code
    15763               and ub.parts.artic     = ub.doc-line.artic
    15764               and ub.parts.prod-type = ub.doc-line.prod-type
    15765               and ub.parts.prod-code = ub.doc-line.prod-code
    15766               and ub.parts.out-code  = ub.doc-line.doc-code
    15767               and ub.parts.status_   = no
    15768               and ub.parts.fact-qnty < ub.parts.qnty
    15769             use-index pi
    15770             no-error.
    15771         end.
    15772         if available parts
    15773         then do:
    15774           do while chg-qnty > 0
    15775           :
    15776             if ub.parts.qnty - ub.parts.fact-qnty >= chg-qnty
    15777             then do:
    15778               assign
    15779                 ub.parts.fact-qnty = ub.parts.fact-qnty + chg-qnty
    15780                 chg-qnty           = 0
    15781               .
    15782               if v-goods-twounit <> true
    15783               then do:
    15784                 if ub.parts.cli-base-rate <> 0
    15785                 then do:
    15786                   assign
    15787                     ub.parts.cli-qnty = ub.parts.fact-qnty / ub.parts.cli-base-rate
    15788                   .
    15789                 end.
    15790                 else do:
    15791                   assign
    15792                     ub.parts.cli-qnty = 0
    15793                   .
    15794                 end.
    15795               end.
    15796               leave.
    15797             end.
    15798             else do:
    15799               assign
    15800                 chg-qnty           = chg-qnty  - (ub.parts.qnty - ub.parts.fact-qnty)
    15801                 ub.parts.fact-qnty = ub.parts.qnty
    15802               .
    15803               if v-goods-twounit <> true
    15804               then do:
    15805                 if ub.parts.cli-base-rate <> 0
    15806                 then do:
    15807                   assign
    15808                     ub.parts.cli-qnty = ub.parts.fact-qnty / ub.parts.cli-base-rate
    15809                   .
    15810                 end.
    15811                 else do:
    15812                   assign
    15813                     ub.parts.cli-qnty = 0
    15814                   .
    15815                 end.
    15816               end.
    15817             end.
    15818             if  v-reserv-pl-code = yes
    15819             and v-pl-code <> ?
    15820             and v-pl-code <> 0
    15821             then do:
    15822               find next ub.parts
    15823                 where ub.parts.obj-type  = ub.doc-line.obj-type
    15824                   and ub.parts.obj-code  = ub.doc-line.obj-code
    15825                   and ub.parts.artic     = ub.doc-line.artic
    15826                   and ub.parts.prod-type = ub.doc-line.prod-type
    15827                   and ub.parts.prod-code = ub.doc-line.prod-code
    15828                   and ub.parts.out-code  = ub.doc-line.doc-code
    15829                   and ub.parts.pl-code   = v-pl-code
    15830                   and ub.parts.status_   = no
    15831                   and ub.parts.fact-qnty < ub.parts.qnty
    15832                 use-index pi
    15833                 no-error .
    15834             end.
    15835             else do:
    15836               find next ub.parts
    15837                 where ub.parts.obj-type  = ub.doc-line.obj-type
    15838                   and ub.parts.obj-code  = ub.doc-line.obj-code
    15839                   and ub.parts.artic     = ub.doc-line.artic
    15840                   and ub.parts.prod-type = ub.doc-line.prod-type
    15841                   and ub.parts.prod-code = ub.doc-line.prod-code
    15842                   and ub.parts.out-code  = ub.doc-line.doc-code
    15843                   and ub.parts.status_   = no
    15844                   and ub.parts.fact-qnty < ub.parts.qnty
    15845                 use-index pi
    15846                 no-error.
    15847             end.
    15848             if not available ub.parts
    15849             then do:
    15850               leave.
    15851             end.
    15852           end.
    15853         end.
    15854         if chg-qnty > 0
    15855         then do:
    15856           if  v-reserv-pl-code = yes
    15857           and v-pl-code <> ?
    15858           and v-pl-code <> 0
    15859           then do:
    15860             find first ub.parts
    15861               where ub.parts.obj-type  = ub.doc-line.obj-type
    15862                 and ub.parts.obj-code  = ub.doc-line.obj-code
    15863                 and ub.parts.artic     = ub.doc-line.artic
    15864                 and ub.parts.prod-type = ub.doc-line.prod-type
    15865                 and ub.parts.prod-code = ub.doc-line.prod-code
    15866                 and ub.parts.out-code  = ub.doc-line.doc-code
    15867                 and ub.parts.pl-code   = v-pl-code
    15868                 and ub.parts.status_   = no
    15869               use-index pi
    15870               .
    15871           end.
    15872           else do:
    15873             find first ub.parts
    15874               where ub.parts.obj-type  = ub.doc-line.obj-type
    15875                 and ub.parts.obj-code  = ub.doc-line.obj-code
    15876                 and ub.parts.artic     = ub.doc-line.artic
    15877                 and ub.parts.prod-type = ub.doc-line.prod-type
    15878                 and ub.parts.prod-code = ub.doc-line.prod-code
    15879                 and ub.parts.out-code  = ub.doc-line.doc-code
    15880                 and ub.parts.status_   = no
    15881               use-index pi
    15882               .
    15883           end.
    15884           assign
    15885             parts.fact-qnty = parts.fact-qnty + chg-qnty
    15886             chg-qnty        = 0
    15887           .
    15888           if v-goods-twounit <> true
    15889           then do:
    15890             if ub.parts.cli-base-rate <> 0
    15891             then do:
    15892               assign
    15893                 ub.parts.cli-qnty = ub.parts.fact-qnty / ub.parts.cli-base-rate
    15894               .
    15895             end.
    15896             else do:
    15897               assign
    15898                 ub.parts.cli-qnty = 0
    15899               .
    15900             end.
    15901           end.
    15902         end.
    15903       end.
    15904     end.
    15905   end procedure.
    15906   procedure check-input-parameters :
    15907     define parameter buffer buf_trn-doc for ub.trn-doc .
    15908     do
    15909     on error undo, return error return-value
    15910     :
    15911       define variable ind                    as integer no-undo .
    15912       define variable v-num-entries-p-action as integer no-undo .
    15913       if p-action = ""
    15914       or p-action = ?
    15915       then do:
    15916         message
    15917           vss-workfile vss-revision vss-description skip
    15918           "Ошибка при задании параметров вызова резервирования" skip
    15919           "Не задан параметр вызова p-action." skip
