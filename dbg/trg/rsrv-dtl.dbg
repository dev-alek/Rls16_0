     4963      release utd-marking-lines-attr.
     4964   end.
     4965   def var vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4966   def var vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4967   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4968   procedure gen-key-rec :
     4969     define input  parameter p-tbl-name    as character no-undo.
     4970     define input  parameter p-bh_tbl-name as handle    no-undo.
     4971     define output parameter p-key-rec     as character no-undo.
     4972     do
     4973     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4974     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     4975     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     4976     :
     4977       define variable fh               as handle    no-undo .
     4978       define variable v-ok             as logical   no-undo .
     4979       define variable v-inform         as character no-undo .
     4980       define variable v-ind            as integer   no-undo .
     4981       define variable v-idx-field-qnty as integer   no-undo .
     4982       if p-tbl-name = ?
     4983         or p-tbl-name = "":U
     4984       then do:
     4985         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info34 ).
     4986       end.
     4987       if not p-bh_tbl-name:available then do:
     4988         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info34, p-tbl-name ).
     4989       end.
     4990       assign
     4991         p-key-rec = p-tbl-name
     4992         v-inform  = p-bh_tbl-name:index-information(1)
     4993         v-ind     = 2
     4994       .
     4995       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4996       on error undo, return error
     4997       :
     4998         assign
     4999           v-inform = p-bh_tbl-name:index-information( v-ind )
     5000           v-ind    = v-ind + 1
     5001         .
     5002       end.
     5003       if v-inform = ?
     5004         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5005         or entry( 3, v-inform, ",":U ) <> "1":U
     5006       then do:
     5007         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, p-tbl-name ).
     5008       end.
     5009       else do:
     5010         assign
     5011           v-idx-field-qnty = num-entries( v-inform ) - 4
     5012         .
     5013         if v-idx-field-qnty < 2 then do:
     5014           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, p-tbl-name ).
     5015         end.
     5016         do v-ind = 1 to v-idx-field-qnty by 2
     5017         on error undo, return error
     5018         :
     5019           assign
     5020             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     5021             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     5022           .
     5023         end.
     5024       end.
     5025       if p-key-rec = ? then do:
     5026         assign
     5027           p-key-rec = "":U
     5028         .
     5029         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info34, p-tbl-name ).
     5030       end.
     5031     end.
     5032     return.
     5033   end procedure.
     5034   procedure gen-where-keyr-tab :
     5035     define input  parameter i-tableSerach as character no-undo.
     5036     define input  parameter i-tablekey   as character  no-undo.
     5037     define input  parameter p-key-rec    as character  no-undo.
     5038     define input  parameter p-key-handle as handle     no-undo .
     5039     define input  parameter p-db-name    as character  no-undo .
     5040     define input  parameter p-tt-handle  as handle     no-undo .
     5041     define output parameter o-Where      as character  no-undo.
     5042     do
     5043     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5044     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5045     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     5046     :
     5047       define variable v-full-tbl-name  as character no-undo .
     5048       define variable bh_tbl-name      as handle    no-undo .
     5049       define variable fh_key           as handle    no-undo .
     5050       define variable fh_search        as handle    no-undo .
     5051       define variable v-field-num      as integer   no-undo .
     5052       define variable v-count-fld      as integer   no-undo .
     5053       define variable v-inform         as character no-undo .
     5054       define variable v-ind            as integer   no-undo .
     5055       define variable v-idx-field-qnty as integer   no-undo .
     5056       define variable v-field-name     as character no-undo .
     5057       define variable v-field-val      as character no-undo .
     5058       define variable v-word-link      as character no-undo .
     5059       define variable vTable           as character no-undo.
     5060       define variable bh_tbl-key       as handle    no-undo .
     5061       assign
     5062         p-key-rec = trim( p-key-rec )
     5063       .
     5064       if p-key-handle <> ? then do:
     5065         if not valid-handle(p-key-handle)
     5066            or p-key-handle:type <> "buffer"
     5067         then do:
     5068           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info34 ).
     5069         end.
     5070         if num-entries( p-key-rec, chr(3) ) > 1
     5071           or p-key-rec = ?
     5072           or p-key-rec = "":U
     5073         then do:
     5074           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info34, p-key-rec ).
     5075         end.
     5076       end.
     5077       else do:
     5078         if p-key-rec = ?
     5079           or p-key-rec = "":U
     5080         then do:
     5081           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5082         end.
     5083       end.
     5084       assign
     5085         vTable = entry( 1 , p-key-rec, chr(3) )
     5086       .
     5087       if p-tt-handle <> ?
     5088         and ( not valid-handle(p-tt-handle)
     5089               or p-tt-handle:type <> "buffer"
     5090             )
     5091       then do:
     5092         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info34, vTable, chr(10) ).
     5093       end.
     5094       if p-tt-handle = ? then do:
     5095         assign
     5096           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     5097         .
     5098         create buffer bh_tbl-name for table v-full-tbl-name .
     5099       end.
     5100       else do:
     5101         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5102       end.
     5103       assign
     5104         v-inform = bh_tbl-name:index-information(1)
     5105         v-ind    = 2
     5106       .
     5107       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5108       on error undo, return error
     5109       :
     5110         assign
     5111           v-inform = bh_tbl-name:index-information( v-ind )
     5112           v-ind    = v-ind + 1
     5113         .
     5114       end.
     5115       if v-inform = ?
     5116         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5117         or entry( 3, v-inform, ",":U ) <> "1":U
     5118       then do:
     5119         delete object bh_tbl-name no-error.
     5120         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info34, vTable ).
     5121       end.
     5122       assign
     5123         v-idx-field-qnty = num-entries( v-inform ) - 4
     5124       .
     5125       if v-idx-field-qnty < 2 then do:
     5126         delete object bh_tbl-name no-error.
     5127         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, vTable ).
     5128       end.
     5129       assign
     5130         o-where     = "where":U
     5131         v-word-link = "":U
     5132         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     5133         v-count-fld = 0
     5134       .
     5135       if i-tablekey ne "" and i-tablekey ne ?
     5136       then do:
     5137         assign
     5138           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     5139         .
     5140         create buffer bh_tbl-key for table v-full-tbl-name .
     5141       end.
     5142       if i-tableSerach ne "" and i-tableSerach ne ?
     5143       then do:
     5144         delete object bh_tbl-name no-error.
     5145         assign
     5146           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     5147         .
     5148         create buffer bh_tbl-name for table v-full-tbl-name .
     5149       end.
     5150       block_where:
     5151       do v-ind = 1 to v-idx-field-qnty by 2
     5152       on error undo, return error
     5153       :
     5154         assign
     5155           v-count-fld = v-count-fld + 1
     5156         .
     5157         if p-key-handle = ?
     5158           and v-count-fld > v-field-num
     5159         then do:
     5160           leave block_where.
     5161         end.
     5162         define variable VfieldKeyTable as handle no-undo.
     5163         assign
     5164           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     5165           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     5166         .
     5167         if     bh_tbl-key ne ?
     5168         then do:
     5169            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     5170            if VfieldKeyTable eq ?
     5171            then next block_where.
     5172         end.
     5173         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     5174         then
     5175            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     5176         else
     5177            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     5178         if p-key-handle = ? then do:
     5179           assign
     5180             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     5181           .
     5182         end.
     5183         else do:
     5184           assign
     5185             fh_key = p-key-handle:buffer-field( v-field-name )
     5186           .
     5187           if fh_key = ?
     5188             or not valid-handle( fh_key )
     5189           then do:
     5190             delete object bh_tbl-name.
     5191             if     bh_tbl-key ne ?
     5192             then
     5193                delete object bh_tbl-key.
     5194             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info34, p-key-handle:name, v-field-name ).
     5195           end.
     5196           assign
     5197             v-field-val = fh_key:buffer-value
     5198           .
     5199         end.
     5200         if fh_search:data-type ="character":U then do:
     5201           assign
     5202             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     5203             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     5204             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     5205             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     5206             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     5207             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     5208             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     5209             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     5210             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     5211             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     5212             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     5213             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     5214             v-field-val = substitute( '"&1"', v-field-val )
     5215           .
     5216         end.
     5217         assign
     5218           o-where = substitute( "&1 &2", o-where, v-field-val )
     5219         .
     5220         if v-word-link = "":U then do:
     5221           assign
     5222             v-word-link = "and":U
     5223           .
     5224         end.
     5225       end.
     5226       delete object bh_tbl-name.
     5227       if     bh_tbl-key ne ?
     5228       then
     5229          delete object bh_tbl-key.
     5230       if p-key-handle = ?
     5231         and v-count-fld <> v-field-num
     5232       then do:
     5233         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info34, vTable ).
     5234       end.
     5235     end.
     5236   end procedure.
     5237   procedure gen-hn-keyr-tab :
     5238     define input  parameter i-tableSerach as character no-undo.
     5239     define input  parameter i-tablekey   as character no-undo.
     5240     define input  parameter p-key-rec    as character no-undo.
     5241     define input  parameter p-key-handle as handle    no-undo .
     5242     define input  parameter p-db-name    as character no-undo .
     5243     define input  parameter p-tt-handle  as handle    no-undo .
     5244     define input  parameter p-stts-lock  as integer   no-undo .
     5245     define output parameter o-hn         as handle    no-undo.
     5246     define variable v-full-tbl-name as character no-undo.
     5247     define variable v-where         as character no-undo.
     5248     define variable bh_tbl-name     as handle    no-undo.
     5249     define variable vTable          as character no-undo.
     5250     do
     5251     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5252     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5253     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     5254         run gen-where-keyr-tab(i-tableSerach,
     5255                                i-tablekey,
     5256                                p-key-rec,
     5257                                p-key-handle,
     5258                                p-db-name,
     5259                                p-tt-handle,
     5260                                output v-where).
     5261         if i-tableSerach ne "" and i-tableSerach ne ?
     5262         then do:
     5263            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     5264            create buffer bh_tbl-name for table v-full-tbl-name .
     5265         end.
     5266         else do:
     5267            if p-tt-handle = ? then do:
     5268               assign
     5269                  vTable = entry( 1 , p-key-rec, chr(3) )
     5270               .
     5271               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     5272               create buffer bh_tbl-name for table v-full-tbl-name .
     5273            end.
     5274            else do:
     5275               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5276            end.
     5277         end.
     5278         if p-tt-handle = ? then do:
     5279            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     5280         end.
     5281         else do:
     5282            bh_tbl-name:find-first( v-where ) no-error .
     5283         end.
     5284         o-hn = bh_tbl-name.
     5285      end.
     5286   end procedure.
     5287   procedure gen-hn-keyr :
     5288     define input  parameter p-key-rec    as character no-undo.
     5289     define input  parameter p-key-handle as handle    no-undo .
     5290     define input  parameter p-db-name    as character no-undo .
     5291     define input  parameter p-tt-handle  as handle    no-undo .
     5292     define input  parameter p-stts-lock  as integer   no-undo .
     5293     define output parameter o-hn         as handle    no-undo.
     5294     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     5295   end.
     5296   procedure gen-row-keyr :
     5297     define input  parameter p-key-rec    as character no-undo.
     5298     define input  parameter p-key-handle as handle    no-undo .
     5299     define input  parameter p-db-name    as character no-undo .
     5300     define input  parameter p-tt-handle  as handle    no-undo .
     5301     define input  parameter p-stts-lock  as integer   no-undo .
     5302     define output parameter p-tbl-row    as rowid     no-undo.
     5303     define output parameter p-tbl-name   as character no-undo.
     5304     define variable vHn as handle no-undo.
     5305       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     5306       p-tbl-row = if vHn:available then vHn:rowid else ?.
     5307       p-tbl-name =  vHn:table.
     5308       delete object vHn no-error.
     5309     if p-tbl-row = ? then do:
     5310       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info34, p-tbl-name, p-key-rec ).
     5311     end.
     5312     else do:
     5313       return.
     5314     end.
     5315   end procedure.
     5316   procedure gen-key-fv :
     5317     define input  parameter p-key-rec    as character no-undo .
     5318     define output parameter p-field-list as character no-undo .
     5319     define output parameter p-value-list as character no-undo.
     5320     do
     5321     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5322     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5323     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5324     :
     5325       define variable v-full-tbl-name  as character no-undo .
     5326       define variable bh_tbl-name      as handle    no-undo .
     5327       define variable v-tbl-name       as character no-undo .
     5328       define variable v-field-num      as integer   no-undo .
     5329       define variable v-count-fld      as integer   no-undo .
     5330       define variable v-inform         as character no-undo .
     5331       define variable v-ind            as integer   no-undo .
     5332       define variable v-idx-field-qnty as integer   no-undo .
     5333       define variable v-delim-key      as character no-undo .
     5334       if p-key-rec = ?
     5335         or p-key-rec = "":U
     5336       then do:
     5337         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5338       end.
     5339       assign
     5340         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     5341         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5342       .
     5343       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5344       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info34 ).
     5345       assign
     5346         v-inform = bh_tbl-name:index-information(1)
     5347         v-ind    = 2
     5348       .
     5349       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5350       on error undo, return error
     5351       :
     5352         assign
     5353           v-inform = bh_tbl-name:index-information( v-ind )
     5354           v-ind    = v-ind + 1
     5355         .
     5356       end.
     5357       if v-inform = ?
     5358         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5359         or entry( 3, v-inform, ",":U ) <> "1":U
     5360       then do:
     5361         delete object bh_tbl-name no-error.
     5362         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     5363       end.
     5364       assign
     5365         v-idx-field-qnty = num-entries( v-inform ) - 4
     5366       .
     5367       if v-idx-field-qnty < 2 then do:
     5368         delete object bh_tbl-name no-error.
     5369         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     5370       end.
     5371       assign
     5372         p-field-list = "":U
     5373         p-value-list = "":U
     5374         v-delim-key  = "":U
     5375         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     5376         v-count-fld  = 0
     5377       .
     5378       block_where:
     5379       do v-ind = 1 to v-idx-field-qnty by 2
     5380       on error undo, return error
     5381       :
     5382         assign
     5383           v-count-fld = v-count-fld + 1
     5384         .
     5385         if v-count-fld > v-field-num then do:
     5386           leave block_where.
     5387         end.
     5388         assign
     5389           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     5390           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     5391         .
     5392         if v-ind = 1 then do:
     5393           assign
     5394             v-delim-key = chr(3)
     5395           .
     5396         end.
     5397       end.
     5398       delete object bh_tbl-name.
     5399       if v-count-fld <> v-field-num then do:
     5400         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info34, v-tbl-name ).
     5401       end.
     5402     end.
     5403   end procedure.
     5404   procedure gen-key-field :
     5405     define input  parameter p-table      as character no-undo .
     5406     define output parameter p-field-list as character no-undo .
     5407     do
     5408     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5409     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5410     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5411     :
     5412       define variable v-full-tbl-name  as character no-undo .
     5413       define variable bh_tbl-name      as handle    no-undo .
     5414       define variable v-tbl-name       as character no-undo .
     5415       define variable v-field-num      as integer   no-undo .
     5416       define variable v-count-fld      as integer   no-undo .
     5417       define variable v-inform         as character no-undo .
     5418       define variable v-ind            as integer   no-undo .
     5419       define variable v-idx-field-qnty as integer   no-undo .
     5420       define variable v-delim-key      as character no-undo .
     5421       if p-table = ?
     5422         or p-table = "":U
     5423       then do:
     5424         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info34 ).
     5425       end.
     5426       assign
     5427         v-tbl-name      = p-table
     5428         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5429       .
     5430       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5431       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info34 ).
     5432       assign
     5433         v-inform = bh_tbl-name:index-information(1)
     5434         v-ind    = 2
     5435       .
     5436       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5437       on error undo, return error
     5438       :
     5439         assign
     5440           v-inform = bh_tbl-name:index-information( v-ind )
     5441           v-ind    = v-ind + 1
     5442         .
     5443       end.
     5444       if v-inform = ?
     5445         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5446         or entry( 3, v-inform, ",":U ) <> "1":U
     5447       then do:
     5448         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     5449       end.
     5450       assign
     5451         v-idx-field-qnty = num-entries( v-inform ) - 4
     5452       .
     5453       if v-idx-field-qnty < 2 then do:
     5454         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     5455       end.
     5456       assign
     5457         p-field-list = "":U
     5458         v-delim-key  = "":U
     5459         v-count-fld  = 0
     5460       .
     5461       block_where:
     5462       do v-ind = 1 to v-idx-field-qnty by 2
     5463       on error undo, return error
     5464       :
     5465         assign
     5466           v-count-fld = v-count-fld + 1
     5467         .
     5468         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     5469         if v-ind = 1 then do:
     5470           assign
     5471             v-delim-key = chr(3)
     5472           .
     5473         end.
     5474       end.
     5475       delete object bh_tbl-name.
     5476     end.
     5477   end procedure.
     5478   function AddUtdErrForTab returns logical
     5479   (idb-num         as integer ,
     5480    idoc-id         as integer ,
     5481    iTab            as character,
     5482    iObj            as handle ,
     5483    iCheckType      as character,
     5484    iCodeErr        as character,
     5485    iCheckObj       as character ):
     5486      define buffer utd-err for utd-err.
     5487      define buffer utd for utd.
     5488      find first utd where utd.db-num     eq idb-num
     5489                       and utd.doc-id     eq idoc-id
     5490                       and utd.Direction  eq 'Outbound'
     5491      no-lock no-error.
     5492      if available utd
     5493      then
     5494         return no.
     5495      define variable vRecKey as character no-undo.
     5496            run gen-key-rec (input iTab,
     5497                             input  iObj,
     5498                             output vRecKey).
     5499      find first utd-err where utd-err.db-num     eq idb-num
     5500                           and utd-err.doc-id     eq idoc-id
     5501                           and utd-err.CheckType  eq iCheckType
     5502                           and utd-err.CodeErr    eq iCodeErr
     5503                           and utd-err.CheckObj   eq iCheckObj
     5504      exclusive-lock no-error.
     5505      if not available utd-err
     5506      then do:
     5507         create utd-err.
     5508         assign
     5509            utd-err.db-num         = idb-num
     5510            utd-err.doc-id         = idoc-id
     5511            utd-err.CheckType      = iCheckType
     5512            utd-err.CodeErr        = iCodeErr
     5513            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     5514            utd-err.reckey         = vRecKey
     5515            utd-err.qnty           = 1
     5516         .
     5517      end.
     5518      else
     5519         utd-err.qnty = utd-err.qnty + 1.
     5520      return utd-err.qnty eq 1.
     5521   end.
     5522   function AddUtdErr returns logical
     5523   (idb-num         as integer ,
     5524    idoc-id         as integer ,
     5525    iObj            as handle ,
     5526    iCheckType      as character,
     5527    iCodeErr        as character,
     5528    iCheckObj       as character ):
     5529      AddUtdErrForTab
     5530         (idb-num,
     5531          idoc-id,
     5532          iObj:table,
     5533          iObj,
     5534          iCheckType,
     5535          iCodeErr,
     5536          iCheckObj).
     5537   end.
     5538   function ClearUtdErrTypeCode returns logical
     5539   (idb-num         as integer,
     5540    idoc-id         as integer ,
     5541    iCheckType      as character,
     5542    iCodeErr        as character
     5543    ):
     5544      define buffer utd-err for utd-err.
     5545      if    iCheckType eq "*"
     5546         or iCheckType eq ?
     5547      then do:
     5548         if     iCodeErr ne ?
     5549            and iCodeErr ne "*"
     5550         then
     5551            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     5552            view-as alert-box.
     5553         else
     5554         for each utd-err where utd-err.db-num  eq idb-num
     5555                            and utd-err.doc-id  eq idoc-id
     5556         exclusive-lock:
     5557            delete utd-err.
     5558         end.
     5559      end.
     5560      else do:
     5561         if    iCodeErr eq ?
     5562            or iCodeErr eq "*"
     5563         then do:
     5564            for each utd-err where utd-err.db-num     eq idb-num
     5565                               and utd-err.doc-id     eq idoc-id
     5566                               and utd-err.CheckType  eq iCheckType
     5567            exclusive-lock:
     5568               delete utd-err.
     5569            end.
     5570         end.
     5571         else do:
     5572            for each utd-err where utd-err.db-num     eq idb-num
     5573                               and utd-err.doc-id     eq idoc-id
     5574                               and utd-err.CheckType  eq iCheckType
     5575                               and ub.utd-err.CodeErr eq iCodeErr
     5576            exclusive-lock:
     5577               delete utd-err.
     5578            end.
     5579         end.
     5580      end.
     5581   end.
     5582   function ClearUtdErr returns logical
     5583   (idb-num         as integer,
     5584    idoc-id         as integer ,
     5585    iCheckType      as character
     5586    ):
     5587      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     5588   end.
     5589   function GetMesError returns character
     5590   (itxt as character,
     5591    iobj as character ):
     5592    define variable vi as integer no-undo.
     5593    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     5594       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     5595    end.
     5596    return itxt.
     5597   end.
     5598   function GetTextErrorType returns character
     5599   (iCheckType as character,
     5600    iCodeErr   as character,
     5601    iChechObj  as character,
     5602    iType      as character  ):
     5603      define buffer code    for code.
     5604      define variable vError as character no-undo.
     5605      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     5606                        and code.code   eq iCodeErr
     5607      no-lock no-error.
     5608      if available code
     5609      then do:
     5610         define variable vType as integer no-undo.
     5611         if code.misc3 eq "error"
     5612         then
     5613            vType = 0.
     5614         else if code.misc3 eq "warning"
     5615         then
     5616            vType = 1.
     5617         else if code.misc3 eq "Hiden"
     5618         then
     5619            vType = 2.
     5620         else
     5621            vtype = int(code.misc3) no-error.
     5622         case itype:
     5623            when "error"
     5624            then do:
     5625               if vtype eq 0
     5626               then
     5627                  vError = GetMesError(Code.CodeValue,iChechObj).
     5628            end.
     5629            when "warning"
     5630            then do:
     5631               if vtype <= 1
     5632               then
     5633                  vError = GetMesError(Code.CodeValue,iChechObj).
     5634            end.
     5635            otherwise do:
     5636               vError = GetMesError(Code.CodeValue,iChechObj).
     5637            end.
     5638         end.
     5639      end.
     5640      else
     5641         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     5642      return vError.
     5643   end.
     5644   function GetTypeError returns integer
     5645   (iCheckType as character,
     5646    iCodeErr   as character):
     5647      define buffer code    for code.
     5648      define variable vType as integer no-undo.
     5649      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     5650                        and code.code   eq iCodeErr
     5651      no-lock no-error.
     5652      if     not available code
     5653         and code.misc3 eq "error"
     5654      then
     5655         vType = 0.
     5656      else if code.misc3 eq "warning"
     5657      then
     5658         vType = 1.
     5659      else if code.misc3 eq "Hiden"
     5660      then
     5661         vType = 2.
     5662      else
     5663         vtype = int(code.misc3) no-error.
     5664      return vtype.
     5665   end.
     5666   function GetTextError returns character
     5667   (iCheckType as character,
     5668    iCodeErr   as character,
     5669    iChechObj  as character ):
     5670      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     5671   end.
     5672   function GetErrForUtdStr returns character
     5673   (idb-num     as integer ,
     5674    idoc-id     as integer ,
     5675    iCheckType  as character
     5676    ):
     5677      define buffer utd-err for utd-err.
     5678      define buffer code    for code.
     5679      define variable vHQry as handle no-undo.
     5680      define variable vError as longchar no-undo.
     5681      define variable vErrorOne as longchar  no-undo.
     5682      define variable oError as character no-undo.
     5683      create query vHQry.
     5684      vHQry:set-buffers(buffer utd-err:handle).
     5685      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     5686                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     5687                               + if    iCheckType eq "*"
     5688                                    or iCheckType eq ?
     5689                                 then       ""
     5690                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     5691      vHQry:query-open().
     5692      vHQry:get-first().
     5693      QRY-BLOCK:
     5694      repeat while not vHQry:query-off-end:
     5695         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     5696         if     vErrorOne ne ""
     5697            and vErrorOne ne ?
     5698         then
     5699            vError = vError + ", " + vErrorOne.
     5700         vHQry:get-next().
     5701      end.
     5702      oError = substring(vError,3,4002).
     5703      return oError.
     5704   end.
     5705   function GetErrJsonForUtd returns character
     5706   (idb-num         as integer ,
     5707    idoc-id         as integer ,
     5708    iCheckType      as character
     5709    ):
     5710      define buffer utd-err for utd-err.
     5711      define variable vHQry as handle no-undo.
     5712      define variable vError as longchar no-undo.
     5713      define variable oError as character no-undo.
     5714      create query vHQry.
     5715      define variable vi as integer no-undo.
     5716      vHQry:set-buffers(buffer utd-err:handle).
     5717      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     5718                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     5719                               + if    iCheckType eq "*"
     5720                                    or iCheckType eq ?
     5721                                 then       ""
     5722                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     5723      vHQry:query-open().
     5724      vHQry:get-first().
     5725      QRY-BLOCK:
     5726      repeat while not vHQry:query-off-end:
     5727         define variable vErrorOne as character no-undo.
     5728         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     5729         if     vErrorOne ne ?
     5730            and vErrorOne ne ""
     5731         then do:
     5732            vi = vi + 1.
     5733            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     5734                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     5735                            + '","ТекстОш":"' + vErrorOne + '"}'.
     5736         end.
     5737         vHQry:get-next().
     5738      end.
     5739      for first utd where utd.db-num eq idb-num
     5740                      and utd.doc-id eq idoc-id
     5741                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     5742      no-lock,
     5743         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     5744                                  and utd-marking-lines.doc-id eq idoc-id
     5745                                  and utd-marking-lines.doc-level eq 1
     5746      no-lock,
     5747         first marking where marking.mark eq utd-marking-lines.mark
     5748                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     5749      no-lock:
     5750         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     5751         if     vErrorOne ne ?
     5752            and vErrorOne ne ""
     5753         then do:
     5754            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     5755                            + '","ОбъектОш":"' + marking.mark
     5756                            + '","ТекстОш":"' + vErrorOne + '"}'.
     5757         end.
     5758      end.
     5759      if vError ne ""
     5760      then
     5761         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     5762      return oError.
     5763   end.
     5764   function GetErrJsonForUtdReturn returns character
     5765   (idb-num         as integer ,
     5766    idoc-id         as integer ,
     5767    iCheckType      as character
     5768    ):
     5769      define buffer utd-err for utd-err.
     5770      define variable vHQry as handle no-undo.
     5771      define variable vError as longchar no-undo.
     5772      define variable oError as character no-undo.
     5773      define variable vi as integer no-undo.
     5774      create query vHQry.
     5775      vHQry:set-buffers(buffer utd-err:handle).
     5776      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     5777                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     5778                               + if    iCheckType eq "*"
     5779                                    or iCheckType eq ?
     5780                                 then       ""
     5781                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     5782      vHQry:query-open().
     5783      vHQry:get-first().
     5784      QRY-BLOCK:
     5785      repeat while not vHQry:query-off-end:
     5786         define variable vErrorOne as character no-undo.
     5787         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     5788         if     vErrorOne ne ?
     5789            and vErrorOne ne ""
     5790         then do:
     5791            vi = vi + 1.
     5792            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     5793                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     5794                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     5795         end.
     5796         vHQry:get-next().
     5797      end.
     5798      if vError ne ""
     5799      then
     5800         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     5801      return oError.
     5802   end.
     5803   function GetCodeTextError returns character
     5804   (iCheckType as character,
     5805    iCodeErr   as character,
     5806    iChechObj  as character,
     5807    output oCode as character,
     5808    output ovalue as character ):
     5809      define buffer code    for code.
     5810      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     5811                        and code.code   eq iCodeErr
     5812      no-lock no-error.
     5813      if     available code
     5814      then do:
     5815         define variable vi as integer no-undo init ?.
     5816         vi = int(Code.misc3) no-error.
     5817         if    code.misc3 ne "error"
     5818            and vi ne 0
     5819         then
     5820            oCode = ?.
     5821         else if     Code.misc1 ne ?
     5822                 and Code.misc1 ne ""
     5823         then
     5824            assign
     5825               oCode  = GetMesError(Code.misc1,iChechObj)
     5826               ovalue = GetMesError(Code.misc2,iChechObj)
     5827            .
     5828      end.
     5829      return if oCode eq ""
     5830             then ""
     5831             else (oCode + "_" + ovalue).
     5832   end.
     5833   define temp-table TT-err no-undo
     5834     field code_ as character
     5835     field text_ as character
     5836   index code_ code_.
     5837   function GetErrTxtForUtd returns character
     5838   (idb-num         as integer ,
     5839    idoc-id         as integer ,
     5840    iCheckType      as character
     5841    ):
     5842      define buffer utd-err for utd-err.
     5843      define variable vHQry as handle no-undo.
     5844      define variable oError as character no-undo.
     5845      create query vHQry.
     5846      define variable vi as integer no-undo.
     5847      for each tt-err :
     5848         delete tt-err.
     5849      end.
     5850      vHQry:set-buffers(buffer utd-err:handle).
     5851      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     5852                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     5853                               + if    iCheckType eq "*"
     5854                                    or iCheckType eq ?
     5855                                 then       ""
     5856                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     5857      vHQry:query-open().
     5858      vHQry:get-first().
     5859      define variable vcode as character no-undo.
     5860      define variable vvalue as character no-undo.
     5861      QRY-BLOCK:
     5862      repeat while not vHQry:query-off-end:
     5863         vi = vi + 1.
     5864         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     5865         if vcode ne ?
     5866         then do:
     5867            find first tt-err where tt-err.code eq vcode
     5868            no-error.
     5869            if not available tt-err
     5870            then do:
     5871               create tt-err.
     5872               assign
     5873                  tt-err.code_ = vcode
     5874                  tt-err.text_ = vvalue
     5875               .
     5876            end.
     5877            else
     5878               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     5879         end.
     5880         vHQry:get-next().
     5881      end.
     5882     find first utd where utd.db-num eq idb-num
     5883                         and utd.doc-id eq idoc-id
     5884         no-lock.
     5885      define buffer cancel_utd-lines for utd-lines.
     5886      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     5887                                  and cancel_utd-lines.doc-id eq idoc-id
     5888      no-lock:
     5889         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     5890         then do:
     5891            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     5892                                        and utd-marking-lines.doc-id eq idoc-id
     5893                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     5894            no-lock,
     5895               first marking where marking.mark eq utd-marking-lines.mark
     5896                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     5897            no-lock:
     5898               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     5899               find first tt-err where tt-err.code eq vcode
     5900               no-error.
     5901               if not available tt-err
     5902               then do:
     5903                  create tt-err.
     5904                  assign
     5905                     tt-err.code_ = vcode
     5906                     tt-err.text_ = vvalue
     5907                  .
     5908               end.
     5909               else
     5910                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     5911            end.
     5912         end.
     5913         else do:
     5914            define variable vqnty as decimal no-undo.
     5915            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     5916            if vqnty eq ? then vqnty = 0.
     5917            if vqnty ne cancel_utd-lines.Quantity
     5918            then do:
     5919               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     5920               find first tt-err where tt-err.code eq vcode
     5921               no-error.
     5922               if not available tt-err
     5923               then do:
     5924                  create tt-err.
     5925                  assign
     5926                     tt-err.code_ = vcode
     5927                     tt-err.text_ = vvalue
     5928                  .
     5929               end.
     5930               else
     5931                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     5932            end.
     5933         end.
     5934      end.
     5935      for each tt-err:
     5936         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     5937      end.
     5938      return oError.
     5939   end.
     5940   define variable mFormatErr as character no-undo init "text".
     5941   function GetErrForUtd returns character
     5942   (idb-num         as integer ,
     5943    idoc-id         as integer ,
     5944    iType           as character
     5945    ):
     5946      if mFormatErr eq "text"
     5947      then
     5948         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     5949      else do:
     5950         if itype eq "return"
     5951         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     5952         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     5953      end.
     5954   end.
     5955   function GetErrComText returns longchar
     5956   (icomment as character,
     5957    itext    as longchar ):
     5958       define variable vText as longchar no-undo.
     5959      if mFormatErr eq "text"
     5960      then do:
     5961         if icomment ne ""
     5962         then
     5963            icomment = substitute("comment:|&1|",icomment).
     5964         vText = icomment + itext.
     5965      end.
     5966      else do:
     5967         icomment = if icomment begins  '"'
     5968                    then icomment
     5969                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     5970         vText = icomment + "," + itext.
     5971         vText = "~{" + trim(vText,",") + "~}".
     5972      end.
     5973      return vText.
     5974   end.
     5975   function CheckTypeForMarkLineType returns logical
     5976   (iObj            as handle,
     5977    iCheckType      as character,
     5978    iCodeErr        as character ,
     5979    iTypeErr        as character ):
     5980      define variable vRecKey-markLine as character no-undo.
     5981      define variable vGoodMark        as logical no-undo.
     5982      define variable vdb-num          as integer no-undo.
     5983      define variable vdoc-id          as integer no-undo.
     5984      define variable vlinenum         as integer no-undo.
     5985      define variable vErrorOne as character no-undo.
     5986      define buffer buf_utd-err for utd-err.
     5987      run gen-key-rec (input "utd-marking-lines",
     5988                       input  iObj,
     5989                       output vRecKey-markLine).
     5990      vGoodMark = yes.
     5991      vdb-num = iObj::db-num.
     5992      vdoc-id = iObj::doc-id.
     5993      vlinenum = iObj::linenum.
     5994      block-mark-err:
     5995      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     5996                               and buf_utd-err.db-num = vdb-num
     5997                               and buf_utd-err.reckey = vRecKey-markLine
     5998                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     5999                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6000      no-lock:
     6001         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6002         if     vErrorOne ne ?
     6003            and vErrorOne ne ""
     6004         then do:
     6005            vGoodMark = no.
     6006            leave block-mark-err.
     6007         end.
     6008      end.
     6009      return not vGoodMark.
     6010   end.
     6011   function CheckErrForMarkLineType returns logical
     6012   (iObj            as handle,
     6013    iType           as character  ):
     6014      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     6015   end.
     6016   function CheckErrForMarkLine returns logical
     6017   (iObj            as handle):
     6018      return CheckErrForMarkLineType(iObj,"*").
     6019   end.
     6020   function CheckErrForLineTypeCode returns logical
     6021   (iObj                 as handle,
     6022    iCheckType           as character,
     6023    iCodeErr             as character,
     6024    iTypeErr             as character,
     6025    iOneErr              as logical):
     6026      define variable vRecKey-line     as character no-undo.
     6027      define buffer buf_utd-err for utd-err.
     6028      define variable vUtdlineError as logical no-undo.
     6029      define variable vErrorOne as character no-undo.
     6030            run gen-key-rec (input "utd-lines",
     6031                             input  iObj,
     6032                             output vRecKey-line).
     6033         define variable vdb-num as integer no-undo.
     6034         define variable vdoc-id as integer no-undo.
     6035         define variable vlinenum as integer no-undo.
     6036         vdb-num = iObj::db-num.
     6037         vdoc-id = iObj::doc-id.
     6038         vlinenum = iObj::linenum.
     6039         block-err:
     6040         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6041                                  and buf_utd-err.db-num = vdb-num
     6042                                  and buf_utd-err.reckey = vRecKey-line
     6043                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6044                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6045         no-lock:
     6046            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6047            if     vErrorOne ne ?
     6048               and vErrorOne ne ""
     6049            then do:
     6050               vUtdlineError = yes.
     6051               leave block-err.
     6052            end.
     6053         end.
     6054         if  not vUtdlineError
     6055         then do:
     6056            define variable vGoodMark as logical no-undo.
     6057            vGoodMark = yes.
     6058            block-line-err:
     6059            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     6060                                         and utd-marking-lines.doc-id  eq vdoc-id
     6061                                         and utd-marking-lines.LineNum eq vLineNum
     6062            no-lock:
     6063               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     6064               if     vGoodMark
     6065                  and iOneErr eq no
     6066               then
     6067                  leave block-line-err.
     6068               if     iOneErr = yes
     6069                  and not vGoodMark
     6070               then
     6071                  leave block-line-err.
     6072            end.
     6073            vUtdlineError = not vGoodMark.
     6074         end.
     6075      return vUtdlineError.
     6076   end.
     6077   function getErrForLineType returns character
     6078   (iObj            as handle,
     6079    iType           as character  ):
     6080      define variable vRecKey-line     as character no-undo.
     6081      define buffer buf_utd-err for utd-err.
     6082      define variable vUtdlineError as logical no-undo.
     6083      define variable vErrorOne as character no-undo.
     6084      define variable oError as character no-undo.
     6085            run gen-key-rec (input "utd-lines",
     6086                             input  iObj,
     6087                             output vRecKey-line).
     6088         define variable vdb-num as integer no-undo.
     6089         define variable vdoc-id as integer no-undo.
     6090         define variable vlinenum as integer no-undo.
     6091         vdb-num = iObj::db-num.
     6092         vdoc-id = iObj::doc-id.
     6093         vlinenum = iObj::linenum.
     6094         block-err:
     6095         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6096                                  and buf_utd-err.db-num = vdb-num
     6097                                  and buf_utd-err.reckey = vRecKey-line
     6098                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     6099         no-lock:
     6100            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     6101            if     vErrorOne ne ?
     6102               and vErrorOne ne ""
     6103            then do:
     6104               oError = oError + vErrorOne + " ".
     6105            end.
     6106         end.
     6107      return oError.
     6108   end.
     6109   function CheckErrForLineType returns logical
     6110   (iObj            as handle,
     6111    iType           as character  ):
     6112       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     6113   end.
     6114   function CheckErrForLine returns logical
     6115   (iObj            as handle):
     6116      return CheckErrForLineType(iobj,"*").
     6117   end.
     6118   function CheckErrForUtd returns logical
     6119   (idb-num         as integer ,
     6120    idoc-id         as integer ):
     6121      for each utd-lines where utd-lines.db-num eq idb-num
     6122                           and utd-lines.doc-id eq idoc-id
     6123      no-lock :
     6124         if not CheckErrForLine (buffer ub.utd-lines:handle)
     6125         then
     6126            return no.
     6127      end.
     6128      return yes.
     6129   end.
     6130   function CheckMarkUtd-28rel return logical
     6131    (input idb-num as integer,
     6132    input idoc-id as integer):
     6133    define buffer utd                   for utd.
     6134    define buffer utd-lines             for utd-lines.
     6135    define buffer utd-marking-lines     for utd-marking-lines.
     6136    define variable v-par-type as character no-undo.
     6137    define variable vgdsNoMark as logical no-undo.
     6138    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6139      define variable v-par-val  as character no-undo.
     6140      find first utd where utd.db-num eq idb-num
     6141                       and utd.doc-id eq idoc-id
     6142      no-lock no-error.
     6143      if available utd
     6144      then do:
     6145         if     utd.obj-code ne ?
     6146            and utd.obj-type ne ?
     6147         then do:
     6148            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     6149            Block-utd-lines:
     6150            for each utd-lines where utd-lines.db-num eq idb-num
     6151                                 and utd-lines.doc-id eq idoc-id
     6152            no-lock:
     6153               if     utd-lines.gds-code ne ?
     6154                  and utd-lines.gds-code ne 0
     6155               then do:
     6156                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6157                       ( utd-lines.gds-code,
     6158                         'mark-type':U,
     6159                          output v-par-val,
     6160                          output v-par-type
     6161                       ).
     6162                  if     EDOParSec:IsEdo
     6163                     and EDOParSec:GetIsEDOForType(v-par-val)
     6164                  then do:
     6165                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     6166                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     6167                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     6168                                                    and length(utd-marking-lines.mark) > 13
     6169                     no-lock no-error.
     6170                     if     avail utd-marking-lines
     6171                        and not CheckErrForLine(buffer utd-lines:handle)
     6172                     then
     6173                        leave Block-utd-lines.
     6174                  end.
     6175                  else
     6176                     vgdsNoMark = yes.
     6177               end.
     6178            end.
     6179            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     6180            if vgdsNoMark then return available utd-lines . else return yes .
     6181         end.
     6182      end.
     6183      return yes.
     6184   end.
     6185   function CheckMarkUtd return logical
     6186    (input idb-num  as integer,
     6187     input idoc-id  as integer):
     6188     define buffer utd-lines             for ub.utd-lines.
     6189     block-line:
     6190     for each utd-lines where utd-lines.db-num eq idb-num
     6191                          and utd-lines.doc-id eq idoc-id
     6192     no-lock:
     6193        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     6194        then
     6195           leave block-line.
     6196     end.
     6197     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     6198     return available utd-lines.
     6199   end.
     6200   function CheckNotMarkUtd return logical
     6201    (input idb-num  as integer,
     6202     input idoc-id  as integer):
     6203     define buffer utd-lines             for ub.utd-lines.
     6204     for each utd-lines where utd-lines.db-num eq idb-num
     6205                          and utd-lines.doc-id eq idoc-id
     6206     no-lock:
     6207        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     6208        then
     6209           return yes.
     6210     end.
     6211     return no.
     6212   end.
     6213   function CheckMarkUtdLine return logical
     6214    (input idb-num  as integer,
     6215     input idoc-id  as integer,
     6216     input iLineNum as integer):
     6217    define buffer utd                   for utd.
     6218    define buffer utd-lines             for utd-lines.
     6219    define buffer utd-marking-lines     for utd-marking-lines.
     6220    define variable v-par-type as character no-undo.
     6221    define variable vMarking        as logical no-undo.
     6222    define variable vArtic          as logical no-undo.
     6223    define variable vTransitional   as logical no-undo.
     6224    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6225      define variable v-par-val  as character no-undo.
     6226      find first utd where utd.db-num eq idb-num
     6227                       and utd.doc-id eq idoc-id
     6228      no-lock no-error.
     6229      if available utd
     6230      then do:
     6231         if     utd.obj-code ne ?
     6232            and utd.obj-type ne ?
     6233         then do:
     6234            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     6235            Block-utd-lines:
     6236            for each utd-lines where utd-lines.db-num   eq idb-num
     6237                                 and utd-lines.doc-id   eq idoc-id
     6238                                 and utd-lines.LineNum  eq iLineNum
     6239            no-lock:
     6240               if     utd-lines.gds-code ne ?
     6241                  and utd-lines.gds-code ne 0
     6242               then do:
     6243                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6244                       ( utd-lines.gds-code,
     6245                         'mark-type':U,
     6246                          output v-par-val,
     6247                          output v-par-type
     6248                       ).
     6249                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     6250                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     6251                  if vMarking
     6252                  then do:
     6253                     block-marking:
     6254                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     6255                                                    and utd-marking-lines.doc-id   eq idoc-id
     6256                                                    and utd-marking-lines.LineNum  eq iLineNum
     6257                                                    and length(utd-marking-lines.mark) > 13
     6258                     no-lock:
     6259                        if isOAD(utd-marking-lines.mark)
     6260                        then do:
     6261                           assign
     6262                              vArtic   = yes
     6263                              vMarking = no
     6264                           .
     6265                           leave block-marking.
     6266                        end.
     6267                     end.
     6268                  end.
     6269                  if vArtic
     6270                  then do:
     6271                     block-artic:
     6272                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     6273                                                    and utd-marking-lines.doc-id   eq idoc-id
     6274                                                    and utd-marking-lines.LineNum  eq iLineNum
     6275                                                    and length(utd-marking-lines.mark) > 13
     6276                     no-lock:
     6277                        if isMark(utd-marking-lines.mark)
     6278                        then do:
     6279                           assign
     6280                              vArtic   = no
     6281                              vMarking = yes
     6282                           .
     6283                           leave block-artic.
     6284                        end.
     6285                     end.
     6286                  end.
     6287                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     6288                  if vTransitional
     6289                  then do:
     6290                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     6291                                                    and utd-marking-lines.doc-id   eq idoc-id
     6292                                                    and utd-marking-lines.LineNum  eq iLineNum
     6293                                                    and length(utd-marking-lines.mark) > 13
     6294                     no-lock no-error.
     6295                     if not available utd-marking-lines
     6296                     then assign
     6297                        vMarking = no
     6298                        vArtic   = no
     6299                     .
     6300                  end.
     6301               end.
     6302               else
     6303                  assign
     6304                     vMarking      = yes
     6305                     vArtic        = no
     6306                     vTransitional = no
     6307                  .
     6308               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     6309               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     6310               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     6311            end.
     6312         end.
     6313      end.
     6314      return vMarking or vArtic.
     6315   end.
     6316   function getMarkUtdLine return logical
     6317    (input  idb-num  as integer,
     6318     input  idoc-id  as integer,
     6319     input  iLineNum as integer,
     6320     output oMarking        as logical,
     6321     output oArtic          as logical,
     6322     output oTransitional   as logical):
     6323     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     6324     oArtic        = not oMarking
     6325            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     6326     oTransitional = (oMarking or oArtic)
     6327            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     6328   end.
     6329   function CheckMarking return logical
     6330    (input idb-num as integer,
     6331    input idoc-id as integer,
     6332    input iTypeErr as character ):
     6333     define variable vMarkutd as logical no-undo.
     6334     define variable vCrErr   as logical no-undo.
     6335     define buffer utd-lines         for utd-lines.
     6336     define buffer utd-marking-lines for utd-marking-lines.
     6337     define buffer marking           for marking.
     6338     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     6339      block-line:
     6340      for each utd-lines where utd-lines.db-num eq idb-num
     6341                           and utd-lines.doc-id eq idoc-id
     6342      no-lock:
     6343         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     6344         then do:
     6345            for each utd-marking-lines
     6346                     where utd-marking-lines.db-num  = utd-lines.db-num
     6347                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     6348                       and utd-marking-lines.LineNum = utd-lines.LineNum
     6349            no-lock:
     6350               if isMark(utd-marking-lines.mark)
     6351               then do:
     6352                  find first marking where marking.mark eq utd-marking-lines.mark
     6353                  no-lock no-error.
     6354                  if not available marking
     6355                  then do:
     6356                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     6357                     vCrErr = yes.
     6358                     next block-line.
     6359                  end.
     6360               end.
     6361            end.
     6362         end.
     6363      end.
     6364      return vCrErr.
     6365   end.
     6366   function CheckMarkForType return logical
     6367    (input idb-num   as integer,
     6368     input idoc-id   as integer):
     6369      define variable vMarking        as logical no-undo.
     6370      define variable vArtic          as logical no-undo.
     6371      define variable vTransitional   as logical no-undo.
     6372      define buffer utd-lines         for utd-lines.
     6373      define buffer utd-marking-lines for utd-marking-lines.
     6374      block-line:
     6375      for each utd-lines where utd-lines.db-num eq idb-num
     6376                           and utd-lines.doc-id eq idoc-id
     6377      no-lock:
     6378         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     6379                          output vMarking         , output vArtic          , output vTransitional).
     6380         for each utd-marking-lines
     6381                     where utd-marking-lines.db-num  = utd-lines.db-num
     6382                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     6383                       and utd-marking-lines.LineNum = utd-lines.LineNum
     6384         no-lock:
     6385            if length(utd-marking-lines.mark) < 14
     6386            then do:
     6387               if (vMarking or vArtic) and not vTransitional
     6388               then
     6389                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     6390            end.
     6391            else if not isMark(utd-marking-lines.mark)
     6392            then do:
     6393               if vMarking
     6394               then
     6395                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     6396            end.
     6397            else do:
     6398            end.
     6399         end.
     6400      end.
     6401   end.
     6402   function WeighedProd return logical
     6403      ( input p-gds-code as integer) :
     6404      define variable v-par-val  as character no-undo.
     6405      define variable v-par-type as character no-undo.
     6406              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6407               ( p-gds-code,
     6408                 'weighed-gds':U,
     6409                  output v-par-val,
     6410                  output v-par-type
     6411               ).
     6412      return logical(v-par-val).
     6413   end.
     6414   function WghProdVariable return logical
     6415       (input p-obj-type as char,
     6416        input p-obj-code as integer,
     6417        input p-gds-code as integer) :
     6418      define variable v-wgh-val  as character no-undo.
     6419      define variable v-par-val  as character no-undo.
     6420      define variable v-par-type as character no-undo.
     6421      define variable vMarking        as logical no-undo.
     6422      define variable vArtic          as logical no-undo.
     6423      define variable vTransitional   as logical no-undo.
     6424      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6425         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6426           ( p-gds-code,
     6427             'weighed-gds':U,
     6428              output v-wgh-val,
     6429              output v-par-type
     6430           ).
     6431       if logical(v-wgh-val) = yes then do:
     6432           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6433               ( p-gds-code,
     6434                 'mark-type':U,
     6435                  output v-par-val,
     6436                  output v-par-type
     6437               ).
     6438           if v-par-val <> "" then do:
     6439               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     6440               assign
     6441                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     6442                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     6443                  .
     6444           end.
     6445      end.
     6446      if v-wgh-val > "" and (vMarking or vArtic)
     6447      then return yes.
     6448      else return no.
     6449   end.
     6450   function MarkWeight return decimal
     6451      ( input p-mark as character) :
     6452      define buffer  buf_marking-attr for  ub.marking-attr.
     6453      define variable vMarkWeight as decimal no-undo.
     6454      vMarkWeight = 0.
     6455      if p-mark <> "" and p-mark <> ?
     6456      then do:
     6457          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     6458                                        and buf_marking-attr.attr-code eq "weight"
     6459             no-lock no-error.
     6460          if not available buf_marking-attr
     6461          then do :
     6462            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     6463                                          and buf_marking-attr.attr-code eq "weight"
     6464               no-lock no-error.
     6465          end .
     6466          if avail buf_marking-attr
     6467          then vMarkWeight = dec(buf_marking-attr.attr-value).
     6468      end.
     6469      return vMarkWeight.
     6470   end.
