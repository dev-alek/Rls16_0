    14406               define variable v-fix-first-qnty as decimal no-undo .
    14407               assign
    14408                 v-can-fix        = false
    14409                 v-fix-first-qnty = 0
    14410               .
    14411               if  free-prt < 0
    14412               and v-total-parts-fact-qnty > abs(free-prt)
    14413               then do:
    14414                 assign
    14415                   v-action         = 2
    14416                   v-can-fix        = true
    14417                   v-fix-first-qnty = free-prt
    14418                 .
    14419               end.
    14420               if  free-prt   >= 0
    14421               and first-qnty >= 0
    14422               then do:
    14423                 assign
    14424                   v-action         = 2
    14425                   v-can-fix        = true
    14426                   v-fix-first-qnty = min(free-prt, first-qnty)
    14427                 .
    14428               end.
    14429               if ub.goods.negative-rest = true
    14430               then do:
    14431                 if v-negative-check = 0
    14432                 then do:
    14433                   run gbl/d-askw.w
    14434                     (input  "Проверка отрицательных остатков"
    14435                     ,input  "Артикул " + string(ub.goods.artic) + " "
    14436                               + string(ub.goods.prod-type) + " " + string(ub.goods.prod-code) + chr(10)
    14437                             + string(ub.goods.gds-name) + chr(10)
    14438                             + "Свободно " + string(free-prt) + chr(10)
    14439                             + "После резервирования товар уйдет в отрицательные остатки" + chr(10)
    14440                             + substitute("Объект &1 &2", v-obj-type, v-obj-code) + chr(10)
    14441                     ,input "|^"
    14442                     ,input  "Резерв" + "|"
    14443                             + "Положительное"
    14444                               + (if v-can-fix then "" else "^disable") + "|"
    14445                             + "Отмена"
    14446                     ,input  "Зарезервировать " + string(first-qnty) + chr(10)
    14447                               + "После резервирования:" + chr(10)
    14448                               + " Свободное количество составит "
    14449                               + string(free-prt - first-qnty) + chr(10)
    14450                               + " Количество по документу составит "
    14451                               + string(v-total-parts-fact-qnty + first-qnty)
    14452                               + "|"
    14453                             + (if v-can-fix then
    14454                                 "Зарезервировать " + string(v-fix-first-qnty) + chr(10)
    14455                                 + "После резервирования:" + chr(10)
    14456                                 + "Свободное количество составит "
    14457                                 + string(free-prt - v-fix-first-qnty) + chr(10)
    14458                                 + "Количество по документу составит "
    14459                                 + string(v-total-parts-fact-qnty + v-fix-first-qnty)
    14460                                 else "Даже если удалить строчку документа" + chr(10)
    14461                                     + "свободное количество будет отрицательным" ) + "|"
    14462                             + "Отмена резервирования" + chr(10)
    14463                               + "Свободное количество составит "
    14464                               + string(free-prt) + chr(10)
    14465                               + "Количество по документу составит "
    14466                               + string(v-total-parts-fact-qnty)
    14467                     ,input 2
    14468                     ,input 3
    14469                     ,output v-action
    14470                     ).
    14471                 end.
    14472                 else do:
    14473                   case v-negative-check
    14474                   :
    14475                     when 1
    14476                     then do:
    14477                       assign
    14478                         v-action = 1
    14479                       .
    14480                     end.
    14481                     when 2
    14482                     then do:
    14483                       if v-can-fix = true
    14484                       then do:
    14485                         assign
    14486                           v-action = 2
    14487                         .
    14488                       end.
    14489                       else do:
    14490                         assign
    14491                           v-action = 3
    14492                         .
    14493                       end.
    14494                     end.
    14495                     when 3
    14496                     then do:
    14497                       assign
    14498                         v-action = 3
    14499                       .
    14500                     end.
    14501                     otherwise do:
    14502                       message
    14503                         vss-workfile vss-revision vss-description skip
    14504                         "Внутренняя ошибка" skip
    14505                         "Неизвестное значение v-negative-check" v-negative-check skip
    14506                         view-as alert-box error .
    14507                       undo, return error return-value .
    14508                     end.
    14509                   end.
    14510                 end.
    14511               end.
    14512               else do:
    14513                 if v-action = 2 and first-qnty <> v-fix-first-qnty then do:
    14514   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
