    11807             then do:
    11808               assign
    11809                 buf_parts.cli-qnty = buf_parts.cli-qnty + v-unrv-sign * archive_parts.cli-qnty
    11810               .
    11811             end.
    11812             else do:
    11813               if buf_parts.cli-base-rate <> 0
    11814               then do:
    11815                 assign
    11816                   buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
    11817                 .
    11818               end.
    11819               else do:
    11820                 assign
    11821                   buf_parts.cli-qnty = 0
    11822                 .
    11823               end.
    11824             end.
    11825             if  buf_parts.qnty      = 0
    11826             and buf_parts.fact-qnty = 0
    11827             then do:
    11828               if v-goods-twounit = true
    11829               then do:
    11830                 if buf_parts.cli-qnty <> 0
    11831                 then do:
    11832                   message
    11833                     vss-workfile vss-revision vss-description skip
    11834                     vss-include-info48 skip
    11835                     "Ошибка при удалении партии" skip
    11836                     "Документ" p-doc-code skip
    11837                     "Объект" p-obj-type p-obj-code skip
    11838                     "Артикул" p-artic p-prod-type p-prod-code skip
    11839                     "Партия" buf_parts.in-code buf_parts.part-code skip
    11840                     "Резерв" buf_parts.out-code skip
    11841                     "qnty" buf_parts.qnty skip
    11842                     "fact-qnty" buf_parts.fact-qnty skip
    11843                     "cli-qnty" buf_parts.cli-qnty skip
    11844                     view-as alert-box error .
    11845                   undo, return error .
    11846                 end.
    11847               end.
    11848               for each del_marking-lines exclusive-lock where del_marking-lines.gds-code = v-gds-code
    11849                                                           and del_marking-lines.obj-type = buf_parts.obj-type
    11850                                                           and del_marking-lines.obj-code = buf_parts.obj-code
    11851                                                           and del_marking-lines.in-code = buf_parts.in-code
    11852                                                           and del_marking-lines.out-code = buf_parts.out-code
    11853                                                           and del_marking-lines.part-code = buf_parts.part-code
    11854                                                           and del_marking-lines.prt-code = buf_parts.prt-code:
    11855                 delete del_marking-lines .
    11856               end.
    11857               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
    11858                                           ,input (buffer buf_parts:handle)
    11859                                           ,output part-key-rec).
    11860               for each ub.gen-attr no-lock where ub.gen-attr.table-name = 'excise-mark':U
    11861                                        and ub.gen-attr.p-key =  part-key-rec
    11862               :
    11863                 find first buf1_gen-attr no-lock where recid (buf1_gen-attr) = recid (ub.gen-attr).
    11864                 find current buf1_gen-attr exclusive-lock.
    11865                 delete buf1_gen-attr .
    11866               end.
    11867               delete buf_parts .
    11868             end.
    11869           end.
    11870         end.
    11871       end.
    11872     end.
    11873   end procedure.
    11874   procedure partcopy-rsrv-parts :
    11875     define input  parameter p-doc-code-rowid as rowid no-undo .
    11876     define input  parameter p-parts-rowid    as rowid no-undo .
    11877     define input  parameter p-rsrv-direction as logical   no-undo .
    11878     define input  parameter p-goods-twounit  as logical   no-undo .
    11879     define input  parameter p-is-hold        as logical   no-undo .
    11880     define variable vss-description as character no-undo init "partcopy-rsrv-parts-01: процедура обработки партий при удалении документа".
    11881     define buffer buf_trn-doc for ub.trn-doc .
    11882     define buffer archive_parts for ub.parts .
    11883     define buffer buf_parts   for ub.parts .
    11884     define buffer orig_marking-lines for ub.marking-lines .
    11885     define buffer buf_marking-lines for ub.marking-lines .
    11886     define buffer buf_marking   for ub.marking .
    11887     define buffer buf_goods for ub.goods .
    11888     define variable v-rsrv-code as character no-undo .
    11889     do
    11890     on error undo, return error return-value
    11891     :
    11892       find first buf_trn-doc no-lock
    11893         where rowid(buf_trn-doc) = p-doc-code-rowid
    11894         no-error .
    11895       if not available buf_trn-doc
    11896       then do:
    11897         message
    11898           vss-workfile vss-revision vss-description skip
    11899           vss-include-info48 skip
    11900           "Ошибка задания входных параметров" skip
    11901           "Не найден документ" skip
    11902           "Документ" string(p-doc-code-rowid) skip
    11903           "Партия" string(p-parts-rowid) skip
    11904           error-status :get-message(1) skip
    11905           return-value skip
    11906           view-as alert-box error .
    11907         undo, return error .
    11908       end.
    11909       find first archive_parts
    11910         where rowid(archive_parts) = p-parts-rowid
    11911         no-error .
    11912       if not available archive_parts
    11913       then do:
    11914         message
    11915           vss-workfile vss-revision vss-description skip
    11916           vss-include-info48 skip
    11917           "Ошибка задания входных параметров" skip
    11918           "Не найдена партия" skip
    11919           "Документ" string(p-doc-code-rowid) skip
    11920           "Партия" string(p-parts-rowid) skip
    11921           error-status :get-message(1) skip
    11922           return-value skip
    11923           view-as alert-box error .
    11924         undo, return error .
    11925       end.
    11926       if  archive_parts.out-code <> archive_parts.in-code
    11927       and archive_parts.qnty <> 0
    11928       and (buf_trn-doc.doc-type = 'при':U and buf_trn-doc.internal = yes ) = false
    11929       and (buf_trn-doc.doc-type = 'возврат':U and p-is-hold = true  ) = false
    11930       then do:
    11931         assign
    11932           v-rsrv-code =
    11933           ( if (lookup(buf_trn-doc.doc-type, 'рас,спи':U) > 0 )
    11934         or (buf_trn-doc.doc-type = 'инв':U and archive_parts.qnty < 0)
    11935         then 'free-zone':U
    11936         else 'out-zone':U )
    11937         .
    11938         run partcopy in this-procedure
    11939           (input  true
    11940           ,input  v-rsrv-code
    11941           ,buffer archive_parts
    11942           ,buffer buf_parts
    11943           ,input  "news"
    11944           ) no-error .
    11945         if error-status :error
    11946         then do:
    11947           message
    11948             vss-workfile vss-revision vss-description skip
    11949             vss-include-info48 skip
    11950             "Ошибка при создании партии" skip
    11951             "Документ" buf_trn-doc.doc-code skip
    11952             "Объект" archive_parts.obj-type archive_parts.obj-code skip
    11953             "Артикул" archive_parts.artic archive_parts.prod-type archive_parts.prod-code skip
    11954             "Партия" archive_parts.in-code archive_parts.part-code skip
    11955             "Количество" archive_parts.qnty skip
    11956             "Резерв" v-rsrv-code skip
    11957             error-status :get-message(1) skip
    11958             return-value skip
    11959             view-as alert-box error .
    11960           undo, return error .
    11961         end.
    11962         assign
    11963           buf_parts.qnty      = buf_parts.qnty     - abs(archive_parts.qnty)
    11964                                                     * (if p-rsrv-direction = true
    11965                                                       then 1
    11966                                                       else -1
    11967                                                       )
    11968           buf_parts.fact-qnty = buf_parts.qnty
    11969         .
    11970         find first buf_goods no-lock where buf_goods.artic = archive_parts.artic
    11971                                        and buf_goods.prod-type = archive_parts.prod-type
    11972                                        and buf_goods.prod-code = archive_parts.prod-code
    11973                                        .
    11974         for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
    11975                                               and orig_marking-lines.obj-type   = archive_parts.obj-type
    11976                                               and orig_marking-lines.obj-code   = archive_parts.obj-code
    11977                                               and orig_marking-lines.in-code    = archive_parts.in-code
    11978                                               and orig_marking-lines.out-code   = archive_parts.out-code
    11979                                               and orig_marking-lines.part-code  = archive_parts.part-code
    11980                                               and orig_marking-lines.prt-code   = archive_parts.prt-code
    11981                                               :
    11982           find first buf_marking-lines no-lock where  buf_marking-lines.mark       = orig_marking-lines.mark
    11983                                                   and buf_marking-lines.gds-code   = buf_goods.gds-code
    11984                                                   and buf_marking-lines.obj-type   = buf_parts.obj-type
    11985                                                   and buf_marking-lines.obj-code   = buf_parts.obj-code
    11986                                                   and buf_marking-lines.in-code    = buf_parts.in-code
    11987                                                   and buf_marking-lines.out-code   = buf_parts.out-code
    11988                                                   and buf_marking-lines.part-code  = buf_parts.part-code
    11989                                                   and buf_marking-lines.prt-code   = buf_parts.prt-code
    11990                                                   no-error .
    11991           if available buf_marking-lines
    11992           then do :
    11993             find current buf_marking-lines exclusive-lock .
    11994             delete buf_marking-lines .
    11995             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
    11996               assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:Reserved:KeyIntDB .
    11997             end .
    11998           end .
    11999           else do :
    12000             create buf_marking-lines .
    12001             assign
    12002               buf_marking-lines.mark       = orig_marking-lines.mark
    12003               buf_marking-lines.doc-level  = orig_marking-lines.doc-level
    12004               buf_marking-lines.gds-code   = buf_goods.gds-code
    12005               buf_marking-lines.obj-type   = buf_parts.obj-type
    12006               buf_marking-lines.obj-code   = buf_parts.obj-code
    12007               buf_marking-lines.in-code    = buf_parts.in-code
    12008               buf_marking-lines.out-code   = buf_parts.out-code
    12009               buf_marking-lines.part-code  = buf_parts.part-code
    12010               buf_marking-lines.prt-code   = buf_parts.prt-code
    12011             .
    12012             if buf_parts.out-code <> buf_parts.in-code
    12013             and buf_parts.out-code <> 'free-zone':U
    12014             and buf_parts.out-code <> 'out-zone':U
    12015             then do :
    12016               find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.out-code no-error .
    12017               if available buf_trn-doc then buf_marking-lines.fact-order = buf_trn-doc.fact-order .
    12018             end .
    12019             for first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
    12020               assign
    12021                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB when buf_parts.out-code = 'free-zone':U
    12022                 buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB when buf_parts.out-code = 'out-zone':U
    12023               .
    12024             end .
    12025           end .
    12026           release buf_marking-lines no-error .
    12027         end.
    12028         if p-goods-twounit = true
    12029         then do:
    12030           assign
    12031             buf_parts.cli-qnty = buf_parts.cli-qnty - abs(archive_parts.cli-qnty)
    12032                                                     * (if p-rsrv-direction = true
    12033                                                       then 1
    12034                                                       else -1
    12035                                                       )
    12036           .
    12037         end.
    12038         if  buf_parts.qnty      = 0
    12039         and buf_parts.fact-qnty = 0
    12040         then do:
    12041           if p-goods-twounit = true
    12042           then do:
    12043             if buf_parts.cli-qnty <> 0
    12044             then do:
    12045               message
    12046                 vss-workfile vss-revision vss-description skip
    12047                 vss-include-info48 skip
    12048                 "Ошибка при удалении партии" skip
    12049                 "Документ" buf_trn-doc.doc-code skip
    12050                 "Объект" buf_parts.obj-type buf_parts.obj-code skip
    12051                 "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
    12052                 "Партия" buf_parts.in-code buf_parts.part-code skip
    12053                 "Резерв" buf_parts.out-code skip
    12054                 "qnty" buf_parts.qnty skip
    12055                 "fact-qnty" buf_parts.fact-qnty skip
    12056                 "cli-qnty" buf_parts.cli-qnty skip
    12057                 view-as alert-box error .
    12058               undo, return error .
    12059             end.
    12060           end.
    12061           delete buf_parts .
    12062         end.
    12063       end.
    12064     end.
    12065   end procedure.
    12066   procedure partcopy-update-doc-line-tot-fact :
    12067     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
    12068     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
    12069     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
    12070     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
    12071     define variable vss-description as character no-undo init "partcopy-update-doc-line-tot-fact-01: процедура обновления средней учетной цены в строке документа".
    12072       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
    12073     define buffer buf_doc-line for ub.doc-line .
    12074     do
    12075     on error undo, return error return-value
    12076     :
    12077       find first buf_doc-line exclusive-lock
    12078         where buf_doc-line.doc-code  = p-doc-code
    12079           and buf_doc-line.artic     = p-artic
    12080           and buf_doc-line.prod-type = p-prod-type
    12081           and buf_doc-line.prod-code = p-prod-code
    12082         no-error .
    12083       if error-status :error
    12084       then do:
    12085         message
    12086           vss-workfile vss-revision vss-description skip
    12087           vss-include-info48 skip
    12088           "Ошибка задания входных параметров" skip
    12089           "Не найдена строка документа" skip
    12090           "Документ" p-doc-code skip
    12091           "Артикул" p-artic p-prod-type p-prod-code skip
    12092           error-status :get-message(1) skip
    12093           return-value skip
    12094           view-as alert-box error .
    12095         undo, return error .
    12096       end.
    12097       run partrqst in this-procedure
    12098         (input buf_doc-line.doc-code
    12099         ,input buf_doc-line.obj-type
    12100         ,input buf_doc-line.obj-code
    12101         ,input buf_doc-line.artic
    12102         ,input buf_doc-line.prod-type
    12103         ,input buf_doc-line.prod-code
    12104               ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
    12105         ) no-error .
    12106       if error-status :error
    12107       then do:
    12108         message
    12109           vss-workfile vss-revision vss-description skip
    12110           vss-include-info48 skip
    12111           "Ошибка при сборе информации по партиям" skip
    12112           "Документ" p-doc-code skip
    12113           "Артикул" p-artic p-prod-type p-prod-code skip
    12114           view-as alert-box error .
    12115         undo, return error .
    12116       end.
    12117       if v-total-parts-fact-qnty <> 0
    12118       then do:
    12119         assign
    12120           buf_doc-line.price-base      = v-total-parts-price-base
    12121                                        / v-total-parts-fact-qnty
    12122           buf_doc-line.price-rubl      = v-total-parts-price-rubl
    12123                                        / v-total-parts-fact-qnty
    12124           buf_doc-line.transport-base  = v-total-parts-transport-base
    12125                                        / v-total-parts-fact-qnty
    12126           buf_doc-line.transport-rubl  = v-total-parts-transport-rubl
    12127                                        / v-total-parts-fact-qnty
    12128           buf_doc-line.other-base      = v-total-parts-other-base
    12129                                        / v-total-parts-fact-qnty
    12130           buf_doc-line.other-rubl      = v-total-parts-other-rubl
    12131                                        / v-total-parts-fact-qnty
    12132         .
    12133       end.
    12134       else do:
    12135       end.
    12136     end.
    12137   end procedure.
    12138   procedure partcopy-change-purch-code :
    12139     define input parameter  p-in-code          like ub.parts.in-code no-undo .
    12140     define input parameter  p-dest-purch-code  like ub.parts.purch-code no-undo .
    12141     define parameter buffer buf_orig_parts     for ub.parts .
    12142     define parameter buffer buf1_parts         for ub.parts .
    12143     define parameter buffer buf2_parts         for ub.parts .
    12144     define variable vss-description as character no-undo init "partcopy-change-purch-code01: процедура копирования партии при смене purch-code".
    12145     define variable var-out-code  like ub.parts.out-code no-undo .
    12146     define variable var-part-code like ub.parts.part-code no-undo .
    12147     define buffer buf_goods        for ub.goods .
    12148     define buffer buf_parts-root   for ub.parts-root.
    12149     define buffer buf_trn-doc      for ub.trn-doc.
    12150     define buffer buf-orig_trn-doc for ub.trn-doc.
    12151     define buffer buf_units        for ub.units .
    12152     do
    12153     on error undo, return error return-value
    12154     :
    12155       if buf_orig_parts.out-code = p-in-code
    12156       then do:
    12157         message
    12158           vss-workfile vss-revision vss-description skip
    12159           vss-include-info48 skip
    12160           "Ошибка задания входных параметров процедуры partcopy" skip
    12161           "buf_orig_parts.out-code" buf_orig_parts.out-code skip
    12162           "p-in-code" p-in-code skip
    12163           view-as alert-box error .
    12164         undo, return error .
    12165       end.
    12166       find first buf_trn-doc no-lock
    12167         where buf_trn-doc.doc-code = p-in-code
    12168         .
    12169       find first buf-orig_trn-doc where buf-orig_trn-doc.doc-code = buf_orig_parts.out-code.
    12170       find first buf_goods no-lock
    12171         where buf_goods.artic = buf_orig_parts.artic
    12172           and buf_goods.prod-type = buf_orig_parts.prod-type
    12173           and buf_goods.prod-code = buf_orig_parts.prod-code
    12174         .
    12175       find first buf_units where buf_units.unit-name = buf_goods.unit-base no-lock.
    12176       find first buf1_parts exclusive-lock
    12177         where buf1_parts.obj-type  = buf_orig_parts.obj-type
    12178           and buf1_parts.obj-code  = buf_orig_parts.obj-code
    12179           and buf1_parts.artic     = buf_orig_parts.artic
    12180           and buf1_parts.prod-type = buf_orig_parts.prod-type
    12181           and buf1_parts.prod-code = buf_orig_parts.prod-code
    12182           and buf1_parts.in-code   = buf_orig_parts.in-code
    12183           and buf1_parts.out-code  = p-in-code
    12184           and buf1_parts.part-code = buf_orig_parts.part-code
    12185         no-error.
    12186       if not available buf1_parts
    12187       then do:
    12188         create buf1_parts .
    12189         buffer-copy buf_orig_parts to buf1_parts
    12190         assign
    12191           buf1_parts.in-code    = buf_orig_parts.in-code
    12192           buf1_parts.out-code   = p-in-code
    12193           buf1_parts.status_    = no
    12194           buf1_parts.qnty       = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
    12195           buf1_parts.fact-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.fact-qnty else - buf_orig_parts.fact-qnty )
    12196           buf1_parts.cli-qnty   = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then buf_orig_parts.cli-qnty  else - buf_orig_parts.cli-qnty  )
    12197           buf1_parts.purch-code = buf_orig_parts.purch-code
    12198           buf1_parts.rsrv-free  = ?
    12199           buf1_parts.status_    = yes
    12200         .
    12201         validate buf1_parts .
    12202       end.
    12203       if  lookup('сер':U, buf_units.type) > 0
    12204       then do:
    12205          var-part-code = buf_orig_parts.part-code.
    12206       end.
    12207       else do:
    12208           run holdprts-get-part-code in this-procedure
    12209             (input  p-in-code
    12210             ,output var-part-code
    12211             ) no-error .
    12212           if error-status :error
    12213           then dO:
    12214             undo, return error return-value.
    12215           end.
    12216       end.
    12217       find first buf2_parts exclusive-lock
    12218         where buf2_parts.obj-type  = buf_orig_parts.obj-type
    12219           and buf2_parts.obj-code  = buf_orig_parts.obj-code
    12220           and buf2_parts.artic     = buf_orig_parts.artic
    12221           and buf2_parts.prod-type = buf_orig_parts.prod-type
    12222           and buf2_parts.prod-code = buf_orig_parts.prod-code
    12223           and buf2_parts.in-code   = p-in-code
    12224           and buf2_parts.out-code  = p-in-code
    12225           and buf2_parts.part-code = var-part-code
    12226         no-error.
    12227       if not available buf2_parts
    12228       then do:
    12229         create buf2_parts .
    12230         buffer-copy buf_orig_parts to buf2_parts
    12231         assign
    12232           buf2_parts.in-code   = p-in-code
    12233           buf2_parts.out-code  = p-in-code
    12234           buf2_parts.qnty      = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
    12235           buf2_parts.fact-qnty = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.fact-qnty else buf_orig_parts.fact-qnty )
    12236           buf2_parts.cli-qnty  = (if buf-orig_trn-doc.ext-doc-type = 'mp':U then - buf_orig_parts.cli-qnty  else buf_orig_parts.cli-qnty  )
    12237           buf2_parts.purch-code = p-dest-purch-code
    12238           buf2_parts.part-code  = var-part-code
    12239           buf2_parts.rsrv-free  = ?
    12240           buf2_parts.status_    = yes
    12241         .
    12242         validate buf2_parts .
    12243       end.
    12244       assign
    12245         buf_orig_parts.in-code    = p-in-code
    12246         buf_orig_parts.part-code  = buf2_parts.part-code
    12247         buf_orig_parts.purch-code = buf2_parts.purch-code
    12248       .
    12249       find first buf_parts-root
    12250         where buf_parts-root.doc-code       = p-in-code
    12251           and buf_parts-root.in-code        = p-in-code
    12252           and buf_parts-root.gds-code       = buf_goods.gds-code
    12253           and buf_parts-root.part-code      = buf2_parts.part-code
    12254           and buf_parts-root.orig-in-code   = buf1_parts.in-code
    12255           and buf_parts-root.orig-gds-code  = buf_goods.gds-code
    12256           and buf_parts-root.orig-part-code = buf1_parts.part-code
    12257         no-error .
    12258       if not available buf_parts-root
    12259       then do:
    12260         create buf_parts-root.
    12261         assign
    12262         buf_parts-root.doc-code       = p-in-code
    12263         buf_parts-root.in-code        = p-in-code
    12264         buf_parts-root.gds-code       = buf_goods.gds-code
    12265         buf_parts-root.part-code      = buf2_parts.part-code
    12266         buf_parts-root.orig-in-code   = buf1_parts.in-code
    12267         buf_parts-root.orig-gds-code  = buf_goods.gds-code
    12268         buf_parts-root.orig-part-code = buf1_parts.part-code
    12269         .
    12270       end.
    12271     end.
    12272   end procedure.
    12273   procedure addChildMarkingLines:
    12274     define input parameter iMark as character no-undo.
    12275     define input parameter iSts  as integer   no-undo.
    12276     define parameter buffer buf_marking-lines  for ub.marking-lines.
    12277     define parameter buffer buf_parts          for ub.parts.
    12278     define parameter buffer orig_marking-lines for ub.marking-lines.
    12279     define parameter buffer buf_orig_parts     for ub.parts.
    12280     define parameter buffer buf_goods          for ub.goods.
    12281     define buffer buf_marking-childs        for ub.marking.
    12282     define buffer buf_marking-lines-childs  for ub.marking-lines.
    12283     define buffer buf_marking-chk           for ub.marking-chk.
    12284     define buffer buf_chk-doc               for ub.chk-doc.
    12285     define buffer orig_marking-lines-childs for ub.marking-lines.
    12286     for each buf_marking-childs exclusive-lock where
    12287              buf_marking-childs.mark-parent = iMark :
    12288         find first buf_marking-lines-childs no-lock where
    12289                    buf_marking-lines-childs.mark       = buf_marking-childs.mark
    12290                and buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
    12291                and buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
    12292                and buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
    12293                and buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
    12294                and buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
    12295                and buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
    12296                and buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
    12297         no-error .
    12298         if not available buf_marking-lines-childs then
    12299         do:
    12300           create buf_marking-lines-childs .
    12301           assign
    12302             buf_marking-lines-childs.mark       = buf_marking-childs.mark
    12303             buf_marking-lines-childs.gds-code   = buf_marking-lines.gds-code
    12304             buf_marking-lines-childs.obj-type   = buf_marking-lines.obj-type
    12305             buf_marking-lines-childs.obj-code   = buf_marking-lines.obj-code
    12306             buf_marking-lines-childs.in-code    = buf_marking-lines.in-code
    12307             buf_marking-lines-childs.out-code   = buf_marking-lines.out-code
    12308             buf_marking-lines-childs.part-code  = buf_marking-lines.part-code
    12309             buf_marking-lines-childs.prt-code   = buf_marking-lines.prt-code
    12310             buf_marking-lines-childs.fact-order = buf_marking-lines.fact-order
    12311             buf_marking-lines-childs.doc-level  = buf_marking-lines.doc-level + 1
    12312           .
    12313           validate buf_marking-childs.
    12314         end .
    12315         buf_marking-childs.sts = iSts .
    12316         for each buf_marking-chk exclusive-lock where
    12317                  buf_marking-chk.mark begins buf_marking-childs.mark
    12318         :
    12319           for first buf_chk-doc no-lock where
    12320                     buf_chk-doc.doc-code = buf_marking-chk.doc-code
    12321                 and buf_chk-doc.out-code = buf_parts.out-code
    12322           :
    12323             buf_marking-chk.sts = 0 .
    12324             validate buf_marking-chk.
    12325           end .
    12326         end .
    12327         if available orig_marking-lines
    12328         then do :
    12329           find first orig_marking-lines-childs exclusive-lock where
    12330                      orig_marking-lines-childs.mark       = buf_marking-childs.mark
    12331                  and orig_marking-lines-childs.gds-code   = buf_goods.gds-code
    12332                  and orig_marking-lines-childs.obj-type   = buf_orig_parts.obj-type
    12333                  and orig_marking-lines-childs.obj-code   = buf_orig_parts.obj-code
    12334                  and orig_marking-lines-childs.in-code    = buf_orig_parts.in-code
    12335                  and orig_marking-lines-childs.out-code   = buf_orig_parts.out-code
    12336                  and orig_marking-lines-childs.part-code  = buf_orig_parts.part-code
    12337                  and orig_marking-lines-childs.prt-code   = buf_orig_parts.prt-code
    12338           no-error .
    12339           if available orig_marking-lines-childs then
    12340             delete orig_marking-lines-childs .
    12341         end.
    12342         run addChildMarkingLines in this-procedure (
    12343           buf_marking-childs.mark,
    12344           iSts,
    12345           buffer buf_marking-lines,
    12346           buffer buf_parts,
    12347           buffer orig_marking-lines,
    12348           buffer buf_orig_parts,
    12349           buffer buf_goods
    12350         ).
    12351     end .
    12352   end.
    12353   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12354   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12355   procedure holdprts-create-parts-supp :
    12356     define input  parameter p-orig-in-code   like ub.parts-supp.orig-in-code   no-undo .
    12357     define input  parameter p-orig-part-code like ub.parts-supp.orig-part-code no-undo .
    12358     define input  parameter p-in-code        like ub.parts-supp.in-code        no-undo .
    12359     define input  parameter p-artic          like ub.parts-supp.artic          no-undo .
    12360     define input  parameter p-prod-type      like ub.parts-supp.prod-type      no-undo .
    12361     define input  parameter p-prod-code      like ub.parts-supp.prod-code      no-undo .
    12362     define input  parameter p-part-code      like ub.parts-supp.part-code      no-undo .
    12363     define variable vss-description as character no-undo init "holdprts-create-parts-supp-01: скопировать атрибут партии".
    12364     define buffer buf_parent_trn-doc  for ub.trn-doc .
    12365     define buffer buf_child_trn-doc   for ub.trn-doc .
    12366     define buffer buf_parts           for ub.parts .
    12367     define buffer buf_parts-supp      for ub.parts-supp .
    12368     define buffer buf_orig_parts-supp for ub.parts-supp .
    12369     define buffer buf_income_trn-doc  for ub.trn-doc .
    12370     define buffer buf_income_doc-line for ub.doc-line .
    12371     define buffer buf_goods           for ub.goods .
    12372       define buffer   in-vatp-trn-doc  for ub.trn-doc .
    12373       define buffer   in-vatp-parts    for ub.parts   .
    12374       define buffer   in-vatp-doc      for ub.trn-doc .
    12375       define buffer   in-vatp-goods    for ub.goods   .
    12376       define buffer   in-vatp-sysconf  for ub.sysconf .
    12377       define buffer   in-vatp_doc-attr for ub.doc-attr.
    12378       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
    12379       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
    12380       define variable varinvprb                  as   character              no-undo.
    12381       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
    12382       define variable cli-base-rate              as   decimal                no-undo.
    12383       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
    12384       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
    12385       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
    12386       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
    12387       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
    12388       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
    12389       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
    12390       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
    12391       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
    12392       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
    12393       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
    12394       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
    12395       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
    12396       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
    12397       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
    12398       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
    12399       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
    12400       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
    12401       define variable other-base-loc             like ub.doc-line.price-base no-undo.
    12402       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
    12403       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
    12404       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
    12405       define variable varinvatp-envd             as   character              no-undo.
    12406       define variable varinvatp-type             as   character              no-undo.
    12407     do
    12408     on error undo, return error return-value
    12409     :
    12410       find first buf_child_trn-doc no-lock
    12411         where buf_child_trn-doc.doc-code = p-in-code
    12412         no-error .
    12413       if not available buf_child_trn-doc
    12414       then do:
    12415         return substitute("Не найден исходный документ &1", p-in-code) .
    12416       end.
    12417       find first buf_parent_trn-doc no-lock
    12418         where buf_parent_trn-doc.doc-code = buf_child_trn-doc.hold-doc-code-parent
    12419         no-error .
    12420       if not available buf_parent_trn-doc
    12421       then do:
    12422         return substitute("Не найден приходный документ &1", buf_child_trn-doc.hold-doc-code-parent) .
    12423       end.
    12424       find first buf_parts-supp exclusive-lock
    12425         where buf_parts-supp.in-code   = p-in-code
    12426           and buf_parts-supp.artic     = p-artic
    12427           and buf_parts-supp.prod-type = p-prod-type
    12428           and buf_parts-supp.prod-code = p-prod-code
    12429           and buf_parts-supp.part-code = p-part-code
    12430         no-error .
    12431       if available buf_parts-supp
    12432       then do:
    12433         message
    12434           vss-workfile vss-revision vss-description skip
    12435           vss-include-info60 skip
    12436           "Попытка повторного создания партии атрибутов" skip
    12437           "Документ прихода" p-in-code skip
    12438           "Артикул" p-artic p-prod-type p-prod-code skip
    12439           "Код партии" p-part-code skip
    12440           "Исходный код партии" p-orig-in-code skip
    12441           "Исходный код документа" p-orig-part-code skip
    12442           view-as alert-box error .
    12443         undo, return error .
    12444       end.
    12445       create buf_parts-supp .
    12446       assign
    12447         buf_parts-supp.in-code   = p-in-code
    12448         buf_parts-supp.artic     = p-artic
    12449         buf_parts-supp.prod-type = p-prod-type
    12450         buf_parts-supp.prod-code = p-prod-code
    12451         buf_parts-supp.part-code = p-part-code
    12452       .
    12453       assign
    12454         buf_parts-supp.orig-in-code   = p-orig-in-code
    12455         buf_parts-supp.orig-part-code = p-orig-part-code
    12456       .
    12457       find first buf_orig_parts-supp share-lock
    12458         where buf_orig_parts-supp.in-code   = p-orig-in-code
    12459           and buf_orig_parts-supp.artic     = p-artic
    12460           and buf_orig_parts-supp.prod-type = p-prod-type
    12461           and buf_orig_parts-supp.prod-code = p-prod-code
    12462           and buf_orig_parts-supp.part-code = p-orig-part-code
    12463         no-error .
    12464       if available buf_orig_parts-supp
    12465       then do:
    12466         buffer-copy buf_orig_parts-supp
    12467         except
    12468           buf_orig_parts-supp.in-code
    12469           buf_orig_parts-supp.artic
    12470           buf_orig_parts-supp.prod-type
    12471           buf_orig_parts-supp.prod-code
    12472           buf_orig_parts-supp.part-code
    12473           buf_orig_parts-supp.orig-in-code
    12474           buf_orig_parts-supp.orig-part-code
    12475         to buf_parts-supp.
    12476       end.
    12477       else do:
    12478         find first buf_parts share-lock
    12479           where buf_parts.obj-type  = buf_parent_trn-doc.obj-type
    12480             and buf_parts.obj-code  = buf_parent_trn-doc.obj-code
    12481             and buf_parts.artic     = p-artic
    12482             and buf_parts.prod-type = p-prod-type
    12483             and buf_parts.prod-code = p-prod-code
    12484             and buf_parts.in-code   = p-orig-in-code
    12485             and buf_parts.out-code  = buf_parent_trn-doc.doc-code
    12486             and buf_parts.part-code = p-orig-part-code
    12487           no-error .
    12488         if not available buf_parts
    12489         then do:
    12490           message
    12491             vss-workfile vss-revision vss-description skip
    12492             vss-include-info60 skip
    12493             "Ошибка задания входных параметров" skip
    12494             "Не найдена исходная партия" skip
    12495             "Исходный документ" p-orig-in-code skip
    12496             "Артикул" p-artic p-prod-type p-prod-code skip
    12497             "Код партии" p-orig-part-code skip
    12498             view-as alert-box error .
    12499           undo, return error .
    12500         end.
    12501         define variable v-base-rate         as decimal   no-undo .
    12502         define variable v-base-scale        as integer   no-undo .
    12503         define variable v-exch-rate         as decimal   no-undo .
    12504         define variable v-exch-scale        as integer   no-undo .
    12505         define variable v-extended-doc-type as character no-undo .
    12506         define variable v-unit-cli          as character no-undo .
    12507         find first buf_income_trn-doc no-lock
    12508           where buf_income_trn-doc.doc-code = p-orig-in-code
    12509           no-error .
    12510         if available buf_income_trn-doc
    12511         then do:
    12512           find first buf_income_doc-line no-lock
    12513             where buf_income_doc-line.doc-code  = p-orig-in-code
    12514               and buf_income_doc-line.artic     = p-artic
    12515               and buf_income_doc-line.prod-type = p-prod-type
    12516               and buf_income_doc-line.prod-code = p-prod-code
    12517             no-error .
    12518           if not available buf_income_doc-line
    12519           then do:
    12520             message
    12521               vss-workfile vss-revision vss-description skip
    12522               vss-include-info60 skip
    12523               "Не найдена исходная строка документа прихода" skip
    12524               "Исходный документ" p-orig-in-code skip
    12525               "Артикул" p-artic p-prod-type p-prod-code skip
    12526               "Код партии" p-orig-part-code skip
    12527               view-as alert-box error .
    12528             undo, return error .
    12529           end.
    12530           assign
    12531             v-base-rate         = buf_income_trn-doc.base-rate
    12532             v-base-scale        = buf_income_trn-doc.base-scale
    12533             v-exch-rate         = buf_income_trn-doc.exch-rate
    12534             v-exch-scale        = buf_income_trn-doc.exch-scale
    12535             v-extended-doc-type = buf_income_trn-doc.ext-doc-type
    12536             v-unit-cli          = buf_income_doc-line.unit-cli
    12537           .
    12538         end.
    12539         else do:
    12540           find first buf_goods no-lock
    12541             where buf_goods.artic     = buf_parts.artic
    12542               and buf_goods.prod-type = buf_parts.prod-type
    12543               and buf_goods.prod-code = buf_parts.prod-code
    12544             .
    12545           assign
    12546             v-base-rate         = buf_parts.price-rubl / buf_parts.price-base
    12547             v-base-scale        = 1
    12548             v-exch-rate         = buf_parts.price-rubl / (buf_parts.price-cli * buf_parts.cli-base-rate)
    12549             v-exch-scale        = 1
    12550             v-extended-doc-type = 'ie':U
    12551             v-unit-cli          = buf_goods.unit-cli
    12552           .
    12553         end.
    12554          if v-base-rate = ? then v-base-rate = 1.
    12555          if v-exch-rate = ? then v-exch-rate = 1.
    12556   assign
    12557     price-rubl-with-tax-loc = buf_parts.price-rubl
    12558     price-base-with-tax-loc = buf_parts.price-base
    12559   .
    12560   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    12561   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    12562     (output varinvprb
    12563     )  .
    12564     if buf_parts.out-code = 'free-zone':U     or
    12565        buf_parts.out-code = 'out-zone':U   or
    12566        buf_parts.doc-type = 'акт':U then do:
    12567       assign
    12568         in-vatp-have-vat-slt = yes.
    12569     end.
    12570     else do:
    12571       find first in-vatp_doc-attr no-lock
    12572         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
    12573           and in-vatp_doc-attr.attr-code = 'envd':U
    12574         no-error .
    12575       if not available in-vatp_doc-attr then do:
    12576         assign
    12577           in-vatp-have-vat-slt = yes.
    12578       end.
    12579       else do:
    12580            in-vatp-have-vat-slt = no.
    12581       end.
    12582     end.
    12583     assign
    12584      price-cli-with-tax-loc = buf_parts.price-cli
    12585      cli-base-rate          = buf_parts.cli-base-rate.
    12586     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
    12587              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
    12588     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
    12589             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
    12590             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
    12591             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
    12592             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
    12593             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
    12594             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
    12595       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
    12596     assign
    12597       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
    12598     assign
    12599       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
    12600       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
    12601       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
    12602       transport-cli-loc  = 0
    12603       other-cli-loc      = 0
    12604     .
    12605   ASSIGN
    12606             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
    12607       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
    12608   .
    12609         assign
    12610           buf_parts-supp.PS                = buf_parts.PS
    12611           buf_parts-supp.SLT-type          = buf_parts.SLT-type
    12612           buf_parts-supp.VAT-type          = buf_parts.VAT-type
    12613           buf_parts-supp.base-rate         = v-base-rate
    12614           buf_parts-supp.base-scale        = v-base-scale
    12615           buf_parts-supp.cli-qnty          = buf_parts.cli-qnty
    12616           buf_parts-supp.cst-code          = buf_parts.cst-code
    12617           buf_parts-supp.doc-qnty          = buf_parts.qnty
    12618           buf_parts-supp.exch-code         = buf_parts.exch-code
    12619           buf_parts-supp.exch-rate         = v-exch-rate
    12620           buf_parts-supp.exch-scale        = v-exch-scale
    12621           buf_parts-supp.extended-doc-type = v-extended-doc-type
    12622           buf_parts-supp.fact-date         = buf_parts.fact-date
    12623           buf_parts-supp.fact-qnty         = buf_parts.fact-qnty
    12624           buf_parts-supp.last-date         = buf_parts.last-date
    12625           buf_parts-supp.pay-code          = buf_parts.pay-code
    12626           buf_parts-supp.price-cli         = buf_parts.price-cli
    12627           buf_parts-supp.purch-code        = buf_parts.purch-code
    12628           buf_parts-supp.supp-code         = buf_parts.supp-code
    12629           buf_parts-supp.supp-type         = buf_parts.supp-type
    12630           buf_parts-supp.unit-cli          = v-unit-cli
    12631         .
    12632         assign
    12633           buf_parts-supp.vat-pc         = vat-pc-loc
    12634           buf_parts-supp.slt-pc         = slt-pc-loc
    12635           buf_parts-supp.price-base     = price-base-with-tax-loc
    12636           buf_parts-supp.price-rubl     = price-rubl-with-tax-loc
    12637           buf_parts-supp.vat-base       = vat-base-loc
    12638           buf_parts-supp.vat-rubl       = vat-rubl-loc
    12639           buf_parts-supp.slt-base       = slt-base-loc
    12640           buf_parts-supp.slt-rubl       = slt-rubl-loc
    12641           buf_parts-supp.road-tax-base  = road-tax-base-loc
    12642           buf_parts-supp.road-tax-rubl  = road-tax-rubl-loc
    12643           buf_parts-supp.transport-base = transport-base-loc
    12644           buf_parts-supp.transport-rubl = transport-rubl-loc
    12645           buf_parts-supp.other-base     = other-base-loc
    12646           buf_parts-supp.other-rubl     = other-rubl-loc
    12647         .
    12648       end.
    12649     end.
    12650   end procedure.
    12651   procedure holdprts-get-part-code :
    12652     define input  parameter p-doc-code       as character no-undo .
    12653     define output parameter p-hold-part-code as integer   no-undo .
    12654     define variable vss-description as character no-undo init "holdprts-get-part-code-01: создать уникальный код партии внутри документа".
    12655     define variable v-attr-value as character no-undo .
    12656     define variable v-attr-type  as character no-undo .
    12657     define buffer buf_trn-doc for ub.trn-doc .
    12658     do
    12659     on error undo, return error return-value
    12660     :
    12661       find first buf_trn-doc exclusive-lock
    12662         where buf_trn-doc.doc-code = p-doc-code
    12663         no-error .
    12664       if not available buf_trn-doc
    12665       then do:
    12666         message
    12667           vss-workfile vss-revision vss-description skip
    12668           vss-include-info60 skip
    12669           "Ошибка задания входных параметров" skip
    12670           "Не найден документ" p-doc-code skip
    12671           view-as alert-box error .
    12672         undo, return error .
    12673       end.
    12674   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
    12675                           input 'hold-part-code':U ,
    12676                          output v-attr-value ,
    12677                          output v-attr-type )  .
    12678       assign
    12679         p-hold-part-code = integer(v-attr-value) + 1
    12680       .
    12681   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
    12682                          input 'hold-part-code':U ,
    12683                          input string(p-hold-part-code) )  .
    12684     end.
    12685   end procedure.
    12686   procedure holdprts-validate-document :
    12687     define input  parameter p-doc-code as character no-undo .
    12688     define variable vss-description as character no-undo init "holdprts-validate-document-01: проверить правильность документа".
    12689     define buffer buf_trn-doc    for ub.trn-doc .
    12690     define buffer parent_trn-doc for ub.trn-doc .
    12691     define buffer buf_parts      for ub.parts .
    12692     define buffer buf_parts-supp for ub.parts-supp .
    12693     do
    12694     on error undo, return error return-value
    12695     :
    12696       find first buf_trn-doc exclusive-lock
    12697         where buf_trn-doc.doc-code = p-doc-code
    12698         no-error .
    12699       if not available buf_trn-doc
    12700       then do:
    12701         message
    12702           vss-workfile vss-revision vss-description skip
    12703           vss-include-info60 skip
    12704           "Ошибка задания входных параметров" skip
    12705           "Не найден документ" p-doc-code skip
    12706           view-as alert-box error .
    12707         undo, return error .
    12708       end.
    12709       find first parent_trn-doc exclusive-lock
    12710         where parent_trn-doc.doc-code = buf_trn-doc.hold-doc-code-parent
    12711         no-error .
    12712       if not available parent_trn-doc
    12713       then do:
    12714         message
    12715           vss-workfile vss-revision vss-description skip
    12716           vss-include-info60 skip
    12717           "Не найден родительский документ" skip
    12718           "Документ" buf_trn-doc.doc-code skip
    12719           "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
    12720           view-as alert-box error .
    12721         undo, return error .
    12722       end.
    12723       if buf_trn-doc.ext-doc-type <> 'ie':U
    12724       then do:
    12725         return .
    12726       end.
    12727       for each buf_parts share-lock
    12728         where buf_parts.out-code = buf_trn-doc.doc-code
    12729       on error undo, return error
    12730       :
    12731         find first buf_parts-supp share-lock
    12732           where buf_parts-supp.in-code   = buf_parts.in-code
    12733             and buf_parts-supp.artic     = buf_parts.artic
    12734             and buf_parts-supp.prod-type = buf_parts.prod-type
    12735             and buf_parts-supp.prod-code = buf_parts.prod-code
    12736             and buf_parts-supp.part-code = buf_parts.part-code
    12737           no-error .
    12738         if not available buf_parts-supp
    12739         then do:
    12740           message
    12741             vss-workfile vss-revision vss-description skip
    12742             vss-include-info60 skip
    12743             "Не найдена информация о поставщике" skip
    12744             "Документ" buf_trn-doc.doc-code skip
    12745             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
    12746             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
    12747             "Номер партии" buf_parts.part-code skip
    12748             view-as alert-box error .
    12749           undo, return error .
    12750         end.
    12751       end.
    12752       for each buf_parts-supp share-lock
    12753         where buf_parts-supp.in-code = buf_trn-doc.doc-code
    12754       on error undo, return error
    12755       :
    12756         find first buf_parts share-lock
    12757           where buf_parts.out-code  = buf_parts-supp.in-code
    12758             and buf_parts.obj-type  = buf_trn-doc.obj-type
    12759             and buf_parts.obj-code  = buf_trn-doc.obj-code
    12760             and buf_parts.artic     = buf_parts-supp.artic
    12761             and buf_parts.prod-type = buf_parts-supp.prod-type
    12762             and buf_parts.prod-code = buf_parts-supp.prod-code
    12763             and buf_parts.part-code = buf_parts-supp.part-code
    12764           no-error .
    12765         if not available buf_parts
    12766         then do:
    12767           message
    12768             vss-workfile vss-revision vss-description skip
    12769             vss-include-info60 skip
    12770             "Задана информация о поставщике для неизвестной партии" skip
    12771             "Документ" buf_trn-doc.doc-code skip
    12772             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
    12773             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
    12774             "Номер партии" buf_parts.part-code skip
    12775             view-as alert-box error .
    12776           undo, return error .
    12777         end.
    12778       end.
    12779       for each buf_parts share-lock
    12780         where buf_parts.out-code = buf_trn-doc.hold-doc-code-parent
    12781       on error undo, return error
    12782       :
    12783         if  buf_trn-doc.doc-type = 'при':U
    12784         and buf_parts.qnty = buf_parts.fact-qnty
    12785         then do:
    12786           next.
    12787         end.
    12788         find first buf_parts-supp share-lock
    12789           where buf_parts-supp.orig-in-code   = buf_parts.in-code
    12790             and buf_parts-supp.artic          = buf_parts.artic
    12791             and buf_parts-supp.prod-type      = buf_parts.prod-type
    12792             and buf_parts-supp.prod-code      = buf_parts.prod-code
    12793             and buf_parts-supp.orig-part-code = buf_parts.part-code
    12794           no-error .
    12795         if not available buf_parts-supp
    12796         then do:
    12797           message
    12798             vss-workfile vss-revision vss-description skip
    12799             vss-include-info60 skip
    12800             "Не найдена информация о поставщике для исходной накладной" skip
    12801             "Документ" buf_trn-doc.doc-code skip
    12802             "Родительский документ" buf_trn-doc.hold-doc-code-parent skip
    12803             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
    12804             "Номер партии" buf_parts.part-code skip
    12805             view-as alert-box error .
    12806           undo, return error .
    12807         end.
    12808       end.
    12809     end.
    12810   end procedure.
    12811   procedure holdprts-doc-type :
    12812     define input  parameter p-cat-code as integer   no-undo .
    12813     define input  parameter p-doc-code as character no-undo .
    12814     define output parameter p-is-sale  as logical   no-undo .
    12815     define output parameter p-is-purch as logical   no-undo .
    12816     define variable vss-description as character no-undo init "holdprts-doc-type-01: определение типа документа для межфирменного архива".
    12817     define buffer buf_trn-doc for ub.trn-doc .
    12818     do
    12819     on error undo, return error return-value
    12820     :
    12821       find first buf_trn-doc no-lock
    12822         where buf_trn-doc.doc-code = p-doc-code
    12823         no-error .
    12824       if not available buf_trn-doc
    12825       then do:
    12826         message
    12827           vss-workfile vss-revision vss-description skip
    12828           vss-include-info60 skip
    12829           "Ошибка задания входных параметров" skip
    12830           "Не найден документ" skip
    12831           "Документ" p-doc-code skip
    12832           "Тип архива" p-cat-code skip
    12833           view-as alert-box error .
    12834         undo, return error .
    12835       end.
    12836       case p-cat-code :
    12837         when 1
    12838         then do:
    12839           define variable v-is-hold as logical   no-undo .
    12840   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12841   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
    12842     (input  buf_trn-doc.doc-code
    12843     ,output v-is-hold
    12844     )  .
    12845           if v-is-hold = true
    12846           then do:
    12847             assign
    12848               p-is-sale  = false
    12849               p-is-purch = false
    12850             .
    12851           end.
    12852           else do:
    12853             case buf_trn-doc.ext-doc-type :
    12854               when 'ie':U or
    12855               when 'ep':U
    12856               then do:
    12857                 assign
    12858                   p-is-sale  = false
    12859                   p-is-purch = true
    12860                 .
    12861               end.
    12862               when 'ee':U or
    12863               when 'es':U or
    12864               when 're':U or
    12865               when 'rs':U
    12866               then do:
    12867                 assign
    12868                   p-is-sale  = true
    12869                   p-is-purch = false
    12870                 .
    12871               end.
    12872               when 'we':U or
    12873               when 'vt':U or
    12874               when 'vp':U or
    12875               when 'ap':U or
    12876               when 'mp':U or
    12877               when 'pc':U or
    12878               when 'iv':U or
    12879               when 'ev':U or
    12880               when 'io':U or
    12881               when 'eo':U or
    12882               when 'rv':U or
    12883               when 'em':U or
    12884               when 'wm':U or
    12885               when 'im':U
    12886               then do:
    12887                 assign
    12888                   p-is-sale  = false
    12889                   p-is-purch = false
    12890                 .
    12891               end.
    12892               otherwise do:
    12893                 message
    12894                   vss-workfile vss-revision vss-description skip
    12895                   vss-include-info60 skip
    12896                   "Неизвестный тип документа" skip
    12897                   "Документ" buf_trn-doc.doc-code skip
    12898                   "Тип документа" buf_trn-doc.ext-doc-type skip
    12899                   "Тип архива" p-cat-code skip
    12900                   view-as alert-box error .
    12901                 undo, return error .
    12902               end.
    12903             end.
    12904           end.
    12905         end.
    12906         when 2
    12907         then do:
    12908           case buf_trn-doc.ext-doc-type :
    12909             when 'vt':U or
    12910             when 'vp':U
    12911             then do:
    12912               assign
    12913                 p-is-sale  = false
    12914                 p-is-purch = true
    12915               .
    12916             end.
    12917             otherwise do:
    12918               assign
    12919                 p-is-sale  = false
    12920                 p-is-purch = false
    12921               .
    12922             end.
    12923           end.
    12924         end.
    12925         when 3
    12926         then do:
    12927           case buf_trn-doc.ext-doc-type :
    12928             when 'we':U
    12929             then do:
    12930               assign
    12931                 p-is-sale  = false
    12932                 p-is-purch = true
    12933               .
    12934             end.
    12935             otherwise do:
    12936               assign
    12937                 p-is-sale  = false
    12938                 p-is-purch = false
    12939               .
    12940             end.
    12941           end.
    12942         end.
    12943         otherwise do:
    12944           message
    12945             vss-workfile vss-revision vss-description skip
    12946             "Неизвестный тип архивов" skip
    12947             "Документ" buf_trn-doc.doc-code skip
    12948             "Тип документа" buf_trn-doc.ext-doc-type skip
    12949             "Тип архива" p-cat-code skip
    12950             view-as alert-box error .
    12951           undo, return error return-value .
    12952         end.
    12953       end.
    12954     end.
    12955   end procedure.
    12956   procedure holdprts-purch-values :
    12957     define input  parameter p-doc-code             like ub.doc-line.doc-code  no-undo .
    12958     define input  parameter p-artic                like ub.doc-line.artic     no-undo .
    12959     define input  parameter p-prod-type            like ub.doc-line.prod-type no-undo .
    12960     define input  parameter p-prod-code            like ub.doc-line.prod-code no-undo .
    12961     define output parameter p-fact-qnty            as decimal   no-undo .
    12962     define output parameter p-purch-sum-base       as decimal   no-undo .
    12963     define output parameter p-purch-sum-rubl       as decimal   no-undo .
    12964     define output parameter p-purch-VAT-base       as decimal   no-undo .
    12965     define output parameter p-purch-VAT-rubl       as decimal   no-undo .
    12966     define output parameter p-purch-SLT-base       as decimal   no-undo .
    12967     define output parameter p-purch-SLT-rubl       as decimal   no-undo .
    12968     define output parameter p-purch-road-tax-base  as decimal   no-undo .
    12969     define output parameter p-purch-road-tax-rubl  as decimal   no-undo .
    12970     define output parameter p-purch-excise-base    as decimal   no-undo .
    12971     define output parameter p-purch-excise-rubl    as decimal   no-undo .
    12972     define output parameter p-purch-transport-base as decimal   no-undo .
    12973     define output parameter p-purch-transport-rubl as decimal   no-undo .
    12974     define output parameter p-purch-other-base     as decimal   no-undo .
    12975     define output parameter p-purch-other-rubl     as decimal   no-undo .
    12976     define output parameter p-purch-discnt-base    as decimal   no-undo .
    12977     define output parameter p-purch-discnt-rubl    as decimal   no-undo .
    12978     define variable vss-description as character no-undo init "holdprts-purch-values-01: параметры закупки товара".
    12979     define variable v-price-base     as decimal   no-undo .
    12980     define variable v-price-rubl     as decimal   no-undo .
    12981     define variable v-VAT-base       as decimal   no-undo .
    12982     define variable v-VAT-rubl       as decimal   no-undo .
    12983     define variable v-SLT-base       as decimal   no-undo .
    12984     define variable v-SLT-rubl       as decimal   no-undo .
    12985     define variable v-road-tax-base  as decimal   no-undo .
    12986     define variable v-road-tax-rubl  as decimal   no-undo .
    12987     define variable v-transport-base as decimal   no-undo .
    12988     define variable v-transport-rubl as decimal   no-undo .
    12989     define variable v-other-base     as decimal   no-undo .
    12990     define variable v-other-rubl     as decimal   no-undo .
    12991     define buffer buf_trn-doc        for ub.trn-doc .
    12992     define buffer buf_parts          for ub.parts .
    12993     define buffer buf_parts-supp     for ub.parts-supp .
    12994     define buffer buf_doc-line       for ub.doc-line .
    12995     define buffer buf_income_trn-doc for ub.trn-doc .
    12996     do
    12997     on error undo, return error return-value
    12998     :
    12999       find first buf_trn-doc no-lock
    13000         where buf_trn-doc.doc-code = p-doc-code
    13001         no-error .
    13002       if not available buf_trn-doc
    13003       then do:
    13004         message
    13005           vss-workfile vss-revision vss-description skip
    13006           vss-include-info60 skip
    13007           "Ошибка задания входных параметров" skip
    13008           "Не найден документ" skip
    13009           "Документ" p-doc-code skip
    13010           view-as alert-box error .
    13011         undo, return error .
    13012       end.
    13013       find first buf_doc-line no-lock
    13014         where buf_doc-line.doc-code  = p-doc-code
    13015           and buf_doc-line.artic     = p-artic
    13016           and buf_doc-line.prod-type = p-prod-type
    13017           and buf_doc-line.prod-code = p-prod-code
    13018         no-error .
    13019       if not available buf_doc-line
    13020       then do:
    13021         message
    13022           vss-workfile vss-revision vss-description skip
    13023           vss-include-info60 skip
    13024           "Ошибка задания входных параметров" skip
    13025           "Не найдена строка документа" skip
    13026           "Документ" p-doc-code skip
    13027           "Артикул" p-artic p-prod-type p-prod-code skip
    13028           view-as alert-box error .
    13029         undo, return error .
    13030       end.
    13031       assign
    13032         p-fact-qnty            = 0
    13033         p-purch-sum-base       = 0
    13034         p-purch-sum-rubl       = 0
    13035         p-purch-VAT-base       = 0
    13036         p-purch-VAT-rubl       = 0
    13037         p-purch-SLT-base       = 0
    13038         p-purch-SLT-rubl       = 0
    13039         p-purch-road-tax-base  = 0
    13040         p-purch-road-tax-rubl  = 0
    13041         p-purch-excise-base    = 0
    13042         p-purch-excise-rubl    = 0
    13043         p-purch-transport-base = 0
    13044         p-purch-transport-rubl = 0
    13045         p-purch-other-base     = 0
    13046         p-purch-other-rubl     = 0
    13047         p-purch-discnt-base    = 0
    13048         p-purch-discnt-rubl    = 0
    13049       .
    13050       for each buf_parts no-lock
    13051         where buf_parts.out-code  = buf_doc-line.doc-code
    13052           and buf_parts.obj-type  = buf_doc-line.obj-type
    13053           and buf_parts.obj-code  = buf_doc-line.obj-code
    13054           and buf_parts.artic     = buf_doc-line.artic
    13055           and buf_parts.prod-type = buf_doc-line.prod-type
    13056           and buf_parts.prod-code = buf_doc-line.prod-code
    13057       on error undo, return error
    13058       :
    13059         define variable v-parts-qnty as decimal   no-undo .
    13060         assign
    13061           v-parts-qnty = buf_parts.fact-qnty
    13062                        * ( if lookup(buf_trn-doc.doc-type, 'рас,спи':U ) > 0
    13063                            then -1
    13064                            else 1
    13065                          )
    13066         .
    13067         find first buf_parts-supp no-lock
    13068           where buf_parts-supp.in-code   = buf_parts.in-code
    13069             and buf_parts-supp.artic     = buf_parts.artic
    13070             and buf_parts-supp.prod-type = buf_parts.prod-type
    13071             and buf_parts-supp.prod-code = buf_parts.prod-code
    13072             and buf_parts-supp.part-code = buf_parts.part-code
    13073           no-error .
    13074         if available buf_parts-supp
    13075         then do:
    13076           assign
    13077             v-price-base     = buf_parts-supp.price-base
    13078             v-price-rubl     = buf_parts-supp.price-rubl
    13079             v-VAT-base       = buf_parts-supp.VAT-base
    13080             v-VAT-rubl       = buf_parts-supp.VAT-rubl
    13081             v-SLT-base       = buf_parts-supp.SLT-base
    13082             v-SLT-rubl       = buf_parts-supp.SLT-rubl
    13083             v-road-tax-base  = buf_parts-supp.road-tax-base
    13084             v-road-tax-rubl  = buf_parts-supp.road-tax-rubl
    13085             v-transport-base = buf_parts-supp.transport-base
    13086             v-transport-rubl = buf_parts-supp.transport-rubl
    13087             v-other-base     = buf_parts-supp.other-base
    13088             v-other-rubl     = buf_parts-supp.other-rubl
    13089           .
    13090         end.
    13091         else do:
    13092       define buffer   in-vatp-trn-doc  for ub.trn-doc .
    13093       define buffer   in-vatp-parts    for ub.parts   .
    13094       define buffer   in-vatp-doc      for ub.trn-doc .
    13095       define buffer   in-vatp-goods    for ub.goods   .
    13096       define buffer   in-vatp-sysconf  for ub.sysconf .
    13097       define buffer   in-vatp_doc-attr for ub.doc-attr.
    13098       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
    13099       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
    13100       define variable varinvprb                  as   character              no-undo.
    13101       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
    13102       define variable cli-base-rate              as   decimal                no-undo.
    13103       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
    13104       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
    13105       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
    13106       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
    13107       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
    13108       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
    13109       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
    13110       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
    13111       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
    13112       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
    13113       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
    13114       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
    13115       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
    13116       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
    13117       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
    13118       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
    13119       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
    13120       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
    13121       define variable other-base-loc             like ub.doc-line.price-base no-undo.
    13122       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
    13123       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
    13124       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
    13125       define variable varinvatp-envd             as   character              no-undo.
    13126       define variable varinvatp-type             as   character              no-undo.
    13127   assign
    13128     price-rubl-with-tax-loc = buf_parts.price-rubl
    13129     price-base-with-tax-loc = buf_parts.price-base
    13130   .
    13131   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    13132   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    13133     (output varinvprb
    13134     )  .
    13135     if buf_parts.out-code = 'free-zone':U     or
    13136        buf_parts.out-code = 'out-zone':U   or
    13137        buf_parts.doc-type = 'акт':U then do:
    13138       assign
    13139         in-vatp-have-vat-slt = yes.
    13140     end.
    13141     else do:
    13142       find first in-vatp_doc-attr no-lock
    13143         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
    13144           and in-vatp_doc-attr.attr-code = 'envd':U
    13145         no-error .
    13146       if not available in-vatp_doc-attr then do:
    13147         assign
    13148           in-vatp-have-vat-slt = yes.
    13149       end.
    13150       else do:
    13151            in-vatp-have-vat-slt = no.
    13152       end.
    13153     end.
    13154     assign
    13155      price-cli-with-tax-loc = buf_parts.price-cli
    13156      cli-base-rate          = buf_parts.cli-base-rate.
    13157     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
    13158              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
    13159     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
    13160             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
    13161             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
    13162             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
    13163             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
    13164             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
    13165             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
    13166       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
    13167     assign
    13168       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
    13169     assign
    13170       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
    13171       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
    13172       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
    13173       transport-cli-loc  = 0
    13174       other-cli-loc      = 0
    13175     .
    13176   ASSIGN
    13177             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
    13178       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
    13179   .
    13180           assign
    13181             v-price-base     = price-base-with-tax-loc
    13182             v-price-rubl     = price-rubl-with-tax-loc
    13183             v-VAT-base       = vat-base-loc
    13184             v-VAT-rubl       = vat-rubl-loc
    13185             v-SLT-base       = slt-base-loc
    13186             v-SLT-rubl       = slt-rubl-loc
    13187             v-road-tax-base  = road-tax-base-loc
    13188             v-road-tax-rubl  = road-tax-rubl-loc
    13189             v-transport-base = transport-base-loc
    13190             v-transport-rubl = transport-rubl-loc
    13191             v-other-base     = other-base-loc
    13192             v-other-rubl     = other-rubl-loc
    13193           .
    13194         end.
    13195         assign
    13196           p-fact-qnty            = p-fact-qnty            + v-parts-qnty
    13197           p-purch-sum-base       = p-purch-sum-base       + v-price-base     * v-parts-qnty
    13198           p-purch-sum-rubl       = p-purch-sum-rubl       + v-price-rubl     * v-parts-qnty
    13199           p-purch-VAT-base       = p-purch-VAT-base       + v-VAT-base       * v-parts-qnty
    13200           p-purch-VAT-rubl       = p-purch-VAT-rubl       + v-VAT-rubl       * v-parts-qnty
    13201           p-purch-SLT-base       = p-purch-SLT-base       + v-SLT-base       * v-parts-qnty
    13202           p-purch-SLT-rubl       = p-purch-SLT-rubl       + v-SLT-rubl       * v-parts-qnty
    13203           p-purch-road-tax-base  = p-purch-road-tax-base  + v-road-tax-base  * v-parts-qnty
    13204           p-purch-road-tax-rubl  = p-purch-road-tax-rubl  + v-road-tax-rubl  * v-parts-qnty
    13205           p-purch-excise-base    = p-purch-excise-base    + 0
    13206           p-purch-excise-rubl    = p-purch-excise-rubl    + 0
    13207           p-purch-transport-base = p-purch-transport-base + v-transport-base * v-parts-qnty
    13208           p-purch-transport-rubl = p-purch-transport-rubl + v-transport-rubl * v-parts-qnty
    13209           p-purch-other-base     = p-purch-other-base     + v-other-base     * v-parts-qnty
    13210           p-purch-other-rubl     = p-purch-other-rubl     + v-other-rubl     * v-parts-qnty
    13211           p-purch-discnt-base    = p-purch-discnt-base    + 0
    13212           p-purch-discnt-rubl    = p-purch-discnt-rubl    + 0
    13213         .
    13214       end.
    13215     end.
    13216   end procedure.
    13217   procedure holdprts-sale-values :
    13218     define input  parameter p-doc-code            like ub.doc-line.doc-code  no-undo .
