        1   block-level on error undo, throw.
        2   using ibs.th.str.alcohol.*.
        3   using ibs.th.gbl.storage.*.
        4   define input        parameter parparentproc as widget-handle no-undo.
        5   define input        parameter p-action      as character no-undo .
        6   define parameter    buffer    rsrv-gds-dtl  for ub.gds-dtl .
        7   define input-output parameter chg-qnty      as   decimal no-undo .
        8   define input-output parameter cost-base     as   decimal no-undo .
        9   define input-output parameter cost-rubl     as   decimal no-undo .
       10   define input        parameter p-b-code      as   integer no-undo .
       11   define input        parameter p-mark        as   character  no-undo .
       12   define variable vss-revision    as character no-undo initial "$Revision$":U .
       13   define variable vss-author      as character no-undo initial "$Author$":U .
       14   define variable vss-date        as character no-undo initial "$Date$":U .
       15   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       16   define variable vss-archive     as character no-undo initial "$Archive$":U .
       17   define variable vss-description as character no-undo initial "Процедура резервирования товара".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36       assign
       37         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8|&9',p-action,rsrv-gds-dtl.artic,rsrv-gds-dtl.prod-type,rsrv-gds-dtl.prod-code,rsrv-gds-dtl.prt-code,chg-qnty,cost-base,cost-rubl,p-b-code)
       38       .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82     define variable v-cntxt-db-num        as integer   no-undo .
       83     define variable v-cntxt-userid        as character no-undo .
       84     define variable v-cntxt-level         as character no-undo .
       85     define variable v-cntxt-host-code-obj as integer   no-undo .
       86     define variable v-cntxt-obj-type      as character no-undo .
       87     define variable v-cntxt-obj-code      as integer   no-undo .
       88     define variable v-cntxt-db-num-obj    as integer   no-undo .
       89     define variable v-cntxt-is-admin      as logical   no-undo .
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       93   define variable par-type          as character no-undo.
       94   define variable v-value-character as character no-undo .
       95   define variable v-value-date      as date      no-undo .
       96   define variable v-value-decimal   as decimal   no-undo .
       97   define variable v-value-integer   as integer   no-undo .
       98   define variable v-value-logical   as logical   no-undo .
       99   define new global shared variable g#lib-trn  as handle no-undo .
      100   define new global shared variable g#lib-trn2 as handle no-undo .
      101   define new global shared variable g#lib-trn3 as handle no-undo .
      102   define new global shared variable g#lib-trn4 as handle no-undo .
      103   define stream alc-rsrv .
      104   define stream tobacco-rsrv .
      105   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   procedure partrqst :
      107     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
      108     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
      109     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
      110     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
      111     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
      112     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
      113     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
      114     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
      115     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
      116     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
      117     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
      118     define output parameter p-total-parts-price-base     as decimal                 no-undo .
      119     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
      120     define output parameter p-total-parts-transport-base as decimal                 no-undo .
      121     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
      122     define output parameter p-total-parts-other-base     as decimal                 no-undo .
      123     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
      124     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
      125     do
      126     on error undo, return error return-value
      127     :
      128       assign
      129         p-total-parts-qnty           = 0
      130         p-total-parts-fact-qnty      = 0
      131         p-total-parts-cli-qnty       = 0
      132         p-total-parts-fact-cli-qnty  = 0
      133         p-total-parts-price-cli      = 0
      134         p-total-parts-price-base     = 0
      135         p-total-parts-price-rubl     = 0
      136         p-total-parts-transport-base = 0
      137         p-total-parts-transport-rubl = 0
      138         p-total-parts-other-base     = 0
      139         p-total-parts-other-rubl     = 0
      140       .
      141       define buffer buf_parts for ub.parts .
      142       for each buf_parts no-lock
      143         where buf_parts.out-code  = p-doc-code
      144           and buf_parts.obj-type  = p-obj-type
      145           and buf_parts.obj-code  = p-obj-code
      146           and buf_parts.artic     = p-artic
      147           and buf_parts.prod-type = p-prod-type
      148           and buf_parts.prod-code = p-prod-code
      149       on error undo, return error return-value
      150       :
      151         define variable v-parts-fact-multiplier as decimal   no-undo .
      152         assign
      153           v-parts-fact-multiplier = 1
      154         .
      155         if buf_parts.qnty <> 0 then do:
      156           assign
      157             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      158           .
      159         end.
      160         assign
      161           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      162           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      163           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      164           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      165                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      166           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      167           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      168           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      169           p-total-parts-transport-base  = p-total-parts-transport-base
      170                                         + buf_parts.fact-qnty
      171                                           * (if   buf_parts.transport-base <> ?
      172                                             then buf_parts.transport-base
      173                                             else 0
      174                                             )
      175           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      176                                         + buf_parts.fact-qnty
      177                                           * (if   buf_parts.transport-rubl <> ?
      178                                             then buf_parts.transport-rubl
      179                                             else 0
      180                                             )
      181           p-total-parts-other-base      = p-total-parts-other-base
      182                                         + buf_parts.fact-qnty
      183                                           * (if   buf_parts.other-base <> ?
      184                                             then buf_parts.other-base
      185                                             else 0
      186                                             )
      187           p-total-parts-other-rubl      = p-total-parts-other-rubl
      188                                         + buf_parts.fact-qnty
      189                                           * (if   buf_parts.other-rubl <> ?
      190                                             then buf_parts.other-rubl
      191                                             else 0
      192                                             )
      193         .
      194       end.
      195     end.
      196   end procedure.
      197   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      198   procedure rsrgdsck :
      199     define input  parameter p-doc-code               like ub.doc-line.doc-code  no-undo .
      200     define input  parameter p-doc-type               like ub.trn-doc.doc-type   no-undo .
      201     define input  parameter p-obj-type               like ub.doc-line.obj-type  no-undo .
      202     define input  parameter p-obj-code               like ub.doc-line.obj-code  no-undo .
      203     define input  parameter p-artic                  like ub.doc-line.artic     no-undo .
      204     define input  parameter p-prod-type              like ub.doc-line.prod-type no-undo .
      205     define input  parameter p-prod-code              like ub.doc-line.prod-code no-undo .
      206     define output parameter p-free-parts-qnty        like ub.parts.qnty         no-undo .
      207     define output parameter p-free-parts-fact-qnty   like ub.parts.fact-qnty    no-undo .
      208     define output parameter p-free-parts-cli-qnty    like ub.parts.cli-qnty     no-undo .
      209     define output parameter p-free-parts-price-base  as decimal                 no-undo .
      210     define output parameter p-free-parts-price-rubl  as decimal                 no-undo .
      211     define output parameter p-out-parts-qnty         like ub.parts.qnty         no-undo .
      212     define output parameter p-out-parts-fact-qnty    like ub.parts.fact-qnty    no-undo .
      213     define output parameter p-out-parts-cli-qnty     like ub.parts.cli-qnty     no-undo .
      214     define output parameter p-out-parts-price-base   as decimal                 no-undo .
      215     define output parameter p-out-parts-price-rubl   as decimal                 no-undo .
      216     define buffer buf_parts    for ub.parts.
      217     assign
      218       p-free-parts-qnty       = 0
      219       p-free-parts-fact-qnty  = 0
      220       p-free-parts-cli-qnty   = 0
      221       p-free-parts-price-base = 0
      222       p-free-parts-price-rubl = 0
      223       p-out-parts-qnty        = 0
      224       p-out-parts-fact-qnty   = 0
      225       p-out-parts-cli-qnty    = 0
      226       p-out-parts-price-base  = 0
      227       p-out-parts-price-rubl  = 0
      228     .
      229     for each buf_parts no-lock
      230       where buf_parts.out-code  = p-doc-code
      231         and buf_parts.obj-type  = p-obj-type
      232         and buf_parts.obj-code  = p-obj-code
      233         and buf_parts.artic     = p-artic
      234         and buf_parts.prod-type = p-prod-type
      235         and buf_parts.prod-code = p-prod-code
      236     on error undo, return error
      237     :
      238       if can-do('при,рас,спи':U, p-doc-type)
      239       or (p-doc-type = 'инв':U
      240           and buf_parts.fact-qnty < 0)
      241       then do:
      242         assign
      243           p-free-parts-qnty       = p-free-parts-qnty
      244                                   + abs(buf_parts.qnty)
      245           p-free-parts-fact-qnty  = p-free-parts-fact-qnty
      246                                   + abs(buf_parts.fact-qnty)
      247           p-free-parts-cli-qnty   = p-free-parts-cli-qnty
      248                                   + abs(buf_parts.cli-qnty)
      249           p-free-parts-price-base = p-free-parts-price-base
      250                                   + abs(buf_parts.fact-qnty) * buf_parts.price-base
      251           p-free-parts-price-rubl = p-free-parts-price-rubl
      252                                   + abs(buf_parts.fact-qnty) * buf_parts.price-rubl
      253         .
      254       end.
      255       else do:
      256         assign
      257           p-out-parts-qnty        = p-out-parts-qnty
      258                                   + buf_parts.qnty
      259           p-out-parts-fact-qnty   = p-out-parts-fact-qnty
      260                                   + buf_parts.fact-qnty
      261           p-out-parts-cli-qnty    = p-out-parts-cli-qnty
      262                                   + buf_parts.cli-qnty
      263           p-out-parts-price-base  = p-out-parts-price-base
      264                                   + buf_parts.fact-qnty * buf_parts.price-base
      265           p-out-parts-price-rubl  = p-out-parts-price-rubl
      266                                   + buf_parts.fact-qnty * buf_parts.price-rubl
      267         .
      268       end.
      269     end.
      270   end procedure.
      271   define variable vss-include-info5 as character format "x(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      272   procedure partscr :
      273     define input  parameter parparentproc      as widget-handle no-undo.
      274     define input  parameter p-db-num           as integer   no-undo .
      275     define input  parameter p-user-id          as character no-undo .
      276     define input  parameter p-supp-type        as character no-undo .
      277     define input  parameter p-supp-code        as integer   no-undo .
      278     define input  parameter p-part-code        as character no-undo .
      279     define input  parameter p-cst-code         as character no-undo .
      280     define input  parameter p-ps               as character no-undo .
      281     define input  parameter p-dop              as character no-undo .
      282     define input  parameter p-part-reserv-base as decimal   no-undo .
      283     define input  parameter p-part-reserv-rubl as decimal   no-undo .
      284     define input  parameter p-vat-type         as character no-undo .
      285     define input  parameter p-vat-pc           as decimal   no-undo .
      286     define input  parameter p-slt-type         as character no-undo .
      287     define input  parameter p-slt-pc           as decimal   no-undo .
      288     define input  parameter p-change-qnty      as decimal   no-undo .
      289     define input  parameter p-action           as character no-undo .
      290     define input  parameter p-cli-qnty         as decimal   no-undo .
      291     define input  parameter p-last-date        as date      no-undo .
      292     define input  parameter p-hold-date        as date      no-undo .
      293     define input  parameter p-pl-code          as integer   no-undo .
      294     define parameter buffer buf_doc-line       for ub.doc-line .
      295     define parameter buffer buf_parts          for ub.parts .
      296     define variable vss-description as character no-undo initial "$Workfile$ $Revision$ Процедура создания партии".
      297     define variable v-price-cli                like ub.doc-line.price-rubl no-undo.
      298     define variable v-price-cli-unit-base      like ub.doc-line.price-rubl no-undo.
      299     define variable v-price-road-tax           like ub.doc-line.price-rubl no-undo.
      300     define variable v-price-other-exp          like ub.doc-line.price-rubl no-undo.
      301     define variable v-price-transport-exp      like ub.doc-line.price-rubl no-undo.
      302     define variable v-price-without-abs        like ub.doc-line.price-rubl no-undo.
      303     define variable v-price-slt                like ub.doc-line.price-rubl no-undo.
      304     define variable v-price-no-slt             like ub.doc-line.price-rubl no-undo.
      305     define variable v-price-vat                like ub.doc-line.price-rubl no-undo.
      306     define variable v-price-no-vat-slt         like ub.doc-line.price-rubl no-undo.
      307     define variable v-price-rubl               like ub.doc-line.price-rubl no-undo.
      308     define variable v-price-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
      309     define variable v-price-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
      310     define variable v-price-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
      311     define variable v-price-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
      312     define variable v-price-slt-rubl           like ub.doc-line.price-rubl no-undo.
      313     define variable v-price-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
      314     define variable v-price-vat-rubl           like ub.doc-line.price-rubl no-undo.
      315     define variable v-price-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
      316     define variable v-price-base               like ub.doc-line.price-base no-undo.
      317     define variable v-price-road-tax-base      like ub.doc-line.price-base no-undo.
      318     define variable v-price-other-exp-base     like ub.doc-line.price-base no-undo.
      319     define variable v-price-transport-exp-base like ub.doc-line.price-base no-undo.
      320     define variable v-price-without-abs-base   like ub.doc-line.price-base no-undo.
      321     define variable v-price-slt-base           like ub.doc-line.price-base no-undo.
      322     define variable v-price-no-slt-base        like ub.doc-line.price-base no-undo.
      323     define variable v-price-vat-base           like ub.doc-line.price-base no-undo.
      324     define variable v-price-no-vat-slt-base    like ub.doc-line.price-base no-undo.
      325     define variable l-fact-qnty              as logical   no-undo .
      326     define variable v-action                 as character no-undo .
      327     define variable l-need-create-old-return as logical   no-undo init false .
      328     define variable l-create-old-return      as logical   no-undo init false .
      329     define variable v-izlcstpr        as character no-undo .
      330     define variable l-goods-serial           as logical   no-undo .
      331     define variable l-goods-twounit          as logical   no-undo .
      332     define variable l-reserv-pl-code         as logical   no-undo .
      333     define variable l-goods-bottle           as logical   no-undo .
      334     define buffer buf_trn-doc  for ub.trn-doc .
      335     define buffer buf_goods    for ub.goods .
      336     define variable v-prompt-price       as character no-undo .
      337     define variable v-check-right        as logical   no-undo .
      338     define variable v-ind                as integer   no-undo .
      339     define variable v-num-entries-action as integer   no-undo .
      340     define variable v-option             as character no-undo .
      341     define variable v-type as character no-undo .
      342     do
      343     on error undo, return error return-value
      344     :
      345       assign
      346         v-check-right = true
      347       .
      348       if not available buf_doc-line
      349       then do:
      350         message
      351           vss-workfile vss-revision vss-description skip
      352           "Ошибка задания входных параметров" skip
      353           "Не задана строка документа" skip
      354           view-as alert-box error .
      355         undo, return error return-value .
      356       end.
      357       if p-supp-type = ?
      358       or p-supp-type = ''
      359       then do:
      360         message
      361           vss-workfile vss-revision vss-description skip
      362           "Ошибка задания входных параметров" skip
      363           "Параметр p-supp-type имеет неопределенное значение" skip
      364           "Документ" buf_doc-line.doc-code skip
      365           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      366           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      367           view-as alert-box error .
      368         undo, return error return-value .
      369       end.
      370       if p-supp-code = ?
      371       or p-supp-code = 0
      372       then do:
      373         message
      374           vss-workfile vss-revision vss-description skip
      375           "Ошибка задания входных параметров" skip
      376           "Параметр p-supp-code имеет неопределенное значение" skip
      377           "Документ" buf_doc-line.doc-code skip
      378           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      379           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      380           view-as alert-box error .
      381         undo, return error return-value .
      382       end.
      383       if p-part-code = ?
      384       then do:
      385         message
      386           vss-workfile vss-revision vss-description skip
      387           "Ошибка задания входных параметров" skip
      388           "Параметр p-part-code имеет неопределенное значение" skip
      389           "Документ" buf_doc-line.doc-code skip
      390           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      391           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      392           view-as alert-box error .
      393         undo, return error return-value .
      394       end.
      395       if p-cst-code = ?
      396       then do:
      397         message
      398           vss-workfile vss-revision vss-description skip
      399           "Ошибка задания входных параметров" skip
      400           "Параметр p-cst-code имеет неопределенное значение" skip
      401           "Документ" buf_doc-line.doc-code skip
      402           "Объект" buf_doc-line.obj-type buf_doc-line.obj-code skip
      403           "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      404           view-as alert-box error .
      405         undo, return error return-value .
      406       end.
