     8553   procedure rsrv-negative :
     8554     define input parameter  parparentproc         AS WIDGET-HANDLE NO-UNDO.
     8555     define input  parameter p-db-num               as integer   no-undo .
     8556     define input  parameter p-user-id              as character no-undo .
     8557     define parameter buffer buf_doc-line           for ub.doc-line .
     8558     define parameter buffer buf_trn-doc            for ub.trn-doc  .
     8559     define input parameter  p-chg-qnty             as decimal   no-undo .
     8560     define input parameter  p-reserv-base          as decimal   no-undo .
     8561     define input parameter  p-reserv-rubl          as decimal   no-undo .
     8562     define input parameter  p-partscr-prompt-price as character no-undo .
     8563     define output parameter p-real-rsrv-qnty       as decimal   no-undo .
     8564     define buffer buf_parts for ub.parts .
     8565     define buffer buf_goods for ub.goods .
     8566     define variable v-vat-type  as character no-undo .
     8567     define variable v-vat-pc    as decimal   no-undo .
     8568     define variable v-slt-type  as character no-undo .
     8569     define variable v-slt-pc    as decimal   no-undo .
     8570     define variable v-is-hold-doc as logical no-undo .
     8571     do
     8572     on error undo, return error return-value
     8573     :
     8574       find first buf_goods no-lock where buf_goods.artic      = buf_doc-line.artic
     8575                                      and buf_goods.prod-type  = buf_doc-line.prod-type
     8576                                      and buf_goods.prod-code  = buf_doc-line.prod-code
     8577                                      .
     8578       if is-gas(buf_goods.gds-code) then return .
     8579       run partscr_get-default-values in this-procedure
     8580         (buffer buf_doc-line
     8581         ,output v-vat-type
     8582         ,output v-vat-pc
     8583         ,output v-slt-type
     8584         ,output v-slt-pc
     8585         ) .
     8586       if lookup('izlcstpr=enable':u, p-partscr-prompt-price) > 0 and p-action <> 'reserv-create':U
     8587       and buf_trn-doc.ext-doc-type = 'vt':U
     8588       then do :
     8589           v-vat-pc = 0 .
     8590           v-vat-type = 'без':U .
     8591       end.
     8592       run partscr in this-procedure
     8593         (input  parparentproc
     8594         ,input  p-db-num
     8595         ,input  p-user-id
     8596         ,input
     8597           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
     8598         ,input
     8599           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
     8600         ,input  '':U
     8601         ,input  '':U
     8602         ,input  '':U
     8603         ,input  '':U
     8604         ,input  p-reserv-base
     8605         ,input  p-reserv-rubl
     8606         ,input  v-vat-type
     8607         ,input  v-vat-pc
     8608         ,input  v-slt-type
     8609         ,input  v-slt-pc
     8610         ,input  p-chg-qnty
     8611         ,input  p-partscr-prompt-price
     8612         ,input  0
     8613         ,input  ?
     8614         ,input  ?
     8615         ,input  0
     8616         ,buffer buf_doc-line
     8617         ,buffer buf_parts
     8618         ) no-error .
     8619       if error-status :error
     8620       then do:
     8621         if error-status :get-message(1) <> '':U
     8622         then do:
     8623           message
     8624             vss-workfile vss-revision vss-description skip
     8625             "Ошибка при создании партии" skip
     8626             "Документ" buf_doc-line.doc-code skip
     8627             "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     8628             error-status :get-message(1) skip
     8629             return-value skip
     8630             view-as alert-box error .
     8631         end.
     8632         undo, return error return-value .
     8633       end.
     8634       if not available buf_parts
     8635       and return-value <> '':U
     8636       then do:
     8637         return return-value .
     8638       end.
     8639   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     8641     (input  buf_trn-doc.doc-code
     8642     ,output v-is-hold-doc
     8643     )  .
     8644       if v-is-hold-doc
     8645       and buf_trn-doc.ext-doc-type = 'ee':U
     8646       then do:
     8647         assign
     8648           buf_parts.contract-code = 0
     8649         .
     8650       end.
     8651       assign
     8652         p-real-rsrv-qnty = p-chg-qnty
     8653       .
     8654     end.
     8655   end procedure.
     8656   procedure unrsrv-negative :
     8657     define parameter buffer buf_doc-line for ub.doc-line .
     8658     define input  parameter p-chg-qnty      as decimal no-undo .
     8659     define output parameter p-real-chg-qnty as decimal no-undo .
     8660     define variable v-part-chg-qnty as decimal no-undo .
     8661     define buffer buf_parts for ub.parts .
     8662     do
     8663     on error undo, return error return-value
     8664     :
     8665       for each buf_parts
     8666         where buf_parts.in-code   = buf_doc-line.doc-code
     8667           and buf_parts.out-code  = buf_doc-line.doc-code
     8668           and buf_parts.obj-code  = buf_doc-line.obj-code
     8669           and buf_parts.obj-type  = buf_doc-line.obj-type
     8670           and buf_parts.artic     = buf_doc-line.artic
     8671           and buf_parts.prod-type = buf_doc-line.prod-type
     8672           and buf_parts.prod-code = buf_doc-line.prod-code
     8673       on error undo, return error return-value
     8674       :
     8675         assign
     8676           v-part-chg-qnty = 0
     8677         .
     8678         if buf_parts.fact-qnty > 0
     8679         and p-chg-qnty < 0
     8680         then do:
     8681           assign
     8682             v-part-chg-qnty = - min(abs(buf_parts.qnty), abs(p-chg-qnty))
     8683           .
     8684         end.
     8685         if buf_parts.fact-qnty < 0
     8686         and p-chg-qnty > 0
     8687         then do:
     8688           assign
     8689             v-part-chg-qnty = min(abs(buf_parts.qnty), abs(p-chg-qnty))
     8690           .
     8691         end.
     8692         if v-part-chg-qnty = 0
     8693         then do:
     8694           next .
     8695         end.
     8696         if p-chg-qnty = 0
     8697         then do:
     8698           return .
     8699         end.
     8700         assign
     8701           p-chg-qnty          = p-chg-qnty          - v-part-chg-qnty
     8702           p-real-chg-qnty     = p-real-chg-qnty     + v-part-chg-qnty
     8703           buf_parts.qnty      = buf_parts.qnty      + v-part-chg-qnty
     8704           buf_parts.fact-qnty = buf_parts.fact-qnty + v-part-chg-qnty
     8705         .
     8706       end.
     8707     end.
     8708   end procedure.
     8709   PROCEDURE ProcAlcCode :
     8710     define input  parameter p-mark-alc as character  no-undo .
     8711     define output parameter p-alc-code as character  no-undo initial ''.
     8712     define variable v-kol              as integer    no-undo .
     8713     define variable alc-code as character no-undo .
     8714     define variable v-result as character no-undo .
     8715     define variable ii as integer no-undo .
     8716     if length(p-mark-alc) = 150 then
     8717     do:
     8718       p-alc-code = "new-mark" .
     8719       return .
     8720     end.
     8721     else
     8722     do:
     8723       alc-code = SUBSTRing (p-mark-alc, 8, 12) .
     8724     end.
     8725     p-alc-code = string (Base2Int64 (alc-code, 36) ) no-error.
     8726     if (Base2Int64 (alc-code, 36) ) < 0 then
     8727     do:
     8728       p-alc-code = ?.
     8729     end.
     8730     else
     8731     do:
     8732       if length(p-alc-code) < 20 then
     8733       do:
     8734         p-alc-code = fill('0', 19 - length(p-alc-code)) + p-alc-code.
     8735       end.
     8736     end.
     8737   END PROCEDURE.
     8738   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8739   procedure rsrvincr :
     8740     define input  parameter parparentproc          AS WIDGET-HANDLE          NO-UNDO.
     8741     define input  parameter p-db-num               as integer   no-undo .
     8742     define input  parameter p-user-id              as character no-undo .
     8743     define input  parameter p-trn-doc-recid        as recid                   no-undo .
     8744     define input  parameter p-doc-line-recid       as recid                   no-undo .
     8745     define input  parameter p-reserv-base          as decimal                 no-undo .
     8746     define input  parameter p-reserv-rubl          as decimal                 no-undo .
     8747     define input  parameter p-partscr-prompt-price as character               no-undo .
     8748     define input  parameter p-extended-doc-type    as character               no-undo .
     8749     define input  parameter p-reserv-single-part   as logical                 no-undo .
     8750     define input  parameter p-in-code              like ub.parts.in-code      no-undo .
     8751     define input  parameter p-part-code            like ub.parts.part-code    no-undo .
     8752     define input  parameter p-reserv-pl-code       as logical                 no-undo .
     8753     define input  parameter p-pl-code              as character               no-undo .
     8754     define input  parameter p-goods-serial         as logical                 no-undo .
     8755     define input  parameter p-goods-twounit        as logical                 no-undo .
     8756     define output parameter p-abs-rsrv-qnty        as decimal                 no-undo .
     8757     define variable vss-description as character no-undo init "rsrvincr: Процедура компенсации отрицательных партий".
     8758     define buffer buf_trn-doc    for ub.trn-doc .
     8759     do
     8760     on error undo, return error
     8761     :
     8762       find first buf_trn-doc no-lock
     8763         where recid(buf_trn-doc) = p-trn-doc-recid
     8764         no-error .
     8765       if not available buf_trn-doc
     8766       then do:
     8767         message
     8768           vss-workfile vss-revision vss-description skip
     8769           "Ошибка задания входных параметров" skip
     8770           "Не найден документ" skip
     8771           "Указатель" p-trn-doc-recid skip
     8772           view-as alert-box error .
     8773         undo, return error .
     8774       end.
     8775       assign
     8776         p-abs-rsrv-qnty = 0
     8777       .
     8778       if p-reserv-pl-code = true
     8779       then do:
     8780         return .
     8781       end.
     8782       if p-goods-twounit = true
     8783       then do:
     8784         return .
     8785       end.
     8786       define variable v-total-rsrv-qnty as decimal no-undo .
     8787       assign
     8788         v-total-rsrv-qnty = 0
     8789       .
     8790       define variable v-neg-beg-date as date no-undo .
     8791       define variable v-neg-end-date as date no-undo .
     8792       assign
     8793         v-neg-beg-date = ?
     8794         v-neg-end-date = ?
     8795       .
     8796       define variable v-parameter-beg-name as character no-undo .
     8797       define variable v-parameter-end-name as character no-undo .
     8798   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8799   empty temp-table thbjattr_thbj-attr.
     8800   run adm/shattri.p (
     8801      input "get":U
     8802     ,input buf_trn-doc.obj-type
     8803     ,input buf_trn-doc.obj-code
     8804     ,input 'rezerv-obj':U
     8805     ,input  ""
     8806     ,output v-value-character
     8807     ,output v-value-date
     8808     ,output v-value-decimal
     8809     ,output v-value-integer
     8810     ,output v-value-logical
     8811     ,output par-type
     8812     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     8813     ) no-error .
     8814       for each thbjattr_thbj-attr :
     8815           if thbjattr_thbj-attr.prop-code = 'invngbeg'  then v-neg-beg-date = thbjattr_thbj-attr.property-value-date.
     8816           if thbjattr_thbj-attr.prop-code = 'invngend'  then v-neg-end-date = thbjattr_thbj-attr.property-value-date.
     8817       end.
     8818       empty temp-table thbjattr_thbj-attr.
     8819       assign
     8820         v-parameter-beg-name = "invngbeg"
     8821         v-parameter-end-name = "invngend"
     8822       .
     8823       if (v-neg-beg-date = ? ) <> (v-neg-end-date = ?)
     8824       then do:
     8825         message
     8826           vss-workfile vss-revision vss-description skip
     8827           "Противоречивое задание параметров ограничения по резервированию порожденных партий" skip
     8828           "Параметры" v-parameter-beg-name v-parameter-end-name skip
     8829           "должны быть или одновременно заданы" skip
     8830           "или одновременно не заданы" skip
     8831           view-as alert-box error .
     8832         undo, return error .
     8833       end.
     8834       if  v-neg-beg-date <> ?
     8835       and v-neg-end-date <> ?
     8836       and v-neg-beg-date > v-neg-end-date
     8837       then do:
     8838         message
     8839           vss-workfile vss-revision vss-description skip
     8840           "Противоречивое задание параметров ограничения по резервированию порожденных партий" skip
     8841           "Первый день интервала резервирования(" v-parameter-beg-name ")" v-neg-beg-date skip
     8842           "Последний день интервала резервирования(" v-parameter-end-name ")" v-neg-end-date skip
     8843           "Дата" v-parameter-beg-name "должна быть меьшне равна даты" v-parameter-end-name skip
     8844           view-as alert-box error .
     8845         undo, return error .
     8846       end.
     8847       run rsrv-inv-create-supp in this-procedure
     8848         (input        p-trn-doc-recid
     8849         ,input        p-doc-line-recid
     8850         ,input        p-goods-serial
     8851         ,input        p-goods-twounit
     8852         ,input        'out-zone':U
     8853         ,input        v-neg-beg-date
     8854         ,input        v-neg-end-date
     8855         ,input-output v-total-rsrv-qnty
     8856         ,input-output p-abs-rsrv-qnty
     8857         ) no-error .
     8858       if error-status :error
     8859       then do:
     8860         message
     8861           vss-workfile vss-revision vss-description skip
     8862           "Ошибка при вызове процедуры резервирования отрицательных партий расходной зоны" skip
     8863           error-status :get-message(1) skip
     8864           return-value skip
     8865           view-as alert-box error .
     8866         undo, return error .
     8867       end.
     8868       run rsrv-inv-create-supp in this-procedure
     8869         (input        p-trn-doc-recid
     8870         ,input        p-doc-line-recid
     8871         ,input        p-goods-serial
     8872         ,input        p-goods-twounit
     8873         ,input        'free-zone':U
     8874         ,input        v-neg-beg-date
     8875         ,input        v-neg-end-date
     8876         ,input-output v-total-rsrv-qnty
     8877         ,input-output p-abs-rsrv-qnty
     8878         ) no-error .
     8879       if error-status :error
     8880       then do:
     8881         message
     8882           vss-workfile vss-revision vss-description skip
     8883           "Ошибка при вызове процедуры резервирования отрицательных партий свободной зоны" skip
     8884           error-status :get-message(1) skip
     8885           return-value skip
     8886           view-as alert-box error .
     8887         undo, return error .
     8888       end.
     8889       if v-total-rsrv-qnty <> 0
     8890       then do:
     8891         define variable v-real-chg-qnty as decimal   no-undo .
     8892         run rsrv-doc in this-procedure
     8893           (input  parparentproc
     8894           ,input  p-db-num
     8895           ,input  p-user-id
     8896           ,input  p-trn-doc-recid
     8897           ,input  p-doc-line-recid
     8898           ,input  p-reserv-base
     8899           ,input  p-reserv-rubl
     8900           ,input  p-partscr-prompt-price
     8901           ,input  p-extended-doc-type
     8902           ,input  p-reserv-single-part
     8903           ,input  p-in-code
     8904           ,input  p-part-code
     8905           ,input  p-reserv-pl-code
     8906           ,input  p-pl-code
     8907           ,input  p-goods-serial
     8908           ,input  p-goods-twounit
     8909           ,input  '':u
     8910           ,input  - v-total-rsrv-qnty
     8911           ,input  false
     8912           ,output v-real-chg-qnty
     8913           ) no-error .
     8914         if error-status :error
     8915         or v-real-chg-qnty <> - v-total-rsrv-qnty
     8916         then do:
     8917           undo, return error .
     8918         end.
     8919         assign
     8920           p-abs-rsrv-qnty = p-abs-rsrv-qnty + abs(v-real-chg-qnty)
     8921         .
     8922       end.
     8923       assign
     8924         p-abs-rsrv-qnty = p-abs-rsrv-qnty / 2
     8925       .
     8926     end.
     8927   end procedure.
     8928   procedure rsrv-inv-create-supp :
     8929     define input        parameter p-trn-doc-recid   as recid     no-undo .
     8930     define input        parameter p-doc-line-recid  as recid     no-undo .
     8931     define input        parameter p-goods-serial    as logical   no-undo .
     8932     define input        parameter p-goods-twounit   as logical   no-undo .
     8933     define input        parameter p-negative-code   as character no-undo .
     8934     define input        parameter p-neg-beg-date    as date      no-undo .
     8935     define input        parameter p-neg-end-date    as date      no-undo .
     8936     define input-output parameter p-total-rsrv-qnty as decimal   no-undo .
     8937     define input-output parameter p-abs-rsrv-qnty   as decimal   no-undo .
     8938     define variable vss-description as character no-undo init "rsrv-inv-create-supp: компенсация партий свободной/расходной зоны".
     8939     define buffer buf_trn-doc    for ub.trn-doc .
     8940     define buffer buf_doc-line   for ub.doc-line .
     8941     define buffer negative_parts for ub.parts .
     8942     define buffer buf_parts      for ub.parts .
     8943     define variable v-rsrv-qnty       as decimal   no-undo .
     8944     define variable v-real-rsrv-qnty  as decimal   no-undo .
     8945     define variable v-parts-recid     as decimal   no-undo .
     8946     do
     8947     on error undo, return error
     8948     :
     8949       find first buf_trn-doc no-lock
     8950         where recid(buf_trn-doc) = p-trn-doc-recid
     8951         no-error .
     8952       if not available buf_trn-doc
     8953       then do:
     8954         message
     8955           vss-workfile vss-revision vss-description skip
     8956           "Ошибка задания входных параметров" skip
     8957           "Не найден документ" skip
     8958           "Указатель" p-trn-doc-recid skip
     8959           view-as alert-box error .
     8960         undo, return error .
     8961       end.
     8962       find first buf_doc-line no-lock
     8963         where recid(buf_doc-line) = p-doc-line-recid
     8964         no-error .
     8965       if not available buf_doc-line
     8966       then do:
     8967         message
     8968           vss-workfile vss-revision vss-description skip
     8969           "Ошибка задания входных параметров" skip
     8970           "Не найдена строка документа" skip
     8971           "Указатель" p-doc-line-recid skip
     8972           view-as alert-box error .
     8973         undo, return error .
     8974       end.
     8975       for each negative_parts
     8976         where negative_parts.obj-type  = buf_doc-line.obj-type
     8977           and negative_parts.obj-code  = buf_doc-line.obj-code
     8978           and negative_parts.artic     = buf_doc-line.artic
     8979           and negative_parts.prod-type = buf_doc-line.prod-type
     8980           and negative_parts.prod-code = buf_doc-line.prod-code
     8981           and negative_parts.out-code  = p-negative-code
     8982           and negative_parts.qnty      < 0
     8983       on error undo, return error
     8984       :
     8985         if p-neg-beg-date <> ?
     8986         then do:
     8987           if negative_parts.fact-date < p-neg-beg-date
     8988           or negative_parts.fact-date > p-neg-end-date
     8989           then do:
     8990             next .
     8991           end.
     8992         end.
     8993         find buf_parts exclusive-lock
     8994           where buf_parts.obj-type  = negative_parts.obj-type
     8995             and buf_parts.obj-code  = negative_parts.obj-code
     8996             and buf_parts.artic     = negative_parts.artic
     8997             and buf_parts.prod-type = negative_parts.prod-type
     8998             and buf_parts.prod-code = negative_parts.prod-code
     8999             and buf_parts.in-code   = negative_parts.in-code
     9000             and buf_parts.out-code  = buf_doc-line.doc-code
     9001             and buf_parts.part-code = negative_parts.part-code
     9002           no-error.
     9003         define variable v-already-rsrv-qnty as decimal no-undo .
     9004         assign
     9005           v-already-rsrv-qnty = 0
     9006         .
     9007         if available buf_parts
     9008         then do:
     9009           assign
     9010             v-already-rsrv-qnty = buf_parts.qnty
     9011           .
     9012         end.
     9013         assign
     9014           v-rsrv-qnty = negative_parts.qnty
     9015                       * ( if p-negative-code = 'free-zone':U
     9016                           then -1
     9017                           else 1
     9018                         )
     9019                       - v-already-rsrv-qnty
     9020         .
     9021         define variable v-real-chg-qnty as decimal   no-undo .
     9022         run partrsrv in this-procedure
     9023           (input  v-rsrv-qnty
     9024           ,input  p-goods-serial
     9025           ,input  p-goods-twounit
     9026           ,input  false
     9027           ,buffer negative_parts
     9028           ,buffer buf_trn-doc
     9029           ,output v-real-chg-qnty
     9030           ,output v-parts-recid
     9031           ) no-error .
     9032         if error-status :error
     9033         then do:
     9034           message
     9035             vss-workfile vss-revision vss-description skip
     9036             "Ошибка при вызове partrsrv" skip
     9037             error-status :get-message(1) skip
     9038             return-value skip
     9039             view-as alert-box error .
     9040           return return-value .
     9041         end.
     9042         assign
     9043           p-total-rsrv-qnty = p-total-rsrv-qnty + v-real-chg-qnty
     9044           p-abs-rsrv-qnty   = p-abs-rsrv-qnty   + abs(v-real-chg-qnty)
     9045         .
     9046       end.
     9047     end.
     9048   end procedure.
     9049   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9050   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9051   define new global shared variable g#trdcalib as handle no-undo.
     9052   function stsMarkWhenDeleteGoods returns integer
     9053       (input iDocCode as character,
     9054        input iMark as character):
     9055     define variable vValue as character no-undo.
     9056     define variable vType as character no-undo.
     9057     define buffer buf_trn-doc for ub.trn-doc.
     9058     define buffer buf_c-marking for ub.c-marking.
     9059     if iDocCode <> ? then
     9060     do:
     9061         find first buf_trn-doc no-lock where
     9062                    buf_trn-doc.doc-code = iDocCode no-error.
     9063         if avail buf_trn-doc then
     9064         do:
     9065   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     9066                           input 'is-return':U ,
     9067                          output vValue ,
     9068                          output vType ) no-error .
     9069            if buf_trn-doc.ext-doc-type = 'we':U or
     9070               buf_trn-doc.ext-doc-type = 'ev':U or
     9071               vValue = "yes" then
     9072            do:
     9073              find last buf_c-marking no-lock where
     9074                        buf_c-marking.mark = iMark
     9075                   use-index pi-2 no-error.
     9076              if avail buf_c-marking and
     9077                      (buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:ReturnLock:KeyIntDB or
     9078                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB or
     9079                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:SaleLock:KeyIntDB or
     9080                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:Moved:KeyIntDB or
     9081                       buf_c-marking.sts = objSrv:Env:Marking:Sts:Mark:OutOfInventory:KeyIntDB) then
     9082                return buf_c-marking.sts .
     9083            end.
     9084         end.
     9085     end.
     9086     return objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
     9087   end function.
     9088   procedure partrsrv :
     9089     define input parameter  p-chg-qnty      as decimal   no-undo .
     9090     define input parameter  p-goods-serial  as logical   no-undo .
     9091     define input parameter  p-goods-twounit as logical   no-undo .
     9092     define input parameter  p-unreserv-only as logical   no-undo .
     9093     define parameter buffer buf_orig_parts  for ub.parts .
     9094     define parameter buffer buf_trn-doc     for ub.trn-doc .
     9095     define output parameter p-real-chg-qnty as decimal   no-undo .
     9096     define output parameter p-parts-recid   as recid     no-undo .
     9097     define input  parameter p-mark          as character  no-undo .
     9098     define variable vss-description as character no-undo init "$Workfile$ Резервирование и снятие резервов по одной партии".
     9099     define buffer buf_parts  for ub.parts .
     9100     define buffer rsrv-parts for ub.parts .
     9101     define buffer unrsrv-parts for ub.parts .
     9102     define buffer buf_parts-attr for ub.parts-attr .
     9103     define buffer free_marking-lines for ub.marking-lines .
     9104     define variable lok                as logical   no-undo .
     9105     define variable v-sign-chg-qnty    as integer   no-undo .
     9106     define variable v-sign-rsrv-qnty   as integer   no-undo .
     9107     define variable v-rsrv-qnty        as decimal   no-undo .
     9108     define variable v-orig-unrsrv-code as character no-undo .
     9109     define variable v-new-rsrv-code    as character no-undo .
     9110     define variable v-new-unrsrv-code  as character no-undo .
     9111     define variable v-unrsrv-qnty      as decimal   no-undo .
     9112     define variable v-value-character as character no-undo .
     9113     define variable v-value-date      as date no-undo .
     9114     define variable v-value-decimal   as decimal no-undo .
     9115     define variable v-value-integer   as integer no-undo .
     9116     define variable v-izlcstpr        as logical no-undo .
     9117     define variable v-tth             as handle no-undo .
     9118     define variable v-type            as character no-undo .
     9119     define variable part-key-rec      as character no-undo .
     9120     define variable v-part-code-int   as integer no-undo .
     9121     define variable v-old-part-code   as character no-undo .
     9122     define variable v-part-gds-code   as integer   no-undo .
     9123     do transaction
     9124     on error undo, return error
     9125     :
     9126       if buf_trn-doc.ext-doc-type = 'vt':U
     9127       then do :
     9128           delete object v-tth no-error.
     9129           run adm/shattri.p (
     9130              input "get":U
     9131             ,input buf_orig_parts.obj-type
     9132             ,input buf_orig_parts.obj-code
     9133             ,input 'inv-obj':U
     9134             ,input  "izlcstpr"
     9135             ,output v-value-character
     9136             ,output v-value-date
     9137             ,output v-value-decimal
     9138             ,output v-value-integer
     9139             ,output v-izlcstpr
     9140             ,output v-type
     9141             ,INPUT-OUTPUT table-handle v-tth
     9142             ) no-error .
     9143             delete object v-tth no-error.
     9144           if error-status:error then do:
     9145             v-izlcstpr = false .
     9146           end.
     9147       end.
     9148       else do :
     9149           v-izlcstpr = false .
     9150       end.
     9151       assign
     9152         p-parts-recid = ?
     9153       .
     9154       if p-chg-qnty = 0 then do:
     9155         assign
     9156           p-parts-recid = recid(buf_orig_parts)
     9157         .
     9158         return .
     9159       end.
     9160       assign
     9161         v-sign-chg-qnty = 0
     9162       .
     9163       if p-chg-qnty < 0 then do:
     9164         assign
     9165           v-sign-chg-qnty = -1
     9166         .
     9167       end.
     9168       if p-chg-qnty > 0 then do:
     9169         assign
