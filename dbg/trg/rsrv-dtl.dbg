     6502   procedure rsrv-doc :
     6503     define input  parameter parparentproc          AS WIDGET-HANDLE           NO-UNDO.
     6504     define input  parameter p-db-num               as integer   no-undo .
     6505     define input  parameter p-user-id              as character no-undo .
     6506     define input  parameter p-trn-doc-recid        as recid     no-undo .
     6507     define input  parameter p-doc-line-recid       as recid     no-undo .
     6508     define input  parameter p-reserv-base          as decimal   no-undo .
     6509     define input  parameter p-reserv-rubl          as decimal   no-undo .
     6510     define input  parameter p-partscr-prompt-price as character no-undo .
     6511     define input  parameter p-extended-doc-type    as character no-undo .
     6512     define input  parameter p-reserv-single-part   as logical   no-undo .
     6513     define input  parameter p-in-code              as character no-undo .
     6514     define input  parameter p-part-code            as character no-undo .
     6515     define input  parameter p-reserv-pl-code       as logical   no-undo .
     6516     define input  parameter p-pl-code              as character no-undo .
     6517     define input  parameter p-goods-serial         as logical   no-undo .
     6518     define input  parameter p-goods-twounit        as logical   no-undo .
     6519     define input  parameter p-purch-code-list      as character no-undo .
     6520     define input  parameter p-chg-qnty             as decimal   no-undo .
     6521     define input  parameter p-unreserv-other-sign  as logical   no-undo .
     6522     define output parameter p-real-chg-qnty        as decimal   no-undo .
     6523     define variable vss-description as character no-undo init "rsrv-doc: Процедура резервирования партий".
     6524     define variable v-chg-qnty-sign   as integer         no-undo .
     6525     define variable v-rsrv-code       as character       no-undo .
     6526     define variable v-reason          as character       no-undo .
     6527     define variable v-process-part    as logical         no-undo .
     6528     define variable v-real-chg-qnty   like ub.parts.qnty no-undo .
     6529     define variable v-parts-recid     as recid           no-undo .
     6530     define variable v-check-part-qnty as decimal         no-undo .
     6531     define buffer buf_parts    for ub.parts .
     6532     define buffer buf2_parts   for ub.parts .
     6533     define buffer buf_trn-doc  for ub.trn-doc .
     6534     define buffer buf_doc-line for ub.doc-line .
     6535     define buffer buf1_doc-line-attr for ub.doc-line-attr .
     6536     define buffer buf1_goods    for ub.goods .
     6537     define buffer buf_goods    for ub.goods .
     6538     define buffer buf_gen-attr for ub.gen-attr .
     6539     define buffer buf2_gen-attr for ub.gen-attr .
     6540     define variable v-part-key        as character no-undo .
     6541     define variable v-value-character as character no-undo .
     6542     define variable v-value-date      as date no-undo .
     6543     define variable v-value-decimal   as decimal no-undo .
     6544     define variable v-value-integer   as integer no-undo .
     6545     define variable v-izlcstpr        as logical no-undo .
     6546     define variable v-mark-alchol     as logical no-undo .
     6547     define variable v-tth             as handle no-undo .
     6548     define variable v-type            as character no-undo .
     6549     define variable v-attr-value      as character no-undo .
     6550     define variable vCodeIdent        as character no-undo .
     6551     define variable v-mark as character no-undo .
     6552     define variable v-mark-list as character no-undo .
     6553     define variable v-alc-code as character no-undo .
     6554     define variable mark-ii as integer  no-undo .
     6555     define variable jj as integer  no-undo .
     6556     define variable v-alc-qnty as decimal no-undo .
     6557     define variable v-tobacco-mark      as character  no-undo .
     6558     define variable v-tobacco-mark-list as character  no-undo .
     6559     define variable v-mark-tobacco      as logical    no-undo .
     6560     define variable v-box-qnty          as integer    no-undo .
     6561     define variable v-GTIN              as character  no-undo .
     6562     define variable v-GTIN-qnty         as integer    no-undo .
     6563      define buffer buf_marking         for ub.marking .
     6564     define buffer buf_marking-childs  for ub.marking .
     6565     define buffer buf_marking-lines   for ub.marking-lines .
     6566     define buffer buf_marking-chk     for ub.marking-chk .
     6567     define variable v-copy-doc-code     as character  no-undo .
     6568     define buffer buf_copy-trn-doc    for ub.trn-doc .
     6569     define buffer buf_utd-lines       for ub.utd-lines .
     6570     define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     6571     define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6572     define variable varb-code like ub.bar-code.b-code .
     6573     define variable vardoc-num     like ub.price-list.doc-num    no-undo .
     6574     define variable varprice-sale  like ub.price-list.price-sale no-undo .
     6575     define variable varroad-tax    like ub.price-list.road-tax   no-undo .
     6576     define variable varexcise      like ub.price-list.excise     no-undo .
     6577     define variable varcur-vat-pc  like ub.price-list.vat-pc     no-undo .
     6578     define variable varcur-slt-pc  like ub.price-list.slt-pc     no-undo .
     6579     define variable varprice-rubl  as decimal no-undo .
     6580     define variable varprice-base  as decimal no-undo .
     6581     define variable vIsExemplarGoods as logical no-undo init false.
     6582     define variable v-isweighed as logical no-undo init false.
     6583     define variable varvalue as character no-undo .
     6584     define variable vartype  as character no-undo .
     6585     define variable v-mark-weight as decimal   no-undo .
     6586     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     6587     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     6588     do
     6589     on error undo, return error return-value
     6590     :
     6591       find first buf_trn-doc no-lock
     6592         where recid(buf_trn-doc) = p-trn-doc-recid
     6593         no-error .
     6594       if not available buf_trn-doc
     6595       then do:
     6596         message
     6597           vss-workfile vss-revision vss-description skip
     6598           "Ошибка задания входных параметров" skip
     6599           "Не найден документ" skip
     6600           "Указатель" p-trn-doc-recid skip
     6601           view-as alert-box error .
     6602         undo, return error return-value .
     6603       end.
     6604       find first buf_doc-line no-lock
     6605         where recid(buf_doc-line) = p-doc-line-recid
     6606         no-error .
     6607       if not available buf_doc-line
     6608       then do:
     6609         message
     6610           vss-workfile vss-revision vss-description skip
     6611           "Ошибка задания входных параметров" skip
     6612           "Не найдена строка документа" skip
     6613           "Указатель" p-doc-line-recid skip
     6614           view-as alert-box error .
     6615         undo, return error return-value .
     6616       end.
     6617       find first buf_goods no-lock where
     6618                  buf_goods.artic     = buf_doc-line.artic
     6619              and buf_goods.prod-type = buf_doc-line.prod-type
     6620              and buf_goods.prod-code = buf_doc-line.prod-code
     6621            no-error.
     6622       if avail buf_goods then
     6623       do:
     6624         run isExemplarGoods in this-procedure
     6625             (buf_trn-doc.obj-type, buf_trn-doc.obj-code, buf_goods.gds-code, output vIsExemplarGoods).
     6626         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code).
     6627         RUN gds-attr-value (
     6628                             INPUT buf_goods.gds-code,
     6629                             INPUT 'mark-type':U,
     6630                             OUTPUT varvalue,
     6631                             OUTPUT vartype
     6632                             ).
     6633         v-isweighed = WeighedProd(buf_goods.gds-code)
     6634                   and varvalue > ""
     6635                   and (EDOParSec:GetIsEDOForType(varvalue)
     6636                     or EDOParSec:GetIsArticForType(varvalue))
     6637         .
     6638       end.
     6639       v-mark-alchol = true .
     6640       if buf_trn-doc.ext-doc-type = 'vt':U
     6641       then do :
     6642           delete object v-tth no-error.
     6643           run adm/shattri.p (
     6644              input "get":U
     6645             ,input buf_trn-doc.obj-type
     6646             ,input buf_trn-doc.obj-code
     6647             ,input 'inv-obj':U
     6648             ,input  "izlcstpr"
     6649             ,output v-value-character
     6650             ,output v-value-date
     6651             ,output v-value-decimal
     6652             ,output v-value-integer
     6653             ,output v-izlcstpr
     6654             ,output v-type
     6655             ,INPUT-OUTPUT table-handle v-tth
     6656             ) no-error .
     6657             delete object v-tth no-error.
     6658           if error-status:error then do:
     6659             v-izlcstpr = false .
     6660           end.
     6661       end.
     6662       else do :
     6663           v-izlcstpr = false .
     6664       end.
     6665       if p-pl-code <> ? and trim(p-pl-code) <> "" and p-pl-code <> "0"
     6666       then
     6667       v-izlcstpr = false .
     6668       empty temp-table tt-alc-codes .
     6669       output stream tobacco-rsrv to value ("tobacco-rsrv.log") .
     6670       if buf_trn-doc.ext-doc-type = 'es':U
     6671       and buf_doc-line.unit-cli > ""
     6672       then do :
     6673         find first buf1_goods no-lock where buf1_goods.artic      = buf_doc-line.artic
     6674                                        and buf1_goods.prod-type  = buf_doc-line.prod-type
     6675                                        and buf1_goods.prod-code  = buf_doc-line.prod-code .
     6676         find first bar-code no-lock where bar-code.gds-code = buf1_goods.gds-code
     6677                                       and bar-code.unit-cli = buf_doc-line.unit-cli .
     6678         for each ub.chk-doc no-lock where ub.chk-doc.out-code = buf_doc-line.doc-code
     6679           and not ub.chk-doc.chk-type = integer ('8':U):
     6680           for each chk-gds no-lock where chk-gds.doc-code = ub.chk-doc.doc-code
     6681                                      and chk-gds.b-code = bar-code.b-code:
     6682             for each chk-gds-attr no-lock where chk-gds-attr.doc-code = chk-gds.doc-code
     6683                                             and chk-gds-attr.line-num = chk-gds.line-num
     6684                                             and chk-gds-attr.attr-code = "mark-code":
     6685               do mark-ii = 1 to num-entries(chk-gds-attr.attr-value) :
     6686                 v-mark = entry(mark-ii, chk-gds-attr.attr-value) .
     6687                 find first tt-marks exclusive-lock where tt-marks.mark = v-mark no-error .
     6688                 if not available tt-marks
     6689                 then do :
     6690                   create tt-marks.
     6691                   tt-marks.mark = v-mark.
     6692                   tt-marks.qnty = 0 .
     6693                 end .
     6694                 tt-marks.qnty = tt-marks.qnty + (chk-gds.doc-qnty / abs(chk-gds.doc-qnty)) .
     6695               end .
     6696             end .
     6697           end .
     6698         end .
     6699       end .
     6700       if buf_trn-doc.ext-doc-type = 'es':U
     6701       and buf_doc-line.unit-cli > ""
     6702       then do :
     6703         find first buf1_goods no-lock where buf1_goods.artic      = buf_doc-line.artic
     6704                                        and buf1_goods.prod-type  = buf_doc-line.prod-type
     6705                                        and buf1_goods.prod-code  = buf_doc-line.prod-code .
     6706         RUN gds-attr-value (
     6707                             INPUT buf1_goods.gds-code,
     6708                             INPUT 'mark-type':U,
     6709                             OUTPUT v-attr-value,
     6710                             OUTPUT v-type
     6711                             ).
     6712         if v-attr-value > ""
     6713         and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_doc-line.obj-type, buf_doc-line.obj-code):GetIsMarkingForType(v-attr-value)
     6714         then do :
     6715           find first bar-code no-lock where bar-code.gds-code = buf1_goods.gds-code
     6716                                         and bar-code.unit-cli = buf_doc-line.unit-cli .
     6717           for each ub.chk-doc no-lock where ub.chk-doc.out-code = buf_doc-line.doc-code
     6718             and ub.chk-doc.chk-type = integer ('1':U):
     6719             for each chk-gds no-lock where chk-gds.doc-code = ub.chk-doc.doc-code
     6720                                        and chk-gds.b-code = bar-code.b-code:
     6721               for each buf_marking-chk no-lock where buf_marking-chk.doc-code = chk-gds.doc-code
     6722                                                  and buf_marking-chk.line-num = chk-gds.line-num
     6723                                                  :
     6724                 if chg-qnty > 0 and buf_marking-chk.sts = 1 then next .
     6725                 if chg-qnty < 0 and buf_marking-chk.sts = 0 then next .
     6726                 if buf_marking-chk.sts = 2 then next .
     6727                 assign vCodeIdent = GetCodeIdent(buf_marking-chk.mark) .
     6728                 find first tt-tobacco-marks exclusive-lock where tt-tobacco-marks.mark = vCodeIdent no-error .
     6729                 find first buf_marking no-lock where buf_marking.mark begins vCodeIdent no-error .
     6730                 if not available tt-tobacco-marks
     6731                 then do :
     6732                   create tt-tobacco-marks.
     6733                   tt-tobacco-marks.mark = vCodeIdent .
     6734                   tt-tobacco-marks.qnty = 0 .
     6735                 end .
     6736                 if available buf_marking then tt-tobacco-marks.unit = buf_marking.unit-ext .
     6737                 tt-tobacco-marks.qnty = tt-tobacco-marks.qnty + (chk-gds.doc-qnty / abs(chk-gds.doc-qnty)) .
     6738               end .
     6739             end .
     6740           end .
     6741         end .
     6742       end .
     6743       if buf_trn-doc.ext-doc-type = 'rs':U
     6744       and buf_doc-line.unit-cli > ""
     6745       then do :
     6746         find first buf1_goods no-lock where buf1_goods.artic      = buf_doc-line.artic
     6747                                        and buf1_goods.prod-type  = buf_doc-line.prod-type
     6748                                        and buf1_goods.prod-code  = buf_doc-line.prod-code .
     6749         find first buf1_goods no-lock where buf1_goods.artic      = buf_doc-line.artic
     6750                                        and buf1_goods.prod-type  = buf_doc-line.prod-type
     6751                                        and buf1_goods.prod-code  = buf_doc-line.prod-code .
     6752         RUN gds-attr-value (
     6753                             INPUT buf1_goods.gds-code,
     6754                             INPUT 'mark-type':U,
     6755                             OUTPUT v-attr-value,
     6756                             OUTPUT v-type
     6757                             ).
     6758         if v-attr-value > ""
     6759         and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_doc-line.obj-type, buf_doc-line.obj-code):GetIsMarkingForType(v-attr-value)
     6760         then do :
     6761           find first bar-code no-lock where bar-code.gds-code = buf1_goods.gds-code
     6762                                         and bar-code.unit-cli = buf_doc-line.unit-cli .
     6763           for each ub.chk-doc no-lock where ub.chk-doc.out-code = buf_trn-doc.out-code
     6764             and (ub.chk-doc.chk-type = integer ('6':U) or ub.chk-doc.chk-type = integer ('69':U) ):
     6765             for each chk-gds no-lock where chk-gds.doc-code = ub.chk-doc.doc-code
     6766                                        and chk-gds.b-code = bar-code.b-code:
     6767               for each buf_marking-chk no-lock where buf_marking-chk.doc-code = chk-gds.doc-code
     6768                                                  and buf_marking-chk.line-num = chk-gds.line-num
     6769                                                  :
     6770                 if buf_marking-chk.sts = 2 then next .
     6771                 assign vCodeIdent = GetCodeIdent(buf_marking-chk.mark) .
     6772                 find first tt-tobacco-marks exclusive-lock where tt-tobacco-marks.mark = vCodeIdent no-error .
     6773                 find first buf_marking no-lock where buf_marking.mark = vCodeIdent no-error .
     6774                 if not available tt-tobacco-marks
     6775                 then do :
     6776                   create tt-tobacco-marks.
     6777                   tt-tobacco-marks.mark = vCodeIdent .
     6778                   tt-tobacco-marks.qnty = 0 .
     6779                 end .
     6780                 if available buf_marking then tt-tobacco-marks.unit = buf_marking.unit-ext .
     6781                 tt-tobacco-marks.qnty = tt-tobacco-marks.qnty + 1 .
     6782               end .
     6783             end .
     6784           end .
     6785         end .
     6786       end .
     6787       define variable v-keyrec   as character no-undo .
     6788       for each ub.fbr-line no-lock where buf_trn-doc.ext-doc-type = 'wm':U
     6789         and ub.fbr-line.doc-code = buf_doc-line.doc-code
     6790         and ub.fbr-line.artic = buf_doc-line.artic
     6791         and ub.fbr-line.prod-type = buf_doc-line.prod-type
     6792         and ub.fbr-line.prod-code = buf_doc-line.prod-code
     6793         :
     6794           run gen-key-rec(input "fbr-line",input buffer ub.fbr-line:handle ,output v-keyrec).
     6795           for each buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark-fbr':U
     6796                                           and buf_gen-attr.p-key = v-keyrec
     6797                                           :
     6798             find first buf2_gen-attr no-lock where
     6799                   buf2_gen-attr.table-name = 'excise-mark-fbr':U
     6800               and buf2_gen-attr.p-key = v-keyrec
     6801               and buf2_gen-attr.attr-code = buf_gen-attr.attr-code no-error.
     6802             find current buf2_gen-attr exclusive-lock.
     6803             buf2_gen-attr.table-name = 'excise-mark':U.
     6804             buf2_gen-attr.p-key = buf2_gen-attr.attr-value.
     6805             buf2_gen-attr.attr-value = "".
     6806             create tt-marks.
     6807             tt-marks.mark = buf2_gen-attr.attr-code.
     6808             tt-marks.qnty = 1.
     6809           end.
     6810       end.
     6811       for each tt-marks exclusive-lock :
     6812         if tt-marks.qnty = 0 then delete tt-marks .
     6813         else
     6814         if tt-marks.qnty <> 1
     6815         then do :
     6816           if not g#auto
     6817           then do :
     6818             message
     6819             vss-workfile vss-revision vss-description skip
     6820             "Ошибка задания входных параметров" skip
     6821             "Не правильное количество по марке - " string(tt-marks.qnty) skip
     6822             "Марка " tt-marks.mark skip
     6823             view-as alert-box error .
     6824           end .
     6825           undo, return error return-value .
     6826         end.
     6827       end.
     6828       for each tt-marks no-lock :
     6829         run ProcAlcCode (input tt-marks.mark, output v-alc-code) no-error.
     6830         if v-alc-code = '' or v-alc-code = ?
     6831         then do :
     6832           message
     6833             vss-workfile vss-revision vss-description skip
     6834             "Ошибка определения алкогольного кода" skip
     6835             "Марка - " v-mark skip
     6836             view-as alert-box error .
     6837           undo, return error return-value .
     6838         end.
     6839         if v-alc-code > ''
     6840         then do :
     6841           find first tt-alc-codes exclusive-lock where tt-alc-codes.alc-code = v-alc-code no-error.
     6842           if not available tt-alc-codes
     6843           then do :
     6844               create tt-alc-codes.
     6845               assign tt-alc-codes.alc-code = v-alc-code .
     6846           end.
     6847           tt-alc-codes.qnty = tt-alc-codes.qnty + 1 .
     6848         end.
     6849       end.
     6850       if p-mark = "tech-marks"
     6851       then do :
     6852         assign
     6853           p-mark = ""
     6854         .
     6855         find first buf1_goods no-lock where buf1_goods.artic      = buf_doc-line.artic
     6856                                         and buf1_goods.prod-type  = buf_doc-line.prod-type
     6857                                         and buf1_goods.prod-code  = buf_doc-line.prod-code .
     6858         for each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf1_goods.gds-code
     6859                                              and buf_marking-lines.obj-type = buf_doc-line.obj-type
     6860                                              and buf_marking-lines.obj-code = buf_doc-line.obj-code
     6861                                              and buf_marking-lines.out-code = 'free-zone':U
     6862                                              and buf_marking-lines.mark begins 'tech_':U
     6863                                              :
     6864           find first tt-tobacco-marks exclusive-lock where tt-tobacco-marks.mark = buf_marking-lines.mark no-error .
     6865           find first buf_marking no-lock where buf_marking.mark = buf_marking-lines.mark no-error .
     6866           if not available tt-tobacco-marks
     6867           then do :
     6868             create tt-tobacco-marks.
     6869             tt-tobacco-marks.mark = buf_marking-lines.mark  .
     6870             tt-tobacco-marks.qnty = 1 .
     6871           end .
     6872           if available buf_marking then tt-tobacco-marks.unit = buf_marking.unit-ext .
     6873         end .
     6874       end .
     6875       if p-mark <> ""
     6876       and num-entries(p-mark, chr(4)) = 2
     6877       and entry(1, p-mark, chr(4)) = "copy-ret"
     6878       then do :
     6879         assign
     6880           v-copy-doc-code = entry(2, p-mark, chr(4))
     6881           p-mark = ""
     6882         .
     6883         find first buf_copy-trn-doc no-lock where buf_copy-trn-doc.doc-code = v-copy-doc-code no-error .
     6884         if available buf_copy-trn-doc
     6885         then do :
     6886           find first buf1_goods no-lock where buf1_goods.artic      = buf_doc-line.artic
     6887                                           and buf1_goods.prod-type  = buf_doc-line.prod-type
     6888                                           and buf1_goods.prod-code  = buf_doc-line.prod-code .
     6889           for each buf_marking-lines no-lock where buf_marking-lines.gds-code = buf1_goods.gds-code
     6890                                                and buf_marking-lines.obj-type = buf_copy-trn-doc.obj-type
     6891                                                and buf_marking-lines.obj-code = buf_copy-trn-doc.obj-code
     6892                                                and buf_marking-lines.out-code = buf_copy-trn-doc.doc-code
     6893                                                :
     6894             find first tt-tobacco-marks exclusive-lock where tt-tobacco-marks.mark = buf_marking-lines.mark no-error .
     6895             find first buf_marking no-lock where buf_marking.mark = buf_marking-lines.mark no-error .
     6896             if not available tt-tobacco-marks
     6897             then do :
     6898               create tt-tobacco-marks.
     6899               tt-tobacco-marks.mark = buf_marking-lines.mark  .
     6900               tt-tobacco-marks.qnty = 1 .
     6901             end .
     6902             if available buf_marking then tt-tobacco-marks.unit = buf_marking.unit-ext .
     6903           end .
     6904         end .
     6905       end .
     6906       if p-mark <> ""
     6907       and num-entries(p-mark, chr(4)) = 2
     6908       and entry(1, p-mark, chr(4)) = "copy-utd-line"
     6909       then do :
     6910         assign
     6911           v-copy-doc-code = entry(2, p-mark, chr(4))
     6912           p-mark = ""
     6913         .
     6914         find first buf_utd-lines no-lock where recid(buf_utd-lines) = integer(v-copy-doc-code) no-error .
     6915         if available buf_utd-lines
     6916         then do :
     6917           for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num   = buf_utd-lines.db-num
     6918                                                    and buf_utd-marking-lines.doc-id   = buf_utd-lines.doc-id
     6919                                                    and buf_utd-marking-lines.LineNum  = buf_utd-lines.LineNum
     6920                                                    and doc-level = 1
     6921                                                    :
