     3819                       when chr(10)
     3820                       then do:
     3821                           assign
     3822                               p-out-string = p-out-string + " ":U
     3823                           .
     3824                       end.
     3825                       when chr(13)
     3826                       then do:
     3827                           assign
     3828                               p-out-string = p-out-string + " ":U
     3829                           .
     3830                       end.
     3831                       otherwise do:
     3832                           assign
     3833                               p-out-string = p-out-string + v-current-char
     3834                           .
     3835                       end.
     3836                   end case.
     3837               end.
     3838           end.
     3839       end case.
     3840   end.
     3841   end .
     3842   procedure xmlchar-decode :
     3843   define input parameter p-in-string      as character        no-undo.
     3844   define output parameter p-out-string    as character        no-undo.
     3845       define variable v-position      as integer      no-undo.
     3846       define variable v-last-position as integer      no-undo.
     3847       define variable v-temp-integer  as integer      no-undo.
     3848       define variable v-current-char  as character    no-undo.
     3849       define variable v-next-char     as character    no-undo.
     3850       define variable v-success       as logical      no-undo.
     3851   do
     3852   on error undo, return error
     3853   :
     3854       assign
     3855           p-out-string = "":U
     3856           v-position   = 0
     3857       .
     3858       replace-cycle:
     3859       do while yes
     3860       on error undo, return error
     3861       :
     3862           assign
     3863               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3864           .
     3865           if v-last-position <= v-position
     3866           then do:
     3867               if v-position = 0
     3868               then do:
     3869                   assign
     3870                       p-out-string = p-in-string
     3871                   .
     3872               end.
     3873               else do:
     3874                   assign
     3875                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3876                   .
     3877               end.
     3878               leave replace-cycle.
     3879           end.
     3880           else do:
     3881               assign
     3882                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3883                   v-position      = v-last-position
     3884                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3885               .
     3886               if v-current-char = "#":U
     3887               then do:
     3888                   assign
     3889                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3890                   .
     3891                   if v-last-position > 0
     3892                   then do:
     3893                       run xmlchar-read-integer in this-procedure
     3894                        (
     3895                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3896                           , output v-temp-integer
     3897                           , output v-success
     3898                       ).
     3899                       if v-success = yes
     3900                       and v-temp-integer >= 1
     3901                       and v-temp-integer <= 255
     3902                       then do:
     3903                           assign
     3904                               p-out-string = p-out-string + chr( v-temp-integer )
     3905                               v-position   = v-last-position + 1
     3906                           .
     3907                       end.
     3908                       else do:
     3909                           assign
     3910                               p-out-string = p-out-string + "&":U
     3911                               v-position   = v-position   + 1
     3912                           .
     3913                       end.
     3914                   end.
     3915                   else do:
     3916                       assign
     3917                           p-out-string = p-out-string + "&":U
     3918                           v-position   = v-position   + 1
     3919                       .
     3920                   end.
     3921               end.
     3922               else do:
     3923                   case substring( p-in-string, v-position + 1, 3 )
     3924                   :
     3925                       when "lt;":U
     3926                       then do:
     3927                           assign
     3928                               p-out-string = p-out-string + "<":U
     3929                               v-position   = v-position   + 3
     3930                           .
     3931                       end.
     3932                       when "gt;":U
     3933                       then do:
     3934                           assign
     3935                               p-out-string = p-out-string + ">":U
     3936                               v-position   = v-position   + 3
     3937                           .
     3938                       end.
     3939                       otherwise do:
     3940                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3941                           then do:
     3942                               assign
     3943                                   p-out-string = p-out-string + "&":U
     3944                                   v-position   = v-position   + 4
     3945                               .
     3946                           end.
     3947                           else do:
     3948                               case substring( p-in-string, v-position + 1, 5 )
     3949                               :
     3950                                   when "quot;":U
     3951                                   then do:
     3952                                       assign
     3953                                           p-out-string = p-out-string + '"':U
     3954                                           v-position   = v-position   + 5
     3955                                       .
     3956                                   end.
     3957                                   when "apos;":U
     3958                                   then do:
     3959                                       assign
     3960                                           p-out-string = p-out-string + "'":U
     3961                                           v-position   = v-position   + 5
     3962                                       .
     3963                                   end.
     3964                                   otherwise do:
     3965                                       assign
     3966                                           p-out-string = p-out-string + "&":U
     3967                                       .
     3968                                   end.
     3969                               end case.
     3970                           end.
     3971                       end.
     3972                   end case.
     3973               end.
     3974           end.
     3975       end.
     3976   end.
     3977   end .
     3978   procedure xmlchar-read-integer :
     3979   define input parameter p-input-string      as character        no-undo.
     3980   define output parameter p-output-integer   as integer          no-undo.
     3981   define output parameter p-success       as logical          no-undo.
     3982   do
     3983   on error undo, return error
     3984   :
     3985       assign
     3986           p-output-integer = integer( p-input-string )
     3987       no-error.
     3988       if error-status :error
     3989       then do:
     3990           assign
     3991               p-success           = no
     3992               p-output-integer    = 0
     3993           .
     3994       end.
     3995       else do:
     3996           assign
     3997               p-success           = yes
     3998           .
     3999       end.
     4000   end.
     4001   end.
     4002   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     4003   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     4004   define variable mMRCCode  as logical    no-undo.
     4005   define variable mTypeMark as character  no-undo.
     4006   function IS-NeedMark returns logical
     4007   ( input ib-code as integer  ,
     4008     input ib-str as character ):
     4009      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     4010      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     4011                                    and buf_prod-bc-attr.b-str  eq ib-str
     4012                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     4013        no-lock no-error.
     4014      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     4015   end.
     4016   function repTegforDm return char
     4017   (iDM as char ):
     4018       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     4019       define variable vteg as character no-undo.
     4020       define variable oDM as character no-undo.
     4021       define variable vi as integer no-undo.
     4022       oDM = iDm.
     4023       do vi = 1 to num-entries(vTeglist):
     4024          vTeg = entry(vi,vTeglist).
     4025          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     4026       end.
     4027       return oDM.
     4028   end.
     4029   function repSpecSimbforDm return char
     4030   (iDM as char ):
     4031       define variable oDM as character no-undo.
     4032     run
     4033       xmlchar-decode(iDM, output oDM).
     4034     return repTegforDm (oDM).
     4035   end.
     4036   function CheckGtin return logical
     4037   (iGtin as char):
     4038      define variable bar_code as character no-undo.
     4039      define variable vGtin as logical no-undo init "yes".
     4040      if length(iGtin) eq 14
     4041      then do:
     4042         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     4043         run str/chk-sum.p
     4044          (input-output bar_code ) no-error .
     4045         if iGtin ne  bar_code
     4046         then
     4047            vGtin = no.
     4048      end.
     4049      else
     4050         vGtin = no.
     4051      return vgtin.
     4052   end.
     4053   function repSpecSimbforXlm return char
     4054   (iDM as char ):
     4055       iDM = replace(iDM,chr(29),"").
     4056       return iDM.
     4057   end.
     4058   function getGtinByDM return char
     4059   (IDM as char):
     4060      define variable VTXT as char no-undo.
     4061      define variable vGtin as char no-undo.
     4062      vTXt = IdM.
     4063      vGtin = IDM.
     4064      if    length(vtxt) > 14
     4065      then do:
     4066         if   vtxt begins "(01)"
     4067                or vtxt begins "(02)"
     4068         then
     4069            vGtin = substring(vtxt,5,14).
     4070         else if   (vtxt begins "01"
     4071                or vtxt begins "02" )
     4072                and (   (    substring(iDm,17,2) eq "21"
     4073                         and length(vtxt) >= 21)
     4074                     or substring(iDm,17,2) eq "37"
     4075                     or substring(iDm,17,4) eq "(37)" )
     4076         then do:
     4077            vGtin = substring(vtxt,3,14).
     4078            if not checkGtin(vGtin)
     4079            then
     4080               vGtin = substring(vtxt,1,14).
     4081         end.
     4082         else if     length(vtxt) eq 14 + 7 + 4 + 4
     4083             or length(vtxt) eq 14 + 7 + 4
     4084             or length(vtxt) eq 14 + 7
     4085         then
     4086            vGtin = substring(vtxt,1,14).
     4087      end.
     4088      if not checkGtin(vGtin)
     4089      then
     4090         vGtin = "".
     4091      return vgtin.
     4092   end.
     4093   function getGdsCodeByGtin return int
     4094   (iGtin as char):
     4095      define buffer prod-bc  for ub.prod-bc.
     4096      define buffer bar-code for ub.bar-code.
     4097      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     4098      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4099      return if avail bar-code then bar-code.gds-code else ?.
     4100   end.
     4101   function getQntyCodeByGtin return decimal
     4102   (iGtin as char):
     4103      define buffer prod-bc  for ub.prod-bc.
     4104      define buffer bar-code for ub.bar-code.
     4105      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     4106      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4107      return if avail bar-code then bar-code.cli-base-rate else ?.
     4108   end.
     4109   function getGdsCodeByDM return int
     4110   (iDm as char):
     4111      define variable vGtin as char no-undo.
     4112      define buffer prod-bc for ub.prod-bc.
     4113      vGtin  = getGtinByDM (IDM ).
     4114      return getGdsCodeByGtin (vGtin).
     4115   end.
     4116   function ChekTypeMarkByGds return logical
     4117   (iGds-code as integer ):
     4118      define buffer goods-attr for ub.goods-attr.
     4119      find first goods-attr where goods-attr.gds-code   = iGds-code
     4120                              and goods-attr.attr-code  = 'mark-type':U
     4121      no-lock no-error.
     4122      if available goods-attr
     4123      then do:
     4124         mTypeMark = goods-attr.attr-value.
     4125         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     4126           .
     4127      end.
     4128      else
     4129         return no.
     4130   end.
     4131   function ChekTypeMarkByDm return logical
     4132   (iDM as char ):
     4133      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     4134   end.
     4135   function ChekTypeMarkByGtin return logical
     4136   (iGtin as char ):
     4137      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     4138   end.
     4139   function GetNextElement return character
     4140     (input iAllTeg        as logical
     4141     ,output oteg          as character
     4142     ,output otegval       as character
     4143     ,input-output pstr    as character
     4144      ):
     4145        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     4146        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     4147        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     4148        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     4149        define variable vTeg as character no-undo.
     4150        define variable vLength as integer no-undo.
     4151        define variable vi as integer no-undo.
     4152        define variable vj as integer no-undo.
     4153        define buffer code for ub.code.
     4154        find first code where Code.parent eq "MarkType"
     4155                          and Code.CodeValue   eq mTypeMark
     4156                          no-lock no-error.
     4157        if     available code
     4158           and Code.misc1 ne ""
     4159           and Code.misc1 ne ?
     4160        then do:
     4161           integer (Code.misc1) no-error.
     4162           if not error-status:error
     4163           then
     4164             entry (4,vlistleng) = Code.misc1.
     4165        end.
     4166        if iAllTeg
     4167        then
     4168           assign
     4169              vlistElem     = vlistElem    + vlistElemDop
     4170              vlistleng     = vlistleng    + vlistlengDop
     4171           .
     4172        else if mMRCCode
     4173        then
     4174           assign
     4175              vlistElem     = vlistElem    + ",(8005),8005"
     4176              vlistleng     = vlistleng    + ",000006,0006"
     4177           .
     4178       block-elem:
     4179       do vi = 1 to num-entries(vlistElem):
     4180          vTeg = entry(vi,vlistElem).
     4181          if pstr begins vTeg
     4182          then do:
     4183             if    vTeg eq "21"
     4184             then
     4185                vLength = index(pstr,chr(29)) - 2 no-error.
     4186             if vLength  <= 0
     4187             then
     4188                vLength = int(entry(vi,vlistleng)).
     4189             otegval = substring (pstr,length(vteg) + 1, vLength).
     4190             oteg = replace(replace(vteg,")",""),"(","").
     4191             vTeg = vteg + otegval.
     4192             otegval = replace(otegval,chr(29),"").
     4193             oteg = replace(replace(oteg,")",""),"(","").
     4194             pstr = substring (pstr,length(vTeg)+ 1).
     4195             vTeg = replace(vTeg,chr(29),"").
     4196             leave block-elem.
     4197          end.
     4198          else
     4199             vTeg = "".
     4200       end.
     4201       return vteg.
     4202   end.
     4203   function GetCodeIdent return character
     4204   (iDm as char):
     4205      define variable Velement   as character no-undo init "first".
     4206      define variable oCodeIdent as character no-undo.
     4207      define variable vteg as character no-undo.
     4208      define variable vtegval as character no-undo.
     4209      define variable vGtin as character no-undo.
     4210      define buffer marking for ub.marking.
     4211      for first marking no-lock where
     4212                marking.mark eq iDm
     4213            and marking.unit-ext = "LEVEL2"
     4214      :
     4215        return iDm.
     4216      end.
     4217      vGtin  = getGtinByDM (iDm ).
     4218      ChekTypeMarkByDm(idm).
     4219      if iDm begins 'tech_':U
     4220      then
     4221         oCodeIdent = iDm.
     4222      else if length(iDm) < 21
     4223      then do:
     4224         find first marking where marking.mark eq idm
     4225         no-lock no-error.
     4226         oCodeIdent = if available marking then marking.mark else  ?.
     4227      end.
     4228      else if     length(iDm) eq 29
     4229         and not iDm begins "01"
     4230         and not iDm begins "02"
     4231      then
     4232         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     4233      else  if     length(iDm) >= 24
     4234               and (  iDm begins "01"
     4235                   or iDm begins "02")
     4236               and  substring(iDm,17,2) ne "21"
     4237      then do:
     4238         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     4239                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     4240         then
     4241            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     4242         else
     4243            oCodeIdent = iDM.
     4244      end.
     4245      else  if     (   length(iDm) eq 25
     4246                    or length(iDm) eq 21)
     4247               and (not iDm begins "01"
     4248               and  not iDm begins "02")
     4249      then
     4250         oCodeIdent = substring(iDm,1,21).
     4251      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     4252      then
     4253         oCodeIdent = substring(iDm,1,21).
     4254      else do while Velement ne "" and idm ne "":
     4255         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     4256         oCodeIdent = oCodeIdent + Velement.
     4257      end.
     4258      return oCodeIdent.
     4259   end.
     4260   function GetTegCod return character
     4261   (icodeIdent as char, iTeg as char):
     4262      define variable Velement   as character no-undo init "first".
     4263      define variable oTeg as character no-undo init ?.
     4264      define variable vteg as character no-undo.
     4265      define variable vtegval as character no-undo.
     4266      if     ((length(icodeIdent) eq 21
     4267         and not icodeIdent begins "01"
     4268         and not icodeIdent begins "02")
     4269         or
     4270             ( length(icodeIdent) eq 25
     4271               and not icodeIdent begins "01"
     4272               and not icodeIdent begins "02"))
     4273      then do:
     4274         if iTeg eq "01" or iTeg eq "02"
     4275         then
     4276            oTeg = substring(icodeIdent,1,21).
     4277         else  if  iTeg eq "21"
     4278         then
     4279            oTeg = substring(icodeIdent,15,7).
     4280      end.
     4281      else do:
     4282         ChekTypeMarkByDm(icodeIdent).
     4283         block-teg:
     4284            do while Velement ne "" and icodeIdent ne "":
     4285            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     4286            if    Velement begins iTeg
     4287               or Velement begins "(" + iTeg + ")"
     4288            then do:
     4289               oTeg = vtegval.
     4290               leave block-teg.
     4291            end.
     4292         end.
     4293      end.
     4294      return oTeg.
     4295   end.
     4296   function isOAD return logical
     4297   (icodeIdent as character):
     4298      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     4299   end.
     4300   function isMark return logical
     4301   (icodeIdent as character):
     4302      define buffer buf_marking for ub.marking.
     4303      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     4304             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     4305   end.
     4306   function addBracketForCode return character
     4307   (icodeIdent as char):
     4308      define variable Velement   as character no-undo init "first".
     4309      define variable oTeg as character no-undo.
     4310      define variable vteg as character no-undo.
     4311      define variable vtegval as character no-undo.
     4312      define buffer marking for ub.marking.
     4313      find first marking no-lock where
     4314                 marking.mark begins icodeIdent no-error.
     4315      if    not ChekTypeMarkByDm(icodeIdent)
     4316         or length(icodeIdent) le 24
     4317         or (avail marking and marking.unit-ext = "LEVEL2")
     4318      then
     4319         oTeg = icodeIdent.
     4320      else do:
     4321         if (  icodeIdent begins "01"
     4322            or icodeIdent begins "02"
     4323            ) and CheckGtin(substring (icodeIdent,3,14))
     4324            and substring (icodeIdent,17,2) eq "21"
     4325         then do:
     4326            mMRCCode = yes.
     4327            ChekTypeMarkByDm(icodeIdent).
     4328            block-teg:
     4329            do while Velement ne "" and icodeIdent ne "":
     4330               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     4331               if vteg ne ""
     4332               then
     4333                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     4334            end.
     4335            mMRCCode = no.
     4336         end.
     4337         else do:
     4338            oTeg = icodeIdent.
     4339         end.
     4340      end.
     4341      return oTeg.
     4342   end.
     4343   function getlevelByCodId return int
     4344   (iCode as char):
     4345      define variable vLength as int no-undo.
     4346      define variable vLevel  as int no-undo.
     4347      if not ChekTypeMarkByDM (icode) then return ?.
     4348      vLength = length(iCode).
     4349      if    vLength eq 18
     4350         or vLength eq 20
     4351      then
     4352         Vlevel = 4.
     4353      else if vLength eq 21
     4354      then
     4355         Vlevel = 1.
     4356      else if vLength eq 25
     4357      then do:
     4358         if  iCode begins "01"
     4359         then
     4360            Vlevel = 3.
     4361         else
     4362            Vlevel = 1.
     4363      end.
     4364      else if     vLength >= 26
     4365              and vLength <= 46
     4366      then do:
     4367         if    substring(iCode,17,2) eq "11"
     4368            or substring(iCode,17,2) eq "13"
     4369            or (    substring(iCode,17,2) eq "21"
     4370                and vLength >= 33
     4371                and substring(iCode,26,4) ne "8005")
     4372         then
     4373            Vlevel = 4.
     4374         else if    vLength eq 31
     4375                 or vLength eq 38
     4376                 or vLength eq 39
     4377                 or vLength eq 45
     4378         then
     4379            Vlevel = 1.
     4380         else if    vLength eq 35
     4381                 or vLength eq 43
     4382         then
     4383            Vlevel = 3.
     4384         else
     4385            Vlevel = ?.
     4386      end.
     4387      else
     4388         Vlevel = ?.
     4389      return Vlevel.
     4390   end.
     4391   function getLevelMotpBycodid return character
     4392   (iDm as char):
     4393      define variable vLevel as integer no-undo.
     4394      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     4395      vLevel = getlevelByCodId(iDm).
     4396      if    vLevel eq ?
     4397         or vLevel < 1
     4398         or vLevel > 6
     4399      then
     4400         return ?.
     4401      else
     4402         return entry(vlevel,vList).
     4403   end.
     4404   function getLevelUTDByLevelMotp return character
     4405   (iUnit as char):
     4406      define variable vLevel as integer no-undo.
     4407      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     4408      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     4409      vLevel = lookup(iUnit,vListMOTP).
     4410      if    vLevel eq ?
     4411         or vLevel < 1
     4412         or vLevel > 4
     4413      then
     4414         return ?.
     4415      else
     4416         return entry(vlevel,vListutd).
     4417   end.
     4418   function getLevelMotpByDM return character
     4419   (iDm as char):
     4420      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     4421   end.
     4422   function getLevelUTDByCodId return character
     4423   (iDm as char):
     4424      define variable vLevel as integer no-undo.
     4425      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     4426      vLevel = getlevelByCodId(iDm).
     4427      if    vLevel eq ?
     4428         or vLevel < 1
     4429         or vLevel > 4
     4430      then
     4431         return ?.
     4432      else
     4433         return entry(vlevel,vList).
     4434   end.
     4435   function getLevelUTDByDM return character
     4436   (iDm as char):
     4437      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     4438   end.
     4439   define variable mNotMarkQnty as logical no-undo.
     4440   function getQntyUTDByCodId return decimal
     4441   (iDM as char):
     4442      define variable vLevel as integer no-undo.
     4443      define variable vList as character no-undo init "1,5,10,500".
     4444      define variable vGtin as character no-undo.
     4445      define variable vqnty as decimal no-undo init ?.
     4446      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     4447      if vqnty eq ?
     4448      then do:
     4449         if not mNotMarkQnty
     4450         then do:
     4451            define buffer marking for ub.marking.
     4452            define variable vCodident as character no-undo.
     4453            vCodident = GetCodeIdent(idm).
     4454            find first marking where marking.mark begins vCodident no-lock no-error.
     4455            if     available marking
     4456               and marking.box-qnty ne ?
     4457            then
     4458               return marking.box-qnty.
     4459         end.
     4460         vGtin = getGtinByDm(iDM).
     4461         if ChekTypeMarkByGtin (vGtin)
     4462         then do:
     4463            vLevel = getlevelByCodId(iDM).
     4464            if     vLevel >= 1
     4465               and vLevel <= 4
     4466            then
     4467               vqnty = int(entry(vlevel,vList)).
     4468         end.
     4469         else
     4470            vqnty = getQntyCodeByGtin(vgtin).
     4471      end.
     4472      return vqnty.
     4473   end.
     4474   function getQntyUTDByDM return decimal
     4475   (iDm as char):
     4476      define variable vDM as character no-undo.
     4477      if     length (iDm) ne 25
     4478         and length (iDm) ne 29
     4479         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     4480      then
     4481         vDM = substring (iDm,1,length (iDm) - 6 ).
     4482      else
     4483         vDM = substring (iDm,1,length (iDm) - 4 ).
     4484      return getQntyUTDByCodId(vDM).
     4485   end.
     4486   function getMRC4 return decimal
     4487   (iMRC as char):
     4488      define variable oMrc     as decimal no-undo init ?.
     4489      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     4490      define variable vi       as integer no-undo.
     4491      define variable vfound   as integer no-undo.
     4492      define variable vposStart   as integer no-undo.
     4493      do:
     4494      OMRc = 0.
     4495      do vi = 1 to 4:
     4496         define variable vsimb as character no-undo.
     4497         vsimb = substring(iMRC,vi,1).
     4498         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     4499         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     4500         if vfound > 0
     4501         then
     4502            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     4503         end.
     4504         OMRc = OMRc / 100.
     4505      end.
     4506      return OMRc.
     4507   end.
     4508   function getMRCByDM return decimal
     4509   (iDm as char):
     4510      define variable vMRC     as character no-undo.
     4511      define variable oMrc     as decimal no-undo init ?.
     4512      define variable Velement as character no-undo init "empty".
     4513      define variable vteg as character no-undo.
     4514      define variable vtegval as character no-undo.
     4515      if    length(idm) eq 14 + 7 + 4 + 4
     4516         or length(idm) eq 14 + 7 + 4
     4517      then do:
     4518         vMRC = substring(idm,22,4).
     4519         omrc = getMRC4(vMRC).
     4520      end.
     4521      else do:
     4522          ChekTypeMarkByDm(iDm).
     4523          block-mrc:
     4524          do while Velement ne "" and idm ne "":
     4525             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     4526             if Velement begins "8005"
     4527             then do:
     4528                vMRC = substring(Velement,5,6).
     4529                leave block-mrc.
     4530             end.
     4531             else if Velement begins "(8005)"
     4532             then do:
     4533                vMRC = substring(Velement,7,6).
     4534                leave block-mrc.
     4535             end.
     4536          end.
     4537          if vMRC ne ""
     4538          then
     4539             OMRc = dec(vmrc) / 100 no-error.
     4540      end.
     4541      return OMRc.
     4542   end.
     4543   function MoveDate return Date
     4544   (idate as date,
     4545    iMonth as int64):
     4546      define variable vMonth   as int64 no-undo.
     4547      define variable vYear    as int64 no-undo.
     4548      define variable vDateNew as date  no-undo.
     4549       define variable vDay     as int64 no-undo.
     4550       vMonth = month(iDate) + iMonth.
     4551       vYear =  year(iDate).
     4552       if vMonth <= 0
     4553       then assign
     4554          vMonth = vMonth + 12
     4555           vYear  = vYear - 1
     4556       .
     4557       else if vMonth > 12
     4558       then assign
     4559          vMonth = vMonth - 12
     4560           vYear  = vYear + 1
     4561       .
     4562       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     4563       do while error-status:error eq yes:
     4564          VDay = vDay + 1.
     4565          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     4566       end.
     4567       if VDay > 0
     4568       then
     4569          vDateNew + 1.
     4570       return vDateNew.
     4571   end.
     4572   procedure checkEMRC:
     4573   define input  parameter iDm as character no-undo.
     4574   define output parameter vok as logical   no-undo init yes.
     4575      define variable v-value-emrc as character no-undo.
     4576      define variable v-type-emrc  as character no-undo.
     4577      define variable vDateIso     as character no-undo.
     4578      define variable vMRC         as decimal no-undo.
     4579      define variable vqnty        as decimal no-undo.
     4580      define variable vPrice       as decimal no-undo.
     4581      define variable vparent      as character no-undo.
     4582      define variable vgds-code    as integer no-undo.
     4583      define buffer code for ub.code.
     4584      vMRC = getMRCByDM(iDm).
     4585      if vMRC > 0
     4586      then do:
     4587         vgds-code = getGdsCodeByDM(iDm).
     4588         vqnty     = getQntyUTDByDM(iDm).
     4589               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     4590            (
     4591             input   vgds-code
     4592            ,input   'emrc-type':U
     4593            ,output   v-value-emrc
     4594            ,output   v-type-emrc
     4595          ) no-error.
     4596          if     v-value-emrc ne ""
     4597             and v-value-emrc ne ?
     4598          then do:
     4599             vDateIso = iso-date(today).
     4600             vPrice = vMRC / vqnty.
     4601             vparent ="emc" + chr(4) + v-value-emrc.
     4602             find last code where Code.parent      eq vparent
     4603                              and Code.code        le vDateIso
     4604                              and code.status_  eq 0
     4605             no-lock no-error.
     4606             if not available code or ( vPrice  >= dec(Code.CodeValue))
     4607             then
     4608                vOk = true .
     4609             else do:
     4610                 define variable vText      as character no-undo.
     4611                 define variable vDate      as date no-undo.
     4612                 define variable vDateLast  as character no-undo.
     4613                 define variable vDateFirst as character no-undo.
     4614                 define variable vDate3     as date no-undo.
     4615                 vdate = date(code.misc1).
     4616                 vDateLast = code.misc1.
     4617                 vDate3 = MoveDate(today, - 3 ).
     4618                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     4619                                      string(vDate3  , "99/99/9999"),
     4620                                      string(vDate   , "99/99/9999")
     4621                                      ).
     4622                 vdateIso = iso-date(vdate3).
     4623                 find last code  where Code.parent      eq vparent
     4624                                   and Code.code        le vDateIso
     4625                                   and code.status_  eq 0 no-lock no-error.
     4626                 if available code
     4627                 then
     4628                    vDateIso = code.code.
     4629                 vDateFirst = vDateIso.
     4630                 vDateLast = iso-date(vdate).
     4631                 define variable vGood as logical no-undo.
     4632                 define variable vDateSale as date no-undo.
     4633                 define buffer bcode for code.
     4634                 for last code where Code.parent   eq vparent
     4635                                 and code.status_  eq 0
     4636                                 and code.code     < vDateLast
     4637                                 and code.code     >= vDateFirst
     4638                 no-lock:
     4639                    find first bcode where bCode.parent   eq vparent
     4640                                       and bcode.status_  eq 0
     4641                                       and bcode.code     > code.code no-lock no-error.
     4642                    if available bcode
     4643                    then do:
     4644                       if vPrice < dec(Code.CodeValue)
     4645                       then
     4646                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     4647                                                     chr(10),
     4648                                                     string(    date( code.misc1)       ,"99/99/9999"),
     4649                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     4650                                                     ).
     4651                       else do:
     4652                          vGood = yes.
     4653                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     4654                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     4655                                                     chr(10),
     4656                                                     string(    date( code.misc1)         ,"99/99/9999"),
     4657                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     4658                                                     string(         vDateSale            ,"99/99/9999"),
     4659                                                     string(vDateSale - today)
     4660                                                     ).
     4661                       end.
     4662                    end.
     4663                 end.
     4664                 if vgood
     4665                 then do:
     4666                    define variable choice as integer no-undo .
     4667                    run gbl/d-askw.w (input "Уточнение"
     4668                           ,input  vText
     4669                           ,input "|"
     4670                           ,input "Принять|Вернуть"
     4671                           ,input "Принять данный товар|Вернуть товар постащику"
     4672                           ,input 1
     4673                           ,input 2
     4674                           ,output choice) no-error.
     4675                    vok = choice eq 1.
     4676                 end.
     4677                 else
     4678                    vok =false.
     4679             end.
     4680          end.
     4681      end.
     4682   end.
     4683   function addGs2Mark return character
     4684   (iMark as char):
     4685      define variable vDM   as character no-undo.
     4686      define variable vIdx  as integer   no-undo.
     4687      if index(iMark,chr(29),1) > 0
     4688      then return iMark.
     4689      if substring(iMark,26,4) = "8005" then
     4690      do:
     4691        vIdx = index(iMark,"93",26 + 4 + 5).
     4692        if vIdx > 1 then do:
     4693          vDM = substitute("&1&4&2&4&3",
     4694                           substring(iMark,1,25),
     4695                           substring(iMark,26,vIdx - 25 - 1),
     4696                           substring(iMark,vIdx),
     4697                           chr(29)) no-error.
     4698          vIdx = index(vDm,"240",vIdx + 4).
     4699          if vIdx > 0 then
     4700          do:
     4701            vDM = substitute("&1&3&2",
     4702                             substring(vDm,1,vIdx - 1),
     4703                             substring(vDm,vIdx),
     4704                             chr(29)) no-error.
     4705          end.
     4706        end.
     4707        else
     4708          vDM = substitute("&1&3&2",
     4709                           substring(iMark,1,25),
     4710                           substring(iMark,26),
     4711                           chr(29)) no-error.
     4712      end.
     4713      else if substring(iMark,32,2) = "91" then
     4714      do:
     4715        vIdx = index(iMark,"92",32).
     4716        if vIdx > 1 then
     4717          vDM = substitute("&1&4&2&4&3",
     4718                           substring(iMark,1,31),
     4719                           substring(iMark,32,vIdx - 31 - 1),
     4720                           substring(iMark,vIdx),
     4721                           chr(29)) no-error.
     4722        else
     4723          vDM = substitute("&1&3&2",
     4724                           substring(iMark,1,31),
     4725                           substring(iMark,32),
     4726                           chr(29)) no-error.
     4727      end.
     4728      else if substring(iMark,39,2) = "91" then
     4729      do:
     4730        vIdx = index(iMark,"92",38).
     4731        if vIdx > 1 then
     4732          vDM = substitute("&1&4&2&4&3",
     4733                           substring(iMark,1,38),
     4734                           substring(iMark,39,vIdx - 38 - 1),
     4735                           substring(iMark,vIdx),
     4736                           chr(29)) no-error.
     4737        else
     4738          vDM = substitute("&1&3&2",
     4739                           substring(iMark,1,38),
     4740                           substring(iMark,39),
     4741                           chr(29)) no-error.
     4742      end.
     4743      else if substring(iMark,25,2) = "93" then
     4744      do:
     4745        vIdx = index(iMark,"92",25).
     4746        if vIdx > 1 then
     4747          vDM = substitute("&1&4&2&4&3",
     4748                           substring(iMark,1,24),
     4749                           substring(iMark,25,vIdx - 24 - 1),
     4750                           substring(iMark,vIdx),
     4751                           chr(29)) no-error.
     4752        else
     4753          vIdx = index(iMark,"3103",25).
     4754          if vIdx > 0 then
     4755          vDM = substitute("&1&4&2&4&3",
     4756                           substring(iMark,1,24),
     4757                           substring(iMark,25,vIdx - 24 - 1),
     4758                           substring(iMark,vIdx),
     4759                           chr(29)) no-error.
     4760          else
     4761            vDM = substitute("&1&3&2",
     4762                             substring(iMark,1,24),
     4763                             substring(iMark,25),
     4764                             chr(29)) no-error.
     4765      end.
     4766      else if substring(iMark,32,2) = "93" then
     4767      do:
     4768        vDM = substitute("&1&3&2",
     4769              substring(iMark,1,31),
     4770              substring(iMark,32),
     4771              chr(29)) no-error.
     4772      end.
     4773      return if vDM <> "" then vDm else iMark.
     4774   end.
     4775   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4776   function getattrUtdex returns char
     4777   (idb-num   as integer,
     4778    idoc-id   as integer,
     4779    iattrcode as character,
     4780    iExValue  as character  ):
     4781      define buffer utd-attr for utd-attr.
     4782      find first utd-attr where utd-attr.db-num eq idb-num
     4783                            and utd-attr.doc-id eq idoc-id
     4784                            and utd-attr.attr-code eq iattrcode
     4785      no-lock no-error.
     4786      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     4787   end.
     4788   function getattrUtd returns char
     4789   (idb-num   as integer,
     4790    idoc-id   as integer,
     4791    iattrcode as character ):
     4792     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     4793   end.
     4794   function setattrUtd returns logical
     4795   (idb-num   as integer,
     4796    idoc-id   as integer,
     4797    iattrcode as character,
     4798    iattrval  as character ):
     4799      define buffer utd-attr for utd-attr.
     4800      find first utd-attr where utd-attr.db-num eq idb-num
     4801                            and utd-attr.doc-id eq idoc-id
     4802                            and utd-attr.attr-code eq iattrcode
     4803      no-lock no-error.
     4804      if not available utd-attr
     4805      then do:
     4806         create utd-attr.
     4807         assign
     4808            utd-attr.db-num    = idb-num
     4809            utd-attr.doc-id    = idoc-id
     4810            utd-attr.attr-code = iattrcode
     4811            utd-attr.attr-value = iattrval
     4812         .
     4813      end.
     4814      else do:
     4815         if utd-attr.attr-value ne iattrval
     4816         then do:
     4817            find current utd-attr exclusive-lock no-error.
     4818            if available utd-attr
     4819            then
     4820               utd-attr.attr-value = iattrval.
     4821         end.
     4822      end.
     4823      release utd-attr.
     4824   end.
     4825   function GetAttrUtdlinesEx returns char
     4826   (idb-num   as integer,
     4827    idoc-id   as integer,
     4828    ilinenum  as integer,
     4829    iattrcode as character,
     4830    iExValue  as character  ):
     4831      define buffer utd-lines-attr for utd-lines-attr.
     4832      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     4833                                  and utd-lines-attr.doc-id    eq idoc-id
     4834                                  and utd-lines-attr.lineNum   eq ilineNum
     4835                                  and utd-lines-attr.attr-code eq iattrcode
     4836      no-lock no-error.
     4837      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     4838   end.
     4839   function GetAttrUtdlines returns char
     4840   (idb-num   as integer,
     4841    idoc-id   as integer,
     4842    ilinenum  as integer,
     4843    iattrcode as character ):
     4844      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     4845   end.
     4846   function setattrUtdlines returns logical
     4847   (idb-num   as integer,
     4848    idoc-id   as integer,
     4849    ilinenum  as integer,
     4850    iattrcode as character,
     4851    iattrval  as character ):
     4852      define buffer utd-lines-attr for utd-lines-attr.
     4853      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     4854                                  and utd-lines-attr.doc-id    eq idoc-id
     4855                                  and utd-lines-attr.lineNum   eq ilineNum
     4856                                  and utd-lines-attr.attr-code eq iattrcode
     4857      no-lock no-error.
     4858      if not available utd-lines-attr
     4859      then do:
     4860         if iattrval ne ?
     4861            and iattrval ne ""
     4862         then do:
     4863            create utd-lines-attr.
     4864            assign
     4865               utd-lines-attr.db-num    = idb-num
     4866               utd-lines-attr.doc-id    = idoc-id
     4867               utd-lines-attr.lineNum   = ilineNum
     4868               utd-lines-attr.attr-code = iattrcode
     4869               utd-lines-attr.attr-value = iattrval
     4870            .
     4871         end.
     4872      end.
     4873      else do:
     4874         if utd-lines-attr.attr-value ne iattrval
     4875         then do:
     4876            find current utd-lines-attr exclusive-lock no-error.
     4877            if available utd-lines-attr
     4878            then do:
     4879               if    iattrval eq ?
     4880                  or iattrval eq ""
     4881               then do:
     4882                  delete utd-lines-attr.
     4883               end.
     4884               else do:
     4885                  utd-lines-attr.attr-value = iattrval.
     4886               end.
     4887            end.
     4888         end.
     4889      end.
     4890      release utd-lines-attr.
     4891   end.
     4892   function GetAttrUtdMarkingLinesEx returns char
     4893   (idb-num   as integer,
     4894    idoc-id   as integer,
     4895    ilinenum  as integer,
