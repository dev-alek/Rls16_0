    13309       define buffer   in-vatp-sysconfo  for ub.sysconf .
    13310       define buffer   in-vatp_doc-attro for ub.doc-attr.
    13311       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
    13312       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
    13313       define variable varinvprbo                  as   character              no-undo.
    13314       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
    13315       define variable cli-base-rateo              as   decimal                no-undo.
    13316       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
    13317       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
    13318       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
    13319       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
    13320       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
    13321       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
    13322       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
    13323       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
    13324       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
    13325       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
    13326       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
    13327       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
    13328       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
    13329       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
    13330       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
    13331       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
    13332       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
    13333       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
    13334       define variable other-base-loco             like ub.doc-line.price-base no-undo.
    13335       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
    13336       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
    13337       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
    13338       define variable varinvatp-envdo             as   character              no-undo.
    13339       define variable varinvatp-typeo             as   character              no-undo.
    13340     do
    13341     on error undo, return error return-value
    13342     :
    13343       find first buf_trn-doc no-lock
    13344         where buf_trn-doc.doc-code = p-doc-code
    13345       no-error .
    13346       if not available buf_trn-doc
    13347       then do:
    13348         message
    13349           vss-workfile vss-revision vss-description skip
    13350           vss-include-info60 skip
    13351           "Ошибка задания входных параметров" skip
    13352           "Не найден документ" skip
    13353           "Документ" p-doc-code skip
    13354           "Артикул" p-artic p-prod-type p-prod-code skip
    13355           view-as alert-box error .
    13356         undo, return error .
    13357       end.
    13358       find first buf_doc-line no-lock
    13359         where buf_doc-line.doc-code  = p-doc-code
    13360           and buf_doc-line.artic     = p-artic
    13361           and buf_doc-line.prod-type = p-prod-type
    13362           and buf_doc-line.prod-code = p-prod-code
    13363         no-error .
    13364       if not available buf_doc-line
    13365       then do:
    13366         message
    13367           vss-workfile vss-revision vss-description skip
    13368           vss-include-info60 skip
    13369           "Ошибка задания входных параметров" skip
    13370           "Не найдена строка документа" skip
    13371           "Документ" p-doc-code skip
    13372           "Артикул" p-artic p-prod-type p-prod-code skip
    13373           view-as alert-box error .
    13374         undo, return error .
    13375       end.
    13376       for each buf_gds-dtl no-lock
    13377         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
    13378           and buf_gds-dtl.artic     = buf_doc-line.artic
    13379           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
    13380           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
    13381       on error undo, return error
    13382       :
    13383         if buf_trn-doc.doc-type <> 'инв':U
    13384         then do:
    13385           if buf_trn-doc.doc-type = 'при':U
    13386           or buf_trn-doc.doc-type = 'возврат':U
    13387           then do:
    13388             assign
    13389               v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
    13390             .
    13391           end.
    13392           else do:
    13393             assign
    13394               v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
    13395             .
    13396           end.
    13397         end.
    13398         else do:
    13399           assign
    13400             v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
    13401           .
    13402         end.
    13403         if v-gds-dtl-fact-qnty <> 0
    13404         then do:
    13405   if buf_trn-doc.ext-doc-type = 'ot':U or
    13406      buf_trn-doc.ext-doc-type = ?                 then do:
    13407     assign
    13408      out-vatp-have-vat-slt = yes.
    13409   end.
    13410   else do:
    13411     find first out-vatp_doc-attr no-lock
    13412       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
    13413         and out-vatp_doc-attr.attr-code = 'envd':U
    13414         no-error .
    13415     if not available out-vatp_doc-attr then do:
    13416       assign
    13417         out-vatp-have-vat-slt = yes.
    13418     end.
    13419     else do:
    13420        out-vatp-have-vat-slt = no.
    13421     end.
    13422   end.
    13423   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
    13424                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
    13425                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
    13426   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13427   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
    13428     (input  buf_doc-line.artic
    13429     ,input  buf_doc-line.prod-type
    13430     ,input  buf_doc-line.prod-code
    13431     ,output varroot-node
    13432     ) no-error .
    13433   if error-status :error then do:
    13434     message
    13435       vss-workfile vss-revision vss-description skip
    13436       "Ошибка при определении корневого признака товара" skip
    13437       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
    13438       error-status :get-message(1) skip
    13439       return-value skip
    13440       view-as alert-box error .
    13441     undo, return error .
    13442   end.
    13443   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
    13444     (input  varroot-node
    13445     ,input  'empty-scale=request'
    13446     ,output varempty-scale
    13447     ) no-error .
    13448   if error-status :error then do:
    13449     message
    13450       vss-workfile vss-revision vss-description skip
    13451       "Ошибка при определении атрибута признака" skip
    13452       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
    13453       "Признак" varroot-node skip
    13454       "Запрашивался атрибут" "empty-scale=request" skip
    13455       error-status :get-message(1) skip
    13456       return-value skip
    13457       view-as alert-box error .
    13458     undo, return error .
    13459   end.
    13460   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    13461   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    13462     (output varoutvprb
    13463     )  .
    13464   if varoutvprb = "base":u then do:
    13465     assign
    13466           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
    13467       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
    13468     .
    13469   end.
    13470   else do:
    13471     assign
    13472           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
    13473       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
    13474     .
    13475   end.
    13476   if varoutvprb = "rubl":u then do:
    13477     assign
    13478           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
    13479       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
    13480   end.
    13481   else do:
    13482     assign
    13483           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
    13484       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
    13485   end.
    13486   assign
    13487     varis-cons-parts-have =  no.
    13488   assign
    13489     varfact-qnty       = 0
    13490     varcons-qnty       = 0
    13491     varprice-base-cons = 0
    13492     varprice-rubl-cons = 0.
    13493   find first out-vatp_doc-line where
    13494              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
    13495          and out-vatp_doc-line.artic      = buf_doc-line.artic
    13496          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
    13497          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
    13498   if available out-vatp_doc-line           and
    13499     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
    13500     assign
    13501       varfact-qnty = out-vatp_doc-line.fact-qnty.
    13502   end.
    13503   else do:
    13504     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
    13505                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
    13506                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
    13507                                  and out-vatp_parts.artic      = buf_doc-line.artic
    13508                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
    13509                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
    13510       if out-vatp_parts.purch-code = 2 then do:
    13511   assign
    13512     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
    13513     price-base-with-tax-loco = out-vatp_parts.price-base
    13514   .
    13515   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    13516   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    13517     (output varinvprbo
    13518     )  .
    13519     if out-vatp_parts.out-code = 'free-zone':U     or
    13520        out-vatp_parts.out-code = 'out-zone':U   or
    13521        out-vatp_parts.doc-type = 'акт':U then do:
    13522       assign
    13523         in-vatp-have-vat-slto = yes.
    13524     end.
    13525     else do:
    13526       find first in-vatp_doc-attro no-lock
    13527         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
    13528           and in-vatp_doc-attro.attr-code = 'envd':U
    13529         no-error .
    13530       if not available in-vatp_doc-attro then do:
    13531         assign
    13532           in-vatp-have-vat-slto = yes.
    13533       end.
    13534       else do:
    13535            in-vatp-have-vat-slto = no.
    13536       end.
    13537     end.
    13538     assign
    13539      price-cli-with-tax-loco = out-vatp_parts.price-cli
    13540      cli-base-rateo          = out-vatp_parts.cli-base-rate.
    13541     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
    13542              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
    13543     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
    13544             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
    13545             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
    13546             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
    13547             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
    13548             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
    13549             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
    13550       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
    13551     assign
    13552       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
    13553     assign
    13554       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
    13555       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
    13556       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
    13557       transport-cli-loco  = 0
    13558       other-cli-loco      = 0
    13559     .
    13560   ASSIGN
    13561             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
    13562       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
    13563   .
    13564         assign
    13565           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
    13566           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
    13567         assign
    13568           varis-cons-parts-have = yes
    13569           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
    13570       end.
    13571       assign
    13572         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
    13573     end.
    13574   end.
    13575   assign
    13576     varprice-base-cons = varprice-base-cons / varcons-qnty
    13577     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
    13578   if varprice-base-cons = ? then do:
    13579     assign
    13580       varprice-base-cons = 0.
    13581   end.
    13582   if varprice-rubl-cons = ? then do:
    13583     assign
    13584       varprice-rubl-cons = 0.
    13585   end.
    13586   assign
    13587       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
    13588     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
    13589     discnt-base-sale            = buf_gds-dtl.discnt-base
    13590     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
    13591       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
    13592     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
    13593     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
    13594     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
    13595     .
    13596   if buf_trn-doc.doc-type = 'инв':U then do:
    13597     assign
    13598       varfact-qnty = buf_gds-dtl.doc-qnty.
    13599   end.
    13600   else do:
    13601     assign
    13602       varfact-qnty = buf_gds-dtl.fact-qnty.
    13603   end.
    13604   if varis-cons-parts-have = no then do:
    13605     assign
    13606           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
    13607           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
    13608   end.
