     4901                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     4902                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     4903                                          and utd-marking-lines-attr.mark      eq imark
     4904                                          and utd-marking-lines-attr.attr-code eq iattrcode
     4905      no-lock no-error.
