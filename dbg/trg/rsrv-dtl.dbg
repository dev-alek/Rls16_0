     3806                       end.
     3807                       when chr(9)
     3808                       then do:
     3809                           assign
     3810                               p-out-string = p-out-string + " ":U
     3811                           .
     3812                       end.
     3813                       when chr(29)
     3814                       then do:
     3815                           assign
     3816                               p-out-string = p-out-string + " ":U
     3817                           .
