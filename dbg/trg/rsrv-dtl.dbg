     8455             find first buf_goods no-lock where buf_goods.artic      = buf_doc-line.artic
     8456                                            and buf_goods.prod-type  = buf_doc-line.prod-type
     8457                                            and buf_goods.prod-code  = buf_doc-line.prod-code .
