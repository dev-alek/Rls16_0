     4925                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     4926                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     4927                                          and utd-marking-lines-attr.mark      eq imark
     4928                                          and utd-marking-lines-attr.attr-code eq iattrcode
     4929      no-lock no-error.
     4930      if not available utd-marking-lines-attr
     4931      then do:
     4932         if iattrval ne ?
     4933            and iattrval ne ""
     4934         then do:
     4935            create utd-marking-lines-attr.
     4936            assign
     4937               utd-marking-lines-attr.db-num     = idb-num
     4938               utd-marking-lines-attr.doc-id     = idoc-id
     4939               utd-marking-lines-attr.lineNum    = ilineNum
     4940               utd-marking-lines-attr.mark       = imark
     4941               utd-marking-lines-attr.attr-code  = iattrcode
     4942               utd-marking-lines-attr.attr-value = iattrval
     4943            .
     4944         end.
     4945      end.
     4946      else do:
     4947         if utd-marking-lines-attr.attr-value ne iattrval
     4948         then do:
     4949            find current utd-marking-lines-attr exclusive-lock no-error.
     4950            if available utd-marking-lines-attr
     4951            then do:
     4952               if    iattrval eq ?
     4953                  or iattrval eq ""
     4954               then do:
     4955                  delete utd-marking-lines-attr.
     4956               end.
     4957               else do:
     4958                  utd-marking-lines-attr.attr-value = iattrval.
     4959               end.
     4960            end.
     4961         end.
