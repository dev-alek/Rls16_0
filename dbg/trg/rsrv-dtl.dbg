    10949                     v-qnty-sign = - 1
    10950                   .
    10951                 end.
    10952                 if archive_parts.cli-qnty <> v-qnty-sign
    10953                 then do:
    10954                   message
    10955                     vss-workfile vss-revision vss-description skip
    10956                     vss-include-info48 skip
    10957                     "Клиентское количество для товара," skip
    10958                     "который учитывается по двум единицам измерения" skip
    10959                     "должно равняться" v-qnty-sign skip
    10960                     "Документ" p-doc-code skip
    10961                     "Объект" p-obj-type p-obj-code skip
    10962                     "Артикул" p-artic p-prod-type p-prod-code skip
    10963                     "Партия" archive_parts.in-code archive_parts.part-code skip
    10964                     "Количество по документу" archive_parts.qnty skip
    10965                     "Фактическое количество" archive_parts.fact-qnty skip
    10966                     "Клиентское количество" archive_parts.cli-qnty skip
    10967                     view-as alert-box error .
    10968                   undo, return error .
    10969                 end.
    10970                 if archive_parts.fact-qnty = archive_parts.qnty
    10971                 then do:
    10972                   assign
    10973                     buf_parts.cli-qnty = buf_parts.cli-qnty + abs(archive_parts.cli-qnty)
    10974                   .
    10975                 end.
    10976                 else do:
    10977                   message
    10978                     vss-workfile vss-revision vss-description skip
    10979                     vss-include-info48 skip
    10980                     "Фактическое количество для товара," skip
    10981                     "который учитывается по двум единицам измерения" skip
    10982                     "должно равняться нулю или количеству по документу" skip
    10983                     "Документ" p-doc-code skip
    10984                     "Объект" p-obj-type p-obj-code skip
    10985                     "Артикул" p-artic p-prod-type p-prod-code skip
    10986                     "Партия" archive_parts.in-code archive_parts.part-code skip
    10987                     "Количество по документу" archive_parts.qnty skip
    10988                     "Фактическое количество" archive_parts.fact-qnty skip
    10989                     "Клиентское количество" archive_parts.cli-qnty skip
    10990                     view-as alert-box error .
    10991                   undo, return error .
    10992                 end.
    10993               end.
    10994               else do:
    10995                 if buf_parts.cli-base-rate <> 0
    10996                 then do:
    10997                   assign
    10998                     buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
    10999                   .
    11000                 end.
    11001                 else do:
    11002                   assign
    11003                     buf_parts.cli-qnty = 0
    11004                   .
    11005                 end.
    11006               end.
    11007               if  buf_parts.qnty      = 0
    11008               and buf_parts.fact-qnty = 0
    11009               then do:
    11010                 if v-goods-twounit = true
    11011                 then do:
    11012                   if buf_parts.cli-qnty <> 0
    11013                   then do:
    11014                     message
    11015                       vss-workfile vss-revision vss-description skip
    11016                       vss-include-info48 skip
    11017                       "Ошибка при удалении партии" skip
    11018                       "Документ" p-doc-code skip
    11019                       "Объект" p-obj-type p-obj-code skip
    11020                       "Артикул" p-artic p-prod-type p-prod-code skip
    11021                       "Партия" buf_parts.in-code buf_parts.part-code skip
    11022                       "Резерв" buf_parts.out-code skip
    11023                       "qnty" buf_parts.qnty skip
    11024                       "fact-qnty" buf_parts.fact-qnty skip
    11025                       "cli-qnty" buf_parts.cli-qnty skip
    11026                       view-as alert-box error .
    11027                     undo, return error .
    11028                   end.
    11029                 end.
    11030                 delete buf_parts .
    11031               end.
    11032             end.
    11033           end.
    11034           if  ( archive_parts.in-code = buf_trn-doc.doc-code
    11035           and archive_parts.supp-type =
    11036           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
    11037           and archive_parts.supp-code =
    11038           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
    11039           )
    11040           or buf_trn-doc.ext-doc-type = 'rv':U
    11041           then do:
    11042             if can-do('рас,спи':U,buf_trn-doc.doc-type)
    11043             or (buf_trn-doc.doc-type = 'инв':U
    11044                 and archive_parts.fact-qnty < 0
    11045               )
    11046             then do:
    11047               assign
    11048                 v-rsrv-code = 'free-zone':U
    11049               .
    11050             end.
    11051             else do:
    11052               assign
    11053                 v-rsrv-code = 'out-zone':U
    11054               .
    11055             end.
    11056             if not v-izlcstpr
    11057             then do :
    11058                 run partcopy in this-procedure
    11059                   (input  true
    11060                   ,input  v-rsrv-code
    11061                   ,buffer archive_parts
    11062                   ,buffer buf_parts
    11063                   ,input  ""
    11064                   ) no-error .
    11065                 if error-status :error
    11066                 then do:
    11067                   message
    11068                     vss-workfile vss-revision vss-description skip
    11069                     vss-include-info48 skip
    11070                     "Ошибка при создании партии" skip
    11071                     "Документ" p-doc-code skip
    11072                     "Объект" p-obj-type p-obj-code skip
    11073                     "Артикул" p-artic p-prod-type p-prod-code skip
    11074                     "Партия" archive_parts.in-code archive_parts.part-code skip
    11075                     "Резерв" v-rsrv-code skip
    11076                     error-status :get-message(1) skip
    11077                     return-value skip
    11078                     view-as alert-box error .
    11079                   undo, return error .
    11080                 end.
    11081                 assign
    11082                   buf_parts.qnty      = buf_parts.qnty - abs(archive_parts.fact-qnty)
    11083                   buf_parts.fact-qnty = buf_parts.qnty
    11084                 .
    11085                 if buf_trn-doc.ext-doc-type = 'rv':U
    11086                 then
    11087                 for each orig_marking-lines no-lock where orig_marking-lines.gds-code   = buf_goods.gds-code
    11088                                                       and orig_marking-lines.obj-type   = archive_parts.obj-type
    11089                                                       and orig_marking-lines.obj-code   = archive_parts.obj-code
    11090                                                       and orig_marking-lines.in-code    = archive_parts.in-code
    11091                                                       and orig_marking-lines.out-code   = archive_parts.out-code
    11092                                                       and orig_marking-lines.part-code  = archive_parts.part-code
    11093                                                       and orig_marking-lines.prt-code   = archive_parts.prt-code,
    11094                 first buf_marking exclusive-lock where buf_marking.mark = orig_marking-lines.mark :
    11095                   if buf_marking.sts = objSrv:Env:Marking:Sts:Mark:OutZone:KeyIntDB
    11096                   then
    11097                   assign buf_marking.sts = objSrv:Env:Marking:Sts:Mark:FreeZone:KeyIntDB .
    11098                 end .
    11099                 if v-goods-twounit = true
    11100                 then do:
    11101                   message
    11102                     vss-workfile vss-revision vss-description skip
    11103                     vss-include-info48 skip
    11104                     "Запрещено порождение партий," skip
    11105                     "который учитывается по двум единицам измерения" skip
    11106                     "Документ" p-doc-code skip
    11107                     "Объект" p-obj-type p-obj-code skip
    11108                     "Артикул" p-artic p-prod-type p-prod-code skip
    11109                     "Партия" archive_parts.in-code archive_parts.part-code skip
    11110                     "Количество по документу" archive_parts.qnty skip
    11111                     "Фактическое количество" archive_parts.fact-qnty skip
    11112                     "Клиентское количество" archive_parts.cli-qnty skip
    11113                     view-as alert-box error .
    11114                   undo, return error .
    11115                 end.
    11116                 else do:
    11117                   if buf_parts.cli-base-rate <> 0
    11118                   then do:
    11119                     assign
    11120                       buf_parts.cli-qnty = buf_parts.fact-qnty / buf_parts.cli-base-rate
    11121                     .
    11122                   end.
    11123                   else do:
    11124                     assign
    11125                       buf_parts.cli-qnty = 0
    11126                     .
    11127                   end.
    11128                 end.
    11129             end.
    11130           end.
    11131           get next partcopy-select-parts .
    11132         end.
    11133       end.
    11134     end.
    11135   end procedure.
    11136   procedure partcopy-update-parts-delete :
    11137     define input  parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
    11138     define input  parameter p-obj-type  like ub.doc-line.obj-type  no-undo .
    11139     define input  parameter p-obj-code  like ub.doc-line.obj-code  no-undo .
    11140     define input  parameter p-artic     like ub.doc-line.artic     no-undo .
    11141     define input  parameter p-prod-type like ub.doc-line.prod-type no-undo .
    11142     define input  parameter p-prod-code like ub.doc-line.prod-code no-undo .
    11143     define variable objMarks as class excisemarks no-undo.
    11144     define variable vss-description as character no-undo init "partcopy-update-parts-delete-01: процедура обработки партий при удалении документа".
    11145     define buffer buf_trn-doc    for ub.trn-doc .
    11146     define buffer archive_parts  for ub.parts .
    11147     define buffer buf_parts      for ub.parts .
    11148     define buffer buf_parts-attr for ub.parts-attr .
