    11152     define variable v-need-unrv as logical   no-undo .
    11153     define variable v-rsrv-sign as integer   no-undo .
    11154     define variable v-unrv-sign as integer   no-undo .
    11155     define variable v-goods-twounit as logical   no-undo .
    11156     define variable v-value-character as character no-undo .
    11157     define variable v-value-date      as date no-undo .
    11158     define variable v-value-decimal   as decimal no-undo .
    11159     define variable v-value-integer   as integer no-undo .
    11160     define variable v-izlcstpr        as logical no-undo .
    11161     define variable v-tth             as handle no-undo .
    11162     define variable v-type            as character no-undo .
    11163     define buffer buf_marking-lines for ub.marking-lines .
    11164     define buffer del_marking-lines for ub.marking-lines .
    11165     define buffer free_marking-lines for ub.marking-lines .
    11166     define buffer buf_marking for ub.marking .
    11167     define buffer buf_marking-chk for ub.marking-chk .
    11168     define buffer buf_chk-doc for ub.chk-doc .
    11169     define variable part-key-rec as character no-undo .
    11170     define variable part-key-rec_arhive   as character no-undo .
    11171     define buffer buf1_gen-attr for ub.gen-attr .
    11172     do
    11173     on error undo, return error return-value
    11174     :
    11175       find first buf_trn-doc no-lock
    11176         where buf_trn-doc.doc-code = p-doc-code
    11177         no-error .
    11178       if not available buf_trn-doc
    11179       then do:
    11180         message
    11181           vss-workfile vss-revision vss-description skip
    11182           vss-include-info48 skip
    11183           "Ошибка задания входных параметров" skip
    11184           "Не найден документ" skip
    11185           "Документ" p-doc-code skip
    11186           "Объект" p-obj-type p-obj-code skip
    11187           "Артикул" p-artic p-prod-type p-prod-code skip
    11188           error-status :get-message(1) skip
    11189           return-value skip
    11190           view-as alert-box error .
    11191         undo, return error .
    11192       end.
    11193       if buf_trn-doc.ext-doc-type = 'vt':U
    11194       then do :
    11195           delete object v-tth no-error.
    11196           run adm/shattri.p (
    11197              input "get":U
    11198             ,input buf_trn-doc.obj-type
    11199             ,input buf_trn-doc.obj-code
    11200             ,input 'inv-obj':U
    11201             ,input  "izlcstpr"
    11202             ,output v-value-character
    11203             ,output v-value-date
    11204             ,output v-value-decimal
    11205             ,output v-value-integer
    11206             ,output v-izlcstpr
    11207             ,output v-type
    11208             ,INPUT-OUTPUT table-handle v-tth
    11209             ) no-error .
    11210             delete object v-tth no-error.
    11211           if error-status:error then do:
    11212             v-izlcstpr = false .
    11213           end.
    11214       end.
    11215       else do :
    11216           v-izlcstpr = false .
    11217       end.
    11218   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11219   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
    11220     (input  p-artic
    11221     ,input  p-prod-type
    11222     ,input  p-prod-code
    11223     ,input  'twounit=request':u
    11224     ,output v-goods-twounit
    11225     ) no-error .
    11226       if error-status :error
    11227       then do:
    11228         message
    11229           vss-workfile vss-revision vss-description skip
    11230           vss-include-info48 skip
    11231           "Ошибка при определении атрибута товара" skip
    11232           "Артикул" p-artic p-prod-type p-prod-code skip
    11233           error-status :get-message(1) skip
    11234           return-value skip
    11235           view-as alert-box error .
    11236         undo, return error .
    11237       end.
    11238       define variable v-gds-code as integer   no-undo .
    11239   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
    11241     (input  p-artic
    11242     ,input  p-prod-type
    11243     ,input  p-prod-code
    11244     ,output v-gds-code
    11245     ) no-error .
    11246       for each archive_parts
    11247         where archive_parts.obj-type  = p-obj-type
    11248           and archive_parts.obj-code  = p-obj-code
    11249           and archive_parts.artic     = p-artic
    11250           and archive_parts.prod-type = p-prod-type
    11251           and archive_parts.prod-code = p-prod-code
    11252           and archive_parts.out-code  = p-doc-code
    11253       on error undo, return error return-value
    11254       :
    11255         if archive_parts.fact-qnty <> 0
    11256         then do:
    11257           define variable v-create-part as logical   no-undo .
    11258           define variable v-old-return  as logical   no-undo .
    11259           assign
    11260             v-create-part = false
    11261             v-old-return  = false
    11262           .
    11263           if archive_parts.in-code = buf_trn-doc.doc-code
    11264           then do:
    11265             assign
    11266               v-create-part = true
    11267             .
    11268             if archive_parts.supp-type <>
    11269           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-type else buf_trn-doc.obj-type )
    11270             or archive_parts.supp-code <>
    11271           ( if buf_trn-doc.doc-type = 'при':U then buf_trn-doc.cli-code else buf_trn-doc.obj-code )
    11272             then do:
    11273               assign
    11274                 v-old-return = true
    11275               .
    11276             end.
    11277           end.
    11278           define variable v-is-hold as logical   no-undo .
    11279   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11280   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
    11281     (input  buf_trn-doc.doc-code
    11282     ,output v-is-hold
    11283     ) no-error .
    11284           if error-status :error
    11285           then do:
    11286             message
    11287               vss-workfile vss-revision vss-description skip
    11288               vss-include-info48
    11289               "Ошибка при определении типа документа hold-doc.i" skip
    11290               "Документ" p-doc-code skip
    11291               "Объект" p-obj-type p-obj-code skip
    11292               "Артикул" p-artic p-prod-type p-prod-code skip
    11293               error-status :get-message(1) skip
    11294               return-value skip
    11295               view-as alert-box error .
    11296             undo, return error .
    11297           end.
    11298   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partcond in g#library
    11299     (input  buf_trn-doc.ext-doc-type
    11300     ,input  v-is-hold
    11301     ,input  archive_parts.fact-qnty
    11302     ,input  v-create-part
    11303     ,input  v-old-return
    11304     ,output v-rsrv-code
    11305     ,output v-unrv-code
    11306     ,output v-need-rsrv
    11307     ,output v-need-unrv
    11308     ,output v-rsrv-sign
    11309     ,output v-unrv-sign
    11310     ) no-error .
    11311           if error-status :error
    11312           then do:
    11313             message
    11314               vss-workfile vss-revision vss-description skip
    11315               vss-include-info48
    11316               "Ошибка при определении параметров резервирования партии" skip
    11317               "Документ" p-doc-code skip
    11318               "Объект" p-obj-type p-obj-code skip
    11319               "Артикул" p-artic p-prod-type p-prod-code skip
    11320               error-status :get-message(1) skip
    11321               return-value skip
    11322               view-as alert-box error .
    11323             undo, return error .
    11324           end.
    11325           if v-izlcstpr and archive_parts.fact-qnty > 0 then v-need-unrv = false .
    11326           if v-need-rsrv = true
    11327           then do:
    11328             release buf_parts no-error .
    11329             if archive_parts.out-code <> v-rsrv-code and v-rsrv-sign = -1 and v-izlcstpr
    11330             then do:
    11331                 find first buf_parts exclusive-lock
    11332                   where buf_parts.obj-type  = archive_parts.obj-type
    11333                     and buf_parts.obj-code  = archive_parts.obj-code
    11334                     and buf_parts.artic     = archive_parts.artic
    11335                     and buf_parts.prod-type = archive_parts.prod-type
    11336                     and buf_parts.prod-code = archive_parts.prod-code
    11337                     and buf_parts.in-code   = archive_parts.out-code
    11338                     and buf_parts.out-code  = v-rsrv-code
    11339                     and buf_parts.part-code = archive_parts.part-code
    11340                   no-error.
    11341             end .
    11342             if not available  buf_parts
    11343             then do :
    11344                 run partcopy in this-procedure
    11345                   (input  true
    11346                   ,input  v-rsrv-code
    11347                   ,buffer archive_parts
    11348                   ,buffer buf_parts
    11349                   ,input  ""
    11350                   ) no-error .
    11351                 if error-status :error
    11352                 then do:
    11353                   message
    11354                     vss-workfile vss-revision vss-description skip
    11355                     vss-include-info48 skip
    11356                     "Ошибка при создании партии" skip
    11357                     "Документ" p-doc-code skip
    11358                     "Объект" p-obj-type p-obj-code skip
    11359                     "Артикул" p-artic p-prod-type p-prod-code skip
    11360                     "Партия" archive_parts.in-code archive_parts.part-code skip
    11361                     "Необходимо резервировать" v-need-rsrv skip
    11362                     "Резерв" v-rsrv-code skip
    11363                     "Необходимо снятие резервов" v-need-unrv skip
    11364                     "Снятие резервов" v-unrv-code skip
    11365                     error-status :get-message(1) skip
    11366                     return-value skip
    11367                     view-as alert-box error .
    11368                   undo, return error .
    11369                 end.
    11370             end.
    11371             if new(buf_parts)
    11372             then do:
    11373   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
    11375     (input  p-artic
    11376     ,input  p-prod-type
    11377     ,input  p-prod-code
    11378     ,output v-gds-code
    11379     ) no-error .
    11380               if error-status :error
    11381               then do:
    11382                 message
    11383                   vss-workfile vss-revision vss-description skip
    11384                   vss-include-info48 skip
    11385                   "Ошибка при определении кода товара" skip
    11386                   "Документ" p-doc-code skip
    11387                   "Объект" p-obj-type p-obj-code skip
    11388                   "Артикул" p-artic p-prod-type p-prod-code skip
    11389                   "Партия" archive_parts.in-code archive_parts.part-code skip
    11390                   "Необходимо резервировать" v-need-rsrv skip
    11391                   "Резерв" v-rsrv-code skip
    11392                   "Необходимо снятие резервов" v-need-unrv skip
    11393                   "Снятие резервов" v-unrv-code skip
    11394                   error-status :get-message(1) skip
    11395                   return-value skip
    11396                   view-as alert-box error .
    11397                 undo, return error .
    11398               end.
