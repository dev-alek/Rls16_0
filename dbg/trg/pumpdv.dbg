        1   block-level on error undo, throw.
        2   DEFINE INPUT  PARAMETER pobj-type like ub.clients.obj-type     no-undo.
        3   DEFINE INPUT  PARAMETER pobj-code like ub.clients.obj-code     no-undo.
        4   DEFINE INPUT  PARAMETER ppump-code like ub.pump.pump-code        no-undo.
        5   DEFINE OUTPUT PARAMETER loc#log   as logical                   no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":u .
        7   define variable vss-author      as character no-undo init "$Author$":u .
        8   define variable vss-date        as character no-undo init "$Date$":u .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       10   define variable vss-archive     as character no-undo init "$Archive$":u .
       11   define variable vss-description as character no-undo init "Проверки возможности удаления ТРК" .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable v-shift-date as date      no-undo.
       82   define variable v-shift-num  as integer   no-undo.
       83   define variable v-shift-name as character no-undo.
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
       86     (input  pobj-type
       87     ,input  pobj-code
       88     ,output v-shift-date
       89     ,output v-shift-num
       90     ,output v-shift-name
       91     ) no-error .
       92   if not error-status:error and v-shift-num > 0 then  do:
       93     find first ub.rvs-doc no-lock where
       94                ub.rvs-doc.obj-type = pobj-type and
       95                ub.rvs-doc.obj-code = pobj-code and
       96                ub.rvs-doc.shift-date = v-shift-date and
       97                ub.rvs-doc.shift-num = v-shift-num and
       98                ub.rvs-doc.status_ = 'факт':U and
       99                ub.rvs-doc.rvs-type = 'смена':U no-error.
      100     if not avail ub.rvs-doc then do:
      101       return error
      102       ("объект " + pobj-type + string(pobj-code) + chr(10) +
      103        "не было сверки по текущей смене типа " + 'смена':U)
      104        .
      105     end.
      106   end.
      107   _deletion:
      108   do on error undo _deletion, return error return-value :
      109     for each ub.pl-pump-nozzle where
      110             ub.pl-pump-nozzle.obj-type = pobj-type and
      111             ub.pl-pump-nozzle.obj-code = pobj-code and
      112             ub.pl-pump-nozzle.pump-code = ppump-code:
      113       delete ub.pl-pump-nozzle no-error.
      114         if error-status:error then do:
      115           undo _deletion, return error ("Не удалось удалить запись pl-pump-nozzle " + chr(10) +
      116                                         "объект " + pobj-type + string(pobj-code) + chr(10) +
      117                                         "резервуар " + string(ub.pl-pump-nozzle.pl-code) + chr(10) +
      118                                         "ТРК " + string(ppump-code) +
      119                                         "пистолет " + string(ub.pl-pump-nozzle.nozzle-code)).
      120         end.
      121     end.
      122     for each ub.pl-gds-pump where
      123             ub.pl-gds-pump.obj-type  = pobj-type  and
      124             ub.pl-gds-pump.obj-code  = pobj-code  and
      125             ub.pl-gds-pump.pump-code = ppump-code on error undo, return error return-value :
      126       delete ub.pl-gds-pump no-error.
      127         if error-status:error then do:
      128           undo _deletion, return error ("Не удалось удалить запись pl-gds-pump " + chr(10) +
      129                                         "объект " + pobj-type + string(pobj-code) + chr(10) +
      130                                         "резервуар " + string(ub.pl-gds-pump.pl-code) + chr(10) +
      131                                         "топливо " + string(ub.pl-gds-pump.gds-code) + chr(10) +
      132                                         "ТРК " + string(ppump-code)).
      133         end.
      134     end.
      135     for each ub.pl-pump where
      136             ub.pl-pump.obj-type  = pobj-type  and
      137             ub.pl-pump.obj-code  = pobj-code  and
      138             ub.pl-pump.pump-code = ppump-code on error undo, return error return-value :
      139       delete ub.pl-pump no-error.
      140         if error-status:error then do:
      141           undo _deletion, return error ("Не удалось удалить запись pl-pump " + chr(10) +
      142                                         "объект " + pobj-type + string(pobj-code) + chr(10) +
      143                                         "резервуар " + string(ub.pl-pump.pl-code) + chr(10) +
      144                                         "ТРК " + string(ppump-code)).
      145         end.
      146     end.
      147     for each ub.pump-nozzle where
      148              ub.pump-nozzle.obj-type  = pobj-type and
      149              ub.pump-nozzle.obj-code  = pobj-code and
      150              ub.pump-nozzle.pump-code = ppump-code on error undo, return error return-value :
      151       delete ub.pump-nozzle no-error.
      152         if error-status:error then do:
      153           undo _deletion, return error ("Не удалось удалить запись pump-nozzle " + chr(10) +
      154                                         "объект " + pobj-type + string(pobj-code) + chr(10) +
      155                                         "ТРК " + string(ub.pump-nozzle.pump-code) + chr(10) +
      156                                         "пистолет " + string(ub.pump-nozzle.nozzle-code)).
      157         end.
      158     end.
      159   end.
      160   assign
      161   loc#log = yes.
