        1   block-level on error undo, throw.
        2   define input  parameter p-rowid as rowid no-undo .
        3   define output parameter p-db    as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Список БД для Маршрутизации price-all".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define temp-table x_obj-group no-undo like ub.clients  .
       81   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
       82   procedure metod-gop-obj :
       83     do
       84     on error undo, return error return-value
       85     :
       86   define input  parameter p-cntxt-db-num as integer   no-undo .
       87   define input  parameter p-gop-id       as integer   no-undo .
       88   define input  parameter p-gop-db-num   as integer   no-undo .
       89   define buffer buf1_clients for ub.clients  .
       90   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
       91   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
       92   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
       93   for each  x_obj-group : delete x_obj-group. end.
       94   if p-gop-id = 0 or p-gop-id = ?  then do:
       95      if p-cntxt-db-num = 0  then do:
       96           for each buf1_clients no-lock where
       97                   (buf1_clients.obj-type = 'маг':U  or
       98                    buf1_clients.obj-type = 'скл':U  )
       99                   and
      100                   buf1_clients.db-num >= 0  and
      101                   buf1_clients.stts = 0
      102                   :
      103             create x_obj-group .
      104             assign
      105               x_obj-group.obj-code   = buf1_clients.obj-code
      106               x_obj-group.obj-type   = buf1_clients.obj-type
      107               x_obj-group.obj-name   = buf1_clients.obj-name
      108               x_obj-group.db-num     = buf1_clients.db-num
      109             .
      110           end.
      111      end.
      112      else do:
      113           for each buf1_clients no-lock where
      114                   (buf1_clients.obj-type = 'маг':U  or
      115                    buf1_clients.obj-type = 'скл':U  ) and
      116                    buf1_clients.db-num = p-cntxt-db-num  and
      117                    buf1_clients.stts = 0
      118                   :
      119             create x_obj-group .
      120             assign
      121               x_obj-group.obj-code   = buf1_clients.obj-code
      122               x_obj-group.obj-type   = buf1_clients.obj-type
      123               x_obj-group.obj-name   = buf1_clients.obj-name
      124               x_obj-group.db-num     = buf1_clients.db-num
      125             .
      126           end.
      127      end.
      128   end.
      129   else do:
      130         for each buf_db-grp-obj-price  where
      131                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      132                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      133                 buf_db-grp-obj-price.stts = 0  no-lock :
      134           for each buf1_clients no-lock where
      135                  (buf1_clients.obj-type = 'маг':U  or
      136                   buf1_clients.obj-type = 'скл':U  ) and
      137                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      138                   buf1_clients.stts = 0
      139                   :
      140             create x_obj-group .
      141             assign
      142               x_obj-group.obj-code   = buf1_clients.obj-code
      143               x_obj-group.obj-type   = buf1_clients.obj-type
      144               x_obj-group.obj-name   = buf1_clients.obj-name
      145               x_obj-group.db-num     = buf1_clients.db-num
      146             .
      147           end.
      148         end.
      149       for each buf_host-grp-obj-price where
      150               buf_host-grp-obj-price.gop-id     = p-gop-id and
      151               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      152               buf_host-grp-obj-price.stts = 0
      153               no-lock :
      154         for each buf1_clients no-lock where
      155                (buf1_clients.obj-type = 'маг':U  or
      156                 buf1_clients.obj-type = 'скл':U  ) and
      157                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      158                 buf1_clients.stts = 0
      159                 :
      160             find first x_obj-group no-lock  where
      161                       x_obj-group.obj-code   = buf1_clients.obj-code and
      162                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      163             if not available  x_obj-group then   create x_obj-group .
      164             assign
      165               x_obj-group.obj-code   = buf1_clients.obj-code
      166               x_obj-group.obj-type   = buf1_clients.obj-type
      167               x_obj-group.obj-name   = buf1_clients.obj-name
      168               x_obj-group.db-num     = buf1_clients.db-num
      169             .
      170         end.
      171       end.
      172       for each buf_obj-grp-obj-price where
      173               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      174               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      175               buf_obj-grp-obj-price.stts = 0
      176               no-lock :
      177         for each buf1_clients no-lock where
      178                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      179                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      180                   buf1_clients.stts     = 0
      181                   :
      182             find first  x_obj-group no-lock  where
      183                         x_obj-group.obj-code   = buf1_clients.obj-code and
      184                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      185             if not available  x_obj-group then   create x_obj-group .
      186             assign
      187               x_obj-group.obj-code   = buf1_clients.obj-code
      188               x_obj-group.obj-type   = buf1_clients.obj-type
      189               x_obj-group.obj-name   = buf1_clients.obj-name
      190               x_obj-group.db-num     = buf1_clients.db-num
      191             .
      192         end.
      193       end.
      194   end.
      195   end.
      196   end procedure.
      197   procedure metod-obj-in-gop :
      198   define input  parameter p-curr-db-num as integer   no-undo .
      199   define input  parameter p-obj-type as character no-undo .
      200   define input  parameter p-obj-code as integer   no-undo .
      201   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      202     do
      203     on error undo, return error return-value
      204     :
      205       empty temp-table x_grp-obj-price.
      206       for each buf_grp-obj-price where
      207                buf_grp-obj-price.stts = 0
      208                no-lock :
      209                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      210                  for each x_obj-group where
      211                           x_obj-group.obj-type = p-obj-type and
      212                           x_obj-group.obj-code = p-obj-code :
      213                       create  x_grp-obj-price.
      214                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      215                  end.
      216       end.
      217     end.
      218   end procedure.
      219   procedure metod-delobj-usr :
      220   define input  parameter p-pdf-id  as integer   no-undo .
      221   define input  parameter p-pdf-db  as integer   no-undo .
      222   define input  parameter p-plt-id  as integer   no-undo .
      223   define input  parameter p-plt-db-num as integer   no-undo .
      224   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      225     do
      226     on error undo, return error return-value
      227     :
      228   for each buf_price-doc-forming-attr no-lock  where
      229            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      230            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      231            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      232            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      233            buf_price-doc-forming-attr.attr-code begins "obj" :
      234      for each x_obj-group  where
      235               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      236               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      237        delete x_obj-group.
      238      end.
      239   end.
      240     if not can-find (first x_obj-group) then do:
      241        return "nullobj" .
      242     end.
      243   end.
      244   end procedure.
      245   procedure metod-obj-pdf :
      246   define input  parameter p-cntxt-db-num as integer   no-undo .
      247   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      248   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      249   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      250   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      251   define buffer buf_price-list-type for ub.price-list-type  .
      252   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      253     do
      254     on error undo, return error return-value
      255     :
      256    for each  x_obj-group : delete x_obj-group. end.
      257    find first buf_price-list-type no-lock where
      258               buf_price-list-type.plt-id = p-plt-id and
      259               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      260   if error-status :error then return error return-value .
      261    find first buf_price-doc-forming no-lock where
      262               buf_price-doc-forming.plt-id     = p-plt-id and
      263               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      264               buf_price-doc-forming.pdf-id     = p-pdf-id and
      265               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      266               no-error .
      267   if error-status :error then return error return-value .
      268     run metod-gop-obj in this-procedure (
      269         p-cntxt-db-num,
      270         buf_price-list-type.gop-id ,
      271         buf_price-list-type.gop-db-num
      272         ) no-error .
      273     run metod-delobj-usr in this-procedure (
      274       buf_price-doc-forming.pdf-id ,
      275       buf_price-doc-forming.pdf-db ,
      276       buf_price-doc-forming.plt-id ,
      277       buf_price-doc-forming.plt-db-num
      278       ) no-error .
      279     end.
      280   end procedure.
      281   define buffer buf_price-all   for ub.price-all  .
      282   define variable v-db as integer   no-undo .
      283   define variable v-par-m as character no-undo .
      284   main-block :
      285   do on error undo main-block, return error
      286   :
      287   p-db  = "" .
      288   find first buf_price-all   no-lock where rowid(buf_price-all) = p-rowid  no-error .
      289   if error-status :error then return .
      290   find first ub.global-state no-lock no-error .
      291   if error-status :error then return error return-value .
      292   find first ub.global-state-attr no-lock where
      293              ub.global-state-attr.gls-id =  ub.global-state.gls-id and
      294              ub.global-state-attr.attr-code = 'pal-nws':U no-error .
      295   if available ub.global-state-attr then
      296           v-par-m =  ub.global-state-attr.attr-value .
      297      else v-par-m = ''.
      298     if v-par-m = 'yes' then do:
      299         if g#db-num = 0 then do:
      300   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      302     (input  buf_price-all.obj-type
      303     ,input  buf_price-all.obj-code
      304     ,output v-db
      305     ) no-error .
      306             if error-status :error then p-db = "".
      307             p-db = string(v-db) .
      308             if v-db = 0 then p-db = "".
      309         end.
      310         else do:
      311           p-db = "0" .
      312         end.
      313     end.
      314     else do:
      315       run trg/pdf-db.p ( input  buf_price-all.plt-db-num ,
      316                          input  buf_price-all.plt-id     ,
      317                          output p-db
      318                         ).
      319     end.
      320    end.
