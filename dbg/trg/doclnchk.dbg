        1   block-level on error undo, throw.
        2   define input parameter p-doc-code  like ub.doc-line.doc-code  no-undo .
        3   define input parameter p-artic     like ub.doc-line.artic     no-undo .
        4   define input parameter p-prod-type like ub.doc-line.prod-type no-undo .
        5   define input parameter p-prod-code like ub.doc-line.prod-code no-undo .
        6   define input parameter l-check-cli-qnty as logical no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Проверка целостности строки документа".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure partrqst :
       73     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
       74     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
       75     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
       76     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
       77     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
       78     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
       79     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
       80     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
       81     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
       82     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
       83     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
       84     define output parameter p-total-parts-price-base     as decimal                 no-undo .
       85     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
       86     define output parameter p-total-parts-transport-base as decimal                 no-undo .
       87     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
       88     define output parameter p-total-parts-other-base     as decimal                 no-undo .
       89     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
       90     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
       91     do
       92     on error undo, return error return-value
       93     :
       94       assign
       95         p-total-parts-qnty           = 0
       96         p-total-parts-fact-qnty      = 0
       97         p-total-parts-cli-qnty       = 0
       98         p-total-parts-fact-cli-qnty  = 0
       99         p-total-parts-price-cli      = 0
      100         p-total-parts-price-base     = 0
      101         p-total-parts-price-rubl     = 0
      102         p-total-parts-transport-base = 0
      103         p-total-parts-transport-rubl = 0
      104         p-total-parts-other-base     = 0
      105         p-total-parts-other-rubl     = 0
      106       .
      107       define buffer buf_parts for ub.parts .
      108       for each buf_parts no-lock
      109         where buf_parts.out-code  = p-doc-code
      110           and buf_parts.obj-type  = p-obj-type
      111           and buf_parts.obj-code  = p-obj-code
      112           and buf_parts.artic     = p-artic
      113           and buf_parts.prod-type = p-prod-type
      114           and buf_parts.prod-code = p-prod-code
      115       on error undo, return error return-value
      116       :
      117         define variable v-parts-fact-multiplier as decimal   no-undo .
      118         assign
      119           v-parts-fact-multiplier = 1
      120         .
      121         if buf_parts.qnty <> 0 then do:
      122           assign
      123             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      124           .
      125         end.
      126         assign
      127           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      128           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      129           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      130           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      131                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      132           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      133           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      134           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      135           p-total-parts-transport-base  = p-total-parts-transport-base
      136                                         + buf_parts.fact-qnty
      137                                           * (if   buf_parts.transport-base <> ?
      138                                             then buf_parts.transport-base
      139                                             else 0
      140                                             )
      141           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      142                                         + buf_parts.fact-qnty
      143                                           * (if   buf_parts.transport-rubl <> ?
      144                                             then buf_parts.transport-rubl
      145                                             else 0
      146                                             )
      147           p-total-parts-other-base      = p-total-parts-other-base
      148                                         + buf_parts.fact-qnty
      149                                           * (if   buf_parts.other-base <> ?
      150                                             then buf_parts.other-base
      151                                             else 0
      152                                             )
      153           p-total-parts-other-rubl      = p-total-parts-other-rubl
      154                                         + buf_parts.fact-qnty
      155                                           * (if   buf_parts.other-rubl <> ?
      156                                             then buf_parts.other-rubl
      157                                             else 0
      158                                             )
      159         .
      160       end.
      161     end.
      162   end procedure.
      163   define variable v-total-gds-dtl-doc-qnty  like ub.gds-dtl.doc-qnty  no-undo .
      164   define variable v-total-gds-dtl-fact-qnty like ub.gds-dtl.fact-qnty no-undo .
      165   do
      166   on error undo, return error
      167   :
      168     find first ub.doc-line no-lock
      169       where ub.doc-line.doc-code  = p-doc-code
      170         and ub.doc-line.artic     = p-artic
      171         and ub.doc-line.prod-type = p-prod-type
      172         and ub.doc-line.prod-code = p-prod-code
      173       no-error .
      174     if not available ub.doc-line then do:
      175       message
      176         vss-workfile vss-revision vss-description skip
      177         "Не найдена строка документа" skip
      178         "Документ" p-doc-code skip
      179         "Артикул" p-artic p-prod-type p-prod-code skip
      180         view-as alert-box error .
      181       undo, return error .
      182     end.
      183     find first ub.trn-doc no-lock
      184       where ub.trn-doc.doc-code = ub.doc-line.doc-code
      185       no-error .
      186     if not available ub.trn-doc then do:
      187       message
      188         vss-workfile vss-revision vss-description skip
      189         "Не найден документ" skip
      190         "Документ" p-doc-code skip
      191         view-as alert-box error .
      192       undo, return error .
      193     end.
      194     define variable v-obj-type like ub.doc-line.obj-type no-undo .
      195     define variable v-obj-code like ub.doc-line.obj-code no-undo .
      196     assign
      197       v-obj-type = ub.doc-line.obj-type
      198       v-obj-code = ub.doc-line.obj-code
      199     .
      200     assign
      201       v-total-gds-dtl-doc-qnty  = 0
      202       v-total-gds-dtl-fact-qnty = 0
      203     .
      204     for each gds-dtl no-lock
      205       where gds-dtl.doc-code  = p-doc-code
      206         and gds-dtl.artic     = p-artic
      207         and gds-dtl.prod-type = p-prod-type
      208         and gds-dtl.prod-code = p-prod-code
      209     :
      210       assign
      211         v-total-gds-dtl-doc-qnty  = v-total-gds-dtl-doc-qnty  + ub.gds-dtl.doc-qnty
      212         v-total-gds-dtl-fact-qnty = v-total-gds-dtl-fact-qnty + ub.gds-dtl.fact-qnty
      213       .
      214     end.
      215       define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
      216     run partrqst in this-procedure
      217       (input  p-doc-code
      218       ,input  v-obj-type
      219       ,input  v-obj-code
      220       ,input  p-artic
      221       ,input  p-prod-type
      222       ,input  p-prod-code
      223           ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
      224       ).
      225     if ub.trn-doc.doc-type <> 'инв':U then do:
      226       if v-total-parts-qnty <> v-total-gds-dtl-doc-qnty
      227       then do:
      228         message
      229           "Количество по всем партиям не сооветствует количеству по всем признакам" skip
      230           "Документ" p-doc-code skip
      231           "Артикул" p-artic p-prod-type p-prod-code skip
      232           "Количество по всем партиям:" v-total-parts-qnty skip
      233           "Количества по всем признакам:" v-total-gds-dtl-doc-qnty skip
      234           view-as alert-box .
      235         undo, return error .
      236       end.
      237     end.
      238     if ub.trn-doc.doc-type <> 'инв':U then do:
      239       if ub.trn-doc.status_ <> 'касс':U then do:
      240         if v-total-parts-fact-qnty <> v-total-gds-dtl-fact-qnty
      241         then do:
      242           message
      243             "Фактическое количество по всем партиям не сооветствует" skip
      244             "фактическому количеству по всем признакам" skip
      245             "Документ" p-doc-code skip
      246             "Артикул" p-artic p-prod-type p-prod-code skip
      247             "Фактическое количество по всем партиям:" v-total-parts-fact-qnty skip
      248             "Фактическое количества по всем признакам:" v-total-gds-dtl-fact-qnty skip
      249             view-as alert-box .
      250           undo, return error .
      251         end.
      252       end.
      253     end.
      254     if l-check-cli-qnty then do:
      255       if v-total-parts-qnty = doc-line.doc-qnty then do:
      256         if v-total-parts-cli-qnty <> ub.doc-line.cli-qnty then do:
      257           message
      258             "Количество по ТТН по всем партиям не сооветствует" skip
      259             "количеству по ТТН накладной" skip
      260             "Документ" p-doc-code skip
      261             "Артикул" p-artic p-prod-type p-prod-code skip
      262             "Количество по ТТН по всем партиям:" v-total-parts-cli-qnty skip
      263             "Количество по ТТН накладной:" ub.doc-line.cli-qnty skip
      264             view-as alert-box .
      265           undo, return error .
      266         end.
      267       end.
      268     end.
      269   end.
