        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.dis-card .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление записи Дисконтная карта".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   procedure discardh_write-dis-card-trigger :
      305   define input parameter p-new-record as logical no-undo .
      306   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      307   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      308   define variable v-date as date      no-undo.
      309   define variable v-time  as integer   no-undo.
      310   define buffer buf_c-dc-hist for ub.c-dc-hist.
      311   define buffer buf_c-dis-card for ub.c-dis-card.
      312     do
      313     on error undo, return error
      314     :
      315       run cur-time in this-procedure(output v-date, output v-time).
      316       create buf_c-dis-card.
      317       buffer-copy ub.dis-card to buf_c-dis-card
      318       assign
      319       buf_c-dis-card.d-card            = ub.dis-card.d-card
      320       buf_c-dis-card.card-num          = ub.dis-card.card-num
      321       buf_c-dis-card.chip-num           = next-value (s-dc-chip, ub)
      322       buf_c-dis-card.corr-time          = v-time
      323       buf_c-dis-card.corr-user-db-num   = g#db-num
      324       buf_c-dis-card.corr-user-name     = (if g#news
      325                                            then (chr(4) +  'СПН':U)
      326                                            else (if g#esys
      327                                                  then (chr(4) +  'ВС':U)
      328                                                  else g#userid
      329                                                 )
      330                                            )
      331       buf_c-dis-card.corr-date          = v-date
      332       .
      333       create buf_c-dc-hist.
      334       buffer-copy buf_c-dis-card to buf_c-dc-hist
      335       assign
      336       buf_c-dc-hist.action = integer('99':U)
      337       buf_c-dc-hist.subject = 'dis-card':U
      338       buf_c-dc-hist.host-code = ub.dis-card.emitent-host-code
      339       buf_c-dc-hist.is-news = g#news
      340       buf_c-dc-hist.source-type = p-source-type
      341       buf_c-dc-hist.source-ref = p-source-ref
      342       .
      343       if not ( g#db-num > 0 )
      344       or (g#news
      345           and ( g#db-num > 0 )
      346           and buf_c-dis-card.corr-user-name = (chr(4) +  'СПН':U)
      347           )
      348       then do:
      349         run str/callnews.p
      350           (input 'c-dis-card':U
      351           ,input (buffer buf_c-dis-card:handle)
      352           ).
      353       end.
      354     end.
      355   end procedure.
      356   define buffer buf_dis-obj             for ub.dis-obj.
      357   define buffer buf_dis-host            for ub.dis-host.
      358   define buffer buf_c-dc-hist           for ub.c-dc-hist .
      359   define buffer buf_c-dis-obj           for ub.c-dis-obj .
      360   define buffer buf_c-dis-host          for ub.c-dis-host .
      361   define buffer buf_dis-card-property   for ub.dis-card-property.
      362   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
      363   define buffer buf_dis-dc-rule         for ub.dis-dc-rule.
      364   define buffer buf_c-dis-dc-rule       for ub.c-dis-dc-rule.
      365   main-block:
      366   do
      367       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      368       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      369       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      370       :
      371       if ub.dis-card.status_ <> 'неисп':U then
      372       do:
      373           message
      374               vss-workfile vss-revision vss-description skip
      375               "Физическое удаление дисконтной карты возможно только для НЕИСПОЛЬЗОВАВШИХСЯ карт" skip
      376               view-as alert-box error .
      377           undo main-block, return error.
      378       end.
      379       for each buf_dis-card-property where
      380           buf_dis-card-property.d-card = ub.dis-card.d-card
      381           on error undo main-block, return error
      382           on stop undo main-block, return error:
      383           find first ub.dis-card-property where
      384               recid(ub.dis-card-property) = recid(buf_dis-card-property) .
      385           assign
      386               ub.dis-card-property.card-num = - abs(ub.dis-card-property.card-num).
      387           delete ub.dis-card-property.
      388       end.
      389       for each buf_dis-obj where
      390           buf_dis-obj.d-card = ub.dis-card.d-card
      391           on error undo main-block, return error
      392           on stop undo main-block, return error:
      393           find first ub.dis-obj where
      394               recid(ub.dis-obj) = recid(buf_dis-obj) .
      395           assign
      396               ub.dis-obj.card-num = - abs(ub.dis-obj.card-num).
      397           delete ub.dis-obj.
      398       end.
      399       for each buf_dis-host where
      400           buf_dis-host.d-card = ub.dis-card.d-card
      401           on error undo main-block, return error
      402           on stop undo main-block, return error:
      403           find first ub.dis-host where
      404               recid(ub.dis-host) = recid(buf_dis-host) .
      405           assign
      406               ub.dis-host.card-num = - abs(ub.dis-host.card-num).
      407           delete ub.dis-host.
      408       end.
      409       for each buf_c-dis-card-property where
      410           buf_c-dis-card-property.d-card = ub.dis-card.d-card
      411           on error undo main-block, return error
      412           on stop undo main-block, return error:
      413           find first ub.c-dis-card-property where
      414               recid(ub.c-dis-card-property) = recid(buf_c-dis-card-property) .
      415           assign
      416               ub.c-dis-card-property.card-num = - abs(ub.c-dis-card-property.card-num).
      417           delete ub.c-dis-card-property.
      418       end.
      419       for each buf_c-dis-obj where
      420           buf_c-dis-obj.d-card = ub.dis-card.d-card
      421           on error undo main-block, return error
      422           on stop undo main-block, return error:
      423           find first ub.c-dis-obj where
      424               recid(ub.c-dis-obj) = recid(buf_c-dis-obj) .
      425           assign
      426               ub.c-dis-obj.card-num = - abs(ub.c-dis-obj.card-num).
      427           delete ub.c-dis-obj.
      428       end.
      429       for each buf_c-dis-host where
      430           buf_c-dis-host.d-card = ub.dis-card.d-card
      431           on error undo main-block, return error
      432           on stop undo main-block, return error:
      433           find first ub.c-dis-host where
      434               recid(ub.c-dis-host) = recid(buf_c-dis-host) .
      435           assign
      436               ub.c-dis-host.card-num = - abs(ub.c-dis-host.card-num).
      437           delete ub.c-dis-host.
      438       end.
      439       for each buf_c-dc-hist where
      440           buf_c-dc-hist.d-card = ub.dis-card.d-card
      441           on error undo main-block, return error
      442           on stop undo main-block, return error:
      443           if buf_c-dc-hist.subject <> 'dis-card':U then
      444           do:
      445               find first ub.c-dc-hist where
      446                   recid(ub.c-dc-hist) = recid(buf_c-dc-hist) .
      447               assign
      448                   ub.c-dc-hist.card-num = - abs(ub.c-dc-hist.card-num).
      449               delete ub.c-dc-hist.
      450           end.
      451       end.
      452       for each buf_dis-card-property where
      453           buf_Dis-card-property.d-card = ub.dis-card.d-card
      454           on error undo main-block, return error
      455           on stop undo main-block, return error:
      456           assign
      457               buf_Dis-card-property.card-num = - abs(buf_dis-card-property.card-num).
      458           delete buf_dis-card-property.
      459       end.
      460       for each buf_c-dis-card-property where
      461           buf_c-Dis-card-property.d-card = ub.dis-card.d-card
      462           on error undo main-block, return error
      463           on stop undo main-block, return error:
      464           assign
      465               buf_c-Dis-card-property.card-num = - abs(buf_c-dis-card-property.card-num).
      466           delete buf_c-dis-card-property.
      467       end.
      468       for each buf_dis-dc-rule where
      469           buf_dis-dc-rule.d-card = ub.dis-card.d-card
      470           on error undo main-block, return error
      471           on stop undo main-block, return error:
      472           assign
      473               buf_Dis-dc-rule.card-num = - abs(buf_dis-dc-rule.card-num).
      474           delete buf_dis-dc-rule.
      475       end.
      476       for each buf_c-dis-dc-rule where
      477           buf_c-dis-dc-rule.d-card = ub.dis-card.d-card
      478           on error undo main-block, return error
      479           on stop undo main-block, return error:
      480           assign
      481               buf_c-Dis-dc-rule.card-num = - abs(buf_c-dis-dc-rule.card-num).
      482           delete buf_c-dis-dc-rule.
      483       end.
      484       run discardh_write-dis-card-trigger in this-procedure  (
      485           input no
      486           ,input (if g#news
      487           then 'db':U
      488           else (if g#esys
      489           then 'esys':U
      490           else "":U)
      491           )
      492           ,input  (if g#news
      493           then string(g#news-source-db)
      494           else (if g#esys
      495           then string(g#esys-source-esys)
      496           else "":U)
      497           )
      498           ) .
      499       if g#oxml = yes
      500           then
      501       do:
      502           run str/calloxml.p (
      503               input 'delete':U
      504               , input 'dis-card':U
      505               , input ( buffer ub.dis-card:handle )
      506               ) no-error.
      507           if error-status :error
      508               then
      509           do:
      510               undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      511                   , chr(10)
      512                   , vss-workfile
      513                   , return-value
      514                   , error-status :get-message ( 1 ) ).
      515           end.
      516       end.
      517       run trg/userlog.p (
      518           input 'delete':U
      519           , input 'dis-card':U
      520           , input ( buffer ub.dis-card :handle )
      521           , input ?
      522           , input ""
      523           ) no-error.
      524       if error-status :error
      525           then
      526       do:
      527           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      528               , chr(10)
      529               , vss-workfile
      530               , return-value
      531               , error-status :get-message ( 1 ) ).
      532       end.
      533   end.
