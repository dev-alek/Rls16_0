        1   block-level on error undo, throw.
        2   DEFINE TEMP-TABLE x_parts LIKE ub.parts.
        3   define input  parameter p-doc-code as character no-undo .
        4   define input  parameter table for x_parts.
        5   define input  parameter p-comand-type as character no-undo .
        6   define input  parameter p-db-list     as character no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Отправка в новости temp-table like parts".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable v-cmd-proc-handle as handle    no-undo .
       72   define variable v-cmd-code        as integer   no-undo .
       73   define variable v-db-list as character no-undo .
       74   define variable v-rec-ord as integer no-undo .
       75   do
       76   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       77   on stop   undo, return error substitute( "&1. stop", vss-workfile )
       78   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       79   :
       80     run nws/cmd-bush.p persistent set v-cmd-proc-handle
       81       no-error .
       82     if error-status :error
       83     then do:
       84       message
       85         vss-workfile vss-revision vss-description skip
       86         substitute("Ошибка при запуске процедуры cmd-bush.p") skip
       87         error-status :get-message(1) skip
       88         return-value skip
       89         view-as alert-box error .
       90       delete procedure v-cmd-proc-handle .
       91       undo, return error return-value .
       92     end.
       93     define variable v-command as character no-undo .
       94     v-command =  substitute("&2&1&3&1&4&1&5&1&6&1&7"
       95                 , chr(6)
       96                 , 'cmd-parts-fact-corr':U
       97                 , p-comand-type
       98                 , p-doc-code
       99                 ).
      100     v-db-list = p-db-list .
      101     run begin-create-command in v-cmd-proc-handle
      102       (input  v-command
      103       ,input  v-db-list
      104       ,output v-cmd-code
      105       ) no-error.
      106     if error-status :error
      107     then do:
      108       message
      109         vss-workfile vss-revision vss-description skip
      110         substitute( "Ошибка при создании команды &1", 'cmd-parts-fact-corr':U ) skip
      111         error-status :get-message(1) skip
      112         return-value skip
      113         view-as alert-box error .
      114       delete procedure v-cmd-proc-handle .
      115       undo, return error return-value .
      116     end.
      117     for each x_parts exclusive-lock
      118     on error undo, return error return-value
      119     :
      120       run add-dump in v-cmd-proc-handle
      121         (input v-cmd-code
      122         ,input 'parts':U
      123         ,input '+update':U
      124         ,input (buffer x_parts :handle)
      125         ,input '':U
      126         ,output v-rec-ord
      127         ) no-error .
      128       if error-status :error
      129       then do:
      130         message
      131           vss-workfile vss-revision vss-description skip
      132           substitute( "Ошибка при добавлении записи &1 в команду с кодом &2", 'parts':U, v-cmd-code ) skip
      133           error-status :get-message(1) skip
      134           return-value skip
      135           view-as alert-box error .
      136         delete procedure v-cmd-proc-handle .
      137         undo, return error return-value .
      138       end.
      139     end.
      140     run send-command in v-cmd-proc-handle
      141       ( input v-cmd-code
      142        ,input p-db-list
      143       ) no-error .
      144     if error-status :error then do:
      145       message
      146         vss-workfile vss-revision vss-description skip
      147         substitute( "Ошибка при отправке в новости команды с кодом &1", v-cmd-code ) skip
      148         error-status :get-message(1) skip
      149         return-value skip
      150         view-as alert-box error .
      151       delete procedure v-cmd-proc-handle .
      152       undo, return error return-value .
      153     end.
      154     delete procedure v-cmd-proc-handle .
      155   end.
