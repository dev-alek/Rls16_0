        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.price-list-type OLD old_price-list-type.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Тригер на корректировку ТПЛ для ценообразованиЯ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   define variable v-waitfram-action01         as character   no-undo .
      305   define variable v-waitfram-action02         as character   no-undo .
      306   define variable v-waitfram-action03         as character   no-undo .
      307   define variable mWaitFramTextBeg            as character   no-undo.
      308   define variable mWaitFramTextEnd            as character   no-undo.
      309   define variable mWaitFramView               as logical     no-undo.
      310   define variable mWaitProcEvent              as logical     no-undo init yes.
      311   define variable mWaitFramInterval           as integer     no-undo init 1 .
      312   define variable mWaitFramStop               as logical     no-undo.
      313   define variable mWaitFramStopUser           as logical     no-undo.
      314   define variable mWaitFramStopTimeOut        as logical     no-undo.
      315   define variable mWaitFramStartProc          as datetime-tz no-undo.
      316   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      317   define button B-WaitFramStop auto-end-key
      318        label "Стоп"
      319        size 10 by 1 tooltip "Остоновить процесс".
      320   define button B-viewProcInfo
      321        label "Информация"
      322        size 15 by 1 tooltip "Информация о процесс".
      323   define frame waitfram
      324     v-waitfram-action01 format "x(72)" no-label skip
      325     v-waitfram-action02 format "x(72)" no-label skip
      326     v-waitfram-action03 format "x(72)" no-label skip
      327     B-viewProcInfo
      328     B-WaitFramStop at row 4 col 30
      329     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      330     .
      331   define new global shared variable mBatchMode as logical no-undo init ?.
      332   define variable mFramBachModHandle as handle no-undo.
      333   mFramBachModHandle = frame waitfram:handle.
      334   define variable mFameOldVis as logical no-undo.
      335   define variable mVisCUrentVin as logical no-undo.
      336   if session:batch-mode
      337   then
      338      mBatchMode = yes.
      339   if mBatchMode = ? then do:
      340     mVisCUrentVin = current-window:visible.
      341     mFameOldVis = mFramBachModHandle:visible.
      342     mFramBachModHandle:visible  = yes.
      343     mBatchMode = mFramBachModHandle:visible ne yes.
      344     mFramBachModHandle:visible = mFameOldVis.
      345     current-window:visible = mVisCUrentVin.
      346   end.
      347    if  log-manager:logfile-name ne ?
      348     then DO:
      349         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      350         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      351         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      352     end.
      353   on choose of B-WaitFramStop in frame waitfram
      354   do:
      355     mWaitFramStop = yes.
      356     mWaitFramStopUser = yes.
      357   end.
      358   function waitfram-check-timeout returns logical():
      359      define variable vtime as int64 no-undo.
      360      if mWaitFramStopTimeOut
      361      then
      362         return yes.
      363      vtime = ( now - mWaitFramStartProc ) / 1000 .
      364      if     mWaitFramTimeOut ne ?
      365         and mWaitFramTimeOut ne 0
      366         and mWaitFramTimeOut lt vtime
      367      then do:
      368         mWaitFramStopTimeOut = yes.
      369      end.
      370      return mWaitFramStopTimeOut.
      371   end.
      372   procedure waitfram-hide :
      373     if not session:batch-mode
      374     then do
      375     on error undo, return error return-value
      376     :
      377       pause 0 before-hide .
      378       if not mBatchMode then
      379         hide frame waitfram .
      380     if     not mWaitFramView
      381        and mWaitProcEvent
      382     then
      383       process events .
      384     end.
      385   end procedure.
      386   procedure waitfram-show :
      387     define input  parameter p-message as character no-undo .
      388     define variable v-left-margin as integer   no-undo .
      389     if not session:batch-mode
      390     then do
      391     on error undo, return error return-value
      392     :
      393       if length(p-message) <= 70 then do:
      394         assign
      395           v-left-margin = integer((70 - length(p-message)) / 2)
      396         .
      397         assign
      398           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      399         .
      400         assign
      401           v-waitfram-action01 = " "
      402           v-waitfram-action02 = " "
      403                                    + fill(" ", v-left-margin)
      404                                    + p-message
      405           v-waitfram-action03 = " "
      406         .
      407       end.
      408       else do:
      409         define variable vRindex1 as integer no-undo.
      410         define variable vRindex2 as integer no-undo.
      411         vRindex1 = r-index(p-message," ",70).
      412         if vRindex1 = 0
      413         then
      414            vRindex1 = 70.
      415         if length(p-message)  <= vRindex1 + 70 then do:
      416           assign
      417             v-waitfram-action01 = " "
      418             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      419             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      420           .
      421         end.
      422         else do:
      423           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      424           if vRindex2 <= vRindex1
      425           then
      426              vRindex2 = vRindex1 + 70.
      427           assign
      428             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      429             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      430             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      431           .
      432         end.
      433       end.
      434       B-viewProcInfo:visible   in frame waitfram = no.
      435       B-viewProcInfo:sensitive in frame waitfram = no.
      436       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      437       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      438       if  (   mWaitFramView
      439          or  mWaitProcEvent)
      440          and not mBatchMode
      441       then
      442          display
      443             v-waitfram-action01 skip
      444             v-waitfram-action02 skip
      445             v-waitfram-action03 skip
      446          with frame waitfram .
      447       if     mWaitFramView
      448          then do:
      449             if     mWaitFramInterval ne ?
      450                and not mBatchMode
      451             then
      452                wait-for go of frame waitfram pause mWaitFramInterval.
      453          end.
      454          else
      455             if     mWaitProcEvent
      456                and not mBatchMode
      457             then
      458                process events .
      459     end.
      460   end procedure.
      461      procedure waitfram-show-this:
      462         define input  parameter iInterval as int64 no-undo.
      463         define variable vtime as int64 no-undo.
      464         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      465         mWaitFramInterval = iInterval.
      466         run waitfram-show (substitute("&1&2 &3&4" ,
      467                                       mWaitFramTextBeg ,
      468                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      469                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      470                                       mWaitFramTextEnd
      471                                      )
      472                           ).
      473      end.
      474      procedure WaitFramRunPause:
      475         define input  parameter iInterval as dec no-undo.
      476         define variable vStart  as datetime-tz no-undo.
      477         define variable vend    as datetime-tz no-undo.
      478         define variable vint as int64 no-undo.
      479         define variable vOk as logical no-undo.
      480         vStart = now.
      481         vend   = vStart.
      482         publish "WaitFramPause" (iInterval,output vOk).
      483         vend   =  now.
      484         vint = vend - vStart.
      485         vint = iInterval - vint / 1000.
      486         if     not mWaitFramStop
      487            and (   vint > 0
      488                 or (    not vOk
      489                     and iInterval eq ?
      490                     )
      491                 )
      492         then
      493            run waitfram-show-this (iInterval).
      494         vend   =  now.
      495         vint = vend - vStart.
      496         vint = iInterval - vint / 1000.
      497         if     not mWaitFramStop
      498            and vint > 0
      499         then do:
      500            run gbl/pause.p (vint * 1000).
      501         end.
      502         if iInterval ne ?
      503         then
      504            publish "WaitFramStop".
      505         waitfram-check-timeout().
      506      end.
      507      procedure WaitFramWaitFor:
      508         define input  parameter iInterval as dec no-undo.
      509         assign
      510            mWaitFramStartProc   = now
      511            mWaitFramStopUser    = no
      512            mWaitFramStopTimeOut = no
      513         .
      514         block-wait:
      515         do while not mWaitFramStop:
      516            run WaitFramRunPause (iInterval).
      517            if  waitfram-check-timeout()
      518            then do:
      519               leave block-wait.
      520            end.
      521         end.
      522         run waitfram-hide.
      523      end.
      524   procedure waitfram-join :
      525     define input  parameter p-line-1  as character no-undo .
      526     define input  parameter p-line-2  as character no-undo .
      527     define input  parameter p-line-3  as character no-undo .
      528     define output parameter p-message as character no-undo .
      529     do
      530     on error undo, return error return-value
      531     :
      532       assign
      533         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      534                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      535                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      536       .
      537     end.
      538   end procedure.
      539   function waitfram-join-function returns character
      540     (input p-line-1 as character
      541     ,input p-line-2 as character
      542     ,input p-line-3 as character
      543     ).
      544     define variable v-message as character no-undo .
      545     run waitfram-join in this-procedure
      546       (input  p-line-1
      547       ,input  p-line-2
      548       ,input  p-line-3
      549       ,output v-message
      550       ) .
      551     return v-message .
      552   end function .
      553   define variable v-today      as date      no-undo.
      554   define variable start-time   as integer   no-undo .
      555   define variable v-chg-fields as character no-undo .
      556   main-block :
      557   do transaction
      558   on error undo main-block, return error
      559   :
      560   define buffer ch_price-list-type for ub.price-list-type  .
      561   if ub.price-list-type.under-type-list = 0 then do:
      562     for each ch_price-list-type exclusive-lock where
      563              ch_price-list-type.stts            = integer('0':U) and
      564              ch_price-list-type.plt-main-id     = ub.price-list-type.plt-id and
      565              ch_price-list-type.plt-main-db-num = ub.price-list-type.plt-db-num and
      566              ch_price-list-type.under-type-list = 1
      567              :
      568             assign
      569                 ch_price-list-type.calc-method        =  ub.price-list-type.calc-method
      570                 ch_price-list-type.create-price-doc   =  ub.price-list-type.create-price-doc
      571                 ch_price-list-type.fix-cource-crc-base=  ub.price-list-type.fix-cource-crc-base
      572                 ch_price-list-type.fix-cource-crc-doc =  ub.price-list-type.fix-cource-crc-doc
      573                 ch_price-list-type.have-rs-qnty-group =  ub.price-list-type.have-rs-qnty-group
      574                 ch_price-list-type.have-rs-sum-group  =  ub.price-list-type.have-rs-sum-group
      575                 ch_price-list-type.only-gbd           =  ub.price-list-type.only-gbd
      576                 ch_price-list-type.priority           =  ub.price-list-type.priority
      577                 ch_price-list-type.send-cassa         =  ub.price-list-type.send-cassa
      578                 ch_price-list-type.use-cassa          =  ub.price-list-type.use-cassa
      579                 ch_price-list-type.work-date          =  ub.price-list-type.work-date
      580                 ch_price-list-type.curr-code          =  ub.price-list-type.curr-code
      581                 ch_price-list-type.qgr-db-num         =  ub.price-list-type.qgr-db-num
      582                 ch_price-list-type.qgr-id             =  ub.price-list-type.qgr-id
      583                 ch_price-list-type.sgr-db-num         =  ub.price-list-type.sgr-db-num
      584                 ch_price-list-type.sgr-id             =  ub.price-list-type.sgr-id
      585                 ch_price-list-type.have-rs-turn-group =  ub.price-list-type.have-rs-turn-group
      586                 ch_price-list-type.have-tog-db-num    =  ub.price-list-type.have-tog-db-num
      587                 ch_price-list-type.have-tog-id        =  ub.price-list-type.have-tog-id
      588                 ch_price-list-type.use-cash-pay       =  ub.price-list-type.use-cash-pay
      589                 ch_price-list-type.use-pay-type       =  ub.price-list-type.use-pay-type
      590                 .
      591     end.
      592   end.
      593   run cur-time in this-procedure ( output v-today, output start-time ) .
      594         create ub.c-price-list-type.
      595         BUFFER-COPY ub.price-list-type TO ub.c-price-list-type
      596         assign
      597           ub.c-price-list-type.chip-num           = next-value (s-corr-chip, ub)
      598           ub.c-price-list-type.corr-time          = start-time
      599           ub.c-price-list-type.corr-user-db-num   = g#db-num
      600           ub.c-price-list-type.corr-user-name     = g#userid
      601           ub.c-price-list-type.corr-date          = v-today
      602       .
      603      if ub.price-list-type.stts <> integer('0':U) then do:
      604          for each ub.batchprocess exclusive-lock
      605              where ub.batchprocess.bp_type   = 'twotpl':U and
      606                    ub.batchprocess.BP_Status     = 'N':U and
      607                    ( ub.batchprocess.CharKey_One   = string(recid(ub.price-list-type)) or
      608                      ub.batchprocess.CharKey_Two   = string(recid(ub.price-list-type)) )
      609                    :
      610                    delete ub.batchprocess.
      611          end.
      612   end.
      613   if g#db-num = 0 or (g#db-num > 0 and g#news = false ) then do:
      614     run str/callnews.p
      615       ( input "price-list-type"
      616       , input (buffer ub.price-list-type:handle)
      617       ) no-error .
      618     if error-status:error then do:
      619        message
      620         vss-workfile vss-revision vss-description skip
      621         "Ошибка при передаче в новости price-list-type" skip
      622         return-value skip
      623         view-as alert-box error .
      624         return error.
      625     end.
      626   end.
      627   if g#news then do:
      628       if  ub.price-list-type.main = false  and
      629           ub.price-list-type.stts = integer('0':U) and
      630           (
      631           not (
      632               ub.price-list-type.bgr-id      = old_price-list-type.bgr-id and
      633               ub.price-list-type.bgr-db-num  = old_price-list-type.bgr-db-num ) or
      634               ub.price-list-type.priority   <> old_price-list-type.priority
      635            ) then do:
      636                     run waitfram-show in this-procedure ("Изменение действующих цен МПЛ...") .
      637                         for each ub.price-all exclusive-lock where
      638                             ub.price-all.plt-db-num = ub.price-list-type.plt-db-num and
      639                             ub.price-all.plt-id     = ub.price-list-type.plt-id
      640                             :
      641                             if ub.price-all.plt-priority <> ub.price-list-type.priority   then ub.price-all.plt-priority = ub.price-list-type.priority   .
      642                             if ub.price-all.bgr-id       <> ub.price-list-type.bgr-id     then ub.price-all.bgr-id       = ub.price-list-type.bgr-id     .
      643                             if ub.price-all.bgr-db-num   <> ub.price-list-type.bgr-db-num then ub.price-all.bgr-db-num   = ub.price-list-type.bgr-db-num .
      644                         end.
      645                     run waitfram-hide in this-procedure  .
      646              end.
      647   end.
      648   if g#oxml = yes
      649       then do:
      650       run str/calloxml.p (
      651             input 'update':U
      652           , input 'price-list-type':U
      653           , input ( buffer ub.price-list-type:handle )
      654       ) no-error.
      655       if error-status :error
      656       then do:
      657           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      658                                , chr(10)
      659                                , vss-workfile
      660                                , return-value
      661                                , error-status :get-message ( 1 ) ).
      662       end.
      663       end.
      664   end.
