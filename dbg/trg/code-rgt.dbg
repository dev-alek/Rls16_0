        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "библиотека для работы с записями code-range".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   procedure gen-key-rec :
       70     define input  parameter p-tbl-name    as character no-undo.
       71     define input  parameter p-bh_tbl-name as handle    no-undo.
       72     define output parameter p-key-rec     as character no-undo.
       73     do
       74     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       75     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       76     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       77     :
       78       define variable fh               as handle    no-undo .
       79       define variable v-ok             as logical   no-undo .
       80       define variable v-inform         as character no-undo .
       81       define variable v-ind            as integer   no-undo .
       82       define variable v-idx-field-qnty as integer   no-undo .
       83       if p-tbl-name = ?
       84         or p-tbl-name = "":U
       85       then do:
       86         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       87       end.
       88       if not p-bh_tbl-name:available then do:
       89         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
       90       end.
       91       assign
       92         p-key-rec = p-tbl-name
       93         v-inform  = p-bh_tbl-name:index-information(1)
       94         v-ind     = 2
       95       .
       96       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       97       on error undo, return error
       98       :
       99         assign
      100           v-inform = p-bh_tbl-name:index-information( v-ind )
      101           v-ind    = v-ind + 1
      102         .
      103       end.
      104       if v-inform = ?
      105         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      106         or entry( 3, v-inform, ",":U ) <> "1":U
      107       then do:
      108         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      109       end.
      110       else do:
      111         assign
      112           v-idx-field-qnty = num-entries( v-inform ) - 4
      113         .
      114         if v-idx-field-qnty < 2 then do:
      115           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      116         end.
      117         do v-ind = 1 to v-idx-field-qnty by 2
      118         on error undo, return error
      119         :
      120           assign
      121             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      122             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      123           .
      124         end.
      125       end.
      126       if p-key-rec = ? then do:
      127         assign
      128           p-key-rec = "":U
      129         .
      130         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      131       end.
      132     end.
      133     return.
      134   end procedure.
      135   procedure gen-where-keyr-tab :
      136     define input  parameter i-tableSerach as character no-undo.
      137     define input  parameter i-tablekey   as character  no-undo.
      138     define input  parameter p-key-rec    as character  no-undo.
      139     define input  parameter p-key-handle as handle     no-undo .
      140     define input  parameter p-db-name    as character  no-undo .
      141     define input  parameter p-tt-handle  as handle     no-undo .
      142     define output parameter o-Where      as character  no-undo.
      143     do
      144     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      145     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      146     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      147     :
      148       define variable v-full-tbl-name  as character no-undo .
      149       define variable bh_tbl-name      as handle    no-undo .
      150       define variable fh_key           as handle    no-undo .
      151       define variable fh_search        as handle    no-undo .
      152       define variable v-field-num      as integer   no-undo .
      153       define variable v-count-fld      as integer   no-undo .
      154       define variable v-inform         as character no-undo .
      155       define variable v-ind            as integer   no-undo .
      156       define variable v-idx-field-qnty as integer   no-undo .
      157       define variable v-field-name     as character no-undo .
      158       define variable v-field-val      as character no-undo .
      159       define variable v-word-link      as character no-undo .
      160       define variable vTable           as character no-undo.
      161       define variable bh_tbl-key       as handle    no-undo .
      162       assign
      163         p-key-rec = trim( p-key-rec )
      164       .
      165       if p-key-handle <> ? then do:
      166         if not valid-handle(p-key-handle)
      167            or p-key-handle:type <> "buffer"
      168         then do:
      169           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      170         end.
      171         if num-entries( p-key-rec, chr(3) ) > 1
      172           or p-key-rec = ?
      173           or p-key-rec = "":U
      174         then do:
      175           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      176         end.
      177       end.
      178       else do:
      179         if p-key-rec = ?
      180           or p-key-rec = "":U
      181         then do:
      182           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      183         end.
      184       end.
      185       assign
      186         vTable = entry( 1 , p-key-rec, chr(3) )
      187       .
      188       if p-tt-handle <> ?
      189         and ( not valid-handle(p-tt-handle)
      190               or p-tt-handle:type <> "buffer"
      191             )
      192       then do:
      193         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      194       end.
      195       if p-tt-handle = ? then do:
      196         assign
      197           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      198         .
      199         create buffer bh_tbl-name for table v-full-tbl-name .
      200       end.
      201       else do:
      202         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      203       end.
      204       assign
      205         v-inform = bh_tbl-name:index-information(1)
      206         v-ind    = 2
      207       .
      208       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      209       on error undo, return error
      210       :
      211         assign
      212           v-inform = bh_tbl-name:index-information( v-ind )
      213           v-ind    = v-ind + 1
      214         .
      215       end.
      216       if v-inform = ?
      217         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      218         or entry( 3, v-inform, ",":U ) <> "1":U
      219       then do:
      220         delete object bh_tbl-name no-error.
      221         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      222       end.
      223       assign
      224         v-idx-field-qnty = num-entries( v-inform ) - 4
      225       .
      226       if v-idx-field-qnty < 2 then do:
      227         delete object bh_tbl-name no-error.
      228         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      229       end.
      230       assign
      231         o-where     = "where":U
      232         v-word-link = "":U
      233         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      234         v-count-fld = 0
      235       .
      236       if i-tablekey ne "" and i-tablekey ne ?
      237       then do:
      238         assign
      239           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      240         .
      241         create buffer bh_tbl-key for table v-full-tbl-name .
      242       end.
      243       if i-tableSerach ne "" and i-tableSerach ne ?
      244       then do:
      245         delete object bh_tbl-name no-error.
      246         assign
      247           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      248         .
      249         create buffer bh_tbl-name for table v-full-tbl-name .
      250       end.
      251       block_where:
      252       do v-ind = 1 to v-idx-field-qnty by 2
      253       on error undo, return error
      254       :
      255         assign
      256           v-count-fld = v-count-fld + 1
      257         .
      258         if p-key-handle = ?
      259           and v-count-fld > v-field-num
      260         then do:
      261           leave block_where.
      262         end.
      263         define variable VfieldKeyTable as handle no-undo.
      264         assign
      265           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      266           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      267         .
      268         if     bh_tbl-key ne ?
      269         then do:
      270            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      271            if VfieldKeyTable eq ?
      272            then next block_where.
      273         end.
      274         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      275         then
      276            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      277         else
      278            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      279         if p-key-handle = ? then do:
      280           assign
      281             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      282           .
      283         end.
      284         else do:
      285           assign
      286             fh_key = p-key-handle:buffer-field( v-field-name )
      287           .
      288           if fh_key = ?
      289             or not valid-handle( fh_key )
      290           then do:
      291             delete object bh_tbl-name.
      292             if     bh_tbl-key ne ?
      293             then
      294                delete object bh_tbl-key.
      295             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      296           end.
      297           assign
      298             v-field-val = fh_key:buffer-value
      299           .
      300         end.
      301         if fh_search:data-type ="character":U then do:
      302           assign
      303             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      304             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      305             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      306             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      307             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      308             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      309             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      310             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      311             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      312             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      313             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      314             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      315             v-field-val = substitute( '"&1"', v-field-val )
      316           .
      317         end.
      318         assign
      319           o-where = substitute( "&1 &2", o-where, v-field-val )
      320         .
      321         if v-word-link = "":U then do:
      322           assign
      323             v-word-link = "and":U
      324           .
      325         end.
      326       end.
      327       delete object bh_tbl-name.
      328       if     bh_tbl-key ne ?
      329       then
      330          delete object bh_tbl-key.
      331       if p-key-handle = ?
      332         and v-count-fld <> v-field-num
      333       then do:
      334         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      335       end.
      336     end.
      337   end procedure.
      338   procedure gen-hn-keyr-tab :
      339     define input  parameter i-tableSerach as character no-undo.
      340     define input  parameter i-tablekey   as character no-undo.
      341     define input  parameter p-key-rec    as character no-undo.
      342     define input  parameter p-key-handle as handle    no-undo .
      343     define input  parameter p-db-name    as character no-undo .
      344     define input  parameter p-tt-handle  as handle    no-undo .
      345     define input  parameter p-stts-lock  as integer   no-undo .
      346     define output parameter o-hn         as handle    no-undo.
      347     define variable v-full-tbl-name as character no-undo.
      348     define variable v-where         as character no-undo.
      349     define variable bh_tbl-name     as handle    no-undo.
      350     define variable vTable          as character no-undo.
      351     do
      352     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      353     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      354     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      355         run gen-where-keyr-tab(i-tableSerach,
      356                                i-tablekey,
      357                                p-key-rec,
      358                                p-key-handle,
      359                                p-db-name,
      360                                p-tt-handle,
      361                                output v-where).
      362         if i-tableSerach ne "" and i-tableSerach ne ?
      363         then do:
      364            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      365            create buffer bh_tbl-name for table v-full-tbl-name .
      366         end.
      367         else do:
      368            if p-tt-handle = ? then do:
      369               assign
      370                  vTable = entry( 1 , p-key-rec, chr(3) )
      371               .
      372               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      373               create buffer bh_tbl-name for table v-full-tbl-name .
      374            end.
      375            else do:
      376               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      377            end.
      378         end.
      379         if p-tt-handle = ? then do:
      380            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      381         end.
      382         else do:
      383            bh_tbl-name:find-first( v-where ) no-error .
      384         end.
      385         o-hn = bh_tbl-name.
      386      end.
      387   end procedure.
      388   procedure gen-hn-keyr :
      389     define input  parameter p-key-rec    as character no-undo.
      390     define input  parameter p-key-handle as handle    no-undo .
      391     define input  parameter p-db-name    as character no-undo .
      392     define input  parameter p-tt-handle  as handle    no-undo .
      393     define input  parameter p-stts-lock  as integer   no-undo .
      394     define output parameter o-hn         as handle    no-undo.
      395     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      396   end.
      397   procedure gen-row-keyr :
      398     define input  parameter p-key-rec    as character no-undo.
      399     define input  parameter p-key-handle as handle    no-undo .
      400     define input  parameter p-db-name    as character no-undo .
      401     define input  parameter p-tt-handle  as handle    no-undo .
      402     define input  parameter p-stts-lock  as integer   no-undo .
      403     define output parameter p-tbl-row    as rowid     no-undo.
      404     define output parameter p-tbl-name   as character no-undo.
      405     define variable vHn as handle no-undo.
      406       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      407       p-tbl-row = if vHn:available then vHn:rowid else ?.
      408       p-tbl-name =  vHn:table.
      409       delete object vHn no-error.
      410     if p-tbl-row = ? then do:
      411       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      412     end.
      413     else do:
      414       return.
      415     end.
      416   end procedure.
      417   procedure gen-key-fv :
      418     define input  parameter p-key-rec    as character no-undo .
      419     define output parameter p-field-list as character no-undo .
      420     define output parameter p-value-list as character no-undo.
      421     do
      422     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      423     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      424     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      425     :
      426       define variable v-full-tbl-name  as character no-undo .
      427       define variable bh_tbl-name      as handle    no-undo .
      428       define variable v-tbl-name       as character no-undo .
      429       define variable v-field-num      as integer   no-undo .
      430       define variable v-count-fld      as integer   no-undo .
      431       define variable v-inform         as character no-undo .
      432       define variable v-ind            as integer   no-undo .
      433       define variable v-idx-field-qnty as integer   no-undo .
      434       define variable v-delim-key      as character no-undo .
      435       if p-key-rec = ?
      436         or p-key-rec = "":U
      437       then do:
      438         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      439       end.
      440       assign
      441         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      442         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      443       .
      444       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      445       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      446       assign
      447         v-inform = bh_tbl-name:index-information(1)
      448         v-ind    = 2
      449       .
      450       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      451       on error undo, return error
      452       :
      453         assign
      454           v-inform = bh_tbl-name:index-information( v-ind )
      455           v-ind    = v-ind + 1
      456         .
      457       end.
      458       if v-inform = ?
      459         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      460         or entry( 3, v-inform, ",":U ) <> "1":U
      461       then do:
      462         delete object bh_tbl-name no-error.
      463         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      464       end.
      465       assign
      466         v-idx-field-qnty = num-entries( v-inform ) - 4
      467       .
      468       if v-idx-field-qnty < 2 then do:
      469         delete object bh_tbl-name no-error.
      470         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      471       end.
      472       assign
      473         p-field-list = "":U
      474         p-value-list = "":U
      475         v-delim-key  = "":U
      476         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      477         v-count-fld  = 0
      478       .
      479       block_where:
      480       do v-ind = 1 to v-idx-field-qnty by 2
      481       on error undo, return error
      482       :
      483         assign
      484           v-count-fld = v-count-fld + 1
      485         .
      486         if v-count-fld > v-field-num then do:
      487           leave block_where.
      488         end.
      489         assign
      490           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      491           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      492         .
      493         if v-ind = 1 then do:
      494           assign
      495             v-delim-key = chr(3)
      496           .
      497         end.
      498       end.
      499       delete object bh_tbl-name.
      500       if v-count-fld <> v-field-num then do:
      501         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      502       end.
      503     end.
      504   end procedure.
      505   procedure gen-key-field :
      506     define input  parameter p-table      as character no-undo .
      507     define output parameter p-field-list as character no-undo .
      508     do
      509     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      510     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      511     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      512     :
      513       define variable v-full-tbl-name  as character no-undo .
      514       define variable bh_tbl-name      as handle    no-undo .
      515       define variable v-tbl-name       as character no-undo .
      516       define variable v-field-num      as integer   no-undo .
      517       define variable v-count-fld      as integer   no-undo .
      518       define variable v-inform         as character no-undo .
      519       define variable v-ind            as integer   no-undo .
      520       define variable v-idx-field-qnty as integer   no-undo .
      521       define variable v-delim-key      as character no-undo .
      522       if p-table = ?
      523         or p-table = "":U
      524       then do:
      525         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      526       end.
      527       assign
      528         v-tbl-name      = p-table
      529         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      530       .
      531       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      532       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      533       assign
      534         v-inform = bh_tbl-name:index-information(1)
      535         v-ind    = 2
      536       .
      537       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      538       on error undo, return error
      539       :
      540         assign
      541           v-inform = bh_tbl-name:index-information( v-ind )
      542           v-ind    = v-ind + 1
      543         .
      544       end.
      545       if v-inform = ?
      546         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      547         or entry( 3, v-inform, ",":U ) <> "1":U
      548       then do:
      549         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      550       end.
      551       assign
      552         v-idx-field-qnty = num-entries( v-inform ) - 4
      553       .
      554       if v-idx-field-qnty < 2 then do:
      555         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      556       end.
      557       assign
      558         p-field-list = "":U
      559         v-delim-key  = "":U
      560         v-count-fld  = 0
      561       .
      562       block_where:
      563       do v-ind = 1 to v-idx-field-qnty by 2
      564       on error undo, return error
      565       :
      566         assign
      567           v-count-fld = v-count-fld + 1
      568         .
      569         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      570         if v-ind = 1 then do:
      571           assign
      572             v-delim-key = chr(3)
      573           .
      574         end.
      575       end.
      576       delete object bh_tbl-name.
      577     end.
      578   end procedure.
      579   define temp-table temp-clients no-undo like ub.clients.
      580   procedure comm-crush-cdrg :
      581     define input  parameter pc-db-num       like ub.db-rec-attr.db-num       no-undo .
      582     define input  parameter pc-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
      583     define input  parameter pc-attr-code    like ub.db-rec-attr.attr-code    no-undo .
      584     define input  parameter pc-parameters   as   character                   no-undo .
      585     define output parameter pc-err-msg      as   character                   no-undo .
      586     do
      587     on error undo, return error
      588     :
      589       define buffer buf_code-range  for ub.code-range .
      590       define variable v-rowid    as rowid     no-undo .
      591       define variable v-tbl-name as character no-undo .
      592       run gen-row-keyr in this-procedure
      593         ( input  pc-uniq-key-rec
      594          ,input ?
      595          ,input "ub":U
      596          ,input ?
      597          ,input share-lock
      598          ,output v-rowid
      599          ,output v-tbl-name
      600         ) no-error .
      601       if error-status :error then do:
      602         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. &3 &4", vss-workfile, pc-uniq-key-rec, chr(10), return-value ).
      603       end.
      604       if v-tbl-name <> 'code-range':U then do:
      605         return error substitute( "&1. Данная процедура может работать только с таблицей диапазонов кодов", vss-workfile ).
      606       end.
      607       find first buf_code-range
      608         where rowid( buf_code-range ) = v-rowid
      609         no-error .
      610       if not available buf_code-range then do:
      611         return error substitute( "&1. Нет необходимого диапазона кодов &2", vss-workfile, pc-uniq-key-rec ).
      612       end.
      613       if buf_code-range.range-type = entry( 1, pc-parameters, chr(4) )
      614          and buf_code-range.first-code = integer( entry( 2, pc-parameters, chr(4) ) )
      615          and buf_code-range.last-code = integer( entry( 3, pc-parameters, chr(4) ) )
      616       then do:
      617         if buf_code-range.stts = "u":U then do:
      618           assign
      619             buf_code-range.PS   = buf_code-range.stts + chr(4) + "Диапазон заблокирован" + chr(4) + buf_code-range.PS
      620             buf_code-range.stts = "c":U
      621           .
      622         end.
      623         else do:
      624           if buf_code-range.stts = "c":U
      625             and num-entries( buf_code-range.PS, chr(4) ) >= 3
      626           then do:
      627             assign
      628               pc-err-msg = substitute( "Диапазон &1 уже заблокирован!!! Блокировка невозможна!!!", pc-uniq-key-rec )
      629             .
      630           end.
      631           else do:
      632             assign
      633               pc-err-msg = substitute( "Диапазон &1 имеет статус &2. Блокировка невозможна!!!", pc-uniq-key-rec, buf_code-range.stts )
      634             .
      635           end.
      636         end.
      637       end.
      638       else do:
      639         return error substitute( "&1. Обнаружено фатальное отличие диапазонов", vss-workfile )
      640                      + chr(10)
      641                      + substitute( "Должно быть: тип &1 начало &2 конец &3", entry( 1, pc-parameters, chr(4) )
      642                                                                            , entry( 2, pc-parameters, chr(4) )
      643                                                                            , entry( 3, pc-parameters, chr(4) ) )
      644                      + chr(10)
      645                      + substitute( "В текущей БД: тип &1 начало &2 конец &3", buf_code-range.range-type
      646                                                                             , buf_code-range.first-code
      647                                                                             , buf_code-range.last-code )
      648         .
      649       end.
      650     end.
      651     return.
      652   end procedure.
      653   procedure exec-crush-cdrg :
      654     define input  parameter pe-db-num       like ub.db-rec-attr.db-num       no-undo .
      655     define input  parameter pe-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
      656     define input  parameter pe-attr-code    like ub.db-rec-attr.attr-code    no-undo .
      657     define input  parameter pe-parameters   as   character                   no-undo .
      658     define output parameter pe-err-msg      as   character                   no-undo .
      659     do
      660     on error undo, return error
      661     :
      662       define buffer buf_code-range     for ub.code-range .
      663       define buffer buf-new_code-range for ub.code-range .
      664       define variable v-rowid            as rowid     no-undo .
      665       define variable v-tbl-name         as character no-undo .
      666       define variable v-new-range-length as integer   no-undo .
      667       define variable v-range-type       as character no-undo .
      668       define variable v-old-first-code   as integer   no-undo .
      669       define variable v-old-last-code    as integer   no-undo .
      670       define variable v-new-first-code   as integer   no-undo .
      671       define variable v-new-last-code    as integer   no-undo .
      672       run gen-row-keyr in this-procedure
      673         ( input  pe-uniq-key-rec
      674          ,input ?
      675          ,input "ub":U
      676          ,input ?
      677          ,input share-lock
      678          ,output v-rowid
      679          ,output v-tbl-name
      680         ) no-error .
      681       if error-status :error then do:
      682         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pe-uniq-key-rec, return-value ).
      683       end.
      684       if v-tbl-name <> 'code-range':U then do:
      685         return error substitute( "&1. Данная процедура может работать только с таблицей диапазонов кодов", vss-workfile ).
      686       end.
      687       find first buf_code-range
      688         where rowid( buf_code-range ) = v-rowid
      689         no-error .
      690       if not available buf_code-range then do:
      691         return error substitute( "&1. Нет необходимого диапазона кодов &2", vss-workfile, pe-uniq-key-rec ).
      692       end.
      693       if buf_code-range.stts <> "c":U then do:
      694         return error substitute( "&1. Диапазон кодов &2 не заблокирован", vss-workfile, pe-uniq-key-rec ).
      695       end.
      696       assign
      697         v-range-type             = entry( 1, pe-parameters, chr(4) )
      698         v-old-first-code         = integer( entry( 2, pe-parameters, chr(4) ) )
      699         v-old-last-code          = integer( entry( 3, pe-parameters, chr(4) ) )
      700         v-new-range-length       = integer( entry( 4, pe-parameters, chr(4) ) )
      701         buf_code-range.last-code = buf_code-range.first-code - 1 + v-new-range-length
      702         v-new-first-code         = buf_code-range.last-code + 1
      703         v-new-last-code          = v-new-first-code - 1 + v-new-range-length
      704       .
      705       do while v-new-first-code < v-old-last-code
      706       on error undo, return error
      707       :
      708         if v-new-last-code > v-old-last-code then do:
      709           assign
      710             v-new-last-code = v-old-last-code
      711           .
      712         end.
      713         create buf-new_code-range .
      714         buffer-copy buf_code-range to buf-new_code-range
      715           assign
      716             buf-new_code-range.stts       = "c":U
      717             buf-new_code-range.first-code = v-new-first-code
      718             buf-new_code-range.last-code  = v-new-last-code
      719         .
      720         assign
      721           v-new-first-code = buf-new_code-range.last-code + 1
      722           v-new-last-code  = v-new-first-code - 1 + v-new-range-length
      723         .
      724       end.
      725       for each buf_code-range
      726         where buf_code-range.range-type = v-range-type
      727           and buf_code-range.first-code >= v-old-first-code
      728           and buf_code-range.first-code <  v-old-last-code
      729       on error undo, return error
      730       :
      731         assign
      732           buf_code-range.stts = entry( 1, buf_code-range.PS, chr(4) )
      733           buf_code-range.PS   = "Диапазон получен разбиением"
      734         .
      735       end.
      736     end.
      737     return.
      738   end procedure.
      739   procedure rcvr-crush-cdrg :
      740     define input  parameter pr-db-num       like ub.db-rec-attr.db-num       no-undo .
      741     define input  parameter pr-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
      742     define input  parameter pr-attr-code    like ub.db-rec-attr.attr-code    no-undo .
      743     define input  parameter pr-parameters   as   character                   no-undo .
      744     define output parameter pr-err-msg      as   character                   no-undo .
      745     do
      746     on error undo, return error
      747     :
      748       define buffer buf_db-rec-attr    for ub.db-rec-attr .
      749       define buffer buf_code-range     for ub.code-range .
      750       define buffer buf-del_code-range for ub.code-range .
      751       define variable v-rowid            as rowid     no-undo .
      752       define variable v-tbl-name         as character no-undo .
      753       define variable v-range-type       as character no-undo .
      754       define variable v-old-first-code   as integer   no-undo .
      755       define variable v-old-last-code    as integer   no-undo .
      756       define variable v-update-cdrg      as logical   no-undo .
      757       run gen-row-keyr in this-procedure
      758         ( input  pr-uniq-key-rec
      759          ,input ?
      760          ,input "ub":U
      761          ,input ?
      762          ,input share-lock
      763          ,output v-rowid
      764          ,output v-tbl-name
      765         ) no-error .
      766       if error-status :error then do:
      767         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pr-uniq-key-rec, return-value ).
      768       end.
      769       if v-tbl-name <> 'code-range':U then do:
      770         return error substitute( "&1. Данная процедура может работать только с таблицей диапазонов кодов", vss-workfile ).
      771       end.
      772       find first buf_code-range
      773         where rowid( buf_code-range ) = v-rowid
      774         no-error .
      775       if not available buf_code-range then do:
      776         return error substitute( "&1. Нет необходимого диапазона кодов &2", vss-workfile, pr-uniq-key-rec ).
      777       end.
      778       assign
      779         v-range-type             = entry( 1, pr-parameters, chr(4) )
      780         v-old-first-code         = integer( entry( 2, pr-parameters, chr(4) ) )
      781         v-old-last-code          = integer( entry( 3, pr-parameters, chr(4) ) )
      782       .
      783       assign
      784         v-update-cdrg = false
      785       .
      786       if buf_code-range.stts = "c":U then do:
      787         assign
      788           v-update-cdrg = true
      789         .
      790       end.
      791       else do:
      792         if buf_code-range.last-code <> v-old-last-code then do:
      793           for each buf-del_code-range
      794             where buf-del_code-range.range-type = v-range-type
      795               and buf-del_code-range.first-code > v-old-first-code
      796               and buf-del_code-range.first-code < v-old-last-code
      797           on error undo, return error
      798           :
      799             assign
      800               buf-del_code-range.stts = "c":U
      801             .
      802             delete buf-del_code-range .
      803           end.
      804           assign
      805             buf_code-range.PS        = buf_code-range.stts + chr(4) + chr(4) + buf_code-range.PS
      806             buf_code-range.stts      = "c":U
      807             buf_code-range.last-code = v-old-last-code
      808             v-update-cdrg            = true
      809           .
      810         end.
      811       end.
      812       if v-update-cdrg = true then do:
      813         assign
      814           buf_code-range.stts = entry( 1, buf_code-range.PS, chr(4) )
      815           buf_code-range.PS   = entry( 3, buf_code-range.PS, chr(4) )
      816         .
      817       end.
      818     end.
      819     return.
      820   end procedure.
      821   procedure comm-del-cdrg :
      822     define input  parameter pc-db-num       like ub.db-rec-attr.db-num       no-undo .
      823     define input  parameter pc-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
      824     define input  parameter pc-attr-code    like ub.db-rec-attr.attr-code    no-undo .
      825     define input  parameter pc-parameters   as   character                   no-undo .
      826     define output parameter pc-err-msg      as   character                   no-undo .
      827     do
      828     on error undo, return error
      829     :
      830       define buffer buf_db-rec-attr for ub.db-rec-attr .
      831       define buffer buf_code-range  for ub.code-range .
      832       define variable v-rowid    as rowid     no-undo .
      833       define variable v-tbl-name as character no-undo .
      834       define variable v-old-stts as character no-undo .
      835       define variable v-old-ps as character no-undo .
      836       define variable l-has-prevention as logical no-undo .
      837       find first buf_db-rec-attr exclusive-lock
      838         where buf_db-rec-attr.db-num       = pc-db-num
      839           and buf_db-rec-attr.uniq-key-rec = pc-uniq-key-rec
      840           and buf_db-rec-attr.attr-code    = pc-attr-code
      841       no-error.
      842       run gen-row-keyr in this-procedure
      843         ( input  pc-uniq-key-rec
      844          ,input ?
      845          ,input "ub":U
      846          ,input ?
      847          ,input share-lock
      848          ,output v-rowid
      849          ,output v-tbl-name
      850         ) no-error .
      851       if error-status :error then do:
      852         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pc-uniq-key-rec, return-value ).
      853       end.
      854       if v-tbl-name <> 'code-range':U then do:
      855         return error substitute( "&1. Данная процедура может работать только с таблицей диапазонов кодов", vss-workfile ).
      856       end.
      857       find first buf_code-range
      858         where rowid( buf_code-range ) = v-rowid
      859         no-error .
      860       if not available buf_code-range then do:
      861         return error substitute( "&1. Нет необходимого диапазона кодов &2", vss-workfile, pc-uniq-key-rec ).
      862       end.
      863       if buf_code-range.range-type = entry( 1, pc-parameters, chr(4) )
      864          and buf_code-range.first-code = integer( entry( 2, pc-parameters, chr(4) ) )
      865          and buf_code-range.last-code = integer( entry( 3, pc-parameters, chr(4) ) )
      866       then do:
      867         if ( buf_code-range.stts = "u":U
      868             or buf_code-range.stts = "f":U
      869             or buf_code-range.stts = "a":U
      870           )
      871         then do:
      872           assign
      873           v-old-stts = buf_code-range.stts
      874             buf_code-range.stts = "c":U
      875           .
      876           l-has-prevention = yes.
      877           run proc-has-prevention in this-procedure ( buffer buf_code-range, output l-has-prevention) no-error.
      878           if error-status:error then do:
      879             undo, return error substitute( "&1. Ошибка при поиске препятствий удаления диапазона с типом &2 для БД &3 (&4-&5):&6&7&6&8"
      880                                           , vss-workfile
      881                                           , buf_code-range.range-type
      882                                           , buf_code-range.db-num
      883                                           , buf_code-range.first-code
      884                                           , buf_code-range.last-code
      885                                           , chr(10)
      886                                           , error-status:get-message(1)
      887                                           , return-value
      888                                           ).
      889           end.
      890           if l-has-prevention then do:
      891             assign
      892             buf_code-range.stts = v-old-stts
      893             buf_code-range.ps = v-old-ps
      894             pc-err-msg = substitute( "&1. Есть препятствия удалению диапазона с типом &2 для БД &3 (&4-&5):&6&7&6&8"
      895                                     , vss-workfile
      896                                     , buf_code-range.range-type
      897                                     , buf_code-range.db-num
      898                                     , buf_code-range.first-code
      899                                     , buf_code-range.last-code
      900                                     , chr(10)
      901                                     , error-status:get-message(1)
      902                                     , return-value
      903                                     ).
      904             return pc-err-msg.
      905         end.
      906         end.
      907         else do:
      908           assign
      909             pc-err-msg = substitute( "Блокировка записи &1 невозможна!!!", pc-uniq-key-rec )
      910           .
      911         end.
      912       end.
      913       else do:
      914         return error substitute( "&1. Обнаружено фатальное отличие диапазонов", vss-workfile )
      915                      + chr(10)
      916                      + substitute( "Должно быть: тип &1 начало &2 конец &3", entry( 1, pc-parameters, chr(4) )
      917                                                                            , entry( 2, pc-parameters, chr(4) )
      918                                                                            , entry( 3, pc-parameters, chr(4) ) )
      919                      + chr(10)
      920                      + substitute( "В текущей БД: тип &1 начало &2 конец &3", buf_code-range.range-type
      921                                                                             , buf_code-range.first-code
      922                                                                             , buf_code-range.last-code )
      923         .
      924       end.
      925     end.
      926     return.
      927   end procedure.
      928   procedure exec-del-cdrg :
      929     define input  parameter pe-db-num       like ub.db-rec-attr.db-num       no-undo .
      930     define input  parameter pe-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
      931     define input  parameter pe-attr-code    like ub.db-rec-attr.attr-code    no-undo .
      932     define input  parameter pe-parameters   as   character                   no-undo .
      933     define output parameter pe-err-msg      as   character                   no-undo .
      934     do
      935     on error undo, return error
      936     :
      937       define buffer buf_code-range     for ub.code-range .
      938       define buffer buf-new_code-range for ub.code-range .
      939       define variable v-rowid            as rowid     no-undo .
      940       define variable v-tbl-name         as character no-undo .
      941       define variable v-new-range-length as integer   no-undo .
      942       define variable v-range-type       as character no-undo .
      943       define variable v-stts         as character no-undo .
      944       define variable v-db-num as integer no-undo .
      945       define variable v-ps as character no-undo .
      946       define variable v-first-code   as integer   no-undo .
      947       define variable v-last-code    as integer   no-undo .
      948       define variable l-has-prevention as logical no-undo .
      949       run gen-row-keyr in this-procedure
      950         ( input  pe-uniq-key-rec
      951          ,input ?
      952          ,input "ub":U
      953          ,input ?
      954          ,input share-lock
      955          ,output v-rowid
      956          ,output v-tbl-name
      957         ) no-error .
      958       if error-status :error then do:
      959         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pe-uniq-key-rec, return-value ).
      960       end.
      961       if v-tbl-name <> 'code-range':U then do:
      962         return error substitute( "&1. Данная процедура может работать только с таблицей диапазонов кодов", vss-workfile ).
      963       end.
      964       find first buf_code-range
      965         where rowid( buf_code-range ) = v-rowid
      966         no-error .
      967       if not available buf_code-range then do:
      968         return error substitute( "&1. Нет необходимого диапазона кодов &2", vss-workfile, pe-uniq-key-rec ).
      969       end.
      970       if buf_code-range.stts <> "c":U then do:
      971         return error substitute( "&1. Диапазон кодов &2 не заблокирован", vss-workfile, pe-uniq-key-rec ).
      972       end.
      973       assign
      974       v-range-type         = entry( 1, pe-parameters, chr(4) )
      975       v-first-code         = integer( entry( 2, pe-parameters, chr(4) ) )
      976       v-last-code          = integer( entry( 3, pe-parameters, chr(4) ) )
      977       v-stts               = entry( 4, pe-parameters, chr(4) )
      978       v-db-num             = integer( entry( 5, pe-parameters, chr(4) ) )
      979       v-ps                 = entry( 6, pe-parameters, chr(4) )
      980       .
      981       l-has-prevention = yes.
      982       run proc-has-prevention in this-procedure ( buffer buf_code-range, output l-has-prevention) no-error.
      983       if error-status:error then do:
      984         undo, return error substitute( "&1. Ошибка при поиске препятствий удаления диапазона с типом &2 для БД &3 (&4-&5):&6&7&6&8"
      985                                       , vss-workfile
      986                                       , buf_code-range.range-type
      987                                       , buf_code-range.db-num
      988                                       , buf_code-range.first-code
      989                                       , buf_code-range.last-code
      990                                       , chr(10)
      991                                       , error-status:get-message(1)
      992                                       , return-value
      993                                       ).
      994       end.
      995       if l-has-prevention then do:
      996         assign
      997         buf_code-range.stts = v-stts
      998         pe-err-msg = substitute( "&1. Есть препятствия удалению диапазона с типом &2 для БД &3 (&4-&5):&6&7&6&8"
      999                                 , buf_code-range.range-type
     1000                                 , buf_code-range.db-num
     1001                                 , buf_code-range.first-code
     1002                                 , buf_code-range.last-code
     1003                                 , chr(10)
     1004                                 , error-status:get-message(1)
     1005                                 , return-value
     1006                                 ).
     1007         undo, return error substitute( "&1. Ошибка при поиске препятствий удаления диапазона с типом &2 для БД &3 (&4-&5):&6&7&6&8"
     1008                                       , vss-workfile
     1009                                       , buf_code-range.range-type
     1010                                       , buf_code-range.db-num
     1011                                       , buf_code-range.first-code
     1012                                       , buf_code-range.last-code
     1013                                       , chr(10)
     1014                                       , error-status:get-message(1)
     1015                                       , return-value
     1016                                       ).
     1017       end.
     1018       on delete of ub.code-range override do: end.
     1019       delete buf_code-range no-error.
     1020       if error-status:error then do:
     1021         undo, return error substitute( "&1. Ошибка при удаления диапазона с типом &2 для БД &3 (&4-&5):&6&7&6&8"
     1022                                       , vss-workfile
     1023                                       , buf_code-range.range-type
     1024                                       , buf_code-range.db-num
     1025                                       , buf_code-range.first-code
     1026                                       , buf_code-range.last-code
     1027                                       , chr(10)
     1028                                       , error-status:get-message(1)
     1029                                       , return-value
     1030                                       ).
     1031       end.
     1032       on delete of ub.code-range revert.
     1033     end.
     1034     return.
     1035   end procedure.
     1036   procedure rcvr-del-cdrg :
     1037     define input  parameter pr-db-num       like ub.db-rec-attr.db-num       no-undo .
     1038     define input  parameter pr-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1039     define input  parameter pr-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1040     define input  parameter pr-parameters   as   character                   no-undo .
     1041     define output parameter pr-err-msg      as   character                   no-undo .
     1042     do
     1043     on error undo, return error
     1044     :
     1045       define buffer buf_db-rec-attr    for ub.db-rec-attr .
     1046       define buffer buf_code-range     for ub.code-range .
     1047       define buffer buf-del_code-range for ub.code-range .
     1048       define variable v-rowid            as rowid     no-undo .
     1049       define variable v-tbl-name         as character no-undo .
     1050       define variable v-range-type       as character no-undo .
     1051       define variable v-first-code   as integer   no-undo .
     1052       define variable v-last-code    as integer   no-undo .
     1053       define variable v-db-num as integer no-undo .
     1054       define variable v-stts as character no-undo .
     1055       define variable v-ps as character no-undo .
     1056       define variable v-update-cdrg      as logical   no-undo .
     1057       run gen-row-keyr in this-procedure
     1058         ( input  pr-uniq-key-rec
     1059          ,input ?
     1060          ,input "ub":U
     1061          ,input ?
     1062          ,input share-lock
     1063          ,output v-rowid
     1064          ,output v-tbl-name
     1065         ) no-error .
     1066       if error-status :error then do:
     1067         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pr-uniq-key-rec, return-value ).
     1068       end.
     1069       if v-tbl-name <> 'code-range':U then do:
     1070         return error substitute( "&1. Данная процедура может работать только с таблицей диапазонов кодов", vss-workfile ).
     1071       end.
     1072       find first buf_code-range
     1073         where rowid( buf_code-range ) = v-rowid
     1074         no-error .
     1075       assign
     1076       v-range-type        = entry( 1, pr-parameters, chr(4) )
     1077       v-first-code        = integer( entry( 2, pr-parameters, chr(4) ) )
     1078       v-last-code         = integer( entry( 3, pr-parameters, chr(4) ) )
     1079       v-stts              =  entry( 4, pr-parameters, chr(4) )
     1080       v-db-num            = integer(entry( 5, pr-parameters, chr(4) ))
     1081       v-ps                = entry( 6, pr-parameters, chr(4) )
     1082       .
     1083       if not available buf_code-range then do:
     1084         find first buf_code-range exclusive-lock where
     1085                    buf_code-range.range-type = v-range-type
     1086                and buf_code-range.first-code = v-first-code     no-error no-wait.
     1087         if not available buf_code-range
     1088         AND not LOCKED(buf_code-range)
     1089         then do:
     1090           find first buf_code-range no-lock where
     1091                    buf_code-range.range-type = v-range-type
     1092               and  buf_code-range.first-code = v-first-code  no-error.
     1093           if not available buf_code-range then do:
     1094             create buf_code-range.
     1095             assign
     1096             buf_code-range.range-type = v-range-type
     1097             buf_code-range.db-num = v-db-num
     1098             buf_code-range.first-code = v-first-code
     1099             buf_code-range.last-code = v-last-code
     1100             buf_code-range.ps = v-ps
     1101             .
     1102             release buf_code-range no-error.
     1103             if error-status:error then do:
     1104               undo, return error substitute( "&1. Ошибка при восстановлении диапазона с типом &2 для БД &3 (&4-&5):&6&7&6&8"
     1105                                             , vss-workfile
     1106                                             , v-range-type
     1107                                             , v-db-num
     1108                                             , v-first-code
     1109                                             , v-last-code
     1110                                             , chr(10)
     1111                                             , error-status:get-message(1)
     1112                                             , return-value
     1113                                             ).
     1114             end.
     1115             return .
     1116           end.
     1117           else do:
     1118             if buf_code-range.db-num <> v-db-num
     1119             or buf_code-range.last-code <> v-last-code then do:
     1120               undo, return error substitute( "&1. Ошибка при восстановлении диапазона с типом &2 для БД &3 (&4-&5):&6" +
     1121                                              "Восстанавливаемый диапазон отличается от исходного (БД = &7 верхняя граница 8)"
     1122                                             , vss-workfile
     1123                                             , v-range-type
     1124                                             , v-db-num
     1125                                             , v-first-code
     1126                                             , v-last-code
     1127                                             , chr(10)
     1128                                             , v-db-num
     1129                                             , v-last-code
     1130                                             ).
     1131             end.
     1132           end.
     1133         end.
     1134       end.
     1135       else do:
     1136         if buf_code-range.db-num <> v-db-num
     1137         or buf_code-range.last-code <> v-last-code then do:
     1138           undo, return error substitute( "&1. Ошибка при восстановлении диапазона с типом &2 для БД &3 (&4-&5):&6" +
     1139                                           "Имеющийся восстанавливаемый диапазон отличается от исходного (БД = &7 верхняя граница 8)"
     1140                                         , vss-workfile
     1141                                         , v-range-type
     1142                                         , v-db-num
     1143                                         , v-first-code
     1144                                         , v-last-code
     1145                                         , chr(10)
     1146                                         , v-db-num
     1147                                         , v-last-code
     1148                                         ).
     1149         end.
     1150       end.
     1151       do
     1152       on error undo, return error
     1153       on stop undo, return error
     1154       :
     1155         if buf_code-range.stts <> v-stts then do:
     1156           assign
     1157           buf_code-range.stts = v-stts
     1158           .
     1159           release buf_code-range no-error.
     1160           if error-status:error then do:
     1161               undo, return error substitute( "&1. Ошибка при восстановлении диапазона с типом &2 для БД &3 (&4-&5):&6&7&6&8"
     1162                                             , vss-workfile
     1163                                             , v-range-type
     1164                                             , v-db-num
     1165                                             , v-first-code
     1166                                             , v-last-code
     1167                                             , chr(10)
     1168                                             , error-status:get-message(1)
     1169                                             , return-value
     1170                                             ).
     1171           end.
     1172         end.
     1173       end.
     1174     end.
     1175     return.
     1176   end procedure.
     1177   procedure proc-has-prevention :
     1178   define parameter buffer buf_code-range for ub.code-range.
     1179   define output parameter p-has-prevention as logical no-undo init yes.
     1180   define buffer buf_clients for ub.clients.
     1181   define variable l-prod-bc-weight as logical no-undo .
     1182   define variable l-prod-bc-global as logical no-undo .
     1183   define variable l-prod-bc-pgweight as logical no-undo .
     1184   define buffer buf_sys-ctrl for ub.sys-ctrl.
     1185   define buffer buf_prod-bc for ub.prod-bc.
     1186   main-block:
     1187   do
     1188   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1189   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1190   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1191   :
     1192     if not available buf_code-range then do:
     1193       undo, return error substitute("Не определен диапазон").
     1194     end.
     1195     find first buf_sys-ctrl.
     1196     case buf_code-range.range-type:
     1197       when 'sclc':U
     1198       or when 'pglc':U
     1199       or when 'scgb':U
     1200       then do:
     1201         empty temp-table temp-clients.
     1202         for each buf_clients no-lock where
     1203                 buf_clients.db-num = buf_sys-ctrl.db-num
     1204         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1205         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1206         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1207         :
     1208           create temp-clients.
     1209           buffer-copy buf_clients to temp-clients.
     1210           release temp-clients.
     1211         end.
     1212         for each buf_prod-bc no-lock where
     1213                 buf_prod-bc.b-str >= string(buf_code-range.first-code, "99999")
     1214             and buf_prod-bc.b-str <= string(buf_code-range.last-code, "99999")
     1215             and length(buf_prod-bc.b-str) = 5
     1216         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1217         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1218         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1219         :
     1220           assign
     1221           l-prod-bc-global = ?
     1222           l-prod-bc-weight = ?
     1223           l-prod-bc-pgweight = ?
     1224           .
     1225   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1226   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     1227     (buffer buf_prod-bc
     1228     ,input  'global=request':u
     1229     ,output l-prod-bc-global
     1230     ) no-error .
     1231           if buf_code-range.range-type = 'scgb':U
     1232           or buf_code-range.range-type = 'sclc':U then do:
     1233   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1234   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     1235     (buffer buf_prod-bc
     1236     ,input  'weight=request':u
     1237     ,output l-prod-bc-weight
     1238     ) no-error .
     1239           end.
     1240           if buf_code-range.range-type = 'pglc':U then do:
     1241   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     1243     (buffer buf_prod-bc
     1244     ,input  'pgweight=request':u
     1245     ,output l-prod-bc-weight
     1246     ) no-error .
     1247           end.
     1248           case buf_code-range.range-type:
     1249             when 'sclc':U then do:
     1250               if l-prod-bc-weight = yes
     1251               and l-prod-bc-global = no then do:
     1252                 return substitute("prod-bc ДопБК &1" + buf_prod-bc.b-str).
     1253               end.
     1254             end.
     1255             when 'pglc':U then do:
     1256               if l-prod-bc-pgweight = yes
     1257               and l-prod-bc-global = no then do:
     1258                 return substitute("prod-bc ДопБК &1" + buf_prod-bc.b-str).
     1259               end.
     1260             end.
     1261             when 'scgb':U then do:
     1262               if l-prod-bc-weight = yes
     1263               and l-prod-bc-global = yes then do:
     1264                 return substitute("prod-bc ДопБК &1" + buf_prod-bc.b-str).
     1265               end.
     1266             end.
     1267           end case.
     1268         end.
     1269         p-has-prevention = no.
     1270       end.
     1271       otherwise do:
     1272         return.
     1273       end.
     1274     end case.
     1275   end.
     1276   end procedure.
