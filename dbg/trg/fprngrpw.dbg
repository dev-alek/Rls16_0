        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.fbr-prn-grp OLD oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись fbr-prn-grp".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                            ,ub.fbr-prn-grp.db-num
       30                            ,ub.fbr-prn-grp.prn-num
       31                            ,ub.fbr-prn-grp.obj-type
       32                            ,ub.fbr-prn-grp.obj-code
       33                            ,ub.fbr-prn-grp.node-code
       34                            )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define buffer buf_clients for ub.clients.
       88   define buffer buf_fbr-prn-grp for ub.fbr-prn-grp.
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure cur-time :
       91      define output parameter p-today as date      no-undo .
       92      define output parameter p-time  as integer   no-undo .
       93     do
       94     on error undo, return error
       95     :
       96       define variable v-date1 as date      no-undo .
       97       define variable v-date2 as date      no-undo .
       98       define variable v-time  as integer   no-undo .
       99       assign
      100         v-date1 = today
      101         v-time  = time
      102         v-date2 = today
      103       .
      104       if v-date1 <> v-date2
      105       then do:
      106         assign
      107           v-date1 = today
      108           v-time  = v-time
      109         .
      110       end.
      111       assign
      112         p-today = v-date1
      113         p-time  = v-time
      114       .
      115     end.
      116   end.
      117   function cur-time-date returns character
      118   :
      119     return string(today, '99/99/9999':U) .
      120   end.
      121   function cur-time-mjd returns decimal
      122   :
      123     define variable v-date as date      no-undo .
      124     define variable v-time as integer   no-undo .
      125     run cur-time in this-procedure
      126       (output v-date
      127       ,output v-time
      128       ) .
      129     return integer(v-date) - 2400002 + (v-time / 86400) .
      130   end.
      131   function cur-time-get-ending-index returns integer
      132   (input p-number as integer
      133   )
      134   :
      135     if p-number < 0
      136     or p-number = ?
      137     then do:
      138       return 1 .
      139     end.
      140     define variable v-rest as integer   no-undo .
      141     assign
      142       p-number = p-number modulo 100
      143     .
      144     if p-number < 20
      145     then do:
      146       assign
      147         v-rest = p-number
      148       .
      149     end.
      150     else do:
      151       assign
      152         v-rest = p-number modulo 10
      153       .
      154     end.
      155     case v-rest :
      156       when 1
      157       then do:
      158         return 2 .
      159       end.
      160       when 2 or
      161       when 3 or
      162       when 4
      163       then do:
      164         return 3 .
      165       end.
      166       otherwise do:
      167         return 1 .
      168       end.
      169     end case .
      170   end.
      171   procedure cur-time-mjd-to-date :
      172      define input  parameter i-mjd-diff as decimal no-undo.
      173      define output parameter o-Date     as date    no-undo.
      174      define output parameter o-Time     as integer no-undo.
      175      define variable v-day-number as integer   no-undo .
      176      if    i-mjd-diff < 0
      177         or i-mjd-diff = ?
      178      then do:
      179         return "?" .
      180      end.
      181      assign
      182         v-day-number = truncate(i-mjd-diff,0).
      183         o-Date = date(v-day-number + 2400002).
      184         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186   end.
      187   function cur-time-mjd-to-string returns character
      188   (input p-mjd-diff as decimal
      189   )
      190   :
      191     define variable v-day-number as integer   no-undo .
      192     define variable v-seconds    as integer   no-undo .
      193     define variable v-hour       as integer   no-undo .
      194     define variable v-min        as integer   no-undo .
      195     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      196     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      197     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      198     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      199     if p-mjd-diff < 0
      200     or p-mjd-diff = ?
      201     then do:
      202       return "?" .
      203     end.
      204     assign
      205       v-day-number = integer(truncate(p-mjd-diff,0))
      206       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      207     .
      208     if v-seconds > 86400
      209     then do:
      210       assign
      211         v-seconds = 86400 - 1
      212       .
      213     end.
      214     if v-seconds < 0
      215     then do:
      216       assign
      217         v-seconds = 0
      218       .
      219     end.
      220     assign
      221       v-hour = truncate(v-seconds / 3600, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 3600
      225     .
      226     assign
      227       v-min = truncate(v-seconds / 60, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 60
      231     .
      232     return
      233         (if v-day-number <> 0
      234           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0
      238           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      239           else ""
      240         )
      241       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      242           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      243           else ""
      244         )
      245       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      246       .
      247   end.
      248   function cur-time-string returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      257   end.
      258   function cur-time-string-sec returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      267   end.
      268   function cur-time-custom  returns character
      269   (input p-prefix as character
      270   ,input p-date-format as character
      271   ,input p-delimiter as character
      272   ,input p-time-format as character
      273   ,input p-suffix as character
      274   )
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return
      283       p-prefix
      284       + string(v-date, p-date-format)
      285       + p-delimiter
      286       + string(v-time, p-time-format)
      287       + p-suffix
      288       .
      289   end.
      290   function cur-time-print  returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-datetime returns datetime
      301   :
      302     define variable v-char as character no-undo .
      303     define variable v-datetime as datetime no-undo .
      304     v-char = cur-time-string().
      305     v-datetime = datetime(v-char).
      306     return  v-datetime.
      307   end.
      308   function cur-time-string-msec returns character
      309   :
      310     define variable v-date as datetime  no-undo .
      311     v-date = now.
      312     return string(v-date) .
      313   end.
      314   define variable v-date as date no-undo .
      315   define variable v-time as integer no-undo .
      316   define buffer buf_c-fbr-prn for ub.c-fbr-prn.
      317   define buffer buf_c-fbr-prn-grp for ub.c-fbr-prn-grp.
      318   main-block:
      319   do
      320   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      321   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      322   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      323   :
      324     if not g#news then do:
      325       find first buf_clients no-lock where
      326                  buf_clients.obj-type = ub.fbr-prn-grp.obj-type
      327              AND buf_clients.obj-code = ub.fbr-prn-grp.obj-code.
      328       if buf_clients.db-num <> g#db-num then do:
      329         message
      330         "Нельзя изменять запись о группе товаров на принтере," skip
      331         "принадлежащем другой БД"
      332         view-as alert-box .
      333         undo main-block, return error.
      334       end.
      335     end.
      336     find first buf_fbr-prn-grp no-lock where
      337                buf_fbr-prn-grp.node-code = ub.fbr-prn-grp.node-code
      338            AND buf_fbr-prn-grp.obj-type = ub.fbr-prn-grp.obj-type
      339            AND buf_fbr-prn-grp.obj-code = ub.fbr-prn-grp.obj-code
      340            AND recid(buf_fbr-prn-grp) <> recid(ub.fbr-prn-grp)
      341            no-error .
      342     if available buf_fbr-prn-grp then do:
      343       message
      344       "Группа товаров" ub.fbr-prn-grp.node-code
      345       "уже привязана к принтеру"  skip
      346       "принтер" buf_fbr-prn-grp.prn-num
      347       view-as alert-box error .
      348       undo main-block, return error .
      349     end.
      350     run str/callnews.p
      351       ( input 'fbr-prn-grp':U
      352        ,input (buffer ub.fbr-prn-grp:handle )
      353       ) .
      354     if not g#news then do:
      355       run cur-time in this-procedure(output v-date, output v-time).
      356       create buf_c-fbr-prn-grp.
      357       assign
      358       buf_c-fbr-prn-grp.prn-num            = ub.fbr-prn-grp.prn-num
      359       buf_c-fbr-prn-grp.db-num             = ub.fbr-prn-grp.db-num
      360       buf_c-fbr-prn-grp.node-code          = ub.fbr-prn-grp.node-code
      361       buf_c-fbr-prn-grp.obj-type           = ub.fbr-prn-grp.obj-type
      362       buf_c-fbr-prn-grp.obj-code           = ub.fbr-prn-grp.obj-code
      363       buf_c-fbr-prn-grp.corr-user-db-num   = g#db-num
      364       buf_c-fbr-prn-grp.chip-num           = next-value (s-scales-chip, ub)
      365       .
      366       create buf_c-fbr-prn.
      367       buffer-copy
      368       buf_c-fbr-prn-grp
      369       to buf_c-fbr-prn
      370       assign
      371       buf_c-fbr-prn.corr-time          = v-time
      372       buf_c-fbr-prn.corr-user-name     = g#userid
      373       buf_c-fbr-prn.corr-date          = v-date
      374       buf_c-fbr-prn.subject            = 'fbr-prn-grp':U
      375       buf_c-fbr-prn.action             = integer(if new(ub.fbr-prn-grp) then '1':U else '2':U)
      376       .
      377     end.
      378     if g#oxml = yes
      379     then do:
      380       run str/calloxml.p (
      381             input 'update':U
      382           , input 'fbr-prn-grp':U
      383           , input ( buffer ub.fbr-prn-grp:handle )
      384       ) no-error.
      385       if error-status :error
      386       then do:
      387           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      388                                , chr(10)
      389                                , vss-workfile
      390                                , return-value
      391                                , error-status :get-message ( 1 ) ).
      392       end.
      393     end.
      394   end.
