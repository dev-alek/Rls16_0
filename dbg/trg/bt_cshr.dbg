        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-log-handle  as handle no-undo .
        4   define input parameter p-parameter   as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Обработка изменений клиента-кассира".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
      305   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   DEFINE New SHARED TEMP-TABLE cash-cash no-undo
      307   FIELD stts like ub.clients.stts
      308   FIELD psn-code like ub.person.psn-code
      309   FIELD cash-code as integer
      310   FIELD slr-code  as integer
      311   FIELD superviser as integer
      312   FIELD cash-name like ub.clients.obj-name
      313   FIELD psswd as character
      314   FIELD s-psswd as character
      315   FIELD ident-type as integer
      316   index icli IS PRIMARY psn-code
      317   index icash cash-code stts
      318   index islr  slr-code stts
      319   .
      320   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      322                                                       ,input p-range-type as character
      323                                                       ,input p-code as integer):
      324   define variable v-seq-val as integer no-undo .
      325   define buffer buf_code-range for ub.code-range.
      326   find first buf_code-range no-lock where
      327             buf_code-range.db-num = p-db-num
      328       and  buf_code-range.range-type = p-range-type
      329       and  buf_code-range.stts = 'u'
      330       and buf_code-range.first-code <= p-code
      331       and buf_code-range.last-code >= p-code no-error .
      332   if available buf_code-range then return yes.
      333   CASE p-range-type:
      334     when 'pngb':U then do:
      335       v-seq-val = current-value(s-pngb-code, ub).
      336     end.
      337     when 'fmgb':U then do:
      338       v-seq-val = current-value(s-fmgb-code, ub).
      339     end.
      340   END CASE.
      341   if p-code <= v-seq-val then do:
      342     find first buf_code-range no-lock where
      343               buf_code-range.db-num = p-db-num
      344         and  buf_code-range.range-type = p-range-type
      345         and  buf_code-range.stts = 'a'
      346         and buf_code-range.first-code <= p-code
      347         no-error .
      348    if available buf_code-range then return yes.
      349   end.
      350   find first buf_code-range no-lock where
      351             buf_code-range.db-num = p-db-num
      352       and  buf_code-range.range-type = p-range-type
      353       and  buf_code-range.stts = 'f'
      354       and buf_code-range.first-code <= p-code
      355       and buf_code-range.last-code >= p-code
      356       no-error .
      357   if available buf_code-range then return yes.
      358   return no.
      359   END FUNCTION.
      360   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      361                                                       ,input p-range-type as character
      362                                                       ,input p-code as integer):
      363   define variable v-seq-val as integer no-undo .
      364   define buffer buf_code-range for ub.code-range.
      365   CASE p-range-type:
      366     when 'pngb':U then do:
      367       v-seq-val = current-value(s-pngb-code, ub).
      368     end.
      369     when 'fmgb':U then do:
      370       v-seq-val = current-value(s-fmgb-code, ub).
      371     end.
      372   END CASE.
      373   if p-code <= v-seq-val then do:
      374     find first buf_code-range no-lock where
      375               buf_code-range.db-num = p-db-num
      376         and  buf_code-range.range-type = p-range-type
      377         and buf_code-range.first-code <= p-code
      378         and buf_code-range.last-code >= p-code no-error .
      379     if available buf_code-range then return yes.
      380   end.
      381   return no.
      382   END FUNCTION.
      383   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      384                                                       ,input p-db-num as integer
      385                                                       ,input p-staff-code as integer
      386                                                       ,input p-date as date
      387                                                        ):
      388   define buffer buf_staff for ub.staff.
      389   if p-date = ? then do:
      390     p-date = today .
      391   end.
      392   find first buf_staff no-lock where
      393             buf_staff.role = p-role
      394         and buf_staff.role-level = 'db':U
      395         and buf_staff.db-num = p-db-num
      396         and buf_staff.staff-code = p-staff-code
      397         and buf_staff.date-end >= p-date use-index pi  no-error .
      398   if available buf_staff then do:
      399     return buf_staff.psn-code.
      400   end.
      401   return 0.
      402   end FUNCTION.
      403   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      404                                                             ,input p-db-num as integer
      405                                                             ,input p-date as date
      406                                                                 ):
      407   define buffer buf_staff for ub.staff.
      408   define buffer buf2_staff for ub.staff.
      409   if p-date = ? then do:
      410     p-date = today .
      411   end.
      412   for each  buf_staff no-lock where
      413             buf_staff.role = p-role
      414         and buf_staff.db-num = p-db-num,
      415   first buf2_staff no-lock where
      416         buf2_staff.role = p-role
      417     and buf2_staff.role-level = 'db':U
      418     and buf2_staff.staff-code = buf_staff.staff-code
      419     and buf2_staff.date-start <= p-date
      420     and buf2_staff.date-end >= p-date
      421   by buf_staff.staff-code
      422   by date-start descending:
      423     return buf_staff.staff-code.
      424   end.
      425   end FUNCTION.
      426   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      427                                                  ,input p-db-num as integer
      428                                                  ,input p-psn-code as integer
      429                                                  ,input p-date as date
      430                                                  ,output p-c-password as character
      431                                                        ):
      432   define buffer buf_staff for ub.staff.
      433   if p-date = ? then do:
      434     p-date = today .
      435   end.
      436   find first buf_staff no-lock where
      437             buf_staff.role = p-role
      438         and buf_staff.role-level = 'db':U
      439         and buf_staff.db-num = p-db-num
      440        and buf_staff.date-end >= p-date
      441        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      442   if available buf_staff
      443   then do:
      444     assign
      445     p-c-password = buf_staff.password.
      446     return buf_staff.staff-code.
      447   end.
      448   p-c-password = ''.
      449   return 0.
      450   end FUNCTION.
      451   FUNCTION gbclcode-is-psn-role returns integer (
      452                                                 input p-role as character
      453                                                 ,input p-psn-code as integer
      454                                                 ,input p-date as date
      455                                                     ):
      456   define buffer buf_staff for ub.staff.
      457   if p-date = ? then do:
      458     p-date = today .
      459   end.
      460   for each buf_staff no-lock where
      461             buf_staff.psn-code = p-psn-code
      462        and  buf_staff.role = p-role
      463   by buf_staff.role-level
      464   by buf_staff.date-start
      465        :
      466     if  buf_staff.date-start <= p-date and
      467     buf_staff.date-end >= p-date  then do:
      468       return buf_staff.staff-code.
      469     end.
      470   end.
      471   return 0.
      472   end FUNCTION.
      473   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      474   define variable v-role-name as character no-undo .
      475   assign
      476   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      477   no-error .
      478   return v-role-name.
      479   END.
      480   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      481   FUNCTION gbclcode-get-position returns character ( input p-role as character
      482                                                     ,input p-role-level as character
      483                                                     ,input p-work-place as character
      484                                                     ,input p-staff-code as integer
      485                                                                ):
      486   define variable v-role-name as character no-undo .
      487   define variable v-role-level as character no-undo .
      488   define variable v-staff-code as integer no-undo .
      489   assign
      490   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      491   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      492   v-staff-code = p-staff-code
      493   no-error .
      494   return substitute("&1, &2, Код &3"
      495                   ,v-role-name
      496                   ,v-role-level
      497                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      498   END.
      499   FUNCTION gbclcode-get-work-place returns character (
      500                                                   input p-role as character
      501                                                  ,input p-role-level as character
      502                                                  ,input p-db-num as integer
      503                                                  ,input p-host-code as integer
      504                                                  ,input p-obj-type as character
      505                                                  ,input p-obj-code as integer
      506                                                  ) :
      507   define variable v-work-place as character no-undo .
      508   define variable v-obj-type as character no-undo .
      509     case p-role-level:
      510       when 'db':U then do:
      511         v-work-place = string(p-db-num, "99999").
      512       end.
      513       when 'firm':U then do:
      514         v-work-place = string(p-host-code, "99999").
      515       end.
      516       when 'object':U then do:
      517         assign
      518         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      519         .
      520       end.
      521     END CASE.
      522     return v-work-place.
      523   END FUNCTION.
      524   FUNCTION gbclcode-get-level-last-code returns integer (
      525                                                           input p-role as character
      526                                                         , input p-role-level as character
      527                                                         , input p-work-place as character
      528                                                         , input p-date-start as date
      529                                                         ):
      530   DEFINE VARIABLE v-today as date no-undo .
      531   define buffer buf_staff for ub.staff.
      532   if p-work-place = chr(63) then return ?.
      533   if p-date-start = ? then do:
      534     v-today = today .
      535   end.
      536   else do:
      537     v-today = p-date-start.
      538   end.
      539   find last buf_staff no-lock where
      540             buf_staff.role = p-role
      541        and  buf_staff.role-level = p-role-level
      542        and  buf_staff.work-place = p-work-place
      543        and  buf_staff.date-start <= v-today + 1
      544        and  buf_staff.date-end >= v-today + 1
      545        use-index pi  no-error .
      546   if available buf_staff
      547   then return buf_staff.staff-code.
      548   return 0.
      549   end FUNCTION.
      550   define temp-table temp-csh-list no-undo
      551     field action-num  as integer
      552     field cashier     as integer
      553     field psn-code    like ub.person.psn-code
      554     field host-code   as integer
      555     field obj-type    as character
      556     field obj-code    as integer
      557     field action      as character
      558     field bp_rowid    as rowid
      559     index xpk is primary unique action-num
      560   .
      561   define variable  p-message-on as logical   no-undo .
      562   define variable log-file-name as character no-undo init "send-cd.txt":U.
      563   define variable v-view-log as logical no-undo .
      564   define variable v-stop as logical no-undo .
      565   main-block:
      566   do
      567   on error undo main-block, return error return-value
      568   :
      569   assign
      570   p-message-on = (if entry(1, p-parameter, chr(4)) = "yes"
      571                   then yes
      572                   else (if entry(1, p-parameter, chr(4)) = "no"
      573                         then no
      574                         else ?)
      575                  )
      576   no-error
      577   .
      578   if error-status:error or p-message-on = ? then return error.
      579     define buffer btpr-dc-lock_batchprocess for ub.batchprocess .
      580     run gbl/lock-prc.p
      581       (input 'cshr':U
      582       ,input 0
      583       ,input 0
      584       ,input 0
      585       ,input ""
      586       ,input ""
      587       ,input ""
      588       ,input ",,,,,,Обработка изменений клиента-кассира"
      589       ,input p-message-on
      590       ,buffer btpr-dc-lock_batchprocess
      591       ) no-error .
      592     if error-status :error
      593     then do:
      594       run write-log-and-file in p-log-handle (
      595             input 1
      596           , input log-file-name
      597           , input 1
      598           , input substitute("В данный момент происходит Обработка изменений клиента-кассира" )
      599                                                 ).
      600       undo, return.
      601     end.
      602     run write-log-and-file in p-log-handle (
      603           input 1
      604         , input log-file-name
      605         , input 1
      606         , input substitute("Ждите... Поиск информации, подлежащей отправке на кассы...")
      607                                               ).
      608     run create-csh-list in this-procedure .
      609     run process-csh-list in this-procedure .
      610     run close-csh-list in this-procedure .
      611   end.
      612   procedure create-csh-list :
      613     define buffer buf_batchprocess for ub.batchprocess .
      614     define buffer buf_temp-csh-list for temp-csh-list .
      615     do
      616     on error undo, return error return-value
      617     :
      618       for each buf_BatchProcess no-lock
      619         where buf_BatchProcess.bp_type       = 'cshr':U
      620           and buf_BatchProcess.bp_status     = 'N':U
      621       on error undo, return error return-value
      622       :
      623         create buf_temp-csh-list .
      624         assign
      625           buf_temp-csh-list.action-num = buf_BatchProcess.BatchProcess#
      626           buf_temp-csh-list.cashier    = integer(buf_BatchProcess.charkey_one)
      627           buf_temp-csh-list.psn-code   = buf_BatchProcess.key#_one
      628           buf_temp-csh-list.host-code  = buf_BatchProcess.key#_two
      629           buf_temp-csh-list.obj-type   = buf_BatchProcess.charkey_two
      630           buf_temp-csh-list.obj-code   = buf_BatchProcess.key#_three
      631           buf_temp-csh-list.action     = buf_BatchProcess.bp_execsystime
      632           buf_temp-csh-list.bp_rowid   = rowid(buf_BatchProcess)
      633         .
      634       end.
      635     end.
      636   end procedure.
      637   procedure process-csh-list :
      638     define buffer buf_temp-csh-list for temp-csh-list .
      639     define buffer cli_shops for ub.clients .
      640     define buffer buf_cash-desk for ub.cash-desk .
      641     define variable lns-cnt as integer no-undo .
      642     define variable line-rec as recid no-undo .
      643     define variable v-db-num like ub.db.db-num no-undo .
      644     DEFINE VARIABLE v-today as date no-undo .
      645     DEFINE VARIABLE v-time as integer no-undo .
      646     define variable v-seller-code as integer no-undo .
      647     define variable v-cashier-code as integer no-undo .
      648     define variable v-s-password as character no-undo .
      649     define variable v-c-password as character no-undo .
      650     define buffer buf_person for ub.person.
      651     define buffer buf_clients for ub.clients.
      652     do
      653     on error undo, return error return-value
      654     :
      655   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      656   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      657     (output v-db-num
      658     )  .
      659       for each buf_temp-csh-list
      660       on error undo, return error return-value
      661       :
      662         find first buf_person no-lock where
      663                    buf_person.psn-code = buf_temp-csh-list.psn-code no-error .
      664         if avail buf_person then do:
      665           find first buf_clients no-lock where
      666                      buf_clients.obj-type = 'чел':U
      667                 AND  buf_clients.obj-code = buf_person.psn-code.
      668           find first cash-cash where
      669                      cash-cash.cash-code = buf_temp-csh-list.cashier no-error .
      670           if not avail cash-cash then do:
      671             create cash-cash.
      672             assign
      673             cash-cash.cash-code = buf_temp-csh-list.cashier
      674             cash-cash.psn-code = buf_temp-csh-list.psn-code
      675             .
      676           end.
      677           v-seller-code = gbclcode-get-db-role (
      678                                                   input 'S':U
      679                                                   ,input v-db-num
      680                                                   ,input cash-cash.psn-code
      681                                                   ,input ?
      682                                                   ,output v-s-password ).
      683           v-cashier-code = gbclcode-get-db-role (
      684                                                   input 'C':U
      685                                                   ,input v-db-num
      686                                                   ,input cash-cash.psn-code
      687                                                   ,input ?
      688                                                   ,output v-c-password ).
      689           assign
      690           cash-cash.cash-name = buf_clients.obj-name
      691           cash-cash.stts      = (if buf_temp-csh-list.action = "D":U
      692                                  or v-cashier-code = 0
      693                                  then 1
      694                                  else 0)
      695           cash-cash.psswd     = v-c-password
      696           cash-cash.s-psswd   = v-s-password
      697           cash-cash.slr-code  = v-seller-code
      698           cash-cash.ident-type  = 1
      699           .
      700         end.
      701       end.
      702       if can-find(first cash-cash)
      703       and can-find(first buf_cash-desk where
      704                         buf_cash-desk.db-num = v-db-num ) then do:
      705         _cli-shops:
      706         FOR EACH cli_shops no-lock where
      707                cli_shops.obj-type = 'маг':U and
      708                cli_shops.db-num = v-db-num,
      709                FIRST buf_cash-desk where
      710                      buf_cash-desk.obj-code = cli_shops.obj-code:
      711           run get-stop-state in p-log-handle (output v-stop).
      712           if v-stop then do:
      713             run write-log-and-file in p-log-handle (
      714                   input 1
      715                 , input log-file-name
      716                 , input 1
      717                 , input substitute("!!!Процедура пересылки остановлена пользователем"
      718                                     )
      719                                       ).
      720             leave _cli-shops.
      721           end.
      722           run str/send-csh.p (  input parparentproc
      723                            ,input this-procedure
      724                            ,input p-log-handle
      725                            ,input(string(cli_shops.obj-code) + chr(4) + "U":U + chr(4) + "yes":U)
      726                         ) .
      727         end.
      728       end.
      729       if not v-stop then do:
      730         find first buf_cash-desk no-lock where
      731                     buf_cash-desk.db-num = g#db-num
      732                 AND buf_cash-desk.cash-on = yes
      733                 AND buf_cash-desk.pos-type = 'MAGIA-XML':U no-error .
      734         if available buf_cash-desk then do:
      735             run str/send-stf.p (  input parparentproc
      736                             ,input this-procedure
      737                             ,input p-log-handle
      738                             ,input('маг':U + chr(4) + string(buf_cash-desk.obj-code) + chr(4) + "U":U +
      739                                     chr(4) + "yes":U)
      740                           ) .
      741         end.
      742       end.
      743     end.
      744   end procedure.
      745   procedure close-csh-list :
      746     define buffer buf_batchprocess for ub.batchprocess .
      747     define buffer buf_temp-csh-list for temp-csh-list .
      748     do
      749     on error undo, return error return-value
      750     :
      751       for each buf_temp-csh-list
      752       on error undo, return error return-value
      753       :
      754         do transaction
      755         on error undo, return error return-value
      756         :
      757     find first buf_batchprocess exclusive-lock
      758       where rowid(buf_batchprocess) = buf_temp-csh-list.bp_rowid
      759       no-error .
      760     if not available buf_batchprocess then do:
      761       message
      762         vss-workfile vss-revision vss-description skip
      763         "Не найдена запись пересчета архива" skip
      764         view-as alert-box error .
      765       undo, return error .
      766     end.
      767     if buf_batchprocess.bp_status <> 'N':U then do:
      768       message
      769         vss-workfile vss-revision vss-description skip
      770         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
      771         "BP_Type"       buf_batchprocess.BP_Type       skip
      772         "BP_Status"     buf_batchprocess.BP_Status     skip
      773         "Key#_One"      buf_batchprocess.Key#_One      skip
      774         "Key#_Two"      buf_batchprocess.Key#_Two      skip
      775         "Key#_Three"    buf_batchprocess.Key#_Three    skip
      776         "CharKey_One"   buf_batchprocess.CharKey_One   skip
      777         "CharKey_Two"   buf_batchprocess.CharKey_Two   skip
      778         "CharKey_Three" buf_batchprocess.CharKey_Three skip
      779         view-as alert-box error .
      780       undo, return error .
      781     end.
      782       define variable v-btpr_upd-today-5 as date      no-undo.
      783     define variable v-btpr_upd-time-5  as integer   no-undo.
      784     run cur-time in this-procedure ( output v-btpr_upd-today-5
      785                                    , output v-btpr_upd-time-5
      786                                    ).
      787     assign
      788       buf_batchprocess.bp_status         = 'D':U
      789       buf_batchprocess.bp_execcounttries = buf_batchprocess.bp_execcounttries + 1
      790       buf_batchprocess.bp_execuser_id    = g#userid
      791       buf_batchprocess.bp_execsysdate    = v-btpr_upd-today-5
      792       buf_batchprocess.bp_execsystime    = string(v-btpr_upd-time-5, 'hh:mm')
      793       buf_batchprocess.bp_execsystimeint = v-btpr_upd-time-5
      794     .
      795         end.
      796       end.
      797     end.
      798   end procedure.
