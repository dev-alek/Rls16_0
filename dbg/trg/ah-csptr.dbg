     3240     (input  buf_trn-doc.obj-type
     3241     ,input  buf_trn-doc.obj-code
     3242     ,input  'cons-pay=request'
     3243     ,output v-cons-pay
     3244     ,output v-cons-type
     3245     ) no-error .
     3246     if error-status :error
     3247     then do:
     3248       message
     3249         vss-workfile vss-revision vss-description skip
     3250         "Ошибка при запуске процедуры objatext" skip
     3251         error-status :get-message(1) skip
     3252         return-value skip
     3253         view-as alert-box error .
     3254       undo main-block, return error .
     3255     end.
     3256     run factord in this-procedure
     3257       (input  buf_trn-doc.fact-date
     3258       ,input  buf_trn-doc.fact-time
     3259       ,input  buf_trn-doc.fact-num
     3260       ,input  buf_trn-doc.shift-date
     3261       ,input  buf_trn-doc.shift-num
     3262       ,input  v-shift-on
     3263       ,output v-fact-order
     3264       ,output v-shift-end-fact-order
     3265       ,output v-day-end-fact-order
     3266       ) no-error .
     3267     if error-status :error
     3268     or v-fact-order = ?
     3269     or v-fact-order = 0
     3270     then do:
     3271       message
     3272         vss-workfile vss-revision vss-description skip
     3273         "Ошибка при определении фактического номера складского документа" skip
     3274         "doc-code"                buf_trn-doc.doc-code    skip
     3275         "fact-date"               buf_trn-doc.fact-date   skip
     3276         "fact-time"               buf_trn-doc.fact-time   skip
     3277         "fact-num"                buf_trn-doc.fact-num    skip
     3278         "shift-date"              buf_trn-doc.shift-date  skip
     3279         "shift-num"               buf_trn-doc.shift-num   skip
     3280         "v-fact-order"            v-fact-order           skip
     3281         "v-shift-end-fact-order"  v-shift-end-fact-order skip
     3282         "v-day-end-fact-order"    v-day-end-fact-order   skip
     3283         error-status :get-message(1) skip
     3284         return-value skip
     3285         view-as alert-box error .
     3286       undo, return error .
     3287     end.
     3288     if p-cut-date = ?
     3289     then do:
     3290       run factord-max-fact-order in this-procedure
     3291         (output v-shift-cut-fact-order
     3292         ) .
     3293       run factord-max-fact-order in this-procedure
     3294         (output v-day-cut-fact-order
     3295         ) .
     3296     end.
     3297     else do:
     3298       if p-cut-date = buf_trn-doc.fact-date
     3299       then do:
     3300         assign
     3301           v-day-end-fact-order = v-day-end-fact-order - 0.0000000001
     3302         .
     3303         if v-shift-on = true
     3304         then do:
     3305           define buffer buf_shift-obj for ub.shift-obj .
     3306           find last buf_shift-obj
     3307             where buf_shift-obj.obj-type    = buf_trn-doc.obj-type
     3308               and buf_shift-obj.obj-code    = buf_trn-doc.obj-code
     3309               and buf_shift-obj.shift-date <= p-cut-date
     3310             use-index pi
     3311             no-error .
     3312           if not available buf_shift-obj
     3313           or buf_shift-obj.status_ <> 'зкр':U
     3314           then do:
     3315             message
     3316               vss-workfile vss-revision vss-description skip
     3317               "Ошибка при поиске последней смены" skip
     3318               "Объект" buf_trn-doc.obj-type buf_trn-doc.obj-code skip
     3319               "Дата" p-cut-date skip
     3320               view-as alert-box error .
     3321             undo, return error return-value .
     3322           end.
     3323           if  buf_trn-doc.shift-date = buf_shift-obj.shift-date
     3324           and buf_trn-doc.shift-num  = buf_shift-obj.shift-num
     3325           then do:
     3326             assign
     3327               v-shift-end-fact-order = v-shift-end-fact-order - 0.0000000001
     3328             .
     3329           end.
     3330         end.
     3331       end.
     3332       assign
     3333         v-shift-cut-fact-order = v-shift-end-fact-order
     3334         v-day-cut-fact-order   = v-day-end-fact-order
     3335       .
     3336     end.
     3337     def frame infa
     3338       ub.trn-doc.doc-code                      label "Документ" skip
     3339       ub.trn-doc.obj-type                      label "Объект"
     3340       ub.trn-doc.obj-code                      no-label skip
     3341       ub.trn-doc.fact-date format "99/99/9999" label "Дата закрытия" skip
     3342       current-action       format "x(40)"      no-label skip
     3343       v-ind                format ">>>>>>>9"   label "Обработано артикулов" skip
     3344       ub.doc-line.artic                        label "Текущий артикул" skip
     3345       current-time         format "x(8)"       label "Время расчета документа" skip
     3346       with view-as dialog-box side-labels three-d
     3347       title "Расчет складского архива по поставщикам"
     3348       .
     3349     define variable mFrameView      as logical   no-undo init yes.
     3350     define variable mFramHandle as handle no-undo.
     3351     mFramHandle = frame infa:handle.
     3352     if  log-manager:logfile-name ne ?
     3353     then DO:
     3354         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameoxmError").
     3355         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameoxmError").
     3356         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameoxmError").
     3357     end.
     3358     mFrameView = not session:batch-mode and mFramHandle:visible.
     3359     run cur-time in this-procedure ( output v-today
     3360                                    , output start-time
     3361                                    ).
     3362     if mFrameView
     3363     then do:
     3364        view frame infa .
     3365     display
     3366       buf_trn-doc.doc-code @ ub.trn-doc.doc-code
     3367       buf_trn-doc.obj-type @ ub.trn-doc.obj-type
     3368       buf_trn-doc.obj-code @ ub.trn-doc.obj-code
     3369       buf_trn-doc.fact-date @ ub.trn-doc.fact-date
     3370       with frame infa .
     3371     end.
     3372     run show-action in this-procedure
     3373       (input "Обработка строк документа"
     3374       ).
     3375     assign
     3376       v-ot-fact-order                  = v-fact-order
     3377       v-stk-supp-tot-fact-order        = v-day-end-fact-order
     3378       v-stk-supp-line-fact-order       = v-day-end-fact-order
     3379       v-shift-stk-supp-tot-fact-order  = v-shift-end-fact-order
     3380       v-shift-stk-supp-line-fact-order = v-shift-end-fact-order
     3381     .
     3382     if p-check-only <> true
     3383     then do:
     3384       run init-ot-table in this-procedure no-error .
     3385       if error-status :error
     3386       then do:
     3387         message
     3388           vss-workfile vss-revision vss-description skip
     3389           "Ошибка при вызове процедуры init-ot-table" skip
     3390           error-status :get-message(1) skip
     3391           return-value skip
     3392           view-as alert-box error .
     3393         undo main-block, return error .
     3394       end.
     3395     end.
     3396     for each buf_doc-line no-lock
     3397       where buf_doc-line.doc-code = buf_trn-doc.doc-code
     3398     on error undo main-block, return error
     3399     :
     3400       run process-doc-line in this-procedure
     3401         (input buf_doc-line.doc-code
     3402         ,input buf_doc-line.obj-type
     3403         ,input buf_doc-line.obj-code
     3404         ,input buf_doc-line.artic
     3405         ,input buf_doc-line.prod-type
     3406         ,input buf_doc-line.prod-code
     3407         ) no-error .
     3408       if error-status :error
     3409       then do:
     3410         message
     3411           vss-workfile vss-revision vss-description skip
     3412           "Ошибка при вызове процедуры process-doc-line" skip
     3413           error-status :get-message(1) skip
     3414           return-value skip
     3415           view-as alert-box error .
     3416         undo main-block, return error .
     3417       end.
     3418       assign
     3419         v-ind = v-ind + 1
     3420       .
     3421       if v-ind modulo 10 = 0
     3422       then do:
     3423         run cur-time in this-procedure ( output v-today
     3424                                        , output v-time
     3425                                        ).
     3426         assign
     3427           current-time = string(v-time - start-time, "HH:MM:SS")
     3428         .
     3429         if mFrameView
     3430         then do:
     3431         display
     3432           v-ind
     3433           buf_doc-line.artic
     3434           current-time
     3435           with frame infa .
     3436         end.
     3437       end.
     3438     end.
     3439     if p-check-only <> true
     3440     then do:
     3441       run update-ot-supp-tot in this-procedure no-error .
     3442       if error-status :error
     3443       then do:
     3444         message
     3445           vss-workfile vss-revision vss-description skip
     3446           "Ошибка при вызове процедуры update-ot-supp-tot" skip
     3447           error-status :get-message(1) skip
     3448           return-value skip
     3449           view-as alert-box error .
     3450         undo main-block, return error .
     3451       end.
     3452       run init-stk-table in this-procedure no-error .
     3453       if error-status :error
     3454       then do:
     3455         message
     3456           vss-workfile vss-revision vss-description skip
     3457           "Ошибка при вызове процедуры init-stk-table" skip
     3458           error-status :get-message(1) skip
     3459           return-value skip
     3460           view-as alert-box error .
     3461         undo main-block, return error .
     3462       end.
     3463       run update-stk-table in this-procedure no-error .
     3464       if error-status :error
     3465       then do:
     3466         message
     3467           vss-workfile vss-revision vss-description skip
     3468           "Ошибка при вызове процедуры update-stk-table" skip
     3469           error-status :get-message(1) skip
     3470           return-value skip
     3471           view-as alert-box error .
     3472         undo main-block, return error .
     3473       end.
     3474       run show-action in this-procedure
     3475         (input "Сохранение складского архива по поставщикам в базу данных"
     3476         ).
     3477       run store-ot-table in this-procedure no-error .
     3478       if error-status :error
     3479       then do:
     3480         message
     3481           vss-workfile vss-revision vss-description skip
     3482           "Ошибка при вызове процедуры store-ot-table" skip
     3483           error-status :get-message(1) skip
     3484           return-value skip
     3485           view-as alert-box error .
     3486         undo main-block, return error .
     3487       end.
     3488       run store-stk-temp-table in this-procedure no-error .
     3489       if error-status :error
     3490       then do:
     3491         message
     3492           vss-workfile vss-revision vss-description skip
     3493           "Ошибка при вызове процедуры store-stk-temp-table" skip
     3494           error-status :get-message(1) skip
     3495           return-value skip
     3496           view-as alert-box error .
     3497         undo main-block, return error .
     3498       end.
     3499       run show-action in this-procedure
     3500         (input "Расчет документа закончен"
     3501         ).
     3502     end.
     3503     else do:
     3504       run check-need-process in this-procedure
     3505         (output p-need-process
     3506         ) .
     3507     end.
     3508   end.
     3509   procedure init-ot-table :
     3510     define buffer buf_ot-supp-tot for ub.ot-supp-tot .
     3511     define buffer buf_ot-supp-line for ub.ot-supp-line .
     3512     define buffer buf_temp-ot-supp-tot for temp-ot-supp-tot .
     3513     define buffer buf_temp-ot-supp-line for temp-ot-supp-line .
     3514     do
     3515     on error undo, return error
     3516     :
     3517       for each buf_ot-supp-tot no-lock
     3518         where buf_ot-supp-tot.doc-code = buf_trn-doc.doc-code
     3519       on error undo, return error
     3520       :
     3521         create buf_temp-ot-supp-tot .
     3522         buffer-copy buf_ot-supp-tot to buf_temp-ot-supp-tot
     3523           .
     3524       end.
     3525       for each buf_ot-supp-line no-lock
     3526         where buf_ot-supp-line.doc-code  = buf_trn-doc.doc-code
     3527       on error undo, return error
     3528       :
     3529         create buf_temp-ot-supp-line .
     3530         buffer-copy buf_ot-supp-line to buf_temp-ot-supp-line
     3531           .
     3532       end.
     3533     end.
     3534   end procedure.
     3535   procedure process-doc-line :
     3536     define input  parameter p-doc-code  as character no-undo .
     3537     define input  parameter p-obj-type  as character no-undo .
     3538     define input  parameter p-obj-code  as integer   no-undo .
     3539     define input  parameter p-artic     as character no-undo .
     3540     define input  parameter p-prod-type as character no-undo .
     3541     define input  parameter p-prod-code as integer   no-undo .
     3542     define buffer buf_tt-clcparts for tt-clcparts .
     3543     define buffer buf_parts for ub.parts .
     3544     define buffer buf_doc-line for ub.doc-line .
     3545     define buffer buf_tt-allsum-line for tt-allsum-line .
     3546     define buffer buf_temp-ot-supp-line for temp-ot-supp-line .
     3547     do
     3548     on error undo, return error
     3549     :
     3550       define variable ind-ext    as integer no-undo .
     3551       define variable v-cat-id   as character no-undo extent 2 .
     3552       define variable v-sum-type as character no-undo extent 2 .
     3553       define variable v-curr-r-b as character no-undo .
     3554   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3555   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3556     (output v-curr-r-b
     3557     )  .
     3558       define variable v-gds-goods as logical   no-undo .
     3559   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3560   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     3561     (input  p-artic
     3562     ,input  p-prod-type
     3563     ,input  p-prod-code
     3564     ,input  'gds-goods=request':u
     3565     ,output v-gds-goods
     3566     ) no-error .
     3567       if error-status :error then do:
     3568         message
     3569           vss-workfile vss-revision vss-description skip
     3570           "Ошибка при определении атрибута товара" skip
     3571           "Переоценка" p-doc-code skip
     3572           "Артикул" p-artic p-prod-type p-prod-code skip
     3573           'gds-goods=request':u
     3574           view-as alert-box error .
     3575         undo, return error .
     3576       end.
     3577       if v-gds-goods <> true
     3578       then do:
     3579         next .
     3580       end.
     3581       define variable v-doc-sign as integer   no-undo .
     3582       if buf_trn-doc.doc-type = 'рас':U
     3583       or buf_trn-doc.doc-type = 'спи':U
     3584       then do:
     3585         assign
     3586           v-doc-sign = -1
     3587         .
     3588       end.
     3589       else do:
     3590         assign
     3591           v-doc-sign = 1
     3592         .
     3593       end.
     3594       for each buf_parts no-lock
     3595         where buf_parts.out-code  = p-doc-code
     3596           and buf_parts.obj-type  = p-obj-type
     3597           and buf_parts.obj-code  = p-obj-code
     3598           and buf_parts.artic     = p-artic
     3599           and buf_parts.prod-type = p-prod-type
     3600           and buf_parts.prod-code = p-prod-code
     3601       on error undo, return error
     3602       :
     3603         for each buf_tt-clcparts
     3604         on error undo, return error return-value
     3605         :
     3606           delete buf_tt-clcparts .
     3607         end.
     3608         create buf_tt-clcparts .
     3609         buffer-copy buf_parts to buf_tt-clcparts .
     3610         find first buf_doc-line no-lock
     3611           where buf_doc-line.doc-code  = p-doc-code
     3612             and buf_doc-line.artic     = p-artic
     3613             and buf_doc-line.prod-type = p-prod-type
     3614             and buf_doc-line.prod-code = p-prod-code
     3615           no-error .
     3616         if not available buf_doc-line
     3617         then do:
     3618           message
     3619             vss-workfile vss-revision vss-description skip
     3620             "Не найдена строка документа" skip
     3621             "Складской документ" p-doc-code skip
     3622             "Артикул" p-artic p-prod-type p-prod-code skip
     3623             view-as alert-box error .
     3624           undo, return error return-value .
     3625         end.
     3626         run clcprtsl_calc-ttable in this-procedure
     3627           (input true
     3628           ,input false
     3629           ,input buf_doc-line.road-tax
     3630           ,input buf_doc-line.excise
     3631           ,input buf_doc-line.vat-pc
     3632           ,input buf_doc-line.cons-vat-pc
     3633           ,input buf_doc-line.slt-pc
     3634           ,input buf_trn-doc.base-rate
     3635           ,input buf_trn-doc.base-scale
     3636           ,input v-curr-r-b
     3637           ,input ?
     3638           ,input ?
     3639           ,input ?
     3640           ,input ?
     3641           ,input ?
     3642           ,input ?
     3643           ) no-error .
     3644         if error-status :error
     3645         then do:
     3646           message
     3647             vss-workfile vss-revision vss-description skip
     3648             "Ошибка при вызове процедуры clcprtsl_calc-ttable" skip
     3649             error-status :get-message(1) skip
     3650             return-value skip
     3651             view-as alert-box error .
     3652           undo, return error return-value .
     3653         end.
     3654         define variable v-ahsp-type-ind        as integer   no-undo .
     3655         define variable v-ahsp-type-list       as character extent 5 no-undo
     3656           initial ['prch':U, 'cacc':U, 'benf':U, 'stor':U, 'cons':U] .
     3657         define variable v-allsum-sum-type-list as character extent 5 no-undo
     3658           initial ['сумма_по_выкупу_со_знаком':U, 'сумма_по_консигнации_закупка_со_знаком':U, 'сумма_по_консигнации_выгода_со_знаком':U, 'сумма_по_ответственному_хранению_со_знаком':U, 'сумма_по_старой_консигнации_со_знаком':U ] .
     3659         define variable v-ahsp-type            as character no-undo .
     3660         define variable v-allsum-sum-type      as character no-undo .
     3661         do v-ahsp-type-ind = 1 to extent(v-ahsp-type-list)
     3662         :
     3663           assign
     3664             v-ahsp-type       = v-ahsp-type-list[v-ahsp-type-ind]
     3665             v-allsum-sum-type = v-allsum-sum-type-list[v-ahsp-type-ind]
     3666           .
     3667           find first buf_tt-allsum-line
     3668             where buf_tt-allsum-line.sum-type = v-allsum-sum-type
     3669             no-error .
     3670           if available buf_tt-allsum-line
     3671           then do:
     3672             assign
     3673               v-fact-qnty      = buf_tt-allsum-line.fact-qnty
     3674               v-sum-base       = buf_tt-allsum-line.sum-dsc-base-acc
     3675               v-sum-rubl       = buf_tt-allsum-line.sum-dsc-rubl-acc
     3676               v-vat-base       = buf_tt-allsum-line.vat-base-acc
     3677               v-vat-rubl       = buf_tt-allsum-line.vat-rubl-acc
     3678               v-slt-base       = buf_tt-allsum-line.slt-base-acc
     3679               v-slt-rubl       = buf_tt-allsum-line.slt-rubl-acc
     3680               v-road-tax-base  = buf_tt-allsum-line.road-tax-base-acc
     3681               v-road-tax-rubl  = buf_tt-allsum-line.road-tax-rubl-acc
     3682               v-excise-base    = buf_tt-allsum-line.excise-base-acc
     3683               v-excise-rubl    = buf_tt-allsum-line.excise-rubl-acc
     3684               v-transport-base = buf_tt-allsum-line.transport-base-acc
     3685               v-transport-rubl = buf_tt-allsum-line.transport-rubl-acc
     3686               v-other-base     = buf_tt-allsum-line.other-base-acc
     3687               v-other-rubl     = buf_tt-allsum-line.other-rubl-acc
     3688             .
     3689             assign
     3690               v-sale-fact-qnty      = buf_tt-allsum-line.fact-qnty
     3691               v-sale-sum-base       = buf_tt-allsum-line.sum-dsc-base-doc
     3692               v-sale-sum-rubl       = buf_tt-allsum-line.sum-dsc-rubl-doc
     3693               v-sale-vat-base       = buf_tt-allsum-line.vat-base-doc
     3694               v-sale-vat-rubl       = buf_tt-allsum-line.vat-rubl-doc
     3695               v-sale-slt-base       = buf_tt-allsum-line.slt-base-doc
     3696               v-sale-slt-rubl       = buf_tt-allsum-line.slt-rubl-doc
     3697               v-sale-road-tax-base  = buf_tt-allsum-line.road-tax-base-doc
     3698               v-sale-road-tax-rubl  = buf_tt-allsum-line.road-tax-rubl-doc
     3699               v-sale-excise-base    = buf_tt-allsum-line.excise-base-doc
     3700               v-sale-excise-rubl    = buf_tt-allsum-line.excise-rubl-doc
     3701               v-sale-transport-base = buf_tt-allsum-line.transport-base-acc
     3702               v-sale-transport-rubl = buf_tt-allsum-line.transport-rubl-acc
     3703               v-sale-other-base     = buf_tt-allsum-line.dsc-base-doc
     3704               v-sale-other-rubl     = buf_tt-allsum-line.dsc-rubl-doc
     3705             .
     3706           end.
     3707           else do:
     3708             assign
     3709               v-fact-qnty      = 0
     3710               v-sum-base       = 0
     3711               v-sum-rubl       = 0
     3712               v-vat-base       = 0
     3713               v-vat-rubl       = 0
     3714               v-slt-base       = 0
     3715               v-slt-rubl       = 0
     3716               v-road-tax-base  = 0
     3717               v-road-tax-rubl  = 0
     3718               v-excise-base    = 0
     3719               v-excise-rubl    = 0
     3720               v-transport-base = 0
     3721               v-transport-rubl = 0
     3722               v-other-base     = 0
     3723               v-other-rubl     = 0
     3724             .
     3725             assign
     3726               v-sale-fact-qnty      = 0
     3727               v-sale-sum-base       = 0
     3728               v-sale-sum-rubl       = 0
     3729               v-sale-vat-base       = 0
     3730               v-sale-vat-rubl       = 0
     3731               v-sale-slt-base       = 0
     3732               v-sale-slt-rubl       = 0
     3733               v-sale-road-tax-base  = 0
     3734               v-sale-road-tax-rubl  = 0
     3735               v-sale-excise-base    = 0
     3736               v-sale-excise-rubl    = 0
     3737               v-sale-transport-base = 0
     3738               v-sale-transport-rubl = 0
     3739               v-sale-other-base     = 0
     3740               v-sale-other-rubl     = 0
     3741             .
     3742           end.
     3743           if v-ahsp-type = 'benf':U
     3744           then do:
     3745             assign
     3746               v-fact-qnty      = 0
     3747               v-sale-fact-qnty = 0
     3748             .
     3749           end.
     3750           if
     3751                                           v-fact-qnty      = ? or    v-sum-base       = ? or    v-sum-rubl       = ? or    v-vat-base       = ? or    v-vat-rubl       = ? or    v-slt-base       = ? or    v-slt-rubl       = ? or    v-road-tax-base  = ? or    v-road-tax-rubl  = ? or    v-excise-base    = ? or    v-excise-rubl    = ? or    v-transport-base = ? or    v-transport-rubl = ? or    v-other-base     = ? or    v-other-rubl     = ?
     3752           then do:
     3753             message
     3754               vss-workfile vss-revision vss-description skip
     3755               "Программа clcprtsl.i вернула неопределенные значения" skip
     3756               "Расчет складского архива по поставщикам невозможен" skip
     3757               "Документ" p-doc-code skip
     3758               "Артикул" p-artic p-prod-type p-prod-code skip
     3759                                                                                       "v-fact-qnty"      v-fact-qnty        skip    "v-sum-base"       v-sum-base         skip    "v-sum-rubl"       v-sum-rubl         skip    "v-vat-base"       v-vat-base         skip    "v-vat-rubl"       v-vat-rubl         skip    "v-slt-base"       v-slt-base         skip    "v-slt-rubl"       v-slt-rubl         skip    "v-road-tax-base"  v-road-tax-base    skip    "v-road-tax-rubl"  v-road-tax-rubl    skip    "v-excise-base"    v-excise-base      skip    "v-excise-rubl"    v-excise-rubl      skip    "v-transport-base" v-transport-base   skip    "v-transport-rubl" v-transport-rubl   skip    "v-other-base"     v-other-base       skip    "v-other-rubl"     v-other-rubl
     3760               view-as alert-box error .
     3761             undo, return error .
     3762           end.
     3763           if
     3764                                           v-sale-fact-qnty      = ? or    v-sale-sum-base       = ? or    v-sale-sum-rubl       = ? or    v-sale-vat-base       = ? or    v-sale-vat-rubl       = ? or    v-sale-slt-base       = ? or    v-sale-slt-rubl       = ? or    v-sale-road-tax-base  = ? or    v-sale-road-tax-rubl  = ? or    v-sale-excise-base    = ? or    v-sale-excise-rubl    = ? or    v-sale-transport-base = ? or    v-sale-transport-rubl = ? or    v-sale-other-base     = ? or    v-sale-other-rubl     = ?
     3765           then do:
     3766             message
     3767               vss-workfile vss-revision vss-description skip
     3768               "Программа clcprtsl.i вернула неопределенные значения" skip
     3769               "Расчет складского архива по поставщикам невозможен" skip
     3770               "Документ" p-doc-code skip
     3771               "Артикул" p-artic p-prod-type p-prod-code skip
     3772                                                                                       "v-sale-fact-qnty"      v-sale-fact-qnty        skip    "v-sale-sum-base"       v-sale-sum-base         skip    "v-sale-sum-rubl"       v-sale-sum-rubl         skip    "v-sale-vat-base"       v-sale-vat-base         skip    "v-sale-vat-rubl"       v-sale-vat-rubl         skip    "v-sale-slt-base"       v-sale-slt-base         skip    "v-sale-slt-rubl"       v-sale-slt-rubl         skip    "v-sale-road-tax-base"  v-sale-road-tax-base    skip    "v-sale-road-tax-rubl"  v-sale-road-tax-rubl    skip    "v-sale-excise-base"    v-sale-excise-base      skip    "v-sale-excise-rubl"    v-sale-excise-rubl      skip    "v-sale-transport-base" v-sale-transport-base   skip    "v-sale-transport-rubl" v-sale-transport-rubl   skip    "v-sale-other-base"     v-sale-other-base       skip    "v-sale-other-rubl"     v-sale-other-rubl
     3773               view-as alert-box error .
     3774             undo, return error .
     3775           end.
     3776           assign
     3777             v-sum-type[1] = 'cost':U
     3778             v-cat-id[1]   = '##':U
     3779             v-sum-type[2] = 'cost':U + 'p':U
     3780             v-cat-id[2]   = v-ahsp-type
     3781           .
     3782           do ind-ext = 1 to 2
     3783           :
     3784             find first buf_temp-ot-supp-line
     3785               where buf_temp-ot-supp-line.doc-code  = p-doc-code
     3786                 and buf_temp-ot-supp-line.cli-type  = buf_parts.supp-type
     3787                 and buf_temp-ot-supp-line.cli-code  = buf_parts.supp-code
     3788                 and buf_temp-ot-supp-line.artic     = buf_parts.artic
     3789                 and buf_temp-ot-supp-line.prod-type = buf_parts.prod-type
     3790                 and buf_temp-ot-supp-line.prod-code = buf_parts.prod-code
     3791                 and buf_temp-ot-supp-line.sum-type  = v-sum-type[ind-ext]
     3792                 and buf_temp-ot-supp-line.cat-id    = v-cat-id[ind-ext]
     3793               no-error .
     3794             if not available buf_temp-ot-supp-line
     3795             then do:
     3796               create buf_temp-ot-supp-line .
     3797               assign
     3798                 buf_temp-ot-supp-line.doc-code  = p-doc-code
     3799                 buf_temp-ot-supp-line.cli-type  = buf_parts.supp-type
     3800                 buf_temp-ot-supp-line.cli-code  = buf_parts.supp-code
     3801                 buf_temp-ot-supp-line.artic     = buf_parts.artic
     3802                 buf_temp-ot-supp-line.prod-type = buf_parts.prod-type
     3803                 buf_temp-ot-supp-line.prod-code = buf_parts.prod-code
     3804                 buf_temp-ot-supp-line.sum-type  = v-sum-type[ind-ext]
     3805                 buf_temp-ot-supp-line.cat-id    = v-cat-id[ind-ext]
     3806                 buf_temp-ot-supp-line.ext-doc-type = buf_trn-doc.ext-doc-type
     3807                 buf_temp-ot-supp-line.obj-type     = buf_trn-doc.obj-type
     3808                 buf_temp-ot-supp-line.obj-code     = buf_trn-doc.obj-code
     3809                 buf_temp-ot-supp-line.fact-order   = v-ot-fact-order
     3810               .
     3811             end.
     3812             assign
     3813                                                                                                               buf_temp-ot-supp-line.new-fact-qnty      = buf_temp-ot-supp-line.new-fact-qnty      + v-fact-qnty           buf_temp-ot-supp-line.new-sum-base       = buf_temp-ot-supp-line.new-sum-base       + v-sum-base            buf_temp-ot-supp-line.new-sum-rubl       = buf_temp-ot-supp-line.new-sum-rubl       + v-sum-rubl            buf_temp-ot-supp-line.new-vat-base       = buf_temp-ot-supp-line.new-vat-base       + v-vat-base            buf_temp-ot-supp-line.new-vat-rubl       = buf_temp-ot-supp-line.new-vat-rubl       + v-vat-rubl            buf_temp-ot-supp-line.new-slt-base       = buf_temp-ot-supp-line.new-slt-base       + v-slt-base            buf_temp-ot-supp-line.new-slt-rubl       = buf_temp-ot-supp-line.new-slt-rubl       + v-slt-rubl            buf_temp-ot-supp-line.new-road-tax-base  = buf_temp-ot-supp-line.new-road-tax-base  + v-road-tax-base       buf_temp-ot-supp-line.new-road-tax-rubl  = buf_temp-ot-supp-line.new-road-tax-rubl  + v-road-tax-rubl       buf_temp-ot-supp-line.new-excise-base    = buf_temp-ot-supp-line.new-excise-base    + v-excise-base         buf_temp-ot-supp-line.new-excise-rubl    = buf_temp-ot-supp-line.new-excise-rubl    + v-excise-rubl         buf_temp-ot-supp-line.new-transport-base = buf_temp-ot-supp-line.new-transport-base + v-transport-base      buf_temp-ot-supp-line.new-transport-rubl = buf_temp-ot-supp-line.new-transport-rubl + v-transport-rubl      buf_temp-ot-supp-line.new-other-base     = buf_temp-ot-supp-line.new-other-base     + v-other-base          buf_temp-ot-supp-line.new-other-rubl     = buf_temp-ot-supp-line.new-other-rubl     + v-other-rubl
     3814             .
     3815           end.
     3816           find first buf_temp-ot-supp-line
     3817             where buf_temp-ot-supp-line.doc-code  = p-doc-code
     3818               and buf_temp-ot-supp-line.cli-type  = buf_parts.supp-type
     3819               and buf_temp-ot-supp-line.cli-code  = buf_parts.supp-code
     3820               and buf_temp-ot-supp-line.artic     = buf_parts.artic
     3821               and buf_temp-ot-supp-line.prod-type = buf_parts.prod-type
     3822               and buf_temp-ot-supp-line.prod-code = buf_parts.prod-code
     3823               and buf_temp-ot-supp-line.sum-type  = 'sale':U
     3824               and buf_temp-ot-supp-line.cat-id    = '##':U
     3825             no-error .
     3826           if not available buf_temp-ot-supp-line
     3827           then do:
     3828             create buf_temp-ot-supp-line .
     3829             assign
     3830               buf_temp-ot-supp-line.doc-code  = p-doc-code
     3831               buf_temp-ot-supp-line.cli-type  = buf_parts.supp-type
     3832               buf_temp-ot-supp-line.cli-code  = buf_parts.supp-code
     3833               buf_temp-ot-supp-line.artic     = buf_parts.artic
     3834               buf_temp-ot-supp-line.prod-type = buf_parts.prod-type
     3835               buf_temp-ot-supp-line.prod-code = buf_parts.prod-code
     3836               buf_temp-ot-supp-line.sum-type  = 'sale':U
     3837               buf_temp-ot-supp-line.cat-id    = '##':U
     3838               buf_temp-ot-supp-line.ext-doc-type = buf_trn-doc.ext-doc-type
     3839               buf_temp-ot-supp-line.obj-type     = buf_trn-doc.obj-type
     3840               buf_temp-ot-supp-line.obj-code     = buf_trn-doc.obj-code
     3841               buf_temp-ot-supp-line.fact-order   = v-ot-fact-order
     3842             .
     3843           end.
     3844           assign
     3845                                                                                             buf_temp-ot-supp-line.new-fact-qnty      = buf_temp-ot-supp-line.new-fact-qnty      + v-sale-fact-qnty           buf_temp-ot-supp-line.new-sum-base       = buf_temp-ot-supp-line.new-sum-base       + v-sale-sum-base            buf_temp-ot-supp-line.new-sum-rubl       = buf_temp-ot-supp-line.new-sum-rubl       + v-sale-sum-rubl            buf_temp-ot-supp-line.new-vat-base       = buf_temp-ot-supp-line.new-vat-base       + v-sale-vat-base            buf_temp-ot-supp-line.new-vat-rubl       = buf_temp-ot-supp-line.new-vat-rubl       + v-sale-vat-rubl            buf_temp-ot-supp-line.new-slt-base       = buf_temp-ot-supp-line.new-slt-base       + v-sale-slt-base            buf_temp-ot-supp-line.new-slt-rubl       = buf_temp-ot-supp-line.new-slt-rubl       + v-sale-slt-rubl            buf_temp-ot-supp-line.new-road-tax-base  = buf_temp-ot-supp-line.new-road-tax-base  + v-sale-road-tax-base       buf_temp-ot-supp-line.new-road-tax-rubl  = buf_temp-ot-supp-line.new-road-tax-rubl  + v-sale-road-tax-rubl       buf_temp-ot-supp-line.new-excise-base    = buf_temp-ot-supp-line.new-excise-base    + v-sale-excise-base         buf_temp-ot-supp-line.new-excise-rubl    = buf_temp-ot-supp-line.new-excise-rubl    + v-sale-excise-rubl         buf_temp-ot-supp-line.new-transport-base = buf_temp-ot-supp-line.new-transport-base + v-sale-transport-base      buf_temp-ot-supp-line.new-transport-rubl = buf_temp-ot-supp-line.new-transport-rubl + v-sale-transport-rubl      buf_temp-ot-supp-line.new-other-base     = buf_temp-ot-supp-line.new-other-base     + v-sale-other-base          buf_temp-ot-supp-line.new-other-rubl     = buf_temp-ot-supp-line.new-other-rubl     + v-sale-other-rubl
     3846           .
     3847         end.
     3848       end.
     3849     end.
     3850   end procedure.
     3851   procedure update-ot-supp-tot :
     3852     define buffer buf_temp-ot-supp-line for temp-ot-supp-line .
     3853     define buffer buf_temp-ot-supp-tot  for temp-ot-supp-tot .
     3854     do
     3855     on error undo, return error
     3856     :
     3857       for each buf_temp-ot-supp-line
     3858       on error undo, return error
     3859       :
     3860         find first buf_temp-ot-supp-tot
     3861           where buf_temp-ot-supp-tot.doc-code = buf_temp-ot-supp-line.doc-code
     3862             and buf_temp-ot-supp-tot.cli-type = buf_temp-ot-supp-line.cli-type
     3863             and buf_temp-ot-supp-tot.cli-code = buf_temp-ot-supp-line.cli-code
     3864             and buf_temp-ot-supp-tot.sum-type = buf_temp-ot-supp-line.sum-type
     3865             and buf_temp-ot-supp-tot.cat-id   = buf_temp-ot-supp-line.cat-id
     3866           no-error .
     3867         if not available buf_temp-ot-supp-tot
     3868         then do:
     3869           create buf_temp-ot-supp-tot .
     3870           assign
     3871             buf_temp-ot-supp-tot.doc-code = buf_temp-ot-supp-line.doc-code
     3872             buf_temp-ot-supp-tot.cli-type = buf_temp-ot-supp-line.cli-type
     3873             buf_temp-ot-supp-tot.cli-code = buf_temp-ot-supp-line.cli-code
     3874             buf_temp-ot-supp-tot.sum-type = buf_temp-ot-supp-line.sum-type
     3875             buf_temp-ot-supp-tot.cat-id   = buf_temp-ot-supp-line.cat-id
     3876             buf_temp-ot-supp-tot.ext-doc-type = buf_trn-doc.ext-doc-type
     3877             buf_temp-ot-supp-tot.obj-type     = buf_trn-doc.obj-type
     3878             buf_temp-ot-supp-tot.obj-code     = buf_trn-doc.obj-code
     3879             buf_temp-ot-supp-tot.fact-order   = v-ot-fact-order
     3880           .
     3881         end.
     3882         assign
     3883                                                                           buf_temp-ot-supp-tot.new-fact-qnty      = buf_temp-ot-supp-tot.new-fact-qnty      + buf_temp-ot-supp-line.new-fact-qnty           buf_temp-ot-supp-tot.new-sum-base       = buf_temp-ot-supp-tot.new-sum-base       + buf_temp-ot-supp-line.new-sum-base            buf_temp-ot-supp-tot.new-sum-rubl       = buf_temp-ot-supp-tot.new-sum-rubl       + buf_temp-ot-supp-line.new-sum-rubl            buf_temp-ot-supp-tot.new-vat-base       = buf_temp-ot-supp-tot.new-vat-base       + buf_temp-ot-supp-line.new-vat-base            buf_temp-ot-supp-tot.new-vat-rubl       = buf_temp-ot-supp-tot.new-vat-rubl       + buf_temp-ot-supp-line.new-vat-rubl            buf_temp-ot-supp-tot.new-slt-base       = buf_temp-ot-supp-tot.new-slt-base       + buf_temp-ot-supp-line.new-slt-base            buf_temp-ot-supp-tot.new-slt-rubl       = buf_temp-ot-supp-tot.new-slt-rubl       + buf_temp-ot-supp-line.new-slt-rubl            buf_temp-ot-supp-tot.new-road-tax-base  = buf_temp-ot-supp-tot.new-road-tax-base  + buf_temp-ot-supp-line.new-road-tax-base       buf_temp-ot-supp-tot.new-road-tax-rubl  = buf_temp-ot-supp-tot.new-road-tax-rubl  + buf_temp-ot-supp-line.new-road-tax-rubl       buf_temp-ot-supp-tot.new-excise-base    = buf_temp-ot-supp-tot.new-excise-base    + buf_temp-ot-supp-line.new-excise-base         buf_temp-ot-supp-tot.new-excise-rubl    = buf_temp-ot-supp-tot.new-excise-rubl    + buf_temp-ot-supp-line.new-excise-rubl         buf_temp-ot-supp-tot.new-transport-base = buf_temp-ot-supp-tot.new-transport-base + buf_temp-ot-supp-line.new-transport-base      buf_temp-ot-supp-tot.new-transport-rubl = buf_temp-ot-supp-tot.new-transport-rubl + buf_temp-ot-supp-line.new-transport-rubl      buf_temp-ot-supp-tot.new-other-base     = buf_temp-ot-supp-tot.new-other-base     + buf_temp-ot-supp-line.new-other-base          buf_temp-ot-supp-tot.new-other-rubl     = buf_temp-ot-supp-tot.new-other-rubl     + buf_temp-ot-supp-line.new-other-rubl
     3884         .
     3885       end.
     3886     end.
     3887   end procedure.
     3888   procedure init-stk-table :
     3889     define buffer buf_temp-ot-supp-tot  for temp-ot-supp-tot .
     3890     define buffer buf_temp-ot-supp-line for temp-ot-supp-line .
     3891     do
     3892     on error undo, return error
     3893     :
     3894       for each buf_temp-ot-supp-tot
     3895       on error undo, return error
     3896       :
     3897         run init-stk-supp-tot-table in this-procedure
     3898           (input buf_temp-ot-supp-tot.cli-type
     3899           ,input buf_temp-ot-supp-tot.cli-code
     3900           ) .
     3901       end.
     3902       for each buf_temp-ot-supp-line
     3903       on error undo, return error
     3904       :
     3905         run init-stk-supp-line-table in this-procedure
     3906           (input buf_temp-ot-supp-line.cli-type
     3907           ,input buf_temp-ot-supp-line.cli-code
     3908           ,input buf_temp-ot-supp-line.artic
     3909           ,input buf_temp-ot-supp-line.prod-type
     3910           ,input buf_temp-ot-supp-line.prod-code
     3911           ) .
     3912       end.
     3913     end.
     3914   end procedure.
     3915   procedure init-stk-supp-tot-table :
     3916     define input parameter p-cli-type as character no-undo .
     3917     define input parameter p-cli-code as integer   no-undo .
     3918     define buffer buf_temp-init-stk-supp-tot for temp-init-stk-supp-tot .
     3919     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     3920     define buffer buf_temp-stk-supp-tot for temp-stk-supp-tot .
     3921     define buffer buf_temp-shift-stk-supp-tot for temp-shift-stk-supp-tot .
     3922     do
     3923     on error undo, return error
     3924     :
     3925       find first buf_temp-init-stk-supp-tot
     3926         where buf_temp-init-stk-supp-tot.cli-type = p-cli-type
     3927           and buf_temp-init-stk-supp-tot.cli-code = p-cli-code
     3928         no-error .
     3929       if not available buf_temp-init-stk-supp-tot
     3930       then do:
     3931         create buf_temp-init-stk-supp-tot .
     3932         assign
     3933           buf_temp-init-stk-supp-tot.cli-type = p-cli-type
     3934           buf_temp-init-stk-supp-tot.cli-code = p-cli-code
     3935         .
     3936       end.
     3937       else do:
     3938         return .
     3939       end.
     3940       define variable v-root-sum-type                  as character no-undo extent 3 .
     3941       define variable v-line-sum-type                  as character no-undo extent 3 .
     3942       define variable v-root-sum-type-ind-ext          as integer   no-undo .
     3943       define variable v-prev-stk-supp-tot-fact-order   as decimal   no-undo .
     3944       define variable v-prev-stk-supp-line-fact-order  as decimal   no-undo .
     3945       define variable v-prsh-stk-supp-tot-fact-order   as decimal   no-undo .
     3946       define variable v-prsh-stk-supp-line-fact-order  as decimal   no-undo .
     3947       assign
     3948         v-root-sum-type[1] = 'cost':U
     3949         v-root-sum-type[2] = 'csdt':U         + buf_trn-doc.ext-doc-type
     3950         v-root-sum-type[3] = 'sadt':U         + buf_trn-doc.ext-doc-type
     3951       .
     3952       do v-root-sum-type-ind-ext = 1 to extent(v-root-sum-type)
     3953       :
     3954         find last buf_stk-supp-tot no-lock
     3955           where buf_stk-supp-tot.obj-type   = buf_trn-doc.obj-type
     3956             and buf_stk-supp-tot.obj-code   = buf_trn-doc.obj-code
     3957             and buf_stk-supp-tot.cli-type   = p-cli-type
     3958             and buf_stk-supp-tot.cli-code   = p-cli-code
     3959             and buf_stk-supp-tot.sum-type   = v-root-sum-type[v-root-sum-type-ind-ext]
     3960             and buf_stk-supp-tot.cat-id     = '##':U
     3961             and buf_stk-supp-tot.fact-order <= v-stk-supp-tot-fact-order
     3962             and buf_stk-supp-tot.shift-date = ?
     3963           use-index category
     3964           no-error .
     3965         if available buf_stk-supp-tot
     3966         then do:
     3967           assign
     3968             v-prev-stk-supp-tot-fact-order = buf_stk-supp-tot.fact-order
     3969           .
     3970           for each buf_stk-supp-tot no-lock
     3971             where buf_stk-supp-tot.obj-type   = buf_trn-doc.obj-type
     3972               and buf_stk-supp-tot.obj-code   = buf_trn-doc.obj-code
     3973               and buf_stk-supp-tot.cli-type   = p-cli-type
     3974               and buf_stk-supp-tot.cli-code   = p-cli-code
     3975               and buf_stk-supp-tot.fact-order = v-prev-stk-supp-tot-fact-order
     3976               and buf_stk-supp-tot.sum-type   begins v-root-sum-type[v-root-sum-type-ind-ext]
     3977           on error undo, return error
     3978           :
     3979             create buf_temp-stk-supp-tot .
