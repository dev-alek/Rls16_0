        1   block-level on error undo, throw.
        2   define input  parameter p-doc-code       as character no-undo .
        3   define input  parameter p-cut-date       as date      no-undo .
        4   define input  parameter p-check-only     as logical   no-undo .
        5   define output parameter p-need-process   as logical   no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Создание складского архива по поставщикам".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30       assign
       31         p-vss-parameters = substitute('&1|&2|&3':u,p-doc-code,p-cut-date,p-check-only)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   procedure factord :
       78     define input  parameter p-fact-date            as date    no-undo .
       79     define input  parameter p-fact-time            as integer no-undo .
       80     define input  parameter p-fact-num             as integer no-undo .
       81     define input  parameter p-shift-date           as date    no-undo .
       82     define input  parameter p-shift-num            as integer no-undo .
       83     define input  parameter p-shift-on             as logical no-undo .
       84     define output parameter p-fact-order           as decimal no-undo .
       85     define output parameter p-shift-end-fact-order as decimal no-undo .
       86     define output parameter p-day-end-fact-order   as decimal no-undo .
       87     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       88     if p-fact-date = ?
       89     then do:
       90       return error "Не указана фактическая дата" .
       91     end.
       92     define variable v-fact-date-num as integer no-undo .
       93     assign
       94       v-fact-date-num = integer(p-fact-date)
       95     .
       96     if p-fact-num = ?
       97     or p-fact-num = 0
       98     then do:
       99       return error "Не задан p-fact-num " + string(p-fact-num) .
      100     end.
      101     if p-fact-num < 0
      102     then do:
      103       return error "Отрицательный fact-num " + string(p-fact-num) .
      104     end.
      105     if p-fact-num >= 100000000
      106     then do:
      107       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      108     end.
      109     if p-shift-on = true
      110     then do:
      111       if p-shift-date = ?
      112       then do:
      113         return error "Не задана дата смены" .
      114       end.
      115       if p-shift-num = ?
      116       or p-shift-num = 0
      117       then do:
      118         return error "Не задан номер смены" .
      119       end.
      120     end.
      121     else do:
      122       assign
      123         p-shift-date = p-fact-date
      124         p-shift-num  = 24
      125       .
      126     end.
      127     define variable v-shift-offset as integer no-undo .
      128     if p-shift-date = p-fact-date
      129     then do:
      130       assign
      131         v-shift-offset = 1
      132       .
      133     end.
      134     if p-shift-date < p-fact-date
      135     then do:
      136       assign
      137         v-shift-offset = 0
      138       .
      139     end.
      140     if p-shift-date > p-fact-date
      141     then do:
      142       message
      143         vss-workfile vss-revision vss-description skip
      144         "Неправильная дата закрытия смены" skip
      145         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      146         view-as alert-box error .
      147       undo, return error
      148         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      149           ,string(p-fact-date, '99/99/9999':U)
      150           ,string(p-shift-date, '99/99/9999':U)
      151           )
      152       .
      153     end.
      154     if p-shift-num < 1
      155     or p-shift-num > 24
      156     then do:
      157       message
      158         vss-workfile vss-revision vss-description skip
      159         "Неправильный номер смены" skip
      160         "p-shift-num" p-shift-num skip
      161         view-as alert-box error .
      162       undo, return error return-value .
      163     end.
      164     assign
      165       p-fact-order           = v-fact-date-num
      166                              + v-shift-offset * 0.5
      167                              + p-shift-num    * 0.02 - 0.01
      168                              + p-fact-num     * 0.0000000001
      169       p-shift-end-fact-order = v-fact-date-num
      170                              + v-shift-offset * 0.5
      171                              + p-shift-num    * 0.02
      172       p-day-end-fact-order   = v-fact-date-num
      173                              + 0.99
      174     .
      175     if p-fact-order           <= v-fact-date-num
      176     or p-shift-end-fact-order <= v-fact-date-num
      177     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      178     or p-shift-end-fact-order >= p-day-end-fact-order
      179     then do:
      180       message
      181         vss-workfile vss-revision vss-description skip
      182         "Внутренняя ошибка при генерации фактического номера" skip
      183         "p-fact-date"            p-fact-date            skip
      184         "p-fact-time"            p-fact-time            skip
      185         "p-fact-num"             p-fact-num             skip
      186         "p-shift-date"           p-shift-date           skip
      187         "p-shift-num"            p-shift-num            skip
      188         "p-shift-on"             p-shift-on             skip
      189         "p-shift-end-fact-order" p-shift-end-fact-order skip
      190         "p-day-end-fact-order"   p-day-end-fact-order   skip
      191         "v-fact-date-num"        v-fact-date-num        skip
      192         view-as alert-box error .
      193       undo, return error return-value .
      194     end.
      195   end procedure.
      196   procedure day-begin-fact-order :
      197     define input  parameter p-fact-date            as date    no-undo .
      198     define output parameter p-day-begin-fact-order as decimal no-undo .
      199     do
      200     on error undo, return error return-value
      201     :
      202       if p-fact-date = ?
      203       then do:
      204         assign
      205           p-day-begin-fact-order = 0
      206         .
      207       end.
      208       else do:
      209         assign
      210           p-day-begin-fact-order = integer(p-fact-date)
      211         .
      212       end.
      213     end.
      214   end procedure.
      215   procedure factord-max-fact-order :
      216     define output parameter p-max-fact-order as decimal   no-undo .
      217     do
      218     on error undo, return error return-value
      219     :
      220       run day-begin-fact-order in this-procedure
      221         (input  date(1, 1, 5000)
      222         ,output p-max-fact-order
      223         ) .
      224     end.
      225   end procedure.
      226   procedure factord-cut-archive :
      227     define input  parameter p-obj-type             as character no-undo .
      228     define input  parameter p-obj-code             as integer   no-undo .
      229     define input  parameter p-fact-date            as date      no-undo .
      230     define output parameter p-shift-on             as logical   no-undo .
      231     define output parameter p-shift-date           as date      no-undo .
      232     define output parameter p-shift-num            as integer   no-undo .
      233     define output parameter p-day-end-fact-order   as decimal   no-undo .
      234     define output parameter p-shift-end-fact-order as decimal   no-undo .
      235     define variable v-fact-order as decimal   no-undo .
      236     define buffer buf_shift-obj for ub.shift-obj .
      237     do
      238     on error undo, return error return-value
      239     :
      240   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      242     (input  p-obj-type
      243     ,input  p-obj-code
      244     ,input  'shift-on=request'
      245     ,output p-shift-on
      246     ) no-error .
      247       if error-status :error
      248       then do:
      249         message
      250           vss-workfile vss-revision vss-description skip
      251           "Ошибка при определении атрибута объекта" skip
      252           "Объект" p-obj-type p-obj-code skip
      253           error-status :get-message(1) skip
      254           return-value skip
      255           view-as alert-box error .
      256         undo, return error return-value .
      257       end.
      258       if p-shift-on = false
      259       then do:
      260         assign
      261           p-shift-date               = ?
      262           p-shift-num                = 0
      263         .
      264       end.
      265       else do:
      266         find first buf_shift-obj share-lock
      267           where buf_shift-obj.obj-type   = p-obj-type
      268             and buf_shift-obj.obj-code   = p-obj-code
      269             and buf_shift-obj.shift-date > p-fact-date
      270           use-index pi
      271           no-error .
      272         if not available buf_shift-obj
      273         or buf_shift-obj.status_ <> 'зкр':U
      274         then do:
      275           message
      276             vss-workfile vss-revision vss-description skip
      277             "Невозможно вычислить последнюю смену" skip
      278             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      279             "Объект" p-obj-type p-obj-code skip
      280             "Дата" p-fact-date skip
      281             view-as alert-box error .
      282           undo, return error return-value .
      283         end.
      284         find last buf_shift-obj share-lock
      285           where buf_shift-obj.obj-type = p-obj-type
      286             and buf_shift-obj.obj-code = p-obj-code
      287             and buf_shift-obj.shift-date <= p-fact-date
      288           use-index pi
      289           no-error .
      290         if available buf_shift-obj
      291         then do:
      292           if  buf_shift-obj.status_ = 'зкр':U
      293           then do:
      294             assign
      295               p-shift-date = buf_shift-obj.shift-date
      296               p-shift-num  = buf_shift-obj.shift-num
      297             .
      298           end.
      299           else do:
      300             message
      301               vss-workfile vss-revision vss-description skip
      302               "Невозможно вычислить последнюю смену" skip
      303               "Статус смены отличен от статуса" 'зкр':U skip
      304               "Объект" p-obj-type p-obj-code skip
      305               "Дата" p-fact-date skip
      306               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      307               view-as alert-box error .
      308             undo, return error return-value .
      309           end.
      310         end.
      311         else do:
      312           assign
      313             p-shift-date = p-fact-date - 1
      314             p-shift-num  = 1
      315           .
      316         end.
      317       end.
      318       run factord in this-procedure
      319         (input  p-fact-date
      320         ,input  1
      321         ,input  1
      322         ,input  p-shift-date
      323         ,input  p-shift-num
      324         ,input  p-shift-on
      325         ,output v-fact-order
      326         ,output p-shift-end-fact-order
      327         ,output p-day-end-fact-order
      328         ) no-error .
      329       if error-status :error
      330       then do:
      331         message
      332           vss-workfile vss-revision vss-description skip
      333           "Ошибка при вызове процедуры factord"
      334           error-status :get-message(1) skip
      335           return-value skip
      336           view-as alert-box error .
      337         undo, return error return-value .
      338       end.
      339     end.
      340   end procedure.
      341   procedure factord-lock-shift :
      342     define input  parameter p-obj-type  as character no-undo .
      343     define input  parameter p-obj-code  as integer   no-undo .
      344     define input  parameter p-fact-date as date      no-undo .
      345     define parameter buffer buf_shift-obj for ub.shift-obj .
      346     define variable v-shift-on      as logical   no-undo .
      347     define variable v-extra-message as character no-undo .
      348     define variable v-error as character no-undo .
      349     do
      350     on error undo, return error return-value
      351     :
      352   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      354     (input  p-obj-type
      355     ,input  p-obj-code
      356     ,input  'shift-on=request'
      357     ,output v-shift-on
      358     ) no-error .
      359       if error-status :error
      360       then do:
      361         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      362         undo, return error v-error .
      363       end.
      364       if v-shift-on = true
      365       then do:
      366         find first buf_shift-obj share-lock
      367           where buf_shift-obj.obj-type   = p-obj-type
      368             and buf_shift-obj.obj-code   = p-obj-code
      369             and buf_shift-obj.shift-date > p-fact-date
      370           use-index pi
      371           no-error .
      372         if not available buf_shift-obj
      373         or buf_shift-obj.status_ <> 'зкр':U
      374         then do:
      375           find last buf_shift-obj
      376             where buf_shift-obj.obj-type = p-obj-type
      377               and buf_shift-obj.obj-code = p-obj-code
      378               and buf_shift-obj.status_  = 'зкр':U
      379             use-index stts
      380             no-error .
      381           if available buf_shift-obj
      382           then do:
      383             assign
      384               v-extra-message =
      385                     substitute("Дата начала последеней закрытой смены на объекте &1"
      386                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      387                               )
      388             .
      389           end.
      390           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      391           undo, return error v-error .
      392         end.
      393       end.
      394     end.
      395   end procedure.
      396   procedure factord-end-day :
      397     define input  parameter p-fact-date            as date    no-undo .
      398     define output parameter p-day-end-fact-order   as decimal no-undo .
      399     do
      400     on error undo, return error return-value
      401     :
      402       if p-fact-date = ?
      403       then do:
      404         return error "Не указана фактическая дата" .
      405       end.
      406       assign
      407         p-day-end-fact-order = integer(p-fact-date) + 0.99
      408       .
      409     end.
      410   end procedure.
      411   procedure factord-to-date :
      412     define input  parameter p-fact-order as decimal no-undo .
      413     define output parameter p-fact-date  as date    no-undo .
      414     define variable v-ref-date  as date      no-undo .
      415     define variable v-ref-delta as integer   no-undo .
      416     do
      417     on error undo, return error return-value
      418     :
      419       if p-fact-order = ?
      420       or p-fact-order = 0
      421       then do:
      422         return error "Не указан fact-order" .
      423       end.
      424       assign
      425         v-ref-date  = date(1, 1, 2000)
      426       .
      427       assign
      428         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      429       .
      430       assign
      431         p-fact-date = v-ref-date + v-ref-delta
      432       .
      433     end.
      434   end procedure.
      435   procedure factord-to-fact-num :
      436     define input  parameter p-fact-order as decimal no-undo .
      437     define output parameter p-fact-num   as integer no-undo .
      438     define variable v-fact-order-trunc as decimal no-undo .
      439     do
      440     on error undo, return error return-value
      441     :
      442       if p-fact-order = ?
      443       or p-fact-order = 0
      444       then do:
      445         return error "Не указан fact-order" .
      446       end.
      447       assign
      448        v-fact-order-trunc = truncate(p-fact-order, 2)
      449       .
      450       assign
      451         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      452       .
      453     end.
      454   end procedure.
      455   procedure factord-to-shift-num :
      456     define input  parameter p-fact-order as decimal no-undo .
      457     define output parameter p-shift-num   as integer no-undo .
      458     define variable  p-shift-numd  as decimal   no-undo .
      459     define variable v-fact-order-trunc as decimal no-undo .
      460     do
      461     on error undo, return error return-value
      462     :
      463       if p-fact-order = ?
      464       or p-fact-order = 0
      465       then do:
      466         return error "Не указан fact-order" .
      467       end.
      468       assign
      469        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      470       .
      471       if v-fact-order-trunc < 0.5 then do:
      472         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      473       end.
      474       assign
      475         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      476         .
      477        assign
      478         p-shift-num = truncate (p-shift-numd , 0)
      479       .
      480     end.
      481   end procedure.
      482   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      483   procedure prl-vat:
      484     define input parameter parrecid as recid no-undo.
      485       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
      486       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
      487       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
      488       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
      489       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
      490       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
      491       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
      492       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
      493       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
      494       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
      495       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
      496       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
      497       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
      498       define output parameter excise-rubl-saleprl            like ub.doc-line.price-rubl no-undo.
      499       define output parameter discnt-base-saleprl            like ub.gds-dtl.discnt-base no-undo.
      500       define output parameter discnt-rubl-saleprl            like ub.gds-dtl.discnt-rubl no-undo.
      501       define buffer out-vatp_gds-dtlprl     for ub.gds-dtl.
      502       define buffer buf_out-vatp_gds-dtlprl for ub.gds-dtl.
      503       define buffer out-vatp_partsprl       for ub.parts.
      504       define buffer out-vatp_sysconfprl     for ub.sysconf.
      505       define buffer out-vatp_doc-lineprl    for ub.doc-line.
