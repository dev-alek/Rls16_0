     4380   procedure update-stk-table :
     4381     define buffer root_temp-stk-supp-tot  for temp-stk-supp-tot  .
     4382     define buffer root_temp-stk-supp-line for temp-stk-supp-line .
     4383     define buffer root_temp-shift-stk-supp-tot  for temp-shift-stk-supp-tot  .
     4384     define buffer root_temp-shift-stk-supp-line for temp-shift-stk-supp-line .
     4385     define buffer buf_temp-ot-supp-tot for temp-ot-supp-tot .
