     4416               and buf_temp-stk-supp-tot.sum-type   = buf_temp-ot-supp-tot.sum-type
     4417               and buf_temp-stk-supp-tot.cat-id     = buf_temp-ot-supp-tot.cat-id
     4418             no-error .
