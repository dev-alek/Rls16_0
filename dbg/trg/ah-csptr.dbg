     4972   procedure store-ot-table :
     4973     define buffer buf_temp-ot-supp-tot for temp-ot-supp-tot .
     4974     define buffer buf_ot-supp-tot for ub.ot-supp-tot .
     4975     define buffer buf_temp-ot-supp-line for temp-ot-supp-line .
