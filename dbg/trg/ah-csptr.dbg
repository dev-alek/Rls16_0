     5020               buf_ot-supp-tot.doc-code     = buf_temp-ot-supp-tot.doc-code       buf_ot-supp-tot.cli-type     = buf_temp-ot-supp-tot.cli-type       buf_ot-supp-tot.cli-code     = buf_temp-ot-supp-tot.cli-code       buf_ot-supp-tot.sum-type     = buf_temp-ot-supp-tot.sum-type       buf_ot-supp-tot.cat-id       = buf_temp-ot-supp-tot.cat-id         buf_ot-supp-tot.ext-doc-type = buf_temp-ot-supp-tot.ext-doc-type   buf_ot-supp-tot.obj-type     = buf_temp-ot-supp-tot.obj-type       buf_ot-supp-tot.obj-code     = buf_temp-ot-supp-tot.obj-code       buf_ot-supp-tot.fact-order   = buf_temp-ot-supp-tot.fact-order
     5021             .
