      606     define variable vardoc-type     as   character              no-undo.
      607     do
      608     on error undo, return error "Ошибка при вызове процедуры prl-vat."
      609     :
      610       find first bf_price-list no-lock
      611         where recid(bf_price-list) = parrecid
      612         no-error .
      613       if not available bf_price-list
      614       then do:
      615         return error "Ошибка во входящих параметрах prl-vat.i" .
      616       end.
      617       find first bf_goods no-lock
      618         where bf_goods.artic     = bf_price-list.artic
      619           and bf_goods.prod-type = bf_price-list.prod-type
      620           and bf_goods.prod-code = bf_price-list.prod-code
      621         no-error .
      622       if not available bf_goods
      623       then do:
      624         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
      625       end.
      626       assign
      627         varvat-pc = bf_price-list.vat-pc
      628         varslt-pc = bf_price-list.slt-pc
      629       .
      630       if varvat-pc = ?
      631       then do:
      632         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
      633       end.
      634       if varslt-pc = ?
      635       then do:
      636         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
      637       end.
      638       assign
      639         varbase-rate   = 1
      640         varbase-scale  = 1
      641         varroad-tax    = bf_price-list.road-tax
      642         varexcise      = bf_price-list.excise
      643         varprice-base  = bf_price-list.price-sale
      644         varprice-rubl  = bf_price-list.price-sale
      645         vardiscnt-base = 0
      646         vardiscnt-rubl = 0
      647       .
      648       assign
      649         varfact-qnty = 0
      650       .
      651       for each bf_parts no-lock
      652         where bf_parts.out-code   = bf_price-list.doc-num
      653           and bf_parts.obj-type   = bf_price-list.obj-type
      654           and bf_parts.obj-code   = bf_price-list.obj-code
      655           and bf_parts.artic      = bf_price-list.artic
      656           and bf_parts.prod-type  = bf_price-list.prod-type
      657           and bf_parts.prod-code  = bf_price-list.prod-code
      658       :
      659         assign
      660           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
      661         .
      662       end.
      663       assign
      664         vardoc-num   = bf_price-list.doc-num
      665         vardoc-code  = bf_price-list.doc-num
      666         varobj-type  = bf_price-list.obj-type
      667         varobj-code  = bf_price-list.obj-code
      668         varartic     = bf_price-list.artic
      669         varprod-type = bf_price-list.prod-type
      670         varprod-code = bf_price-list.prod-code
      671         vardoc-qnty  = varfact-qnty
      672         varext-doc-type = 'ot':U
      673       .
      674   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      675   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      676     (input  bf_price-list.obj-type
      677     ,input  bf_price-list.obj-code
      678     ,output v-host-code
      679     )  .
      680       find first bf_sysconf no-lock
      681         where bf_sysconf.host-code = v-host-code
      682         .
      683       if bf_sysconf.cons-vat-pc = ?
      684       then do:
      685         return error "Не задан консигнационный НДС по фирме." .
      686       end.
      687       else do:
      688         assign
      689           varcons-vat-pc = bf_sysconf.cons-vat-pc
      690         .
      691       end.
      692   if varext-doc-type = 'ot':U or
      693      varext-doc-type = ?                 then do:
      694     assign
      695      out-vatp-have-vat-sltprl = yes.
      696   end.
      697   else do:
      698     find first out-vatp_doc-attrprl no-lock
      699       where out-vatp_doc-attrprl.doc-code  = vardoc-code
      700         and out-vatp_doc-attrprl.attr-code = 'envd':U
      701         no-error .
      702     if not available out-vatp_doc-attrprl then do:
      703       assign
      704         out-vatp-have-vat-sltprl = yes.
      705     end.
      706     else do:
      707        out-vatp-have-vat-sltprl = no.
      708     end.
      709   end.
      710   find first out-vatp_goodsprl where out-vatp_goodsprl.artic     = varartic     and
      711                                      out-vatp_goodsprl.prod-type = varprod-type and
      712                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
      713   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      714   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      715     (input  varartic
      716     ,input  varprod-type
      717     ,input  varprod-code
      718     ,output varroot-nodeprl
      719     ) no-error .
      720   if error-status :error then do:
      721     message
      722       vss-workfile vss-revision vss-description skip
      723       "Ошибка при определении корневого признака товара" skip
      724       "Артикул" varartic varprod-type varprod-code skip
      725       error-status :get-message(1) skip
      726       return-value skip
      727       view-as alert-box error .
      728     undo, return error .
      729   end.
      730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
      731     (input  varroot-nodeprl
      732     ,input  'empty-scale=request'
      733     ,output varempty-scaleprl
      734     ) no-error .
      735   if error-status :error then do:
      736     message
      737       vss-workfile vss-revision vss-description skip
      738       "Ошибка при определении атрибута признака" skip
      739       "Артикул" varartic varprod-type varprod-code skip
      740       "Признак" varroot-nodeprl skip
      741       "Запрашивался атрибут" "empty-scale=request" skip
      742       error-status :get-message(1) skip
      743       return-value skip
      744       view-as alert-box error .
      745     undo, return error .
      746   end.
      747   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      748   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      749     (output varoutvprbprl
      750     )  .
      751   if varoutvprbprl = "base":u then do:
      752     assign
      753           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
      754       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
      755     .
      756   end.
      757   else do:
      758     assign
      759           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
      760       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
      761     .
      762   end.
      763   if varoutvprbprl = "rubl":u then do:
      764     assign
      765           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
      766       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
      767   end.
      768   else do:
      769     assign
      770           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
      771       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
      772   end.
      773   assign
      774     varis-cons-parts-haveprl =  no.
      775   assign
      776     varfact-qntyprl       = 0
      777     varcons-qntyprl       = 0
      778     varprice-base-consprl = 0
      779     varprice-rubl-consprl = 0.
      780   find first out-vatp_doc-lineprl where
      781              out-vatp_doc-lineprl.doc-code   = vardoc-num
      782          and out-vatp_doc-lineprl.artic      = varartic
      783          and out-vatp_doc-lineprl.prod-type  = varprod-type
      784          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
      785   if available out-vatp_doc-lineprl           and
      786     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
      787     assign
      788       varfact-qntyprl = out-vatp_doc-lineprl.fact-qnty.
      789   end.
      790   else do:
      791     for each out-vatp_partsprl where out-vatp_partsprl.out-code   = vardoc-num
      792                                  and out-vatp_partsprl.obj-type   = varobj-type
      793                                  and out-vatp_partsprl.obj-code   = varobj-code
      794                                  and out-vatp_partsprl.artic      = varartic
      795                                  and out-vatp_partsprl.prod-type  = varprod-type
      796                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
      797       if out-vatp_partsprl.purch-code = 2 then do:
      798   assign
      799     price-rubl-with-tax-locoprl = out-vatp_partsprl.price-rubl
      800     price-base-with-tax-locoprl = out-vatp_partsprl.price-base
      801   .
      802   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      803   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      804     (output varinvprboprl
      805     )  .
      806     if out-vatp_partsprl.out-code = 'free-zone':U     or
      807        out-vatp_partsprl.out-code = 'out-zone':U   or
      808        out-vatp_partsprl.doc-type = 'акт':U then do:
      809       assign
      810         in-vatp-have-vat-sltoprl = yes.
      811     end.
      812     else do:
      813       find first in-vatp_doc-attroprl no-lock
      814         where in-vatp_doc-attroprl.doc-code  = out-vatp_partsprl.out-code
      815           and in-vatp_doc-attroprl.attr-code = 'envd':U
      816         no-error .
      817       if not available in-vatp_doc-attroprl then do:
      818         assign
      819           in-vatp-have-vat-sltoprl = yes.
      820       end.
      821       else do:
      822            in-vatp-have-vat-sltoprl = no.
      823       end.
      824     end.
      825     assign
      826      price-cli-with-tax-locoprl = out-vatp_partsprl.price-cli
      827      cli-base-rateoprl          = out-vatp_partsprl.cli-base-rate.
      828     ASSIGN   road-tax-base-locoprl  = (if out-vatp_partsprl.road-tax-base  = ? then 0 else out-vatp_partsprl.road-tax-base)
      829              road-tax-rubl-locoprl  = (if out-vatp_partsprl.road-tax-rubl  = ? then 0 else out-vatp_partsprl.road-tax-rubl).
      830     ASSIGN  transport-base-locoprl = (if out-vatp_partsprl.transport-base = ? then 0 else out-vatp_partsprl.transport-base)
      831             transport-rubl-locoprl = (if out-vatp_partsprl.transport-rubl = ? then 0 else out-vatp_partsprl.transport-rubl)
      832             other-base-locoprl     = (if out-vatp_partsprl.other-base     = ? then 0 else out-vatp_partsprl.other-base)
      833             other-rubl-locoprl     = (if out-vatp_partsprl.other-rubl     = ? then 0 else out-vatp_partsprl.other-rubl)
      834             vat-pc-locoprl         = (if out-vatp_partsprl.vat-pc         = ? then 0 else out-vatp_partsprl.vat-pc)
      835             slt-pc-locoprl         = (if out-vatp_partsprl.slt-pc         = ? then 0 else out-vatp_partsprl.slt-pc).
      836             ASSIGN   slt-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
      837       ASSIGN   slt-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
      838     assign
      839       exch-rate-cli-locoprl = (out-vatp_partsprl.price-rubl - transport-rubl-locoprl - other-rubl-locoprl - road-tax-rubl-locoprl - (if out-vatp_partsprl.vat-type <> 'в т. ч.':U then vat-rubl-locoprl else 0) - (if out-vatp_partsprl.slt-type <> 'в т. ч.':U then slt-rubl-locoprl else 0)) / out-vatp_partsprl.price-cli .
      840     assign
      841       slt-cli-locoprl        = slt-rubl-locoprl       / exch-rate-cli-locoprl
      842       vat-cli-locoprl        = vat-rubl-locoprl       / exch-rate-cli-locoprl
      843       road-tax-cli-locoprl   = road-tax-rubl-locoprl  / exch-rate-cli-locoprl
      844       transport-cli-locoprl  = 0
      845       other-cli-locoprl      = 0
      846     .
      847   ASSIGN
      848             price-base-without-tax-locoprl = price-base-with-tax-locoprl - vat-base-locoprl - slt-base-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))
      849       price-rubl-without-tax-locoprl = price-rubl-with-tax-locoprl - vat-rubl-locoprl - slt-rubl-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))
      850   .
      851         assign
      852           varprice-base-consprl = varprice-base-consprl + (price-base-with-tax-locoprl - (if road-tax-base-locoprl = ? then 0 else road-tax-base-locoprl))* out-vatp_partsprl.fact-qnty
      853           varprice-rubl-consprl = varprice-rubl-consprl + (price-rubl-with-tax-locoprl - (if road-tax-rubl-locoprl = ? then 0 else road-tax-rubl-locoprl))* out-vatp_partsprl.fact-qnty.
      854         assign
      855           varis-cons-parts-haveprl = yes
      856           varcons-qntyprl          = varcons-qntyprl + out-vatp_partsprl.fact-qnty.
      857       end.
      858       assign
      859         varfact-qntyprl = varfact-qntyprl + out-vatp_partsprl.fact-qnty.
      860     end.
      861   end.
      862   assign
      863     varprice-base-consprl = varprice-base-consprl / varcons-qntyprl
      864     varprice-rubl-consprl = varprice-rubl-consprl / varcons-qntyprl.
      865   if varprice-base-consprl = ? then do:
      866     assign
      867       varprice-base-consprl = 0.
      868   end.
      869   if varprice-rubl-consprl = ? then do:
      870     assign
      871       varprice-rubl-consprl = 0.
      872   end.
      873   assign
      874       slt-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc)
      875     vat-base-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
      876     discnt-base-saleprl            = vardiscnt-base
      877     price-base-with-tax-saleprl    = (varprice-base - vardiscnt-base)
      878       slt-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc)
      879     vat-rubl-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc)
      880     discnt-rubl-saleprl            = vardiscnt-rubl
      881     price-rubl-with-tax-saleprl    = (varprice-rubl - vardiscnt-rubl)
      882     .
      883   if vardoc-type = 'инв':U then do:
      884     assign
      885       varfact-qntyprl = vardoc-qnty.
      886   end.
      887   else do:
      888     assign
      889       varfact-qntyprl = varfact-qnty.
      890   end.
      891   if varis-cons-parts-haveprl = no then do:
      892     assign
      893           vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
      894           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
      895   end.
      896   else do:
      897     if vardoc-type = 'инв':U then do:
      898       assign
      899               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
      900               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
      901        .
      902     end.
      903     else do:
      904       assign
      905               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
      906               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
      907        .
      908     end.
      909   end.
      910   assign
      911   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
      912   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
      913     end.
      914   end procedure.
      915   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   procedure cur-time :
      917      define output parameter p-today as date      no-undo .
      918      define output parameter p-time  as integer   no-undo .
      919     do
      920     on error undo, return error
      921     :
      922       define variable v-date1 as date      no-undo .
      923       define variable v-date2 as date      no-undo .
      924       define variable v-time  as integer   no-undo .
      925       assign
      926         v-date1 = today
      927         v-time  = time
      928         v-date2 = today
      929       .
      930       if v-date1 <> v-date2
      931       then do:
      932         assign
      933           v-date1 = today
      934           v-time  = v-time
      935         .
      936       end.
      937       assign
      938         p-today = v-date1
      939         p-time  = v-time
      940       .
      941     end.
      942   end.
      943   function cur-time-date returns character
      944   :
      945     return string(today, '99/99/9999':U) .
      946   end.
      947   function cur-time-mjd returns decimal
      948   :
      949     define variable v-date as date      no-undo .
      950     define variable v-time as integer   no-undo .
      951     run cur-time in this-procedure
      952       (output v-date
      953       ,output v-time
      954       ) .
      955     return integer(v-date) - 2400002 + (v-time / 86400) .
      956   end.
      957   function cur-time-get-ending-index returns integer
      958   (input p-number as integer
      959   )
      960   :
      961     if p-number < 0
      962     or p-number = ?
      963     then do:
      964       return 1 .
      965     end.
      966     define variable v-rest as integer   no-undo .
      967     assign
      968       p-number = p-number modulo 100
      969     .
      970     if p-number < 20
      971     then do:
      972       assign
      973         v-rest = p-number
      974       .
      975     end.
      976     else do:
      977       assign
      978         v-rest = p-number modulo 10
      979       .
      980     end.
      981     case v-rest :
      982       when 1
      983       then do:
      984         return 2 .
      985       end.
      986       when 2 or
      987       when 3 or
      988       when 4
      989       then do:
      990         return 3 .
      991       end.
      992       otherwise do:
      993         return 1 .
      994       end.
      995     end case .
      996   end.
      997   procedure cur-time-mjd-to-date :
      998      define input  parameter i-mjd-diff as decimal no-undo.
      999      define output parameter o-Date     as date    no-undo.
     1000      define output parameter o-Time     as integer no-undo.
     1001      define variable v-day-number as integer   no-undo .
     1002      if    i-mjd-diff < 0
     1003         or i-mjd-diff = ?
     1004      then do:
     1005         return "?" .
     1006      end.
     1007      assign
     1008         v-day-number = truncate(i-mjd-diff,0).
     1009         o-Date = date(v-day-number + 2400002).
     1010         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1011     .
     1012   end.
     1013   function cur-time-mjd-to-string returns character
     1014   (input p-mjd-diff as decimal
     1015   )
     1016   :
     1017     define variable v-day-number as integer   no-undo .
     1018     define variable v-seconds    as integer   no-undo .
     1019     define variable v-hour       as integer   no-undo .
     1020     define variable v-min        as integer   no-undo .
     1021     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1022     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1023     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1024     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1025     if p-mjd-diff < 0
     1026     or p-mjd-diff = ?
     1027     then do:
     1028       return "?" .
     1029     end.
     1030     assign
     1031       v-day-number = integer(truncate(p-mjd-diff,0))
     1032       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1033     .
     1034     if v-seconds > 86400
     1035     then do:
     1036       assign
     1037         v-seconds = 86400 - 1
     1038       .
     1039     end.
     1040     if v-seconds < 0
     1041     then do:
     1042       assign
     1043         v-seconds = 0
     1044       .
     1045     end.
     1046     assign
     1047       v-hour = truncate(v-seconds / 3600, 0)
     1048     .
     1049     assign
     1050       v-seconds = v-seconds modulo 3600
     1051     .
     1052     assign
     1053       v-min = truncate(v-seconds / 60, 0)
     1054     .
     1055     assign
     1056       v-seconds = v-seconds modulo 60
     1057     .
     1058     return
     1059         (if v-day-number <> 0
     1060           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1061           else ""
     1062         )
     1063       + (if v-day-number <> 0 or v-hour <> 0
     1064           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1065           else ""
     1066         )
     1067       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1068           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1069           else ""
     1070         )
     1071       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1072       .
     1073   end.
     1074   function cur-time-string returns character
     1075   :
     1076     define variable v-date as date      no-undo .
     1077     define variable v-time as integer   no-undo .
     1078     run cur-time in this-procedure
     1079       (output v-date
     1080       ,output v-time
     1081       ) .
     1082     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1083   end.
     1084   function cur-time-string-sec returns character
     1085   :
     1086     define variable v-date as date      no-undo .
     1087     define variable v-time as integer   no-undo .
     1088     run cur-time in this-procedure
     1089       (output v-date
     1090       ,output v-time
     1091       ) .
     1092     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1093   end.
     1094   function cur-time-custom  returns character
     1095   (input p-prefix as character
     1096   ,input p-date-format as character
     1097   ,input p-delimiter as character
     1098   ,input p-time-format as character
     1099   ,input p-suffix as character
     1100   )
     1101   :
     1102     define variable v-date as date      no-undo .
     1103     define variable v-time as integer   no-undo .
     1104     run cur-time in this-procedure
     1105       (output v-date
     1106       ,output v-time
     1107       ) .
     1108     return
     1109       p-prefix
     1110       + string(v-date, p-date-format)
     1111       + p-delimiter
     1112       + string(v-time, p-time-format)
     1113       + p-suffix
     1114       .
     1115   end.
     1116   function cur-time-print  returns character
     1117   :
     1118     define variable v-date as date      no-undo .
     1119     define variable v-time as integer   no-undo .
     1120     run cur-time in this-procedure
     1121       (output v-date
     1122       ,output v-time
     1123       ) .
     1124     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1125   end.
     1126   function cur-time-datetime returns datetime
     1127   :
     1128     define variable v-char as character no-undo .
     1129     define variable v-datetime as datetime no-undo .
     1130     v-char = cur-time-string().
     1131     v-datetime = datetime(v-char).
     1132     return  v-datetime.
     1133   end.
     1134   function cur-time-string-msec returns character
     1135   :
     1136     define variable v-date as datetime  no-undo .
     1137     v-date = now.
     1138     return string(v-date) .
     1139   end.
