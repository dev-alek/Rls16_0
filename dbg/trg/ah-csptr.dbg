     3194   define buffer buf_trn-doc for ub.trn-doc .
     3195   define buffer buf_doc-line for ub.doc-line .
     3196   main-block :
     3197   do transaction
     3198   on error undo main-block, return error
     3199   :
     3200     find first buf_trn-doc share-lock
     3201       where buf_trn-doc.doc-code = p-doc-code
     3202       no-error .
     3203     if not available buf_trn-doc
     3204     then do:
     3205       message
     3206         vss-workfile vss-revision vss-description skip
     3207         "Не найден документ" p-doc-code skip
     3208         view-as alert-box error .
     3209       undo main-block, return error .
     3210     end.
     3211     if buf_trn-doc.status_ <> 'факт':U
     3212     then do:
     3213       message
     3214         vss-workfile vss-revision vss-description skip
     3215         "Нельзя рассчитать складской архив по поставщикам" skip
     3216         "для складского документа не закрытого до статуса" 'факт':U skip
     3217         "Документ" p-doc-code skip
     3218         view-as alert-box error .
     3219       undo main-block, return error .
     3220     end.
     3221   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3222   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3223     (input  buf_trn-doc.obj-type
     3224     ,input  buf_trn-doc.obj-code
     3225     ,input  'shift-on=request'
     3226     ,output v-shift-on
     3227     ) no-error .
     3228     if error-status :error
     3229     then do:
     3230       message
     3231         vss-workfile vss-revision vss-description skip
     3232         "Ошибка при запуске процедуры objat" skip
     3233         error-status :get-message(1) skip
     3234         return-value skip
     3235         view-as alert-box error .
     3236       undo main-block, return error .
     3237     end.
