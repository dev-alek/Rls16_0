     2879     (input  bf_trn-doc.obj-type
     2880     ,input  bf_trn-doc.obj-code
     2881     ,input  varb-code
     2882     ,input  0
     2883     ,input  bf_trn-doc.fact-order
     2884     ,output vardoc-num
     2885     ,output varprice-sale
     2886     ,output varroad-tax
     2887     ,output varexcise
     2888     )  .
     2889             if varprice-sale = ?
     2890             then do:
     2891               assign
     2892                 varprice-sale = 0
     2893                 varroad-tax   = 0
     2894                 varexcise     = 0
     2895               .
     2896             end.
     2897             assign
     2898               varlastcur-base     = varprice-sale
     2899               varlastcur-road-tax = varroad-tax
     2900               varlastcur-excise   = varexcise
     2901               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2902               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2903               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2904               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2905             .
     2906         end.
     2907       end.
     2908       if varcur-fact-qnty = 0 then do:
     2909         assign
     2910           varcur-base      = varlastcur-base
     2911           varcur-road-tax  = varlastcur-road-tax
     2912           varcur-excise    = varlastcur-excise
     2913         .
     2914       end.
     2915       else do:
     2916         assign
     2917           varcur-base      = varcur-base      / varcur-fact-qnty
     2918           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2919           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2920         .
     2921       end.
     2922       if varcur-vat-pc = ?
     2923       then do:
     2924         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2925       end.
     2926       if varcur-slt-pc = ?
     2927       then do:
     2928         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2929       end.
     2930       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2931       assign
     2932         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     2933       if varcur-cons-vat-pc = ? then do:
