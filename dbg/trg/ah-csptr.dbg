     5283             end.
     5284                                 assign
     5285               buf_stk-supp-line.obj-type     = buf_temp-shift-stk-supp-line.obj-type     buf_stk-supp-line.obj-code     = buf_temp-shift-stk-supp-line.obj-code     buf_stk-supp-line.cli-type     = buf_temp-shift-stk-supp-line.cli-type     buf_stk-supp-line.cli-code     = buf_temp-shift-stk-supp-line.cli-code     buf_stk-supp-line.artic        = buf_temp-shift-stk-supp-line.artic        buf_stk-supp-line.prod-type    = buf_temp-shift-stk-supp-line.prod-type    buf_stk-supp-line.prod-code    = buf_temp-shift-stk-supp-line.prod-code    buf_stk-supp-line.fact-order   = buf_temp-shift-stk-supp-line.fact-order   buf_stk-supp-line.sum-type     = buf_temp-shift-stk-supp-line.sum-type     buf_stk-supp-line.cat-id       = buf_temp-shift-stk-supp-line.cat-id       buf_stk-supp-line.fact-date    = buf_temp-shift-stk-supp-line.fact-date    buf_stk-supp-line.shift-num    = buf_temp-shift-stk-supp-line.shift-num    buf_stk-supp-line.shift-date   = buf_temp-shift-stk-supp-line.shift-date
     5286             .
     5287             assign
     5288                                                                                       buf_stk-supp-line.fact-qnty      = buf_temp-shift-stk-supp-line.new-fact-qnty            buf_stk-supp-line.sum-base       = buf_temp-shift-stk-supp-line.new-sum-base             buf_stk-supp-line.sum-rubl       = buf_temp-shift-stk-supp-line.new-sum-rubl             buf_stk-supp-line.vat-base       = buf_temp-shift-stk-supp-line.new-vat-base             buf_stk-supp-line.vat-rubl       = buf_temp-shift-stk-supp-line.new-vat-rubl             buf_stk-supp-line.slt-base       = buf_temp-shift-stk-supp-line.new-slt-base             buf_stk-supp-line.slt-rubl       = buf_temp-shift-stk-supp-line.new-slt-rubl             buf_stk-supp-line.road-tax-base  = buf_temp-shift-stk-supp-line.new-road-tax-base        buf_stk-supp-line.road-tax-rubl  = buf_temp-shift-stk-supp-line.new-road-tax-rubl        buf_stk-supp-line.excise-base    = buf_temp-shift-stk-supp-line.new-excise-base          buf_stk-supp-line.excise-rubl    = buf_temp-shift-stk-supp-line.new-excise-rubl          buf_stk-supp-line.transport-base = buf_temp-shift-stk-supp-line.new-transport-base       buf_stk-supp-line.transport-rubl = buf_temp-shift-stk-supp-line.new-transport-rubl       buf_stk-supp-line.other-base     = buf_temp-shift-stk-supp-line.new-other-base           buf_stk-supp-line.other-rubl     = buf_temp-shift-stk-supp-line.new-other-rubl
     5289             .
     5290           end.
     5291           else do:
     5292             if available buf_stk-supp-line
     5293             then do:
     5294               delete buf_stk-supp-line .
     5295             end.
     5296           end.
     5297         end.
     5298       end.
     5299     end.
     5300   end procedure.
     5301   procedure check-need-process :
     5302     define output parameter p-need-process as logical   no-undo .
     5303     define buffer buf_temp-ot-supp-line for temp-ot-supp-line .
     5304     do
     5305     on error undo, return error return-value
     5306     :
     5307       if can-find (
     5308        first buf_temp-ot-supp-line
     5309         where
     5310                                           buf_temp-ot-supp-line.new-fact-qnty      <> 0 or    buf_temp-ot-supp-line.new-sum-base       <> 0 or    buf_temp-ot-supp-line.new-sum-rubl       <> 0 or    buf_temp-ot-supp-line.new-vat-base       <> 0 or    buf_temp-ot-supp-line.new-vat-rubl       <> 0 or    buf_temp-ot-supp-line.new-slt-base       <> 0 or    buf_temp-ot-supp-line.new-slt-rubl       <> 0 or    buf_temp-ot-supp-line.new-road-tax-base  <> 0 or    buf_temp-ot-supp-line.new-road-tax-rubl  <> 0 or    buf_temp-ot-supp-line.new-excise-base    <> 0 or    buf_temp-ot-supp-line.new-excise-rubl    <> 0 or    buf_temp-ot-supp-line.new-transport-base <> 0 or    buf_temp-ot-supp-line.new-transport-rubl <> 0 or    buf_temp-ot-supp-line.new-other-base     <> 0 or    buf_temp-ot-supp-line.new-other-rubl     <> 0
     5311         )
     5312       then do:
     5313         assign
     5314           p-need-process = true
     5315         .
     5316       end.
     5317       else do:
     5318         assign
     5319           p-need-process = false
     5320         .
     5321       end.
     5322     end.
     5323   end procedure.
     5324   procedure show-action :
     5325     do
     5326     on error undo, return error
     5327     :
     5328       define input parameter p-action as character no-undo .
     5329       define variable v-today as date      no-undo.
     5330       define variable v-time  as integer   no-undo.
     5331       run cur-time in this-procedure ( output v-today
     5332                                      , output v-time
     5333                                      ).
     5334       assign
     5335         current-time = string(v-time - start-time, "HH:MM:SS")
     5336         current-action = p-action
     5337       .
     5338       if mFrameView
     5339       then do:
     5340       display
     5341         current-time
     5342         current-action
     5343         with frame infa.
     5344        end.
     5345     end.
     5346   end procedure.
