     3018   procedure clcprtsl_calc-ttable :
     3019   define input parameter paris-doc           as   logical                 no-undo.
     3020   define input parameter paris-cur           as   logical                 no-undo.
     3021   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3022   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3023   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3024   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3025   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3026   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3027   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3028   define input parameter parr-b              as   character               no-undo.
     3029   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3030   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3031   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3032   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3033   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3034   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3035   define buffer bf_tt-allsum      for tt-allsum.
     3036   define buffer bf_tt-clcparts    for tt-clcparts.
     3037   define buffer bf_tt-allsum-line for tt-allsum-line.
     3038   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3039   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3040   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3041   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3042   define variable varexcise          like ub.price-list.excise     no-undo.
     3043   do on error undo, return error return-value :
     3044   for each bf_tt-allsum-line
     3045   on error undo, return error return-value
     3046    :
     3047     delete bf_tt-allsum-line.
     3048   end.
     3049   for each bf_tt-allsum
     3050   on error undo, return error return-value
     3051   :
     3052     delete bf_tt-allsum.
     3053   end.
     3054   for each bf_tt-clcparts
     3055   on error undo, return error return-value
     3056   :
     3057   if v-calcbypart then do:
     3058             assign
     3059             parcur-base =   bf_tt-clcparts.part-cur-base
     3060             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3061             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3062             .
     3063   end.
     3064      run clcprtsl_calc-parts in this-procedure (
     3065        input recid(bf_tt-clcparts),
     3066        input paris-doc,
     3067        input paris-cur,
     3068        input parroad-tax,
     3069        input parexcise,
     3070        input parvat-pc,
     3071        input parcons-vat-pc,
     3072        input parslt-pc,
     3073        input parbase-rate,
     3074        input parbase-scale,
     3075        input parr-b,
     3076        input parcur-base,
     3077        input parcur-road-tax,
     3078        input parcur-excise,
     3079        input parcur-vat-pc,
     3080        input parcurcons-vat-pc,
     3081        input parcurslt-pc
     3082        ) no-error.
     3083     if error-status:error then do:
     3084       message
     3085         vss-workfile vss-revision vss-description skip
     3086         vss-include-info10 skip
     3087         "Ошибка при обсчете партии" skip
     3088         "Документ партии " bf_tt-clcparts.out-code skip
     3089         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3090         return-value skip
     3091         error-status:get-message(1) skip
     3092         error-status:get-message(2) skip
     3093         error-status:get-message(3) skip
     3094         view-as alert-box error .
     3095       undo, return error .
     3096     end.
     3097     for each bf_tt-allsum on error undo, return error return-value :
     3098       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3099       if not available bf_tt-allsum-line then do:
     3100         create bf_tt-allsum-line.
     3101         assign
     3102           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3103       end.
     3104       assign
     3105         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3106         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3107         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3108         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3109         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3110         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3111         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3112         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3113         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3114         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3115         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3116         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3117         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3118         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3119         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3120         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3121         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3122         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3123         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3124         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3125         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3126         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
