      363   do
      364   on error undo, return error return-value
      365   :
      366     define buffer calc-supp-arh-lock_batchprocess for ub.batchprocess .
      367     run gbl/lock-prc.p
      368       (input 'ahsp':U
      369       ,input p-obj-code
      370       ,input 0
      371       ,input 0
      372       ,input p-obj-type
      373       ,input ""
      374       ,input ""
      375       ,input "Объект,,, ,,,Расчет складского архива по поставщикам"
      376       ,input true
      377       ,buffer calc-supp-arh-lock_batchprocess
      378       ) no-error .
      379     if error-status :error
      380     then do:
      381       message
      382         vss-workfile vss-revision vss-description skip
      383         "В данный момент рассчитывается складской архив по поставщикам" skip
      384         "Невозможно пометить складской архив по поставщикам, как требующий перерасчета" skip
      385         view-as alert-box error .
      386       undo, return error .
      387     end.
      388     define variable v-ahsp-recalc      as character no-undo .
      389     define variable v-attr-type        as character no-undo .
      390     define variable v-ahsp-recalc-date as date      no-undo .
      391     assign
      392       v-ahsp-recalc-date = ?
      393     .
      394     run clntattr-value in this-procedure
      395       (input  p-obj-type
      396       ,input  p-obj-code
      397       ,input  'ahsp-recalc':U
      398       ,output v-ahsp-recalc
      399       ,output v-attr-type
      400       ) .
      401     if v-ahsp-recalc <> ""
      402     then do:
      403       assign
      404         v-ahsp-recalc-date = date(v-ahsp-recalc)
      405       .
      406     end.
      407     if  v-ahsp-recalc-date <> ?
      408     and v-ahsp-recalc-date < p-fact-date
      409     then do:
      410       return .
      411     end.
      412     define variable v-create-chip-num as integer   no-undo .
      413     run utl/arhiscr.p
      414       (input  p-obj-type
      415       ,input  p-obj-code
      416       ,input  'ahsp':U
      417       ,input  'set-recalc':U
      418       ,input  ""
      419       ,input  ""
      420       ,input  0
      421       ,input  'trn-doc':U
      422       ,input  p-doc-code
      423       ,input  p-fact-date
      424       ,output v-create-chip-num
      425       ) .
      426     run clntattr-write in this-procedure
      427       (input p-obj-type
      428       ,input p-obj-code
      429       ,input 'ahsp-recalc':U
      430       ,input string(p-fact-date, '99/99/9999':U)
      431       ) .
      432   end.
