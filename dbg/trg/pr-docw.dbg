     3007                                , chr(10)
     3008                                , vss-workfile
     3009                                , return-value
     3010                                , error-status :get-message ( 1 ) ).
     3011       end.
     3012       end.
     3013   end.
     3014   procedure change-status-act :
     3015     define input parameter l-need-clear-ov-on as logical no-undo .
     3016     define variable v-today as date      no-undo.
     3017     define variable v-time  as integer   no-undo.
     3018     define buffer buf_price-list for ub.price-list .
     3019     do
