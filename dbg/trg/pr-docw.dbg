        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.price-doc old buffer old-doc .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись ub.price-doc".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2',ub.price-doc.doc-num,ub.price-doc.status_)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure factord :
       83     define input  parameter p-fact-date            as date    no-undo .
       84     define input  parameter p-fact-time            as integer no-undo .
       85     define input  parameter p-fact-num             as integer no-undo .
       86     define input  parameter p-shift-date           as date    no-undo .
       87     define input  parameter p-shift-num            as integer no-undo .
       88     define input  parameter p-shift-on             as logical no-undo .
       89     define output parameter p-fact-order           as decimal no-undo .
       90     define output parameter p-shift-end-fact-order as decimal no-undo .
       91     define output parameter p-day-end-fact-order   as decimal no-undo .
       92     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       93     if p-fact-date = ?
       94     then do:
       95       return error "Не указана фактическая дата" .
       96     end.
       97     define variable v-fact-date-num as integer no-undo .
       98     assign
       99       v-fact-date-num = integer(p-fact-date)
      100     .
      101     if p-fact-num = ?
      102     or p-fact-num = 0
      103     then do:
      104       return error "Не задан p-fact-num " + string(p-fact-num) .
      105     end.
      106     if p-fact-num < 0
      107     then do:
      108       return error "Отрицательный fact-num " + string(p-fact-num) .
      109     end.
      110     if p-fact-num >= 100000000
      111     then do:
      112       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      113     end.
      114     if p-shift-on = true
      115     then do:
      116       if p-shift-date = ?
      117       then do:
      118         return error "Не задана дата смены" .
      119       end.
      120       if p-shift-num = ?
      121       or p-shift-num = 0
      122       then do:
      123         return error "Не задан номер смены" .
      124       end.
      125     end.
      126     else do:
      127       assign
      128         p-shift-date = p-fact-date
      129         p-shift-num  = 24
      130       .
      131     end.
      132     define variable v-shift-offset as integer no-undo .
      133     if p-shift-date = p-fact-date
      134     then do:
      135       assign
      136         v-shift-offset = 1
      137       .
      138     end.
      139     if p-shift-date < p-fact-date
      140     then do:
      141       assign
      142         v-shift-offset = 0
      143       .
      144     end.
      145     if p-shift-date > p-fact-date
      146     then do:
      147       message
      148         vss-workfile vss-revision vss-description skip
      149         "Неправильная дата закрытия смены" skip
      150         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      151         view-as alert-box error .
      152       undo, return error
      153         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      154           ,string(p-fact-date, '99/99/9999':U)
      155           ,string(p-shift-date, '99/99/9999':U)
      156           )
      157       .
      158     end.
      159     if p-shift-num < 1
      160     or p-shift-num > 24
      161     then do:
      162       message
      163         vss-workfile vss-revision vss-description skip
      164         "Неправильный номер смены" skip
      165         "p-shift-num" p-shift-num skip
      166         view-as alert-box error .
      167       undo, return error return-value .
      168     end.
      169     assign
      170       p-fact-order           = v-fact-date-num
      171                              + v-shift-offset * 0.5
      172                              + p-shift-num    * 0.02 - 0.01
      173                              + p-fact-num     * 0.0000000001
      174       p-shift-end-fact-order = v-fact-date-num
      175                              + v-shift-offset * 0.5
      176                              + p-shift-num    * 0.02
      177       p-day-end-fact-order   = v-fact-date-num
      178                              + 0.99
      179     .
      180     if p-fact-order           <= v-fact-date-num
      181     or p-shift-end-fact-order <= v-fact-date-num
      182     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      183     or p-shift-end-fact-order >= p-day-end-fact-order
      184     then do:
      185       message
      186         vss-workfile vss-revision vss-description skip
      187         "Внутренняя ошибка при генерации фактического номера" skip
      188         "p-fact-date"            p-fact-date            skip
      189         "p-fact-time"            p-fact-time            skip
      190         "p-fact-num"             p-fact-num             skip
      191         "p-shift-date"           p-shift-date           skip
      192         "p-shift-num"            p-shift-num            skip
      193         "p-shift-on"             p-shift-on             skip
      194         "p-shift-end-fact-order" p-shift-end-fact-order skip
      195         "p-day-end-fact-order"   p-day-end-fact-order   skip
      196         "v-fact-date-num"        v-fact-date-num        skip
      197         view-as alert-box error .
      198       undo, return error return-value .
      199     end.
      200   end procedure.
      201   procedure day-begin-fact-order :
      202     define input  parameter p-fact-date            as date    no-undo .
      203     define output parameter p-day-begin-fact-order as decimal no-undo .
      204     do
      205     on error undo, return error return-value
      206     :
      207       if p-fact-date = ?
      208       then do:
      209         assign
      210           p-day-begin-fact-order = 0
      211         .
      212       end.
      213       else do:
      214         assign
      215           p-day-begin-fact-order = integer(p-fact-date)
      216         .
      217       end.
      218     end.
      219   end procedure.
      220   procedure factord-max-fact-order :
      221     define output parameter p-max-fact-order as decimal   no-undo .
      222     do
      223     on error undo, return error return-value
      224     :
      225       run day-begin-fact-order in this-procedure
      226         (input  date(1, 1, 5000)
      227         ,output p-max-fact-order
      228         ) .
      229     end.
      230   end procedure.
      231   procedure factord-cut-archive :
      232     define input  parameter p-obj-type             as character no-undo .
      233     define input  parameter p-obj-code             as integer   no-undo .
      234     define input  parameter p-fact-date            as date      no-undo .
      235     define output parameter p-shift-on             as logical   no-undo .
      236     define output parameter p-shift-date           as date      no-undo .
      237     define output parameter p-shift-num            as integer   no-undo .
      238     define output parameter p-day-end-fact-order   as decimal   no-undo .
      239     define output parameter p-shift-end-fact-order as decimal   no-undo .
      240     define variable v-fact-order as decimal   no-undo .
      241     define buffer buf_shift-obj for ub.shift-obj .
      242     do
      243     on error undo, return error return-value
      244     :
      245   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      246   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      247     (input  p-obj-type
      248     ,input  p-obj-code
      249     ,input  'shift-on=request'
      250     ,output p-shift-on
      251     ) no-error .
      252       if error-status :error
      253       then do:
      254         message
      255           vss-workfile vss-revision vss-description skip
      256           "Ошибка при определении атрибута объекта" skip
      257           "Объект" p-obj-type p-obj-code skip
      258           error-status :get-message(1) skip
      259           return-value skip
      260           view-as alert-box error .
      261         undo, return error return-value .
      262       end.
      263       if p-shift-on = false
      264       then do:
      265         assign
      266           p-shift-date               = ?
      267           p-shift-num                = 0
      268         .
      269       end.
      270       else do:
      271         find first buf_shift-obj share-lock
      272           where buf_shift-obj.obj-type   = p-obj-type
      273             and buf_shift-obj.obj-code   = p-obj-code
      274             and buf_shift-obj.shift-date > p-fact-date
      275           use-index pi
      276           no-error .
      277         if not available buf_shift-obj
      278         or buf_shift-obj.status_ <> 'зкр':U
      279         then do:
      280           message
      281             vss-workfile vss-revision vss-description skip
      282             "Невозможно вычислить последнюю смену" skip
      283             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      284             "Объект" p-obj-type p-obj-code skip
      285             "Дата" p-fact-date skip
      286             view-as alert-box error .
      287           undo, return error return-value .
      288         end.
      289         find last buf_shift-obj share-lock
      290           where buf_shift-obj.obj-type = p-obj-type
      291             and buf_shift-obj.obj-code = p-obj-code
      292             and buf_shift-obj.shift-date <= p-fact-date
      293           use-index pi
      294           no-error .
      295         if available buf_shift-obj
      296         then do:
      297           if  buf_shift-obj.status_ = 'зкр':U
      298           then do:
      299             assign
      300               p-shift-date = buf_shift-obj.shift-date
      301               p-shift-num  = buf_shift-obj.shift-num
      302             .
      303           end.
      304           else do:
      305             message
      306               vss-workfile vss-revision vss-description skip
      307               "Невозможно вычислить последнюю смену" skip
      308               "Статус смены отличен от статуса" 'зкр':U skip
      309               "Объект" p-obj-type p-obj-code skip
      310               "Дата" p-fact-date skip
      311               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      312               view-as alert-box error .
      313             undo, return error return-value .
      314           end.
      315         end.
      316         else do:
      317           assign
      318             p-shift-date = p-fact-date - 1
      319             p-shift-num  = 1
      320           .
      321         end.
      322       end.
      323       run factord in this-procedure
      324         (input  p-fact-date
      325         ,input  1
      326         ,input  1
      327         ,input  p-shift-date
      328         ,input  p-shift-num
      329         ,input  p-shift-on
      330         ,output v-fact-order
      331         ,output p-shift-end-fact-order
      332         ,output p-day-end-fact-order
      333         ) no-error .
      334       if error-status :error
      335       then do:
      336         message
      337           vss-workfile vss-revision vss-description skip
      338           "Ошибка при вызове процедуры factord"
      339           error-status :get-message(1) skip
      340           return-value skip
      341           view-as alert-box error .
      342         undo, return error return-value .
      343       end.
      344     end.
      345   end procedure.
      346   procedure factord-lock-shift :
      347     define input  parameter p-obj-type  as character no-undo .
      348     define input  parameter p-obj-code  as integer   no-undo .
      349     define input  parameter p-fact-date as date      no-undo .
      350     define parameter buffer buf_shift-obj for ub.shift-obj .
      351     define variable v-shift-on      as logical   no-undo .
      352     define variable v-extra-message as character no-undo .
      353     define variable v-error as character no-undo .
      354     do
      355     on error undo, return error return-value
      356     :
      357   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      359     (input  p-obj-type
      360     ,input  p-obj-code
      361     ,input  'shift-on=request'
      362     ,output v-shift-on
      363     ) no-error .
      364       if error-status :error
      365       then do:
      366         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      367         undo, return error v-error .
      368       end.
      369       if v-shift-on = true
      370       then do:
      371         find first buf_shift-obj share-lock
      372           where buf_shift-obj.obj-type   = p-obj-type
      373             and buf_shift-obj.obj-code   = p-obj-code
      374             and buf_shift-obj.shift-date > p-fact-date
      375           use-index pi
      376           no-error .
      377         if not available buf_shift-obj
      378         or buf_shift-obj.status_ <> 'зкр':U
      379         then do:
      380           find last buf_shift-obj
      381             where buf_shift-obj.obj-type = p-obj-type
      382               and buf_shift-obj.obj-code = p-obj-code
      383               and buf_shift-obj.status_  = 'зкр':U
      384             use-index stts
      385             no-error .
      386           if available buf_shift-obj
      387           then do:
      388             assign
      389               v-extra-message =
      390                     substitute("Дата начала последеней закрытой смены на объекте &1"
      391                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      392                               )
      393             .
      394           end.
      395           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      396           undo, return error v-error .
      397         end.
      398       end.
      399     end.
      400   end procedure.
      401   procedure factord-end-day :
      402     define input  parameter p-fact-date            as date    no-undo .
      403     define output parameter p-day-end-fact-order   as decimal no-undo .
      404     do
      405     on error undo, return error return-value
      406     :
      407       if p-fact-date = ?
      408       then do:
      409         return error "Не указана фактическая дата" .
      410       end.
      411       assign
      412         p-day-end-fact-order = integer(p-fact-date) + 0.99
      413       .
      414     end.
      415   end procedure.
      416   procedure factord-to-date :
      417     define input  parameter p-fact-order as decimal no-undo .
      418     define output parameter p-fact-date  as date    no-undo .
      419     define variable v-ref-date  as date      no-undo .
      420     define variable v-ref-delta as integer   no-undo .
      421     do
      422     on error undo, return error return-value
      423     :
      424       if p-fact-order = ?
      425       or p-fact-order = 0
      426       then do:
      427         return error "Не указан fact-order" .
      428       end.
      429       assign
      430         v-ref-date  = date(1, 1, 2000)
      431       .
      432       assign
      433         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      434       .
      435       assign
      436         p-fact-date = v-ref-date + v-ref-delta
      437       .
      438     end.
      439   end procedure.
      440   procedure factord-to-fact-num :
      441     define input  parameter p-fact-order as decimal no-undo .
      442     define output parameter p-fact-num   as integer no-undo .
      443     define variable v-fact-order-trunc as decimal no-undo .
      444     do
      445     on error undo, return error return-value
      446     :
      447       if p-fact-order = ?
      448       or p-fact-order = 0
      449       then do:
      450         return error "Не указан fact-order" .
      451       end.
      452       assign
      453        v-fact-order-trunc = truncate(p-fact-order, 2)
      454       .
      455       assign
      456         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      457       .
      458     end.
      459   end procedure.
      460   procedure factord-to-shift-num :
      461     define input  parameter p-fact-order as decimal no-undo .
      462     define output parameter p-shift-num   as integer no-undo .
      463     define variable  p-shift-numd  as decimal   no-undo .
      464     define variable v-fact-order-trunc as decimal no-undo .
      465     do
      466     on error undo, return error return-value
      467     :
      468       if p-fact-order = ?
      469       or p-fact-order = 0
      470       then do:
      471         return error "Не указан fact-order" .
      472       end.
      473       assign
      474        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      475       .
      476       if v-fact-order-trunc < 0.5 then do:
      477         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      478       end.
      479       assign
      480         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      481         .
      482        assign
      483         p-shift-num = truncate (p-shift-numd , 0)
      484       .
      485     end.
      486   end procedure.
      487   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      488   define temp-table temp-pl-gds no-undo   like ub.pl-gds .
      489   define temp-table temp-prt-obj no-undo   field prt-code         like ub.prt-obj.prt-code     field price-sale       like ub.prt-obj.price-sale   field fact-qnty        like ub.prt-obj.fact-qnty    field price-list-qnty  like ub.prt-obj.fact-qnty    field is-term          as logical   field prt-obj-recid    as recid     field price-list-recid as recid     index xpk is primary unique prt-code   index xie1 is-term .
      490   procedure prdoclib-process-goods :
      491     define input  parameter p-obj-type          as character no-undo .
      492     define input  parameter p-obj-code          as integer   no-undo .
      493     define input  parameter p-artic             as character no-undo .
      494     define input  parameter p-prod-type         as character no-undo .
      495     define input  parameter p-prod-code         as integer   no-undo .
      496     define input  parameter p-check-price-list  as logical   no-undo .
      497     define input  parameter p-check-price-parts as logical   no-undo .
      498     define input  parameter p-doc-num           as character no-undo .
      499     define input  parameter p-fact-date         as date      no-undo .
      500     define input  parameter p-corr-user-db-num  as integer   no-undo .
      501     define input  parameter p-corr-user-name    as character no-undo .
      502     define input  parameter p-corr-date         as date      no-undo .
      503     define input  parameter p-corr-time         as integer   no-undo .
      504     define input  parameter p-corr-time-str     as character no-undo .
      505     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
      506     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
      507     define buffer buf_gds-obj      for ub.gds-obj .
      508     define buffer buf_prt-obj      for ub.prt-obj .
      509     define buffer buf_price-list   for ub.price-list .
