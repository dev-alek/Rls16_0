      937   end.
      938       for each buf_temp-prt-obj
      939       ,first buf_prt-obj exclusive-lock
      940         where recid(buf_prt-obj) = buf_temp-prt-obj.prt-obj-recid
      941       on error undo, return error return-value
      942       :
      943         assign
      944           buf_prt-obj.price-sale = buf_temp-prt-obj.price-sale
      945         .
      946       end.
      947     end.
      948   end procedure.
      949   procedure prdoclib-clear-temp-prt-obj :
      950     define buffer buf_temp-prt-obj for temp-prt-obj .
      951     do
      952     on error undo, return error return-value
      953     :
      954       for each buf_temp-prt-obj
      955       on error undo, return error return-value
      956       :
      957         delete buf_temp-prt-obj .
      958       end.
      959     end.
      960   end procedure.
      961   procedure prdoclib-create-temp-prt-obj :
      962     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
      963     define parameter buffer buf_prt-obj       for ub.prt-obj .
      964     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
      965     define buffer buf_gds-prt for ub.gds-prt .
      966     do
      967     on error undo, return error return-value
      968     :
      969       find first buf_temp-prt-obj
      970         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
      971         no-error .
      972       if not available buf_temp-prt-obj
      973       then do:
      974         create buf_temp-prt-obj .
      975         assign
      976           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
      977           buf_temp-prt-obj.price-sale       = ?
      978           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
      979           buf_temp-prt-obj.price-list-qnty  = ?
      980           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
      981           buf_temp-prt-obj.price-list-recid = ?
      982         .
      983         find first buf_gds-prt no-lock
      984           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
      985           .
      986         assign
      987           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
      988         .
      989         if buf_temp-prt-obj.is-term
      990         then do:
      991           assign
      992             buf_temp-prt-obj.price-sale = p-root-price-sale
      993           .
      994         end.
      995       end.
      996     end.
      997   end procedure.
      998   procedure prdoclib-temp-prt-obj-by-prt-root :
      999     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1000     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1001     define buffer buf_gds-prt for ub.gds-prt .
     1002     do
     1003     on error undo, return error return-value
     1004     :
     1005       find first buf_temp-prt-obj
     1006         where buf_temp-prt-obj.prt-code = p-prt-code
     1007         no-error .
     1008       if not available buf_temp-prt-obj
     1009       then do:
     1010         create buf_temp-prt-obj .
     1011         assign
     1012           buf_temp-prt-obj.prt-code         = p-prt-code
     1013           buf_temp-prt-obj.price-sale       = ?
     1014           buf_temp-prt-obj.fact-qnty        = 0
     1015           buf_temp-prt-obj.price-list-qnty  = ?
     1016           buf_temp-prt-obj.prt-obj-recid    = ?
     1017           buf_temp-prt-obj.price-list-recid = ?
     1018         .
     1019         find first buf_gds-prt no-lock
     1020           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1021           .
     1022         assign
     1023           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1024         .
     1025         if buf_temp-prt-obj.is-term
     1026         then do:
     1027           assign
     1028             buf_temp-prt-obj.price-sale = 0
     1029           .
     1030         end.
     1031       end.
     1032     end.
     1033   end procedure.
     1034   procedure prdoclib-init-temp-prt-obj :
     1035     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1036     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1037     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1038     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1039     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1040     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1041     define buffer buf_prt-obj      for ub.prt-obj .
     1042     define buffer buf_temp-prt-obj for temp-prt-obj .
     1043     do
     1044     on error undo, return error return-value
     1045     :
     1046       run prdoclib-clear-temp-prt-obj in this-procedure .
     1047       for each buf_prt-obj
     1048         where buf_prt-obj.obj-type  = p-obj-type
     1049           and buf_prt-obj.obj-code  = p-obj-code
     1050           and buf_prt-obj.artic     = p-artic
     1051           and buf_prt-obj.prod-type = p-prod-type
     1052           and buf_prt-obj.prod-code = p-prod-code
     1053       on error undo, return error return-value
     1054       :
     1055         run prdoclib-create-temp-prt-obj in this-procedure
     1056           (input  p-root-price-sale
     1057           ,buffer buf_prt-obj
     1058           ,buffer buf_temp-prt-obj
     1059           ).
     1060       end.
     1061     end.
     1062   end procedure.
     1063   procedure prdoclib-calc-fact-sale :
     1064     define input  parameter p-price-list-recid   as recid     no-undo .
     1065     define output parameter p-fact-qnty          as decimal   no-undo .
     1066     define output parameter p-cur-base           as decimal   no-undo .
     1067     define output parameter p-cur-VAT-base       as decimal   no-undo .
     1068     define output parameter p-cur-SLT-base       as decimal   no-undo .
     1069     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     1070     define output parameter p-cur-excise-base    as decimal   no-undo .
     1071     define buffer buf_main_price-list for ub.price-list .
     1072     define buffer buf_price-list      for ub.price-list .
     1073     define buffer buf_goods           for ub.goods .
     1074     define buffer buf_gds-obj         for ub.gds-obj .
     1075     define buffer buf_bar-code        for ub.bar-code .
     1076     define variable l-empty-scale   as logical   no-undo .
     1077     do
     1078     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     1079     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     1080     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     1081     :
     1082       find first buf_main_price-list no-lock
     1083         where recid(buf_main_price-list) = p-price-list-recid
     1084         no-error .
     1085       if not available buf_main_price-list
     1086       then do:
     1087         message
     1088           vss-workfile vss-revision vss-description skip
     1089           vss-include-info3 skip
     1090           "Ошибка задания входных параметров" skip
     1091           "Не найдена строка переоценки" skip
     1092           "Код записи (recid)" p-price-list-recid skip
     1093           view-as alert-box error .
     1094         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     1095       end.
     1096       if buf_main_price-list.main-price <> true
     1097       then do:
     1098         message
     1099           vss-workfile vss-revision vss-description skip
     1100           vss-include-info3 skip
     1101           "Ошибка задания входных параметров" skip
     1102           "Строка переоценки не является основной" skip
     1103           "Код записи (recid)" p-price-list-recid skip
     1104           "Переоценка" buf_main_price-list.doc-num skip
     1105           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1106           "Бар-код" buf_main_price-list.b-code skip
     1107           view-as alert-box error .
     1108         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     1109       end.
     1110       find first buf_goods no-lock
     1111         where buf_goods.artic     = buf_main_price-list.artic
     1112           and buf_goods.prod-type = buf_main_price-list.prod-type
     1113           and buf_goods.prod-code = buf_main_price-list.prod-code
     1114         no-error .
     1115       if not available buf_goods
     1116       then do:
     1117         message
     1118           vss-workfile vss-revision vss-description skip
     1119           vss-include-info3 skip
     1120           "Не найден товар" skip
     1121           "Переоценка" buf_main_price-list.doc-num skip
     1122           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1123           view-as alert-box error .
     1124         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1125       end.
     1126   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1128     (input  buf_main_price-list.artic
     1129     ,input  buf_main_price-list.prod-type
     1130     ,input  buf_main_price-list.prod-code
     1131     ,input  'empty-scale=request':u
     1132     ,output l-empty-scale
     1133     ) no-error .
     1134       if error-status :error
     1135       then do:
     1136         message
     1137           vss-workfile vss-revision vss-description skip
     1138           vss-include-info3 skip
     1139           "Ошибка при определении атрибута товара" skip
     1140           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1141           'empty-scale=request':u skip
     1142           error-status :get-message(1) skip
     1143           return-value skip
     1144           view-as alert-box error .
     1145         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1146       end.
     1147       find first buf_gds-obj no-lock
     1148         where buf_gds-obj.gds-code = buf_goods.gds-code
     1149           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     1150           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     1151         no-error .
     1152         if not available buf_gds-obj then do:
     1153   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1155     (input  buf_main_price-list.obj-type
     1156     ,input  buf_main_price-list.obj-code
     1157     ,input  buf_goods.artic
     1158     ,input  buf_goods.prod-type
     1159     ,input  buf_goods.prod-code
     1160     ,buffer buf_gds-obj
     1161     ) no-error .
     1162           if error-status :error then do:
     1163              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1164           end.
     1165         end.
     1166       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     1167       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     1168       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     1169       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     1170       define variable vat-base-sale-prl               as decimal   no-undo .
     1171       define variable vat-rubl-sale-prl               as decimal   no-undo .
     1172       define variable vat-base-buyer-prl              as decimal   no-undo .
     1173       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     1174       define variable slt-base-sale-prl               as decimal   no-undo .
     1175       define variable slt-rubl-sale-prl               as decimal   no-undo .
     1176       define variable road-tax-base-sale-prl          as decimal   no-undo .
     1177       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     1178       define variable excise-base-sale-prl            as decimal   no-undo .
     1179       define variable excise-rubl-sale-prl            as decimal   no-undo .
     1180       define variable discnt-base-sale-prl            as decimal   no-undo .
     1181       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     1182       if buf_main_price-list.doc-qnty <> 0
     1183       then do:
     1184         run prl-vat in this-procedure
     1185           (input  recid(buf_main_price-list)
     1186           ,output price-rubl-with-tax-sale-prl
     1187           ,output price-base-with-tax-sale-prl
     1188           ,output price-rubl-without-tax-sale-prl
     1189           ,output price-base-without-tax-sale-prl
     1190           ,output vat-base-sale-prl
     1191           ,output vat-rubl-sale-prl
     1192           ,output vat-base-buyer-prl
     1193           ,output vat-rubl-buyer-prl
     1194           ,output slt-base-sale-prl
     1195           ,output slt-rubl-sale-prl
     1196           ,output road-tax-base-sale-prl
     1197           ,output road-tax-rubl-sale-prl
     1198           ,output excise-base-sale-prl
     1199           ,output excise-rubl-sale-prl
     1200           ,output discnt-base-sale-prl
     1201           ,output discnt-rubl-sale-prl
     1202           ) no-error .
     1203         if error-status :error
     1204         then do:
     1205           message
     1206             vss-workfile vss-revision vss-description skip
     1207             vss-include-info3 skip
     1208             "Ошибка при вызове процеды prl-vat" skip
     1209             "Документ" buf_main_price-list.doc-num skip
     1210             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1211             error-status :get-message(1) skip
     1212             return-value skip
     1213             view-as alert-box error .
     1214           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1215         end.
     1216       end.
     1217       else do:
     1218         assign
     1219           price-rubl-with-tax-sale-prl    = 0
     1220           price-base-with-tax-sale-prl    = 0
     1221           price-rubl-without-tax-sale-prl = 0
     1222           price-base-without-tax-sale-prl = 0
     1223           vat-base-sale-prl               = 0
     1224           vat-rubl-sale-prl               = 0
     1225           vat-base-buyer-prl              = 0
     1226           vat-rubl-buyer-prl              = 0
     1227           slt-base-sale-prl               = 0
     1228           slt-rubl-sale-prl               = 0
     1229           road-tax-base-sale-prl          = 0
     1230           road-tax-rubl-sale-prl          = 0
     1231           excise-base-sale-prl            = 0
     1232           excise-rubl-sale-prl            = 0
     1233           discnt-base-sale-prl            = 0
     1234           discnt-rubl-sale-prl            = 0
     1235         .
     1236       end.
     1237       define variable v-curr-r-b as character no-undo .
     1238   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1239   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1240     (output v-curr-r-b
     1241     )  .
     1242       if v-curr-r-b = 'base':U
     1243       then do:
     1244         assign
     1245           p-fact-qnty         = buf_main_price-list.doc-qnty
     1246           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1247           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     1248           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     1249           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     1250           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     1251         .
     1252       end.
     1253       else do:
     1254         assign
     1255           p-fact-qnty         = buf_main_price-list.doc-qnty
     1256           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1257           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     1258           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     1259           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     1260           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     1261         .
     1262       end.
     1263         define variable v-unit-base like ub.goods.unit-base no-undo .
     1264   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1266     (input  buf_goods.gds-code
     1267     ,output v-unit-base
     1268     ) no-error .
     1269         if error-status :error
     1270         then do:
     1271           message
     1272             vss-workfile vss-revision vss-description skip
     1273             vss-include-info3 skip
     1274             "Ошибка при определении базовой единицы измерения товара" skip
     1275             "Код товара" buf_goods.gds-code skip
     1276             error-status :get-message(1) skip
     1277             return-value skip
     1278             view-as alert-box error .
     1279           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1280         end.
     1281         for each buf_price-list no-lock
     1282           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     1283             and buf_price-list.main-price = false
     1284             and buf_price-list.artic      = buf_main_price-list.artic
     1285             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     1286             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     1287         :
     1288           if buf_price-list.doc-qnty = ?
     1289           then do:
     1290             find first buf_bar-code no-lock
     1291               where buf_bar-code.b-code = buf_price-list.b-code
     1292               no-error .
     1293             if available buf_bar-code
     1294             and buf_bar-code.unit-cli = v-unit-base
     1295             then do:
     1296               message
     1297                 vss-workfile vss-revision vss-description skip
     1298                 vss-include-info3 skip
     1299                 "Ошибка при закрытии переоценки" skip
     1300                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1301                 "Переоценка" buf_main_price-list.doc-num skip
     1302                 "Бар-код" buf_price-list.b-code skip
     1303                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1304                 "Количество" buf_price-list.doc-qnty skip
     1305                 "Основная единица измерения" v-unit-base skip
     1306                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1307                 view-as alert-box error .
     1308               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1309             end.
     1310             next .
     1311           end.
     1312           if not can-find
     1313             (first buf_bar-code
     1314             where buf_bar-code.b-code = buf_price-list.b-code
     1315             )
     1316           then do:
     1317             message
     1318               vss-workfile vss-revision vss-description skip
     1319               vss-include-info3 skip
     1320               "В переоценке задан несуществующий бар-код" skip
     1321               "Переоценка" buf_price-list.doc-num skip
     1322               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1323               "Бар-код" buf_price-list.b-code skip
     1324               view-as alert-box error .
     1325             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1326           end.
     1327           if buf_price-list.doc-qnty <> 0
     1328           then do:
     1329             run prl-vat in this-procedure
     1330               (input  recid(buf_price-list)
     1331               ,output price-rubl-with-tax-sale-prl
     1332               ,output price-base-with-tax-sale-prl
     1333               ,output price-rubl-without-tax-sale-prl
     1334               ,output price-base-without-tax-sale-prl
     1335               ,output vat-base-sale-prl
     1336               ,output vat-rubl-sale-prl
     1337               ,output vat-base-buyer-prl
     1338               ,output vat-rubl-buyer-prl
     1339               ,output slt-base-sale-prl
     1340               ,output slt-rubl-sale-prl
     1341               ,output road-tax-base-sale-prl
     1342               ,output road-tax-rubl-sale-prl
     1343               ,output excise-base-sale-prl
     1344               ,output excise-rubl-sale-prl
     1345               ,output discnt-base-sale-prl
     1346               ,output discnt-rubl-sale-prl
     1347               ) no-error .
     1348             if error-status :error
     1349             then do:
     1350               message
     1351                 vss-workfile vss-revision vss-description skip
     1352                 vss-include-info3 skip
     1353                 "Ошибка при вызове процеды prl-vat" skip
     1354                 "Документ" buf_price-list.doc-num skip
     1355                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1356                 error-status :get-message(1) skip
     1357                 return-value skip
     1358                 view-as alert-box error .
     1359               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1360             end.
     1361           end.
     1362           else do:
     1363             assign
     1364               price-rubl-with-tax-sale-prl    = 0
     1365               price-base-with-tax-sale-prl    = 0
     1366               price-rubl-without-tax-sale-prl = 0
     1367               price-base-without-tax-sale-prl = 0
     1368               vat-base-sale-prl               = 0
     1369               vat-rubl-sale-prl               = 0
     1370               vat-base-buyer-prl              = 0
     1371               vat-rubl-buyer-prl              = 0
     1372               slt-base-sale-prl               = 0
     1373               slt-rubl-sale-prl               = 0
     1374               road-tax-base-sale-prl          = 0
     1375               road-tax-rubl-sale-prl          = 0
     1376               excise-base-sale-prl            = 0
     1377               excise-rubl-sale-prl            = 0
     1378               discnt-base-sale-prl            = 0
     1379               discnt-rubl-sale-prl            = 0
     1380             .
     1381           end.
     1382           if v-curr-r-b = 'base':U
     1383           then do:
     1384             assign
     1385               p-fact-qnty         = p-fact-qnty
     1386                                   + buf_price-list.doc-qnty
     1387               p-cur-base          = p-cur-base
     1388                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1389               p-cur-VAT-base      = p-cur-VAT-base
     1390                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1391               p-cur-SLT-base      = p-cur-SLT-base
     1392                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1393               p-cur-road-tax-base = p-cur-road-tax-base
     1394                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1395               p-cur-excise-base   = p-cur-excise-base
     1396                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1397             .
     1398           end.
     1399           else do:
     1400             assign
     1401               p-fact-qnty         = p-fact-qnty
     1402                                   + buf_price-list.doc-qnty
     1403               p-cur-base          = p-cur-base
     1404                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1405               p-cur-VAT-base      = p-cur-VAT-base
     1406                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1407               p-cur-SLT-base      = p-cur-SLT-base
     1408                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1409               p-cur-road-tax-base = p-cur-road-tax-base
     1410                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1411               p-cur-excise-base   = p-cur-excise-base
     1412                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     1413             .
     1414           end.
     1415         end.
     1416     end.
     1417   end procedure.
     1418   procedure prdoclib-calc-prc :
     1419     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1420     define input  parameter p-cons-pay        as   integer                no-undo.
     1421     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1422     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1423     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1424     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1425     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1426     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1427     do
     1428     on error undo, return error return-value
     1429     :
     1430       define buffer buf_price-doc       for ub.price-doc .
     1431       define buffer buf_price-list      for ub.price-list .
     1432       define buffer buf_parts           for ub.parts .
     1433       define variable v-ov-qnty     as decimal   no-undo .
     1434       define variable v-ov-base     as decimal   no-undo .
     1435       define variable v-ov-VAT-base as decimal   no-undo .
     1436       define variable v-ov-SLT-base as decimal   no-undo .
     1437       define variable v-cons-qnty   as decimal   no-undo .
     1438       define variable v-prch-qnty   as decimal   no-undo .
     1439       define variable v-cons-mult   as decimal   no-undo .
     1440       define variable v-prch-mult   as decimal   no-undo .
     1441       find first buf_price-doc no-lock
     1442         where recid(buf_price-doc) = p-price-doc-recid
     1443         no-error .
     1444       if not available buf_price-doc
     1445       then do:
     1446         message
     1447           vss-workfile vss-revision vss-description skip
     1448           vss-include-info3 skip
     1449           "Ошибка задания входных параметров" skip
     1450           "Не найден документ переоценки" skip
     1451           "Код записи (recid)" p-price-doc-recid skip
     1452           view-as alert-box error .
     1453         undo, return error .
     1454       end.
     1455       for each buf_price-list no-lock
     1456         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1457           and buf_price-list.main-price = true
     1458       on error undo, return error return-value
     1459       :
     1460         run prdoclib-calc-ov
     1461           (input recid(buf_price-list)
     1462           ,output v-ov-qnty
     1463           ,output v-ov-base
     1464           ,output v-ov-VAT-base
     1465           ,output v-ov-SLT-base
     1466           ) no-error .
     1467         if error-status :error
     1468         then do:
     1469           if error-status :get-message(1) <> ""
     1470           then do:
     1471             message
     1472               vss-workfile vss-revision vss-description skip
     1473               vss-include-info3 skip
     1474               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1475               error-status :get-message(1) skip
     1476               return-value skip
     1477               view-as alert-box error .
     1478           end.
     1479           undo, return error return-value .
     1480         end.
     1481         assign
     1482           v-cons-qnty = 0
     1483           v-prch-qnty = 0
     1484         .
     1485         for each buf_parts no-lock
     1486           where buf_parts.out-code  = buf_price-list.doc-num
     1487             and buf_parts.obj-type  = buf_price-list.obj-type
     1488             and buf_parts.obj-code  = buf_price-list.obj-code
     1489             and buf_parts.artic     = buf_price-list.artic
     1490             and buf_parts.prod-type = buf_price-list.prod-type
     1491             and buf_parts.prod-code = buf_price-list.prod-code
     1492         on error undo, return error return-value
     1493         :
     1494           if buf_parts.pay-code = p-cons-pay
     1495           then do:
     1496             assign
     1497               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1498             .
     1499           end.
     1500           else do:
     1501             assign
     1502               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1503             .
     1504           end.
     1505         end.
     1506         if (v-cons-qnty + v-prch-qnty) = 0
     1507         then do:
     1508           assign
     1509             v-cons-mult = 0
     1510             v-prch-mult = 1
     1511           .
     1512         end.
     1513         else do:
     1514           assign
     1515             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1516             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1517           .
     1518         end.
     1519         assign
     1520           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1521           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1522           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1523           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1524           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1525           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1526         .
     1527       end.
     1528     end.
     1529   end procedure.
     1530   procedure prdoclib-calc-ov :
     1531     define input  parameter p-price-list-recid as recid     no-undo .
     1532     define output parameter p-fact-qnty        as decimal   no-undo .
     1533     define output parameter p-ov-base          as decimal   no-undo .
     1534     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1535     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539       define buffer buf_main_price-list    for ub.price-list .
     1540       define buffer buf_prev_price-list    for ub.price-list .
     1541       define buffer buf_special_price-list for ub.price-list .
     1542       define buffer buf_goods              for ub.goods .
     1543       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1544       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1545       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1546       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1547       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1548       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1549       define variable v-prev-price-list-recid as   recid                  no-undo.
     1550       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1551       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1552       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1553       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1554       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1555       find first buf_main_price-list no-lock
     1556         where recid(buf_main_price-list) = p-price-list-recid
     1557         no-error .
     1558       if not available buf_main_price-list
     1559       then do:
     1560         message
     1561           vss-workfile vss-revision vss-description skip
     1562           vss-include-info3 skip
     1563           "Ошибка задания входных параметров" skip
     1564           "Не найдена строка переоценки" skip
     1565           "Код записи (recid)" p-price-list-recid skip
     1566           view-as alert-box error .
     1567         undo, return error .
     1568       end.
     1569       if buf_main_price-list.main-price <> true
     1570       then do:
     1571         message
     1572           vss-workfile vss-revision vss-description skip
     1573           vss-include-info3 skip
     1574           "Ошибка задания входных параметров" skip
     1575           "Строка переоценки не является основной" skip
     1576           "Код записи (recid)" p-price-list-recid skip
     1577           "Переоценка" buf_main_price-list.doc-num skip
     1578           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1579           "Бар-код" buf_main_price-list.b-code skip
     1580           view-as alert-box error .
     1581         undo, return error .
     1582       end.
     1583       run prdoclib-calc-fact-sale in this-procedure
     1584         (input  recid(buf_main_price-list)
     1585         ,output v-fact-qnty
     1586         ,output v-cur-base
     1587         ,output v-cur-VAT-base
     1588         ,output v-cur-SLT-base
     1589         ,output v-cur-road-tax-base
     1590         ,output v-cur-excise-base
     1591         ) no-error.
     1592       if error-status :error
     1593       then do:
     1594         message
     1595           vss-workfile vss-revision vss-description skip
     1596           vss-include-info3 skip
     1597           "Ошибка при расчете сумм переоценки." skip
     1598           "Документ переоценки" buf_main_price-list.doc-num skip
     1599           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1600           error-status :get-message(1) skip
     1601           return-value skip
     1602           view-as alert-box error .
     1603         undo, return error .
     1604       end.
     1605   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1607     (input  buf_main_price-list.obj-type
     1608     ,input  buf_main_price-list.obj-code
     1609     ,input  buf_main_price-list.b-code
     1610     ,input  buf_main_price-list.b-code
     1611     ,input  buf_main_price-list.fact-order
     1612     ,output v-prev-price-list-recid
     1613     ,output v-prev-cli-base-rate
     1614     ) no-error .
     1615       if error-status :error
     1616       then do:
     1617         message
     1618           vss-workfile vss-revision vss-description skip
     1619           vss-include-info3 skip
     1620           "Ошибка при поиске предыдущей переоценки." skip
     1621           "Документ переоценки " buf_main_price-list.doc-num skip
     1622           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1623           error-status :get-message(1) skip
     1624           return-value skip
     1625           view-as alert-box error .
     1626         undo, return error .
     1627       end.
     1628       if v-prev-price-list-recid <> ?
     1629       then do:
     1630         find first buf_prev_price-list no-lock
     1631           where recid(buf_prev_price-list) = v-prev-price-list-recid
     1632           .
     1633         find first buf_special_price-list no-lock
     1634           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     1635             and buf_special_price-list.main-price = false
     1636             and buf_special_price-list.artic      = buf_prev_price-list.artic
     1637             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     1638             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     1639             and buf_special_price-list.doc-qnty   <> ?
     1640           no-error .
     1641         if available buf_special_price-list
     1642         then do:
     1643           message
     1644             "Товар имеет специальные цены на признаки" skip
     1645             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1646             "Переоценка" buf_prev_price-list.doc-num skip
     1647             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1648             view-as alert-box error .
     1649           undo, return error .
     1650         end.
     1651         find first buf_goods no-lock
     1652           where buf_goods.artic     = buf_main_price-list.artic
     1653             and buf_goods.prod-type = buf_main_price-list.prod-type
     1654             and buf_goods.prod-code = buf_main_price-list.prod-code
     1655           no-error .
     1656         if not available buf_goods
     1657         then do:
     1658           message
     1659             vss-workfile vss-revision vss-description skip
     1660             vss-include-info3 skip
     1661             "Не найден товар" skip
     1662             "Переоценка" buf_main_price-list.doc-num skip
     1663             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1664             view-as alert-box error .
     1665           undo, return error .
     1666         end.
     1667         if buf_prev_price-list.vat-pc = ?
     1668         or buf_prev_price-list.slt-pc = ?
     1669         then do:
     1670           message
     1671             "В переоценке не заданы налоги товара" skip
     1672             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1673             "Переоценка" buf_prev_price-list.doc-num skip
     1674             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1675             "НДС" buf_prev_price-list.vat-pc skip
     1676             "НП" buf_prev_price-list.slt-pc skip
     1677             view-as alert-box error .
     1678           undo, return error return-value .
     1679         end.
     1680         define variable v-prev-cur-SLT-pc as decimal no-undo .
     1681         assign
     1682           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     1683         .
     1684         assign
     1685           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     1686           v-prev-cur-VAT-base = v-fact-qnty
     1687                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     1688                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     1689           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     1690         .
     1691         assign
     1692           p-fact-qnty   = v-fact-qnty
     1693           p-ov-base     = v-cur-base     - v-prev-cur-base
     1694           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1695           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1696         .
     1697       end.
     1698       else do:
     1699         assign
     1700           v-prev-cur-base     = 0
     1701           v-prev-cur-VAT-base = 0
     1702           v-prev-cur-SLT-base = 0
     1703           .
     1704         assign
     1705           p-fact-qnty   = v-fact-qnty
     1706           p-ov-base     = v-cur-base     - v-prev-cur-base
     1707           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1708           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1709         .
     1710       end.
     1711     end.
     1712   end procedure.
     1713   procedure prdoclib-init-prt-obj-by-factord :
     1714     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1715     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1716     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1717     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1718     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1719     define input parameter p-fact-order         as decimal   no-undo .
     1720     define input parameter p-include-fact-order as logical   no-undo .
     1721     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     1722     define buffer buf_gds-obj      for ub.gds-obj .
     1723     define buffer buf_doc-line     for ub.doc-line .
     1724     define buffer buf_temp-prt-obj for temp-prt-obj .
     1725     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     1726     do
     1727     on error undo, return error return-value
     1728     :
     1729       do transaction
     1730       on error undo, return error return-value
     1731       :
     1732   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1733   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1734     (input  p-obj-type
     1735     ,input  p-obj-code
     1736     ,input  p-artic
     1737     ,input  p-prod-type
     1738     ,input  p-prod-code
     1739     ,buffer buf_gds-obj
     1740     ) no-error .
     1741         if error-status :error
     1742         then do:
     1743           message
     1744             vss-workfile vss-revision vss-description skip
     1745             vss-include-info3 skip
     1746             "Невозможно найти gds-obj" skip
     1747             error-status :get-message(1) skip
     1748             return-value skip
     1749             view-as alert-box error .
     1750           undo, return error .
     1751         end.
     1752         find current buf_gds-obj exclusive-lock .
     1753       end.
     1754       run prdoclib-init-temp-prt-obj in this-procedure
     1755         (input p-obj-type
     1756         ,input p-obj-code
     1757         ,input p-artic
     1758         ,input p-prod-type
     1759         ,input p-prod-code
     1760         ,input 0
     1761         ) .
     1762       for each buf_temp-prt-obj
     1763         where buf_temp-prt-obj.is-term <> true
     1764       on error undo, return error return-value
     1765       :
     1766         delete buf_temp-prt-obj .
     1767       end.
     1768       if p-include-fact-order = true
     1769       then do:
     1770         assign
     1771          p-fact-order = p-fact-order - 0.0000000001
     1772         .
     1773       end.
     1774       for each buf_doc-line no-lock
     1775         where buf_doc-line.obj-type   = p-obj-type
     1776           and buf_doc-line.obj-code   = p-obj-code
     1777           and buf_doc-line.artic      = p-artic
     1778           and buf_doc-line.prod-type  = p-prod-type
     1779           and buf_doc-line.prod-code  = p-prod-code
     1780           and buf_doc-line.status_    = 'факт':U
     1781           and buf_doc-line.fact-order >= p-fact-order
     1782       on error undo, return error return-value
     1783       :
     1784         run prdoclib-process-document in this-procedure
     1785           (input  buf_doc-line.doc-code
     1786           ,input  p-obj-type
     1787           ,input  p-obj-code
     1788           ,input  p-artic
     1789           ,input  p-prod-type
     1790           ,input  p-prod-code
     1791           ,output v-total-gds-dtl-qnty
     1792           ) .
     1793       end.
     1794     end.
     1795   end procedure.
     1796   procedure prdoclib-process-document :
     1797     define input  parameter p-doc-code           as character no-undo .
     1798     define input  parameter p-obj-type           as character no-undo .
     1799     define input  parameter p-obj-code           as integer   no-undo .
     1800     define input  parameter p-artic              as character no-undo .
     1801     define input  parameter p-prod-type          as character no-undo .
     1802     define input  parameter p-prod-code          as integer   no-undo .
     1803     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     1804     define buffer buf_trn-doc      for ub.trn-doc .
     1805     define buffer buf_gds-dtl      for ub.gds-dtl .
     1806     define buffer buf_temp-prt-obj for temp-prt-obj .
     1807     do
     1808     on error undo, return error return-value
     1809     :
     1810       find first buf_trn-doc no-lock
     1811         where buf_trn-doc.doc-code = p-doc-code
     1812         no-error .
     1813       if not available buf_trn-doc then do:
     1814         message
     1815           vss-workfile vss-revision vss-description skip
     1816           vss-include-info3 skip
     1817           "Ошибка при поиске документа" skip
     1818           "Документ" p-doc-code skip
     1819           "Объект" p-obj-type p-obj-code skip
     1820           "Артикул" p-artic p-prod-type p-prod-code skip
     1821           view-as alert-box error .
     1822         undo, return error .
     1823       end.
     1824       assign
     1825         p-total-gds-dtl-qnty = 0
     1826       .
     1827       for each buf_gds-dtl no-lock
     1828         where buf_gds-dtl.doc-code  = p-doc-code
     1829           and buf_gds-dtl.artic     = p-artic
     1830           and buf_gds-dtl.prod-type = p-prod-type
     1831           and buf_gds-dtl.prod-code = p-prod-code
     1832       on error undo, return error
     1833       :
     1834         define variable v-term-node as integer   no-undo .
     1835   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     1836     (input  buf_gds-dtl.prt-code
     1837     ,output v-term-node
     1838     )  .
     1839         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     1840           (input  v-term-node
     1841           ,buffer buf_temp-prt-obj
     1842           ) .
     1843         if buf_temp-prt-obj.is-term <> true then do:
     1844           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     1845                                        ,buf_gds-dtl.prt-code
     1846                                        ) .
     1847         end.
     1848         case buf_trn-doc.doc-type :
     1849           when 'при':U or
     1850           when 'возврат':U
     1851           then do:
     1852             assign
     1853               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1854                                           - buf_gds-dtl.fact-qnty
     1855               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1856                                           - buf_gds-dtl.fact-qnty
     1857             .
     1858           end.
     1859           when 'рас':U or
     1860           when 'спи':U
     1861           then do:
     1862             assign
     1863               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1864                                           + buf_gds-dtl.fact-qnty
     1865               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1866                                           + buf_gds-dtl.fact-qnty
     1867             .
     1868           end.
     1869           when 'инв':U
     1870           then do:
     1871             assign
     1872               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     1873                                           - buf_gds-dtl.doc-qnty
     1874               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     1875                                           - buf_gds-dtl.doc-qnty
     1876             .
     1877           end.
     1878           otherwise do:
     1879             undo, return error substitute("Неизвестный тип документа &1"
     1880                                          ,buf_trn-doc.doc-type
     1881                                          ) .
     1882           end.
     1883         end.
     1884       end.
     1885     end.
     1886   end procedure.
     1887   procedure prdoclib-prc-pl-document :
     1888     define input  parameter p-doc-code              as character no-undo .
     1889     define input  parameter p-obj-type              as character no-undo .
     1890     define input  parameter p-obj-code              as integer   no-undo .
     1891     define input  parameter p-gds-code              as integer   no-undo .
     1892     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     1893     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     1894     do
     1895     on error undo, return error return-value
     1896     :
     1897       define buffer buf_trn-doc      for ub.trn-doc .
     1898       define buffer buf_doc-pl       for ub.doc-pl .
     1899       define buffer buf_temp-pl-gds for temp-pl-gds .
     1900       define variable v-sign as decimal   no-undo .
     1901       find first buf_trn-doc no-lock
     1902         where buf_trn-doc.doc-code = p-doc-code
     1903         no-error .
     1904       if not available buf_trn-doc then do:
     1905         message
     1906           vss-workfile vss-revision vss-description skip
     1907           vss-include-info3 skip
     1908           "Ошибка при поиске документа" skip
     1909           "Документ" p-doc-code skip
     1910           "Объект" p-obj-type p-obj-code skip
     1911           "Товар" p-gds-code skip
     1912           view-as alert-box error .
     1913         undo, return error .
     1914       end.
     1915       assign
     1916         p-total-pl-gds-qnty     = 0
     1917         p-total-pl-gds-cli-qnty = 0
     1918       .
     1919       for each buf_doc-pl no-lock
     1920         where buf_doc-pl.out-code  = p-doc-code
     1921           and buf_doc-pl.gds-code  = p-gds-code
     1922       on error undo, return error return-value
     1923       :
     1924         find first buf_temp-pl-gds
     1925           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     1926             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     1927             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     1928           .
     1929         case buf_trn-doc.doc-type :
     1930           when 'при':U
     1931           or when 'возврат':U
     1932           or when 'инв':U
     1933           then do:
     1934             assign
     1935               v-sign = -1.0
     1936             .
     1937           end.
     1938           when 'рас':U or
     1939           when 'спи':U
     1940           then do:
     1941             assign
     1942               v-sign = 1.0
     1943             .
     1944           end.
     1945           otherwise do:
     1946             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     1947           end.
     1948         end case.
     1949         assign
     1950           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     1951           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     1952           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     1953           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     1954         .
     1955       end.
     1956     end.
     1957   end procedure.
     1958   procedure prdoclib-init-prt-obj-by-date :
     1959     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     1960     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     1961     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     1962     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     1963     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     1964     define input parameter p-fact-date  as date      no-undo .
     1965     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     1966     do
     1967     on error undo, return error return-value
     1968     :
     1969       define variable v-fact-order                as decimal   no-undo .
     1970       define variable v-shift-end-fact-order      as decimal   no-undo .
     1971       define variable v-day-end-fact-order        as decimal   no-undo .
     1972       run factord in this-procedure
     1973         (input  p-fact-date
     1974         ,input  1
     1975         ,input  1
     1976         ,input  ?
     1977         ,input  0
     1978         ,input  false
     1979         ,output v-fact-order
     1980         ,output v-shift-end-fact-order
     1981         ,output v-day-end-fact-order
     1982         ) no-error .
     1983       if error-status :error
     1984       then do:
     1985         message
     1986           vss-workfile vss-revision vss-description skip
     1987           vss-include-info3 skip
     1988           "Ошибка при определении момента времени, на который требуется остаток" skip
     1989           "Объект" p-obj-type p-obj-code skip
     1990           "Артикул" p-artic p-prod-type p-prod-code skip
     1991           "Дата" p-fact-date skip
     1992           view-as alert-box error .
     1993         undo, return error .
     1994       end.
     1995       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     1996         (input p-obj-type
     1997         ,input p-obj-code
     1998         ,input p-artic
     1999         ,input p-prod-type
     2000         ,input p-prod-code
     2001         ,input v-day-end-fact-order
     2002         ,input false
     2003         ) no-error .
     2004       if error-status :error
     2005       then do:
     2006         message
     2007           vss-workfile vss-revision vss-description skip
     2008           vss-include-info3 skip
     2009           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2010           "Объект" p-obj-type p-obj-code skip
     2011           "Артикул" p-artic p-prod-type p-prod-code skip
     2012           "Дата" p-fact-date skip
     2013           view-as alert-box error .
     2014         undo, return error .
     2015       end.
     2016     end.
     2017   end procedure.
     2018   procedure prdoclib-calc-temp-fact-sale :
     2019     define input  parameter p-obj-type           as character no-undo .
     2020     define input  parameter p-obj-code           as integer   no-undo .
     2021     define input  parameter p-gds-code           as integer   no-undo .
     2022     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2023     define input  parameter p-curr-r-b           as character no-undo .
     2024     define output parameter p-fact-qnty          as decimal   no-undo .
     2025     define output parameter p-cur-base           as decimal   no-undo .
     2026     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2027     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2028     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2029     define output parameter p-cur-excise-base    as decimal   no-undo .
     2030     define buffer buf_temp-prt-obj for temp-prt-obj .
     2031     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2032     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2033     define variable parrecid-prl        as recid     no-undo .
     2034     define variable v-fact-qnty         as decimal   no-undo .
     2035     define variable v-cur-base          as decimal   no-undo .
     2036     define variable v-cur-VAT-base      as decimal   no-undo .
     2037     define variable v-cur-SLT-base      as decimal   no-undo .
     2038     define variable v-cur-road-tax-base as decimal   no-undo .
     2039     define variable v-cur-excise-base   as decimal   no-undo .
     2040     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2041     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2042     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2043     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2044     define variable vat-base-sale-prl               as decimal   no-undo .
     2045     define variable vat-rubl-sale-prl               as decimal   no-undo .
     2046     define variable vat-base-buyer-prl              as decimal   no-undo .
     2047     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2048     define variable slt-base-sale-prl               as decimal   no-undo .
     2049     define variable slt-rubl-sale-prl               as decimal   no-undo .
     2050     define variable road-tax-base-sale-prl          as decimal   no-undo .
     2051     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2052     define variable excise-base-sale-prl            as decimal   no-undo .
     2053     define variable excise-rubl-sale-prl            as decimal   no-undo .
     2054     define variable discnt-base-sale-prl            as decimal   no-undo .
     2055     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2056     do
     2057     on error undo, return error return-value
     2058     :
     2059       for each buf_temp-prt-obj no-lock
     2060       on error undo, return error return-value
     2061       :
     2062   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2063     (input  p-gds-code
     2064     ,input  buf_temp-prt-obj.prt-code
     2065     ,output v-prt-b-code
     2066     ) no-error .
     2067         if error-status :error
     2068         then do:
     2069           message
     2070             vss-workfile vss-revision vss-description skip
     2071             "Ошибка при определении бар-кода признака" skip
     2072             "Код товара"   p-gds-code skip
     2073             "Код признака" buf_temp-prt-obj.prt-code skip
     2074             error-status :get-message(1) skip
     2075             return-value skip
     2076             view-as alert-box error .
     2077           undo, return error .
     2078         end.
     2079   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2080   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2081     (input  p-obj-type
     2082     ,input  p-obj-code
     2083     ,input  v-prt-b-code
     2084     ,input  0
     2085     ,input  p-day-end-fact-order
     2086     ,output parrecid-prl
     2087     ,output v-cli-base-rate
     2088     ) no-error .
     2089         if error-status :error
     2090         then do:
     2091           message
     2092             vss-workfile vss-revision vss-description skip
     2093             "Ошибка при определении цены бар-кода" skip
     2094             "Объект" p-obj-type p-obj-code skip
     2095             "Бар-код" v-prt-b-code skip
     2096             "fact-order" p-day-end-fact-order skip
     2097             error-status :get-message(1) skip
     2098             return-value skip
     2099             view-as alert-box error .
     2100           undo, return error .
     2101         end.
     2102         if parrecid-prl <> ?
     2103         then do:
     2104           run prl-vat in this-procedure
     2105             (input  parrecid-prl
     2106             ,output price-rubl-with-tax-sale-prl
     2107             ,output price-base-with-tax-sale-prl
     2108             ,output price-rubl-without-tax-sale-prl
     2109             ,output price-base-without-tax-sale-prl
     2110             ,output vat-base-sale-prl
     2111             ,output vat-rubl-sale-prl
     2112             ,output vat-base-buyer-prl
     2113             ,output vat-rubl-buyer-prl
     2114             ,output slt-base-sale-prl
     2115             ,output slt-rubl-sale-prl
     2116             ,output road-tax-base-sale-prl
     2117             ,output road-tax-rubl-sale-prl
     2118             ,output excise-base-sale-prl
     2119             ,output excise-rubl-sale-prl
     2120             ,output discnt-base-sale-prl
     2121             ,output discnt-rubl-sale-prl
     2122             ) no-error .
     2123           if error-status :error
     2124           then do:
     2125             message
     2126               vss-workfile vss-revision vss-description skip
     2127               "Ошибка при вызове процеды prl-vat" skip
     2128               "Объект" p-obj-type p-obj-code skip
     2129               "Код товара" p-gds-code skip
     2130               "Указатель на запись переоценки" parrecid-prl skip
     2131               error-status :get-message(1) skip
     2132               return-value skip
     2133               view-as alert-box error .
     2134             undo, return error .
     2135           end.
     2136         end.
     2137         else do:
     2138           assign
     2139             price-rubl-with-tax-sale-prl    = 0
     2140             price-base-with-tax-sale-prl    = 0
     2141             price-rubl-without-tax-sale-prl = 0
     2142             price-base-without-tax-sale-prl = 0
     2143             vat-base-sale-prl               = 0
     2144             vat-rubl-sale-prl               = 0
     2145             slt-base-sale-prl               = 0
     2146             slt-rubl-sale-prl               = 0
     2147             road-tax-base-sale-prl          = 0
     2148             road-tax-rubl-sale-prl          = 0
     2149             excise-base-sale-prl            = 0
     2150             excise-rubl-sale-prl            = 0
     2151             discnt-base-sale-prl            = 0
     2152             discnt-rubl-sale-prl            = 0
     2153           .
     2154         end.
     2155         assign
     2156           v-fact-qnty         = v-fact-qnty
     2157                               + buf_temp-prt-obj.fact-qnty
     2158           v-cur-base          = v-cur-base
     2159                               + (if p-curr-r-b = 'base':U
     2160                                   then price-base-with-tax-sale-prl
     2161                                   else price-rubl-with-tax-sale-prl
     2162                                 )
     2163                               * buf_temp-prt-obj.fact-qnty
     2164           v-cur-VAT-base      = v-cur-VAT-base
     2165                               + (if p-curr-r-b = 'base':U
     2166                                   then vat-base-sale-prl
     2167                                   else vat-rubl-sale-prl
     2168                                 )
     2169                               * buf_temp-prt-obj.fact-qnty
     2170           v-cur-SLT-base      = v-cur-SLT-base
     2171                               + (if p-curr-r-b = 'base':U
     2172                                   then slt-base-sale-prl
     2173                                   else slt-rubl-sale-prl
     2174                                 )
     2175                               * buf_temp-prt-obj.fact-qnty
     2176           v-cur-road-tax-base = v-cur-road-tax-base
     2177                               + (if p-curr-r-b = 'base':U
     2178                                   then road-tax-base-sale-prl
     2179                                   else road-tax-rubl-sale-prl
     2180                                 )
     2181                               * buf_temp-prt-obj.fact-qnty
     2182           v-cur-excise-base   = v-cur-excise-base
     2183                               + (if p-curr-r-b = 'base':U
     2184                                   then excise-base-sale-prl
     2185                                   else excise-rubl-sale-prl
     2186                                 )
     2187                               * buf_temp-prt-obj.fact-qnty
     2188         .
     2189       end.
     2190       assign
     2191         p-fact-qnty         = v-fact-qnty
     2192         p-cur-base          = v-cur-base
     2193         p-cur-VAT-base      = v-cur-VAT-base
     2194         p-cur-SLT-base      = v-cur-SLT-base
     2195         p-cur-road-tax-base = v-cur-road-tax-base
     2196         p-cur-excise-base   = v-cur-excise-base
     2197       .
     2198     end.
     2199   end procedure.
     2200   procedure prdoclib-clear-temp-pl-gds :
     2201     define buffer buf_temp-pl-gds for temp-pl-gds .
     2202     do
     2203     on error undo, return error return-value
     2204     :
     2205       for each buf_temp-pl-gds
     2206       on error undo, return error return-value
     2207       :
     2208         delete buf_temp-pl-gds .
     2209       end.
     2210     end.
     2211   end procedure.
     2212   procedure prdoclib-init-temp-pl-gds :
     2213     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     2214     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     2215     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     2216     define buffer buf_pl-gds      for ub.pl-gds .
     2217     define buffer buf_temp-pl-gds for temp-pl-gds .
     2218     do
     2219     on error undo, return error return-value
     2220     :
     2221       run prdoclib-clear-temp-pl-gds in this-procedure .
     2222       for each buf_pl-gds
     2223         where buf_pl-gds.obj-type = p-obj-type
     2224           and buf_pl-gds.obj-code = p-obj-code
     2225           and buf_pl-gds.gds-code = p-gds-code
     2226       on error undo, return error return-value
     2227       :
     2228         create buf_temp-pl-gds .
     2229         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     2230       end.
     2231     end.
     2232   end procedure.
     2233   procedure prdoclib-init-pl-gds-by-factord :
     2234     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2235     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2236     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2237     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2238     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2239     define input parameter p-fact-order         as decimal   no-undo .
     2240     define input parameter p-include-fact-order as logical   no-undo .
     2241     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     2242     define buffer buf_goods       for ub.goods .
     2243     define buffer buf_gds-obj     for ub.gds-obj .
     2244     define buffer buf_doc-line    for ub.doc-line .
     2245     define buffer buf_temp-pl-gds for temp-pl-gds .
     2246     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     2247     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     2248     do
     2249     on error undo, return error return-value
     2250     :
     2251       do transaction
     2252       on error undo, return error return-value
     2253       :
     2254   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2255   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2256     (input  p-obj-type
     2257     ,input  p-obj-code
     2258     ,input  p-artic
     2259     ,input  p-prod-type
     2260     ,input  p-prod-code
     2261     ,buffer buf_gds-obj
     2262     ) no-error .
     2263         if error-status :error
     2264         then do:
     2265           message
     2266             vss-workfile vss-revision vss-description skip
     2267             vss-include-info3 skip
     2268             "Невозможно найти gds-obj" skip
     2269             error-status :get-message(1) skip
     2270             return-value skip
     2271             view-as alert-box error .
     2272           undo, return error return-value .
     2273         end.
     2274         find current buf_gds-obj exclusive-lock .
     2275       end.
     2276       find first buf_goods no-lock
     2277         where buf_goods.artic     = p-artic
     2278           and buf_goods.prod-type = p-prod-type
     2279           and buf_goods.prod-code = p-prod-code
     2280         .
     2281       run prdoclib-init-temp-pl-gds in this-procedure
     2282         (input p-obj-type
     2283         ,input p-obj-code
     2284         ,input buf_goods.gds-code
     2285         ) .
     2286       if p-include-fact-order = true
     2287       then do:
     2288         assign
     2289          p-fact-order = p-fact-order - 0.0000000001
     2290         .
     2291       end.
     2292       for each buf_doc-line no-lock
     2293         where buf_doc-line.obj-type   = p-obj-type
     2294           and buf_doc-line.obj-code   = p-obj-code
     2295           and buf_doc-line.artic      = p-artic
     2296           and buf_doc-line.prod-type  = p-prod-type
     2297           and buf_doc-line.prod-code  = p-prod-code
     2298           and buf_doc-line.status_    = 'факт':U
     2299           and buf_doc-line.fact-order >= p-fact-order
     2300       on error undo, return error return-value
     2301       :
     2302         run prdoclib-prc-pl-document in this-procedure
     2303           ( input  buf_doc-line.doc-code
     2304            ,input  p-obj-type
     2305            ,input  p-obj-code
     2306            ,input  buf_goods.gds-code
     2307            ,output v-total-pl-gds-qnty
     2308            ,output v-total-pl-gds-cli-qnty
     2309           ) .
     2310       end.
     2311     end.
     2312   end procedure.
     2313   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2314   procedure cur-time :
     2315      define output parameter p-today as date      no-undo .
     2316      define output parameter p-time  as integer   no-undo .
     2317     do
     2318     on error undo, return error
     2319     :
     2320       define variable v-date1 as date      no-undo .
     2321       define variable v-date2 as date      no-undo .
     2322       define variable v-time  as integer   no-undo .
     2323       assign
     2324         v-date1 = today
     2325         v-time  = time
     2326         v-date2 = today
     2327       .
     2328       if v-date1 <> v-date2
     2329       then do:
     2330         assign
     2331           v-date1 = today
     2332           v-time  = v-time
     2333         .
     2334       end.
     2335       assign
     2336         p-today = v-date1
     2337         p-time  = v-time
     2338       .
     2339     end.
     2340   end.
     2341   function cur-time-date returns character
     2342   :
     2343     return string(today, '99/99/9999':U) .
     2344   end.
     2345   function cur-time-mjd returns decimal
     2346   :
     2347     define variable v-date as date      no-undo .
     2348     define variable v-time as integer   no-undo .
     2349     run cur-time in this-procedure
     2350       (output v-date
     2351       ,output v-time
     2352       ) .
     2353     return integer(v-date) - 2400002 + (v-time / 86400) .
     2354   end.
     2355   function cur-time-get-ending-index returns integer
     2356   (input p-number as integer
     2357   )
     2358   :
     2359     if p-number < 0
     2360     or p-number = ?
     2361     then do:
     2362       return 1 .
     2363     end.
     2364     define variable v-rest as integer   no-undo .
     2365     assign
     2366       p-number = p-number modulo 100
     2367     .
     2368     if p-number < 20
     2369     then do:
     2370       assign
     2371         v-rest = p-number
     2372       .
     2373     end.
     2374     else do:
     2375       assign
     2376         v-rest = p-number modulo 10
     2377       .
     2378     end.
     2379     case v-rest :
     2380       when 1
     2381       then do:
     2382         return 2 .
     2383       end.
     2384       when 2 or
     2385       when 3 or
     2386       when 4
     2387       then do:
     2388         return 3 .
     2389       end.
     2390       otherwise do:
     2391         return 1 .
     2392       end.
     2393     end case .
     2394   end.
     2395   procedure cur-time-mjd-to-date :
     2396      define input  parameter i-mjd-diff as decimal no-undo.
     2397      define output parameter o-Date     as date    no-undo.
     2398      define output parameter o-Time     as integer no-undo.
     2399      define variable v-day-number as integer   no-undo .
     2400      if    i-mjd-diff < 0
     2401         or i-mjd-diff = ?
     2402      then do:
     2403         return "?" .
     2404      end.
     2405      assign
     2406         v-day-number = truncate(i-mjd-diff,0).
     2407         o-Date = date(v-day-number + 2400002).
     2408         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     2409     .
     2410   end.
     2411   function cur-time-mjd-to-string returns character
     2412   (input p-mjd-diff as decimal
     2413   )
     2414   :
     2415     define variable v-day-number as integer   no-undo .
     2416     define variable v-seconds    as integer   no-undo .
     2417     define variable v-hour       as integer   no-undo .
     2418     define variable v-min        as integer   no-undo .
     2419     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     2420     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     2421     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     2422     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     2423     if p-mjd-diff < 0
     2424     or p-mjd-diff = ?
     2425     then do:
     2426       return "?" .
     2427     end.
     2428     assign
     2429       v-day-number = integer(truncate(p-mjd-diff,0))
     2430       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     2431     .
     2432     if v-seconds > 86400
     2433     then do:
     2434       assign
     2435         v-seconds = 86400 - 1
     2436       .
     2437     end.
     2438     if v-seconds < 0
     2439     then do:
     2440       assign
     2441         v-seconds = 0
     2442       .
     2443     end.
     2444     assign
     2445       v-hour = truncate(v-seconds / 3600, 0)
     2446     .
     2447     assign
     2448       v-seconds = v-seconds modulo 3600
     2449     .
     2450     assign
     2451       v-min = truncate(v-seconds / 60, 0)
     2452     .
     2453     assign
     2454       v-seconds = v-seconds modulo 60
     2455     .
     2456     return
     2457         (if v-day-number <> 0
     2458           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     2459           else ""
     2460         )
     2461       + (if v-day-number <> 0 or v-hour <> 0
     2462           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     2463           else ""
     2464         )
     2465       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2466           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2467           else ""
     2468         )
     2469       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2470       .
     2471   end.
     2472   function cur-time-string returns character
     2473   :
     2474     define variable v-date as date      no-undo .
     2475     define variable v-time as integer   no-undo .
     2476     run cur-time in this-procedure
     2477       (output v-date
     2478       ,output v-time
     2479       ) .
     2480     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2481   end.
     2482   function cur-time-string-sec returns character
     2483   :
     2484     define variable v-date as date      no-undo .
     2485     define variable v-time as integer   no-undo .
     2486     run cur-time in this-procedure
     2487       (output v-date
     2488       ,output v-time
     2489       ) .
     2490     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2491   end.
     2492   function cur-time-custom  returns character
     2493   (input p-prefix as character
     2494   ,input p-date-format as character
     2495   ,input p-delimiter as character
     2496   ,input p-time-format as character
     2497   ,input p-suffix as character
     2498   )
     2499   :
     2500     define variable v-date as date      no-undo .
     2501     define variable v-time as integer   no-undo .
     2502     run cur-time in this-procedure
     2503       (output v-date
     2504       ,output v-time
     2505       ) .
     2506     return
     2507       p-prefix
     2508       + string(v-date, p-date-format)
     2509       + p-delimiter
     2510       + string(v-time, p-time-format)
     2511       + p-suffix
     2512       .
     2513   end.
     2514   function cur-time-print  returns character
     2515   :
     2516     define variable v-date as date      no-undo .
     2517     define variable v-time as integer   no-undo .
     2518     run cur-time in this-procedure
     2519       (output v-date
     2520       ,output v-time
     2521       ) .
     2522     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2523   end.
     2524   function cur-time-datetime returns datetime
     2525   :
     2526     define variable v-char as character no-undo .
     2527     define variable v-datetime as datetime no-undo .
     2528     v-char = cur-time-string().
     2529     v-datetime = datetime(v-char).
     2530     return  v-datetime.
     2531   end.
     2532   function cur-time-string-msec returns character
     2533   :
     2534     define variable v-date as datetime  no-undo .
     2535     v-date = now.
     2536     return string(v-date) .
     2537   end.
