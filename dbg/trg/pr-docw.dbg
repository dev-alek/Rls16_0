     2990           "Ошибка при записи истории изменений переоценки" skip
     2991           error-status :get-message(1) skip
     2992           return-value skip
     2993           view-as alert-box error .
     2994         undo main-block, return error .
     2995       end.
     2996     end.
     2997       if g#oxml = yes
     2998       then do:
     2999       run str/calloxml.p (
     3000             input 'update':U
     3001           , input 'price-doc':U
     3002           , input ( buffer ub.price-doc:handle )
     3003       ) no-error.
     3004       if error-status :error
     3005       then do:
