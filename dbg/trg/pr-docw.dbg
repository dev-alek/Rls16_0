     3820   procedure copy-parts :
     3821     define input parameter  p-out-code         like ub.parts.out-code  no-undo .
     3822     define input parameter  p-obj-type         like ub.parts.obj-type  no-undo .
     3823     define input parameter  p-obj-code         like ub.parts.obj-code  no-undo .
     3824     define input parameter  p-artic            like ub.parts.artic     no-undo .
     3825     define input parameter  p-prod-type        like ub.parts.prod-type no-undo .
     3826     define input parameter  p-prod-code        like ub.parts.prod-code no-undo .
     3827     define output parameter p-total-parts-qnty like ub.parts.qnty      no-undo .
     3828     def buffer buf_parts for ub.parts .
     3829     do
     3830     on error undo, return error
     3831     :
     3832       assign
     3833         p-total-parts-qnty = 0
     3834       .
     3835       for each ub.parts
     3836         where ub.parts.obj-type  = p-obj-type
     3837           and ub.parts.obj-code  = p-obj-code
     3838           and ub.parts.artic     = p-artic
     3839           and ub.parts.prod-type = p-prod-type
     3840           and ub.parts.prod-code = p-prod-code
     3841           and ub.parts.rsrv-free = yes
     3842           and ub.parts.status_   = no
     3843           and ub.parts.in-code   <> ub.parts.out-code
     3844       on error undo, return error
     3845       :
     3846         run partcopy_pr-docw in this-procedure
     3847           (input  p-out-code
     3848           ,buffer ub.parts
     3849           ,buffer buf_parts
     3850           ) no-error .
     3851         if error-status :error then do:
     3852           message
     3853             vss-workfile vss-revision vss-description skip
     3854             "Ошибка при создании партии" skip
     3855             "Объект" ub.parts.obj-type ub.parts.obj-code skip
     3856             "Артикул" ub.parts.artic ub.parts.prod-type ub.parts.prod-code skip
     3857             "Партия" ub.parts.in-code ub.parts.part-code skip
     3858             "Резерв" p-out-code skip
     3859             error-status :get-message(1) skip
     3860             return-value skip
     3861             view-as alert-box error .
     3862           undo, return error .
     3863         end.
     3864         define variable v-parts-qnty     like ub.parts.qnty no-undo .
     3865         define variable v-parts-cli-qnty like ub.parts.cli-qnty no-undo .
     3866         if ub.parts.out-code = 'free-zone':U then do:
     3867           assign
     3868             v-parts-qnty     = ub.parts.qnty
     3869             v-parts-cli-qnty = ub.parts.cli-qnty
     3870           .
     3871         end.
     3872         else do:
     3873           assign
     3874             v-parts-qnty     = abs(ub.parts.qnty)
     3875             v-parts-cli-qnty = abs(ub.parts.cli-qnty)
     3876           .
     3877         end.
     3878         assign
     3879           buf_parts.qnty      = buf_parts.qnty     + v-parts-qnty
     3880           buf_parts.fact-qnty = buf_parts.qnty
     3881           buf_parts.cli-qnty  = buf_parts.cli-qnty + v-parts-cli-qnty
     3882         .
     3883         assign
     3884           p-total-parts-qnty  = p-total-parts-qnty + v-parts-qnty
     3885         .
     3886       end.
     3887     end.
     3888   end procedure.
     3889   procedure show-action :
     3890     do
     3891     on error undo, return error
     3892     :
     3893       define input parameter p-action as character no-undo .
     3894       define variable v-today as date      no-undo.
     3895       define variable v-time  as integer   no-undo.
     3896       run cur-time in this-procedure ( output v-today
     3897                                      , output v-time
     3898                                      ).
     3899       assign
     3900         current-time = string(v-time - start-time, "HH:MM:SS")
     3901         current-action = p-action
     3902       .
     3903       display
     3904         current-time current-action
     3905         with frame a.
     3906       process events .
     3907     end.
     3908   end procedure.
     3909   procedure partcopy_pr-docw :
     3910     define input parameter  p-out-code         like ub.parts.out-code no-undo .
     3911     define parameter buffer buf_orig_parts     for ub.parts .
     3912     define parameter buffer buf_parts          for ub.parts .
     3913     do transaction
     3914     on error undo, return error
     3915     :
     3916       find first buf_parts exclusive-lock
     3917         where buf_parts.obj-type  = buf_orig_parts.obj-type
     3918           and buf_parts.obj-code  = buf_orig_parts.obj-code
     3919           and buf_parts.artic     = buf_orig_parts.artic
     3920           and buf_parts.prod-type = buf_orig_parts.prod-type
     3921           and buf_parts.prod-code = buf_orig_parts.prod-code
     3922           and buf_parts.in-code   = buf_orig_parts.in-code
     3923           and buf_parts.out-code  = p-out-code
     3924           and buf_parts.part-code = buf_orig_parts.part-code
     3925         no-error.
     3926       if not available buf_parts then do:
     3927         create buf_parts .
     3928         buffer-copy buf_orig_parts to buf_parts
     3929         assign
     3930           buf_parts.out-code  = p-out-code
     3931           buf_parts.status_   = yes
     3932           buf_parts.rsrv-free = ?
     3933           buf_parts.doc-type  = 'акт':U
     3934           buf_parts.PS        = 'архив переоценки ' + p-out-code
     3935           buf_parts.qnty      = 0
     3936           buf_parts.fact-qnty = 0
     3937           buf_parts.real-qnty = 0
     3938           buf_parts.cli-qnty  = 0
     3939         .
     3940         validate buf_parts .
     3941       end.
     3942       else do:
     3943         if buf_parts.status_   <> yes
     3944         or buf_parts.rsrv-free <> ?
     3945         or buf_parts.doc-type  <> 'акт':U
     3946         or buf_parts.PS        <> 'архив переоценки ' + p-out-code then do:
     3947           message
     3948             vss-workfile vss-revision vss-description skip
     3949             "Ошибка при поиске архивной партии, привязанной к переоценке" skip
     3950             "Переоценка" p-out-code skip
     3951             "Артикул" buf_parts.artic buf_parts.prod-type buf_parts.prod-code skip
     3952             "status_" buf_parts.status_ skip
     3953             "rsrv-free" buf_parts.rsrv-free skip
     3954             "doc-type" buf_parts.doc-type skip
     3955             "PS" buf_parts.PS skip
     3956             view-as alert-box error .
     3957           undo, return error .
     3958         end.
     3959       end.
     3960     end.
     3961   end procedure.
