     3022       run trg/lockprdc.p
     3023         (input ub.price-doc.doc-num
     3024         ) no-error.
     3025       if error-status :error then do:
     3026         message
     3027           vss-workfile vss-revision vss-description skip
     3028           "Не удается заблокировать товары для переоценки" skip
     3029           "Переоценка" ub.price-doc.doc-num skip
     3030           error-status :get-message(1) skip
     3031           return-value skip
     3032           view-as alert-box error .
     3033         undo, return error .
     3034       end.
     3035       if g#news then do:
     3036         if ub.price-doc.fact-num = ?
     3037         or ub.price-doc.fact-num = 0 then do:
     3038           message
     3039             vss-workfile vss-revision vss-description skip
     3040             "Не задан фактический номер переоценки" skip
     3041             "Документ переоценки" ub.price-doc.doc-num skip
     3042             "fact-num" ub.price-doc.fact-num skip
     3043             view-as alert-box error .
     3044           undo, return error .
     3045         end.
     3046         if ub.price-doc.fact-order = ?
     3047         or ub.price-doc.fact-order = 0 then do:
     3048           message
     3049             vss-workfile vss-revision vss-description skip
     3050             "Не задан фактический номер переоценки" skip
     3051             "Документ переоценки" ub.price-doc.doc-num skip
     3052             "fact-order" ub.price-doc.fact-order skip
     3053             view-as alert-box error .
     3054           undo, return error .
     3055         end.
     3056       end.
     3057       if not g#news then do:
     3058         run gbl/chk-date.p
     3059           (input ub.price-doc.obj-type
     3060           ,input ub.price-doc.obj-code
     3061           ,input ub.price-doc.fact-date
     3062           ,input ub.price-doc.fact-time
     3063           ,input ub.price-doc.shift-date
     3064           ,input ub.price-doc.shift-num
     3065           ,input yes
     3066           ) no-error.
     3067         if error-status :error then do:
     3068           message
     3069             vss-workfile vss-revision vss-description skip
     3070             "Ошибка при установке дат, времен, смен в переоценке(price-doc)." skip
     3071             "fact-num" ub.price-doc.fact-num skip
     3072             "fact-date" ub.price-doc.fact-date skip
     3073             "fact-time" ub.price-doc.fact-time skip
     3074             "shift-date" ub.price-doc.shift-date skip
     3075             "shift-num" ub.price-doc.shift-num skip
     3076             error-status :get-message(1) skip
     3077             return-value skip
     3078             view-as alert-box error .
     3079           undo, return error .
     3080         end.
     3081       end.
     3082       if not g#news then do:
     3083         if ub.price-doc.fact-num > 0 then do:
     3084           message
     3085             vss-workfile vss-revision vss-description skip
     3086             "Ошибочно задан фактический номер переоценки" skip
     3087             "Документ переоценки" ub.price-doc.doc-num skip
     3088             "fact-num" ub.price-doc.fact-num skip
     3089             view-as alert-box error .
     3090           undo, return error .
     3091         end.
     3092         if ub.price-doc.fact-order > 0 then do:
     3093           message
     3094             vss-workfile vss-revision vss-description skip
     3095             "Ошибочно задан фактический номер переоценки" skip
     3096             "Документ переоценки" ub.price-doc.doc-num skip
     3097             "fact-order" ub.price-doc.fact-order skip
     3098             view-as alert-box error .
     3099           undo, return error .
     3100         end.
     3101         assign
     3102           ub.price-doc.fact-num = next-value (s-trn-fact, ub)
     3103         .
