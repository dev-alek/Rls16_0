     2825     index xie1 main-price-exist
     2826   .
     2827   define variable num_rec        as integer   no-undo .
     2828   define variable num_gds        as integer   no-undo .
     2829   define variable start-time     as integer   no-undo .
     2830   define variable current-time   as character no-undo .
     2831   define variable current-action as character no-undo .
     2832   define buffer last_price-all         for ub.price-all  .
     2833   define variable l-check-price-parts  as logical   no-undo .
     2834   define variable par-is-pharm         as character no-undo .
     2835   define variable par-type             as character no-undo .
     2836   def frame a
     2837     ub.price-doc.doc-num label "Переоценка"  skip
     2838     current-action       format "x(40)"      no-label skip
     2839     num_rec              format ">>>>>>>9"   label "Обработано артикулов" skip
     2840     ub.price-list.artic                      label "Текущий артикул" skip
     2841     num_gds              format ">>>>>>>9"   label "Обработано строк" skip
     2842     current-time         format "x(8)" label "Время" skip
     2843     with view-as dialog-box side-labels three-d
     2844     title "Обработка переоценки"
     2845     .
     2846   Main-block:
     2847   do transaction
     2848   on error undo main-block, return error
     2849   on end-key undo main-block, return error
     2850   :
     2851   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2852     (input  'is-pharm'
     2853     ,input  ub.price-doc.host-code
     2854     ,input  ub.price-doc.obj-type
     2855     ,input  ub.price-doc.obj-code
     2856     ,input  ''
     2857     ,input  ''
     2858     ,input  ''
     2859     ,input  no
     2860     ,output par-is-pharm
     2861     ,output par-type
     2862     ) no-error .
     2863     .
     2864     l-check-price-parts = true .
     2865   if par-is-pharm = "yes"  then do:
     2866   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$workfile: $ $revision: $".
     2867   define variable v-o-pharm    as character no-undo .
     2868   define variable v-o-var-type as character no-undo .
     2869     run clntattr-value in this-procedure
     2870       ( input   ub.price-doc.obj-type ,
     2871         input   ub.price-doc.obj-code ,
     2872         input  'pharm':U,
     2873         output v-o-pharm    ,
     2874         output v-o-var-type )
     2875        no-error .
     2876     if v-o-pharm <> "yes":u or error-status :error then do:
     2877        par-is-pharm = "no"  .
     2878     end.
     2879   end.
     2880   if par-is-pharm = "yes"  then do:
     2881      l-check-price-parts = false .
     2882   end.
     2883     run trg/chkdocnm.p
     2884       ( input ub.price-doc.doc-num
     2885       , input 'price-doc':U
     2886       , input recid (ub.price-doc)
     2887       ) no-error .
     2888     if error-status :error then do:
     2889       message
     2890         vss-workfile vss-revision vss-description skip
     2891         "Ошибка при проверке уникальности кода документа" skip
     2892         "Переоценка" ub.price-doc.doc-num skip
     2893         error-status :get-message(1) skip
     2894         return-value skip
     2895         view-as alert-box error .
     2896       undo main-block, return error .
     2897     end.
     2898     if ub.price-doc.creid = "" then do:
     2899       assign
     2900         ub.price-doc.creid = g#userid
     2901       .
     2902     end.
     2903   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2904   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2905     (input  ub.price-doc.obj-type
     2906     ,input  ub.price-doc.obj-code
     2907     ,output ub.price-doc.host-code
     2908     ) no-error .
     2909     if error-status :error then do:
     2910       message
     2911         vss-workfile vss-revision vss-description skip
     2912         "Невозможно найти фирму для объекта " ub.price-doc.obj-type ub.price-doc.obj-code skip
     2913         error-status :get-message(1) skip
     2914         return-value skip
     2915         view-as alert-box error .
     2916       undo main-block, return error .
     2917     end.
     2918     if old-doc.status_ = ub.price-doc.status_ then do:
     2919       return.
     2920     end.
     2921     if  not new ub.price-doc
     2922     and old-doc.status_ = 'акт':U
     2923     and ub.price-doc.status_ <> 'акт':U then do:
     2924       message
     2925         vss-workfile vss-revision vss-description skip
     2926         "Изменение статуса переоценки невозможно" skip
     2927         "Переоценка" ub.price-doc.doc-num skip
     2928         "Переоценка закрыта до статуса" old-doc.status_ skip
     2929         "Нельзя изменить на статус" ub.price-doc.status_ skip
     2930         view-as alert-box error .
     2931       undo main-block, return error .
     2932     end.
     2933     if not g#news
     2934     then do:
     2935   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2936   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     2937     (output ub.price-doc.user-db-num
     2938     ,output ub.price-doc.user-name
     2939     ,output ub.price-doc.sys-date
     2940     ,output ub.price-doc.sys-time
     2941     ,output ub.price-doc.sys-time-int
     2942     )  .
     2943     end.
     2944     if ub.price-doc.status_ = 'приказ':U then do:
     2945       run change-status-prikaz in this-procedure no-error .
     2946       if error-status :error then do:
     2947         message
     2948           vss-workfile vss-revision vss-description skip
     2949           "Ошибка при выполнении программы change-status-prikaz" skip
     2950           error-status :get-message(1) skip
     2951           return-value skip
     2952           view-as alert-box error .
