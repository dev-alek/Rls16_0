     2954       end.
     2955     end.
     2956     if ub.price-doc.status_ = 'разрешен':U then do:
     2957       run change-status-permitted in this-procedure no-error .
     2958       if error-status :error then do:
     2959         message
     2960           vss-workfile vss-revision vss-description skip
     2961           "Ошибка при выполнении программы change-status-permitted" skip
     2962           error-status :get-message(1) skip
     2963           return-value skip
     2964           view-as alert-box error .
     2965         undo main-block, return error .
     2966       end.
     2967     end.
     2968     if ub.price-doc.status_ = 'акт':U then do:
     2969       run change-status-act in this-procedure
     2970         (input old-doc.status_ = 'разрешен':U
     2971         ) no-error .
     2972       if error-status :error then do:
     2973         message
     2974           vss-workfile vss-revision vss-description skip
     2975           "Ошибка при выполнении программы change-status-act" skip
     2976           error-status :get-message(1) skip
     2977           return-value skip
     2978           view-as alert-box error .
     2979         undo main-block, return error .
     2980       end.
     2981     end.
     2982     if not g#news and ub.price-doc.status_ <> 'новый':U then do:
     2983       run trg/pr-doch.p
     2984         (buffer old-doc
     2985         ,buffer ub.price-doc
     2986         ) no-error .
     2987       if error-status :error then do:
     2988         message
