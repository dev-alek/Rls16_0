        1   block-level on error undo, throw.
        2   define parameter buffer buf_chk-doc for ub.chk-doc.
        3   define input parameter p-validate    as logical no-undo .
        4   define input parameter p-add         as logical no-undo .
        5   define input parameter p-del         as logical no-undo .
        6   define input-output parameter p-chip-num like ub.c-chk-doc.chip-num no-undo .
        7   define output parameter p-is-update as logical no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: d765e193a656, 1242, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       10   define variable vss-date        as character no-undo init "$Date: 2018/02/26 16:31:29 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: chk-doch.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: trg/chk-doch.p $":U .
       13   define variable vss-description as character no-undo init "Запись истории для таблицы chk-doc".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure cur-time :
       85      define output parameter p-today as date      no-undo .
       86      define output parameter p-time  as integer   no-undo .
       87     do
       88     on error undo, return error
       89     :
       90       define variable v-date1 as date      no-undo .
       91       define variable v-date2 as date      no-undo .
       92       define variable v-time  as integer   no-undo .
       93       assign
       94         v-date1 = today
       95         v-time  = time
       96         v-date2 = today
       97       .
       98       if v-date1 <> v-date2
       99       then do:
      100         assign
      101           v-date1 = today
      102           v-time  = v-time
      103         .
      104       end.
      105       assign
      106         p-today = v-date1
      107         p-time  = v-time
      108       .
      109     end.
      110   end.
      111   function cur-time-date returns character
      112   :
      113     return string(today, '99/99/9999':U) .
      114   end.
      115   function cur-time-mjd returns decimal
      116   :
      117     define variable v-date as date      no-undo .
      118     define variable v-time as integer   no-undo .
      119     run cur-time in this-procedure
      120       (output v-date
      121       ,output v-time
      122       ) .
      123     return integer(v-date) - 2400002 + (v-time / 86400) .
      124   end.
      125   function cur-time-get-ending-index returns integer
      126   (input p-number as integer
      127   )
      128   :
      129     if p-number < 0
      130     or p-number = ?
      131     then do:
      132       return 1 .
      133     end.
      134     define variable v-rest as integer   no-undo .
      135     assign
      136       p-number = p-number modulo 100
      137     .
      138     if p-number < 20
      139     then do:
      140       assign
      141         v-rest = p-number
      142       .
      143     end.
      144     else do:
      145       assign
      146         v-rest = p-number modulo 10
      147       .
      148     end.
      149     case v-rest :
      150       when 1
      151       then do:
      152         return 2 .
      153       end.
      154       when 2 or
      155       when 3 or
      156       when 4
      157       then do:
      158         return 3 .
      159       end.
      160       otherwise do:
      161         return 1 .
      162       end.
      163     end case .
      164   end.
      165   procedure cur-time-mjd-to-date :
      166      define input  parameter i-mjd-diff as decimal no-undo.
      167      define output parameter o-Date     as date    no-undo.
      168      define output parameter o-Time     as integer no-undo.
      169      define variable v-day-number as integer   no-undo .
      170      if    i-mjd-diff < 0
      171         or i-mjd-diff = ?
      172      then do:
      173         return "?" .
      174      end.
      175      assign
      176         v-day-number = truncate(i-mjd-diff,0).
      177         o-Date = date(v-day-number + 2400002).
      178         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      179     .
      180   end.
      181   function cur-time-mjd-to-string returns character
      182   (input p-mjd-diff as decimal
      183   )
      184   :
      185     define variable v-day-number as integer   no-undo .
      186     define variable v-seconds    as integer   no-undo .
      187     define variable v-hour       as integer   no-undo .
      188     define variable v-min        as integer   no-undo .
      189     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      190     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      191     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      192     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      193     if p-mjd-diff < 0
      194     or p-mjd-diff = ?
      195     then do:
      196       return "?" .
      197     end.
      198     assign
      199       v-day-number = integer(truncate(p-mjd-diff,0))
      200       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      201     .
      202     if v-seconds > 86400
      203     then do:
      204       assign
      205         v-seconds = 86400 - 1
      206       .
      207     end.
      208     if v-seconds < 0
      209     then do:
      210       assign
      211         v-seconds = 0
      212       .
      213     end.
      214     assign
      215       v-hour = truncate(v-seconds / 3600, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 3600
      219     .
      220     assign
      221       v-min = truncate(v-seconds / 60, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 60
      225     .
      226     return
      227         (if v-day-number <> 0
      228           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0
      232           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      236           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      237           else ""
      238         )
      239       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      240       .
      241   end.
      242   function cur-time-string returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      251   end.
      252   function cur-time-string-sec returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      261   end.
      262   function cur-time-custom  returns character
      263   (input p-prefix as character
      264   ,input p-date-format as character
      265   ,input p-delimiter as character
      266   ,input p-time-format as character
      267   ,input p-suffix as character
      268   )
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return
      277       p-prefix
      278       + string(v-date, p-date-format)
      279       + p-delimiter
      280       + string(v-time, p-time-format)
      281       + p-suffix
      282       .
      283   end.
      284   function cur-time-print  returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-datetime returns datetime
      295   :
      296     define variable v-char as character no-undo .
      297     define variable v-datetime as datetime no-undo .
      298     v-char = cur-time-string().
      299     v-datetime = datetime(v-char).
      300     return  v-datetime.
      301   end.
      302   function cur-time-string-msec returns character
      303   :
      304     define variable v-date as datetime  no-undo .
      305     v-date = now.
      306     return string(v-date) .
      307   end.
      308   define variable v-create   as logical no-undo .
      309   define variable v-is-equal as logical no-undo .
      310   define variable v-date     as date    no-undo.
      311   define variable v-time     as integer no-undo.
      312   define buffer buf_c-chk-doc      for ub.c-chk-doc.
      313   define buffer buf_c-chk-gds      for ub.c-chk-gds.
      314   define buffer buf_c-chk-pay      for ub.c-chk-pay.
      315   define buffer buf_c-chk-discnt   for ub.c-chk-discnt.
      316   define buffer buf_c-chk-doc-attr for ub.c-chk-doc-attr.
      317   define buffer buf_c-marking-chk  for ub.c-marking-chk.
      318   define buffer last_c-chk-doc     for ub.c-chk-doc.
      319   define buffer buf_chk-gds        for ub.chk-gds.
      320   define buffer buf_chk-pay        for ub.chk-pay.
      321   define buffer buf_chk-discnt     for ub.chk-discnt.
      322   define buffer buf_chk-doc-attr   for ub.chk-doc-attr.
      323   define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      324   define buffer buf_chk-pay-attr for ub.chk-pay-attr.
      325   define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
      326   define buffer buf_marking-chk for marking-chk.
      327   _main:
      328   do
      329       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      330       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      331       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile ):
      332       if p-validate = no
      333           or p-add
      334           or p-del
      335           then
      336       do:
      337           run cur-time in this-procedure(output v-date, output v-time).
      338           if p-chip-num > 0 then
      339           do:
      340               find first buf_c-chk-doc where
      341                   buf_c-chk-doc.doc-code = buf_chk-doc.doc-code
      342                   AND buf_c-chk-doc.chip-num = p-chip-num no-error .
      343           end.
      344           if not available buf_c-chk-doc then
      345           do:
      346               find last last_c-chk-doc no-lock where
      347                   last_c-chk-doc.doc-code = buf_chk-doc.doc-code no-error .
      348               if available last_c-chk-doc then
      349               do:
      350                   assign
      351                       p-chip-num = last_c-chk-doc.chip-num + 1
      352                       .
      353               end.
      354               else
      355               do:
      356                   assign
      357                       p-chip-num = 1
      358                       .
      359               end.
      360               create buf_c-chk-doc.
      361               assign
      362                   buf_c-chk-doc.doc-code         = buf_chk-doc.doc-code
      363                   buf_c-chk-doc.chip-num         = p-chip-num
      364                   buf_c-chk-doc.corr-user-db-num = g#db-num
      365                   buf_c-chk-doc.corr-user-name   = g#userid
      366                   buf_c-chk-doc.corr-time        = v-time
      367                   buf_c-chk-doc.corr-date        = v-date
      368                   buf_c-chk-doc.is-del           = p-del
      369                   buf_c-chk-doc.is-add           = (if available last_c-chk-doc
      370                                         then last_c-chk-doc.is-add
      371                                         else p-add)
      372                   v-create                       = yes
      373                   .
      374               if p-add then
      375               do:
      376                   run trg/userlog.p (
      377                       input 'create':U
      378                       , input 'c-chk-doc':U
      379                       , input ( buffer buf_c-chk-doc :handle )
      380                       , input ?
      381                       , input ""
      382                       ) no-error.
      383                   if error-status :error
      384                       then
      385                   do:
      386                       undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      387                           , chr(10)
      388                           , vss-workfile
      389                           , return-value
      390                           , error-status :get-message ( 1 ) ).
      391                   end.
      392               end.
      393               if p-del then
      394               do:
      395                   run trg/userlog.p (
      396                       input 'delete':U
      397                       , input 'c-chk-doc':U
      398                       , input ( buffer buf_c-chk-doc :handle )
      399                       , input ?
      400                       , input ""
      401                       ) no-error.
      402                   if error-status :error
      403                       then
      404                   do:
      405                       undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      406                           , chr(10)
      407                           , vss-workfile
      408                           , return-value
      409                           , error-status :get-message ( 1 ) ).
      410                   end.
      411               end.
      412           end.
      413           else
      414           do:
      415               assign
      416                   buf_c-chk-doc.corr-user-db-num = g#db-num
      417                   buf_c-chk-doc.corr-user-name   = g#userid
      418                   buf_c-chk-doc.corr-time        = v-time
      419                   buf_c-chk-doc.corr-date        = v-date
      420                   buf_c-chk-doc.is-del           = p-del
      421                   buf_c-chk-doc.is-add           = p-add
      422                   .
      423           end.
      424           buffer-copy buf_chk-doc
      425               except doc-code PS
      426               to buf_c-chk-doc.
      427           if not v-create then
      428           do:
      429               for each buf_c-chk-gds where
      430                   buf_c-chk-gds.doc-code = buf_chk-doc.doc-code
      431                   AND buf_c-chk-gds.chip-num = p-chip-num:
      432                   delete buf_c-chk-gds.
      433               END.
      434               for each buf_c-chk-pay where
      435                   buf_c-chk-pay.doc-code = buf_chk-doc.doc-code
      436                   AND buf_c-chk-pay.chip-num = p-chip-num:
      437                   delete buf_c-chk-pay.
      438               END.
      439               for each buf_c-chk-discnt where
      440                   buf_c-chk-discnt.doc-code = buf_chk-doc.doc-code
      441                   AND buf_c-chk-discnt.chip-num = p-chip-num
      442                   :
      443                   delete buf_c-chk-discnt.
      444               END.
      445               for each buf_c-chk-doc-attr where
      446                   buf_c-chk-doc-attr.doc-code = buf_chk-doc.doc-code
      447                   AND buf_c-chk-doc-attr.chip-num = p-chip-num:
      448                   delete buf_c-chk-doc-attr.
      449               END.
      450               for each buf_c-marking-chk where
      451                   buf_c-marking-chk.doc-code = buf_chk-doc.doc-code
      452                   AND buf_c-marking-chk.chip-num = p-chip-num:
      453                   delete buf_c-marking-chk.
      454               END.
      455           end.
      456           for each buf_chk-gds no-lock where
      457               buf_chk-gds.doc-code = buf_chk-doc.doc-code
      458               on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      459               create buf_c-chk-gds.
      460               buffer-copy buf_chk-gds
      461                   to buf_c-chk-gds
      462                   assign
      463                   buf_c-chk-gds.chip-num = p-chip-num
      464                   buf_c-chk-gds.corr-user-db-num = g#db-num
      465                   .
      466           end.
      467           for each buf_chk-pay no-lock where
      468               buf_chk-pay.doc-code = buf_chk-doc.doc-code
      469               on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      470               create buf_c-chk-pay.
      471               buffer-copy buf_chk-pay
      472                   to buf_c-chk-pay
      473                   assign
      474                   buf_c-chk-pay.chip-num = p-chip-num
      475                   buf_c-chk-pay.corr-user-db-num = g#db-num
      476                   .
      477           end.
      478           for each buf_chk-discnt no-lock where
      479               buf_chk-discnt.doc-code = buf_chk-doc.doc-code
      480               on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      481               create buf_c-chk-discnt.
      482               buffer-copy buf_chk-discnt
      483                   to buf_c-chk-discnt
      484                   assign
      485                   buf_c-chk-discnt.chip-num = p-chip-num
      486                   buf_c-chk-discnt.corr-user-db-num = g#db-num
      487                   .
      488           end.
      489           for each buf_chk-doc-attr no-lock where
      490               buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code
      491               on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      492               create buf_c-chk-doc-attr.
      493               buffer-copy buf_chk-doc-attr
      494                   to buf_c-chk-doc-attr
      495                   assign
      496                   buf_c-chk-doc-attr.chip-num = p-chip-num
      497                   buf_c-chk-doc-attr.corr-user-db-num = g#db-num
      498                   .
      499           end.
      500           for each buf_marking-chk no-lock where
      501                    buf_marking-chk.doc-code = buf_chk-doc.doc-code
      502                    on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      503                    find first buf_c-marking-chk where
      504                               buf_c-marking-chk.doc-code = buf_chk-doc.doc-code
      505                           AND buf_c-marking-chk.chip-num = p-chip-num no-error.
      506                    if not available buf_c-marking-chk then do:
      507                       create buf_c-marking-chk.
      508                       buffer-copy buf_marking-chk
      509                       to buf_c-marking-chk
      510                       assign
      511                       buf_c-marking-chk.chip-num = p-chip-num
      512                       buf_c-marking-chk.corr-user-db-num = g#db-num
      513                       .
      514                    end.
      515           end.
      516       for each buf_chk-gds-attr no-lock where
      517               buf_chk-gds-attr.doc-code = buf_chk-doc.doc-code
      518       on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      519         create buf_c-chk-doc-attr.
      520         buffer-copy buf_chk-gds-attr
      521         to buf_c-chk-doc-attr
      522         assign
      523         buf_c-chk-doc-attr.attr-code = "gds=" + string(buf_chk-gds-attr.line-num) + chr(4) + buf_chk-gds-attr.attr-code
      524         buf_c-chk-doc-attr.chip-num = p-chip-num
      525         buf_c-chk-doc-attr.corr-user-db-num = g#db-num
      526         .
      527       end.
      528       for each buf_chk-pay-attr no-lock where
      529               buf_chk-pay-attr.doc-code = buf_chk-doc.doc-code
      530       on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      531         create buf_c-chk-doc-attr.
      532         buffer-copy buf_chk-pay-attr
      533         to buf_c-chk-doc-attr
      534         assign
      535         buf_c-chk-doc-attr.attr-code = "pay=" + string(buf_chk-pay-attr.line-num) + chr(4) + buf_chk-pay-attr.attr-code
      536         buf_c-chk-doc-attr.chip-num = p-chip-num
      537         buf_c-chk-doc-attr.corr-user-db-num = g#db-num
      538         .
      539       end.
      540       for each buf_chk-discnt-attr no-lock where
      541               buf_chk-discnt-attr.doc-code = buf_chk-doc.doc-code
      542       on error undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
      543         create buf_c-chk-doc-attr.
      544         buffer-copy buf_chk-discnt-attr
      545         to buf_c-chk-doc-attr
      546         assign
      547         buf_c-chk-doc-attr.attr-code = "discnt=" + string(buf_chk-discnt-attr.line-num)
      548                                      + chr(3) + string(buf_chk-discnt-attr.record-type)
      549                                      + chr(3) + string(buf_chk-discnt-attr.discnt-id)
      550                                      + chr(3) + string(buf_chk-discnt-attr.object-line-num)
      551                                      + chr(4) + buf_chk-discnt-attr.attr-code
      552         buf_c-chk-doc-attr.chip-num = p-chip-num
      553         buf_c-chk-doc-attr.corr-user-db-num = g#db-num
      554         .
      555       end.
      556            if p-del
      557               and ( g#db-num > 0 )
      558               then
      559           do:
      560               run str/callnews.p
      561                   (input 'c-chk-doc':U
      562                   ,input (buffer buf_c-chk-doc:handle)
      563                   ) no-error .
      564           end.
      565       end.
      566       else
      567       do:
      568           find first buf_c-chk-doc where
      569               buf_c-chk-doc.doc-code = buf_chk-doc.doc-code
      570               AND buf_c-chk-doc.chip-num = p-chip-num .
      571           buffer-compare
      572               buf_c-chk-doc
      573               EXCEPT PS
      574               to buf_chk-doc
      575               case-sensitive
      576               save result in v-is-equal
      577               .
      578           if not v-is-equal then
      579           do:
      580               assign
      581                   p-is-update = yes
      582                   .
      583               return.
      584           end.
      585           for each buf_chk-gds no-lock where
      586               buf_chk-gds.doc-code = buf_chk-doc.doc-code:
      587               find first buf_c-chk-gds no-lock where
      588                   buf_c-chk-gds.doc-code = buf_chk-doc.doc-code
      589                   AND buf_c-chk-gds.chip-num = p-chip-num
      590                   AND buf_c-chk-gds.line-num = buf_chk-gds.line-num no-error .
      591               if not avail buf_c-chk-gds then
      592               do:
      593                   assign
      594                       p-is-update = yes
      595                       .
      596                   return.
      597               end.
      598               buffer-compare
      599                   buf_c-chk-gds to buf_chk-gds
      600                   case-sensitive
      601                   save result in v-is-equal
      602                   .
      603               if not v-is-equal then
      604               do:
      605                   assign
      606                       p-is-update = yes
      607                       .
      608                   return.
      609               end.
      610           end.
      611           for each buf_chk-pay no-lock where
      612               buf_chk-pay.doc-code = buf_chk-doc.doc-code:
      613               find first buf_c-chk-pay no-lock where
      614                   buf_c-chk-pay.doc-code = buf_chk-doc.doc-code
      615                   AND buf_c-chk-pay.chip-num = p-chip-num
      616                   AND buf_c-chk-pay.line-num = buf_chk-pay.line-num no-error .
      617               if not avail buf_c-chk-pay then
      618               do:
      619                   assign
      620                       p-is-update = yes
      621                       .
      622                   return.
      623               end.
      624               buffer-compare
      625                   buf_c-chk-pay to buf_chk-pay
      626                   case-sensitive
      627                   save result in v-is-equal
      628                   .
      629               if not v-is-equal then
      630               do:
      631                   assign
      632                       p-is-update = yes
      633                       .
      634                   return.
      635               end.
      636           end.
      637           for each buf_chk-discnt no-lock where
      638               buf_chk-discnt.doc-code = buf_chk-doc.doc-code
      639               AND buf_chk-discnt.record-type < 2
      640               :
      641               find first buf_c-chk-discnt no-lock where
      642                   buf_c-chk-discnt.doc-code = buf_chk-doc.doc-code
      643                   AND buf_c-chk-discnt.chip-num = p-chip-num
      644                   AND buf_c-chk-discnt.line-num = buf_chk-discnt.line-num
      645                   AND buf_c-chk-discnt.discnt-id = buf_chk-discnt.discnt-id
      646                   AND buf_c-chk-discnt.object-line-num = buf_chk-discnt.object-line-num
      647                   AND buf_c-chk-discnt.record-type     = buf_chk-discnt.record-type
      648                   no-error .
      649               if not avail buf_c-chk-discnt then
      650               do:
      651                   assign
      652                       p-is-update = yes
      653                       .
      654                   return.
      655               end.
      656               buffer-compare
      657                   buf_c-chk-discnt to buf_chk-discnt
      658                   case-sensitive
      659                   save result in v-is-equal
      660                   .
      661               if not v-is-equal then
      662               do:
      663                   assign
      664                       p-is-update = yes
      665                       .
      666                   return.
      667               end.
      668           end.
      669           for each buf_chk-discnt no-lock where
      670               buf_chk-discnt.doc-code = buf_chk-doc.doc-code
      671               AND buf_chk-discnt.record-type >= 4
      672               and buf_chk-discnt.record-type <= 5
      673               :
      674               find first buf_c-chk-discnt no-lock where
      675                   buf_c-chk-discnt.doc-code = buf_chk-doc.doc-code
      676                   AND buf_c-chk-discnt.chip-num = p-chip-num
      677                   AND buf_c-chk-discnt.line-num = buf_chk-discnt.line-num
      678                   AND buf_c-chk-discnt.discnt-id = buf_chk-discnt.discnt-id
      679                   AND buf_c-chk-discnt.object-line-num = buf_chk-discnt.object-line-num
      680                   AND buf_c-chk-discnt.record-type     = buf_chk-discnt.record-type
      681                   no-error .
      682               if not avail buf_c-chk-discnt then
      683               do:
      684                   assign
      685                       p-is-update = yes
      686                       .
      687                   return.
      688               end.
      689               buffer-compare
      690                   buf_c-chk-discnt to buf_chk-discnt
      691                   case-sensitive
      692                   save result in v-is-equal
      693                   .
      694               if not v-is-equal then
      695               do:
      696                   assign
      697                       p-is-update = yes
      698                       .
      699                   return.
      700               end.
      701           end.
      702           for each buf_chk-doc-attr no-lock where
      703               buf_chk-doc-attr.doc-code = buf_chk-doc.doc-code:
      704               find first buf_c-chk-doc-attr no-lock where
      705                   buf_c-chk-doc-attr.doc-code = buf_chk-doc.doc-code
      706                   AND buf_c-chk-doc-attr.chip-num = p-chip-num
      707                   AND buf_c-chk-doc-attr.attr-code = buf_chk-doc-attr.attr-code no-error .
      708               if not avail buf_c-chk-doc-attr then
      709               do:
      710                   assign
      711                       p-is-update = yes
      712                       .
      713                   return.
      714               end.
      715               buffer-compare
      716                   buf_c-chk-doc-attr to buf_chk-doc-attr
      717                   case-sensitive
      718                   save result in v-is-equal
      719                   .
      720               if not v-is-equal then
      721               do:
      722                   assign
      723                       p-is-update = yes
      724                       .
      725                   return.
      726               end.
      727           end.
      728           for each buf_c-chk-gds where
      729               buf_c-chk-gds.doc-code = buf_chk-doc.doc-code
      730               AND buf_c-chk-gds.chip-num = p-chip-num:
      731               delete buf_c-chk-gds.
      732           end.
      733           for each buf_c-chk-pay where
      734               buf_c-chk-pay.doc-code = buf_chk-doc.doc-code
      735               AND buf_c-chk-pay.chip-num = p-chip-num:
      736               delete buf_c-chk-pay.
      737           end.
      738           for each buf_c-chk-discnt where
      739               buf_c-chk-discnt.doc-code = buf_chk-doc.doc-code
      740               AND buf_c-chk-discnt.chip-num = p-chip-num:
      741               delete buf_c-chk-discnt.
      742           end.
      743           for each buf_c-chk-doc-attr where
      744               buf_c-chk-doc-attr.doc-code = buf_chk-doc.doc-code
      745               AND buf_c-chk-doc-attr.chip-num = p-chip-num:
      746               delete buf_c-chk-doc-attr.
      747           end.
      748           for each buf_c-marking-chk where
      749               buf_c-marking-chk.doc-code = buf_chk-doc.doc-code
      750               AND buf_c-marking-chk.chip-num = p-chip-num:
      751               delete buf_c-marking-chk.
      752           END.
      753           delete buf_c-chk-doc.
      754       end.
      755   end.
