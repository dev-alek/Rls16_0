     2871   end.
     2872   function CheckErrForUtd returns logical
     2873   (idb-num         as integer ,
     2874    idoc-id         as integer ):
     2875      for each utd-lines where utd-lines.db-num eq idb-num
     2876                           and utd-lines.doc-id eq idoc-id
     2877      no-lock :
     2878         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2879         then
     2880            return no.
     2881      end.
     2882      return yes.
     2883   end.
     2884   function CheckMarkUtd-28rel return logical
     2885    (input idb-num as integer,
     2886    input idoc-id as integer):
     2887    define buffer utd                   for utd.
     2888    define buffer utd-lines             for utd-lines.
     2889    define buffer utd-marking-lines     for utd-marking-lines.
     2890    define variable v-par-type as character no-undo.
     2891    define variable vgdsNoMark as logical no-undo.
     2892    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2893      define variable v-par-val  as character no-undo.
     2894      find first utd where utd.db-num eq idb-num
     2895                       and utd.doc-id eq idoc-id
     2896      no-lock no-error.
     2897      if available utd
     2898      then do:
     2899         if     utd.obj-code ne ?
     2900            and utd.obj-type ne ?
     2901         then do:
     2902            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2903            Block-utd-lines:
     2904            for each utd-lines where utd-lines.db-num eq idb-num
     2905                                 and utd-lines.doc-id eq idoc-id
     2906            no-lock:
     2907               if     utd-lines.gds-code ne ?
     2908                  and utd-lines.gds-code ne 0
     2909               then do:
     2910                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2911                       ( utd-lines.gds-code,
     2912                         'mark-type':U,
     2913                          output v-par-val,
     2914                          output v-par-type
     2915                       ).
     2916                  if     EDOParSec:IsEdo
     2917                     and EDOParSec:GetIsEDOForType(v-par-val)
     2918                  then do:
     2919                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2920                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2921                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2922                                                    and length(utd-marking-lines.mark) > 13
     2923                     no-lock no-error.
     2924                     if     avail utd-marking-lines
     2925                        and not CheckErrForLine(buffer utd-lines:handle)
     2926                     then
     2927                        leave Block-utd-lines.
     2928                  end.
     2929                  else
     2930                     vgdsNoMark = yes.
     2931               end.
     2932            end.
     2933            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2934            if vgdsNoMark then return available utd-lines . else return yes .
     2935         end.
     2936      end.
     2937      return yes.
     2938   end.
     2939   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2940   define temp-table tt-utd-mark no-undo like utd-marking-lines
     2941     field side as character.
     2942   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2943   function CheckMarkUtd return logical
     2944    (input idb-num  as integer,
     2945     input idoc-id  as integer):
     2946     define buffer utd-lines             for ub.utd-lines.
     2947     block-line:
     2948     for each utd-lines where utd-lines.db-num eq idb-num
     2949                          and utd-lines.doc-id eq idoc-id
     2950     no-lock:
     2951        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2952        then
     2953           leave block-line.
     2954     end.
     2955     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2956     return available utd-lines.
     2957   end.
     2958   function CheckNotMarkUtd return logical
     2959    (input idb-num  as integer,
     2960     input idoc-id  as integer):
     2961     define buffer utd-lines             for ub.utd-lines.
     2962     for each utd-lines where utd-lines.db-num eq idb-num
     2963                          and utd-lines.doc-id eq idoc-id
     2964     no-lock:
     2965        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2966        then
     2967           return yes.
     2968     end.
     2969     return no.
     2970   end.
     2971   function CheckMarkUtdLine return logical
     2972    (input idb-num  as integer,
     2973     input idoc-id  as integer,
     2974     input iLineNum as integer):
     2975    define buffer utd                   for utd.
     2976    define buffer utd-lines             for utd-lines.
     2977    define buffer utd-marking-lines     for utd-marking-lines.
     2978    define variable v-par-type as character no-undo.
     2979    define variable vMarking        as logical no-undo.
     2980    define variable vArtic          as logical no-undo.
     2981    define variable vTransitional   as logical no-undo.
     2982    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2983      define variable v-par-val  as character no-undo.
     2984      find first utd where utd.db-num eq idb-num
     2985                       and utd.doc-id eq idoc-id
     2986      no-lock no-error.
     2987      if available utd
     2988      then do:
     2989         if     utd.obj-code ne ?
     2990            and utd.obj-type ne ?
     2991         then do:
     2992            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2993            Block-utd-lines:
     2994            for each utd-lines where utd-lines.db-num   eq idb-num
     2995                                 and utd-lines.doc-id   eq idoc-id
     2996                                 and utd-lines.LineNum  eq iLineNum
     2997            no-lock:
     2998               if     utd-lines.gds-code ne ?
     2999                  and utd-lines.gds-code ne 0
     3000               then do:
     3001                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3002                       ( utd-lines.gds-code,
     3003                         'mark-type':U,
     3004                          output v-par-val,
     3005                          output v-par-type
     3006                       ).
     3007                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     3008                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     3009                  if vMarking
     3010                  then do:
     3011                     block-marking:
     3012                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3013                                                    and utd-marking-lines.doc-id   eq idoc-id
     3014                                                    and utd-marking-lines.LineNum  eq iLineNum
     3015                                                    and length(utd-marking-lines.mark) > 13
     3016                     no-lock:
     3017                        if isOAD(utd-marking-lines.mark)
     3018                        then do:
     3019                           assign
     3020                              vArtic   = yes
     3021                              vMarking = no
     3022                           .
     3023                           leave block-marking.
     3024                        end.
     3025                     end.
     3026                  end.
     3027                  if vArtic
     3028                  then do:
     3029                     block-artic:
     3030                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3031                                                    and utd-marking-lines.doc-id   eq idoc-id
     3032                                                    and utd-marking-lines.LineNum  eq iLineNum
     3033                                                    and length(utd-marking-lines.mark) > 13
     3034                     no-lock:
     3035                        if isMark(utd-marking-lines.mark)
     3036                        then do:
     3037                           assign
     3038                              vArtic   = no
     3039                              vMarking = yes
     3040                           .
     3041                           leave block-artic.
     3042                        end.
     3043                     end.
     3044                  end.
     3045                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     3046                  if vTransitional
     3047                  then do:
     3048                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     3049                                                    and utd-marking-lines.doc-id   eq idoc-id
     3050                                                    and utd-marking-lines.LineNum  eq iLineNum
     3051                                                    and length(utd-marking-lines.mark) > 13
     3052                     no-lock no-error.
     3053                     if not available utd-marking-lines
     3054                     then assign
     3055                        vMarking = no
     3056                        vArtic   = no
     3057                     .
     3058                  end.
     3059               end.
     3060               else
     3061                  assign
     3062                     vMarking      = yes
     3063                     vArtic        = no
     3064                     vTransitional = no
     3065                  .
     3066               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     3067               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     3068               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     3069            end.
     3070         end.
     3071      end.
     3072      return vMarking or vArtic.
     3073   end.
     3074   function getMarkUtdLine return logical
     3075    (input  idb-num  as integer,
     3076     input  idoc-id  as integer,
     3077     input  iLineNum as integer,
     3078     output oMarking        as logical,
     3079     output oArtic          as logical,
     3080     output oTransitional   as logical):
     3081     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     3082     oArtic        = not oMarking
     3083            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     3084     oTransitional = (oMarking or oArtic)
     3085            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     3086   end.
     3087   function CheckMarking return logical
     3088    (input idb-num as integer,
     3089    input idoc-id as integer,
     3090    input iTypeErr as character ):
     3091     define variable vMarkutd as logical no-undo.
     3092     define variable vCrErr   as logical no-undo.
     3093     define buffer utd-lines         for utd-lines.
     3094     define buffer utd-marking-lines for utd-marking-lines.
     3095     define buffer marking           for marking.
     3096     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     3097      block-line:
     3098      for each utd-lines where utd-lines.db-num eq idb-num
     3099                           and utd-lines.doc-id eq idoc-id
     3100      no-lock:
     3101         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     3102         then do:
     3103            for each utd-marking-lines
     3104                     where utd-marking-lines.db-num  = utd-lines.db-num
     3105                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3106                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3107            no-lock:
     3108               if isMark(utd-marking-lines.mark)
     3109               then do:
     3110                  find first marking where marking.mark eq utd-marking-lines.mark
     3111                  no-lock no-error.
     3112                  if not available marking
     3113                  then do:
     3114                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     3115                     vCrErr = yes.
     3116                     next block-line.
     3117                  end.
     3118               end.
     3119            end.
     3120         end.
     3121      end.
     3122      return vCrErr.
     3123   end.
     3124   function CheckMarkForType return logical
     3125    (input idb-num   as integer,
     3126     input idoc-id   as integer):
     3127      define variable vMarking        as logical no-undo.
     3128      define variable vArtic          as logical no-undo.
     3129      define variable vTransitional   as logical no-undo.
     3130      define buffer utd-lines         for utd-lines.
     3131      define buffer utd-marking-lines for utd-marking-lines.
     3132      block-line:
     3133      for each utd-lines where utd-lines.db-num eq idb-num
     3134                           and utd-lines.doc-id eq idoc-id
     3135      no-lock:
     3136         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     3137                          output vMarking         , output vArtic          , output vTransitional).
     3138         for each utd-marking-lines
     3139                     where utd-marking-lines.db-num  = utd-lines.db-num
     3140                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     3141                       and utd-marking-lines.LineNum = utd-lines.LineNum
     3142         no-lock:
     3143            if length(utd-marking-lines.mark) < 14
     3144            then do:
     3145               if (vMarking or vArtic) and not vTransitional
     3146               then
     3147                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3148            end.
     3149            else if not isMark(utd-marking-lines.mark)
     3150            then do:
     3151               if vMarking
     3152               then
     3153                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3154            end.
     3155            else do:
     3156            end.
     3157         end.
     3158      end.
     3159   end.
     3160   function WeighedProd return logical
     3161      ( input p-gds-code as integer) :
     3162      define variable v-par-val  as character no-undo.
     3163      define variable v-par-type as character no-undo.
     3164              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3165               ( p-gds-code,
     3166                 'weighed-gds':U,
     3167                  output v-par-val,
     3168                  output v-par-type
     3169               ).
     3170      return logical(v-par-val).
     3171   end.
     3172   function WghProdVariable return logical
     3173       (input p-obj-type as char,
     3174        input p-obj-code as integer,
     3175        input p-gds-code as integer) :
     3176      define variable v-wgh-val  as character no-undo.
     3177      define variable v-par-val  as character no-undo.
     3178      define variable v-par-type as character no-undo.
     3179      define variable vMarking        as logical no-undo.
     3180      define variable vArtic          as logical no-undo.
     3181      define variable vTransitional   as logical no-undo.
     3182      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3183         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3184           ( p-gds-code,
     3185             'weighed-gds':U,
     3186              output v-wgh-val,
     3187              output v-par-type
     3188           ).
     3189       if logical(v-wgh-val) = yes then do:
     3190           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3191               ( p-gds-code,
     3192                 'mark-type':U,
     3193                  output v-par-val,
     3194                  output v-par-type
     3195               ).
     3196           if v-par-val <> "" then do:
     3197               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3198               assign
     3199                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3200                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3201                  .
     3202           end.
     3203      end.
     3204      if v-wgh-val > "" and (vMarking or vArtic)
     3205      then return yes.
     3206      else return no.
     3207   end.
     3208   function MarkWeight return decimal
     3209      ( input p-mark as character) :
     3210      define buffer  buf_marking-attr for  ub.marking-attr.
     3211      define variable vMarkWeight as decimal no-undo.
     3212      vMarkWeight = 0.
     3213      if p-mark <> "" and p-mark <> ?
     3214      then do:
     3215          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3216                                        and buf_marking-attr.attr-code eq "weight"
     3217             no-lock no-error.
     3218          if not available buf_marking-attr
     3219          then do :
     3220            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3221                                          and buf_marking-attr.attr-code eq "weight"
     3222               no-lock no-error.
     3223          end .
     3224          if avail buf_marking-attr
     3225          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3226      end.
     3227      return vMarkWeight.
     3228   end.
     3229   function CheckQnty returns logical
     3230   (  input idb-num  as integer,
     3231      input idoc-id  as integer,
     3232      input iErrType as character
     3233   ):
     3234      if iErrType ne "loadUTD"
     3235      then do:
     3236         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3237         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3238         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3239      end.
     3240      if iErrType ne "CheckQnty"
     3241      then do:
     3242         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3243         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3244         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3245      end.
     3246      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3247      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3248      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3249      define buffer marking               for marking.
     3250      define buffer utd-lines             for utd-lines.
     3251      define buffer utd-marking-lines     for utd-marking-lines.
     3252      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3253      block-line:
     3254      for each utd-lines where utd-lines.db-num eq idb-num
     3255                           and utd-lines.doc-id eq idoc-id
     3256      no-lock:
     3257         define variable Vflagmark as logical no-undo.
     3258         find first buf_utd-marking-lines
     3259                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3260                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3261                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3262                         and length(buf_utd-marking-lines.mark) > 13
     3263         no-lock no-error.
     3264         if not available buf_utd-marking-lines
     3265         then
     3266            next block-line.
     3267         define variable vqntyMark as integer no-undo.
     3268         define variable vqntyOAD  as integer no-undo.
     3269         vqntyMark = 0.
     3270         vqntyOAD  = 0.
     3271         block-mark:
     3272         for each utd-marking-lines
     3273              where utd-marking-lines.db-num  = utd-lines.db-num
     3274                and utd-marking-lines.doc-id  = utd-lines.doc-id
     3275                and utd-marking-lines.LineNum = utd-lines.LineNum
     3276                and length(utd-marking-lines.mark) > 13
     3277                and utd-marking-lines.doc-level  = 1
     3278         no-lock:
     3279            if isMark(utd-marking-lines.mark)
     3280            then do:
     3281               find first marking where marking.mark eq utd-marking-lines.mark
     3282               no-lock no-error.
     3283               if available marking
     3284               then do:
     3285                  if marking.box-qnty ne ?
     3286                  then
     3287                     vqntyMark = vqntyMark + marking.box-qnty.
     3288               end.
     3289            end.
     3290            else do:
     3291               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     3292                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     3293                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     3294                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     3295                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     3296               no-lock no-error.
     3297               if available utd-marking-lines-attr
     3298               then
     3299                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     3300            end.
     3301         end.
     3302         if     utd-lines.gds-code   gt 0
     3303            and utd-lines.gds-code   ne ?
     3304            and vqntyMark            ne 0
     3305         then do:
     3306            if utd-lines.Quantity  < vqntyMark
     3307            then
     3308               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3309            else if utd-lines.Quantity  <> vqntyMark
     3310            then
     3311               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3312         end.
     3313         else if     utd-lines.gds-code   gt 0
     3314            and utd-lines.gds-code   ne ?
     3315            and vqntyOAD ne 0
     3316            and utd-lines.Quantity  ne vqntyOAD
     3317         then
     3318            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     3319      end.
     3320   end.
     3321   function CheckGds returns logical
     3322   (  input idb-num   as integer,
     3323      input idoc-id   as integer,
     3324      input iobj-type as character,
     3325      input iobj-code as integer,
     3326      input iErrType as character
     3327   ):
     3328      if iErrType ne "loadUTD"
     3329      then do:
     3330         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     3331         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     3332         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     3333         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3334         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     3335         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     3336         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     3337         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     3338         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     3339         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     3340         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     3341      end.
     3342      if iErrType ne "CheckGds"
     3343      then do:
     3344         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     3345         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     3346         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     3347         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     3348         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     3349         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     3350         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     3351         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     3352         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     3353         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     3354         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     3355      end.
     3356      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     3357      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     3358      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     3359      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3360      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     3361      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     3362      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     3363      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     3364      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     3365      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     3366      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     3367      define variable v-par-type as character no-undo.
     3368      define variable v-par-val  as character no-undo.
     3369      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3370      define buffer marking               for marking.
     3371      define buffer utd-lines             for utd-lines.
     3372      define buffer buf_utd-lines         for utd-lines.
     3373      define buffer utd-marking-lines     for utd-marking-lines.
     3374      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3375      define variable vGdsCode as integer no-undo.
     3376      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     3377      block-line:
     3378      for each utd-lines where utd-lines.db-num eq idb-num
     3379                           and utd-lines.doc-id eq idoc-id
     3380      no-lock:
     3381         vGdsCode = ?.
     3382         define variable Vflagmark as logical no-undo.
     3383         define variable VflagOAD  as logical no-undo.
     3384         assign
     3385            Vflagmark = no
     3386            VflagOAD = no
     3387         .
     3388         block-mark:
     3389         for each utd-marking-lines
     3390                  where utd-marking-lines.db-num  = utd-lines.db-num
     3391                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3392                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3393         no-lock:
     3394            if    isMark(utd-marking-lines.mark)
     3395               or isOAD (utd-marking-lines.mark)
     3396            then do:
     3397               define variable vnewGdsCode as integer no-undo.
     3398               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     3399               if isMark(utd-marking-lines.mark)
     3400               then do:
     3401                  Vflagmark = yes.
     3402                  find first marking where marking.mark eq utd-marking-lines.mark
     3403                  no-lock no-error.
     3404                  if not available marking
     3405                  then do:
     3406                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     3407                     next block-mark.
     3408                  end.
     3409                  if vnewGdsCode eq ?
     3410                  then
     3411                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     3412                  if    marking.gds-code eq 0
     3413                     or marking.gds-code eq ?
     3414                     or marking.sts eq 0
     3415                     or marking.sts eq ?
     3416                     or marking.box-qnty eq ?
     3417                     or (marking.gds-code ne vnewGdsCode
     3418                         and vnewGdsCode ne ?
     3419                         and vnewGdsCode ne 0)
     3420                  then do:
     3421                     find first marking where marking.mark eq utd-marking-lines.mark
     3422                     exclusive-lock no-error.
     3423                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     3424                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     3425                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     3426                     if    marking.gds-ext-id eq ""
     3427                        or marking.gds-ext-id eq ?
     3428                     then do:
     3429                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     3430                     end.
     3431                     else if    marking.gds-code eq 0
     3432                             or marking.gds-code eq ?
     3433                     then
     3434                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     3435                     else if     marking.sts eq 0
     3436                             or  marking.sts eq ?
     3437                     then
     3438                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     3439                  end.
     3440                  if utd-marking-lines.doc-level eq 1
     3441                  then do:
     3442                     if marking.box-qnty eq ?
     3443                     then
     3444                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3445                  end.
     3446               end.
     3447               else do:
     3448                  VflagOAD = yes.
     3449                  define variable vQnty as decimal no-undo.
     3450                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     3451                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     3452                                          utd-marking-lines.doc-id,
     3453                                          utd-marking-lines.LineNum,
     3454                                          utd-marking-lines.mark,
     3455                                          "box-qnty",
     3456                                           string(vQnty)).
     3457                  define variable vgtin as character no-undo.
     3458                  vgtin = getGtinByDM(utd-marking-lines.mark).
     3459                  if getQntyCodeByGtin(vgtin) ne 1
     3460                  then
     3461                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     3462               end.
     3463               if utd-marking-lines.gds-code ne vnewGdsCode
     3464               and vnewGdsCode ne ?
     3465               and vnewGdsCode ne 0
     3466               then do:
     3467                  find first buf_utd-marking-lines
     3468                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3469                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3470                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3471                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3472                  exclusive-lock no-error.
     3473                  if available buf_utd-marking-lines
     3474                  then do:
     3475                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     3476                  end.
     3477               end.
     3478            end.
     3479            else  do:
     3480               define variable vgdsbar as integer no-undo.
     3481               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     3482               if    utd-marking-lines.gds-code ne vgdsbar
     3483               then do:
     3484                  find first buf_utd-marking-lines
     3485                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3486                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3487                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3488                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3489                  exclusive-lock no-error.
     3490                  if available buf_utd-marking-lines
     3491                  then do:
     3492                     buf_utd-marking-lines.gds-code = vgdsbar.
     3493                  end.
     3494               end.
     3495               if vgdsbar ne ?
     3496               then do:
     3497                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3498                            ( vgdsbar,
     3499                              'mark-type':U,
     3500                              output v-par-val,
     3501                              output v-par-type
     3502                             ).
     3503                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     3504                       or  EDOParSec:GetIsArticForType(v-par-val))
     3505                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     3506                   and     EDOParSec:IsEdo
     3507                  then do:
     3508                     AddUtdErr(utd-marking-lines.db-num,
     3509                               utd-marking-lines.doc-id,
     3510                               buffer utd-marking-lines:handle,
     3511                               iErrType,
     3512                               "MarkingForTypeEDO",
     3513                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3514                  end.
     3515               end.
     3516            end.
     3517            if vGdsCode eq ?
     3518            then
     3519               vGdsCode = utd-marking-lines.gds-code.
     3520            if vGdsCode ne utd-marking-lines.gds-code
     3521            and utd-marking-lines.gds-code > 0
     3522            then do:
     3523               vGdsCode = -1.
     3524            end.
     3525         end.
     3526         if  vGdsCode = -1
     3527         then do:
     3528            vGdsCode = ?.
     3529            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     3530            next block-line.
     3531         end.
     3532         if vGdsCode ne ?
     3533         then do:
     3534                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3535                      ( vGdsCode,
     3536                        'mark-type':U,
     3537                        output v-par-val,
     3538                        output v-par-type
     3539                       ).
     3540            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     3541                and(
     3542                 (    EDOParSec:GetIsEDOForType(v-par-val)
     3543                     and not Vflagmark)
     3544                 or  (EDOParSec:GetIsArticForType(v-par-val)
     3545                     and not VflagOAD
     3546                     and not Vflagmark))
     3547            then do:
     3548               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     3549            end.
     3550         end.
     3551         if utd-lines.gds-code ne vGdsCode
     3552         then do:
     3553            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3554                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3555                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     3556            exclusive-lock no-error.
     3557            if available buf_utd-lines
     3558            then
     3559               buf_utd-lines.gds-code = vGdsCode.
     3560            release buf_utd-lines.
     3561         end.
     3562         define variable VBarCode as character no-undo.
     3563         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     3564         if VBarCode ne ?
     3565         then do:
     3566            if num-entries(VBarCode," ") > 0
     3567            then
     3568               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     3569            vgdsbar = GetGdsCodeByGtin(VBarCode).
     3570            if vgdsbar eq ? or vgdsbar eq 0
     3571            then do:
     3572               AddUtdErr(utd-lines.db-num,
     3573                         utd-lines.doc-id,
     3574                         buffer utd-lines:handle,
     3575                         iErrType,
     3576                         "NotFindGdsForBarCode",
     3577                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     3578            end.
     3579            else do:
     3580               if    utd-lines.gds-code eq ?
     3581                  or utd-lines.gds-code eq 0
     3582               then do:
     3583                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3584                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3585                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3586                  exclusive-lock no-error.
     3587                  if available buf_utd-lines
     3588                  then
     3589                     buf_utd-lines.gds-code = vgdsbar.
     3590                  release buf_utd-lines.
     3591               end.
     3592               else if utd-lines.gds-code ne vgdsbar
     3593               then do:
     3594                  AddUtdErr(utd-lines.db-num,
     3595                         utd-lines.doc-id,
     3596                         buffer utd-lines:handle,
     3597                         iErrType,
     3598                         "NotEqGgsForLineAndMark",
     3599                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     3600               end.
     3601            end.
     3602         end.
     3603         if vGdsCode eq ? and utd-lines.gds-code eq ?
     3604         then
     3605            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     3606      end.
     3607   end.
     3608   function GetUtdLineForOrig return logical
     3609   (input idb-num as integer,
     3610    input idoc-id as integer,
     3611    input ilineNum as integer,
     3612    input idb-numOrig as integer,
     3613    input idoc-idOrig as integer,
     3614    buffer edoc-lines for utd-lines):
     3615      define buffer edoc-marking-lines for ub.utd-marking-lines.
     3616      block-mark:
     3617      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     3618                                   and utd-marking-lines.doc-id  eq idoc-id
     3619                                   and utd-marking-lines.LineNum eq iLineNum
     3620                                   and utd-marking-lines.site eq "-"
     3621      no-lock:
     3622         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     3623                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     3624                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     3625                     no-lock no-error.
     3626         if available edoc-marking-lines
     3627         then do:
     3628            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     3629                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     3630                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     3631            no-lock no-error.
     3632               leave block-mark.
     3633          end.
     3634      end.
     3635       if not available edoc-lines
     3636       then do:
     3637          find  first  utd-lines where utd-lines.db-num      = idb-num
     3638                                   and utd-lines.doc-id      = idoc-id
     3639                                   and utd-lines.LineNum     = ilinenum
     3640             no-lock no-error.
     3641          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3642                                  and edoc-lines.doc-id      = idoc-idOrig
     3643                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     3644          no-lock no-error.
     3645       end.
     3646       if not available edoc-lines
     3647       then
     3648          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3649                                  and edoc-lines.doc-id      = idoc-idOrig
     3650                                  and edoc-lines.gds-code    = utd-lines.gds-code
     3651          no-lock no-error.
     3652   end.
     3653   function GetLastUTDinPack returns logical
     3654   (input idb-num as integer,
     3655    input idoc-id as integer,
     3656    output odb-num as integer,
     3657    output odoc-id as integer ) forward.
     3658   function getObgFns return logical
     3659   (input iDocumentNumber   as character ,
     3660    input iFnsParticipantId as character ,
     3661    input ikpp              as character ,
     3662    output ohost-code       as integer,
     3663    output oobj-type        as character ,
     3664    output oobj-code        as integer ,
     3665    output otext            as character  ):
     3666       define buffer ext-classif   for ext-classif.
     3667       define buffer clients       for clients.
     3668       define buffer buf_clients   for clients.
     3669       define buffer clients-attr  for clients-attr.
     3670       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3671                                and ext-classif.charkey_three eq iFnsParticipantId
     3672       no-lock no-error.
     3673       if available ext-classif
     3674       then do:
     3675          if ext-classif.CharKey_One eq 'маг':U
     3676          then do:
     3677             assign
     3678                oobj-type = ext-classif.CharKey_One
     3679                oobj-code = ext-classif.Key#_One
     3680             .
     3681             find first clients
     3682                  where clients.obj-type   = ext-classif.CharKey_One
     3683                    and clients.obj-code   = ext-classif.Key#_One
     3684             no-lock no-error .
     3685             if available clients
     3686             then
     3687                ohost-code =  clients.host-code.
     3688          end.
     3689          else do:
     3690             find first clients
     3691                  where clients.obj-type   = ext-classif.CharKey_One
     3692                    and clients.obj-code   = ext-classif.Key#_One
     3693                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     3694             no-lock no-error .
     3695             if not available clients
     3696             then do:
     3697                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     3698                return no.
     3699             end.
     3700             ohost-code = ext-classif.Key#_One.
     3701             block-cl:
     3702             for each clients-attr
     3703                where clients-attr.attr-code  = 'kpp':U
     3704                  and clients-attr.obj-type   = 'маг':U
     3705                  and clients-attr.attr-value = ikpp
     3706                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     3707                                             and buf_clients.obj-code   = clients-attr.obj-code
     3708                                             and buf_clients.host-code  = ohost-code)
     3709             no-lock :
     3710                leave block-cl.
     3711             end.
     3712             if     available clients
     3713                and clients.obj-type eq 'маг':U
     3714             then do:
     3715                assign
     3716                   oobj-type = clients.obj-type
     3717                   oobj-code = clients.obj-code
     3718                .
     3719             end.
     3720             else if available clients-attr
     3721             then do:
     3722                assign
     3723                   oobj-type = clients-attr.obj-type
     3724                   oobj-code = clients-attr.obj-code
     3725                .
     3726             end.
     3727             else do:
     3728                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     3729                return yes.
     3730             end.
     3731          end.
     3732       end.
     3733       else do:
     3734          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     3735          return no.
     3736       end.
     3737       return ?.
     3738   end.
     3739   function CheckUcdForReturn return logical
     3740   (input idb-numUcd as integer,
     3741    input idoc-idUcd as integer,
     3742    input idb-numRet as integer,
     3743    input idoc-idRet as integer  ):
     3744       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     3745                                    and utd-marking-lines.doc-id eq idoc-idUcd
     3746                                    and utd-marking-lines.doc-level eq 1
     3747       no-lock:
     3748          create tt-utd-mark.
     3749          buffer-copy utd-marking-lines to tt-utd-mark
     3750          assign
     3751             tt-utd-mark.side = "+"
     3752          .
     3753       end.
     3754       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     3755                                    and utd-marking-lines.doc-id eq idoc-idRet
     3756                                    and utd-marking-lines.doc-level eq 1
     3757       no-lock:
     3758          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     3759          no-lock no-error.
     3760          if available tt-utd-mark
     3761          then
     3762             tt-utd-mark.side = "".
     3763          else do:
     3764             create tt-utd-mark.
     3765             buffer-copy utd-marking-lines to tt-utd-mark
     3766             assign
     3767                tt-utd-mark.side = "-"
     3768             .
     3769          end.
     3770       end.
     3771       for each tt-utd-mark where  tt-utd-mark.side ne ""
     3772       no-lock:
     3773          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     3774       end.
     3775       for each tt-utd-mark:
     3776          delete tt-utd-mark.
     3777       end.
     3778   end.
     3779   function GetLastUTDinPackAft returns logical
     3780   (input idb-num as integer,
     3781    input idoc-id as integer,
     3782    output odb-num as integer,
     3783    output odoc-id as integer ) forward.
     3784   function SaturateAndCheckUTD return character
     3785   (input idb-num as integer,
     3786    input idoc-id as integer  ):
     3787      define buffer clients-attr          for clients-attr.
     3788      define buffer clients               for clients.
     3789      define buffer Utd                   for Utd.
     3790      define buffer utd_ret               for ub.utd.
     3791      define buffer utd-lines             for utd-lines.
     3792      define buffer buf_utd-lines         for utd-lines.
     3793      define buffer buf_utddoc-lines      for utd-lines.
     3794      define buffer marking               for marking.
     3795      define buffer marking-lines         for marking-lines.
     3796      define buffer utd-marking-lines     for utd-marking-lines.
     3797      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3798      define buffer contract              for contract.
     3799      define buffer old_utd               for Utd.
     3800      define variable vError as character no-undo.
     3801      define variable vGdsCode as integer no-undo.
     3802      define variable vcli-type as character no-undo.
     3803      define variable vcli-code as integer no-undo.
     3804      define variable vhost-code as integer no-undo init ?.
     3805      define variable vcontract-code as integer no-undo.
     3806      define variable vobj-type as character no-undo init ?.
     3807      define variable vobj-code as integer no-undo init ?.
     3808      define variable volddb-num as integer no-undo.
     3809      define variable volddoc-id as integer no-undo.
     3810      define variable vMark as logical no-undo.
     3811      define variable VUcd as logical no-undo.
     3812      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3813      define variable v-par-type as character no-undo.
     3814      define variable v-par-val  as character no-undo.
     3815      define variable VFileMark as logical no-undo.
     3816      define variable vunit     as int no-undo.
     3817      define variable vunitCode as character no-undo.
     3818      define variable vMarkingUtd as logical no-undo.
     3819      find first Utd where utd.db-num eq idb-num
     3820                       and utd.doc-id eq idoc-id
     3821      no-lock no-error.
     3822      if available Utd
     3823      then do:
     3824         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     3825         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     3826         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     3827         assign
     3828               vobj-type  = utd.obj-type
     3829               vobj-code  = utd.obj-code
     3830               vhost-code = utd.host-code
     3831         .
     3832         do:
     3833            define variable vtext       as character no-undo.
     3834            define variable vhost-code1 as integer   no-undo.
     3835            define variable vobj-type1  as character no-undo.
     3836            define variable vobj-code1  as integer   no-undo.
     3837             getObgFns
     3838                       (input utd.DocumentNumber ,
     3839                        input utd.obj-FnsParticipantId ,
     3840                        input utd.obj-kpp,
     3841                        output vhost-code1,
     3842                        output vobj-type1,
     3843                        output vobj-code1,
     3844                        output vtext ).
     3845            assign
     3846               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     3847               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     3848               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     3849            .
     3850            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     3851            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     3852            block-line:
     3853            for each utd-lines where utd-lines.db-num eq utd.db-num
     3854                                 and utd-lines.doc-id eq utd.doc-id
     3855            no-lock:
     3856               vGdsCode =?.
     3857               define variable vNotMarkForLine as logical no-undo.
     3858               vNotMarkForLine = no.
     3859               if not VUcd
     3860               then do:
     3861                  find first utd-marking-lines
     3862                       where utd-marking-lines.db-num  = utd-lines.db-num
     3863                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     3864                         and utd-marking-lines.LineNum = utd-lines.LineNum
     3865                  no-lock no-error.
     3866                  if not available utd-marking-lines
     3867                  then do:
     3868                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     3869                     vNotMarkForLine = yes.
     3870                  end.
     3871               end.
     3872               block-mark:
     3873               for each utd-marking-lines
     3874                  where utd-marking-lines.db-num  = utd-lines.db-num
     3875                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3876                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3877               no-lock:
     3878                  vMark = yes.
     3879                  if     isMark(utd-marking-lines.mark)
     3880                     and utd-marking-lines.gds-code  ne 0
     3881                     and utd-marking-lines.gds-code ne ?
     3882                  then do:
     3883                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3884                           ( utd-marking-lines.gds-code,
     3885                            'mark-type':U,
     3886                            output v-par-val,
     3887                            output v-par-type
     3888                            ).
     3889                      if     not VFileMark
     3890                         and not VUcd
     3891                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     3892                      then do:
     3893                          AddUtdErr(utd.db-num,
     3894                                     utd.doc-id,
     3895                                     buffer utd-marking-lines:handle,
     3896                                     "loadUtd",
     3897                                     "NotON_NSCHFDOPPRMARK",
     3898                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3899                     end.
     3900                  end.
     3901               end.
     3902               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     3903               then do :
     3904                  if     VUcd
     3905                  then do:
     3906                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     3907                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     3908                     if available buf_utddoc-lines
     3909                     then do:
     3910                        vGdsCode = buf_utddoc-lines.gds-code.
     3911                        vunitCode = buf_utddoc-lines.UnitCode.
     3912                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     3913                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3914                        then
     3915                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3916                               "loadUtd",
     3917                               "UcdUnitChangForUtd",
     3918                               string(utd-lines.LineNum )                  + chr(4) +
     3919                               buf_utddoc-lines.UnitCode                   + chr(4) +
     3920                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3921                     end.
     3922                     if     utd-lines.UnitCode ne ?
     3923                        and utd-lines.UnitCode ne ""
     3924                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3925                     then
     3926                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3927                               "loadUtd",
     3928                               "UcdUnitChang",
     3929                               string(utd-lines.LineNum )                  + chr(4) +
     3930                               utd-lines.UnitCode                          + chr(4) +
     3931                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3932                  end.
     3933               end.
     3934               else
     3935                  vGdsCode = utd-lines.gds-code.
     3936               define variable vValText as character no-undo.
     3937               define variable vValDec  as decimal no-undo.
     3938               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     3939               if VValText = ?
     3940               then do:
     3941                  vValDec = utd-lines.Quantity.
     3942                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     3943               end.
     3944               else
     3945                  vValDec = dec(VValText).
     3946               release bar-code .
     3947               if     vGdsCode > 0 and vGdsCode ne ?
     3948               then do:
     3949                  assign
     3950                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     3951                     vunit = ?
     3952                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     3953                  no-error.
     3954                  if vunit ne 0 and vunit ne ?
     3955                  then do:
     3956                     find units where units.OKEI eq vunit no-lock no-error.
     3957                     if available units
     3958                     then
     3959                        vunitCode = units.unit-name.
     3960                  end.
     3961                  find first bar-code where bar-code.gds-code eq vGdsCode
     3962                                        and bar-code.unit-cli eq vUnitCode
     3963                  no-lock no-error.
     3964                  if not available bar-code
     3965                  then
     3966                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3967                               "loadUtd",
     3968                               "Unit",
     3969                               string(utd-lines.LineNum )                  + chr(4) +
     3970                               string(vGdsCode)                            + chr(4) +
     3971                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     3972                               vunitCode).
     3973               end.
     3974               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     3975               then do:
     3976                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3977                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3978                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3979                  exclusive-lock no-error.
     3980                  if available buf_utd-lines
     3981                  then do:
     3982                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     3983                     release buf_utd-lines.
     3984                  end.
     3985               end.
     3986               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     3987               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     3988               if     not VUcd
     3989                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     3990               then
     3991                  vMarkingUtd = yes .
     3992            end.
     3993            if not VUcd
     3994            then
     3995               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     3996            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3997                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     3998            no-lock no-error.
     3999            if available ext-classif
     4000            then
     4001               assign
     4002                  vcli-type = ext-classif.CharKey_One
     4003                  vcli-code = ext-classif.Key#_One
     4004               .
     4005            else do:
     4006               assign
     4007                 vcli-type = ?
     4008                 vcli-code = ?
     4009               .
     4010               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     4011            end.
     4012            find first contract  where contract.host-code eq vhost-code
     4013                                   and contract.cli-type  eq vcli-type
     4014                                   and contract.cli-code  eq vcli-code
     4015                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     4016            no-lock no-error.
     4017            define variable VContractEdo as logical no-undo init yes.
     4018            if available contract
     4019            then do:
     4020               assign
     4021                  VContractEdo = contract.whole-send-news > 0
     4022                  vcontract-code = contract.contract-code
     4023               .
     4024               if not VContractEdo
     4025               then
     4026                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     4027            end.
     4028            else do:
     4029               vcontract-code = ?.
     4030            end.
     4031         end.
     4032         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     4033         then do:
     4034            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     4035         end.
     4036         define variable vdoc-code as character no-undo init ?.
     4037         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4038         then do:
     4039            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4040                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4041                                 and utd_ret.Timestamp             le utd.Timestamp
     4042                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4043            no-lock no-error.
     4044            if available utd_ret
     4045            then do:
     4046               vdoc-code = utd_ret.doc-code.
     4047               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     4048            end.
     4049         end.
     4050      end.
     4051      find current utd exclusive-lock no-error.
     4052      if available utd
     4053      then do:
     4054         assign
     4055            utd.cli-type      = vcli-type      when vcli-type      ne ?
     4056            utd.cli-code      = vcli-code      when vcli-type      ne ?
     4057            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     4058            utd.contract-code = vcontract-code when vcontract-code ne ?
     4059            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     4060            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     4061            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     4062         .
     4063         if   ( utd.contract-code eq ?
     4064            or utd.contract-code eq 0)
     4065            and not vucd
     4066         then
     4067            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     4068         if utd.host-code eq ?
     4069            or utd.host-code eq 0
     4070         then
     4071            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     4072         if utd.obj-code eq ?
     4073            or utd.obj-code eq 0
     4074         then
     4075            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     4076      end.
     4077      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     4078      if vError eq ""
     4079      then do:
     4080         if utd.sts eq 0 or utd.sts eq ?
     4081         then
     4082            utd.sts = if VUcd
     4083                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     4084                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4085         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     4086         then do:
     4087            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4088         end.
     4089         if     not VUcd
     4090            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     4091         then do:
     4092            if not vMarkingUtd
     4093            then
     4094               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     4095         end.
     4096      end.
     4097      else do:
     4098         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     4099         then
     4100            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     4101      end.
     4102      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4103         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     4104      then
     4105         utd.sts-edi = ?.
     4106      else if     (not vMark and  not vucd) or not VContractEdo
     4107              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     4108      then
     4109         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     4110      release utd no-error.
     4111      if error-status:error
     4112      then
     4113         return error return-value.
     4114      return vError.
     4115   end.
     4116   function ReCheckload returns logical
     4117   (idb-num as integer,
     4118    idoc-id as integer,
     4119    iload   as logical ):
     4120      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4121      define buffer buf_c-utd for ub.c-utd .
     4122      define buffer buf_utd   for ub.utd .
     4123      find first buf_utd where buf_utd.db-num eq idb-num
     4124                           and buf_utd.doc-id eq idoc-id
     4125      exclusive-lock no-error.
     4126      if available buf_utd
     4127      then do:
     4128         if    iload
     4129            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     4130         then do:
     4131            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     4132            if  error-status:error then
     4133            do:
     4134               message return-value view-as alert-box.
     4135            end.
     4136         end.
     4137         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4138            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4139            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     4140            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     4141         then do:
     4142            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     4143                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     4144                                              buf_c-utd.sts    eq buf_utd.sts and
     4145                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     4146            no-error .
     4147            if available (buf_c-utd)
     4148            then do:
     4149               buf_utd.sts = buf_c-utd.sts .
     4150               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4151            end.
     4152            else do:
     4153               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4154                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4155               then
     4156                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4157               else
     4158                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4159               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4160            end.
     4161         end.
     4162         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4163         then do:
     4164            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4165                                     input buf_utd.doc-id) .
     4166         end.
     4167      end.
     4168      release buf_utd.
     4169      unsubscribe "getNextseq".
     4170   end.
     4171   function ReCheck returns logical
     4172   (idb-num as integer,
     4173    idoc-id as integer ):
     4174      ReCheckload(idb-num,idoc-id,no).
     4175   end.
     4176   function GetLastUTDForPac returns logical
     4177   (iPackegeId as character ,
     4178    iTimestamp as datetime,
     4179    output odb-num as integer,
     4180    output odoc-id as integer ):
     4181      define buffer buf_utd for utd.
     4182      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4183                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4184                                and Buf_utd.Timestamp gt iTimestamp
     4185      no-lock no-error.
     4186      if available  buf_utd
     4187      then
     4188         assign
     4189            odb-num = buf_utd.db-num
     4190            odoc-id = buf_utd.doc-id
     4191         no-error.
     4192      else
     4193         assign
     4194            odb-num = ?
     4195            odoc-id = ?
     4196         no-error.
     4197   end.
     4198   function GetprevUTDForPac returns logical
     4199   (iPackegeId as character ,
     4200    iTimestamp as datetime,
     4201    output odb-num as integer,
     4202    output odoc-id as integer ):
     4203      define buffer buf_utd for utd.
     4204      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4205                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4206                                and Buf_utd.Timestamp < iTimestamp
     4207      no-lock no-error.
     4208      if available  buf_utd
     4209      then
     4210         assign
     4211            odb-num = buf_utd.db-num
     4212            odoc-id = buf_utd.doc-id
     4213         no-error.
     4214      else
     4215         assign
     4216            odb-num = ?
     4217            odoc-id = ?
     4218         no-error.
     4219   end.
     4220   function GetLastUTDinPackAft returns logical
     4221   (input idb-num as integer,
     4222    input idoc-id as integer,
     4223    output odb-num as integer,
     4224    output odoc-id as integer ):
     4225      define buffer buf_utd for utd.
     4226      define buffer     utd for utd.
     4227      find first utd where utd.db-num eq idb-num
     4228                       and utd.doc-id eq idoc-id
     4229      no-lock no-error.
     4230      if available utd
     4231      then do:
     4232         if utd.PackageId eq ""
     4233         then do:
     4234            assign
     4235               odb-num = utd.db-num
     4236               odoc-id = utd.doc-id
     4237            .
     4238            return yes.
     4239         end.
     4240         else do:
     4241            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4242            if    odb-num eq ?
     4243               or odoc-id eq ?
     4244            then do:
     4245               assign
     4246                  odb-num = utd.db-num
     4247                  odoc-id = utd.doc-id
     4248               .
     4249               return yes.
     4250            end.
     4251            else
     4252               return odoc-id = utd.doc-id.
     4253         end.
     4254      end.
     4255      return ?.
     4256   end.
     4257   function GetLastUTDinPackbef returns logical
     4258   (input idb-num as integer,
     4259    input idoc-id as integer,
     4260    output odb-num as integer,
     4261    output odoc-id as integer ):
     4262      define buffer buf_utd for utd.
     4263      define buffer     utd for utd.
     4264      find first utd where utd.db-num eq idb-num
     4265                       and utd.doc-id eq idoc-id
     4266      no-lock no-error.
     4267      if available utd
     4268      then do:
     4269         if utd.PackageId eq ""
     4270         then do:
     4271            assign
     4272               odb-num = utd.db-num
     4273               odoc-id = utd.doc-id
     4274            .
     4275            return yes.
     4276         end.
     4277         else do:
     4278            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4279            if    odb-num eq ?
     4280               or odoc-id eq ?
     4281            then do:
     4282               assign
     4283                  odb-num = utd.db-num
     4284                  odoc-id = utd.doc-id
     4285               .
     4286               return yes.
     4287            end.
     4288            else
     4289               return odoc-id = utd.doc-id.
     4290         end.
     4291      end.
     4292      return ?.
     4293   end.
     4294   function GetLastUTDinPack returns logical
     4295   (input idb-num as integer,
     4296    input idoc-id as integer,
     4297    output odb-num as integer,
     4298    output odoc-id as integer ):
     4299      define buffer buf_utd for utd.
     4300      define buffer     utd for utd.
     4301      find first utd where utd.db-num eq idb-num
     4302                       and utd.doc-id eq idoc-id
     4303      no-lock no-error.
     4304      if available utd
     4305      then do:
     4306         if utd.PackageId eq ""
     4307         then do:
     4308            assign
     4309               odb-num = utd.db-num
     4310               odoc-id = utd.doc-id
     4311            .
     4312            return yes.
     4313         end.
     4314         else do:
     4315            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     4316            if    odb-num eq ?
     4317               or odoc-id eq ?
     4318            then do:
     4319               assign
     4320                  odb-num = utd.db-num
     4321                  odoc-id = utd.doc-id
     4322               .
     4323               return yes.
     4324            end.
     4325            else
     4326               return odoc-id = utd.doc-id.
     4327         end.
     4328      end.
     4329      return ?.
     4330   end.
     4331   function delMark returns logical
     4332   ( buffer utd-marking-lines for utd-marking-lines ):
     4333      define buffer buf_utd-marking-line for utd-marking-lines.
     4334      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4335         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4336                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4337                                           and buf_utd-marking-line.mark      eq marking.mark
     4338         no-lock no-error.
     4339         if available  buf_utd-marking-line
     4340         then do:
     4341            delMark(buffer buf_utd-marking-line).
     4342            delete buf_utd-marking-line.
     4343         end.
     4344      end.
     4345   end.
     4346   function addMark returns logical
     4347   ( buffer utd-marking-lines for utd-marking-lines ):
     4348      define buffer buf_utd-marking-line for utd-marking-lines.
     4349      define buffer par_utd-marking-line for utd-marking-lines.
     4350      define buffer buf_utd for ub.utd .
     4351      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4352         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4353                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4354                                           and buf_utd-marking-line.mark      eq marking.mark
     4355         no-lock no-error.
     4356         if available  buf_utd-marking-line
     4357         then do:
     4358            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     4359            then do:
     4360               find current  buf_utd-marking-line exclusive-lock no-error.
     4361               if available buf_utd-marking-line
     4362               then
     4363                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     4364            end.
     4365         end.
     4366         else do:
     4367            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     4368                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     4369                                         no-error .
     4370            create buf_utd-marking-line.
     4371            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     4372            assign
     4373               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     4374               buf_utd-marking-line.mark      = marking.mark
     4375               buf_utd-marking-line.gds-code  = marking.Gds-code
     4376               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     4377                                               then marking.sts
     4378                                               else
     4379                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     4380                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     4381                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     4382                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     4383                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4384                                                else marking.sts
     4385            .
     4386            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     4387            do:
     4388              for first par_utd-marking-line no-lock where
     4389                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     4390                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     4391                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     4392                    and par_utd-marking-line.mark    = marking.mark-parent
     4393                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4394              :
     4395                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     4396              end.
     4397            end.
     4398         end.
     4399         addMark(buffer buf_utd-marking-line).
     4400      end.
     4401   end.
     4402   function UnLockUTDMarkbuf returns logical
     4403   (buffer old_utd for utd,
     4404    iAll as logical ):
     4405      define variable voldkey    as character no-undo.
     4406         run gen-key-rec (input "utd",
     4407                          input  buffer old_utd:handle,
     4408                          output voldkey).
     4409      for each marking where marking.loc-key eq voldkey
     4410      exclusive-lock:
     4411         if    iAll
     4412            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4413                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     4414         then do:
     4415            marking.loc-key = "".
     4416            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     4417         end.
     4418      end.
     4419   end.
     4420   function UnLockUTDMark returns logical
     4421   (idb-num as integer ,idoc-id as integer ,iall as logical):
     4422      define buffer old_utd for utd.
     4423      find first old_utd where old_utd.db-num eq idb-num
     4424                           and old_utd.db-num eq idoc-id
     4425      no-lock no-error.
     4426      if available old_utd
     4427      then do:
     4428         UnLockUTDMarkbuf(buffer old_utd,iall).
     4429      end.
     4430   end.
     4431   function changSts returns logical
     4432   (idb-num as integer ,
     4433    idoc-id as integer ,
     4434    old_sts_edo as character ,
     4435    new_sts_edo as character  ):
     4436      if     old_sts_edo ne new_sts_edo
     4437         and ( new_sts_edo eq "RevocationAccepted"
     4438              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     4439              )
     4440      then
     4441         UnLockUTDMark(idb-num,idoc-id,yes).
     4442      if     old_sts_edo ne new_sts_edo
     4443         and ( new_sts_edo eq "WithRecipientSignature"
     4444           or  new_sts_edo eq "WithRecipientPartiallySignature"
     4445              )
     4446      then
     4447         UnLockUTDMark(idb-num,idoc-id,no).
     4448   end.
     4449   function SetLockUTDMark returns logical
     4450   (idb-num as integer ,idoc-id as integer ):
     4451      define buffer new_utd for utd.
     4452      define buffer old_utd for utd.
     4453      define variable volddb-num as integer no-undo.
     4454      define variable volddoc-id as integer no-undo.
     4455      define variable voldkey    as character no-undo.
     4456      define variable vnewkey    as character no-undo.
     4457      find first new_utd where new_utd.db-num eq idb-num
     4458                           and new_utd.doc-id eq idoc-id
     4459      no-lock no-error.
     4460      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     4461      then do trans:
     4462         find first old_utd where old_utd.db-num eq volddb-num
     4463                              and old_utd.doc-id eq volddoc-id
     4464         no-lock no-error.
     4465            run gen-key-rec (input "utd",
     4466                             input  buffer new_utd:handle,
     4467                             output vnewkey).
     4468            run gen-key-rec (input "utd",
     4469                             input  buffer old_utd:handle,
     4470                             output voldkey).
     4471         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     4472                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     4473         no-lock:
     4474            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     4475            if available  marking
     4476            then do:
     4477               if    marking.loc-key eq ""
     4478                  or marking.loc-key eq ?
     4479                  or marking.loc-key eq voldkey
     4480               then do:
     4481                  find current marking exclusive-lock no-error.
     4482                  if available marking
     4483                  then do:
     4484                     marking.loc-key = vnewkey.
     4485                     release marking.
     4486                  end.
     4487               end.
     4488               else if marking.loc-key ne vnewkey
     4489               then do:
     4490                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     4491               end.
     4492            end.
     4493         end.
     4494         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     4495      end.
     4496   end.
     4497   if new-utd-marking-lines.gds-code eq 0
     4498   then
     4499      new-utd-marking-lines.gds-code = ?.
     4500   if     not g#news
     4501      and new new-utd-marking-lines
     4502      and new-utd-marking-lines.doc-level eq 1
     4503   then
     4504      addMark(buffer new-utd-marking-lines ).
     4505   if     g#esys
     4506      and new new-utd-marking-lines
     4507   then do:
     4508     for first marking where
     4509               marking.mark = new-utd-marking-lines.mark
     4510         no-lock:
     4511       if can-do(objSrv:Env:Marking:Sts:Mark:EqualChecked,string(marking.sts)) then
     4512         new-utd-marking-lines.sts = marking.sts.
     4513     end.
     4514   end.
     4515   define buffer buf_c-utd-head for ub.c-utd-head .
     4516         buffer-compare new-utd-marking-lines to old-utd-marking-lines case-sensitive save result in v-field-chg.
     4517         if v-field-chg > "":U then . else return .
     4518         run cur-time in this-procedure (output v-date, output v-time).
     4519       publish "getNextseq" ("utd-marking-lines","s-c-utd-chip-num", "ub", output v-Seq ).
     4520       if v-Seq = ?
     4521       then
     4522          v-Seq  = next-value (s-c-utd-chip-num, ub).
     4523       else
     4524          vFlagSeq = yes.
     4525       if vFlagSeq
     4526       then do:
     4527                        if new(new-utd-marking-lines)
     4528          then do:
     4529    for first buf_c-utd-marking-lines where buf_c-utd-marking-lines.db-num eq new-utd-marking-lines.db-num
     4530   and buf_c-utd-marking-lines.doc-id eq new-utd-marking-lines.doc-id
     4531   and buf_c-utd-marking-lines.LineNum eq new-utd-marking-lines.LineNum
     4532   and buf_c-utd-marking-lines.mark eq new-utd-marking-lines.mark
     4533     and buf_c-utd-marking-lines.corr-user-db-num   = g#db-num and buf_c-utd-marking-lines.chip-num = v-Seq exclusive-lock: leave. end.
     4534          end.
     4535          else do:
     4536    for first buf_c-utd-marking-lines where buf_c-utd-marking-lines.db-num eq old-utd-marking-lines.db-num
     4537   and buf_c-utd-marking-lines.doc-id eq old-utd-marking-lines.doc-id
     4538   and buf_c-utd-marking-lines.LineNum eq old-utd-marking-lines.LineNum
     4539   and buf_c-utd-marking-lines.mark eq old-utd-marking-lines.mark
     4540     and buf_c-utd-marking-lines.corr-user-db-num   = g#db-num and buf_c-utd-marking-lines.chip-num = v-Seq exclusive-lock: leave. end.
     4541          end.
     4542       end.
     4543      if new(new-utd-marking-lines)
     4544      then do:
     4545         if not available buf_c-utd-marking-lines
     4546         then do:
     4547            create buf_c-utd-marking-lines.
     4548         buffer-copy new-utd-marking-lines to buf_c-utd-marking-lines
     4549         assign
     4550            buf_c-utd-marking-lines.chip-num           = v-Seq
     4551            buf_c-utd-marking-lines.corr-date          = v-date
     4552            buf_c-utd-marking-lines.corr-time          = v-time
     4553            buf_c-utd-marking-lines.corr-user-db-num   = g#db-num
     4554            buf_c-utd-marking-lines.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
     4555            buf_c-utd-marking-lines.action             = 1
     4556            buf_c-utd-marking-lines.is-del             = false
     4557         .
     4558         end.
     4559         else
     4560            if buf_c-utd-marking-lines.action eq 99
     4561            then
     4562               buf_c-utd-marking-lines.action = 2.
     4563      end.
     4564      else do:
     4565         if not available buf_c-utd-marking-lines
     4566         then do:
     4567            create buf_c-utd-marking-lines.
     4568            buffer-copy old-utd-marking-lines to buf_c-utd-marking-lines
     4569            assign
     4570               buf_c-utd-marking-lines.chip-num           = v-Seq
     4571               buf_c-utd-marking-lines.corr-date          = v-date
     4572               buf_c-utd-marking-lines.corr-time          = v-time
     4573               buf_c-utd-marking-lines.corr-user-db-num   = g#db-num
     4574               buf_c-utd-marking-lines.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
     4575               buf_c-utd-marking-lines.action             = 2 when buf_c-utd-marking-lines.action ne 1
     4576               buf_c-utd-marking-lines.is-del             = false
     4577            .
     4578         end.
     4579      end.
     4580         if vFlagSeq
     4581         then do:
     4582            if new(new-utd-marking-lines)
     4583            then do:
     4584    for first buf_c-utd-head where buf_c-utd-head.db-num eq new-utd-marking-lines.db-num
     4585   and buf_c-utd-head.doc-id eq new-utd-marking-lines.doc-id
     4586     and buf_c-utd-head.corr-user-db-num   = g#db-num and buf_c-utd-head.chip-num = v-Seq exclusive-lock: leave. end.
     4587            end.
     4588            else do:
     4589    for first buf_c-utd-head where buf_c-utd-head.db-num eq old-utd-marking-lines.db-num
     4590   and buf_c-utd-head.doc-id eq old-utd-marking-lines.doc-id
     4591     and buf_c-utd-head.corr-user-db-num   = g#db-num and buf_c-utd-head.chip-num = v-Seq exclusive-lock: leave. end.
     4592            end.
     4593         end.
     4594         if not available  buf_c-utd-head
     4595         then do:
     4596            create buf_c-utd-head.
     4597            buffer-copy  buf_c-utd-marking-lines to buf_c-utd-head
     4598            assign
     4599               buf_c-utd-head.subject = "utd-marking-lines"
     4600               buf_c-utd-head.is-news = g#news
     4601               buf_c-utd-head.source-type = (if g#news
     4602                                             then 'db':U
     4603                                             else (if g#esys
     4604                                                   then 'esys':U
     4605                                                   else "":U)
     4606                                             )
     4607               buf_c-utd-head.source-ref = (if g#news
     4608                                            then string(g#news-source-db)
     4609                                            else (if g#esys
     4610                                                  then string(g#esys-source-esys)
     4611                                                  else "":U)
     4612                                            )
     4613            .
     4614         end.
     4615         else do:
     4616            if     buf_c-utd-head.subject ne "*"
     4617            then
     4618               buf_c-utd-head.subject = "*".
     4619            if buf_c-utd-head.action  ne 88
     4620            then
     4621               buf_c-utd-head.action             = 88 .
     4622         end.
