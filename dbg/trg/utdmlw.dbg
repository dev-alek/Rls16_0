        1   block-level on error undo, throw.
        2   trigger procedure for write of ub.utd-marking-lines
        3     new buffer new-utd-marking-lines
        4     old buffer old-utd-marking-lines
        5   .
        6   define variable vss-revision    as character no-undo initial "$Revision$":U .
        7   define variable vss-author      as character no-undo initial "$Author$":U .
        8   define variable vss-date        as character no-undo initial "$Date$":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       10   define variable vss-archive     as character no-undo initial "$Archive$":U .
       11   define variable vss-description as character no-undo init "Тригер изменение utd-marking-lines".
       12   define buffer marking for ub.marking.
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure cur-time :
       84      define output parameter p-today as date      no-undo .
       85      define output parameter p-time  as integer   no-undo .
       86     do
       87     on error undo, return error
       88     :
       89       define variable v-date1 as date      no-undo .
       90       define variable v-date2 as date      no-undo .
       91       define variable v-time  as integer   no-undo .
       92       assign
       93         v-date1 = today
       94         v-time  = time
       95         v-date2 = today
       96       .
       97       if v-date1 <> v-date2
       98       then do:
       99         assign
      100           v-date1 = today
      101           v-time  = v-time
      102         .
      103       end.
      104       assign
      105         p-today = v-date1
      106         p-time  = v-time
      107       .
      108     end.
      109   end.
      110   function cur-time-date returns character
      111   :
      112     return string(today, '99/99/9999':U) .
      113   end.
      114   function cur-time-mjd returns decimal
      115   :
      116     define variable v-date as date      no-undo .
      117     define variable v-time as integer   no-undo .
      118     run cur-time in this-procedure
      119       (output v-date
      120       ,output v-time
      121       ) .
      122     return integer(v-date) - 2400002 + (v-time / 86400) .
      123   end.
      124   function cur-time-get-ending-index returns integer
      125   (input p-number as integer
      126   )
      127   :
      128     if p-number < 0
      129     or p-number = ?
      130     then do:
      131       return 1 .
      132     end.
      133     define variable v-rest as integer   no-undo .
      134     assign
      135       p-number = p-number modulo 100
      136     .
      137     if p-number < 20
      138     then do:
      139       assign
      140         v-rest = p-number
      141       .
      142     end.
      143     else do:
      144       assign
      145         v-rest = p-number modulo 10
      146       .
      147     end.
      148     case v-rest :
      149       when 1
      150       then do:
      151         return 2 .
      152       end.
      153       when 2 or
      154       when 3 or
      155       when 4
      156       then do:
      157         return 3 .
      158       end.
      159       otherwise do:
      160         return 1 .
      161       end.
      162     end case .
      163   end.
      164   procedure cur-time-mjd-to-date :
      165      define input  parameter i-mjd-diff as decimal no-undo.
      166      define output parameter o-Date     as date    no-undo.
      167      define output parameter o-Time     as integer no-undo.
      168      define variable v-day-number as integer   no-undo .
      169      if    i-mjd-diff < 0
      170         or i-mjd-diff = ?
      171      then do:
      172         return "?" .
      173      end.
      174      assign
      175         v-day-number = truncate(i-mjd-diff,0).
      176         o-Date = date(v-day-number + 2400002).
      177         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      178     .
      179   end.
      180   function cur-time-mjd-to-string returns character
      181   (input p-mjd-diff as decimal
      182   )
      183   :
      184     define variable v-day-number as integer   no-undo .
      185     define variable v-seconds    as integer   no-undo .
      186     define variable v-hour       as integer   no-undo .
      187     define variable v-min        as integer   no-undo .
      188     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      189     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      190     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      191     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      192     if p-mjd-diff < 0
      193     or p-mjd-diff = ?
      194     then do:
      195       return "?" .
      196     end.
      197     assign
      198       v-day-number = integer(truncate(p-mjd-diff,0))
      199       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201     if v-seconds > 86400
      202     then do:
      203       assign
      204         v-seconds = 86400 - 1
      205       .
      206     end.
      207     if v-seconds < 0
      208     then do:
      209       assign
      210         v-seconds = 0
      211       .
      212     end.
      213     assign
      214       v-hour = truncate(v-seconds / 3600, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 3600
      218     .
      219     assign
      220       v-min = truncate(v-seconds / 60, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 60
      224     .
      225     return
      226         (if v-day-number <> 0
      227           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0
      231           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      235           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      236           else ""
      237         )
      238       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      239       .
      240   end.
      241   function cur-time-string returns character
      242   :
      243     define variable v-date as date      no-undo .
      244     define variable v-time as integer   no-undo .
      245     run cur-time in this-procedure
      246       (output v-date
      247       ,output v-time
      248       ) .
      249     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      250   end.
      251   function cur-time-string-sec returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      260   end.
      261   function cur-time-custom  returns character
      262   (input p-prefix as character
      263   ,input p-date-format as character
      264   ,input p-delimiter as character
      265   ,input p-time-format as character
      266   ,input p-suffix as character
      267   )
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return
      276       p-prefix
      277       + string(v-date, p-date-format)
      278       + p-delimiter
      279       + string(v-time, p-time-format)
      280       + p-suffix
      281       .
      282   end.
      283   function cur-time-print  returns character
      284   :
      285     define variable v-date as date      no-undo .
      286     define variable v-time as integer   no-undo .
      287     run cur-time in this-procedure
      288       (output v-date
      289       ,output v-time
      290       ) .
      291     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      292   end.
      293   function cur-time-datetime returns datetime
      294   :
      295     define variable v-char as character no-undo .
      296     define variable v-datetime as datetime no-undo .
      297     v-char = cur-time-string().
      298     v-datetime = datetime(v-char).
      299     return  v-datetime.
      300   end.
      301   function cur-time-string-msec returns character
      302   :
      303     define variable v-date as datetime  no-undo .
      304     v-date = now.
      305     return string(v-date) .
      306   end.
      307   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   procedure gen-key-rec :
      309     define input  parameter p-tbl-name    as character no-undo.
      310     define input  parameter p-bh_tbl-name as handle    no-undo.
      311     define output parameter p-key-rec     as character no-undo.
      312     do
      313     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      314     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      315     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      316     :
      317       define variable fh               as handle    no-undo .
      318       define variable v-ok             as logical   no-undo .
      319       define variable v-inform         as character no-undo .
      320       define variable v-ind            as integer   no-undo .
      321       define variable v-idx-field-qnty as integer   no-undo .
      322       if p-tbl-name = ?
      323         or p-tbl-name = "":U
      324       then do:
      325         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      326       end.
      327       if not p-bh_tbl-name:available then do:
      328         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      329       end.
      330       assign
      331         p-key-rec = p-tbl-name
      332         v-inform  = p-bh_tbl-name:index-information(1)
      333         v-ind     = 2
      334       .
      335       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      336       on error undo, return error
      337       :
      338         assign
      339           v-inform = p-bh_tbl-name:index-information( v-ind )
      340           v-ind    = v-ind + 1
      341         .
      342       end.
      343       if v-inform = ?
      344         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      345         or entry( 3, v-inform, ",":U ) <> "1":U
      346       then do:
      347         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      348       end.
      349       else do:
      350         assign
      351           v-idx-field-qnty = num-entries( v-inform ) - 4
      352         .
      353         if v-idx-field-qnty < 2 then do:
      354           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      355         end.
      356         do v-ind = 1 to v-idx-field-qnty by 2
      357         on error undo, return error
      358         :
      359           assign
      360             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      361             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      362           .
      363         end.
      364       end.
      365       if p-key-rec = ? then do:
      366         assign
      367           p-key-rec = "":U
      368         .
      369         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      370       end.
      371     end.
      372     return.
      373   end procedure.
      374   procedure gen-where-keyr-tab :
      375     define input  parameter i-tableSerach as character no-undo.
      376     define input  parameter i-tablekey   as character  no-undo.
      377     define input  parameter p-key-rec    as character  no-undo.
      378     define input  parameter p-key-handle as handle     no-undo .
      379     define input  parameter p-db-name    as character  no-undo .
      380     define input  parameter p-tt-handle  as handle     no-undo .
      381     define output parameter o-Where      as character  no-undo.
      382     do
      383     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      384     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      385     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      386     :
      387       define variable v-full-tbl-name  as character no-undo .
      388       define variable bh_tbl-name      as handle    no-undo .
      389       define variable fh_key           as handle    no-undo .
      390       define variable fh_search        as handle    no-undo .
      391       define variable v-field-num      as integer   no-undo .
      392       define variable v-count-fld      as integer   no-undo .
      393       define variable v-inform         as character no-undo .
      394       define variable v-ind            as integer   no-undo .
      395       define variable v-idx-field-qnty as integer   no-undo .
      396       define variable v-field-name     as character no-undo .
      397       define variable v-field-val      as character no-undo .
      398       define variable v-word-link      as character no-undo .
      399       define variable vTable           as character no-undo.
      400       define variable bh_tbl-key       as handle    no-undo .
      401       assign
      402         p-key-rec = trim( p-key-rec )
      403       .
      404       if p-key-handle <> ? then do:
      405         if not valid-handle(p-key-handle)
      406            or p-key-handle:type <> "buffer"
      407         then do:
      408           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      409         end.
      410         if num-entries( p-key-rec, chr(3) ) > 1
      411           or p-key-rec = ?
      412           or p-key-rec = "":U
      413         then do:
      414           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      415         end.
      416       end.
      417       else do:
      418         if p-key-rec = ?
      419           or p-key-rec = "":U
      420         then do:
      421           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      422         end.
      423       end.
      424       assign
      425         vTable = entry( 1 , p-key-rec, chr(3) )
      426       .
      427       if p-tt-handle <> ?
      428         and ( not valid-handle(p-tt-handle)
      429               or p-tt-handle:type <> "buffer"
      430             )
      431       then do:
      432         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      433       end.
      434       if p-tt-handle = ? then do:
      435         assign
      436           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      437         .
      438         create buffer bh_tbl-name for table v-full-tbl-name .
      439       end.
      440       else do:
      441         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      442       end.
      443       assign
      444         v-inform = bh_tbl-name:index-information(1)
      445         v-ind    = 2
      446       .
      447       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      448       on error undo, return error
      449       :
      450         assign
      451           v-inform = bh_tbl-name:index-information( v-ind )
      452           v-ind    = v-ind + 1
      453         .
      454       end.
      455       if v-inform = ?
      456         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      457         or entry( 3, v-inform, ",":U ) <> "1":U
      458       then do:
      459         delete object bh_tbl-name no-error.
      460         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      461       end.
      462       assign
      463         v-idx-field-qnty = num-entries( v-inform ) - 4
      464       .
      465       if v-idx-field-qnty < 2 then do:
      466         delete object bh_tbl-name no-error.
      467         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      468       end.
      469       assign
      470         o-where     = "where":U
      471         v-word-link = "":U
      472         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      473         v-count-fld = 0
      474       .
      475       if i-tablekey ne "" and i-tablekey ne ?
      476       then do:
      477         assign
      478           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      479         .
      480         create buffer bh_tbl-key for table v-full-tbl-name .
      481       end.
      482       if i-tableSerach ne "" and i-tableSerach ne ?
      483       then do:
      484         delete object bh_tbl-name no-error.
      485         assign
      486           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      487         .
      488         create buffer bh_tbl-name for table v-full-tbl-name .
      489       end.
      490       block_where:
      491       do v-ind = 1 to v-idx-field-qnty by 2
      492       on error undo, return error
      493       :
      494         assign
      495           v-count-fld = v-count-fld + 1
      496         .
      497         if p-key-handle = ?
      498           and v-count-fld > v-field-num
      499         then do:
      500           leave block_where.
      501         end.
      502         define variable VfieldKeyTable as handle no-undo.
      503         assign
      504           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      505           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      506         .
      507         if     bh_tbl-key ne ?
      508         then do:
      509            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      510            if VfieldKeyTable eq ?
      511            then next block_where.
      512         end.
      513         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      514         then
      515            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      516         else
      517            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      518         if p-key-handle = ? then do:
      519           assign
      520             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      521           .
      522         end.
      523         else do:
      524           assign
      525             fh_key = p-key-handle:buffer-field( v-field-name )
      526           .
      527           if fh_key = ?
      528             or not valid-handle( fh_key )
      529           then do:
      530             delete object bh_tbl-name.
      531             if     bh_tbl-key ne ?
      532             then
      533                delete object bh_tbl-key.
      534             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      535           end.
      536           assign
      537             v-field-val = fh_key:buffer-value
      538           .
      539         end.
      540         if fh_search:data-type ="character":U then do:
      541           assign
      542             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      543             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      544             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      545             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      546             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      547             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      548             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      549             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      550             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      551             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      552             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      553             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      554             v-field-val = substitute( '"&1"', v-field-val )
      555           .
      556         end.
      557         assign
      558           o-where = substitute( "&1 &2", o-where, v-field-val )
      559         .
      560         if v-word-link = "":U then do:
      561           assign
      562             v-word-link = "and":U
      563           .
      564         end.
      565       end.
      566       delete object bh_tbl-name.
      567       if     bh_tbl-key ne ?
      568       then
      569          delete object bh_tbl-key.
      570       if p-key-handle = ?
      571         and v-count-fld <> v-field-num
      572       then do:
      573         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      574       end.
      575     end.
      576   end procedure.
      577   procedure gen-hn-keyr-tab :
      578     define input  parameter i-tableSerach as character no-undo.
      579     define input  parameter i-tablekey   as character no-undo.
      580     define input  parameter p-key-rec    as character no-undo.
      581     define input  parameter p-key-handle as handle    no-undo .
      582     define input  parameter p-db-name    as character no-undo .
      583     define input  parameter p-tt-handle  as handle    no-undo .
      584     define input  parameter p-stts-lock  as integer   no-undo .
      585     define output parameter o-hn         as handle    no-undo.
      586     define variable v-full-tbl-name as character no-undo.
      587     define variable v-where         as character no-undo.
      588     define variable bh_tbl-name     as handle    no-undo.
      589     define variable vTable          as character no-undo.
      590     do
      591     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      592     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      593     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      594         run gen-where-keyr-tab(i-tableSerach,
      595                                i-tablekey,
      596                                p-key-rec,
      597                                p-key-handle,
      598                                p-db-name,
      599                                p-tt-handle,
      600                                output v-where).
      601         if i-tableSerach ne "" and i-tableSerach ne ?
      602         then do:
      603            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      604            create buffer bh_tbl-name for table v-full-tbl-name .
      605         end.
      606         else do:
      607            if p-tt-handle = ? then do:
      608               assign
      609                  vTable = entry( 1 , p-key-rec, chr(3) )
      610               .
      611               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      612               create buffer bh_tbl-name for table v-full-tbl-name .
      613            end.
      614            else do:
      615               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      616            end.
      617         end.
      618         if p-tt-handle = ? then do:
      619            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      620         end.
      621         else do:
      622            bh_tbl-name:find-first( v-where ) no-error .
      623         end.
      624         o-hn = bh_tbl-name.
      625      end.
      626   end procedure.
      627   procedure gen-hn-keyr :
      628     define input  parameter p-key-rec    as character no-undo.
      629     define input  parameter p-key-handle as handle    no-undo .
      630     define input  parameter p-db-name    as character no-undo .
      631     define input  parameter p-tt-handle  as handle    no-undo .
      632     define input  parameter p-stts-lock  as integer   no-undo .
      633     define output parameter o-hn         as handle    no-undo.
      634     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      635   end.
      636   procedure gen-row-keyr :
      637     define input  parameter p-key-rec    as character no-undo.
      638     define input  parameter p-key-handle as handle    no-undo .
      639     define input  parameter p-db-name    as character no-undo .
      640     define input  parameter p-tt-handle  as handle    no-undo .
      641     define input  parameter p-stts-lock  as integer   no-undo .
      642     define output parameter p-tbl-row    as rowid     no-undo.
      643     define output parameter p-tbl-name   as character no-undo.
      644     define variable vHn as handle no-undo.
      645       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      646       p-tbl-row = if vHn:available then vHn:rowid else ?.
      647       p-tbl-name =  vHn:table.
      648       delete object vHn no-error.
      649     if p-tbl-row = ? then do:
      650       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      651     end.
      652     else do:
      653       return.
      654     end.
      655   end procedure.
      656   procedure gen-key-fv :
      657     define input  parameter p-key-rec    as character no-undo .
      658     define output parameter p-field-list as character no-undo .
      659     define output parameter p-value-list as character no-undo.
      660     do
      661     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      662     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      663     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      664     :
      665       define variable v-full-tbl-name  as character no-undo .
      666       define variable bh_tbl-name      as handle    no-undo .
      667       define variable v-tbl-name       as character no-undo .
      668       define variable v-field-num      as integer   no-undo .
      669       define variable v-count-fld      as integer   no-undo .
      670       define variable v-inform         as character no-undo .
      671       define variable v-ind            as integer   no-undo .
      672       define variable v-idx-field-qnty as integer   no-undo .
      673       define variable v-delim-key      as character no-undo .
      674       if p-key-rec = ?
      675         or p-key-rec = "":U
      676       then do:
      677         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      678       end.
      679       assign
      680         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      681         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      682       .
      683       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      684       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      685       assign
      686         v-inform = bh_tbl-name:index-information(1)
      687         v-ind    = 2
      688       .
      689       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      690       on error undo, return error
      691       :
      692         assign
      693           v-inform = bh_tbl-name:index-information( v-ind )
      694           v-ind    = v-ind + 1
      695         .
      696       end.
      697       if v-inform = ?
      698         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      699         or entry( 3, v-inform, ",":U ) <> "1":U
      700       then do:
      701         delete object bh_tbl-name no-error.
      702         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      703       end.
      704       assign
      705         v-idx-field-qnty = num-entries( v-inform ) - 4
      706       .
      707       if v-idx-field-qnty < 2 then do:
      708         delete object bh_tbl-name no-error.
      709         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      710       end.
      711       assign
      712         p-field-list = "":U
      713         p-value-list = "":U
      714         v-delim-key  = "":U
      715         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      716         v-count-fld  = 0
      717       .
      718       block_where:
      719       do v-ind = 1 to v-idx-field-qnty by 2
      720       on error undo, return error
      721       :
      722         assign
      723           v-count-fld = v-count-fld + 1
      724         .
      725         if v-count-fld > v-field-num then do:
      726           leave block_where.
      727         end.
      728         assign
      729           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      730           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      731         .
      732         if v-ind = 1 then do:
      733           assign
      734             v-delim-key = chr(3)
      735           .
      736         end.
      737       end.
      738       delete object bh_tbl-name.
      739       if v-count-fld <> v-field-num then do:
      740         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      741       end.
      742     end.
      743   end procedure.
      744   procedure gen-key-field :
      745     define input  parameter p-table      as character no-undo .
      746     define output parameter p-field-list as character no-undo .
      747     do
      748     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      749     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      750     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      751     :
      752       define variable v-full-tbl-name  as character no-undo .
      753       define variable bh_tbl-name      as handle    no-undo .
      754       define variable v-tbl-name       as character no-undo .
      755       define variable v-field-num      as integer   no-undo .
      756       define variable v-count-fld      as integer   no-undo .
      757       define variable v-inform         as character no-undo .
      758       define variable v-ind            as integer   no-undo .
      759       define variable v-idx-field-qnty as integer   no-undo .
      760       define variable v-delim-key      as character no-undo .
      761       if p-table = ?
      762         or p-table = "":U
      763       then do:
      764         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      765       end.
      766       assign
      767         v-tbl-name      = p-table
      768         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      769       .
      770       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      771       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      772       assign
      773         v-inform = bh_tbl-name:index-information(1)
      774         v-ind    = 2
      775       .
      776       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      777       on error undo, return error
      778       :
      779         assign
      780           v-inform = bh_tbl-name:index-information( v-ind )
      781           v-ind    = v-ind + 1
      782         .
      783       end.
      784       if v-inform = ?
      785         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      786         or entry( 3, v-inform, ",":U ) <> "1":U
      787       then do:
      788         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      789       end.
      790       assign
      791         v-idx-field-qnty = num-entries( v-inform ) - 4
      792       .
      793       if v-idx-field-qnty < 2 then do:
      794         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      795       end.
      796       assign
      797         p-field-list = "":U
      798         v-delim-key  = "":U
      799         v-count-fld  = 0
      800       .
      801       block_where:
      802       do v-ind = 1 to v-idx-field-qnty by 2
      803       on error undo, return error
      804       :
      805         assign
      806           v-count-fld = v-count-fld + 1
      807         .
      808         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      809         if v-ind = 1 then do:
      810           assign
      811             v-delim-key = chr(3)
      812           .
      813         end.
      814       end.
      815       delete object bh_tbl-name.
      816     end.
      817   end procedure.
      818   define buffer buf_c-utd-marking-lines  for ub.c-utd-marking-lines .
      819   define variable v-date      as date      no-undo .
      820   define variable v-time      as integer   no-undo .
      821   define variable v-field-chg as character no-undo .
      822   define variable v-Seq       as int64     no-undo init ?.
      823   define variable vFlagseq    as logical no-undo.
      824   define variable vuniq-key-rec as character no-undo.
      825   define variable v-rowid as rowid no-undo.
      826   define variable v-tbl-name as character no-undo.
      827   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      829   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      830   define new global shared variable g#attr-lib  as handle no-undo .
      831   define variable v-attr-lib-variable as handle no-undo .
      832   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   function getattrUtdex returns char
      834   (idb-num   as integer,
      835    idoc-id   as integer,
      836    iattrcode as character,
      837    iExValue  as character  ):
      838      define buffer utd-attr for utd-attr.
      839      find first utd-attr where utd-attr.db-num eq idb-num
      840                            and utd-attr.doc-id eq idoc-id
      841                            and utd-attr.attr-code eq iattrcode
      842      no-lock no-error.
      843      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      844   end.
      845   function getattrUtd returns char
      846   (idb-num   as integer,
      847    idoc-id   as integer,
      848    iattrcode as character ):
      849     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      850   end.
      851   function setattrUtd returns logical
      852   (idb-num   as integer,
      853    idoc-id   as integer,
      854    iattrcode as character,
      855    iattrval  as character ):
      856      define buffer utd-attr for utd-attr.
      857      find first utd-attr where utd-attr.db-num eq idb-num
      858                            and utd-attr.doc-id eq idoc-id
      859                            and utd-attr.attr-code eq iattrcode
      860      no-lock no-error.
      861      if not available utd-attr
      862      then do:
      863         create utd-attr.
      864         assign
      865            utd-attr.db-num    = idb-num
      866            utd-attr.doc-id    = idoc-id
      867            utd-attr.attr-code = iattrcode
      868            utd-attr.attr-value = iattrval
      869         .
      870      end.
      871      else do:
      872         if utd-attr.attr-value ne iattrval
      873         then do:
      874            find current utd-attr exclusive-lock no-error.
      875            if available utd-attr
      876            then
      877               utd-attr.attr-value = iattrval.
      878         end.
      879      end.
      880      release utd-attr.
      881   end.
      882   function GetAttrUtdlinesEx returns char
      883   (idb-num   as integer,
      884    idoc-id   as integer,
      885    ilinenum  as integer,
      886    iattrcode as character,
      887    iExValue  as character  ):
      888      define buffer utd-lines-attr for utd-lines-attr.
      889      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      890                                  and utd-lines-attr.doc-id    eq idoc-id
      891                                  and utd-lines-attr.lineNum   eq ilineNum
      892                                  and utd-lines-attr.attr-code eq iattrcode
      893      no-lock no-error.
      894      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      895   end.
      896   function GetAttrUtdlines returns char
      897   (idb-num   as integer,
      898    idoc-id   as integer,
      899    ilinenum  as integer,
      900    iattrcode as character ):
      901      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      902   end.
      903   function setattrUtdlines returns logical
      904   (idb-num   as integer,
      905    idoc-id   as integer,
      906    ilinenum  as integer,
      907    iattrcode as character,
      908    iattrval  as character ):
      909      define buffer utd-lines-attr for utd-lines-attr.
      910      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      911                                  and utd-lines-attr.doc-id    eq idoc-id
      912                                  and utd-lines-attr.lineNum   eq ilineNum
      913                                  and utd-lines-attr.attr-code eq iattrcode
      914      no-lock no-error.
      915      if not available utd-lines-attr
      916      then do:
      917         if iattrval ne ?
      918            and iattrval ne ""
      919         then do:
      920            create utd-lines-attr.
      921            assign
      922               utd-lines-attr.db-num    = idb-num
      923               utd-lines-attr.doc-id    = idoc-id
      924               utd-lines-attr.lineNum   = ilineNum
      925               utd-lines-attr.attr-code = iattrcode
      926               utd-lines-attr.attr-value = iattrval
      927            .
      928         end.
      929      end.
      930      else do:
      931         if utd-lines-attr.attr-value ne iattrval
      932         then do:
      933            find current utd-lines-attr exclusive-lock no-error.
      934            if available utd-lines-attr
      935            then do:
      936               if    iattrval eq ?
      937                  or iattrval eq ""
      938               then do:
      939                  delete utd-lines-attr.
      940               end.
      941               else do:
      942                  utd-lines-attr.attr-value = iattrval.
      943               end.
      944            end.
      945         end.
      946      end.
      947      release utd-lines-attr.
      948   end.
      949   function GetAttrUtdMarkingLinesEx returns char
      950   (idb-num   as integer,
      951    idoc-id   as integer,
      952    ilinenum  as integer,
      953    imark     as character,
      954    iattrcode as character,
      955    iExValue  as character  ):
      956      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      957      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      958                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      959                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      960                                          and utd-marking-lines-attr.mark      eq imark
      961                                          and utd-marking-lines-attr.attr-code eq iattrcode
      962      no-lock no-error.
      963      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      964   end.
      965   function GetAttrUtdMarkingLines returns char
      966   (idb-num   as integer,
      967    idoc-id   as integer,
      968    ilinenum  as integer,
      969    imark     as character,
      970    iattrcode as character ):
      971      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      972   end.
      973   function setattrUtdMarkingLines returns logical
      974   (idb-num   as integer,
      975    idoc-id   as integer,
      976    ilinenum  as integer,
      977    imark     as character,
      978    iattrcode as character,
      979    iattrval  as character ):
      980      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      981      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      982                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      983                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      984                                          and utd-marking-lines-attr.mark      eq imark
      985                                          and utd-marking-lines-attr.attr-code eq iattrcode
      986      no-lock no-error.
      987      if not available utd-marking-lines-attr
      988      then do:
      989         if iattrval ne ?
      990            and iattrval ne ""
      991         then do:
      992            create utd-marking-lines-attr.
      993            assign
      994               utd-marking-lines-attr.db-num     = idb-num
      995               utd-marking-lines-attr.doc-id     = idoc-id
      996               utd-marking-lines-attr.lineNum    = ilineNum
      997               utd-marking-lines-attr.mark       = imark
      998               utd-marking-lines-attr.attr-code  = iattrcode
      999               utd-marking-lines-attr.attr-value = iattrval
     1000            .
     1001         end.
     1002      end.
     1003      else do:
     1004         if utd-marking-lines-attr.attr-value ne iattrval
     1005         then do:
     1006            find current utd-marking-lines-attr exclusive-lock no-error.
     1007            if available utd-marking-lines-attr
     1008            then do:
     1009               if    iattrval eq ?
     1010                  or iattrval eq ""
     1011               then do:
     1012                  delete utd-marking-lines-attr.
     1013               end.
     1014               else do:
     1015                  utd-marking-lines-attr.attr-value = iattrval.
     1016               end.
     1017            end.
     1018         end.
     1019      end.
     1020      release utd-marking-lines-attr.
     1021   end.
     1022   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1023   define variable vss-include-info5 as character format "X(65)" no-undo
     1024   initial "@(#)$Workfile$ $Revision$".
     1025   procedure xmlchar-test :
     1026   define input parameter p-in-string          as character        no-undo.
     1027   define output parameter p-out-string-enc    as character        no-undo.
     1028   define output parameter p-out-string-dec    as character        no-undo.
     1029   do
     1030   on error undo, return error
     1031   :
     1032          run xmlchar-encode in this-procedure
     1033       (
     1034             input p-in-string
     1035           , output p-out-string-enc
     1036       ).
     1037          run xmlchar-decode in this-procedure
     1038       (
     1039             input p-out-string-enc
     1040           , output p-out-string-dec
     1041       ).
     1042   end.
     1043   end .
     1044   procedure xmlchar-encode :
     1045   define input parameter p-in-string      as character        no-undo.
     1046   define output parameter p-out-string    as character        no-undo.
     1047       define variable v-position      as integer      no-undo.
     1048       define variable v-current-char  as character    no-undo.
     1049   do
     1050   on error undo, return error
     1051   :
     1052       assign
     1053           p-out-string = "":U
     1054       .
     1055       case p-in-string
     1056       :
     1057           when ?
     1058           then do:
     1059               assign
     1060                   p-out-string = "?":U
     1061               .
     1062           end.
     1063           when "?":U
     1064           then do:
     1065               assign
     1066                   p-out-string = "&#63;":U
     1067               .
     1068           end.
     1069           otherwise do:
     1070               do v-position = 1 to length( p-in-string )
     1071               :
     1072                   assign
     1073                       v-current-char = substring( p-in-string, v-position, 1 )
     1074                   .
     1075                   case v-current-char
     1076                   :
     1077                       when "&":U
     1078                       then do:
     1079                           assign
     1080                               p-out-string = p-out-string + "&amp;":U
     1081                           .
     1082                       end.
     1083                       when ">":U
     1084                       then do:
     1085                           assign
     1086                               p-out-string = p-out-string + "&gt;":U
     1087                           .
     1088                       end.
     1089                       when "<":U
     1090                       then do:
     1091                           assign
     1092                               p-out-string = p-out-string + "&lt;":U
     1093                           .
     1094                       end.
     1095                       when "'":U
     1096                       then do:
     1097                           assign
     1098                               p-out-string = p-out-string + "&apos;":U
     1099                           .
     1100                       end.
     1101                       when '"':U
     1102                       then do:
     1103                           assign
     1104                               p-out-string = p-out-string + "&quot;":U
     1105                           .
     1106                       end.
     1107                       when chr(1)
     1108                       then do:
     1109                           assign
     1110                               p-out-string = p-out-string + "":U
     1111                           .
     1112                       end.
     1113                       when chr(2)
     1114                       then do:
     1115                           assign
     1116                               p-out-string = p-out-string + "":U
     1117                           .
     1118                       end.
     1119                       when chr(3)
     1120                       then do:
     1121                           assign
     1122                               p-out-string = p-out-string + "":U
     1123                           .
     1124                       end.
     1125                       when chr(4)
     1126                       then do:
     1127                           assign
     1128                               p-out-string = p-out-string + "":U
     1129                           .
     1130                       end.
     1131                       when chr(5)
     1132                       then do:
     1133                           assign
     1134                               p-out-string = p-out-string + "":U
     1135                           .
     1136                       end.
     1137                       when chr(6)
     1138                       then do:
     1139                           assign
     1140                               p-out-string = p-out-string + "":U
     1141                           .
     1142                       end.
     1143                       when chr(7)
     1144                       then do:
     1145                           assign
     1146                               p-out-string = p-out-string + "":U
     1147                           .
     1148                       end.
     1149                       when chr(8)
     1150                       then do:
     1151                           assign
     1152                               p-out-string = p-out-string + "":U
     1153                           .
     1154                       end.
     1155                       when chr(9)
     1156                       then do:
     1157                           assign
     1158                               p-out-string = p-out-string + "":U
     1159                           .
     1160                       end.
     1161                       when chr(29)
     1162                       then do:
     1163                           assign
     1164                               p-out-string = p-out-string + "":U
     1165                           .
     1166                       end.
     1167                       when chr(10)
     1168                       then do:
     1169                           assign
     1170                               p-out-string = p-out-string + "&#10;":U
     1171                           .
     1172                       end.
     1173                       when chr(13)
     1174                       then do:
     1175                           assign
     1176                               p-out-string = p-out-string + "&#13;":U
     1177                           .
     1178                       end.
     1179                       otherwise do:
     1180                           assign
     1181                               p-out-string = p-out-string + v-current-char
     1182                           .
     1183                       end.
     1184                   end case.
     1185               end.
     1186           end.
     1187       end case.
     1188   end.
     1189   end .
     1190   procedure xmlchar-encode-1c :
     1191   define input parameter p-in-string      as character        no-undo.
     1192   define output parameter p-out-string    as character        no-undo.
     1193       define variable v-position      as integer      no-undo.
     1194       define variable v-current-char  as character    no-undo.
     1195   do
     1196   on error undo, return error
     1197   :
     1198       assign
     1199           p-out-string = "":U
     1200       .
     1201       case p-in-string
     1202       :
     1203           when ?
     1204           then do:
     1205               assign
     1206                   p-out-string = "?":U
     1207               .
     1208           end.
     1209           otherwise do:
     1210               do v-position = 1 to length( p-in-string )
     1211               :
     1212                   assign
     1213                       v-current-char = substring( p-in-string, v-position, 1 )
     1214                   .
     1215                   case v-current-char
     1216                   :
     1217                       when chr(1)
     1218                       then do:
     1219                           assign
     1220                               p-out-string = p-out-string + " ":U
     1221                           .
     1222                       end.
     1223                       when chr(2)
     1224                       then do:
     1225                           assign
     1226                               p-out-string = p-out-string + " ":U
     1227                           .
     1228                       end.
     1229                       when chr(3)
     1230                       then do:
     1231                           assign
     1232                               p-out-string = p-out-string + " ":U
     1233                           .
     1234                       end.
     1235                       when chr(4)
     1236                       then do:
     1237                           assign
     1238                               p-out-string = p-out-string + " ":U
     1239                           .
     1240                       end.
     1241                       when chr(5)
     1242                       then do:
     1243                           assign
     1244                               p-out-string = p-out-string + " ":U
     1245                           .
     1246                       end.
     1247                       when chr(6)
     1248                       then do:
     1249                           assign
     1250                               p-out-string = p-out-string + " ":U
     1251                           .
     1252                       end.
     1253                       when chr(7)
     1254                       then do:
     1255                           assign
     1256                               p-out-string = p-out-string + " ":U
     1257                           .
     1258                       end.
     1259                       when chr(8)
     1260                       then do:
     1261                           assign
     1262                               p-out-string = p-out-string + " ":U
     1263                           .
     1264                       end.
     1265                       when chr(9)
     1266                       then do:
     1267                           assign
     1268                               p-out-string = p-out-string + " ":U
     1269                           .
     1270                       end.
     1271                       when chr(29)
     1272                       then do:
     1273                           assign
     1274                               p-out-string = p-out-string + " ":U
     1275                           .
     1276                       end.
     1277                       when chr(10)
     1278                       then do:
     1279                           assign
     1280                               p-out-string = p-out-string + " ":U
     1281                           .
     1282                       end.
     1283                       when chr(13)
     1284                       then do:
     1285                           assign
     1286                               p-out-string = p-out-string + " ":U
     1287                           .
     1288                       end.
     1289                       otherwise do:
     1290                           assign
     1291                               p-out-string = p-out-string + v-current-char
     1292                           .
     1293                       end.
     1294                   end case.
     1295               end.
     1296           end.
     1297       end case.
     1298   end.
     1299   end .
     1300   procedure xmlchar-decode :
     1301   define input parameter p-in-string      as character        no-undo.
     1302   define output parameter p-out-string    as character        no-undo.
     1303       define variable v-position      as integer      no-undo.
     1304       define variable v-last-position as integer      no-undo.
     1305       define variable v-temp-integer  as integer      no-undo.
     1306       define variable v-current-char  as character    no-undo.
     1307       define variable v-next-char     as character    no-undo.
     1308       define variable v-success       as logical      no-undo.
     1309   do
     1310   on error undo, return error
     1311   :
     1312       assign
     1313           p-out-string = "":U
     1314           v-position   = 0
     1315       .
     1316       replace-cycle:
     1317       do while yes
     1318       on error undo, return error
     1319       :
     1320           assign
     1321               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1322           .
     1323           if v-last-position <= v-position
     1324           then do:
     1325               if v-position = 0
     1326               then do:
     1327                   assign
     1328                       p-out-string = p-in-string
     1329                   .
     1330               end.
     1331               else do:
     1332                   assign
     1333                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1334                   .
     1335               end.
     1336               leave replace-cycle.
     1337           end.
     1338           else do:
     1339               assign
     1340                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1341                   v-position      = v-last-position
     1342                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1343               .
     1344               if v-current-char = "#":U
     1345               then do:
     1346                   assign
     1347                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1348                   .
     1349                   if v-last-position > 0
     1350                   then do:
     1351                       run xmlchar-read-integer in this-procedure
     1352                        (
     1353                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1354                           , output v-temp-integer
     1355                           , output v-success
     1356                       ).
     1357                       if v-success = yes
     1358                       and v-temp-integer >= 1
     1359                       and v-temp-integer <= 255
     1360                       then do:
     1361                           assign
     1362                               p-out-string = p-out-string + chr( v-temp-integer )
     1363                               v-position   = v-last-position + 1
     1364                           .
     1365                       end.
     1366                       else do:
     1367                           assign
     1368                               p-out-string = p-out-string + "&":U
     1369                               v-position   = v-position   + 1
     1370                           .
     1371                       end.
     1372                   end.
     1373                   else do:
     1374                       assign
     1375                           p-out-string = p-out-string + "&":U
     1376                           v-position   = v-position   + 1
     1377                       .
     1378                   end.
     1379               end.
     1380               else do:
     1381                   case substring( p-in-string, v-position + 1, 3 )
     1382                   :
     1383                       when "lt;":U
     1384                       then do:
     1385                           assign
     1386                               p-out-string = p-out-string + "<":U
     1387                               v-position   = v-position   + 3
     1388                           .
     1389                       end.
     1390                       when "gt;":U
     1391                       then do:
     1392                           assign
     1393                               p-out-string = p-out-string + ">":U
     1394                               v-position   = v-position   + 3
     1395                           .
     1396                       end.
     1397                       otherwise do:
     1398                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1399                           then do:
     1400                               assign
     1401                                   p-out-string = p-out-string + "&":U
     1402                                   v-position   = v-position   + 4
     1403                               .
     1404                           end.
     1405                           else do:
     1406                               case substring( p-in-string, v-position + 1, 5 )
     1407                               :
     1408                                   when "quot;":U
     1409                                   then do:
     1410                                       assign
     1411                                           p-out-string = p-out-string + '"':U
     1412                                           v-position   = v-position   + 5
     1413                                       .
     1414                                   end.
     1415                                   when "apos;":U
     1416                                   then do:
     1417                                       assign
     1418                                           p-out-string = p-out-string + "'":U
     1419                                           v-position   = v-position   + 5
     1420                                       .
     1421                                   end.
     1422                                   otherwise do:
     1423                                       assign
     1424                                           p-out-string = p-out-string + "&":U
     1425                                       .
     1426                                   end.
     1427                               end case.
     1428                           end.
     1429                       end.
     1430                   end case.
     1431               end.
     1432           end.
     1433       end.
     1434   end.
     1435   end .
     1436   procedure xmlchar-read-integer :
     1437   define input parameter p-input-string      as character        no-undo.
     1438   define output parameter p-output-integer   as integer          no-undo.
     1439   define output parameter p-success       as logical          no-undo.
     1440   do
     1441   on error undo, return error
     1442   :
     1443       assign
     1444           p-output-integer = integer( p-input-string )
     1445       no-error.
     1446       if error-status :error
     1447       then do:
     1448           assign
     1449               p-success           = no
     1450               p-output-integer    = 0
     1451           .
     1452       end.
     1453       else do:
     1454           assign
     1455               p-success           = yes
     1456           .
     1457       end.
     1458   end.
     1459   end.
     1460   define variable mMRCCode  as logical    no-undo.
     1461   define variable mTypeMark as character  no-undo.
     1462   function IS-NeedMark returns logical
     1463   ( input ib-code as integer  ,
     1464     input ib-str as character ):
     1465      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1466      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1467                                    and buf_prod-bc-attr.b-str  eq ib-str
     1468                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1469        no-lock no-error.
     1470      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1471   end.
     1472   function repTegforDm return char
     1473   (iDM as char ):
     1474       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1475       define variable vteg as character no-undo.
     1476       define variable oDM as character no-undo.
     1477       define variable vi as integer no-undo.
     1478       oDM = iDm.
     1479       do vi = 1 to num-entries(vTeglist):
     1480          vTeg = entry(vi,vTeglist).
     1481          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1482       end.
     1483       return oDM.
     1484   end.
     1485   function repSpecSimbforDm return char
     1486   (iDM as char ):
     1487       define variable oDM as character no-undo.
     1488     run
     1489       xmlchar-decode(iDM, output oDM).
     1490     return repTegforDm (oDM).
     1491   end.
     1492   function CheckGtin return logical
     1493   (iGtin as char):
     1494      define variable bar_code as character no-undo.
     1495      define variable vGtin as logical no-undo init "yes".
     1496      if length(iGtin) eq 14
     1497      then do:
     1498         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1499         run str/chk-sum.p
     1500          (input-output bar_code ) no-error .
     1501         if iGtin ne  bar_code
     1502         then
     1503            vGtin = no.
     1504      end.
     1505      else
     1506         vGtin = no.
     1507      return vgtin.
     1508   end.
     1509   function repSpecSimbforXlm return char
     1510   (iDM as char ):
     1511       iDM = replace(iDM,chr(29),"").
     1512       return iDM.
     1513   end.
     1514   function getGtinByDM return char
     1515   (IDM as char):
     1516      define variable VTXT as char no-undo.
     1517      define variable vGtin as char no-undo.
     1518      vTXt = IdM.
     1519      vGtin = IDM.
     1520      if    length(vtxt) > 14
     1521      then do:
     1522         if   vtxt begins "(01)"
     1523                or vtxt begins "(02)"
     1524         then
     1525            vGtin = substring(vtxt,5,14).
     1526         else if   (vtxt begins "01"
     1527                or vtxt begins "02" )
     1528                and (   (    substring(iDm,17,2) eq "21"
     1529                         and length(vtxt) >= 21)
     1530                     or substring(iDm,17,2) eq "37"
     1531                     or substring(iDm,17,4) eq "(37)" )
     1532         then do:
     1533            vGtin = substring(vtxt,3,14).
     1534            if not checkGtin(vGtin)
     1535            then
     1536               vGtin = substring(vtxt,1,14).
     1537         end.
     1538         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1539             or length(vtxt) eq 14 + 7 + 4
     1540             or length(vtxt) eq 14 + 7
     1541         then
     1542            vGtin = substring(vtxt,1,14).
     1543      end.
     1544      if not checkGtin(vGtin)
     1545      then
     1546         vGtin = "".
     1547      return vgtin.
     1548   end.
     1549   function getGdsCodeByGtin return int
     1550   (iGtin as char):
     1551      define buffer prod-bc  for ub.prod-bc.
     1552      define buffer bar-code for ub.bar-code.
     1553      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1554      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1555      return if avail bar-code then bar-code.gds-code else ?.
     1556   end.
     1557   function getQntyCodeByGtin return decimal
     1558   (iGtin as char):
     1559      define buffer prod-bc  for ub.prod-bc.
     1560      define buffer bar-code for ub.bar-code.
     1561      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1562      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1563      return if avail bar-code then bar-code.cli-base-rate else ?.
     1564   end.
     1565   function getGdsCodeByDM return int
     1566   (iDm as char):
     1567      define variable vGtin as char no-undo.
     1568      define buffer prod-bc for ub.prod-bc.
     1569      vGtin  = getGtinByDM (IDM ).
     1570      return getGdsCodeByGtin (vGtin).
     1571   end.
     1572   function ChekTypeMarkByGds return logical
     1573   (iGds-code as integer ):
     1574      define buffer goods-attr for ub.goods-attr.
     1575      find first goods-attr where goods-attr.gds-code   = iGds-code
     1576                              and goods-attr.attr-code  = 'mark-type':U
     1577      no-lock no-error.
     1578      if available goods-attr
     1579      then do:
     1580         mTypeMark = goods-attr.attr-value.
     1581         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1582           .
     1583      end.
     1584      else
     1585         return no.
     1586   end.
     1587   function ChekTypeMarkByDm return logical
     1588   (iDM as char ):
     1589      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1590   end.
     1591   function ChekTypeMarkByGtin return logical
     1592   (iGtin as char ):
     1593      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1594   end.
     1595   function GetNextElement return character
     1596     (input iAllTeg        as logical
     1597     ,output oteg          as character
     1598     ,output otegval       as character
     1599     ,input-output pstr    as character
     1600      ):
     1601        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1602        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1603        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1604        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1605        define variable vTeg as character no-undo.
     1606        define variable vLength as integer no-undo.
     1607        define variable vi as integer no-undo.
     1608        define variable vj as integer no-undo.
     1609        define buffer code for ub.code.
     1610        find first code where Code.parent eq "MarkType"
     1611                          and Code.CodeValue   eq mTypeMark
     1612                          no-lock no-error.
     1613        if     available code
     1614           and Code.misc1 ne ""
     1615           and Code.misc1 ne ?
     1616        then do:
     1617           integer (Code.misc1) no-error.
     1618           if not error-status:error
     1619           then
     1620             entry (4,vlistleng) = Code.misc1.
     1621        end.
     1622        if iAllTeg
     1623        then
     1624           assign
     1625              vlistElem     = vlistElem    + vlistElemDop
     1626              vlistleng     = vlistleng    + vlistlengDop
     1627           .
     1628        else if mMRCCode
     1629        then
     1630           assign
     1631              vlistElem     = vlistElem    + ",(8005),8005"
     1632              vlistleng     = vlistleng    + ",000006,0006"
     1633           .
     1634       block-elem:
     1635       do vi = 1 to num-entries(vlistElem):
     1636          vTeg = entry(vi,vlistElem).
     1637          if pstr begins vTeg
     1638          then do:
     1639             if    vTeg eq "21"
     1640             then
     1641                vLength = index(pstr,chr(29)) - 2 no-error.
     1642             if vLength  <= 0
     1643             then
     1644                vLength = int(entry(vi,vlistleng)).
     1645             otegval = substring (pstr,length(vteg) + 1, vLength).
     1646             oteg = replace(replace(vteg,")",""),"(","").
     1647             vTeg = vteg + otegval.
     1648             otegval = replace(otegval,chr(29),"").
     1649             oteg = replace(replace(oteg,")",""),"(","").
     1650             pstr = substring (pstr,length(vTeg)+ 1).
     1651             vTeg = replace(vTeg,chr(29),"").
     1652             leave block-elem.
     1653          end.
     1654          else
     1655             vTeg = "".
     1656       end.
     1657       return vteg.
     1658   end.
     1659   function GetCodeIdent return character
     1660   (iDm as char):
     1661      define variable Velement   as character no-undo init "first".
     1662      define variable oCodeIdent as character no-undo.
     1663      define variable vteg as character no-undo.
     1664      define variable vtegval as character no-undo.
     1665      define variable vGtin as character no-undo.
     1666      define buffer marking for ub.marking.
     1667      for first marking no-lock where
     1668                marking.mark eq iDm
     1669            and marking.unit-ext = "LEVEL2"
     1670      :
     1671        return iDm.
     1672      end.
     1673      vGtin  = getGtinByDM (iDm ).
     1674      ChekTypeMarkByDm(idm).
     1675      if iDm begins 'tech_':U
     1676      then
     1677         oCodeIdent = iDm.
     1678      else if length(iDm) < 21
     1679      then do:
     1680         find first marking where marking.mark eq idm
     1681         no-lock no-error.
     1682         oCodeIdent = if available marking then marking.mark else  ?.
     1683      end.
     1684      else if     length(iDm) eq 29
     1685         and not iDm begins "01"
     1686         and not iDm begins "02"
     1687      then
     1688         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1689      else  if     length(iDm) >= 24
     1690               and (  iDm begins "01"
     1691                   or iDm begins "02")
     1692               and  substring(iDm,17,2) ne "21"
     1693      then do:
     1694         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1695                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1696         then
     1697            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1698         else
     1699            oCodeIdent = iDM.
     1700      end.
     1701      else  if     (   length(iDm) eq 25
     1702                    or length(iDm) eq 21)
     1703               and (not iDm begins "01"
     1704               and  not iDm begins "02")
     1705      then
     1706         oCodeIdent = substring(iDm,1,21).
     1707      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1708      then
     1709         oCodeIdent = substring(iDm,1,21).
     1710      else do while Velement ne "" and idm ne "":
     1711         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1712         oCodeIdent = oCodeIdent + Velement.
     1713      end.
     1714      return oCodeIdent.
     1715   end.
     1716   function GetTegCod return character
     1717   (icodeIdent as char, iTeg as char):
     1718      define variable Velement   as character no-undo init "first".
     1719      define variable oTeg as character no-undo init ?.
     1720      define variable vteg as character no-undo.
     1721      define variable vtegval as character no-undo.
     1722      if     ((length(icodeIdent) eq 21
     1723         and not icodeIdent begins "01"
     1724         and not icodeIdent begins "02")
     1725         or
     1726             ( length(icodeIdent) eq 25
     1727               and not icodeIdent begins "01"
     1728               and not icodeIdent begins "02"))
     1729      then do:
     1730         if iTeg eq "01" or iTeg eq "02"
     1731         then
     1732            oTeg = substring(icodeIdent,1,21).
     1733         else  if  iTeg eq "21"
     1734         then
     1735            oTeg = substring(icodeIdent,15,7).
     1736      end.
     1737      else do:
     1738         ChekTypeMarkByDm(icodeIdent).
     1739         block-teg:
     1740            do while Velement ne "" and icodeIdent ne "":
     1741            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1742            if    Velement begins iTeg
     1743               or Velement begins "(" + iTeg + ")"
     1744            then do:
     1745               oTeg = vtegval.
     1746               leave block-teg.
     1747            end.
     1748         end.
     1749      end.
     1750      return oTeg.
     1751   end.
     1752   function isOAD return logical
     1753   (icodeIdent as character):
     1754      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1755   end.
     1756   function isMark return logical
     1757   (icodeIdent as character):
     1758      define buffer buf_marking for ub.marking.
     1759      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1760             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1761   end.
     1762   function addBracketForCode return character
     1763   (icodeIdent as char):
     1764      define variable Velement   as character no-undo init "first".
     1765      define variable oTeg as character no-undo.
     1766      define variable vteg as character no-undo.
     1767      define variable vtegval as character no-undo.
     1768      define buffer marking for ub.marking.
     1769      find first marking no-lock where
     1770                 marking.mark begins icodeIdent no-error.
     1771      if    not ChekTypeMarkByDm(icodeIdent)
     1772         or length(icodeIdent) le 24
     1773         or (avail marking and marking.unit-ext = "LEVEL2")
     1774      then
     1775         oTeg = icodeIdent.
     1776      else do:
     1777         if (  icodeIdent begins "01"
     1778            or icodeIdent begins "02"
     1779            ) and CheckGtin(substring (icodeIdent,3,14))
     1780            and substring (icodeIdent,17,2) eq "21"
     1781         then do:
     1782            mMRCCode = yes.
     1783            ChekTypeMarkByDm(icodeIdent).
     1784            block-teg:
     1785            do while Velement ne "" and icodeIdent ne "":
     1786               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1787               if vteg ne ""
     1788               then
     1789                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1790            end.
     1791            mMRCCode = no.
     1792         end.
     1793         else do:
     1794            oTeg = icodeIdent.
     1795         end.
     1796      end.
     1797      return oTeg.
     1798   end.
     1799   function getlevelByCodId return int
     1800   (iCode as char):
     1801      define variable vLength as int no-undo.
     1802      define variable vLevel  as int no-undo.
     1803      if not ChekTypeMarkByDM (icode) then return ?.
     1804      vLength = length(iCode).
     1805      if    vLength eq 18
     1806         or vLength eq 20
     1807      then
     1808         Vlevel = 4.
     1809      else if vLength eq 21
     1810      then
     1811         Vlevel = 1.
     1812      else if vLength eq 25
     1813      then do:
     1814         if  iCode begins "01"
     1815         then
     1816            Vlevel = 3.
     1817         else
     1818            Vlevel = 1.
     1819      end.
     1820      else if     vLength >= 26
     1821              and vLength <= 46
     1822      then do:
     1823         if    substring(iCode,17,2) eq "11"
     1824            or substring(iCode,17,2) eq "13"
     1825            or (    substring(iCode,17,2) eq "21"
     1826                and vLength >= 33
     1827                and substring(iCode,26,4) ne "8005")
     1828         then
     1829            Vlevel = 4.
     1830         else if    vLength eq 31
     1831                 or vLength eq 38
     1832                 or vLength eq 39
     1833                 or vLength eq 45
     1834         then
     1835            Vlevel = 1.
     1836         else if    vLength eq 35
     1837                 or vLength eq 43
     1838         then
     1839            Vlevel = 3.
     1840         else
     1841            Vlevel = ?.
     1842      end.
     1843      else
     1844         Vlevel = ?.
     1845      return Vlevel.
     1846   end.
     1847   function getLevelMotpBycodid return character
     1848   (iDm as char):
     1849      define variable vLevel as integer no-undo.
     1850      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1851      vLevel = getlevelByCodId(iDm).
     1852      if    vLevel eq ?
     1853         or vLevel < 1
     1854         or vLevel > 6
     1855      then
     1856         return ?.
     1857      else
     1858         return entry(vlevel,vList).
     1859   end.
     1860   function getLevelUTDByLevelMotp return character
     1861   (iUnit as char):
     1862      define variable vLevel as integer no-undo.
     1863      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1864      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1865      vLevel = lookup(iUnit,vListMOTP).
     1866      if    vLevel eq ?
     1867         or vLevel < 1
     1868         or vLevel > 4
     1869      then
     1870         return ?.
     1871      else
     1872         return entry(vlevel,vListutd).
     1873   end.
     1874   function getLevelMotpByDM return character
     1875   (iDm as char):
     1876      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1877   end.
     1878   function getLevelUTDByCodId return character
     1879   (iDm as char):
     1880      define variable vLevel as integer no-undo.
     1881      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1882      vLevel = getlevelByCodId(iDm).
     1883      if    vLevel eq ?
     1884         or vLevel < 1
     1885         or vLevel > 4
     1886      then
     1887         return ?.
     1888      else
     1889         return entry(vlevel,vList).
     1890   end.
     1891   function getLevelUTDByDM return character
     1892   (iDm as char):
     1893      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1894   end.
     1895   define variable mNotMarkQnty as logical no-undo.
     1896   function getQntyUTDByCodId return decimal
     1897   (iDM as char):
     1898      define variable vLevel as integer no-undo.
     1899      define variable vList as character no-undo init "1,5,10,500".
     1900      define variable vGtin as character no-undo.
     1901      define variable vqnty as decimal no-undo init ?.
     1902      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1903      if vqnty eq ?
     1904      then do:
     1905         if not mNotMarkQnty
     1906         then do:
     1907            define buffer marking for ub.marking.
     1908            define variable vCodident as character no-undo.
     1909            vCodident = GetCodeIdent(idm).
     1910            find first marking where marking.mark begins vCodident no-lock no-error.
     1911            if     available marking
     1912               and marking.box-qnty ne ?
     1913            then
     1914               return marking.box-qnty.
     1915         end.
     1916         vGtin = getGtinByDm(iDM).
     1917         if ChekTypeMarkByGtin (vGtin)
     1918         then do:
     1919            vLevel = getlevelByCodId(iDM).
     1920            if     vLevel >= 1
     1921               and vLevel <= 4
     1922            then
     1923               vqnty = int(entry(vlevel,vList)).
     1924         end.
     1925         else
     1926            vqnty = getQntyCodeByGtin(vgtin).
     1927      end.
     1928      return vqnty.
     1929   end.
     1930   function getQntyUTDByDM return decimal
     1931   (iDm as char):
     1932      define variable vDM as character no-undo.
     1933      if     length (iDm) ne 25
     1934         and length (iDm) ne 29
     1935         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1936      then
     1937         vDM = substring (iDm,1,length (iDm) - 6 ).
     1938      else
     1939         vDM = substring (iDm,1,length (iDm) - 4 ).
     1940      return getQntyUTDByCodId(vDM).
     1941   end.
     1942   function getMRC4 return decimal
     1943   (iMRC as char):
     1944      define variable oMrc     as decimal no-undo init ?.
     1945      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1946      define variable vi       as integer no-undo.
     1947      define variable vfound   as integer no-undo.
     1948      define variable vposStart   as integer no-undo.
     1949      do:
     1950      OMRc = 0.
     1951      do vi = 1 to 4:
     1952         define variable vsimb as character no-undo.
     1953         vsimb = substring(iMRC,vi,1).
     1954         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1955         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1956         if vfound > 0
     1957         then
     1958            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1959         end.
     1960         OMRc = OMRc / 100.
     1961      end.
     1962      return OMRc.
     1963   end.
     1964   function getMRCByDM return decimal
     1965   (iDm as char):
     1966      define variable vMRC     as character no-undo.
     1967      define variable oMrc     as decimal no-undo init ?.
     1968      define variable Velement as character no-undo init "empty".
     1969      define variable vteg as character no-undo.
     1970      define variable vtegval as character no-undo.
     1971      if    length(idm) eq 14 + 7 + 4 + 4
     1972         or length(idm) eq 14 + 7 + 4
     1973      then do:
     1974         vMRC = substring(idm,22,4).
     1975         omrc = getMRC4(vMRC).
     1976      end.
     1977      else do:
     1978          ChekTypeMarkByDm(iDm).
     1979          block-mrc:
     1980          do while Velement ne "" and idm ne "":
     1981             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1982             if Velement begins "8005"
     1983             then do:
     1984                vMRC = substring(Velement,5,6).
     1985                leave block-mrc.
     1986             end.
     1987             else if Velement begins "(8005)"
     1988             then do:
     1989                vMRC = substring(Velement,7,6).
     1990                leave block-mrc.
     1991             end.
     1992          end.
     1993          if vMRC ne ""
     1994          then
     1995             OMRc = dec(vmrc) / 100 no-error.
     1996      end.
     1997      return OMRc.
     1998   end.
     1999   function MoveDate return Date
     2000   (idate as date,
     2001    iMonth as int64):
     2002      define variable vMonth   as int64 no-undo.
     2003      define variable vYear    as int64 no-undo.
     2004      define variable vDateNew as date  no-undo.
     2005       define variable vDay     as int64 no-undo.
     2006       vMonth = month(iDate) + iMonth.
     2007       vYear =  year(iDate).
     2008       if vMonth <= 0
     2009       then assign
     2010          vMonth = vMonth + 12
     2011           vYear  = vYear - 1
     2012       .
     2013       else if vMonth > 12
     2014       then assign
     2015          vMonth = vMonth - 12
     2016           vYear  = vYear + 1
     2017       .
     2018       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     2019       do while error-status:error eq yes:
     2020          VDay = vDay + 1.
     2021          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     2022       end.
     2023       if VDay > 0
     2024       then
     2025          vDateNew + 1.
     2026       return vDateNew.
     2027   end.
     2028   procedure checkEMRC:
     2029   define input  parameter iDm as character no-undo.
     2030   define output parameter vok as logical   no-undo init yes.
     2031      define variable v-value-emrc as character no-undo.
     2032      define variable v-type-emrc  as character no-undo.
     2033      define variable vDateIso     as character no-undo.
     2034      define variable vMRC         as decimal no-undo.
     2035      define variable vqnty        as decimal no-undo.
     2036      define variable vPrice       as decimal no-undo.
     2037      define variable vparent      as character no-undo.
     2038      define variable vgds-code    as integer no-undo.
     2039      define buffer code for ub.code.
     2040      vMRC = getMRCByDM(iDm).
     2041      if vMRC > 0
     2042      then do:
     2043         vgds-code = getGdsCodeByDM(iDm).
     2044         vqnty     = getQntyUTDByDM(iDm).
     2045               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2046            (
     2047             input   vgds-code
     2048            ,input   'emrc-type':U
     2049            ,output   v-value-emrc
     2050            ,output   v-type-emrc
     2051          ) no-error.
     2052          if     v-value-emrc ne ""
     2053             and v-value-emrc ne ?
     2054          then do:
     2055             vDateIso = iso-date(today).
     2056             vPrice = vMRC / vqnty.
     2057             vparent ="emc" + chr(4) + v-value-emrc.
     2058             find last code where Code.parent      eq vparent
     2059                              and Code.code        le vDateIso
     2060                              and code.status_  eq 0
     2061             no-lock no-error.
     2062             if not available code or ( vPrice  >= dec(Code.CodeValue))
     2063             then
     2064                vOk = true .
     2065             else do:
     2066                 define variable vText      as character no-undo.
     2067                 define variable vDate      as date no-undo.
     2068                 define variable vDateLast  as character no-undo.
     2069                 define variable vDateFirst as character no-undo.
     2070                 define variable vDate3     as date no-undo.
     2071                 vdate = date(code.misc1).
     2072                 vDateLast = code.misc1.
     2073                 vDate3 = MoveDate(today, - 3 ).
     2074                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     2075                                      string(vDate3  , "99/99/9999"),
     2076                                      string(vDate   , "99/99/9999")
     2077                                      ).
     2078                 vdateIso = iso-date(vdate3).
     2079                 find last code  where Code.parent      eq vparent
     2080                                   and Code.code        le vDateIso
     2081                                   and code.status_  eq 0 no-lock no-error.
     2082                 if available code
     2083                 then
     2084                    vDateIso = code.code.
     2085                 vDateFirst = vDateIso.
     2086                 vDateLast = iso-date(vdate).
     2087                 define variable vGood as logical no-undo.
     2088                 define variable vDateSale as date no-undo.
     2089                 define buffer bcode for code.
     2090                 for last code where Code.parent   eq vparent
     2091                                 and code.status_  eq 0
     2092                                 and code.code     < vDateLast
     2093                                 and code.code     >= vDateFirst
     2094                 no-lock:
     2095                    find first bcode where bCode.parent   eq vparent
     2096                                       and bcode.status_  eq 0
     2097                                       and bcode.code     > code.code no-lock no-error.
     2098                    if available bcode
     2099                    then do:
     2100                       if vPrice < dec(Code.CodeValue)
     2101                       then
     2102                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     2103                                                     chr(10),
     2104                                                     string(    date( code.misc1)       ,"99/99/9999"),
     2105                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     2106                                                     ).
     2107                       else do:
     2108                          vGood = yes.
     2109                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     2110                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     2111                                                     chr(10),
     2112                                                     string(    date( code.misc1)         ,"99/99/9999"),
     2113                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     2114                                                     string(         vDateSale            ,"99/99/9999"),
     2115                                                     string(vDateSale - today)
     2116                                                     ).
     2117                       end.
     2118                    end.
     2119                 end.
     2120                 if vgood
     2121                 then do:
     2122                    define variable choice as integer no-undo .
     2123                    run gbl/d-askw.w (input "Уточнение"
     2124                           ,input  vText
     2125                           ,input "|"
     2126                           ,input "Принять|Вернуть"
     2127                           ,input "Принять данный товар|Вернуть товар постащику"
     2128                           ,input 1
     2129                           ,input 2
     2130                           ,output choice) no-error.
     2131                    vok = choice eq 1.
     2132                 end.
     2133                 else
     2134                    vok =false.
     2135             end.
     2136          end.
     2137      end.
     2138   end.
     2139   function addGs2Mark return character
     2140   (iMark as char):
     2141      define variable vDM   as character no-undo.
     2142      define variable vIdx  as integer   no-undo.
     2143      if index(iMark,chr(29),1) > 0
     2144      then return iMark.
     2145      if substring(iMark,26,4) = "8005" then
     2146      do:
     2147        vIdx = index(iMark,"93",26 + 4 + 5).
     2148        if vIdx > 1 then do:
     2149          vDM = substitute("&1&4&2&4&3",
     2150                           substring(iMark,1,25),
     2151                           substring(iMark,26,vIdx - 25 - 1),
     2152                           substring(iMark,vIdx),
     2153                           chr(29)) no-error.
     2154          vIdx = index(vDm,"240",vIdx + 4).
     2155          if vIdx > 0 then
     2156          do:
     2157            vDM = substitute("&1&3&2",
     2158                             substring(vDm,1,vIdx - 1),
     2159                             substring(vDm,vIdx),
     2160                             chr(29)) no-error.
     2161          end.
     2162        end.
     2163        else
     2164          vDM = substitute("&1&3&2",
     2165                           substring(iMark,1,25),
     2166                           substring(iMark,26),
     2167                           chr(29)) no-error.
     2168      end.
     2169      else if substring(iMark,32,2) = "91" then
     2170      do:
     2171        vIdx = index(iMark,"92",32).
     2172        if vIdx > 1 then
     2173          vDM = substitute("&1&4&2&4&3",
     2174                           substring(iMark,1,31),
     2175                           substring(iMark,32,vIdx - 31 - 1),
     2176                           substring(iMark,vIdx),
     2177                           chr(29)) no-error.
     2178        else
     2179          vDM = substitute("&1&3&2",
     2180                           substring(iMark,1,31),
     2181                           substring(iMark,32),
     2182                           chr(29)) no-error.
     2183      end.
     2184      else if substring(iMark,39,2) = "91" then
     2185      do:
     2186        vIdx = index(iMark,"92",38).
     2187        if vIdx > 1 then
     2188          vDM = substitute("&1&4&2&4&3",
     2189                           substring(iMark,1,38),
     2190                           substring(iMark,39,vIdx - 38 - 1),
     2191                           substring(iMark,vIdx),
     2192                           chr(29)) no-error.
     2193        else
     2194          vDM = substitute("&1&3&2",
     2195                           substring(iMark,1,38),
     2196                           substring(iMark,39),
     2197                           chr(29)) no-error.
     2198      end.
     2199      else if substring(iMark,25,2) = "93" then
     2200      do:
     2201        vIdx = index(iMark,"92",25).
     2202        if vIdx > 1 then
     2203          vDM = substitute("&1&4&2&4&3",
     2204                           substring(iMark,1,24),
     2205                           substring(iMark,25,vIdx - 24 - 1),
     2206                           substring(iMark,vIdx),
     2207                           chr(29)) no-error.
     2208        else
     2209          vIdx = index(iMark,"3103",25).
     2210          if vIdx > 0 then
     2211          vDM = substitute("&1&4&2&4&3",
     2212                           substring(iMark,1,24),
     2213                           substring(iMark,25,vIdx - 24 - 1),
     2214                           substring(iMark,vIdx),
     2215                           chr(29)) no-error.
     2216          else
     2217            vDM = substitute("&1&3&2",
     2218                             substring(iMark,1,24),
     2219                             substring(iMark,25),
     2220                             chr(29)) no-error.
     2221      end.
     2222      else if substring(iMark,32,2) = "93" then
     2223      do:
     2224        vDM = substitute("&1&3&2",
     2225              substring(iMark,1,31),
     2226              substring(iMark,32),
     2227              chr(29)) no-error.
     2228      end.
     2229      return if vDM <> "" then vDm else iMark.
     2230   end.
     2231   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2232   function AddUtdErrForTab returns logical
     2233   (idb-num         as integer ,
     2234    idoc-id         as integer ,
     2235    iTab            as character,
     2236    iObj            as handle ,
     2237    iCheckType      as character,
     2238    iCodeErr        as character,
     2239    iCheckObj       as character ):
     2240      define buffer utd-err for utd-err.
     2241      define buffer utd for utd.
     2242      find first utd where utd.db-num     eq idb-num
     2243                       and utd.doc-id     eq idoc-id
     2244                       and utd.Direction  eq 'Outbound'
     2245      no-lock no-error.
     2246      if available utd
     2247      then
     2248         return no.
     2249      define variable vRecKey as character no-undo.
     2250            run gen-key-rec (input iTab,
     2251                             input  iObj,
     2252                             output vRecKey).
     2253      find first utd-err where utd-err.db-num     eq idb-num
     2254                           and utd-err.doc-id     eq idoc-id
     2255                           and utd-err.CheckType  eq iCheckType
     2256                           and utd-err.CodeErr    eq iCodeErr
     2257                           and utd-err.CheckObj   eq iCheckObj
     2258      exclusive-lock no-error.
     2259      if not available utd-err
     2260      then do:
     2261         create utd-err.
     2262         assign
     2263            utd-err.db-num         = idb-num
     2264            utd-err.doc-id         = idoc-id
     2265            utd-err.CheckType      = iCheckType
     2266            utd-err.CodeErr        = iCodeErr
     2267            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2268            utd-err.reckey         = vRecKey
     2269            utd-err.qnty           = 1
     2270         .
     2271      end.
     2272      else
     2273         utd-err.qnty = utd-err.qnty + 1.
     2274      return utd-err.qnty eq 1.
     2275   end.
     2276   function AddUtdErr returns logical
     2277   (idb-num         as integer ,
     2278    idoc-id         as integer ,
     2279    iObj            as handle ,
     2280    iCheckType      as character,
     2281    iCodeErr        as character,
     2282    iCheckObj       as character ):
     2283      AddUtdErrForTab
     2284         (idb-num,
     2285          idoc-id,
     2286          iObj:table,
     2287          iObj,
     2288          iCheckType,
     2289          iCodeErr,
     2290          iCheckObj).
     2291   end.
     2292   function ClearUtdErrTypeCode returns logical
     2293   (idb-num         as integer,
     2294    idoc-id         as integer ,
     2295    iCheckType      as character,
     2296    iCodeErr        as character
     2297    ):
     2298      define buffer utd-err for utd-err.
     2299      if    iCheckType eq "*"
     2300         or iCheckType eq ?
     2301      then do:
     2302         if     iCodeErr ne ?
     2303            and iCodeErr ne "*"
     2304         then
     2305            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2306            view-as alert-box.
     2307         else
     2308         for each utd-err where utd-err.db-num  eq idb-num
     2309                            and utd-err.doc-id  eq idoc-id
     2310         exclusive-lock:
     2311            delete utd-err.
     2312         end.
     2313      end.
     2314      else do:
     2315         if    iCodeErr eq ?
     2316            or iCodeErr eq "*"
     2317         then do:
     2318            for each utd-err where utd-err.db-num     eq idb-num
     2319                               and utd-err.doc-id     eq idoc-id
     2320                               and utd-err.CheckType  eq iCheckType
     2321            exclusive-lock:
     2322               delete utd-err.
     2323            end.
     2324         end.
     2325         else do:
     2326            for each utd-err where utd-err.db-num     eq idb-num
     2327                               and utd-err.doc-id     eq idoc-id
     2328                               and utd-err.CheckType  eq iCheckType
     2329                               and ub.utd-err.CodeErr eq iCodeErr
     2330            exclusive-lock:
     2331               delete utd-err.
     2332            end.
     2333         end.
     2334      end.
     2335   end.
     2336   function ClearUtdErr returns logical
     2337   (idb-num         as integer,
     2338    idoc-id         as integer ,
     2339    iCheckType      as character
     2340    ):
     2341      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2342   end.
     2343   function GetMesError returns character
     2344   (itxt as character,
     2345    iobj as character ):
     2346    define variable vi as integer no-undo.
     2347    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2348       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2349    end.
     2350    return itxt.
     2351   end.
     2352   function GetTextErrorType returns character
     2353   (iCheckType as character,
     2354    iCodeErr   as character,
     2355    iChechObj  as character,
     2356    iType      as character  ):
     2357      define buffer code    for code.
     2358      define variable vError as character no-undo.
     2359      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2360                        and code.code   eq iCodeErr
     2361      no-lock no-error.
     2362      if available code
     2363      then do:
     2364         define variable vType as integer no-undo.
     2365         if code.misc3 eq "error"
     2366         then
     2367            vType = 0.
     2368         else if code.misc3 eq "warning"
     2369         then
     2370            vType = 1.
     2371         else if code.misc3 eq "Hiden"
     2372         then
     2373            vType = 2.
     2374         else
     2375            vtype = int(code.misc3) no-error.
     2376         case itype:
     2377            when "error"
     2378            then do:
     2379               if vtype eq 0
     2380               then
     2381                  vError = GetMesError(Code.CodeValue,iChechObj).
     2382            end.
     2383            when "warning"
     2384            then do:
     2385               if vtype <= 1
     2386               then
     2387                  vError = GetMesError(Code.CodeValue,iChechObj).
     2388            end.
     2389            otherwise do:
     2390               vError = GetMesError(Code.CodeValue,iChechObj).
     2391            end.
     2392         end.
     2393      end.
     2394      else
     2395         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2396      return vError.
     2397   end.
     2398   function GetTypeError returns integer
     2399   (iCheckType as character,
     2400    iCodeErr   as character):
     2401      define buffer code    for code.
     2402      define variable vType as integer no-undo.
     2403      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2404                        and code.code   eq iCodeErr
     2405      no-lock no-error.
     2406      if     not available code
     2407         and code.misc3 eq "error"
     2408      then
     2409         vType = 0.
     2410      else if code.misc3 eq "warning"
     2411      then
     2412         vType = 1.
     2413      else if code.misc3 eq "Hiden"
     2414      then
     2415         vType = 2.
     2416      else
     2417         vtype = int(code.misc3) no-error.
     2418      return vtype.
     2419   end.
     2420   function GetTextError returns character
     2421   (iCheckType as character,
     2422    iCodeErr   as character,
     2423    iChechObj  as character ):
     2424      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2425   end.
     2426   function GetErrForUtdStr returns character
     2427   (idb-num     as integer ,
     2428    idoc-id     as integer ,
     2429    iCheckType  as character
     2430    ):
     2431      define buffer utd-err for utd-err.
     2432      define buffer code    for code.
     2433      define variable vHQry as handle no-undo.
     2434      define variable vError as longchar no-undo.
     2435      define variable vErrorOne as longchar  no-undo.
     2436      define variable oError as character no-undo.
     2437      create query vHQry.
     2438      vHQry:set-buffers(buffer utd-err:handle).
     2439      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2440                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2441                               + if    iCheckType eq "*"
     2442                                    or iCheckType eq ?
     2443                                 then       ""
     2444                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2445      vHQry:query-open().
     2446      vHQry:get-first().
     2447      QRY-BLOCK:
     2448      repeat while not vHQry:query-off-end:
     2449         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2450         if     vErrorOne ne ""
     2451            and vErrorOne ne ?
     2452         then
     2453            vError = vError + ", " + vErrorOne.
     2454         vHQry:get-next().
     2455      end.
     2456      oError = substring(vError,3,4002).
     2457      return oError.
     2458   end.
     2459   function GetErrJsonForUtd returns character
     2460   (idb-num         as integer ,
     2461    idoc-id         as integer ,
     2462    iCheckType      as character
     2463    ):
     2464      define buffer utd-err for utd-err.
     2465      define variable vHQry as handle no-undo.
     2466      define variable vError as longchar no-undo.
     2467      define variable oError as character no-undo.
     2468      create query vHQry.
     2469      define variable vi as integer no-undo.
     2470      vHQry:set-buffers(buffer utd-err:handle).
     2471      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2472                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2473                               + if    iCheckType eq "*"
     2474                                    or iCheckType eq ?
     2475                                 then       ""
     2476                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2477      vHQry:query-open().
     2478      vHQry:get-first().
     2479      QRY-BLOCK:
     2480      repeat while not vHQry:query-off-end:
     2481         define variable vErrorOne as character no-undo.
     2482         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2483         if     vErrorOne ne ?
     2484            and vErrorOne ne ""
     2485         then do:
     2486            vi = vi + 1.
     2487            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2488                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2489                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2490         end.
     2491         vHQry:get-next().
     2492      end.
     2493      for first utd where utd.db-num eq idb-num
     2494                      and utd.doc-id eq idoc-id
     2495                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2496      no-lock,
     2497         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2498                                  and utd-marking-lines.doc-id eq idoc-id
     2499                                  and utd-marking-lines.doc-level eq 1
     2500      no-lock,
     2501         first marking where marking.mark eq utd-marking-lines.mark
     2502                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2503      no-lock:
     2504         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2505         if     vErrorOne ne ?
     2506            and vErrorOne ne ""
     2507         then do:
     2508            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2509                            + '","ОбъектОш":"' + marking.mark
     2510                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2511         end.
     2512      end.
     2513      if vError ne ""
     2514      then
     2515         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2516      return oError.
     2517   end.
     2518   function GetErrJsonForUtdReturn returns character
     2519   (idb-num         as integer ,
     2520    idoc-id         as integer ,
     2521    iCheckType      as character
     2522    ):
     2523      define buffer utd-err for utd-err.
     2524      define variable vHQry as handle no-undo.
     2525      define variable vError as longchar no-undo.
     2526      define variable oError as character no-undo.
     2527      define variable vi as integer no-undo.
     2528      create query vHQry.
     2529      vHQry:set-buffers(buffer utd-err:handle).
     2530      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2531                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2532                               + if    iCheckType eq "*"
     2533                                    or iCheckType eq ?
     2534                                 then       ""
     2535                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2536      vHQry:query-open().
     2537      vHQry:get-first().
     2538      QRY-BLOCK:
     2539      repeat while not vHQry:query-off-end:
     2540         define variable vErrorOne as character no-undo.
     2541         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2542         if     vErrorOne ne ?
     2543            and vErrorOne ne ""
     2544         then do:
     2545            vi = vi + 1.
     2546            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2547                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2548                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2549         end.
     2550         vHQry:get-next().
     2551      end.
     2552      if vError ne ""
     2553      then
     2554         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2555      return oError.
     2556   end.
     2557   function GetCodeTextError returns character
     2558   (iCheckType as character,
     2559    iCodeErr   as character,
     2560    iChechObj  as character,
     2561    output oCode as character,
     2562    output ovalue as character ):
     2563      define buffer code    for code.
     2564      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2565                        and code.code   eq iCodeErr
     2566      no-lock no-error.
     2567      if     available code
     2568      then do:
     2569         define variable vi as integer no-undo init ?.
     2570         vi = int(Code.misc3) no-error.
     2571         if    code.misc3 ne "error"
     2572            and vi ne 0
     2573         then
     2574            oCode = ?.
     2575         else if     Code.misc1 ne ?
     2576                 and Code.misc1 ne ""
     2577         then
     2578            assign
     2579               oCode  = GetMesError(Code.misc1,iChechObj)
     2580               ovalue = GetMesError(Code.misc2,iChechObj)
     2581            .
     2582      end.
     2583      return if oCode eq ""
     2584             then ""
     2585             else (oCode + "_" + ovalue).
     2586   end.
     2587   define temp-table TT-err no-undo
     2588     field code_ as character
     2589     field text_ as character
     2590   index code_ code_.
     2591   function GetErrTxtForUtd returns character
     2592   (idb-num         as integer ,
     2593    idoc-id         as integer ,
     2594    iCheckType      as character
     2595    ):
     2596      define buffer utd-err for utd-err.
     2597      define variable vHQry as handle no-undo.
     2598      define variable oError as character no-undo.
     2599      create query vHQry.
     2600      define variable vi as integer no-undo.
     2601      for each tt-err :
     2602         delete tt-err.
     2603      end.
     2604      vHQry:set-buffers(buffer utd-err:handle).
     2605      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2606                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2607                               + if    iCheckType eq "*"
     2608                                    or iCheckType eq ?
     2609                                 then       ""
     2610                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2611      vHQry:query-open().
     2612      vHQry:get-first().
     2613      define variable vcode as character no-undo.
     2614      define variable vvalue as character no-undo.
     2615      QRY-BLOCK:
     2616      repeat while not vHQry:query-off-end:
     2617         vi = vi + 1.
     2618         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2619         if vcode ne ?
     2620         then do:
     2621            find first tt-err where tt-err.code eq vcode
     2622            no-error.
     2623            if not available tt-err
     2624            then do:
     2625               create tt-err.
     2626               assign
     2627                  tt-err.code_ = vcode
     2628                  tt-err.text_ = vvalue
     2629               .
     2630            end.
     2631            else
     2632               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2633         end.
     2634         vHQry:get-next().
     2635      end.
     2636     find first utd where utd.db-num eq idb-num
     2637                         and utd.doc-id eq idoc-id
     2638         no-lock.
     2639      define buffer cancel_utd-lines for utd-lines.
     2640      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2641                                  and cancel_utd-lines.doc-id eq idoc-id
     2642      no-lock:
     2643         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2644         then do:
     2645            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2646                                        and utd-marking-lines.doc-id eq idoc-id
     2647                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2648            no-lock,
     2649               first marking where marking.mark eq utd-marking-lines.mark
     2650                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2651            no-lock:
     2652               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2653               find first tt-err where tt-err.code eq vcode
     2654               no-error.
     2655               if not available tt-err
     2656               then do:
     2657                  create tt-err.
     2658                  assign
     2659                     tt-err.code_ = vcode
     2660                     tt-err.text_ = vvalue
     2661                  .
     2662               end.
     2663               else
     2664                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2665            end.
     2666         end.
     2667         else do:
     2668            define variable vqnty as decimal no-undo.
     2669            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2670            if vqnty eq ? then vqnty = 0.
     2671            if vqnty ne cancel_utd-lines.Quantity
     2672            then do:
     2673               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2674               find first tt-err where tt-err.code eq vcode
     2675               no-error.
     2676               if not available tt-err
     2677               then do:
     2678                  create tt-err.
     2679                  assign
     2680                     tt-err.code_ = vcode
     2681                     tt-err.text_ = vvalue
     2682                  .
     2683               end.
     2684               else
     2685                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2686            end.
     2687         end.
     2688      end.
     2689      for each tt-err:
     2690         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2691      end.
     2692      return oError.
     2693   end.
     2694   define variable mFormatErr as character no-undo init "text".
     2695   function GetErrForUtd returns character
     2696   (idb-num         as integer ,
     2697    idoc-id         as integer ,
     2698    iType           as character
     2699    ):
     2700      if mFormatErr eq "text"
     2701      then
     2702         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2703      else do:
     2704         if itype eq "return"
     2705         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2706         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2707      end.
     2708   end.
     2709   function GetErrComText returns longchar
     2710   (icomment as character,
     2711    itext    as longchar ):
     2712       define variable vText as longchar no-undo.
     2713      if mFormatErr eq "text"
     2714      then do:
     2715         if icomment ne ""
     2716         then
     2717            icomment = substitute("comment:|&1|",icomment).
     2718         vText = icomment + itext.
     2719      end.
     2720      else do:
     2721         icomment = if icomment begins  '"'
     2722                    then icomment
     2723                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2724         vText = icomment + "," + itext.
     2725         vText = "~{" + trim(vText,",") + "~}".
     2726      end.
     2727      return vText.
     2728   end.
     2729   function CheckTypeForMarkLineType returns logical
     2730   (iObj            as handle,
     2731    iCheckType      as character,
     2732    iCodeErr        as character ,
     2733    iTypeErr        as character ):
     2734      define variable vRecKey-markLine as character no-undo.
     2735      define variable vGoodMark        as logical no-undo.
     2736      define variable vdb-num          as integer no-undo.
     2737      define variable vdoc-id          as integer no-undo.
     2738      define variable vlinenum         as integer no-undo.
     2739      define variable vErrorOne as character no-undo.
     2740      define buffer buf_utd-err for utd-err.
     2741      run gen-key-rec (input "utd-marking-lines",
     2742                       input  iObj,
     2743                       output vRecKey-markLine).
     2744      vGoodMark = yes.
     2745      vdb-num = iObj::db-num.
     2746      vdoc-id = iObj::doc-id.
     2747      vlinenum = iObj::linenum.
     2748      block-mark-err:
     2749      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2750                               and buf_utd-err.db-num = vdb-num
     2751                               and buf_utd-err.reckey = vRecKey-markLine
     2752                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2753                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2754      no-lock:
     2755         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2756         if     vErrorOne ne ?
     2757            and vErrorOne ne ""
     2758         then do:
     2759            vGoodMark = no.
     2760            leave block-mark-err.
     2761         end.
     2762      end.
     2763      return not vGoodMark.
     2764   end.
     2765   function CheckErrForMarkLineType returns logical
     2766   (iObj            as handle,
     2767    iType           as character  ):
     2768      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2769   end.
     2770   function CheckErrForMarkLine returns logical
     2771   (iObj            as handle):
     2772      return CheckErrForMarkLineType(iObj,"*").
     2773   end.
     2774   function CheckErrForLineTypeCode returns logical
     2775   (iObj                 as handle,
     2776    iCheckType           as character,
     2777    iCodeErr             as character,
     2778    iTypeErr             as character,
     2779    iOneErr              as logical):
     2780      define variable vRecKey-line     as character no-undo.
     2781      define buffer buf_utd-err for utd-err.
     2782      define variable vUtdlineError as logical no-undo.
     2783      define variable vErrorOne as character no-undo.
     2784            run gen-key-rec (input "utd-lines",
     2785                             input  iObj,
     2786                             output vRecKey-line).
     2787         define variable vdb-num as integer no-undo.
     2788         define variable vdoc-id as integer no-undo.
     2789         define variable vlinenum as integer no-undo.
     2790         vdb-num = iObj::db-num.
     2791         vdoc-id = iObj::doc-id.
     2792         vlinenum = iObj::linenum.
     2793         block-err:
     2794         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2795                                  and buf_utd-err.db-num = vdb-num
     2796                                  and buf_utd-err.reckey = vRecKey-line
     2797                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2798                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2799         no-lock:
     2800            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2801            if     vErrorOne ne ?
     2802               and vErrorOne ne ""
     2803            then do:
     2804               vUtdlineError = yes.
     2805               leave block-err.
     2806            end.
     2807         end.
     2808         if  not vUtdlineError
     2809         then do:
     2810            define variable vGoodMark as logical no-undo.
     2811            vGoodMark = yes.
     2812            block-line-err:
     2813            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2814                                         and utd-marking-lines.doc-id  eq vdoc-id
     2815                                         and utd-marking-lines.LineNum eq vLineNum
     2816            no-lock:
     2817               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2818               if     vGoodMark
     2819                  and iOneErr eq no
     2820               then
     2821                  leave block-line-err.
     2822               if     iOneErr = yes
     2823                  and not vGoodMark
     2824               then
     2825                  leave block-line-err.
     2826            end.
     2827            vUtdlineError = not vGoodMark.
     2828         end.
     2829      return vUtdlineError.
     2830   end.
     2831   function getErrForLineType returns character
     2832   (iObj            as handle,
     2833    iType           as character  ):
     2834      define variable vRecKey-line     as character no-undo.
     2835      define buffer buf_utd-err for utd-err.
     2836      define variable vUtdlineError as logical no-undo.
     2837      define variable vErrorOne as character no-undo.
     2838      define variable oError as character no-undo.
     2839            run gen-key-rec (input "utd-lines",
     2840                             input  iObj,
     2841                             output vRecKey-line).
     2842         define variable vdb-num as integer no-undo.
     2843         define variable vdoc-id as integer no-undo.
     2844         define variable vlinenum as integer no-undo.
     2845         vdb-num = iObj::db-num.
     2846         vdoc-id = iObj::doc-id.
     2847         vlinenum = iObj::linenum.
     2848         block-err:
     2849         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2850                                  and buf_utd-err.db-num = vdb-num
     2851                                  and buf_utd-err.reckey = vRecKey-line
     2852                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2853         no-lock:
     2854            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2855            if     vErrorOne ne ?
     2856               and vErrorOne ne ""
     2857            then do:
     2858               oError = oError + vErrorOne + " ".
     2859            end.
     2860         end.
     2861      return oError.
     2862   end.
     2863   function CheckErrForLineType returns logical
     2864   (iObj            as handle,
     2865    iType           as character  ):
     2866       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2867   end.
     2868   function CheckErrForLine returns logical
     2869   (iObj            as handle):
