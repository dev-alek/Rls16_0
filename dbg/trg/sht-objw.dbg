     1298   define variable v-today          as date      no-undo.
     1299   define variable v-time           as integer   no-undo.
     1300   define variable v-obj-date       as date      no-undo.
     1301   define variable v-sys-time       as integer   no-undo.
     1302   define variable v-sys-date       as date      no-undo.
     1303   define variable v-max-shift-days as integer   no-undo.
     1304   define variable v-par-type       as character no-undo.
     1305   define variable v-host-code      like ub.shop.host-code no-undo.
     1306   define buffer prev-shift      for ub.shift-obj.
     1307   define buffer buf_shift-obj   for ub.shift-obj.
     1308   define buffer buf_c-shift-obj for ub.c-shift-obj.
     1309   define buffer buf_c-sht-hist  for ub.c-sht-hist.
     1310   define variable l-shift-on         as logical   no-undo .
     1311   define variable lok                as logical   no-undo .
     1312   define variable v-avail-petrol     as logical   no-undo .
     1313   define variable v-is-petrol        as logical   no-undo .
     1314   define variable v-is-pieces        as logical   no-undo .
     1315   define variable v-ptrl-without-rvs as character no-undo .
     1316   define variable v-attr-type        as character no-undo .
     1317   define variable v-edit-time        as logical   no-undo .
     1318   define variable v-vid-action       as integer   no-undo .
     1319   define variable v-vid-ok           as logical   no-undo .
     1320   define variable v-vid-mes          as character no-undo .
     1321   define variable v-vid-param        as longchar  no-undo .
     1322   define variable v-shift-staff-list as character no-undo .
     1323   define variable v-shift-manager    as character no-undo .
     1324   define buffer buf_inkas    for ub.inkas .
     1325   define buffer buf_pl-gds   for ub.pl-gds .
     1326   define buffer buf_goods    for ub.goods .
     1327   define buffer buf_rvs-doc  for ub.rvs-doc .
     1328   define buffer buf_rvs-line for ub.rvs-line .
     1329   define variable v-fact-status-list as character no-undo .
     1330   define variable ii                 as integer   no-undo .
     1331   main-block:
     1332   do
     1333       on error undo, return error return-value
     1334       :
     1335       v-fact-status-list = (if 'факт':U < 'запрос':U
     1336           then ('факт':U + chr(44) + 'запрос':U)
     1337           else ('запрос':U + chr(44) + 'факт':U)).
     1338   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1339   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1340     (input  ub.shift-obj.obj-type
     1341     ,input  ub.shift-obj.obj-code
     1342     ,input  'shift-on=request'
     1343     ,output l-shift-on
     1344     ) no-error .
     1345       if error-status :error then
     1346       do:
     1347           message
     1348               vss-workfile vss-revision vss-description skip
     1349               "Ошибка при запуске процедуры objat" skip
     1350               error-status :get-message(1) skip
     1351               return-value skip
     1352               view-as alert-box error .
     1353           undo main-block, return error .
     1354       end.
     1355       if l-shift-on <> yes then
     1356       do:
     1357           message
     1358               vss-workfile vss-revision vss-description skip
     1359               "На объекте выключены смены" skip
     1360               "Работа со сменами невозможна" skip
     1361               "Объект" ub.shift-obj.obj-type ub.shift-obj.obj-code skip
     1362               view-as alert-box error .
     1363           undo main-block, return error .
     1364       end.
     1365       if lookup (ub.shift-obj.status_, 'ожд,тек,зкр,отм':U) = 0
     1366           then
     1367       do:
     1368           message
     1369               "Смена" ub.shift-obj.shift-date "Номер" ub.shift-obj.shift-name "Порядок" ub.shift-obj.shift-num skip
     1370               "Недопустимый статус смены" ub.shift-obj.status_ skip
     1371               "Невозможно выполнить операцию со сменой" skip
     1372               view-as alert-box error .
     1373           undo main-block, return error .
     1374       end.
     1375       if not new( ub.shift-obj )
     1376           and ( ub.shift-obj.obj-type     <> oldb.obj-type
     1377           or ub.shift-obj.obj-code   <> oldb.obj-code
     1378           or ub.shift-obj.shift-date <> oldb.shift-date
     1379           or ub.shift-obj.shift-num  <> oldb.shift-num
     1380           )
     1381           then
     1382       do:
     1383           message
     1384               vss-workfile vss-revision vss-description skip
     1385               "Нельзя менять уникальные параметры смены" skip
     1386               "Объект:" ub.shift-obj.obj-type ub.shift-obj.obj-code skip
     1387               "Смена:" ub.shift-obj.shift-date skip
     1388               "Порядок:" ub.shift-obj.shift-num skip
     1389               view-as alert-box error .
     1390           undo main-block, return error .
     1391       end.
     1392       if not new( ub.shift-obj )
     1393           and ub.shift-obj.shift-name <> oldb.shift-name
