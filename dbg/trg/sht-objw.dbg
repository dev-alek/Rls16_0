        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.shift-obj old buffer oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись смены".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5':u,ub.shift-obj.obj-type,ub.shift-obj.obj-code,ub.shift-obj.shift-date,ub.shift-obj.shift-num,ub.shift-obj.status_)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define new global shared variable g#lib-trn  as handle no-undo .
       82   define new global shared variable g#lib-trn2 as handle no-undo .
       83   define new global shared variable g#lib-trn3 as handle no-undo .
       84   define new global shared variable g#lib-trn4 as handle no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure factord :
       87     define input  parameter p-fact-date            as date    no-undo .
       88     define input  parameter p-fact-time            as integer no-undo .
       89     define input  parameter p-fact-num             as integer no-undo .
       90     define input  parameter p-shift-date           as date    no-undo .
       91     define input  parameter p-shift-num            as integer no-undo .
       92     define input  parameter p-shift-on             as logical no-undo .
       93     define output parameter p-fact-order           as decimal no-undo .
       94     define output parameter p-shift-end-fact-order as decimal no-undo .
       95     define output parameter p-day-end-fact-order   as decimal no-undo .
       96     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       97     if p-fact-date = ?
       98     then do:
       99       return error "Не указана фактическая дата" .
      100     end.
      101     define variable v-fact-date-num as integer no-undo .
      102     assign
      103       v-fact-date-num = integer(p-fact-date)
      104     .
      105     if p-fact-num = ?
      106     or p-fact-num = 0
      107     then do:
      108       return error "Не задан p-fact-num " + string(p-fact-num) .
      109     end.
      110     if p-fact-num < 0
      111     then do:
      112       return error "Отрицательный fact-num " + string(p-fact-num) .
      113     end.
      114     if p-fact-num >= 100000000
      115     then do:
      116       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      117     end.
      118     if p-shift-on = true
      119     then do:
      120       if p-shift-date = ?
      121       then do:
      122         return error "Не задана дата смены" .
      123       end.
      124       if p-shift-num = ?
      125       or p-shift-num = 0
      126       then do:
      127         return error "Не задан номер смены" .
      128       end.
      129     end.
      130     else do:
      131       assign
      132         p-shift-date = p-fact-date
      133         p-shift-num  = 24
      134       .
      135     end.
      136     define variable v-shift-offset as integer no-undo .
      137     if p-shift-date = p-fact-date
      138     then do:
      139       assign
      140         v-shift-offset = 1
      141       .
      142     end.
      143     if p-shift-date < p-fact-date
      144     then do:
      145       assign
      146         v-shift-offset = 0
      147       .
      148     end.
      149     if p-shift-date > p-fact-date
      150     then do:
      151       message
      152         vss-workfile vss-revision vss-description skip
      153         "Неправильная дата закрытия смены" skip
      154         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      155         view-as alert-box error .
      156       undo, return error
      157         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      158           ,string(p-fact-date, '99/99/9999':U)
      159           ,string(p-shift-date, '99/99/9999':U)
      160           )
      161       .
      162     end.
      163     if p-shift-num < 1
      164     or p-shift-num > 24
      165     then do:
      166       message
      167         vss-workfile vss-revision vss-description skip
      168         "Неправильный номер смены" skip
      169         "p-shift-num" p-shift-num skip
      170         view-as alert-box error .
      171       undo, return error return-value .
      172     end.
      173     assign
      174       p-fact-order           = v-fact-date-num
      175                              + v-shift-offset * 0.5
      176                              + p-shift-num    * 0.02 - 0.01
      177                              + p-fact-num     * 0.0000000001
      178       p-shift-end-fact-order = v-fact-date-num
      179                              + v-shift-offset * 0.5
      180                              + p-shift-num    * 0.02
      181       p-day-end-fact-order   = v-fact-date-num
      182                              + 0.99
      183     .
      184     if p-fact-order           <= v-fact-date-num
      185     or p-shift-end-fact-order <= v-fact-date-num
      186     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      187     or p-shift-end-fact-order >= p-day-end-fact-order
      188     then do:
      189       message
      190         vss-workfile vss-revision vss-description skip
      191         "Внутренняя ошибка при генерации фактического номера" skip
      192         "p-fact-date"            p-fact-date            skip
      193         "p-fact-time"            p-fact-time            skip
      194         "p-fact-num"             p-fact-num             skip
      195         "p-shift-date"           p-shift-date           skip
      196         "p-shift-num"            p-shift-num            skip
      197         "p-shift-on"             p-shift-on             skip
      198         "p-shift-end-fact-order" p-shift-end-fact-order skip
      199         "p-day-end-fact-order"   p-day-end-fact-order   skip
      200         "v-fact-date-num"        v-fact-date-num        skip
      201         view-as alert-box error .
      202       undo, return error return-value .
      203     end.
      204   end procedure.
      205   procedure day-begin-fact-order :
      206     define input  parameter p-fact-date            as date    no-undo .
      207     define output parameter p-day-begin-fact-order as decimal no-undo .
      208     do
      209     on error undo, return error return-value
      210     :
      211       if p-fact-date = ?
      212       then do:
      213         assign
      214           p-day-begin-fact-order = 0
      215         .
      216       end.
      217       else do:
      218         assign
      219           p-day-begin-fact-order = integer(p-fact-date)
      220         .
      221       end.
      222     end.
      223   end procedure.
      224   procedure factord-max-fact-order :
      225     define output parameter p-max-fact-order as decimal   no-undo .
      226     do
      227     on error undo, return error return-value
      228     :
      229       run day-begin-fact-order in this-procedure
      230         (input  date(1, 1, 5000)
      231         ,output p-max-fact-order
      232         ) .
      233     end.
      234   end procedure.
      235   procedure factord-cut-archive :
      236     define input  parameter p-obj-type             as character no-undo .
      237     define input  parameter p-obj-code             as integer   no-undo .
      238     define input  parameter p-fact-date            as date      no-undo .
      239     define output parameter p-shift-on             as logical   no-undo .
      240     define output parameter p-shift-date           as date      no-undo .
      241     define output parameter p-shift-num            as integer   no-undo .
      242     define output parameter p-day-end-fact-order   as decimal   no-undo .
      243     define output parameter p-shift-end-fact-order as decimal   no-undo .
      244     define variable v-fact-order as decimal   no-undo .
      245     define buffer buf_shift-obj for ub.shift-obj .
      246     do
      247     on error undo, return error return-value
      248     :
      249   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      250   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      251     (input  p-obj-type
      252     ,input  p-obj-code
      253     ,input  'shift-on=request'
      254     ,output p-shift-on
      255     ) no-error .
      256       if error-status :error
      257       then do:
      258         message
      259           vss-workfile vss-revision vss-description skip
      260           "Ошибка при определении атрибута объекта" skip
      261           "Объект" p-obj-type p-obj-code skip
      262           error-status :get-message(1) skip
      263           return-value skip
      264           view-as alert-box error .
      265         undo, return error return-value .
      266       end.
      267       if p-shift-on = false
      268       then do:
      269         assign
      270           p-shift-date               = ?
      271           p-shift-num                = 0
      272         .
      273       end.
      274       else do:
      275         find first buf_shift-obj share-lock
      276           where buf_shift-obj.obj-type   = p-obj-type
      277             and buf_shift-obj.obj-code   = p-obj-code
      278             and buf_shift-obj.shift-date > p-fact-date
      279           use-index pi
      280           no-error .
      281         if not available buf_shift-obj
      282         or buf_shift-obj.status_ <> 'зкр':U
      283         then do:
      284           message
      285             vss-workfile vss-revision vss-description skip
      286             "Невозможно вычислить последнюю смену" skip
      287             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      288             "Объект" p-obj-type p-obj-code skip
      289             "Дата" p-fact-date skip
      290             view-as alert-box error .
      291           undo, return error return-value .
      292         end.
      293         find last buf_shift-obj share-lock
      294           where buf_shift-obj.obj-type = p-obj-type
      295             and buf_shift-obj.obj-code = p-obj-code
      296             and buf_shift-obj.shift-date <= p-fact-date
      297           use-index pi
      298           no-error .
      299         if available buf_shift-obj
      300         then do:
      301           if  buf_shift-obj.status_ = 'зкр':U
      302           then do:
      303             assign
      304               p-shift-date = buf_shift-obj.shift-date
      305               p-shift-num  = buf_shift-obj.shift-num
      306             .
      307           end.
      308           else do:
      309             message
      310               vss-workfile vss-revision vss-description skip
      311               "Невозможно вычислить последнюю смену" skip
      312               "Статус смены отличен от статуса" 'зкр':U skip
      313               "Объект" p-obj-type p-obj-code skip
      314               "Дата" p-fact-date skip
      315               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      316               view-as alert-box error .
      317             undo, return error return-value .
      318           end.
      319         end.
      320         else do:
      321           assign
      322             p-shift-date = p-fact-date - 1
      323             p-shift-num  = 1
      324           .
      325         end.
      326       end.
      327       run factord in this-procedure
      328         (input  p-fact-date
      329         ,input  1
      330         ,input  1
      331         ,input  p-shift-date
      332         ,input  p-shift-num
      333         ,input  p-shift-on
      334         ,output v-fact-order
      335         ,output p-shift-end-fact-order
      336         ,output p-day-end-fact-order
      337         ) no-error .
      338       if error-status :error
      339       then do:
      340         message
      341           vss-workfile vss-revision vss-description skip
      342           "Ошибка при вызове процедуры factord"
      343           error-status :get-message(1) skip
      344           return-value skip
      345           view-as alert-box error .
      346         undo, return error return-value .
      347       end.
      348     end.
      349   end procedure.
      350   procedure factord-lock-shift :
      351     define input  parameter p-obj-type  as character no-undo .
      352     define input  parameter p-obj-code  as integer   no-undo .
      353     define input  parameter p-fact-date as date      no-undo .
      354     define parameter buffer buf_shift-obj for ub.shift-obj .
      355     define variable v-shift-on      as logical   no-undo .
      356     define variable v-extra-message as character no-undo .
      357     define variable v-error as character no-undo .
      358     do
      359     on error undo, return error return-value
      360     :
      361   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      363     (input  p-obj-type
      364     ,input  p-obj-code
      365     ,input  'shift-on=request'
      366     ,output v-shift-on
      367     ) no-error .
      368       if error-status :error
      369       then do:
      370         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      371         undo, return error v-error .
      372       end.
      373       if v-shift-on = true
      374       then do:
      375         find first buf_shift-obj share-lock
      376           where buf_shift-obj.obj-type   = p-obj-type
      377             and buf_shift-obj.obj-code   = p-obj-code
      378             and buf_shift-obj.shift-date > p-fact-date
      379           use-index pi
      380           no-error .
      381         if not available buf_shift-obj
      382         or buf_shift-obj.status_ <> 'зкр':U
      383         then do:
      384           find last buf_shift-obj
      385             where buf_shift-obj.obj-type = p-obj-type
      386               and buf_shift-obj.obj-code = p-obj-code
      387               and buf_shift-obj.status_  = 'зкр':U
      388             use-index stts
      389             no-error .
      390           if available buf_shift-obj
      391           then do:
      392             assign
      393               v-extra-message =
      394                     substitute("Дата начала последеней закрытой смены на объекте &1"
      395                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      396                               )
      397             .
      398           end.
      399           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      400           undo, return error v-error .
      401         end.
      402       end.
      403     end.
      404   end procedure.
      405   procedure factord-end-day :
      406     define input  parameter p-fact-date            as date    no-undo .
      407     define output parameter p-day-end-fact-order   as decimal no-undo .
      408     do
      409     on error undo, return error return-value
      410     :
      411       if p-fact-date = ?
      412       then do:
      413         return error "Не указана фактическая дата" .
      414       end.
      415       assign
      416         p-day-end-fact-order = integer(p-fact-date) + 0.99
      417       .
      418     end.
      419   end procedure.
      420   procedure factord-to-date :
      421     define input  parameter p-fact-order as decimal no-undo .
      422     define output parameter p-fact-date  as date    no-undo .
      423     define variable v-ref-date  as date      no-undo .
      424     define variable v-ref-delta as integer   no-undo .
      425     do
      426     on error undo, return error return-value
      427     :
      428       if p-fact-order = ?
      429       or p-fact-order = 0
      430       then do:
      431         return error "Не указан fact-order" .
      432       end.
      433       assign
      434         v-ref-date  = date(1, 1, 2000)
      435       .
      436       assign
      437         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      438       .
      439       assign
      440         p-fact-date = v-ref-date + v-ref-delta
      441       .
      442     end.
      443   end procedure.
      444   procedure factord-to-fact-num :
      445     define input  parameter p-fact-order as decimal no-undo .
      446     define output parameter p-fact-num   as integer no-undo .
      447     define variable v-fact-order-trunc as decimal no-undo .
      448     do
      449     on error undo, return error return-value
      450     :
      451       if p-fact-order = ?
      452       or p-fact-order = 0
      453       then do:
      454         return error "Не указан fact-order" .
      455       end.
      456       assign
      457        v-fact-order-trunc = truncate(p-fact-order, 2)
      458       .
      459       assign
      460         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      461       .
      462     end.
      463   end procedure.
      464   procedure factord-to-shift-num :
      465     define input  parameter p-fact-order as decimal no-undo .
      466     define output parameter p-shift-num   as integer no-undo .
      467     define variable  p-shift-numd  as decimal   no-undo .
      468     define variable v-fact-order-trunc as decimal no-undo .
      469     do
      470     on error undo, return error return-value
      471     :
      472       if p-fact-order = ?
      473       or p-fact-order = 0
      474       then do:
      475         return error "Не указан fact-order" .
      476       end.
      477       assign
      478        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      479       .
      480       if v-fact-order-trunc < 0.5 then do:
      481         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      482       end.
      483       assign
      484         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      485         .
      486        assign
      487         p-shift-num = truncate (p-shift-numd , 0)
      488       .
      489     end.
      490   end procedure.
      491   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   procedure cur-time :
      493      define output parameter p-today as date      no-undo .
      494      define output parameter p-time  as integer   no-undo .
      495     do
      496     on error undo, return error
      497     :
      498       define variable v-date1 as date      no-undo .
      499       define variable v-date2 as date      no-undo .
      500       define variable v-time  as integer   no-undo .
      501       assign
      502         v-date1 = today
      503         v-time  = time
      504         v-date2 = today
      505       .
      506       if v-date1 <> v-date2
      507       then do:
      508         assign
      509           v-date1 = today
      510           v-time  = v-time
      511         .
      512       end.
      513       assign
      514         p-today = v-date1
      515         p-time  = v-time
      516       .
      517     end.
      518   end.
      519   function cur-time-date returns character
      520   :
      521     return string(today, '99/99/9999':U) .
      522   end.
      523   function cur-time-mjd returns decimal
      524   :
      525     define variable v-date as date      no-undo .
      526     define variable v-time as integer   no-undo .
      527     run cur-time in this-procedure
      528       (output v-date
      529       ,output v-time
      530       ) .
      531     return integer(v-date) - 2400002 + (v-time / 86400) .
      532   end.
      533   function cur-time-get-ending-index returns integer
      534   (input p-number as integer
      535   )
      536   :
      537     if p-number < 0
      538     or p-number = ?
      539     then do:
      540       return 1 .
      541     end.
      542     define variable v-rest as integer   no-undo .
      543     assign
      544       p-number = p-number modulo 100
      545     .
      546     if p-number < 20
      547     then do:
      548       assign
      549         v-rest = p-number
      550       .
      551     end.
      552     else do:
      553       assign
      554         v-rest = p-number modulo 10
      555       .
      556     end.
      557     case v-rest :
      558       when 1
      559       then do:
      560         return 2 .
      561       end.
      562       when 2 or
      563       when 3 or
      564       when 4
      565       then do:
      566         return 3 .
      567       end.
      568       otherwise do:
      569         return 1 .
      570       end.
      571     end case .
      572   end.
      573   procedure cur-time-mjd-to-date :
      574      define input  parameter i-mjd-diff as decimal no-undo.
      575      define output parameter o-Date     as date    no-undo.
      576      define output parameter o-Time     as integer no-undo.
      577      define variable v-day-number as integer   no-undo .
      578      if    i-mjd-diff < 0
      579         or i-mjd-diff = ?
      580      then do:
      581         return "?" .
      582      end.
      583      assign
      584         v-day-number = truncate(i-mjd-diff,0).
      585         o-Date = date(v-day-number + 2400002).
      586         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      587     .
      588   end.
      589   function cur-time-mjd-to-string returns character
      590   (input p-mjd-diff as decimal
      591   )
      592   :
      593     define variable v-day-number as integer   no-undo .
      594     define variable v-seconds    as integer   no-undo .
      595     define variable v-hour       as integer   no-undo .
      596     define variable v-min        as integer   no-undo .
      597     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      598     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      599     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      600     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      601     if p-mjd-diff < 0
      602     or p-mjd-diff = ?
      603     then do:
      604       return "?" .
      605     end.
      606     assign
      607       v-day-number = integer(truncate(p-mjd-diff,0))
      608       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      609     .
      610     if v-seconds > 86400
      611     then do:
      612       assign
      613         v-seconds = 86400 - 1
      614       .
      615     end.
      616     if v-seconds < 0
      617     then do:
      618       assign
      619         v-seconds = 0
      620       .
      621     end.
      622     assign
      623       v-hour = truncate(v-seconds / 3600, 0)
      624     .
      625     assign
      626       v-seconds = v-seconds modulo 3600
      627     .
      628     assign
      629       v-min = truncate(v-seconds / 60, 0)
      630     .
      631     assign
      632       v-seconds = v-seconds modulo 60
      633     .
      634     return
      635         (if v-day-number <> 0
      636           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      637           else ""
      638         )
      639       + (if v-day-number <> 0 or v-hour <> 0
      640           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      641           else ""
      642         )
      643       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      644           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      645           else ""
      646         )
      647       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      648       .
      649   end.
      650   function cur-time-string returns character
      651   :
      652     define variable v-date as date      no-undo .
      653     define variable v-time as integer   no-undo .
      654     run cur-time in this-procedure
      655       (output v-date
      656       ,output v-time
      657       ) .
      658     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      659   end.
      660   function cur-time-string-sec returns character
      661   :
      662     define variable v-date as date      no-undo .
      663     define variable v-time as integer   no-undo .
      664     run cur-time in this-procedure
      665       (output v-date
      666       ,output v-time
      667       ) .
      668     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      669   end.
      670   function cur-time-custom  returns character
      671   (input p-prefix as character
      672   ,input p-date-format as character
      673   ,input p-delimiter as character
      674   ,input p-time-format as character
      675   ,input p-suffix as character
      676   )
      677   :
      678     define variable v-date as date      no-undo .
      679     define variable v-time as integer   no-undo .
      680     run cur-time in this-procedure
      681       (output v-date
      682       ,output v-time
      683       ) .
      684     return
      685       p-prefix
      686       + string(v-date, p-date-format)
      687       + p-delimiter
      688       + string(v-time, p-time-format)
      689       + p-suffix
      690       .
      691   end.
      692   function cur-time-print  returns character
      693   :
      694     define variable v-date as date      no-undo .
      695     define variable v-time as integer   no-undo .
      696     run cur-time in this-procedure
      697       (output v-date
      698       ,output v-time
      699       ) .
      700     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      701   end.
      702   function cur-time-datetime returns datetime
      703   :
      704     define variable v-char as character no-undo .
      705     define variable v-datetime as datetime no-undo .
      706     v-char = cur-time-string().
      707     v-datetime = datetime(v-char).
      708     return  v-datetime.
      709   end.
      710   function cur-time-string-msec returns character
      711   :
      712     define variable v-date as datetime  no-undo .
      713     v-date = now.
      714     return string(v-date) .
      715   end.
