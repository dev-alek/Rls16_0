     2228                   find first buf_rvs-doc
     2229                       where buf_rvs-doc.obj-type = ub.shift-obj.obj-type
     2230                       and buf_rvs-doc.obj-code = ub.shift-obj.obj-code
     2231                       and buf_rvs-doc.rvs-type <> 'проверка':U
     2232                       and buf_rvs-doc.status_  <> 'факт':U
     2233                       no-error .
     2234                   if available buf_rvs-doc then
     2235                   do:
     2236                       message
     2237                           "Найдена незакрытая сверка" skip
     2238                           "Невозможно отменить текущую смену" skip
     2239                           "Смена" ub.shift-obj.shift-date "Номер" ub.shift-obj.shift-name "Порядок" ub.shift-obj.shift-num skip
     2240                           "Сверка" buf_rvs-doc.rvs-code skip
     2241                           view-as alert-box error .
     2242                       undo main-block, return error .
     2243                   end.
     2244                   for each ub.shift-staff no-lock where ub.shift-staff.obj-type = ub.shift-obj.obj-type
     2245                       and ub.shift-staff.obj-code = ub.shift-obj.obj-code
     2246                       and ub.shift-staff.shift-num = ub.shift-obj.shift-num
     2247                       and ub.shift-staff.shift-date = ub.shift-obj.shift-date
     2248                       and ub.shift-staff.next-shift = no :
     2249                       if ub.shift-staff.staff-role
     2250                           then
     2251                           assign
     2252                               v-shift-manager = ub.shift-staff.name
     2253                               .
     2254                       else
     2255                           assign
     2256                               v-shift-staff-list = v-shift-staff-list + (if v-shift-staff-list = "" then "" else ", ") + ub.shift-staff.name
     2257                               .
     2258                   end.
     2259                   v-vid-action = 53 .
     2260                   v-vid-param = "SHOP_NUM=" + string(ub.shift-obj.obj-code) + chr(4) +
     2261                       "SHIFT_NUM=" + string(ub.shift-obj.shift-num) + string(ub.shift-obj.shift-date, "99999999") + chr(4) +
     2262                       "ShiftManager=" + v-shift-manager + chr(4) +
     2263                       "ShiftStaff=" + v-shift-staff-list + chr(4) +
     2264                       "RESULT=0" + chr(4) +
     2265                       "Description=".
     2266               end.
     2267           end.
     2268       end.
     2269       if not g#news then
     2270       do:
     2271           run cur-time in this-procedure
     2272               ( output v-today
     2273               ,output v-time
     2274               ).
     2275           create buf_c-shift-obj.
     2276           buffer-copy oldb except
     2277               obj-type
     2278               obj-code
     2279               shift-date
     2280               shift-num
     2281               to buf_c-shift-obj
     2282               .
     2283           assign
     2284               buf_c-shift-obj.obj-type         = ub.shift-obj.obj-type
     2285               buf_c-shift-obj.obj-code         = ub.shift-obj.obj-code
     2286               buf_c-shift-obj.shift-date       = ub.shift-obj.shift-date
     2287               buf_c-shift-obj.shift-num        = ub.shift-obj.shift-num
     2288               buf_c-shift-obj.chip-num         = next-value (s-shift-chip, ub)
     2289               buf_c-shift-obj.corr-time        = v-time
     2290               buf_c-shift-obj.corr-user-db-num = g#db-num
     2291               buf_c-shift-obj.corr-user-name   = g#userid
     2292               buf_c-shift-obj.corr-date        = v-today
     2293               .
     2294           if new( ub.shift-obj ) then
     2295           do:
     2296               assign
     2297                   buf_c-shift-obj.shift-name = ub.shift-obj.shift-name
     2298                   .
     2299           end.
     2300           create buf_c-sht-hist.
     2301           buffer-copy buf_c-shift-obj to buf_c-sht-hist
     2302               assign
     2303               buf_c-sht-hist.action             = integer( if new( ub.shift-obj )
     2304                                                 then '1':U
     2305                                                 else '2':U)
     2306               buf_c-sht-hist.subject = 'shift-obj':U
     2307               buf_c-sht-hist.is-news = g#news
     2308               .
     2309           if ub.shift-obj.status_ <> "" then
     2310           do:
     2311               run str/callnews.p
     2312                   (input 'shift-obj':U
     2313                   ,input (buffer ub.shift-obj:handle)
     2314                   ) no-error .
     2315               if error-status :error then
     2316               do:
     2317                   message
     2318                       vss-workfile vss-revision vss-description skip
     2319                       "Невозможно маршрутизировать shift-obj для отправки в новости" skip
     2320                       error-status :get-message(1) skip
     2321                       return-value skip
     2322                       view-as alert-box error .
     2323                   undo main-block, return error .
     2324               end.
     2325           end.
     2326           if ub.shift-obj.status_ = 'зкр':U then
     2327           do:
     2328               define buffer buf_user-account for ub.user-account .
     2329               define variable user-id as character no-undo .
     2330               define variable fio     as character no-undo .
     2331               find first buf_user-account no-lock where buf_user-account.user-id = g#userid no-error .
     2332               if available (buf_user-account) then
     2333               do:
     2334                   assign
     2335                       user-id = buf_user-account.user-id
     2336                       fio     = buf_user-account.last-name + " " + buf_user-account.first-name + " " + buf_user-account.second-name .
     2337               end.
     2338               define buffer buf_reportShift for ub.reportShift .
     2339               define buffer buf_shift-attr  for ub.shift-obj-attr .
     2340               find first buf_reportShift exclusive-lock where buf_reportShift.shift-date = ub.shift-obj.shift-date and
     2341                   buf_reportShift.shift-num = ub.shift-obj.shift-num and buf_reportShift.obj-code = ub.shift-obj.obj-code and
     2342                   buf_reportShift.obj-type = ub.shift-obj.obj-type and buf_reportShift.report-type = 0 no-error .
     2343               if not available (buf_reportShift) then
     2344               do:
     2345                   find first buf_shift-attr exclusive-lock where buf_shift-attr.attr-code = "reportShift" and
     2346                       buf_shift-attr.obj-code = ub.shift-obj.obj-code and
     2347                       buf_shift-attr.obj-type = ub.shift-obj.obj-type and
     2348                       buf_shift-attr.shift-date = 01/01/1970 and
     2349                       buf_shift-attr.shift-num = 1 no-error .
     2350                   if available (buf_shift-attr) then
     2351                   do:
     2352                       buf_shift-attr.attr-value = string(integer(buf_shift-attr.attr-value) + 1) .
     2353                   end.
     2354                   else
     2355                   do:
     2356                       create buf_shift-attr .
     2357                       assign
     2358                           buf_shift-attr.attr-code  = "reportShift"
     2359                           buf_shift-attr.obj-code   = ub.shift-obj.obj-code
     2360                           buf_shift-attr.obj-type   = ub.shift-obj.obj-type
     2361                           buf_shift-attr.shift-date = 01/01/1970
     2362                           buf_shift-attr.shift-num  = 1
     2363                           buf_shift-attr.attr-value = string(next-value(s-reportShift, ub)).
     2364                   end.
     2365                   create buf_reportShift.
     2366                   assign
     2367                       buf_reportShift.id          = integer(buf_shift-attr.attr-value)
     2368                       buf_reportShift.obj-code    = ub.shift-obj.obj-code
     2369                       buf_reportShift.obj-type    = ub.shift-obj.obj-type
     2370                       buf_reportShift.report-type = 0
     2371                       buf_reportShift.shift-date  = ub.shift-obj.shift-date
     2372                       buf_reportShift.shift-num   = ub.shift-obj.shift-num
     2373                       .
     2374               end.
     2375               assign
     2376                   buf_reportShift.date       = today
     2377                   buf_reportShift.user-id    = user-id
     2378                   buf_reportShift.fio        = fio
     2379                   buf_reportShift.time_      = time
     2380                   buf_reportShift.shift-name = ub.shift-obj.shift-name
     2381                   .
     2382               find first ub.susp-chk no-lock where ub.susp-chk.obj-code = ub.shift-obj.obj-code and
     2383                   ub.susp-chk.obj-type = ub.shift-obj.obj-type and
     2384                   ub.susp-chk.shift-date = ub.shift-obj.shift-date and
     2385                   ub.susp-chk.shift-name = ub.shift-obj.shift-name and
     2386                   ub.susp-chk.shift-num = ub.shift-obj.shift-num no-error .
     2387               if available (ub.susp-chk) then buf_reportShift.flag = true .
     2388           end.
     2389       end.
     2390       if g#oxml = yes
     2391           then
     2392       do:
     2393           run str/calloxml.p (
     2394               input 'update':U
     2395               , input 'shift-obj':U
     2396               , input ( buffer ub.shift-obj:handle )
     2397               ) no-error.
     2398           if error-status :error
     2399               then
     2400           do:
     2401               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     2402                   , chr(10)
     2403                   , vss-workfile
     2404                   , return-value
     2405                   , error-status :get-message ( 1 ) ).
     2406           end.
     2407       end.
     2408   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     2409     (input ?
     2410     ,input this-procedure:handle
     2411     ,input ?
     2412     ,input 'event_shift':U
     2413     ,input  buffer oldb:handle
     2414     ,input  buffer ub.shift-obj:handle
     2415     ,input ''
     2416     ,input ''
     2417     ) no-error .
     2418       if error-status :error
     2419           then
     2420       do:
     2421           return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
     2422               , chr(10)
     2423               , vss-workfile
     2424               , return-value
     2425               , error-status :get-message ( 1 ) ).
     2426       end.
     2427   end.
     2428   if g#news <> yes
     2429       then
     2430   do:
     2431       run trg/userlog.p (
     2432           input 'update':U
     2433           , input 'c-sht-hist':U
     2434           , input ( buffer buf_c-sht-hist :handle )
     2435           , input v-vid-action
     2436           , input v-vid-param
     2437           ) no-error.
     2438       if error-status :error
     2439           then
     2440       do:
     2441           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     2442               , chr(10)
     2443               , vss-workfile
     2444               , return-value
     2445               , error-status :get-message ( 1 ) ).
     2446       end.
     2447   end.
