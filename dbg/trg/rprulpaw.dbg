        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.rp-rule-param OLD old_rp-rule-param.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись связки параметры профайла-параметры правила".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7'
       29                            , ub.rp-rule-param.profile_id
       30                            , ub.rp-rule-param.codex_id
       31                            , ub.rp-rule-param.ruleset_id
       32                            , ub.rp-rule-param.rule_id
       33                            , ub.rp-rule-param.rp_order_id
       34                            , ub.rp-rule-param.rule-param-name
       35                            , ub.rp-rule-param.rp-param-name
       36                            )
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure cur-time :
       91      define output parameter p-today as date      no-undo .
       92      define output parameter p-time  as integer   no-undo .
       93     do
       94     on error undo, return error
       95     :
       96       define variable v-date1 as date      no-undo .
       97       define variable v-date2 as date      no-undo .
       98       define variable v-time  as integer   no-undo .
       99       assign
      100         v-date1 = today
      101         v-time  = time
      102         v-date2 = today
      103       .
      104       if v-date1 <> v-date2
      105       then do:
      106         assign
      107           v-date1 = today
      108           v-time  = v-time
      109         .
      110       end.
      111       assign
      112         p-today = v-date1
      113         p-time  = v-time
      114       .
      115     end.
      116   end.
      117   function cur-time-date returns character
      118   :
      119     return string(today, '99/99/9999':U) .
      120   end.
      121   function cur-time-mjd returns decimal
      122   :
      123     define variable v-date as date      no-undo .
      124     define variable v-time as integer   no-undo .
      125     run cur-time in this-procedure
      126       (output v-date
      127       ,output v-time
      128       ) .
      129     return integer(v-date) - 2400002 + (v-time / 86400) .
      130   end.
      131   function cur-time-get-ending-index returns integer
      132   (input p-number as integer
      133   )
      134   :
      135     if p-number < 0
      136     or p-number = ?
      137     then do:
      138       return 1 .
      139     end.
      140     define variable v-rest as integer   no-undo .
      141     assign
      142       p-number = p-number modulo 100
      143     .
      144     if p-number < 20
      145     then do:
      146       assign
      147         v-rest = p-number
      148       .
      149     end.
      150     else do:
      151       assign
      152         v-rest = p-number modulo 10
      153       .
      154     end.
      155     case v-rest :
      156       when 1
      157       then do:
      158         return 2 .
      159       end.
      160       when 2 or
      161       when 3 or
      162       when 4
      163       then do:
      164         return 3 .
      165       end.
      166       otherwise do:
      167         return 1 .
      168       end.
      169     end case .
      170   end.
      171   procedure cur-time-mjd-to-date :
      172      define input  parameter i-mjd-diff as decimal no-undo.
      173      define output parameter o-Date     as date    no-undo.
      174      define output parameter o-Time     as integer no-undo.
      175      define variable v-day-number as integer   no-undo .
      176      if    i-mjd-diff < 0
      177         or i-mjd-diff = ?
      178      then do:
      179         return "?" .
      180      end.
      181      assign
      182         v-day-number = truncate(i-mjd-diff,0).
      183         o-Date = date(v-day-number + 2400002).
      184         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186   end.
      187   function cur-time-mjd-to-string returns character
      188   (input p-mjd-diff as decimal
      189   )
      190   :
      191     define variable v-day-number as integer   no-undo .
      192     define variable v-seconds    as integer   no-undo .
      193     define variable v-hour       as integer   no-undo .
      194     define variable v-min        as integer   no-undo .
      195     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      196     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      197     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      198     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      199     if p-mjd-diff < 0
      200     or p-mjd-diff = ?
      201     then do:
      202       return "?" .
      203     end.
      204     assign
      205       v-day-number = integer(truncate(p-mjd-diff,0))
      206       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      207     .
      208     if v-seconds > 86400
      209     then do:
      210       assign
      211         v-seconds = 86400 - 1
      212       .
      213     end.
      214     if v-seconds < 0
      215     then do:
      216       assign
      217         v-seconds = 0
      218       .
      219     end.
      220     assign
      221       v-hour = truncate(v-seconds / 3600, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 3600
      225     .
      226     assign
      227       v-min = truncate(v-seconds / 60, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 60
      231     .
      232     return
      233         (if v-day-number <> 0
      234           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0
      238           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      239           else ""
      240         )
      241       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      242           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      243           else ""
      244         )
      245       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      246       .
      247   end.
      248   function cur-time-string returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      257   end.
      258   function cur-time-string-sec returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      267   end.
      268   function cur-time-custom  returns character
      269   (input p-prefix as character
      270   ,input p-date-format as character
      271   ,input p-delimiter as character
      272   ,input p-time-format as character
      273   ,input p-suffix as character
      274   )
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return
      283       p-prefix
      284       + string(v-date, p-date-format)
      285       + p-delimiter
      286       + string(v-time, p-time-format)
      287       + p-suffix
      288       .
      289   end.
      290   function cur-time-print  returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-datetime returns datetime
      301   :
      302     define variable v-char as character no-undo .
      303     define variable v-datetime as datetime no-undo .
      304     v-char = cur-time-string().
      305     v-datetime = datetime(v-char).
      306     return  v-datetime.
      307   end.
      308   function cur-time-string-msec returns character
      309   :
      310     define variable v-date as datetime  no-undo .
      311     v-date = now.
      312     return string(v-date) .
      313   end.
      314   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      315   procedure gen-key-rec :
      316     define input  parameter p-tbl-name    as character no-undo.
      317     define input  parameter p-bh_tbl-name as handle    no-undo.
      318     define output parameter p-key-rec     as character no-undo.
      319     do
      320     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      321     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      322     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      323     :
      324       define variable fh               as handle    no-undo .
      325       define variable v-ok             as logical   no-undo .
      326       define variable v-inform         as character no-undo .
      327       define variable v-ind            as integer   no-undo .
      328       define variable v-idx-field-qnty as integer   no-undo .
      329       if p-tbl-name = ?
      330         or p-tbl-name = "":U
      331       then do:
      332         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      333       end.
      334       if not p-bh_tbl-name:available then do:
      335         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      336       end.
      337       assign
      338         p-key-rec = p-tbl-name
      339         v-inform  = p-bh_tbl-name:index-information(1)
      340         v-ind     = 2
      341       .
      342       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      343       on error undo, return error
      344       :
      345         assign
      346           v-inform = p-bh_tbl-name:index-information( v-ind )
      347           v-ind    = v-ind + 1
      348         .
      349       end.
      350       if v-inform = ?
      351         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      352         or entry( 3, v-inform, ",":U ) <> "1":U
      353       then do:
      354         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      355       end.
      356       else do:
      357         assign
      358           v-idx-field-qnty = num-entries( v-inform ) - 4
      359         .
      360         if v-idx-field-qnty < 2 then do:
      361           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      362         end.
      363         do v-ind = 1 to v-idx-field-qnty by 2
      364         on error undo, return error
      365         :
      366           assign
      367             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      368             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      369           .
      370         end.
      371       end.
      372       if p-key-rec = ? then do:
      373         assign
      374           p-key-rec = "":U
      375         .
      376         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      377       end.
      378     end.
      379     return.
      380   end procedure.
      381   procedure gen-where-keyr-tab :
      382     define input  parameter i-tableSerach as character no-undo.
      383     define input  parameter i-tablekey   as character  no-undo.
      384     define input  parameter p-key-rec    as character  no-undo.
      385     define input  parameter p-key-handle as handle     no-undo .
      386     define input  parameter p-db-name    as character  no-undo .
      387     define input  parameter p-tt-handle  as handle     no-undo .
      388     define output parameter o-Where      as character  no-undo.
      389     do
      390     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      391     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      392     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      393     :
      394       define variable v-full-tbl-name  as character no-undo .
      395       define variable bh_tbl-name      as handle    no-undo .
      396       define variable fh_key           as handle    no-undo .
      397       define variable fh_search        as handle    no-undo .
      398       define variable v-field-num      as integer   no-undo .
      399       define variable v-count-fld      as integer   no-undo .
      400       define variable v-inform         as character no-undo .
      401       define variable v-ind            as integer   no-undo .
      402       define variable v-idx-field-qnty as integer   no-undo .
      403       define variable v-field-name     as character no-undo .
      404       define variable v-field-val      as character no-undo .
      405       define variable v-word-link      as character no-undo .
      406       define variable vTable           as character no-undo.
      407       define variable bh_tbl-key       as handle    no-undo .
      408       assign
      409         p-key-rec = trim( p-key-rec )
      410       .
      411       if p-key-handle <> ? then do:
      412         if not valid-handle(p-key-handle)
      413            or p-key-handle:type <> "buffer"
      414         then do:
      415           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      416         end.
      417         if num-entries( p-key-rec, chr(3) ) > 1
      418           or p-key-rec = ?
      419           or p-key-rec = "":U
      420         then do:
      421           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      422         end.
      423       end.
      424       else do:
      425         if p-key-rec = ?
      426           or p-key-rec = "":U
      427         then do:
      428           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      429         end.
      430       end.
      431       assign
      432         vTable = entry( 1 , p-key-rec, chr(3) )
      433       .
      434       if p-tt-handle <> ?
      435         and ( not valid-handle(p-tt-handle)
      436               or p-tt-handle:type <> "buffer"
      437             )
      438       then do:
      439         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      440       end.
      441       if p-tt-handle = ? then do:
      442         assign
      443           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      444         .
      445         create buffer bh_tbl-name for table v-full-tbl-name .
      446       end.
      447       else do:
      448         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      449       end.
      450       assign
      451         v-inform = bh_tbl-name:index-information(1)
      452         v-ind    = 2
      453       .
      454       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      455       on error undo, return error
      456       :
      457         assign
      458           v-inform = bh_tbl-name:index-information( v-ind )
      459           v-ind    = v-ind + 1
      460         .
      461       end.
      462       if v-inform = ?
      463         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      464         or entry( 3, v-inform, ",":U ) <> "1":U
      465       then do:
      466         delete object bh_tbl-name no-error.
      467         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      468       end.
      469       assign
      470         v-idx-field-qnty = num-entries( v-inform ) - 4
      471       .
      472       if v-idx-field-qnty < 2 then do:
      473         delete object bh_tbl-name no-error.
      474         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      475       end.
      476       assign
      477         o-where     = "where":U
      478         v-word-link = "":U
      479         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      480         v-count-fld = 0
      481       .
      482       if i-tablekey ne "" and i-tablekey ne ?
      483       then do:
      484         assign
      485           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      486         .
      487         create buffer bh_tbl-key for table v-full-tbl-name .
      488       end.
      489       if i-tableSerach ne "" and i-tableSerach ne ?
      490       then do:
      491         delete object bh_tbl-name no-error.
      492         assign
      493           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      494         .
      495         create buffer bh_tbl-name for table v-full-tbl-name .
      496       end.
      497       block_where:
      498       do v-ind = 1 to v-idx-field-qnty by 2
      499       on error undo, return error
      500       :
      501         assign
      502           v-count-fld = v-count-fld + 1
      503         .
      504         if p-key-handle = ?
      505           and v-count-fld > v-field-num
      506         then do:
      507           leave block_where.
      508         end.
      509         define variable VfieldKeyTable as handle no-undo.
      510         assign
      511           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      512           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      513         .
      514         if     bh_tbl-key ne ?
      515         then do:
      516            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      517            if VfieldKeyTable eq ?
      518            then next block_where.
      519         end.
      520         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      521         then
      522            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      523         else
      524            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      525         if p-key-handle = ? then do:
      526           assign
      527             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      528           .
      529         end.
      530         else do:
      531           assign
      532             fh_key = p-key-handle:buffer-field( v-field-name )
      533           .
      534           if fh_key = ?
      535             or not valid-handle( fh_key )
      536           then do:
      537             delete object bh_tbl-name.
      538             if     bh_tbl-key ne ?
      539             then
      540                delete object bh_tbl-key.
      541             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      542           end.
      543           assign
      544             v-field-val = fh_key:buffer-value
      545           .
      546         end.
      547         if fh_search:data-type ="character":U then do:
      548           assign
      549             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      550             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      551             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      552             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      553             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      554             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      555             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      556             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      557             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      558             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      559             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      560             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      561             v-field-val = substitute( '"&1"', v-field-val )
      562           .
      563         end.
      564         assign
      565           o-where = substitute( "&1 &2", o-where, v-field-val )
      566         .
      567         if v-word-link = "":U then do:
      568           assign
      569             v-word-link = "and":U
      570           .
      571         end.
      572       end.
      573       delete object bh_tbl-name.
      574       if     bh_tbl-key ne ?
      575       then
      576          delete object bh_tbl-key.
      577       if p-key-handle = ?
      578         and v-count-fld <> v-field-num
      579       then do:
      580         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      581       end.
      582     end.
      583   end procedure.
      584   procedure gen-hn-keyr-tab :
      585     define input  parameter i-tableSerach as character no-undo.
      586     define input  parameter i-tablekey   as character no-undo.
      587     define input  parameter p-key-rec    as character no-undo.
      588     define input  parameter p-key-handle as handle    no-undo .
      589     define input  parameter p-db-name    as character no-undo .
      590     define input  parameter p-tt-handle  as handle    no-undo .
      591     define input  parameter p-stts-lock  as integer   no-undo .
      592     define output parameter o-hn         as handle    no-undo.
      593     define variable v-full-tbl-name as character no-undo.
      594     define variable v-where         as character no-undo.
      595     define variable bh_tbl-name     as handle    no-undo.
      596     define variable vTable          as character no-undo.
      597     do
      598     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      599     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      600     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      601         run gen-where-keyr-tab(i-tableSerach,
      602                                i-tablekey,
      603                                p-key-rec,
      604                                p-key-handle,
      605                                p-db-name,
      606                                p-tt-handle,
      607                                output v-where).
      608         if i-tableSerach ne "" and i-tableSerach ne ?
      609         then do:
      610            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      611            create buffer bh_tbl-name for table v-full-tbl-name .
      612         end.
      613         else do:
      614            if p-tt-handle = ? then do:
      615               assign
      616                  vTable = entry( 1 , p-key-rec, chr(3) )
      617               .
      618               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      619               create buffer bh_tbl-name for table v-full-tbl-name .
      620            end.
      621            else do:
      622               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      623            end.
      624         end.
      625         if p-tt-handle = ? then do:
      626            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      627         end.
      628         else do:
      629            bh_tbl-name:find-first( v-where ) no-error .
      630         end.
      631         o-hn = bh_tbl-name.
      632      end.
      633   end procedure.
      634   procedure gen-hn-keyr :
      635     define input  parameter p-key-rec    as character no-undo.
      636     define input  parameter p-key-handle as handle    no-undo .
      637     define input  parameter p-db-name    as character no-undo .
      638     define input  parameter p-tt-handle  as handle    no-undo .
      639     define input  parameter p-stts-lock  as integer   no-undo .
      640     define output parameter o-hn         as handle    no-undo.
      641     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      642   end.
      643   procedure gen-row-keyr :
      644     define input  parameter p-key-rec    as character no-undo.
      645     define input  parameter p-key-handle as handle    no-undo .
      646     define input  parameter p-db-name    as character no-undo .
      647     define input  parameter p-tt-handle  as handle    no-undo .
      648     define input  parameter p-stts-lock  as integer   no-undo .
      649     define output parameter p-tbl-row    as rowid     no-undo.
      650     define output parameter p-tbl-name   as character no-undo.
      651     define variable vHn as handle no-undo.
      652       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      653       p-tbl-row = if vHn:available then vHn:rowid else ?.
      654       p-tbl-name =  vHn:table.
      655       delete object vHn no-error.
      656     if p-tbl-row = ? then do:
      657       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      658     end.
      659     else do:
      660       return.
      661     end.
      662   end procedure.
      663   procedure gen-key-fv :
      664     define input  parameter p-key-rec    as character no-undo .
      665     define output parameter p-field-list as character no-undo .
      666     define output parameter p-value-list as character no-undo.
      667     do
      668     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      669     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      670     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      671     :
      672       define variable v-full-tbl-name  as character no-undo .
      673       define variable bh_tbl-name      as handle    no-undo .
      674       define variable v-tbl-name       as character no-undo .
      675       define variable v-field-num      as integer   no-undo .
      676       define variable v-count-fld      as integer   no-undo .
      677       define variable v-inform         as character no-undo .
      678       define variable v-ind            as integer   no-undo .
      679       define variable v-idx-field-qnty as integer   no-undo .
      680       define variable v-delim-key      as character no-undo .
      681       if p-key-rec = ?
      682         or p-key-rec = "":U
      683       then do:
      684         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      685       end.
      686       assign
      687         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      688         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      689       .
      690       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      691       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      692       assign
      693         v-inform = bh_tbl-name:index-information(1)
      694         v-ind    = 2
      695       .
      696       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      697       on error undo, return error
      698       :
      699         assign
      700           v-inform = bh_tbl-name:index-information( v-ind )
      701           v-ind    = v-ind + 1
      702         .
      703       end.
      704       if v-inform = ?
      705         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      706         or entry( 3, v-inform, ",":U ) <> "1":U
      707       then do:
      708         delete object bh_tbl-name no-error.
      709         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      710       end.
      711       assign
      712         v-idx-field-qnty = num-entries( v-inform ) - 4
      713       .
      714       if v-idx-field-qnty < 2 then do:
      715         delete object bh_tbl-name no-error.
      716         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      717       end.
      718       assign
      719         p-field-list = "":U
      720         p-value-list = "":U
      721         v-delim-key  = "":U
      722         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      723         v-count-fld  = 0
      724       .
      725       block_where:
      726       do v-ind = 1 to v-idx-field-qnty by 2
      727       on error undo, return error
      728       :
      729         assign
      730           v-count-fld = v-count-fld + 1
      731         .
      732         if v-count-fld > v-field-num then do:
      733           leave block_where.
      734         end.
      735         assign
      736           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      737           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      738         .
      739         if v-ind = 1 then do:
      740           assign
      741             v-delim-key = chr(3)
      742           .
      743         end.
      744       end.
      745       delete object bh_tbl-name.
      746       if v-count-fld <> v-field-num then do:
      747         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      748       end.
      749     end.
      750   end procedure.
      751   procedure gen-key-field :
      752     define input  parameter p-table      as character no-undo .
      753     define output parameter p-field-list as character no-undo .
      754     do
      755     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      756     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      757     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      758     :
      759       define variable v-full-tbl-name  as character no-undo .
      760       define variable bh_tbl-name      as handle    no-undo .
      761       define variable v-tbl-name       as character no-undo .
      762       define variable v-field-num      as integer   no-undo .
      763       define variable v-count-fld      as integer   no-undo .
      764       define variable v-inform         as character no-undo .
      765       define variable v-ind            as integer   no-undo .
      766       define variable v-idx-field-qnty as integer   no-undo .
      767       define variable v-delim-key      as character no-undo .
      768       if p-table = ?
      769         or p-table = "":U
      770       then do:
      771         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      772       end.
      773       assign
      774         v-tbl-name      = p-table
      775         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      776       .
      777       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      778       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      779       assign
      780         v-inform = bh_tbl-name:index-information(1)
      781         v-ind    = 2
      782       .
      783       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      784       on error undo, return error
      785       :
      786         assign
      787           v-inform = bh_tbl-name:index-information( v-ind )
      788           v-ind    = v-ind + 1
      789         .
      790       end.
      791       if v-inform = ?
      792         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      793         or entry( 3, v-inform, ",":U ) <> "1":U
      794       then do:
      795         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      796       end.
      797       assign
      798         v-idx-field-qnty = num-entries( v-inform ) - 4
      799       .
      800       if v-idx-field-qnty < 2 then do:
      801         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      802       end.
      803       assign
      804         p-field-list = "":U
      805         v-delim-key  = "":U
      806         v-count-fld  = 0
      807       .
      808       block_where:
      809       do v-ind = 1 to v-idx-field-qnty by 2
      810       on error undo, return error
      811       :
      812         assign
      813           v-count-fld = v-count-fld + 1
      814         .
      815         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      816         if v-ind = 1 then do:
      817           assign
      818             v-delim-key = chr(3)
      819           .
      820         end.
      821       end.
      822       delete object bh_tbl-name.
      823     end.
      824   end procedure.
      825   define variable v-date as date no-undo .
      826   define variable v-time as integer no-undo .
      827   define variable v-uniq-key-rec as character no-undo .
      828   define variable v-param-num as integer no-undo .
      829   define buffer buf_rule-profile for ub.rule-profile.
      830   define buffer buf_ruledict for ub.ruledict.
      831   define buffer buf_ruledict-param for ub.ruledict-param.
      832   define buffer buf_rule for ub.rule.
      833   define buffer rule_ruledict for ub.ruledict.
      834   define buffer rule_ruledict-param for ub.ruledict-param.
      835   define buffer buf_c-rule-profile for ub.c-rule-profile.
      836   define buffer buf_c-rp-rule-param for ub.c-rp-rule-param.
      837   main-block:
      838   do
      839   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      840   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      841   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      842   :
      843     if not g#news then do:
      844       if g#db-num > 0 then do:
      845         message
      846         vss-workfile vss-revision vss-description skip
      847         "Запрещено  создавать связки ПАРАМЕТР ПРОФАЙЛА - ПАРАМЕТР ПРАВИЛА в УБД"
      848         view-as alert-box error .
      849         undo main-block, return error .
      850       end.
      851       find first buf_rule-profile no-lock where
      852                 buf_rule-profile.profile_id = ub.rp-rule-param.profile_id no-error .
      853       if not available buf_rule-profile then do:
      854         message
      855         vss-workfile vss-revision vss-description skip
      856         substitute("Не найден профайл &1 для связки ПАРАМЕТР ПРОФАЙЛА - ПАРАМЕТР ПРАВИЛА&2" +
      857                    "профайл &1 кодекс &3 набор правил &4 порядок вызова &5 правило &6"
      858                    , ub.rp-rule-param.profile_id
      859                    , chr(10)
      860                    ,ub.rp-rule-param.codex_id
      861                    ,ub.rp-rule-param.ruleset_id
      862                    ,ub.rp-rule-param.rp_order_id
      863                    ,ub.rp-rule-param.rule_id)
      864        view-as alert-box error .
      865        undo main-block, return error .
      866       end.
      867       run gen-key-rec in this-procedure (
      868                                           input 'rule-profile':U
      869                                           ,input  buffer buf_rule-profile:handle
      870                                           ,output v-uniq-key-rec
      871                                           ).
      872       find first buf_ruledict where
      873                 buf_ruledict.entry-type  = 'rule-profile':U
      874             and buf_ruledict.uniq-key-rec  = v-uniq-key-rec no-error.
      875       if not available buf_ruledict then do:
      876         message
      877         vss-workfile vss-revision vss-description skip
      878         substitute("Не найдена запись в словаре правил для профайла &1"
      879                    , ub.rp-rule-param.profile_id
      880                    )
      881        view-as alert-box error .
      882        undo main-block, return error .
      883       end.
      884       find current buf_ruledict exclusive-lock .
      885       find first buf_ruledict-param where
      886                 buf_ruledict-param.entry-id = buf_ruledict.entry-id
      887             and buf_ruledict-param.param-name = ub.rp-rule-param.rp-param-name no-error  .
      888       if not available buf_ruledict-param then do:
      889         find first buf_rule share-lock where
      890                   buf_rule.rule_id = ub.rp-rule-param.rule_id.
      891         find first rule_ruledict no-lock where
      892                   rule_ruledict.entry-type = 'rule':U
      893               and rule_ruledict.uniq-key-rec = buf_rule.uniq-key-rec no-error .
      894         if not available rule_ruledict then do:
      895           message
      896           vss-workfile vss-revision vss-description skip
      897           substitute("Не найдена запись в словаре правил для правила &1"
      898                     , buf_rule.rule_id
      899                     )
      900           view-as alert-box error .
      901           undo main-block, return error .
      902         end.
      903         find first rule_ruledict-param where
      904                   rule_ruledict-param.entry-id = rule_ruledict.entry-id
      905               and rule_ruledict-param.language = rule_ruledict.language
      906               and rule_ruledict-param.param-name = ub.rp-rule-param.rule-param-name no-error.
      907         if not available rule_ruledict-param then do:
      908           message
      909           vss-workfile vss-revision vss-description skip
      910           substitute("Не найдена запись в словаре правил для параметра &1 правила &2"
      911                     , ub.rp-rule-param.rule-param-name
      912                     , buf_rule.rule_id
      913                     , chr(10))
      914           view-as alert-box error .
      915           undo main-block, return error .
      916         end.
      917         do v-param-num = 1 to 999999999:
      918           find first buf_ruledict-param no-lock where
      919                   buf_ruledict-param.entry-id = buf_ruledict.entry-id
      920               and buf_ruledict-param.language = buf_ruledict.language
      921               and buf_ruledict-param.param-num = v-param-num no-error .
      922           if not available buf_ruledict-param then do:
      923              leave.
      924           end.
      925         end.
      926         if ub.rp-rule-param.rp-param-name > '' then do:
      927         create buf_ruledict-param.
      928         buffer-copy rule_ruledict-param
      929         except param-name
      930         entry-id
      931         language
      932         param-num
      933         to buf_ruledict-param
      934         assign
      935         buf_ruledict-param.entry-id = buf_ruledict.entry-id
      936         buf_ruledict-param.language = buf_ruledict.language
      937         buf_ruledict-param.param-num = v-param-num
      938         buf_ruledict-param.param-name = ub.rp-rule-param.rp-param-name
      939         .
      940       end.
      941     end.
      942     end.
      943     if not g#news
      944     or g#db-num <> 0 then do:
      945       run cur-time in this-procedure ( output v-date, output v-time).
      946       create buf_c-rp-rule-param.
      947       assign
      948       buf_c-rp-rule-param.profile_id         = ub.rp-rule-param.profile_id
      949       buf_c-rp-rule-param.codex_id           = ub.rp-rule-param.codex_id
      950       buf_c-rp-rule-param.ruleset_id         = ub.rp-rule-param.ruleset_id
      951       buf_c-rp-rule-param.rp_order_id        = ub.rp-rule-param.rp_order_id
      952       buf_c-rp-rule-param.rule_id            = ub.rp-rule-param.rule_id
      953       buf_c-rp-rule-param.rule-param-name    = ub.rp-rule-param.rule-param-name
      954       buf_c-rp-rule-param.rp-param-name      = ub.rp-rule-param.rp-param-name
      955       buf_c-rp-rule-param.chip-num           = next-value (s-ref-corr-chip, ub)
      956       buf_c-rp-rule-param.corr-time          = v-time
      957       buf_c-rp-rule-param.corr-user-db-num   = g#db-num
      958       buf_c-rp-rule-param.corr-user-name     = (if g#news
      959                                       then (chr(4) +  'СПН':U)
      960                                       else g#userid)
      961       buf_c-rp-rule-param.corr-date          = v-date
      962       .
      963       create buf_c-rule-profile.
      964       buffer-copy buf_c-rp-rule-param to buf_c-rule-profile
      965       assign
      966       buf_c-rule-profile.action = integer(if new(ub.rp-rule-param) then '1':U else '2':U)
      967       buf_c-rule-profile.subject = 'rp-rule-param':U
      968       .
      969     end.
      970     if not g#news
      971     and g#db-num = 0
      972     then do:
      973       run str/callnews.p
      974         (input 'rp-rule-param':U
      975         ,input (buffer ub.rp-rule-param:handle)
      976         ).
      977     end.
      978       if g#oxml = yes
      979       then do:
      980       run str/calloxml.p (
      981             input 'update':U
      982           , input 'rp-rule-param':U
      983           , input ( buffer ub.rp-rule-param:handle )
      984       ) no-error.
      985       if error-status :error
      986       then do:
      987           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      988                                , chr(10)
      989                                , vss-workfile
      990                                , return-value
      991                                , error-status :get-message ( 1 ) ).
      992       end.
      993       end.
      994   end.
