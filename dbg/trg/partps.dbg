        1   block-level on error undo, throw.
        2   define input parameter p-gds-code                  as integer                             no-undo .
        3   define input parameter p-in-code                   as character                           no-undo .
        4   define input parameter p-out-code                  as character                           no-undo .
        5   define input parameter p-part-code                 as character                           no-undo .
        6   define input parameter p-mark-db-num               like ub.parts.mark-db-num              no-undo .
        7   define input parameter p-mark-code                 like ub.parts.mark-code                no-undo .
        8   define input parameter p-alc-bottling-date         like ub.parts.alc-bottling-date        no-undo .
        9   define input parameter p-alc-ref-ab-path           like ub.parts.alc-ref-ab-path          no-undo .
       10   define input parameter p-alc-quality-certif-path   like ub.parts.alc-quality-certif-path  no-undo .
       11   define input parameter p-alc-certif-path           like ub.parts.alc-certif-path          no-undo .
       12   define input parameter p-alc-imp-type              like ub.parts.alc-imp-type             no-undo .
       13   define input parameter p-alc-imp-code              like ub.parts.alc-imp-code             no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Изменение описания для партии приходной накладной и для всех партий, которые были получены из этой партии".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   procedure check-avail-artic:
       90     define input parameter chg-artic     like ub.goods.artic     no-undo.
       91     define input parameter chg-prod-type like ub.goods.prod-type no-undo.
       92     define input parameter chg-prod-code like ub.goods.prod-code no-undo.
       93     do
       94     on error  undo, return error
       95     on stop   undo, return error
       96     on endkey undo, return error :
       97       define buffer buf_goods for ub.goods .
       98       if not can-find( buf_goods where buf_goods.artic     = chg-artic
       99                                    and buf_goods.prod-type = chg-prod-type
      100                                    and buf_goods.prod-code = chg-prod-code
      101                                  no-lock )
      102       then do:
      103         return error.
      104       end.
      105     end.
      106     return.
      107   end procedure.
      108   procedure check-avail-gds-code:
      109     define input-output parameter chg-gds-code like ub.goods.gds-code no-undo.
      110     do
      111     on error  undo, return error
      112     on stop   undo, return error
      113     on endkey undo, return error :
      114       define buffer buf_goods for ub.goods .
      115       define buffer buf_route for ub.route .
      116       find buf_goods where buf_goods.gds-code = chg-gds-code
      117                     no-lock no-error.
      118       if not available buf_goods then do:
      119         do-sch:
      120         for each buf_route no-lock
      121           where buf_route.name-rec begins ("command" + chr(1)
      122                                            + "goods" + chr(1)
      123                                            + "ren-gds-code" + chr(1)
      124                                            + string(chg-gds-code)
      125                                           )
      126         on error  undo, return error
      127         :
      128           assign
      129             chg-gds-code = int(entry(5,buf_route.name-rec,chr(1)))
      130             .
      131           leave do-sch.
      132         end.
      133       end.
      134     end.
      135     return.
      136   end procedure.
      137   PROCEDURE check-avail-b-code :
      138     define input-output parameter loc-b-code like ub.bar-code.b-code no-undo.
      139     do
      140     on error  undo, return error
      141     on endkey undo, return error
      142     on stop   undo, return error :
      143       define variable sought-b-code  like ub.bar-code.b-code no-undo.
      144       define variable bar_code      like ub.prod-bc.b-str   no-undo .
      145       define buffer buf_bar-code for ub.bar-code .
      146       define buffer buf_prod-bc  for ub.prod-bc .
      147       assign sought-b-code = loc-b-code .
      148       find buf_bar-code where buf_bar-code.b-code = sought-b-code no-lock no-error.
      149       if available buf_bar-code then do:
      150         assign loc-b-code = buf_bar-code.b-code.
      151       end.
      152       else do :
      153         run gen-bc( input sought-b-code, output bar_code ).
      154         find first buf_prod-bc where buf_prod-bc.b-str = bar_code no-lock no-error.
      155         if available buf_prod-bc then do:
      156           assign loc-b-code = buf_prod-bc.b-code .
      157           find next buf_prod-bc where buf_prod-bc.b-str = bar_code no-lock no-error.
      158           if available buf_prod-bc then do:
      159             assign loc-b-code = ? .
      160             return error.
      161           end.
      162         end.
      163         else do:
      164           assign loc-b-code = ?.
      165           return error.
      166         end.
      167       end.
      168     end.
      169   END PROCEDURE.
      170   define variable v-gds-code       as integer   no-undo .
      171   define variable v-artic          as character no-undo .
      172   define variable v-prod-type      as character no-undo .
      173   define variable v-prod-code      as integer   no-undo .
      174   define variable iCounter         as integer   no-undo .
      175   define variable v-send-db-list   as character no-undo .
      176   define variable v-remote-db-list as character no-undo .
      177   define variable v-cmd            as character no-undo .
      178   define variable v-msg-text       as character no-undo .
      179   define buffer buf_goods      for ub.goods .
      180   define buffer buf_gds-obj    for ub.gds-obj .
      181   define buffer buf_parts      for ub.parts .
      182   define buffer buf_parts-attr for ub.parts-attr .
      183   define buffer buf_db         for ub.db .
      184   main-block:
      185   do transaction
      186   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, "~n", error-status :get-message ( error-status :num-messages ) )
      187   on stop   undo main-block, return error substitute( "&1. stop"  , vss-workfile )
      188   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      189   :
      190     assign
      191       v-gds-code = p-gds-code
      192     .
      193     if p-alc-imp-code = ?
      194     then do:
      195       assign
      196         p-alc-imp-code = 0
      197         p-mark-code = 0
      198       .
      199     end.
      200     if p-out-code = ?
      201     then do:
      202       p-out-code = "".
      203     end.
      204     find first buf_goods no-lock
      205       where buf_goods.gds-code = v-gds-code no-error.
      206     if not available buf_goods then do:
      207       if g#news then do:
      208         run check-avail-gds-code in this-procedure (input-output v-gds-code).
      209         find first buf_goods no-lock
      210           where buf_goods.gds-code = v-gds-code no-error.
      211         if not available buf_goods then do:
      212           assign
      213             v-msg-text = substitute("&1. Не найден товар с кодом &2.", vss-workfile, v-gds-code)
      214                        + chr(10)
      215                        + substitute("Первоначальный поиск производился для товара с кодом &1", p-gds-code)
      216           .
      217           return error v-msg-text.
      218         end.
      219       end.
      220       else do:
      221         assign
      222           v-msg-text = substitute("Не найден товар с кодом &1", v-gds-code)
      223         .
      224         return error v-msg-text.
      225       end.
      226     end.
      227     for each ub.gds-obj share-lock
      228       where ub.gds-obj.gds-code = v-gds-code
      229     on error undo main-block, return error
      230     :
      231       find first buf_gds-obj exclusive-lock
      232         where recid(buf_gds-obj) = recid(ub.gds-obj)
      233         .
      234     end.
      235   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run arptpc in g#library
      237     (input  v-gds-code
      238     ,output v-artic
      239     ,output v-prod-type
      240     ,output v-prod-code
      241     )  .
      242     find first buf_parts-attr exclusive-lock
      243       where buf_parts-attr.in-code   = p-in-code
      244         and buf_parts-attr.gds-code  = v-gds-code
      245         and buf_parts-attr.part-code = p-part-code
      246       no-error .
      247     if available buf_parts-attr
      248     then do:
      249       assign
      250         buf_parts-attr.alc-bottling-date        = p-alc-bottling-date
      251         buf_parts-attr.alc-certif-path          = p-alc-certif-path
      252         buf_parts-attr.alc-imp-type             = p-alc-imp-type
      253         buf_parts-attr.alc-imp-code             = p-alc-imp-code
      254         buf_parts-attr.alc-quality-certif-path  = p-alc-quality-certif-path
      255         buf_parts-attr.alc-ref-ab-path          = p-alc-ref-ab-path
      256         buf_parts-attr.mark-code                = p-mark-code
      257         buf_parts-attr.mark-db-num              = p-mark-db-num
      258       .
      259     end.
      260     for each ub.parts share-lock
      261       where ub.parts.in-code   = p-in-code
      262         and ub.parts.artic     = v-artic
      263         and ub.parts.prod-type = v-prod-type
      264         and ub.parts.prod-code = v-prod-code
      265         and ub.parts.part-code = p-part-code
      266         and (p-out-code = "" or ub.parts.out-code = p-out-code)
      267     on error undo main-block, return error
      268     :
      269       if ( ub.parts.alc-bottling-date       <> p-alc-bottling-date       )  or
      270          ( ub.parts.alc-certif-path         <> p-alc-certif-path         )  or
      271          ( ub.parts.alc-imp-type            <> p-alc-imp-type            )  or
      272          ( ub.parts.alc-imp-code            <> p-alc-imp-code            )  or
      273          ( ub.parts.alc-quality-certif-path <> p-alc-quality-certif-path )  or
      274          ( ub.parts.alc-ref-ab-path         <> p-alc-ref-ab-path         )  or
      275          ( ub.parts.mark-code               <> p-mark-code               )  or
      276          ( ub.parts.mark-db-num             <> p-mark-db-num             )
      277       then do:
      278         find first buf_parts exclusive-lock
      279           where recid(buf_parts) = recid(ub.parts)
      280           .
      281         assign
      282           buf_parts.alc-bottling-date        = p-alc-bottling-date
      283           buf_parts.alc-certif-path          = p-alc-certif-path
      284           buf_parts.alc-imp-type             = p-alc-imp-type
      285           buf_parts.alc-imp-code             = p-alc-imp-code
      286           buf_parts.alc-quality-certif-path  = p-alc-quality-certif-path
      287           buf_parts.alc-ref-ab-path          = p-alc-ref-ab-path
      288           buf_parts.mark-code                = p-mark-code
      289           buf_parts.mark-db-num              = p-mark-db-num
      290           iCounter                           = iCounter + 1
      291         .
      292       end.
      293     end.
      294     if iCounter > 0 then do:
      295       v-remote-db-list = "":U .
      296       for each buf_db where buf_db.db-num > 0 no-lock :
      297         assign
      298           v-remote-db-list = (if v-remote-db-list <> "":U then v-remote-db-list + chr(1)
      299                                                           else ""
      300                              ) + string(buf_db.db-num)
      301         .
      302       end.
      303       if g#db-num = 0 then do:
      304         assign
      305           v-send-db-list = v-remote-db-list
      306         .
      307       end.
      308       if g#db-num <> 0 and not g#news then do:
      309         assign
      310           v-send-db-list = "0":U
      311         .
      312       end.
      313       if v-send-db-list <> "":U then do:
      314         assign
      315           v-cmd = "command":U                 + chr(1)
      316                 + "parts":U                   + chr(1)
      317                 + "alc-attr":U                + chr(1)
      318                 + string(v-gds-code)          + chr(1)
      319                 + p-in-code                   + chr(1)
      320                 + p-part-code                 + chr(1)
      321                 + string(p-mark-db-num)       + chr(1)
      322                 + (if p-mark-code = ? then "0" else string(p-mark-code)) + chr(1)
      323                 + (if p-alc-bottling-date = ? then "?" else string(p-alc-bottling-date)) + chr(1)
      324                 + p-alc-ref-ab-path           + chr(1)
      325                 + p-alc-quality-certif-path   + chr(1)
      326                 + p-alc-certif-path           + chr(1)
      327                 + p-alc-imp-type              + chr(1)
      328                 + (if p-alc-imp-code = ? then "0" else STRING(p-alc-imp-code)) + chr(1)
      329                 + p-out-code
      330         .
      331         if v-cmd = ?
      332         then do:
      333           message substitute ('Ошибка генерации комманды - "&1"', ('command|parts|alc-attr'
      334             + "|" + string(v-gds-code) + "|" + p-in-code + "|" + p-part-code))
      335           view-as alert-box.
      336           return error substitute ('Ошибка генерации комманды - "&1"', ('command|parts|alc-attr'
      337             + "|" + string(v-gds-code) + "|" + p-in-code + "|" + p-part-code)).
      338         end.
      339         run nws/cr-route.p
      340           (input  'send-cmd':U
      341           ,input  v-cmd
      342           ,input  ?
      343           ,input  v-send-db-list
      344           ).
      345       end.
      346     end.
      347   end.
