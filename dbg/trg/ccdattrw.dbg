      629   define variable p-news as logical no-undo .
      630   define variable p-from-gbd as logical no-undo .
      631   define variable p-from-ubd as logical no-undo .
      632   define buffer buf_cash-desk for ub.cash-desk.
      633   main-block:
      634   do
      635   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      636   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      637   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      638   :
      639     run cd-attr-news in this-procedure (
      640                                           input ub.c-cash-desk-attr.upper-attr-code
      641                                          ,input ub.c-cash-desk-attr.attr-code
      642                                          ,output p-news
      643                                          ,output p-from-gbd
      644                                          ,output p-from-ubd
      645                                          ) no-error.
      646     if p-news
      647     and (
      648     not g#news
      649     or (g#news
      650         and g#db-num > 0
      651         and ub.c-cash-desk-attr.corr-user-name = (chr(4) +  'СПН':U)
      652         )
      653         )
      654     then do:
      655       run str/callnews.p
      656         (input 'c-cash-desk-attr':U
      657         ,input (buffer ub.c-cash-desk-attr:handle)
      658         ) no-error .
      659       if error-status:error then undo main-block, return error return-value .
      660     end.
      661       if g#oxml = yes
      662       then do:
      663       run str/calloxml.p (
      664             input 'update':U
      665           , input 'c-cash-desk-attr':U
      666           , input ( buffer ub.c-cash-desk-attr:handle )
      667       ) no-error.
      668       if error-status :error
      669       then do:
      670           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      671                                , chr(10)
      672                                , vss-workfile
      673                                , return-value
      674                                , error-status :get-message ( 1 ) ).
      675       end.                                                                    end.
      676   end.
