        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.pl-gds.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Триггер на удаление pl-gds":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4'
       29                            , ub.pl-gds.obj-type
       30                            , ub.pl-gds.obj-code
       31                            , ub.pl-gds.pl-code
       32                            , ub.pl-gds.gds-code
       33                            )
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure cur-time :
       88      define output parameter p-today as date      no-undo .
       89      define output parameter p-time  as integer   no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       define variable v-date1 as date      no-undo .
       94       define variable v-date2 as date      no-undo .
       95       define variable v-time  as integer   no-undo .
       96       assign
       97         v-date1 = today
       98         v-time  = time
       99         v-date2 = today
      100       .
      101       if v-date1 <> v-date2
      102       then do:
      103         assign
      104           v-date1 = today
      105           v-time  = v-time
      106         .
      107       end.
      108       assign
      109         p-today = v-date1
      110         p-time  = v-time
      111       .
      112     end.
      113   end.
      114   function cur-time-date returns character
      115   :
      116     return string(today, '99/99/9999':U) .
      117   end.
      118   function cur-time-mjd returns decimal
      119   :
      120     define variable v-date as date      no-undo .
      121     define variable v-time as integer   no-undo .
      122     run cur-time in this-procedure
      123       (output v-date
      124       ,output v-time
      125       ) .
      126     return integer(v-date) - 2400002 + (v-time / 86400) .
      127   end.
      128   function cur-time-get-ending-index returns integer
      129   (input p-number as integer
      130   )
      131   :
      132     if p-number < 0
      133     or p-number = ?
      134     then do:
      135       return 1 .
      136     end.
      137     define variable v-rest as integer   no-undo .
      138     assign
      139       p-number = p-number modulo 100
      140     .
      141     if p-number < 20
      142     then do:
      143       assign
      144         v-rest = p-number
      145       .
      146     end.
      147     else do:
      148       assign
      149         v-rest = p-number modulo 10
      150       .
      151     end.
      152     case v-rest :
      153       when 1
      154       then do:
      155         return 2 .
      156       end.
      157       when 2 or
      158       when 3 or
      159       when 4
      160       then do:
      161         return 3 .
      162       end.
      163       otherwise do:
      164         return 1 .
      165       end.
      166     end case .
      167   end.
      168   procedure cur-time-mjd-to-date :
      169      define input  parameter i-mjd-diff as decimal no-undo.
      170      define output parameter o-Date     as date    no-undo.
      171      define output parameter o-Time     as integer no-undo.
      172      define variable v-day-number as integer   no-undo .
      173      if    i-mjd-diff < 0
      174         or i-mjd-diff = ?
      175      then do:
      176         return "?" .
      177      end.
      178      assign
      179         v-day-number = truncate(i-mjd-diff,0).
      180         o-Date = date(v-day-number + 2400002).
      181         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      182     .
      183   end.
      184   function cur-time-mjd-to-string returns character
      185   (input p-mjd-diff as decimal
      186   )
      187   :
      188     define variable v-day-number as integer   no-undo .
      189     define variable v-seconds    as integer   no-undo .
      190     define variable v-hour       as integer   no-undo .
      191     define variable v-min        as integer   no-undo .
      192     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      193     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      194     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      195     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      196     if p-mjd-diff < 0
      197     or p-mjd-diff = ?
      198     then do:
      199       return "?" .
      200     end.
      201     assign
      202       v-day-number = integer(truncate(p-mjd-diff,0))
      203       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      204     .
      205     if v-seconds > 86400
      206     then do:
      207       assign
      208         v-seconds = 86400 - 1
      209       .
      210     end.
      211     if v-seconds < 0
      212     then do:
      213       assign
      214         v-seconds = 0
      215       .
      216     end.
      217     assign
      218       v-hour = truncate(v-seconds / 3600, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 3600
      222     .
      223     assign
      224       v-min = truncate(v-seconds / 60, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 60
      228     .
      229     return
      230         (if v-day-number <> 0
      231           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0
      235           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      239           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      240           else ""
      241         )
      242       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      243       .
      244   end.
      245   function cur-time-string returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      254   end.
      255   function cur-time-string-sec returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      264   end.
      265   function cur-time-custom  returns character
      266   (input p-prefix as character
      267   ,input p-date-format as character
      268   ,input p-delimiter as character
      269   ,input p-time-format as character
      270   ,input p-suffix as character
      271   )
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return
      280       p-prefix
      281       + string(v-date, p-date-format)
      282       + p-delimiter
      283       + string(v-time, p-time-format)
      284       + p-suffix
      285       .
      286   end.
      287   function cur-time-print  returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-datetime returns datetime
      298   :
      299     define variable v-char as character no-undo .
      300     define variable v-datetime as datetime no-undo .
      301     v-char = cur-time-string().
      302     v-datetime = datetime(v-char).
      303     return  v-datetime.
      304   end.
      305   function cur-time-string-msec returns character
      306   :
      307     define variable v-date as datetime  no-undo .
      308     v-date = now.
      309     return string(v-date) .
      310   end.
      311   define variable v-log      as   logical      no-undo.
      312   define variable v-db-num   like ub.db.db-num no-undo.
      313   define variable str1       as   character    no-undo.
      314   define variable jj         as   integer      no-undo.
      315   DEFINE VARIABLE v-today as date no-undo .
      316   DEFINE VARIABLE v-time as integer no-undo .
      317   define variable v-host-code like ub.sysconf.host-code no-undo .
      318   define buffer buf_goods   for ub.goods.
      319   define buffer buf_units   for ub.units.
      320   define buffer buf_place   for ub.place.
      321   define buffer buf_c-gds-hist for ub.c-gds-hist.
      322   define buffer buf_c-pl-gds  for ub.c-pl-gds.
      323   define buffer buf_c-plc-hist  for ub.c-plc-hist.
      324   define buffer buf_c-table-bind for ub.c-table-bind.
      325   main-block:
      326   do
      327   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      328   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      329   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
      330   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      332     (input  ub.pl-gds.obj-type
      333     ,input  ub.pl-gds.obj-code
      334     ,output v-db-num
      335     )  .
      336     if g#db-num <> v-db-num
      337     and g#news <> yes
      338     then do:
      339         message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      340                 "Нельзя удалять запись ТОВАРА НА СКЛАДСКОМ МЕСТЕ в БД, отличной от БД объекта." skip
      341                 "Номер текущей БД:" g#db-num skip "Номер БД объекта:" v-db-num
      342         view-as alert-box error.
      343         undo main-block, return error.
      344     end.
      345     if ub.pl-gds.fact-qnty <> 0 or
      346        ub.pl-gds.free-qnty <> 0 or
      347        ub.pl-gds.cli-free-qnty <> 0 or
      348        ub.pl-gds.cli-fact-qnty <> 0
      349         then do:
      350         message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      351                 "Количество по товару не равно 0!" skip
      352                 "Код товара" pl-gds.gds-code skip
      353                 "Код резервуара" pl-gds.pl-code skip
      354                 "Факт кол-во (е.п.)" pl-gds.cli-fact-qnty skip
      355                 "Свободно кол-во (е.п.)" pl-gds.cli-free-qnty skip
      356                 "Факт (кол-во)" pl-gds.fact-qnty skip
      357                 "Свободно (кол-во)" pl-gds.free-qnty skip
      358                 "Удаление невозможно!"
      359         view-as alert-box error.
      360         undo main-block, return error.
      361     end.
      362     find first buf_goods no-lock where
      363                buf_goods.gds-code = ub.pl-gds.gds-code no-error.
      364     if not available buf_goods then do:
      365       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      366               "Не найден товар с кодом " ub.pl-gds.gds-code
      367       view-as alert-box error.
      368       undo main-block, return error.
      369     end.
      370     find first buf_units no-lock where
      371                buf_units.unit-name = buf_goods.unit-base no-error.
      372     if not available buf_goods then do:
      373       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      374               "Не найдена единица измерения " buf_goods.unit-base
      375       view-as alert-box error.
      376       undo main-block, return error.
      377     end.
      378     if lookup( 'топ':U,  buf_units.type ) > 0 or
      379        lookup( 'дро':U, buf_units.type ) > 0 then do:
      380       assign
      381         v-log = no
      382       .
      383       run trg/pl-gdsdv.p (  input ub.pl-gds.obj-type,
      384                         input ub.pl-gds.obj-code,
      385                         input ub.pl-gds.pl-code,
      386                         input ub.pl-gds.gds-code,
      387                        output v-log               ) no-error.
      388       if error-status :error then do:
      389           message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      390                   "Ошибка при вызове процедуры (триггера)" skip
      391                   "объект" ub.pl-gds.obj-type ub.pl-gds.obj-code skip
      392                   "скл.место" ub.pl-gds.pl-code skip
      393                   "товар" ub.pl-gds.gds-code skip
      394                   error-status :get-message( 1 ) skip
      395                   return-value
      396           view-as alert-box error.
      397           undo main-block, return error.
      398       end.
      399       if v-log <> yes then do:
      400           message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      401                   "Не удалось удалить запись." skip
      402                   return-value
      403           view-as alert-box information.
      404           undo main-block, return error.
      405       end.
      406     end.
      407     if not g#news then do:
      408       run nws/cmd-del.p ( input 'pl-gds':U
      409                       ,input ( buffer ub.pl-gds :handle )
      410                       ,input "":U                          ) no-error.
      411       if error-status :error then do:
      412         assign str1 = chr(10).
      413         do jj = 1 to error-status :num-messages :
      414           assign str1 = str1 + chr(10) + error-status :get-message ( jj ).
      415         end.
      416         undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&4",
      417                                       vss-workfile, chr(10), return-value, str1 ).
      418       end.
      419     end.
      420     if g#news <> yes then do:
      421       run cur-time in this-procedure(output v-today, output v-time).
      422       create buf_c-pl-gds.
      423       buffer-copy ub.pl-gds to buf_c-pl-gds
      424       assign
      425       buf_c-pl-gds.chip-num           = next-value (s-plc-chip, ub)
      426       buf_c-pl-gds.corr-time          = v-time
      427       buf_c-pl-gds.corr-user-db-num   = g#db-num
      428       buf_c-pl-gds.corr-user-name     = g#userid
      429       buf_c-pl-gds.corr-date          = v-today
      430       .
      431       create buf_c-plc-hist.
      432       buffer-copy buf_c-pl-gds to buf_c-plc-hist
      433       assign
      434       buf_c-plc-hist.action = integer('99':U)
      435       buf_c-plc-hist.subject = 'pl-gds':U
      436       buf_c-plc-hist.is-news = g#news
      437       .
      438   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      440     (input  ub.pl-gds.obj-type
      441     ,input  ub.pl-gds.obj-code
      442     ,output v-host-code
      443     )  .
      444       create buf_c-gds-hist.
      445       buffer-copy buf_c-pl-gds
      446       except chip-num
      447       to buf_c-gds-hist
      448       assign
      449       buf_c-gds-hist.action = integer('99':U)
      450       buf_c-gds-hist.subject = 'pl-gds':U
      451       buf_c-gds-hist.host-code = v-host-code
      452       buf_c-gds-hist.is-news = g#news
      453       buf_c-gds-hist.chip-num = next-value (s-gds-chip, ub)
      454       buf_c-gds-hist.source-type = (if g#news then 'db':U else "":U)
      455       buf_c-gds-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      456       .
      457       create buf_c-table-bind.
      458       assign
      459       buf_c-table-bind.chip-num-rec   = buf_c-gds-hist.chip-num
      460       buf_c-table-bind.chip-num-src   = buf_c-pl-gds.chip-num
      461       buf_c-table-bind.corr-user-db-num     = buf_c-pl-gds.corr-user-db-num
      462       buf_c-table-bind.tbl-name-rec   = 'c-gds-hist':U
      463       buf_c-table-bind.tbl-name-src   = 'c-plc-hist':U
      464       buf_c-table-bind.is-news         = g#news
      465       buf_c-table-bind.corr-user-name  = g#userid
      466       buf_c-table-bind.subject        = 'pl-gds':U
      467       .
      468     end.
      469       if g#oxml = yes
      470       then do:
      471       run str/calloxml.p (
      472             input 'delete':U
      473           , input 'pl-gds':U
      474           , input ( buffer ub.pl-gds:handle )
      475       ) no-error.
      476       if error-status :error
      477       then do:
      478           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      479                                , chr(10)
      480                                , vss-workfile
      481                                , return-value
      482                                , error-status :get-message ( 1 ) ).
      483       end.
      484       end.
      485       run trg/userlog.p (
      486           input 'delete':U
      487           , input 'pl-gds':U
      488           , input ( buffer ub.pl-gds :handle )
      489           , input ?
      490           , input ""
      491           ) no-error.
      492       if error-status :error
      493           then
      494       do:
      495           undo, return substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      496               , chr(10)
      497               , vss-workfile
      498               , return-value
      499               , error-status :get-message ( 1 ) ).
      500       end.
      501   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      502     (input ?
      503     ,input this-procedure:handle
      504     ,input ?
      505     ,input 'ref-event':U
      506     ,input  buffer ub.pl-gds:handle
      507     ,input ''
      508     ,input ''
      509     ,input ''
      510     ) no-error .
      511     if error-status :error
      512     then
      513     do:
      514         return error substitute( "&2&1Ошибка маршрутизации записи в машину правил&1&3&1&4"
      515             , chr(10)
      516             , vss-workfile
      517             , return-value
      518             , error-status :get-message ( 1 ) ).
      519   end.
      520   end.
