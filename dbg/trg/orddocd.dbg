        1   block-level on error undo, throw.
        2   trigger procedure for delete of ub.order-doc.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo init "Тригер удаления order-doc".
        9   define buffer buf_order-doc-attr for ub.order-doc-attr.
       10   define buffer buf_order-line for ub.order-line.
       11   for each buf_order-doc-attr where
       12            buf_order-doc-attr.db-num   = order-doc.db-num
       13        and buf_order-doc-attr.doc-code = order-doc.doc-code
       14       exclusive-lock:
       15     delete buf_order-doc-attr.
       16   end.
       17   for each buf_order-line where
       18            buf_order-line.db-num   = order-doc.db-num
       19        and buf_order-line.doc-code = order-doc.doc-code
       20       exclusive-lock:
       21     delete buf_order-line.
       22   end.
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   procedure cur-time :
       94      define output parameter p-today as date      no-undo .
       95      define output parameter p-time  as integer   no-undo .
       96     do
       97     on error undo, return error
       98     :
       99       define variable v-date1 as date      no-undo .
      100       define variable v-date2 as date      no-undo .
      101       define variable v-time  as integer   no-undo .
      102       assign
      103         v-date1 = today
      104         v-time  = time
      105         v-date2 = today
      106       .
      107       if v-date1 <> v-date2
      108       then do:
      109         assign
      110           v-date1 = today
      111           v-time  = v-time
      112         .
      113       end.
      114       assign
      115         p-today = v-date1
      116         p-time  = v-time
      117       .
      118     end.
      119   end.
      120   function cur-time-date returns character
      121   :
      122     return string(today, '99/99/9999':U) .
      123   end.
      124   function cur-time-mjd returns decimal
      125   :
      126     define variable v-date as date      no-undo .
      127     define variable v-time as integer   no-undo .
      128     run cur-time in this-procedure
      129       (output v-date
      130       ,output v-time
      131       ) .
      132     return integer(v-date) - 2400002 + (v-time / 86400) .
      133   end.
      134   function cur-time-get-ending-index returns integer
      135   (input p-number as integer
      136   )
      137   :
      138     if p-number < 0
      139     or p-number = ?
      140     then do:
      141       return 1 .
      142     end.
      143     define variable v-rest as integer   no-undo .
      144     assign
      145       p-number = p-number modulo 100
      146     .
      147     if p-number < 20
      148     then do:
      149       assign
      150         v-rest = p-number
      151       .
      152     end.
      153     else do:
      154       assign
      155         v-rest = p-number modulo 10
      156       .
      157     end.
      158     case v-rest :
      159       when 1
      160       then do:
      161         return 2 .
      162       end.
      163       when 2 or
      164       when 3 or
      165       when 4
      166       then do:
      167         return 3 .
      168       end.
      169       otherwise do:
      170         return 1 .
      171       end.
      172     end case .
      173   end.
      174   procedure cur-time-mjd-to-date :
      175      define input  parameter i-mjd-diff as decimal no-undo.
      176      define output parameter o-Date     as date    no-undo.
      177      define output parameter o-Time     as integer no-undo.
      178      define variable v-day-number as integer   no-undo .
      179      if    i-mjd-diff < 0
      180         or i-mjd-diff = ?
      181      then do:
      182         return "?" .
      183      end.
      184      assign
      185         v-day-number = truncate(i-mjd-diff,0).
      186         o-Date = date(v-day-number + 2400002).
      187         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189   end.
      190   function cur-time-mjd-to-string returns character
      191   (input p-mjd-diff as decimal
      192   )
      193   :
      194     define variable v-day-number as integer   no-undo .
      195     define variable v-seconds    as integer   no-undo .
      196     define variable v-hour       as integer   no-undo .
      197     define variable v-min        as integer   no-undo .
      198     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      199     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      200     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      201     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      202     if p-mjd-diff < 0
      203     or p-mjd-diff = ?
      204     then do:
      205       return "?" .
      206     end.
      207     assign
      208       v-day-number = integer(truncate(p-mjd-diff,0))
      209       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      210     .
      211     if v-seconds > 86400
      212     then do:
      213       assign
      214         v-seconds = 86400 - 1
      215       .
      216     end.
      217     if v-seconds < 0
      218     then do:
      219       assign
      220         v-seconds = 0
      221       .
      222     end.
      223     assign
      224       v-hour = truncate(v-seconds / 3600, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 3600
      228     .
      229     assign
      230       v-min = truncate(v-seconds / 60, 0)
      231     .
      232     assign
      233       v-seconds = v-seconds modulo 60
      234     .
      235     return
      236         (if v-day-number <> 0
      237           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0
      241           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      245           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      246           else ""
      247         )
      248       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      249       .
      250   end.
      251   function cur-time-string returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      260   end.
      261   function cur-time-string-sec returns character
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      270   end.
      271   function cur-time-custom  returns character
      272   (input p-prefix as character
      273   ,input p-date-format as character
      274   ,input p-delimiter as character
      275   ,input p-time-format as character
      276   ,input p-suffix as character
      277   )
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return
      286       p-prefix
      287       + string(v-date, p-date-format)
      288       + p-delimiter
      289       + string(v-time, p-time-format)
      290       + p-suffix
      291       .
      292   end.
      293   function cur-time-print  returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-datetime returns datetime
      304   :
      305     define variable v-char as character no-undo .
      306     define variable v-datetime as datetime no-undo .
      307     v-char = cur-time-string().
      308     v-datetime = datetime(v-char).
      309     return  v-datetime.
      310   end.
      311   function cur-time-string-msec returns character
      312   :
      313     define variable v-date as datetime  no-undo .
      314     v-date = now.
      315     return string(v-date) .
      316   end.
      317   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      318   procedure gen-key-rec :
      319     define input  parameter p-tbl-name    as character no-undo.
      320     define input  parameter p-bh_tbl-name as handle    no-undo.
      321     define output parameter p-key-rec     as character no-undo.
      322     do
      323     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      324     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      325     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      326     :
      327       define variable fh               as handle    no-undo .
      328       define variable v-ok             as logical   no-undo .
      329       define variable v-inform         as character no-undo .
      330       define variable v-ind            as integer   no-undo .
      331       define variable v-idx-field-qnty as integer   no-undo .
      332       if p-tbl-name = ?
      333         or p-tbl-name = "":U
      334       then do:
      335         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      336       end.
      337       if not p-bh_tbl-name:available then do:
      338         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      339       end.
      340       assign
      341         p-key-rec = p-tbl-name
      342         v-inform  = p-bh_tbl-name:index-information(1)
      343         v-ind     = 2
      344       .
      345       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      346       on error undo, return error
      347       :
      348         assign
      349           v-inform = p-bh_tbl-name:index-information( v-ind )
      350           v-ind    = v-ind + 1
      351         .
      352       end.
      353       if v-inform = ?
      354         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      355         or entry( 3, v-inform, ",":U ) <> "1":U
      356       then do:
      357         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      358       end.
      359       else do:
      360         assign
      361           v-idx-field-qnty = num-entries( v-inform ) - 4
      362         .
      363         if v-idx-field-qnty < 2 then do:
      364           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      365         end.
      366         do v-ind = 1 to v-idx-field-qnty by 2
      367         on error undo, return error
      368         :
      369           assign
      370             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      371             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      372           .
      373         end.
      374       end.
      375       if p-key-rec = ? then do:
      376         assign
      377           p-key-rec = "":U
      378         .
      379         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      380       end.
      381     end.
      382     return.
      383   end procedure.
      384   procedure gen-where-keyr-tab :
      385     define input  parameter i-tableSerach as character no-undo.
      386     define input  parameter i-tablekey   as character  no-undo.
      387     define input  parameter p-key-rec    as character  no-undo.
      388     define input  parameter p-key-handle as handle     no-undo .
      389     define input  parameter p-db-name    as character  no-undo .
      390     define input  parameter p-tt-handle  as handle     no-undo .
      391     define output parameter o-Where      as character  no-undo.
      392     do
      393     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      394     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      395     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      396     :
      397       define variable v-full-tbl-name  as character no-undo .
      398       define variable bh_tbl-name      as handle    no-undo .
      399       define variable fh_key           as handle    no-undo .
      400       define variable fh_search        as handle    no-undo .
      401       define variable v-field-num      as integer   no-undo .
      402       define variable v-count-fld      as integer   no-undo .
      403       define variable v-inform         as character no-undo .
      404       define variable v-ind            as integer   no-undo .
      405       define variable v-idx-field-qnty as integer   no-undo .
      406       define variable v-field-name     as character no-undo .
      407       define variable v-field-val      as character no-undo .
      408       define variable v-word-link      as character no-undo .
      409       define variable vTable           as character no-undo.
      410       define variable bh_tbl-key       as handle    no-undo .
      411       assign
      412         p-key-rec = trim( p-key-rec )
      413       .
      414       if p-key-handle <> ? then do:
      415         if not valid-handle(p-key-handle)
      416            or p-key-handle:type <> "buffer"
      417         then do:
      418           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      419         end.
      420         if num-entries( p-key-rec, chr(3) ) > 1
      421           or p-key-rec = ?
      422           or p-key-rec = "":U
      423         then do:
      424           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      425         end.
      426       end.
      427       else do:
      428         if p-key-rec = ?
      429           or p-key-rec = "":U
      430         then do:
      431           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      432         end.
      433       end.
      434       assign
      435         vTable = entry( 1 , p-key-rec, chr(3) )
      436       .
      437       if p-tt-handle <> ?
      438         and ( not valid-handle(p-tt-handle)
      439               or p-tt-handle:type <> "buffer"
      440             )
      441       then do:
      442         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      443       end.
      444       if p-tt-handle = ? then do:
      445         assign
      446           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      447         .
      448         create buffer bh_tbl-name for table v-full-tbl-name .
      449       end.
      450       else do:
      451         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      452       end.
      453       assign
      454         v-inform = bh_tbl-name:index-information(1)
      455         v-ind    = 2
      456       .
      457       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      458       on error undo, return error
      459       :
      460         assign
      461           v-inform = bh_tbl-name:index-information( v-ind )
      462           v-ind    = v-ind + 1
      463         .
      464       end.
      465       if v-inform = ?
      466         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      467         or entry( 3, v-inform, ",":U ) <> "1":U
      468       then do:
      469         delete object bh_tbl-name no-error.
      470         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      471       end.
      472       assign
      473         v-idx-field-qnty = num-entries( v-inform ) - 4
      474       .
      475       if v-idx-field-qnty < 2 then do:
      476         delete object bh_tbl-name no-error.
      477         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      478       end.
      479       assign
      480         o-where     = "where":U
      481         v-word-link = "":U
      482         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      483         v-count-fld = 0
      484       .
      485       if i-tablekey ne "" and i-tablekey ne ?
      486       then do:
      487         assign
      488           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      489         .
      490         create buffer bh_tbl-key for table v-full-tbl-name .
      491       end.
      492       if i-tableSerach ne "" and i-tableSerach ne ?
      493       then do:
      494         delete object bh_tbl-name no-error.
      495         assign
      496           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      497         .
      498         create buffer bh_tbl-name for table v-full-tbl-name .
      499       end.
      500       block_where:
      501       do v-ind = 1 to v-idx-field-qnty by 2
      502       on error undo, return error
      503       :
      504         assign
      505           v-count-fld = v-count-fld + 1
      506         .
      507         if p-key-handle = ?
      508           and v-count-fld > v-field-num
      509         then do:
      510           leave block_where.
      511         end.
      512         define variable VfieldKeyTable as handle no-undo.
      513         assign
      514           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      515           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      516         .
      517         if     bh_tbl-key ne ?
      518         then do:
      519            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      520            if VfieldKeyTable eq ?
      521            then next block_where.
      522         end.
      523         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      524         then
      525            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      526         else
      527            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      528         if p-key-handle = ? then do:
      529           assign
      530             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      531           .
      532         end.
      533         else do:
      534           assign
      535             fh_key = p-key-handle:buffer-field( v-field-name )
      536           .
      537           if fh_key = ?
      538             or not valid-handle( fh_key )
      539           then do:
      540             delete object bh_tbl-name.
      541             if     bh_tbl-key ne ?
      542             then
      543                delete object bh_tbl-key.
      544             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      545           end.
      546           assign
      547             v-field-val = fh_key:buffer-value
      548           .
      549         end.
      550         if fh_search:data-type ="character":U then do:
      551           assign
      552             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      553             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      554             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      555             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      556             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      557             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      558             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      559             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      560             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      561             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      562             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      563             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      564             v-field-val = substitute( '"&1"', v-field-val )
      565           .
      566         end.
      567         assign
      568           o-where = substitute( "&1 &2", o-where, v-field-val )
      569         .
      570         if v-word-link = "":U then do:
      571           assign
      572             v-word-link = "and":U
      573           .
      574         end.
      575       end.
      576       delete object bh_tbl-name.
      577       if     bh_tbl-key ne ?
      578       then
      579          delete object bh_tbl-key.
      580       if p-key-handle = ?
      581         and v-count-fld <> v-field-num
      582       then do:
      583         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      584       end.
      585     end.
      586   end procedure.
      587   procedure gen-hn-keyr-tab :
      588     define input  parameter i-tableSerach as character no-undo.
      589     define input  parameter i-tablekey   as character no-undo.
      590     define input  parameter p-key-rec    as character no-undo.
      591     define input  parameter p-key-handle as handle    no-undo .
      592     define input  parameter p-db-name    as character no-undo .
      593     define input  parameter p-tt-handle  as handle    no-undo .
      594     define input  parameter p-stts-lock  as integer   no-undo .
      595     define output parameter o-hn         as handle    no-undo.
      596     define variable v-full-tbl-name as character no-undo.
      597     define variable v-where         as character no-undo.
      598     define variable bh_tbl-name     as handle    no-undo.
      599     define variable vTable          as character no-undo.
      600     do
      601     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      602     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      603     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      604         run gen-where-keyr-tab(i-tableSerach,
      605                                i-tablekey,
      606                                p-key-rec,
      607                                p-key-handle,
      608                                p-db-name,
      609                                p-tt-handle,
      610                                output v-where).
      611         if i-tableSerach ne "" and i-tableSerach ne ?
      612         then do:
      613            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      614            create buffer bh_tbl-name for table v-full-tbl-name .
      615         end.
      616         else do:
      617            if p-tt-handle = ? then do:
      618               assign
      619                  vTable = entry( 1 , p-key-rec, chr(3) )
      620               .
      621               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      622               create buffer bh_tbl-name for table v-full-tbl-name .
      623            end.
      624            else do:
      625               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      626            end.
      627         end.
      628         if p-tt-handle = ? then do:
      629            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      630         end.
      631         else do:
      632            bh_tbl-name:find-first( v-where ) no-error .
      633         end.
      634         o-hn = bh_tbl-name.
      635      end.
      636   end procedure.
      637   procedure gen-hn-keyr :
      638     define input  parameter p-key-rec    as character no-undo.
      639     define input  parameter p-key-handle as handle    no-undo .
      640     define input  parameter p-db-name    as character no-undo .
      641     define input  parameter p-tt-handle  as handle    no-undo .
      642     define input  parameter p-stts-lock  as integer   no-undo .
      643     define output parameter o-hn         as handle    no-undo.
      644     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      645   end.
      646   procedure gen-row-keyr :
      647     define input  parameter p-key-rec    as character no-undo.
      648     define input  parameter p-key-handle as handle    no-undo .
      649     define input  parameter p-db-name    as character no-undo .
      650     define input  parameter p-tt-handle  as handle    no-undo .
      651     define input  parameter p-stts-lock  as integer   no-undo .
      652     define output parameter p-tbl-row    as rowid     no-undo.
      653     define output parameter p-tbl-name   as character no-undo.
      654     define variable vHn as handle no-undo.
      655       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      656       p-tbl-row = if vHn:available then vHn:rowid else ?.
      657       p-tbl-name =  vHn:table.
      658       delete object vHn no-error.
      659     if p-tbl-row = ? then do:
      660       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      661     end.
      662     else do:
      663       return.
      664     end.
      665   end procedure.
      666   procedure gen-key-fv :
      667     define input  parameter p-key-rec    as character no-undo .
      668     define output parameter p-field-list as character no-undo .
      669     define output parameter p-value-list as character no-undo.
      670     do
      671     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      672     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      673     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      674     :
      675       define variable v-full-tbl-name  as character no-undo .
      676       define variable bh_tbl-name      as handle    no-undo .
      677       define variable v-tbl-name       as character no-undo .
      678       define variable v-field-num      as integer   no-undo .
      679       define variable v-count-fld      as integer   no-undo .
      680       define variable v-inform         as character no-undo .
      681       define variable v-ind            as integer   no-undo .
      682       define variable v-idx-field-qnty as integer   no-undo .
      683       define variable v-delim-key      as character no-undo .
      684       if p-key-rec = ?
      685         or p-key-rec = "":U
      686       then do:
      687         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      688       end.
      689       assign
      690         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      691         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      692       .
      693       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      694       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      695       assign
      696         v-inform = bh_tbl-name:index-information(1)
      697         v-ind    = 2
      698       .
      699       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      700       on error undo, return error
      701       :
      702         assign
      703           v-inform = bh_tbl-name:index-information( v-ind )
      704           v-ind    = v-ind + 1
      705         .
      706       end.
      707       if v-inform = ?
      708         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      709         or entry( 3, v-inform, ",":U ) <> "1":U
      710       then do:
      711         delete object bh_tbl-name no-error.
      712         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      713       end.
      714       assign
      715         v-idx-field-qnty = num-entries( v-inform ) - 4
      716       .
      717       if v-idx-field-qnty < 2 then do:
      718         delete object bh_tbl-name no-error.
      719         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      720       end.
      721       assign
      722         p-field-list = "":U
      723         p-value-list = "":U
      724         v-delim-key  = "":U
      725         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      726         v-count-fld  = 0
      727       .
      728       block_where:
      729       do v-ind = 1 to v-idx-field-qnty by 2
      730       on error undo, return error
      731       :
      732         assign
      733           v-count-fld = v-count-fld + 1
      734         .
      735         if v-count-fld > v-field-num then do:
      736           leave block_where.
      737         end.
      738         assign
      739           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      740           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      741         .
      742         if v-ind = 1 then do:
      743           assign
      744             v-delim-key = chr(3)
      745           .
      746         end.
      747       end.
      748       delete object bh_tbl-name.
      749       if v-count-fld <> v-field-num then do:
      750         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      751       end.
      752     end.
      753   end procedure.
      754   procedure gen-key-field :
      755     define input  parameter p-table      as character no-undo .
      756     define output parameter p-field-list as character no-undo .
      757     do
      758     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      759     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      760     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      761     :
      762       define variable v-full-tbl-name  as character no-undo .
      763       define variable bh_tbl-name      as handle    no-undo .
      764       define variable v-tbl-name       as character no-undo .
      765       define variable v-field-num      as integer   no-undo .
      766       define variable v-count-fld      as integer   no-undo .
      767       define variable v-inform         as character no-undo .
      768       define variable v-ind            as integer   no-undo .
      769       define variable v-idx-field-qnty as integer   no-undo .
      770       define variable v-delim-key      as character no-undo .
      771       if p-table = ?
      772         or p-table = "":U
      773       then do:
      774         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      775       end.
      776       assign
      777         v-tbl-name      = p-table
      778         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      779       .
      780       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      781       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      782       assign
      783         v-inform = bh_tbl-name:index-information(1)
      784         v-ind    = 2
      785       .
      786       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      787       on error undo, return error
      788       :
      789         assign
      790           v-inform = bh_tbl-name:index-information( v-ind )
      791           v-ind    = v-ind + 1
      792         .
      793       end.
      794       if v-inform = ?
      795         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      796         or entry( 3, v-inform, ",":U ) <> "1":U
      797       then do:
      798         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      799       end.
      800       assign
      801         v-idx-field-qnty = num-entries( v-inform ) - 4
      802       .
      803       if v-idx-field-qnty < 2 then do:
      804         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      805       end.
      806       assign
      807         p-field-list = "":U
      808         v-delim-key  = "":U
      809         v-count-fld  = 0
      810       .
      811       block_where:
      812       do v-ind = 1 to v-idx-field-qnty by 2
      813       on error undo, return error
      814       :
      815         assign
      816           v-count-fld = v-count-fld + 1
      817         .
      818         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      819         if v-ind = 1 then do:
      820           assign
      821             v-delim-key = chr(3)
      822           .
      823         end.
      824       end.
      825       delete object bh_tbl-name.
      826     end.
      827   end procedure.
      828   define buffer buf_c-order-doc  for ub.c-order-doc .
      829   define variable v-date      as date      no-undo .
      830   define variable v-time      as integer   no-undo .
      831   define variable v-field-chg as character no-undo .
      832   define variable v-Seq       as int64     no-undo init ?.
      833   define variable vFlagseq    as logical no-undo.
      834   define variable vuniq-key-rec as character no-undo.
      835   define variable v-rowid as rowid no-undo.
      836   define variable v-tbl-name as character no-undo.
      837   define buffer buf_c-order-head for ub.c-order-head .
      838       run cur-time in this-procedure (output v-date, output v-time).
      839       publish "getNextseq" ("order-doc","s-c-order-chip-num", "ub", output v-Seq ).
      840       if v-Seq = ?
      841       then
      842          v-Seq  = next-value (s-c-order-chip-num, ub).
      843       else
      844          vFlagSeq = yes.
      845       if vFlagseq
      846       then do:
      847    for first buf_c-order-doc where buf_c-order-doc.db-num eq order-doc.db-num
      848   and buf_c-order-doc.doc-code eq order-doc.doc-code
      849     and buf_c-order-doc.corr-user-db-num   = g#db-num and buf_c-order-doc.chip-num = v-Seq exclusive-lock: leave. end.
      850       end.
      851       if not available buf_c-order-doc
      852       then do:
      853          create buf_c-order-doc.
      854          buffer-copy ub.order-doc to buf_c-order-doc
      855          assign
      856            buf_c-order-doc.chip-num           = v-Seq
      857            buf_c-order-doc.corr-date          = v-date
      858            buf_c-order-doc.corr-time          = v-time
      859            buf_c-order-doc.corr-user-db-num   = g#db-num
      860            buf_c-order-doc.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
      861            buf_c-order-doc.action             = 99
      862            buf_c-order-doc.is-del             = true
      863          .
      864       end.
      865       else
      866          buf_c-order-doc.action             = 99.
      867         if vFlagSeq
      868         then do:
      869    for first buf_c-order-head where buf_c-order-head.db-num eq order-doc.db-num
      870   and buf_c-order-head.doc-code eq order-doc.doc-code
      871     and buf_c-order-head.corr-user-db-num   = g#db-num and buf_c-order-head.chip-num = v-Seq exclusive-lock: leave. end.
      872         end.
      873         if not available  buf_c-order-head
      874         then do:
      875            create buf_c-order-head.
      876            buffer-copy  buf_c-order-doc to buf_c-order-head
      877            assign
      878               buf_c-order-head.subject = "order-doc"
      879               buf_c-order-head.is-news = g#news
      880               buf_c-order-head.source-type = (if g#news
      881                                             then 'db':U
      882                                             else (if g#esys
      883                                                   then 'esys':U
      884                                                   else "":U)
      885                                             )
      886               buf_c-order-head.source-ref = (if g#news
      887                                            then string(g#news-source-db)
      888                                            else (if g#esys
      889                                                  then string(g#esys-source-esys)
      890                                                  else "":U)
      891                                            )
      892            .
      893         end.
      894         else do:
      895            if     buf_c-order-head.subject ne "*"
      896            then
      897               buf_c-order-head.subject = "*".
      898            if buf_c-order-head.action  ne 88
      899            then
      900               buf_c-order-head.action             = 88 .
      901         end.
