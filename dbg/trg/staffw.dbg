        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.staff old oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись ПЕРСОНАЛА".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                            ,  ub.staff.role
       30                            ,  ub.staff.role-level
       31                            ,  ub.staff.work-place
       32                            ,  ub.staff.staff-code
       33                            ,  ub.staff.date-start
       34                            )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
       89                                                       ,input p-range-type as character
       90                                                       ,input p-code as integer):
       91   define variable v-seq-val as integer no-undo .
       92   define buffer buf_code-range for ub.code-range.
       93   find first buf_code-range no-lock where
       94             buf_code-range.db-num = p-db-num
       95       and  buf_code-range.range-type = p-range-type
       96       and  buf_code-range.stts = 'u'
       97       and buf_code-range.first-code <= p-code
       98       and buf_code-range.last-code >= p-code no-error .
       99   if available buf_code-range then return yes.
      100   CASE p-range-type:
      101     when 'pngb':U then do:
      102       v-seq-val = current-value(s-pngb-code, ub).
      103     end.
      104     when 'fmgb':U then do:
      105       v-seq-val = current-value(s-fmgb-code, ub).
      106     end.
      107   END CASE.
      108   if p-code <= v-seq-val then do:
      109     find first buf_code-range no-lock where
      110               buf_code-range.db-num = p-db-num
      111         and  buf_code-range.range-type = p-range-type
      112         and  buf_code-range.stts = 'a'
      113         and buf_code-range.first-code <= p-code
      114         no-error .
      115    if available buf_code-range then return yes.
      116   end.
      117   find first buf_code-range no-lock where
      118             buf_code-range.db-num = p-db-num
      119       and  buf_code-range.range-type = p-range-type
      120       and  buf_code-range.stts = 'f'
      121       and buf_code-range.first-code <= p-code
      122       and buf_code-range.last-code >= p-code
      123       no-error .
      124   if available buf_code-range then return yes.
      125   return no.
      126   END FUNCTION.
      127   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      128                                                       ,input p-range-type as character
      129                                                       ,input p-code as integer):
      130   define variable v-seq-val as integer no-undo .
      131   define buffer buf_code-range for ub.code-range.
      132   CASE p-range-type:
      133     when 'pngb':U then do:
      134       v-seq-val = current-value(s-pngb-code, ub).
      135     end.
      136     when 'fmgb':U then do:
      137       v-seq-val = current-value(s-fmgb-code, ub).
      138     end.
      139   END CASE.
      140   if p-code <= v-seq-val then do:
      141     find first buf_code-range no-lock where
      142               buf_code-range.db-num = p-db-num
      143         and  buf_code-range.range-type = p-range-type
      144         and buf_code-range.first-code <= p-code
      145         and buf_code-range.last-code >= p-code no-error .
      146     if available buf_code-range then return yes.
      147   end.
      148   return no.
      149   END FUNCTION.
      150   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      151                                                       ,input p-db-num as integer
      152                                                       ,input p-staff-code as integer
      153                                                       ,input p-date as date
      154                                                        ):
      155   define buffer buf_staff for ub.staff.
      156   if p-date = ? then do:
      157     p-date = today .
      158   end.
      159   find first buf_staff no-lock where
      160             buf_staff.role = p-role
      161         and buf_staff.role-level = 'db':U
      162         and buf_staff.db-num = p-db-num
      163         and buf_staff.staff-code = p-staff-code
      164         and buf_staff.date-end >= p-date use-index pi  no-error .
      165   if available buf_staff then do:
      166     return buf_staff.psn-code.
      167   end.
      168   return 0.
      169   end FUNCTION.
      170   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      171                                                             ,input p-db-num as integer
      172                                                             ,input p-date as date
      173                                                                 ):
      174   define buffer buf_staff for ub.staff.
      175   define buffer buf2_staff for ub.staff.
      176   if p-date = ? then do:
      177     p-date = today .
      178   end.
      179   for each  buf_staff no-lock where
      180             buf_staff.role = p-role
      181         and buf_staff.db-num = p-db-num,
      182   first buf2_staff no-lock where
      183         buf2_staff.role = p-role
      184     and buf2_staff.role-level = 'db':U
      185     and buf2_staff.staff-code = buf_staff.staff-code
      186     and buf2_staff.date-start <= p-date
      187     and buf2_staff.date-end >= p-date
      188   by buf_staff.staff-code
      189   by date-start descending:
      190     return buf_staff.staff-code.
      191   end.
      192   end FUNCTION.
      193   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      194                                                  ,input p-db-num as integer
      195                                                  ,input p-psn-code as integer
      196                                                  ,input p-date as date
      197                                                  ,output p-c-password as character
      198                                                        ):
      199   define buffer buf_staff for ub.staff.
      200   if p-date = ? then do:
      201     p-date = today .
      202   end.
      203   find first buf_staff no-lock where
      204             buf_staff.role = p-role
      205         and buf_staff.role-level = 'db':U
      206         and buf_staff.db-num = p-db-num
      207        and buf_staff.date-end >= p-date
      208        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      209   if available buf_staff
      210   then do:
      211     assign
      212     p-c-password = buf_staff.password.
      213     return buf_staff.staff-code.
      214   end.
      215   p-c-password = ''.
      216   return 0.
      217   end FUNCTION.
      218   FUNCTION gbclcode-is-psn-role returns integer (
      219                                                 input p-role as character
      220                                                 ,input p-psn-code as integer
      221                                                 ,input p-date as date
      222                                                     ):
      223   define buffer buf_staff for ub.staff.
      224   if p-date = ? then do:
      225     p-date = today .
      226   end.
      227   for each buf_staff no-lock where
      228             buf_staff.psn-code = p-psn-code
      229        and  buf_staff.role = p-role
      230   by buf_staff.role-level
      231   by buf_staff.date-start
      232        :
      233     if  buf_staff.date-start <= p-date and
      234     buf_staff.date-end >= p-date  then do:
      235       return buf_staff.staff-code.
      236     end.
      237   end.
      238   return 0.
      239   end FUNCTION.
      240   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      241   define variable v-role-name as character no-undo .
      242   assign
      243   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      244   no-error .
      245   return v-role-name.
      246   END.
      247   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      248   FUNCTION gbclcode-get-position returns character ( input p-role as character
      249                                                     ,input p-role-level as character
      250                                                     ,input p-work-place as character
      251                                                     ,input p-staff-code as integer
      252                                                                ):
      253   define variable v-role-name as character no-undo .
      254   define variable v-role-level as character no-undo .
      255   define variable v-staff-code as integer no-undo .
      256   assign
      257   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      258   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      259   v-staff-code = p-staff-code
      260   no-error .
      261   return substitute("&1, &2, Код &3"
      262                   ,v-role-name
      263                   ,v-role-level
      264                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      265   END.
      266   FUNCTION gbclcode-get-work-place returns character (
      267                                                   input p-role as character
      268                                                  ,input p-role-level as character
      269                                                  ,input p-db-num as integer
      270                                                  ,input p-host-code as integer
      271                                                  ,input p-obj-type as character
      272                                                  ,input p-obj-code as integer
      273                                                  ) :
      274   define variable v-work-place as character no-undo .
      275   define variable v-obj-type as character no-undo .
      276     case p-role-level:
      277       when 'db':U then do:
      278         v-work-place = string(p-db-num, "99999").
      279       end.
      280       when 'firm':U then do:
      281         v-work-place = string(p-host-code, "99999").
      282       end.
      283       when 'object':U then do:
      284         assign
      285         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      286         .
      287       end.
      288     END CASE.
      289     return v-work-place.
      290   END FUNCTION.
      291   FUNCTION gbclcode-get-level-last-code returns integer (
      292                                                           input p-role as character
      293                                                         , input p-role-level as character
      294                                                         , input p-work-place as character
      295                                                         , input p-date-start as date
      296                                                         ):
      297   DEFINE VARIABLE v-today as date no-undo .
      298   define buffer buf_staff for ub.staff.
      299   if p-work-place = chr(63) then return ?.
      300   if p-date-start = ? then do:
      301     v-today = today .
      302   end.
      303   else do:
      304     v-today = p-date-start.
      305   end.
      306   find last buf_staff no-lock where
      307             buf_staff.role = p-role
      308        and  buf_staff.role-level = p-role-level
      309        and  buf_staff.work-place = p-work-place
      310        and  buf_staff.date-start <= v-today + 1
      311        and  buf_staff.date-end >= v-today + 1
      312        use-index pi  no-error .
      313   if available buf_staff
      314   then return buf_staff.staff-code.
      315   return 0.
      316   end FUNCTION.
      317   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      318   procedure cur-time :
      319      define output parameter p-today as date      no-undo .
      320      define output parameter p-time  as integer   no-undo .
      321     do
      322     on error undo, return error
      323     :
      324       define variable v-date1 as date      no-undo .
      325       define variable v-date2 as date      no-undo .
      326       define variable v-time  as integer   no-undo .
      327       assign
      328         v-date1 = today
      329         v-time  = time
      330         v-date2 = today
      331       .
      332       if v-date1 <> v-date2
      333       then do:
      334         assign
      335           v-date1 = today
      336           v-time  = v-time
      337         .
      338       end.
      339       assign
      340         p-today = v-date1
      341         p-time  = v-time
      342       .
      343     end.
      344   end.
      345   function cur-time-date returns character
      346   :
      347     return string(today, '99/99/9999':U) .
      348   end.
      349   function cur-time-mjd returns decimal
      350   :
      351     define variable v-date as date      no-undo .
      352     define variable v-time as integer   no-undo .
      353     run cur-time in this-procedure
      354       (output v-date
      355       ,output v-time
      356       ) .
      357     return integer(v-date) - 2400002 + (v-time / 86400) .
      358   end.
      359   function cur-time-get-ending-index returns integer
      360   (input p-number as integer
      361   )
      362   :
      363     if p-number < 0
      364     or p-number = ?
      365     then do:
      366       return 1 .
      367     end.
      368     define variable v-rest as integer   no-undo .
      369     assign
      370       p-number = p-number modulo 100
      371     .
      372     if p-number < 20
      373     then do:
      374       assign
      375         v-rest = p-number
      376       .
      377     end.
      378     else do:
      379       assign
      380         v-rest = p-number modulo 10
      381       .
      382     end.
      383     case v-rest :
      384       when 1
      385       then do:
      386         return 2 .
      387       end.
      388       when 2 or
      389       when 3 or
      390       when 4
      391       then do:
      392         return 3 .
      393       end.
      394       otherwise do:
      395         return 1 .
      396       end.
      397     end case .
      398   end.
      399   procedure cur-time-mjd-to-date :
      400      define input  parameter i-mjd-diff as decimal no-undo.
      401      define output parameter o-Date     as date    no-undo.
      402      define output parameter o-Time     as integer no-undo.
      403      define variable v-day-number as integer   no-undo .
      404      if    i-mjd-diff < 0
      405         or i-mjd-diff = ?
      406      then do:
      407         return "?" .
      408      end.
      409      assign
      410         v-day-number = truncate(i-mjd-diff,0).
      411         o-Date = date(v-day-number + 2400002).
      412         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      413     .
      414   end.
      415   function cur-time-mjd-to-string returns character
      416   (input p-mjd-diff as decimal
      417   )
      418   :
      419     define variable v-day-number as integer   no-undo .
      420     define variable v-seconds    as integer   no-undo .
      421     define variable v-hour       as integer   no-undo .
      422     define variable v-min        as integer   no-undo .
      423     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      424     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      425     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      426     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      427     if p-mjd-diff < 0
      428     or p-mjd-diff = ?
      429     then do:
      430       return "?" .
      431     end.
      432     assign
      433       v-day-number = integer(truncate(p-mjd-diff,0))
      434       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      435     .
      436     if v-seconds > 86400
      437     then do:
      438       assign
      439         v-seconds = 86400 - 1
      440       .
      441     end.
      442     if v-seconds < 0
      443     then do:
      444       assign
      445         v-seconds = 0
      446       .
      447     end.
      448     assign
      449       v-hour = truncate(v-seconds / 3600, 0)
      450     .
      451     assign
      452       v-seconds = v-seconds modulo 3600
      453     .
      454     assign
      455       v-min = truncate(v-seconds / 60, 0)
      456     .
      457     assign
      458       v-seconds = v-seconds modulo 60
      459     .
      460     return
      461         (if v-day-number <> 0
      462           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      463           else ""
      464         )
      465       + (if v-day-number <> 0 or v-hour <> 0
      466           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      467           else ""
      468         )
      469       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      470           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      471           else ""
      472         )
      473       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      474       .
      475   end.
      476   function cur-time-string returns character
      477   :
      478     define variable v-date as date      no-undo .
      479     define variable v-time as integer   no-undo .
      480     run cur-time in this-procedure
      481       (output v-date
      482       ,output v-time
      483       ) .
      484     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      485   end.
      486   function cur-time-string-sec returns character
      487   :
      488     define variable v-date as date      no-undo .
      489     define variable v-time as integer   no-undo .
      490     run cur-time in this-procedure
      491       (output v-date
      492       ,output v-time
      493       ) .
      494     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      495   end.
      496   function cur-time-custom  returns character
      497   (input p-prefix as character
      498   ,input p-date-format as character
      499   ,input p-delimiter as character
      500   ,input p-time-format as character
      501   ,input p-suffix as character
      502   )
      503   :
      504     define variable v-date as date      no-undo .
      505     define variable v-time as integer   no-undo .
      506     run cur-time in this-procedure
      507       (output v-date
      508       ,output v-time
      509       ) .
      510     return
      511       p-prefix
      512       + string(v-date, p-date-format)
      513       + p-delimiter
      514       + string(v-time, p-time-format)
      515       + p-suffix
      516       .
      517   end.
      518   function cur-time-print  returns character
      519   :
      520     define variable v-date as date      no-undo .
      521     define variable v-time as integer   no-undo .
      522     run cur-time in this-procedure
      523       (output v-date
      524       ,output v-time
      525       ) .
      526     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      527   end.
      528   function cur-time-datetime returns datetime
      529   :
      530     define variable v-char as character no-undo .
      531     define variable v-datetime as datetime no-undo .
      532     v-char = cur-time-string().
      533     v-datetime = datetime(v-char).
      534     return  v-datetime.
      535   end.
      536   function cur-time-string-msec returns character
      537   :
      538     define variable v-date as datetime  no-undo .
      539     v-date = now.
      540     return string(v-date) .
      541   end.
      542   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   procedure gen-key-rec :
      544     define input  parameter p-tbl-name    as character no-undo.
      545     define input  parameter p-bh_tbl-name as handle    no-undo.
      546     define output parameter p-key-rec     as character no-undo.
      547     do
      548     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      549     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      550     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      551     :
      552       define variable fh               as handle    no-undo .
      553       define variable v-ok             as logical   no-undo .
      554       define variable v-inform         as character no-undo .
      555       define variable v-ind            as integer   no-undo .
      556       define variable v-idx-field-qnty as integer   no-undo .
      557       if p-tbl-name = ?
      558         or p-tbl-name = "":U
      559       then do:
      560         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      561       end.
      562       if not p-bh_tbl-name:available then do:
      563         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      564       end.
      565       assign
      566         p-key-rec = p-tbl-name
      567         v-inform  = p-bh_tbl-name:index-information(1)
      568         v-ind     = 2
      569       .
      570       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      571       on error undo, return error
      572       :
      573         assign
      574           v-inform = p-bh_tbl-name:index-information( v-ind )
      575           v-ind    = v-ind + 1
      576         .
      577       end.
      578       if v-inform = ?
      579         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      580         or entry( 3, v-inform, ",":U ) <> "1":U
      581       then do:
      582         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      583       end.
      584       else do:
      585         assign
      586           v-idx-field-qnty = num-entries( v-inform ) - 4
      587         .
      588         if v-idx-field-qnty < 2 then do:
      589           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      590         end.
      591         do v-ind = 1 to v-idx-field-qnty by 2
      592         on error undo, return error
      593         :
      594           assign
      595             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      596             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      597           .
      598         end.
      599       end.
      600       if p-key-rec = ? then do:
      601         assign
      602           p-key-rec = "":U
      603         .
      604         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      605       end.
      606     end.
      607     return.
      608   end procedure.
      609   procedure gen-where-keyr-tab :
      610     define input  parameter i-tableSerach as character no-undo.
      611     define input  parameter i-tablekey   as character  no-undo.
      612     define input  parameter p-key-rec    as character  no-undo.
      613     define input  parameter p-key-handle as handle     no-undo .
      614     define input  parameter p-db-name    as character  no-undo .
      615     define input  parameter p-tt-handle  as handle     no-undo .
      616     define output parameter o-Where      as character  no-undo.
      617     do
      618     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      619     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      620     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      621     :
      622       define variable v-full-tbl-name  as character no-undo .
      623       define variable bh_tbl-name      as handle    no-undo .
      624       define variable fh_key           as handle    no-undo .
      625       define variable fh_search        as handle    no-undo .
      626       define variable v-field-num      as integer   no-undo .
      627       define variable v-count-fld      as integer   no-undo .
      628       define variable v-inform         as character no-undo .
      629       define variable v-ind            as integer   no-undo .
      630       define variable v-idx-field-qnty as integer   no-undo .
      631       define variable v-field-name     as character no-undo .
      632       define variable v-field-val      as character no-undo .
      633       define variable v-word-link      as character no-undo .
      634       define variable vTable           as character no-undo.
      635       define variable bh_tbl-key       as handle    no-undo .
      636       assign
      637         p-key-rec = trim( p-key-rec )
      638       .
      639       if p-key-handle <> ? then do:
      640         if not valid-handle(p-key-handle)
      641            or p-key-handle:type <> "buffer"
      642         then do:
      643           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      644         end.
      645         if num-entries( p-key-rec, chr(3) ) > 1
      646           or p-key-rec = ?
      647           or p-key-rec = "":U
      648         then do:
      649           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      650         end.
      651       end.
      652       else do:
      653         if p-key-rec = ?
      654           or p-key-rec = "":U
      655         then do:
      656           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      657         end.
      658       end.
      659       assign
      660         vTable = entry( 1 , p-key-rec, chr(3) )
      661       .
      662       if p-tt-handle <> ?
      663         and ( not valid-handle(p-tt-handle)
      664               or p-tt-handle:type <> "buffer"
      665             )
      666       then do:
      667         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      668       end.
      669       if p-tt-handle = ? then do:
      670         assign
      671           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      672         .
      673         create buffer bh_tbl-name for table v-full-tbl-name .
      674       end.
      675       else do:
      676         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      677       end.
      678       assign
      679         v-inform = bh_tbl-name:index-information(1)
      680         v-ind    = 2
      681       .
      682       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      683       on error undo, return error
      684       :
      685         assign
      686           v-inform = bh_tbl-name:index-information( v-ind )
      687           v-ind    = v-ind + 1
      688         .
      689       end.
      690       if v-inform = ?
      691         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      692         or entry( 3, v-inform, ",":U ) <> "1":U
      693       then do:
      694         delete object bh_tbl-name no-error.
      695         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      696       end.
      697       assign
      698         v-idx-field-qnty = num-entries( v-inform ) - 4
      699       .
      700       if v-idx-field-qnty < 2 then do:
      701         delete object bh_tbl-name no-error.
      702         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      703       end.
      704       assign
      705         o-where     = "where":U
      706         v-word-link = "":U
      707         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      708         v-count-fld = 0
      709       .
      710       if i-tablekey ne "" and i-tablekey ne ?
      711       then do:
      712         assign
      713           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      714         .
      715         create buffer bh_tbl-key for table v-full-tbl-name .
      716       end.
      717       if i-tableSerach ne "" and i-tableSerach ne ?
      718       then do:
      719         delete object bh_tbl-name no-error.
      720         assign
      721           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      722         .
      723         create buffer bh_tbl-name for table v-full-tbl-name .
      724       end.
      725       block_where:
      726       do v-ind = 1 to v-idx-field-qnty by 2
      727       on error undo, return error
      728       :
      729         assign
      730           v-count-fld = v-count-fld + 1
      731         .
      732         if p-key-handle = ?
      733           and v-count-fld > v-field-num
      734         then do:
      735           leave block_where.
      736         end.
      737         define variable VfieldKeyTable as handle no-undo.
      738         assign
      739           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      740           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      741         .
      742         if     bh_tbl-key ne ?
      743         then do:
      744            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      745            if VfieldKeyTable eq ?
      746            then next block_where.
      747         end.
      748         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      749         then
      750            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      751         else
      752            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      753         if p-key-handle = ? then do:
      754           assign
      755             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      756           .
      757         end.
      758         else do:
      759           assign
      760             fh_key = p-key-handle:buffer-field( v-field-name )
      761           .
      762           if fh_key = ?
      763             or not valid-handle( fh_key )
      764           then do:
      765             delete object bh_tbl-name.
      766             if     bh_tbl-key ne ?
      767             then
      768                delete object bh_tbl-key.
      769             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      770           end.
      771           assign
      772             v-field-val = fh_key:buffer-value
      773           .
      774         end.
      775         if fh_search:data-type ="character":U then do:
      776           assign
      777             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      778             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      779             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      780             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      781             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      782             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      783             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      784             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      785             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      786             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      787             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      788             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      789             v-field-val = substitute( '"&1"', v-field-val )
      790           .
      791         end.
      792         assign
      793           o-where = substitute( "&1 &2", o-where, v-field-val )
      794         .
      795         if v-word-link = "":U then do:
      796           assign
      797             v-word-link = "and":U
      798           .
      799         end.
      800       end.
      801       delete object bh_tbl-name.
      802       if     bh_tbl-key ne ?
      803       then
      804          delete object bh_tbl-key.
      805       if p-key-handle = ?
      806         and v-count-fld <> v-field-num
      807       then do:
      808         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      809       end.
      810     end.
      811   end procedure.
      812   procedure gen-hn-keyr-tab :
      813     define input  parameter i-tableSerach as character no-undo.
      814     define input  parameter i-tablekey   as character no-undo.
      815     define input  parameter p-key-rec    as character no-undo.
      816     define input  parameter p-key-handle as handle    no-undo .
      817     define input  parameter p-db-name    as character no-undo .
      818     define input  parameter p-tt-handle  as handle    no-undo .
      819     define input  parameter p-stts-lock  as integer   no-undo .
      820     define output parameter o-hn         as handle    no-undo.
      821     define variable v-full-tbl-name as character no-undo.
      822     define variable v-where         as character no-undo.
      823     define variable bh_tbl-name     as handle    no-undo.
      824     define variable vTable          as character no-undo.
      825     do
      826     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      827     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      828     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      829         run gen-where-keyr-tab(i-tableSerach,
      830                                i-tablekey,
      831                                p-key-rec,
      832                                p-key-handle,
      833                                p-db-name,
      834                                p-tt-handle,
      835                                output v-where).
      836         if i-tableSerach ne "" and i-tableSerach ne ?
      837         then do:
      838            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      839            create buffer bh_tbl-name for table v-full-tbl-name .
      840         end.
      841         else do:
      842            if p-tt-handle = ? then do:
      843               assign
      844                  vTable = entry( 1 , p-key-rec, chr(3) )
      845               .
      846               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      847               create buffer bh_tbl-name for table v-full-tbl-name .
      848            end.
      849            else do:
      850               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      851            end.
      852         end.
      853         if p-tt-handle = ? then do:
      854            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      855         end.
      856         else do:
      857            bh_tbl-name:find-first( v-where ) no-error .
      858         end.
      859         o-hn = bh_tbl-name.
      860      end.
      861   end procedure.
      862   procedure gen-hn-keyr :
      863     define input  parameter p-key-rec    as character no-undo.
      864     define input  parameter p-key-handle as handle    no-undo .
      865     define input  parameter p-db-name    as character no-undo .
      866     define input  parameter p-tt-handle  as handle    no-undo .
      867     define input  parameter p-stts-lock  as integer   no-undo .
      868     define output parameter o-hn         as handle    no-undo.
      869     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      870   end.
      871   procedure gen-row-keyr :
      872     define input  parameter p-key-rec    as character no-undo.
      873     define input  parameter p-key-handle as handle    no-undo .
      874     define input  parameter p-db-name    as character no-undo .
      875     define input  parameter p-tt-handle  as handle    no-undo .
      876     define input  parameter p-stts-lock  as integer   no-undo .
      877     define output parameter p-tbl-row    as rowid     no-undo.
      878     define output parameter p-tbl-name   as character no-undo.
      879     define variable vHn as handle no-undo.
      880       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      881       p-tbl-row = if vHn:available then vHn:rowid else ?.
      882       p-tbl-name =  vHn:table.
      883       delete object vHn no-error.
      884     if p-tbl-row = ? then do:
      885       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      886     end.
      887     else do:
      888       return.
      889     end.
      890   end procedure.
      891   procedure gen-key-fv :
      892     define input  parameter p-key-rec    as character no-undo .
      893     define output parameter p-field-list as character no-undo .
      894     define output parameter p-value-list as character no-undo.
      895     do
      896     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      897     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      898     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      899     :
      900       define variable v-full-tbl-name  as character no-undo .
      901       define variable bh_tbl-name      as handle    no-undo .
      902       define variable v-tbl-name       as character no-undo .
      903       define variable v-field-num      as integer   no-undo .
      904       define variable v-count-fld      as integer   no-undo .
      905       define variable v-inform         as character no-undo .
      906       define variable v-ind            as integer   no-undo .
      907       define variable v-idx-field-qnty as integer   no-undo .
      908       define variable v-delim-key      as character no-undo .
      909       if p-key-rec = ?
      910         or p-key-rec = "":U
      911       then do:
      912         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      913       end.
      914       assign
      915         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      916         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      917       .
      918       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      919       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      920       assign
      921         v-inform = bh_tbl-name:index-information(1)
      922         v-ind    = 2
      923       .
      924       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      925       on error undo, return error
      926       :
      927         assign
      928           v-inform = bh_tbl-name:index-information( v-ind )
      929           v-ind    = v-ind + 1
      930         .
      931       end.
      932       if v-inform = ?
      933         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      934         or entry( 3, v-inform, ",":U ) <> "1":U
      935       then do:
      936         delete object bh_tbl-name no-error.
      937         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      938       end.
      939       assign
      940         v-idx-field-qnty = num-entries( v-inform ) - 4
      941       .
      942       if v-idx-field-qnty < 2 then do:
      943         delete object bh_tbl-name no-error.
      944         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      945       end.
      946       assign
      947         p-field-list = "":U
      948         p-value-list = "":U
      949         v-delim-key  = "":U
      950         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      951         v-count-fld  = 0
      952       .
      953       block_where:
      954       do v-ind = 1 to v-idx-field-qnty by 2
      955       on error undo, return error
      956       :
      957         assign
      958           v-count-fld = v-count-fld + 1
      959         .
      960         if v-count-fld > v-field-num then do:
      961           leave block_where.
      962         end.
      963         assign
      964           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      965           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      966         .
      967         if v-ind = 1 then do:
      968           assign
      969             v-delim-key = chr(3)
      970           .
      971         end.
      972       end.
      973       delete object bh_tbl-name.
      974       if v-count-fld <> v-field-num then do:
      975         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      976       end.
      977     end.
      978   end procedure.
      979   procedure gen-key-field :
      980     define input  parameter p-table      as character no-undo .
      981     define output parameter p-field-list as character no-undo .
      982     do
      983     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      984     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      985     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      986     :
      987       define variable v-full-tbl-name  as character no-undo .
      988       define variable bh_tbl-name      as handle    no-undo .
      989       define variable v-tbl-name       as character no-undo .
      990       define variable v-field-num      as integer   no-undo .
      991       define variable v-count-fld      as integer   no-undo .
      992       define variable v-inform         as character no-undo .
      993       define variable v-ind            as integer   no-undo .
      994       define variable v-idx-field-qnty as integer   no-undo .
      995       define variable v-delim-key      as character no-undo .
      996       if p-table = ?
      997         or p-table = "":U
      998       then do:
      999         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1000       end.
     1001       assign
     1002         v-tbl-name      = p-table
     1003         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1004       .
     1005       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1006       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1007       assign
     1008         v-inform = bh_tbl-name:index-information(1)
     1009         v-ind    = 2
     1010       .
     1011       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1012       on error undo, return error
     1013       :
     1014         assign
     1015           v-inform = bh_tbl-name:index-information( v-ind )
     1016           v-ind    = v-ind + 1
     1017         .
     1018       end.
     1019       if v-inform = ?
     1020         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1021         or entry( 3, v-inform, ",":U ) <> "1":U
     1022       then do:
     1023         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1024       end.
     1025       assign
     1026         v-idx-field-qnty = num-entries( v-inform ) - 4
     1027       .
     1028       if v-idx-field-qnty < 2 then do:
     1029         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1030       end.
     1031       assign
     1032         p-field-list = "":U
     1033         v-delim-key  = "":U
     1034         v-count-fld  = 0
     1035       .
     1036       block_where:
     1037       do v-ind = 1 to v-idx-field-qnty by 2
     1038       on error undo, return error
     1039       :
     1040         assign
     1041           v-count-fld = v-count-fld + 1
     1042         .
     1043         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1044         if v-ind = 1 then do:
     1045           assign
     1046             v-delim-key = chr(3)
     1047           .
     1048         end.
     1049       end.
     1050       delete object bh_tbl-name.
     1051     end.
     1052   end procedure.
     1053   DEFINE VARIABLE v-today      as date      no-undo .
     1054   DEFINE VARIABLE v-time       as integer   no-undo .
     1055   define variable v-obj-type   as character no-undo .
     1056   define variable v-obj-code   as integer   no-undo .
     1057   define variable v-host-code  as integer   no-undo .
     1058   define variable conf-par     as character no-undo .
     1059   define variable par-type     as character no-undo .
     1060   define variable v-obj-db-num as integer   no-undo .
     1061   define variable v-no-uniq    as logical   no-undo .
     1062   define variable v-mess       as character no-undo .
     1063   define variable v-key-rec    as character no-undo .
     1064   define buffer buf_c-cli-hist for ub.c-cli-hist.
     1065   define buffer buf_c-staff    for ub.c-staff.
     1066   define buffer buf_staff      for ub.staff.
     1067   main-block:
     1068   do
     1069       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1070       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1071       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1072       :
     1073       if ub.staff.date-start = ?
     1074           or ub.staff.date-end = ? then
     1075       do:
     1076           message
     1077               substitute("&1 &2 &3&4" +
     1078               "Не определены даты начала или окончания работы в данной роли&4&5"
     1079               ,vss-workfile
     1080               ,vss-revision
     1081               ,vss-description
     1082               , chr(10)
     1083               ,gbclcode-get-position  ( input ub.staff.role
     1084               ,input ub.staff.role-level
     1085               ,input ub.staff.work-place
     1086               ,input ub.staff.staff-code )
     1087               )
     1088               view-as alert-box error .
     1089           undo main-block, return error  .
     1090       end.
     1091       if not g#news then
     1092       do:
     1093           if (ub.staff.db-num = 0
     1094               and g#db-num <> 0 )
     1095               or (ub.staff.db-num > 0
     1096               and g#db-num <> ub.staff.db-num
     1097               and g#db-num <> 0)
     1098               then
     1099           do:
     1100               message
     1101                   substitute("&1 &2 &3&4" +
     1102                   "Невозможно измененить запись персонала в чужой БД&4" +
     1103                   "БД персонала: &5&4" +
     1104                   "Текущая БД: &6&4&7"
     1105                   ,vss-workfile
     1106                   ,vss-revision
     1107                   ,vss-description
     1108                   ,ub.staff.db-num
     1109                   ,g#db-num
     1110                   ,gbclcode-get-position  ( input ub.staff.role
     1111                   ,input ub.staff.role-level
     1112                   ,input ub.staff.work-place
     1113                   ,input ub.staff.staff-code )
     1114                   )
     1115                   view-as alert-box error .
     1116               undo main-block, return error  .
     1117           end.
     1118           if not (ub.staff.obj-type = '':U
     1119               and
     1120               ub.staff.obj-code = 0) then
     1121           do:
     1122   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1123   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1124     (input  ub.staff.obj-type
     1125     ,input  ub.staff.obj-code
     1126     ,output v-obj-db-num
     1127     )  .
     1128               if v-obj-db-num = 0
     1129                   and g#db-num <> 0
     1130                   or (v-obj-db-num > 0
     1131                   and g#db-num <> v-obj-db-num
     1132                   and g#db-num <> 0) then
     1133               do:
     1134                   message
     1135                       substitute("&1 &2 &3&4" +
     1136                       "Невозможно измененить запись персонала в чужой БД&4" +
     1137                       "БД персонала: &5&4" +
     1138                       "Текущая БД: &6&4&7"
     1139                       ,vss-workfile
     1140                       ,vss-revision
     1141                       ,vss-description
     1142                       ,v-obj-db-num
     1143                       ,g#db-num
     1144                       ,gbclcode-get-position  ( input ub.staff.role
     1145                       ,input ub.staff.role-level
     1146                       ,input ub.staff.work-place
     1147                       ,input ub.staff.staff-code )
     1148                       )
     1149                       view-as alert-box error .
     1150                   undo main-block, return error .
     1151               end.
     1152           end.
     1153           if not new(ub.staff)
     1154               and
     1155               (ub.staff.role <> oldb.role
     1156               or
     1157               ub.staff.role-level <> oldb.role-level
     1158               or
     1159               ub.staff.work-place <> oldb.work-place
     1160               or
     1161               ub.staff.date-start <> oldb.date-start
     1162               or
     1163               ub.staff.staff-code <> oldb.staff-code
     1164               ) then
     1165           do:
     1166               message
     1167                   vss-workfile vss-revision vss-description skip
     1168                   "Для уже имеющейся записи нельзя изменить"
     1169                   "код физ.лица и/или" skip
     1170                   "роль" skip
     1171                   "место работы и/или" skip
     1172                   "дату начала работы в данной роли" skip
     1173                   view-as alert-box ERROR.
     1174               undo main-block, return error '':U.
     1175           end.
     1176       end.
     1177   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1178   if new(ub.staff) then do:
     1179     find first buf_staff no-lock where
     1180               buf_staff.role = ub.staff.role
     1181           and buf_staff.role-level = ub.staff.role-level
     1182           and buf_staff.work-place = ub.staff.work-place
     1183           and buf_staff.staff-code = ub.staff.staff-code
     1184           and buf_staff.date-start >= ub.staff.date-start no-error .
     1185     if available buf_staff
     1186     and recid(buf_staff) <> recid(ub.staff)
     1187     then do:
     1188         v-no-uniq = yes.
     1189     end.
     1190   end.
     1191   if not v-no-uniq then do:
     1192     find first buf_staff no-lock where
     1193               buf_staff.role = ub.staff.role
     1194           and buf_staff.role-level = ub.staff.role-level
     1195           and buf_staff.work-place = ub.staff.work-place
     1196           and buf_staff.staff-code = ub.staff.staff-code
     1197           and buf_staff.date-start = ub.staff.date-start no-error .
     1198     if available buf_staff
     1199     and recid(buf_staff) <> recid(ub.staff)
     1200     then do:
     1201         v-no-uniq = yes.
     1202     end.
     1203   end.
