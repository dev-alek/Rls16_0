     1416                       , input 'staff':U
     1417                       , input ( buffer ub.staff :handle )
     1418                       , input ?
     1419                       , input ""
     1420                       ) no-error.
     1421                   if error-status :error
     1422                       then
     1423                   do:
     1424                       undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     1425                           , chr(10)
     1426                           , vss-workfile
     1427                           , return-value
     1428                           , error-status :get-message ( 1 ) ).
     1429                   end.
     1430               end.
     1431           end.
