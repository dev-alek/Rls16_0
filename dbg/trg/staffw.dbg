     1208           and buf_staff.work-place = ub.staff.work-place
     1209           and buf_staff.staff-code = ub.staff.staff-code
     1210           and buf_staff.date-start <= ub.staff.date-start
     1211           and buf_staff.date-end >= ub.staff.date-start
     1212           no-error .
     1213     if available buf_staff
     1214     and recid(buf_staff) <> recid(ub.staff)
     1215     then do:
     1216         v-no-uniq = yes.
     1217     end.
     1218   end.
     1219   if not v-no-uniq then do:
     1220     find first buf_staff no-lock where
     1221               buf_staff.role = ub.staff.role
     1222           and buf_staff.role-level = ub.staff.role-level
     1223           and buf_staff.work-place = ub.staff.work-place
     1224           and buf_staff.staff-code = ub.staff.staff-code
     1225           and buf_staff.date-start <= ub.staff.date-end
     1226           and buf_staff.date-end >= ub.staff.date-end
     1227           no-error .
     1228     if available buf_staff
     1229     and recid(buf_staff) <> recid(ub.staff)
     1230     then do:
     1231         v-no-uniq = yes.
     1232     end.
     1233   end.
     1234   if not v-no-uniq then do:
     1235     find first buf_staff no-lock where
     1236               buf_staff.role = ub.staff.role
     1237           and buf_staff.role-level = ub.staff.role-level
     1238           and buf_staff.work-place = ub.staff.work-place
     1239           and buf_staff.staff-code = ub.staff.staff-code
     1240           and buf_staff.date-start >= ub.staff.date-start
     1241           and buf_staff.date-start <= ub.staff.date-end
     1242           no-error .
     1243     if available buf_staff and
     1244     recid(buf_staff) <> recid(ub.staff)
     1245     then do:
     1246         v-no-uniq = yes.
     1247     end.
     1248   end.
     1249   if not v-no-uniq then do:
     1250     find first buf_staff no-lock where
     1251               buf_staff.role = ub.staff.role
     1252           and buf_staff.role-level = ub.staff.role-level
     1253           and buf_staff.work-place = ub.staff.work-place
     1254           and buf_staff.staff-code = ub.staff.staff-code
     1255           and buf_staff.date-end >= ub.staff.date-start
     1256           and buf_staff.date-end <= ub.staff.date-end
     1257           no-error .
     1258     if available buf_staff
     1259     and recid(buf_staff) <> recid(ub.staff)
     1260     then do:
     1261         v-no-uniq = yes.
     1262     end.
     1263   end.
     1264   if v-no-uniq then do:
     1265     v-mess =  substitute("Запись ПЕРСОНАЛА с определенным кодом должна быть уникальна&1" +
     1266                 "в пределах БД или фирмы или объекта во всем периоде действия&1" +
     1267                 "(Добавлять можно только если начиная с текущего момента других таких записей нет)&1" +
     1268                 "Попытка сохранить запись - &2 Действует с &3 по &4&1" +
     1269                 "Найдена уже существующая запись - &5 Действует с &6 по &7"
     1270                 ,chr(10)
     1271                 ,gbclcode-get-position  ( input ub.staff.role
     1272                                           ,input ub.staff.role-level
     1273                                           ,input ub.staff.work-place
     1274                                           ,input ub.staff.staff-code )
     1275                 ,string(ub.staff.date-start, "99/99/9999")
     1276                 ,(if ub.staff.date-end = 12/31/9999 then "настоящее время" else string(ub.staff.date-end, "99/99/9999"))
     1277                 ,gbclcode-get-position  ( input buf_staff.role
     1278                                           ,input buf_staff.role-level
     1279                                           ,input buf_staff.work-place
     1280                                           ,input buf_staff.staff-code )
     1281                 ,string(buf_staff.date-start, "99/99/9999")
     1282                 ,(if buf_staff.date-end = 12/31/9999 then "настоящее время" else string(buf_staff.date-end, "99/99/9999"))
     1283                 ).
     1284   end.
     1285       if v-no-uniq then
     1286       do:
     1287           if g#esys then
     1288           do:
     1289             v-mess = substitute("Уже существует Кассир с кодом &1. Физ лицо - код &2. Сохранение кода кассира &3 для кода физ лица &4 невозможно.", buf_staff.staff-code, buf_staff.psn-code, ub.staff.staff-code, ub.staff.psn-code) .
     1290             return error v-mess .
     1291           end.
     1292           else
     1293           do:
     1294               message
     1295                   vss-workfile vss-revision vss-description skip
     1296                   v-mess
     1297                   view-as alert-box .
     1298               undo main-block, return error.
     1299           end.
     1300       end.
     1301       if not (g#db-num <> 0 and g#news) then
     1302       do:
     1303           run str/callnews.p (
     1304               input 'staff':U
     1305               ,input (buffer ub.staff:handle)
     1306               ) no-error .
     1307           if error-status:error then
     1308           do:
     1309               undo main-block, return error return-value .
     1310           end.
     1311       end.
     1312       run cur-time in this-procedure ( output v-today, output v-time).
     1313       create buf_c-staff.
     1314       assign
     1315           buf_c-staff.role             = ub.staff.role
     1316           buf_c-staff.role-level       = ub.staff.role-level
     1317           buf_c-staff.work-place       = ub.staff.work-place
     1318           buf_c-staff.date-start       = ub.staff.date-start
     1319           buf_c-staff.staff-code       = ub.staff.staff-code
     1320           buf_c-staff.psn-code         = (if new ub.staff then ub.staff.psn-code else oldb.psn-code)
     1321           buf_c-staff.chip-num         = next-value (s-cli-chip, ub)
     1322           buf_c-staff.corr-user-db-num = g#db-num
     1323           buf_c-staff.corr-user-name   = (if g#news
     1324                                       then (chr(4) +  'СПН':U)
     1325                                       else (if g#esys
