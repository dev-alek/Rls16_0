        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.rule-process.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление звена процесса".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4'
       29                            , ub.rule-process.pchain-type
       30                            , ub.rule-process.pchain-id
       31                            , ub.rule-process.start-from
       32                            , ub.rule-process.link-id
       33                                                     )
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-start-level as integer no-undo .
       87   define variable level as integer no-undo .
       88   define variable v-p as character no-undo .
       89   define variable v-confirmed as logical no-undo .
       90   main-block:
       91   do
       92   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       93   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       94   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       95   :
       96     assign
       97     v-start-level = 2
       98     .
       99     assign
      100       level = v-start-level
      101     .
      102     _repeat:
      103     repeat while program-name( level ) <> ? :
      104       v-p = program-name( level ).
      105       if substring(v-p, length(v-p) - length("fixrum.p") + 1) = "fixrum.p":U
      106       or substring(v-p, length(v-p) - length("fixrum.p") + 1) = "fixrum.r":U
      107       or substring(v-p, length(v-p) - length("rule-process3.p") + 1) = "rule-process3.p":U
      108       or substring(v-p, length(v-p) - length("rule-process3.p") + 1) = "rule-process3.r":U
      109       then do:
      110         v-confirmed = yes.
      111         leave _repeat.
      112       end.
      113       assign
      114         level = level + 1
      115       .
      116     end.
      117     if not v-confirmed then do:
      118       message
      119       vss-workfile vss-revision vss-description skip
      120       "Физическое удаление звена процесса в системе запрещено" skip
      121       view-as alert-box error .
      122       undo main-block, return error .
      123     end.
      124   end.
