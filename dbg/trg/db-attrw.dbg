      231   procedure db-attr-batch-edit :
      232     define input  parameter p-code           as character no-undo .
      233     define output parameter p-section-num    as integer no-undo .
      234     do
      235     on error undo, return error
      236     :
      237           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-batch-edit in g#attr-lib
      238         (input  p-code
      239         ,output p-section-num
      240         ) no-error .
      241       if error-status :error
      242       then do:
      243         undo, return error return-value .
      244       end.
      245     end.
      246   end procedure.
      247   define variable p-news as logical no-undo.
      248   main-block:
      249   do
      250   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      251   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      252   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      253   :
      254     run db-attr-news in this-procedure
      255       ( input ub.db-attr.attr-code
      256        ,output p-news
      257       ) no-error.
      258     if p-news = true then do:
      259       run str/callnews.p
      260         (input 'db-attr':U
      261         ,input (buffer ub.db-attr:handle)
      262         ) no-error .
      263       if error-status :error then do:
      264         undo, return error substitute( "&1. Невозможно маршрутизировать db-attr для отправки в новости. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      265       end.
      266     end.
      267     if g#oxml = yes
      268     then do:
      269       run str/calloxml.p (
      270             input 'update':U
      271           , input 'db-attr':U
      272           , input ( buffer ub.db-attr:handle )
      273       ) no-error.
      274       if error-status :error
      275       then do:
      276           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      277                                , chr(10)
      278                                , vss-workfile
      279                                , return-value
      280                                , error-status :get-message ( 1 ) ).
      281       end.
      282     end.
      283   end.
