      215   procedure db-attr-manual-edit :
      216     define input  parameter p-code           as character no-undo .
      217     define output parameter p-section-num    as integer no-undo .
      218     do
      219     on error undo, return error
      220     :
      221           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-manual-edit in g#attr-lib
      222         (input  p-code
      223         ,output p-section-num
      224         ) no-error .
      225       if error-status :error
      226       then do:
      227         undo, return error return-value .
      228       end.
