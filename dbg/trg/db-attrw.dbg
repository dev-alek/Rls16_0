        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.db-attr.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись db-attr".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define new global shared variable g#attr-lib  as handle no-undo .
       80   define variable v-attr-lib-variable as handle no-undo .
       81   procedure db-attr-code :
       82     define input  parameter p-code           as character no-undo .
       83     define output parameter p-type           as character no-undo .
       84     define output parameter p-format         as character no-undo .
       85     define output parameter p-label          as character no-undo .
       86     define output parameter p-user-can-edit  as logical   no-undo .
       87     define output parameter p-output-display as logical   no-undo .
       88     define output parameter p-other          as character no-undo .
       89     do
       90     on error undo, return error
       91     :
       92           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-code in g#attr-lib
       93         (input  p-code
       94         ,output p-type
       95         ,output p-format
       96         ,output p-label
       97         ,output p-user-can-edit
       98         ,output p-output-display
       99         ,output p-other
      100         ) no-error .
      101       if error-status :error
      102       then do:
      103         undo, return error return-value .
      104       end.
      105     end.
      106   end procedure.
      107   procedure db-attr-tooltip :
      108     define input  parameter p-code    as character no-undo .
      109     define output parameter p-tooltip as character no-undo .
      110     define output parameter p-label   as character no-undo .
      111     do
      112     on error undo, return error
      113     :
      114           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-tooltip in g#attr-lib
      115         (input  p-code
      116         ,output p-tooltip
      117         ,output p-label
      118         ) no-error .
      119       if error-status :error
      120       then do:
      121         undo, return error return-value .
      122       end.
      123     end.
      124   end procedure.
      125   procedure db-attr-value :
      126     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      127     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      128     define output parameter p-value     like ub.db-attr.attr-value no-undo .
      129     define output parameter p-type      as character no-undo .
      130     do
      131     on error undo, return error
      132     :
      133           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-value in g#attr-lib
      134         (input  p-db-num
      135         ,input  p-code
      136         ,output p-value
      137         ,output p-type
      138         ) no-error .
      139       if error-status :error
      140       then do:
      141         undo, return error return-value .
      142       end.
      143     end.
      144   end procedure.
      145   procedure db-attr-write :
      146     define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      147     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      148     define input parameter p-value     like ub.db-attr.attr-value no-undo .
      149     do
      150     on error undo, return error
      151     :
      152           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
      153         (input p-db-num
      154         ,input p-code
      155         ,input p-value
      156         ) no-error .
      157       if error-status :error
      158       then do:
      159         undo, return error return-value .
      160       end.
      161     end.
      162   end procedure.
      163   procedure db-attr-exist :
      164     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      165     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      166     define output parameter p-exist    as logical  no-undo .
      167     do
      168     on error undo, return error
      169     :
      170           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-exist in g#attr-lib
      171         (input  p-db-num
      172         ,input  p-code
      173         ,output p-exist
      174         ) no-error .
      175       if error-status :error
      176       then do:
      177         undo, return error return-value .
      178       end.
      179     end.
      180   end procedure.
      181   procedure db-attr-delete :
      182     define input  parameter p-db-num   like ub.db-attr.db-num     no-undo .
      183     define input  parameter p-code     like ub.db-attr.attr-code  no-undo .
      184     define output parameter p-deleted  as logical no-undo.
      185     do
      186     on error undo, return error
      187     :
      188           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-delete in g#attr-lib
      189         (input  p-db-num
      190         ,input  p-code
      191         ,output p-deleted
      192         ) no-error .
      193       if error-status :error
      194       then do:
      195         undo, return error return-value .
      196       end.
      197     end.
      198   end procedure.
      199   procedure db-attr-news :
      200     define input  parameter p-code           as character no-undo .
      201     define output parameter p-news           as logical   no-undo .
      202     do
      203     on error undo, return error
      204     :
      205           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-news in g#attr-lib
      206         (input  p-code
      207         ,output p-news
      208         ) no-error .
      209       if error-status :error
      210       then do:
      211         undo, return error return-value .
      212       end.
