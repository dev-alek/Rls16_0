      665   define variable v-output-display as logical   no-undo .
      666   define variable v-other          as character no-undo .
      667   define variable jj as integer no-undo .
      668   define variable v-host-code like ub.sysconf.host-code no-undo .
      669   define variable v-date as date no-undo .
      670   define variable v-time as integer no-undo .
      671   define buffer buf_c-gds-obj-attr for ub.c-gds-obj-attr.
      672   define buffer buf_c-gds-hist for ub.c-gds-hist.
