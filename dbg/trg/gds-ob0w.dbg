      415     end.
      416   end.
      417   procedure gdsoattr-manual-edit :
      418     define input  parameter p-code        as character no-undo .
      419     define output parameter p-section-num as integer no-undo .
      420     do
      421     on error undo, return error
      422     :
      423           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-manual-edit in g#attr-lib
      424         (input  p-code
      425         ,output p-section-num
      426         ) no-error .
      427       if error-status :error
      428       then do:
      429         undo, return error return-value .
