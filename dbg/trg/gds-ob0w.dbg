      682     if g#news then do:
      683       define variable v-send as integer no-undo .
      684       v-send = integer('0':U).
      685   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      686   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      687     (input  g#db-num
      688     ,input  'gds-obj-prop':U
      689     ,input  0
      690     ,input  '':U
      691     ,input  0
      692     ,input  '':U
      693     ,input  '':U
      694     ,input  '':U
      695     ,input  0
      696     ,input  0
      697     ,input  0
      698     ,input  'nws-to-hist'
      699     ,output v-send
