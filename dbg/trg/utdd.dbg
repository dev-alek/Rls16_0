      895   :
      896       assign
      897           p-out-string = "":U
      898       .
      899       case p-in-string
      900       :
      901           when ?
      902           then do:
      903               assign
      904                   p-out-string = "?":U
      905               .
      906           end.
      907           otherwise do:
      908               do v-position = 1 to length( p-in-string )
      909               :
      910                   assign
      911                       v-current-char = substring( p-in-string, v-position, 1 )
      912                   .
