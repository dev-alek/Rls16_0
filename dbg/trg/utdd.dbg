      723   procedure xmlchar-test :
      724   define input parameter p-in-string          as character        no-undo.
      725   define output parameter p-out-string-enc    as character        no-undo.
      726   define output parameter p-out-string-dec    as character        no-undo.
      727   do
      728   on error undo, return error
      729   :
      730          run xmlchar-encode in this-procedure
      731       (
      732             input p-in-string
      733           , output p-out-string-enc
      734       ).
      735          run xmlchar-decode in this-procedure
      736       (
      737             input p-out-string-enc
      738           , output p-out-string-dec
      739       ).
      740   end.
      741   end .
      742   procedure xmlchar-encode :
      743   define input parameter p-in-string      as character        no-undo.
      744   define output parameter p-out-string    as character        no-undo.
      745       define variable v-position      as integer      no-undo.
      746       define variable v-current-char  as character    no-undo.
      747   do
      748   on error undo, return error
      749   :
      750       assign
      751           p-out-string = "":U
      752       .
      753       case p-in-string
      754       :
      755           when ?
      756           then do:
      757               assign
      758                   p-out-string = "?":U
      759               .
      760           end.
      761           when "?":U
      762           then do:
      763               assign
      764                   p-out-string = "&#63;":U
      765               .
      766           end.
      767           otherwise do:
      768               do v-position = 1 to length( p-in-string )
      769               :
      770                   assign
      771                       v-current-char = substring( p-in-string, v-position, 1 )
      772                   .
      773                   case v-current-char
      774                   :
      775                       when "&":U
      776                       then do:
      777                           assign
      778                               p-out-string = p-out-string + "&amp;":U
      779                           .
      780                       end.
      781                       when ">":U
      782                       then do:
      783                           assign
      784                               p-out-string = p-out-string + "&gt;":U
      785                           .
      786                       end.
      787                       when "<":U
      788                       then do:
      789                           assign
      790                               p-out-string = p-out-string + "&lt;":U
      791                           .
      792                       end.
      793                       when "'":U
      794                       then do:
      795                           assign
      796                               p-out-string = p-out-string + "&apos;":U
      797                           .
      798                       end.
      799                       when '"':U
      800                       then do:
      801                           assign
      802                               p-out-string = p-out-string + "&quot;":U
      803                           .
      804                       end.
      805                       when chr(1)
      806                       then do:
      807                           assign
      808                               p-out-string = p-out-string + "":U
      809                           .
      810                       end.
      811                       when chr(2)
      812                       then do:
      813                           assign
      814                               p-out-string = p-out-string + "":U
      815                           .
      816                       end.
      817                       when chr(3)
      818                       then do:
      819                           assign
      820                               p-out-string = p-out-string + "":U
      821                           .
      822                       end.
      823                       when chr(4)
      824                       then do:
      825                           assign
      826                               p-out-string = p-out-string + "":U
      827                           .
      828                       end.
      829                       when chr(5)
      830                       then do:
      831                           assign
      832                               p-out-string = p-out-string + "":U
      833                           .
      834                       end.
      835                       when chr(6)
      836                       then do:
      837                           assign
      838                               p-out-string = p-out-string + "":U
      839                           .
      840                       end.
      841                       when chr(7)
      842                       then do:
      843                           assign
      844                               p-out-string = p-out-string + "":U
      845                           .
      846                       end.
      847                       when chr(8)
      848                       then do:
      849                           assign
      850                               p-out-string = p-out-string + "":U
      851                           .
      852                       end.
      853                       when chr(9)
      854                       then do:
      855                           assign
      856                               p-out-string = p-out-string + "":U
      857                           .
      858                       end.
      859                       when chr(29)
      860                       then do:
      861                           assign
      862                               p-out-string = p-out-string + "":U
      863                           .
      864                       end.
      865                       when chr(10)
      866                       then do:
      867                           assign
      868                               p-out-string = p-out-string + "&#10;":U
      869                           .
      870                       end.
      871                       when chr(13)
      872                       then do:
      873                           assign
      874                               p-out-string = p-out-string + "&#13;":U
      875                           .
      876                       end.
      877                       otherwise do:
      878                           assign
      879                               p-out-string = p-out-string + v-current-char
      880                           .
      881                       end.
      882                   end case.
      883               end.
      884           end.
      885       end case.
      886   end.
      887   end .
      888   procedure xmlchar-encode-1c :
