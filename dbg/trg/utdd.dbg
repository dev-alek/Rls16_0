      932                       end.
      933                       when chr(4)
      934                       then do:
      935                           assign
      936                               p-out-string = p-out-string + " ":U
      937                           .
      938                       end.
      939                       when chr(5)
      940                       then do:
      941                           assign
      942                               p-out-string = p-out-string + " ":U
      943                           .
      944                       end.
      945                       when chr(6)
      946                       then do:
      947                           assign
      948                               p-out-string = p-out-string + " ":U
      949                           .
      950                       end.
      951                       when chr(7)
      952                       then do:
      953                           assign
      954                               p-out-string = p-out-string + " ":U
      955                           .
      956                       end.
      957                       when chr(8)
      958                       then do:
      959                           assign
      960                               p-out-string = p-out-string + " ":U
      961                           .
      962                       end.
      963                       when chr(9)
      964                       then do:
      965                           assign
      966                               p-out-string = p-out-string + " ":U
      967                           .
      968                       end.
      969                       when chr(29)
      970                       then do:
      971                           assign
      972                               p-out-string = p-out-string + " ":U
      973                           .
      974                       end.
      975                       when chr(10)
      976                       then do:
      977                           assign
      978                               p-out-string = p-out-string + " ":U
      979                           .
      980                       end.
      981                       when chr(13)
      982                       then do:
      983                           assign
      984                               p-out-string = p-out-string + " ":U
      985                           .
      986                       end.
      987                       otherwise do:
      988                           assign
      989                               p-out-string = p-out-string + v-current-char
      990                           .
      991                       end.
      992                   end case.
      993               end.
      994           end.
      995       end case.
      996   end.
      997   end .
      998   procedure xmlchar-decode :
      999   define input parameter p-in-string      as character        no-undo.
     1000   define output parameter p-out-string    as character        no-undo.
     1001       define variable v-position      as integer      no-undo.
     1002       define variable v-last-position as integer      no-undo.
     1003       define variable v-temp-integer  as integer      no-undo.
     1004       define variable v-current-char  as character    no-undo.
     1005       define variable v-next-char     as character    no-undo.
     1006       define variable v-success       as logical      no-undo.
     1007   do
     1008   on error undo, return error
     1009   :
     1010       assign
     1011           p-out-string = "":U
     1012           v-position   = 0
     1013       .
     1014       replace-cycle:
     1015       do while yes
     1016       on error undo, return error
     1017       :
     1018           assign
     1019               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1020           .
     1021           if v-last-position <= v-position
     1022           then do:
     1023               if v-position = 0
     1024               then do:
     1025                   assign
     1026                       p-out-string = p-in-string
     1027                   .
     1028               end.
     1029               else do:
     1030                   assign
     1031                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1032                   .
     1033               end.
     1034               leave replace-cycle.
     1035           end.
     1036           else do:
     1037               assign
     1038                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1039                   v-position      = v-last-position
     1040                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1041               .
     1042               if v-current-char = "#":U
     1043               then do:
     1044                   assign
     1045                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1046                   .
     1047                   if v-last-position > 0
     1048                   then do:
     1049                       run xmlchar-read-integer in this-procedure
     1050                        (
     1051                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1052                           , output v-temp-integer
     1053                           , output v-success
     1054                       ).
     1055                       if v-success = yes
     1056                       and v-temp-integer >= 1
     1057                       and v-temp-integer <= 255
     1058                       then do:
     1059                           assign
     1060                               p-out-string = p-out-string + chr( v-temp-integer )
     1061                               v-position   = v-last-position + 1
     1062                           .
     1063                       end.
     1064                       else do:
     1065                           assign
     1066                               p-out-string = p-out-string + "&":U
     1067                               v-position   = v-position   + 1
     1068                           .
     1069                       end.
     1070                   end.
     1071                   else do:
     1072                       assign
     1073                           p-out-string = p-out-string + "&":U
     1074                           v-position   = v-position   + 1
     1075                       .
     1076                   end.
     1077               end.
     1078               else do:
     1079                   case substring( p-in-string, v-position + 1, 3 )
     1080                   :
     1081                       when "lt;":U
     1082                       then do:
     1083                           assign
     1084                               p-out-string = p-out-string + "<":U
     1085                               v-position   = v-position   + 3
     1086                           .
     1087                       end.
     1088                       when "gt;":U
     1089                       then do:
     1090                           assign
     1091                               p-out-string = p-out-string + ">":U
     1092                               v-position   = v-position   + 3
     1093                           .
     1094                       end.
     1095                       otherwise do:
     1096                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1097                           then do:
     1098                               assign
     1099                                   p-out-string = p-out-string + "&":U
     1100                                   v-position   = v-position   + 4
     1101                               .
     1102                           end.
     1103                           else do:
     1104                               case substring( p-in-string, v-position + 1, 5 )
     1105                               :
     1106                                   when "quot;":U
     1107                                   then do:
     1108                                       assign
     1109                                           p-out-string = p-out-string + '"':U
     1110                                           v-position   = v-position   + 5
     1111                                       .
     1112                                   end.
     1113                                   when "apos;":U
     1114                                   then do:
     1115                                       assign
     1116                                           p-out-string = p-out-string + "'":U
     1117                                           v-position   = v-position   + 5
     1118                                       .
     1119                                   end.
     1120                                   otherwise do:
     1121                                       assign
     1122                                           p-out-string = p-out-string + "&":U
     1123                                       .
     1124                                   end.
     1125                               end case.
     1126                           end.
     1127                       end.
     1128                   end case.
     1129               end.
     1130           end.
     1131       end.
     1132   end.
     1133   end .
     1134   procedure xmlchar-read-integer :
     1135   define input parameter p-input-string      as character        no-undo.
     1136   define output parameter p-output-integer   as integer          no-undo.
     1137   define output parameter p-success       as logical          no-undo.
     1138   do
     1139   on error undo, return error
     1140   :
     1141       assign
     1142           p-output-integer = integer( p-input-string )
     1143       no-error.
     1144       if error-status :error
     1145       then do:
     1146           assign
     1147               p-success           = no
     1148               p-output-integer    = 0
     1149           .
     1150       end.
     1151       else do:
     1152           assign
     1153               p-success           = yes
     1154           .
     1155       end.
     1156   end.
     1157   end.
     1158   define variable mMRCCode  as logical    no-undo.
     1159   define variable mTypeMark as character  no-undo.
     1160   function IS-NeedMark returns logical
     1161   ( input ib-code as integer  ,
     1162     input ib-str as character ):
     1163      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1164      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1165                                    and buf_prod-bc-attr.b-str  eq ib-str
     1166                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1167        no-lock no-error.
     1168      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1169   end.
     1170   function repTegforDm return char
     1171   (iDM as char ):
     1172       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1173       define variable vteg as character no-undo.
     1174       define variable oDM as character no-undo.
     1175       define variable vi as integer no-undo.
     1176       oDM = iDm.
     1177       do vi = 1 to num-entries(vTeglist):
     1178          vTeg = entry(vi,vTeglist).
     1179          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1180       end.
     1181       return oDM.
     1182   end.
     1183   function repSpecSimbforDm return char
     1184   (iDM as char ):
     1185       define variable oDM as character no-undo.
     1186     run
     1187       xmlchar-decode(iDM, output oDM).
     1188     return repTegforDm (oDM).
     1189   end.
     1190   function CheckGtin return logical
     1191   (iGtin as char):
     1192      define variable bar_code as character no-undo.
     1193      define variable vGtin as logical no-undo init "yes".
     1194      if length(iGtin) eq 14
     1195      then do:
     1196         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1197         run str/chk-sum.p
     1198          (input-output bar_code ) no-error .
     1199         if iGtin ne  bar_code
     1200         then
     1201            vGtin = no.
     1202      end.
     1203      else
     1204         vGtin = no.
     1205      return vgtin.
     1206   end.
     1207   function repSpecSimbforXlm return char
     1208   (iDM as char ):
     1209       iDM = replace(iDM,chr(29),"").
     1210       return iDM.
     1211   end.
     1212   function getGtinByDM return char
     1213   (IDM as char):
     1214      define variable VTXT as char no-undo.
     1215      define variable vGtin as char no-undo.
     1216      vTXt = IdM.
     1217      vGtin = IDM.
     1218      if    length(vtxt) > 14
     1219      then do:
     1220         if   vtxt begins "(01)"
     1221                or vtxt begins "(02)"
     1222         then
     1223            vGtin = substring(vtxt,5,14).
     1224         else if   (vtxt begins "01"
     1225                or vtxt begins "02" )
     1226                and (   (    substring(iDm,17,2) eq "21"
     1227                         and length(vtxt) >= 21)
     1228                     or substring(iDm,17,2) eq "37"
     1229                     or substring(iDm,17,4) eq "(37)" )
     1230         then do:
     1231            vGtin = substring(vtxt,3,14).
     1232            if not checkGtin(vGtin)
     1233            then
     1234               vGtin = substring(vtxt,1,14).
     1235         end.
     1236         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1237             or length(vtxt) eq 14 + 7 + 4
     1238             or length(vtxt) eq 14 + 7
     1239         then
     1240            vGtin = substring(vtxt,1,14).
     1241      end.
     1242      if not checkGtin(vGtin)
     1243      then
     1244         vGtin = "".
     1245      return vgtin.
     1246   end.
     1247   function getGdsCodeByGtin return int
     1248   (iGtin as char):
     1249      define buffer prod-bc  for ub.prod-bc.
     1250      define buffer bar-code for ub.bar-code.
     1251      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1252      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1253      return if avail bar-code then bar-code.gds-code else ?.
     1254   end.
     1255   function getQntyCodeByGtin return decimal
     1256   (iGtin as char):
     1257      define buffer prod-bc  for ub.prod-bc.
     1258      define buffer bar-code for ub.bar-code.
     1259      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1260      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1261      return if avail bar-code then bar-code.cli-base-rate else ?.
     1262   end.
     1263   function getGdsCodeByDM return int
     1264   (iDm as char):
     1265      define variable vGtin as char no-undo.
     1266      define buffer prod-bc for ub.prod-bc.
     1267      vGtin  = getGtinByDM (IDM ).
     1268      return getGdsCodeByGtin (vGtin).
     1269   end.
     1270   function ChekTypeMarkByGds return logical
     1271   (iGds-code as integer ):
     1272      define buffer goods-attr for ub.goods-attr.
     1273      find first goods-attr where goods-attr.gds-code   = iGds-code
     1274                              and goods-attr.attr-code  = 'mark-type':U
     1275      no-lock no-error.
     1276      if available goods-attr
     1277      then do:
     1278         mTypeMark = goods-attr.attr-value.
     1279         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1280           .
     1281      end.
     1282      else
     1283         return no.
     1284   end.
     1285   function ChekTypeMarkByDm return logical
     1286   (iDM as char ):
     1287      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1288   end.
     1289   function ChekTypeMarkByGtin return logical
     1290   (iGtin as char ):
     1291      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1292   end.
     1293   function GetNextElement return character
     1294     (input iAllTeg        as logical
     1295     ,output oteg          as character
     1296     ,output otegval       as character
     1297     ,input-output pstr    as character
     1298      ):
     1299        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1300        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1301        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1302        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1303        define variable vTeg as character no-undo.
     1304        define variable vLength as integer no-undo.
     1305        define variable vi as integer no-undo.
     1306        define variable vj as integer no-undo.
     1307        define buffer code for ub.code.
     1308        find first code where Code.parent eq "MarkType"
     1309                          and Code.CodeValue   eq mTypeMark
     1310                          no-lock no-error.
     1311        if     available code
     1312           and Code.misc1 ne ""
     1313           and Code.misc1 ne ?
     1314        then do:
     1315           integer (Code.misc1) no-error.
     1316           if not error-status:error
     1317           then
     1318             entry (4,vlistleng) = Code.misc1.
     1319        end.
     1320        if iAllTeg
     1321        then
     1322           assign
     1323              vlistElem     = vlistElem    + vlistElemDop
     1324              vlistleng     = vlistleng    + vlistlengDop
     1325           .
     1326        else if mMRCCode
     1327        then
     1328           assign
     1329              vlistElem     = vlistElem    + ",(8005),8005"
     1330              vlistleng     = vlistleng    + ",000006,0006"
     1331           .
     1332       block-elem:
     1333       do vi = 1 to num-entries(vlistElem):
     1334          vTeg = entry(vi,vlistElem).
     1335          if pstr begins vTeg
     1336          then do:
     1337             if    vTeg eq "21"
     1338             then
     1339                vLength = index(pstr,chr(29)) - 2 no-error.
     1340             if vLength  <= 0
     1341             then
     1342                vLength = int(entry(vi,vlistleng)).
     1343             otegval = substring (pstr,length(vteg) + 1, vLength).
     1344             oteg = replace(replace(vteg,")",""),"(","").
     1345             vTeg = vteg + otegval.
     1346             otegval = replace(otegval,chr(29),"").
     1347             oteg = replace(replace(oteg,")",""),"(","").
     1348             pstr = substring (pstr,length(vTeg)+ 1).
     1349             vTeg = replace(vTeg,chr(29),"").
     1350             leave block-elem.
     1351          end.
     1352          else
     1353             vTeg = "".
     1354       end.
     1355       return vteg.
     1356   end.
     1357   function GetCodeIdent return character
     1358   (iDm as char):
     1359      define variable Velement   as character no-undo init "first".
     1360      define variable oCodeIdent as character no-undo.
     1361      define variable vteg as character no-undo.
     1362      define variable vtegval as character no-undo.
     1363      define variable vGtin as character no-undo.
     1364      define buffer marking for ub.marking.
     1365      for first marking no-lock where
     1366                marking.mark eq iDm
     1367            and marking.unit-ext = "LEVEL2"
     1368      :
     1369        return iDm.
     1370      end.
     1371      vGtin  = getGtinByDM (iDm ).
     1372      ChekTypeMarkByDm(idm).
     1373      if iDm begins 'tech_':U
     1374      then
     1375         oCodeIdent = iDm.
     1376      else if length(iDm) < 21
     1377      then do:
     1378         find first marking where marking.mark eq idm
     1379         no-lock no-error.
     1380         oCodeIdent = if available marking then marking.mark else  ?.
     1381      end.
     1382      else if     length(iDm) eq 29
     1383         and not iDm begins "01"
     1384         and not iDm begins "02"
     1385      then
     1386         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1387      else  if     length(iDm) >= 24
     1388               and (  iDm begins "01"
     1389                   or iDm begins "02")
     1390               and  substring(iDm,17,2) ne "21"
     1391      then do:
     1392         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1393                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1394         then
     1395            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1396         else
     1397            oCodeIdent = iDM.
     1398      end.
     1399      else  if     (   length(iDm) eq 25
     1400                    or length(iDm) eq 21)
     1401               and (not iDm begins "01"
     1402               and  not iDm begins "02")
     1403      then
     1404         oCodeIdent = substring(iDm,1,21).
     1405      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1406      then
     1407         oCodeIdent = substring(iDm,1,21).
     1408      else do while Velement ne "" and idm ne "":
     1409         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1410         oCodeIdent = oCodeIdent + Velement.
     1411      end.
     1412      return oCodeIdent.
     1413   end.
     1414   function GetTegCod return character
     1415   (icodeIdent as char, iTeg as char):
     1416      define variable Velement   as character no-undo init "first".
     1417      define variable oTeg as character no-undo init ?.
     1418      define variable vteg as character no-undo.
     1419      define variable vtegval as character no-undo.
     1420      if     ((length(icodeIdent) eq 21
     1421         and not icodeIdent begins "01"
     1422         and not icodeIdent begins "02")
     1423         or
     1424             ( length(icodeIdent) eq 25
     1425               and not icodeIdent begins "01"
     1426               and not icodeIdent begins "02"))
     1427      then do:
     1428         if iTeg eq "01" or iTeg eq "02"
     1429         then
     1430            oTeg = substring(icodeIdent,1,21).
     1431         else  if  iTeg eq "21"
     1432         then
     1433            oTeg = substring(icodeIdent,15,7).
     1434      end.
     1435      else do:
     1436         ChekTypeMarkByDm(icodeIdent).
     1437         block-teg:
     1438            do while Velement ne "" and icodeIdent ne "":
     1439            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1440            if    Velement begins iTeg
     1441               or Velement begins "(" + iTeg + ")"
     1442            then do:
     1443               oTeg = vtegval.
     1444               leave block-teg.
     1445            end.
     1446         end.
     1447      end.
     1448      return oTeg.
     1449   end.
     1450   function isOAD return logical
     1451   (icodeIdent as character):
     1452      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1453   end.
     1454   function isMark return logical
     1455   (icodeIdent as character):
     1456      define buffer buf_marking for ub.marking.
     1457      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1458             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1459   end.
     1460   function addBracketForCode return character
     1461   (icodeIdent as char):
     1462      define variable Velement   as character no-undo init "first".
     1463      define variable oTeg as character no-undo.
     1464      define variable vteg as character no-undo.
     1465      define variable vtegval as character no-undo.
     1466      define buffer marking for ub.marking.
     1467      find first marking no-lock where
     1468                 marking.mark begins icodeIdent no-error.
     1469      if    not ChekTypeMarkByDm(icodeIdent)
     1470         or length(icodeIdent) le 24
     1471         or (avail marking and marking.unit-ext = "LEVEL2")
     1472      then
     1473         oTeg = icodeIdent.
     1474      else do:
     1475         if (  icodeIdent begins "01"
     1476            or icodeIdent begins "02"
     1477            ) and CheckGtin(substring (icodeIdent,3,14))
     1478            and substring (icodeIdent,17,2) eq "21"
     1479         then do:
     1480            mMRCCode = yes.
     1481            ChekTypeMarkByDm(icodeIdent).
     1482            block-teg:
     1483            do while Velement ne "" and icodeIdent ne "":
     1484               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1485               if vteg ne ""
     1486               then
     1487                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1488            end.
     1489            mMRCCode = no.
     1490         end.
     1491         else do:
     1492            oTeg = icodeIdent.
     1493         end.
     1494      end.
     1495      return oTeg.
     1496   end.
     1497   function getlevelByCodId return int
     1498   (iCode as char):
     1499      define variable vLength as int no-undo.
     1500      define variable vLevel  as int no-undo.
     1501      if not ChekTypeMarkByDM (icode) then return ?.
     1502      vLength = length(iCode).
     1503      if    vLength eq 18
     1504         or vLength eq 20
     1505      then
     1506         Vlevel = 4.
     1507      else if vLength eq 21
     1508      then
     1509         Vlevel = 1.
     1510      else if vLength eq 25
     1511      then do:
     1512         if  iCode begins "01"
     1513         then
     1514            Vlevel = 3.
     1515         else
     1516            Vlevel = 1.
     1517      end.
     1518      else if     vLength >= 26
     1519              and vLength <= 46
     1520      then do:
     1521         if    substring(iCode,17,2) eq "11"
     1522            or substring(iCode,17,2) eq "13"
     1523            or (    substring(iCode,17,2) eq "21"
     1524                and vLength >= 33
     1525                and substring(iCode,26,4) ne "8005")
     1526         then
     1527            Vlevel = 4.
     1528         else if    vLength eq 31
     1529                 or vLength eq 38
     1530                 or vLength eq 39
     1531                 or vLength eq 45
     1532         then
     1533            Vlevel = 1.
     1534         else if    vLength eq 35
     1535                 or vLength eq 43
     1536         then
     1537            Vlevel = 3.
     1538         else
     1539            Vlevel = ?.
     1540      end.
     1541      else
     1542         Vlevel = ?.
     1543      return Vlevel.
     1544   end.
     1545   function getLevelMotpBycodid return character
     1546   (iDm as char):
     1547      define variable vLevel as integer no-undo.
     1548      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1549      vLevel = getlevelByCodId(iDm).
     1550      if    vLevel eq ?
     1551         or vLevel < 1
     1552         or vLevel > 6
     1553      then
     1554         return ?.
     1555      else
     1556         return entry(vlevel,vList).
     1557   end.
     1558   function getLevelUTDByLevelMotp return character
     1559   (iUnit as char):
     1560      define variable vLevel as integer no-undo.
     1561      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1562      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1563      vLevel = lookup(iUnit,vListMOTP).
     1564      if    vLevel eq ?
     1565         or vLevel < 1
     1566         or vLevel > 4
     1567      then
     1568         return ?.
     1569      else
     1570         return entry(vlevel,vListutd).
     1571   end.
     1572   function getLevelMotpByDM return character
     1573   (iDm as char):
     1574      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1575   end.
     1576   function getLevelUTDByCodId return character
     1577   (iDm as char):
     1578      define variable vLevel as integer no-undo.
     1579      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1580      vLevel = getlevelByCodId(iDm).
     1581      if    vLevel eq ?
     1582         or vLevel < 1
     1583         or vLevel > 4
     1584      then
     1585         return ?.
     1586      else
     1587         return entry(vlevel,vList).
     1588   end.
     1589   function getLevelUTDByDM return character
     1590   (iDm as char):
     1591      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1592   end.
     1593   define variable mNotMarkQnty as logical no-undo.
     1594   function getQntyUTDByCodId return decimal
     1595   (iDM as char):
     1596      define variable vLevel as integer no-undo.
     1597      define variable vList as character no-undo init "1,5,10,500".
     1598      define variable vGtin as character no-undo.
     1599      define variable vqnty as decimal no-undo init ?.
     1600      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1601      if vqnty eq ?
     1602      then do:
     1603         if not mNotMarkQnty
     1604         then do:
     1605            define buffer marking for ub.marking.
     1606            define variable vCodident as character no-undo.
     1607            vCodident = GetCodeIdent(idm).
     1608            find first marking where marking.mark begins vCodident no-lock no-error.
     1609            if     available marking
     1610               and marking.box-qnty ne ?
     1611            then
     1612               return marking.box-qnty.
     1613         end.
     1614         vGtin = getGtinByDm(iDM).
     1615         if ChekTypeMarkByGtin (vGtin)
     1616         then do:
     1617            vLevel = getlevelByCodId(iDM).
     1618            if     vLevel >= 1
     1619               and vLevel <= 4
     1620            then
     1621               vqnty = int(entry(vlevel,vList)).
     1622         end.
     1623         else
     1624            vqnty = getQntyCodeByGtin(vgtin).
     1625      end.
     1626      return vqnty.
     1627   end.
     1628   function getQntyUTDByDM return decimal
     1629   (iDm as char):
     1630      define variable vDM as character no-undo.
     1631      if     length (iDm) ne 25
     1632         and length (iDm) ne 29
     1633         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1634      then
     1635         vDM = substring (iDm,1,length (iDm) - 6 ).
     1636      else
     1637         vDM = substring (iDm,1,length (iDm) - 4 ).
     1638      return getQntyUTDByCodId(vDM).
     1639   end.
     1640   function getMRC4 return decimal
     1641   (iMRC as char):
     1642      define variable oMrc     as decimal no-undo init ?.
     1643      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1644      define variable vi       as integer no-undo.
     1645      define variable vfound   as integer no-undo.
     1646      define variable vposStart   as integer no-undo.
     1647      do:
     1648      OMRc = 0.
     1649      do vi = 1 to 4:
     1650         define variable vsimb as character no-undo.
     1651         vsimb = substring(iMRC,vi,1).
     1652         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1653         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1654         if vfound > 0
     1655         then
     1656            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1657         end.
     1658         OMRc = OMRc / 100.
     1659      end.
     1660      return OMRc.
     1661   end.
     1662   function getMRCByDM return decimal
     1663   (iDm as char):
     1664      define variable vMRC     as character no-undo.
     1665      define variable oMrc     as decimal no-undo init ?.
     1666      define variable Velement as character no-undo init "empty".
     1667      define variable vteg as character no-undo.
     1668      define variable vtegval as character no-undo.
     1669      if    length(idm) eq 14 + 7 + 4 + 4
     1670         or length(idm) eq 14 + 7 + 4
     1671      then do:
     1672         vMRC = substring(idm,22,4).
     1673         omrc = getMRC4(vMRC).
     1674      end.
     1675      else do:
     1676          ChekTypeMarkByDm(iDm).
     1677          block-mrc:
     1678          do while Velement ne "" and idm ne "":
     1679             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1680             if Velement begins "8005"
     1681             then do:
     1682                vMRC = substring(Velement,5,6).
     1683                leave block-mrc.
     1684             end.
     1685             else if Velement begins "(8005)"
     1686             then do:
     1687                vMRC = substring(Velement,7,6).
     1688                leave block-mrc.
     1689             end.
     1690          end.
     1691          if vMRC ne ""
     1692          then
     1693             OMRc = dec(vmrc) / 100 no-error.
     1694      end.
     1695      return OMRc.
     1696   end.
     1697   function MoveDate return Date
     1698   (idate as date,
     1699    iMonth as int64):
     1700      define variable vMonth   as int64 no-undo.
     1701      define variable vYear    as int64 no-undo.
     1702      define variable vDateNew as date  no-undo.
     1703       define variable vDay     as int64 no-undo.
     1704       vMonth = month(iDate) + iMonth.
     1705       vYear =  year(iDate).
     1706       if vMonth <= 0
     1707       then assign
     1708          vMonth = vMonth + 12
     1709           vYear  = vYear - 1
     1710       .
     1711       else if vMonth > 12
     1712       then assign
     1713          vMonth = vMonth - 12
     1714           vYear  = vYear + 1
     1715       .
     1716       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1717       do while error-status:error eq yes:
     1718          VDay = vDay + 1.
     1719          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1720       end.
     1721       if VDay > 0
     1722       then
     1723          vDateNew + 1.
     1724       return vDateNew.
     1725   end.
     1726   procedure checkEMRC:
     1727   define input  parameter iDm as character no-undo.
     1728   define output parameter vok as logical   no-undo init yes.
     1729      define variable v-value-emrc as character no-undo.
     1730      define variable v-type-emrc  as character no-undo.
     1731      define variable vDateIso     as character no-undo.
     1732      define variable vMRC         as decimal no-undo.
     1733      define variable vqnty        as decimal no-undo.
     1734      define variable vPrice       as decimal no-undo.
     1735      define variable vparent      as character no-undo.
     1736      define variable vgds-code    as integer no-undo.
     1737      define buffer code for ub.code.
     1738      vMRC = getMRCByDM(iDm).
     1739      if vMRC > 0
     1740      then do:
     1741         vgds-code = getGdsCodeByDM(iDm).
     1742         vqnty     = getQntyUTDByDM(iDm).
     1743               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1744            (
     1745             input   vgds-code
     1746            ,input   'emrc-type':U
     1747            ,output   v-value-emrc
     1748            ,output   v-type-emrc
     1749          ) no-error.
     1750          if     v-value-emrc ne ""
     1751             and v-value-emrc ne ?
     1752          then do:
     1753             vDateIso = iso-date(today).
     1754             vPrice = vMRC / vqnty.
     1755             vparent ="emc" + chr(4) + v-value-emrc.
     1756             find last code where Code.parent      eq vparent
     1757                              and Code.code        le vDateIso
     1758                              and code.status_  eq 0
     1759             no-lock no-error.
     1760             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1761             then
     1762                vOk = true .
     1763             else do:
     1764                 define variable vText      as character no-undo.
     1765                 define variable vDate      as date no-undo.
     1766                 define variable vDateLast  as character no-undo.
     1767                 define variable vDateFirst as character no-undo.
     1768                 define variable vDate3     as date no-undo.
     1769                 vdate = date(code.misc1).
     1770                 vDateLast = code.misc1.
     1771                 vDate3 = MoveDate(today, - 3 ).
     1772                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1773                                      string(vDate3  , "99/99/9999"),
     1774                                      string(vDate   , "99/99/9999")
     1775                                      ).
     1776                 vdateIso = iso-date(vdate3).
     1777                 find last code  where Code.parent      eq vparent
     1778                                   and Code.code        le vDateIso
     1779                                   and code.status_  eq 0 no-lock no-error.
     1780                 if available code
     1781                 then
     1782                    vDateIso = code.code.
     1783                 vDateFirst = vDateIso.
     1784                 vDateLast = iso-date(vdate).
     1785                 define variable vGood as logical no-undo.
     1786                 define variable vDateSale as date no-undo.
     1787                 define buffer bcode for code.
     1788                 for last code where Code.parent   eq vparent
     1789                                 and code.status_  eq 0
     1790                                 and code.code     < vDateLast
     1791                                 and code.code     >= vDateFirst
     1792                 no-lock:
     1793                    find first bcode where bCode.parent   eq vparent
     1794                                       and bcode.status_  eq 0
     1795                                       and bcode.code     > code.code no-lock no-error.
     1796                    if available bcode
     1797                    then do:
     1798                       if vPrice < dec(Code.CodeValue)
     1799                       then
     1800                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1801                                                     chr(10),
     1802                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1803                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1804                                                     ).
     1805                       else do:
     1806                          vGood = yes.
     1807                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1808                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1809                                                     chr(10),
     1810                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1811                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1812                                                     string(         vDateSale            ,"99/99/9999"),
     1813                                                     string(vDateSale - today)
     1814                                                     ).
     1815                       end.
     1816                    end.
     1817                 end.
     1818                 if vgood
     1819                 then do:
     1820                    define variable choice as integer no-undo .
     1821                    run gbl/d-askw.w (input "Уточнение"
     1822                           ,input  vText
     1823                           ,input "|"
     1824                           ,input "Принять|Вернуть"
     1825                           ,input "Принять данный товар|Вернуть товар постащику"
     1826                           ,input 1
     1827                           ,input 2
     1828                           ,output choice) no-error.
     1829                    vok = choice eq 1.
     1830                 end.
     1831                 else
     1832                    vok =false.
     1833             end.
     1834          end.
     1835      end.
     1836   end.
     1837   function addGs2Mark return character
     1838   (iMark as char):
     1839      define variable vDM   as character no-undo.
     1840      define variable vIdx  as integer   no-undo.
     1841      if index(iMark,chr(29),1) > 0
     1842      then return iMark.
     1843      if substring(iMark,26,4) = "8005" then
     1844      do:
     1845        vIdx = index(iMark,"93",26 + 4 + 5).
     1846        if vIdx > 1 then do:
     1847          vDM = substitute("&1&4&2&4&3",
     1848                           substring(iMark,1,25),
     1849                           substring(iMark,26,vIdx - 25 - 1),
     1850                           substring(iMark,vIdx),
     1851                           chr(29)) no-error.
     1852          vIdx = index(vDm,"240",vIdx + 4).
     1853          if vIdx > 0 then
     1854          do:
     1855            vDM = substitute("&1&3&2",
     1856                             substring(vDm,1,vIdx - 1),
     1857                             substring(vDm,vIdx),
     1858                             chr(29)) no-error.
     1859          end.
     1860        end.
     1861        else
     1862          vDM = substitute("&1&3&2",
     1863                           substring(iMark,1,25),
     1864                           substring(iMark,26),
     1865                           chr(29)) no-error.
     1866      end.
     1867      else if substring(iMark,32,2) = "91" then
     1868      do:
     1869        vIdx = index(iMark,"92",32).
     1870        if vIdx > 1 then
     1871          vDM = substitute("&1&4&2&4&3",
     1872                           substring(iMark,1,31),
     1873                           substring(iMark,32,vIdx - 31 - 1),
     1874                           substring(iMark,vIdx),
     1875                           chr(29)) no-error.
     1876        else
     1877          vDM = substitute("&1&3&2",
     1878                           substring(iMark,1,31),
     1879                           substring(iMark,32),
     1880                           chr(29)) no-error.
     1881      end.
     1882      else if substring(iMark,39,2) = "91" then
     1883      do:
     1884        vIdx = index(iMark,"92",38).
     1885        if vIdx > 1 then
     1886          vDM = substitute("&1&4&2&4&3",
     1887                           substring(iMark,1,38),
     1888                           substring(iMark,39,vIdx - 38 - 1),
     1889                           substring(iMark,vIdx),
     1890                           chr(29)) no-error.
     1891        else
     1892          vDM = substitute("&1&3&2",
     1893                           substring(iMark,1,38),
     1894                           substring(iMark,39),
     1895                           chr(29)) no-error.
     1896      end.
     1897      else if substring(iMark,25,2) = "93" then
     1898      do:
     1899        vIdx = index(iMark,"92",25).
     1900        if vIdx > 1 then
     1901          vDM = substitute("&1&4&2&4&3",
     1902                           substring(iMark,1,24),
     1903                           substring(iMark,25,vIdx - 24 - 1),
     1904                           substring(iMark,vIdx),
     1905                           chr(29)) no-error.
     1906        else
     1907          vIdx = index(iMark,"3103",25).
     1908          if vIdx > 0 then
     1909          vDM = substitute("&1&4&2&4&3",
     1910                           substring(iMark,1,24),
     1911                           substring(iMark,25,vIdx - 24 - 1),
     1912                           substring(iMark,vIdx),
     1913                           chr(29)) no-error.
     1914          else
     1915            vDM = substitute("&1&3&2",
     1916                             substring(iMark,1,24),
     1917                             substring(iMark,25),
     1918                             chr(29)) no-error.
     1919      end.
     1920      else if substring(iMark,32,2) = "93" then
     1921      do:
     1922        vDM = substitute("&1&3&2",
     1923              substring(iMark,1,31),
     1924              substring(iMark,32),
     1925              chr(29)) no-error.
     1926      end.
     1927      return if vDM <> "" then vDm else iMark.
     1928   end.
     1929   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1930   function AddUtdErrForTab returns logical
     1931   (idb-num         as integer ,
     1932    idoc-id         as integer ,
     1933    iTab            as character,
     1934    iObj            as handle ,
     1935    iCheckType      as character,
     1936    iCodeErr        as character,
     1937    iCheckObj       as character ):
     1938      define buffer utd-err for utd-err.
     1939      define buffer utd for utd.
     1940      find first utd where utd.db-num     eq idb-num
     1941                       and utd.doc-id     eq idoc-id
     1942                       and utd.Direction  eq 'Outbound'
     1943      no-lock no-error.
     1944      if available utd
     1945      then
     1946         return no.
     1947      define variable vRecKey as character no-undo.
     1948            run gen-key-rec (input iTab,
     1949                             input  iObj,
     1950                             output vRecKey).
     1951      find first utd-err where utd-err.db-num     eq idb-num
     1952                           and utd-err.doc-id     eq idoc-id
     1953                           and utd-err.CheckType  eq iCheckType
     1954                           and utd-err.CodeErr    eq iCodeErr
     1955                           and utd-err.CheckObj   eq iCheckObj
     1956      exclusive-lock no-error.
     1957      if not available utd-err
     1958      then do:
     1959         create utd-err.
     1960         assign
     1961            utd-err.db-num         = idb-num
     1962            utd-err.doc-id         = idoc-id
     1963            utd-err.CheckType      = iCheckType
     1964            utd-err.CodeErr        = iCodeErr
     1965            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     1966            utd-err.reckey         = vRecKey
     1967            utd-err.qnty           = 1
     1968         .
     1969      end.
     1970      else
     1971         utd-err.qnty = utd-err.qnty + 1.
     1972      return utd-err.qnty eq 1.
     1973   end.
     1974   function AddUtdErr returns logical
     1975   (idb-num         as integer ,
     1976    idoc-id         as integer ,
     1977    iObj            as handle ,
     1978    iCheckType      as character,
     1979    iCodeErr        as character,
     1980    iCheckObj       as character ):
     1981      AddUtdErrForTab
     1982         (idb-num,
     1983          idoc-id,
     1984          iObj:table,
     1985          iObj,
     1986          iCheckType,
     1987          iCodeErr,
     1988          iCheckObj).
     1989   end.
     1990   function ClearUtdErrTypeCode returns logical
     1991   (idb-num         as integer,
     1992    idoc-id         as integer ,
     1993    iCheckType      as character,
     1994    iCodeErr        as character
     1995    ):
     1996      define buffer utd-err for utd-err.
     1997      if    iCheckType eq "*"
     1998         or iCheckType eq ?
     1999      then do:
     2000         if     iCodeErr ne ?
     2001            and iCodeErr ne "*"
     2002         then
     2003            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2004            view-as alert-box.
     2005         else
     2006         for each utd-err where utd-err.db-num  eq idb-num
     2007                            and utd-err.doc-id  eq idoc-id
     2008         exclusive-lock:
     2009            delete utd-err.
     2010         end.
     2011      end.
     2012      else do:
     2013         if    iCodeErr eq ?
     2014            or iCodeErr eq "*"
     2015         then do:
     2016            for each utd-err where utd-err.db-num     eq idb-num
     2017                               and utd-err.doc-id     eq idoc-id
     2018                               and utd-err.CheckType  eq iCheckType
     2019            exclusive-lock:
     2020               delete utd-err.
     2021            end.
     2022         end.
     2023         else do:
     2024            for each utd-err where utd-err.db-num     eq idb-num
     2025                               and utd-err.doc-id     eq idoc-id
     2026                               and utd-err.CheckType  eq iCheckType
     2027                               and ub.utd-err.CodeErr eq iCodeErr
     2028            exclusive-lock:
     2029               delete utd-err.
     2030            end.
     2031         end.
     2032      end.
     2033   end.
     2034   function ClearUtdErr returns logical
     2035   (idb-num         as integer,
     2036    idoc-id         as integer ,
     2037    iCheckType      as character
     2038    ):
     2039      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2040   end.
     2041   function GetMesError returns character
     2042   (itxt as character,
     2043    iobj as character ):
     2044    define variable vi as integer no-undo.
     2045    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2046       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2047    end.
     2048    return itxt.
     2049   end.
     2050   function GetTextErrorType returns character
     2051   (iCheckType as character,
     2052    iCodeErr   as character,
     2053    iChechObj  as character,
     2054    iType      as character  ):
     2055      define buffer code    for code.
     2056      define variable vError as character no-undo.
     2057      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2058                        and code.code   eq iCodeErr
     2059      no-lock no-error.
     2060      if available code
     2061      then do:
     2062         define variable vType as integer no-undo.
     2063         if code.misc3 eq "error"
     2064         then
     2065            vType = 0.
     2066         else if code.misc3 eq "warning"
     2067         then
     2068            vType = 1.
     2069         else if code.misc3 eq "Hiden"
     2070         then
     2071            vType = 2.
     2072         else
     2073            vtype = int(code.misc3) no-error.
     2074         case itype:
     2075            when "error"
     2076            then do:
     2077               if vtype eq 0
     2078               then
     2079                  vError = GetMesError(Code.CodeValue,iChechObj).
     2080            end.
     2081            when "warning"
     2082            then do:
     2083               if vtype <= 1
     2084               then
     2085                  vError = GetMesError(Code.CodeValue,iChechObj).
     2086            end.
     2087            otherwise do:
     2088               vError = GetMesError(Code.CodeValue,iChechObj).
     2089            end.
     2090         end.
     2091      end.
     2092      else
     2093         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2094      return vError.
     2095   end.
     2096   function GetTypeError returns integer
     2097   (iCheckType as character,
     2098    iCodeErr   as character):
     2099      define buffer code    for code.
     2100      define variable vType as integer no-undo.
     2101      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2102                        and code.code   eq iCodeErr
     2103      no-lock no-error.
     2104      if     not available code
     2105         and code.misc3 eq "error"
     2106      then
     2107         vType = 0.
     2108      else if code.misc3 eq "warning"
     2109      then
     2110         vType = 1.
     2111      else if code.misc3 eq "Hiden"
     2112      then
     2113         vType = 2.
     2114      else
     2115         vtype = int(code.misc3) no-error.
     2116      return vtype.
     2117   end.
     2118   function GetTextError returns character
     2119   (iCheckType as character,
     2120    iCodeErr   as character,
     2121    iChechObj  as character ):
     2122      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2123   end.
     2124   function GetErrForUtdStr returns character
     2125   (idb-num     as integer ,
     2126    idoc-id     as integer ,
     2127    iCheckType  as character
     2128    ):
     2129      define buffer utd-err for utd-err.
     2130      define buffer code    for code.
     2131      define variable vHQry as handle no-undo.
     2132      define variable vError as longchar no-undo.
     2133      define variable vErrorOne as longchar  no-undo.
     2134      define variable oError as character no-undo.
     2135      create query vHQry.
     2136      vHQry:set-buffers(buffer utd-err:handle).
     2137      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2138                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2139                               + if    iCheckType eq "*"
     2140                                    or iCheckType eq ?
     2141                                 then       ""
     2142                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2143      vHQry:query-open().
     2144      vHQry:get-first().
     2145      QRY-BLOCK:
     2146      repeat while not vHQry:query-off-end:
     2147         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2148         if     vErrorOne ne ""
     2149            and vErrorOne ne ?
     2150         then
     2151            vError = vError + ", " + vErrorOne.
     2152         vHQry:get-next().
     2153      end.
     2154      oError = substring(vError,3,4002).
     2155      return oError.
     2156   end.
     2157   function GetErrJsonForUtd returns character
     2158   (idb-num         as integer ,
     2159    idoc-id         as integer ,
     2160    iCheckType      as character
     2161    ):
     2162      define buffer utd-err for utd-err.
     2163      define variable vHQry as handle no-undo.
     2164      define variable vError as longchar no-undo.
     2165      define variable oError as character no-undo.
     2166      create query vHQry.
     2167      define variable vi as integer no-undo.
     2168      vHQry:set-buffers(buffer utd-err:handle).
     2169      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2170                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2171                               + if    iCheckType eq "*"
     2172                                    or iCheckType eq ?
     2173                                 then       ""
     2174                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2175      vHQry:query-open().
     2176      vHQry:get-first().
     2177      QRY-BLOCK:
     2178      repeat while not vHQry:query-off-end:
     2179         define variable vErrorOne as character no-undo.
     2180         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2181         if     vErrorOne ne ?
     2182            and vErrorOne ne ""
     2183         then do:
     2184            vi = vi + 1.
     2185            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2186                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2187                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2188         end.
     2189         vHQry:get-next().
     2190      end.
     2191      for first utd where utd.db-num eq idb-num
     2192                      and utd.doc-id eq idoc-id
     2193                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2194      no-lock,
     2195         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2196                                  and utd-marking-lines.doc-id eq idoc-id
     2197                                  and utd-marking-lines.doc-level eq 1
     2198      no-lock,
     2199         first marking where marking.mark eq utd-marking-lines.mark
     2200                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2201      no-lock:
     2202         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2203         if     vErrorOne ne ?
     2204            and vErrorOne ne ""
     2205         then do:
     2206            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2207                            + '","ОбъектОш":"' + marking.mark
     2208                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2209         end.
     2210      end.
     2211      if vError ne ""
     2212      then
     2213         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2214      return oError.
     2215   end.
     2216   function GetErrJsonForUtdReturn returns character
     2217   (idb-num         as integer ,
     2218    idoc-id         as integer ,
     2219    iCheckType      as character
     2220    ):
     2221      define buffer utd-err for utd-err.
     2222      define variable vHQry as handle no-undo.
     2223      define variable vError as longchar no-undo.
     2224      define variable oError as character no-undo.
     2225      define variable vi as integer no-undo.
     2226      create query vHQry.
     2227      vHQry:set-buffers(buffer utd-err:handle).
     2228      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2229                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2230                               + if    iCheckType eq "*"
     2231                                    or iCheckType eq ?
     2232                                 then       ""
     2233                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2234      vHQry:query-open().
     2235      vHQry:get-first().
     2236      QRY-BLOCK:
     2237      repeat while not vHQry:query-off-end:
     2238         define variable vErrorOne as character no-undo.
     2239         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2240         if     vErrorOne ne ?
     2241            and vErrorOne ne ""
     2242         then do:
     2243            vi = vi + 1.
     2244            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2245                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2246                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2247         end.
     2248         vHQry:get-next().
     2249      end.
     2250      if vError ne ""
     2251      then
     2252         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2253      return oError.
     2254   end.
     2255   function GetCodeTextError returns character
     2256   (iCheckType as character,
     2257    iCodeErr   as character,
     2258    iChechObj  as character,
     2259    output oCode as character,
     2260    output ovalue as character ):
     2261      define buffer code    for code.
     2262      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2263                        and code.code   eq iCodeErr
     2264      no-lock no-error.
     2265      if     available code
     2266      then do:
     2267         define variable vi as integer no-undo init ?.
     2268         vi = int(Code.misc3) no-error.
     2269         if    code.misc3 ne "error"
     2270            and vi ne 0
     2271         then
     2272            oCode = ?.
     2273         else if     Code.misc1 ne ?
     2274                 and Code.misc1 ne ""
     2275         then
     2276            assign
     2277               oCode  = GetMesError(Code.misc1,iChechObj)
     2278               ovalue = GetMesError(Code.misc2,iChechObj)
     2279            .
     2280      end.
     2281      return if oCode eq ""
     2282             then ""
     2283             else (oCode + "_" + ovalue).
     2284   end.
     2285   define temp-table TT-err no-undo
     2286     field code_ as character
     2287     field text_ as character
     2288   index code_ code_.
     2289   function GetErrTxtForUtd returns character
     2290   (idb-num         as integer ,
     2291    idoc-id         as integer ,
     2292    iCheckType      as character
     2293    ):
     2294      define buffer utd-err for utd-err.
     2295      define variable vHQry as handle no-undo.
     2296      define variable oError as character no-undo.
     2297      create query vHQry.
     2298      define variable vi as integer no-undo.
     2299      for each tt-err :
     2300         delete tt-err.
     2301      end.
     2302      vHQry:set-buffers(buffer utd-err:handle).
     2303      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2304                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2305                               + if    iCheckType eq "*"
     2306                                    or iCheckType eq ?
     2307                                 then       ""
     2308                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2309      vHQry:query-open().
     2310      vHQry:get-first().
     2311      define variable vcode as character no-undo.
     2312      define variable vvalue as character no-undo.
     2313      QRY-BLOCK:
     2314      repeat while not vHQry:query-off-end:
     2315         vi = vi + 1.
     2316         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2317         if vcode ne ?
     2318         then do:
     2319            find first tt-err where tt-err.code eq vcode
     2320            no-error.
     2321            if not available tt-err
     2322            then do:
     2323               create tt-err.
     2324               assign
     2325                  tt-err.code_ = vcode
     2326                  tt-err.text_ = vvalue
     2327               .
     2328            end.
     2329            else
     2330               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2331         end.
     2332         vHQry:get-next().
     2333      end.
     2334     find first utd where utd.db-num eq idb-num
     2335                         and utd.doc-id eq idoc-id
     2336         no-lock.
     2337      define buffer cancel_utd-lines for utd-lines.
     2338      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2339                                  and cancel_utd-lines.doc-id eq idoc-id
     2340      no-lock:
     2341         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2342         then do:
     2343            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2344                                        and utd-marking-lines.doc-id eq idoc-id
     2345                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2346            no-lock,
     2347               first marking where marking.mark eq utd-marking-lines.mark
     2348                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2349            no-lock:
     2350               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2351               find first tt-err where tt-err.code eq vcode
     2352               no-error.
     2353               if not available tt-err
     2354               then do:
     2355                  create tt-err.
     2356                  assign
     2357                     tt-err.code_ = vcode
     2358                     tt-err.text_ = vvalue
     2359                  .
     2360               end.
     2361               else
     2362                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2363            end.
     2364         end.
     2365         else do:
     2366            define variable vqnty as decimal no-undo.
     2367            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2368            if vqnty eq ? then vqnty = 0.
     2369            if vqnty ne cancel_utd-lines.Quantity
     2370            then do:
     2371               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2372               find first tt-err where tt-err.code eq vcode
     2373               no-error.
     2374               if not available tt-err
     2375               then do:
     2376                  create tt-err.
     2377                  assign
     2378                     tt-err.code_ = vcode
     2379                     tt-err.text_ = vvalue
     2380                  .
     2381               end.
     2382               else
     2383                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2384            end.
     2385         end.
     2386      end.
     2387      for each tt-err:
     2388         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2389      end.
     2390      return oError.
     2391   end.
     2392   define variable mFormatErr as character no-undo init "text".
     2393   function GetErrForUtd returns character
     2394   (idb-num         as integer ,
     2395    idoc-id         as integer ,
     2396    iType           as character
     2397    ):
     2398      if mFormatErr eq "text"
     2399      then
     2400         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2401      else do:
     2402         if itype eq "return"
     2403         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2404         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2405      end.
     2406   end.
     2407   function GetErrComText returns longchar
     2408   (icomment as character,
     2409    itext    as longchar ):
     2410       define variable vText as longchar no-undo.
     2411      if mFormatErr eq "text"
     2412      then do:
     2413         if icomment ne ""
     2414         then
     2415            icomment = substitute("comment:|&1|",icomment).
     2416         vText = icomment + itext.
     2417      end.
     2418      else do:
     2419         icomment = if icomment begins  '"'
     2420                    then icomment
     2421                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2422         vText = icomment + "," + itext.
     2423         vText = "~{" + trim(vText,",") + "~}".
     2424      end.
     2425      return vText.
     2426   end.
     2427   function CheckTypeForMarkLineType returns logical
     2428   (iObj            as handle,
     2429    iCheckType      as character,
     2430    iCodeErr        as character ,
     2431    iTypeErr        as character ):
     2432      define variable vRecKey-markLine as character no-undo.
     2433      define variable vGoodMark        as logical no-undo.
     2434      define variable vdb-num          as integer no-undo.
     2435      define variable vdoc-id          as integer no-undo.
     2436      define variable vlinenum         as integer no-undo.
     2437      define variable vErrorOne as character no-undo.
     2438      define buffer buf_utd-err for utd-err.
     2439      run gen-key-rec (input "utd-marking-lines",
     2440                       input  iObj,
     2441                       output vRecKey-markLine).
     2442      vGoodMark = yes.
     2443      vdb-num = iObj::db-num.
     2444      vdoc-id = iObj::doc-id.
     2445      vlinenum = iObj::linenum.
     2446      block-mark-err:
     2447      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2448                               and buf_utd-err.db-num = vdb-num
     2449                               and buf_utd-err.reckey = vRecKey-markLine
     2450                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2451                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2452      no-lock:
     2453         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2454         if     vErrorOne ne ?
     2455            and vErrorOne ne ""
     2456         then do:
     2457            vGoodMark = no.
     2458            leave block-mark-err.
     2459         end.
     2460      end.
     2461      return not vGoodMark.
     2462   end.
     2463   function CheckErrForMarkLineType returns logical
     2464   (iObj            as handle,
     2465    iType           as character  ):
     2466      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2467   end.
     2468   function CheckErrForMarkLine returns logical
     2469   (iObj            as handle):
     2470      return CheckErrForMarkLineType(iObj,"*").
     2471   end.
     2472   function CheckErrForLineTypeCode returns logical
     2473   (iObj                 as handle,
     2474    iCheckType           as character,
     2475    iCodeErr             as character,
     2476    iTypeErr             as character,
     2477    iOneErr              as logical):
     2478      define variable vRecKey-line     as character no-undo.
     2479      define buffer buf_utd-err for utd-err.
     2480      define variable vUtdlineError as logical no-undo.
     2481      define variable vErrorOne as character no-undo.
     2482            run gen-key-rec (input "utd-lines",
     2483                             input  iObj,
     2484                             output vRecKey-line).
     2485         define variable vdb-num as integer no-undo.
     2486         define variable vdoc-id as integer no-undo.
     2487         define variable vlinenum as integer no-undo.
     2488         vdb-num = iObj::db-num.
     2489         vdoc-id = iObj::doc-id.
     2490         vlinenum = iObj::linenum.
     2491         block-err:
     2492         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2493                                  and buf_utd-err.db-num = vdb-num
     2494                                  and buf_utd-err.reckey = vRecKey-line
     2495                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2496                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2497         no-lock:
     2498            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2499            if     vErrorOne ne ?
     2500               and vErrorOne ne ""
     2501            then do:
     2502               vUtdlineError = yes.
     2503               leave block-err.
     2504            end.
     2505         end.
     2506         if  not vUtdlineError
     2507         then do:
     2508            define variable vGoodMark as logical no-undo.
     2509            vGoodMark = yes.
     2510            block-line-err:
     2511            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2512                                         and utd-marking-lines.doc-id  eq vdoc-id
     2513                                         and utd-marking-lines.LineNum eq vLineNum
     2514            no-lock:
     2515               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2516               if     vGoodMark
     2517                  and iOneErr eq no
     2518               then
     2519                  leave block-line-err.
     2520               if     iOneErr = yes
     2521                  and not vGoodMark
     2522               then
     2523                  leave block-line-err.
     2524            end.
     2525            vUtdlineError = not vGoodMark.
     2526         end.
     2527      return vUtdlineError.
     2528   end.
     2529   function getErrForLineType returns character
     2530   (iObj            as handle,
     2531    iType           as character  ):
     2532      define variable vRecKey-line     as character no-undo.
     2533      define buffer buf_utd-err for utd-err.
     2534      define variable vUtdlineError as logical no-undo.
     2535      define variable vErrorOne as character no-undo.
     2536      define variable oError as character no-undo.
     2537            run gen-key-rec (input "utd-lines",
     2538                             input  iObj,
     2539                             output vRecKey-line).
     2540         define variable vdb-num as integer no-undo.
     2541         define variable vdoc-id as integer no-undo.
     2542         define variable vlinenum as integer no-undo.
     2543         vdb-num = iObj::db-num.
     2544         vdoc-id = iObj::doc-id.
     2545         vlinenum = iObj::linenum.
     2546         block-err:
     2547         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2548                                  and buf_utd-err.db-num = vdb-num
     2549                                  and buf_utd-err.reckey = vRecKey-line
     2550                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2551         no-lock:
     2552            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2553            if     vErrorOne ne ?
     2554               and vErrorOne ne ""
     2555            then do:
     2556               oError = oError + vErrorOne + " ".
     2557            end.
     2558         end.
     2559      return oError.
     2560   end.
     2561   function CheckErrForLineType returns logical
     2562   (iObj            as handle,
     2563    iType           as character  ):
     2564       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2565   end.
     2566   function CheckErrForLine returns logical
     2567   (iObj            as handle):
     2568      return CheckErrForLineType(iobj,"*").
     2569   end.
     2570   function CheckErrForUtd returns logical
     2571   (idb-num         as integer ,
     2572    idoc-id         as integer ):
     2573      for each utd-lines where utd-lines.db-num eq idb-num
     2574                           and utd-lines.doc-id eq idoc-id
     2575      no-lock :
     2576         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2577         then
     2578            return no.
     2579      end.
     2580      return yes.
     2581   end.
     2582   function CheckMarkUtd-28rel return logical
     2583    (input idb-num as integer,
     2584    input idoc-id as integer):
     2585    define buffer utd                   for utd.
     2586    define buffer utd-lines             for utd-lines.
     2587    define buffer utd-marking-lines     for utd-marking-lines.
     2588    define variable v-par-type as character no-undo.
     2589    define variable vgdsNoMark as logical no-undo.
     2590    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2591      define variable v-par-val  as character no-undo.
     2592      find first utd where utd.db-num eq idb-num
     2593                       and utd.doc-id eq idoc-id
     2594      no-lock no-error.
     2595      if available utd
     2596      then do:
     2597         if     utd.obj-code ne ?
     2598            and utd.obj-type ne ?
     2599         then do:
     2600            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2601            Block-utd-lines:
     2602            for each utd-lines where utd-lines.db-num eq idb-num
     2603                                 and utd-lines.doc-id eq idoc-id
     2604            no-lock:
     2605               if     utd-lines.gds-code ne ?
     2606                  and utd-lines.gds-code ne 0
     2607               then do:
     2608                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2609                       ( utd-lines.gds-code,
     2610                         'mark-type':U,
     2611                          output v-par-val,
     2612                          output v-par-type
     2613                       ).
     2614                  if     EDOParSec:IsEdo
     2615                     and EDOParSec:GetIsEDOForType(v-par-val)
     2616                  then do:
     2617                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2618                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2619                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2620                                                    and length(utd-marking-lines.mark) > 13
     2621                     no-lock no-error.
     2622                     if     avail utd-marking-lines
     2623                        and not CheckErrForLine(buffer utd-lines:handle)
     2624                     then
     2625                        leave Block-utd-lines.
     2626                  end.
     2627                  else
     2628                     vgdsNoMark = yes.
     2629               end.
     2630            end.
     2631            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2632            if vgdsNoMark then return available utd-lines . else return yes .
     2633         end.
     2634      end.
     2635      return yes.
     2636   end.
     2637   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2638   define temp-table tt-utd-mark no-undo like utd-marking-lines
     2639     field side as character.
     2640   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2641   function CheckMarkUtd return logical
     2642    (input idb-num  as integer,
     2643     input idoc-id  as integer):
     2644     define buffer utd-lines             for ub.utd-lines.
     2645     block-line:
     2646     for each utd-lines where utd-lines.db-num eq idb-num
     2647                          and utd-lines.doc-id eq idoc-id
     2648     no-lock:
     2649        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2650        then
     2651           leave block-line.
     2652     end.
     2653     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2654     return available utd-lines.
     2655   end.
     2656   function CheckNotMarkUtd return logical
     2657    (input idb-num  as integer,
     2658     input idoc-id  as integer):
     2659     define buffer utd-lines             for ub.utd-lines.
     2660     for each utd-lines where utd-lines.db-num eq idb-num
     2661                          and utd-lines.doc-id eq idoc-id
     2662     no-lock:
     2663        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2664        then
     2665           return yes.
     2666     end.
     2667     return no.
     2668   end.
     2669   function CheckMarkUtdLine return logical
     2670    (input idb-num  as integer,
     2671     input idoc-id  as integer,
     2672     input iLineNum as integer):
     2673    define buffer utd                   for utd.
     2674    define buffer utd-lines             for utd-lines.
     2675    define buffer utd-marking-lines     for utd-marking-lines.
     2676    define variable v-par-type as character no-undo.
     2677    define variable vMarking        as logical no-undo.
     2678    define variable vArtic          as logical no-undo.
     2679    define variable vTransitional   as logical no-undo.
     2680    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2681      define variable v-par-val  as character no-undo.
     2682      find first utd where utd.db-num eq idb-num
     2683                       and utd.doc-id eq idoc-id
     2684      no-lock no-error.
     2685      if available utd
     2686      then do:
     2687         if     utd.obj-code ne ?
     2688            and utd.obj-type ne ?
     2689         then do:
     2690            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2691            Block-utd-lines:
     2692            for each utd-lines where utd-lines.db-num   eq idb-num
     2693                                 and utd-lines.doc-id   eq idoc-id
     2694                                 and utd-lines.LineNum  eq iLineNum
     2695            no-lock:
     2696               if     utd-lines.gds-code ne ?
     2697                  and utd-lines.gds-code ne 0
     2698               then do:
     2699                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2700                       ( utd-lines.gds-code,
     2701                         'mark-type':U,
     2702                          output v-par-val,
     2703                          output v-par-type
     2704                       ).
     2705                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2706                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2707                  if vMarking
     2708                  then do:
     2709                     block-marking:
     2710                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2711                                                    and utd-marking-lines.doc-id   eq idoc-id
     2712                                                    and utd-marking-lines.LineNum  eq iLineNum
     2713                                                    and length(utd-marking-lines.mark) > 13
     2714                     no-lock:
     2715                        if isOAD(utd-marking-lines.mark)
     2716                        then do:
     2717                           assign
     2718                              vArtic   = yes
     2719                              vMarking = no
     2720                           .
     2721                           leave block-marking.
     2722                        end.
     2723                     end.
     2724                  end.
     2725                  if vArtic
     2726                  then do:
     2727                     block-artic:
     2728                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2729                                                    and utd-marking-lines.doc-id   eq idoc-id
     2730                                                    and utd-marking-lines.LineNum  eq iLineNum
     2731                                                    and length(utd-marking-lines.mark) > 13
     2732                     no-lock:
     2733                        if isMark(utd-marking-lines.mark)
     2734                        then do:
     2735                           assign
     2736                              vArtic   = no
     2737                              vMarking = yes
     2738                           .
     2739                           leave block-artic.
     2740                        end.
     2741                     end.
     2742                  end.
     2743                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     2744                  if vTransitional
     2745                  then do:
     2746                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2747                                                    and utd-marking-lines.doc-id   eq idoc-id
     2748                                                    and utd-marking-lines.LineNum  eq iLineNum
     2749                                                    and length(utd-marking-lines.mark) > 13
     2750                     no-lock no-error.
     2751                     if not available utd-marking-lines
     2752                     then assign
     2753                        vMarking = no
     2754                        vArtic   = no
     2755                     .
     2756                  end.
     2757               end.
     2758               else
     2759                  assign
     2760                     vMarking      = yes
     2761                     vArtic        = no
     2762                     vTransitional = no
     2763                  .
     2764               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     2765               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     2766               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     2767            end.
     2768         end.
     2769      end.
     2770      return vMarking or vArtic.
     2771   end.
     2772   function getMarkUtdLine return logical
     2773    (input  idb-num  as integer,
     2774     input  idoc-id  as integer,
     2775     input  iLineNum as integer,
     2776     output oMarking        as logical,
     2777     output oArtic          as logical,
     2778     output oTransitional   as logical):
     2779     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     2780     oArtic        = not oMarking
     2781            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     2782     oTransitional = (oMarking or oArtic)
     2783            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     2784   end.
     2785   function CheckMarking return logical
     2786    (input idb-num as integer,
     2787    input idoc-id as integer,
     2788    input iTypeErr as character ):
     2789     define variable vMarkutd as logical no-undo.
     2790     define variable vCrErr   as logical no-undo.
     2791     define buffer utd-lines         for utd-lines.
     2792     define buffer utd-marking-lines for utd-marking-lines.
     2793     define buffer marking           for marking.
     2794     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     2795      block-line:
     2796      for each utd-lines where utd-lines.db-num eq idb-num
     2797                           and utd-lines.doc-id eq idoc-id
     2798      no-lock:
     2799         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2800         then do:
     2801            for each utd-marking-lines
     2802                     where utd-marking-lines.db-num  = utd-lines.db-num
     2803                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2804                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2805            no-lock:
     2806               if isMark(utd-marking-lines.mark)
     2807               then do:
     2808                  find first marking where marking.mark eq utd-marking-lines.mark
     2809                  no-lock no-error.
     2810                  if not available marking
     2811                  then do:
     2812                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     2813                     vCrErr = yes.
     2814                     next block-line.
     2815                  end.
     2816               end.
     2817            end.
     2818         end.
     2819      end.
     2820      return vCrErr.
     2821   end.
     2822   function CheckMarkForType return logical
     2823    (input idb-num   as integer,
     2824     input idoc-id   as integer):
     2825      define variable vMarking        as logical no-undo.
     2826      define variable vArtic          as logical no-undo.
     2827      define variable vTransitional   as logical no-undo.
     2828      define buffer utd-lines         for utd-lines.
     2829      define buffer utd-marking-lines for utd-marking-lines.
     2830      block-line:
     2831      for each utd-lines where utd-lines.db-num eq idb-num
     2832                           and utd-lines.doc-id eq idoc-id
     2833      no-lock:
     2834         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     2835                          output vMarking         , output vArtic          , output vTransitional).
     2836         for each utd-marking-lines
     2837                     where utd-marking-lines.db-num  = utd-lines.db-num
     2838                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2839                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2840         no-lock:
     2841            if length(utd-marking-lines.mark) < 14
     2842            then do:
     2843               if (vMarking or vArtic) and not vTransitional
     2844               then
     2845                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2846            end.
     2847            else if not isMark(utd-marking-lines.mark)
     2848            then do:
     2849               if vMarking
     2850               then
     2851                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2852            end.
     2853            else do:
     2854            end.
     2855         end.
     2856      end.
     2857   end.
     2858   function WeighedProd return logical
     2859      ( input p-gds-code as integer) :
     2860      define variable v-par-val  as character no-undo.
     2861      define variable v-par-type as character no-undo.
     2862              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2863               ( p-gds-code,
     2864                 'weighed-gds':U,
     2865                  output v-par-val,
     2866                  output v-par-type
     2867               ).
     2868      return logical(v-par-val).
     2869   end.
     2870   function WghProdVariable return logical
     2871       (input p-obj-type as char,
     2872        input p-obj-code as integer,
     2873        input p-gds-code as integer) :
     2874      define variable v-wgh-val  as character no-undo.
     2875      define variable v-par-val  as character no-undo.
     2876      define variable v-par-type as character no-undo.
     2877      define variable vMarking        as logical no-undo.
     2878      define variable vArtic          as logical no-undo.
     2879      define variable vTransitional   as logical no-undo.
     2880      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2881         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2882           ( p-gds-code,
     2883             'weighed-gds':U,
     2884              output v-wgh-val,
     2885              output v-par-type
     2886           ).
     2887       if logical(v-wgh-val) = yes then do:
     2888           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2889               ( p-gds-code,
     2890                 'mark-type':U,
     2891                  output v-par-val,
     2892                  output v-par-type
     2893               ).
     2894           if v-par-val <> "" then do:
     2895               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     2896               assign
     2897                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     2898                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     2899                  .
     2900           end.
     2901      end.
     2902      if v-wgh-val > "" and (vMarking or vArtic)
     2903      then return yes.
     2904      else return no.
     2905   end.
     2906   function MarkWeight return decimal
     2907      ( input p-mark as character) :
     2908      define buffer  buf_marking-attr for  ub.marking-attr.
     2909      define variable vMarkWeight as decimal no-undo.
     2910      vMarkWeight = 0.
     2911      if p-mark <> "" and p-mark <> ?
     2912      then do:
     2913          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     2914                                        and buf_marking-attr.attr-code eq "weight"
     2915             no-lock no-error.
     2916          if not available buf_marking-attr
     2917          then do :
     2918            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     2919                                          and buf_marking-attr.attr-code eq "weight"
     2920               no-lock no-error.
     2921          end .
     2922          if avail buf_marking-attr
     2923          then vMarkWeight = dec(buf_marking-attr.attr-value).
     2924      end.
     2925      return vMarkWeight.
     2926   end.
     2927   function CheckQnty returns logical
     2928   (  input idb-num  as integer,
     2929      input idoc-id  as integer,
     2930      input iErrType as character
     2931   ):
     2932      if iErrType ne "loadUTD"
     2933      then do:
     2934         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     2935         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     2936         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     2937      end.
     2938      if iErrType ne "CheckQnty"
     2939      then do:
     2940         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     2941         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     2942         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     2943      end.
     2944      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     2945      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     2946      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     2947      define buffer marking               for marking.
     2948      define buffer utd-lines             for utd-lines.
     2949      define buffer utd-marking-lines     for utd-marking-lines.
     2950      define buffer Buf_utd-marking-lines for utd-marking-lines.
     2951      block-line:
     2952      for each utd-lines where utd-lines.db-num eq idb-num
     2953                           and utd-lines.doc-id eq idoc-id
     2954      no-lock:
     2955         define variable Vflagmark as logical no-undo.
     2956         find first buf_utd-marking-lines
     2957                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     2958                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     2959                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     2960                         and length(buf_utd-marking-lines.mark) > 13
     2961         no-lock no-error.
     2962         if not available buf_utd-marking-lines
     2963         then
     2964            next block-line.
     2965         define variable vqntyMark as integer no-undo.
     2966         define variable vqntyOAD  as integer no-undo.
     2967         vqntyMark = 0.
     2968         vqntyOAD  = 0.
     2969         block-mark:
     2970         for each utd-marking-lines
     2971              where utd-marking-lines.db-num  = utd-lines.db-num
     2972                and utd-marking-lines.doc-id  = utd-lines.doc-id
     2973                and utd-marking-lines.LineNum = utd-lines.LineNum
     2974                and length(utd-marking-lines.mark) > 13
     2975                and utd-marking-lines.doc-level  = 1
     2976         no-lock:
     2977            if isMark(utd-marking-lines.mark)
     2978            then do:
     2979               find first marking where marking.mark eq utd-marking-lines.mark
     2980               no-lock no-error.
     2981               if available marking
     2982               then do:
     2983                  if marking.box-qnty ne ?
     2984                  then
     2985                     vqntyMark = vqntyMark + marking.box-qnty.
     2986               end.
     2987            end.
     2988            else do:
     2989               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     2990                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     2991                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     2992                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     2993                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     2994               no-lock no-error.
     2995               if available utd-marking-lines-attr
     2996               then
     2997                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     2998            end.
     2999         end.
     3000         if     utd-lines.gds-code   gt 0
     3001            and utd-lines.gds-code   ne ?
     3002            and vqntyMark            ne 0
     3003         then do:
     3004            if utd-lines.Quantity  < vqntyMark
     3005            then
     3006               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3007            else if utd-lines.Quantity  <> vqntyMark
     3008            then
     3009               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3010         end.
     3011         else if     utd-lines.gds-code   gt 0
     3012            and utd-lines.gds-code   ne ?
     3013            and vqntyOAD ne 0
     3014            and utd-lines.Quantity  ne vqntyOAD
     3015         then
     3016            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     3017      end.
     3018   end.
     3019   function CheckGds returns logical
     3020   (  input idb-num   as integer,
     3021      input idoc-id   as integer,
     3022      input iobj-type as character,
     3023      input iobj-code as integer,
     3024      input iErrType as character
     3025   ):
     3026      if iErrType ne "loadUTD"
     3027      then do:
     3028         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     3029         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     3030         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     3031         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3032         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     3033         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     3034         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     3035         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     3036         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     3037         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     3038         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     3039      end.
     3040      if iErrType ne "CheckGds"
     3041      then do:
     3042         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     3043         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     3044         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     3045         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     3046         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     3047         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     3048         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     3049         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     3050         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     3051         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     3052         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     3053      end.
     3054      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     3055      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     3056      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     3057      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3058      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     3059      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     3060      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     3061      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     3062      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     3063      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     3064      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     3065      define variable v-par-type as character no-undo.
     3066      define variable v-par-val  as character no-undo.
     3067      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3068      define buffer marking               for marking.
     3069      define buffer utd-lines             for utd-lines.
     3070      define buffer buf_utd-lines         for utd-lines.
     3071      define buffer utd-marking-lines     for utd-marking-lines.
     3072      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3073      define variable vGdsCode as integer no-undo.
     3074      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     3075      block-line:
     3076      for each utd-lines where utd-lines.db-num eq idb-num
     3077                           and utd-lines.doc-id eq idoc-id
     3078      no-lock:
     3079         vGdsCode = ?.
     3080         define variable Vflagmark as logical no-undo.
     3081         define variable VflagOAD  as logical no-undo.
     3082         assign
     3083            Vflagmark = no
     3084            VflagOAD = no
     3085         .
     3086         block-mark:
     3087         for each utd-marking-lines
     3088                  where utd-marking-lines.db-num  = utd-lines.db-num
     3089                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3090                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3091         no-lock:
     3092            if    isMark(utd-marking-lines.mark)
     3093               or isOAD (utd-marking-lines.mark)
     3094            then do:
     3095               define variable vnewGdsCode as integer no-undo.
     3096               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     3097               if isMark(utd-marking-lines.mark)
     3098               then do:
     3099                  Vflagmark = yes.
     3100                  find first marking where marking.mark eq utd-marking-lines.mark
     3101                  no-lock no-error.
     3102                  if not available marking
     3103                  then do:
     3104                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     3105                     next block-mark.
     3106                  end.
     3107                  if vnewGdsCode eq ?
     3108                  then
     3109                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     3110                  if    marking.gds-code eq 0
     3111                     or marking.gds-code eq ?
     3112                     or marking.sts eq 0
     3113                     or marking.sts eq ?
     3114                     or marking.box-qnty eq ?
     3115                     or (marking.gds-code ne vnewGdsCode
     3116                         and vnewGdsCode ne ?
     3117                         and vnewGdsCode ne 0)
     3118                  then do:
     3119                     find first marking where marking.mark eq utd-marking-lines.mark
     3120                     exclusive-lock no-error.
     3121                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     3122                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     3123                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     3124                     if    marking.gds-ext-id eq ""
     3125                        or marking.gds-ext-id eq ?
     3126                     then do:
     3127                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     3128                     end.
     3129                     else if    marking.gds-code eq 0
     3130                             or marking.gds-code eq ?
     3131                     then
     3132                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     3133                     else if     marking.sts eq 0
     3134                             or  marking.sts eq ?
     3135                     then
     3136                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     3137                  end.
     3138                  if utd-marking-lines.doc-level eq 1
     3139                  then do:
     3140                     if marking.box-qnty eq ?
     3141                     then
     3142                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3143                  end.
     3144               end.
     3145               else do:
     3146                  VflagOAD = yes.
     3147                  define variable vQnty as decimal no-undo.
     3148                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     3149                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     3150                                          utd-marking-lines.doc-id,
     3151                                          utd-marking-lines.LineNum,
     3152                                          utd-marking-lines.mark,
     3153                                          "box-qnty",
     3154                                           string(vQnty)).
     3155                  define variable vgtin as character no-undo.
     3156                  vgtin = getGtinByDM(utd-marking-lines.mark).
     3157                  if getQntyCodeByGtin(vgtin) ne 1
     3158                  then
     3159                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     3160               end.
     3161               if utd-marking-lines.gds-code ne vnewGdsCode
     3162               and vnewGdsCode ne ?
     3163               and vnewGdsCode ne 0
     3164               then do:
     3165                  find first buf_utd-marking-lines
     3166                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3167                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3168                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3169                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3170                  exclusive-lock no-error.
     3171                  if available buf_utd-marking-lines
     3172                  then do:
     3173                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     3174                  end.
     3175               end.
     3176            end.
     3177            else  do:
     3178               define variable vgdsbar as integer no-undo.
     3179               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     3180               if    utd-marking-lines.gds-code ne vgdsbar
     3181               then do:
     3182                  find first buf_utd-marking-lines
     3183                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3184                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3185                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3186                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3187                  exclusive-lock no-error.
     3188                  if available buf_utd-marking-lines
     3189                  then do:
     3190                     buf_utd-marking-lines.gds-code = vgdsbar.
     3191                  end.
     3192               end.
     3193               if vgdsbar ne ?
     3194               then do:
     3195                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3196                            ( vgdsbar,
     3197                              'mark-type':U,
     3198                              output v-par-val,
     3199                              output v-par-type
     3200                             ).
     3201                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     3202                       or  EDOParSec:GetIsArticForType(v-par-val))
     3203                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     3204                   and     EDOParSec:IsEdo
     3205                  then do:
     3206                     AddUtdErr(utd-marking-lines.db-num,
     3207                               utd-marking-lines.doc-id,
     3208                               buffer utd-marking-lines:handle,
     3209                               iErrType,
     3210                               "MarkingForTypeEDO",
     3211                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3212                  end.
     3213               end.
     3214            end.
     3215            if vGdsCode eq ?
     3216            then
     3217               vGdsCode = utd-marking-lines.gds-code.
     3218            if vGdsCode ne utd-marking-lines.gds-code
     3219            and utd-marking-lines.gds-code > 0
     3220            then do:
     3221               vGdsCode = -1.
     3222            end.
     3223         end.
     3224         if  vGdsCode = -1
     3225         then do:
     3226            vGdsCode = ?.
     3227            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     3228            next block-line.
     3229         end.
     3230         if vGdsCode ne ?
     3231         then do:
     3232                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3233                      ( vGdsCode,
     3234                        'mark-type':U,
     3235                        output v-par-val,
     3236                        output v-par-type
     3237                       ).
     3238            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     3239                and(
     3240                 (    EDOParSec:GetIsEDOForType(v-par-val)
     3241                     and not Vflagmark)
     3242                 or  (EDOParSec:GetIsArticForType(v-par-val)
     3243                     and not VflagOAD
     3244                     and not Vflagmark))
     3245            then do:
     3246               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     3247            end.
     3248         end.
     3249         if utd-lines.gds-code ne vGdsCode
     3250         then do:
     3251            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3252                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3253                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     3254            exclusive-lock no-error.
     3255            if available buf_utd-lines
     3256            then
     3257               buf_utd-lines.gds-code = vGdsCode.
     3258            release buf_utd-lines.
     3259         end.
     3260         define variable VBarCode as character no-undo.
     3261         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     3262         if VBarCode ne ?
     3263         then do:
     3264            if num-entries(VBarCode," ") > 0
     3265            then
     3266               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     3267            vgdsbar = GetGdsCodeByGtin(VBarCode).
     3268            if vgdsbar eq ? or vgdsbar eq 0
     3269            then do:
     3270               AddUtdErr(utd-lines.db-num,
     3271                         utd-lines.doc-id,
     3272                         buffer utd-lines:handle,
     3273                         iErrType,
     3274                         "NotFindGdsForBarCode",
     3275                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     3276            end.
     3277            else do:
     3278               if    utd-lines.gds-code eq ?
     3279                  or utd-lines.gds-code eq 0
     3280               then do:
     3281                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3282                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3283                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3284                  exclusive-lock no-error.
     3285                  if available buf_utd-lines
     3286                  then
     3287                     buf_utd-lines.gds-code = vgdsbar.
     3288                  release buf_utd-lines.
     3289               end.
     3290               else if utd-lines.gds-code ne vgdsbar
     3291               then do:
     3292                  AddUtdErr(utd-lines.db-num,
     3293                         utd-lines.doc-id,
     3294                         buffer utd-lines:handle,
     3295                         iErrType,
     3296                         "NotEqGgsForLineAndMark",
     3297                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     3298               end.
     3299            end.
     3300         end.
     3301         if vGdsCode eq ? and utd-lines.gds-code eq ?
     3302         then
     3303            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     3304      end.
     3305   end.
     3306   function GetUtdLineForOrig return logical
     3307   (input idb-num as integer,
     3308    input idoc-id as integer,
     3309    input ilineNum as integer,
     3310    input idb-numOrig as integer,
     3311    input idoc-idOrig as integer,
     3312    buffer edoc-lines for utd-lines):
     3313      define buffer edoc-marking-lines for ub.utd-marking-lines.
     3314      block-mark:
     3315      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     3316                                   and utd-marking-lines.doc-id  eq idoc-id
     3317                                   and utd-marking-lines.LineNum eq iLineNum
     3318                                   and utd-marking-lines.site eq "-"
     3319      no-lock:
     3320         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     3321                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     3322                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     3323                     no-lock no-error.
     3324         if available edoc-marking-lines
     3325         then do:
     3326            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     3327                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     3328                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     3329            no-lock no-error.
     3330               leave block-mark.
     3331          end.
     3332      end.
     3333       if not available edoc-lines
     3334       then do:
     3335          find  first  utd-lines where utd-lines.db-num      = idb-num
     3336                                   and utd-lines.doc-id      = idoc-id
     3337                                   and utd-lines.LineNum     = ilinenum
     3338             no-lock no-error.
     3339          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3340                                  and edoc-lines.doc-id      = idoc-idOrig
     3341                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     3342          no-lock no-error.
     3343       end.
     3344       if not available edoc-lines
     3345       then
     3346          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3347                                  and edoc-lines.doc-id      = idoc-idOrig
     3348                                  and edoc-lines.gds-code    = utd-lines.gds-code
     3349          no-lock no-error.
     3350   end.
     3351   function GetLastUTDinPack returns logical
     3352   (input idb-num as integer,
     3353    input idoc-id as integer,
     3354    output odb-num as integer,
     3355    output odoc-id as integer ) forward.
     3356   function getObgFns return logical
     3357   (input iDocumentNumber   as character ,
     3358    input iFnsParticipantId as character ,
     3359    input ikpp              as character ,
     3360    output ohost-code       as integer,
     3361    output oobj-type        as character ,
     3362    output oobj-code        as integer ,
     3363    output otext            as character  ):
     3364       define buffer ext-classif   for ext-classif.
     3365       define buffer clients       for clients.
     3366       define buffer buf_clients   for clients.
     3367       define buffer clients-attr  for clients-attr.
     3368       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3369                                and ext-classif.charkey_three eq iFnsParticipantId
     3370       no-lock no-error.
     3371       if available ext-classif
     3372       then do:
     3373          if ext-classif.CharKey_One eq 'маг':U
     3374          then do:
     3375             assign
     3376                oobj-type = ext-classif.CharKey_One
     3377                oobj-code = ext-classif.Key#_One
     3378             .
     3379             find first clients
     3380                  where clients.obj-type   = ext-classif.CharKey_One
     3381                    and clients.obj-code   = ext-classif.Key#_One
     3382             no-lock no-error .
     3383             if available clients
     3384             then
     3385                ohost-code =  clients.host-code.
     3386          end.
     3387          else do:
     3388             find first clients
     3389                  where clients.obj-type   = ext-classif.CharKey_One
     3390                    and clients.obj-code   = ext-classif.Key#_One
     3391                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     3392             no-lock no-error .
     3393             if not available clients
     3394             then do:
     3395                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     3396                return no.
     3397             end.
     3398             ohost-code = ext-classif.Key#_One.
     3399             block-cl:
     3400             for each clients-attr
     3401                where clients-attr.attr-code  = 'kpp':U
     3402                  and clients-attr.obj-type   = 'маг':U
     3403                  and clients-attr.attr-value = ikpp
     3404                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     3405                                             and buf_clients.obj-code   = clients-attr.obj-code
     3406                                             and buf_clients.host-code  = ohost-code)
     3407             no-lock :
     3408                leave block-cl.
     3409             end.
     3410             if     available clients
     3411                and clients.obj-type eq 'маг':U
     3412             then do:
     3413                assign
     3414                   oobj-type = clients.obj-type
     3415                   oobj-code = clients.obj-code
     3416                .
     3417             end.
     3418             else if available clients-attr
     3419             then do:
     3420                assign
     3421                   oobj-type = clients-attr.obj-type
     3422                   oobj-code = clients-attr.obj-code
     3423                .
     3424             end.
     3425             else do:
     3426                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     3427                return yes.
     3428             end.
     3429          end.
     3430       end.
     3431       else do:
     3432          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     3433          return no.
     3434       end.
     3435       return ?.
     3436   end.
     3437   function CheckUcdForReturn return logical
     3438   (input idb-numUcd as integer,
     3439    input idoc-idUcd as integer,
     3440    input idb-numRet as integer,
     3441    input idoc-idRet as integer  ):
     3442       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     3443                                    and utd-marking-lines.doc-id eq idoc-idUcd
     3444                                    and utd-marking-lines.doc-level eq 1
     3445       no-lock:
     3446          create tt-utd-mark.
     3447          buffer-copy utd-marking-lines to tt-utd-mark
     3448          assign
     3449             tt-utd-mark.side = "+"
     3450          .
     3451       end.
     3452       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     3453                                    and utd-marking-lines.doc-id eq idoc-idRet
     3454                                    and utd-marking-lines.doc-level eq 1
     3455       no-lock:
     3456          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     3457          no-lock no-error.
     3458          if available tt-utd-mark
     3459          then
     3460             tt-utd-mark.side = "".
     3461          else do:
     3462             create tt-utd-mark.
     3463             buffer-copy utd-marking-lines to tt-utd-mark
     3464             assign
     3465                tt-utd-mark.side = "-"
     3466             .
     3467          end.
     3468       end.
     3469       for each tt-utd-mark where  tt-utd-mark.side ne ""
     3470       no-lock:
     3471          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     3472       end.
     3473       for each tt-utd-mark:
     3474          delete tt-utd-mark.
     3475       end.
     3476   end.
     3477   function GetLastUTDinPackAft returns logical
     3478   (input idb-num as integer,
     3479    input idoc-id as integer,
     3480    output odb-num as integer,
     3481    output odoc-id as integer ) forward.
     3482   function SaturateAndCheckUTD return character
     3483   (input idb-num as integer,
     3484    input idoc-id as integer  ):
     3485      define buffer clients-attr          for clients-attr.
     3486      define buffer clients               for clients.
     3487      define buffer Utd                   for Utd.
     3488      define buffer utd_ret               for ub.utd.
     3489      define buffer utd-lines             for utd-lines.
     3490      define buffer buf_utd-lines         for utd-lines.
     3491      define buffer buf_utddoc-lines      for utd-lines.
     3492      define buffer marking               for marking.
     3493      define buffer marking-lines         for marking-lines.
     3494      define buffer utd-marking-lines     for utd-marking-lines.
     3495      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3496      define buffer contract              for contract.
     3497      define buffer old_utd               for Utd.
     3498      define variable vError as character no-undo.
     3499      define variable vGdsCode as integer no-undo.
     3500      define variable vcli-type as character no-undo.
     3501      define variable vcli-code as integer no-undo.
     3502      define variable vhost-code as integer no-undo init ?.
     3503      define variable vcontract-code as integer no-undo.
     3504      define variable vobj-type as character no-undo init ?.
     3505      define variable vobj-code as integer no-undo init ?.
     3506      define variable volddb-num as integer no-undo.
     3507      define variable volddoc-id as integer no-undo.
     3508      define variable vMark as logical no-undo.
     3509      define variable VUcd as logical no-undo.
     3510      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3511      define variable v-par-type as character no-undo.
     3512      define variable v-par-val  as character no-undo.
     3513      define variable VFileMark as logical no-undo.
     3514      define variable vunit     as int no-undo.
     3515      define variable vunitCode as character no-undo.
     3516      define variable vMarkingUtd as logical no-undo.
     3517      find first Utd where utd.db-num eq idb-num
     3518                       and utd.doc-id eq idoc-id
     3519      no-lock no-error.
     3520      if available Utd
     3521      then do:
     3522         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     3523         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     3524         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     3525         assign
     3526               vobj-type  = utd.obj-type
     3527               vobj-code  = utd.obj-code
     3528               vhost-code = utd.host-code
     3529         .
     3530         do:
     3531            define variable vtext       as character no-undo.
     3532            define variable vhost-code1 as integer   no-undo.
     3533            define variable vobj-type1  as character no-undo.
     3534            define variable vobj-code1  as integer   no-undo.
     3535             getObgFns
     3536                       (input utd.DocumentNumber ,
     3537                        input utd.obj-FnsParticipantId ,
     3538                        input utd.obj-kpp,
     3539                        output vhost-code1,
     3540                        output vobj-type1,
     3541                        output vobj-code1,
     3542                        output vtext ).
     3543            assign
     3544               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     3545               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     3546               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     3547            .
     3548            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     3549            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     3550            block-line:
     3551            for each utd-lines where utd-lines.db-num eq utd.db-num
     3552                                 and utd-lines.doc-id eq utd.doc-id
     3553            no-lock:
     3554               vGdsCode =?.
     3555               define variable vNotMarkForLine as logical no-undo.
     3556               vNotMarkForLine = no.
     3557               if not VUcd
     3558               then do:
     3559                  find first utd-marking-lines
     3560                       where utd-marking-lines.db-num  = utd-lines.db-num
     3561                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     3562                         and utd-marking-lines.LineNum = utd-lines.LineNum
     3563                  no-lock no-error.
     3564                  if not available utd-marking-lines
     3565                  then do:
     3566                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     3567                     vNotMarkForLine = yes.
     3568                  end.
     3569               end.
     3570               block-mark:
     3571               for each utd-marking-lines
     3572                  where utd-marking-lines.db-num  = utd-lines.db-num
     3573                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3574                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3575               no-lock:
     3576                  vMark = yes.
     3577                  if     isMark(utd-marking-lines.mark)
     3578                     and utd-marking-lines.gds-code  ne 0
     3579                     and utd-marking-lines.gds-code ne ?
     3580                  then do:
     3581                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3582                           ( utd-marking-lines.gds-code,
     3583                            'mark-type':U,
     3584                            output v-par-val,
     3585                            output v-par-type
     3586                            ).
     3587                      if     not VFileMark
     3588                         and not VUcd
     3589                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     3590                      then do:
     3591                          AddUtdErr(utd.db-num,
     3592                                     utd.doc-id,
     3593                                     buffer utd-marking-lines:handle,
     3594                                     "loadUtd",
     3595                                     "NotON_NSCHFDOPPRMARK",
     3596                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3597                     end.
     3598                  end.
     3599               end.
     3600               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     3601               then do :
     3602                  if     VUcd
     3603                  then do:
     3604                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     3605                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     3606                     if available buf_utddoc-lines
     3607                     then do:
     3608                        vGdsCode = buf_utddoc-lines.gds-code.
     3609                        vunitCode = buf_utddoc-lines.UnitCode.
     3610                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     3611                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3612                        then
     3613                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3614                               "loadUtd",
     3615                               "UcdUnitChangForUtd",
     3616                               string(utd-lines.LineNum )                  + chr(4) +
     3617                               buf_utddoc-lines.UnitCode                   + chr(4) +
     3618                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3619                     end.
     3620                     if     utd-lines.UnitCode ne ?
     3621                        and utd-lines.UnitCode ne ""
     3622                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3623                     then
     3624                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3625                               "loadUtd",
     3626                               "UcdUnitChang",
     3627                               string(utd-lines.LineNum )                  + chr(4) +
     3628                               utd-lines.UnitCode                          + chr(4) +
     3629                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3630                  end.
     3631               end.
     3632               else
     3633                  vGdsCode = utd-lines.gds-code.
     3634               define variable vValText as character no-undo.
     3635               define variable vValDec  as decimal no-undo.
     3636               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     3637               if VValText = ?
     3638               then do:
     3639                  vValDec = utd-lines.Quantity.
     3640                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     3641               end.
     3642               else
     3643                  vValDec = dec(VValText).
     3644               release bar-code .
     3645               if     vGdsCode > 0 and vGdsCode ne ?
     3646               then do:
     3647                  assign
     3648                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     3649                     vunit = ?
     3650                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     3651                  no-error.
     3652                  if vunit ne 0 and vunit ne ?
     3653                  then do:
     3654                     find units where units.OKEI eq vunit no-lock no-error.
     3655                     if available units
     3656                     then
     3657                        vunitCode = units.unit-name.
     3658                  end.
     3659                  find first bar-code where bar-code.gds-code eq vGdsCode
     3660                                        and bar-code.unit-cli eq vUnitCode
     3661                  no-lock no-error.
     3662                  if not available bar-code
     3663                  then
     3664                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3665                               "loadUtd",
     3666                               "Unit",
     3667                               string(utd-lines.LineNum )                  + chr(4) +
     3668                               string(vGdsCode)                            + chr(4) +
     3669                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     3670                               vunitCode).
     3671               end.
     3672               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     3673               then do:
     3674                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3675                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3676                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3677                  exclusive-lock no-error.
     3678                  if available buf_utd-lines
     3679                  then do:
     3680                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     3681                     release buf_utd-lines.
     3682                  end.
     3683               end.
     3684               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     3685               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     3686               if     not VUcd
     3687                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     3688               then
     3689                  vMarkingUtd = yes .
     3690            end.
     3691            if not VUcd
     3692            then
     3693               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     3694            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3695                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     3696            no-lock no-error.
     3697            if available ext-classif
     3698            then
     3699               assign
     3700                  vcli-type = ext-classif.CharKey_One
     3701                  vcli-code = ext-classif.Key#_One
     3702               .
     3703            else do:
     3704               assign
     3705                 vcli-type = ?
     3706                 vcli-code = ?
     3707               .
     3708               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     3709            end.
     3710            find first contract  where contract.host-code eq vhost-code
     3711                                   and contract.cli-type  eq vcli-type
     3712                                   and contract.cli-code  eq vcli-code
     3713                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     3714            no-lock no-error.
     3715            define variable VContractEdo as logical no-undo init yes.
     3716            if available contract
     3717            then do:
     3718               assign
     3719                  VContractEdo = contract.whole-send-news > 0
     3720                  vcontract-code = contract.contract-code
     3721               .
     3722               if not VContractEdo
     3723               then
     3724                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     3725            end.
     3726            else do:
     3727               vcontract-code = ?.
     3728            end.
     3729         end.
     3730         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     3731         then do:
     3732            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     3733         end.
     3734         define variable vdoc-code as character no-undo init ?.
     3735         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     3736         then do:
     3737            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     3738                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     3739                                 and utd_ret.Timestamp             le utd.Timestamp
     3740                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     3741            no-lock no-error.
     3742            if available utd_ret
     3743            then do:
     3744               vdoc-code = utd_ret.doc-code.
     3745               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     3746            end.
     3747         end.
     3748      end.
     3749      find current utd exclusive-lock no-error.
     3750      if available utd
     3751      then do:
     3752         assign
     3753            utd.cli-type      = vcli-type      when vcli-type      ne ?
     3754            utd.cli-code      = vcli-code      when vcli-type      ne ?
     3755            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     3756            utd.contract-code = vcontract-code when vcontract-code ne ?
     3757            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     3758            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     3759            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     3760         .
     3761         if   ( utd.contract-code eq ?
     3762            or utd.contract-code eq 0)
     3763            and not vucd
     3764         then
     3765            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     3766         if utd.host-code eq ?
     3767            or utd.host-code eq 0
     3768         then
     3769            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     3770         if utd.obj-code eq ?
     3771            or utd.obj-code eq 0
     3772         then
     3773            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     3774      end.
     3775      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     3776      if vError eq ""
     3777      then do:
     3778         if utd.sts eq 0 or utd.sts eq ?
     3779         then
     3780            utd.sts = if VUcd
     3781                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     3782                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3783         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     3784         then do:
     3785            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3786         end.
     3787         if     not VUcd
     3788            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     3789         then do:
     3790            if not vMarkingUtd
     3791            then
     3792               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     3793         end.
     3794      end.
     3795      else do:
     3796         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     3797         then
     3798            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     3799      end.
     3800      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3801         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     3802      then
     3803         utd.sts-edi = ?.
     3804      else if     (not vMark and  not vucd) or not VContractEdo
     3805              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3806      then
     3807         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     3808      release utd no-error.
     3809      if error-status:error
     3810      then
     3811         return error return-value.
     3812      return vError.
     3813   end.
     3814   function ReCheckload returns logical
     3815   (idb-num as integer,
     3816    idoc-id as integer,
     3817    iload   as logical ):
     3818      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     3819      define buffer buf_c-utd for ub.c-utd .
     3820      define buffer buf_utd   for ub.utd .
     3821      find first buf_utd where buf_utd.db-num eq idb-num
     3822                           and buf_utd.doc-id eq idoc-id
     3823      exclusive-lock no-error.
     3824      if available buf_utd
     3825      then do:
     3826         if    iload
     3827            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     3828         then do:
     3829            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     3830            if  error-status:error then
     3831            do:
     3832               message return-value view-as alert-box.
     3833            end.
     3834         end.
     3835         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     3836            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     3837            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     3838            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     3839         then do:
     3840            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     3841                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     3842                                              buf_c-utd.sts    eq buf_utd.sts and
     3843                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     3844            no-error .
     3845            if available (buf_c-utd)
     3846            then do:
     3847               buf_utd.sts = buf_c-utd.sts .
     3848               buf_utd.sts-edi = buf_c-utd.sts-edi .
     3849            end.
     3850            else do:
     3851               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     3852                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     3853               then
     3854                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     3855               else
     3856                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     3857               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     3858            end.
     3859         end.
     3860         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     3861         then do:
     3862            run utl/utd-checkSpec.p (input buf_utd.db-num,
     3863                                     input buf_utd.doc-id) .
     3864         end.
     3865      end.
     3866      release buf_utd.
     3867      unsubscribe "getNextseq".
     3868   end.
     3869   function ReCheck returns logical
     3870   (idb-num as integer,
     3871    idoc-id as integer ):
     3872      ReCheckload(idb-num,idoc-id,no).
     3873   end.
     3874   function GetLastUTDForPac returns logical
     3875   (iPackegeId as character ,
     3876    iTimestamp as datetime,
     3877    output odb-num as integer,
     3878    output odoc-id as integer ):
     3879      define buffer buf_utd for utd.
     3880      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     3881                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     3882                                and Buf_utd.Timestamp gt iTimestamp
     3883      no-lock no-error.
     3884      if available  buf_utd
     3885      then
     3886         assign
     3887            odb-num = buf_utd.db-num
     3888            odoc-id = buf_utd.doc-id
     3889         no-error.
     3890      else
     3891         assign
     3892            odb-num = ?
     3893            odoc-id = ?
     3894         no-error.
     3895   end.
     3896   function GetprevUTDForPac returns logical
     3897   (iPackegeId as character ,
     3898    iTimestamp as datetime,
     3899    output odb-num as integer,
     3900    output odoc-id as integer ):
     3901      define buffer buf_utd for utd.
     3902      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     3903                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     3904                                and Buf_utd.Timestamp < iTimestamp
     3905      no-lock no-error.
     3906      if available  buf_utd
     3907      then
     3908         assign
     3909            odb-num = buf_utd.db-num
     3910            odoc-id = buf_utd.doc-id
     3911         no-error.
     3912      else
     3913         assign
     3914            odb-num = ?
     3915            odoc-id = ?
     3916         no-error.
     3917   end.
     3918   function GetLastUTDinPackAft returns logical
     3919   (input idb-num as integer,
     3920    input idoc-id as integer,
     3921    output odb-num as integer,
     3922    output odoc-id as integer ):
     3923      define buffer buf_utd for utd.
     3924      define buffer     utd for utd.
     3925      find first utd where utd.db-num eq idb-num
     3926                       and utd.doc-id eq idoc-id
     3927      no-lock no-error.
     3928      if available utd
     3929      then do:
     3930         if utd.PackageId eq ""
     3931         then do:
     3932            assign
     3933               odb-num = utd.db-num
     3934               odoc-id = utd.doc-id
     3935            .
     3936            return yes.
     3937         end.
     3938         else do:
     3939            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     3940            if    odb-num eq ?
     3941               or odoc-id eq ?
     3942            then do:
     3943               assign
     3944                  odb-num = utd.db-num
     3945                  odoc-id = utd.doc-id
     3946               .
     3947               return yes.
     3948            end.
     3949            else
     3950               return odoc-id = utd.doc-id.
     3951         end.
     3952      end.
     3953      return ?.
     3954   end.
     3955   function GetLastUTDinPackbef returns logical
     3956   (input idb-num as integer,
     3957    input idoc-id as integer,
     3958    output odb-num as integer,
     3959    output odoc-id as integer ):
     3960      define buffer buf_utd for utd.
     3961      define buffer     utd for utd.
     3962      find first utd where utd.db-num eq idb-num
     3963                       and utd.doc-id eq idoc-id
     3964      no-lock no-error.
     3965      if available utd
     3966      then do:
     3967         if utd.PackageId eq ""
     3968         then do:
     3969            assign
     3970               odb-num = utd.db-num
     3971               odoc-id = utd.doc-id
     3972            .
     3973            return yes.
     3974         end.
     3975         else do:
     3976            GetprevUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     3977            if    odb-num eq ?
     3978               or odoc-id eq ?
     3979            then do:
     3980               assign
     3981                  odb-num = utd.db-num
     3982                  odoc-id = utd.doc-id
     3983               .
     3984               return yes.
     3985            end.
     3986            else
     3987               return odoc-id = utd.doc-id.
     3988         end.
     3989      end.
     3990      return ?.
     3991   end.
     3992   function GetLastUTDinPack returns logical
     3993   (input idb-num as integer,
     3994    input idoc-id as integer,
     3995    output odb-num as integer,
     3996    output odoc-id as integer ):
     3997      define buffer buf_utd for utd.
     3998      define buffer     utd for utd.
     3999      find first utd where utd.db-num eq idb-num
     4000                       and utd.doc-id eq idoc-id
     4001      no-lock no-error.
     4002      if available utd
     4003      then do:
     4004         if utd.PackageId eq ""
     4005         then do:
     4006            assign
     4007               odb-num = utd.db-num
     4008               odoc-id = utd.doc-id
     4009            .
     4010            return yes.
     4011         end.
     4012         else do:
     4013            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     4014            if    odb-num eq ?
     4015               or odoc-id eq ?
     4016            then do:
     4017               assign
     4018                  odb-num = utd.db-num
     4019                  odoc-id = utd.doc-id
     4020               .
     4021               return yes.
     4022            end.
     4023            else
     4024               return odoc-id = utd.doc-id.
     4025         end.
     4026      end.
     4027      return ?.
     4028   end.
     4029   function delMark returns logical
     4030   ( buffer utd-marking-lines for utd-marking-lines ):
     4031      define buffer buf_utd-marking-line for utd-marking-lines.
     4032      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4033         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4034                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4035                                           and buf_utd-marking-line.mark      eq marking.mark
     4036         no-lock no-error.
     4037         if available  buf_utd-marking-line
     4038         then do:
     4039            delMark(buffer buf_utd-marking-line).
     4040            delete buf_utd-marking-line.
     4041         end.
     4042      end.
     4043   end.
     4044   function addMark returns logical
     4045   ( buffer utd-marking-lines for utd-marking-lines ):
     4046      define buffer buf_utd-marking-line for utd-marking-lines.
     4047      define buffer par_utd-marking-line for utd-marking-lines.
     4048      define buffer buf_utd for ub.utd .
     4049      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4050         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4051                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4052                                           and buf_utd-marking-line.mark      eq marking.mark
     4053         no-lock no-error.
     4054         if available  buf_utd-marking-line
     4055         then do:
     4056            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     4057            then do:
     4058               find current  buf_utd-marking-line exclusive-lock no-error.
     4059               if available buf_utd-marking-line
     4060               then
     4061                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     4062            end.
     4063         end.
     4064         else do:
     4065            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     4066                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     4067                                         no-error .
     4068            create buf_utd-marking-line.
     4069            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     4070            assign
     4071               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     4072               buf_utd-marking-line.mark      = marking.mark
     4073               buf_utd-marking-line.gds-code  = marking.Gds-code
     4074               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     4075                                               then marking.sts
     4076                                               else
     4077                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     4078                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     4079                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     4080                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     4081                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4082                                                else marking.sts
     4083            .
     4084            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     4085            do:
     4086              for first par_utd-marking-line no-lock where
     4087                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     4088                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     4089                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     4090                    and par_utd-marking-line.mark    = marking.mark-parent
     4091                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4092              :
     4093                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     4094              end.
     4095            end.
     4096         end.
     4097         addMark(buffer buf_utd-marking-line).
     4098      end.
     4099   end.
     4100   function UnLockUTDMarkbuf returns logical
     4101   (buffer old_utd for utd,
     4102    iAll as logical ):
     4103      define variable voldkey    as character no-undo.
     4104         run gen-key-rec (input "utd",
     4105                          input  buffer old_utd:handle,
     4106                          output voldkey).
     4107      for each marking where marking.loc-key eq voldkey
     4108      exclusive-lock:
     4109         if    iAll
     4110            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4111                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     4112         then do:
     4113            marking.loc-key = "".
     4114            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     4115         end.
     4116      end.
     4117   end.
     4118   function UnLockUTDMark returns logical
     4119   (idb-num as integer ,idoc-id as integer ,iall as logical):
     4120      define buffer old_utd for utd.
     4121      find first old_utd where old_utd.db-num eq idb-num
     4122                           and old_utd.db-num eq idoc-id
     4123      no-lock no-error.
     4124      if available old_utd
     4125      then do:
     4126         UnLockUTDMarkbuf(buffer old_utd,iall).
     4127      end.
     4128   end.
     4129   function changSts returns logical
     4130   (idb-num as integer ,
     4131    idoc-id as integer ,
     4132    old_sts_edo as character ,
     4133    new_sts_edo as character  ):
     4134      if     old_sts_edo ne new_sts_edo
     4135         and ( new_sts_edo eq "RevocationAccepted"
     4136              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     4137              )
     4138      then
     4139         UnLockUTDMark(idb-num,idoc-id,yes).
     4140      if     old_sts_edo ne new_sts_edo
     4141         and ( new_sts_edo eq "WithRecipientSignature"
     4142           or  new_sts_edo eq "WithRecipientPartiallySignature"
     4143              )
     4144      then
     4145         UnLockUTDMark(idb-num,idoc-id,no).
     4146   end.
     4147   function SetLockUTDMark returns logical
     4148   (idb-num as integer ,idoc-id as integer ):
     4149      define buffer new_utd for utd.
     4150      define buffer old_utd for utd.
     4151      define variable volddb-num as integer no-undo.
     4152      define variable volddoc-id as integer no-undo.
     4153      define variable voldkey    as character no-undo.
     4154      define variable vnewkey    as character no-undo.
     4155      find first new_utd where new_utd.db-num eq idb-num
     4156                           and new_utd.doc-id eq idoc-id
     4157      no-lock no-error.
     4158      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     4159      then do trans:
     4160         find first old_utd where old_utd.db-num eq volddb-num
     4161                              and old_utd.doc-id eq volddoc-id
     4162         no-lock no-error.
     4163            run gen-key-rec (input "utd",
     4164                             input  buffer new_utd:handle,
     4165                             output vnewkey).
     4166            run gen-key-rec (input "utd",
     4167                             input  buffer old_utd:handle,
     4168                             output voldkey).
     4169         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     4170                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     4171         no-lock:
     4172            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     4173            if available  marking
     4174            then do:
     4175               if    marking.loc-key eq ""
     4176                  or marking.loc-key eq ?
     4177                  or marking.loc-key eq voldkey
     4178               then do:
     4179                  find current marking exclusive-lock no-error.
     4180                  if available marking
     4181                  then do:
     4182                     marking.loc-key = vnewkey.
     4183                     release marking.
     4184                  end.
     4185               end.
     4186               else if marking.loc-key ne vnewkey
     4187               then do:
     4188                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     4189               end.
     4190            end.
     4191         end.
     4192         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     4193      end.
     4194   end.
     4195   procedure vss-get-info :
     4196     define output parameter p-vss-revision    like vss-revision    no-undo .
     4197     define output parameter p-vss-author      like vss-author      no-undo .
     4198     define output parameter p-vss-date        like vss-date        no-undo .
     4199     define output parameter p-vss-workfile    like vss-workfile    no-undo .
     4200     define output parameter p-vss-archive     like vss-archive     no-undo .
     4201     define output parameter p-vss-description like vss-description no-undo .
     4202     assign
     4203       p-vss-revision    = vss-revision
     4204       p-vss-author      = vss-author
     4205       p-vss-date        = vss-date
     4206       p-vss-workfile    = vss-workfile
     4207       p-vss-archive     = vss-archive
     4208       p-vss-description = vss-description
     4209     .
     4210   end procedure.
     4211   procedure vss-get-parameters :
     4212     define output parameter p-vss-parameters as character no-undo .
     4213   end procedure.
     4214   define new global shared variable g#vssrevis-logger as handle    no-undo .
     4215   define variable v-vssrevis-logevent                 as logical   no-undo init false .
     4216   define variable v-vssrevis-logger                   as handle    no-undo .
     4217   procedure vss-logevent :
     4218     define input  parameter p-extra-paramters as character no-undo .
     4219     define variable v-vssrevis-parameters as character no-undo .
     4220     do
     4221     on error undo, return error return-value
     4222     :
     4223       if  valid-handle(v-vssrevis-logger)
     4224       and v-vssrevis-logger :get-signature("logevent") <> ""
     4225       then do:
     4226         run vss-get-parameters in this-procedure
     4227           (output v-vssrevis-parameters
     4228           ).
     4229         run logevent in v-vssrevis-logger
     4230           (input vss-workfile
     4231           ,input vss-revision
     4232           ,input v-vssrevis-parameters
     4233           ,input p-extra-paramters
     4234           ).
     4235       end.
     4236     end.
     4237   end procedure.
     4238   assign
     4239     v-vssrevis-logger = g#vssrevis-logger
     4240   .
     4241   if  valid-handle(v-vssrevis-logger)
     4242   and v-vssrevis-logger :get-signature("logevent") <> ""
     4243   then do:
     4244     assign
     4245       v-vssrevis-logevent = true
     4246     .
     4247     run vss-logevent in this-procedure (input vss-description) .
     4248   end.
     4249   define new global shared variable g#library  as handle no-undo .
     4250   define new global shared variable g#library2 as handle no-undo .
     4251   define   shared variable g#auto as logical no-undo.
     4252   define   shared variable g#news as logical no-undo.
     4253   define   shared variable g#oxml as logical no-undo.
     4254   define   shared variable g#esys as logical no-undo.
     4255   define   shared variable g#news-source-db as integer no-undo.
     4256   define   shared variable g#esys-source-esys as integer no-undo.
     4257   define   shared variable g#db-num as integer   no-undo .
     4258   define   shared variable g#userid as character no-undo .
     4259   define   shared variable g#passwd as character no-undo .
     4260   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4261   procedure cur-time :
     4262      define output parameter p-today as date      no-undo .
     4263      define output parameter p-time  as integer   no-undo .
     4264     do
     4265     on error undo, return error
     4266     :
     4267       define variable v-date1 as date      no-undo .
     4268       define variable v-date2 as date      no-undo .
     4269       define variable v-time  as integer   no-undo .
     4270       assign
     4271         v-date1 = today
     4272         v-time  = time
     4273         v-date2 = today
     4274       .
     4275       if v-date1 <> v-date2
     4276       then do:
     4277         assign
     4278           v-date1 = today
     4279           v-time  = v-time
     4280         .
     4281       end.
     4282       assign
     4283         p-today = v-date1
     4284         p-time  = v-time
     4285       .
     4286     end.
     4287   end.
     4288   function cur-time-date returns character
     4289   :
     4290     return string(today, '99/99/9999':U) .
     4291   end.
     4292   function cur-time-mjd returns decimal
     4293   :
     4294     define variable v-date as date      no-undo .
     4295     define variable v-time as integer   no-undo .
     4296     run cur-time in this-procedure
     4297       (output v-date
     4298       ,output v-time
     4299       ) .
     4300     return integer(v-date) - 2400002 + (v-time / 86400) .
     4301   end.
     4302   function cur-time-get-ending-index returns integer
     4303   (input p-number as integer
     4304   )
     4305   :
     4306     if p-number < 0
     4307     or p-number = ?
     4308     then do:
     4309       return 1 .
     4310     end.
     4311     define variable v-rest as integer   no-undo .
     4312     assign
     4313       p-number = p-number modulo 100
     4314     .
     4315     if p-number < 20
     4316     then do:
     4317       assign
     4318         v-rest = p-number
     4319       .
     4320     end.
     4321     else do:
     4322       assign
     4323         v-rest = p-number modulo 10
     4324       .
     4325     end.
     4326     case v-rest :
     4327       when 1
     4328       then do:
     4329         return 2 .
     4330       end.
     4331       when 2 or
     4332       when 3 or
     4333       when 4
     4334       then do:
     4335         return 3 .
     4336       end.
     4337       otherwise do:
     4338         return 1 .
     4339       end.
     4340     end case .
     4341   end.
     4342   procedure cur-time-mjd-to-date :
     4343      define input  parameter i-mjd-diff as decimal no-undo.
     4344      define output parameter o-Date     as date    no-undo.
     4345      define output parameter o-Time     as integer no-undo.
     4346      define variable v-day-number as integer   no-undo .
     4347      if    i-mjd-diff < 0
     4348         or i-mjd-diff = ?
     4349      then do:
     4350         return "?" .
     4351      end.
     4352      assign
     4353         v-day-number = truncate(i-mjd-diff,0).
     4354         o-Date = date(v-day-number + 2400002).
     4355         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     4356     .
     4357   end.
     4358   function cur-time-mjd-to-string returns character
     4359   (input p-mjd-diff as decimal
     4360   )
     4361   :
     4362     define variable v-day-number as integer   no-undo .
     4363     define variable v-seconds    as integer   no-undo .
     4364     define variable v-hour       as integer   no-undo .
     4365     define variable v-min        as integer   no-undo .
     4366     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     4367     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     4368     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     4369     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     4370     if p-mjd-diff < 0
     4371     or p-mjd-diff = ?
     4372     then do:
     4373       return "?" .
     4374     end.
     4375     assign
     4376       v-day-number = integer(truncate(p-mjd-diff,0))
     4377       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     4378     .
     4379     if v-seconds > 86400
     4380     then do:
     4381       assign
     4382         v-seconds = 86400 - 1
     4383       .
     4384     end.
     4385     if v-seconds < 0
     4386     then do:
     4387       assign
     4388         v-seconds = 0
     4389       .
     4390     end.
     4391     assign
     4392       v-hour = truncate(v-seconds / 3600, 0)
     4393     .
     4394     assign
     4395       v-seconds = v-seconds modulo 3600
     4396     .
     4397     assign
     4398       v-min = truncate(v-seconds / 60, 0)
     4399     .
     4400     assign
     4401       v-seconds = v-seconds modulo 60
     4402     .
     4403     return
     4404         (if v-day-number <> 0
     4405           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     4406           else ""
     4407         )
     4408       + (if v-day-number <> 0 or v-hour <> 0
     4409           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     4410           else ""
     4411         )
     4412       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     4413           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     4414           else ""
     4415         )
     4416       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     4417       .
     4418   end.
     4419   function cur-time-string returns character
     4420   :
     4421     define variable v-date as date      no-undo .
     4422     define variable v-time as integer   no-undo .
     4423     run cur-time in this-procedure
     4424       (output v-date
     4425       ,output v-time
     4426       ) .
     4427     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     4428   end.
     4429   function cur-time-string-sec returns character
     4430   :
     4431     define variable v-date as date      no-undo .
     4432     define variable v-time as integer   no-undo .
     4433     run cur-time in this-procedure
     4434       (output v-date
     4435       ,output v-time
     4436       ) .
     4437     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     4438   end.
     4439   function cur-time-custom  returns character
     4440   (input p-prefix as character
     4441   ,input p-date-format as character
     4442   ,input p-delimiter as character
     4443   ,input p-time-format as character
     4444   ,input p-suffix as character
     4445   )
     4446   :
     4447     define variable v-date as date      no-undo .
     4448     define variable v-time as integer   no-undo .
     4449     run cur-time in this-procedure
     4450       (output v-date
     4451       ,output v-time
     4452       ) .
     4453     return
     4454       p-prefix
     4455       + string(v-date, p-date-format)
     4456       + p-delimiter
     4457       + string(v-time, p-time-format)
     4458       + p-suffix
     4459       .
     4460   end.
     4461   function cur-time-print  returns character
     4462   :
     4463     define variable v-date as date      no-undo .
     4464     define variable v-time as integer   no-undo .
     4465     run cur-time in this-procedure
     4466       (output v-date
     4467       ,output v-time
     4468       ) .
     4469     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     4470   end.
     4471   function cur-time-datetime returns datetime
     4472   :
     4473     define variable v-char as character no-undo .
     4474     define variable v-datetime as datetime no-undo .
     4475     v-char = cur-time-string().
     4476     v-datetime = datetime(v-char).
     4477     return  v-datetime.
     4478   end.
     4479   function cur-time-string-msec returns character
     4480   :
     4481     define variable v-date as datetime  no-undo .
     4482     v-date = now.
     4483     return string(v-date) .
     4484   end.
     4485   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4486   define buffer buf_c-utd  for ub.c-utd .
     4487   define variable v-date      as date      no-undo .
     4488   define variable v-time      as integer   no-undo .
     4489   define variable v-field-chg as character no-undo .
     4490   define variable v-Seq       as int64     no-undo init ?.
     4491   define variable vFlagseq    as logical no-undo.
     4492   define variable vuniq-key-rec as character no-undo.
     4493   define variable v-rowid as rowid no-undo.
     4494   define variable v-tbl-name as character no-undo.
     4495   define buffer buf_c-utd-head for ub.c-utd-head .
     4496       run cur-time in this-procedure (output v-date, output v-time).
     4497       publish "getNextseq" ("utd","s-c-utd-chip-num", "ub", output v-Seq ).
     4498       if v-Seq = ?
     4499       then
     4500          v-Seq  = next-value (s-c-utd-chip-num, ub).
     4501       else
     4502          vFlagSeq = yes.
     4503       if vFlagseq
     4504       then do:
     4505    for first buf_c-utd where buf_c-utd.db-num eq utd.db-num
     4506   and buf_c-utd.doc-id eq utd.doc-id
     4507     and buf_c-utd.corr-user-db-num   = g#db-num and buf_c-utd.chip-num = v-Seq exclusive-lock: leave. end.
     4508       end.
     4509       if not available buf_c-utd
     4510       then do:
     4511          create buf_c-utd.
     4512          buffer-copy ub.utd to buf_c-utd
     4513          assign
     4514            buf_c-utd.chip-num           = v-Seq
     4515            buf_c-utd.corr-date          = v-date
     4516            buf_c-utd.corr-time          = v-time
     4517            buf_c-utd.corr-user-db-num   = g#db-num
     4518            buf_c-utd.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
     4519            buf_c-utd.action             = 99
     4520            buf_c-utd.is-del             = true
     4521          .
     4522       end.
     4523       else
     4524          buf_c-utd.action             = 99.
     4525         if vFlagSeq
     4526         then do:
     4527    for first buf_c-utd-head where buf_c-utd-head.db-num eq utd.db-num
     4528   and buf_c-utd-head.doc-id eq utd.doc-id
     4529     and buf_c-utd-head.corr-user-db-num   = g#db-num and buf_c-utd-head.chip-num = v-Seq exclusive-lock: leave. end.
     4530         end.
     4531         if not available  buf_c-utd-head
     4532         then do:
     4533            create buf_c-utd-head.
     4534            buffer-copy  buf_c-utd to buf_c-utd-head
     4535            assign
     4536               buf_c-utd-head.subject = "utd"
     4537               buf_c-utd-head.is-news = g#news
     4538               buf_c-utd-head.source-type = (if g#news
     4539                                             then 'db':U
     4540                                             else (if g#esys
     4541                                                   then 'esys':U
     4542                                                   else "":U)
     4543                                             )
     4544               buf_c-utd-head.source-ref = (if g#news
     4545                                            then string(g#news-source-db)
     4546                                            else (if g#esys
     4547                                                  then string(g#esys-source-esys)
     4548                                                  else "":U)
     4549                                            )
     4550            .
     4551         end.
     4552         else do:
     4553            if     buf_c-utd-head.subject ne "*"
     4554            then
     4555               buf_c-utd-head.subject = "*".
     4556            if buf_c-utd-head.action  ne 88
     4557            then
     4558               buf_c-utd-head.action             = 88 .
     4559         end.
     4560   if not g#news
     4561   then do:
     4562     define variable v-list-db as char no-undo.
     4563     if utd.db-num ne g#db-num and not g#esys and not g#auto
     4564     then do:
     4565       v-msg = substitute( "&1. Ошибка при удалении документа. Запрещено удалять документ не своей БД.", vss-workfile ).
     4566       message v-msg view-as alert-box information title "Информация".
     4567       undo, return error v-msg.
     4568     end.
     4569     if g#db-num = 0
     4570     then do:
     4571       find first ub.clients no-lock where ub.clients.obj-type = utd.obj-type and ub.clients.obj-code = utd.obj-code no-error.
     4572        if     avail  ub.clients
     4573           and ub.clients.db-num ne 0
     4574        then
     4575           v-list-db = string (ub.clients.db-num).
     4576     end.
     4577     else do:
     4578       v-list-db = "0".
     4579     end.
     4580     run nws/cmd-del.p
     4581         ( input 'utd':U
     4582         ,input (buffer utd:handle)
     4583         ,input v-list-db
     4584         ) no-error .
     4585     if error-status :error
     4586     then do:
     4587       undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
     4588     end.
     4589   end.
     4590   UnLockUTDMarkbuf(buffer utd,yes).
     4591   for each utd-err where utd-err.db-num eq  utd.db-num
     4592                      and utd-err.doc-id eq  utd.doc-id
     4593   exclusive-lock:
     4594      delete utd-err.
     4595   end.
     4596   for each utd-lines where utd-lines.db-num eq  utd.db-num
     4597                                and utd-lines.doc-id eq  utd.doc-id
     4598   exclusive-lock:
     4599      delete utd-lines.
     4600   end.
     4601   for each utd-err-attr where utd-err-attr.db-num eq  utd.db-num
     4602                           and utd-err-attr.doc-id eq  utd.doc-id
     4603   exclusive-lock:
     4604      delete utd-err-attr.
     4605   end.
