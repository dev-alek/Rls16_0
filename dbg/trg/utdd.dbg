        1   block-level on error undo, throw.
        2   trigger procedure for delete of ub.utd.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo init "Тригер удаления utd".
        9   define variable v-msg as character no-undo.
       10   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
       11   run gbl/getobjsrvhndl.p (input-output ObjSrv).
       12   define new global shared variable g#language as character no-undo .
       13   if g#language <> '' and g#language <> 'rus':U then do:
       14     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       15   end.
       16   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       17   procedure gen-key-rec :
       18     define input  parameter p-tbl-name    as character no-undo.
       19     define input  parameter p-bh_tbl-name as handle    no-undo.
       20     define output parameter p-key-rec     as character no-undo.
       21     do
       22     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       23     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       24     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       25     :
       26       define variable fh               as handle    no-undo .
       27       define variable v-ok             as logical   no-undo .
       28       define variable v-inform         as character no-undo .
       29       define variable v-ind            as integer   no-undo .
       30       define variable v-idx-field-qnty as integer   no-undo .
       31       if p-tbl-name = ?
       32         or p-tbl-name = "":U
       33       then do:
       34         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       35       end.
       36       if not p-bh_tbl-name:available then do:
       37         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
       38       end.
       39       assign
       40         p-key-rec = p-tbl-name
       41         v-inform  = p-bh_tbl-name:index-information(1)
       42         v-ind     = 2
       43       .
       44       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       45       on error undo, return error
       46       :
       47         assign
       48           v-inform = p-bh_tbl-name:index-information( v-ind )
       49           v-ind    = v-ind + 1
       50         .
       51       end.
       52       if v-inform = ?
       53         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
       54         or entry( 3, v-inform, ",":U ) <> "1":U
       55       then do:
       56         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
       57       end.
       58       else do:
       59         assign
       60           v-idx-field-qnty = num-entries( v-inform ) - 4
       61         .
       62         if v-idx-field-qnty < 2 then do:
       63           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
       64         end.
       65         do v-ind = 1 to v-idx-field-qnty by 2
       66         on error undo, return error
       67         :
       68           assign
       69             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
       70             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
       71           .
       72         end.
       73       end.
       74       if p-key-rec = ? then do:
       75         assign
       76           p-key-rec = "":U
       77         .
       78         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
       79       end.
       80     end.
       81     return.
       82   end procedure.
       83   procedure gen-where-keyr-tab :
       84     define input  parameter i-tableSerach as character no-undo.
       85     define input  parameter i-tablekey   as character  no-undo.
       86     define input  parameter p-key-rec    as character  no-undo.
       87     define input  parameter p-key-handle as handle     no-undo .
       88     define input  parameter p-db-name    as character  no-undo .
       89     define input  parameter p-tt-handle  as handle     no-undo .
       90     define output parameter o-Where      as character  no-undo.
       91     do
       92     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       93     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
       94     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
       95     :
       96       define variable v-full-tbl-name  as character no-undo .
       97       define variable bh_tbl-name      as handle    no-undo .
       98       define variable fh_key           as handle    no-undo .
       99       define variable fh_search        as handle    no-undo .
      100       define variable v-field-num      as integer   no-undo .
      101       define variable v-count-fld      as integer   no-undo .
      102       define variable v-inform         as character no-undo .
      103       define variable v-ind            as integer   no-undo .
      104       define variable v-idx-field-qnty as integer   no-undo .
      105       define variable v-field-name     as character no-undo .
      106       define variable v-field-val      as character no-undo .
      107       define variable v-word-link      as character no-undo .
      108       define variable vTable           as character no-undo.
      109       define variable bh_tbl-key       as handle    no-undo .
      110       assign
      111         p-key-rec = trim( p-key-rec )
      112       .
      113       if p-key-handle <> ? then do:
      114         if not valid-handle(p-key-handle)
      115            or p-key-handle:type <> "buffer"
      116         then do:
      117           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      118         end.
      119         if num-entries( p-key-rec, chr(3) ) > 1
      120           or p-key-rec = ?
      121           or p-key-rec = "":U
      122         then do:
      123           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      124         end.
      125       end.
      126       else do:
      127         if p-key-rec = ?
      128           or p-key-rec = "":U
      129         then do:
      130           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      131         end.
      132       end.
      133       assign
      134         vTable = entry( 1 , p-key-rec, chr(3) )
      135       .
      136       if p-tt-handle <> ?
      137         and ( not valid-handle(p-tt-handle)
      138               or p-tt-handle:type <> "buffer"
      139             )
      140       then do:
      141         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      142       end.
      143       if p-tt-handle = ? then do:
      144         assign
      145           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      146         .
      147         create buffer bh_tbl-name for table v-full-tbl-name .
      148       end.
      149       else do:
      150         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      151       end.
      152       assign
      153         v-inform = bh_tbl-name:index-information(1)
      154         v-ind    = 2
      155       .
      156       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      157       on error undo, return error
      158       :
      159         assign
      160           v-inform = bh_tbl-name:index-information( v-ind )
      161           v-ind    = v-ind + 1
      162         .
      163       end.
      164       if v-inform = ?
      165         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      166         or entry( 3, v-inform, ",":U ) <> "1":U
      167       then do:
      168         delete object bh_tbl-name no-error.
      169         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      170       end.
      171       assign
      172         v-idx-field-qnty = num-entries( v-inform ) - 4
      173       .
      174       if v-idx-field-qnty < 2 then do:
      175         delete object bh_tbl-name no-error.
      176         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      177       end.
      178       assign
      179         o-where     = "where":U
      180         v-word-link = "":U
      181         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      182         v-count-fld = 0
      183       .
      184       if i-tablekey ne "" and i-tablekey ne ?
      185       then do:
      186         assign
      187           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      188         .
      189         create buffer bh_tbl-key for table v-full-tbl-name .
      190       end.
      191       if i-tableSerach ne "" and i-tableSerach ne ?
      192       then do:
      193         delete object bh_tbl-name no-error.
      194         assign
      195           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      196         .
      197         create buffer bh_tbl-name for table v-full-tbl-name .
      198       end.
      199       block_where:
      200       do v-ind = 1 to v-idx-field-qnty by 2
      201       on error undo, return error
      202       :
      203         assign
      204           v-count-fld = v-count-fld + 1
      205         .
      206         if p-key-handle = ?
      207           and v-count-fld > v-field-num
      208         then do:
      209           leave block_where.
      210         end.
      211         define variable VfieldKeyTable as handle no-undo.
      212         assign
      213           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      214           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      215         .
      216         if     bh_tbl-key ne ?
      217         then do:
      218            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      219            if VfieldKeyTable eq ?
      220            then next block_where.
      221         end.
      222         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      223         then
      224            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      225         else
      226            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      227         if p-key-handle = ? then do:
      228           assign
      229             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      230           .
      231         end.
      232         else do:
      233           assign
      234             fh_key = p-key-handle:buffer-field( v-field-name )
      235           .
      236           if fh_key = ?
      237             or not valid-handle( fh_key )
      238           then do:
      239             delete object bh_tbl-name.
      240             if     bh_tbl-key ne ?
      241             then
      242                delete object bh_tbl-key.
      243             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      244           end.
      245           assign
      246             v-field-val = fh_key:buffer-value
      247           .
      248         end.
      249         if fh_search:data-type ="character":U then do:
      250           assign
      251             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      252             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      253             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      254             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      255             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      256             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      257             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      258             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      259             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      260             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      261             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      262             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      263             v-field-val = substitute( '"&1"', v-field-val )
      264           .
      265         end.
      266         assign
      267           o-where = substitute( "&1 &2", o-where, v-field-val )
      268         .
      269         if v-word-link = "":U then do:
      270           assign
      271             v-word-link = "and":U
      272           .
      273         end.
      274       end.
      275       delete object bh_tbl-name.
      276       if     bh_tbl-key ne ?
      277       then
      278          delete object bh_tbl-key.
      279       if p-key-handle = ?
      280         and v-count-fld <> v-field-num
      281       then do:
      282         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      283       end.
      284     end.
      285   end procedure.
      286   procedure gen-hn-keyr-tab :
      287     define input  parameter i-tableSerach as character no-undo.
      288     define input  parameter i-tablekey   as character no-undo.
      289     define input  parameter p-key-rec    as character no-undo.
      290     define input  parameter p-key-handle as handle    no-undo .
      291     define input  parameter p-db-name    as character no-undo .
      292     define input  parameter p-tt-handle  as handle    no-undo .
      293     define input  parameter p-stts-lock  as integer   no-undo .
      294     define output parameter o-hn         as handle    no-undo.
      295     define variable v-full-tbl-name as character no-undo.
      296     define variable v-where         as character no-undo.
      297     define variable bh_tbl-name     as handle    no-undo.
      298     define variable vTable          as character no-undo.
      299     do
      300     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      301     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      302     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      303         run gen-where-keyr-tab(i-tableSerach,
      304                                i-tablekey,
      305                                p-key-rec,
      306                                p-key-handle,
      307                                p-db-name,
      308                                p-tt-handle,
      309                                output v-where).
      310         if i-tableSerach ne "" and i-tableSerach ne ?
      311         then do:
      312            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      313            create buffer bh_tbl-name for table v-full-tbl-name .
      314         end.
      315         else do:
      316            if p-tt-handle = ? then do:
      317               assign
      318                  vTable = entry( 1 , p-key-rec, chr(3) )
      319               .
      320               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      321               create buffer bh_tbl-name for table v-full-tbl-name .
      322            end.
      323            else do:
      324               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      325            end.
      326         end.
      327         if p-tt-handle = ? then do:
      328            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      329         end.
      330         else do:
      331            bh_tbl-name:find-first( v-where ) no-error .
      332         end.
      333         o-hn = bh_tbl-name.
      334      end.
      335   end procedure.
      336   procedure gen-hn-keyr :
      337     define input  parameter p-key-rec    as character no-undo.
      338     define input  parameter p-key-handle as handle    no-undo .
      339     define input  parameter p-db-name    as character no-undo .
      340     define input  parameter p-tt-handle  as handle    no-undo .
      341     define input  parameter p-stts-lock  as integer   no-undo .
      342     define output parameter o-hn         as handle    no-undo.
      343     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      344   end.
      345   procedure gen-row-keyr :
      346     define input  parameter p-key-rec    as character no-undo.
      347     define input  parameter p-key-handle as handle    no-undo .
      348     define input  parameter p-db-name    as character no-undo .
      349     define input  parameter p-tt-handle  as handle    no-undo .
      350     define input  parameter p-stts-lock  as integer   no-undo .
      351     define output parameter p-tbl-row    as rowid     no-undo.
      352     define output parameter p-tbl-name   as character no-undo.
      353     define variable vHn as handle no-undo.
      354       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      355       p-tbl-row = if vHn:available then vHn:rowid else ?.
      356       p-tbl-name =  vHn:table.
      357       delete object vHn no-error.
      358     if p-tbl-row = ? then do:
      359       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      360     end.
      361     else do:
      362       return.
      363     end.
      364   end procedure.
      365   procedure gen-key-fv :
      366     define input  parameter p-key-rec    as character no-undo .
      367     define output parameter p-field-list as character no-undo .
      368     define output parameter p-value-list as character no-undo.
      369     do
      370     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      371     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      372     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      373     :
      374       define variable v-full-tbl-name  as character no-undo .
      375       define variable bh_tbl-name      as handle    no-undo .
      376       define variable v-tbl-name       as character no-undo .
      377       define variable v-field-num      as integer   no-undo .
      378       define variable v-count-fld      as integer   no-undo .
      379       define variable v-inform         as character no-undo .
      380       define variable v-ind            as integer   no-undo .
      381       define variable v-idx-field-qnty as integer   no-undo .
      382       define variable v-delim-key      as character no-undo .
      383       if p-key-rec = ?
      384         or p-key-rec = "":U
      385       then do:
      386         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      387       end.
      388       assign
      389         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      390         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      391       .
      392       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      393       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      394       assign
      395         v-inform = bh_tbl-name:index-information(1)
      396         v-ind    = 2
      397       .
      398       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      399       on error undo, return error
      400       :
      401         assign
      402           v-inform = bh_tbl-name:index-information( v-ind )
      403           v-ind    = v-ind + 1
      404         .
      405       end.
      406       if v-inform = ?
      407         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      408         or entry( 3, v-inform, ",":U ) <> "1":U
      409       then do:
      410         delete object bh_tbl-name no-error.
      411         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      412       end.
      413       assign
      414         v-idx-field-qnty = num-entries( v-inform ) - 4
      415       .
      416       if v-idx-field-qnty < 2 then do:
      417         delete object bh_tbl-name no-error.
      418         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      419       end.
      420       assign
      421         p-field-list = "":U
      422         p-value-list = "":U
      423         v-delim-key  = "":U
      424         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      425         v-count-fld  = 0
      426       .
      427       block_where:
      428       do v-ind = 1 to v-idx-field-qnty by 2
      429       on error undo, return error
      430       :
      431         assign
      432           v-count-fld = v-count-fld + 1
      433         .
      434         if v-count-fld > v-field-num then do:
      435           leave block_where.
      436         end.
      437         assign
      438           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      439           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      440         .
      441         if v-ind = 1 then do:
      442           assign
      443             v-delim-key = chr(3)
      444           .
      445         end.
      446       end.
      447       delete object bh_tbl-name.
      448       if v-count-fld <> v-field-num then do:
      449         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      450       end.
      451     end.
      452   end procedure.
      453   procedure gen-key-field :
      454     define input  parameter p-table      as character no-undo .
      455     define output parameter p-field-list as character no-undo .
      456     do
      457     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      458     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      459     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      460     :
      461       define variable v-full-tbl-name  as character no-undo .
      462       define variable bh_tbl-name      as handle    no-undo .
      463       define variable v-tbl-name       as character no-undo .
      464       define variable v-field-num      as integer   no-undo .
      465       define variable v-count-fld      as integer   no-undo .
      466       define variable v-inform         as character no-undo .
      467       define variable v-ind            as integer   no-undo .
      468       define variable v-idx-field-qnty as integer   no-undo .
      469       define variable v-delim-key      as character no-undo .
      470       if p-table = ?
      471         or p-table = "":U
      472       then do:
      473         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      474       end.
      475       assign
      476         v-tbl-name      = p-table
      477         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      478       .
      479       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      480       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      481       assign
      482         v-inform = bh_tbl-name:index-information(1)
      483         v-ind    = 2
      484       .
      485       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      486       on error undo, return error
      487       :
      488         assign
      489           v-inform = bh_tbl-name:index-information( v-ind )
      490           v-ind    = v-ind + 1
      491         .
      492       end.
      493       if v-inform = ?
      494         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      495         or entry( 3, v-inform, ",":U ) <> "1":U
      496       then do:
      497         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      498       end.
      499       assign
      500         v-idx-field-qnty = num-entries( v-inform ) - 4
      501       .
      502       if v-idx-field-qnty < 2 then do:
      503         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      504       end.
      505       assign
      506         p-field-list = "":U
      507         v-delim-key  = "":U
      508         v-count-fld  = 0
      509       .
      510       block_where:
      511       do v-ind = 1 to v-idx-field-qnty by 2
      512       on error undo, return error
      513       :
      514         assign
      515           v-count-fld = v-count-fld + 1
      516         .
      517         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      518         if v-ind = 1 then do:
      519           assign
      520             v-delim-key = chr(3)
      521           .
      522         end.
      523       end.
      524       delete object bh_tbl-name.
      525     end.
      526   end procedure.
      527   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      528   define new global shared variable g#attr-lib  as handle no-undo .
      529   define variable v-attr-lib-variable as handle no-undo .
      530   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      531   function getattrUtdex returns char
      532   (idb-num   as integer,
      533    idoc-id   as integer,
      534    iattrcode as character,
      535    iExValue  as character  ):
      536      define buffer utd-attr for utd-attr.
      537      find first utd-attr where utd-attr.db-num eq idb-num
      538                            and utd-attr.doc-id eq idoc-id
      539                            and utd-attr.attr-code eq iattrcode
      540      no-lock no-error.
      541      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      542   end.
      543   function getattrUtd returns char
      544   (idb-num   as integer,
      545    idoc-id   as integer,
      546    iattrcode as character ):
      547     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      548   end.
      549   function setattrUtd returns logical
      550   (idb-num   as integer,
      551    idoc-id   as integer,
      552    iattrcode as character,
      553    iattrval  as character ):
      554      define buffer utd-attr for utd-attr.
      555      find first utd-attr where utd-attr.db-num eq idb-num
      556                            and utd-attr.doc-id eq idoc-id
      557                            and utd-attr.attr-code eq iattrcode
      558      no-lock no-error.
      559      if not available utd-attr
      560      then do:
      561         create utd-attr.
      562         assign
      563            utd-attr.db-num    = idb-num
      564            utd-attr.doc-id    = idoc-id
      565            utd-attr.attr-code = iattrcode
      566            utd-attr.attr-value = iattrval
      567         .
      568      end.
      569      else do:
      570         if utd-attr.attr-value ne iattrval
      571         then do:
      572            find current utd-attr exclusive-lock no-error.
      573            if available utd-attr
      574            then
      575               utd-attr.attr-value = iattrval.
      576         end.
      577      end.
      578      release utd-attr.
      579   end.
      580   function GetAttrUtdlinesEx returns char
      581   (idb-num   as integer,
      582    idoc-id   as integer,
      583    ilinenum  as integer,
      584    iattrcode as character,
      585    iExValue  as character  ):
      586      define buffer utd-lines-attr for utd-lines-attr.
      587      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      588                                  and utd-lines-attr.doc-id    eq idoc-id
      589                                  and utd-lines-attr.lineNum   eq ilineNum
      590                                  and utd-lines-attr.attr-code eq iattrcode
      591      no-lock no-error.
      592      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      593   end.
      594   function GetAttrUtdlines returns char
      595   (idb-num   as integer,
      596    idoc-id   as integer,
      597    ilinenum  as integer,
      598    iattrcode as character ):
      599      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      600   end.
      601   function setattrUtdlines returns logical
      602   (idb-num   as integer,
      603    idoc-id   as integer,
      604    ilinenum  as integer,
      605    iattrcode as character,
      606    iattrval  as character ):
      607      define buffer utd-lines-attr for utd-lines-attr.
      608      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      609                                  and utd-lines-attr.doc-id    eq idoc-id
      610                                  and utd-lines-attr.lineNum   eq ilineNum
      611                                  and utd-lines-attr.attr-code eq iattrcode
      612      no-lock no-error.
      613      if not available utd-lines-attr
      614      then do:
      615         if iattrval ne ?
      616            and iattrval ne ""
      617         then do:
      618            create utd-lines-attr.
      619            assign
      620               utd-lines-attr.db-num    = idb-num
      621               utd-lines-attr.doc-id    = idoc-id
      622               utd-lines-attr.lineNum   = ilineNum
      623               utd-lines-attr.attr-code = iattrcode
      624               utd-lines-attr.attr-value = iattrval
      625            .
      626         end.
      627      end.
      628      else do:
      629         if utd-lines-attr.attr-value ne iattrval
      630         then do:
      631            find current utd-lines-attr exclusive-lock no-error.
      632            if available utd-lines-attr
      633            then do:
      634               if    iattrval eq ?
      635                  or iattrval eq ""
      636               then do:
      637                  delete utd-lines-attr.
      638               end.
      639               else do:
      640                  utd-lines-attr.attr-value = iattrval.
      641               end.
      642            end.
      643         end.
      644      end.
      645      release utd-lines-attr.
      646   end.
      647   function GetAttrUtdMarkingLinesEx returns char
      648   (idb-num   as integer,
      649    idoc-id   as integer,
      650    ilinenum  as integer,
      651    imark     as character,
      652    iattrcode as character,
      653    iExValue  as character  ):
      654      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      655      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      656                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      657                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      658                                          and utd-marking-lines-attr.mark      eq imark
      659                                          and utd-marking-lines-attr.attr-code eq iattrcode
      660      no-lock no-error.
      661      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      662   end.
      663   function GetAttrUtdMarkingLines returns char
      664   (idb-num   as integer,
      665    idoc-id   as integer,
      666    ilinenum  as integer,
      667    imark     as character,
      668    iattrcode as character ):
      669      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      670   end.
      671   function setattrUtdMarkingLines returns logical
      672   (idb-num   as integer,
      673    idoc-id   as integer,
      674    ilinenum  as integer,
      675    imark     as character,
      676    iattrcode as character,
      677    iattrval  as character ):
      678      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      679      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      680                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      681                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      682                                          and utd-marking-lines-attr.mark      eq imark
      683                                          and utd-marking-lines-attr.attr-code eq iattrcode
      684      no-lock no-error.
      685      if not available utd-marking-lines-attr
      686      then do:
      687         if iattrval ne ?
      688            and iattrval ne ""
      689         then do:
      690            create utd-marking-lines-attr.
      691            assign
      692               utd-marking-lines-attr.db-num     = idb-num
      693               utd-marking-lines-attr.doc-id     = idoc-id
      694               utd-marking-lines-attr.lineNum    = ilineNum
      695               utd-marking-lines-attr.mark       = imark
      696               utd-marking-lines-attr.attr-code  = iattrcode
      697               utd-marking-lines-attr.attr-value = iattrval
      698            .
      699         end.
      700      end.
      701      else do:
      702         if utd-marking-lines-attr.attr-value ne iattrval
      703         then do:
      704            find current utd-marking-lines-attr exclusive-lock no-error.
      705            if available utd-marking-lines-attr
      706            then do:
      707               if    iattrval eq ?
      708                  or iattrval eq ""
      709               then do:
      710                  delete utd-marking-lines-attr.
      711               end.
      712               else do:
      713                  utd-marking-lines-attr.attr-value = iattrval.
      714               end.
      715            end.
      716         end.
      717      end.
      718      release utd-marking-lines-attr.
      719   end.
