        1   block-level on error undo, throw.
        2   define input parameter pardoc-code like ub.wth-line.doc-code no-undo .
        3   define input parameter parhost-code like ub.wth-doc.host-code no-undo .
        4   define input parameter parobj-type like ub.wth-doc.obj-type no-undo .
        5   define input parameter parobj-code like ub.wth-doc.obj-code no-undo .
        6   define input parameter parcli-type like ub.wth-doc.cli-type no-undo .
        7   define input parameter parcli-code like ub.wth-doc.cli-code no-undo .
        8   define input parameter parauto-fill like ub.wth-doc.auto-fill no-undo .
        9   define input parameter par-borned like ub.wth-doc.borned no-undo .
       10   define input parameter par-exter_ like ub.wth-doc.exter_ no-undo .
       11   define input parameter par-rid as recid no-undo .
       12   define input parameter parwth-code like ub.wth-line.wth-code no-undo .
       13   define input parameter parw-p-code like ub.wth-line.w-p-code no-undo .
       14   define input parameter parout-code like ub.wth-line.out-code no-undo .
       15   define input parameter pardoc-sum  like ub.wth-line.doc-sum no-undo .
       16   define input parameter parfact-sum  like ub.wth-line.doc-sum no-undo .
       17   define output parameter p-stts like ub.wealth.stts no-undo .
       18   define variable vss-revision    as character no-undo init "$Revision$":U .
       19   define variable vss-author      as character no-undo init "$Author$":U .
       20   define variable vss-date        as character no-undo init "$Date$":U .
       21   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       22   define variable vss-archive     as character no-undo init "$Archive$":U .
       23   define variable vss-description as character no-undo init "Проверка корректности записи строки документа МЦ неивентр".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   DEFINE VARIABLE var-entry as character no-undo .
       79   define buffer current-place for ub.wth-place .
       80   define buffer out-place for ub.wth-place .
       81   define buffer buf_wth-line for ub.wth-line .
       82   define buffer inv_wth-doc for ub.wth-doc.
       83   define buffer buf_wealth  for ub.wealth .
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   do
      100   on error undo, return error
      101   :
      102   find first buf_wealth NO-LOCK WHERE buf_wealth.wth-code = parwth-code no-error .
      103   if not avail buf_wealth then do:
      104     MESSAGE
      105     "Документ" pardoc-code skip
      106     "Материальная ценность" parwth-code "не найдена в справочнике!"
      107     VIEW-AS ALERT-BOX ERROR.
      108     var-entry = "wth-code":U.
      109     return error var-entry .
      110   END.
      111   if   not (parw-p-code = 0 or parw-p-code = ?) then do:
      112     FIND FIRST current-place NO-LOCK WHERE
      113         current-place.host-code   = parhost-code AND
      114         current-place.obj-type    = parobj-type AND
      115         current-place.obj-code    = parobj-code AND
      116         current-place.w-p-code    = parw-p-code
      117           NO-ERROR.
      118     IF NOT AVAIL current-place THEN DO:
      119       MESSAGE
      120       "Документ" pardoc-code skip
      121       "МЦ" parwth-code skip
      122       "МХ" parw-p-code skip
      123       "Не найдено место хранения МЦ в справочнике!"
      124       VIEW-AS ALERT-BOX ERROR.
      125       var-entry = "w-p-code":U.
      126       return error var-entry .
      127     END.
      128   end.
      129   if not g#news and parauto-fill and (available current-place and current-place.cash-desk = 0) and not par-borned then do:
      130     MESSAGE
      131     "Документ" pardoc-code skip
      132     "МЦ" parwth-code skip
      133     "МХ" parw-p-code skip
      134     "Для автоматического документа место хранения должно быть кассой!"
      135     VIEW-AS ALERT-BOX ERROR.
      136     var-entry = "w-p-code":U.
      137     return error var-entry .
      138   end.
      139   FIND FIRST out-place NO-LOCK WHERE
      140             out-place.host-code   = parhost-code AND
      141             out-place.obj-type    = parcli-type AND
      142             out-place.obj-code    = parcli-code AND
      143             out-place.w-p-code    = parout-code  NO-ERROR.
      144   IF NOT AVAIL out-place AND not par-exter_ and parcli-type = parobj-type and parcli-code = parobj-code THEN DO:
      145     MESSAGE
      146     "Документ" pardoc-code skip
      147     "МЦ" parwth-code skip
      148     "МХ" parw-p-code skip
      149     "Не найдено место хранения МЦ в справочнике!"
      150     VIEW-AS ALERT-BOX ERROR.
      151     var-entry = "out-code":U.
      152     return error var-entry .
      153   END.
      154   if available out-place then do:
      155     if parauto-fill and par-borned and out-place.cash-desk = 0 then do:
      156       MESSAGE
      157       "Документ" pardoc-code skip
      158       "МЦ" parwth-code skip
      159       "МХ" parout-code skip
      160       "Для автоматического документа место хранения должно быть кассой!"
      161       VIEW-AS ALERT-BOX ERROR.
      162       var-entry = "out-code":U.
      163       return error var-entry .
      164     end.
      165     IF parobj-type = parcli-type AND
      166       parobj-code = parcli-code THEN DO:
      167       IF current-place.w-p-code = out-place.w-p-code THEN DO:
      168         MESSAGE "Нельзя перемещать МЦ в место их хранения!"
      169         VIEW-AS ALERT-BOX ERROR.
      170         var-entry = "out-w-p-code":U.
      171         return error var-entry .
      172       END.
      173     END.
      174   end.
      175   FIND FIRST buf_wth-line NO-LOCK WHERE
      176             buf_wth-line.obj-type    = parobj-type   AND
      177             buf_wth-line.obj-code    = parobj-code   AND
      178             buf_wth-line.w-p-code    = parw-p-code   AND
      179             buf_wth-line.wth-code    = parwth-code   AND
      180             buf_wth-line.doc-code    = pardoc-code AND
      181             RECID( buf_wth-line )   <>  par-rid NO-ERROR.
      182   IF AVAIL buf_wth-line THEN DO:
      183     MESSAGE
      184     "В этом документе уже есть запись материальной ценности" parwth-code "по м/х" parw-p-code "!" SKIP
      185     "Невозможно добавить в документ!"
      186     VIEW-AS ALERT-BOX ERROR.
      187     var-entry = "wth-code":U.
      188     return error var-entry .
      189   END.
      190   IF parfact-sum > pardoc-sum THEN DO:
      191     MESSAGE
      192       "Фактическая сумма материальных ценностей не д.б. больше суммы движения!"
      193     VIEW-AS ALERT-BOX ERROR.
      194     var-entry = "fact-sum":U.
      195     return error var-entry .
      196   END.
      197   assign
      198   p-stts = buf_wealth.stts
      199   .
      200   end.
