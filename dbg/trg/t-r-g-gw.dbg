        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.tax-rate-gds-grp OLD old-tax-rate-gds-grp.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись для таблицы налоги на группу товаров".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                                       ,ub.tax-rate-gds-grp.node-code
       30                                       ,ub.tax-rate-gds-grp.tax-code
       31                                       ,ub.tax-rate-gds-grp.host-code
       32                                       ,ub.tax-rate-gds-grp.obj-type
       33                                       ,ub.tax-rate-gds-grp.obj-code
       34                                       )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure cur-time :
       89      define output parameter p-today as date      no-undo .
       90      define output parameter p-time  as integer   no-undo .
       91     do
       92     on error undo, return error
       93     :
       94       define variable v-date1 as date      no-undo .
       95       define variable v-date2 as date      no-undo .
       96       define variable v-time  as integer   no-undo .
       97       assign
       98         v-date1 = today
       99         v-time  = time
      100         v-date2 = today
      101       .
      102       if v-date1 <> v-date2
      103       then do:
      104         assign
      105           v-date1 = today
      106           v-time  = v-time
      107         .
      108       end.
      109       assign
      110         p-today = v-date1
      111         p-time  = v-time
      112       .
      113     end.
      114   end.
      115   function cur-time-date returns character
      116   :
      117     return string(today, '99/99/9999':U) .
      118   end.
      119   function cur-time-mjd returns decimal
      120   :
      121     define variable v-date as date      no-undo .
      122     define variable v-time as integer   no-undo .
      123     run cur-time in this-procedure
      124       (output v-date
      125       ,output v-time
      126       ) .
      127     return integer(v-date) - 2400002 + (v-time / 86400) .
      128   end.
      129   function cur-time-get-ending-index returns integer
      130   (input p-number as integer
      131   )
      132   :
      133     if p-number < 0
      134     or p-number = ?
      135     then do:
      136       return 1 .
      137     end.
      138     define variable v-rest as integer   no-undo .
      139     assign
      140       p-number = p-number modulo 100
      141     .
      142     if p-number < 20
      143     then do:
      144       assign
      145         v-rest = p-number
      146       .
      147     end.
      148     else do:
      149       assign
      150         v-rest = p-number modulo 10
      151       .
      152     end.
      153     case v-rest :
      154       when 1
      155       then do:
      156         return 2 .
      157       end.
      158       when 2 or
      159       when 3 or
      160       when 4
      161       then do:
      162         return 3 .
      163       end.
      164       otherwise do:
      165         return 1 .
      166       end.
      167     end case .
      168   end.
      169   procedure cur-time-mjd-to-date :
      170      define input  parameter i-mjd-diff as decimal no-undo.
      171      define output parameter o-Date     as date    no-undo.
      172      define output parameter o-Time     as integer no-undo.
      173      define variable v-day-number as integer   no-undo .
      174      if    i-mjd-diff < 0
      175         or i-mjd-diff = ?
      176      then do:
      177         return "?" .
      178      end.
      179      assign
      180         v-day-number = truncate(i-mjd-diff,0).
      181         o-Date = date(v-day-number + 2400002).
      182         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184   end.
      185   function cur-time-mjd-to-string returns character
      186   (input p-mjd-diff as decimal
      187   )
      188   :
      189     define variable v-day-number as integer   no-undo .
      190     define variable v-seconds    as integer   no-undo .
      191     define variable v-hour       as integer   no-undo .
      192     define variable v-min        as integer   no-undo .
      193     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      194     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      195     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      196     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      197     if p-mjd-diff < 0
      198     or p-mjd-diff = ?
      199     then do:
      200       return "?" .
      201     end.
      202     assign
      203       v-day-number = integer(truncate(p-mjd-diff,0))
      204       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206     if v-seconds > 86400
      207     then do:
      208       assign
      209         v-seconds = 86400 - 1
      210       .
      211     end.
      212     if v-seconds < 0
      213     then do:
      214       assign
      215         v-seconds = 0
      216       .
      217     end.
      218     assign
      219       v-hour = truncate(v-seconds / 3600, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 3600
      223     .
      224     assign
      225       v-min = truncate(v-seconds / 60, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 60
      229     .
      230     return
      231         (if v-day-number <> 0
      232           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0
      236           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      240           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      241           else ""
      242         )
      243       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      244       .
      245   end.
      246   function cur-time-string returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      255   end.
      256   function cur-time-string-sec returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      265   end.
      266   function cur-time-custom  returns character
      267   (input p-prefix as character
      268   ,input p-date-format as character
      269   ,input p-delimiter as character
      270   ,input p-time-format as character
      271   ,input p-suffix as character
      272   )
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return
      281       p-prefix
      282       + string(v-date, p-date-format)
      283       + p-delimiter
      284       + string(v-time, p-time-format)
      285       + p-suffix
      286       .
      287   end.
      288   function cur-time-print  returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-datetime returns datetime
      299   :
      300     define variable v-char as character no-undo .
      301     define variable v-datetime as datetime no-undo .
      302     v-char = cur-time-string().
      303     v-datetime = datetime(v-char).
      304     return  v-datetime.
      305   end.
      306   function cur-time-string-msec returns character
      307   :
      308     define variable v-date as datetime  no-undo .
      309     v-date = now.
      310     return string(v-date) .
      311   end.
      312   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   procedure gds-grph_write-gds-grp-attr-proc  :
      314   define parameter buffer buf_gds-grp-attr for ub.gds-grp-attr .
      315   define input parameter p-action as integer no-undo .
      316   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      317   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      318   define variable v-date as date      no-undo.
      319   define variable v-time  as integer   no-undo.
      320   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      321   define buffer buf_c-gds-grp-attr for ub.c-gds-grp-attr.
      322     do
      323     on error undo, return error
      324     :
      325       if not available buf_gds-grp-attr then do:
      326         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      327                       "Ошибка задания входных параметров:Не определен атрибут группы товара" ).
      328       end.
      329       run cur-time in this-procedure(output v-date, output v-time).
      330       create buf_c-gds-grp-attr.
      331       buffer-copy buf_gds-grp-attr to buf_c-gds-grp-attr
      332       assign
      333       buf_c-gds-grp-attr.node-code          = buf_gds-grp-attr.node-code
      334       buf_c-gds-grp-attr.attr-code          = buf_gds-grp-attr.attr-code
      335       buf_c-gds-grp-attr.host-code          = buf_gds-grp-attr.host-code
      336       buf_c-gds-grp-attr.obj-type           = buf_gds-grp-attr.obj-type
      337       buf_c-gds-grp-attr.obj-code           = buf_gds-grp-attr.obj-code
      338       buf_c-gds-grp-attr.chip-num           = next-value (s-gds-grp-chip, ub)
      339       buf_c-gds-grp-attr.corr-time          = v-time
      340       buf_c-gds-grp-attr.corr-user-db-num   = g#db-num
      341       buf_c-gds-grp-attr.corr-user-name     = (if g#news
      342                                           then (chr(4) +  'СПН':U)
      343                                           else (if g#esys
      344                                                then (chr(4) +  'ВС':U)
      345                                                else g#userid)
      346                                           )
      347       buf_c-gds-grp-attr.corr-date          = v-date
      348       .
      349       create buf_c-gds-grp-hist.
      350       buffer-copy buf_c-gds-grp-attr to buf_c-gds-grp-hist
      351       assign
      352       buf_c-gds-grp-hist.action =  p-action
      353       buf_c-gds-grp-hist.subject = 'gds-grp-attr':U
      354       buf_c-gds-grp-hist.is-news = g#news
      355       buf_c-gds-grp-hist.source-type = p-source-type
      356       buf_c-gds-grp-hist.source-ref = p-source-ref
      357       .
      358     end.
      359   end procedure.
      360   procedure gds-grph_write-gds-grp-obj-proc  :
      361   define parameter buffer buf_gds-grp-obj for ub.gds-grp-obj .
      362   define input parameter p-action as integer no-undo .
      363   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      364   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      365   define variable v-date as date      no-undo.
      366   define variable v-time  as integer   no-undo.
      367   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      368   define buffer buf_c-gds-grp-obj for ub.c-gds-grp-obj.
      369     do
      370     on error undo, return error
      371     :
      372       if not available buf_gds-grp-obj then do:
      373         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      374                       "Ошибка задания входных параметров:Не определена группы товара на объекте" ).
      375       end.
      376       run cur-time in this-procedure(output v-date, output v-time).
      377       create buf_c-gds-grp-obj.
      378       buffer-copy buf_gds-grp-obj to buf_c-gds-grp-obj
      379       assign
      380       buf_c-gds-grp-obj.node-code          = buf_gds-grp-obj.node-code
      381       buf_c-gds-grp-obj.host-code          = buf_gds-grp-obj.host-code
      382       buf_c-gds-grp-obj.obj-type           = buf_gds-grp-obj.obj-type
      383       buf_c-gds-grp-obj.obj-code           = buf_gds-grp-obj.obj-code
      384       buf_c-gds-grp-obj.chip-num           = next-value (s-gds-grp-chip, ub)
      385       buf_c-gds-grp-obj.corr-time          = v-time
      386       buf_c-gds-grp-obj.corr-user-db-num   = g#db-num
      387       buf_c-gds-grp-obj.corr-user-name     = (if g#news
      388                                           then (chr(4) +  'СПН':U)
      389                                           else (if g#esys
      390                                                then (chr(4) +  'ВС':U)
      391                                                else g#userid)
      392                                           )
      393       buf_c-gds-grp-obj.corr-date          = v-date
      394       .
      395       create buf_c-gds-grp-hist.
      396       buffer-copy buf_c-gds-grp-obj to buf_c-gds-grp-hist
      397       assign
      398       buf_c-gds-grp-hist.action =  p-action
      399       buf_c-gds-grp-hist.subject = 'gds-grp-obj':U
      400       buf_c-gds-grp-hist.is-news = g#news
      401       buf_c-gds-grp-hist.source-type = p-source-type
      402       buf_c-gds-grp-hist.source-ref = p-source-ref
      403       .
      404     end.
      405   end procedure.
      406   procedure gds-grph_write-tax-rate-gds-grp-trigger :
      407   define input parameter p-new-record as logical no-undo .
      408   define input parameter p-source-type like ub.c-gds-grp-hist.source-type no-undo .
      409   define input parameter p-source-ref  like ub.c-gds-grp-hist.source-ref no-undo .
      410   define input parameter p-action as integer no-undo .
      411   define variable v-date as date      no-undo.
      412   define variable v-time  as integer   no-undo.
      413   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      414   define buffer buf_c-tax-rate-gds-grp for ub.c-tax-rate-gds-grp.
      415     do
      416     on error undo, return error
      417     :
      418       run cur-time in this-procedure(output v-date, output v-time).
      419       create buf_c-tax-rate-gds-grp.
      420       buffer-copy old-tax-rate-gds-grp to buf_c-tax-rate-gds-grp
      421       assign
      422       buf_c-tax-rate-gds-grp.node-code          = (if p-new-record then ub.tax-rate-gds-grp.node-code else old-tax-rate-gds-grp.node-code)
      423       buf_c-tax-rate-gds-grp.tax-code           = (if p-new-record then ub.tax-rate-gds-grp.tax-code else old-tax-rate-gds-grp.tax-code)
      424       buf_c-tax-rate-gds-grp.host-code          = (if p-new-record then ub.tax-rate-gds-grp.host-code else  old-tax-rate-gds-grp.host-code)
      425       buf_c-tax-rate-gds-grp.obj-type           = (if p-new-record then ub.tax-rate-gds-grp.obj-type  else  old-tax-rate-gds-grp.obj-type)
      426       buf_c-tax-rate-gds-grp.obj-code           = (if p-new-record then ub.tax-rate-gds-grp.obj-code  else  old-tax-rate-gds-grp.obj-code)
      427       buf_c-tax-rate-gds-grp.chip-num           = next-value (s-gds-grp-chip, ub)
      428       buf_c-tax-rate-gds-grp.corr-time          = v-time
      429       buf_c-tax-rate-gds-grp.corr-user-db-num   = g#db-num
      430       buf_c-tax-rate-gds-grp.corr-user-name     = (if g#news
      431                                           then (chr(4) +  'СПН':U)
      432                                           else (if g#esys
      433                                                then (chr(4) +  'ВС':U)
      434                                                else g#userid)
      435                                           )
      436       buf_c-tax-rate-gds-grp.corr-date          = v-date
      437       .
      438       create buf_c-gds-grp-hist.
      439       buffer-copy buf_c-tax-rate-gds-grp to buf_c-gds-grp-hist
      440       assign
      441       buf_c-gds-grp-hist.node-code           = buf_c-tax-rate-gds-grp.node-code
      442       buf_c-gds-grp-hist.action = p-action
      443       buf_c-gds-grp-hist.subject = 'tax-rate-gds-grp':U
      444       buf_c-gds-grp-hist.is-news = g#news
      445       buf_c-gds-grp-hist.source-type = p-source-type
      446       buf_c-gds-grp-hist.source-ref = p-source-ref
      447       .
      448     end.
      449   end procedure.
      450   procedure gds-grph_write-tax-rate-gds-grp-proc  :
      451   define parameter buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp .
      452   define input parameter p-action as integer no-undo .
      453   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      454   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      455   define variable v-date as date      no-undo.
      456   define variable v-time  as integer   no-undo.
      457   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      458   define buffer buf_c-tax-rate-gds-grp for ub.c-tax-rate-gds-grp.
      459     do
      460     on error undo, return error
      461     :
      462       if not available buf_tax-rate-gds-grp then do:
      463         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      464                       "Ошибка задания входных параметров:Не определена группы товара на объекте" ).
      465       end.
      466       run cur-time in this-procedure(output v-date, output v-time).
      467       create buf_c-tax-rate-gds-grp.
      468       buffer-copy buf_tax-rate-gds-grp to buf_c-tax-rate-gds-grp
      469       assign
      470       buf_c-tax-rate-gds-grp.node-code          = buf_tax-rate-gds-grp.node-code
      471       buf_c-tax-rate-gds-grp.tax-code           = buf_tax-rate-gds-grp.tax-code
      472       buf_c-tax-rate-gds-grp.host-code          = buf_tax-rate-gds-grp.host-code
      473       buf_c-tax-rate-gds-grp.obj-type           = buf_tax-rate-gds-grp.obj-type
      474       buf_c-tax-rate-gds-grp.obj-code           = buf_tax-rate-gds-grp.obj-code
      475       buf_c-tax-rate-gds-grp.chip-num           = next-value (s-gds-grp-chip, ub)
      476       buf_c-tax-rate-gds-grp.corr-time          = v-time
      477       buf_c-tax-rate-gds-grp.corr-user-db-num   = g#db-num
      478       buf_c-tax-rate-gds-grp.corr-user-name     = (if g#news
      479                                           then (chr(4) +  'СПН':U)
      480                                           else (if g#esys
      481                                                then (chr(4) +  'ВС':U)
      482                                                else g#userid)
      483                                           )
      484       buf_c-tax-rate-gds-grp.corr-date          = v-date
      485       .
      486       create buf_c-gds-grp-hist.
      487       buffer-copy buf_c-tax-rate-gds-grp to buf_c-gds-grp-hist
      488       assign
      489       buf_c-gds-grp-hist.action =  p-action
      490       buf_c-gds-grp-hist.subject = 'tax-rate-gds-grp':U
      491       buf_c-gds-grp-hist.is-news = g#news
      492       buf_c-gds-grp-hist.source-type = p-source-type
      493       buf_c-gds-grp-hist.source-ref = p-source-ref
      494       .
      495     end.
      496   end procedure.
      497   main-block:
      498   do
      499   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      500   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      501   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      502   :
      503     run str/callnews.p
      504       (input "tax-rate-gds-grp"
      505       ,input (buffer ub.tax-rate-gds-grp:handle)
      506       ).
      507     if not g#news then do:
      508       run gds-grph_write-tax-rate-gds-grp-trigger  in this-procedure (
      509                                                                   input new(ub.tax-rate-gds-grp)
      510                                                                  ,input "":U
      511                                                                  ,input "":U
      512                                                                  ,input (if new(ub.tax-rate-gds-grp)
      513                                                                          then integer('1':U)
      514                                                                          else integer('2':U)
      515                                                                         )
      516                                                                 ).
      517     end.
      518       if g#oxml = yes
      519       then do:
      520       run str/calloxml.p (
      521             input 'update':U
      522           , input 'tax-rate-gds-grp':U
      523           , input ( buffer ub.tax-rate-gds-grp:handle )
      524       ) no-error.
      525       if error-status :error
      526       then do:
      527           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      528                                , chr(10)
      529                                , vss-workfile
      530                                , return-value
      531                                , error-status :get-message ( 1 ) ).
      532       end.
      533       end.
      534   end.
