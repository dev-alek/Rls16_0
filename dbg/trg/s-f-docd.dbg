        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.schet-fact-doc .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление счета-фактуры".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3', ub.schet-fact-doc.doc-code, ub.schet-fact-doc.doc-date, ub.schet-fact-doc.status_)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   main-block :
       82   do transaction
       83   on error undo main-block, return error
       84   :
       85     define buffer buf_factur-connect  for ub.factur-connect.
       86     define buffer buf_schet-fact-line for ub.schet-fact-line.
       87     define buffer buf_fin-ob  for ub.fin-ob.
       88     define buffer buf_fin-doc for ub.fin-doc.
       89     define buffer buf_trn-doc for ub.trn-doc.
       90     define variable  p-sys-date     as date      no-undo .
       91     define variable  p-sys-time     as character no-undo .
       92     define variable  p-sys-time-int as integer   no-undo .
       93     for each buf_factur-connect exclusive-lock
       94       where buf_factur-connect.db-num          = ub.schet-fact-doc.db-num
       95         and buf_factur-connect.factur-doc-code = ub.schet-fact-doc.doc-code
       96     :
       97       delete buf_factur-connect .
       98     end.
       99     for each buf_schet-fact-line exclusive-lock
      100        where buf_schet-fact-line.db-num   = ub.schet-fact-doc.db-num
      101          and buf_schet-fact-line.doc-code = ub.schet-fact-doc.doc-code
      102     :
      103       delete buf_schet-fact-line .
      104     end.
      105     if ub.schet-fact-doc.in-doc-type <> "" then do:
      106       case ub.schet-fact-doc.in-doc-type :
      107         when 'fo':U then do:
      108           find first buf_fin-ob exclusive-lock where buf_fin-ob.host-code = ub.schet-fact-doc.host-code and  buf_fin-ob.doc-code = ub.schet-fact-doc.in-doc-code no-error .
      109           if available buf_fin-ob then do:
      110             assign
      111               buf_fin-ob.factur-date      = ?
      112               buf_fin-ob.cr-factur        = no
      113               buf_fin-ob.need-factur      = 1
      114             .
      115           end.
      116         end.
      117         when 'td':U then do:
      118           find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = ub.schet-fact-doc.in-doc-code no-error .
      119           if available buf_trn-doc then do:
      120             assign
      121               buf_trn-doc.factur-date      = ?
      122               buf_trn-doc.cr-factur        = no
      123               buf_trn-doc.need-factur      = 1
      124             .
      125           end.
      126         end.
      127         when 'fd':U then do:
      128           find first buf_fin-doc exclusive-lock where buf_fin-doc.host-code = ub.schet-fact-doc.host-code and  buf_fin-doc.fin-doc-code = int(ub.schet-fact-doc.in-doc-code) no-error .
      129           if available buf_fin-doc then do:
      130             assign
      131               buf_fin-doc.factur-date      = ?
      132               buf_fin-doc.cr-factur        = no
      133               buf_fin-doc.need-factur      = 1
      134             .
      135           end.
      136         end.
      137       end.
      138     end.
      139     if not g#news and ( g#db-num <> 0 or ub.schet-fact-doc.db-num <> g#db-num) then do:
      140       define variable v-list-db as character no-undo .
      141       if g#db-num <> 0 then assign v-list-db = "0" .
      142       else                  assign v-list-db = string(ub.schet-fact-doc.db-num) .
      143       run nws/cmd-del.p
      144         ( input 'schet-fact-doc':U
      145          ,input (buffer ub.schet-fact-doc:handle)
      146          ,input v-list-db
      147         ) no-error .
      148       if error-status :error then do:
      149         return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      150       end.
      151     end.
      152   end.
