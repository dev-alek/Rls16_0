        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.rule-call-param .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление параметры вызова правила".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6'
       29                           ,  ub.rule-call-param.call#_id
       30                           ,  ub.rule-call-param.codex_id
       31                           ,  ub.rule-call-param.ruleset_id
       32                           ,  ub.rule-call-param.order_id
       33                           ,  ub.rule-call-param.param-name
       34                           ,  ub.rule-call-param.p-index
       35                           )
       36       .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure cur-time :
       90      define output parameter p-today as date      no-undo .
       91      define output parameter p-time  as integer   no-undo .
       92     do
       93     on error undo, return error
       94     :
       95       define variable v-date1 as date      no-undo .
       96       define variable v-date2 as date      no-undo .
       97       define variable v-time  as integer   no-undo .
       98       assign
       99         v-date1 = today
      100         v-time  = time
      101         v-date2 = today
      102       .
      103       if v-date1 <> v-date2
      104       then do:
      105         assign
      106           v-date1 = today
      107           v-time  = v-time
      108         .
      109       end.
      110       assign
      111         p-today = v-date1
      112         p-time  = v-time
      113       .
      114     end.
      115   end.
      116   function cur-time-date returns character
      117   :
      118     return string(today, '99/99/9999':U) .
      119   end.
      120   function cur-time-mjd returns decimal
      121   :
      122     define variable v-date as date      no-undo .
      123     define variable v-time as integer   no-undo .
      124     run cur-time in this-procedure
      125       (output v-date
      126       ,output v-time
      127       ) .
      128     return integer(v-date) - 2400002 + (v-time / 86400) .
      129   end.
      130   function cur-time-get-ending-index returns integer
      131   (input p-number as integer
      132   )
      133   :
      134     if p-number < 0
      135     or p-number = ?
      136     then do:
      137       return 1 .
      138     end.
      139     define variable v-rest as integer   no-undo .
      140     assign
      141       p-number = p-number modulo 100
      142     .
      143     if p-number < 20
      144     then do:
      145       assign
      146         v-rest = p-number
      147       .
      148     end.
      149     else do:
      150       assign
      151         v-rest = p-number modulo 10
      152       .
      153     end.
      154     case v-rest :
      155       when 1
      156       then do:
      157         return 2 .
      158       end.
      159       when 2 or
      160       when 3 or
      161       when 4
      162       then do:
      163         return 3 .
      164       end.
      165       otherwise do:
      166         return 1 .
      167       end.
      168     end case .
      169   end.
      170   procedure cur-time-mjd-to-date :
      171      define input  parameter i-mjd-diff as decimal no-undo.
      172      define output parameter o-Date     as date    no-undo.
      173      define output parameter o-Time     as integer no-undo.
      174      define variable v-day-number as integer   no-undo .
      175      if    i-mjd-diff < 0
      176         or i-mjd-diff = ?
      177      then do:
      178         return "?" .
      179      end.
      180      assign
      181         v-day-number = truncate(i-mjd-diff,0).
      182         o-Date = date(v-day-number + 2400002).
      183         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185   end.
      186   function cur-time-mjd-to-string returns character
      187   (input p-mjd-diff as decimal
      188   )
      189   :
      190     define variable v-day-number as integer   no-undo .
      191     define variable v-seconds    as integer   no-undo .
      192     define variable v-hour       as integer   no-undo .
      193     define variable v-min        as integer   no-undo .
      194     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      195     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      196     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      197     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      198     if p-mjd-diff < 0
      199     or p-mjd-diff = ?
      200     then do:
      201       return "?" .
      202     end.
      203     assign
      204       v-day-number = integer(truncate(p-mjd-diff,0))
      205       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207     if v-seconds > 86400
      208     then do:
      209       assign
      210         v-seconds = 86400 - 1
      211       .
      212     end.
      213     if v-seconds < 0
      214     then do:
      215       assign
      216         v-seconds = 0
      217       .
      218     end.
      219     assign
      220       v-hour = truncate(v-seconds / 3600, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 3600
      224     .
      225     assign
      226       v-min = truncate(v-seconds / 60, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 60
      230     .
      231     return
      232         (if v-day-number <> 0
      233           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0
      237           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      241           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      242           else ""
      243         )
      244       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      245       .
      246   end.
      247   function cur-time-string returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      256   end.
      257   function cur-time-string-sec returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      266   end.
      267   function cur-time-custom  returns character
      268   (input p-prefix as character
      269   ,input p-date-format as character
      270   ,input p-delimiter as character
      271   ,input p-time-format as character
      272   ,input p-suffix as character
      273   )
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return
      282       p-prefix
      283       + string(v-date, p-date-format)
      284       + p-delimiter
      285       + string(v-time, p-time-format)
      286       + p-suffix
      287       .
      288   end.
      289   function cur-time-print  returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-datetime returns datetime
      300   :
      301     define variable v-char as character no-undo .
      302     define variable v-datetime as datetime no-undo .
      303     v-char = cur-time-string().
      304     v-datetime = datetime(v-char).
      305     return  v-datetime.
      306   end.
      307   function cur-time-string-msec returns character
      308   :
      309     define variable v-date as datetime  no-undo .
      310     v-date = now.
      311     return string(v-date) .
      312   end.
      313   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      314   procedure gen-key-rec :
      315     define input  parameter p-tbl-name    as character no-undo.
      316     define input  parameter p-bh_tbl-name as handle    no-undo.
      317     define output parameter p-key-rec     as character no-undo.
      318     do
      319     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      320     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      321     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      322     :
      323       define variable fh               as handle    no-undo .
      324       define variable v-ok             as logical   no-undo .
      325       define variable v-inform         as character no-undo .
      326       define variable v-ind            as integer   no-undo .
      327       define variable v-idx-field-qnty as integer   no-undo .
      328       if p-tbl-name = ?
      329         or p-tbl-name = "":U
      330       then do:
      331         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      332       end.
      333       if not p-bh_tbl-name:available then do:
      334         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      335       end.
      336       assign
      337         p-key-rec = p-tbl-name
      338         v-inform  = p-bh_tbl-name:index-information(1)
      339         v-ind     = 2
      340       .
      341       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      342       on error undo, return error
      343       :
      344         assign
      345           v-inform = p-bh_tbl-name:index-information( v-ind )
      346           v-ind    = v-ind + 1
      347         .
      348       end.
      349       if v-inform = ?
      350         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      351         or entry( 3, v-inform, ",":U ) <> "1":U
      352       then do:
      353         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      354       end.
      355       else do:
      356         assign
      357           v-idx-field-qnty = num-entries( v-inform ) - 4
      358         .
      359         if v-idx-field-qnty < 2 then do:
      360           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      361         end.
      362         do v-ind = 1 to v-idx-field-qnty by 2
      363         on error undo, return error
      364         :
      365           assign
      366             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      367             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      368           .
      369         end.
      370       end.
      371       if p-key-rec = ? then do:
      372         assign
      373           p-key-rec = "":U
      374         .
      375         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      376       end.
      377     end.
      378     return.
      379   end procedure.
      380   procedure gen-where-keyr-tab :
      381     define input  parameter i-tableSerach as character no-undo.
      382     define input  parameter i-tablekey   as character  no-undo.
      383     define input  parameter p-key-rec    as character  no-undo.
      384     define input  parameter p-key-handle as handle     no-undo .
      385     define input  parameter p-db-name    as character  no-undo .
      386     define input  parameter p-tt-handle  as handle     no-undo .
      387     define output parameter o-Where      as character  no-undo.
      388     do
      389     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      390     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      391     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      392     :
      393       define variable v-full-tbl-name  as character no-undo .
      394       define variable bh_tbl-name      as handle    no-undo .
      395       define variable fh_key           as handle    no-undo .
      396       define variable fh_search        as handle    no-undo .
      397       define variable v-field-num      as integer   no-undo .
      398       define variable v-count-fld      as integer   no-undo .
      399       define variable v-inform         as character no-undo .
      400       define variable v-ind            as integer   no-undo .
      401       define variable v-idx-field-qnty as integer   no-undo .
      402       define variable v-field-name     as character no-undo .
      403       define variable v-field-val      as character no-undo .
      404       define variable v-word-link      as character no-undo .
      405       define variable vTable           as character no-undo.
      406       define variable bh_tbl-key       as handle    no-undo .
      407       assign
      408         p-key-rec = trim( p-key-rec )
      409       .
      410       if p-key-handle <> ? then do:
      411         if not valid-handle(p-key-handle)
      412            or p-key-handle:type <> "buffer"
      413         then do:
      414           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      415         end.
      416         if num-entries( p-key-rec, chr(3) ) > 1
      417           or p-key-rec = ?
      418           or p-key-rec = "":U
      419         then do:
      420           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      421         end.
      422       end.
      423       else do:
      424         if p-key-rec = ?
      425           or p-key-rec = "":U
      426         then do:
      427           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      428         end.
      429       end.
      430       assign
      431         vTable = entry( 1 , p-key-rec, chr(3) )
      432       .
      433       if p-tt-handle <> ?
      434         and ( not valid-handle(p-tt-handle)
      435               or p-tt-handle:type <> "buffer"
      436             )
      437       then do:
      438         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      439       end.
      440       if p-tt-handle = ? then do:
      441         assign
      442           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      443         .
      444         create buffer bh_tbl-name for table v-full-tbl-name .
      445       end.
      446       else do:
      447         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      448       end.
      449       assign
      450         v-inform = bh_tbl-name:index-information(1)
      451         v-ind    = 2
      452       .
      453       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      454       on error undo, return error
      455       :
      456         assign
      457           v-inform = bh_tbl-name:index-information( v-ind )
      458           v-ind    = v-ind + 1
      459         .
      460       end.
      461       if v-inform = ?
      462         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      463         or entry( 3, v-inform, ",":U ) <> "1":U
      464       then do:
      465         delete object bh_tbl-name no-error.
      466         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      467       end.
      468       assign
      469         v-idx-field-qnty = num-entries( v-inform ) - 4
      470       .
      471       if v-idx-field-qnty < 2 then do:
      472         delete object bh_tbl-name no-error.
      473         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      474       end.
      475       assign
      476         o-where     = "where":U
      477         v-word-link = "":U
      478         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      479         v-count-fld = 0
      480       .
      481       if i-tablekey ne "" and i-tablekey ne ?
      482       then do:
      483         assign
      484           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      485         .
      486         create buffer bh_tbl-key for table v-full-tbl-name .
      487       end.
      488       if i-tableSerach ne "" and i-tableSerach ne ?
      489       then do:
      490         delete object bh_tbl-name no-error.
      491         assign
      492           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      493         .
      494         create buffer bh_tbl-name for table v-full-tbl-name .
      495       end.
      496       block_where:
      497       do v-ind = 1 to v-idx-field-qnty by 2
      498       on error undo, return error
      499       :
      500         assign
      501           v-count-fld = v-count-fld + 1
      502         .
      503         if p-key-handle = ?
      504           and v-count-fld > v-field-num
      505         then do:
      506           leave block_where.
      507         end.
      508         define variable VfieldKeyTable as handle no-undo.
      509         assign
      510           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      511           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      512         .
      513         if     bh_tbl-key ne ?
      514         then do:
      515            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      516            if VfieldKeyTable eq ?
      517            then next block_where.
      518         end.
      519         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      520         then
      521            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      522         else
      523            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      524         if p-key-handle = ? then do:
      525           assign
      526             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      527           .
      528         end.
      529         else do:
      530           assign
      531             fh_key = p-key-handle:buffer-field( v-field-name )
      532           .
      533           if fh_key = ?
      534             or not valid-handle( fh_key )
      535           then do:
      536             delete object bh_tbl-name.
      537             if     bh_tbl-key ne ?
      538             then
      539                delete object bh_tbl-key.
      540             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      541           end.
      542           assign
      543             v-field-val = fh_key:buffer-value
      544           .
      545         end.
      546         if fh_search:data-type ="character":U then do:
      547           assign
      548             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      549             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      550             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      551             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      552             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      553             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      554             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      555             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      556             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      557             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      558             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      559             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      560             v-field-val = substitute( '"&1"', v-field-val )
      561           .
      562         end.
      563         assign
      564           o-where = substitute( "&1 &2", o-where, v-field-val )
      565         .
      566         if v-word-link = "":U then do:
      567           assign
      568             v-word-link = "and":U
      569           .
      570         end.
      571       end.
      572       delete object bh_tbl-name.
      573       if     bh_tbl-key ne ?
      574       then
      575          delete object bh_tbl-key.
      576       if p-key-handle = ?
      577         and v-count-fld <> v-field-num
      578       then do:
      579         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      580       end.
      581     end.
      582   end procedure.
      583   procedure gen-hn-keyr-tab :
      584     define input  parameter i-tableSerach as character no-undo.
      585     define input  parameter i-tablekey   as character no-undo.
      586     define input  parameter p-key-rec    as character no-undo.
      587     define input  parameter p-key-handle as handle    no-undo .
      588     define input  parameter p-db-name    as character no-undo .
      589     define input  parameter p-tt-handle  as handle    no-undo .
      590     define input  parameter p-stts-lock  as integer   no-undo .
      591     define output parameter o-hn         as handle    no-undo.
      592     define variable v-full-tbl-name as character no-undo.
      593     define variable v-where         as character no-undo.
      594     define variable bh_tbl-name     as handle    no-undo.
      595     define variable vTable          as character no-undo.
      596     do
      597     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      598     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      599     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      600         run gen-where-keyr-tab(i-tableSerach,
      601                                i-tablekey,
      602                                p-key-rec,
      603                                p-key-handle,
      604                                p-db-name,
      605                                p-tt-handle,
      606                                output v-where).
      607         if i-tableSerach ne "" and i-tableSerach ne ?
      608         then do:
      609            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      610            create buffer bh_tbl-name for table v-full-tbl-name .
      611         end.
      612         else do:
      613            if p-tt-handle = ? then do:
      614               assign
      615                  vTable = entry( 1 , p-key-rec, chr(3) )
      616               .
      617               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      618               create buffer bh_tbl-name for table v-full-tbl-name .
      619            end.
      620            else do:
      621               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      622            end.
      623         end.
      624         if p-tt-handle = ? then do:
      625            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      626         end.
      627         else do:
      628            bh_tbl-name:find-first( v-where ) no-error .
      629         end.
      630         o-hn = bh_tbl-name.
      631      end.
      632   end procedure.
      633   procedure gen-hn-keyr :
      634     define input  parameter p-key-rec    as character no-undo.
      635     define input  parameter p-key-handle as handle    no-undo .
      636     define input  parameter p-db-name    as character no-undo .
      637     define input  parameter p-tt-handle  as handle    no-undo .
      638     define input  parameter p-stts-lock  as integer   no-undo .
      639     define output parameter o-hn         as handle    no-undo.
      640     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      641   end.
      642   procedure gen-row-keyr :
      643     define input  parameter p-key-rec    as character no-undo.
      644     define input  parameter p-key-handle as handle    no-undo .
      645     define input  parameter p-db-name    as character no-undo .
      646     define input  parameter p-tt-handle  as handle    no-undo .
      647     define input  parameter p-stts-lock  as integer   no-undo .
      648     define output parameter p-tbl-row    as rowid     no-undo.
      649     define output parameter p-tbl-name   as character no-undo.
      650     define variable vHn as handle no-undo.
      651       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      652       p-tbl-row = if vHn:available then vHn:rowid else ?.
      653       p-tbl-name =  vHn:table.
      654       delete object vHn no-error.
      655     if p-tbl-row = ? then do:
      656       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      657     end.
      658     else do:
      659       return.
      660     end.
      661   end procedure.
      662   procedure gen-key-fv :
      663     define input  parameter p-key-rec    as character no-undo .
      664     define output parameter p-field-list as character no-undo .
      665     define output parameter p-value-list as character no-undo.
      666     do
      667     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      668     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      669     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      670     :
      671       define variable v-full-tbl-name  as character no-undo .
      672       define variable bh_tbl-name      as handle    no-undo .
      673       define variable v-tbl-name       as character no-undo .
      674       define variable v-field-num      as integer   no-undo .
      675       define variable v-count-fld      as integer   no-undo .
      676       define variable v-inform         as character no-undo .
      677       define variable v-ind            as integer   no-undo .
      678       define variable v-idx-field-qnty as integer   no-undo .
      679       define variable v-delim-key      as character no-undo .
      680       if p-key-rec = ?
      681         or p-key-rec = "":U
      682       then do:
      683         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      684       end.
      685       assign
      686         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      687         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      688       .
      689       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      690       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      691       assign
      692         v-inform = bh_tbl-name:index-information(1)
      693         v-ind    = 2
      694       .
      695       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      696       on error undo, return error
      697       :
      698         assign
      699           v-inform = bh_tbl-name:index-information( v-ind )
      700           v-ind    = v-ind + 1
      701         .
      702       end.
      703       if v-inform = ?
      704         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      705         or entry( 3, v-inform, ",":U ) <> "1":U
      706       then do:
      707         delete object bh_tbl-name no-error.
      708         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      709       end.
      710       assign
      711         v-idx-field-qnty = num-entries( v-inform ) - 4
      712       .
      713       if v-idx-field-qnty < 2 then do:
      714         delete object bh_tbl-name no-error.
      715         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      716       end.
      717       assign
      718         p-field-list = "":U
      719         p-value-list = "":U
      720         v-delim-key  = "":U
      721         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      722         v-count-fld  = 0
      723       .
      724       block_where:
      725       do v-ind = 1 to v-idx-field-qnty by 2
      726       on error undo, return error
      727       :
      728         assign
      729           v-count-fld = v-count-fld + 1
      730         .
      731         if v-count-fld > v-field-num then do:
      732           leave block_where.
      733         end.
      734         assign
      735           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      736           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      737         .
      738         if v-ind = 1 then do:
      739           assign
      740             v-delim-key = chr(3)
      741           .
      742         end.
      743       end.
      744       delete object bh_tbl-name.
      745       if v-count-fld <> v-field-num then do:
      746         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      747       end.
      748     end.
      749   end procedure.
      750   procedure gen-key-field :
      751     define input  parameter p-table      as character no-undo .
      752     define output parameter p-field-list as character no-undo .
      753     do
      754     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      755     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      756     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      757     :
      758       define variable v-full-tbl-name  as character no-undo .
      759       define variable bh_tbl-name      as handle    no-undo .
      760       define variable v-tbl-name       as character no-undo .
      761       define variable v-field-num      as integer   no-undo .
      762       define variable v-count-fld      as integer   no-undo .
      763       define variable v-inform         as character no-undo .
      764       define variable v-ind            as integer   no-undo .
      765       define variable v-idx-field-qnty as integer   no-undo .
      766       define variable v-delim-key      as character no-undo .
      767       if p-table = ?
      768         or p-table = "":U
      769       then do:
      770         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      771       end.
      772       assign
      773         v-tbl-name      = p-table
      774         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      775       .
      776       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      777       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      778       assign
      779         v-inform = bh_tbl-name:index-information(1)
      780         v-ind    = 2
      781       .
      782       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      783       on error undo, return error
      784       :
      785         assign
      786           v-inform = bh_tbl-name:index-information( v-ind )
      787           v-ind    = v-ind + 1
      788         .
      789       end.
      790       if v-inform = ?
      791         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      792         or entry( 3, v-inform, ",":U ) <> "1":U
      793       then do:
      794         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      795       end.
      796       assign
      797         v-idx-field-qnty = num-entries( v-inform ) - 4
      798       .
      799       if v-idx-field-qnty < 2 then do:
      800         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      801       end.
      802       assign
      803         p-field-list = "":U
      804         v-delim-key  = "":U
      805         v-count-fld  = 0
      806       .
      807       block_where:
      808       do v-ind = 1 to v-idx-field-qnty by 2
      809       on error undo, return error
      810       :
      811         assign
      812           v-count-fld = v-count-fld + 1
      813         .
      814         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      815         if v-ind = 1 then do:
      816           assign
      817             v-delim-key = chr(3)
      818           .
      819         end.
      820       end.
      821       delete object bh_tbl-name.
      822     end.
      823   end procedure.
      824   define variable v-date as date no-undo .
      825   define variable v-time as integer no-undo .
      826   define variable v-field-list as character no-undo .
      827   define variable v-value-list as character no-undo .
      828   define variable v-host-code as integer no-undo .
      829   define buffer buf_c-rule-call-param for ub.c-rule-call-param.
      830   define buffer buf_c-dis-card-type for ub.c-dis-card-type.
      831   define buffer buf_c-thbj-attr for ub.c-thbj-attr.
      832   define buffer buf_c-cli-hist for ub.c-cli-hist.
      833   main-block:
      834   do
      835   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      836   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      837   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      838   :
      839     if (not g#news
      840     or g#db-num <> 0 )
      841     and not ub.rule-call-param.call_id begins ('layout-elem-rule':U + chr(3))
      842     then do:
      843       run cur-time in this-procedure ( output v-date, output v-time).
      844       create buf_c-rule-call-param.
      845       buffer-copy ub.rule-call-param to buf_c-rule-call-param
      846       assign
      847       buf_c-rule-call-param.codex_id = ub.rule-call-param.codex_id
      848       buf_c-rule-call-param.ruleset_id = ub.rule-call-param.ruleset_id
      849       buf_c-rule-call-param.call_id = ub.rule-call-param.call_id
      850       buf_c-rule-call-param.call#_id = ub.rule-call-param.call#_id
      851       buf_c-rule-call-param.order_id = ub.rule-call-param.order_id
      852       buf_c-rule-call-param.param-name = ub.rule-call-param.param-name
      853       buf_c-rule-call-param.p-index = ub.rule-call-param.p-index
      854       buf_c-rule-call-param.corr-time          = v-time
      855       buf_c-rule-call-param.corr-user-db-num   = g#db-num
      856       buf_c-rule-call-param.corr-user-name     = (if g#news
      857                                       then (chr(4) +  'СПН':U)
      858                                       else g#userid)
      859       buf_c-rule-call-param.corr-date          = v-date
      860       .
      861       run  gen-key-fv in this-procedure (
      862                                           input ub.rule-call-param.call_id
      863                                           ,output v-field-list
      864                                           ,output v-value-list).
      865       if ub.rule-call-param.call_id begins 'dis-card-type':U then do:
      866         create buf_c-dis-card-type.
      867         buffer-copy buf_c-rule-call-param
      868         except chip-num
      869         to buf_c-dis-card-type
      870         assign
      871         buf_c-dis-card-type.chip-num = next-value (s-dc-chip, ub)
      872         buf_c-rule-call-param.chip-num  = buf_c-dis-card-type.chip-num
      873         buf_c-dis-card-type.uniq-key-rec = buf_c-rule-call-param.call_id
      874         buf_c-dis-card-type.type =  entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      875         buf_c-dis-card-type.emitent-host-code = integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)))
      876         buf_c-dis-card-type.action             = integer('99':U)
      877         buf_c-dis-card-type.subject            = 'rule-call-param':U
      878         .
      879       end.
      880       if ub.rule-call-param.call_id begins 'thbj-attr':U then do:
      881         create buf_c-thbj-attr.
      882         buffer-copy buf_c-rule-call-param
      883         except chip-num
      884         to buf_c-thbj-attr
      885         assign
      886         buf_c-thbj-attr.chip-num = next-value (s-cli-chip, ub)
      887         buf_c-rule-call-param.chip-num  = buf_c-thbj-attr.chip-num
      888         buf_c-thbj-attr.prop-code         = entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3))
      889         buf_c-thbj-attr.upper-prop-code   = entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3))
      890         buf_c-thbj-attr.obj-type          = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      891         buf_c-thbj-attr.obj-code          = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)))
      892         buf_c-thbj-attr.action             = integer('99':U)
      893         buf_c-thbj-attr.subject            = 'rule-call-param':U
      894         .
      895         if buf_c-thbj-attr.obj-type = 'маг':U
      896         or buf_c-thbj-attr.obj-type = 'скл':U then do:
      897   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      899     (input  buf_c-thbj-attr.obj-type
      900     ,input  buf_c-thbj-attr.obj-code
      901     ,output v-host-code
      902     )  .
      903         end.
      904         if buf_c-thbj-attr.obj-type = 'орг':U then do:
      905           assign
      906           v-host-code = buf_c-thbj-attr.obj-code.
      907         end.
      908         create buf_c-cli-hist.
      909         buffer-copy buf_c-thbj-attr to buf_c-cli-hist
      910         assign
      911         buf_c-cli-hist.action = integer('99':U)
      912         buf_c-cli-hist.subject = 'thbj-attr':U
      913         buf_c-cli-hist.host-code = v-host-code
      914         buf_c-cli-hist.is-news = g#news
      915         buf_c-cli-hist.source-type = (if g#news then 'db':U else "":U)
      916         buf_c-cli-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      917         .
      918       end.
      919       if ub.rule-call-param.call_id begins 'schedule':U then do:
      920         buf_c-rule-call-param.chip-num = next-value(s-ref-corr-chip, ub).
      921       end.
      922     end.
      923     if g#oxml = yes
      924     then do:
      925       run str/calloxml.p (
      926             input 'delete':U
      927           , input 'rule-call-param':U
      928           , input ( buffer ub.rule-call-param:handle )
      929       ) no-error.
      930       if error-status :error
      931       then do:
      932           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      933                                , chr(10)
      934                                , vss-workfile
      935                                , return-value
      936                                , error-status :get-message ( 1 ) ).
      937       end.
      938     end.
      939   end.
