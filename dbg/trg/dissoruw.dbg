        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.dis-some-rule old old_dis-some-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись привязки правила скидки к ресурсу".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&7|&8'
       29                           ,  ub.dis-some-rule.classif-type
       30                           ,  ub.dis-some-rule.resource#_id
       31                           ,  ub.dis-some-rule.host-code
       32                           ,  ub.dis-some-rule.obj-type
       33                           ,  ub.dis-some-rule.obj-code
       34                           ,  ub.dis-some-rule.pos-type
       35                           ,  ub.dis-some-rule.discnt-role
       36                           ,  ub.dis-some-rule.nonunique
       37                           )
       38       .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure cur-time :
       92      define output parameter p-today as date      no-undo .
       93      define output parameter p-time  as integer   no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       define variable v-date1 as date      no-undo .
       98       define variable v-date2 as date      no-undo .
       99       define variable v-time  as integer   no-undo .
      100       assign
      101         v-date1 = today
      102         v-time  = time
      103         v-date2 = today
      104       .
      105       if v-date1 <> v-date2
      106       then do:
      107         assign
      108           v-date1 = today
      109           v-time  = v-time
      110         .
      111       end.
      112       assign
      113         p-today = v-date1
      114         p-time  = v-time
      115       .
      116     end.
      117   end.
      118   function cur-time-date returns character
      119   :
      120     return string(today, '99/99/9999':U) .
      121   end.
      122   function cur-time-mjd returns decimal
      123   :
      124     define variable v-date as date      no-undo .
      125     define variable v-time as integer   no-undo .
      126     run cur-time in this-procedure
      127       (output v-date
      128       ,output v-time
      129       ) .
      130     return integer(v-date) - 2400002 + (v-time / 86400) .
      131   end.
      132   function cur-time-get-ending-index returns integer
      133   (input p-number as integer
      134   )
      135   :
      136     if p-number < 0
      137     or p-number = ?
      138     then do:
      139       return 1 .
      140     end.
      141     define variable v-rest as integer   no-undo .
      142     assign
      143       p-number = p-number modulo 100
      144     .
      145     if p-number < 20
      146     then do:
      147       assign
      148         v-rest = p-number
      149       .
      150     end.
      151     else do:
      152       assign
      153         v-rest = p-number modulo 10
      154       .
      155     end.
      156     case v-rest :
      157       when 1
      158       then do:
      159         return 2 .
      160       end.
      161       when 2 or
      162       when 3 or
      163       when 4
      164       then do:
      165         return 3 .
      166       end.
      167       otherwise do:
      168         return 1 .
      169       end.
      170     end case .
      171   end.
      172   procedure cur-time-mjd-to-date :
      173      define input  parameter i-mjd-diff as decimal no-undo.
      174      define output parameter o-Date     as date    no-undo.
      175      define output parameter o-Time     as integer no-undo.
      176      define variable v-day-number as integer   no-undo .
      177      if    i-mjd-diff < 0
      178         or i-mjd-diff = ?
      179      then do:
      180         return "?" .
      181      end.
      182      assign
      183         v-day-number = truncate(i-mjd-diff,0).
      184         o-Date = date(v-day-number + 2400002).
      185         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      186     .
      187   end.
      188   function cur-time-mjd-to-string returns character
      189   (input p-mjd-diff as decimal
      190   )
      191   :
      192     define variable v-day-number as integer   no-undo .
      193     define variable v-seconds    as integer   no-undo .
      194     define variable v-hour       as integer   no-undo .
      195     define variable v-min        as integer   no-undo .
      196     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      197     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      198     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      199     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      200     if p-mjd-diff < 0
      201     or p-mjd-diff = ?
      202     then do:
      203       return "?" .
      204     end.
      205     assign
      206       v-day-number = integer(truncate(p-mjd-diff,0))
      207       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209     if v-seconds > 86400
      210     then do:
      211       assign
      212         v-seconds = 86400 - 1
      213       .
      214     end.
      215     if v-seconds < 0
      216     then do:
      217       assign
      218         v-seconds = 0
      219       .
      220     end.
      221     assign
      222       v-hour = truncate(v-seconds / 3600, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 3600
      226     .
      227     assign
      228       v-min = truncate(v-seconds / 60, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 60
      232     .
      233     return
      234         (if v-day-number <> 0
      235           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0
      239           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      240           else ""
      241         )
      242       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      243           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      244           else ""
      245         )
      246       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      247       .
      248   end.
      249   function cur-time-string returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      258   end.
      259   function cur-time-string-sec returns character
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      268   end.
      269   function cur-time-custom  returns character
      270   (input p-prefix as character
      271   ,input p-date-format as character
      272   ,input p-delimiter as character
      273   ,input p-time-format as character
      274   ,input p-suffix as character
      275   )
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return
      284       p-prefix
      285       + string(v-date, p-date-format)
      286       + p-delimiter
      287       + string(v-time, p-time-format)
      288       + p-suffix
      289       .
      290   end.
      291   function cur-time-print  returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-datetime returns datetime
      302   :
      303     define variable v-char as character no-undo .
      304     define variable v-datetime as datetime no-undo .
      305     v-char = cur-time-string().
      306     v-datetime = datetime(v-char).
      307     return  v-datetime.
      308   end.
      309   function cur-time-string-msec returns character
      310   :
      311     define variable v-date as datetime  no-undo .
      312     v-date = now.
      313     return string(v-date) .
      314   end.
      315   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   define new global shared variable g#lib-nws as handle no-undo .
      317   define variable v-date as date no-undo .
      318   define variable v-time as integer no-undo .
      319   define variable v-timeplus as integer no-undo .
      320   define variable v-obj-db-num as integer no-undo .
      321   define buffer buf_c-dis-some-rule for ub.c-dis-some-rule.
      322   main-block:
      323   do
      324   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      325   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      326   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      327   :
      328     if not g#news
      329     and g#db-num > 0
      330     and (
      331         ub.dis-some-rule.obj-type  = '':U
      332         or
      333         ub.dis-some-rule.obj-code = 0
      334         or
      335         ub.dis-some-rule.host-code  = 0
      336         ) then do:
      337       message
      338       vss-workfile vss-revision vss-description skip
      339       substitute("Фирма &1 &2&3 Место использ. &4 тип скидки &5&6" +
      340                  "Нельзя изменять запись СКИДОК ПО в УБД"
      341                  ,ub.dis-some-rule.host-code
      342                  ,ub.dis-some-rule.obj-type
      343                  ,ub.dis-some-rule.obj-code
      344                  ,ub.dis-some-rule.pos-type
      345                  ,ub.dis-some-rule.discnt-role
      346                  ,chr(10)
      347                  )
      348       view-as alert-box error .
      349       undo main-block, return error .
      350     end.
      351     if ub.dis-some-rule.obj-type = 'маг':U
      352     or ub.dis-some-rule.obj-type = 'скл':U then do:
      353   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      354   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      355     (input  ub.dis-some-rule.obj-type
      356     ,input  ub.dis-some-rule.obj-code
      357     ,output v-obj-db-num
      358     )  .
      359       if v-obj-db-num <> g#db-num
      360       and g#db-num <> 0 then do:
      361         message
      362         vss-workfile vss-revision vss-description skip
      363         substitute("Фирма &1 &2&3 место использ. &4 тип скидки &5&6" +
      364                   "Нельзя изменять запись СКИДОК в чужой БД"
      365                  ,ub.dis-some-rule.host-code
      366                  ,ub.dis-some-rule.obj-type
      367                  ,ub.dis-some-rule.obj-code
      368                  ,ub.dis-some-rule.pos-type
      369                  ,ub.dis-some-rule.discnt-role
      370                  ,chr(10)
      371                  )
      372         view-as alert-box error .
      373         undo main-block, return error .
      374       end.
      375     end.
      376     run str/callnews.p
      377       ( input 'dis-some-rule':U
      378         ,input (buffer ub.dis-some-rule:handle)
      379       ) .
      380     if g#news then do:
      381       define variable v-send as integer no-undo .
      382       v-send = integer('0':U).
      383   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      385     (input  g#db-num
      386     ,input  'dis-some-rule':U
      387     ,input  0
      388     ,input  '':U
      389     ,input  0
      390     ,input  '':U
      391     ,input  '':U
      392     ,input  '':U
      393     ,input  0
      394     ,input  0
      395     ,input  0
      396     ,input  'nws-to-hist'
      397     ,output v-send
      398     ) no-error .
      399     end.
      400     if not g#news
      401     or v-send >= 0 then do:
      402       run cur-time in this-procedure(output v-date, output v-time).
      403       assign v-timeplus = v-time .
      404       repeat:
      405           find first buf_c-dis-some-rule where buf_c-dis-some-rule.nonunique = ub.dis-some-rule.nonunique + "-" + string(v-timeplus) no-lock no-error .
      406           if avail buf_c-dis-some-rule then v-timeplus = v-timeplus + 1 .
      407           else leave .
      408       end.
      409       DO TRANSACTION :
      410       create buf_c-dis-some-rule.
      411       buffer-copy old_dis-some-rule
      412       except
      413       pos-type
      414       templ-rl-root
      415       host-code
      416       obj-type
      417       obj-code
      418       nonunique
      419       to buf_c-dis-some-rule
      420       assign
      421       buf_c-dis-some-rule.obj-type           = ub.dis-some-rule.obj-type
      422       buf_c-dis-some-rule.obj-code           = ub.dis-some-rule.obj-code
      423       buf_c-dis-some-rule.host-code          = ub.dis-some-rule.host-code
      424       buf_c-dis-some-rule.pos-type           = ub.dis-some-rule.pos-type
      425       buf_c-dis-some-rule.discnt-role        = ub.dis-some-rule.discnt-role
      426       buf_c-dis-some-rule.resource_id        = ub.dis-some-rule.resource_id
      427       buf_c-dis-some-rule.nonunique          = ub.dis-some-rule.nonunique + "-" + string(v-timeplus)
      428       buf_c-dis-some-rule.corr-time          = v-time
      429       buf_c-dis-some-rule.corr-user-db-num   = g#db-num
      430       buf_c-dis-some-rule.corr-user-name     = (if g#news
      431                                                 then (chr(4) +  'СПН':U)
      432                                                 else (if g#esys
      433                                                       then (chr(4) +  'ВС':U)
      434                                                       else g#userid)
      435                                                 )
      436       buf_c-dis-some-rule.corr-date          = v-date
      437       .
      438       END .
      439       CASE buf_c-dis-some-rule.classif-type:
      440       end case.
      441     end.
      442     if g#oxml = yes
      443     then do:
      444       run str/calloxml.p (
      445             input 'update':U
      446           , input 'dis-some-rule':U
      447           , input ( buffer ub.dis-some-rule:handle )
      448       ) no-error.
      449       if error-status :error
      450       then do:
      451           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      452                                , chr(10)
      453                                , vss-workfile
      454                                , return-value
      455                                , error-status :get-message ( 1 ) ).
      456       end.
      457     end.
      458   end.
