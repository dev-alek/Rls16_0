        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.prop-ref OLD old_prop-ref.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись СРЕЗА ДАННЫХ по ОБЪЕКТУ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1'
       29                            , ub.prop-ref.dt-code
       30                            )
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure cur-time :
       85      define output parameter p-today as date      no-undo .
       86      define output parameter p-time  as integer   no-undo .
       87     do
       88     on error undo, return error
       89     :
       90       define variable v-date1 as date      no-undo .
       91       define variable v-date2 as date      no-undo .
       92       define variable v-time  as integer   no-undo .
       93       assign
       94         v-date1 = today
       95         v-time  = time
       96         v-date2 = today
       97       .
       98       if v-date1 <> v-date2
       99       then do:
      100         assign
      101           v-date1 = today
      102           v-time  = v-time
      103         .
      104       end.
      105       assign
      106         p-today = v-date1
      107         p-time  = v-time
      108       .
      109     end.
      110   end.
      111   function cur-time-date returns character
      112   :
      113     return string(today, '99/99/9999':U) .
      114   end.
      115   function cur-time-mjd returns decimal
      116   :
      117     define variable v-date as date      no-undo .
      118     define variable v-time as integer   no-undo .
      119     run cur-time in this-procedure
      120       (output v-date
      121       ,output v-time
      122       ) .
      123     return integer(v-date) - 2400002 + (v-time / 86400) .
      124   end.
      125   function cur-time-get-ending-index returns integer
      126   (input p-number as integer
      127   )
      128   :
      129     if p-number < 0
      130     or p-number = ?
      131     then do:
      132       return 1 .
      133     end.
      134     define variable v-rest as integer   no-undo .
      135     assign
      136       p-number = p-number modulo 100
      137     .
      138     if p-number < 20
      139     then do:
      140       assign
      141         v-rest = p-number
      142       .
      143     end.
      144     else do:
      145       assign
      146         v-rest = p-number modulo 10
      147       .
      148     end.
      149     case v-rest :
      150       when 1
      151       then do:
      152         return 2 .
      153       end.
      154       when 2 or
      155       when 3 or
      156       when 4
      157       then do:
      158         return 3 .
      159       end.
      160       otherwise do:
      161         return 1 .
      162       end.
      163     end case .
      164   end.
      165   procedure cur-time-mjd-to-date :
      166      define input  parameter i-mjd-diff as decimal no-undo.
      167      define output parameter o-Date     as date    no-undo.
      168      define output parameter o-Time     as integer no-undo.
      169      define variable v-day-number as integer   no-undo .
      170      if    i-mjd-diff < 0
      171         or i-mjd-diff = ?
      172      then do:
      173         return "?" .
      174      end.
      175      assign
      176         v-day-number = truncate(i-mjd-diff,0).
      177         o-Date = date(v-day-number + 2400002).
      178         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      179     .
      180   end.
      181   function cur-time-mjd-to-string returns character
      182   (input p-mjd-diff as decimal
      183   )
      184   :
      185     define variable v-day-number as integer   no-undo .
      186     define variable v-seconds    as integer   no-undo .
      187     define variable v-hour       as integer   no-undo .
      188     define variable v-min        as integer   no-undo .
      189     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      190     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      191     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      192     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      193     if p-mjd-diff < 0
      194     or p-mjd-diff = ?
      195     then do:
      196       return "?" .
      197     end.
      198     assign
      199       v-day-number = integer(truncate(p-mjd-diff,0))
      200       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      201     .
      202     if v-seconds > 86400
      203     then do:
      204       assign
      205         v-seconds = 86400 - 1
      206       .
      207     end.
      208     if v-seconds < 0
      209     then do:
      210       assign
      211         v-seconds = 0
      212       .
      213     end.
      214     assign
      215       v-hour = truncate(v-seconds / 3600, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 3600
      219     .
      220     assign
      221       v-min = truncate(v-seconds / 60, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 60
      225     .
      226     return
      227         (if v-day-number <> 0
      228           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0
      232           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      236           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      237           else ""
      238         )
      239       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      240       .
      241   end.
      242   function cur-time-string returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      251   end.
      252   function cur-time-string-sec returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      261   end.
      262   function cur-time-custom  returns character
      263   (input p-prefix as character
      264   ,input p-date-format as character
      265   ,input p-delimiter as character
      266   ,input p-time-format as character
      267   ,input p-suffix as character
      268   )
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return
      277       p-prefix
      278       + string(v-date, p-date-format)
      279       + p-delimiter
      280       + string(v-time, p-time-format)
      281       + p-suffix
      282       .
      283   end.
      284   function cur-time-print  returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-datetime returns datetime
      295   :
      296     define variable v-char as character no-undo .
      297     define variable v-datetime as datetime no-undo .
      298     v-char = cur-time-string().
      299     v-datetime = datetime(v-char).
      300     return  v-datetime.
      301   end.
      302   function cur-time-string-msec returns character
      303   :
      304     define variable v-date as datetime  no-undo .
      305     v-date = now.
      306     return string(v-date) .
      307   end.
      308   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   procedure gen-key-rec :
      310     define input  parameter p-tbl-name    as character no-undo.
      311     define input  parameter p-bh_tbl-name as handle    no-undo.
      312     define output parameter p-key-rec     as character no-undo.
      313     do
      314     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      315     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      316     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      317     :
      318       define variable fh               as handle    no-undo .
      319       define variable v-ok             as logical   no-undo .
      320       define variable v-inform         as character no-undo .
      321       define variable v-ind            as integer   no-undo .
      322       define variable v-idx-field-qnty as integer   no-undo .
      323       if p-tbl-name = ?
      324         or p-tbl-name = "":U
      325       then do:
      326         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      327       end.
      328       if not p-bh_tbl-name:available then do:
      329         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      330       end.
      331       assign
      332         p-key-rec = p-tbl-name
      333         v-inform  = p-bh_tbl-name:index-information(1)
      334         v-ind     = 2
      335       .
      336       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      337       on error undo, return error
      338       :
      339         assign
      340           v-inform = p-bh_tbl-name:index-information( v-ind )
      341           v-ind    = v-ind + 1
      342         .
      343       end.
      344       if v-inform = ?
      345         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      346         or entry( 3, v-inform, ",":U ) <> "1":U
      347       then do:
      348         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      349       end.
      350       else do:
      351         assign
      352           v-idx-field-qnty = num-entries( v-inform ) - 4
      353         .
      354         if v-idx-field-qnty < 2 then do:
      355           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      356         end.
      357         do v-ind = 1 to v-idx-field-qnty by 2
      358         on error undo, return error
      359         :
      360           assign
      361             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      362             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      363           .
      364         end.
      365       end.
      366       if p-key-rec = ? then do:
      367         assign
      368           p-key-rec = "":U
      369         .
      370         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      371       end.
      372     end.
      373     return.
      374   end procedure.
      375   procedure gen-where-keyr-tab :
      376     define input  parameter i-tableSerach as character no-undo.
      377     define input  parameter i-tablekey   as character  no-undo.
      378     define input  parameter p-key-rec    as character  no-undo.
      379     define input  parameter p-key-handle as handle     no-undo .
      380     define input  parameter p-db-name    as character  no-undo .
      381     define input  parameter p-tt-handle  as handle     no-undo .
      382     define output parameter o-Where      as character  no-undo.
      383     do
      384     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      385     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      386     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      387     :
      388       define variable v-full-tbl-name  as character no-undo .
      389       define variable bh_tbl-name      as handle    no-undo .
      390       define variable fh_key           as handle    no-undo .
      391       define variable fh_search        as handle    no-undo .
      392       define variable v-field-num      as integer   no-undo .
      393       define variable v-count-fld      as integer   no-undo .
      394       define variable v-inform         as character no-undo .
      395       define variable v-ind            as integer   no-undo .
      396       define variable v-idx-field-qnty as integer   no-undo .
      397       define variable v-field-name     as character no-undo .
      398       define variable v-field-val      as character no-undo .
      399       define variable v-word-link      as character no-undo .
      400       define variable vTable           as character no-undo.
      401       define variable bh_tbl-key       as handle    no-undo .
      402       assign
      403         p-key-rec = trim( p-key-rec )
      404       .
      405       if p-key-handle <> ? then do:
      406         if not valid-handle(p-key-handle)
      407            or p-key-handle:type <> "buffer"
      408         then do:
      409           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      410         end.
      411         if num-entries( p-key-rec, chr(3) ) > 1
      412           or p-key-rec = ?
      413           or p-key-rec = "":U
      414         then do:
      415           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      416         end.
      417       end.
      418       else do:
      419         if p-key-rec = ?
      420           or p-key-rec = "":U
      421         then do:
      422           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      423         end.
      424       end.
      425       assign
      426         vTable = entry( 1 , p-key-rec, chr(3) )
      427       .
      428       if p-tt-handle <> ?
      429         and ( not valid-handle(p-tt-handle)
      430               or p-tt-handle:type <> "buffer"
      431             )
      432       then do:
      433         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      434       end.
      435       if p-tt-handle = ? then do:
      436         assign
      437           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      438         .
      439         create buffer bh_tbl-name for table v-full-tbl-name .
      440       end.
      441       else do:
      442         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      443       end.
      444       assign
      445         v-inform = bh_tbl-name:index-information(1)
      446         v-ind    = 2
      447       .
      448       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      449       on error undo, return error
      450       :
      451         assign
      452           v-inform = bh_tbl-name:index-information( v-ind )
      453           v-ind    = v-ind + 1
      454         .
      455       end.
      456       if v-inform = ?
      457         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      458         or entry( 3, v-inform, ",":U ) <> "1":U
      459       then do:
      460         delete object bh_tbl-name no-error.
      461         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      462       end.
      463       assign
      464         v-idx-field-qnty = num-entries( v-inform ) - 4
      465       .
      466       if v-idx-field-qnty < 2 then do:
      467         delete object bh_tbl-name no-error.
      468         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      469       end.
      470       assign
      471         o-where     = "where":U
      472         v-word-link = "":U
      473         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      474         v-count-fld = 0
      475       .
      476       if i-tablekey ne "" and i-tablekey ne ?
      477       then do:
      478         assign
      479           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      480         .
      481         create buffer bh_tbl-key for table v-full-tbl-name .
      482       end.
      483       if i-tableSerach ne "" and i-tableSerach ne ?
      484       then do:
      485         delete object bh_tbl-name no-error.
      486         assign
      487           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      488         .
      489         create buffer bh_tbl-name for table v-full-tbl-name .
      490       end.
      491       block_where:
      492       do v-ind = 1 to v-idx-field-qnty by 2
      493       on error undo, return error
      494       :
      495         assign
      496           v-count-fld = v-count-fld + 1
      497         .
      498         if p-key-handle = ?
      499           and v-count-fld > v-field-num
      500         then do:
      501           leave block_where.
      502         end.
      503         define variable VfieldKeyTable as handle no-undo.
      504         assign
      505           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      506           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      507         .
      508         if     bh_tbl-key ne ?
      509         then do:
      510            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      511            if VfieldKeyTable eq ?
      512            then next block_where.
      513         end.
      514         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      515         then
      516            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      517         else
      518            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      519         if p-key-handle = ? then do:
      520           assign
      521             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      522           .
      523         end.
      524         else do:
      525           assign
      526             fh_key = p-key-handle:buffer-field( v-field-name )
      527           .
      528           if fh_key = ?
      529             or not valid-handle( fh_key )
      530           then do:
      531             delete object bh_tbl-name.
      532             if     bh_tbl-key ne ?
      533             then
      534                delete object bh_tbl-key.
      535             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      536           end.
      537           assign
      538             v-field-val = fh_key:buffer-value
      539           .
      540         end.
      541         if fh_search:data-type ="character":U then do:
      542           assign
      543             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      544             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      545             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      546             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      547             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      548             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      549             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      550             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      551             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      552             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      553             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      554             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      555             v-field-val = substitute( '"&1"', v-field-val )
      556           .
      557         end.
      558         assign
      559           o-where = substitute( "&1 &2", o-where, v-field-val )
      560         .
      561         if v-word-link = "":U then do:
      562           assign
      563             v-word-link = "and":U
      564           .
      565         end.
      566       end.
      567       delete object bh_tbl-name.
      568       if     bh_tbl-key ne ?
      569       then
      570          delete object bh_tbl-key.
      571       if p-key-handle = ?
      572         and v-count-fld <> v-field-num
      573       then do:
      574         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      575       end.
      576     end.
      577   end procedure.
      578   procedure gen-hn-keyr-tab :
      579     define input  parameter i-tableSerach as character no-undo.
      580     define input  parameter i-tablekey   as character no-undo.
      581     define input  parameter p-key-rec    as character no-undo.
      582     define input  parameter p-key-handle as handle    no-undo .
      583     define input  parameter p-db-name    as character no-undo .
      584     define input  parameter p-tt-handle  as handle    no-undo .
      585     define input  parameter p-stts-lock  as integer   no-undo .
      586     define output parameter o-hn         as handle    no-undo.
      587     define variable v-full-tbl-name as character no-undo.
      588     define variable v-where         as character no-undo.
      589     define variable bh_tbl-name     as handle    no-undo.
      590     define variable vTable          as character no-undo.
      591     do
      592     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      593     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      594     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      595         run gen-where-keyr-tab(i-tableSerach,
      596                                i-tablekey,
      597                                p-key-rec,
      598                                p-key-handle,
      599                                p-db-name,
      600                                p-tt-handle,
      601                                output v-where).
      602         if i-tableSerach ne "" and i-tableSerach ne ?
      603         then do:
      604            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      605            create buffer bh_tbl-name for table v-full-tbl-name .
      606         end.
      607         else do:
      608            if p-tt-handle = ? then do:
      609               assign
      610                  vTable = entry( 1 , p-key-rec, chr(3) )
      611               .
      612               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      613               create buffer bh_tbl-name for table v-full-tbl-name .
      614            end.
      615            else do:
      616               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      617            end.
      618         end.
      619         if p-tt-handle = ? then do:
      620            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      621         end.
      622         else do:
      623            bh_tbl-name:find-first( v-where ) no-error .
      624         end.
      625         o-hn = bh_tbl-name.
      626      end.
      627   end procedure.
      628   procedure gen-hn-keyr :
      629     define input  parameter p-key-rec    as character no-undo.
      630     define input  parameter p-key-handle as handle    no-undo .
      631     define input  parameter p-db-name    as character no-undo .
      632     define input  parameter p-tt-handle  as handle    no-undo .
      633     define input  parameter p-stts-lock  as integer   no-undo .
      634     define output parameter o-hn         as handle    no-undo.
      635     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      636   end.
      637   procedure gen-row-keyr :
      638     define input  parameter p-key-rec    as character no-undo.
      639     define input  parameter p-key-handle as handle    no-undo .
      640     define input  parameter p-db-name    as character no-undo .
      641     define input  parameter p-tt-handle  as handle    no-undo .
      642     define input  parameter p-stts-lock  as integer   no-undo .
      643     define output parameter p-tbl-row    as rowid     no-undo.
      644     define output parameter p-tbl-name   as character no-undo.
      645     define variable vHn as handle no-undo.
      646       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      647       p-tbl-row = if vHn:available then vHn:rowid else ?.
      648       p-tbl-name =  vHn:table.
      649       delete object vHn no-error.
      650     if p-tbl-row = ? then do:
      651       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      652     end.
      653     else do:
      654       return.
      655     end.
      656   end procedure.
      657   procedure gen-key-fv :
      658     define input  parameter p-key-rec    as character no-undo .
      659     define output parameter p-field-list as character no-undo .
      660     define output parameter p-value-list as character no-undo.
      661     do
      662     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      663     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      664     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      665     :
      666       define variable v-full-tbl-name  as character no-undo .
      667       define variable bh_tbl-name      as handle    no-undo .
      668       define variable v-tbl-name       as character no-undo .
      669       define variable v-field-num      as integer   no-undo .
      670       define variable v-count-fld      as integer   no-undo .
      671       define variable v-inform         as character no-undo .
      672       define variable v-ind            as integer   no-undo .
      673       define variable v-idx-field-qnty as integer   no-undo .
      674       define variable v-delim-key      as character no-undo .
      675       if p-key-rec = ?
      676         or p-key-rec = "":U
      677       then do:
      678         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      679       end.
      680       assign
      681         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      682         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      683       .
      684       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      685       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      686       assign
      687         v-inform = bh_tbl-name:index-information(1)
      688         v-ind    = 2
      689       .
      690       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      691       on error undo, return error
      692       :
      693         assign
      694           v-inform = bh_tbl-name:index-information( v-ind )
      695           v-ind    = v-ind + 1
      696         .
      697       end.
      698       if v-inform = ?
      699         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      700         or entry( 3, v-inform, ",":U ) <> "1":U
      701       then do:
      702         delete object bh_tbl-name no-error.
      703         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      704       end.
      705       assign
      706         v-idx-field-qnty = num-entries( v-inform ) - 4
      707       .
      708       if v-idx-field-qnty < 2 then do:
      709         delete object bh_tbl-name no-error.
      710         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      711       end.
      712       assign
      713         p-field-list = "":U
      714         p-value-list = "":U
      715         v-delim-key  = "":U
      716         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      717         v-count-fld  = 0
      718       .
      719       block_where:
      720       do v-ind = 1 to v-idx-field-qnty by 2
      721       on error undo, return error
      722       :
      723         assign
      724           v-count-fld = v-count-fld + 1
      725         .
      726         if v-count-fld > v-field-num then do:
      727           leave block_where.
      728         end.
      729         assign
      730           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      731           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      732         .
      733         if v-ind = 1 then do:
      734           assign
      735             v-delim-key = chr(3)
      736           .
      737         end.
      738       end.
      739       delete object bh_tbl-name.
      740       if v-count-fld <> v-field-num then do:
      741         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      742       end.
      743     end.
      744   end procedure.
      745   procedure gen-key-field :
      746     define input  parameter p-table      as character no-undo .
      747     define output parameter p-field-list as character no-undo .
      748     do
      749     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      750     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      751     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      752     :
      753       define variable v-full-tbl-name  as character no-undo .
      754       define variable bh_tbl-name      as handle    no-undo .
      755       define variable v-tbl-name       as character no-undo .
      756       define variable v-field-num      as integer   no-undo .
      757       define variable v-count-fld      as integer   no-undo .
      758       define variable v-inform         as character no-undo .
      759       define variable v-ind            as integer   no-undo .
      760       define variable v-idx-field-qnty as integer   no-undo .
      761       define variable v-delim-key      as character no-undo .
      762       if p-table = ?
      763         or p-table = "":U
      764       then do:
      765         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      766       end.
      767       assign
      768         v-tbl-name      = p-table
      769         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      770       .
      771       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      772       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      773       assign
      774         v-inform = bh_tbl-name:index-information(1)
      775         v-ind    = 2
      776       .
      777       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      778       on error undo, return error
      779       :
      780         assign
      781           v-inform = bh_tbl-name:index-information( v-ind )
      782           v-ind    = v-ind + 1
      783         .
      784       end.
      785       if v-inform = ?
      786         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      787         or entry( 3, v-inform, ",":U ) <> "1":U
      788       then do:
      789         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      790       end.
      791       assign
      792         v-idx-field-qnty = num-entries( v-inform ) - 4
      793       .
      794       if v-idx-field-qnty < 2 then do:
      795         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      796       end.
      797       assign
      798         p-field-list = "":U
      799         v-delim-key  = "":U
      800         v-count-fld  = 0
      801       .
      802       block_where:
      803       do v-ind = 1 to v-idx-field-qnty by 2
      804       on error undo, return error
      805       :
      806         assign
      807           v-count-fld = v-count-fld + 1
      808         .
      809         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      810         if v-ind = 1 then do:
      811           assign
      812             v-delim-key = chr(3)
      813           .
      814         end.
      815       end.
      816       delete object bh_tbl-name.
      817     end.
      818   end procedure.
      819   define variable v-date as date no-undo .
      820   define variable v-time as integer no-undo .
      821   define variable v-uniq-key-rec as character no-undo .
      822   define variable v-confirmed as logical   no-undo .
      823   define variable level as integer   no-undo .
      824   define variable v-p as character no-undo .
      825   define buffer buf_ruledict for ub.ruledict.
      826   define buffer buf_c-prop-ref for ub.c-prop-ref.
      827   define buffer buf_c-prop-head for ub.c-prop-head.
      828   define buffer first_ruledict for ub.ruledict.
      829   define buffer last_ruledict for ub.ruledict.
      830   main-block:
      831   do
      832   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      833   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      834   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      835   :
      836     if not g#news
      837     then do:
      838       run gen-key-rec in this-procedure (
      839                                           input 'prop-ref':U
      840                                           ,input  buffer ub.prop-ref:handle
      841                                           ,output v-uniq-key-rec
      842                                           ).
      843       assign
      844       ub.prop-ref.uniq-key-rec = v-uniq-key-rec
      845       .
      846       assign
      847         level = 2
      848       .
      849       _repeat:
      850       repeat while program-name( level ) <> ? :
      851         v-p = program-name( level ).
      852         if index(v-p, "fixrum.") > 0
      853         then do:
      854           v-confirmed = yes.
      855           leave _repeat.
      856         end.
      857         assign
      858           level = level + 1
      859         .
      860       end.
      861       if not v-confirmed then do:
      862         find first buf_ruledict where
      863                   buf_ruledict.entry-type  = 'sum-id':U
      864               and buf_ruledict.uniq-key-rec  = v-uniq-key-rec no-error.
      865         if not available buf_ruledict then do:
      866           find first first_ruledict exclusive-lock use-index pi.
      867           find first last_ruledict no-lock where last_ruledict.entry-id <= 0 use-index pi no-error.
      868           create buf_ruledict.
      869           assign
      870           buf_ruledict.entry-type = 'sum-id':U
      871           buf_ruledict.uniq-key-rec = v-uniq-key-rec
      872           buf_ruledict.entry-id = (if available last_ruledict
      873                                   then last_ruledict.entry-id - 1
      874                                   else -1)
      875           buf_ruledict.language = "ABL"
      876           .
      877         end.
      878         assign
      879         buf_ruledict.script-al = string(ub.prop-ref.dt-code)
      880         buf_ruledict.script-nl = ub.prop-ref.sum-id
      881         .
      882       end.
      883     end.
      884     if not g#news
      885     or g#db-num > 0 then do:
      886       run cur-time in this-procedure(output v-date, output v-time).
      887       create buf_c-prop-ref.
      888       buffer-copy old_prop-ref to buf_c-prop-ref
      889       assign
      890       buf_c-prop-ref.dt-code            = ub.prop-ref.dt-code
      891       buf_c-prop-ref.chip-num           = next-value (s-ref-corr-chip, ub)
      892       buf_c-prop-ref.corr-time          = v-time
      893       buf_c-prop-ref.corr-user-db-num   = g#db-num
      894       buf_c-prop-ref.corr-user-name     = g#userid
      895       buf_c-prop-ref.corr-date          = v-date
      896       .
      897       if ub.prop-ref.dtm-code > 0 then do:
      898         create buf_c-prop-head.
      899         buffer-copy buf_c-prop-ref
      900         except uniq-key-rec
      901         to buf_c-prop-head
      902         assign
      903         buf_c-prop-head.action             = integer(if new(ub.prop-ref) then '1':U else '2':U)
      904         buf_C-prop-head.subject            = 'prop-ref':U
      905         .
      906       end.
      907     end.
      908     if not g#news
      909     and g#db-num = 0
      910     then do:
      911       run str/callnews.p
      912         (input 'prop-ref':U
      913         ,input (buffer ub.prop-ref:handle)
      914         ).
      915     end.
      916       if g#oxml = yes
      917       then do:
      918       run str/calloxml.p (
      919             input 'update':U
      920           , input 'prop-ref':U
      921           , input ( buffer ub.prop-ref:handle )
      922       ) no-error.
      923       if error-status :error
      924       then do:
      925           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      926                                , chr(10)
      927                                , vss-workfile
      928                                , return-value
      929                                , error-status :get-message ( 1 ) ).
      930       end.
      931       end.
      932   end.
