        1   block-level on error undo, throw.
        2   trigger procedure for delete of ub.marking-attr.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Тригер удаления marking-attr".
        9   main-block:
       10   do
       11   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       12   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       13   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       14   :
       15     if marking-attr.attr-code = "notOnlineCheck" then
       16     do:
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure cur-time :
       88      define output parameter p-today as date      no-undo .
       89      define output parameter p-time  as integer   no-undo .
       90     do
       91     on error undo, return error
       92     :
       93       define variable v-date1 as date      no-undo .
       94       define variable v-date2 as date      no-undo .
       95       define variable v-time  as integer   no-undo .
       96       assign
       97         v-date1 = today
       98         v-time  = time
       99         v-date2 = today
      100       .
      101       if v-date1 <> v-date2
      102       then do:
      103         assign
      104           v-date1 = today
      105           v-time  = v-time
      106         .
      107       end.
      108       assign
      109         p-today = v-date1
      110         p-time  = v-time
      111       .
      112     end.
      113   end.
      114   function cur-time-date returns character
      115   :
      116     return string(today, '99/99/9999':U) .
      117   end.
      118   function cur-time-mjd returns decimal
      119   :
      120     define variable v-date as date      no-undo .
      121     define variable v-time as integer   no-undo .
      122     run cur-time in this-procedure
      123       (output v-date
      124       ,output v-time
      125       ) .
      126     return integer(v-date) - 2400002 + (v-time / 86400) .
      127   end.
      128   function cur-time-get-ending-index returns integer
      129   (input p-number as integer
      130   )
      131   :
      132     if p-number < 0
      133     or p-number = ?
      134     then do:
      135       return 1 .
      136     end.
      137     define variable v-rest as integer   no-undo .
      138     assign
      139       p-number = p-number modulo 100
      140     .
      141     if p-number < 20
      142     then do:
      143       assign
      144         v-rest = p-number
      145       .
      146     end.
      147     else do:
      148       assign
      149         v-rest = p-number modulo 10
      150       .
      151     end.
      152     case v-rest :
      153       when 1
      154       then do:
      155         return 2 .
      156       end.
      157       when 2 or
      158       when 3 or
      159       when 4
      160       then do:
      161         return 3 .
      162       end.
      163       otherwise do:
      164         return 1 .
      165       end.
      166     end case .
      167   end.
      168   procedure cur-time-mjd-to-date :
      169      define input  parameter i-mjd-diff as decimal no-undo.
      170      define output parameter o-Date     as date    no-undo.
      171      define output parameter o-Time     as integer no-undo.
      172      define variable v-day-number as integer   no-undo .
      173      if    i-mjd-diff < 0
      174         or i-mjd-diff = ?
      175      then do:
      176         return "?" .
      177      end.
      178      assign
      179         v-day-number = truncate(i-mjd-diff,0).
      180         o-Date = date(v-day-number + 2400002).
      181         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      182     .
      183   end.
      184   function cur-time-mjd-to-string returns character
      185   (input p-mjd-diff as decimal
      186   )
      187   :
      188     define variable v-day-number as integer   no-undo .
      189     define variable v-seconds    as integer   no-undo .
      190     define variable v-hour       as integer   no-undo .
      191     define variable v-min        as integer   no-undo .
      192     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      193     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      194     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      195     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      196     if p-mjd-diff < 0
      197     or p-mjd-diff = ?
      198     then do:
      199       return "?" .
      200     end.
      201     assign
      202       v-day-number = integer(truncate(p-mjd-diff,0))
      203       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      204     .
      205     if v-seconds > 86400
      206     then do:
      207       assign
      208         v-seconds = 86400 - 1
      209       .
      210     end.
      211     if v-seconds < 0
      212     then do:
      213       assign
      214         v-seconds = 0
      215       .
      216     end.
      217     assign
      218       v-hour = truncate(v-seconds / 3600, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 3600
      222     .
      223     assign
      224       v-min = truncate(v-seconds / 60, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 60
      228     .
      229     return
      230         (if v-day-number <> 0
      231           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      232           else ""
      233         )
      234       + (if v-day-number <> 0 or v-hour <> 0
      235           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      236           else ""
      237         )
      238       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      239           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      240           else ""
      241         )
      242       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      243       .
      244   end.
      245   function cur-time-string returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      254   end.
      255   function cur-time-string-sec returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      264   end.
      265   function cur-time-custom  returns character
      266   (input p-prefix as character
      267   ,input p-date-format as character
      268   ,input p-delimiter as character
      269   ,input p-time-format as character
      270   ,input p-suffix as character
      271   )
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return
      280       p-prefix
      281       + string(v-date, p-date-format)
      282       + p-delimiter
      283       + string(v-time, p-time-format)
      284       + p-suffix
      285       .
      286   end.
      287   function cur-time-print  returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-datetime returns datetime
      298   :
      299     define variable v-char as character no-undo .
      300     define variable v-datetime as datetime no-undo .
      301     v-char = cur-time-string().
      302     v-datetime = datetime(v-char).
      303     return  v-datetime.
      304   end.
      305   function cur-time-string-msec returns character
      306   :
      307     define variable v-date as datetime  no-undo .
      308     v-date = now.
      309     return string(v-date) .
      310   end.
      311   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   procedure gen-key-rec :
      313     define input  parameter p-tbl-name    as character no-undo.
      314     define input  parameter p-bh_tbl-name as handle    no-undo.
      315     define output parameter p-key-rec     as character no-undo.
      316     do
      317     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      318     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      319     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      320     :
      321       define variable fh               as handle    no-undo .
      322       define variable v-ok             as logical   no-undo .
      323       define variable v-inform         as character no-undo .
      324       define variable v-ind            as integer   no-undo .
      325       define variable v-idx-field-qnty as integer   no-undo .
      326       if p-tbl-name = ?
      327         or p-tbl-name = "":U
      328       then do:
      329         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      330       end.
      331       if not p-bh_tbl-name:available then do:
      332         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      333       end.
      334       assign
      335         p-key-rec = p-tbl-name
      336         v-inform  = p-bh_tbl-name:index-information(1)
      337         v-ind     = 2
      338       .
      339       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      340       on error undo, return error
      341       :
      342         assign
      343           v-inform = p-bh_tbl-name:index-information( v-ind )
      344           v-ind    = v-ind + 1
      345         .
      346       end.
      347       if v-inform = ?
      348         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      349         or entry( 3, v-inform, ",":U ) <> "1":U
      350       then do:
      351         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      352       end.
      353       else do:
      354         assign
      355           v-idx-field-qnty = num-entries( v-inform ) - 4
      356         .
      357         if v-idx-field-qnty < 2 then do:
      358           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      359         end.
      360         do v-ind = 1 to v-idx-field-qnty by 2
      361         on error undo, return error
      362         :
      363           assign
      364             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      365             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      366           .
      367         end.
      368       end.
      369       if p-key-rec = ? then do:
      370         assign
      371           p-key-rec = "":U
      372         .
      373         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      374       end.
      375     end.
      376     return.
      377   end procedure.
      378   procedure gen-where-keyr-tab :
      379     define input  parameter i-tableSerach as character no-undo.
      380     define input  parameter i-tablekey   as character  no-undo.
      381     define input  parameter p-key-rec    as character  no-undo.
      382     define input  parameter p-key-handle as handle     no-undo .
      383     define input  parameter p-db-name    as character  no-undo .
      384     define input  parameter p-tt-handle  as handle     no-undo .
      385     define output parameter o-Where      as character  no-undo.
      386     do
      387     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      388     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      389     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      390     :
      391       define variable v-full-tbl-name  as character no-undo .
      392       define variable bh_tbl-name      as handle    no-undo .
      393       define variable fh_key           as handle    no-undo .
      394       define variable fh_search        as handle    no-undo .
      395       define variable v-field-num      as integer   no-undo .
      396       define variable v-count-fld      as integer   no-undo .
      397       define variable v-inform         as character no-undo .
      398       define variable v-ind            as integer   no-undo .
      399       define variable v-idx-field-qnty as integer   no-undo .
      400       define variable v-field-name     as character no-undo .
      401       define variable v-field-val      as character no-undo .
      402       define variable v-word-link      as character no-undo .
      403       define variable vTable           as character no-undo.
      404       define variable bh_tbl-key       as handle    no-undo .
      405       assign
      406         p-key-rec = trim( p-key-rec )
      407       .
      408       if p-key-handle <> ? then do:
      409         if not valid-handle(p-key-handle)
      410            or p-key-handle:type <> "buffer"
      411         then do:
      412           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      413         end.
      414         if num-entries( p-key-rec, chr(3) ) > 1
      415           or p-key-rec = ?
      416           or p-key-rec = "":U
      417         then do:
      418           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      419         end.
      420       end.
      421       else do:
      422         if p-key-rec = ?
      423           or p-key-rec = "":U
      424         then do:
      425           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      426         end.
      427       end.
      428       assign
      429         vTable = entry( 1 , p-key-rec, chr(3) )
      430       .
      431       if p-tt-handle <> ?
      432         and ( not valid-handle(p-tt-handle)
      433               or p-tt-handle:type <> "buffer"
      434             )
      435       then do:
      436         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      437       end.
      438       if p-tt-handle = ? then do:
      439         assign
      440           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      441         .
      442         create buffer bh_tbl-name for table v-full-tbl-name .
      443       end.
      444       else do:
      445         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      446       end.
      447       assign
      448         v-inform = bh_tbl-name:index-information(1)
      449         v-ind    = 2
      450       .
      451       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      452       on error undo, return error
      453       :
      454         assign
      455           v-inform = bh_tbl-name:index-information( v-ind )
      456           v-ind    = v-ind + 1
      457         .
      458       end.
      459       if v-inform = ?
      460         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      461         or entry( 3, v-inform, ",":U ) <> "1":U
      462       then do:
      463         delete object bh_tbl-name no-error.
      464         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      465       end.
      466       assign
      467         v-idx-field-qnty = num-entries( v-inform ) - 4
      468       .
      469       if v-idx-field-qnty < 2 then do:
      470         delete object bh_tbl-name no-error.
      471         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      472       end.
      473       assign
      474         o-where     = "where":U
      475         v-word-link = "":U
      476         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      477         v-count-fld = 0
      478       .
      479       if i-tablekey ne "" and i-tablekey ne ?
      480       then do:
      481         assign
      482           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      483         .
      484         create buffer bh_tbl-key for table v-full-tbl-name .
      485       end.
      486       if i-tableSerach ne "" and i-tableSerach ne ?
      487       then do:
      488         delete object bh_tbl-name no-error.
      489         assign
      490           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      491         .
      492         create buffer bh_tbl-name for table v-full-tbl-name .
      493       end.
      494       block_where:
      495       do v-ind = 1 to v-idx-field-qnty by 2
      496       on error undo, return error
      497       :
      498         assign
      499           v-count-fld = v-count-fld + 1
      500         .
      501         if p-key-handle = ?
      502           and v-count-fld > v-field-num
      503         then do:
      504           leave block_where.
      505         end.
      506         define variable VfieldKeyTable as handle no-undo.
      507         assign
      508           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      509           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      510         .
      511         if     bh_tbl-key ne ?
      512         then do:
      513            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      514            if VfieldKeyTable eq ?
      515            then next block_where.
      516         end.
      517         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      518         then
      519            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      520         else
      521            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      522         if p-key-handle = ? then do:
      523           assign
      524             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      525           .
      526         end.
      527         else do:
      528           assign
      529             fh_key = p-key-handle:buffer-field( v-field-name )
      530           .
      531           if fh_key = ?
      532             or not valid-handle( fh_key )
      533           then do:
      534             delete object bh_tbl-name.
      535             if     bh_tbl-key ne ?
      536             then
      537                delete object bh_tbl-key.
      538             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      539           end.
      540           assign
      541             v-field-val = fh_key:buffer-value
      542           .
      543         end.
      544         if fh_search:data-type ="character":U then do:
      545           assign
      546             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      547             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      548             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      549             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      550             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      551             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      552             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      553             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      554             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      555             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      556             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      557             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      558             v-field-val = substitute( '"&1"', v-field-val )
      559           .
      560         end.
      561         assign
      562           o-where = substitute( "&1 &2", o-where, v-field-val )
      563         .
      564         if v-word-link = "":U then do:
      565           assign
      566             v-word-link = "and":U
      567           .
      568         end.
      569       end.
      570       delete object bh_tbl-name.
      571       if     bh_tbl-key ne ?
      572       then
      573          delete object bh_tbl-key.
      574       if p-key-handle = ?
      575         and v-count-fld <> v-field-num
      576       then do:
      577         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      578       end.
      579     end.
      580   end procedure.
      581   procedure gen-hn-keyr-tab :
      582     define input  parameter i-tableSerach as character no-undo.
      583     define input  parameter i-tablekey   as character no-undo.
      584     define input  parameter p-key-rec    as character no-undo.
      585     define input  parameter p-key-handle as handle    no-undo .
      586     define input  parameter p-db-name    as character no-undo .
      587     define input  parameter p-tt-handle  as handle    no-undo .
      588     define input  parameter p-stts-lock  as integer   no-undo .
      589     define output parameter o-hn         as handle    no-undo.
      590     define variable v-full-tbl-name as character no-undo.
      591     define variable v-where         as character no-undo.
      592     define variable bh_tbl-name     as handle    no-undo.
      593     define variable vTable          as character no-undo.
      594     do
      595     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      596     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      597     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      598         run gen-where-keyr-tab(i-tableSerach,
      599                                i-tablekey,
      600                                p-key-rec,
      601                                p-key-handle,
      602                                p-db-name,
      603                                p-tt-handle,
      604                                output v-where).
      605         if i-tableSerach ne "" and i-tableSerach ne ?
      606         then do:
      607            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      608            create buffer bh_tbl-name for table v-full-tbl-name .
      609         end.
      610         else do:
      611            if p-tt-handle = ? then do:
      612               assign
      613                  vTable = entry( 1 , p-key-rec, chr(3) )
      614               .
      615               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      616               create buffer bh_tbl-name for table v-full-tbl-name .
      617            end.
      618            else do:
      619               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      620            end.
      621         end.
      622         if p-tt-handle = ? then do:
      623            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      624         end.
      625         else do:
      626            bh_tbl-name:find-first( v-where ) no-error .
      627         end.
      628         o-hn = bh_tbl-name.
      629      end.
      630   end procedure.
      631   procedure gen-hn-keyr :
      632     define input  parameter p-key-rec    as character no-undo.
      633     define input  parameter p-key-handle as handle    no-undo .
      634     define input  parameter p-db-name    as character no-undo .
      635     define input  parameter p-tt-handle  as handle    no-undo .
      636     define input  parameter p-stts-lock  as integer   no-undo .
      637     define output parameter o-hn         as handle    no-undo.
      638     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      639   end.
      640   procedure gen-row-keyr :
      641     define input  parameter p-key-rec    as character no-undo.
      642     define input  parameter p-key-handle as handle    no-undo .
      643     define input  parameter p-db-name    as character no-undo .
      644     define input  parameter p-tt-handle  as handle    no-undo .
      645     define input  parameter p-stts-lock  as integer   no-undo .
      646     define output parameter p-tbl-row    as rowid     no-undo.
      647     define output parameter p-tbl-name   as character no-undo.
      648     define variable vHn as handle no-undo.
      649       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      650       p-tbl-row = if vHn:available then vHn:rowid else ?.
      651       p-tbl-name =  vHn:table.
      652       delete object vHn no-error.
      653     if p-tbl-row = ? then do:
      654       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      655     end.
      656     else do:
      657       return.
      658     end.
      659   end procedure.
      660   procedure gen-key-fv :
      661     define input  parameter p-key-rec    as character no-undo .
      662     define output parameter p-field-list as character no-undo .
      663     define output parameter p-value-list as character no-undo.
      664     do
      665     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      666     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      667     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      668     :
      669       define variable v-full-tbl-name  as character no-undo .
      670       define variable bh_tbl-name      as handle    no-undo .
      671       define variable v-tbl-name       as character no-undo .
      672       define variable v-field-num      as integer   no-undo .
      673       define variable v-count-fld      as integer   no-undo .
      674       define variable v-inform         as character no-undo .
      675       define variable v-ind            as integer   no-undo .
      676       define variable v-idx-field-qnty as integer   no-undo .
      677       define variable v-delim-key      as character no-undo .
      678       if p-key-rec = ?
      679         or p-key-rec = "":U
      680       then do:
      681         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      682       end.
      683       assign
      684         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      685         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      686       .
      687       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      688       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      689       assign
      690         v-inform = bh_tbl-name:index-information(1)
      691         v-ind    = 2
      692       .
      693       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      694       on error undo, return error
      695       :
      696         assign
      697           v-inform = bh_tbl-name:index-information( v-ind )
      698           v-ind    = v-ind + 1
      699         .
      700       end.
      701       if v-inform = ?
      702         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      703         or entry( 3, v-inform, ",":U ) <> "1":U
      704       then do:
      705         delete object bh_tbl-name no-error.
      706         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      707       end.
      708       assign
      709         v-idx-field-qnty = num-entries( v-inform ) - 4
      710       .
      711       if v-idx-field-qnty < 2 then do:
      712         delete object bh_tbl-name no-error.
      713         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      714       end.
      715       assign
      716         p-field-list = "":U
      717         p-value-list = "":U
      718         v-delim-key  = "":U
      719         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      720         v-count-fld  = 0
      721       .
      722       block_where:
      723       do v-ind = 1 to v-idx-field-qnty by 2
      724       on error undo, return error
      725       :
      726         assign
      727           v-count-fld = v-count-fld + 1
      728         .
      729         if v-count-fld > v-field-num then do:
      730           leave block_where.
      731         end.
      732         assign
      733           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      734           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      735         .
      736         if v-ind = 1 then do:
      737           assign
      738             v-delim-key = chr(3)
      739           .
      740         end.
      741       end.
      742       delete object bh_tbl-name.
      743       if v-count-fld <> v-field-num then do:
      744         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      745       end.
      746     end.
      747   end procedure.
      748   procedure gen-key-field :
      749     define input  parameter p-table      as character no-undo .
      750     define output parameter p-field-list as character no-undo .
      751     do
      752     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      753     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      754     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      755     :
      756       define variable v-full-tbl-name  as character no-undo .
      757       define variable bh_tbl-name      as handle    no-undo .
      758       define variable v-tbl-name       as character no-undo .
      759       define variable v-field-num      as integer   no-undo .
      760       define variable v-count-fld      as integer   no-undo .
      761       define variable v-inform         as character no-undo .
      762       define variable v-ind            as integer   no-undo .
      763       define variable v-idx-field-qnty as integer   no-undo .
      764       define variable v-delim-key      as character no-undo .
      765       if p-table = ?
      766         or p-table = "":U
      767       then do:
      768         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      769       end.
      770       assign
      771         v-tbl-name      = p-table
      772         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      773       .
      774       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      775       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      776       assign
      777         v-inform = bh_tbl-name:index-information(1)
      778         v-ind    = 2
      779       .
      780       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      781       on error undo, return error
      782       :
      783         assign
      784           v-inform = bh_tbl-name:index-information( v-ind )
      785           v-ind    = v-ind + 1
      786         .
      787       end.
      788       if v-inform = ?
      789         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      790         or entry( 3, v-inform, ",":U ) <> "1":U
      791       then do:
      792         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      793       end.
      794       assign
      795         v-idx-field-qnty = num-entries( v-inform ) - 4
      796       .
      797       if v-idx-field-qnty < 2 then do:
      798         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      799       end.
      800       assign
      801         p-field-list = "":U
      802         v-delim-key  = "":U
      803         v-count-fld  = 0
      804       .
      805       block_where:
      806       do v-ind = 1 to v-idx-field-qnty by 2
      807       on error undo, return error
      808       :
      809         assign
      810           v-count-fld = v-count-fld + 1
      811         .
      812         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      813         if v-ind = 1 then do:
      814           assign
      815             v-delim-key = chr(3)
      816           .
      817         end.
      818       end.
      819       delete object bh_tbl-name.
      820     end.
      821   end procedure.
      822   define buffer buf_c-marking-attr  for ub.c-marking-attr .
      823   define variable v-date      as date      no-undo .
      824   define variable v-time      as integer   no-undo .
      825   define variable v-field-chg as character no-undo .
      826   define variable v-Seq       as int64     no-undo init ?.
      827   define variable vFlagseq    as logical no-undo.
      828   define variable vuniq-key-rec as character no-undo.
      829   define variable v-rowid as rowid no-undo.
      830   define variable v-tbl-name as character no-undo.
      831       run cur-time in this-procedure (output v-date, output v-time).
      832       publish "getNextseq" ("marking-attr","s-c-mark-attr-chip-num", "ub", output v-Seq ).
      833       if v-Seq = ?
      834       then
      835          v-Seq  = next-value (s-c-mark-attr-chip-num, ub).
      836       else
      837          vFlagSeq = yes.
      838       if vFlagseq
      839       then do:
      840    for first buf_c-marking-attr where buf_c-marking-attr.mark eq marking-attr.mark
      841   and buf_c-marking-attr.attr-code eq marking-attr.attr-code
      842     and buf_c-marking-attr.corr-user-db-num   = g#db-num and buf_c-marking-attr.chip-num = v-Seq exclusive-lock: leave. end.
      843       end.
      844       if not available buf_c-marking-attr
      845       then do:
      846          create buf_c-marking-attr.
      847          buffer-copy ub.marking-attr to buf_c-marking-attr
      848          assign
      849            buf_c-marking-attr.chip-num           = v-Seq
      850            buf_c-marking-attr.corr-date          = v-date
      851            buf_c-marking-attr.corr-time          = v-time
      852            buf_c-marking-attr.corr-user-db-num   = g#db-num
      853            buf_c-marking-attr.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
      854            buf_c-marking-attr.action             = 99
      855            buf_c-marking-attr.is-del             = true
      856          .
      857       end.
      858       else
      859          buf_c-marking-attr.action             = 99.
      860     end.
      861   end.
