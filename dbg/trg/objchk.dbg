      444   procedure check-stop-list :
      445     do
      446     on error undo, return error
      447     :
      448       define buffer buf_stop-list for ub.stop-list .
      449       find first buf_stop-list no-lock
      450         where buf_stop-list.obj-type = p-obj-type
      451           and buf_stop-list.obj-code = p-obj-code
      452           and buf_stop-list.status_ <> 'факт':U
      453         no-error .
      454       if available buf_stop-list then do:
      455         message
      456           "На объекте существуют открытые стоплисты" skip
      457           "Объект" p-obj-type p-obj-code skip
      458           "вид стоплиста" buf_stop-list.classif-type skip
      459           "стоплист" buf_stop-list.stop-list-code skip
      460           view-as alert-box error .
      461         undo, return error .
      462       end.
      463     end.
      464   end procedure.
