      233           and buf_rvs-doc.rvs-type <> 'проверка':U
      234           and buf_rvs-doc.status_ <> 'факт':U
      235         no-error .
      236       if available buf_rvs-doc then do:
      237         message
      238           "На объекте существуют открытые документы сверки" skip
      239           "Объект" p-obj-type p-obj-code skip
      240           "Документ сверки" buf_rvs-doc.rvs-code skip
      241           view-as alert-box error .
      242         undo, return error .
      243       end.
      244     end.
      245   end procedure.
