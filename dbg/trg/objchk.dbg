        1   block-level on error undo, throw.
        2   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter p-action   as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Выполнение различных проверок объекта".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   main-block:
       70   do
       71   on error undo main-block, return error
       72   :
       73     if p-action <> "check-open":u then do:
       74       message
       75         vss-workfile vss-revision vss-description skip
       76         "Ошибка задания входных параметров" skip
       77         "p-action" p-action skip
       78         view-as alert-box error .
       79       undo main-block, return error .
       80     end.
       81     run check-trn-doc   in this-procedure .
       82     run check-price-doc in this-procedure .
       83     run check-ord-doc in this-procedure .
       84     run check-fbr-doc   in this-procedure .
       85     run check-inkas     in this-procedure .
       86     run check-rvs-doc   in this-procedure .
       87     run check-shift-obj in this-procedure .
       88     run check-wth-doc   in this-procedure .
       89     run check-icnt-doc  in this-procedure .
       90     run check-chk-doc   in this-procedure .
       91     run check-scales-gds in this-procedure .
       92     run check-cash-desk  in this-procedure .
       93     run check-wth-place  in this-procedure .
       94     run check-fbr-prn    in this-procedure .
       95     run check-fbr-prn-gds    in this-procedure .
       96     run check-fbr-prn-grp    in this-procedure .
       97     run check-stop-list    in this-procedure .
       98   end.
       99   procedure check-trn-doc :
      100     do
      101     on error undo, return error
      102     :
      103       define buffer buf_trn-doc for ub.trn-doc .
      104       find first buf_trn-doc no-lock
      105         where buf_trn-doc.obj-type = p-obj-type
      106           and buf_trn-doc.obj-code = p-obj-code
      107           and buf_trn-doc.status_ <> 'факт':U
      108           and buf_trn-doc.status_ <> 'готов':U
      109           and buf_trn-doc.status_ <> 'запрос':U
      110         no-error .
      111       if available buf_trn-doc then do:
      112         message
      113           "На объекте существуют открытые документы" skip
      114           "Объект" p-obj-type p-obj-code skip
      115           "Документ" buf_trn-doc.doc-code skip
      116           view-as alert-box error .
      117         undo, return error .
      118       end.
      119     end.
      120   end procedure.
      121   procedure check-price-doc :
      122     do
      123     on error undo, return error
      124     :
      125       define buffer buf_price-doc for ub.price-doc .
      126       find first buf_price-doc no-lock
      127         where buf_price-doc.obj-type = p-obj-type
      128           and buf_price-doc.obj-code = p-obj-code
      129           and buf_price-doc.status_ <> 'акт':U
      130         no-error .
      131       if available buf_price-doc then do:
      132         message
      133           "На объекте существуют открытые переоценки" skip
      134           "Объект" p-obj-type p-obj-code skip
      135           "Переоценка" buf_price-doc.doc-num skip
      136           view-as alert-box error .
      137         undo, return error .
      138       end.
      139     end.
      140   end procedure.
