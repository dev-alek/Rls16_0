      345   procedure check-cash-desk :
      346     do
      347     on error undo, return error
      348     :
      349       define buffer buf_cash-desk for ub.cash-desk .
      350       if p-obj-type <> 'маг':U then return.
      351       find first buf_cash-desk no-lock
      352         where buf_cash-desk.obj-code = p-obj-code
      353         no-error .
      354       if available buf_cash-desk then do:
      355         message
      356           "На объекте существуют кассы" skip
      357           "Объект" p-obj-type p-obj-code skip
      358           "Касса"  buf_cash-desk.cash-num skip
      359           view-as alert-box error .
      360         undo, return error .
      361       end.
      362     end.
      363   end procedure.
      364   procedure check-wth-place :
      365     do
      366     on error undo, return error
      367     :
      368       define buffer buf_wth-place for ub.wth-place .
      369       find first buf_wth-place no-lock
      370         where buf_wth-place.obj-type = p-obj-type
      371         AND buf_wth-place.obj-code = p-obj-code
      372         AND buf_wth-place.cash-desk <> ?
      373         AND buf_wth-place.cash-desk <> 0
      374         no-error .
      375       if available buf_wth-place then do:
      376         message
      377           "На объекте существуют МХ МЦк, привязанные к кассам" skip
      378           "Объект" p-obj-type p-obj-code skip
      379           "МХ МЦ"  buf_wth-place.w-p-code skip
      380           view-as alert-box error .
      381         undo, return error .
      382       end.
      383     end.
      384   end procedure.
