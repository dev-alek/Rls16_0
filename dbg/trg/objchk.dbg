      142     do
      143     on error undo, return error
      144     :
      145       define buffer buf_ord-doc for ub.ord-doc .
      146       find first buf_ord-doc no-lock
      147         where buf_ord-doc.obj-type = p-obj-type
      148           and buf_ord-doc.obj-code = p-obj-code
      149           and buf_ord-doc.status_ <> 'факт':U
      150         no-error .
      151       if available buf_ord-doc then do:
      152         message
      153           "На объекте существуют открытые заказы" skip
      154           "Объект" p-obj-type p-obj-code skip
      155           "Заказ" buf_ord-doc.doc-code skip
      156           view-as alert-box error .
      157         undo, return error .
      158       end.
      159     end.
      160   end procedure.
      161   procedure check-fbr-doc :
      162     do
      163     on error undo, return error
      164     :
      165       define buffer buf_fbr-doc for ub.fbr-doc .
      166       find first buf_fbr-doc no-lock
      167         where buf_fbr-doc.obj-type = p-obj-type
      168           and buf_fbr-doc.obj-code = p-obj-code
      169           and buf_fbr-doc.status_ <> 'факт':U
      170         no-error .
      171       if available buf_fbr-doc then do:
      172         message
      173           "На объекте существуют открытые документы производства" skip
      174           "Объект" p-obj-type p-obj-code skip
      175           "Документ производства" buf_fbr-doc.doc-code skip
      176           view-as alert-box error .
      177         undo, return error .
      178       end.
      179     end.
      180   end procedure.
      181   procedure check-inkas :
      182     do
      183     on error undo, return error return-value
      184     :
      185       define buffer buf_inkas for ub.inkas .
      186       define variable v-fact-status-list as character no-undo .
      187       define variable ii as integer no-undo .
      188       v-fact-status-list = (if 'факт':U < 'запрос':U
      189                             then ('факт':U + chr(44) + 'запрос':U)
      190                             else ('запрос':U + chr(44) + 'факт':U)).
      191       do ii = 0 to num-entries(v-fact-status-list):
      192         CASE ii:
      193           when 0 then do:
      194             find first buf_inkas no-lock
      195               where buf_inkas.obj-type = p-obj-type
      196                 and buf_inkas.obj-code = p-obj-code
      197                 and buf_inkas.status_ < entry(1, v-fact-status-list) no-error .
      198           end.
      199           when num-entries(v-fact-status-list) then do:
      200             find first buf_inkas no-lock
      201               where buf_inkas.obj-type = p-obj-type
      202                 and buf_inkas.obj-code = p-obj-code
      203                 and buf_inkas.status_ > entry(num-entries(v-fact-status-list), v-fact-status-list) no-error .
      204           end.
      205           otherwise do:
      206             find first buf_inkas no-lock
      207               where buf_inkas.obj-type = p-obj-type
      208                 and buf_inkas.obj-code = p-obj-code
      209                 and buf_inkas.status_ > entry(ii, v-fact-status-list)
      210                 and buf_inkas.status_ < entry(ii + 1, v-fact-status-list)
      211                 no-error .
      212           end.
      213         END CASE.
      214         if available buf_inkas then do:
      215           message
      216             "На объекте существуют открытые продажа" skip
      217             "Объект" p-obj-type p-obj-code skip
      218             "Продажа" buf_inkas.inkas-code skip
      219             view-as alert-box error .
      220           undo, return error .
      221         end.
      222       end.
      223     end.
      224   end procedure.
