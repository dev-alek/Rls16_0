        1   block-level on error undo, throw.
        2   define input parameter p-action as integer no-undo .
        3   define input parameter p-param  as longchar no-undo .
        4   define output parameter p-ok    as logical no-undo .
        5   define output parameter p-mes   as character no-undo .
        6   define new global shared variable g#language as character no-undo .
        7   if g#language <> '' and g#language <> 'rus':U then do:
        8     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        9   end.
       10   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       11   procedure sys-time_get-sys :
       12     define output parameter p-year         as integer   no-undo .
       13     define output parameter p-month        as integer   no-undo .
       14     define output parameter p-day          as integer   no-undo .
       15     define output parameter p-hour         as integer   no-undo .
       16     define output parameter p-minute       as integer   no-undo .
       17     define output parameter p-second       as integer   no-undo .
       18     define output parameter p-milliseconds as integer   no-undo .
       19     define variable v-system-time-structure as memptr    no-undo.
       20     do
       21     on error undo, return error return-value
       22     :
       23       assign
       24         set-size(v-system-time-structure) = 16
       25       .
       26       run GetSystemTime
       27         (input  get-pointer-value(v-system-time-structure)
       28         ) .
       29       assign
       30         p-year         = get-short(v-system-time-structure,  1)
       31         p-month        = get-short(v-system-time-structure,  3)
       32         p-day          = get-short(v-system-time-structure,  7)
       33         p-hour         = get-short(v-system-time-structure,  9)
       34         p-minute       = get-short(v-system-time-structure, 11)
       35         p-second       = get-short(v-system-time-structure, 13)
       36         p-milliseconds = get-short(v-system-time-structure, 15)
       37       .
       38       assign
       39         set-size(v-system-time-structure) = 0
       40       .
       41     end.
       42   end procedure.
       43   procedure sys-time_get-comp-user-name :
       44     define output parameter p-computer-name as character no-undo .
       45     define output parameter p-user-name     as character no-undo .
       46     define output parameter p-process-pid   as integer   no-undo .
       47     define variable v-return-value  as integer   no-undo .
       48     define variable v-buffer-length as integer   no-undo .
       49     define variable v-buffer-memptr as memptr    no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       assign
       54         v-buffer-length = 1024
       55         set-size(v-buffer-memptr) = v-buffer-length + 4
       56       .
       57       assign
       58         put-long(v-buffer-memptr, 1) = v-buffer-length
       59       .
       60       run GetComputerNameA
       61         (input  get-pointer-value(v-buffer-memptr) + 4
       62         ,input  get-pointer-value(v-buffer-memptr)
       63         ,output v-return-value
       64         ) .
       65       if v-return-value <> 0
       66       then do:
       67         assign
       68           p-computer-name = get-string(v-buffer-memptr, 5)
       69         .
       70       end.
       71       assign
       72         put-long(v-buffer-memptr, 1) = v-buffer-length
       73       .
       74       run GetUserNameA
       75         (input  get-pointer-value(v-buffer-memptr) + 4
       76         ,input  get-pointer-value(v-buffer-memptr)
       77         ,output v-return-value
       78         ) .
       79       if v-return-value <> 0
       80       then do:
       81         assign
       82           p-user-name = get-string(v-buffer-memptr, 5)
       83         .
       84       end.
       85       run GetCurrentProcessId
       86         (output p-process-pid
       87         ) .
       88       assign
       89         set-size(v-buffer-memptr) = 0
       90       .
       91     end.
       92   end procedure.
       93   procedure sys-time_get-http :
       94     define output parameter p-http-time as character no-undo .
       95     define variable v-year         as integer   no-undo .
       96     define variable v-month        as integer   no-undo .
       97     define variable v-day-of-week  as integer   no-undo .
       98     define variable v-day          as integer   no-undo .
       99     define variable v-hour         as integer   no-undo .
      100     define variable v-minute       as integer   no-undo .
      101     define variable v-second       as integer   no-undo .
      102     define variable v-milliseconds as integer   no-undo .
      103     do
      104     on error undo, return error return-value
      105     :
      106       run sys-time_get-sys in this-procedure
      107         (output v-year
      108         ,output v-month
      109         ,output v-day
      110         ,output v-hour
      111         ,output v-minute
      112         ,output v-second
      113         ,output v-milliseconds
      114         ) .
      115       assign
      116         v-day-of-week = weekday(date(v-month, v-day, v-year))
      117         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
      118                     + ', ':u
      119                     + string(v-day, '99':u)
      120                     + ' ':u
      121                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
      122                     + ' ':u
      123                     + string(v-year, '9999':u)
      124                     + ' ':u
      125                     + string(v-hour, '99':u)
      126                     + ':':u
      127                     + string(v-minute, '99':u)
      128                     + ':':u
      129                     + string(v-second, '99':u)
      130                     + ' ':u
      131                     + 'GMT':u
      132       .
      133     end.
      134   end procedure.
      135   procedure sys-time_set-sys :
      136     define input  parameter p-year         as integer   no-undo .
      137     define input  parameter p-month        as integer   no-undo .
      138     define input  parameter p-day          as integer   no-undo .
      139     define input  parameter p-hour         as integer   no-undo .
      140     define input  parameter p-minute       as integer   no-undo .
      141     define input  parameter p-second       as integer   no-undo .
      142     define input  parameter p-milliseconds as integer   no-undo .
      143     define variable v-system-time-structure as memptr    no-undo.
      144     define variable v-return-value as integer   no-undo .
      145     define variable v-day-of-week  as integer   no-undo .
      146     do
      147     on error undo, return error return-value
      148     :
      149       assign
      150         v-day-of-week = weekday(date(p-month, p-day, p-year))
      151       .
      152       assign
      153         set-size(v-system-time-structure) = 16
      154       .
      155       assign
      156         put-short(v-system-time-structure,  1) = p-year
      157         put-short(v-system-time-structure,  3) = p-month
      158         put-short(v-system-time-structure,  5) = v-day-of-week
      159         put-short(v-system-time-structure,  7) = p-day
      160         put-short(v-system-time-structure,  9) = p-hour
      161         put-short(v-system-time-structure, 11) = p-minute
      162         put-short(v-system-time-structure, 13) = p-second
      163         put-short(v-system-time-structure, 15) = p-milliseconds
      164       .
      165       run SetSystemTime
      166         (input  get-pointer-value(v-system-time-structure)
      167         ,output v-return-value
      168         ) .
      169       assign
      170         set-size(v-system-time-structure) = 0
      171       .
      172       if v-return-value = 0
      173       then do:
      174         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      175       end.
      176     end.
      177   end procedure.
      178   procedure sys-time_sys-to-mjd :
      179     define input  parameter p-year         as integer   no-undo .
      180     define input  parameter p-month        as integer   no-undo .
      181     define input  parameter p-day          as integer   no-undo .
      182     define input  parameter p-hour         as integer   no-undo .
      183     define input  parameter p-minute       as integer   no-undo .
      184     define input  parameter p-second       as integer   no-undo .
      185     define input  parameter p-milliseconds as integer   no-undo .
      186     define output parameter p-mjd          as decimal   no-undo .
      187     define variable v-year-correction as decimal   no-undo .
      188     define variable v-shift-year as decimal   no-undo .
      189     do
      190     on error undo, return error return-value
      191     :
      192       assign
      193         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
      194         v-shift-year      = decimal(p-year) + v-year-correction
      195         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
      196               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
      197               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
      198               + decimal(p-day) - 2432076.0
      199               + p-hour / 24.0
      200               + p-minute / 1440.0
      201               + p-second / 86400.0
      202               + p-milliseconds / 86400000.0
      203       .
      204     end.
      205   end procedure.
      206   procedure sys-time_sys-to-loc :
      207     define input  parameter p-sys-year         as integer   no-undo .
      208     define input  parameter p-sys-month        as integer   no-undo .
      209     define input  parameter p-sys-day          as integer   no-undo .
      210     define input  parameter p-sys-hour         as integer   no-undo .
      211     define input  parameter p-sys-minute       as integer   no-undo .
      212     define input  parameter p-sys-second       as integer   no-undo .
      213     define input  parameter p-sys-milliseconds as integer   no-undo .
      214     define output parameter p-loc-year         as integer   no-undo .
      215     define output parameter p-loc-month        as integer   no-undo .
      216     define output parameter p-loc-day          as integer   no-undo .
      217     define output parameter p-loc-hour         as integer   no-undo .
      218     define output parameter p-loc-minute       as integer   no-undo .
      219     define output parameter p-loc-second       as integer   no-undo .
      220     define output parameter p-loc-milliseconds as integer   no-undo .
      221     define variable v-system-time-structure as memptr    no-undo.
      222     define variable v-return-value          as integer   no-undo .
      223     define variable v-sys-day-of-week       as integer   no-undo .
      224     do
      225     on error undo, return error return-value
      226     :
      227       assign
      228         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
      229       .
      230       assign
      231         set-size(v-system-time-structure) = 32
      232       .
      233       assign
      234         put-short(v-system-time-structure,  1) = p-sys-year
      235         put-short(v-system-time-structure,  3) = p-sys-month
      236         put-short(v-system-time-structure,  5) = v-sys-day-of-week
      237         put-short(v-system-time-structure,  7) = p-sys-day
      238         put-short(v-system-time-structure,  9) = p-sys-hour
      239         put-short(v-system-time-structure, 11) = p-sys-minute
      240         put-short(v-system-time-structure, 13) = p-sys-second
      241         put-short(v-system-time-structure, 15) = p-sys-milliseconds
      242       .
      243       run SystemTimeToTzSpecificLocalTime
      244         (input  0
      245         ,input  get-pointer-value(v-system-time-structure)
      246         ,input  get-pointer-value(v-system-time-structure) + 16
      247         ,output v-return-value
      248         ) .
      249       assign
      250         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
      251         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
      252         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
      253         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
      254         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
      255         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
      256         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
      257       .
      258       assign
      259         set-size(v-system-time-structure) = 0
      260       .
      261       if v-return-value = 0
      262       then do:
      263         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
      264       end.
      265     end.
      266   end procedure.
      267   procedure sys-time_mjd-to-sys :
      268     define input  parameter p-mjd          as decimal   no-undo .
      269     define output parameter p-year         as integer   no-undo .
      270     define output parameter p-month        as integer   no-undo .
      271     define output parameter p-day          as integer   no-undo .
      272     define output parameter p-hour         as integer   no-undo .
      273     define output parameter p-minute       as integer   no-undo .
      274     define output parameter p-second       as integer   no-undo .
      275     define output parameter p-milliseconds as integer   no-undo .
      276     define variable v-year-correction as decimal   no-undo .
      277     define variable v-shift-year      as decimal   no-undo .
      278     define variable v-conv-date     as date      no-undo .
      279     define variable v-int-part      as integer   no-undo .
      280     define variable v-fraction-part as decimal   no-undo .
      281     do
      282     on error undo, return error return-value
      283     :
      284       assign
      285         v-int-part      = integer(truncate(p-mjd, 0))
      286         v-fraction-part = p-mjd - v-int-part
      287         v-conv-date     = date(11, 17, 1858) + v-int-part
      288         p-year          = year(v-conv-date)
      289         p-month         = month(v-conv-date)
      290         p-day           = day(v-conv-date)
      291         v-fraction-part = v-fraction-part * 24.0
      292         p-hour          = integer(truncate(v-fraction-part, 0))
      293         v-fraction-part = (v-fraction-part - p-hour) * 60.0
      294         p-minute        = integer(truncate(v-fraction-part, 0))
      295         v-fraction-part = (v-fraction-part - p-minute) * 60.0
      296         p-second        = integer(truncate(v-fraction-part, 0))
      297         v-fraction-part = (v-fraction-part - p-second) * 1000.0
      298         p-milliseconds  = integer(v-fraction-part)
      299       .
      300     end.
      301   end procedure.
      302   procedure sys-time_mjd-to-loc :
      303     define input  parameter p-mjd              as decimal   no-undo .
      304     define output parameter p-loc-year         as integer   no-undo .
      305     define output parameter p-loc-month        as integer   no-undo .
      306     define output parameter p-loc-day          as integer   no-undo .
      307     define output parameter p-loc-hour         as integer   no-undo .
      308     define output parameter p-loc-minute       as integer   no-undo .
      309     define output parameter p-loc-second       as integer   no-undo .
      310     define output parameter p-loc-milliseconds as integer   no-undo .
      311     define variable v-sys-year         as integer   no-undo .
      312     define variable v-sys-month        as integer   no-undo .
      313     define variable v-sys-day          as integer   no-undo .
      314     define variable v-sys-hour         as integer   no-undo .
      315     define variable v-sys-minute       as integer   no-undo .
      316     define variable v-sys-second       as integer   no-undo .
      317     define variable v-sys-milliseconds as integer   no-undo .
      318     do
      319     on error undo, return error return-value
      320     :
      321       run sys-time_mjd-to-sys
      322         (input  p-mjd
      323         ,output v-sys-year
      324         ,output v-sys-month
      325         ,output v-sys-day
      326         ,output v-sys-hour
      327         ,output v-sys-minute
      328         ,output v-sys-second
      329         ,output v-sys-milliseconds
      330         ) .
      331       run sys-time_sys-to-loc
      332         (input  v-sys-year
      333         ,input  v-sys-month
      334         ,input  v-sys-day
      335         ,input  v-sys-hour
      336         ,input  v-sys-minute
      337         ,input  v-sys-second
      338         ,input  v-sys-milliseconds
      339         ,output p-loc-year
      340         ,output p-loc-month
      341         ,output p-loc-day
      342         ,output p-loc-hour
      343         ,output p-loc-minute
      344         ,output p-loc-second
      345         ,output p-loc-milliseconds
      346         ) .
      347     end.
      348   end procedure.
      349   function sys-time_get-mjd-func returns decimal
      350   :
      351     define variable v-year         as integer   no-undo .
      352     define variable v-month        as integer   no-undo .
      353     define variable v-day          as integer   no-undo .
      354     define variable v-hour         as integer   no-undo .
      355     define variable v-minute       as integer   no-undo .
      356     define variable v-second       as integer   no-undo .
      357     define variable v-milliseconds as integer   no-undo .
      358     define variable v-mjd          as decimal   no-undo .
      359     run sys-time_get-sys in this-procedure
      360       (output v-year
      361       ,output v-month
      362       ,output v-day
      363       ,output v-hour
      364       ,output v-minute
      365       ,output v-second
      366       ,output v-milliseconds
      367       ) .
      368     run sys-time_sys-to-mjd in this-procedure
      369       (input  v-year
      370       ,input  v-month
      371       ,input  v-day
      372       ,input  v-hour
      373       ,input  v-minute
      374       ,input  v-second
      375       ,input  v-milliseconds
      376       ,output v-mjd
      377       ) .
      378     return v-mjd .
      379   end function .
      380   function sys-time_get-sys-str-func returns character
      381   :
      382     define variable v-utc-time as character no-undo .
      383     define variable v-year         as integer   no-undo .
      384     define variable v-month        as integer   no-undo .
      385     define variable v-day          as integer   no-undo .
      386     define variable v-hour         as integer   no-undo .
      387     define variable v-minute       as integer   no-undo .
      388     define variable v-second       as integer   no-undo .
      389     define variable v-milliseconds as integer   no-undo .
      390     run sys-time_get-sys in this-procedure
      391       (output v-year
      392       ,output v-month
      393       ,output v-day
      394       ,output v-hour
      395       ,output v-minute
      396       ,output v-second
      397       ,output v-milliseconds
      398       ) .
      399     assign
      400       v-utc-time  = 'UTC ':u
      401                   + string(v-year,         '9999':u)
      402                   + '/':u
      403                   + string(v-month,        '99':u)
      404                   + '/':u
      405                   + string(v-day,          '99':u)
      406                   + ' ':u
      407                   + string(v-hour,         '99':u)
      408                   + ':':u
      409                   + string(v-minute,       '99':u)
      410                   + ':':u
      411                   + string(v-second,       '99':u)
      412                   + ' ':u
      413                   + string(v-milliseconds, '999':u)
      414     .
      415     return v-utc-time.
      416   end function .
      417   function sys-time_mjd-to-loc-str-func returns character
      418     (v-sys-mjd as decimal)
      419   :
      420     define variable v-loc-str          as character no-undo .
      421     define variable v-loc-year         as integer   no-undo .
      422     define variable v-loc-month        as integer   no-undo .
      423     define variable v-loc-day          as integer   no-undo .
      424     define variable v-loc-hour         as integer   no-undo .
      425     define variable v-loc-minute       as integer   no-undo .
      426     define variable v-loc-second       as integer   no-undo .
      427     define variable v-loc-milliseconds as integer   no-undo .
      428     run sys-time_mjd-to-loc in this-procedure
      429       (input  v-sys-mjd
      430       ,output v-loc-year
      431       ,output v-loc-month
      432       ,output v-loc-day
      433       ,output v-loc-hour
      434       ,output v-loc-minute
      435       ,output v-loc-second
      436       ,output v-loc-milliseconds
      437       ) .
      438     assign
      439       v-loc-str = substitute('&1/&2/&3 &4:&5'
      440                             ,string(v-loc-day,    '99':U)
      441                             ,string(v-loc-month,  '99':U)
      442                             ,string(v-loc-year,   '9999':U)
      443                             ,string(v-loc-hour,   '99':U)
      444                             ,string(v-loc-minute, '99':U)
      445                             )
      446     .
      447     return v-loc-str .
      448   end function .
      449   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
      450   :
      451     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      452   END PROCEDURE.
      453   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
      454   :
      455     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
      456     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
      457   END PROCEDURE.
      458   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
      459   :
      460     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
      461     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
      462   END PROCEDURE.
      463   PROCEDURE SystemTimeToTzSpecificLocalTime EXTERNAL "kernel32.dll"
      464   :
      465     DEFINE INPUT  PARAMETER lpTimeZone      AS LONG .
      466     DEFINE INPUT  PARAMETER lpUniversalTime AS LONG .
      467     DEFINE INPUT  PARAMETER lpLocalTime     AS LONG .
      468     DEFINE RETURN PARAMETER ReturnValue     AS LONG .
      469   END PROCEDURE.
      470   PROCEDURE GetUserNameA EXTERNAL "advapi32.dll"
      471   :
      472     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      473     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      474     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      475   END PROCEDURE.
      476   PROCEDURE GetComputerNameA EXTERNAL "kernel32.dll"
      477   :
      478     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
      479     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
      480     DEFINE RETURN PARAMETER ReturnValue AS LONG .
      481   END PROCEDURE.
      482   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll"
      483   :
      484     DEFINE RETURN PARAMETER RetVal          AS LONG.
      485   END PROCEDURE.
      486   define temp-table tt-params
      487       field p-code    as character
      488       field p-value   as character
      489       index pi as primary unique
      490           p-code
      491   .
      492   define variable v-action-name   as character no-undo .
      493   define variable v-numpar        as integer no-undo .
      494   define variable v-par as character no-undo .
      495   define variable ii as integer no-undo .
      496   define variable sw as handle no-undo .
      497   define variable cmd as character no-undo .
      498   define variable v-section   as character no-undo .
      499   define variable v-key       as character no-undo .
      500   define variable v-path      as character no-undo .
      501   define variable v-id        as character no-undo .
      502   define variable v-trans-file as character no-undo .
      503   define variable v-resp-file as character no-undo .
      504   define variable v-resp-line as character no-undo .
      505   define variable v-resp-line-ent1 as character no-undo .
      506   define variable v-resp-line-ent2 as character no-undo .
      507   define variable dt          as datetime no-undo .
      508   define variable v-computer-name        as character no-undo .
      509   define variable v-computer-tcp-name    as character no-undo .
      510   define variable v-computer-ip-addr     as character no-undo .
      511   define variable v-computer-login-name  as character no-undo .
      512   define variable v-computer-process-pid as integer   no-undo .
      513   define variable hRoot as handle  no-undo.
      514   define variable hDoc  as handle  no-undo.
      515   define variable hRow  as handle  no-undo.
      516   define variable hText as handle  no-undo.
      517   v-numpar = num-entries(p-param, chr(4)) .
      518   case p-action :
      519       when 50
      520       then do :
      521           v-action-name = "Авторизация пользователя" .
      522       end.
      523       when 51
      524       then do :
      525           v-action-name = "Открытие смены" .
      526       end.
      527       when 52
      528       then do :
      529           v-action-name = "Изменение персонала смены" .
      530       end.
      531       when 53
      532       then do :
      533           v-action-name = "Отмена смены" .
      534       end.
      535       when 54
      536       then do :
      537           v-action-name = "Удаление смены" .
      538       end.
      539       when 55
      540       then do :
      541           v-action-name = "Создание документа пользователем" .
      542       end.
      543       when 56
      544       then do :
      545           v-action-name = "Регистрация показаний АСИ" .
      546       end.
      547       when 57
      548       then do :
      549           v-action-name = "Изменение статуса документа" .
      550       end.
      551       when 58
      552       then do :
      553           v-action-name = "Изменение статуса документа сверки" .
      554       end.
      555       when 59
      556       then do :
      557           v-action-name = "Удаление документа" .
      558       end.
      559       when 60
      560       then do :
      561           v-action-name = "Удаление документа сверки" .
      562       end.
      563       when 61
      564       then do :
      565           v-action-name = "Изменение статуса резервуара" .
      566       end.
      567       when 62
      568       then do :
      569           v-action-name = "Закрытие смены" .
      570       end.
      571       when 63
      572       then do :
      573           v-action-name = "Закрытие приложения" .
      574       end.
      575       when 65
      576       then do :
      577           v-action-name = "Изменение уровня остатков сверх допустимого значения в отсутствие отпуска и штатной приемки" .
      578       end.
      579       when 66
      580       then do :
      581           v-action-name = "Изменение параметров допустимого отклонения" .
      582       end.
      583       otherwise
      584       do :
      585       end.
      586   end case .
      587   empty temp-table tt-params .
      588   do ii = 1 to v-numpar :
      589       v-par = entry(ii, p-param, chr(4)) .
      590       create tt-params.
      591       assign
      592           tt-params.p-code    = entry(1, v-par, "=")
      593           tt-params.p-value   = entry(2, v-par, "=")
      594       .
      595       tt-params.p-value = replace(tt-params.p-value,'"','').
      596   end.
      597   assign
      598       v-section = 'CCTV':u
      599       v-key     = 'path':u
      600   .
      601   get-key-value section v-section key v-key value v-path .
      602   if v-path = ? or trim(v-path) = ""
      603   then do :
      604       p-ok = false.
      605       p-mes = "В .ini файле не указан путь к серверу видеонаблюдения".
      606       return.
      607   end.
      608   assign
      609       v-key     = 'id':u
      610   .
      611   get-key-value section v-section key v-key value v-id .
      612   if v-id = ? or trim(v-id) = ""
      613   then do :
      614       p-ok = false.
      615       p-mes = "В .ini файле не указан терминал для сервера видеонаблюдения".
      616       return.
      617   end.
      618   run sys-time_get-comp-user-name in this-procedure
      619       (output v-computer-name
      620       ,output v-computer-login-name
      621       ,output v-computer-process-pid
      622       ) .
      623   run gbl/tcp-info.p
      624         (output v-computer-tcp-name
      625         ,output v-computer-ip-addr
      626         ) .
      627   os-delete "TransBlock.json".
      628   os-delete "RespTrans.json".
      629   assign
      630       v-trans-file = "TransBlock.json"
      631       v-resp-file = "RespTrans.json"
      632   .
      633   dt = now - (timezone * 60000) .
      634   output to value(v-trans-file) convert target "UTF-8".
      635   put unformatted
      636       CHR(123) skip
      637       '"FunctionNumber":"' string(p-action) '",' skip
      638       '"FunctionName":"' v-action-name '",' skip
      639       '"TransactionTimestamp":"' iso-date(dt) '",' skip
      640       '"Terminal":"' v-id '",' skip
      641       '"Ip":"' v-computer-ip-addr '",' skip
      642       '"HostName":"' v-computer-tcp-name '",' skip
      643       '"UserName":"' v-computer-login-name '"'
      644   .
      645   for each tt-params no-lock  :
      646       put unformatted
      647           ',' skip '"' tt-params.p-code '":"' tt-params.p-value '"'
      648       .
      649   end.
      650   put unformatted
      651       skip '}' skip .
      652   .
      653   output close .
      654   cmd = substitute ('&1 --connect-timeout 5 curl -X POST -d @&2 &3/PosEvent?content=json --header "Content-Type:application/json" >&4',search ("exe/curl.exe"), v-trans-file, v-path, v-resp-file).
      655   os-command silent value (cmd).
      656   file-info:file-name = search (v-resp-file).
      657   if search (v-resp-file) = ? or file-info:file-size = 0
      658   then do:
      659     assign
      660       p-ok = false
      661       p-mes = "Не удалось получить ответ от системы видеонаблюдения"
      662     .
      663     output to value (ibs.th.gbl.gbl-inipar:logDir + "svn-err.log") append .
      664     put unformatted string(today, "99/99/9999") "    " string(time, "hh:mm:ss")
      665                     "    нет ответа от СВН IP " v-path skip.
      666     output close .
      667     return.
      668   end.
      669   output to value (v-resp-file) append .
      670   put unformatted " " skip " _ ".
      671   output close .
      672   input from value (v-resp-file) .
      673   import unformatted v-resp-line .
      674   output close .
      675   v-resp-line = trim(v-resp-line, chr(123)) .
      676   v-resp-line = trim(v-resp-line, "} ") .
      677   v-resp-line-ent1 = entry(1,v-resp-line) .
      678   v-resp-line-ent2 = entry(2,v-resp-line) .
      679   if v-resp-line-ent1 begins '"Description"'
      680   then
      681   p-mes = trim(entry(2, v-resp-line-ent1, ':'), '"') .
      682   else
      683   p-ok = trim(entry(2, v-resp-line-ent1, ':'), '"') = "ok" .
      684   if v-resp-line-ent2 begins '"Description"'
      685   then
      686   p-mes = trim(entry(2, v-resp-line-ent2, ':'), '"') .
      687   else
      688   p-ok = trim(entry(2, v-resp-line-ent2, ':'), '"') = "ok" .
