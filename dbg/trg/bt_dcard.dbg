      731   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      732   define variable v-waitfram-action01         as character   no-undo .
      733   define variable v-waitfram-action02         as character   no-undo .
      734   define variable v-waitfram-action03         as character   no-undo .
      735   define variable mWaitFramTextBeg            as character   no-undo.
      736   define variable mWaitFramTextEnd            as character   no-undo.
      737   define variable mWaitFramView               as logical     no-undo.
      738   define variable mWaitProcEvent              as logical     no-undo init yes.
      739   define variable mWaitFramInterval           as integer     no-undo init 1 .
      740   define variable mWaitFramStop               as logical     no-undo.
      741   define variable mWaitFramStopUser           as logical     no-undo.
      742   define variable mWaitFramStopTimeOut        as logical     no-undo.
      743   define variable mWaitFramStartProc          as datetime-tz no-undo.
      744   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      745   define button B-WaitFramStop auto-end-key
      746        label "Стоп"
      747        size 10 by 1 tooltip "Остоновить процесс".
      748   define button B-viewProcInfo
      749        label "Информация"
      750        size 15 by 1 tooltip "Информация о процесс".
      751   define frame waitfram
      752     v-waitfram-action01 format "x(72)" no-label skip
      753     v-waitfram-action02 format "x(72)" no-label skip
      754     v-waitfram-action03 format "x(72)" no-label skip
      755     B-viewProcInfo
      756     B-WaitFramStop at row 4 col 30
      757     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      758     .
      759   define new global shared variable mBatchMode as logical no-undo init ?.
      760   define variable mFramBachModHandle as handle no-undo.
      761   mFramBachModHandle = frame waitfram:handle.
      762   define variable mFameOldVis as logical no-undo.
      763   define variable mVisCUrentVin as logical no-undo.
      764   if session:batch-mode
      765   then
      766      mBatchMode = yes.
      767   if mBatchMode = ? then do:
      768     mVisCUrentVin = current-window:visible.
      769     mFameOldVis = mFramBachModHandle:visible.
      770     mFramBachModHandle:visible  = yes.
      771     mBatchMode = mFramBachModHandle:visible ne yes.
      772     mFramBachModHandle:visible = mFameOldVis.
      773     current-window:visible = mVisCUrentVin.
      774   end.
      775    if  log-manager:logfile-name ne ?
      776     then DO:
      777         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      778         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      779         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      780     end.
      781   on choose of B-WaitFramStop in frame waitfram
      782   do:
      783     mWaitFramStop = yes.
      784     mWaitFramStopUser = yes.
      785   end.
      786   function waitfram-check-timeout returns logical():
      787      define variable vtime as int64 no-undo.
      788      if mWaitFramStopTimeOut
      789      then
      790         return yes.
      791      vtime = ( now - mWaitFramStartProc ) / 1000 .
      792      if     mWaitFramTimeOut ne ?
      793         and mWaitFramTimeOut ne 0
      794         and mWaitFramTimeOut lt vtime
      795      then do:
      796         mWaitFramStopTimeOut = yes.
      797      end.
      798      return mWaitFramStopTimeOut.
      799   end.
      800   procedure waitfram-hide :
      801     if not session:batch-mode
      802     then do
      803     on error undo, return error return-value
      804     :
      805       pause 0 before-hide .
      806       if not mBatchMode then
      807         hide frame waitfram .
      808     if     not mWaitFramView
      809        and mWaitProcEvent
      810     then
      811       process events .
      812     end.
      813   end procedure.
      814   procedure waitfram-show :
      815     define input  parameter p-message as character no-undo .
      816     define variable v-left-margin as integer   no-undo .
      817     if not session:batch-mode
      818     then do
      819     on error undo, return error return-value
      820     :
      821       if length(p-message) <= 70 then do:
      822         assign
      823           v-left-margin = integer((70 - length(p-message)) / 2)
      824         .
      825         assign
      826           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      827         .
      828         assign
      829           v-waitfram-action01 = " "
      830           v-waitfram-action02 = " "
      831                                    + fill(" ", v-left-margin)
      832                                    + p-message
      833           v-waitfram-action03 = " "
      834         .
      835       end.
      836       else do:
      837         define variable vRindex1 as integer no-undo.
      838         define variable vRindex2 as integer no-undo.
      839         vRindex1 = r-index(p-message," ",70).
      840         if vRindex1 = 0
      841         then
      842            vRindex1 = 70.
      843         if length(p-message)  <= vRindex1 + 70 then do:
      844           assign
      845             v-waitfram-action01 = " "
      846             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      847             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      848           .
      849         end.
      850         else do:
      851           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      852           if vRindex2 <= vRindex1
      853           then
      854              vRindex2 = vRindex1 + 70.
      855           assign
      856             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      857             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      858             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      859           .
      860         end.
      861       end.
      862       B-viewProcInfo:visible   in frame waitfram = no.
      863       B-viewProcInfo:sensitive in frame waitfram = no.
      864       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      865       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      866       if  (   mWaitFramView
      867          or  mWaitProcEvent)
      868          and not mBatchMode
      869       then
      870          display
      871             v-waitfram-action01 skip
      872             v-waitfram-action02 skip
      873             v-waitfram-action03 skip
      874          with frame waitfram .
      875       if     mWaitFramView
      876          then do:
      877             if     mWaitFramInterval ne ?
      878                and not mBatchMode
      879             then
      880                wait-for go of frame waitfram pause mWaitFramInterval.
      881          end.
      882          else
      883             if     mWaitProcEvent
      884                and not mBatchMode
      885             then
      886                process events .
      887     end.
      888   end procedure.
      889      procedure waitfram-show-this:
      890         define input  parameter iInterval as int64 no-undo.
      891         define variable vtime as int64 no-undo.
      892         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      893         mWaitFramInterval = iInterval.
      894         run waitfram-show (substitute("&1&2 &3&4" ,
      895                                       mWaitFramTextBeg ,
      896                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      897                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      898                                       mWaitFramTextEnd
      899                                      )
      900                           ).
      901      end.
      902      procedure WaitFramRunPause:
      903         define input  parameter iInterval as dec no-undo.
      904         define variable vStart  as datetime-tz no-undo.
      905         define variable vend    as datetime-tz no-undo.
      906         define variable vint as int64 no-undo.
      907         define variable vOk as logical no-undo.
      908         vStart = now.
      909         vend   = vStart.
      910         publish "WaitFramPause" (iInterval,output vOk).
      911         vend   =  now.
      912         vint = vend - vStart.
      913         vint = iInterval - vint / 1000.
      914         if     not mWaitFramStop
      915            and (   vint > 0
      916                 or (    not vOk
      917                     and iInterval eq ?
      918                     )
      919                 )
      920         then
      921            run waitfram-show-this (iInterval).
      922         vend   =  now.
      923         vint = vend - vStart.
      924         vint = iInterval - vint / 1000.
      925         if     not mWaitFramStop
      926            and vint > 0
      927         then do:
      928            run gbl/pause.p (vint * 1000).
      929         end.
      930         if iInterval ne ?
      931         then
      932            publish "WaitFramStop".
      933         waitfram-check-timeout().
      934      end.
      935      procedure WaitFramWaitFor:
      936         define input  parameter iInterval as dec no-undo.
      937         assign
      938            mWaitFramStartProc   = now
      939            mWaitFramStopUser    = no
      940            mWaitFramStopTimeOut = no
      941         .
      942         block-wait:
      943         do while not mWaitFramStop:
      944            run WaitFramRunPause (iInterval).
      945            if  waitfram-check-timeout()
      946            then do:
      947               leave block-wait.
      948            end.
      949         end.
      950         run waitfram-hide.
      951      end.
      952   procedure waitfram-join :
      953     define input  parameter p-line-1  as character no-undo .
      954     define input  parameter p-line-2  as character no-undo .
      955     define input  parameter p-line-3  as character no-undo .
      956     define output parameter p-message as character no-undo .
      957     do
      958     on error undo, return error return-value
      959     :
      960       assign
      961         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      962                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      963                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      964       .
      965     end.
      966   end procedure.
      967   function waitfram-join-function returns character
      968     (input p-line-1 as character
      969     ,input p-line-2 as character
      970     ,input p-line-3 as character
      971     ).
      972     define variable v-message as character no-undo .
      973     run waitfram-join in this-procedure
      974       (input  p-line-1
      975       ,input  p-line-2
      976       ,input  p-line-3
      977       ,output v-message
      978       ) .
      979     return v-message .
      980   end function .
      981   define temp-table temp-dc-list no-undo
      982     field action-num  as integer
      983     field d-card      as character
      984     field host-code   as integer
      985     field obj-type    as character
      986     field obj-code    as integer
      987     field action      as character
      988     field bp_rowid    as rowid
      989     index xpk is primary unique action-num
      990     index xie1 d-card
      991   .
      992   define variable v-stop as logical no-undo .
      993   define variable log-file-name as character no-undo init "send-cd.txt":U.
      994   main-block:
      995   do
      996   on error undo main-block, return error return-value
      997   :
      998     define buffer btpr-dc-lock_batchprocess for ub.batchprocess .
      999     run gbl/lock-prc.p
     1000       (input 'dcrd':U
     1001       ,input 0
     1002       ,input 0
     1003       ,input 0
     1004       ,input ""
     1005       ,input ""
     1006       ,input ""
     1007       ,input ",,,,,,Обработка изменений клиента-карты"
     1008       ,input p-message-on
     1009       ,buffer btpr-dc-lock_batchprocess
     1010       ) no-error .
     1011     if error-status :error
     1012     then do:
     1013       if p-message-on = true
     1014       or error-status :get-message(1) <> ""
     1015       then do:
     1016         message
     1017           vss-workfile vss-revision vss-description skip
     1018           "В данный момент происходит Обработка изменений клиента-карты" skip
     1019           view-as alert-box error .
     1020       end.
     1021       undo, return error "В данный момент происходит Обработка изменений клиента-карты" .
     1022     end.
     1023     run waitfram-show in this-procedure ("Ждите... Поиск информации, подлежащей отправке на кассы..." ).
     1024     run create-dc-list in this-procedure .
     1025     run waitfram-hide in this-procedure .
     1026     run process-dc-list in this-procedure .
     1027     run close-dc-list in this-procedure .
     1028   end.
     1029   procedure create-dc-list :
     1030     define buffer buf_batchprocess for ub.batchprocess .
     1031     define buffer buf_temp-dc-list for temp-dc-list .
     1032     do
     1033     on error undo, return error return-value
     1034     :
     1035       for each buf_BatchProcess no-lock
     1036         where buf_BatchProcess.bp_type       = 'dcard':U
     1037           and buf_BatchProcess.bp_status     = 'N':U
     1038       on error undo, return error return-value
     1039       :
     1040         create buf_temp-dc-list .
     1041         assign
     1042           buf_temp-dc-list.action-num = buf_BatchProcess.BatchProcess#
     1043           buf_temp-dc-list.d-card      = buf_BatchProcess.charkey_one
     1044           buf_temp-dc-list.host-code  = buf_BatchProcess.key#_one
     1045           buf_temp-dc-list.obj-type   = buf_BatchProcess.charkey_two
     1046           buf_temp-dc-list.obj-code   = buf_BatchProcess.key#_two
     1047           buf_temp-dc-list.action     = buf_BatchProcess.bp_execsystime
     1048           buf_temp-dc-list.bp_rowid   = rowid(buf_BatchProcess)
     1049         .
     1050       end.
     1051     end.
     1052   end procedure.
     1053   procedure process-dc-list :
     1054     define buffer buf_temp-dc-list for temp-dc-list .
     1055     define buffer cli_shops for ub.clients .
     1056     define buffer buf_cash-desk for ub.cash-desk .
     1057     define variable lns-cnt as integer no-undo .
     1058     define variable line-rec as recid no-undo .
     1059     define variable v-db-num like ub.db.db-num no-undo .
     1060     do
     1061     on error undo, return error return-value
     1062     :
     1063   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1065     (output v-db-num
     1066     )  .
     1067       for each buf_temp-dc-list
     1068       on error undo, return error return-value
     1069       :
     1070         find first ub.dis-card no-lock where
     1071                   ub.dis-card.d-card = buf_temp-dc-list.d-card no-error .
     1072         if avail ub.dis-card then do:
     1073           if buf_temp-dc-list.obj-type = "":U
     1074           AND buf_temp-dc-list.obj-code = 0 then do:
     1075   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1076   find dc-list
     1077     where dc-list.d-card = dis-card.d-card
     1078     no-error .
     1079   if available dc-list then do:
     1080     assign
     1081       dc-list.to-del = no
     1082     .
     1083   end.
     1084   else do:
     1085     create dc-list .
     1086     buffer-copy dis-card to dc-list
     1087     assign
     1088       dc-list.to-del = no
     1089     .
     1090     assign
     1091       lns-cnt = lns-cnt + 1
     1092       line-rec = recid (dc-list)
     1093     .
     1094   end.
     1095               assign
     1096               dc-list.to-del = buf_temp-dc-list.action = "D":U
     1097               dc-list.order-num = action-num
     1098               .
     1099           end.
     1100           else do:
     1101             find first dcp-list where
     1102                        dcp-list.d-card   = buf_temp-dc-list.d-card
     1103                   AND  dcp-list.host-code = buf_temp-dc-list.host-code
     1104                   AND  dcp-list.obj-type = buf_temp-dc-list.obj-type
     1105                   and  dcp-list.obj-code = buf_temp-dc-list.obj-code
     1106                   and  dcp-list.dt-code = 0
     1107                   and  dcp-list.node-code = 0
     1108                   no-error .
     1109             if not avail dcp-list then do:
     1110               create dcp-list.
     1111               assign
     1112               dcp-list.d-card = buf_temp-dc-list.d-card
     1113               dcp-list.host-code = buf_temp-dc-list.host-code
     1114               dcp-list.obj-type = buf_temp-dc-list.obj-type
     1115               dcp-list.obj-code = buf_temp-dc-list.obj-code
     1116               .
     1117             end.
     1118             assign
     1119             dcp-list.to-del = (buf_temp-dc-list.action = "D":U)
     1120             dcp-list.order-num =  buf_temp-dc-list.action-num
     1121             .
     1122           end.
     1123         end.
     1124       end.
     1125       if (can-find(first dc-list)
     1126           or can-find(first dcp-list) )
     1127       and can-find(first buf_cash-desk where
     1128                         buf_cash-desk.db-num = v-db-num ) then do:
     1129         run get-stop-state in p-log-handle (output v-stop).
     1130         if v-stop then do:
     1131           run write-log-and-file in p-log-handle (
     1132                 input 1
     1133               , input log-file-name
     1134               , input 1
     1135               , input substitute("!!!Процедура пересылки остановлена пользователем"
     1136                                   )
     1137                                     ).
     1138           return.
     1139         end.
     1140         run str/sendclia.p (
     1141                         input parparentproc
     1142                       , input this-procedure
     1143                       , input p-log-handle
     1144                       , (string(g#db-num) + chr(4) + "optimize":U + chr(4) + "yes":U + chr(4) + "S":U)
     1145                       )
     1146         no-error .
     1147         if error-status:error then do:
     1148             run set-view-log in p-log-handle(yes).
     1149         end.
     1150       end.
     1151     end.
     1152   end procedure.
     1153   procedure close-dc-list :
     1154     define buffer buf_batchprocess for ub.batchprocess .
     1155     define buffer buf_temp-dc-list for temp-dc-list .
     1156     do
     1157     on error undo, return error return-value
     1158     :
     1159       for each buf_temp-dc-list
     1160       on error undo, return error return-value
     1161       :
     1162         do transaction
     1163         on error undo, return error return-value
     1164         :
     1165     find first buf_batchprocess exclusive-lock
     1166       where rowid(buf_batchprocess) = buf_temp-dc-list.bp_rowid
     1167       no-error .
     1168     if not available buf_batchprocess then do:
     1169       message
     1170         vss-workfile vss-revision vss-description skip
     1171         "Не найдена запись пересчета архива" skip
     1172         view-as alert-box error .
     1173       undo, return error .
     1174     end.
     1175     if buf_batchprocess.bp_status <> 'N':U then do:
     1176       message
     1177         vss-workfile vss-revision vss-description skip
     1178         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
     1179         "BP_Type"       buf_batchprocess.BP_Type       skip
     1180         "BP_Status"     buf_batchprocess.BP_Status     skip
     1181         "Key#_One"      buf_batchprocess.Key#_One      skip
     1182         "Key#_Two"      buf_batchprocess.Key#_Two      skip
     1183         "Key#_Three"    buf_batchprocess.Key#_Three    skip
     1184         "CharKey_One"   buf_batchprocess.CharKey_One   skip
     1185         "CharKey_Two"   buf_batchprocess.CharKey_Two   skip
     1186         "CharKey_Three" buf_batchprocess.CharKey_Three skip
     1187         view-as alert-box error .
     1188       undo, return error .
     1189     end.
     1190       define variable v-btpr_upd-today-9 as date      no-undo.
     1191     define variable v-btpr_upd-time-9  as integer   no-undo.
     1192     run cur-time in this-procedure ( output v-btpr_upd-today-9
     1193                                    , output v-btpr_upd-time-9
     1194                                    ).
     1195     assign
     1196       buf_batchprocess.bp_status         = 'D':U
     1197       buf_batchprocess.bp_execcounttries = buf_batchprocess.bp_execcounttries + 1
     1198       buf_batchprocess.bp_execuser_id    = g#userid
     1199       buf_batchprocess.bp_execsysdate    = v-btpr_upd-today-9
     1200       buf_batchprocess.bp_execsystime    = string(v-btpr_upd-time-9, 'hh:mm')
     1201       buf_batchprocess.bp_execsystimeint = v-btpr_upd-time-9
     1202     .
     1203         end.
     1204       end.
     1205     end.
     1206   end procedure.
