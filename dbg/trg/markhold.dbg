        1   block-level on error undo, throw.
        2   define input  parameter p-cat-code  as integer   no-undo .
        3   define input  parameter p-lock-code as character no-undo .
        4   define input  parameter p-fact-date as date      no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Пометить межфирменные архивы, как требующие перерасчета с определенной даты".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1|&2|&3',p-cat-code,p-lock-code,p-fact-date)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure holdattr-code :
       85     do
       86     on error undo, return error
       87     :
       88       define input  parameter p-code           as character no-undo .
       89       define output parameter p-type           as character no-undo .
       90       define output parameter p-format         as character no-undo .
       91       define output parameter p-label          as character no-undo .
       92       define output parameter p-user-can-edit  as logical   no-undo .
       93       define output parameter p-output-display as logical   no-undo .
       94       define output parameter p-other          as character no-undo .
       95       case p-code :
       96               when 'begin-date':U then do:     assign     p-label = "Дата начала межфирменного архива"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата начала межфирменного архива"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       97               when 'is-calc':U then do:     assign     p-label = "Произв.расчет арх."     p-type = 'L':U      p-format = "+/-"     p-label = "Произв.расчет арх."     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       98         otherwise do:
       99           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      100         end.
      101       end.
      102     end.
      103   end procedure.
      104   procedure holdattr-tooltip :
      105     do
      106     on error undo, return error
      107     :
      108       define input  parameter p-code    as character no-undo .
      109       define output parameter p-tooltip as character no-undo .
      110       define output parameter p-label   as character no-undo .
      111       case p-code :
      112               when 'begin-date':U then do:     assign     p-tooltip = "Дата начала межфирменного архива"     p-label = "Дата начала межфирменного архива" .   end.
      113               when 'is-calc':U then do:     assign     p-tooltip = "Производится расчет межфирменного архива"     p-label = "Произв.расчет арх." .   end.
      114         otherwise do:
      115           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      116         end.
      117       end.
      118     end.
      119   end procedure.
      120   procedure holdattr-value :
      121     do
      122     on error undo, return error
      123     :
      124       define input  parameter p-cat-code  like ub.hold-attr.cat-code     no-undo .
      125       define input  parameter p-code      like ub.hold-attr.attr-code  no-undo .
      126       define output parameter p-value     like ub.hold-attr.attr-value no-undo .
      127       define output parameter p-type      as character no-undo .
      128       define buffer buf_hold-attr for ub.hold-attr .
      129       def var v-format         as character no-undo .
      130       def var v-label          as character no-undo .
      131       def var v-user-can-edit  as logical   no-undo .
      132       def var v-output-display as logical   no-undo .
      133       def var v-other          as character no-undo .
      134       run holdattr-code in this-procedure
      135         (input  p-code
      136         ,output p-type
      137         ,output v-format
      138         ,output v-label
      139         ,output v-user-can-edit
      140         ,output v-output-display
      141         ,output v-other
      142         ) no-error .
      143       if error-status :error then do:
      144         undo, return error return-value .
      145       end.
      146       find first buf_hold-attr no-lock
      147         where buf_hold-attr.cat-code    = p-cat-code
      148           and buf_hold-attr.attr-code = p-code
      149         no-error .
      150       if avail buf_hold-attr then do:
      151         assign
      152           p-value =  buf_hold-attr.attr-value
      153         .
      154       end.
      155       else do:
      156         assign
      157           p-value = if p-type = 'L':U then "no":U else ""
      158         .
      159       end.
      160     end.
      161   end procedure.
      162   procedure holdattr-write :
      163     do
      164     on error undo, return error
      165     :
      166       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      167       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      168       define input parameter p-value     like ub.hold-attr.attr-value no-undo .
      169       define buffer buf_hold-attr for ub.hold-attr .
      170       def var v-type           as character no-undo .
      171       def var v-format         as character no-undo .
      172       def var v-label          as character no-undo .
      173       def var v-user-can-edit  as logical   no-undo .
      174       def var v-output-display as logical   no-undo .
      175       def var v-other          as character no-undo .
      176       run holdattr-code in this-procedure
      177         (input  p-code
      178         ,output v-type
      179         ,output v-format
      180         ,output v-label
      181         ,output v-user-can-edit
      182         ,output v-output-display
      183         ,output v-other
      184         ) no-error .
      185       if error-status :error then do:
      186         undo, return error return-value .
      187       end.
      188       find first buf_hold-attr exclusive-lock
      189         where buf_hold-attr.cat-code    = p-cat-code
      190           and buf_hold-attr.attr-code = p-code
      191         no-error .
      192       if not available buf_hold-attr then do:
      193         create buf_hold-attr .
      194         assign
      195           buf_hold-attr.cat-code    = p-cat-code
      196           buf_hold-attr.attr-code = p-code
      197         .
      198       end.
      199       assign
      200         buf_hold-attr.attr-value = p-value
      201       .
      202     end.
      203   end procedure.
      204   procedure holdattr-exist :
      205     do
      206     on error undo, return error
      207     :
      208       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      209       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      210       define output parameter p-exist    as logical  no-undo .
      211       define buffer buf_hold-attr for ub.hold-attr .
      212       def var v-type           as character no-undo .
      213       def var v-format         as character no-undo .
      214       def var v-label          as character no-undo .
      215       def var v-user-can-edit  as logical   no-undo .
      216       def var v-output-display as logical   no-undo .
      217       def var v-other          as character no-undo .
      218       run holdattr-code in this-procedure
      219         (input  p-code
      220         ,output v-type
      221         ,output v-format
      222         ,output v-label
      223         ,output v-user-can-edit
      224         ,output v-output-display
      225         ,output v-other
      226         ) no-error .
      227       if error-status :error then do:
      228         undo, return error return-value .
      229       end.
      230       find first buf_hold-attr no-lock
      231         where buf_hold-attr.cat-code    = p-cat-code
      232           and buf_hold-attr.attr-code = p-code
      233         no-error .
      234       if  available buf_hold-attr then do:
      235         p-exist = yes.
      236       end.
      237     end.
      238   end procedure.
      239   procedure holdattr-delete :
      240     do
      241     on error undo, return error
      242     :
      243       define input parameter p-cat-code   like ub.hold-attr.cat-code     no-undo .
      244       define input parameter p-code     like ub.hold-attr.attr-code  no-undo .
      245       define output parameter p-deleted  as logical no-undo.
      246       define buffer buf_hold-attr for ub.hold-attr .
      247       def var v-type           as character no-undo .
      248       def var v-format         as character no-undo .
      249       def var v-label          as character no-undo .
      250       def var v-user-can-edit  as logical   no-undo .
      251       def var v-output-display as logical   no-undo .
      252       def var v-other          as character no-undo .
      253       run holdattr-code in this-procedure
      254         (input  p-code
      255         ,output v-type
      256         ,output v-format
      257         ,output v-label
      258         ,output v-user-can-edit
      259         ,output v-output-display
      260         ,output v-other
      261         ) no-error .
      262       if error-status :error then do:
      263         undo, return error return-value .
      264       end.
      265       find first buf_hold-attr exclusive-lock
      266         where buf_hold-attr.cat-code    = p-cat-code
      267           and buf_hold-attr.attr-code = p-code
      268         no-error NO-WAIT.
      269       if not available buf_hold-attr then do:
      270         p-deleted = no.
      271       end.
      272       else do:
      273         delete buf_hold-attr.
      274         p-deleted = yes.
      275       end.
      276     end.
      277   end procedure.
      278   procedure holdattr-news :
      279     do
      280     on error undo, return error
      281     :
      282       define input  parameter p-code           as character no-undo .
      283       define output parameter p-news           as logical   no-undo .
      284       case p-code :
      285               when 'begin-date':U then do:     assign     p-news = no.   end.
      286               when 'is-calc':U then do:     assign     p-news = no.   end.
      287         otherwise do:
      288           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      289         end.
      290       end.
      291     end.
      292   end procedure.
      293   do
      294   on error undo, return error return-value
      295   :
      296     if  p-cat-code <> 1
      297     and p-cat-code <> 2
      298     and p-cat-code <> 3
      299     then do:
      300       message
      301         vss-workfile vss-revision vss-description skip
      302         "Ошибка задания входных параметров" skip
      303         "Неизвестная категория межфирменных архивов" skip
      304         "Категория" p-cat-code skip
      305         view-as alert-box error .
      306       undo, return error return-value .
      307     end.
      308     if p-fact-date = ?
      309     then do:
      310       message
      311         vss-workfile vss-revision vss-description skip
      312         "Ошибка задания входных параметров" skip
      313         "Дата имеет неопределенное значение" skip
      314         view-as alert-box error .
      315       undo, return error return-value .
      316     end.
      317     define buffer calc-hold-lock_batchprocess for ub.batchprocess .
      318     run gbl/lock-prc.p
      319       (input p-lock-code
      320       ,input p-cat-code
      321       ,input 0
      322       ,input 0
      323       ,input ""
      324       ,input ""
      325       ,input ""
      326       ,input "Категория,,,,,,Расчет межфирменных архивов"
      327       ,input true
      328       ,buffer calc-hold-lock_batchprocess
      329       ) no-error .
      330     if error-status :error then do:
      331       message
      332         vss-workfile vss-revision vss-description skip
      333         "В данный момент рассчитываются межфирменные архивы" skip
      334         "Категория" p-cat-code skip
      335         "Пометить межфирменные архивы, как требующие перерасчета" skip
      336         view-as alert-box error .
      337       undo, return error .
      338     end.
      339     define variable v-hold-calc-value as character no-undo .
      340     define variable v-hold-calc-type  as character no-undo .
      341     define variable v-hold-calc       as logical   no-undo .
      342     run holdattr-value in this-procedure
      343       (input  p-cat-code
      344       ,input  'is-calc':U
      345       ,output v-hold-calc-value
      346       ,output v-hold-calc-type
      347       ) .
      348     assign
      349       v-hold-calc = (lookup(v-hold-calc-value, 'yes,true') > 0)
      350     .
      351     if v-hold-calc = true then do:
      352       return .
      353     end.
      354     define variable v-attr-begin-date-value as character no-undo .
      355     define variable v-attr-begin-date-type  as character no-undo .
      356     define variable v-attr-begin-date       as date      no-undo .
      357     assign
      358       v-attr-begin-date = ?
      359     .
      360     run holdattr-value in this-procedure
      361       (input  p-cat-code
      362       ,input  'begin-date':U
      363       ,output v-attr-begin-date-value
      364       ,output v-attr-begin-date-type
      365       ) .
      366     if v-attr-begin-date-value <> "" then do:
      367       assign
      368         v-attr-begin-date = date(v-attr-begin-date-value)
      369       .
      370     end.
      371     define variable v-start-date as date      no-undo .
      372     assign
      373       v-start-date = date(month(p-fact-date), 1, year(p-fact-date))
      374     .
      375     if  v-attr-begin-date <> ?
      376     and v-start-date < v-attr-begin-date
      377     then do:
      378       return .
      379     end.
      380     define buffer del_hold-time for ub.hold-time .
      381     find first del_hold-time exclusive-lock
      382       where del_hold-time.cat-code = p-cat-code
      383         and del_hold-time.time-type = 'мес':U
      384         and del_hold-time.start-date = v-start-date
      385       no-error .
      386     if  available del_hold-time then do:
      387     assign
      388       del_hold-time.status_ = 'удаленные':U
      389       del_hold-time.grpupdate-date = today
      390       del_hold-time.update-date = today
      391     .
      392     end.
      393   end.
