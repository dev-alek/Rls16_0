      852   define variable v-date as date no-undo .
      853   define variable v-time as integer no-undo .
      854   define variable p-news as logical no-undo.
      855   define variable p-from-gbd as logical no-undo.
      856   define variable p-from-ubd as logical no-undo.
      857   define variable v-db-list as character no-undo .
      858   define buffer locked_cash-desk-attr for ub.cash-desk-attr.
      859   define buffer buf_c-cash-desk for ub.c-cash-desk.
      860   define buffer buf_c-cash-desk-attr for ub.c-cash-desk-attr.
      861   main-block:
      862   do
      863   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      864   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      865   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      866   :
      867     if not (ub.cash-desk-attr.upper-attr-code = ""
      868     and ub.cash-desk-attr.attr-code = "") then do:
      869       if not ub.cash-desk-attr.upper-attr-code = substitute("&1_&2"
      870                                                              ,ub.cash-desk-attr.pos-type
      871                                                              , "operative") then do:
      872         FIND FIRST locked_cash-desk-attr EXCLUSIVE-LOCK WHERE
      873                   locked_cash-desk-attr.db-num = ub.cash-desk-attr.db-num
      874             AND   locked_cash-desk-attr.obj-code = ub.cash-desk-attr.obj-code
      875             AND   locked_cash-desk-attr.pos-type = ub.cash-desk-attr.pos-type
      876             AND   locked_cash-desk-attr.cash-num = ub.cash-desk-attr.cash-num
      877             AND   locked_cash-desk-attr.upper-attr-code = ''
      878             AND   locked_cash-desk-attr.attr-code = ''
      879             no-error no-wait.
      880         if locked locked_cash-desk-attr then do:
      881           undo main-block, return error substitute("Атрибут/параметр кассы занят&6" +
      882                                                   "Нет POS &1 на БД &2 &3&4 №&5"
      883                                                   , ub.cash-desk-attr.pos-type
      884                                                   , ub.cash-desk-attr.db-num
      885                                                   , 'маг':U
      886                                                   , ub.cash-desk-attr.obj-code
      887                                                   , ub.cash-desk-attr.cash-num
      888                                                   , chr(10)).
      889         end.
      890       end.
      891       run cd-attr-news in this-procedure (
      892                                             input ub.cash-desk-attr.upper-attr-code
      893                                           ,input ub.cash-desk-attr.attr-code
      894                                           ,output p-news
      895                                           ,output p-from-gbd
      896                                           ,output p-from-ubd
      897                                           ) no-error.
      898       if ub.cash-desk-attr.db-num <> g#db-num
      899       and g#db-num <> 0 then do:
      900         undo main-block, return error substitute( "&1. &2&3&4Запись об атрибуте кассе, принадлежащей другой БД, можно удалять только в ГБД&4" +
      901                                                 "&5, текущая БД &6"
      902                                                 , vss-workfile
      903                                                 , vss-revision
      904                                                 , vss-description
      905                                                 , chr(10)
      906                                                 , substitute("Касса № &1 тип &2 объект &3 БД &4 атрибут &5 секция &6"
      907                                                               ,ub.cash-desk-attr.cash-num
      908                                                               ,ub.cash-desk-attr.pos-type
      909                                                               ,ub.cash-desk-attr.obj-code
      910                                                               ,ub.cash-desk-attr.db-num
      911                                                               ,ub.cash-desk-attr.attr-code
      912                                                               ,ub.cash-desk-attr.upper-attr-code
      913                                                               )
      914                                                 , g#db-num).
      915       end.
      916       if not g#news then do:
      917         if ub.cash-desk-attr.db-num <> g#db-num
      918         and g#db-num = 0
      919         and not p-from-gbd then do:
      920         undo main-block, return error substitute( "&1. &2&3&4Запись об атрибуте кассы &7, принадлежащей БД &8, можно удалять только в БД кассы&4" +
      921                                                 "&5, текущая БД &6"
      922                                                 , vss-workfile
      923                                                 , vss-revision
      924                                                 , vss-description
      925                                                 , chr(10)
      926                                                 , substitute("Касса № &1 тип &2 объект &3 БД &4 атрибут &5 секция &6"
      927                                                               ,ub.cash-desk-attr.cash-num
      928                                                               ,ub.cash-desk-attr.pos-type
      929                                                               ,ub.cash-desk-attr.obj-code
      930                                                               ,ub.cash-desk-attr.db-num
      931                                                               ,ub.cash-desk-attr.attr-code
      932                                                               ,ub.cash-desk-attr.upper-attr-code
      933                                                               )
      934                                                 ,ub.cash-desk-attr.attr-code
      935                                                 , g#db-num
      936                                                 , ub.cash-desk-attr.db-num
      937                                                 ).
      938         end.
      939         if g#db-num = ub.cash-desk-attr.db-num
      940         and g#db-num <> 0
      941         and not p-from-ubd then do:
      942         undo main-block, return error substitute( "&1. &2&3&4Запись об атрибуте кассы &7, принадлежащей БД &8, можно менять удалять в ГБД&4" +
      943                                                 "&5, текущая БД &6"
      944                                                 , vss-workfile
      945                                                 , vss-revision
      946                                                 , vss-description
      947                                                 , chr(10)
      948                                                 , substitute("Касса № &1 тип &2 объект &3 БД &4 атрибут &5 секция &6"
      949                                                               ,ub.cash-desk-attr.cash-num
      950                                                               ,ub.cash-desk-attr.pos-type
      951                                                               ,ub.cash-desk-attr.obj-code
      952                                                               ,ub.cash-desk-attr.db-num
      953                                                               ,ub.cash-desk-attr.attr-code
      954                                                               ,ub.cash-desk-attr.upper-attr-code
      955                                                               )
      956                                                 ,ub.cash-desk-attr.attr-code
      957                                                 , g#db-num).
      958         end.
      959         run cur-time in this-procedure(output v-date, output v-time).
      960         create buf_c-cash-desk-attr.
      961         buffer-copy ub.cash-desk-attr to buf_c-cash-desk-attr
      962         assign
      963         buf_c-cash-desk-attr.chip-num           = next-value (s-cash-desk-chip, ub )
      964         buf_c-cash-desk-attr.corr-time          = v-time
      965         buf_c-cash-desk-attr.corr-user-db-num   = g#db-num
      966         buf_c-cash-desk-attr.corr-user-name     = g#userid
      967         buf_c-cash-desk-attr.corr-date          = v-date
      968         .
      969         create buf_c-cash-desk.
      970         buffer-copy buf_c-cash-desk-attr to buf_c-cash-desk
      971         assign
      972         buf_c-cash-desk.is-del             = yes
      973         buf_c-cash-desk.subject            = 'cash-desk-attr':U
      974         buf_c-cash-desk.action             = integer('99':U)
      975         .
      976       end.
      977       if g#db-num = 0 then do:
      978         if  not g#news
      979         and ub.cash-desk-attr.db-num <> 0
      980         then do:
      981           assign
      982           v-db-list = string(ub.cash-desk-attr.db-num)
      983           .
      984         end.
      985       end.
      986       if g#db-num <> 0 then do:
      987         if ub.cash-desk-attr.db-num <> 0 then
      988         assign
      989         v-db-list = string(0)
      990         .
      991       end.
      992       if v-db-list <> '':U then do:
      993         run nws/cmd-del.p
      994           ( input 'cash-desk-attr':U
      995           ,input (buffer ub.cash-desk-attr:handle)
      996           ,input v-db-list
      997           ) no-error .
      998         if error-status :error then do:
      999           undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
     1000         end.
     1001       end.
     1002         if g#oxml = yes
     1003         then do:
     1004         run str/calloxml.p (
     1005               input 'delete':U
     1006             , input 'cash-desk-attr':U
     1007             , input ( buffer ub.cash-desk-attr:handle )
     1008         ) no-error.
     1009         if error-status :error
     1010         then do:
     1011             undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
     1012                                 , chr(10)
     1013                                 , vss-workfile
     1014                                 , return-value
     1015                                 , error-status :get-message ( 1 ) ).
     1016         end.
     1017       end.
     1018     end.
     1019   end.
