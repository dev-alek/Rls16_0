        1   block-level on error undo, throw.
        2   define input parameter p-doc-num like ub.price-doc.doc-num no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Наложение блокировки на все товары переоценки".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1',p-doc-num)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define buffer buf_price-list for ub.price-list .
       69   define buffer buf_gds-obj  for ub.gds-obj .
       70   main-block :
       71   do transaction
       72   on error undo main-block, return error
       73   :
       74     for each buf_price-list no-lock
       75       where buf_price-list.doc-num    = p-doc-num
       76         and buf_price-list.main-price = true
       77     on error undo main-block, return error
       78     :
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
       81     (input  buf_price-list.obj-type
       82     ,input  buf_price-list.obj-code
       83     ,input  buf_price-list.artic
       84     ,input  buf_price-list.prod-type
       85     ,input  buf_price-list.prod-code
       86     ,buffer buf_gds-obj
       87     ) no-error .
       88       if error-status :error then do:
       89         message
       90           vss-workfile vss-revision vss-description skip
       91           "Невозможно найти gds-obj" skip
       92           "Объект" buf_price-list.obj-type buf_price-list.obj-code skip
       93           "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
       94           error-status :get-message(1) skip
       95           return-value skip
       96           view-as alert-box.
       97         undo main-block, return error .
       98       end.
       99       find current buf_gds-obj exclusive-lock .
      100       release buf_gds-obj .
      101   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
      103     (input buf_price-list.obj-type
      104     ,input buf_price-list.obj-code
      105     ,input buf_price-list.artic
      106     ,input buf_price-list.prod-type
      107     ,input buf_price-list.prod-code
      108     ,input ?
      109     ,input ''
      110     ) no-error .
      111       if error-status :error then do:
      112         message
      113           vss-workfile vss-revision vss-description skip
      114           "Ошибка при проверке целостности товара" skip
      115           "Объект" buf_price-list.obj-type buf_price-list.obj-code skip
      116           "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
      117           error-status :get-message(1) skip
      118           view-as alert-box .
      119         undo main-block, return error .
      120       end.
      121     end.
      122   end.
