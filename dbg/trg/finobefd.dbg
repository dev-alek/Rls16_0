        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.fin-ob-before.
        3   define variable  vss-revision    as character no-undo init "$Revision$":U .
        4   define variable  vss-author      as character no-undo init "$Author$":U .
        5   define variable  vss-date        as character no-undo init "$Date$":U .
        6   define variable  vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable  vss-archive     as character no-undo init "$Archive$":U .
        8   define variable  vss-description as character no-undo init "Триггер на yдаление пред финансового обязательства ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2', ub.fin-ob-before.before-code, ub.fin-ob-before.host-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   main-block :
       82   do transaction
       83   on error undo main-block, return error
       84   :
       85   define buffer other_fin-ob for fin-ob.
       86   define buffer other_fin-ob-before for fin-ob-before.
       87   define buffer other_fin-ob-trn for fin-ob-trn.
       88   define variable v-trn-code as character no-undo .
       89   define variable v-fin-ob as character no-undo .
       90   define variable v-col-fin-ob as integer no-undo .
       91   define variable v-type-pay-orig  as character no-undo .
       92   define variable v-type-pay       as character no-undo .
       93   define variable v-pay as character no-undo .
       94   define variable v-ok as logical no-undo .
       95   define variable v-not-flag as logical no-undo .
       96   define variable v-galki as logical no-undo .
       97   find first contract no-lock where  contract.contract-code = fin-ob-before.contract-code no-error .
       98   v-ok = true .
       99   if lookup ( contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)' ) > 0
      100      then
      101        assign
      102         v-type-pay-orig = "по поставке"
      103         v-pay = 'По факту поставки,Отсрочка платежа (по поставке)'
      104        .
      105      else
      106        assign
      107           v-type-pay-orig = "по реализации"
      108           v-pay = 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)'
      109        .
      110   for each fin-ob-trn no-lock where fin-ob-trn.doc-code  = fin-ob-before.before-code
      111       on error undo, return error :
      112       v-trn-code = fin-ob-trn.trn-doc-code.
      113       v-fin-ob =  "" .
      114       v-col-fin-ob =  0 .
      115           for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code  = v-trn-code and
      116                                                   other_fin-ob-trn.doc-code      <> fin-ob-before.before-code ,
      117               first other_fin-ob no-lock where other_fin-ob.doc-code  = other_fin-ob-trn.doc-code ,
      118                 first contract   no-lock where contract.contract-code = other_fin-ob.contract-code and
      119                                                lookup( contract.usl-opl , v-pay ) > 0
      120               on error undo, return error :
      121               v-fin-ob = v-fin-ob + " ФО " + string(other_fin-ob-trn.doc-code) + "," .
      122               v-col-fin-ob = v-col-fin-ob + 1.
      123           end.
      124           for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code  = v-trn-code and
      125                                                   other_fin-ob-trn.doc-code      <> fin-ob-before.before-code ,
      126               first other_fin-ob-before no-lock where other_fin-ob-before.before-code  = other_fin-ob-trn.doc-code ,
      127                 first contract   no-lock where contract.contract-code = other_fin-ob-before.contract-code and
      128                                                lookup( contract.usl-opl , v-pay ) > 0
      129               on error undo, return error :
      130               v-fin-ob = v-fin-ob + "  ПФО " + string(other_fin-ob-trn.doc-code).
      131               v-col-fin-ob = v-col-fin-ob + 1.
      132           end.
      133       if v-col-fin-ob > 0 then
      134       message "ПредФинОбязательство было создано по накладной  " v-trn-code skip
      135                "Тип оплаты : " v-type-pay-orig skip
      136                "По этой же накладной было одновременно создано еще : " v-col-fin-ob   skip
      137                "Вн. номера : " v-fin-ob                                     skip
      138                "По накладной ФО и ПФО автоматически генерируются один раз "  skip
      139                "   по одному типу оплаты (поставке или реализации)       "  skip
      140                " "                                                          skip  skip
      141                "( ДА  - удалить ПФО " fin-ob-before.before-code " , "  skip
      142                "      без возможности повторной автоматической генерации по накладной "  skip
      143                " НЕТ - не удалять ) "
      144                view-as alert-box question
      145                buttons yes-no
      146                title "Вопрос"
      147                update v-ok
      148                .
      149   end.
      150   if v-ok = false then   UNDO , RETURN ERROR.
      151       for each fin-ob-tax-before where
      152           fin-ob-tax-before.before-code  = fin-ob-before.before-code  and
      153           fin-ob-tax-before.host-code    = fin-ob-before.host-code
      154           on error undo main-block, return error
      155           :
      156             delete  fin-ob-tax-before.
      157       end.
      158       for each fin-ob-trn no-lock where
      159           fin-ob-trn.doc-code  = fin-ob-before.before-code  and
      160           fin-ob-trn.host-code = fin-ob-before.host-code
      161           on error undo main-block, return error
      162           :
      163           for each trn-doc  exclusive-lock   where
      164             trn-doc.doc-code = fin-ob-trn.trn-doc-code
      165               on error undo main-block, return error  :
      166               v-galki = true .
      167                   for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code =  fin-ob-trn.trn-doc-code and
      168                                                           other_fin-ob-trn.doc-code     <>  fin-ob-trn.doc-code ,
      169                       first other_fin-ob no-lock where other_fin-ob.doc-code  = other_fin-ob-trn.doc-code ,
      170                         first contract   no-lock where contract.contract-code = other_fin-ob.contract-code and
      171                                                       lookup( contract.usl-opl , v-pay ) > 0
      172                         on error undo, return error :
      173                         v-galki = false .
      174                   end.
      175                   for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code =  fin-ob-trn.trn-doc-code and
      176                                                           other_fin-ob-trn.doc-code     <>  fin-ob-trn.doc-code ,
      177                       first other_fin-ob-before no-lock where other_fin-ob-before.before-code  = other_fin-ob-trn.doc-code ,
      178                         first contract   no-lock where contract.contract-code = other_fin-ob-before.contract-code and
      179                                                       lookup( contract.usl-opl , v-pay ) > 0
      180                         on error undo, return error :
      181                         v-galki = false .
      182                   end.
      183                     if v-galki = true  then do:
      184                         if v-pay = 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' then do:
      185                             assign
      186                                 trn-doc.cr-expfo    = false
      187                                 trn-doc.expfo-date  = 01/01/1990
      188                             no-error .
      189                         end.
      190                         else do:
      191                             assign
      192                                 trn-doc.cr-incfo    = false
      193                                 trn-doc.incfo-date  = 01/01/1990
      194                             no-error .
      195                         end.
      196                           if error-status :error then
      197                           message vss-workfile vss-revision vss-description skip
      198                               "Ошибка корректировки накладной" skip
      199                               error-status :get-message(1)
      200                               view-as alert-box information .
      201                         if trn-doc.cr-expfo = false and
      202                            trn-doc.cr-incfo = false then do:
      203                           assign
      204                             trn-doc.cr-incorexpfo = false.
      205                         end.
      206                     end.
      207           end.
      208       end.
      209       for each fin-ob-trn where
      210           fin-ob-trn.doc-code  = fin-ob-before.before-code  and
      211           fin-ob-trn.host-code = fin-ob-before.host-code
      212           on error undo main-block, return error
      213           :
      214             delete  fin-ob-trn.
      215       end.
      216       for each fin-gds-part where
      217           fin-gds-part.fin-ob-code  = fin-ob-before.before-code  and
      218           fin-gds-part.host-code    = fin-ob-before.host-code
      219           on error undo main-block, return error
      220           :
      221             delete  fin-gds-part.
      222       end.
      223       if g#oxml = yes
      224       then do:
      225       run str/calloxml.p (
      226             input 'delete':U
      227           , input 'fin-ob-before':U
      228           , input ( buffer ub.fin-ob-before:handle )
      229       ) no-error.
      230       if error-status :error
      231       then do:
      232           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      233                                , chr(10)
      234                                , vss-workfile
      235                                , return-value
      236                                , error-status :get-message ( 1 ) ).
      237       end.
      238       end.
      239   end.
