        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.fin-statement-attr OLD oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись атрибутов банковской выписки".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3'
       29                            , ub.fin-statement-attr.host-code
       30                            , ub.fin-statement-attr.sttm-code
       31                            , ub.fin-statement-attr.attr-code)
       32       .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure cur-time :
       86      define output parameter p-today as date      no-undo .
       87      define output parameter p-time  as integer   no-undo .
       88     do
       89     on error undo, return error
       90     :
       91       define variable v-date1 as date      no-undo .
       92       define variable v-date2 as date      no-undo .
       93       define variable v-time  as integer   no-undo .
       94       assign
       95         v-date1 = today
       96         v-time  = time
       97         v-date2 = today
       98       .
       99       if v-date1 <> v-date2
      100       then do:
      101         assign
      102           v-date1 = today
      103           v-time  = v-time
      104         .
      105       end.
      106       assign
      107         p-today = v-date1
      108         p-time  = v-time
      109       .
      110     end.
      111   end.
      112   function cur-time-date returns character
      113   :
      114     return string(today, '99/99/9999':U) .
      115   end.
      116   function cur-time-mjd returns decimal
      117   :
      118     define variable v-date as date      no-undo .
      119     define variable v-time as integer   no-undo .
      120     run cur-time in this-procedure
      121       (output v-date
      122       ,output v-time
      123       ) .
      124     return integer(v-date) - 2400002 + (v-time / 86400) .
      125   end.
      126   function cur-time-get-ending-index returns integer
      127   (input p-number as integer
      128   )
      129   :
      130     if p-number < 0
      131     or p-number = ?
      132     then do:
      133       return 1 .
      134     end.
      135     define variable v-rest as integer   no-undo .
      136     assign
      137       p-number = p-number modulo 100
      138     .
      139     if p-number < 20
      140     then do:
      141       assign
      142         v-rest = p-number
      143       .
      144     end.
      145     else do:
      146       assign
      147         v-rest = p-number modulo 10
      148       .
      149     end.
      150     case v-rest :
      151       when 1
      152       then do:
      153         return 2 .
      154       end.
      155       when 2 or
      156       when 3 or
      157       when 4
      158       then do:
      159         return 3 .
      160       end.
      161       otherwise do:
      162         return 1 .
      163       end.
      164     end case .
      165   end.
      166   procedure cur-time-mjd-to-date :
      167      define input  parameter i-mjd-diff as decimal no-undo.
      168      define output parameter o-Date     as date    no-undo.
      169      define output parameter o-Time     as integer no-undo.
      170      define variable v-day-number as integer   no-undo .
      171      if    i-mjd-diff < 0
      172         or i-mjd-diff = ?
      173      then do:
      174         return "?" .
      175      end.
      176      assign
      177         v-day-number = truncate(i-mjd-diff,0).
      178         o-Date = date(v-day-number + 2400002).
      179         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      180     .
      181   end.
      182   function cur-time-mjd-to-string returns character
      183   (input p-mjd-diff as decimal
      184   )
      185   :
      186     define variable v-day-number as integer   no-undo .
      187     define variable v-seconds    as integer   no-undo .
      188     define variable v-hour       as integer   no-undo .
      189     define variable v-min        as integer   no-undo .
      190     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      191     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      192     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      193     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      194     if p-mjd-diff < 0
      195     or p-mjd-diff = ?
      196     then do:
      197       return "?" .
      198     end.
      199     assign
      200       v-day-number = integer(truncate(p-mjd-diff,0))
      201       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203     if v-seconds > 86400
      204     then do:
      205       assign
      206         v-seconds = 86400 - 1
      207       .
      208     end.
      209     if v-seconds < 0
      210     then do:
      211       assign
      212         v-seconds = 0
      213       .
      214     end.
      215     assign
      216       v-hour = truncate(v-seconds / 3600, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 3600
      220     .
      221     assign
      222       v-min = truncate(v-seconds / 60, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 60
      226     .
      227     return
      228         (if v-day-number <> 0
      229           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0
      233           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      237           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      238           else ""
      239         )
      240       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      241       .
      242   end.
      243   function cur-time-string returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      252   end.
      253   function cur-time-string-sec returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      262   end.
      263   function cur-time-custom  returns character
      264   (input p-prefix as character
      265   ,input p-date-format as character
      266   ,input p-delimiter as character
      267   ,input p-time-format as character
      268   ,input p-suffix as character
      269   )
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return
      278       p-prefix
      279       + string(v-date, p-date-format)
      280       + p-delimiter
      281       + string(v-time, p-time-format)
      282       + p-suffix
      283       .
      284   end.
      285   function cur-time-print  returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      294   end.
      295   function cur-time-datetime returns datetime
      296   :
      297     define variable v-char as character no-undo .
      298     define variable v-datetime as datetime no-undo .
      299     v-char = cur-time-string().
      300     v-datetime = datetime(v-char).
      301     return  v-datetime.
      302   end.
      303   function cur-time-string-msec returns character
      304   :
      305     define variable v-date as datetime  no-undo .
      306     v-date = now.
      307     return string(v-date) .
      308   end.
      309   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   procedure fs-attr-code :
      311     do
      312     on error undo, return error
      313     :
      314       define input  parameter p-code           as character no-undo .
      315       define output parameter p-type           as character no-undo .
      316       define output parameter p-format         as character no-undo .
      317       define output parameter p-label          as character no-undo .
      318       define output parameter p-user-can-edit  as logical   no-undo .
      319       define output parameter p-output-display as logical   no-undo .
      320       define output parameter p-other          as character no-undo .
      321       case p-code :
      322         otherwise do:
      323           undo, return error "неизвестный атрибут выписки" + " " + p-code .
      324         end.
      325       end.
      326     end.
      327   end procedure.
      328   procedure fs-attr-tooltip :
      329     do
      330     on error undo, return error
      331     :
      332       define input  parameter p-code    as character no-undo .
      333       define output parameter p-tooltip as character no-undo .
      334       define output parameter p-label   as character no-undo .
      335       case p-code :
      336         otherwise do:
      337           undo, return error "неизвестный атрибут выписки" + " " + p-code .
      338         end.
      339       end.
      340     end.
      341   end procedure.
      342   procedure fin-statement-attr-write :
      343    do
      344    on error undo, return error return-value
      345    :
      346   define input parameter p-host-code     like ub.fin-statement-attr.host-code  no-undo .
      347   define input parameter p-sttm-code  like ub.fin-statement-attr.sttm-code   no-undo .
      348   define input parameter p-attr-code     like ub.fin-statement-attr.attr-code  no-undo .
      349   define input parameter p-attr-value    like ub.fin-statement-attr.attr-value no-undo .
      350   define variable  v-format         as character no-undo .
      351   define variable  v-label          as character no-undo .
      352   define variable  v-user-can-edit  as logical   no-undo .
      353   define variable  v-output-display as logical   no-undo .
      354   define variable  v-other          as character no-undo .
      355   define variable  v-type           as character no-undo .
      356   define buffer buf_fin-statement-attr for ub.fin-statement-attr.
      357   run fs-attr-code in this-procedure
      358                                     (input  p-attr-code
      359                                     ,output v-type
      360                                     ,output v-format
      361                                     ,output v-label
      362                                     ,output v-user-can-edit
      363                                     ,output v-output-display
      364                                     ,output v-other
      365                                     ) no-error .
      366   if error-status :error then do:
      367     undo, return error return-value .
      368   end.
      369   find first buf_fin-statement-attr  exclusive-lock  where
      370             buf_fin-statement-attr.attr-code    = p-attr-code
      371         AND buf_fin-statement-attr.host-code    = p-host-code
      372         AND buf_fin-statement-attr.sttm-code     = p-sttm-code  no-error .
      373     if not available  buf_fin-statement-attr then do:
      374         create buf_fin-statement-attr.
      375         assign
      376         buf_fin-statement-attr.attr-code    = p-attr-code
      377         buf_fin-statement-attr.attr-value   = p-attr-value
      378         buf_fin-statement-attr.host-code    = p-host-code
      379         buf_fin-statement-attr.sttm-code     = p-sttm-code
      380         .
      381     end.
      382     else do:
      383           buf_fin-statement-attr.attr-value   = p-attr-value .
      384     end.
      385    end.
      386   end procedure.
      387   procedure fs-attr-exist :
      388     do
      389     on error undo, return error
      390     :
      391       define input parameter p-host-code     like ub.fin-statement-attr.host-code  no-undo .
      392       define input parameter p-sttm-code  like ub.fin-statement-attr.sttm-code   no-undo .
      393       define input parameter p-code          like ub.fin-statement-attr.attr-code  no-undo .
      394       define output parameter p-exist   as logical  no-undo .
      395       define buffer buf_fin-statement-attr for ub.fin-statement-attr .
      396       def var v-type           as character no-undo .
      397       def var v-format         as character no-undo .
      398       def var v-label          as character no-undo .
      399       def var v-user-can-edit  as logical   no-undo .
      400       def var v-output-display as logical   no-undo .
      401       def var v-other          as character no-undo .
      402       run fs-attr-code in this-procedure
      403         (input  p-code
      404         ,output v-type
      405         ,output v-format
      406         ,output v-label
      407         ,output v-user-can-edit
      408         ,output v-output-display
      409         ,output v-other
      410         ) no-error .
      411       if error-status :error then do:
      412         undo, return error return-value .
      413       end.
      414       find first buf_fin-statement-attr exclusive-lock
      415         where buf_fin-statement-attr.host-code  = p-host-code
      416           and buf_fin-statement-attr.sttm-code  = p-sttm-code
      417           and buf_fin-statement-attr.attr-code = p-code
      418         no-error .
      419       if  available buf_fin-statement-attr then do:
      420         p-exist = yes.
      421       end.
      422     end.
      423   end procedure.
      424   procedure fs-attr-delete :
      425     do
      426     on error undo, return error
      427     :
      428     define input parameter p-host-code     like ub.fin-statement-attr.host-code  no-undo .
      429     define input parameter p-sttm-code  like ub.fin-statement-attr.sttm-code   no-undo .
      430     define input parameter p-code          like ub.fin-statement-attr.attr-code  no-undo .
      431     define output parameter p-deleted  as logical no-undo.
      432       define buffer buf_fin-statement-attr for ub.fin-statement-attr .
      433       def var v-type           as character no-undo .
      434       def var v-format         as character no-undo .
      435       def var v-label          as character no-undo .
      436       def var v-user-can-edit  as logical   no-undo .
      437       def var v-output-display as logical   no-undo .
      438       def var v-other          as character no-undo .
      439       run fs-attr-code in this-procedure
      440         (input  p-code
      441         ,output v-type
      442         ,output v-format
      443         ,output v-label
      444         ,output v-user-can-edit
      445         ,output v-output-display
      446         ,output v-other
      447         ) no-error .
      448       if error-status :error then do:
      449         undo, return error return-value .
      450       end.
      451       find first buf_fin-statement-attr exclusive-lock
      452         where buf_fin-statement-attr.host-code  = p-host-code
      453           and buf_fin-statement-attr.sttm-code  = p-sttm-code
      454           and buf_fin-statement-attr.attr-code = p-code
      455         no-error NO-WAIT.
      456       if not available buf_fin-statement-attr then do:
      457         p-deleted = no.
      458       end.
      459       else do:
      460         delete buf_fin-statement-attr no-error .
      461         if error-status:error then do:
      462           undo, return error return-value .
      463         end.
      464         p-deleted = yes.
      465       end.
      466     end.
      467   end procedure.
      468   procedure fin-statement-attr-value :
      469    do
      470    on error undo, return error return-value
      471    :
      472   define input  parameter p-host-code    like ub.fin-statement-attr.host-code    no-undo .
      473   define input  parameter p-sttm-code like ub.fin-statement-attr.sttm-code     no-undo .
      474   define input  parameter p-attr-code    like ub.fin-statement-attr.attr-code    no-undo .
      475   define output parameter p-attr-value   like ub.fin-statement-attr.attr-value   no-undo .
      476   define variable  v-format         as character no-undo .
      477   define variable  v-label          as character no-undo .
      478   define variable  v-user-can-edit  as logical   no-undo .
      479   define variable  v-output-display as logical   no-undo .
      480   define variable  v-other          as character no-undo .
      481   define variable  v-type           as character no-undo .
      482   define buffer buf_fin-statement-attr for ub.fin-statement-attr.
      483   run fs-attr-code in this-procedure
      484     (input  p-attr-code
      485     ,output v-type
      486     ,output v-format
      487     ,output v-label
      488     ,output v-user-can-edit
      489     ,output v-output-display
      490     ,output v-other
      491     ) no-error .
      492   if error-status :error then do:
      493     undo, return error return-value .
      494   end.
      495   find first buf_fin-statement-attr no-lock where
      496             buf_fin-statement-attr.attr-code    = p-attr-code
      497         AND buf_fin-statement-attr.host-code     = p-host-code
      498         AND buf_fin-statement-attr.sttm-code = p-sttm-code      no-error .
      499     if available  buf_fin-statement-attr then do:
      500       assign
      501       p-attr-value = buf_fin-statement-attr.attr-value
      502       .
      503     end.
      504     else do:
      505       p-attr-value = ? .
      506     end.
      507    end.
      508   end procedure.
      509   procedure fs-attr-news :
      510     do
      511     on error undo, return error
      512     :
      513       define input  parameter p-code           as character no-undo .
      514       define output parameter p-news           as logical   no-undo .
      515       case p-code :
      516         otherwise do:
      517           undo, return error "неизвестный атрибут выписки " + " " + p-code .
      518         end.
      519       end.
      520     end.
      521   end procedure.
      522   procedure c-fin-statement-attr-write :
      523    do
      524    on error undo, return error return-value
      525    :
      526   define input parameter p-host-code     like ub.c-fin-statement-attr.host-code  no-undo .
      527   define input parameter p-sttm-code  like ub.c-fin-statement-attr.sttm-code   no-undo .
      528   define input parameter p-corr-user-db-num  like ub.c-fin-statement-attr.corr-user-db-num   no-undo .
      529   define input parameter p-chip-num      like ub.c-fin-statement-attr.chip-num   no-undo .
      530   define input parameter p-attr-code     like ub.c-fin-statement-attr.attr-code  no-undo .
      531   define input parameter p-attr-value    like ub.c-fin-statement-attr.attr-value no-undo .
      532   define variable  v-format         as character no-undo .
      533   define variable  v-label          as character no-undo .
      534   define variable  v-user-can-edit  as logical   no-undo .
      535   define variable  v-output-display as logical   no-undo .
      536   define variable  v-other          as character no-undo .
      537   define variable  v-type           as character no-undo .
      538   define buffer buf_c-fin-statement-attr for ub.c-fin-statement-attr.
      539   run fs-attr-code in this-procedure
      540                                     (input  p-attr-code
      541                                     ,output v-type
      542                                     ,output v-format
      543                                     ,output v-label
      544                                     ,output v-user-can-edit
      545                                     ,output v-output-display
      546                                     ,output v-other
      547                                     ) no-error .
      548   if error-status :error then do:
      549     undo, return error return-value .
      550   end.
      551   find first buf_c-fin-statement-attr  exclusive-lock  where
      552             buf_c-fin-statement-attr.attr-code    = p-attr-code
      553         AND buf_c-fin-statement-attr.host-code    = p-host-code
      554         AND buf_c-fin-statement-attr.sttm-code     = p-sttm-code
      555         AND buf_c-fin-statement-attr.corr-user-db-num = p-corr-user-db-num
      556         AND buf_c-fin-statement-attr.chip-num         = p-chip-num      no-error .
      557     if not available  buf_c-fin-statement-attr then do:
      558         create buf_c-fin-statement-attr.
      559         assign
      560         buf_c-fin-statement-attr.attr-code    = p-attr-code
      561         buf_c-fin-statement-attr.attr-value   = p-attr-value
      562         buf_c-fin-statement-attr.host-code    = p-host-code
      563         buf_c-fin-statement-attr.sttm-code     = p-sttm-code
      564         .
      565     end.
      566     else do:
      567           buf_c-fin-statement-attr.attr-value   = p-attr-value .
      568     end.
      569    end.
      570   end procedure.
      571   procedure c-fin-statement-attr-value :
      572    do
      573    on error undo, return error return-value
      574    :
      575   define input  parameter p-host-code    like ub.c-fin-statement-attr.host-code    no-undo .
      576   define input  parameter p-sttm-code like ub.c-fin-statement-attr.sttm-code     no-undo .
      577   define input parameter  p-corr-user-db-num  like ub.c-fin-statement-attr.corr-user-db-num   no-undo .
      578   define input parameter  p-chip-num      like ub.c-fin-statement-attr.chip-num   no-undo .
      579   define input  parameter p-attr-code    like ub.c-fin-statement-attr.attr-code    no-undo .
      580   define output parameter p-attr-value   like ub.c-fin-statement-attr.attr-value   no-undo .
      581   define variable  v-format         as character no-undo .
      582   define variable  v-label          as character no-undo .
      583   define variable  v-user-can-edit  as logical   no-undo .
      584   define variable  v-output-display as logical   no-undo .
      585   define variable  v-other          as character no-undo .
      586   define variable  v-type           as character no-undo .
      587   define buffer buf_c-fin-statement-attr for ub.c-fin-statement-attr.
      588   run fs-attr-code in this-procedure
      589     (input  p-attr-code
      590     ,output v-type
      591     ,output v-format
      592     ,output v-label
      593     ,output v-user-can-edit
      594     ,output v-output-display
      595     ,output v-other
      596     ) no-error .
      597   if error-status :error then do:
      598     undo, return error return-value .
      599   end.
      600   find first buf_c-fin-statement-attr no-lock where
      601             buf_c-fin-statement-attr.attr-code    = p-attr-code
      602         AND buf_c-fin-statement-attr.sttm-code      = p-sttm-code
      603         AND buf_c-fin-statement-attr.host-code      = p-host-code
      604         AND buf_c-fin-statement-attr.corr-user-db-num = p-corr-user-db-num
      605         AND buf_c-fin-statement-attr.chip-num         = p-chip-num      no-error .
      606     if available  buf_c-fin-statement-attr then do:
      607       assign
      608       p-attr-value = buf_c-fin-statement-attr.attr-value
      609       .
      610     end.
      611     else do:
      612       p-attr-value = ? .
      613     end.
      614    end.
      615   end procedure.
      616   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617   procedure write-fin-statement-attr-trigger :
      618   define input parameter p-new-record as logical no-undo .
      619   define variable v-date as date no-undo .
      620   define variable v-time as integer no-undo .
      621   define buffer buf_c-fin-statement-attr for ub.c-fin-statement-attr.
      622     do
      623     on error undo, return error
      624     :
      625       run cur-time in this-procedure(output v-date, output v-time).
      626       create buf_c-fin-statement-attr.
      627       buffer-copy oldb to buf_c-fin-statement-attr
      628       assign
      629       buf_c-fin-statement-attr.host-code          = (if p-new-record then ub.fin-statement-attr.host-code else oldb.host-code)
      630       buf_c-fin-statement-attr.sttm-code          = (if p-new-record then ub.fin-statement-attr.sttm-code else oldb.sttm-code)
      631       buf_c-fin-statement-attr.attr-code          = (if p-new-record then ub.fin-statement-attr.attr-code else oldb.attr-code)
      632       buf_c-fin-statement-attr.chip-num           = next-value (s-fin-corr-chip, ub)
      633       buf_c-fin-statement-attr.corr-time          = v-time
      634       buf_c-fin-statement-attr.corr-user-db-num   = g#db-num
      635       buf_c-fin-statement-attr.corr-user-name     = g#userid
      636       buf_c-fin-statement-attr.corr-date          = v-date
      637       .
      638       release buf_c-fin-statement-attr.
      639     end.
      640   end procedure.
      641   procedure write-fin-statement-attr-proc :
      642   define parameter buffer buf_fin-statement-attr for ub.fin-statement-attr.
      643   define variable v-date as date no-undo .
      644   define variable v-time as integer no-undo .
      645   define buffer buf_c-fin-statement-attr for ub.c-fin-statement-attr.
      646     do
      647     on error undo, return error
      648     :
      649       if not available buf_fin-statement-attr then do:
      650         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      651                       "Ошибка задания входных параметров:Не определен атрибут выписки" ).
      652       end.
      653       run cur-time in this-procedure(output v-date, output v-time).
      654       create buf_c-fin-statement-attr.
      655       buffer-copy buf_fin-statement-attr to buf_c-fin-statement-attr
      656       assign
      657       buf_c-fin-statement-attr.chip-num           = next-value (s-fin-corr-chip, ub)
      658       buf_c-fin-statement-attr.corr-time          = v-time
      659       buf_c-fin-statement-attr.corr-user-db-num   = g#db-num
      660       buf_c-fin-statement-attr.corr-user-name     = g#userid
      661       buf_c-fin-statement-attr.corr-date          = v-date
      662       .
      663       release buf_c-fin-statement-attr.
      664     end.
      665   end procedure.
      666   define variable p-news as logical no-undo.
      667   main-block:
      668   do
      669   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      670   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      671   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      672   :
      673     run fs-attr-news  in this-procedure (
      674                                           input ub.fin-statement-attr.attr-code
      675                                          ,output p-news) no-error.
      676     if  p-news then do:
      677       run str/callnews.p
      678         ( input "fin-statement-attr"
      679          ,input (buffer ub.fin-statement-attr:handle)
      680         ) .
      681     end.
      682     run write-fin-statement-attr-trigger in this-procedure (
      683                                input (if new(ub.fin-statement-attr) then yes else no)).
      684       if g#oxml = yes
      685       then do:
      686       run str/calloxml.p (
      687             input 'update':U
      688           , input 'fin-statement-attr':U
      689           , input ( buffer ub.fin-statement-attr:handle )
      690       ) no-error.
      691       if error-status :error
      692       then do:
      693           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      694                                , chr(10)
      695                                , vss-workfile
      696                                , return-value
      697                                , error-status :get-message ( 1 ) ).
      698       end.
      699       end.
      700   end.
