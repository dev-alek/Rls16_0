        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-inkas old buffer old-c-inkas .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись истории продажи".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3',ub.c-inkas.inkas-code,ub.c-inkas.chip-num,ub.c-inkas.status_)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable v-host-code like c-inkas.host-code no-undo.
       82   main-block:
       83   do
       84   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       85   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       86   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
       87     find first ub.clients no-lock
       88       where ub.clients.obj-type = ub.c-inkas.obj-type
       89         and ub.clients.obj-code = ub.c-inkas.obj-code
       90       no-error .
       91     if not available ub.clients then do:
       92       message
       93         vss-workfile vss-revision vss-description skip
       94         "Неправильная ссылка на объект" skip
       95         "Продажа" ub.c-inkas.inkas-code skip
       96         "Не найден объект" ub.c-inkas.obj-type ub.c-inkas.obj-code skip
       97         view-as alert-box error .
       98       undo main-block, return error .
       99     end.
      100   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      102     (input  ub.c-inkas.obj-type
      103     ,input  ub.c-inkas.obj-code
      104     ,output v-host-code
      105     ) no-error .
      106     if error-status :error then do:
      107       message
      108        vss-workfile vss-revision vss-description skip
      109        "Ошика при определении кода фирмы для объекта" skip
      110        "Продажа" ub.c-inkas.inkas-code skip
      111        "obj-type" ub.c-inkas.obj-type skip
      112        "obj-code" ub.c-inkas.obj-code skip
      113        error-status :get-message(1) skip
      114        return-value skip
      115        view-as alert-box error .
      116       undo main-block, return error .
      117     end.
      118     if ub.c-inkas.host-code <> v-host-code then do:
      119       message
      120         vss-workfile vss-revision vss-description skip
      121         "Неправильно заполнено поле фирма" skip
      122         "Продажа" ub.c-inkas.inkas-code skip
      123         "Объект"  ub.c-inkas.obj-type ub.c-inkas.obj-code skip
      124         "Фирма"   ub.c-inkas.host-code skip
      125         "Должна быть фирма" v-host-code skip
      126         view-as alert-box error .
      127       undo main-block, return error .
      128     end.
      129     if  not g#news
      130     and ub.c-inkas.corr-user-name = "" then do:
      131       assign
      132         ub.c-inkas.corr-user-name = g#userid
      133       .
      134     end.
      135     if not g#news
      136     and ub.c-inkas.status_ = 'факт':U
      137     then do:
      138       run str/callnews.p (
      139           input 'c-inkas':U
      140          ,input (buffer ub.c-inkas:handle)
      141          ) no-error .
      142       if error-status :error then do:
      143         message
      144           vss-workfile vss-revision vss-description skip
      145           "Невозможно маршрутизировать c-inkas для отправки в новости" skip
      146           error-status :get-message(1) skip
      147           return-value skip
      148           view-as alert-box error .
      149         undo, return error .
      150       end.
      151     end.
      152       if g#oxml = yes
      153       then do:
      154       run str/calloxml.p (
      155             input 'update':U
      156           , input 'c-inkas':U
      157           , input ( buffer ub.c-inkas:handle )
      158       ) no-error.
      159       if error-status :error
      160       then do:
      161           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      162                                , chr(10)
      163                                , vss-workfile
      164                                , return-value
      165                                , error-status :get-message ( 1 ) ).
      166       end.
      167       end.
      168   end.
