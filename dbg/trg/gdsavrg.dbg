      332     when 'Прих-объект':U then do:
      333       if buf_goods.gds-type = 'т':U then do:
      334         find first buf_gds-obj no-lock
      335           where buf_gds-obj.obj-type  = p-obj-type
      336             and buf_gds-obj.obj-code  = p-obj-code
      337             and buf_gds-obj.artic     = p-artic
      338             and buf_gds-obj.prod-type = p-prod-type
      339             and buf_gds-obj.prod-code = p-prod-code
      340           no-error .
      341         if available buf_gds-obj then do:
