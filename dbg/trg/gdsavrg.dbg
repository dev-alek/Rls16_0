      365         "Недопустимое значение аргумента p-price-type" p-price-type skip
      366         "Артикул" p-artic p-prod-type p-prod-code skip
      367         view-as alert-box error .
      368       undo, return error .
      369     end.
      370   end case.
      371   if p-price-base = 0 then do:
      372     assign
      373       p-price-base = ?
      374     .
      375   end.
      376   if p-price-rubl = 0 then do:
      377     assign
      378       p-price-rubl = ?
      379     .
      380   end.
      381   if (p-price-base = ?) <> (p-price-rubl = ?) then do:
      382     message
