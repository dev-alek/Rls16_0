        1   block-level on error undo, throw.
        2   define input parameter  p-price-type as character no-undo .
        3   define input parameter  p-obj-type   like ub.gds-obj.obj-type   no-undo .
        4   define input parameter  p-obj-code   like ub.gds-obj.obj-code   no-undo .
        5   define input parameter  p-host-code  like ub.gds-obj.host-code no-undo .
        6   define input parameter  p-artic      like ub.gds-obj.artic      no-undo .
        7   define input parameter  p-prod-type  like ub.gds-obj.prod-type  no-undo .
        8   define input parameter  p-prod-code  like ub.gds-obj.prod-code  no-undo .
        9   define output parameter p-price-base like ub.gds-obj.avrg-base no-undo .
       10   define output parameter p-price-rubl like ub.gds-obj.avrg-rubl no-undo .
       11   define output parameter p-tax-road-base like ub.gds-obj.avrg-base no-undo .
       12   define output parameter p-tax-road-rubl like ub.gds-obj.avrg-rubl no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
       14   define variable vss-author      as character no-undo init "$Author$":U .
       15   define variable vss-date        as character no-undo init "$Date$":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       17   define variable vss-archive     as character no-undo init "$Archive$":U .
       18   define variable vss-description as character no-undo init "Процедура определения средней учетной цены товара по различным схемам".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define buffer buf_goods   for ub.goods .
       89   define buffer buf_gds-obj for ub.gds-obj .
       90   define variable v-total-avrg-base as decimal no-undo .
       91   define variable v-total-avrg-rubl as decimal no-undo .
       92   define variable v-total-avrg-qnty as decimal no-undo .
       93   define variable v-last-in-code  like ub.gds-obj.in-code  no-undo .
       94   define variable v-last-obj-type like ub.gds-obj.obj-type no-undo .
       95   define variable v-last-obj-code like ub.gds-obj.obj-code no-undo .
       96   find first buf_goods no-lock
       97     where buf_goods.artic     = p-artic
       98       and buf_goods.prod-type = p-prod-type
       99       and buf_goods.prod-code = p-prod-code
      100     no-error .
      101   if not available buf_goods then do:
      102     message
      103       vss-workfile vss-revision vss-description skip
      104       "Не найден товар" skip
      105       "Артикул" p-artic p-prod-type p-prod-code skip
      106       view-as alert-box .
      107     undo, return error .
      108   end.
      109   case p-price-type :
      110     when 'Учетная':U then do:
      111       if buf_goods.gds-type = 'т':U then do:
      112         if p-host-code = 0
      113         or p-host-code = ? then do:
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      116     (input  p-obj-type
      117     ,input  p-obj-code
      118     ,output p-host-code
      119     ) no-error .
      120           if error-status:error then do:
      121             message
      122               vss-workfile vss-revision vss-description skip
      123               "Невозможно найти фирму для объекта " p-obj-type p-obj-code skip
      124               error-status :get-message(1) skip
      125               return-value skip
      126               view-as alert-box error .
      127             undo, return error .
      128           end.
      129         end.
      130         assign
      131           v-total-avrg-base = 0
      132           v-total-avrg-rubl = 0
      133           v-total-avrg-qnty = 0
      134         .
      135         for each buf_gds-obj no-lock
      136           where buf_gds-obj.host-code = p-host-code
      137             and buf_gds-obj.artic     = p-artic
      138             and buf_gds-obj.prod-type = p-prod-type
      139             and buf_gds-obj.prod-code = p-prod-code
      140         on error undo, return error
      141         :
      142           if buf_gds-obj.avrg-base > 0 then do:
      143             assign
      144               v-total-avrg-base = v-total-avrg-base
      145                                 + (buf_gds-obj.avrg-base * buf_gds-obj.avrg-qnty)
      146               v-total-avrg-rubl = v-total-avrg-rubl
      147                                 + (buf_gds-obj.avrg-rubl * buf_gds-obj.avrg-qnty)
      148               v-total-avrg-qnty = v-total-avrg-qnty
      149                                 + buf_gds-obj.avrg-qnty
      150             .
      151           end.
      152         end.
      153         if v-total-avrg-qnty > 0 then do:
      154           assign
      155             p-price-base = v-total-avrg-base / v-total-avrg-qnty
      156             p-price-rubl = v-total-avrg-rubl / v-total-avrg-qnty
      157           .
      158         end.
      159         else do:
      160   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lastindc in g#library
      162     (input  p-host-code
      163     ,input  p-artic
      164     ,input  p-prod-type
      165     ,input  p-prod-code
      166     ,output v-last-in-code
      167     ,output v-last-obj-type
      168     ,output v-last-obj-code
      169     )  .
      170           find first buf_gds-obj no-lock
      171             where buf_gds-obj.obj-type  = v-last-obj-type
      172               and buf_gds-obj.obj-code  = v-last-obj-code
      173               and buf_gds-obj.artic     = p-artic
      174               and buf_gds-obj.prod-type = p-prod-type
      175               and buf_gds-obj.prod-code = p-prod-code
      176             no-error .
      177           if available buf_gds-obj then do:
      178             assign
      179               p-price-base = buf_gds-obj.last-base
      180               p-price-rubl = buf_gds-obj.last-rubl
      181             .
      182           end.
      183           else do:
      184                 find first buf_gds-obj no-lock
      185                   where buf_gds-obj.obj-type  = p-obj-type
      186                     and buf_gds-obj.obj-code  = p-obj-code
      187                     and buf_gds-obj.artic     = p-artic
      188                     and buf_gds-obj.prod-type = p-prod-type
      189                     and buf_gds-obj.prod-code = p-prod-code
      190                   no-error .
      191                 if available buf_gds-obj then do:
      192                   assign
      193                     p-price-base = buf_gds-obj.last-base
      194                     p-price-rubl = buf_gds-obj.last-rubl
      195                   .
      196                 end.
      197           end.
      198         end.
      199       end.
      200       else do:
      201         assign
      202           p-price-base = ?
      203           p-price-rubl = ?
      204         .
      205       end.
      206     end.
      207     when 'Учет-объект':U then do:
      208       find first buf_gds-obj no-lock
      209         where buf_gds-obj.obj-type  = p-obj-type
      210           and buf_gds-obj.obj-code  = p-obj-code
      211           and buf_gds-obj.artic     = p-artic
      212           and buf_gds-obj.prod-type = p-prod-type
      213           and buf_gds-obj.prod-code = p-prod-code
      214         no-error .
      215       if available buf_gds-obj then do:
      216         if buf_goods.gds-type = 'т':U then do:
      217           if buf_gds-obj.avrg-qnty > 0 then do:
      218             assign
      219               p-price-base = buf_gds-obj.avrg-base
      220               p-price-rubl = buf_gds-obj.avrg-rubl
      221             .
      222           end.
      223           else do:
      224             assign
      225               p-price-base = buf_gds-obj.last-base
      226               p-price-rubl = buf_gds-obj.last-rubl
      227             .
      228           end.
      229         end.
      230         else do:
      231           assign
      232             p-price-base = buf_gds-obj.price-base
      233             p-price-rubl = buf_gds-obj.price-rubl
      234           .
      235         end.
      236       end.
      237     end.
      238     when 'Учет-резерв':U then do:
      239       if buf_goods.gds-type = 'т':U then do:
      240         define buffer buf_parts for ub.parts .
      241         for each buf_parts no-lock
      242           where buf_parts.obj-type  = p-obj-type
      243             and buf_parts.obj-code  = p-obj-code
      244             and buf_parts.artic     = p-artic
      245             and buf_parts.prod-type = p-prod-type
      246             and buf_parts.prod-code = p-prod-code
      247             and buf_parts.status_   = no
      248             and buf_parts.out-code  = 'free-zone':U
      249             and buf_parts.qnty      > 0
      250         on error undo, return error
      251         :
      252             assign
      253             v-total-avrg-base = v-total-avrg-base
      254                               + (buf_parts.price-base * buf_parts.qnty)
      255             v-total-avrg-rubl = v-total-avrg-rubl
      256                               + (buf_parts.price-rubl * buf_parts.qnty)
      257             v-total-avrg-qnty = v-total-avrg-qnty
      258                               + buf_parts.qnty
      259           .
      260         end.
      261         if v-total-avrg-qnty > 0 then do:
      262           assign
      263             p-price-base = v-total-avrg-base / v-total-avrg-qnty
      264             p-price-rubl = v-total-avrg-rubl / v-total-avrg-qnty
      265           .
      266         end.
      267         else do:
      268           find first buf_gds-obj no-lock
      269             where buf_gds-obj.obj-type  = p-obj-type
      270               and buf_gds-obj.obj-code  = p-obj-code
      271               and buf_gds-obj.artic     = p-artic
      272               and buf_gds-obj.prod-type = p-prod-type
      273               and buf_gds-obj.prod-code = p-prod-code
      274             no-error .
      275           if available buf_gds-obj then do:
      276             assign
      277               p-price-base = buf_gds-obj.last-base
      278               p-price-rubl = buf_gds-obj.last-rubl
      279             .
      280           end.
      281         end.
      282       end.
      283       else do:
      284         find first buf_gds-obj no-lock
      285           where buf_gds-obj.obj-type  = p-obj-type
      286             and buf_gds-obj.obj-code  = p-obj-code
      287             and buf_gds-obj.artic     = p-artic
      288             and buf_gds-obj.prod-type = p-prod-type
      289             and buf_gds-obj.prod-code = p-prod-code
      290           no-error .
      291         if available buf_gds-obj then do:
      292           assign
      293             p-price-base = buf_gds-obj.price-base
      294             p-price-rubl = buf_gds-obj.price-rubl
      295           .
      296         end.
      297         else do:
      298           assign
      299             p-price-base = ?
      300             p-price-rubl = ?
      301           .
      302         end.
      303       end.
      304     end.
      305     when 'Приходная':U then do:
      306       if buf_goods.gds-type = 'т':U then do:
      307   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lastindc in g#library
      309     (input  p-host-code
      310     ,input  p-artic
      311     ,input  p-prod-type
      312     ,input  p-prod-code
      313     ,output v-last-in-code
      314     ,output v-last-obj-type
      315     ,output v-last-obj-code
      316     )  .
      317         find first buf_gds-obj no-lock
      318           where buf_gds-obj.obj-type  = v-last-obj-type
      319             and buf_gds-obj.obj-code  = v-last-obj-code
      320             and buf_gds-obj.artic     = p-artic
      321             and buf_gds-obj.prod-type = p-prod-type
      322             and buf_gds-obj.prod-code = p-prod-code
      323           no-error .
      324         if available buf_gds-obj then do:
