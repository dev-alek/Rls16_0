        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.dis-dc-rule OLD olddis-dc-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись в таблице dis-dc-rule".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8'
       29                            , ub.dis-dc-rule.d-card
       30                           , ub.dis-dc-rule.host-code
       31                           , ub.dis-dc-rule.obj-type
       32                           , ub.dis-dc-rule.obj-code
       33                           , ub.dis-dc-rule.pos-type
       34                           , ub.dis-dc-rule.discnt-role
       35                           , ub.dis-dc-rule.nonunique
       36                            )
       37       .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure cur-time :
       91      define output parameter p-today as date      no-undo .
       92      define output parameter p-time  as integer   no-undo .
       93     do
       94     on error undo, return error
       95     :
       96       define variable v-date1 as date      no-undo .
       97       define variable v-date2 as date      no-undo .
       98       define variable v-time  as integer   no-undo .
       99       assign
      100         v-date1 = today
      101         v-time  = time
      102         v-date2 = today
      103       .
      104       if v-date1 <> v-date2
      105       then do:
      106         assign
      107           v-date1 = today
      108           v-time  = v-time
      109         .
      110       end.
      111       assign
      112         p-today = v-date1
      113         p-time  = v-time
      114       .
      115     end.
      116   end.
      117   function cur-time-date returns character
      118   :
      119     return string(today, '99/99/9999':U) .
      120   end.
      121   function cur-time-mjd returns decimal
      122   :
      123     define variable v-date as date      no-undo .
      124     define variable v-time as integer   no-undo .
      125     run cur-time in this-procedure
      126       (output v-date
      127       ,output v-time
      128       ) .
      129     return integer(v-date) - 2400002 + (v-time / 86400) .
      130   end.
      131   function cur-time-get-ending-index returns integer
      132   (input p-number as integer
      133   )
      134   :
      135     if p-number < 0
      136     or p-number = ?
      137     then do:
      138       return 1 .
      139     end.
      140     define variable v-rest as integer   no-undo .
      141     assign
      142       p-number = p-number modulo 100
      143     .
      144     if p-number < 20
      145     then do:
      146       assign
      147         v-rest = p-number
      148       .
      149     end.
      150     else do:
      151       assign
      152         v-rest = p-number modulo 10
      153       .
      154     end.
      155     case v-rest :
      156       when 1
      157       then do:
      158         return 2 .
      159       end.
      160       when 2 or
      161       when 3 or
      162       when 4
      163       then do:
      164         return 3 .
      165       end.
      166       otherwise do:
      167         return 1 .
      168       end.
      169     end case .
      170   end.
      171   procedure cur-time-mjd-to-date :
      172      define input  parameter i-mjd-diff as decimal no-undo.
      173      define output parameter o-Date     as date    no-undo.
      174      define output parameter o-Time     as integer no-undo.
      175      define variable v-day-number as integer   no-undo .
      176      if    i-mjd-diff < 0
      177         or i-mjd-diff = ?
      178      then do:
      179         return "?" .
      180      end.
      181      assign
      182         v-day-number = truncate(i-mjd-diff,0).
      183         o-Date = date(v-day-number + 2400002).
      184         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186   end.
      187   function cur-time-mjd-to-string returns character
      188   (input p-mjd-diff as decimal
      189   )
      190   :
      191     define variable v-day-number as integer   no-undo .
      192     define variable v-seconds    as integer   no-undo .
      193     define variable v-hour       as integer   no-undo .
      194     define variable v-min        as integer   no-undo .
      195     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      196     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      197     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      198     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      199     if p-mjd-diff < 0
      200     or p-mjd-diff = ?
      201     then do:
      202       return "?" .
      203     end.
      204     assign
      205       v-day-number = integer(truncate(p-mjd-diff,0))
      206       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      207     .
      208     if v-seconds > 86400
      209     then do:
      210       assign
      211         v-seconds = 86400 - 1
      212       .
      213     end.
      214     if v-seconds < 0
      215     then do:
      216       assign
      217         v-seconds = 0
      218       .
      219     end.
      220     assign
      221       v-hour = truncate(v-seconds / 3600, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 3600
      225     .
      226     assign
      227       v-min = truncate(v-seconds / 60, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 60
      231     .
      232     return
      233         (if v-day-number <> 0
      234           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0
      238           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      239           else ""
      240         )
      241       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      242           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      243           else ""
      244         )
      245       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      246       .
      247   end.
      248   function cur-time-string returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      257   end.
      258   function cur-time-string-sec returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      267   end.
      268   function cur-time-custom  returns character
      269   (input p-prefix as character
      270   ,input p-date-format as character
      271   ,input p-delimiter as character
      272   ,input p-time-format as character
      273   ,input p-suffix as character
      274   )
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return
      283       p-prefix
      284       + string(v-date, p-date-format)
      285       + p-delimiter
      286       + string(v-time, p-time-format)
      287       + p-suffix
      288       .
      289   end.
      290   function cur-time-print  returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-datetime returns datetime
      301   :
      302     define variable v-char as character no-undo .
      303     define variable v-datetime as datetime no-undo .
      304     v-char = cur-time-string().
      305     v-datetime = datetime(v-char).
      306     return  v-datetime.
      307   end.
      308   function cur-time-string-msec returns character
      309   :
      310     define variable v-date as datetime  no-undo .
      311     v-date = now.
      312     return string(v-date) .
      313   end.
      314   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      315   procedure disdcruh_write-dis-dc-rule-trigger :
      316   define input parameter p-new-record as logical no-undo .
      317   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      318   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      319   define variable v-date as date      no-undo.
      320   define variable v-time  as integer   no-undo.
      321   define buffer buf_c-dc-hist for ub.c-dc-hist.
      322   define buffer buf_c-dis-dc-rule for ub.c-dis-dc-rule.
      323     do
      324     on error undo, return error
      325     :
      326       run cur-time in this-procedure(output v-date, output v-time).
      327       create buf_c-dis-dc-rule.
      328       buffer-copy olddis-dc-rule to buf_c-dis-dc-rule
      329       assign
      330       buf_c-dis-dc-rule.d-card             = ub.dis-dc-rule.d-card
      331       buf_c-dis-dc-rule.card-num           = ub.dis-dc-rule.card-num
      332       buf_c-dis-dc-rule.obj-type           = ub.dis-dc-rule.obj-type
      333       buf_c-dis-dc-rule.obj-code           = ub.dis-dc-rule.obj-code
      334       buf_c-dis-dc-rule.host-code          = ub.dis-dc-rule.host-code
      335       buf_c-dis-dc-rule.pos-type           = ub.dis-dc-rule.pos-type
      336       buf_c-dis-dc-rule.discnt-role        = ub.dis-dc-rule.discnt-role
      337       buf_c-dis-dc-rule.nonunique          = ub.dis-dc-rule.nonunique
      338       buf_c-dis-dc-rule.chip-num           = next-value (s-dc-chip, ub)
      339       buf_c-dis-dc-rule.corr-time          = v-time
      340       buf_c-dis-dc-rule.corr-user-db-num   = g#db-num
      341       buf_c-dis-dc-rule.corr-user-name     = (if g#news
      342                                               then (chr(4) +  'СПН':U)
      343                                               else (if g#esys
      344                                                    then (chr(4) +  'ВС':U)
      345                                                    else g#userid
      346                                                    )
      347                                               )
      348       buf_c-dis-dc-rule.corr-date          = v-date
      349       .
      350       create buf_c-dc-hist.
      351       buffer-copy buf_c-dis-dc-rule to buf_c-dc-hist
      352       assign
      353       buf_c-dc-hist.action = (if p-new-record then integer('1':U) else integer('2':U))
      354       buf_c-dc-hist.subject = 'dis-dc-rule':U
      355       buf_c-dc-hist.is-news  = g#news
      356       buf_c-dc-hist.source-type = p-source-type
      357       buf_c-dc-hist.source-ref =  p-source-ref
      358       .
      359     end.
      360   end procedure.
      361   procedure disdcruh_write-dis-dc-rule-proc :
      362   define input parameter p-d-card      like ub.c-dis-dc-rule.d-card no-undo .
      363   define input parameter p-card-num    like ub.c-dis-dc-rule.card-num no-undo .
      364   define input parameter p-host-code   like ub.c-dis-dc-rule.host-code no-undo .
      365   define input parameter p-obj-type    like ub.c-dis-dc-rule.obj-type  no-undo .
      366   define input parameter p-obj-code    like ub.c-dis-dc-rule.obj-code  no-undo .
      367   define input parameter p-pos-type    like ub.c-dis-dc-rule.pos-type  no-undo .
      368   define input parameter p-discnt-role  like ub.c-dis-dc-rule.discnt-role no-undo .
      369   define input parameter p-nonunique   like ub.c-dis-dc-rule.nonunique no-undo .
      370   define input parameter p-action      as integer no-undo .
      371   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      372   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      373   define variable v-date as date      no-undo.
      374   define variable v-time  as integer   no-undo.
      375   define buffer buf_c-dc-hist for ub.c-dc-hist.
      376   define buffer buf_c-dis-dc-rule for ub.c-dis-dc-rule.
      377     do
      378     on error undo, return error
      379     :
      380       run cur-time in this-procedure(output v-date, output v-time).
      381       create buf_c-dis-dc-rule.
      382       assign
      383       buf_c-dis-dc-rule.d-card             = p-d-card
      384       buf_c-dis-dc-rule.card-num           = p-card-num
      385       buf_c-dis-dc-rule.obj-type           = p-obj-type
      386       buf_c-dis-dc-rule.obj-code           = p-obj-code
      387       buf_c-dis-dc-rule.host-code          = p-host-code
      388       buf_c-dis-dc-rule.pos-type           = p-pos-type
      389       buf_c-dis-dc-rule.discnt-role        = p-discnt-role
      390       buf_c-dis-dc-rule.nonunique          = p-nonunique
      391       buf_c-dis-dc-rule.chip-num           = next-value (s-dc-chip, ub)
      392       buf_c-dis-dc-rule.corr-time          = v-time
      393       buf_c-dis-dc-rule.corr-user-db-num   = g#db-num
      394       buf_c-dis-dc-rule.corr-user-name     = (if g#news
      395                                               then (chr(4) +  'СПН':U)
      396                                               else (if g#esys
      397                                                    then (chr(4) +  'ВС':U)
      398                                                    else g#userid
      399                                                    )
      400                                               )
      401       buf_c-dis-dc-rule.corr-date          = v-date
      402       .
      403       create buf_c-dc-hist.
      404       buffer-copy buf_c-dis-dc-rule to buf_c-dc-hist
      405       assign
      406       buf_c-dc-hist.action = p-action
      407       buf_c-dc-hist.subject = 'dis-dc-rule':U
      408       buf_c-dc-hist.is-news  = g#news
      409       buf_c-dc-hist.source-type = p-source-type
      410       buf_c-dc-hist.source-ref =  p-source-ref
      411       .
      412     end.
      413   end procedure.
      414   define variable conf-par as character no-undo .
      415   define variable par-type as character no-undo .
      416   define variable v-date as date no-undo .
      417   define variable v-time as integer no-undo .
      418   define variable v-host-code like ub.sysconf.host-code no-undo .
      419   define variable v-manual-editing as integer no-undo .
      420   define buffer buf_c-dis-dc-rule for ub.c-dis-dc-rule.
      421   define buffer buf_c-dc-hist for ub.c-dc-hist.
      422   define buffer locked_dis-dc-rule for ub.dis-dc-rule.
      423   main-block:
      424   do
      425   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      426   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      427   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      428   :
      429     if not ub.dis-dc-rule.templ-rl-root = 0 then do:
      430       Find first locked_dis-dc-rule exclusive-lock  where
      431               locked_dis-dc-rule.d-card    = ub.dis-dc-rule.d-card
      432           AND locked_dis-dc-rule.obj-type  = '':U
      433           AND locked_dis-dc-rule.obj-code  = 0
      434           AND locked_dis-dc-rule.host-code = 0
      435           and locked_dis-dc-rule.pos-type = '':U
      436           and locked_dis-dc-rule.discnt-role = '':U
      437           and locked_dis-dc-rule.nonunique = '':U
      438           no-error no-wait.
      439       if locked locked_dis-dc-rule then
      440       undo main-block, return error substitute("СКИДКА по ДК карта &1 место использ. &2 тип скидки &3 занята"
      441                                                 , ub.dis-dc-rule.d-card
      442                                                 , ub.dis-dc-rule.pos-type
      443                                                 , entry (lookup (ub.dis-dc-rule.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)
      444                                                 ).
      445     end.
      446     if ub.dis-dc-rule.obj-type  = '':U
      447           AND ub.dis-dc-rule.obj-code  = 0
      448           AND ub.dis-dc-rule.host-code = 0
      449           and ub.dis-dc-rule.pos-type = '':U
      450           and ub.dis-dc-rule.discnt-role = '':U
      451           and ub.dis-dc-rule.nonunique = '':U then do:
      452    end.
      453    else do:
      454   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   define variable send-ref as logical no-undo.
      456   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      457     (input  'send-ref'
      458     ,input  0
      459     ,input  ''
      460     ,input  0
      461     ,input  ''
      462     ,input  ''
      463     ,input  ''
      464     ,input  no
      465     ,output conf-par
      466     ,output par-type
      467     ) no-error .
      468     send-ref = (IF error-status:error or conf-par <> "yes" then no else yes).
      469       if send-ref and not g#news then do:
      470         run trg/nu_dcard.p (
      471                       input  ub.dis-dc-rule.d-card
      472                       ,input  ub.dis-dc-rule.host-code
      473                       ,input  "":U
      474                       ,input  0
      475                       ,input  "U":U
      476                     ).
      477       end.
      478         run disdcruh_write-dis-dc-rule-trigger in this-procedure  (
      479                                             input new(ub.dis-dc-rule)
      480                                           ,input (if g#news
      481                                                   then 'db':U
      482                                                   else (if g#esys
      483                                                         then 'esys':U
      484                                                         else "":U)
      485                                                   )
      486                                           ,input  (if g#news
      487                                                     then string(g#news-source-db)
      488                                                     else (if g#esys
      489                                                           then string(g#esys-source-esys)
      490                                                           else "":U)
      491                                                     )
      492                                           ) .
      493       run str/callnews.p
      494         ( input 'dis-dc-rule':U
      495         ,input (buffer ub.dis-dc-rule:handle )
      496         ) no-error .
      497       if error-status:error then undo main-block, return error return-value .
      498       if g#oxml = yes
      499       then do:
      500         run str/calloxml.p (
      501               input 'update':U
      502             , input 'dis-dc-rule':U
      503             , input ( buffer ub.dis-dc-rule:handle )
      504         ) no-error.
      505         if error-status :error
      506         then do:
      507             undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      508                                 , chr(10)
      509                                 , vss-workfile
      510                                 , return-value
      511                                 , error-status :get-message ( 1 ) ).
      512         end.
      513       end.
      514     end.
      515   end.
