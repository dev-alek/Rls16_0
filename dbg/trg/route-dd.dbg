        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.route-dump .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление записи маршрутизации".
        9   do
       10   on error undo, return error
       11   :
       12     define buffer buf_route-dump-link for ub.route-dump-link .
       13     for each buf_route-dump-link
       14       where buf_route-dump-link.dump-ord = ub.route-dump.dump-ord
       15         and buf_route-dump-link.rec-ord  = ub.route-dump.rec-ord
       16     on error undo, return error
       17     :
       18       delete buf_route-dump-link.
       19     end.
       20   end.
