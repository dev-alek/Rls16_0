        1   block-level on error undo, throw.
        2   define input  parameter p-handle-callback    as handle    no-undo .
        3   define input  parameter p-obj-type           as character no-undo .
        4   define input  parameter p-obj-code           as integer   no-undo .
        5   define input  parameter p-new-start-date     as date      no-undo .
        6   define input  parameter p-current-start-date as date      no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Расчет остатков складском архиве по поставщикам на основании текущих остатков товара".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31       assign
       32         p-vss-parameters = substitute('&1|&2|&3|&4|&5':u,p-handle-callback,p-obj-type,p-obj-code,p-new-start-date,p-current-start-date)
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure cur-time :
       87      define output parameter p-today as date      no-undo .
       88      define output parameter p-time  as integer   no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       define variable v-date1 as date      no-undo .
       93       define variable v-date2 as date      no-undo .
       94       define variable v-time  as integer   no-undo .
       95       assign
       96         v-date1 = today
       97         v-time  = time
       98         v-date2 = today
       99       .
      100       if v-date1 <> v-date2
      101       then do:
      102         assign
      103           v-date1 = today
      104           v-time  = v-time
      105         .
      106       end.
      107       assign
      108         p-today = v-date1
      109         p-time  = v-time
      110       .
      111     end.
      112   end.
      113   function cur-time-date returns character
      114   :
      115     return string(today, '99/99/9999':U) .
      116   end.
      117   function cur-time-mjd returns decimal
      118   :
      119     define variable v-date as date      no-undo .
      120     define variable v-time as integer   no-undo .
      121     run cur-time in this-procedure
      122       (output v-date
      123       ,output v-time
      124       ) .
      125     return integer(v-date) - 2400002 + (v-time / 86400) .
      126   end.
      127   function cur-time-get-ending-index returns integer
      128   (input p-number as integer
      129   )
      130   :
      131     if p-number < 0
      132     or p-number = ?
      133     then do:
      134       return 1 .
      135     end.
      136     define variable v-rest as integer   no-undo .
      137     assign
      138       p-number = p-number modulo 100
      139     .
      140     if p-number < 20
      141     then do:
      142       assign
      143         v-rest = p-number
      144       .
      145     end.
      146     else do:
      147       assign
      148         v-rest = p-number modulo 10
      149       .
      150     end.
      151     case v-rest :
      152       when 1
      153       then do:
      154         return 2 .
      155       end.
      156       when 2 or
      157       when 3 or
      158       when 4
      159       then do:
      160         return 3 .
      161       end.
      162       otherwise do:
      163         return 1 .
      164       end.
      165     end case .
      166   end.
      167   procedure cur-time-mjd-to-date :
      168      define input  parameter i-mjd-diff as decimal no-undo.
      169      define output parameter o-Date     as date    no-undo.
      170      define output parameter o-Time     as integer no-undo.
      171      define variable v-day-number as integer   no-undo .
      172      if    i-mjd-diff < 0
      173         or i-mjd-diff = ?
      174      then do:
      175         return "?" .
      176      end.
      177      assign
      178         v-day-number = truncate(i-mjd-diff,0).
      179         o-Date = date(v-day-number + 2400002).
      180         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      181     .
      182   end.
      183   function cur-time-mjd-to-string returns character
      184   (input p-mjd-diff as decimal
      185   )
      186   :
      187     define variable v-day-number as integer   no-undo .
      188     define variable v-seconds    as integer   no-undo .
      189     define variable v-hour       as integer   no-undo .
      190     define variable v-min        as integer   no-undo .
      191     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      192     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      193     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      194     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      195     if p-mjd-diff < 0
      196     or p-mjd-diff = ?
      197     then do:
      198       return "?" .
      199     end.
      200     assign
      201       v-day-number = integer(truncate(p-mjd-diff,0))
      202       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204     if v-seconds > 86400
      205     then do:
      206       assign
      207         v-seconds = 86400 - 1
      208       .
      209     end.
      210     if v-seconds < 0
      211     then do:
      212       assign
      213         v-seconds = 0
      214       .
      215     end.
      216     assign
      217       v-hour = truncate(v-seconds / 3600, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 3600
      221     .
      222     assign
      223       v-min = truncate(v-seconds / 60, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 60
      227     .
      228     return
      229         (if v-day-number <> 0
      230           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0
      234           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      238           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      239           else ""
      240         )
      241       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      242       .
      243   end.
      244   function cur-time-string returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      253   end.
      254   function cur-time-string-sec returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      263   end.
      264   function cur-time-custom  returns character
      265   (input p-prefix as character
      266   ,input p-date-format as character
      267   ,input p-delimiter as character
      268   ,input p-time-format as character
      269   ,input p-suffix as character
      270   )
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return
      279       p-prefix
      280       + string(v-date, p-date-format)
      281       + p-delimiter
      282       + string(v-time, p-time-format)
      283       + p-suffix
      284       .
      285   end.
      286   function cur-time-print  returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-datetime returns datetime
      297   :
      298     define variable v-char as character no-undo .
      299     define variable v-datetime as datetime no-undo .
      300     v-char = cur-time-string().
      301     v-datetime = datetime(v-char).
      302     return  v-datetime.
      303   end.
      304   function cur-time-string-msec returns character
      305   :
      306     define variable v-date as datetime  no-undo .
      307     v-date = now.
      308     return string(v-date) .
      309   end.
      310   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      312   procedure factord :
      313     define input  parameter p-fact-date            as date    no-undo .
      314     define input  parameter p-fact-time            as integer no-undo .
      315     define input  parameter p-fact-num             as integer no-undo .
      316     define input  parameter p-shift-date           as date    no-undo .
      317     define input  parameter p-shift-num            as integer no-undo .
      318     define input  parameter p-shift-on             as logical no-undo .
      319     define output parameter p-fact-order           as decimal no-undo .
      320     define output parameter p-shift-end-fact-order as decimal no-undo .
      321     define output parameter p-day-end-fact-order   as decimal no-undo .
      322     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      323     if p-fact-date = ?
      324     then do:
      325       return error "Не указана фактическая дата" .
      326     end.
      327     define variable v-fact-date-num as integer no-undo .
      328     assign
      329       v-fact-date-num = integer(p-fact-date)
      330     .
      331     if p-fact-num = ?
      332     or p-fact-num = 0
      333     then do:
      334       return error "Не задан p-fact-num " + string(p-fact-num) .
      335     end.
      336     if p-fact-num < 0
      337     then do:
      338       return error "Отрицательный fact-num " + string(p-fact-num) .
      339     end.
      340     if p-fact-num >= 100000000
      341     then do:
      342       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      343     end.
      344     if p-shift-on = true
      345     then do:
      346       if p-shift-date = ?
      347       then do:
      348         return error "Не задана дата смены" .
      349       end.
      350       if p-shift-num = ?
      351       or p-shift-num = 0
      352       then do:
      353         return error "Не задан номер смены" .
      354       end.
      355     end.
      356     else do:
      357       assign
      358         p-shift-date = p-fact-date
      359         p-shift-num  = 24
      360       .
      361     end.
      362     define variable v-shift-offset as integer no-undo .
      363     if p-shift-date = p-fact-date
      364     then do:
      365       assign
      366         v-shift-offset = 1
      367       .
      368     end.
      369     if p-shift-date < p-fact-date
      370     then do:
      371       assign
      372         v-shift-offset = 0
      373       .
      374     end.
      375     if p-shift-date > p-fact-date
      376     then do:
      377       message
      378         vss-workfile vss-revision vss-description skip
      379         "Неправильная дата закрытия смены" skip
      380         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      381         view-as alert-box error .
      382       undo, return error
      383         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      384           ,string(p-fact-date, '99/99/9999':U)
      385           ,string(p-shift-date, '99/99/9999':U)
      386           )
      387       .
      388     end.
      389     if p-shift-num < 1
      390     or p-shift-num > 24
      391     then do:
      392       message
      393         vss-workfile vss-revision vss-description skip
      394         "Неправильный номер смены" skip
      395         "p-shift-num" p-shift-num skip
      396         view-as alert-box error .
      397       undo, return error return-value .
      398     end.
      399     assign
      400       p-fact-order           = v-fact-date-num
      401                              + v-shift-offset * 0.5
      402                              + p-shift-num    * 0.02 - 0.01
      403                              + p-fact-num     * 0.0000000001
      404       p-shift-end-fact-order = v-fact-date-num
      405                              + v-shift-offset * 0.5
      406                              + p-shift-num    * 0.02
      407       p-day-end-fact-order   = v-fact-date-num
      408                              + 0.99
      409     .
      410     if p-fact-order           <= v-fact-date-num
      411     or p-shift-end-fact-order <= v-fact-date-num
      412     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      413     or p-shift-end-fact-order >= p-day-end-fact-order
      414     then do:
      415       message
      416         vss-workfile vss-revision vss-description skip
      417         "Внутренняя ошибка при генерации фактического номера" skip
      418         "p-fact-date"            p-fact-date            skip
      419         "p-fact-time"            p-fact-time            skip
      420         "p-fact-num"             p-fact-num             skip
      421         "p-shift-date"           p-shift-date           skip
      422         "p-shift-num"            p-shift-num            skip
      423         "p-shift-on"             p-shift-on             skip
      424         "p-shift-end-fact-order" p-shift-end-fact-order skip
      425         "p-day-end-fact-order"   p-day-end-fact-order   skip
      426         "v-fact-date-num"        v-fact-date-num        skip
      427         view-as alert-box error .
      428       undo, return error return-value .
      429     end.
      430   end procedure.
      431   procedure day-begin-fact-order :
      432     define input  parameter p-fact-date            as date    no-undo .
      433     define output parameter p-day-begin-fact-order as decimal no-undo .
      434     do
      435     on error undo, return error return-value
      436     :
      437       if p-fact-date = ?
      438       then do:
      439         assign
      440           p-day-begin-fact-order = 0
      441         .
      442       end.
      443       else do:
      444         assign
      445           p-day-begin-fact-order = integer(p-fact-date)
      446         .
      447       end.
      448     end.
      449   end procedure.
      450   procedure factord-max-fact-order :
      451     define output parameter p-max-fact-order as decimal   no-undo .
      452     do
      453     on error undo, return error return-value
      454     :
      455       run day-begin-fact-order in this-procedure
      456         (input  date(1, 1, 5000)
      457         ,output p-max-fact-order
      458         ) .
      459     end.
      460   end procedure.
      461   procedure factord-cut-archive :
      462     define input  parameter p-obj-type             as character no-undo .
      463     define input  parameter p-obj-code             as integer   no-undo .
      464     define input  parameter p-fact-date            as date      no-undo .
      465     define output parameter p-shift-on             as logical   no-undo .
      466     define output parameter p-shift-date           as date      no-undo .
      467     define output parameter p-shift-num            as integer   no-undo .
      468     define output parameter p-day-end-fact-order   as decimal   no-undo .
      469     define output parameter p-shift-end-fact-order as decimal   no-undo .
      470     define variable v-fact-order as decimal   no-undo .
      471     define buffer buf_shift-obj for ub.shift-obj .
      472     do
      473     on error undo, return error return-value
      474     :
      475   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      477     (input  p-obj-type
      478     ,input  p-obj-code
      479     ,input  'shift-on=request'
      480     ,output p-shift-on
      481     ) no-error .
      482       if error-status :error
      483       then do:
      484         message
      485           vss-workfile vss-revision vss-description skip
      486           "Ошибка при определении атрибута объекта" skip
      487           "Объект" p-obj-type p-obj-code skip
      488           error-status :get-message(1) skip
      489           return-value skip
      490           view-as alert-box error .
      491         undo, return error return-value .
      492       end.
      493       if p-shift-on = false
      494       then do:
      495         assign
      496           p-shift-date               = ?
      497           p-shift-num                = 0
      498         .
      499       end.
      500       else do:
      501         find first buf_shift-obj share-lock
      502           where buf_shift-obj.obj-type   = p-obj-type
      503             and buf_shift-obj.obj-code   = p-obj-code
      504             and buf_shift-obj.shift-date > p-fact-date
      505           use-index pi
      506           no-error .
      507         if not available buf_shift-obj
      508         or buf_shift-obj.status_ <> 'зкр':U
      509         then do:
      510           message
      511             vss-workfile vss-revision vss-description skip
      512             "Невозможно вычислить последнюю смену" skip
      513             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      514             "Объект" p-obj-type p-obj-code skip
      515             "Дата" p-fact-date skip
      516             view-as alert-box error .
      517           undo, return error return-value .
      518         end.
      519         find last buf_shift-obj share-lock
      520           where buf_shift-obj.obj-type = p-obj-type
      521             and buf_shift-obj.obj-code = p-obj-code
      522             and buf_shift-obj.shift-date <= p-fact-date
      523           use-index pi
      524           no-error .
      525         if available buf_shift-obj
      526         then do:
      527           if  buf_shift-obj.status_ = 'зкр':U
      528           then do:
      529             assign
      530               p-shift-date = buf_shift-obj.shift-date
      531               p-shift-num  = buf_shift-obj.shift-num
      532             .
      533           end.
      534           else do:
      535             message
      536               vss-workfile vss-revision vss-description skip
      537               "Невозможно вычислить последнюю смену" skip
      538               "Статус смены отличен от статуса" 'зкр':U skip
      539               "Объект" p-obj-type p-obj-code skip
      540               "Дата" p-fact-date skip
      541               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      542               view-as alert-box error .
      543             undo, return error return-value .
      544           end.
      545         end.
      546         else do:
      547           assign
      548             p-shift-date = p-fact-date - 1
      549             p-shift-num  = 1
      550           .
      551         end.
      552       end.
      553       run factord in this-procedure
      554         (input  p-fact-date
      555         ,input  1
      556         ,input  1
      557         ,input  p-shift-date
      558         ,input  p-shift-num
      559         ,input  p-shift-on
      560         ,output v-fact-order
      561         ,output p-shift-end-fact-order
      562         ,output p-day-end-fact-order
      563         ) no-error .
      564       if error-status :error
      565       then do:
      566         message
      567           vss-workfile vss-revision vss-description skip
      568           "Ошибка при вызове процедуры factord"
      569           error-status :get-message(1) skip
      570           return-value skip
      571           view-as alert-box error .
      572         undo, return error return-value .
      573       end.
      574     end.
      575   end procedure.
      576   procedure factord-lock-shift :
      577     define input  parameter p-obj-type  as character no-undo .
      578     define input  parameter p-obj-code  as integer   no-undo .
      579     define input  parameter p-fact-date as date      no-undo .
      580     define parameter buffer buf_shift-obj for ub.shift-obj .
      581     define variable v-shift-on      as logical   no-undo .
      582     define variable v-extra-message as character no-undo .
      583     define variable v-error as character no-undo .
      584     do
      585     on error undo, return error return-value
      586     :
      587   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      589     (input  p-obj-type
      590     ,input  p-obj-code
      591     ,input  'shift-on=request'
      592     ,output v-shift-on
      593     ) no-error .
      594       if error-status :error
      595       then do:
      596         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      597         undo, return error v-error .
      598       end.
      599       if v-shift-on = true
      600       then do:
      601         find first buf_shift-obj share-lock
      602           where buf_shift-obj.obj-type   = p-obj-type
      603             and buf_shift-obj.obj-code   = p-obj-code
      604             and buf_shift-obj.shift-date > p-fact-date
      605           use-index pi
      606           no-error .
      607         if not available buf_shift-obj
      608         or buf_shift-obj.status_ <> 'зкр':U
      609         then do:
      610           find last buf_shift-obj
      611             where buf_shift-obj.obj-type = p-obj-type
      612               and buf_shift-obj.obj-code = p-obj-code
      613               and buf_shift-obj.status_  = 'зкр':U
      614             use-index stts
      615             no-error .
      616           if available buf_shift-obj
      617           then do:
      618             assign
      619               v-extra-message =
      620                     substitute("Дата начала последеней закрытой смены на объекте &1"
      621                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      622                               )
      623             .
      624           end.
      625           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      626           undo, return error v-error .
      627         end.
      628       end.
      629     end.
      630   end procedure.
      631   procedure factord-end-day :
      632     define input  parameter p-fact-date            as date    no-undo .
      633     define output parameter p-day-end-fact-order   as decimal no-undo .
      634     do
      635     on error undo, return error return-value
      636     :
      637       if p-fact-date = ?
      638       then do:
      639         return error "Не указана фактическая дата" .
      640       end.
      641       assign
      642         p-day-end-fact-order = integer(p-fact-date) + 0.99
      643       .
      644     end.
      645   end procedure.
      646   procedure factord-to-date :
      647     define input  parameter p-fact-order as decimal no-undo .
      648     define output parameter p-fact-date  as date    no-undo .
      649     define variable v-ref-date  as date      no-undo .
      650     define variable v-ref-delta as integer   no-undo .
      651     do
      652     on error undo, return error return-value
      653     :
      654       if p-fact-order = ?
      655       or p-fact-order = 0
      656       then do:
      657         return error "Не указан fact-order" .
      658       end.
      659       assign
      660         v-ref-date  = date(1, 1, 2000)
      661       .
      662       assign
      663         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      664       .
      665       assign
      666         p-fact-date = v-ref-date + v-ref-delta
      667       .
      668     end.
      669   end procedure.
      670   procedure factord-to-fact-num :
      671     define input  parameter p-fact-order as decimal no-undo .
      672     define output parameter p-fact-num   as integer no-undo .
      673     define variable v-fact-order-trunc as decimal no-undo .
      674     do
      675     on error undo, return error return-value
      676     :
      677       if p-fact-order = ?
      678       or p-fact-order = 0
      679       then do:
      680         return error "Не указан fact-order" .
      681       end.
      682       assign
      683        v-fact-order-trunc = truncate(p-fact-order, 2)
      684       .
      685       assign
      686         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      687       .
      688     end.
      689   end procedure.
      690   procedure factord-to-shift-num :
      691     define input  parameter p-fact-order as decimal no-undo .
      692     define output parameter p-shift-num   as integer no-undo .
      693     define variable  p-shift-numd  as decimal   no-undo .
      694     define variable v-fact-order-trunc as decimal no-undo .
      695     do
      696     on error undo, return error return-value
      697     :
      698       if p-fact-order = ?
      699       or p-fact-order = 0
      700       then do:
      701         return error "Не указан fact-order" .
      702       end.
      703       assign
      704        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      705       .
      706       if v-fact-order-trunc < 0.5 then do:
      707         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      708       end.
      709       assign
      710         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      711         .
      712        assign
      713         p-shift-num = truncate (p-shift-numd , 0)
      714       .
      715     end.
      716   end procedure.
