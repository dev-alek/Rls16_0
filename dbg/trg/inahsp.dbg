     2430     ,input  buf_gds-obj.gds-code
     2431     ,input  'close':U
     2432     ,input  buf_gds-obj.fact-qnty
     2433     ,input  buf_gds-obj.fact-cli-qnty
     2434     ,input  buf_gds-obj.fact-base
     2435     ,input  buf_gds-obj.fact-rubl
     2436     ,input  buf_gds-obj.fact-sale
     2437     ,input  v-old-fact-qnty
     2438     ,input  v-old-fact-cli-qnty
     2439     ,input  v-old-fact-base
