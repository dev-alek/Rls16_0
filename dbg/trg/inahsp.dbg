     2370         then do:
     2371           message
     2372             vss-workfile vss-revision vss-description skip
     2373             vss-include-info9 skip
     2374             "Ошибка при закрытии переоценки" skip
     2375             "Несовпадают текущие количества по корневому признаку" skip
     2376             "и количество признака в переоценке" skip
     2377             "Переоценка" v-doc-num skip
     2378             "Артикул" p-artic p-prod-type p-prod-code skip
     2379             "Код признака" buf_temp-prt-obj.prt-code skip
     2380             "Количество по признаку" buf_temp-prt-obj.fact-qnty skip
     2381             "Количество по переоценке" buf_temp-prt-obj.price-list-qnty skip
     2382             view-as alert-box error .
     2383           undo, return error .
     2384         end.
     2385       end.
     2386       assign
     2387         v-total-fact-sale = v-total-fact-sale
     2388                           + buf_temp-prt-obj.fact-qnty * buf_temp-prt-obj.price-sale
     2389       .
     2390       if v-total-fact-sale = ?
     2391       then do:
     2392         message
     2393           vss-workfile vss-revision vss-description skip
     2394           vss-include-info9 skip
     2395           "Ошибка при вычислении суммы в продажных ценах" skip
     2396           "Получено неопределенное значение" skip
     2397           "Переоценка" v-doc-num skip
     2398           "Артикул" p-artic p-prod-type p-prod-code skip
     2399           "Код признака" buf_temp-prt-obj.prt-code skip
     2400           "Сумма в продажных ценах" v-total-fact-sale skip
     2401           view-as alert-box error .
     2402         undo, return error .
     2403       end.
     2404       define variable v-old-fact-qnty     as decimal   no-undo .
     2405       define variable v-old-fact-cli-qnty as decimal   no-undo .
     2406       define variable v-old-fact-base     as decimal   no-undo .
     2407       define variable v-old-fact-rubl     as decimal   no-undo .
     2408       define variable v-old-fact-sale     as decimal   no-undo .
     2409       assign
     2410         v-old-fact-qnty     = buf_gds-obj.fact-qnty
     2411         v-old-fact-cli-qnty = buf_gds-obj.fact-cli-qnty
     2412         v-old-fact-base     = buf_gds-obj.fact-base
     2413         v-old-fact-rubl     = buf_gds-obj.fact-rubl
     2414         v-old-fact-sale     = buf_gds-obj.fact-sale
     2415       .
     2416       assign
     2417         buf_gds-obj.price-sale = v-price-sale
     2418         buf_gds-obj.fact-sale  = v-total-fact-sale
     2419       .
     2420       define variable v-corr-date as date      no-undo .
     2421       define variable v-corr-time as integer   no-undo .
     2422       run cur-time in this-procedure
     2423         (output v-corr-date
     2424         ,output v-corr-time
     2425         ) .
