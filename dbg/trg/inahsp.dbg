     4097       end.
     4098     end.
     4099   end procedure.
     4100   procedure partslib-update-by-factord :
     4101     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     4102     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     4103     define input parameter p-artic              like ub.parts.artic     no-undo .
     4104     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     4105     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     4106     define input parameter p-start-fact-order   as decimal   no-undo .
     4107     define input parameter p-end-fact-order     as decimal   no-undo .
     4108     define input parameter p-lock-gds-obj       as logical   no-undo .
     4109     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     4110     define buffer buf_gds-obj  for ub.gds-obj .
     4111     define buffer buf_doc-line for ub.doc-line .
     4112     define variable v-total-parts-qnty as decimal   no-undo .
     4113     define variable v-goods-gds-goods  as logical   no-undo .
     4114     define variable v-goods-twounit    as logical   no-undo .
     4115     do
     4116     on error undo, return error
     4117     :
     4118       if p-start-fact-order > p-end-fact-order
     4119       then do:
     4120         message
     4121           vss-workfile vss-revision vss-description skip
     4122           vss-include-info26 skip
     4123           "Ошибка задания входных параметров" skip
     4124           "Начало интервала превышает конец интервала" skip
     4125           "Объект" p-obj-type p-obj-code skip
     4126           "Артикул" p-artic p-prod-type p-prod-code skip
     4127           "p-start-fact-order" p-start-fact-order skip
     4128           "p-end-fact-order"   p-end-fact-order skip
     4129           view-as alert-box error .
     4130         undo, return error .
     4131       end.
     4132       if p-lock-gds-obj = true
     4133       then do:
     4134         do transaction
     4135         on error undo, return error
     4136         :
     4137   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4138   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     4139     (input  p-obj-type
     4140     ,input  p-obj-code
     4141     ,input  p-artic
     4142     ,input  p-prod-type
     4143     ,input  p-prod-code
     4144     ,buffer buf_gds-obj
     4145     ) no-error .
     4146           if error-status :error
     4147           then do:
     4148             message
     4149               vss-workfile vss-revision vss-description skip
     4150               vss-include-info26 skip
     4151               "Невозможно найти gds-obj" skip
     4152               error-status :get-message(1) skip
     4153               return-value skip
     4154               view-as alert-box error .
     4155             undo, return error .
     4156           end.
     4157           find current buf_gds-obj exclusive-lock .
     4158         end.
     4159       end.
     4160   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4162     (input  p-artic
     4163     ,input  p-prod-type
     4164     ,input  p-prod-code
     4165     ,input  'gds-goods=request':u
     4166     ,output v-goods-gds-goods
     4167     ) no-error .
     4168       if error-status :error
     4169       then do:
     4170         message
     4171           vss-workfile vss-revision vss-description skip
     4172           vss-include-info26 skip
     4173           "Ошибка при определении атрибута товара" skip
     4174           "Артикул" p-artic p-prod-type p-prod-code skip
     4175           "gds-goods=request" skip
     4176           error-status :get-message(1) skip
     4177           return-value skip
     4178           view-as alert-box error .
     4179         undo, return error return-value .
     4180       end.
     4181   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4182   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4183     (input  p-artic
     4184     ,input  p-prod-type
     4185     ,input  p-prod-code
     4186     ,input  'twounit=request':u
     4187     ,output v-goods-twounit
     4188     ) no-error .
     4189       if error-status :error
     4190       then do:
     4191         message
     4192           vss-workfile vss-revision vss-description skip
     4193           vss-include-info26 skip
     4194           "Ошибка при определении атрибута товара" skip
     4195           "Артикул" p-artic p-prod-type p-prod-code skip
     4196           "twounit=request" skip
     4197           error-status :get-message(1) skip
     4198           return-value skip
     4199           view-as alert-box error .
     4200         undo, return error return-value .
     4201       end.
     4202       for each buf_doc-line no-lock
     4203         where buf_doc-line.obj-type   = p-obj-type
     4204           and buf_doc-line.obj-code   = p-obj-code
     4205           and buf_doc-line.artic      = p-artic
     4206           and buf_doc-line.prod-type  = p-prod-type
     4207           and buf_doc-line.prod-code  = p-prod-code
     4208           and buf_doc-line.status_    = 'факт':U
     4209           and buf_doc-line.fact-order > p-start-fact-order
     4210           and buf_doc-line.fact-order <= p-end-fact-order
     4211       on error undo, return error
     4212       :
     4213         run partslib-process-document in this-procedure
     4214           (input  buf_doc-line.doc-code
     4215           ,input  p-obj-type
     4216           ,input  p-obj-code
     4217           ,input  p-artic
     4218           ,input  p-prod-type
     4219           ,input  p-prod-code
     4220           ,input  v-goods-gds-goods
     4221           ,input  v-goods-twounit
     4222           ,output v-total-parts-qnty
     4223           ) no-error .
     4224         if error-status :error
     4225         then do:
     4226           message
     4227             vss-workfile vss-revision vss-description skip
     4228             vss-include-info26 skip
     4229             "Ошибка при вызове процедуры partslib-process-document" skip
     4230             "Документ" buf_doc-line.doc-code skip
     4231             "Объект" p-obj-type p-obj-code skip
     4232             "Артикул" p-artic p-prod-type p-prod-code skip
     4233             "p-start-fact-order" p-start-fact-order skip
     4234             "p-end-fact-order" p-end-fact-order skip
     4235             error-status :get-message(1) skip
     4236             return-value skip
     4237             view-as alert-box error .
     4238           undo, return error return-value .
     4239         end.
     4240       end.
     4241     end.
     4242   end procedure.
     4243   procedure partslib-process-document :
     4244     define input  parameter p-doc-code         as character no-undo .
     4245     define input  parameter p-obj-type         as character no-undo .
     4246     define input  parameter p-obj-code         as integer   no-undo .
     4247     define input  parameter p-artic            as character no-undo .
     4248     define input  parameter p-prod-type        as character no-undo .
     4249     define input  parameter p-prod-code        as integer   no-undo .
     4250     define input  parameter p-goods-gds-goods  as logical   no-undo .
     4251     define input  parameter p-goods-twounit    as logical   no-undo .
     4252     define output parameter p-total-parts-qnty as decimal   no-undo .
     4253     define variable v-parts-sign as integer   no-undo .
     4254     define buffer buf_trn-doc    for ub.trn-doc .
     4255     define buffer buf_doc-line   for ub.doc-line .
     4256     define buffer buf_parts      for ub.parts .
     4257     define buffer buf_temp-parts for temp-parts .
     4258     do
     4259     on error undo, return error return-value
     4260     :
     4261       find first buf_trn-doc no-lock
     4262         where buf_trn-doc.doc-code = p-doc-code
     4263         no-error .
     4264       if not available buf_trn-doc
     4265       then do:
     4266         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     4267                                      ,p-doc-code
     4268                                      ) .
     4269       end.
     4270       case buf_trn-doc.doc-type
     4271       :
     4272         when 'при':U or
     4273         when 'возврат':U or
     4274         when 'инв':U
     4275         then do:
     4276           assign
     4277             v-parts-sign = -1
     4278           .
     4279         end.
     4280         when 'рас':U or
     4281         when 'спи':U
     4282         then do:
     4283           assign
     4284             v-parts-sign = 1
     4285           .
     4286         end.
     4287         otherwise do:
     4288           undo, return error substitute("Неизвестный тип документа &1"
     4289                                       ,buf_trn-doc.doc-type
     4290                                       ) .
     4291         end.
     4292       end.
     4293       find first buf_doc-line no-lock
     4294         where buf_doc-line.doc-code  = p-doc-code
     4295           and buf_doc-line.artic     = p-artic
     4296           and buf_doc-line.prod-type = p-prod-type
     4297           and buf_doc-line.prod-code = p-prod-code
     4298         no-error .
     4299       if not available buf_doc-line
     4300       then do:
     4301         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     4302                                      ,p-doc-code
     4303                                      ,artic
     4304                                      ,prod-type
     4305                                      ,prod-code
     4306                                      ) .
     4307       end.
     4308       assign
     4309         p-total-parts-qnty = 0
     4310       .
     4311       if p-goods-gds-goods = true
     4312       then do:
     4313         for each buf_parts no-lock
     4314           where buf_parts.out-code  = p-doc-code
     4315             and buf_parts.obj-type  = p-obj-type
     4316             and buf_parts.obj-code  = p-obj-code
     4317             and buf_parts.artic     = p-artic
     4318             and buf_parts.prod-type = p-prod-type
     4319             and buf_parts.prod-code = p-prod-code
     4320         on error undo, return error
     4321         :
     4322           run partslib-create-temp-parts in this-procedure
     4323             (buffer buf_parts
     4324             ,buffer buf_temp-parts
     4325             ,input  p-goods-twounit
     4326             ) .
     4327           assign
     4328             p-total-parts-qnty        = p-total-parts-qnty
     4329                                       + v-parts-sign * buf_parts.fact-qnty
     4330             buf_temp-parts.qnty       = buf_temp-parts.qnty
     4331                                       + v-parts-sign * buf_parts.fact-qnty
     4332             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     4333                                       + v-parts-sign * buf_parts.fact-qnty
     4334             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     4335                                       + v-parts-sign * buf_parts.cli-qnty
     4336           .
     4337           if buf_temp-parts.qnty = 0
     4338           then do:
     4339             delete buf_temp-parts .
     4340           end.
     4341         end.
     4342       end.
     4343       else do:
     4344         assign
     4345           p-total-parts-qnty = p-total-parts-qnty
     4346                              + v-parts-sign * buf_doc-line.fact-qnty
     4347         .
     4348       end.
     4349     end.
     4350   end procedure.
     4351   procedure partslib-init-temp-parts-by-date :
     4352     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     4353     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     4354     define input parameter p-artic           like ub.parts.artic     no-undo .
     4355     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     4356     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     4357     define input parameter p-fact-date       as date      no-undo .
     4358     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     4359     do
     4360     on error undo, return error
     4361     :
     4362       define variable v-fact-order                as decimal   no-undo .
     4363       define variable v-shift-end-fact-order      as decimal   no-undo .
     4364       define variable v-day-end-fact-order        as decimal   no-undo .
     4365       run factord in this-procedure
     4366         (input  p-fact-date
     4367         ,input  1
     4368         ,input  1
     4369         ,input  ?
     4370         ,input  0
     4371         ,input  false
     4372         ,output v-fact-order
     4373         ,output v-shift-end-fact-order
     4374         ,output v-day-end-fact-order
     4375         ) no-error .
     4376       if error-status :error
     4377       then do:
     4378         message
     4379           vss-workfile vss-revision vss-description skip
     4380           vss-include-info26 skip
     4381           "Ошибка при определении момента времени, на который требуется остаток" skip
     4382           "Объект" p-obj-type p-obj-code skip
     4383           "Артикул" p-artic p-prod-type p-prod-code skip
     4384           "Дата" p-fact-date skip
     4385           view-as alert-box error .
     4386         undo, return error .
     4387       end.
     4388       run partslib-init-temp-parts-by-factord in this-procedure
     4389         (input p-obj-type
     4390         ,input p-obj-code
     4391         ,input p-artic
     4392         ,input p-prod-type
     4393         ,input p-prod-code
     4394         ,input v-day-end-fact-order
     4395         ,input false
     4396         ) no-error .
     4397       if error-status :error
     4398       then do:
     4399         message
     4400           vss-workfile vss-revision vss-description skip
     4401           vss-include-info26 skip
     4402           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     4403           "Объект" p-obj-type p-obj-code skip
     4404           "Артикул" p-artic p-prod-type p-prod-code skip
     4405           "Дата" p-fact-date skip
     4406           view-as alert-box error .
     4407         undo, return error .
     4408       end.
     4409     end.
     4410   end procedure.
     4411   procedure partslib-calc-cost :
     4412     define output parameter p-fact-qnty      as decimal   no-undo .
     4413     define output parameter p-vat-pc         as decimal   no-undo .
     4414     define output parameter p-slt-pc         as decimal   no-undo .
     4415     define output parameter p-sum-base       as decimal   no-undo .
     4416     define output parameter p-sum-rubl       as decimal   no-undo .
     4417     define output parameter p-vat-base       as decimal   no-undo .
     4418     define output parameter p-vat-rubl       as decimal   no-undo .
     4419     define output parameter p-slt-base       as decimal   no-undo .
     4420     define output parameter p-slt-rubl       as decimal   no-undo .
     4421     define output parameter p-road-tax-base  as decimal   no-undo .
     4422     define output parameter p-road-tax-rubl  as decimal   no-undo .
     4423     define output parameter p-transport-base as decimal   no-undo .
     4424     define output parameter p-transport-rubl as decimal   no-undo .
     4425     define output parameter p-other-base     as decimal   no-undo .
     4426     define output parameter p-other-rubl     as decimal   no-undo .
     4427     define output parameter p-excise-base    as decimal   no-undo .
     4428     define output parameter p-excise-rubl    as decimal   no-undo .
     4429     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     4430     do
     4431     on error undo, return error return-value
     4432     :
     4433       define buffer buf_temp-parts for temp-parts .
     4434       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     4435       define buffer   in-vatp-parts    for ub.parts   .
     4436       define buffer   in-vatp-doc      for ub.trn-doc .
     4437       define buffer   in-vatp-goods    for ub.goods   .
     4438       define buffer   in-vatp-sysconf  for ub.sysconf .
     4439       define buffer   in-vatp_doc-attr for ub.doc-attr.
     4440       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     4441       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     4442       define variable varinvprb                  as   character              no-undo.
     4443       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     4444       define variable cli-base-rate              as   decimal                no-undo.
     4445       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     4446       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     4447       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     4448       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     4449       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     4450       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     4451       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     4452       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4453       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     4454       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     4455       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4456       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     4457       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     4458       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     4459       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     4460       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     4461       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     4462       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     4463       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     4464       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     4465       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     4466       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     4467       define variable varinvatp-envd             as   character              no-undo.
     4468       define variable varinvatp-type             as   character              no-undo.
     4469       for each buf_temp-parts
     4470       on error undo, return error
     4471       :
     4472   assign
     4473     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     4474     price-base-with-tax-loc = buf_temp-parts.price-base
     4475   .
     4476   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4477   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4478     (output varinvprb
     4479     )  .
     4480     if buf_temp-parts.out-code = 'free-zone':U     or
     4481        buf_temp-parts.out-code = 'out-zone':U   or
     4482        buf_temp-parts.doc-type = 'акт':U then do:
     4483       assign
     4484         in-vatp-have-vat-slt = yes.
     4485     end.
     4486     else do:
     4487       find first in-vatp_doc-attr no-lock
     4488         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     4489           and in-vatp_doc-attr.attr-code = 'envd':U
     4490         no-error .
     4491       if not available in-vatp_doc-attr then do:
     4492         assign
     4493           in-vatp-have-vat-slt = yes.
     4494       end.
     4495       else do:
     4496            in-vatp-have-vat-slt = no.
     4497       end.
     4498     end.
     4499     assign
     4500      price-cli-with-tax-loc = buf_temp-parts.price-cli
     4501      cli-base-rate          = buf_temp-parts.cli-base-rate.
     4502     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     4503              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     4504     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     4505             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     4506             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     4507             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     4508             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     4509             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     4510             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4511       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4512     assign
     4513       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     4514     assign
     4515       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     4516       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     4517       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     4518       transport-cli-loc  = 0
     4519       other-cli-loc      = 0
     4520     .
     4521   ASSIGN
     4522             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4523       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4524   .
     4525         assign
     4526           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     4527           p-vat-pc         = p-vat-pc         + vat-pc-loc
     4528           p-slt-pc         = p-slt-pc         + slt-pc-loc
     4529           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     4530           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     4531           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     4532           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     4533           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     4534           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     4535           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     4536           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     4537           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     4538           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     4539           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     4540           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     4541           p-excise-base    = p-excise-base    + 0
     4542           p-excise-rubl    = p-excise-rubl    + 0
     4543         .
     4544       end.
     4545       if p-fact-qnty      = ?
     4546       or p-sum-base       = ?
     4547       or p-sum-rubl       = ?
     4548       or p-vat-base       = ?
     4549       or p-vat-rubl       = ?
     4550       or p-slt-base       = ?
     4551       or p-slt-rubl       = ?
     4552       or p-road-tax-base  = ?
     4553       or p-road-tax-rubl  = ?
     4554       or p-transport-base = ?
     4555       or p-transport-rubl = ?
     4556       or p-other-base     = ?
     4557       or p-other-rubl     = ?
     4558       or p-excise-base    = ?
     4559       or p-excise-rubl    = ?
     4560       then do:
     4561         message
     4562           vss-workfile vss-revision vss-description skip
     4563           vss-include-info26 skip
     4564           "Программа in-vatp.i вернула неопределенные значения" skip
     4565           "p-fact-qnty"      p-fact-qnty      skip
     4566           "p-sum-base"       p-sum-base       skip
     4567           "p-sum-rubl"       p-sum-rubl       skip
     4568           "p-vat-base"       p-vat-base       skip
     4569           "p-vat-rubl"       p-vat-rubl       skip
     4570           "p-slt-base"       p-slt-base       skip
     4571           "p-slt-rubl"       p-slt-rubl       skip
     4572           "p-road-tax-base"  p-road-tax-base  skip
     4573           "p-road-tax-rubl"  p-road-tax-rubl  skip
     4574           "p-transport-base" p-transport-base skip
     4575           "p-transport-rubl" p-transport-rubl skip
     4576           "p-other-base"     p-other-base     skip
     4577           "p-other-rubl"     p-other-rubl     skip
     4578           "p-excise-base"    p-excise-base    skip
     4579           "p-excise-rubl"    p-excise-rubl    skip
     4580           view-as alert-box error .
     4581         undo, return error .
     4582       end.
     4583     end.
     4584   end procedure.
     4585   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4586   procedure prl-vat:
     4587     define input parameter parrecid as recid no-undo.
     4588       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
     4589       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     4590       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     4591       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     4592       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     4593       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     4594       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     4595       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
     4596       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
     4597       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     4598       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
     4599       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
     4600       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
     4601       define output parameter excise-rubl-saleprl            like ub.doc-line.price-rubl no-undo.
     4602       define output parameter discnt-base-saleprl            like ub.gds-dtl.discnt-base no-undo.
     4603       define output parameter discnt-rubl-saleprl            like ub.gds-dtl.discnt-rubl no-undo.
     4604       define buffer out-vatp_gds-dtlprl     for ub.gds-dtl.
     4605       define buffer buf_out-vatp_gds-dtlprl for ub.gds-dtl.
     4606       define buffer out-vatp_partsprl       for ub.parts.
     4607       define buffer out-vatp_sysconfprl     for ub.sysconf.
     4608       define buffer out-vatp_doc-lineprl    for ub.doc-line.
     4609       define buffer out-vatp_goodsprl       for ub.goods.
     4610       define buffer out-vatp_trn-docprl     for ub.trn-doc.
     4611       define buffer out-vatp_doc-attrprl    for ub.doc-attr.
     4612       define variable varprice-base-consprl      like ub.doc-line.price-base initial 0.00 no-undo.
     4613       define variable varprice-rubl-consprl      like ub.doc-line.price-rubl initial 0.00 no-undo.
     4614       define variable varfrm-cnsv-typeprl         as   character                           no-undo.
     4615       define variable varfrm-cnsvprl              as   character                           no-undo.
     4616       define variable varroot-nodeprl             as   integer                             no-undo.
     4617       define variable varempty-scaleprl           as   logical                             no-undo.
     4618       define variable varis-cons-parts-haveprl    as   logical                             no-undo.
     4619       define variable varsum-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4620       define variable varslt-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4621       define variable varvat-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4622       define variable varvatcons-base-factovpprl  like ub.gds-dtl.price-base               no-undo.
     4623       define variable vardsc-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4624       define variable varsum-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4625       define variable varslt-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4626       define variable varvat-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4627       define variable varvatcons-base-docovpprl   like ub.gds-dtl.price-base               no-undo.
     4628       define variable vardsc-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4629       define variable varsum-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4630       define variable varslt-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4631       define variable varvat-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4632       define variable varvatcons-rubl-factovpprl  like ub.gds-dtl.price-base               no-undo.
     4633       define variable vardsc-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     4634       define variable varsum-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4635       define variable varslt-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4636       define variable varvat-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4637       define variable varvatcons-rubl-docovpprl   like ub.gds-dtl.price-base               no-undo.
     4638       define variable vardsc-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     4639       define variable varfact-qntyprl             like ub.parts.fact-qnty                  no-undo.
     4640       define variable varcons-qntyprl             like ub.parts.fact-qnty                  no-undo.
     4641       define variable varis-one-gds-dtlprl        as   logical                             no-undo.
     4642       define variable varcurprlprice-base         like ub.gds-dtl.cur-base                 no-undo.
     4643       define variable varcurprlprice-rubl         like ub.gds-dtl.price-base               no-undo.
     4644       define variable varcurprldiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     4645       define variable varcurprldiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     4646       define variable varoutvprbprl               as   character                           no-undo.
     4647       define variable out-vatp-have-vat-sltprl    as   logical initial yes                 no-undo.
     4648       define buffer   in-vatp-trn-docoprl  for ub.trn-doc .
     4649       define buffer   in-vatp-partsoprl    for ub.parts   .
     4650       define buffer   in-vatp-docoprl      for ub.trn-doc .
     4651       define buffer   in-vatp-goodsoprl    for ub.goods   .
     4652       define buffer   in-vatp-sysconfoprl  for ub.sysconf .
     4653       define buffer   in-vatp_doc-attroprl for ub.doc-attr.
     4654       define variable in-vatp-have-vat-sltoprl       as   logical initial yes    no-undo.
     4655       define variable vat-pc-locoprl                 like ub.doc-line.vat-pc     no-undo.
     4656       define variable varinvprboprl                  as   character              no-undo.
     4657       define variable slt-pc-locoprl                 like ub.doc-line.slt-pc     no-undo.
     4658       define variable cli-base-rateoprl              as   decimal                no-undo.
     4659       define variable price-rubl-with-tax-locoprl    like ub.doc-line.price-rubl no-undo.
     4660       define variable price-base-with-tax-locoprl    like ub.doc-line.price-base no-undo.
     4661       define variable price-cli-with-tax-locoprl     like ub.doc-line.price-cli  no-undo.
     4662       define variable price-rubl-without-tax-locoprl like ub.doc-line.price-rubl no-undo.
     4663       define variable price-base-without-tax-locoprl like ub.doc-line.price-base no-undo.
     4664       define variable price-cli-without-tax-locoprl  like ub.doc-line.price-base no-undo.
     4665       define variable vat-base-locoprl               like ub.doc-line.price-base no-undo.
     4666       define variable vat-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     4667       define variable vat-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     4668       define variable slt-base-locoprl               like ub.doc-line.price-base no-undo.
     4669       define variable slt-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     4670       define variable slt-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     4671       define variable road-tax-base-locoprl          like ub.doc-line.road-tax   no-undo.
     4672       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
     4673       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
     4674       define variable transport-base-locoprl         like ub.doc-line.price-base no-undo.
     4675       define variable transport-rubl-locoprl         like ub.doc-line.price-rubl no-undo.
     4676       define variable transport-cli-locoprl          like ub.doc-line.price-rubl no-undo.
     4677       define variable other-base-locoprl             like ub.doc-line.price-base no-undo.
     4678       define variable other-rubl-locoprl             like ub.doc-line.price-rubl no-undo.
     4679       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
     4680       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
     4681       define variable varinvatp-envdoprl             as   character              no-undo.
     4682       define variable varinvatp-typeoprl             as   character              no-undo.
     4683     define buffer bf_price-list for ub.price-list.
     4684     define buffer bf_goods      for ub.goods.
     4685     define buffer bf_sysconf    for ub.sysconf.
     4686     define buffer bf_parts      for ub.parts.
     4687     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
     4688     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
     4689     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
     4690     define variable varexcise      like ub.price-list.excise     no-undo.
     4691     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
     4692     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
     4693     define variable varprice-base  like ub.price-list.price-sale no-undo.
     4694     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     4695     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     4696     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     4697     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     4698     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     4699     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     4700     define variable varobj-type    like ub.price-list.obj-type   no-undo.
     4701     define variable varobj-code    like ub.price-list.obj-code   no-undo.
     4702     define variable varartic       like ub.price-list.artic      no-undo.
     4703     define variable varprod-type   like ub.price-list.prod-type  no-undo.
     4704     define variable varprod-code   like ub.price-list.prod-code  no-undo.
     4705     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
     4706     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
     4707     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     4708     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     4709     define variable vardoc-type     as   character              no-undo.
     4710     do
     4711     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     4712     :
     4713       find first bf_price-list no-lock
     4714         where recid(bf_price-list) = parrecid
     4715         no-error .
     4716       if not available bf_price-list
     4717       then do:
     4718         return error "Ошибка во входящих параметрах prl-vat.i" .
     4719       end.
     4720       find first bf_goods no-lock
     4721         where bf_goods.artic     = bf_price-list.artic
     4722           and bf_goods.prod-type = bf_price-list.prod-type
     4723           and bf_goods.prod-code = bf_price-list.prod-code
     4724         no-error .
     4725       if not available bf_goods
     4726       then do:
     4727         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     4728       end.
     4729       assign
     4730         varvat-pc = bf_price-list.vat-pc
     4731         varslt-pc = bf_price-list.slt-pc
     4732       .
     4733       if varvat-pc = ?
     4734       then do:
     4735         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     4736       end.
     4737       if varslt-pc = ?
     4738       then do:
     4739         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     4740       end.
     4741       assign
     4742         varbase-rate   = 1
     4743         varbase-scale  = 1
     4744         varroad-tax    = bf_price-list.road-tax
     4745         varexcise      = bf_price-list.excise
     4746         varprice-base  = bf_price-list.price-sale
     4747         varprice-rubl  = bf_price-list.price-sale
     4748         vardiscnt-base = 0
     4749         vardiscnt-rubl = 0
     4750       .
     4751       assign
     4752         varfact-qnty = 0
     4753       .
     4754       for each bf_parts no-lock
     4755         where bf_parts.out-code   = bf_price-list.doc-num
     4756           and bf_parts.obj-type   = bf_price-list.obj-type
     4757           and bf_parts.obj-code   = bf_price-list.obj-code
     4758           and bf_parts.artic      = bf_price-list.artic
     4759           and bf_parts.prod-type  = bf_price-list.prod-type
     4760           and bf_parts.prod-code  = bf_price-list.prod-code
     4761       :
     4762         assign
     4763           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     4764         .
     4765       end.
     4766       assign
     4767         vardoc-num   = bf_price-list.doc-num
     4768         vardoc-code  = bf_price-list.doc-num
     4769         varobj-type  = bf_price-list.obj-type
     4770         varobj-code  = bf_price-list.obj-code
     4771         varartic     = bf_price-list.artic
     4772         varprod-type = bf_price-list.prod-type
     4773         varprod-code = bf_price-list.prod-code
     4774         vardoc-qnty  = varfact-qnty
     4775         varext-doc-type = 'ot':U
     4776       .
     4777   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4779     (input  bf_price-list.obj-type
     4780     ,input  bf_price-list.obj-code
     4781     ,output v-host-code
     4782     )  .
     4783       find first bf_sysconf no-lock
     4784         where bf_sysconf.host-code = v-host-code
     4785         .
     4786       if bf_sysconf.cons-vat-pc = ?
     4787       then do:
     4788         return error "Не задан консигнационный НДС по фирме." .
     4789       end.
     4790       else do:
     4791         assign
     4792           varcons-vat-pc = bf_sysconf.cons-vat-pc
     4793         .
     4794       end.
     4795   if varext-doc-type = 'ot':U or
     4796      varext-doc-type = ?                 then do:
     4797     assign
     4798      out-vatp-have-vat-sltprl = yes.
     4799   end.
     4800   else do:
     4801     find first out-vatp_doc-attrprl no-lock
     4802       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     4803         and out-vatp_doc-attrprl.attr-code = 'envd':U
     4804         no-error .
     4805     if not available out-vatp_doc-attrprl then do:
     4806       assign
     4807         out-vatp-have-vat-sltprl = yes.
     4808     end.
