     7844   procedure ahrstutl-supp-tot-sum-type-list :
     7845     define output parameter p-sum-type-list as character no-undo .
     7846     do
     7847     on error undo, return error return-value
     7848     :
     7849       define variable v-ind                    as integer   no-undo .
     7850       define variable v-num-entries-TDEDT_List as integer   no-undo .
     7851       assign
     7852         v-num-entries-TDEDT_List = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     7853       .
     7854       assign
     7855         p-sum-type-list = 'cost':U
     7856       .
     7857       do v-ind = 1 to v-num-entries-TDEDT_List
     7858       :
     7859         assign
     7860           p-sum-type-list = p-sum-type-list
     7861                           + chr(44)
     7862                           + 'sadt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     7863         .
     7864       end.
     7865       do v-ind = 1 to v-num-entries-TDEDT_List
     7866       :
     7867         assign
     7868           p-sum-type-list = p-sum-type-list
     7869                           + chr(44)
     7870                           + 'csdt':U + entry(v-ind, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U)
     7871         .
     7872       end.
     7873     end.
     7874   end procedure.
