     1000   define temp-table doc-list no-undo
     1001     field doc-code         like ub.trn-doc.doc-code
     1002     field obj-type         like ub.trn-doc.obj-type
     1003     field obj-code         like ub.trn-doc.obj-code
     1004     field fact-date        like ub.trn-doc.fact-date
     1005     field shift-date       like ub.trn-doc.shift-date
     1006     field shift-num        like ub.trn-doc.shift-num
     1007     field shift-name       like ub.trn-doc.shift-name
     1008     field fact-order       as decimal
     1009     field is-trn-doc       as logical
     1010     field doc-type         like ub.trn-doc.doc-type
     1011     field is-archive-exist as logical
     1012     index xpk is primary unique doc-code doc-type
     1013     index xfact-order fact-order
     1014     index xfact-date  fact-date
     1015     .
     1016   define temp-table doclslib-goods no-undo
     1017     field gds-code  as integer
     1018     field artic     as character
     1019     field prod-type as character
     1020     field prod-code as integer
     1021     index xpk is primary unique gds-code
     1022     index xie1 artic prod-type prod-code
     1023     .
     1024   define buffer inkas_trn-doc for ub.trn-doc .
     1025   define stream doclsliblog .
     1026   procedure doclslib-clear-doc-list :
     1027     define buffer buf_doc-list for doc-list .
     1028     do
     1029     on error undo, return error
     1030     :
     1031       for each buf_doc-list
     1032       on error undo, return error
     1033       :
     1034         delete buf_doc-list .
     1035       end.
     1036     end.
     1037   end procedure.
     1038   procedure doclslib-init-trn-doc :
     1039     define input parameter p-obj-type      as character no-undo .
     1040     define input parameter p-obj-code      as integer   no-undo .
     1041     define input parameter p-cut-date      as date      no-undo .
     1042     define buffer buf_trn-doc for ub.trn-doc .
     1043     define buffer buf_doc-list for doc-list .
     1044     do
     1045     on error undo, return error
     1046     :
     1047       if p-cut-date = ?
     1048       then do:
     1049         for each buf_trn-doc no-lock
     1050           where buf_trn-doc.obj-type = p-obj-type
     1051             and buf_trn-doc.obj-code = p-obj-code
     1052             and buf_trn-doc.status_  = 'факт':U
     1053         on error undo, return error
     1054         :
     1055           create buf_doc-list .
     1056           assign
     1057             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1058             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1059             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1060             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1061             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1062             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1063             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1064             buf_doc-list.is-trn-doc = true
     1065           .
     1066         end.
     1067       end.
     1068       else do:
     1069         for each buf_trn-doc no-lock
     1070           where buf_trn-doc.obj-type  = p-obj-type
     1071             and buf_trn-doc.obj-code  = p-obj-code
     1072             and buf_trn-doc.status_   = 'факт':U
     1073             and buf_trn-doc.fact-date >= p-cut-date
     1074         on error undo, return error
     1075         :
     1076           create buf_doc-list .
     1077           assign
     1078             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1079             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1080             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1081             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1082             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1083             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1084             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1085             buf_doc-list.is-trn-doc = true
     1086           .
     1087         end.
     1088       end.
     1089     end.
     1090   end procedure.
     1091   procedure doclslib-init-price-doc :
     1092     define input parameter p-obj-type      as character no-undo .
     1093     define input parameter p-obj-code      as integer   no-undo .
     1094     define input parameter p-cut-date      as date      no-undo .
     1095     define buffer buf_price-doc for ub.price-doc .
     1096     define buffer buf_doc-list for doc-list .
     1097     do
     1098     on error undo, return error
     1099     :
     1100       if p-cut-date = ?
     1101       then do:
     1102         for each buf_price-doc no-lock
     1103           where buf_price-doc.obj-type = p-obj-type
     1104             and buf_price-doc.obj-code = p-obj-code
     1105             and buf_price-doc.status_  = 'акт':U
     1106         on error undo, return error
     1107         :
     1108           create buf_doc-list .
     1109           assign
     1110             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1111             buf_doc-list.doc-type   = ''
     1112             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1113             buf_doc-list.shift-date = buf_price-doc.shift-date
     1114             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1115             buf_doc-list.shift-name = buf_price-doc.shift-name
     1116             buf_doc-list.fact-order = buf_price-doc.fact-order
     1117             buf_doc-list.is-trn-doc = false
     1118           .
     1119         end.
     1120       end.
     1121       else do:
     1122         for each buf_price-doc no-lock
     1123           where buf_price-doc.obj-type = p-obj-type
     1124             and buf_price-doc.obj-code = p-obj-code
     1125             and buf_price-doc.status_  = 'акт':U
     1126             and ub.buf_price-doc.fact-date >= p-cut-date
     1127         on error undo, return error
     1128         :
     1129           create buf_doc-list .
     1130           assign
     1131             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1132             buf_doc-list.doc-type   = ''
     1133             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1134             buf_doc-list.shift-date = buf_price-doc.shift-date
     1135             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1136             buf_doc-list.shift-name = buf_price-doc.shift-name
     1137             buf_doc-list.fact-order = buf_price-doc.fact-order
     1138             buf_doc-list.is-trn-doc = false
     1139           .
     1140         end.
     1141       end.
     1142     end.
     1143   end procedure.
     1144   procedure doclslib-clear-bydate-doc-list :
     1145     define input parameter p-fact-date as date no-undo .
     1146     define buffer buf_doc-list for doc-list .
     1147     do
     1148     on error undo, return error
     1149     :
     1150       if p-fact-date <> ?
     1151       then do:
     1152         for each buf_doc-list
     1153           where buf_doc-list.fact-date < p-fact-date
     1154         on error undo, return error
     1155         :
     1156           delete buf_doc-list .
     1157         end.
     1158       end.
     1159     end.
     1160   end procedure.
     1161   procedure doclslib-clear-rst :
     1162     define input parameter p-fact-date as date no-undo .
     1163     define buffer buf_doc-list for doc-list .
     1164     do
     1165     on error undo, return error
     1166     :
     1167       if p-fact-date <> ?
     1168       then do:
     1169         for each buf_doc-list
     1170           where buf_doc-list.fact-date >= p-fact-date
     1171         on error undo, return error
     1172         :
     1173           delete buf_doc-list .
     1174         end.
     1175       end.
     1176     end.
     1177   end procedure.
     1178   procedure doclslib-export-doc-list :
     1179     define input  parameter p-obj-type      as character no-undo .
     1180     define input  parameter p-obj-code      as integer no-undo .
     1181     define input  parameter p-log-file-name as character no-undo .
     1182     define input  parameter p-description   as character no-undo .
     1183     define buffer buf_doc-list for doc-list .
     1184     do
     1185     on error undo, return error
     1186     :
     1187       output stream doclsliblog to value(p-log-file-name) .
     1188       export stream doclsliblog "#############################################################" .
     1189       export stream doclsliblog "Список документов" .
     1190       export stream doclsliblog p-description .
     1191       export stream doclsliblog "Объект" p-obj-type p-obj-code .
     1192       export stream doclsliblog "Дата" string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     1193       for each buf_doc-list
     1194       by buf_doc-list.fact-order
     1195       on error undo, return error
     1196       :
     1197         export stream doclsliblog buf_doc-list .
     1198       end.
     1199       export stream doclsliblog "#############################################################" .
     1200       output stream doclsliblog close .
     1201     end.
     1202   end procedure.
     1203   procedure doclslib-clear-batch-process :
     1204     define input parameter p-bp_type like ub.batchprocess.bp_type no-undo .
     1205     define buffer buf_batchprocess        for ub.batchprocess .
     1206     define buffer execdelete_batchprocess for ub.batchprocess .
     1207     define buffer buf_doc-list            for doc-list .
     1208     for each buf_doc-list
     1209     on end-key undo, return error substitute( "doclslib-clear-batch-process. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1210     on error   undo, return error substitute( "doclslib-clear-batch-process. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1211     on stop    undo, return error substitute( "doclslib-clear-batch-process. STOP      &2"
     1212                                    + "bp_type &3&2"
     1213                                    + "Документ &4"
     1214                                    , chr(10)
     1215                                    , p-bp_type
     1216                                    , buf_doc-list.doc-code
     1217                                   )
     1218     :
     1219       find first buf_batchprocess exclusive-lock
     1220         where buf_BatchProcess.BP_Status   = 'N':U
     1221           and buf_batchprocess.bp_type     = p-bp_type
     1222           and buf_batchprocess.charkey_one = buf_doc-list.doc-code
     1223         no-error .
     1224       if available buf_batchprocess
     1225       then do:
     1226         delete buf_batchprocess .
     1227       end.
     1228     end.
     1229   end procedure.
     1230   procedure doclslib-calc-arh :
     1231     define input  parameter p-log-handle     as handle    no-undo .
     1232     define input  parameter p-obj-type       as character no-undo .
     1233     define input  parameter p-obj-code       as integer   no-undo .
     1234     define input  parameter p-cut-date       as date      no-undo .
     1235     define input  parameter p-update-recalc  as logical   no-undo .
     1236     define variable v-prev-fact-date as date      no-undo .
     1237     define buffer buf_doc-list for doc-list .
     1238     define buffer stop-arh-restore-lock_btpr for ub.batchprocess .
     1239     define buffer stop-arh-news-lock_btpr    for ub.batchprocess .
     1240     do
     1241     on stop    undo, return error substitute( "doclslib-calc-arh. stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1242     on end-key undo, return error substitute( "doclslib-calc-arh. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1243     on error   undo, return error substitute( "doclslib-calc-arh. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1244     :
     1245       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1246       run gbl/lockrngd.p
     1247         (input  'grar':U
     1248         ,input  'disable':U
     1249         ,buffer buf_lock_gdsrenart_batchprocess
     1250         ) no-error .
     1251       if error-status :error
     1252       then do:
     1253         if error-status :get-message(1) <> ""
     1254         then do:
     1255           message
     1256             vss-workfile vss-revision vss-description skip
     1257             "Ошибка при блокировании функции переименования артикула товара" skip
     1258             error-status :get-message(1) skip
     1259             return-value skip
     1260             view-as alert-box error .
     1261         end.
     1262         undo, return error return-value .
     1263       end.
     1264       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1265       run gbl/lockrngd.p
     1266         (input  'grgc':U
     1267         ,input  'disable':U
     1268         ,buffer buf_lock_gdsrengc_batchprocess
     1269         ) no-error .
     1270       if error-status :error
     1271       then do:
     1272         if error-status :get-message(1) <> ""
     1273         then do:
     1274           message
     1275             vss-workfile vss-revision vss-description skip
     1276             "Ошибка при блокировании функции переименования кода товара" skip
     1277             error-status :get-message(1) skip
     1278             return-value skip
     1279             view-as alert-box error .
     1280         end.
     1281         undo, return error return-value .
     1282       end.
     1283       for each buf_doc-list
     1284       by buf_doc-list.fact-order
     1285       on stop    undo, return error substitute( "f e . stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1286       on end-key undo, return error substitute( "f e . end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1287       on error   undo, return error substitute( "f e . error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1288       :
     1289         find first stop-arh-restore-lock_btpr no-lock
     1290           where stop-arh-restore-lock_btpr.bp_type       = 'lock':U + 'rsrs':U
     1291             and stop-arh-restore-lock_btpr.bp_status     = 'N':U
     1292             and stop-arh-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1293             and stop-arh-restore-lock_btpr.Key#_Two      = 0
     1294             and stop-arh-restore-lock_btpr.Key#_Three    = 0
     1295             and stop-arh-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1296             and stop-arh-restore-lock_btpr.CharKey_Two   = ""
     1297             and stop-arh-restore-lock_btpr.CharKey_Three = ""
     1298           no-error .
     1299         if available stop-arh-restore-lock_btpr
     1300         then do:
     1301           run doclslib-log-information in this-procedure
     1302             (input p-log-handle
     1303             ,input "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива"
     1304             ) .
     1305           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1306         end.
     1307         find first stop-arh-news-lock_btpr no-lock
     1308           where stop-arh-news-lock_btpr.bp_type       = 'lock':U + 'rsrn':U
     1309             and stop-arh-news-lock_btpr.bp_status     = 'N':U
     1310             and stop-arh-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1311             and stop-arh-news-lock_btpr.Key#_Two      = 0
     1312             and stop-arh-news-lock_btpr.Key#_Three    = 0
     1313             and stop-arh-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1314             and stop-arh-news-lock_btpr.CharKey_Three = ""
     1315           no-error .
     1316         if available stop-arh-news-lock_btpr
     1317         then do:
     1318           run doclslib-log-information in this-procedure
     1319             (input p-log-handle
     1320             ,input "Система новостей запросила остановку процедуры расчета складского архива"
     1321             ) .
     1322           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1323         end.
     1324         if buf_doc-list.is-trn-doc
     1325         then do:
     1326           run doclslib-log-information in this-procedure
     1327             (input p-log-handle
     1328             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1329                              ,buf_doc-list.doc-code
     1330                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1331                              ,buf_doc-list.fact-order
     1332                              )
     1333             ) .
     1334           run trg/calc-arh.p
     1335             (input buf_doc-list.doc-code
     1336             ,input p-cut-date
     1337             ).
     1338           run doclslib-log-information in this-procedure
     1339             (input p-log-handle
     1340             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1341                              ,buf_doc-list.doc-code
     1342                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1343                              ,buf_doc-list.fact-order
     1344                              )
     1345             ) .
     1346         end.
     1347         else do:
     1348           run doclslib-log-information in this-procedure
     1349             (input p-log-handle
     1350             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1351                              ,buf_doc-list.doc-code
     1352                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1353                              ,buf_doc-list.fact-order
     1354                              )
     1355             ) .
     1356           run trg/calc-apc.p
     1357             (input buf_doc-list.doc-code
     1358             ,input p-cut-date
     1359             ).
     1360           run doclslib-log-information in this-procedure
     1361             (input p-log-handle
     1362             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1363                              ,buf_doc-list.doc-code
     1364                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1365                              ,buf_doc-list.fact-order
     1366                              )
     1367             ) .
     1368         end.
     1369         if  p-update-recalc  = true
     1370         and v-prev-fact-date <> ?
     1371         and buf_doc-list.fact-date > v-prev-fact-date
     1372         then do:
     1373           run gbl/clntat-w.p
     1374             (input p-obj-type
     1375             ,input p-obj-code
     1376             ,input 'arh-recalc':U
     1377             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1378             ) .
     1379           run doclslib-log-information in this-procedure
     1380             (input p-log-handle
     1381             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1382                              ,string(v-prev-fact-date, '99/99/9999':u)
     1383                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1384                              )
     1385             ) .
     1386         end.
     1387         assign
     1388           v-prev-fact-date = buf_doc-list.fact-date
     1389         .
     1390       end.
     1391     end.
     1392   end procedure.
     1393   procedure doclslib-calc-aht :
     1394     define input  parameter p-log-handle    as handle    no-undo .
     1395     define input  parameter p-obj-type      as character no-undo .
     1396     define input  parameter p-obj-code      as integer   no-undo .
     1397     define input  parameter p-cut-date      as date      no-undo .
     1398     define input  parameter p-update-recalc as logical   no-undo .
     1399     define variable v-prev-fact-date as date      no-undo .
     1400     define buffer buf_doc-list for doc-list .
     1401     define buffer stop-aht-restore-lock_btpr for ub.batchprocess .
     1402     define buffer stop-aht-news-lock_btpr    for ub.batchprocess .
     1403     do
     1404     on error undo, return error return-value
     1405     :
     1406       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1407       run gbl/lockrngd.p
     1408         (input  'grar':U
     1409         ,input  'disable':U
     1410         ,buffer buf_lock_gdsrenart_batchprocess
     1411         ) no-error .
     1412       if error-status :error
     1413       then do:
     1414         if error-status :get-message(1) <> ""
     1415         then do:
     1416           message
     1417             vss-workfile vss-revision vss-description skip
     1418             "Ошибка при блокировании функции переименования артикула товара" skip
     1419             error-status :get-message(1) skip
     1420             return-value skip
     1421             view-as alert-box error .
     1422         end.
     1423         undo, return error return-value .
     1424       end.
     1425       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1426       run gbl/lockrngd.p
     1427         (input  'grgc':U
     1428         ,input  'disable':U
     1429         ,buffer buf_lock_gdsrengc_batchprocess
     1430         ) no-error .
     1431       if error-status :error
     1432       then do:
     1433         if error-status :get-message(1) <> ""
     1434         then do:
     1435           message
     1436             vss-workfile vss-revision vss-description skip
     1437             "Ошибка при блокировании функции переименования кода товара" skip
     1438             error-status :get-message(1) skip
     1439             return-value skip
     1440             view-as alert-box error .
     1441         end.
     1442         undo, return error return-value .
     1443       end.
     1444       for each buf_doc-list
     1445       by buf_doc-list.fact-order
     1446       on error undo, return error
     1447       :
     1448         find first stop-aht-restore-lock_btpr no-lock
     1449           where stop-aht-restore-lock_btpr.bp_type       = 'lock':U + 'rsts':U
     1450             and stop-aht-restore-lock_btpr.bp_status     = 'N':U
     1451             and stop-aht-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1452             and stop-aht-restore-lock_btpr.Key#_Two      = 0
     1453             and stop-aht-restore-lock_btpr.Key#_Three    = 0
     1454             and stop-aht-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1455             and stop-aht-restore-lock_btpr.CharKey_Two   = ""
     1456             and stop-aht-restore-lock_btpr.CharKey_Three = ""
     1457           no-error .
     1458         if available stop-aht-restore-lock_btpr
     1459         then do:
     1460           undo, return error "Процедура восстановления складского архива запросила остановку процедуры автоматического расчета складского архива" .
     1461         end.
     1462         find first stop-aht-news-lock_btpr no-lock
     1463           where stop-aht-news-lock_btpr.bp_type       = 'lock':U + 'rstn':U
     1464             and stop-aht-news-lock_btpr.bp_status     = 'N':U
     1465             and stop-aht-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1466             and stop-aht-news-lock_btpr.Key#_Two      = 0
     1467             and stop-aht-news-lock_btpr.Key#_Three    = 0
     1468             and stop-aht-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1469             and stop-aht-news-lock_btpr.CharKey_Three = ""
     1470           no-error .
     1471         if available stop-aht-news-lock_btpr
     1472         then do:
     1473           undo, return error "Система новостей запросила остановку процедуры автоматического расчета складского архива" .
     1474         end.
     1475         if buf_doc-list.is-trn-doc
     1476         then do:
     1477           run doclslib-log-information in this-procedure
     1478             (input p-log-handle
     1479             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1480                              ,buf_doc-list.doc-code
     1481                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1482                              ,buf_doc-list.fact-order
     1483                              )
     1484             ) .
     1485           run trg/aht-doc.p
     1486             (input buf_doc-list.doc-code
     1487             ,input p-cut-date
     1488             ).
     1489           run doclslib-log-information in this-procedure
     1490             (input p-log-handle
     1491             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1492                              ,buf_doc-list.doc-code
     1493                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1494                              ,buf_doc-list.fact-order
     1495                              )
     1496             ) .
     1497         end.
     1498         else do:
     1499           run doclslib-log-information in this-procedure
     1500             (input p-log-handle
     1501             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1502                              ,buf_doc-list.doc-code
     1503                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1504                              ,buf_doc-list.fact-order
     1505                              )
     1506             ) .
     1507           run trg/aht-prc.p
     1508             (input buf_doc-list.doc-code
     1509             ,input p-cut-date
     1510             ).
     1511           run doclslib-log-information in this-procedure
     1512             (input p-log-handle
     1513             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1514                              ,buf_doc-list.doc-code
     1515                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1516                              ,buf_doc-list.fact-order
     1517                              )
     1518             ) .
     1519         end.
     1520         if  p-update-recalc  = true
     1521         and v-prev-fact-date <> ?
     1522         and buf_doc-list.fact-date > v-prev-fact-date
     1523         then do:
     1524           run gbl/clntat-w.p
     1525             (input p-obj-type
     1526             ,input p-obj-code
     1527             ,input 'aht-recalc':U
     1528             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1529             ) .
     1530           run doclslib-log-information in this-procedure
     1531             (input p-log-handle
     1532             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1533                              ,string(v-prev-fact-date, '99/99/9999':u)
     1534                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1535                              )
     1536             ) .
     1537         end.
     1538         assign
     1539           v-prev-fact-date = buf_doc-list.fact-date
     1540         .
     1541       end.
     1542     end.
     1543   end procedure.
     1544   procedure doclslib-calc-ahsp :
     1545     define input  parameter p-log-handle    as handle    no-undo .
     1546     define input  parameter p-obj-type      as character no-undo .
     1547     define input  parameter p-obj-code      as integer   no-undo .
     1548     define input  parameter p-cut-date      as date      no-undo .
     1549     define input  parameter p-update-recalc as logical   no-undo .
     1550     define variable v-prev-fact-date as date      no-undo .
     1551     define buffer buf_doc-list for doc-list .
     1552     define buffer stop-ahsp-restore-lock_btpr for ub.batchprocess .
     1553     define buffer stop-ahsp-news-lock_btpr    for ub.batchprocess .
     1554     do
     1555     on error undo, return error return-value
     1556     :
     1557       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1558       run gbl/lockrngd.p
     1559         (input  'grar':U
     1560         ,input  'disable':U
     1561         ,buffer buf_lock_gdsrenart_batchprocess
     1562         ) no-error .
     1563       if error-status :error
     1564       then do:
     1565         if error-status :get-message(1) <> ""
     1566         then do:
     1567           message
     1568             vss-workfile vss-revision vss-description skip
     1569             "Ошибка при блокировании функции переименования артикула товара" skip
     1570             error-status :get-message(1) skip
     1571             return-value skip
     1572             view-as alert-box error .
     1573         end.
     1574         undo, return error return-value .
     1575       end.
     1576       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1577       run gbl/lockrngd.p
     1578         (input  'grgc':U
     1579         ,input  'disable':U
     1580         ,buffer buf_lock_gdsrengc_batchprocess
     1581         ) no-error .
     1582       if error-status :error
     1583       then do:
     1584         if error-status :get-message(1) <> ""
     1585         then do:
     1586           message
     1587             vss-workfile vss-revision vss-description skip
     1588             "Ошибка при блокировании функции переименования кода товара" skip
     1589             error-status :get-message(1) skip
     1590             return-value skip
     1591             view-as alert-box error .
     1592         end.
     1593         undo, return error return-value .
     1594       end.
     1595       for each buf_doc-list
     1596         where buf_doc-list.is-trn-doc = true
     1597       by buf_doc-list.fact-order
     1598       on error undo, return error
     1599       :
     1600         find first stop-ahsp-restore-lock_btpr no-lock
     1601           where stop-ahsp-restore-lock_btpr.bp_type       = 'lock':U + 'rsss':U
     1602             and stop-ahsp-restore-lock_btpr.bp_status     = 'N':U
     1603             and stop-ahsp-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1604             and stop-ahsp-restore-lock_btpr.Key#_Two      = 0
     1605             and stop-ahsp-restore-lock_btpr.Key#_Three    = 0
     1606             and stop-ahsp-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1607             and stop-ahsp-restore-lock_btpr.CharKey_Two   = ""
     1608             and stop-ahsp-restore-lock_btpr.CharKey_Three = ""
     1609           no-error .
     1610         if available stop-ahsp-restore-lock_btpr
     1611         then do:
     1612           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1613         end.
     1614         find first stop-ahsp-news-lock_btpr no-lock
     1615           where stop-ahsp-news-lock_btpr.bp_type       = 'lock':U + 'rssn':U
     1616             and stop-ahsp-news-lock_btpr.bp_status     = 'N':U
     1617             and stop-ahsp-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1618             and stop-ahsp-news-lock_btpr.Key#_Two      = 0
     1619             and stop-ahsp-news-lock_btpr.Key#_Three    = 0
     1620             and stop-ahsp-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1621             and stop-ahsp-news-lock_btpr.CharKey_Three = ""
     1622           no-error .
     1623         if available stop-ahsp-news-lock_btpr
     1624         then do:
     1625           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1626         end.
     1627         run doclslib-log-information in this-procedure
     1628           (input p-log-handle
     1629           ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1630                             ,buf_doc-list.doc-code
     1631                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1632                             ,buf_doc-list.fact-order
     1633                             )
     1634           ) .
     1635         define variable v-need-process as logical   no-undo .
     1636         run trg/ah-csptr.p
     1637           (input  buf_doc-list.doc-code
     1638           ,input  p-cut-date
     1639           ,input  false
     1640           ,output v-need-process
     1641           ).
     1642         run doclslib-log-information in this-procedure
     1643           (input p-log-handle
     1644           ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1645                             ,buf_doc-list.doc-code
     1646                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1647                             ,buf_doc-list.fact-order
     1648                             )
     1649           ) .
     1650         if  p-update-recalc  = true
     1651         and v-prev-fact-date <> ?
     1652         and buf_doc-list.fact-date > v-prev-fact-date
     1653         then do:
     1654           run gbl/clntat-w.p
     1655             (input p-obj-type
     1656             ,input p-obj-code
     1657             ,input 'ahsp-recalc':U
     1658             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1659             ) .
     1660           run doclslib-log-information in this-procedure
     1661             (input p-log-handle
     1662             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1663                              ,string(v-prev-fact-date, '99/99/9999':u)
     1664                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1665                              )
     1666             ) .
     1667         end.
     1668         assign
     1669           v-prev-fact-date = buf_doc-list.fact-date
     1670         .
     1671       end.
     1672     end.
     1673   end procedure.
     1674   procedure doclslib-log-information :
     1675     define input  parameter p-log-handle as handle    no-undo .
     1676     define input  parameter p-message    as character no-undo .
     1677     do
     1678     on error undo, return error return-value
     1679     :
     1680       define variable v-log-procedure-name as character no-undo .
     1681       assign
     1682         v-log-procedure-name = "cb-doclslib-log"
     1683       .
     1684       if valid-handle(p-log-handle)
     1685       and p-log-handle :get-signature(v-log-procedure-name) <> ""
     1686       then do:
     1687         run value(v-log-procedure-name) in p-log-handle
     1688           (input p-message
     1689           ) no-error .
     1690       end.
     1691     end.
     1692   end procedure.
     1693   procedure doclslib-find-last-fact-date :
     1694     define output parameter p-last-fact-date  as date      no-undo .
     1695     define output parameter p-reason          as character no-undo .
     1696     do
     1697     on error undo, return error
     1698     :
     1699       define variable v-last-fact-date    as date      no-undo .
     1700       define buffer buf_doc-list for doc-list .
     1701       assign
     1702         v-last-fact-date    = ?
     1703       .
     1704       for each buf_doc-list
     1705       by buf_doc-list.fact-order
     1706       on error undo, return error
     1707       :
     1708         if buf_doc-list.is-archive-exist = false
     1709         or buf_doc-list.fact-date = ?
     1710         then do:
     1711           assign
     1712             p-reason = p-reason + substitute("По документу &1 отсутствует рассчитанный складской архив"
     1713                                             ,buf_doc-list.doc-code
     1714                                             )
     1715           .
     1716           leave .
     1717         end.
     1718         if buf_doc-list.fact-date = ?
     1719         then do:
     1720           assign
     1721             p-reason = p-reason + substitute("Документ &1 имеет не заданную фактическую дату "
     1722                                             ,buf_doc-list.doc-code
     1723                                             )
     1724           .
     1725           leave .
     1726         end.
     1727         if v-last-fact-date = ?
     1728         or (v-last-fact-date <> ?
     1729             and v-last-fact-date < buf_doc-list.fact-date
     1730            )
     1731         then do:
     1732           assign
     1733             v-last-fact-date = buf_doc-list.fact-date
     1734             p-reason         = substitute("Последний рассчитанный документ &1" + chr(10)
     1735                                          ,buf_doc-list.doc-code
     1736                                          )
     1737           .
     1738         end.
     1739       end.
     1740       assign
     1741         p-last-fact-date = v-last-fact-date
     1742       .
     1743     end.
     1744   end procedure.
     1745   procedure doclslib-check-arh-exist :
     1746     define input parameter  p-obj-type       as character no-undo .
     1747     define input parameter  p-obj-code       as integer   no-undo .
     1748     define input parameter  p-cut-fact-order as decimal   no-undo .
     1749     define output parameter p-archive-exist  as logical   no-undo .
     1750     define buffer buf_stk-tot for ub.stk-tot .
     1751     do
     1752     on error undo, return error
     1753     :
     1754       find first buf_stk-tot no-lock
     1755         where buf_stk-tot.obj-type   = p-obj-type
     1756           and buf_stk-tot.obj-code   = p-obj-code
     1757           and buf_stk-tot.fact-order > p-cut-fact-order
     1758         no-error .
     1759       assign
     1760         p-archive-exist = (available buf_stk-tot)
     1761       .
     1762     end.
     1763   end procedure.
     1764   procedure doclslib-check-aht-exist :
     1765     define input parameter  p-obj-type       as character no-undo .
     1766     define input parameter  p-obj-code       as integer   no-undo .
     1767     define input parameter  p-cut-fact-order as decimal   no-undo .
     1768     define output parameter p-archive-exist  as logical   no-undo .
     1769     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     1770     do
     1771     on error undo, return error
     1772     :
     1773       find first buf_aht-stk-tot no-lock
     1774         where buf_aht-stk-tot.obj-type   = p-obj-type
     1775           and buf_aht-stk-tot.obj-code   = p-obj-code
     1776           and buf_aht-stk-tot.fact-order > p-cut-fact-order
     1777         no-error .
     1778       assign
     1779         p-archive-exist = (available buf_aht-stk-tot)
     1780       .
     1781     end.
     1782   end procedure.
     1783   procedure doclslib-check-ahsp-exist :
     1784     define input parameter  p-obj-type       as character no-undo .
     1785     define input parameter  p-obj-code       as integer   no-undo .
     1786     define input parameter  p-cut-fact-order as decimal   no-undo .
     1787     define output parameter p-archive-exist  as logical   no-undo .
     1788     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     1789     do
     1790     on error undo, return error
     1791     :
     1792       find first buf_stk-supp-tot no-lock
     1793         where buf_stk-supp-tot.obj-type   = p-obj-type
     1794           and buf_stk-supp-tot.obj-code   = p-obj-code
     1795           and buf_stk-supp-tot.fact-order > p-cut-fact-order
     1796         no-error .
     1797       assign
     1798         p-archive-exist = (available buf_stk-supp-tot)
     1799       .
     1800     end.
     1801   end procedure.
     1802   procedure doclslib-check-doc-arh-exist :
     1803     define buffer buf_doc-list for doc-list .
     1804     define buffer buf_ot-tot for ub.ot-tot .
     1805     do
     1806     on error undo, return error return-value
     1807     :
     1808       for each buf_doc-list
     1809       on error undo, return error
     1810       :
     1811         find first buf_ot-tot no-lock
     1812           where buf_ot-tot.doc-code = buf_doc-list.doc-code
     1813           no-error .
     1814         if available buf_ot-tot
     1815         then do:
     1816           assign
     1817             buf_doc-list.is-archive-exist = true
     1818           .
     1819         end.
     1820         else do:
     1821           assign
     1822             buf_doc-list.is-archive-exist = false
     1823           .
     1824         end.
     1825       end.
     1826     end.
     1827   end procedure.
     1828   procedure doclslib-check-doc-aht-exist :
     1829     define buffer buf_doc-list for doc-list .
     1830     define buffer buf_aht-doc for ub.aht-doc .
     1831     do
     1832     on error undo, return error return-value
     1833     :
     1834       for each buf_doc-list
     1835       on error undo, return error
     1836       :
     1837         find first buf_aht-doc no-lock
     1838           where buf_aht-doc.doc-code = buf_doc-list.doc-code
     1839           no-error .
     1840         if available buf_aht-doc
     1841         then do:
     1842           assign
     1843             buf_doc-list.is-archive-exist = true
     1844           .
     1845         end.
     1846         else do:
     1847           assign
     1848             buf_doc-list.is-archive-exist = false
     1849           .
     1850         end.
     1851       end.
     1852     end.
     1853   end procedure.
     1854   procedure doclslib-check-doc-ahsp-exist :
     1855     define buffer buf_doc-list for doc-list .
     1856     define buffer buf_ot-supp-line for ub.ot-supp-tot .
     1857     do
     1858     on error undo, return error return-value
     1859     :
     1860       for each buf_doc-list
     1861       on error undo, return error
     1862       :
     1863         find first buf_ot-supp-line no-lock
     1864           where buf_ot-supp-line.doc-code = buf_doc-list.doc-code
     1865           no-error .
     1866         if available buf_ot-supp-line
     1867         then do:
     1868           assign
     1869             buf_doc-list.is-archive-exist = true
     1870           .
     1871         end.
     1872         else do:
     1873           if buf_doc-list.doc-type = 'инв':U
     1874           then do:
     1875             define variable v-need-process as logical   no-undo .
     1876             run trg/ah-csptr.p
     1877               (input  buf_doc-list.doc-code
     1878               ,input  0
     1879               ,input  true
     1880               ,output v-need-process
     1881               ).
     1882             if v-need-process = true
     1883             then do:
     1884               assign
     1885                 buf_doc-list.is-archive-exist = false
     1886               .
     1887             end.
     1888             else do:
     1889               assign
     1890                 buf_doc-list.is-archive-exist = true
     1891               .
     1892             end.
     1893           end.
     1894           else do:
     1895             assign
     1896               buf_doc-list.is-archive-exist = false
     1897             .
     1898           end.
     1899         end.
     1900       end.
     1901     end.
     1902   end procedure.
     1903   procedure doclslib-clear-ahsp-doc-list :
     1904     define buffer buf_doc-list for doc-list .
     1905     define buffer buf_trn-doc  for ub.trn-doc .
     1906     define buffer buf_doc-line for ub.doc-line .
     1907     define buffer buf_parts    for ub.parts .
     1908     do
     1909     on error undo, return error return-value
     1910     :
     1911       check-doc-list :
     1912       for each buf_doc-list
     1913       on error undo, return error return-value
     1914       :
     1915         find first buf_trn-doc no-lock
     1916           where buf_trn-doc.doc-code = buf_doc-list.doc-code
     1917           .
     1918         if buf_trn-doc.office = true
     1919         then do:
     1920           delete buf_doc-list .
     1921           next check-doc-list .
     1922         end.
     1923         find first buf_doc-line no-lock
     1924           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1925           no-error .
     1926         if not available buf_doc-line
     1927         then do:
     1928           delete buf_doc-list .
     1929           next check-doc-list .
     1930         end.
     1931         find first buf_parts no-lock
     1932           where buf_parts.out-code = buf_trn-doc.doc-code
     1933             and buf_parts.fact-qnty <> 0
     1934           no-error .
     1935         if not available buf_parts
     1936         then do:
     1937           delete buf_doc-list .
     1938           next check-doc-list .
     1939         end.
     1940       end.
     1941     end.
     1942   end procedure.
     1943   procedure doclslib-init-goods :
     1944     define buffer buf_doclslib-goods for doclslib-goods .
     1945     define buffer buf_doc-list       for doc-list .
     1946     define buffer buf_trn-doc        for ub.trn-doc .
     1947     define buffer buf_price-doc      for ub.price-doc .
     1948     define buffer buf_doc-line       for ub.doc-line .
     1949     define buffer buf_price-list     for ub.price-list .
     1950     define variable v-gds-code as integer   no-undo .
     1951     do
     1952     on error undo, return error return-value
     1953     :
     1954       for each buf_doclslib-goods
     1955       on error undo, return error return-value
     1956       :
     1957         delete buf_doclslib-goods .
     1958       end.
     1959       for each buf_doc-list
     1960       on error undo, return error return-value
     1961       :
     1962         if buf_doc-list.is-trn-doc
     1963         then do:
     1964           find first buf_trn-doc no-lock
     1965             where buf_trn-doc.doc-code = buf_doc-list.doc-code
     1966             .
     1967           for each buf_doc-line no-lock
     1968             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1969           on error undo, return error return-value
     1970           :
     1971   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1972   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
