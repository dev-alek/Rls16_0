     6103                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     6104                                              ) / cli-base-ratecl = ? then 0
     6105                                           else
     6106                                             (price-cli-with-tax-loccl +
     6107                                              road-tax-cli-loccl       +
     6108                                              (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-cli-loccl else 0) +
     6109                                              (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-cli-loccl else 0)
     6110                                              ) / cli-base-ratecl * cl_tt-clcparts.fact-qnty)
     6111     bf_tt-allsum.dsc-base-acc         = 0
