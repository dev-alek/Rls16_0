     6896   procedure clcprtsl_calc-ttable :
     6897   define input parameter paris-doc           as   logical                 no-undo.
     6898   define input parameter paris-cur           as   logical                 no-undo.
     6899   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     6900   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     6901   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     6902   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     6903   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     6904   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     6905   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     6906   define input parameter parr-b              as   character               no-undo.
     6907   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     6908   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     6909   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     6910   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     6911   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     6912   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     6913   define buffer bf_tt-allsum      for tt-allsum.
     6914   define buffer bf_tt-clcparts    for tt-clcparts.
     6915   define buffer bf_tt-allsum-line for tt-allsum-line.
     6916   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     6917   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     6918   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     6919   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     6920   define variable varexcise          like ub.price-list.excise     no-undo.
     6921   do on error undo, return error return-value :
     6922   for each bf_tt-allsum-line
     6923   on error undo, return error return-value
     6924    :
     6925     delete bf_tt-allsum-line.
     6926   end.
     6927   for each bf_tt-allsum
     6928   on error undo, return error return-value
     6929   :
     6930     delete bf_tt-allsum.
     6931   end.
     6932   for each bf_tt-clcparts
     6933   on error undo, return error return-value
     6934   :
     6935   if v-calcbypart then do:
     6936             assign
     6937             parcur-base =   bf_tt-clcparts.part-cur-base
     6938             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     6939             parcur-excise =   bf_tt-clcparts.part-cur-excise
     6940             .
     6941   end.
     6942      run clcprtsl_calc-parts in this-procedure (
     6943        input recid(bf_tt-clcparts),
     6944        input paris-doc,
     6945        input paris-cur,
     6946        input parroad-tax,
     6947        input parexcise,
     6948        input parvat-pc,
     6949        input parcons-vat-pc,
     6950        input parslt-pc,
     6951        input parbase-rate,
     6952        input parbase-scale,
     6953        input parr-b,
     6954        input parcur-base,
     6955        input parcur-road-tax,
     6956        input parcur-excise,
     6957        input parcur-vat-pc,
     6958        input parcurcons-vat-pc,
     6959        input parcurslt-pc
     6960        ) no-error.
     6961     if error-status:error then do:
     6962       message
     6963         vss-workfile vss-revision vss-description skip
     6964         vss-include-info38 skip
     6965         "Ошибка при обсчете партии" skip
     6966         "Документ партии " bf_tt-clcparts.out-code skip
