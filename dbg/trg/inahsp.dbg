     2488   procedure prdoclib-clear-temp-prt-obj :
     2489     define buffer buf_temp-prt-obj for temp-prt-obj .
     2490     do
     2491     on error undo, return error return-value
     2492     :
     2493       for each buf_temp-prt-obj
     2494       on error undo, return error return-value
     2495       :
     2496         delete buf_temp-prt-obj .
     2497       end.
     2498     end.
     2499   end procedure.
     2500   procedure prdoclib-create-temp-prt-obj :
     2501     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2502     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2503     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2504     define buffer buf_gds-prt for ub.gds-prt .
     2505     do
     2506     on error undo, return error return-value
     2507     :
     2508       find first buf_temp-prt-obj
     2509         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2510         no-error .
     2511       if not available buf_temp-prt-obj
     2512       then do:
     2513         create buf_temp-prt-obj .
     2514         assign
     2515           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2516           buf_temp-prt-obj.price-sale       = ?
     2517           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2518           buf_temp-prt-obj.price-list-qnty  = ?
     2519           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2520           buf_temp-prt-obj.price-list-recid = ?
     2521         .
     2522         find first buf_gds-prt no-lock
     2523           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2524           .
     2525         assign
     2526           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2527         .
     2528         if buf_temp-prt-obj.is-term
     2529         then do:
     2530           assign
     2531             buf_temp-prt-obj.price-sale = p-root-price-sale
     2532           .
     2533         end.
     2534       end.
     2535     end.
     2536   end procedure.
     2537   procedure prdoclib-temp-prt-obj-by-prt-root :
     2538     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     2539     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2540     define buffer buf_gds-prt for ub.gds-prt .
     2541     do
     2542     on error undo, return error return-value
     2543     :
     2544       find first buf_temp-prt-obj
     2545         where buf_temp-prt-obj.prt-code = p-prt-code
     2546         no-error .
     2547       if not available buf_temp-prt-obj
     2548       then do:
     2549         create buf_temp-prt-obj .
     2550         assign
     2551           buf_temp-prt-obj.prt-code         = p-prt-code
     2552           buf_temp-prt-obj.price-sale       = ?
     2553           buf_temp-prt-obj.fact-qnty        = 0
     2554           buf_temp-prt-obj.price-list-qnty  = ?
     2555           buf_temp-prt-obj.prt-obj-recid    = ?
     2556           buf_temp-prt-obj.price-list-recid = ?
     2557         .
     2558         find first buf_gds-prt no-lock
     2559           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2560           .
     2561         assign
     2562           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2563         .
     2564         if buf_temp-prt-obj.is-term
     2565         then do:
     2566           assign
     2567             buf_temp-prt-obj.price-sale = 0
     2568           .
     2569         end.
     2570       end.
     2571     end.
     2572   end procedure.
     2573   procedure prdoclib-init-temp-prt-obj :
     2574     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2575     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2576     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2577     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2578     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2579     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2580     define buffer buf_prt-obj      for ub.prt-obj .
     2581     define buffer buf_temp-prt-obj for temp-prt-obj .
     2582     do
     2583     on error undo, return error return-value
     2584     :
     2585       run prdoclib-clear-temp-prt-obj in this-procedure .
     2586       for each buf_prt-obj
     2587         where buf_prt-obj.obj-type  = p-obj-type
     2588           and buf_prt-obj.obj-code  = p-obj-code
     2589           and buf_prt-obj.artic     = p-artic
     2590           and buf_prt-obj.prod-type = p-prod-type
     2591           and buf_prt-obj.prod-code = p-prod-code
     2592       on error undo, return error return-value
     2593       :
     2594         run prdoclib-create-temp-prt-obj in this-procedure
     2595           (input  p-root-price-sale
     2596           ,buffer buf_prt-obj
     2597           ,buffer buf_temp-prt-obj
     2598           ).
     2599       end.
     2600     end.
     2601   end procedure.
     2602   procedure prdoclib-calc-fact-sale :
     2603     define input  parameter p-price-list-recid   as recid     no-undo .
     2604     define output parameter p-fact-qnty          as decimal   no-undo .
     2605     define output parameter p-cur-base           as decimal   no-undo .
     2606     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2607     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2608     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2609     define output parameter p-cur-excise-base    as decimal   no-undo .
     2610     define buffer buf_main_price-list for ub.price-list .
     2611     define buffer buf_price-list      for ub.price-list .
     2612     define buffer buf_goods           for ub.goods .
     2613     define buffer buf_gds-obj         for ub.gds-obj .
     2614     define buffer buf_bar-code        for ub.bar-code .
     2615     define variable l-empty-scale   as logical   no-undo .
     2616     do
     2617     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     2618     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2619     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2620     :
     2621       find first buf_main_price-list no-lock
     2622         where recid(buf_main_price-list) = p-price-list-recid
     2623         no-error .
     2624       if not available buf_main_price-list
     2625       then do:
     2626         message
     2627           vss-workfile vss-revision vss-description skip
     2628           vss-include-info9 skip
     2629           "Ошибка задания входных параметров" skip
     2630           "Не найдена строка переоценки" skip
     2631           "Код записи (recid)" p-price-list-recid skip
     2632           view-as alert-box error .
     2633         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2634       end.
     2635       if buf_main_price-list.main-price <> true
     2636       then do:
     2637         message
     2638           vss-workfile vss-revision vss-description skip
     2639           vss-include-info9 skip
     2640           "Ошибка задания входных параметров" skip
     2641           "Строка переоценки не является основной" skip
     2642           "Код записи (recid)" p-price-list-recid skip
     2643           "Переоценка" buf_main_price-list.doc-num skip
     2644           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2645           "Бар-код" buf_main_price-list.b-code skip
     2646           view-as alert-box error .
     2647         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2648       end.
     2649       find first buf_goods no-lock
     2650         where buf_goods.artic     = buf_main_price-list.artic
     2651           and buf_goods.prod-type = buf_main_price-list.prod-type
     2652           and buf_goods.prod-code = buf_main_price-list.prod-code
     2653         no-error .
     2654       if not available buf_goods
     2655       then do:
     2656         message
     2657           vss-workfile vss-revision vss-description skip
     2658           vss-include-info9 skip
     2659           "Не найден товар" skip
     2660           "Переоценка" buf_main_price-list.doc-num skip
     2661           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2662           view-as alert-box error .
     2663         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2664       end.
     2665   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2667     (input  buf_main_price-list.artic
     2668     ,input  buf_main_price-list.prod-type
     2669     ,input  buf_main_price-list.prod-code
     2670     ,input  'empty-scale=request':u
     2671     ,output l-empty-scale
     2672     ) no-error .
     2673       if error-status :error
     2674       then do:
     2675         message
     2676           vss-workfile vss-revision vss-description skip
     2677           vss-include-info9 skip
     2678           "Ошибка при определении атрибута товара" skip
     2679           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2680           'empty-scale=request':u skip
     2681           error-status :get-message(1) skip
     2682           return-value skip
     2683           view-as alert-box error .
     2684         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2685       end.
     2686       find first buf_gds-obj no-lock
     2687         where buf_gds-obj.gds-code = buf_goods.gds-code
     2688           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     2689           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     2690         no-error .
     2691         if not available buf_gds-obj then do:
     2692   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2693   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2694     (input  buf_main_price-list.obj-type
     2695     ,input  buf_main_price-list.obj-code
     2696     ,input  buf_goods.artic
     2697     ,input  buf_goods.prod-type
     2698     ,input  buf_goods.prod-code
     2699     ,buffer buf_gds-obj
     2700     ) no-error .
     2701           if error-status :error then do:
     2702              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2703           end.
     2704         end.
     2705       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2706       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2707       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2708       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2709       define variable vat-base-sale-prl               as decimal   no-undo .
     2710       define variable vat-rubl-sale-prl               as decimal   no-undo .
     2711       define variable vat-base-buyer-prl              as decimal   no-undo .
     2712       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2713       define variable slt-base-sale-prl               as decimal   no-undo .
     2714       define variable slt-rubl-sale-prl               as decimal   no-undo .
     2715       define variable road-tax-base-sale-prl          as decimal   no-undo .
     2716       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2717       define variable excise-base-sale-prl            as decimal   no-undo .
     2718       define variable excise-rubl-sale-prl            as decimal   no-undo .
     2719       define variable discnt-base-sale-prl            as decimal   no-undo .
     2720       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2721       if buf_main_price-list.doc-qnty <> 0
     2722       then do:
     2723         run prl-vat in this-procedure
     2724           (input  recid(buf_main_price-list)
     2725           ,output price-rubl-with-tax-sale-prl
     2726           ,output price-base-with-tax-sale-prl
     2727           ,output price-rubl-without-tax-sale-prl
     2728           ,output price-base-without-tax-sale-prl
     2729           ,output vat-base-sale-prl
     2730           ,output vat-rubl-sale-prl
     2731           ,output vat-base-buyer-prl
     2732           ,output vat-rubl-buyer-prl
     2733           ,output slt-base-sale-prl
     2734           ,output slt-rubl-sale-prl
     2735           ,output road-tax-base-sale-prl
     2736           ,output road-tax-rubl-sale-prl
     2737           ,output excise-base-sale-prl
     2738           ,output excise-rubl-sale-prl
     2739           ,output discnt-base-sale-prl
     2740           ,output discnt-rubl-sale-prl
     2741           ) no-error .
     2742         if error-status :error
     2743         then do:
     2744           message
     2745             vss-workfile vss-revision vss-description skip
     2746             vss-include-info9 skip
     2747             "Ошибка при вызове процеды prl-vat" skip
     2748             "Документ" buf_main_price-list.doc-num skip
     2749             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2750             error-status :get-message(1) skip
     2751             return-value skip
     2752             view-as alert-box error .
     2753           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2754         end.
     2755       end.
     2756       else do:
     2757         assign
     2758           price-rubl-with-tax-sale-prl    = 0
     2759           price-base-with-tax-sale-prl    = 0
     2760           price-rubl-without-tax-sale-prl = 0
     2761           price-base-without-tax-sale-prl = 0
     2762           vat-base-sale-prl               = 0
     2763           vat-rubl-sale-prl               = 0
     2764           vat-base-buyer-prl              = 0
     2765           vat-rubl-buyer-prl              = 0
     2766           slt-base-sale-prl               = 0
     2767           slt-rubl-sale-prl               = 0
     2768           road-tax-base-sale-prl          = 0
     2769           road-tax-rubl-sale-prl          = 0
     2770           excise-base-sale-prl            = 0
     2771           excise-rubl-sale-prl            = 0
     2772           discnt-base-sale-prl            = 0
     2773           discnt-rubl-sale-prl            = 0
     2774         .
     2775       end.
     2776       define variable v-curr-r-b as character no-undo .
     2777   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2778   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2779     (output v-curr-r-b
     2780     )  .
     2781       if v-curr-r-b = 'base':U
     2782       then do:
     2783         assign
     2784           p-fact-qnty         = buf_main_price-list.doc-qnty
     2785           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     2786           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     2787           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     2788           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     2789           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     2790         .
     2791       end.
     2792       else do:
     2793         assign
     2794           p-fact-qnty         = buf_main_price-list.doc-qnty
     2795           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     2796           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     2797           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     2798           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     2799           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     2800         .
     2801       end.
     2802         define variable v-unit-base like ub.goods.unit-base no-undo .
     2803   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2804   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2805     (input  buf_goods.gds-code
     2806     ,output v-unit-base
     2807     ) no-error .
     2808         if error-status :error
     2809         then do:
     2810           message
     2811             vss-workfile vss-revision vss-description skip
     2812             vss-include-info9 skip
     2813             "Ошибка при определении базовой единицы измерения товара" skip
     2814             "Код товара" buf_goods.gds-code skip
     2815             error-status :get-message(1) skip
     2816             return-value skip
     2817             view-as alert-box error .
     2818           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2819         end.
     2820         for each buf_price-list no-lock
     2821           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     2822             and buf_price-list.main-price = false
     2823             and buf_price-list.artic      = buf_main_price-list.artic
     2824             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     2825             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     2826         :
     2827           if buf_price-list.doc-qnty = ?
     2828           then do:
     2829             find first buf_bar-code no-lock
     2830               where buf_bar-code.b-code = buf_price-list.b-code
     2831               no-error .
     2832             if available buf_bar-code
     2833             and buf_bar-code.unit-cli = v-unit-base
     2834             then do:
     2835               message
     2836                 vss-workfile vss-revision vss-description skip
     2837                 vss-include-info9 skip
     2838                 "Ошибка при закрытии переоценки" skip
     2839                 "Не задано количество для бар-кода с основной единицей измерения" skip
     2840                 "Переоценка" buf_main_price-list.doc-num skip
     2841                 "Бар-код" buf_price-list.b-code skip
     2842                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2843                 "Количество" buf_price-list.doc-qnty skip
     2844                 "Основная единица измерения" v-unit-base skip
     2845                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     2846                 view-as alert-box error .
     2847               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2848             end.
     2849             next .
     2850           end.
     2851           if not can-find
     2852             (first buf_bar-code
     2853             where buf_bar-code.b-code = buf_price-list.b-code
     2854             )
     2855           then do:
     2856             message
     2857               vss-workfile vss-revision vss-description skip
     2858               vss-include-info9 skip
     2859               "В переоценке задан несуществующий бар-код" skip
     2860               "Переоценка" buf_price-list.doc-num skip
     2861               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2862               "Бар-код" buf_price-list.b-code skip
     2863               view-as alert-box error .
     2864             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2865           end.
     2866           if buf_price-list.doc-qnty <> 0
     2867           then do:
     2868             run prl-vat in this-procedure
     2869               (input  recid(buf_price-list)
     2870               ,output price-rubl-with-tax-sale-prl
     2871               ,output price-base-with-tax-sale-prl
     2872               ,output price-rubl-without-tax-sale-prl
     2873               ,output price-base-without-tax-sale-prl
     2874               ,output vat-base-sale-prl
     2875               ,output vat-rubl-sale-prl
     2876               ,output vat-base-buyer-prl
     2877               ,output vat-rubl-buyer-prl
     2878               ,output slt-base-sale-prl
     2879               ,output slt-rubl-sale-prl
     2880               ,output road-tax-base-sale-prl
     2881               ,output road-tax-rubl-sale-prl
     2882               ,output excise-base-sale-prl
     2883               ,output excise-rubl-sale-prl
     2884               ,output discnt-base-sale-prl
     2885               ,output discnt-rubl-sale-prl
     2886               ) no-error .
     2887             if error-status :error
     2888             then do:
     2889               message
     2890                 vss-workfile vss-revision vss-description skip
     2891                 vss-include-info9 skip
     2892                 "Ошибка при вызове процеды prl-vat" skip
     2893                 "Документ" buf_price-list.doc-num skip
     2894                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2895                 error-status :get-message(1) skip
     2896                 return-value skip
     2897                 view-as alert-box error .
     2898               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2899             end.
     2900           end.
     2901           else do:
     2902             assign
     2903               price-rubl-with-tax-sale-prl    = 0
     2904               price-base-with-tax-sale-prl    = 0
     2905               price-rubl-without-tax-sale-prl = 0
     2906               price-base-without-tax-sale-prl = 0
     2907               vat-base-sale-prl               = 0
     2908               vat-rubl-sale-prl               = 0
     2909               vat-base-buyer-prl              = 0
     2910               vat-rubl-buyer-prl              = 0
     2911               slt-base-sale-prl               = 0
     2912               slt-rubl-sale-prl               = 0
     2913               road-tax-base-sale-prl          = 0
     2914               road-tax-rubl-sale-prl          = 0
     2915               excise-base-sale-prl            = 0
     2916               excise-rubl-sale-prl            = 0
     2917               discnt-base-sale-prl            = 0
     2918               discnt-rubl-sale-prl            = 0
     2919             .
     2920           end.
     2921           if v-curr-r-b = 'base':U
     2922           then do:
     2923             assign
     2924               p-fact-qnty         = p-fact-qnty
     2925                                   + buf_price-list.doc-qnty
     2926               p-cur-base          = p-cur-base
     2927                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     2928               p-cur-VAT-base      = p-cur-VAT-base
     2929                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     2930               p-cur-SLT-base      = p-cur-SLT-base
     2931                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     2932               p-cur-road-tax-base = p-cur-road-tax-base
     2933                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     2934               p-cur-excise-base   = p-cur-excise-base
     2935                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     2936             .
     2937           end.
     2938           else do:
     2939             assign
     2940               p-fact-qnty         = p-fact-qnty
     2941                                   + buf_price-list.doc-qnty
     2942               p-cur-base          = p-cur-base
     2943                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     2944               p-cur-VAT-base      = p-cur-VAT-base
     2945                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     2946               p-cur-SLT-base      = p-cur-SLT-base
     2947                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     2948               p-cur-road-tax-base = p-cur-road-tax-base
     2949                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     2950               p-cur-excise-base   = p-cur-excise-base
     2951                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     2952             .
     2953           end.
     2954         end.
     2955     end.
     2956   end procedure.
     2957   procedure prdoclib-calc-prc :
     2958     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2959     define input  parameter p-cons-pay        as   integer                no-undo.
     2960     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2961     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2962     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2963     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2964     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2965     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2966     do
     2967     on error undo, return error return-value
     2968     :
     2969       define buffer buf_price-doc       for ub.price-doc .
     2970       define buffer buf_price-list      for ub.price-list .
     2971       define buffer buf_parts           for ub.parts .
     2972       define variable v-ov-qnty     as decimal   no-undo .
     2973       define variable v-ov-base     as decimal   no-undo .
     2974       define variable v-ov-VAT-base as decimal   no-undo .
     2975       define variable v-ov-SLT-base as decimal   no-undo .
     2976       define variable v-cons-qnty   as decimal   no-undo .
     2977       define variable v-prch-qnty   as decimal   no-undo .
     2978       define variable v-cons-mult   as decimal   no-undo .
     2979       define variable v-prch-mult   as decimal   no-undo .
     2980       find first buf_price-doc no-lock
     2981         where recid(buf_price-doc) = p-price-doc-recid
     2982         no-error .
     2983       if not available buf_price-doc
     2984       then do:
     2985         message
     2986           vss-workfile vss-revision vss-description skip
     2987           vss-include-info9 skip
     2988           "Ошибка задания входных параметров" skip
     2989           "Не найден документ переоценки" skip
     2990           "Код записи (recid)" p-price-doc-recid skip
     2991           view-as alert-box error .
     2992         undo, return error .
     2993       end.
     2994       for each buf_price-list no-lock
     2995         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2996           and buf_price-list.main-price = true
     2997       on error undo, return error return-value
     2998       :
     2999         run prdoclib-calc-ov
     3000           (input recid(buf_price-list)
     3001           ,output v-ov-qnty
     3002           ,output v-ov-base
     3003           ,output v-ov-VAT-base
     3004           ,output v-ov-SLT-base
     3005           ) no-error .
     3006         if error-status :error
     3007         then do:
     3008           if error-status :get-message(1) <> ""
     3009           then do:
     3010             message
     3011               vss-workfile vss-revision vss-description skip
     3012               vss-include-info9 skip
     3013               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     3014               error-status :get-message(1) skip
     3015               return-value skip
     3016               view-as alert-box error .
     3017           end.
     3018           undo, return error return-value .
     3019         end.
     3020         assign
     3021           v-cons-qnty = 0
     3022           v-prch-qnty = 0
     3023         .
     3024         for each buf_parts no-lock
     3025           where buf_parts.out-code  = buf_price-list.doc-num
     3026             and buf_parts.obj-type  = buf_price-list.obj-type
     3027             and buf_parts.obj-code  = buf_price-list.obj-code
     3028             and buf_parts.artic     = buf_price-list.artic
     3029             and buf_parts.prod-type = buf_price-list.prod-type
     3030             and buf_parts.prod-code = buf_price-list.prod-code
     3031         on error undo, return error return-value
     3032         :
     3033           if buf_parts.pay-code = p-cons-pay
     3034           then do:
     3035             assign
     3036               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     3037             .
     3038           end.
     3039           else do:
     3040             assign
     3041               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     3042             .
     3043           end.
     3044         end.
     3045         if (v-cons-qnty + v-prch-qnty) = 0
     3046         then do:
     3047           assign
     3048             v-cons-mult = 0
     3049             v-prch-mult = 1
     3050           .
     3051         end.
     3052         else do:
     3053           assign
     3054             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     3055             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     3056           .
     3057         end.
     3058         assign
     3059           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     3060           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     3061           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     3062           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     3063           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     3064           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     3065         .
     3066       end.
     3067     end.
     3068   end procedure.
     3069   procedure prdoclib-calc-ov :
     3070     define input  parameter p-price-list-recid as recid     no-undo .
     3071     define output parameter p-fact-qnty        as decimal   no-undo .
     3072     define output parameter p-ov-base          as decimal   no-undo .
     3073     define output parameter p-ov-VAT-base      as decimal   no-undo .
     3074     define output parameter p-ov-SLT-base      as decimal   no-undo .
     3075     do
     3076     on error undo, return error return-value
     3077     :
     3078       define buffer buf_main_price-list    for ub.price-list .
     3079       define buffer buf_prev_price-list    for ub.price-list .
     3080       define buffer buf_special_price-list for ub.price-list .
     3081       define buffer buf_goods              for ub.goods .
     3082       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     3083       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     3084       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     3085       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     3086       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     3087       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     3088       define variable v-prev-price-list-recid as   recid                  no-undo.
     3089       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     3090       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     3091       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     3092       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     3093       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     3094       find first buf_main_price-list no-lock
     3095         where recid(buf_main_price-list) = p-price-list-recid
     3096         no-error .
     3097       if not available buf_main_price-list
     3098       then do:
     3099         message
     3100           vss-workfile vss-revision vss-description skip
     3101           vss-include-info9 skip
     3102           "Ошибка задания входных параметров" skip
     3103           "Не найдена строка переоценки" skip
     3104           "Код записи (recid)" p-price-list-recid skip
     3105           view-as alert-box error .
     3106         undo, return error .
     3107       end.
     3108       if buf_main_price-list.main-price <> true
     3109       then do:
     3110         message
     3111           vss-workfile vss-revision vss-description skip
     3112           vss-include-info9 skip
     3113           "Ошибка задания входных параметров" skip
     3114           "Строка переоценки не является основной" skip
     3115           "Код записи (recid)" p-price-list-recid skip
     3116           "Переоценка" buf_main_price-list.doc-num skip
     3117           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3118           "Бар-код" buf_main_price-list.b-code skip
     3119           view-as alert-box error .
     3120         undo, return error .
     3121       end.
     3122       run prdoclib-calc-fact-sale in this-procedure
     3123         (input  recid(buf_main_price-list)
     3124         ,output v-fact-qnty
     3125         ,output v-cur-base
     3126         ,output v-cur-VAT-base
     3127         ,output v-cur-SLT-base
     3128         ,output v-cur-road-tax-base
     3129         ,output v-cur-excise-base
     3130         ) no-error.
     3131       if error-status :error
     3132       then do:
     3133         message
     3134           vss-workfile vss-revision vss-description skip
     3135           vss-include-info9 skip
     3136           "Ошибка при расчете сумм переоценки." skip
     3137           "Документ переоценки" buf_main_price-list.doc-num skip
     3138           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3139           error-status :get-message(1) skip
     3140           return-value skip
     3141           view-as alert-box error .
     3142         undo, return error .
     3143       end.
     3144   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3146     (input  buf_main_price-list.obj-type
     3147     ,input  buf_main_price-list.obj-code
     3148     ,input  buf_main_price-list.b-code
     3149     ,input  buf_main_price-list.b-code
     3150     ,input  buf_main_price-list.fact-order
     3151     ,output v-prev-price-list-recid
     3152     ,output v-prev-cli-base-rate
     3153     ) no-error .
     3154       if error-status :error
     3155       then do:
     3156         message
     3157           vss-workfile vss-revision vss-description skip
     3158           vss-include-info9 skip
     3159           "Ошибка при поиске предыдущей переоценки." skip
     3160           "Документ переоценки " buf_main_price-list.doc-num skip
     3161           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3162           error-status :get-message(1) skip
     3163           return-value skip
     3164           view-as alert-box error .
     3165         undo, return error .
     3166       end.
     3167       if v-prev-price-list-recid <> ?
     3168       then do:
     3169         find first buf_prev_price-list no-lock
     3170           where recid(buf_prev_price-list) = v-prev-price-list-recid
     3171           .
     3172         find first buf_special_price-list no-lock
     3173           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     3174             and buf_special_price-list.main-price = false
     3175             and buf_special_price-list.artic      = buf_prev_price-list.artic
     3176             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     3177             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     3178             and buf_special_price-list.doc-qnty   <> ?
     3179           no-error .
     3180         if available buf_special_price-list
     3181         then do:
     3182           message
     3183             "Товар имеет специальные цены на признаки" skip
     3184             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3185             "Переоценка" buf_prev_price-list.doc-num skip
     3186             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3187             view-as alert-box error .
     3188           undo, return error .
     3189         end.
     3190         find first buf_goods no-lock
     3191           where buf_goods.artic     = buf_main_price-list.artic
     3192             and buf_goods.prod-type = buf_main_price-list.prod-type
     3193             and buf_goods.prod-code = buf_main_price-list.prod-code
     3194           no-error .
     3195         if not available buf_goods
     3196         then do:
     3197           message
     3198             vss-workfile vss-revision vss-description skip
     3199             vss-include-info9 skip
     3200             "Не найден товар" skip
     3201             "Переоценка" buf_main_price-list.doc-num skip
     3202             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3203             view-as alert-box error .
     3204           undo, return error .
     3205         end.
     3206         if buf_prev_price-list.vat-pc = ?
     3207         or buf_prev_price-list.slt-pc = ?
     3208         then do:
     3209           message
     3210             "В переоценке не заданы налоги товара" skip
     3211             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3212             "Переоценка" buf_prev_price-list.doc-num skip
     3213             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3214             "НДС" buf_prev_price-list.vat-pc skip
     3215             "НП" buf_prev_price-list.slt-pc skip
     3216             view-as alert-box error .
     3217           undo, return error return-value .
     3218         end.
     3219         define variable v-prev-cur-SLT-pc as decimal no-undo .
     3220         assign
     3221           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     3222         .
     3223         assign
     3224           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     3225           v-prev-cur-VAT-base = v-fact-qnty
     3226                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     3227                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     3228           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     3229         .
     3230         assign
     3231           p-fact-qnty   = v-fact-qnty
     3232           p-ov-base     = v-cur-base     - v-prev-cur-base
     3233           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3234           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3235         .
     3236       end.
     3237       else do:
     3238         assign
     3239           v-prev-cur-base     = 0
     3240           v-prev-cur-VAT-base = 0
     3241           v-prev-cur-SLT-base = 0
     3242           .
     3243         assign
     3244           p-fact-qnty   = v-fact-qnty
     3245           p-ov-base     = v-cur-base     - v-prev-cur-base
     3246           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3247           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3248         .
     3249       end.
     3250     end.
     3251   end procedure.
     3252   procedure prdoclib-init-prt-obj-by-factord :
     3253     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3254     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3255     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3256     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3257     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3258     define input parameter p-fact-order         as decimal   no-undo .
     3259     define input parameter p-include-fact-order as logical   no-undo .
     3260     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     3261     define buffer buf_gds-obj      for ub.gds-obj .
     3262     define buffer buf_doc-line     for ub.doc-line .
     3263     define buffer buf_temp-prt-obj for temp-prt-obj .
     3264     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3265     do
     3266     on error undo, return error return-value
     3267     :
     3268       do transaction
     3269       on error undo, return error return-value
     3270       :
     3271   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3272   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3273     (input  p-obj-type
     3274     ,input  p-obj-code
     3275     ,input  p-artic
     3276     ,input  p-prod-type
     3277     ,input  p-prod-code
     3278     ,buffer buf_gds-obj
     3279     ) no-error .
     3280         if error-status :error
     3281         then do:
     3282           message
     3283             vss-workfile vss-revision vss-description skip
     3284             vss-include-info9 skip
     3285             "Невозможно найти gds-obj" skip
     3286             error-status :get-message(1) skip
     3287             return-value skip
     3288             view-as alert-box error .
     3289           undo, return error .
     3290         end.
     3291         find current buf_gds-obj exclusive-lock .
     3292       end.
     3293       run prdoclib-init-temp-prt-obj in this-procedure
     3294         (input p-obj-type
     3295         ,input p-obj-code
     3296         ,input p-artic
     3297         ,input p-prod-type
     3298         ,input p-prod-code
     3299         ,input 0
     3300         ) .
     3301       for each buf_temp-prt-obj
     3302         where buf_temp-prt-obj.is-term <> true
     3303       on error undo, return error return-value
     3304       :
     3305         delete buf_temp-prt-obj .
     3306       end.
     3307       if p-include-fact-order = true
     3308       then do:
     3309         assign
     3310          p-fact-order = p-fact-order - 0.0000000001
     3311         .
     3312       end.
     3313       for each buf_doc-line no-lock
     3314         where buf_doc-line.obj-type   = p-obj-type
     3315           and buf_doc-line.obj-code   = p-obj-code
     3316           and buf_doc-line.artic      = p-artic
     3317           and buf_doc-line.prod-type  = p-prod-type
     3318           and buf_doc-line.prod-code  = p-prod-code
     3319           and buf_doc-line.status_    = 'факт':U
     3320           and buf_doc-line.fact-order >= p-fact-order
     3321       on error undo, return error return-value
     3322       :
     3323         run prdoclib-process-document in this-procedure
     3324           (input  buf_doc-line.doc-code
     3325           ,input  p-obj-type
     3326           ,input  p-obj-code
     3327           ,input  p-artic
     3328           ,input  p-prod-type
     3329           ,input  p-prod-code
     3330           ,output v-total-gds-dtl-qnty
     3331           ) .
     3332       end.
     3333     end.
     3334   end procedure.
     3335   procedure prdoclib-process-document :
     3336     define input  parameter p-doc-code           as character no-undo .
     3337     define input  parameter p-obj-type           as character no-undo .
     3338     define input  parameter p-obj-code           as integer   no-undo .
     3339     define input  parameter p-artic              as character no-undo .
     3340     define input  parameter p-prod-type          as character no-undo .
     3341     define input  parameter p-prod-code          as integer   no-undo .
     3342     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3343     define buffer buf_trn-doc      for ub.trn-doc .
     3344     define buffer buf_gds-dtl      for ub.gds-dtl .
     3345     define buffer buf_temp-prt-obj for temp-prt-obj .
     3346     do
     3347     on error undo, return error return-value
     3348     :
     3349       find first buf_trn-doc no-lock
     3350         where buf_trn-doc.doc-code = p-doc-code
     3351         no-error .
     3352       if not available buf_trn-doc then do:
     3353         message
     3354           vss-workfile vss-revision vss-description skip
     3355           vss-include-info9 skip
     3356           "Ошибка при поиске документа" skip
     3357           "Документ" p-doc-code skip
     3358           "Объект" p-obj-type p-obj-code skip
     3359           "Артикул" p-artic p-prod-type p-prod-code skip
     3360           view-as alert-box error .
     3361         undo, return error .
     3362       end.
     3363       assign
     3364         p-total-gds-dtl-qnty = 0
     3365       .
     3366       for each buf_gds-dtl no-lock
     3367         where buf_gds-dtl.doc-code  = p-doc-code
     3368           and buf_gds-dtl.artic     = p-artic
     3369           and buf_gds-dtl.prod-type = p-prod-type
     3370           and buf_gds-dtl.prod-code = p-prod-code
     3371       on error undo, return error
     3372       :
     3373         define variable v-term-node as integer   no-undo .
     3374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3375     (input  buf_gds-dtl.prt-code
     3376     ,output v-term-node
     3377     )  .
     3378         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3379           (input  v-term-node
     3380           ,buffer buf_temp-prt-obj
     3381           ) .
     3382         if buf_temp-prt-obj.is-term <> true then do:
     3383           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3384                                        ,buf_gds-dtl.prt-code
     3385                                        ) .
     3386         end.
     3387         case buf_trn-doc.doc-type :
     3388           when 'при':U or
     3389           when 'возврат':U
     3390           then do:
     3391             assign
     3392               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3393                                           - buf_gds-dtl.fact-qnty
     3394               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3395                                           - buf_gds-dtl.fact-qnty
     3396             .
     3397           end.
     3398           when 'рас':U or
     3399           when 'спи':U
     3400           then do:
     3401             assign
     3402               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3403                                           + buf_gds-dtl.fact-qnty
     3404               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3405                                           + buf_gds-dtl.fact-qnty
     3406             .
     3407           end.
     3408           when 'инв':U
     3409           then do:
     3410             assign
     3411               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3412                                           - buf_gds-dtl.doc-qnty
     3413               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3414                                           - buf_gds-dtl.doc-qnty
     3415             .
     3416           end.
     3417           otherwise do:
     3418             undo, return error substitute("Неизвестный тип документа &1"
     3419                                          ,buf_trn-doc.doc-type
     3420                                          ) .
     3421           end.
     3422         end.
     3423       end.
     3424     end.
     3425   end procedure.
     3426   procedure prdoclib-prc-pl-document :
     3427     define input  parameter p-doc-code              as character no-undo .
     3428     define input  parameter p-obj-type              as character no-undo .
     3429     define input  parameter p-obj-code              as integer   no-undo .
     3430     define input  parameter p-gds-code              as integer   no-undo .
     3431     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3432     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3433     do
     3434     on error undo, return error return-value
     3435     :
     3436       define buffer buf_trn-doc      for ub.trn-doc .
     3437       define buffer buf_doc-pl       for ub.doc-pl .
     3438       define buffer buf_temp-pl-gds for temp-pl-gds .
     3439       define variable v-sign as decimal   no-undo .
     3440       find first buf_trn-doc no-lock
     3441         where buf_trn-doc.doc-code = p-doc-code
     3442         no-error .
     3443       if not available buf_trn-doc then do:
     3444         message
     3445           vss-workfile vss-revision vss-description skip
     3446           vss-include-info9 skip
     3447           "Ошибка при поиске документа" skip
     3448           "Документ" p-doc-code skip
     3449           "Объект" p-obj-type p-obj-code skip
     3450           "Товар" p-gds-code skip
     3451           view-as alert-box error .
     3452         undo, return error .
     3453       end.
     3454       assign
     3455         p-total-pl-gds-qnty     = 0
     3456         p-total-pl-gds-cli-qnty = 0
     3457       .
     3458       for each buf_doc-pl no-lock
     3459         where buf_doc-pl.out-code  = p-doc-code
     3460           and buf_doc-pl.gds-code  = p-gds-code
     3461       on error undo, return error return-value
     3462       :
     3463         find first buf_temp-pl-gds
     3464           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3465             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3466             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3467           .
     3468         case buf_trn-doc.doc-type :
     3469           when 'при':U
     3470           or when 'возврат':U
     3471           or when 'инв':U
     3472           then do:
     3473             assign
     3474               v-sign = -1.0
     3475             .
     3476           end.
     3477           when 'рас':U or
     3478           when 'спи':U
     3479           then do:
     3480             assign
     3481               v-sign = 1.0
     3482             .
     3483           end.
     3484           otherwise do:
     3485             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3486           end.
     3487         end case.
     3488         assign
     3489           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3490           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3491           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3492           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3493         .
     3494       end.
     3495     end.
     3496   end procedure.
     3497   procedure prdoclib-init-prt-obj-by-date :
     3498     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3499     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3500     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3501     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3502     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3503     define input parameter p-fact-date  as date      no-undo .
     3504     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3505     do
     3506     on error undo, return error return-value
     3507     :
     3508       define variable v-fact-order                as decimal   no-undo .
     3509       define variable v-shift-end-fact-order      as decimal   no-undo .
     3510       define variable v-day-end-fact-order        as decimal   no-undo .
     3511       run factord in this-procedure
     3512         (input  p-fact-date
     3513         ,input  1
     3514         ,input  1
     3515         ,input  ?
     3516         ,input  0
     3517         ,input  false
     3518         ,output v-fact-order
     3519         ,output v-shift-end-fact-order
     3520         ,output v-day-end-fact-order
     3521         ) no-error .
     3522       if error-status :error
     3523       then do:
     3524         message
     3525           vss-workfile vss-revision vss-description skip
     3526           vss-include-info9 skip
     3527           "Ошибка при определении момента времени, на который требуется остаток" skip
     3528           "Объект" p-obj-type p-obj-code skip
     3529           "Артикул" p-artic p-prod-type p-prod-code skip
     3530           "Дата" p-fact-date skip
     3531           view-as alert-box error .
     3532         undo, return error .
     3533       end.
     3534       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3535         (input p-obj-type
     3536         ,input p-obj-code
     3537         ,input p-artic
     3538         ,input p-prod-type
     3539         ,input p-prod-code
     3540         ,input v-day-end-fact-order
     3541         ,input false
     3542         ) no-error .
     3543       if error-status :error
     3544       then do:
     3545         message
     3546           vss-workfile vss-revision vss-description skip
     3547           vss-include-info9 skip
     3548           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3549           "Объект" p-obj-type p-obj-code skip
     3550           "Артикул" p-artic p-prod-type p-prod-code skip
     3551           "Дата" p-fact-date skip
     3552           view-as alert-box error .
     3553         undo, return error .
     3554       end.
     3555     end.
     3556   end procedure.
     3557   procedure prdoclib-calc-temp-fact-sale :
     3558     define input  parameter p-obj-type           as character no-undo .
     3559     define input  parameter p-obj-code           as integer   no-undo .
     3560     define input  parameter p-gds-code           as integer   no-undo .
     3561     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3562     define input  parameter p-curr-r-b           as character no-undo .
     3563     define output parameter p-fact-qnty          as decimal   no-undo .
     3564     define output parameter p-cur-base           as decimal   no-undo .
     3565     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3566     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3567     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3568     define output parameter p-cur-excise-base    as decimal   no-undo .
     3569     define buffer buf_temp-prt-obj for temp-prt-obj .
     3570     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3571     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3572     define variable parrecid-prl        as recid     no-undo .
     3573     define variable v-fact-qnty         as decimal   no-undo .
     3574     define variable v-cur-base          as decimal   no-undo .
     3575     define variable v-cur-VAT-base      as decimal   no-undo .
     3576     define variable v-cur-SLT-base      as decimal   no-undo .
     3577     define variable v-cur-road-tax-base as decimal   no-undo .
     3578     define variable v-cur-excise-base   as decimal   no-undo .
     3579     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3580     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3581     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3582     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3583     define variable vat-base-sale-prl               as decimal   no-undo .
     3584     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3585     define variable vat-base-buyer-prl              as decimal   no-undo .
     3586     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3587     define variable slt-base-sale-prl               as decimal   no-undo .
     3588     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3589     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3590     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3591     define variable excise-base-sale-prl            as decimal   no-undo .
     3592     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3593     define variable discnt-base-sale-prl            as decimal   no-undo .
     3594     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3595     do
     3596     on error undo, return error return-value
     3597     :
     3598       for each buf_temp-prt-obj no-lock
     3599       on error undo, return error return-value
     3600       :
     3601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3602     (input  p-gds-code
     3603     ,input  buf_temp-prt-obj.prt-code
     3604     ,output v-prt-b-code
     3605     ) no-error .
     3606         if error-status :error
     3607         then do:
     3608           message
     3609             vss-workfile vss-revision vss-description skip
     3610             "Ошибка при определении бар-кода признака" skip
     3611             "Код товара"   p-gds-code skip
     3612             "Код признака" buf_temp-prt-obj.prt-code skip
     3613             error-status :get-message(1) skip
     3614             return-value skip
     3615             view-as alert-box error .
     3616           undo, return error .
     3617         end.
     3618   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3619   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3620     (input  p-obj-type
     3621     ,input  p-obj-code
     3622     ,input  v-prt-b-code
     3623     ,input  0
     3624     ,input  p-day-end-fact-order
     3625     ,output parrecid-prl
     3626     ,output v-cli-base-rate
     3627     ) no-error .
     3628         if error-status :error
     3629         then do:
     3630           message
     3631             vss-workfile vss-revision vss-description skip
     3632             "Ошибка при определении цены бар-кода" skip
     3633             "Объект" p-obj-type p-obj-code skip
     3634             "Бар-код" v-prt-b-code skip
     3635             "fact-order" p-day-end-fact-order skip
     3636             error-status :get-message(1) skip
     3637             return-value skip
     3638             view-as alert-box error .
     3639           undo, return error .
     3640         end.
     3641         if parrecid-prl <> ?
     3642         then do:
     3643           run prl-vat in this-procedure
     3644             (input  parrecid-prl
     3645             ,output price-rubl-with-tax-sale-prl
     3646             ,output price-base-with-tax-sale-prl
     3647             ,output price-rubl-without-tax-sale-prl
     3648             ,output price-base-without-tax-sale-prl
     3649             ,output vat-base-sale-prl
     3650             ,output vat-rubl-sale-prl
     3651             ,output vat-base-buyer-prl
     3652             ,output vat-rubl-buyer-prl
     3653             ,output slt-base-sale-prl
     3654             ,output slt-rubl-sale-prl
     3655             ,output road-tax-base-sale-prl
     3656             ,output road-tax-rubl-sale-prl
     3657             ,output excise-base-sale-prl
     3658             ,output excise-rubl-sale-prl
     3659             ,output discnt-base-sale-prl
     3660             ,output discnt-rubl-sale-prl
     3661             ) no-error .
     3662           if error-status :error
     3663           then do:
     3664             message
     3665               vss-workfile vss-revision vss-description skip
     3666               "Ошибка при вызове процеды prl-vat" skip
     3667               "Объект" p-obj-type p-obj-code skip
     3668               "Код товара" p-gds-code skip
     3669               "Указатель на запись переоценки" parrecid-prl skip
     3670               error-status :get-message(1) skip
     3671               return-value skip
     3672               view-as alert-box error .
     3673             undo, return error .
     3674           end.
     3675         end.
     3676         else do:
     3677           assign
     3678             price-rubl-with-tax-sale-prl    = 0
     3679             price-base-with-tax-sale-prl    = 0
     3680             price-rubl-without-tax-sale-prl = 0
     3681             price-base-without-tax-sale-prl = 0
     3682             vat-base-sale-prl               = 0
     3683             vat-rubl-sale-prl               = 0
     3684             slt-base-sale-prl               = 0
     3685             slt-rubl-sale-prl               = 0
     3686             road-tax-base-sale-prl          = 0
     3687             road-tax-rubl-sale-prl          = 0
     3688             excise-base-sale-prl            = 0
     3689             excise-rubl-sale-prl            = 0
     3690             discnt-base-sale-prl            = 0
     3691             discnt-rubl-sale-prl            = 0
     3692           .
     3693         end.
     3694         assign
     3695           v-fact-qnty         = v-fact-qnty
     3696                               + buf_temp-prt-obj.fact-qnty
     3697           v-cur-base          = v-cur-base
     3698                               + (if p-curr-r-b = 'base':U
     3699                                   then price-base-with-tax-sale-prl
     3700                                   else price-rubl-with-tax-sale-prl
     3701                                 )
     3702                               * buf_temp-prt-obj.fact-qnty
     3703           v-cur-VAT-base      = v-cur-VAT-base
     3704                               + (if p-curr-r-b = 'base':U
     3705                                   then vat-base-sale-prl
     3706                                   else vat-rubl-sale-prl
     3707                                 )
     3708                               * buf_temp-prt-obj.fact-qnty
     3709           v-cur-SLT-base      = v-cur-SLT-base
     3710                               + (if p-curr-r-b = 'base':U
     3711                                   then slt-base-sale-prl
     3712                                   else slt-rubl-sale-prl
     3713                                 )
     3714                               * buf_temp-prt-obj.fact-qnty
     3715           v-cur-road-tax-base = v-cur-road-tax-base
     3716                               + (if p-curr-r-b = 'base':U
     3717                                   then road-tax-base-sale-prl
     3718                                   else road-tax-rubl-sale-prl
     3719                                 )
     3720                               * buf_temp-prt-obj.fact-qnty
     3721           v-cur-excise-base   = v-cur-excise-base
     3722                               + (if p-curr-r-b = 'base':U
     3723                                   then excise-base-sale-prl
     3724                                   else excise-rubl-sale-prl
     3725                                 )
     3726                               * buf_temp-prt-obj.fact-qnty
     3727         .
     3728       end.
     3729       assign
     3730         p-fact-qnty         = v-fact-qnty
     3731         p-cur-base          = v-cur-base
     3732         p-cur-VAT-base      = v-cur-VAT-base
     3733         p-cur-SLT-base      = v-cur-SLT-base
     3734         p-cur-road-tax-base = v-cur-road-tax-base
     3735         p-cur-excise-base   = v-cur-excise-base
     3736       .
     3737     end.
     3738   end procedure.
     3739   procedure prdoclib-clear-temp-pl-gds :
     3740     define buffer buf_temp-pl-gds for temp-pl-gds .
     3741     do
     3742     on error undo, return error return-value
     3743     :
     3744       for each buf_temp-pl-gds
     3745       on error undo, return error return-value
     3746       :
     3747         delete buf_temp-pl-gds .
     3748       end.
     3749     end.
     3750   end procedure.
     3751   procedure prdoclib-init-temp-pl-gds :
     3752     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3753     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3754     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3755     define buffer buf_pl-gds      for ub.pl-gds .
     3756     define buffer buf_temp-pl-gds for temp-pl-gds .
     3757     do
     3758     on error undo, return error return-value
     3759     :
     3760       run prdoclib-clear-temp-pl-gds in this-procedure .
     3761       for each buf_pl-gds
     3762         where buf_pl-gds.obj-type = p-obj-type
     3763           and buf_pl-gds.obj-code = p-obj-code
     3764           and buf_pl-gds.gds-code = p-gds-code
     3765       on error undo, return error return-value
     3766       :
     3767         create buf_temp-pl-gds .
     3768         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3769       end.
     3770     end.
     3771   end procedure.
     3772   procedure prdoclib-init-pl-gds-by-factord :
     3773     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3774     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3775     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3776     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3777     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3778     define input parameter p-fact-order         as decimal   no-undo .
     3779     define input parameter p-include-fact-order as logical   no-undo .
     3780     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3781     define buffer buf_goods       for ub.goods .
     3782     define buffer buf_gds-obj     for ub.gds-obj .
     3783     define buffer buf_doc-line    for ub.doc-line .
     3784     define buffer buf_temp-pl-gds for temp-pl-gds .
     3785     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3786     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3787     do
     3788     on error undo, return error return-value
     3789     :
     3790       do transaction
     3791       on error undo, return error return-value
     3792       :
     3793   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3794   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3795     (input  p-obj-type
     3796     ,input  p-obj-code
     3797     ,input  p-artic
     3798     ,input  p-prod-type
     3799     ,input  p-prod-code
     3800     ,buffer buf_gds-obj
     3801     ) no-error .
     3802         if error-status :error
     3803         then do:
     3804           message
     3805             vss-workfile vss-revision vss-description skip
     3806             vss-include-info9 skip
     3807             "Невозможно найти gds-obj" skip
     3808             error-status :get-message(1) skip
     3809             return-value skip
     3810             view-as alert-box error .
     3811           undo, return error return-value .
     3812         end.
     3813         find current buf_gds-obj exclusive-lock .
     3814       end.
     3815       find first buf_goods no-lock
     3816         where buf_goods.artic     = p-artic
     3817           and buf_goods.prod-type = p-prod-type
     3818           and buf_goods.prod-code = p-prod-code
     3819         .
     3820       run prdoclib-init-temp-pl-gds in this-procedure
     3821         (input p-obj-type
     3822         ,input p-obj-code
     3823         ,input buf_goods.gds-code
     3824         ) .
     3825       if p-include-fact-order = true
     3826       then do:
     3827         assign
     3828          p-fact-order = p-fact-order - 0.0000000001
     3829         .
     3830       end.
     3831       for each buf_doc-line no-lock
     3832         where buf_doc-line.obj-type   = p-obj-type
     3833           and buf_doc-line.obj-code   = p-obj-code
     3834           and buf_doc-line.artic      = p-artic
     3835           and buf_doc-line.prod-type  = p-prod-type
     3836           and buf_doc-line.prod-code  = p-prod-code
     3837           and buf_doc-line.status_    = 'факт':U
     3838           and buf_doc-line.fact-order >= p-fact-order
     3839       on error undo, return error return-value
     3840       :
     3841         run prdoclib-prc-pl-document in this-procedure
     3842           ( input  buf_doc-line.doc-code
     3843            ,input  p-obj-type
     3844            ,input  p-obj-code
     3845            ,input  buf_goods.gds-code
     3846            ,output v-total-pl-gds-qnty
     3847            ,output v-total-pl-gds-cli-qnty
     3848           ) .
     3849       end.
     3850     end.
     3851   end procedure.
     3852   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3853   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     3854   procedure partslib-clear-temp-parts :
     3855     define buffer buf_temp-parts for temp-parts .
     3856     do
     3857     on error undo, return error
     3858     :
     3859       for each buf_temp-parts
     3860       on error undo, return error
     3861       :
     3862         delete buf_temp-parts .
     3863       end.
     3864     end.
     3865   end procedure.
     3866   procedure partslib-create-temp-parts :
     3867     define parameter buffer buf_parts       for ub.parts .
     3868     define parameter buffer buf_temp-parts  for temp-parts .
     3869     define input  parameter p-goods-twounit as logical   no-undo .
     3870     define variable v-base-part-code as character no-undo .
     3871     do
     3872     on error undo, return error
     3873     :
     3874       if p-goods-twounit = true
     3875       then do:
     3876         assign
     3877           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     3878         .
     3879       end.
     3880       else do:
     3881         assign
     3882           v-base-part-code = buf_parts.part-code
     3883         .
     3884       end.
     3885       find first buf_temp-parts exclusive-lock
     3886         where buf_temp-parts.obj-type  = buf_parts.obj-type
     3887           and buf_temp-parts.obj-code  = buf_parts.obj-code
     3888           and buf_temp-parts.artic     = buf_parts.artic
     3889           and buf_temp-parts.prod-type = buf_parts.prod-type
     3890           and buf_temp-parts.prod-code = buf_parts.prod-code
     3891           and buf_temp-parts.in-code   = buf_parts.in-code
     3892           and buf_temp-parts.out-code  = 'free-zone':U
     3893           and buf_temp-parts.part-code = v-base-part-code
     3894         no-error.
     3895       if not available buf_temp-parts
     3896       then do:
     3897         create buf_temp-parts .
     3898         buffer-copy buf_parts to buf_temp-parts
     3899         assign
     3900           buf_temp-parts.out-code  = 'free-zone':U
     3901           buf_temp-parts.part-code = v-base-part-code
     3902           buf_temp-parts.rsrv-free = yes
     3903           buf_temp-parts.status_   = no
     3904           buf_temp-parts.qnty      = 0
     3905           buf_temp-parts.fact-qnty = 0
     3906           buf_temp-parts.real-qnty = 0
     3907           buf_temp-parts.cli-qnty  = 0
     3908         .
     3909       end.
     3910     end.
     3911   end procedure.
     3912   procedure partslib-init-temp-parts :
     3913     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     3914     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     3915     define input parameter p-artic           like ub.parts.artic     no-undo .
     3916     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     3917     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     3918     define buffer buf_parts      for ub.parts .
     3919     define buffer buf_temp-parts for temp-parts .
     3920     define variable v-goods-twounit    as logical   no-undo .
     3921     do
     3922     on error undo, return error
     3923     :
     3924   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     3926     (input  p-artic
     3927     ,input  p-prod-type
     3928     ,input  p-prod-code
     3929     ,input  'twounit=request':u
     3930     ,output v-goods-twounit
     3931     ) no-error .
     3932       if error-status :error
     3933       then do:
     3934         message
     3935           vss-workfile vss-revision vss-description skip
     3936           vss-include-info26 skip
     3937           "Ошибка при определении атрибута товара" skip
     3938           "Артикул" p-artic p-prod-type p-prod-code skip
     3939           "twounit=request" skip
     3940           error-status :get-message(1) skip
     3941           return-value skip
     3942           view-as alert-box error .
     3943         undo, return error return-value .
     3944       end.
     3945       run partslib-clear-temp-parts in this-procedure .
     3946       for each buf_parts
     3947         where buf_parts.obj-type  = p-obj-type
     3948           and buf_parts.obj-code  = p-obj-code
     3949           and buf_parts.artic     = p-artic
     3950           and buf_parts.prod-type = p-prod-type
     3951           and buf_parts.prod-code = p-prod-code
     3952           and buf_parts.rsrv-free = yes
     3953           and buf_parts.status_   = no
     3954           and buf_parts.in-code   <> buf_parts.out-code
     3955       on error undo, return error
     3956       :
     3957         run partslib-create-temp-parts in this-procedure
     3958           (buffer buf_parts
     3959           ,buffer buf_temp-parts
     3960           ,input  v-goods-twounit
     3961           ) .
     3962         define variable v-parts-qnty          as decimal   no-undo .
     3963         define variable v-parts-cli-qnty      as decimal   no-undo .
     3964         define variable v-parts-free-qnty     as decimal   no-undo .
     3965         define variable v-parts-free-cli-qnty as decimal   no-undo .
     3966         if buf_parts.out-code = 'free-zone':U
     3967         then do:
     3968           assign
     3969             v-parts-qnty          = buf_parts.qnty
     3970             v-parts-cli-qnty      = buf_parts.cli-qnty
     3971             v-parts-free-qnty     = buf_parts.qnty
     3972             v-parts-free-cli-qnty = buf_parts.cli-qnty
     3973           .
     3974         end.
     3975         else do:
     3976           assign
     3977             v-parts-qnty          = abs(buf_parts.qnty)
     3978             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     3979             v-parts-free-qnty     = 0
     3980             v-parts-free-cli-qnty = 0
     3981           .
     3982         end.
     3983         assign
     3984           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     3985           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     3986           buf_temp-parts.real-qnty     = 0
     3987           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     3988           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     3989           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     3990         .
     3991       end.
     3992     end.
     3993   end procedure.
     3994   procedure partslib-init-temp-parts-by-factord :
     3995     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     3996     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
