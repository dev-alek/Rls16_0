     6421       bfsacc_tt-allsum.vat-rubl-cur        = 0
     6422       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     6423       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     6424       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     6425       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     6426       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     6427       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     6428       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     6429       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     6430       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     6431       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     6432       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     6433       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     6434       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     6435       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     6436       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     6437       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     6438       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     6439       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     6440       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     6441       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     6442       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     6443       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     6444       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     6445       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     6446       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     6447       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     6448       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     6449       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     6450       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     6451       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     6452       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     6453       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     6454       .
     6455   end.
     6456   otherwise do:
     6457     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     6458                              cl_tt-clcparts.purch-code,
     6459                              cl_tt-clcparts.part-code,
     6460                              cl_tt-clcparts.out-code,
     6461                              cl_tt-clcparts.in-code,
     6462                              cl_tt-clcparts.artic,
     6463                              cl_tt-clcparts.prod-type,
     6464                              cl_tt-clcparts.prod-code).
     6465   end.
     6466   end case.
     6467   end.
     6468   end procedure.
     6469   procedure clcprtsl_calc-line :
     6470   define input  parameter parrec-line as recid no-undo.
     6471   define variable v-tax-date         as   date                     no-undo.
     6472   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     6473   define variable varr-b             as   character                no-undo.
     6474   define variable varr-btype         as   character                no-undo.
     6475   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     6476   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     6477   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     6478   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     6479   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     6480   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     6481   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     6482   define variable varb-code          like ub.bar-code.b-code       no-undo.
     6483   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     6484   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     6485   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     6486   define variable varexcise          like ub.price-list.excise     no-undo.
     6487   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     6488   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     6489   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     6490   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     6491   define variable v-varsum           as decimal                  no-undo.
     6492   define variable varprice-salef as decimal   no-undo .
     6493   define buffer bf_trn-doc             for ub.trn-doc.
     6494   define buffer bf_doc-line            for ub.doc-line.
     6495   define buffer bf_gds-dtl             for ub.gds-dtl.
     6496   define buffer bf_goods               for ub.goods.
     6497   define buffer bf_parts               for ub.parts.
     6498   define buffer bf_sysconf             for ub.sysconf.
     6499   define buffer bf_tt-allsum-line      for tt-allsum-line.
     6500   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     6501   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     6502   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     6503   define buffer buf_parts        for ub.parts.
     6504   v-calcbypart = no.
     6505   do on error undo, return error return-value :
     6506   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6508     (output varr-b
     6509     )  .
     6510     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     6511     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     6512     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     6513                               bf_goods.prod-type = bf_doc-line.prod-type and
     6514                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     6515     if bf_trn-doc.fact-date <> ?        then do:
     6516       assign v-tax-date = bf_trn-doc.fact-date.
     6517     end.
     6518     else do:
     6519       assign v-tax-date = ?.
     6520     end.
     6521   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6522   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6523     (input  bf_goods.gds-code
     6524     ,input  '1':U
     6525     ,input  v-tax-date
     6526     ,input  bf_trn-doc.host-code
     6527     ,input  bf_trn-doc.obj-type
     6528     ,input  bf_trn-doc.obj-code
     6529     ,output v-vat-pc
     6530     ) no-error .
     6531     if error-status :error
     6532     or v-vat-pc = ? then do:
     6533        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     6534     end.
     6535     if bf_goods.gds-type = 'у':U or
     6536        bf_trn-doc.status_ = 'запрос':U then do:
     6537       for each bf_tt-allsum-line
     6538       on error undo, return error return-value
     6539        :
     6540         delete bf_tt-allsum-line.
     6541       end.
     6542       create bf_tt-allsum-line.
     6543       assign
     6544        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     6545       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     6546                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     6547                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     6548                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     6549         assign
     6550           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     6551           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     6552           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     6553           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     6554           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     6555           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     6556           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     6557           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     6558           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     6559           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     6560           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     6561           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     6562           bf_tt-allsum-line.vat-cli-acc          =  ?
     6563           .
     6564       end.
     6565       assign
     6566         bf_tt-allsum-line.cli-qnty             =  ?
     6567         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6568         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6569         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     6570         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     6571         bf_tt-allsum-line.road-tax-base-doc    =  0
     6572         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     6573         bf_tt-allsum-line.excise-base-doc      =  0
     6574         bf_tt-allsum-line.excise-rubl-doc      =  0
     6575         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     6576         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     6577         bf_tt-allsum-line.dsc-base-cur         =  0
     6578         bf_tt-allsum-line.dsc-rubl-cur         =  0
     6579         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6580         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     6581         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     6582         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     6583         bf_tt-allsum-line.road-tax-base-cur    =  0
     6584         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     6585         bf_tt-allsum-line.excise-base-cur      =  0
     6586         bf_tt-allsum-line.excise-rubl-cur      =  0
     6587         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     6588         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     6589         bf_tt-allsum-line.dsc-base-acc         =  0
     6590         bf_tt-allsum-line.dsc-rubl-acc         =  0
     6591         bf_tt-allsum-line.dsc-cli-acc          =  0
     6592         bf_tt-allsum-line.slt-base-acc         =  0
     6593         bf_tt-allsum-line.slt-rubl-acc         =  0
     6594         bf_tt-allsum-line.slt-cli-acc          =  0
     6595         bf_tt-allsum-line.road-tax-base-acc    =  0
     6596         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     6597         bf_tt-allsum-line.road-tax-cli-acc     =  0
     6598         bf_tt-allsum-line.excise-base-acc      =  0
     6599         bf_tt-allsum-line.excise-rubl-acc      =  0
     6600         bf_tt-allsum-line.excise-cli-acc       =  0
     6601         bf_tt-allsum-line.transport-base-acc   =  0
     6602         bf_tt-allsum-line.transport-rubl-acc   =  0
     6603         bf_tt-allsum-line.transport-cli-acc    =  0
     6604         bf_tt-allsum-line.other-base-acc       =  0
     6605         bf_tt-allsum-line.other-rubl-acc       =  0
     6606         bf_tt-allsum-line.other-cli-acc        =  0
     6607         .
     6608       create bfs_tt-allsum-line.
     6609       assign
     6610       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     6611       if bf_trn-doc.doc-type = 'инв':U or
     6612          bf_trn-doc.doc-type = 'при':U    or
     6613          bf_trn-doc.doc-type = 'возврат':U    then do:
     6614          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     6615       end.
     6616       else do:
     6617         assign
     6618           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     6619           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     6620           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     6621           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     6622           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     6623           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     6624           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     6625           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     6626           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     6627           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     6628           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     6629           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     6630           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     6631           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     6632           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     6633           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     6634           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     6635           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     6636           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     6637           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     6638           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     6639           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     6640           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     6641           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     6642           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     6643           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     6644           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     6645           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     6646           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     6647           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     6648           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     6649           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     6650           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     6651           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     6652           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     6653           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     6654           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     6655           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     6656           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     6657           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     6658           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
