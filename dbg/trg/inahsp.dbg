     6099     bf_tt-allsum.sum-dsc-rubl-acc     = (if price-rubl-with-tax-loccl    = ? then 0 else price-rubl-with-tax-loccl    * cl_tt-clcparts.fact-qnty)
     6100     bf_tt-allsum.sum-dsc-cli-acc      = (if (price-cli-with-tax-loccl +
