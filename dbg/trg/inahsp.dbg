     2475     .
     2476   end.
     2477       for each buf_temp-prt-obj
     2478       ,first buf_prt-obj exclusive-lock
     2479         where recid(buf_prt-obj) = buf_temp-prt-obj.prt-obj-recid
     2480       on error undo, return error return-value
     2481       :
     2482         assign
