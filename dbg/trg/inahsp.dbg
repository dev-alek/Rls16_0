     6773               .
     6774             end.
     6775             assign
     6776               varlastcur-base     = varprice-sale
     6777               varlastcur-road-tax = varroad-tax
     6778               varlastcur-excise   = varexcise
     6779               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     6780               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     6781               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     6782               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     6783             .
     6784         end.
     6785       end.
     6786       if varcur-fact-qnty = 0 then do:
     6787         assign
     6788           varcur-base      = varlastcur-base
     6789           varcur-road-tax  = varlastcur-road-tax
     6790           varcur-excise    = varlastcur-excise
     6791         .
     6792       end.
     6793       else do:
     6794         assign
     6795           varcur-base      = varcur-base      / varcur-fact-qnty
     6796           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     6797           varcur-excise    = varcur-excise    / varcur-fact-qnty
     6798         .
     6799       end.
     6800       if varcur-vat-pc = ?
