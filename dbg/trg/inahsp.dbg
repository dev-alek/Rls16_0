     7773   procedure update-tot :
     7774     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     7775     define buffer buf_temp-stk-supp-tot  for temp-stk-supp-tot .
     7776     do
     7777     on error undo, return error return-value
     7778     :
     7779       for each buf_temp-stk-supp-line
     7780       on error undo, return error return-value
     7781       :
     7782         find first buf_temp-stk-supp-tot
     7783           where buf_temp-stk-supp-tot.obj-type   = p-obj-type
     7784             and buf_temp-stk-supp-tot.obj-code   = p-obj-code
     7785             and buf_temp-stk-supp-tot.cli-type   = buf_temp-stk-supp-line.cli-type
     7786             and buf_temp-stk-supp-tot.cli-code   = buf_temp-stk-supp-line.cli-code
     7787             and buf_temp-stk-supp-tot.fact-order = v-day-end-fact-order
     7788             and buf_temp-stk-supp-tot.sum-type   = buf_temp-stk-supp-line.sum-type
     7789             and buf_temp-stk-supp-tot.cat-id     = buf_temp-stk-supp-line.cat-id
     7790           no-error .
     7791         if not available buf_temp-stk-supp-tot
     7792         then do:
     7793           create buf_temp-stk-supp-tot .
     7794           assign
     7795             buf_temp-stk-supp-tot.obj-type   = p-obj-type
     7796             buf_temp-stk-supp-tot.obj-code   = p-obj-code
     7797             buf_temp-stk-supp-tot.cli-type   = buf_temp-stk-supp-line.cli-type
     7798             buf_temp-stk-supp-tot.cli-code   = buf_temp-stk-supp-line.cli-code
     7799             buf_temp-stk-supp-tot.sum-type   = buf_temp-stk-supp-line.sum-type
     7800             buf_temp-stk-supp-tot.cat-id     = buf_temp-stk-supp-line.cat-id
     7801             buf_temp-stk-supp-tot.fact-order = v-day-end-fact-order
     7802             buf_temp-stk-supp-tot.fact-date  = p-new-start-date
     7803             buf_temp-stk-supp-tot.shift-date = ?
     7804             buf_temp-stk-supp-tot.shift-num  = 0
     7805           .
     7806         end.
     7807         assign
     7808                                                                           buf_temp-stk-supp-tot.new-fact-qnty      = buf_temp-stk-supp-tot.new-fact-qnty      + buf_temp-stk-supp-line.new-fact-qnty           buf_temp-stk-supp-tot.new-sum-base       = buf_temp-stk-supp-tot.new-sum-base       + buf_temp-stk-supp-line.new-sum-base            buf_temp-stk-supp-tot.new-sum-rubl       = buf_temp-stk-supp-tot.new-sum-rubl       + buf_temp-stk-supp-line.new-sum-rubl            buf_temp-stk-supp-tot.new-vat-base       = buf_temp-stk-supp-tot.new-vat-base       + buf_temp-stk-supp-line.new-vat-base            buf_temp-stk-supp-tot.new-vat-rubl       = buf_temp-stk-supp-tot.new-vat-rubl       + buf_temp-stk-supp-line.new-vat-rubl            buf_temp-stk-supp-tot.new-slt-base       = buf_temp-stk-supp-tot.new-slt-base       + buf_temp-stk-supp-line.new-slt-base            buf_temp-stk-supp-tot.new-slt-rubl       = buf_temp-stk-supp-tot.new-slt-rubl       + buf_temp-stk-supp-line.new-slt-rubl            buf_temp-stk-supp-tot.new-road-tax-base  = buf_temp-stk-supp-tot.new-road-tax-base  + buf_temp-stk-supp-line.new-road-tax-base       buf_temp-stk-supp-tot.new-road-tax-rubl  = buf_temp-stk-supp-tot.new-road-tax-rubl  + buf_temp-stk-supp-line.new-road-tax-rubl       buf_temp-stk-supp-tot.new-excise-base    = buf_temp-stk-supp-tot.new-excise-base    + buf_temp-stk-supp-line.new-excise-base         buf_temp-stk-supp-tot.new-excise-rubl    = buf_temp-stk-supp-tot.new-excise-rubl    + buf_temp-stk-supp-line.new-excise-rubl         buf_temp-stk-supp-tot.new-transport-base = buf_temp-stk-supp-tot.new-transport-base + buf_temp-stk-supp-line.new-transport-base      buf_temp-stk-supp-tot.new-transport-rubl = buf_temp-stk-supp-tot.new-transport-rubl + buf_temp-stk-supp-line.new-transport-rubl      buf_temp-stk-supp-tot.new-other-base     = buf_temp-stk-supp-tot.new-other-base     + buf_temp-stk-supp-line.new-other-base          buf_temp-stk-supp-tot.new-other-rubl     = buf_temp-stk-supp-tot.new-other-rubl     + buf_temp-stk-supp-line.new-other-rubl
     7809         .
     7810         if v-shift-on = true
     7811         then do:
     7812           find first buf_temp-stk-supp-tot
     7813             where buf_temp-stk-supp-tot.obj-type   = p-obj-type
     7814               and buf_temp-stk-supp-tot.obj-code   = p-obj-code
     7815               and buf_temp-stk-supp-tot.cli-type   = buf_temp-stk-supp-line.cli-type
     7816               and buf_temp-stk-supp-tot.cli-code   = buf_temp-stk-supp-line.cli-code
     7817               and buf_temp-stk-supp-tot.fact-order = v-shift-end-fact-order
     7818               and buf_temp-stk-supp-tot.sum-type   = buf_temp-stk-supp-line.sum-type
     7819               and buf_temp-stk-supp-tot.cat-id     = buf_temp-stk-supp-line.cat-id
     7820             no-error .
     7821           if not available buf_temp-stk-supp-tot
     7822           then do:
     7823             create buf_temp-stk-supp-tot .
     7824             assign
     7825               buf_temp-stk-supp-tot.obj-type   = p-obj-type
     7826               buf_temp-stk-supp-tot.obj-code   = p-obj-code
