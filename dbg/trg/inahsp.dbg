     7378   procedure cb_inahsp_store-temp-supp-gds :
     7379     define input  parameter p-cli-type  as character no-undo .
     7380     define input  parameter p-cli-code  as integer   no-undo .
     7381     define input  parameter p-artic     as character no-undo .
     7382     define input  parameter p-prod-type as character no-undo .
     7383     define input  parameter p-prod-code as integer   no-undo .
     7384     define buffer buf_temp-supp for temp-supp .
     7385     define buffer buf_temp-supp-gds for temp-supp-gds .
     7386     do
     7387     on error undo, return error return-value
     7388     :
     7389       find first buf_temp-supp
     7390         where buf_temp-supp.cli-type = p-cli-type
     7391           and buf_temp-supp.cli-code = p-cli-code
     7392         no-error .
     7393       if not available buf_temp-supp
     7394       then do:
     7395         create buf_temp-supp .
     7396         assign
     7397           buf_temp-supp.cli-type = p-cli-type
     7398           buf_temp-supp.cli-code = p-cli-code
     7399         .
     7400       end.
     7401       find first buf_temp-supp-gds
     7402         where buf_temp-supp-gds.cli-type  = p-cli-type
     7403           and buf_temp-supp-gds.cli-code  = p-cli-code
     7404           and buf_temp-supp-gds.artic     = p-artic
     7405           and buf_temp-supp-gds.prod-type = p-prod-type
     7406           and buf_temp-supp-gds.prod-code = p-prod-code
     7407         no-error .
     7408       if not available buf_temp-supp-gds
     7409       then do:
     7410         create buf_temp-supp-gds .
     7411         assign
     7412           buf_temp-supp-gds.cli-type  = p-cli-type
     7413           buf_temp-supp-gds.cli-code  = p-cli-code
     7414           buf_temp-supp-gds.artic     = p-artic
     7415           buf_temp-supp-gds.prod-type = p-prod-type
     7416           buf_temp-supp-gds.prod-code = p-prod-code
     7417         .
     7418       end.
     7419     end.
     7420   end procedure.
     7421   procedure process-gds-obj :
     7422     define input  parameter p-obj-type             like ub.gds-obj.obj-type  no-undo .
     7423     define input  parameter p-obj-code             like ub.gds-obj.obj-code  no-undo .
     7424     define input  parameter p-artic                like ub.gds-obj.artic     no-undo .
     7425     define input  parameter p-prod-type            like ub.gds-obj.prod-type no-undo .
     7426     define input  parameter p-prod-code            like ub.gds-obj.prod-code no-undo .
     7427     define input  parameter p-cons-pay             as integer   no-undo .
     7428     define input  parameter p-base-rate            like ub.curr-accnt.exch-rate no-undo .
     7429     define input  parameter p-base-scale           like ub.curr-accnt.exch-scale no-undo .
     7430     define input  parameter p-base-rate-reason     as character no-undo .
     7431     define input  parameter p-archive-date         as date      no-undo .
     7432     define input  parameter p-shift-on             as logical   no-undo .
     7433     define input  parameter p-shift-date           as date      no-undo .
     7434     define input  parameter p-shift-num            as integer   no-undo .
     7435     define input  parameter p-day-end-fact-order   as decimal   no-undo .
     7436     define input  parameter p-shift-end-fact-order as decimal   no-undo .
     7437     define buffer buf_goods              for ub.goods .
     7438     define buffer buf_temp-parts         for temp-parts .
     7439     define buffer buf_tt-clcparts        for tt-clcparts .
     7440     define buffer buf_tt-allsum-line     for tt-allsum-line .
     7441     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     7442     define buffer buf_temp-stk-supp-tot  for temp-stk-supp-tot .
     7443     do
     7444     on error undo, return error return-value
     7445     :
     7446       run partslib-init-temp-parts-by-factord in this-procedure
     7447         (input p-obj-type
     7448         ,input p-obj-code
     7449         ,input p-artic
     7450         ,input p-prod-type
     7451         ,input p-prod-code
     7452         ,input p-day-end-fact-order
     7453         ,input false
     7454         ) .
     7455       for each buf_temp-parts
     7456       on error undo, return error return-value
     7457       :
     7458         for each buf_tt-clcparts
     7459         on error undo, return error return-value
     7460         :
     7461           delete buf_tt-clcparts .
     7462         end.
     7463         create buf_tt-clcparts .
     7464         buffer-copy buf_temp-parts to buf_tt-clcparts .
     7465         run clcprtsl_calc-ttable in this-procedure
     7466           (input false
     7467           ,input false
     7468           ,input ?
     7469           ,input ?
     7470           ,input ?
     7471           ,input ?
     7472           ,input ?
     7473           ,input ?
     7474           ,input ?
     7475           ,input ?
     7476           ,input ?
     7477           ,input ?
     7478           ,input ?
     7479           ,input ?
     7480           ,input ?
     7481           ,input ?
     7482           ) no-error .
     7483         if error-status :error
     7484         then do:
     7485           message
     7486             vss-workfile vss-revision vss-description skip
     7487             "Ошибка при вызове процедуры clcprtsl_calc-ttable" skip
     7488             error-status :get-message(1) skip
     7489             return-value skip
     7490             view-as alert-box error .
     7491           undo, return error return-value .
     7492         end.
     7493         find first buf_tt-allsum-line
     7494           where buf_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U
     7495           no-error .
     7496         if available buf_tt-allsum-line
     7497         then do:
     7498           assign
     7499             v-fact-qnty      = - buf_tt-allsum-line.fact-qnty
     7500             v-sum-base       = - buf_tt-allsum-line.sum-dsc-base-acc
     7501             v-sum-rubl       = - buf_tt-allsum-line.sum-dsc-rubl-acc
     7502             v-vat-base       = - buf_tt-allsum-line.vat-base-acc
     7503             v-vat-rubl       = - buf_tt-allsum-line.vat-rubl-acc
     7504             v-slt-base       = - buf_tt-allsum-line.slt-base-acc
     7505             v-slt-rubl       = - buf_tt-allsum-line.slt-rubl-acc
     7506             v-road-tax-base  = - buf_tt-allsum-line.road-tax-base-acc
     7507             v-road-tax-rubl  = - buf_tt-allsum-line.road-tax-rubl-acc
     7508             v-excise-base    = - buf_tt-allsum-line.excise-base-acc
     7509             v-excise-rubl    = - buf_tt-allsum-line.excise-rubl-acc
     7510             v-transport-base = - buf_tt-allsum-line.transport-base-acc
     7511             v-transport-rubl = - buf_tt-allsum-line.transport-rubl-acc
     7512             v-other-base     = - buf_tt-allsum-line.other-base-acc
     7513             v-other-rubl     = - buf_tt-allsum-line.other-rubl-acc
     7514           .
     7515         end.
     7516         else do:
     7517           assign
     7518             v-fact-qnty      = 0
     7519             v-sum-base       = 0
     7520             v-sum-rubl       = 0
     7521             v-vat-base       = 0
     7522             v-vat-rubl       = 0
     7523             v-slt-base       = 0
     7524             v-slt-rubl       = 0
     7525             v-road-tax-base  = 0
     7526             v-road-tax-rubl  = 0
     7527             v-excise-base    = 0
     7528             v-excise-rubl    = 0
     7529             v-transport-base = 0
     7530             v-transport-rubl = 0
     7531             v-other-base     = 0
     7532             v-other-rubl     = 0
     7533           .
     7534         end.
     7535         if
     7536                                 v-fact-qnty      = ? or    v-sum-base       = ? or    v-sum-rubl       = ? or    v-vat-base       = ? or    v-vat-rubl       = ? or    v-slt-base       = ? or    v-slt-rubl       = ? or    v-road-tax-base  = ? or    v-road-tax-rubl  = ? or    v-excise-base    = ? or    v-excise-rubl    = ? or    v-transport-base = ? or    v-transport-rubl = ? or    v-other-base     = ? or    v-other-rubl     = ?
     7537         then do:
     7538           message
     7539             vss-workfile vss-revision vss-description skip
     7540             "Программа clcprtsl_calc-ttable вернула неопределенные значения" skip
     7541             "Расчет складского архива невозможен" skip
     7542             "Объект" p-obj-type p-obj-code skip
     7543             "Артикул" p-artic p-prod-type p-prod-code skip
     7544             "Тип суммы" 'основная_сумма_со_знаком':U skip
     7545                                                                         "v-fact-qnty"      v-fact-qnty        skip    "v-sum-base"       v-sum-base         skip    "v-sum-rubl"       v-sum-rubl         skip    "v-vat-base"       v-vat-base         skip    "v-vat-rubl"       v-vat-rubl         skip    "v-slt-base"       v-slt-base         skip    "v-slt-rubl"       v-slt-rubl         skip    "v-road-tax-base"  v-road-tax-base    skip    "v-road-tax-rubl"  v-road-tax-rubl    skip    "v-excise-base"    v-excise-base      skip    "v-excise-rubl"    v-excise-rubl      skip    "v-transport-base" v-transport-base   skip    "v-transport-rubl" v-transport-rubl   skip    "v-other-base"     v-other-base       skip    "v-other-rubl"     v-other-rubl
     7546             view-as alert-box error .
     7547           undo, return error return-value .
     7548         end.
     7549         define variable v-ahsp-type-ind        as integer   no-undo .
     7550         define variable v-ahsp-type-list       as character extent 5 no-undo
     7551           initial ['prch':U, 'cacc':U, 'benf':U, 'stor':U, 'cons':U] .
     7552         define variable v-allsum-sum-type-list as character extent 5 no-undo
     7553           initial ['сумма_по_выкупу_со_знаком':U, 'сумма_по_консигнации_закупка_со_знаком':U, 'сумма_по_консигнации_выгода_со_знаком':U, 'сумма_по_ответственному_хранению_со_знаком':U, 'сумма_по_старой_консигнации_со_знаком':U] .
     7554         define variable v-ahsp-type            as character no-undo .
     7555         define variable v-allsum-sum-type      as character no-undo .
     7556         do v-ahsp-type-ind = 1 to extent(v-ahsp-type-list)
     7557         :
     7558           assign
     7559             v-ahsp-type       = v-ahsp-type-list[v-ahsp-type-ind]
     7560             v-allsum-sum-type = v-allsum-sum-type-list[v-ahsp-type-ind]
     7561           .
     7562           find first buf_tt-allsum-line
     7563             where buf_tt-allsum-line.sum-type = v-allsum-sum-type
     7564             no-error .
     7565           if available buf_tt-allsum-line
     7566           then do:
     7567             assign
     7568               v-fact-qnty      = - buf_tt-allsum-line.fact-qnty
     7569               v-sum-base       = - buf_tt-allsum-line.sum-dsc-base-acc
     7570               v-sum-rubl       = - buf_tt-allsum-line.sum-dsc-rubl-acc
     7571               v-vat-base       = - buf_tt-allsum-line.vat-base-acc
     7572               v-vat-rubl       = - buf_tt-allsum-line.vat-rubl-acc
     7573               v-slt-base       = - buf_tt-allsum-line.slt-base-acc
     7574               v-slt-rubl       = - buf_tt-allsum-line.slt-rubl-acc
     7575               v-road-tax-base  = - buf_tt-allsum-line.road-tax-base-acc
     7576               v-road-tax-rubl  = - buf_tt-allsum-line.road-tax-rubl-acc
     7577               v-excise-base    = - buf_tt-allsum-line.excise-base-acc
     7578               v-excise-rubl    = - buf_tt-allsum-line.excise-rubl-acc
     7579               v-transport-base = - buf_tt-allsum-line.transport-base-acc
     7580               v-transport-rubl = - buf_tt-allsum-line.transport-rubl-acc
     7581               v-other-base     = - buf_tt-allsum-line.other-base-acc
     7582               v-other-rubl     = - buf_tt-allsum-line.other-rubl-acc
     7583             .
     7584           end.
     7585           else do:
     7586             assign
     7587               v-fact-qnty      = 0
     7588               v-sum-base       = 0
     7589               v-sum-rubl       = 0
     7590               v-vat-base       = 0
     7591               v-vat-rubl       = 0
     7592               v-slt-base       = 0
     7593               v-slt-rubl       = 0
     7594               v-road-tax-base  = 0
     7595               v-road-tax-rubl  = 0
     7596               v-excise-base    = 0
     7597               v-excise-rubl    = 0
     7598               v-transport-base = 0
     7599               v-transport-rubl = 0
     7600               v-other-base     = 0
     7601               v-other-rubl     = 0
     7602             .
     7603           end.
     7604           if v-ahsp-type = 'benf':U
     7605           then do:
     7606             assign
     7607               v-fact-qnty = 0
     7608             .
     7609           end.
     7610           if
     7611                                           v-fact-qnty      = ? or    v-sum-base       = ? or    v-sum-rubl       = ? or    v-vat-base       = ? or    v-vat-rubl       = ? or    v-slt-base       = ? or    v-slt-rubl       = ? or    v-road-tax-base  = ? or    v-road-tax-rubl  = ? or    v-excise-base    = ? or    v-excise-rubl    = ? or    v-transport-base = ? or    v-transport-rubl = ? or    v-other-base     = ? or    v-other-rubl     = ?
     7612           then do:
     7613             message
     7614               vss-workfile vss-revision vss-description skip
     7615               "Программа clcprtsl_calc-ttable вернула неопределенные значения" skip
     7616               "Расчет складского архива невозможен" skip
     7617               "Объект" p-obj-type p-obj-code skip
     7618               "Артикул" p-artic p-prod-type p-prod-code skip
     7619               "Тип суммы" v-allsum-sum-type skip
     7620                                                                                       "v-fact-qnty"      v-fact-qnty        skip    "v-sum-base"       v-sum-base         skip    "v-sum-rubl"       v-sum-rubl         skip    "v-vat-base"       v-vat-base         skip    "v-vat-rubl"       v-vat-rubl         skip    "v-slt-base"       v-slt-base         skip    "v-slt-rubl"       v-slt-rubl         skip    "v-road-tax-base"  v-road-tax-base    skip    "v-road-tax-rubl"  v-road-tax-rubl    skip    "v-excise-base"    v-excise-base      skip    "v-excise-rubl"    v-excise-rubl      skip    "v-transport-base" v-transport-base   skip    "v-transport-rubl" v-transport-rubl   skip    "v-other-base"     v-other-base       skip    "v-other-rubl"     v-other-rubl
     7621               view-as alert-box error .
     7622             undo, return error return-value .
     7623           end.
     7624           define variable ind-ext    as integer no-undo .
     7625           define variable v-cat-id   as character no-undo extent 4 .
     7626           define variable v-sum-type as character no-undo extent 4 .
     7627           assign
     7628             v-sum-type[1] = 'cost':U
     7629             v-cat-id[1]   = '##':U
     7630             v-sum-type[2] = 'cost':U + 'p':U
     7631             v-cat-id[2]   = v-ahsp-type
     7632           .
     7633           do ind-ext = 1 to 2
     7634           :
     7635             find first buf_temp-stk-supp-line
     7636               where buf_temp-stk-supp-line.obj-type   = p-obj-type
     7637                 and buf_temp-stk-supp-line.obj-code   = p-obj-code
     7638                 and buf_temp-stk-supp-line.cli-type   = buf_temp-parts.supp-type
     7639                 and buf_temp-stk-supp-line.cli-code   = buf_temp-parts.supp-code
     7640                 and buf_temp-stk-supp-line.artic      = p-artic
     7641                 and buf_temp-stk-supp-line.prod-type  = p-prod-type
     7642                 and buf_temp-stk-supp-line.prod-code  = p-prod-code
     7643                 and buf_temp-stk-supp-line.fact-order = p-day-end-fact-order
     7644                 and buf_temp-stk-supp-line.sum-type   = v-sum-type[ind-ext]
     7645                 and buf_temp-stk-supp-line.cat-id     = v-cat-id[ind-ext]
     7646               no-error .
     7647             if not available buf_temp-stk-supp-line
     7648             then do:
     7649               create buf_temp-stk-supp-line .
     7650               assign
     7651                 buf_temp-stk-supp-line.obj-type   = p-obj-type
     7652                 buf_temp-stk-supp-line.obj-code   = p-obj-code
     7653                 buf_temp-stk-supp-line.cli-type   = buf_temp-parts.supp-type
     7654                 buf_temp-stk-supp-line.cli-code   = buf_temp-parts.supp-code
     7655                 buf_temp-stk-supp-line.artic      = p-artic
     7656                 buf_temp-stk-supp-line.prod-type  = p-prod-type
     7657                 buf_temp-stk-supp-line.prod-code  = p-prod-code
     7658                 buf_temp-stk-supp-line.fact-order = p-day-end-fact-order
     7659                 buf_temp-stk-supp-line.sum-type   = v-sum-type[ind-ext]
     7660                 buf_temp-stk-supp-line.cat-id     = v-cat-id[ind-ext]
     7661               .
     7662               assign
     7663                 buf_temp-stk-supp-line.fact-date    = p-archive-date
     7664                 buf_temp-stk-supp-line.shift-date   = ?
     7665                 buf_temp-stk-supp-line.shift-num    = 0
     7666               .
     7667             end.
     7668             assign
     7669                                                                                                               buf_temp-stk-supp-line.new-fact-qnty      = buf_temp-stk-supp-line.new-fact-qnty      + v-fact-qnty           buf_temp-stk-supp-line.new-sum-base       = buf_temp-stk-supp-line.new-sum-base       + v-sum-base            buf_temp-stk-supp-line.new-sum-rubl       = buf_temp-stk-supp-line.new-sum-rubl       + v-sum-rubl            buf_temp-stk-supp-line.new-vat-base       = buf_temp-stk-supp-line.new-vat-base       + v-vat-base            buf_temp-stk-supp-line.new-vat-rubl       = buf_temp-stk-supp-line.new-vat-rubl       + v-vat-rubl            buf_temp-stk-supp-line.new-slt-base       = buf_temp-stk-supp-line.new-slt-base       + v-slt-base            buf_temp-stk-supp-line.new-slt-rubl       = buf_temp-stk-supp-line.new-slt-rubl       + v-slt-rubl            buf_temp-stk-supp-line.new-road-tax-base  = buf_temp-stk-supp-line.new-road-tax-base  + v-road-tax-base       buf_temp-stk-supp-line.new-road-tax-rubl  = buf_temp-stk-supp-line.new-road-tax-rubl  + v-road-tax-rubl       buf_temp-stk-supp-line.new-excise-base    = buf_temp-stk-supp-line.new-excise-base    + v-excise-base         buf_temp-stk-supp-line.new-excise-rubl    = buf_temp-stk-supp-line.new-excise-rubl    + v-excise-rubl         buf_temp-stk-supp-line.new-transport-base = buf_temp-stk-supp-line.new-transport-base + v-transport-base      buf_temp-stk-supp-line.new-transport-rubl = buf_temp-stk-supp-line.new-transport-rubl + v-transport-rubl      buf_temp-stk-supp-line.new-other-base     = buf_temp-stk-supp-line.new-other-base     + v-other-base          buf_temp-stk-supp-line.new-other-rubl     = buf_temp-stk-supp-line.new-other-rubl     + v-other-rubl
     7670             .
     7671             if v-shift-on = true
     7672             then do:
     7673               find first buf_temp-stk-supp-line
     7674                 where buf_temp-stk-supp-line.obj-type   = p-obj-type
     7675                   and buf_temp-stk-supp-line.obj-code   = p-obj-code
     7676                   and buf_temp-stk-supp-line.cli-type   = buf_temp-parts.supp-type
     7677                   and buf_temp-stk-supp-line.cli-code   = buf_temp-parts.supp-code
     7678                   and buf_temp-stk-supp-line.artic      = p-artic
     7679                   and buf_temp-stk-supp-line.prod-type  = p-prod-type
     7680                   and buf_temp-stk-supp-line.prod-code  = p-prod-code
     7681                   and buf_temp-stk-supp-line.fact-order = p-shift-end-fact-order
     7682                   and buf_temp-stk-supp-line.sum-type   = v-sum-type[ind-ext]
     7683                   and buf_temp-stk-supp-line.cat-id     = v-cat-id[ind-ext]
     7684                 no-error .
     7685               if not available buf_temp-stk-supp-line
     7686               then do:
     7687                 create buf_temp-stk-supp-line .
     7688                 assign
     7689                   buf_temp-stk-supp-line.obj-type   = p-obj-type
     7690                   buf_temp-stk-supp-line.obj-code   = p-obj-code
     7691                   buf_temp-stk-supp-line.cli-type   = buf_temp-parts.supp-type
     7692                   buf_temp-stk-supp-line.cli-code   = buf_temp-parts.supp-code
     7693                   buf_temp-stk-supp-line.artic      = p-artic
     7694                   buf_temp-stk-supp-line.prod-type  = p-prod-type
     7695                   buf_temp-stk-supp-line.prod-code  = p-prod-code
     7696                   buf_temp-stk-supp-line.fact-order = p-shift-end-fact-order
     7697                   buf_temp-stk-supp-line.sum-type   = v-sum-type[ind-ext]
     7698                   buf_temp-stk-supp-line.cat-id     = v-cat-id[ind-ext]
     7699                 .
     7700                 assign
     7701                   buf_temp-stk-supp-line.fact-date    = p-archive-date
     7702                   buf_temp-stk-supp-line.shift-date   = p-shift-date
     7703                   buf_temp-stk-supp-line.shift-num    = p-shift-num
     7704                 .
     7705               end.
     7706               assign
     7707                                                                                                                                 buf_temp-stk-supp-line.new-fact-qnty      = buf_temp-stk-supp-line.new-fact-qnty      + v-fact-qnty           buf_temp-stk-supp-line.new-sum-base       = buf_temp-stk-supp-line.new-sum-base       + v-sum-base            buf_temp-stk-supp-line.new-sum-rubl       = buf_temp-stk-supp-line.new-sum-rubl       + v-sum-rubl            buf_temp-stk-supp-line.new-vat-base       = buf_temp-stk-supp-line.new-vat-base       + v-vat-base            buf_temp-stk-supp-line.new-vat-rubl       = buf_temp-stk-supp-line.new-vat-rubl       + v-vat-rubl            buf_temp-stk-supp-line.new-slt-base       = buf_temp-stk-supp-line.new-slt-base       + v-slt-base            buf_temp-stk-supp-line.new-slt-rubl       = buf_temp-stk-supp-line.new-slt-rubl       + v-slt-rubl            buf_temp-stk-supp-line.new-road-tax-base  = buf_temp-stk-supp-line.new-road-tax-base  + v-road-tax-base       buf_temp-stk-supp-line.new-road-tax-rubl  = buf_temp-stk-supp-line.new-road-tax-rubl  + v-road-tax-rubl       buf_temp-stk-supp-line.new-excise-base    = buf_temp-stk-supp-line.new-excise-base    + v-excise-base         buf_temp-stk-supp-line.new-excise-rubl    = buf_temp-stk-supp-line.new-excise-rubl    + v-excise-rubl         buf_temp-stk-supp-line.new-transport-base = buf_temp-stk-supp-line.new-transport-base + v-transport-base      buf_temp-stk-supp-line.new-transport-rubl = buf_temp-stk-supp-line.new-transport-rubl + v-transport-rubl      buf_temp-stk-supp-line.new-other-base     = buf_temp-stk-supp-line.new-other-base     + v-other-base          buf_temp-stk-supp-line.new-other-rubl     = buf_temp-stk-supp-line.new-other-rubl     + v-other-rubl
     7708               .
     7709             end.
     7710           end.
     7711         end.
     7712       end.
     7713     end.
     7714   end procedure.
     7715   procedure store-line :
     7716     define buffer buf_temp-stk-supp-line for temp-stk-supp-line .
     7717     define buffer buf_stk-supp-line      for ub.stk-supp-line .
     7718     do
     7719     on error undo, return error return-value
     7720     :
     7721       for each buf_temp-stk-supp-line
     7722       on error undo, return error return-value
     7723       :
     7724         create buf_stk-supp-line .
     7725         buffer-copy buf_temp-stk-supp-line to buf_stk-supp-line
     7726         assign
     7727                                                           buf_stk-supp-line.fact-qnty      = buf_temp-stk-supp-line.new-fact-qnty            buf_stk-supp-line.sum-base       = buf_temp-stk-supp-line.new-sum-base             buf_stk-supp-line.sum-rubl       = buf_temp-stk-supp-line.new-sum-rubl             buf_stk-supp-line.vat-base       = buf_temp-stk-supp-line.new-vat-base             buf_stk-supp-line.vat-rubl       = buf_temp-stk-supp-line.new-vat-rubl             buf_stk-supp-line.slt-base       = buf_temp-stk-supp-line.new-slt-base             buf_stk-supp-line.slt-rubl       = buf_temp-stk-supp-line.new-slt-rubl             buf_stk-supp-line.road-tax-base  = buf_temp-stk-supp-line.new-road-tax-base        buf_stk-supp-line.road-tax-rubl  = buf_temp-stk-supp-line.new-road-tax-rubl        buf_stk-supp-line.excise-base    = buf_temp-stk-supp-line.new-excise-base          buf_stk-supp-line.excise-rubl    = buf_temp-stk-supp-line.new-excise-rubl          buf_stk-supp-line.transport-base = buf_temp-stk-supp-line.new-transport-base       buf_stk-supp-line.transport-rubl = buf_temp-stk-supp-line.new-transport-rubl       buf_stk-supp-line.other-base     = buf_temp-stk-supp-line.new-other-base           buf_stk-supp-line.other-rubl     = buf_temp-stk-supp-line.new-other-rubl
     7728         .
     7729       end.
     7730     end.
     7731   end procedure.
     7732   procedure store-tot :
