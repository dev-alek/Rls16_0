        1   block-level on error undo, throw.
        2   define input parameter p-b-code like ub.bar-code.b-code no-undo.
        3   define input parameter p-question-weight as logical no-undo .
        4   define input parameter p-question-global as logical no-undo .
        5   define input parameter p-question-on     as logical no-undo .
        6   define input parameter p-current-b-str like ub.prod-bc.b-str no-undo.
        7   define output parameter p-answer as logical no-undo .
        8   define output parameter p-on as logical no-undo .
        9   define output parameter p-b-str like ub.prod-bc.b-str no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Проверка наличия у товара весовых кодов".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable l-prod-bc-global as logical no-undo .
       86   define variable l-prod-bc-weight as logical no-undo .
       87   DEFINE VARIABLE v-answer-global as logical no-undo init yes.
       88   DEFINE VARIABLE v-answer-weight as logical no-undo init yes.
       89   DEFINE VARIABLE v-answer-on     as logical no-undo init yes.
       90   DEFINE VARIABLE v-found         as logical no-undo .
       91   DEFINE VARIABLE v-found-b-str   like ub.prod-bc.b-str no-undo .
       92   define buffer b-prod-bc for ub.prod-bc .
       93   do
       94   on error undo, return error
       95   :
       96     _b-prod-bc:
       97     FOR EACH b-prod-bc where
       98             b-prod-bc.b-code = p-b-code no-LOCK:
       99       if p-current-b-str = b-prod-bc.b-str then NEXT _b-prod-bc.
      100       assign
      101       v-answer-global = yes
      102       v-answer-weight = yes
      103       v-answer-on     = yes
      104       .
      105       if p-question-global then do:
      106   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      108     (buffer b-prod-bc
      109     ,input  'global=request':u
      110     ,output l-prod-bc-global
      111     ) no-error .
      112         if error-status :error then do:
      113           message
      114             vss-workfile vss-revision vss-description skip
      115             "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
      116             "Основной бар-код" b-prod-bc.b-code skip
      117             "Дополнительный бар-код" b-prod-bc.b-str skip
      118             "Действие global=request" skip
      119             error-status :get-message(1) skip
      120             return-value skip
      121             view-as alert-box error .
      122           return error .
      123         end.
      124       end.
      125       if p-question-weight then do:
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
      128     (buffer b-prod-bc
      129     ,input  'weight=request':u
      130     ,output l-prod-bc-weight
      131     ) no-error .
      132         if error-status :error then do:
      133           message
      134             vss-workfile vss-revision vss-description skip
      135             "Ошибка при определении типа дополнительного бар-кода prodbcat" skip
      136             "Основной бар-код" b-prod-bc.b-code skip
      137             "Дополнительный бар-код" b-prod-bc.b-str skip
      138             "Действие weight=request" skip
      139             error-status :get-message(1) skip
      140             return-value skip
      141             view-as alert-box error .
      142           return error .
      143         end.
      144       end.
      145       if p-question-global and (NOT l-prod-bc-global) then do:
      146         v-answer-global = no.
      147       end.
      148       if p-question-weight and (NOT l-prod-bc-weight) then do:
      149         v-answer-weight = no.
      150       end.
      151       assign
      152       p-on = b-prod-bc.bc-on
      153       p-b-str = b-prod-bc.b-str
      154       .
      155       if p-question-on then do:
      156         assign
      157         v-answer-on = p-on
      158         .
      159       end.
      160       assign
      161       v-found = (if v-found = no then
      162                 v-answer-global AND v-answer-weight
      163                 else v-found)
      164       v-found-b-str = (if v-found-b-str = "":U
      165                        then b-prod-bc.b-str
      166                        else v-found-b-str
      167                        )
      168       p-answer = v-answer-global AND v-answer-weight AND v-answer-on.
      169       if p-answer then LEAVE.
      170     END.
      171     if (p-question-on and not p-answer)
      172     AND v-found then do:
      173       assign
      174       p-answer = yes
      175       p-on = no
      176       p-b-str = v-found-b-str
      177       .
      178     end.
      179    end.
