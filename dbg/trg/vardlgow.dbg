        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.varianty-delivery-gds-obj OLD old_varianty-delivery-gds-obj.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись в таблице ВАРИАНТЫ ДОСТАВКИ ДЛЯ ТОВАРА НА ОБЪЕКТЕ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                                          , ub.varianty-delivery-gds-obj.gds-code
       30                                          , ub.varianty-delivery-gds-obj.obj-type
       31                                          , ub.varianty-delivery-gds-obj.obj-code
       32                                          , ub.varianty-delivery-gds-obj.deliv-type-code
       33                                          , ub.varianty-delivery-gds-obj.deliv-subj-code
       34                                           )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure cur-time :
       89      define output parameter p-today as date      no-undo .
       90      define output parameter p-time  as integer   no-undo .
       91     do
       92     on error undo, return error
       93     :
       94       define variable v-date1 as date      no-undo .
       95       define variable v-date2 as date      no-undo .
       96       define variable v-time  as integer   no-undo .
       97       assign
       98         v-date1 = today
       99         v-time  = time
      100         v-date2 = today
      101       .
      102       if v-date1 <> v-date2
      103       then do:
      104         assign
      105           v-date1 = today
      106           v-time  = v-time
      107         .
      108       end.
      109       assign
      110         p-today = v-date1
      111         p-time  = v-time
      112       .
      113     end.
      114   end.
      115   function cur-time-date returns character
      116   :
      117     return string(today, '99/99/9999':U) .
      118   end.
      119   function cur-time-mjd returns decimal
      120   :
      121     define variable v-date as date      no-undo .
      122     define variable v-time as integer   no-undo .
      123     run cur-time in this-procedure
      124       (output v-date
      125       ,output v-time
      126       ) .
      127     return integer(v-date) - 2400002 + (v-time / 86400) .
      128   end.
      129   function cur-time-get-ending-index returns integer
      130   (input p-number as integer
      131   )
      132   :
      133     if p-number < 0
      134     or p-number = ?
      135     then do:
      136       return 1 .
      137     end.
      138     define variable v-rest as integer   no-undo .
      139     assign
      140       p-number = p-number modulo 100
      141     .
      142     if p-number < 20
      143     then do:
      144       assign
      145         v-rest = p-number
      146       .
      147     end.
      148     else do:
      149       assign
      150         v-rest = p-number modulo 10
      151       .
      152     end.
      153     case v-rest :
      154       when 1
      155       then do:
      156         return 2 .
      157       end.
      158       when 2 or
      159       when 3 or
      160       when 4
      161       then do:
      162         return 3 .
      163       end.
      164       otherwise do:
      165         return 1 .
      166       end.
      167     end case .
      168   end.
      169   procedure cur-time-mjd-to-date :
      170      define input  parameter i-mjd-diff as decimal no-undo.
      171      define output parameter o-Date     as date    no-undo.
      172      define output parameter o-Time     as integer no-undo.
      173      define variable v-day-number as integer   no-undo .
      174      if    i-mjd-diff < 0
      175         or i-mjd-diff = ?
      176      then do:
      177         return "?" .
      178      end.
      179      assign
      180         v-day-number = truncate(i-mjd-diff,0).
      181         o-Date = date(v-day-number + 2400002).
      182         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184   end.
      185   function cur-time-mjd-to-string returns character
      186   (input p-mjd-diff as decimal
      187   )
      188   :
      189     define variable v-day-number as integer   no-undo .
      190     define variable v-seconds    as integer   no-undo .
      191     define variable v-hour       as integer   no-undo .
      192     define variable v-min        as integer   no-undo .
      193     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      194     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      195     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      196     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      197     if p-mjd-diff < 0
      198     or p-mjd-diff = ?
      199     then do:
      200       return "?" .
      201     end.
      202     assign
      203       v-day-number = integer(truncate(p-mjd-diff,0))
      204       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206     if v-seconds > 86400
      207     then do:
      208       assign
      209         v-seconds = 86400 - 1
      210       .
      211     end.
      212     if v-seconds < 0
      213     then do:
      214       assign
      215         v-seconds = 0
      216       .
      217     end.
      218     assign
      219       v-hour = truncate(v-seconds / 3600, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 3600
      223     .
      224     assign
      225       v-min = truncate(v-seconds / 60, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 60
      229     .
      230     return
      231         (if v-day-number <> 0
      232           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0
      236           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      240           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      241           else ""
      242         )
      243       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      244       .
      245   end.
      246   function cur-time-string returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      255   end.
      256   function cur-time-string-sec returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      265   end.
      266   function cur-time-custom  returns character
      267   (input p-prefix as character
      268   ,input p-date-format as character
      269   ,input p-delimiter as character
      270   ,input p-time-format as character
      271   ,input p-suffix as character
      272   )
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return
      281       p-prefix
      282       + string(v-date, p-date-format)
      283       + p-delimiter
      284       + string(v-time, p-time-format)
      285       + p-suffix
      286       .
      287   end.
      288   function cur-time-print  returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-datetime returns datetime
      299   :
      300     define variable v-char as character no-undo .
      301     define variable v-datetime as datetime no-undo .
      302     v-char = cur-time-string().
      303     v-datetime = datetime(v-char).
      304     return  v-datetime.
      305   end.
      306   function cur-time-string-msec returns character
      307   :
      308     define variable v-date as datetime  no-undo .
      309     v-date = now.
      310     return string(v-date) .
      311   end.
      312   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   define new global shared variable g#lib-nws as handle no-undo .
      314   define variable v-date as date no-undo .
      315   define variable v-time as integer no-undo .
      316   define variable v-db-num like ub.db.db-num no-undo .
      317   define variable v-host-code like ub.sysconf.host-code no-undo .
      318   define buffer buf_c-varianty-delivery-gds-obj for ub.c-varianty-delivery-gds-obj.
      319   define buffer buf_clients for ub.clients.
      320   define buffer buf_goods for ub.goods.
      321   define buffer buf_group-period-validity  for ub.group-period-validity.
      322   define buffer buf_var-deliv-gr-per-val for ub.var-deliv-gr-per-val.
      323   define buffer buf_deliv-type-cond-keep for ub.deliv-type-cond-keep.
      324   define buffer buf_c-gds-hist for ub.c-gds-hist.
      325   main-block:
      326   do
      327   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      328   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      329   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      330   :
      331     if not g#news then do:
      332   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      333   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      334     (input  ub.varianty-delivery-gds-obj.obj-type
      335     ,input  ub.varianty-delivery-gds-obj.obj-code
      336     ,output v-db-num
      337     )  .
      338       if g#db-num <> v-db-num then do:
      339         message
      340         vss-workfile vss-revision vss-description skip
      341         "Нельзя изменять запись ВАРИАНТЫ ДОСТАВКИ ДЛЯ ТОВАРА НА ОБЪЕКТЕ для объекта другой БД" skip
      342         view-as alert-box error .
      343         undo main-block, return error .
      344       end.
      345       find first buf_goods no-lock where
      346                  buf_goods.gds-code = ub.varianty-delivery-gds-obj.gds-code  no-error .
      347       if not available buf_goods then do:
      348         message
      349         vss-workfile vss-revision vss-description skip
      350         "Неправильная ссылка на ТОВАР" skip
      351         "код товара" ub.varianty-delivery-gds-obj.gds-code skip
      352          view-as alert-box error .
      353         undo main-block, return error.
      354       end.
      355       find first buf_clients no-lock where
      356                  buf_clients.obj-type = ub.varianty-delivery-gds-obj.obj-type
      357              AND buf_clients.obj-code = ub.varianty-delivery-gds-obj.obj-code
      358                  no-error .
      359       if not available buf_clients then do:
      360         message
      361         vss-workfile vss-revision vss-description skip
      362         "Неправильная ссылка на ОБЪЕКТ ДОСТАВКИ" skip
      363         "тип" ub.varianty-delivery-gds-obj.obj-type    skip
      364         "код" ub.varianty-delivery-gds-obj.obj-code   skip
      365          view-as alert-box error .
      366         undo main-block, return error.
      367       end.
      368       find first buf_deliv-type-cond-keep no-lock where
      369                  buf_deliv-type-cond-keep.deliv-type-code = ub.varianty-delivery-gds-obj.deliv-type-code
      370              AND buf_deliv-type-cond-keep.cond-keep-code  = ub.varianty-delivery-gds-obj.cond-keep-code
      371                  no-error .
      372       if not available buf_deliv-type-cond-keep then do:
      373         message
      374         vss-workfile vss-revision vss-description skip
      375         "Неправильная ссылка на ТИП ДОСТАВКИ ПО УСЛОВИЯ ХРАНЕНИЯ" skip
      376         "код типа доставки" ub.varianty-delivery-gds-obj.deliv-type-code skip
      377         "код условий хранения" ub.varianty-delivery-gds-obj.cond-keep-code skip
      378          view-as alert-box error .
      379         undo main-block, return error.
      380       end.
      381       find first buf_var-deliv-gr-per-val no-lock where
      382                  buf_var-deliv-gr-per-val.deliv-type-code = ub.varianty-delivery-gds-obj.deliv-type-code
      383              AND buf_var-deliv-gr-per-val.deliv-subj-code = ub.varianty-delivery-gds-obj.deliv-subj-code
      384              AND buf_var-deliv-gr-per-val.obj-type        = ub.varianty-delivery-gds-obj.obj-type
      385              AND buf_var-deliv-gr-per-val.obj-code        = ub.varianty-delivery-gds-obj.obj-code
      386              AND buf_var-deliv-gr-per-val.gr-per-val-code = ub.varianty-delivery-gds-obj.gr-per-val-code
      387                  no-error .
      388       if not available buf_var-deliv-gr-per-val then do:
      389         message
      390         vss-workfile vss-revision vss-description skip
      391         "Неправильная ссылка на ВАРИАНТ ДОСТАВКИ" skip
      392         "код типа доставки" ub.varianty-delivery-gds-obj.deliv-type-code skip
      393         "код субъекта доставки" ub.varianty-delivery-gds-obj.deliv-subj-code skip
      394         "тип объекта доставки" ub.varianty-delivery-gds-obj.obj-type    skip
      395         "код объекта доставки" ub.varianty-delivery-gds-obj.obj-code   skip
      396         "код группы сроков годности" ub.varianty-delivery-gds-obj.gr-per-val-code   skip
      397          view-as alert-box error .
      398         undo main-block, return error.
      399       end.
      400     end.
      401     if g#news then do:
      402       define variable v-send as integer no-undo .
      403       v-send = integer('0':U).
      404   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      405   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      406     (input  g#db-num
      407     ,input  'varianty-delivery-gds-obj':U
      408     ,input  0
      409     ,input  '':U
      410     ,input  0
      411     ,input  '':U
      412     ,input  '':U
      413     ,input  '':U
      414     ,input  0
      415     ,input  0
      416     ,input  0
      417     ,input  'nws-to-hist'
      418     ,output v-send
      419     ) no-error .
      420     end.
      421     if not g#news
      422     or v-send >= 0
      423     then do:
      424       run cur-time in this-procedure(output v-date, output v-time).
      425       create buf_c-varianty-delivery-gds-obj.
      426       buffer-copy old_varianty-delivery-gds-obj to buf_c-varianty-delivery-gds-obj
      427       assign
      428       buf_c-varianty-delivery-gds-obj.gds-code           = ub.varianty-delivery-gds-obj.gds-code
      429       buf_c-varianty-delivery-gds-obj.obj-type           = ub.varianty-delivery-gds-obj.obj-type
      430       buf_c-varianty-delivery-gds-obj.obj-code           = ub.varianty-delivery-gds-obj.obj-code
      431       buf_c-varianty-delivery-gds-obj.deliv-type-code    = ub.varianty-delivery-gds-obj.deliv-type-code
      432       buf_c-varianty-delivery-gds-obj.deliv-subj-code    = ub.varianty-delivery-gds-obj.deliv-subj-code
      433       buf_c-varianty-delivery-gds-obj.chip-num           = next-value (s-gds-chip, ub)
      434       buf_c-varianty-delivery-gds-obj.corr-time          = v-time
      435       buf_c-varianty-delivery-gds-obj.corr-user-db-num   = g#db-num
      436       buf_c-varianty-delivery-gds-obj.corr-user-name     = g#userid
      437       buf_c-varianty-delivery-gds-obj.corr-date          = v-date
      438       .
      439   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      440   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      441     (input  ub.varianty-delivery-gds-obj.obj-type
      442     ,input  ub.varianty-delivery-gds-obj.obj-code
      443     ,output v-host-code
      444     )  .
      445       create buf_c-gds-hist.
      446       buffer-copy buf_c-varianty-delivery-gds-obj to buf_c-gds-hist
      447       assign
      448       buf_c-gds-hist.action = (if new ub.varianty-delivery-gds-obj then integer('1':U) else integer('2':U))
      449       buf_c-gds-hist.subject = 'varianty-delivery-gds-obj':U
      450       buf_c-gds-hist.host-code = v-host-code
      451       buf_c-gds-hist.is-news = g#news
      452       buf_c-gds-hist.source-type = (if g#news then 'db':U else "":U)
      453       buf_c-gds-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      454       .
      455     end.
      456     if not g#news
      457     or g#db-num > 0 then do:
      458       run str/callnews.p
      459         (input 'varianty-delivery-gds-obj':U
      460         ,input (buffer ub.varianty-delivery-gds-obj:handle)
      461         ).
      462     end.
      463     if g#oxml = yes
      464     then do:
      465       run str/calloxml.p (
      466             input 'update':U
      467           , input 'varianty-delivery-gds-obj':U
      468           , input ( buffer ub.varianty-delivery-gds-obj:handle )
      469       ) no-error.
      470       if error-status :error
      471       then do:
      472           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      473                                , chr(10)
      474                                , vss-workfile
      475                                , return-value
      476                                , error-status :get-message ( 1 ) ).
      477       end.
      478       end.
      479   end.
