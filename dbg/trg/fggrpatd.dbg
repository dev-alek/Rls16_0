        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.fbr-gds-grp-attr.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление атрибутов группы блюд".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4'
       29                 ,ub.fbr-gds-grp-attr.obj-type
       30                 ,ub.fbr-gds-grp-attr.obj-code
       31                 ,ub.fbr-gds-grp-attr.node-code
       32                 ,ub.fbr-gds-grp-attr.attr-code
       33                 )
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   procedure fbr-grp-attr-name :
       88   do
       89     on error undo, return error
       90     :
       91     define input  parameter p-code           as character no-undo .
       92     define output parameter p-type           as character no-undo .
       93     define output parameter p-format         as character no-undo .
       94     define output parameter p-label          as character no-undo .
       95     define output parameter p-user-can-edit  as logical   no-undo .
       96     define output parameter p-output-display as logical   no-undo .
       97     define output parameter p-other          as character no-undo .
       98       case p-code :
       99         otherwise do:
      100           undo, return error "Неизвестный атрибут группы блюд" + " " + p-code .
      101         end.
      102       end.
      103     end.
      104   end procedure.
      105   procedure fbr-grp-attr-tooltip :
      106   do
      107     on error undo, return error
      108     :
      109       define input  parameter p-code    as character no-undo .
      110       define output parameter p-tooltip as character no-undo .
      111       define output parameter p-label   as character no-undo .
      112       case p-code :
      113         otherwise do:
      114               undo, return error "Неизвестный атрибут группы блюд" + " " + p-code .
      115         end.
      116       end.
      117     end.
      118   end procedure.
      119   procedure fbr-grp-attr-value :
      120   do
      121   on error undo, return error
      122   :
      123   define input  parameter p-obj-type    as character  no-undo.
      124   define input  parameter p-obj-code    as integer    no-undo.
      125   define input  parameter p-node-code   as integer    no-undo.
      126   define input  parameter p-code        as character  no-undo.
      127   define output parameter p-value       as character  no-undo.
      128   define output parameter p-type        as character  no-undo.
      129       define variable v-format         as character no-undo .
      130       define variable v-label          as character no-undo .
      131       define variable v-user-can-edit  as logical   no-undo .
      132       define variable v-output-display as logical   no-undo .
      133       define variable v-other          as character no-undo .
      134       define buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr.
      135       run fbr-grp-attr-name in this-procedure (
      136             input  p-code
      137           , output p-type
      138           , output v-format
      139           , output v-label
      140           , output v-user-can-edit
      141           , output v-output-display
      142           , output v-other
      143       ) no-error .
      144       if error-status :error
      145       then do:
      146           undo, return error return-value .
      147       end.
      148       find first buf_fbr-gds-grp-attr no-lock
      149            where buf_fbr-gds-grp-attr.obj-type  = p-obj-type
      150              and buf_fbr-gds-grp-attr.obj-code  = p-obj-code
      151              and buf_fbr-gds-grp-attr.node-code = p-node-code
      152              and buf_fbr-gds-grp-attr.attr-code = p-code
      153       no-error .
      154       if available buf_fbr-gds-grp-attr
      155       then do:
      156           assign
      157               p-value = buf_fbr-gds-grp-attr.attr-value
      158           .
      159       end.
      160       else do:
      161           assign
      162           p-value = (if p-type = 'L':U then "no":U else "")
      163           .
      164       end.
      165   end.
      166   end procedure.
      167   procedure fbr-grp-attr-write :
      168   do
      169   on error undo, return error
      170   :
      171   define input parameter p-obj-type   like ub.fbr-gds-grp-attr.obj-type            no-undo.
      172   define input parameter p-obj-code   like ub.fbr-gds-grp-attr.obj-code            no-undo.
      173   define input parameter p-node-code  like ub.fbr-gds-grp-attr.node-code      no-undo.
      174   define input parameter p-code       like ub.fbr-gds-grp-attr.attr-code      no-undo.
      175   define input parameter p-value      like ub.fbr-gds-grp-attr.attr-value     no-undo.
      176       define variable v-type              as character                no-undo.
      177       define variable v-format            as character                no-undo.
      178       define variable v-label             as character                no-undo.
      179       define variable v-user-can-edit     as logical                  no-undo.
      180       define variable v-output-display    as logical                  no-undo.
      181       define variable v-other             as character                no-undo.
      182       define buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr .
      183       run fbr-grp-attr-name in this-procedure (
      184                         input  p-code
      185                       , output v-type
      186                       , output v-format
      187                       , output v-label
      188                       , output v-user-can-edit
      189                       , output v-output-display
      190                       , output v-other
      191       ) no-error.
      192       if error-status :error
      193       then do:
      194           undo, return error return-value.
      195       end.
      196       find first buf_fbr-gds-grp-attr exclusive-lock
      197            where buf_fbr-gds-grp-attr.obj-type   = p-obj-type
      198              and buf_fbr-gds-grp-attr.obj-code   = p-obj-code
      199              and buf_fbr-gds-grp-attr.node-code  = p-node-code
      200              and buf_fbr-gds-grp-attr.attr-code  = p-code
      201       no-error.
      202       if not available buf_fbr-gds-grp-attr
      203       then do:
      204           create buf_fbr-gds-grp-attr.
      205           assign
      206           buf_fbr-gds-grp-attr.node-code  = p-node-code
      207           buf_fbr-gds-grp-attr.attr-code  = p-code
      208           buf_fbr-gds-grp-attr.obj-type   = p-obj-type
      209           buf_fbr-gds-grp-attr.obj-code   = p-obj-code
      210           buf_fbr-gds-grp-attr.attr-value = p-value
      211           .
      212       end.
      213       else do:
      214           assign
      215               buf_fbr-gds-grp-attr.attr-value = p-value
      216           .
      217       end.
      218   end.
      219   end procedure.
      220   procedure fbr-grp-attr-delete :
      221   do
      222   on error undo, return error
      223   :
      224   define input parameter p-obj-type   like ub.fbr-gds-grp-attr.obj-type        no-undo.
      225   define input parameter p-obj-code   like ub.fbr-gds-grp-attr.obj-code        no-undo.
      226   define input parameter p-node-code  like ub.fbr-gds-grp-attr.node-code  no-undo.
      227   define input parameter p-code       like ub.fbr-gds-grp-attr.attr-code  no-undo.
      228   define output parameter p-deleted   as logical                      no-undo.
      229       define buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr .
      230       define variable v-type              as character                no-undo.
      231       define variable v-format            as character                no-undo.
      232       define variable v-label             as character                no-undo.
      233       define variable v-user-can-edit     as logical                  no-undo.
      234       define variable v-output-display    as logical                  no-undo.
      235       define variable v-other             as character                no-undo.
      236       run fbr-grp-attr-name in this-procedure
      237       ( input  p-code
      238       , output v-type
      239       , output v-format
      240       , output v-label
      241       , output v-user-can-edit
      242       , output v-output-display
      243       , output v-other
      244       ) no-error .
      245       if error-status :error then do:
      246           undo, return error return-value .
      247       end.
      248       find first buf_fbr-gds-grp-attr exclusive-lock
      249            where buf_fbr-gds-grp-attr.obj-type   = p-obj-type
      250              and buf_fbr-gds-grp-attr.obj-code   = p-obj-code
      251              and buf_fbr-gds-grp-attr.node-code  = p-node-code
      252              and buf_fbr-gds-grp-attr.attr-code  = p-code
      253       no-error.
      254       if not available buf_fbr-gds-grp-attr
      255       then do:
      256           assign
      257               p-deleted = no
      258           .
      259       end.
      260       else do:
      261          delete buf_fbr-gds-grp-attr.
      262          assign
      263               p-deleted = yes
      264           .
      265       end.
      266   end.
      267   end procedure.
      268   procedure fbr-grp-attr-news :
      269   do
      270   on error undo, return error
      271   :
      272       define input  parameter p-code           as character no-undo .
      273       define output parameter p-news           as logical   no-undo .
      274       case p-code :
      275         otherwise do:
      276           undo, return error "неизвестный атрибут группы блюд" + " " + p-code .
      277         end.
      278       end.
      279   end.
      280   end procedure.
      281   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      282   procedure cur-time :
      283      define output parameter p-today as date      no-undo .
      284      define output parameter p-time  as integer   no-undo .
      285     do
      286     on error undo, return error
      287     :
      288       define variable v-date1 as date      no-undo .
      289       define variable v-date2 as date      no-undo .
      290       define variable v-time  as integer   no-undo .
      291       assign
      292         v-date1 = today
      293         v-time  = time
      294         v-date2 = today
      295       .
      296       if v-date1 <> v-date2
      297       then do:
      298         assign
      299           v-date1 = today
      300           v-time  = v-time
      301         .
      302       end.
      303       assign
      304         p-today = v-date1
      305         p-time  = v-time
      306       .
      307     end.
      308   end.
      309   function cur-time-date returns character
      310   :
      311     return string(today, '99/99/9999':U) .
      312   end.
      313   function cur-time-mjd returns decimal
      314   :
      315     define variable v-date as date      no-undo .
      316     define variable v-time as integer   no-undo .
      317     run cur-time in this-procedure
      318       (output v-date
      319       ,output v-time
      320       ) .
      321     return integer(v-date) - 2400002 + (v-time / 86400) .
      322   end.
      323   function cur-time-get-ending-index returns integer
      324   (input p-number as integer
      325   )
      326   :
      327     if p-number < 0
      328     or p-number = ?
      329     then do:
      330       return 1 .
      331     end.
      332     define variable v-rest as integer   no-undo .
      333     assign
      334       p-number = p-number modulo 100
      335     .
      336     if p-number < 20
      337     then do:
      338       assign
      339         v-rest = p-number
      340       .
      341     end.
      342     else do:
      343       assign
      344         v-rest = p-number modulo 10
      345       .
      346     end.
      347     case v-rest :
      348       when 1
      349       then do:
      350         return 2 .
      351       end.
      352       when 2 or
      353       when 3 or
      354       when 4
      355       then do:
      356         return 3 .
      357       end.
      358       otherwise do:
      359         return 1 .
      360       end.
      361     end case .
      362   end.
      363   procedure cur-time-mjd-to-date :
      364      define input  parameter i-mjd-diff as decimal no-undo.
      365      define output parameter o-Date     as date    no-undo.
      366      define output parameter o-Time     as integer no-undo.
      367      define variable v-day-number as integer   no-undo .
      368      if    i-mjd-diff < 0
      369         or i-mjd-diff = ?
      370      then do:
      371         return "?" .
      372      end.
      373      assign
      374         v-day-number = truncate(i-mjd-diff,0).
      375         o-Date = date(v-day-number + 2400002).
      376         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      377     .
      378   end.
      379   function cur-time-mjd-to-string returns character
      380   (input p-mjd-diff as decimal
      381   )
      382   :
      383     define variable v-day-number as integer   no-undo .
      384     define variable v-seconds    as integer   no-undo .
      385     define variable v-hour       as integer   no-undo .
      386     define variable v-min        as integer   no-undo .
      387     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      388     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      389     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      390     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      391     if p-mjd-diff < 0
      392     or p-mjd-diff = ?
      393     then do:
      394       return "?" .
      395     end.
      396     assign
      397       v-day-number = integer(truncate(p-mjd-diff,0))
      398       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      399     .
      400     if v-seconds > 86400
      401     then do:
      402       assign
      403         v-seconds = 86400 - 1
      404       .
      405     end.
      406     if v-seconds < 0
      407     then do:
      408       assign
      409         v-seconds = 0
      410       .
      411     end.
      412     assign
      413       v-hour = truncate(v-seconds / 3600, 0)
      414     .
      415     assign
      416       v-seconds = v-seconds modulo 3600
      417     .
      418     assign
      419       v-min = truncate(v-seconds / 60, 0)
      420     .
      421     assign
      422       v-seconds = v-seconds modulo 60
      423     .
      424     return
      425         (if v-day-number <> 0
      426           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      427           else ""
      428         )
      429       + (if v-day-number <> 0 or v-hour <> 0
      430           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      431           else ""
      432         )
      433       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      434           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      435           else ""
      436         )
      437       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      438       .
      439   end.
      440   function cur-time-string returns character
      441   :
      442     define variable v-date as date      no-undo .
      443     define variable v-time as integer   no-undo .
      444     run cur-time in this-procedure
      445       (output v-date
      446       ,output v-time
      447       ) .
      448     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      449   end.
      450   function cur-time-string-sec returns character
      451   :
      452     define variable v-date as date      no-undo .
      453     define variable v-time as integer   no-undo .
      454     run cur-time in this-procedure
      455       (output v-date
      456       ,output v-time
      457       ) .
      458     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      459   end.
      460   function cur-time-custom  returns character
      461   (input p-prefix as character
      462   ,input p-date-format as character
      463   ,input p-delimiter as character
      464   ,input p-time-format as character
      465   ,input p-suffix as character
      466   )
      467   :
      468     define variable v-date as date      no-undo .
      469     define variable v-time as integer   no-undo .
      470     run cur-time in this-procedure
      471       (output v-date
      472       ,output v-time
      473       ) .
      474     return
      475       p-prefix
      476       + string(v-date, p-date-format)
      477       + p-delimiter
      478       + string(v-time, p-time-format)
      479       + p-suffix
      480       .
      481   end.
      482   function cur-time-print  returns character
      483   :
      484     define variable v-date as date      no-undo .
      485     define variable v-time as integer   no-undo .
      486     run cur-time in this-procedure
      487       (output v-date
      488       ,output v-time
      489       ) .
      490     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      491   end.
      492   function cur-time-datetime returns datetime
      493   :
      494     define variable v-char as character no-undo .
      495     define variable v-datetime as datetime no-undo .
      496     v-char = cur-time-string().
      497     v-datetime = datetime(v-char).
      498     return  v-datetime.
      499   end.
      500   function cur-time-string-msec returns character
      501   :
      502     define variable v-date as datetime  no-undo .
      503     v-date = now.
      504     return string(v-date) .
      505   end.
      506   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   procedure fbr-gds-grph_write-fbr-gds-grp-attr-trigger :
      508   define input parameter p-new-record as logical no-undo .
      509   define input parameter p-source-type like ub.c-fbr-gds-grp-hist.source-type no-undo .
      510   define input parameter p-source-ref  like ub.c-fbr-gds-grp-hist.source-ref no-undo .
      511   define input parameter p-action as integer no-undo .
      512   define variable v-date as date      no-undo.
      513   define variable v-time  as integer   no-undo.
      514   define buffer buf_c-fbr-gds-grp-hist for ub.c-fbr-gds-grp-hist.
      515   define buffer buf_c-fbr-gds-grp-attr for ub.c-fbr-gds-grp-attr.
      516     do
      517     on error undo, return error
      518     :
      519       run cur-time in this-procedure(output v-date, output v-time).
      520       create buf_c-fbr-gds-grp-attr.
      521       buffer-copy ub.fbr-gds-grp-attr to buf_c-fbr-gds-grp-attr
      522       assign
      523       buf_c-fbr-gds-grp-attr.obj-type           = (if p-new-record then ub.fbr-gds-grp-attr.obj-type  else ub.fbr-gds-grp-attr.obj-type)
      524       buf_c-fbr-gds-grp-attr.obj-code           = (if p-new-record then ub.fbr-gds-grp-attr.node-code else ub.fbr-gds-grp-attr.obj-code)
      525       buf_c-fbr-gds-grp-attr.node-code          = (if p-new-record then ub.fbr-gds-grp-attr.node-code else ub.fbr-gds-grp-attr.node-code)
      526       buf_c-fbr-gds-grp-attr.attr-code          = (if p-new-record then ub.fbr-gds-grp-attr.attr-code else  ub.fbr-gds-grp-attr.attr-code)
      527       buf_c-fbr-gds-grp-attr.chip-num           = next-value (s-fbr-gds-grp-chip, ub)
      528       buf_c-fbr-gds-grp-attr.corr-time          = v-time
      529       buf_c-fbr-gds-grp-attr.corr-user-db-num   = g#db-num
      530       buf_c-fbr-gds-grp-attr.corr-user-name     = (if g#news
      531                                               then (chr(4) +  'СПН':U)
      532                                               else (if g#esys
      533                                                     then (chr(4) +  'ВС':U)
      534                                                     else g#userid)
      535                                               )
      536       buf_c-fbr-gds-grp-attr.corr-date          = v-date
      537       .
      538       create buf_c-fbr-gds-grp-hist.
      539       buffer-copy buf_c-fbr-gds-grp-attr to buf_c-fbr-gds-grp-hist
      540       assign
      541       buf_c-fbr-gds-grp-hist.obj-type            = buf_c-fbr-gds-grp-attr.obj-type
      542       buf_c-fbr-gds-grp-hist.obj-code            = buf_c-fbr-gds-grp-attr.obj-code
      543       buf_c-fbr-gds-grp-hist.node-code           = buf_c-fbr-gds-grp-attr.node-code
      544       buf_c-fbr-gds-grp-hist.action = p-action
      545       buf_c-fbr-gds-grp-hist.subject = 'fbr-gds-grp-attr':U
      546       buf_c-fbr-gds-grp-hist.is-news = g#news
      547       buf_c-fbr-gds-grp-hist.source-type = p-source-type
      548       buf_c-fbr-gds-grp-hist.source-ref = p-source-ref
      549       buf_c-fbr-gds-grp-hist.is-del = (p-action = integer('99':U))
      550       .
      551     end.
      552   end procedure.
      553   procedure fbr-gds-grph_write-fbr-gds-grp-attr-proc  :
      554   define parameter buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr .
      555   define input parameter p-action as integer no-undo .
      556   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      557   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      558   define variable v-date as date      no-undo.
      559   define variable v-time  as integer   no-undo.
      560   define buffer buf_c-fbr-gds-grp-hist for ub.c-fbr-gds-grp-hist.
      561   define buffer buf_c-fbr-gds-grp-attr for ub.c-fbr-gds-grp-attr.
      562     do
      563     on error undo, return error
      564     :
      565       if not available buf_fbr-gds-grp-attr then do:
      566         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      567                       "Ошибка задания входных параметров:Не определен атрибут группы блюд" ).
      568       end.
      569       run cur-time in this-procedure(output v-date, output v-time).
      570       create buf_c-fbr-gds-grp-attr.
      571       buffer-copy buf_fbr-gds-grp-attr to buf_c-fbr-gds-grp-attr
      572       assign
      573       buf_c-fbr-gds-grp-attr.obj-type           = buf_fbr-gds-grp-attr.obj-type
      574       buf_c-fbr-gds-grp-attr.obj-code           = buf_fbr-gds-grp-attr.obj-code
      575       buf_c-fbr-gds-grp-attr.node-code          = buf_fbr-gds-grp-attr.node-code
      576       buf_c-fbr-gds-grp-attr.attr-code          = buf_fbr-gds-grp-attr.attr-code
      577       buf_c-fbr-gds-grp-attr.chip-num           = next-value (s-fbr-gds-grp-chip, ub)
      578       buf_c-fbr-gds-grp-attr.corr-time          = v-time
      579       buf_c-fbr-gds-grp-attr.corr-user-db-num   = g#db-num
      580       buf_c-fbr-gds-grp-attr.corr-user-name     = (if g#news
      581                                               then (chr(4) +  'СПН':U)
      582                                               else (if g#esys
      583                                                     then (chr(4) +  'ВС':U)
      584                                                     else g#userid)
      585                                               )
      586       buf_c-fbr-gds-grp-attr.corr-date          = v-date
      587       .
      588       create buf_c-fbr-gds-grp-hist.
      589       buffer-copy buf_c-fbr-gds-grp-attr to buf_c-fbr-gds-grp-hist
      590       assign
      591       buf_c-fbr-gds-grp-hist.action =  p-action
      592       buf_c-fbr-gds-grp-hist.subject = 'fbr-gds-grp-attr':U
      593       buf_c-fbr-gds-grp-hist.is-news = g#news
      594       buf_c-fbr-gds-grp-hist.source-type = p-source-type
      595       buf_c-fbr-gds-grp-hist.source-ref = p-source-ref
      596       .
      597     end.
      598   end procedure.
      599   define variable p-news as logical no-undo.
      600   main-block:
      601   do
      602   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      603   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      604   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      605   :
      606     run fbr-grp-attr-news in this-procedure(input ub.fbr-gds-grp-attr.attr-code,
      607                                         output p-news) no-error.
      608     if p-news
      609     and not g#news
      610     and g#db-num <> 0 then do:
      611       run nws/cmd-del.p
      612         ( input "fbr-gds-grp-attr":U
      613         ,input (buffer ub.fbr-gds-grp-attr:handle)
      614         ,input string(0)
      615         ) no-error .
      616       if error-status :error then do:
      617         undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      618       end.
      619     end.
      620     if not g#news then do:
      621       run fbr-gds-grph_write-fbr-gds-grp-attr-proc   in this-procedure (
      622                                                         buffer ub.fbr-gds-grp-attr
      623                                                         ,integer('99':U)
      624                                                         ,"":U
      625                                                         ,"":U
      626                                                         ).
      627     end.
      628       if g#oxml = yes
      629       then do:
      630       run str/calloxml.p (
      631             input 'delete':U
      632           , input 'fbr-gds-grp-attr':U
      633           , input ( buffer ub.fbr-gds-grp-attr:handle )
      634       ) no-error.
      635       if error-status :error
      636       then do:
      637           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      638                                , chr(10)
      639                                , vss-workfile
      640                                , return-value
      641                                , error-status :get-message ( 1 ) ).
      642       end.
      643       end.
      644   END.
