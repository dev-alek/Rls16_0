        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.dis-time-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление расписания скидок".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1',  ub.dis-time-rule.time-rule-num)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure dtr-code :
       83     do
       84     on error undo, return error
       85     :
       86       define input  parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
       87       define output parameter  p-des               like ub.dis-time-rule.des               no-undo .
       88       define output parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
       89       define output parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
       90       define output parameter  p-level-1 as character no-undo .
       91       define output parameter  p-level-2 as character no-undo .
       92       define output parameter  p-output-display as logical   no-undo .
       93       define output parameter  p-tree           as char  no-undo .
       94       define output parameter  p-other          as character no-undo .
       95       define variable v-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
       96       define buffer buf_dis-time-rule for ub.dis-time-rule .
       97       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
       98       if p-templ-rl-root < 50000 then
       99       v-templ-rl-root = (p-templ-rl-root + 50000).
      100       else v-templ-rl-root = p-templ-rl-root.
      101       find first buf_dis-time-rule no-lock where
      102                 buf_dis-time-rule.time-rule-num = v-templ-rl-root no-error .
      103       if not available buf_dis-time-rule then do:
      104         undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root) .
      105       end.
      106       find first buf_dis-cfg-rule no-lock where
      107               buf_dis-cfg-rule.templ-rl-root = 0
      108           and buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      109           and buf_dis-cfg-rule.pos-type = '':U
      110           and buf_dis-cfg-rule.table-name = '':U
      111           and buf_dis-cfg-rule.discnt-role = '':U
      112           and buf_dis-cfg-rule.self-nonunique = '':U
      113               no-error.
      114       if not available buf_Dis-cfg-rule then do:
      115           undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root ).
      116       end.
      117       assign
      118       p-des = buf_dis-time-rule.des
      119       p-upper-time-rule-num = (buf_dis-time-rule.upper-time-rule-num - 50000)
      120       p-value-type = buf_dis-time-rule.value-type
      121       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      122       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      123                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      124                    else '')
      125       p-output-display = (buf_dis-time-rule.sts = integer('0':U))
      126       p-tree = buf_dis-time-rule.uniq-field
      127       p-other = buf_dis-time-rule.other-inf
      128       .
      129     end.
      130   end procedure.
      131   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   procedure cur-time :
      133      define output parameter p-today as date      no-undo .
      134      define output parameter p-time  as integer   no-undo .
      135     do
      136     on error undo, return error
      137     :
      138       define variable v-date1 as date      no-undo .
      139       define variable v-date2 as date      no-undo .
      140       define variable v-time  as integer   no-undo .
      141       assign
      142         v-date1 = today
      143         v-time  = time
      144         v-date2 = today
      145       .
      146       if v-date1 <> v-date2
      147       then do:
      148         assign
      149           v-date1 = today
      150           v-time  = v-time
      151         .
      152       end.
      153       assign
      154         p-today = v-date1
      155         p-time  = v-time
      156       .
      157     end.
      158   end.
      159   function cur-time-date returns character
      160   :
      161     return string(today, '99/99/9999':U) .
      162   end.
      163   function cur-time-mjd returns decimal
      164   :
      165     define variable v-date as date      no-undo .
      166     define variable v-time as integer   no-undo .
      167     run cur-time in this-procedure
      168       (output v-date
      169       ,output v-time
      170       ) .
      171     return integer(v-date) - 2400002 + (v-time / 86400) .
      172   end.
      173   function cur-time-get-ending-index returns integer
      174   (input p-number as integer
      175   )
      176   :
      177     if p-number < 0
      178     or p-number = ?
      179     then do:
      180       return 1 .
      181     end.
      182     define variable v-rest as integer   no-undo .
      183     assign
      184       p-number = p-number modulo 100
      185     .
      186     if p-number < 20
      187     then do:
      188       assign
      189         v-rest = p-number
      190       .
      191     end.
      192     else do:
      193       assign
      194         v-rest = p-number modulo 10
      195       .
      196     end.
      197     case v-rest :
      198       when 1
      199       then do:
      200         return 2 .
      201       end.
      202       when 2 or
      203       when 3 or
      204       when 4
      205       then do:
      206         return 3 .
      207       end.
      208       otherwise do:
      209         return 1 .
      210       end.
      211     end case .
      212   end.
      213   procedure cur-time-mjd-to-date :
      214      define input  parameter i-mjd-diff as decimal no-undo.
      215      define output parameter o-Date     as date    no-undo.
      216      define output parameter o-Time     as integer no-undo.
      217      define variable v-day-number as integer   no-undo .
      218      if    i-mjd-diff < 0
      219         or i-mjd-diff = ?
      220      then do:
      221         return "?" .
      222      end.
      223      assign
      224         v-day-number = truncate(i-mjd-diff,0).
      225         o-Date = date(v-day-number + 2400002).
      226         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      227     .
      228   end.
      229   function cur-time-mjd-to-string returns character
      230   (input p-mjd-diff as decimal
      231   )
      232   :
      233     define variable v-day-number as integer   no-undo .
      234     define variable v-seconds    as integer   no-undo .
      235     define variable v-hour       as integer   no-undo .
      236     define variable v-min        as integer   no-undo .
      237     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      238     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      239     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      240     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      241     if p-mjd-diff < 0
      242     or p-mjd-diff = ?
      243     then do:
      244       return "?" .
      245     end.
      246     assign
      247       v-day-number = integer(truncate(p-mjd-diff,0))
      248       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      249     .
      250     if v-seconds > 86400
      251     then do:
      252       assign
      253         v-seconds = 86400 - 1
      254       .
      255     end.
      256     if v-seconds < 0
      257     then do:
      258       assign
      259         v-seconds = 0
      260       .
      261     end.
      262     assign
      263       v-hour = truncate(v-seconds / 3600, 0)
      264     .
      265     assign
      266       v-seconds = v-seconds modulo 3600
      267     .
      268     assign
      269       v-min = truncate(v-seconds / 60, 0)
      270     .
      271     assign
      272       v-seconds = v-seconds modulo 60
      273     .
      274     return
      275         (if v-day-number <> 0
      276           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      277           else ""
      278         )
      279       + (if v-day-number <> 0 or v-hour <> 0
      280           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      281           else ""
      282         )
      283       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      284           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      285           else ""
      286         )
      287       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      288       .
      289   end.
      290   function cur-time-string returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-string-sec returns character
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      309   end.
      310   function cur-time-custom  returns character
      311   (input p-prefix as character
      312   ,input p-date-format as character
      313   ,input p-delimiter as character
      314   ,input p-time-format as character
      315   ,input p-suffix as character
      316   )
      317   :
      318     define variable v-date as date      no-undo .
      319     define variable v-time as integer   no-undo .
      320     run cur-time in this-procedure
      321       (output v-date
      322       ,output v-time
      323       ) .
      324     return
      325       p-prefix
      326       + string(v-date, p-date-format)
      327       + p-delimiter
      328       + string(v-time, p-time-format)
      329       + p-suffix
      330       .
      331   end.
      332   function cur-time-print  returns character
      333   :
      334     define variable v-date as date      no-undo .
      335     define variable v-time as integer   no-undo .
      336     run cur-time in this-procedure
      337       (output v-date
      338       ,output v-time
      339       ) .
      340     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      341   end.
      342   function cur-time-datetime returns datetime
      343   :
      344     define variable v-char as character no-undo .
      345     define variable v-datetime as datetime no-undo .
      346     v-char = cur-time-string().
      347     v-datetime = datetime(v-char).
      348     return  v-datetime.
      349   end.
      350   function cur-time-string-msec returns character
      351   :
      352     define variable v-date as datetime  no-undo .
      353     v-date = now.
      354     return string(v-date) .
      355   end.
      356   define variable v-date as date no-undo .
      357   define variable v-time as integer no-undo .
      358   define buffer buf_c-dis-time-rule for ub.c-dis-time-rule.
      359   define buffer buf_dis-time-rule  for ub.dis-time-rule.
      360   define buffer buf_dis-rule  for ub.dis-rule.
      361   define variable v-db-num like ub.db.db-num no-undo .
      362   main-block :
      363   do transaction
      364   on error undo main-block, return error
      365   :
      366     if not g#news
      367     and ub.dis-time-rule.time-rule-num <= 99999
      368       and ub.dis-time-rule.sts <> integer('1':U)
      369       and ub.dis-time-rule.time-rule-num < (13 + 50000) then do:
      370       message
      371       vss-workfile vss-revision vss-description skip
      372       "Нельзя удалять запись ШАБЛОНОВ РАСПИСАНИЙ СКИДОК"
      373       view-as alert-box error .
      374       undo main-block, return error .
      375     end.
      376     if not g#news then do:
      377       if can-find(first buf_dis-time-rule no-lock where
      378                         buf_dis-time-rule.upper-time-rule-num = ub.dis-time-rule.time-rule-num
      379                     AND buf_dis-time-rule.time-rule-num < (13 + 50000)
      380                         ) then do:
      381         message
      382         vss-workfile vss-revision vss-description skip
      383         "Нельзя удалять запись РАСПИСАНИЙ СКИДОК, если к ней привязана другая запись"
      384         view-as alert-box error .
      385         undo main-block, return error .
      386       end.
      387       if can-find(first buf_dis-rule no-lock where
      388                         buf_dis-rule.time-rule-num = ub.dis-time-rule.time-rule-num) then do:
      389         message
      390         vss-workfile vss-revision vss-description skip
      391         "Нельзя удалить запись РАСПИСАНИЙ СКИДОК, если к ней привязана запись ШАБЛОНА ПРАВИЛ СКИДОК"
      392         view-as alert-box error .
      393         undo main-block, return error .
      394       end.
      395     end.
      396     if ub.dis-time-rule.upper-time-rule-num <= 99999
      397     then do:
      398       run nws/cmd-del.p
      399         ( input "dis-time-rule":U
      400         ,input (buffer ub.dis-time-rule:handle)
      401         ,input "":U
      402         ) no-error .
      403       if error-status :error then do:
      404         return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      405       end.
      406     end.
      407     run cur-time in this-procedure(output v-date, output v-time).
      408     create buf_c-dis-time-rule.
      409     buffer-copy ub.dis-time-rule to buf_c-dis-time-rule
      410     assign
      411     buf_c-dis-time-rule.time-rule-num             = ub.dis-time-rule.time-rule-num
      412     buf_c-dis-time-rule.chip-num           = next-value (s-dc-chip, ub)
      413     buf_c-dis-time-rule.corr-time          = v-time
      414     buf_c-dis-time-rule.corr-user-db-num   = g#db-num
      415     buf_c-dis-time-rule.corr-user-name     = (if g#news
      416                                              then (chr(4) +  'СПН':U)
      417                                              else (if g#esys
      418                                                    then (chr(4) +  'ВС':U)
      419                                                    else g#userid)
      420                                              )
      421     buf_c-dis-time-rule.corr-date          = v-date
      422     buf_c-dis-time-rule.is-news            = g#news
      423     buf_c-dis-time-rule.action             = integer('99':U)
      424     .
      425       if g#oxml = yes
      426       then do:
      427       run str/calloxml.p (
      428             input 'delete':U
      429           , input 'dis-time-rule':U
      430           , input ( buffer ub.dis-time-rule:handle )
      431       ) no-error.
      432       if error-status :error
      433       then do:
      434           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      435                                , chr(10)
      436                                , vss-workfile
      437                                , return-value
      438                                , error-status :get-message ( 1 ) ).
      439       end.
      440       end.
      441   end.
