        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.dis-card-type.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление типа дисконтной карты".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                            , ub.dis-card-type.emitent-host-code
       30                            , ub.dis-card-type.type
       31                            , ub.dis-card-type.host-code
       32                           , ub.dis-card-type.obj-type
       33                           , ub.dis-card-type.obj-code
       34                            )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure cur-time :
       89      define output parameter p-today as date      no-undo .
       90      define output parameter p-time  as integer   no-undo .
       91     do
       92     on error undo, return error
       93     :
       94       define variable v-date1 as date      no-undo .
       95       define variable v-date2 as date      no-undo .
       96       define variable v-time  as integer   no-undo .
       97       assign
       98         v-date1 = today
       99         v-time  = time
      100         v-date2 = today
      101       .
      102       if v-date1 <> v-date2
      103       then do:
      104         assign
      105           v-date1 = today
      106           v-time  = v-time
      107         .
      108       end.
      109       assign
      110         p-today = v-date1
      111         p-time  = v-time
      112       .
      113     end.
      114   end.
      115   function cur-time-date returns character
      116   :
      117     return string(today, '99/99/9999':U) .
      118   end.
      119   function cur-time-mjd returns decimal
      120   :
      121     define variable v-date as date      no-undo .
      122     define variable v-time as integer   no-undo .
      123     run cur-time in this-procedure
      124       (output v-date
      125       ,output v-time
      126       ) .
      127     return integer(v-date) - 2400002 + (v-time / 86400) .
      128   end.
      129   function cur-time-get-ending-index returns integer
      130   (input p-number as integer
      131   )
      132   :
      133     if p-number < 0
      134     or p-number = ?
      135     then do:
      136       return 1 .
      137     end.
      138     define variable v-rest as integer   no-undo .
      139     assign
      140       p-number = p-number modulo 100
      141     .
      142     if p-number < 20
      143     then do:
      144       assign
      145         v-rest = p-number
      146       .
      147     end.
      148     else do:
      149       assign
      150         v-rest = p-number modulo 10
      151       .
      152     end.
      153     case v-rest :
      154       when 1
      155       then do:
      156         return 2 .
      157       end.
      158       when 2 or
      159       when 3 or
      160       when 4
      161       then do:
      162         return 3 .
      163       end.
      164       otherwise do:
      165         return 1 .
      166       end.
      167     end case .
      168   end.
      169   procedure cur-time-mjd-to-date :
      170      define input  parameter i-mjd-diff as decimal no-undo.
      171      define output parameter o-Date     as date    no-undo.
      172      define output parameter o-Time     as integer no-undo.
      173      define variable v-day-number as integer   no-undo .
      174      if    i-mjd-diff < 0
      175         or i-mjd-diff = ?
      176      then do:
      177         return "?" .
      178      end.
      179      assign
      180         v-day-number = truncate(i-mjd-diff,0).
      181         o-Date = date(v-day-number + 2400002).
      182         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184   end.
      185   function cur-time-mjd-to-string returns character
      186   (input p-mjd-diff as decimal
      187   )
      188   :
      189     define variable v-day-number as integer   no-undo .
      190     define variable v-seconds    as integer   no-undo .
      191     define variable v-hour       as integer   no-undo .
      192     define variable v-min        as integer   no-undo .
      193     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      194     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      195     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      196     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      197     if p-mjd-diff < 0
      198     or p-mjd-diff = ?
      199     then do:
      200       return "?" .
      201     end.
      202     assign
      203       v-day-number = integer(truncate(p-mjd-diff,0))
      204       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206     if v-seconds > 86400
      207     then do:
      208       assign
      209         v-seconds = 86400 - 1
      210       .
      211     end.
      212     if v-seconds < 0
      213     then do:
      214       assign
      215         v-seconds = 0
      216       .
      217     end.
      218     assign
      219       v-hour = truncate(v-seconds / 3600, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 3600
      223     .
      224     assign
      225       v-min = truncate(v-seconds / 60, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 60
      229     .
      230     return
      231         (if v-day-number <> 0
      232           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0
      236           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      240           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      241           else ""
      242         )
      243       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      244       .
      245   end.
      246   function cur-time-string returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      255   end.
      256   function cur-time-string-sec returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      265   end.
      266   function cur-time-custom  returns character
      267   (input p-prefix as character
      268   ,input p-date-format as character
      269   ,input p-delimiter as character
      270   ,input p-time-format as character
      271   ,input p-suffix as character
      272   )
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return
      281       p-prefix
      282       + string(v-date, p-date-format)
      283       + p-delimiter
      284       + string(v-time, p-time-format)
      285       + p-suffix
      286       .
      287   end.
      288   function cur-time-print  returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-datetime returns datetime
      299   :
      300     define variable v-char as character no-undo .
      301     define variable v-datetime as datetime no-undo .
      302     v-char = cur-time-string().
      303     v-datetime = datetime(v-char).
      304     return  v-datetime.
      305   end.
      306   function cur-time-string-msec returns character
      307   :
      308     define variable v-date as datetime  no-undo .
      309     v-date = now.
      310     return string(v-date) .
      311   end.
      312   define variable v-date as date    no-undo .
      313   define variable v-time as integer no-undo .
      314   define buffer buf_c-dis-card-type    for ub.c-dis-card-type.
      315   define buffer buf_hist-nws-option    for ub.hist-nws-option.
      316   define buffer buf_rule-call-param    for ub.rule-call-param.
      317   define buffer buf_rp-by-call         for ub.rp-by-call.
      318   define buffer buf_rule-by-call       for ub.rule-by-call.
      319   define buffer buf_Dis-card-type      for ub.dis-card-type.
      320   define buffer buf_dis-card-type-attr for ub.dis-card-type-attr.
      321   define buffer buf_dis-dct-rule       for ub.dis-dct-rule.
      322   define buffer buf_prop-ref-call      for ub.prop-ref-call.
      323   main-block:
      324   do
      325       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      326       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      327       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      328       :
      329       if not g#news
      330           and g#db-num <> 0 then
      331       do:
      332           message
      333               vss-workfile vss-revision vss-description skip
      334               "Запрещено удаление типа ДК в УБД"
      335               view-as alert-box error .
      336           undo main-block, return error .
      337       end.
      338       if ub.dis-card-type.host-code = 0
      339           and ub.dis-card-type.obj-code = 0
      340           and ub.dis-card-type.obj-type = '':U
      341           then
      342       do:
      343           FIND FIRST ub.dis-card No-LOCK WHERE
      344               ub.dis-card.type = ub.dis-card-type.type AND
      345               ub.dis-card.emitent-host-code = ub.dis-card-type.emitent-host-code NO-ERROR.
      346           if avail ub.dis-card then
      347           do:
      348               message "Для типа дисконтной карты имеются карты!" skip
      349                   "Удаление невозможно!" view-as alert-box ERROR.
      350               undo main-block, return error.
      351           end.
      352           find first buf_prop-ref-call no-lock where
      353               buf_prop-ref-call.call_id = ub.dis-card-type.uniq-key-rec no-error.
      354           if available buf_prop-ref-call then
      355           do:
      356               message "Для типа дисконтной карты имеются срезы/итоги!" skip
      357                   "Удаление невозможно!" view-as alert-box ERROR.
      358               undo main-block, return error.
      359           end.
      360           find first buf_dis-card-type-attr no-lock where
      361               buf_dis-card-type-attr.emitent-host-code = ub.dis-card-type.emitent-host-code
      362               and buf_dis-card-type-attr.type = ub.dis-card-type.type no-error.
      363           if available buf_dis-card-type-attr then
      364           do:
      365               message
      366                   vss-workfile vss-revision vss-description skip
      367                   "Имеются записи атрибутов типа ДК" skip
      368                   "Тип ДК" ub.dis-card-type.type "Эмитент" ub.dis-card-type.emitent-host-code
      369                   view-as alert-box error .
      370               undo main-block, return error .
      371           end.
      372           find first buf_dis-card-type no-lock where
      373               buf_dis-card-type.emitent-host-code = ub.dis-card-type.emitent-host-code
      374               and buf_dis-card-type.type = ub.dis-card-type.type
      375               and buf_dis-card-type.host-code > 0 no-error.
      376           if available buf_dis-card-type then
      377           do:
      378               message
      379                   vss-workfile vss-revision vss-description skip
      380                   "Имеются записи локальных (фирма или объект) настроек для типа ДК" skip
      381                   "Тип ДК" ub.dis-card-type.type "Эмитент" ub.dis-card-type.emitent-host-code
      382                   view-as alert-box error .
      383               undo main-block, return error .
      384           end.
      385           find first buf_hist-nws-option no-lock where
      386               buf_hist-nws-option.table-name = 'dis-card-type':U
      387               and buf_hist-nws-option.host-code = ub.dis-card-type.emitent-host-code
      388               AND buf_hist-nws-option.charkey_one = ub.dis-card-type.type no-error .
      389           if available buf_hist-nws-option then
      390           do:
      391               message
      392                   vss-workfile vss-revision vss-description skip
      393                   "Имеются записи опций маршрутизации и записи истории для типа ДК" skip
      394                   "Тип ДК" ub.dis-card-type.type "Эмитент" ub.dis-card-type.emitent-host-code
      395                   view-as alert-box error .
      396               undo main-block, return error .
      397           end.
      398           find first buf_rule-by-call no-lock where
      399               buf_rule-by-call.call_id = ub.dis-card-type.uniq-key-rec no-error.
      400           if available buf_rule-by-call then
      401           do:
      402               message
      403                   vss-workfile vss-revision vss-description skip
      404                   "Имеются привязки правил к типу ДК" skip
      405                   "Тип ДК" ub.dis-card-type.type "Эмитент" ub.dis-card-type.emitent-host-code
      406                   view-as alert-box error .
      407               undo main-block, return error .
      408           end.
      409           find first buf_rp-by-call no-lock where
      410               buf_rp-by-call.call_id = ub.dis-card-type.uniq-key-rec no-error.
      411           if available buf_rp-by-call then
      412           do:
      413               message
      414                   vss-workfile vss-revision vss-description skip
      415                   "Имеются привязки правил к профайлам правил для типа ДК" skip
      416                   "Тип ДК" ub.dis-card-type.type "Эмитент" ub.dis-card-type.emitent-host-code
      417                   view-as alert-box error .
      418               undo main-block, return error .
      419           end.
      420           find first buf_rule-call-param no-lock where
      421               buf_rule-call-param.call_id = ub.dis-card-type.uniq-key-rec no-error.
      422           if available buf_rule-call-param then
      423           do:
      424               message
      425                   vss-workfile vss-revision vss-description skip
      426                   "Имеются параметры вызова правил для типа ДК" skip
      427                   "Тип ДК" ub.dis-card-type.type "Эмитент" ub.dis-card-type.emitent-host-code
      428                   view-as alert-box error .
      429               undo main-block, return error .
      430           end.
      431       end.
      432       for each buf_dis-dct-rule  where
      433           buf_Dis-dct-rule.emitent-host-code = ub.dis-card-type.emitent-host-code
      434           and buf_Dis-dct-rule.type = ub.dis-card-type.type
      435           and buf_Dis-dct-rule.host-code = ub.dis-card-type.host-code
      436           and buf_Dis-dct-rule.obj-type = ub.dis-card-type.obj-type
      437           and buf_Dis-dct-rule.obj-code = ub.dis-card-type.obj-code
      438           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      439           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      440           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      441           :
      442           if buf_Dis-dct-rule.discnt-role = 'def-categ':U
      443               or buf_Dis-dct-rule.discnt-role = 'def-pcnt':U
      444               or buf_Dis-dct-rule.discnt-role = 'def-cash-pcnt':U then
      445           do:
      446               delete buf_Dis-dct-rule.
      447           end.
      448           else
      449           do:
      450               message
      451                   vss-workfile vss-revision vss-description skip
      452                   "Имеются скидки для ТИПА ДК" skip
      453                   "Тип ДК" ub.dis-card-type.type "Эмитент" ub.dis-card-type.emitent-host-code
      454                   "Фирма" ub.dis-card-type.host-code
      455                   "Объект" ub.dis-card-type.obj-type ub.dis-card-type.obj-code
      456                   "Объект"
      457                   "Тип скидки"  entry (lookup (buf_dis-dct-rule.discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u)
      458                   view-as alert-box error .
      459               undo main-block, return error .
      460           end.
      461       end.
      462       run cur-time in this-procedure(output v-date, output v-time).
      463       create buf_c-dis-card-type.
      464       buffer-copy ub.dis-card-type to buf_c-dis-card-type
      465           assign
      466           buf_c-dis-card-type.chip-num           = next-value (s-dc-chip, ub)
      467           buf_c-dis-card-type.corr-time          = v-time
      468           buf_c-dis-card-type.corr-user-db-num   = g#db-num
      469           buf_c-dis-card-type.corr-user-name     = g#userid
      470           buf_c-dis-card-type.corr-date          = v-date
      471           buf_c-dis-card-type.action = integer('99':U)
      472           buf_c-dis-card-type.subject = 'dis-card-type':U
      473           .
      474       if g#oxml = yes
      475           then
      476       do:
      477           run str/calloxml.p (
      478               input 'delete':U
      479               , input 'dis-card-type':U
      480               , input ( buffer ub.dis-card-type:handle )
      481               ) no-error.
      482           if error-status :error
      483               then
      484           do:
      485               undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      486                   , chr(10)
      487                   , vss-workfile
      488                   , return-value
      489                   , error-status :get-message ( 1 ) ).
      490           end.
      491       end.
      492       run trg/userlog.p (
      493           input 'delete':U
      494           , input 'dis-card-type':U
      495           , input ( buffer ub.dis-card-type :handle )
      496           , input ?
      497           , input ""
      498           ) no-error.
      499       if error-status :error
      500           then
      501       do:
      502           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      503               , chr(10)
      504               , vss-workfile
      505               , return-value
      506               , error-status :get-message ( 1 ) ).
      507       end.
      508   end.
