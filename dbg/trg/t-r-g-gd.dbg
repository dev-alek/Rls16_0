      432       buf_c-tax-rate-gds-grp.corr-user-db-num   = g#db-num
      433       buf_c-tax-rate-gds-grp.corr-user-name     = (if g#news
      434                                           then (chr(4) +  'СПН':U)
      435                                           else (if g#esys
      436                                                then (chr(4) +  'ВС':U)
      437                                                else g#userid)
      438                                           )
      439       buf_c-tax-rate-gds-grp.corr-date          = v-date
