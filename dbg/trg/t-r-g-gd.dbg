      452   define buffer buf_gds-grp for ub.gds-grp.
      453   main-block:
      454   do
      455   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      456   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      457   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      458   :
      459     if not g#news then do:
      460       run nws/cmd-del.p
      461         ( input "tax-rate-gds-grp":U
      462         ,input (buffer ub.tax-rate-gds-grp:handle)
      463         ,input "":U
      464         ) no-error .
      465       if error-status :error then do:
      466         undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      467       end.
      468     end.
      469     if not g#news then do:
      470       find first buf_gds-grp no-lock where
      471                 buf_gds-grp.node-code = ub.tax-rate-gds-grp.node-code no-error .
      472       if available buf_gds-grp then
      473       run gds-grph_write-tax-rate-gds-grp-proc   in this-procedure (
      474                                                         buffer ub.tax-rate-gds-grp
      475                                                         ,integer('99':U)
      476                                                         ,"":U
      477                                                         ,"":U
      478                                                         ).
      479     end.
      480       if g#oxml = yes
      481       then do:
      482       run str/calloxml.p (
      483             input 'delete':U
      484           , input 'tax-rate-gds-grp':U
      485           , input ( buffer ub.tax-rate-gds-grp:handle )
      486       ) no-error.
      487       if error-status :error
      488       then do:
      489           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      490                                , chr(10)
      491                                , vss-workfile
      492                                , return-value
      493                                , error-status :get-message ( 1 ) ).
      494       end.
      495       end.
      496   end.
