      380       buf_c-gds-grp-obj.host-code          = buf_gds-grp-obj.host-code
      381       buf_c-gds-grp-obj.obj-type           = buf_gds-grp-obj.obj-type
      382       buf_c-gds-grp-obj.obj-code           = buf_gds-grp-obj.obj-code
      383       buf_c-gds-grp-obj.chip-num           = next-value (s-gds-grp-chip, ub)
      384       buf_c-gds-grp-obj.corr-time          = v-time
      385       buf_c-gds-grp-obj.corr-user-db-num   = g#db-num
      386       buf_c-gds-grp-obj.corr-user-name     = (if g#news
      387                                           then (chr(4) +  'СПН':U)
      388                                           else (if g#esys
      389                                                then (chr(4) +  'ВС':U)
      390                                                else g#userid)
      391                                           )
      392       buf_c-gds-grp-obj.corr-date          = v-date
      393       .
      394       create buf_c-gds-grp-hist.
      395       buffer-copy buf_c-gds-grp-obj to buf_c-gds-grp-hist
      396       assign
      397       buf_c-gds-grp-hist.action =  p-action
      398       buf_c-gds-grp-hist.subject = 'gds-grp-obj':U
      399       buf_c-gds-grp-hist.is-news = g#news
      400       buf_c-gds-grp-hist.source-type = p-source-type
      401       buf_c-gds-grp-hist.source-ref = p-source-ref
      402       .
      403     end.
      404   end procedure.
      405   procedure gds-grph_write-tax-rate-gds-grp-proc  :
      406   define parameter buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp .
      407   define input parameter p-action as integer no-undo .
      408   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      409   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      410   define variable v-date as date      no-undo.
      411   define variable v-time  as integer   no-undo.
      412   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
