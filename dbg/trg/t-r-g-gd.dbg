      426       buf_c-tax-rate-gds-grp.tax-code           = buf_tax-rate-gds-grp.tax-code
      427       buf_c-tax-rate-gds-grp.host-code          = buf_tax-rate-gds-grp.host-code
      428       buf_c-tax-rate-gds-grp.obj-type           = buf_tax-rate-gds-grp.obj-type
      429       buf_c-tax-rate-gds-grp.obj-code           = buf_tax-rate-gds-grp.obj-code
      430       buf_c-tax-rate-gds-grp.chip-num           = next-value (s-gds-grp-chip, ub)
