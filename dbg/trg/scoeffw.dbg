        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.s-coeff OLD oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись s-coeff".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5',ub.s-coeff.gds-code,ub.s-coeff.host-code,ub.s-coeff.obj-type,ub.s-coeff.obj-code,ub.s-coeff.s-date)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   define new global shared variable g#lib-nws as handle no-undo .
      308   define variable v-date as date no-undo .
      309   define variable v-time as integer no-undo .
      310   define variable v-host-code like ub.sysconf.host-code no-undo .
      311   define buffer buf_clients for ub.clients.
      312   define buffer buf_s-coeff for ub.s-coeff.
      313   define buffer buf_c-s-coeff for ub.c-s-coeff.
      314   define buffer buf_c-gds-hist for ub.c-gds-hist.
      315   main-block:
      316   do
      317   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) )
      318   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      319   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      320   :
      321     if g#news
      322     and g#db-num  = 0
      323     AND not new(ub.s-coeff)
      324     AND
      325     (ub.s-coeff.host-code = 0
      326     or ub.s-coeff.obj-type = "":U
      327     or ub.s-coeff.obj-code = 0)
      328     then do:
      329       assign
      330       ub.s-coeff.coeff-value = oldb.coeff-value
      331       .
      332     end.
      333     if not g#news then do:
      334       if g#db-num <> 0 and
      335       (ub.s-coeff.host-code = 0
      336       or ub.s-coeff.obj-type = "":U
      337       or ub.s-coeff.obj-code = 0
      338       )
      339       AND ub.s-coeff.coeff-value <> 0
      340       then do:
      341         if ub.s-coeff.host-code = 0 then do:
      342           message
      343           vss-workfile vss-revision vss-description skip
      344           "Нельзя создавать/изменять глобальные записи сезонных коэффицентов" skip
      345           "в удаленной БД" skip
      346           "товар" ub.s-coeff.gds-code
      347           view-as alert-box error .
      348         end.
      349         else do:
      350           message
      351           vss-workfile vss-revision vss-description skip
      352           "Нельзя создавать/изменять записи сезонных коэффицентов для фирмы" skip
      353           "в удаленной БД" skip
      354           "товар" ub.s-coeff.gds-code
      355           view-as alert-box error .
      356         end.
      357         undo main-block, return error.
      358       end.
      359       if ub.s-coeff.obj-type <> "":U
      360       or ub.s-coeff.obj-code <> 0 then do:
      361         find first buf_clients no-lock where
      362                   buf_clients.obj-type = ub.s-coeff.obj-type
      363               AND buf_clients.obj-code = ub.s-coeff.obj-code.
      364         if buf_clients.db-num <> g#db-num then do:
      365           message
      366           vss-workfile vss-revision vss-description skip
      367           "Нельзя изменять запись сезонного коэффициента для товара на объекте," skip
      368           "принадлежащем другой БД" skip
      369           "товар" ub.s-coeff.gds-code skip
      370           ub.s-coeff.obj-type ub.s-coeff.obj-code
      371           view-as alert-box .
      372           undo  main-block, return error.
      373         end.
      374       end.
      375       if (ub.s-coeff.s-date <> 01/01/1996
      376       OR ub.s-coeff.host-code <> 0
      377       OR ub.s-coeff.obj-type <> "":U
      378       OR ub.s-coeff.obj-code <> 0)
      379       AND
      380       not can-find (first buf_s-coeff where
      381                             buf_s-coeff.gds-code = ub.s-coeff.gds-code
      382                         AND buf_s-coeff.s-date = 01/01/1996
      383                         AND buf_s-coeff.host-code = 0
      384                         AND buf_s-coeff.obj-type = "":U
      385                         AND buf_s-coeff.obj-code = 0)
      386       then do:
      387         message
      388         vss-workfile vss-revision vss-description skip
      389         "Отсутствует корневая запись сезонного коэффициента на товар" ub.s-coeff.gds-code
      390         view-as alert-box error .
      391         undo main-block, return error.
      392       end.
      393     end.
      394     find first buf_s-coeff no-lock where
      395                buf_s-coeff.gds-code = ub.s-coeff.gds-code
      396            AND buf_s-coeff.host-code = ub.s-coeff.host-code
      397            AND buf_s-coeff.obj-type = ub.s-coeff.obj-type
      398            AND buf_s-coeff.obj-code = ub.s-coeff.obj-code
      399            AND buf_s-coeff.s-date = ub.s-coeff.s-date
      400            AND recid(buf_s-coeff) <> recid(ub.s-coeff)
      401            no-error .
      402     if available buf_s-coeff then do:
      403       message
      404       "Товар"  ub.s-coeff.gds-code skip
      405       "Уже есть сезонный коэффициент товара"
      406       "товар" ub.s-coeff.gds-code skip
      407       "фирма" ub.s-coeff.host-code "объект" ub.s-coeff.obj-type ub.s-coeff.obj-code "дата" ub.s-coeff.s-date
      408       view-as alert-box error .
      409       undo main-block, return error .
      410     end.
      411     run str/callnews.p
      412       ( input "s-coeff"
      413        ,input (buffer ub.s-coeff:handle)
      414       ) no-error .
      415     if error-status:error then undo main-block, return error return-value .
      416     run cur-time in this-procedure(output v-date, output v-time).
      417     if ub.s-coeff.host-code = 0
      418     and not (ub.s-coeff.obj-type = "":U and ub.s-coeff.obj-code = 0)
      419     then do:
      420   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      422     (input  ub.s-coeff.obj-type
      423     ,input  ub.s-coeff.obj-code
      424     ,output v-host-code
      425     )  .
      426     end.
      427     else do:
      428       assign
      429       v-host-code = ub.s-coeff.host-code
      430       .
      431     end.
      432     if g#news then do:
      433       define variable v-send as integer no-undo .
      434       v-send = integer('0':U).
      435   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      436   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      437     (input  g#db-num
      438     ,input  's-coeff':U
      439     ,input  0
      440     ,input  '':U
      441     ,input  0
      442     ,input  '':U
      443     ,input  '':U
      444     ,input  '':U
      445     ,input  0
      446     ,input  0
      447     ,input  0
      448     ,input  'nws-to-hist'
      449     ,output v-send
      450     ) no-error .
      451     end.
      452     if not g#news
      453     or v-send >= 0 then do:
      454       create buf_c-s-coeff.
      455       buffer-copy oldb to buf_c-s-coeff
      456       assign
      457       buf_c-s-coeff.gds-code           = ub.s-coeff.gds-code
      458       buf_c-s-coeff.obj-type           = ub.s-coeff.obj-type
      459       buf_c-s-coeff.obj-code           = ub.s-coeff.obj-code
      460       buf_c-s-coeff.host-code          = v-host-code
      461       buf_c-s-coeff.s-date             = ub.s-coeff.s-date
      462       buf_c-s-coeff.chip-num           = next-value (s-gds-chip, ub)
      463       buf_c-s-coeff.corr-time          = v-time
      464       buf_c-s-coeff.corr-user-db-num   = g#db-num
      465       buf_c-s-coeff.corr-user-name     = (if g#news
      466                                        then (chr(4) +  'СПН':U)
      467                                        else (if g#esys
      468                                              then (chr(4) +  'ВС':U)
      469                                              else g#userid)
      470                                       )
      471       buf_c-s-coeff.corr-date          = v-date
      472       .
      473       create buf_c-gds-hist.
      474       buffer-copy buf_c-s-coeff to buf_c-gds-hist
      475       assign
      476       buf_c-gds-hist.action = (if new ub.s-coeff then integer('1':U) else integer('2':U))
      477       buf_c-gds-hist.subject = 's-coeff':U
      478       buf_c-gds-hist.host-code = v-host-code
      479       buf_c-gds-hist.is-news = g#news
      480       buf_c-gds-hist.source-type = (if g#news
      481                                     then 'db':U
      482                                     else (if g#esys
      483                                           then 'esys':U
      484                                           else "":U)
      485                                     )
      486       buf_c-gds-hist.source-ref = (if g#news
      487                                     then string(g#news-source-db)
      488                                     else (if g#esys
      489                                           then string(g#esys-source-esys)
      490                                           else "":U)
      491                                     )
      492       .
      493     end.
      494       if g#oxml = yes
      495       then do:
      496       run str/calloxml.p (
      497             input 'update':U
      498           , input 's-coeff':U
      499           , input ( buffer ub.s-coeff:handle )
      500       ) no-error.
      501       if error-status :error
      502       then do:
      503           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      504                                , chr(10)
      505                                , vss-workfile
      506                                , return-value
      507                                , error-status :get-message ( 1 ) ).
      508       end.
      509       end.
      510   end.
