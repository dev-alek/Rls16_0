        1   block-level on error undo, throw.
        2   define input parameter v-wth-doc-doc-code like ub.wth-doc.doc-code no-undo .
        3   define input parameter p-check-inv        as logical no-undo .
        4   define input parameter p-document-fact-order like ub.wth-doc.fact-order no-undo .
        5   define input parameter p-fact-close       as logical no-undo .
        6   define input parameter p-is-news          as logical no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Блокировка МЦ по документу".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define temp-table temp-wth-pl no-undo
       74     field w-p-code like ub.wth-place.w-p-code
       75     index xpk is primary w-p-code
       76   .
       77   define buffer buf_wth-doc  for ub.wth-doc .
       78   define buffer buf_wth-line for ub.wth-line .
       79   define buffer buf_wth-obj  for ub.wth-obj .
       80   define buffer buf_wealth   for ub.wealth .
       81   define buffer inv_wth-line for ub.wth-line .
       82   define buffer inv_wth-doc  for ub.wth-doc .
       83   define variable l-reserv-pl-code         as logical no-undo .
       84   define variable num_rec       as integer   no-undo initial 0 .
       85   define variable start_time    as integer   no-undo .
       86   define variable curr_time     as integer   no-undo .
       87   main-block:
       88   do transaction
       89   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       90   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       91   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       92   :
       93     find first buf_wth-doc no-lock
       94       where buf_wth-doc.doc-code = v-wth-doc-doc-code
       95       no-error .
       96     if not available buf_wth-doc then do:
       97       message
       98         vss-workfile vss-revision vss-description skip
       99         "Ошибка задания входных параметров" skip
      100         "Не найден документ" skip
      101         "Документ" v-wth-doc-doc-code skip
      102         view-as alert-box error .
      103       undo main-block, return error .
      104     end.
      105     if p-document-fact-order = ? then do:
      106       message
      107         vss-workfile vss-revision vss-description skip
      108         "Ошибка задания входных параметров" skip
      109         "Документ" v-wth-doc-doc-code skip
      110         "Логический номер закрываемого документа" p-document-fact-order skip
      111         view-as alert-box error .
      112       undo main-block, return error .
      113     end.
      114     def frame a
      115       "Блокировка МЦ на объекте." skip
      116       num_rec           format ">>>>>>>9"   label "Обработано МЦ" skip
      117       buf_wth-line.wth-code format ">>>>>>>>9"      label "Текущая МЦ" skip
      118       curr_time         format "->>>>>>>>9" label "Время" skip
      119       with view-as dialog-box side-labels three-d
      120       title "Документ " + v-wth-doc-doc-code .
      121     assign
      122       start_time = time
      123     .
      124     view frame a.
      125     for each buf_wth-line no-lock
      126       where buf_wth-line.doc-code = v-wth-doc-doc-code
      127       break by
      128       buf_wth-line.wth-code
      129     on error undo main-block, return error
      130     :
      131       find first buf_wealth no-lock
      132         where buf_wealth.wth-code = buf_wth-line.wth-code
      133         no-error .
      134       if error-status :error then do:
      135         message
      136           vss-workfile vss-revision vss-description skip
      137           "Не найдена МЦ" skip
      138           "Документ" buf_wth-line.doc-code skip
      139           "Код МЦ" buf_wealth.wth-code skip
      140           error-status :get-message(1) skip
      141           return-value skip
      142           view-as alert-box error .
      143         undo main-block, return error .
      144       end.
      145       assign
      146         num_rec   = num_rec + 1
      147       .
      148       if num_rec mod 10 = 0 then do:
      149         assign
      150           curr_time = time - start_time
      151         .
      152         display
      153           num_rec buf_wth-line.wth-code curr_time
      154           with frame a.
      155         process events .
      156       end.
      157   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      158   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthobjcr in g#library
      159     (input  buf_wth-line.obj-type
      160     ,input  buf_wth-line.obj-code
      161     ,input  buf_wth-line.wth-code
      162     ,buffer buf_wth-obj
      163     ) no-error .
      164       if error-status :error then do:
      165         message
      166           vss-workfile vss-revision vss-description skip
      167           "Невозможно найти wth-obj" skip
      168           error-status :get-message(1) skip
      169           return-value skip
      170           view-as alert-box error .
      171         undo main-block, return error .
      172       end.
      173           DEFINE VARIABLE my-rec as recid no-undo .
      174       my-rec = recid(buf_wth-obj).
      175       find first buf_wth-obj exclusive-lock where
      176                 recid(buf_wth-obj) = my-rec.
      177       release buf_wth-obj .
      178   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthcheck in g#library
      180     (input buf_wth-line.obj-type
      181     ,input buf_wth-line.obj-code
      182     ,input buf_wth-line.wth-code
      183     ,input ''
      184     ) no-error .
      185       if error-status :error then do:
      186         message
      187           vss-workfile vss-revision vss-description skip
      188           "Ошибка при проверке целостности товара" skip
      189           "Объект" buf_wth-line.obj-type buf_wth-line.obj-code skip
      190           "Код МЦ" buf_wth-line.wth-code skip
      191           error-status :get-message(1) skip
      192           view-as alert-box .
      193         undo main-block, return error .
      194       end.
      195       if  p-fact-close = true
      196       and p-is-news    = false
      197       and buf_wth-doc.ext-doc-type <> 'dc':U
      198       then do:
      199         if first-of(buf_wth-line.wth-code) then do:
      200           for each temp-wth-pl
      201           on error undo main-block, return error
      202           :
      203             delete temp-wth-pl .
      204           end.
      205         end.
      206           find first temp-wth-pl
      207             where temp-wth-pl.w-p-code = buf_wth-line.w-p-code
      208             no-error .
      209           if not available temp-wth-pl then do:
      210             create temp-wth-pl .
      211             assign
      212               temp-wth-pl.w-p-code = buf_wth-line.w-p-code
      213             .
      214           end.
      215           if buf_wth-doc.inter_ then do:
      216             find first temp-wth-pl
      217               where temp-wth-pl.w-p-code = buf_wth-line.out-code
      218               no-error .
      219             if not available temp-wth-pl then do:
      220               create temp-wth-pl .
      221               assign
      222                 temp-wth-pl.w-p-code = buf_wth-line.out-code
      223               .
      224              end.
      225            end.
      226             if last-of(buf_wth-line.wth-code) then do:
      227               for each temp-wth-pl
      228               on error undo main-block, return error
      229               :
      230                 run trg/lockplgw.p
      231                   (input buf_wth-line.obj-type
      232                   ,input buf_wth-line.obj-code
      233                   ,input buf_wealth.wth-code
      234                   ,input temp-wth-pl.w-p-code
      235                   ,input "check-doc-on=false"
      236                   ,input ""
      237                   ) no-error .
      238                 if error-status :error then do:
      239                   message
      240                     vss-workfile vss-revision vss-description skip
      241                     "МЦ заблокирована на МХ" skip
      242                     "Объект" buf_wth-line.obj-type buf_wth-line.obj-code skip
      243                     "МХ" temp-wth-pl.w-p-code skip
      244                     "Код МЦ" buf_wealth.wth-code skip
      245                     error-status :get-message(1) skip
      246                     return-value skip
      247                     view-as alert-box error .
      248                   undo main-block, return error .
      249                 end.
      250               end.
      251             end.
      252       end.
      253       if p-check-inv then do:
      254         define variable l-inv-on as logical no-undo .
      255   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run wthobjat in g#library
      257     (input  buf_wth-line.obj-type
      258     ,input  buf_wth-line.obj-code
      259     ,input  buf_wth-line.wth-code
      260     ,input  'inv-on=request'
      261     ,output l-inv-on
      262     ) no-error .
      263         if error-status :error then do:
      264           message
      265             vss-workfile vss-revision vss-description skip
      266             "Ошибка получения признака МЦ на объекте" skip
      267             error-status :get-message(1) skip
      268             return-value skip
      269             view-as alert-box error .
      270           undo main-block, return no-apply .
      271         end.
      272         if l-inv-on then do:
      273           for each inv_wth-line no-lock
      274             where inv_wth-line.obj-type  = buf_wth-line.obj-type
      275               and inv_wth-line.obj-code  = buf_wth-line.obj-code
      276               and inv_wth-line.wth-code  = buf_wth-line.wth-code
      277               and inv_wth-line.status_   = 'разрешен':U
      278           ,first inv_wth-doc no-lock
      279             where inv_wth-doc.doc-code = inv_wth-line.doc-code
      280               and inv_wth-doc.doc-type = 'инв':U
      281               and inv_wth-doc.status_  = 'разрешен':U
      282           on error undo main-block, return error
      283           :
      284             message
      285               "МЦ :" buf_wealth.wth-code skip
      286               buf_wealth.wth-name skip
      287               "на объекте" inv_wth-line.obj-type inv_wth-line.obj-code skip
      288               "сейчас в инвентаризации (Документ №" inv_wth-line.doc-code ")." skip
      289               view-as alert-box information .
      290             undo main-block, return error .
      291           end.
      292           message
      293             "МЦ :" buf_wth-line.wth-code skip
      294             "на объекте" buf_wth-line.obj-type buf_wth-line.obj-code skip
      295             "Отмечен, как принадлежащий инвентризации" skip
      296             "Документ инвентаризации не найден" skip
      297             view-as alert-box information .
      298           undo main-block, return error .
      299         end.
      300       end.
      301       if false  then do:
      302         for each inv_wth-line no-lock
      303           where inv_wth-line.obj-type     = buf_wth-line.obj-type
      304             and inv_wth-line.obj-code     = buf_wth-line.obj-code
      305             and inv_wth-line.wth-code     = buf_wth-line.wth-code
      306             and inv_wth-line.ext-doc-type = 'iy':U
      307             and inv_wth-line.status_      = 'разрешен':U
      308             and inv_wth-line.doc-code     <> v-wth-doc-doc-code
      309         ,first ub.wth-doc no-lock
      310           where ub.wth-doc.doc-code       = inv_wth-line.doc-code
      311         on error undo main-block, return error
      312         :
      313           message
      314             "На объекте" inv_wth-line.obj-type inv_wth-line.obj-code skip
      315             "существует инвентаризация (Документ №" inv_wth-line.doc-code ") по МЦ" skip
      316             buf_wealth.wth-code skip
      317             buf_wealth.wth-name skip
      318             "Находящаяся в статусе '" STRING(ub.wth-doc.status_) "'." skip
      319             view-as alert-box information .
      320           undo main-block, return error .
      321         end.
      322       end.
      323       if p-document-fact-order <> 0 then do:
      324         for each inv_wth-line no-lock
      325           where inv_wth-line.obj-type     = buf_wth-line.obj-type
      326             and inv_wth-line.obj-code     = buf_wth-line.obj-code
      327             and inv_wth-line.wth-code     = buf_wth-line.wth-code
      328             and inv_wth-line.ext-doc-type = 'iy':U
      329             and inv_wth-line.status_      = 'факт':U
      330             and inv_wth-line.fact-order   > p-document-fact-order
      331         on error undo main-block, return error
      332         :
      333           message
      334             "На объекте" inv_wth-line.obj-type inv_wth-line.obj-code skip
      335             "существует инвентаризация (Документ №" inv_wth-line.doc-code ") по МЦ" skip
      336             buf_wealth.wth-code skip
      337             buf_wealth.wth-name skip
      338             "с большим логическим номером " inv_wth-line.fact-order "." skip
      339             "Невозможно закрыть документ с логическим номером" p-document-fact-order "." skip
      340             view-as alert-box information .
      341           undo main-block, return error .
      342         end.
      343       end.
      344     end.
      345   end.
