        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.c-variant-delivery.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись в таблице ИСТОРИЯ ВАРИАНТОВ ДОСТАВКИ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6', ub.c-variant-delivery.deliv-type-code,
       29                                                 ub.c-variant-delivery.deliv-subj-code,
       30                                                 ub.c-variant-delivery.obj-type,
       31                                                 ub.c-variant-delivery.obj-code,
       32                                                 ub.c-variant-delivery.corr-user-db-num,
       33                                                 ub.c-variant-delivery.chip-num
       34                                                 )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define buffer buf_delivery-type for ub.delivery-type.
       88   define buffer buf_delivery-subject for ub.delivery-subject.
       89   define buffer buf_clients for ub.clients.
       90   define buffer buf_variant-delivery for ub.variant-delivery.
       91   main-block:
       92   do
       93   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       94   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       95   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       96   :
       97     if not g#news then do:
       98       find first buf_delivery-type no-lock where
       99                  buf_delivery-type.deliv-type-code = c-variant-delivery.deliv-type-code  no-error .
      100       if not available buf_delivery-type then do:
      101         message
      102         vss-workfile vss-revision vss-description skip
      103         "Неправильная ссылка на ТИП ДОСТАВКИ" skip
      104         "код" c-variant-delivery.deliv-type-code skip
      105          view-as alert-box error .
      106         undo main-block, return error.
      107       end.
      108       find first buf_delivery-subject no-lock where
      109                  buf_delivery-subject.deliv-subj-code = c-variant-delivery.deliv-subj-code  no-error .
      110       if not available buf_delivery-subject then do:
      111         message
      112         vss-workfile vss-revision vss-description skip
      113         "Неправильная ссылка на СУБЪЕКТ ДОСТАВКИ" skip
      114         "код" c-variant-delivery.deliv-subj-code skip
      115          view-as alert-box error .
      116         undo main-block, return error.
      117       end.
      118       find first buf_clients no-lock where
      119                  buf_clients.obj-type = c-variant-delivery.obj-type
      120              AND buf_clients.obj-code = c-variant-delivery.obj-code
      121                  no-error .
      122       if not available buf_clients then do:
      123         message
      124         vss-workfile vss-revision vss-description skip
      125         "Неправильная ссылка на ОБЪЕКТ ДОСТАВКИ" skip
      126         "тип" c-variant-delivery.obj-type    skip
      127         "код" c-variant-delivery.obj-code   skip
      128          view-as alert-box error .
      129         undo main-block, return error.
      130       end.
      131       find first buf_variant-delivery no-lock where
      132                  buf_variant-delivery.deliv-type-code = c-variant-delivery.deliv-type-code
      133              AND buf_variant-delivery.deliv-subj-code = c-variant-delivery.deliv-subj-code
      134              AND buf_variant-delivery.obj-type        = c-variant-delivery.obj-type
      135              AND buf_variant-delivery.obj-code        = c-variant-delivery.obj-code
      136                  no-error .
      137       if not available buf_variant-delivery then do:
      138         message
      139         vss-workfile vss-revision vss-description skip
      140         "Неправильная ссылка на ВАРИАНТ ДОСТАВКИ" skip
      141         "код типа доставки" c-variant-delivery.deliv-type-code skip
      142         "код субъекта доставки" c-variant-delivery.deliv-subj-code skip
      143         "тип объекта доставки" c-variant-delivery.obj-type    skip
      144         "код объекта доставки" c-variant-delivery.obj-code   skip
      145          view-as alert-box error .
      146         undo main-block, return error.
      147       end.
      148     end.
      149     if not g#news then do:
      150       if ( g#db-num > 0 ) then do:
      151         message
      152         vss-workfile vss-revision vss-description skip
      153         "Нельзя создавать записи истории ВАРИАНТА ДОСТАВКИ в УБД" skip
      154         view-as alert-box error .
      155         undo main-block, return error.
      156       end.
      157     end.
      158     run str/callnews.p
      159       (input 'c-variant-delivery':U
      160     ,input (buffer ub.c-variant-delivery:handle)
      161     ).
      162       if g#oxml = yes
      163       then do:
      164       run str/calloxml.p (
      165             input 'update':U
      166           , input 'c-variant-delivery':U
      167           , input ( buffer ub.c-variant-delivery:handle )
      168       ) no-error.
      169       if error-status :error
      170       then do:
      171           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      172                                , chr(10)
      173                                , vss-workfile
      174                                , return-value
      175                                , error-status :get-message ( 1 ) ).
      176       end.
      177       end.
      178   end.
