        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.esys-route OLD BUFFER old-esys-route .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись маршрутизации во внешней системы.".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure esallatr-name :
       80   do
       81     on error undo, return error
       82     :
       83     define input  parameter p-code           as character no-undo .
       84     define output parameter p-type           as character no-undo .
       85     define output parameter p-format         as character no-undo .
       86     define output parameter p-label          as character no-undo .
       87     define output parameter p-user-can-edit  as logical   no-undo .
       88     define output parameter p-output-display as logical   no-undo .
       89     define output parameter p-other          as character no-undo .
       90       case p-code :
       91               when 'custom-pack-name':U then do:     assign     p-label = "Имя файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Имя файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       92               when 'route-custom-pack-name':U then do:     assign     p-label = "Иям файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Иям файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       93         otherwise do:
       94           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
       95         end.
       96       end.
       97     end.
       98   end procedure.
       99   procedure esallatr-tooltip :
      100   do
      101     on error undo, return error
      102     :
      103       define input  parameter p-code    as character no-undo .
      104       define output parameter p-tooltip as character no-undo .
      105       define output parameter p-label   as character no-undo .
      106       case p-code :
      107               when 'custom-pack-name':U then do:     assign     p-tooltip = "Имя файла в ВС"     p-label = "Имя файла в ВС" .   end.
      108               when 'route-custom-pack-name':U then do:     assign     p-tooltip = "Имя файла в ВС"     p-label = "Иям файла в ВС" .   end.
      109         otherwise do:
      110           undo, return error substitute("Неизвестный атрибут ВС &1", p-code) .
      111         end.
      112       end.
      113     end.
      114   end procedure.
      115   procedure esallatr-value :
      116   do
      117     on error undo, return error
      118     :
      119     define input  parameter p-table-name as character no-undo .
      120     define input  parameter p-key1     as int64 no-undo .
      121     define input  parameter p-key2     as int64 no-undo .
      122     define input  parameter p-key3     as character no-undo .
      123     define input  parameter p-key4     as character no-undo .
      124     define input  parameter p-key5     as int64 no-undo .
      125     define input  parameter p-key6     as int64 no-undo .
      126     define input  parameter p-key7     as character no-undo .
      127     define input  parameter p-key8     as character no-undo .
      128     define input  parameter p-code     as character no-undo .
      129     define output parameter p-value    as character no-undo .
      130     define output parameter p-type     as character no-undo .
      131     define buffer buf_esys-all-attr for ub.esys-all-attr.
      132     define variable v-format         as character no-undo .
      133     define variable v-label          as character no-undo .
      134     define variable v-user-can-edit  as logical   no-undo .
      135     define variable v-output-display as logical   no-undo .
      136     define variable v-other          as character no-undo .
      137       run esallatr-name in this-procedure
      138         (input  p-code
      139         ,output p-type
      140         ,output v-format
      141         ,output v-label
      142         ,output v-user-can-edit
      143         ,output v-output-display
      144         ,output v-other
      145         ) no-error .
      146       if error-status :error then do:
      147         undo, return error return-value .
      148       end.
      149       Find first  buf_esys-all-attr no-lock where
      150                   buf_esys-all-attr.attr-code = p-code
      151              and  buf_esys-all-attr.table-name  = p-table-name
      152              and  buf_esys-all-attr.key1  = p-key1
      153              and  buf_esys-all-attr.key2  = p-key2
      154              and  buf_esys-all-attr.key3  = p-key3
      155              and  buf_esys-all-attr.key4  = p-key4
      156              and  buf_esys-all-attr.key5  = p-key5
      157              and  buf_esys-all-attr.key6  = p-key6
      158              and  buf_esys-all-attr.key7  = p-key7
      159              and  buf_esys-all-attr.key8  = p-key8  no-error .
      160      if avail buf_esys-all-attr then do:
      161       assign
      162       p-value = buf_esys-all-attr.attr-value.
      163      end.
      164      else do:
      165       assign
      166       p-value = if p-type = 'L':U then "no":U else "".
      167      end.
      168   end.
      169   end procedure.
      170   procedure esallatr-write :
      171     do
      172     on error undo, return error
      173     :
      174       define input  parameter p-table-name as character no-undo .
      175       define input  parameter p-key1     as int64 no-undo .
      176       define input  parameter p-key2     as int64 no-undo .
      177       define input  parameter p-key3     as character no-undo .
      178       define input  parameter p-key4     as character no-undo .
      179       define input  parameter p-key5     as int64 no-undo .
      180       define input  parameter p-key6     as int64 no-undo .
      181       define input  parameter p-key7     as character no-undo .
      182       define input  parameter p-key8     as character no-undo .
      183       define input  parameter p-code     as character no-undo .
      184       define input  parameter p-value    like ub.esys-all-attr.attr-value no-undo .
      185       define buffer buf_esys-all-attr for ub.esys-all-attr .
      186       define variable v-type           as character no-undo .
      187       define variable v-format         as character no-undo .
      188       define variable v-label          as character no-undo .
      189       define variable v-user-can-edit  as logical   no-undo .
      190       define variable v-output-display as logical   no-undo .
      191       define variable v-other          as character no-undo .
      192       run esallatr-name in this-procedure
      193         (input  p-code
      194         ,output v-type
      195         ,output v-format
      196         ,output v-label
      197         ,output v-user-can-edit
      198         ,output v-output-display
      199         ,output v-other
      200         ) no-error .
      201       if error-status :error then do:
      202         undo, return error return-value .
      203       end.
      204       Find first  buf_esys-all-attr exclusive-lock where
      205                   buf_esys-all-attr.attr-code = p-code
      206              and  buf_esys-all-attr.table-name  = p-table-name
      207              and  buf_esys-all-attr.key1  = p-key1
      208              and  buf_esys-all-attr.key2  = p-key2
      209              and  buf_esys-all-attr.key3  = p-key3
      210              and  buf_esys-all-attr.key4  = p-key4
      211              and  buf_esys-all-attr.key5  = p-key5
      212              and  buf_esys-all-attr.key6  = p-key6
      213              and  buf_esys-all-attr.key7  = p-key7
      214              and  buf_esys-all-attr.key8  = p-key8  no-error .
      215       if not available buf_esys-all-attr then do:
      216         assign
      217         buf_esys-all-attr.attr-code = p-code
      218         buf_esys-all-attr.table-name  = p-table-name
      219         buf_esys-all-attr.key1  = p-key1
      220         buf_esys-all-attr.key2  = p-key2
      221         buf_esys-all-attr.key3  = p-key3
      222         buf_esys-all-attr.key4  = p-key4
      223         buf_esys-all-attr.key5  = p-key5
      224         buf_esys-all-attr.key6  = p-key6
      225         buf_esys-all-attr.key7  = p-key7
      226         buf_esys-all-attr.key8  = p-key8
      227         buf_esys-all-attr.attr-value = p-value
      228         no-error.
      229       end.
      230       ELSE
      231       assign
      232       buf_esys-all-attr.attr-value = p-value no-error
      233       .
      234     end.
      235   end procedure.
      236   procedure esallatr-exist :
      237     do
      238     on error undo, return error
      239     :
      240       define input  parameter p-table-name as character no-undo .
      241       define input  parameter p-key1     as int64 no-undo .
      242       define input  parameter p-key2     as int64 no-undo .
      243       define input  parameter p-key3     as character no-undo .
      244       define input  parameter p-key4     as character no-undo .
      245       define input  parameter p-key5     as int64 no-undo .
      246       define input  parameter p-key6     as int64 no-undo .
      247       define input  parameter p-key7     as character no-undo .
      248       define input  parameter p-key8     as character no-undo .
      249       define input  parameter p-code     like ub.esys-all-attr.attr-code  no-undo .
      250       define output parameter p-exist   AS LOGICAL no-undo .
      251       define buffer buf_esys-all-attr for ub.esys-all-attr .
      252       define variable v-type           as character no-undo .
      253       define variable v-format         as character no-undo .
      254       define variable v-label          as character no-undo .
      255       define variable v-user-can-edit  as logical   no-undo .
      256       define variable v-output-display as logical   no-undo .
      257       define variable v-other          as character no-undo .
      258       run esallatr-name in this-procedure
      259         (input  p-code
      260         ,output v-type
      261         ,output v-format
      262         ,output v-label
      263         ,output v-user-can-edit
      264         ,output v-output-display
      265         ,output v-other
      266         ) no-error .
      267       if error-status :error then do:
      268         undo, return error return-value .
      269       end.
      270       Find first  buf_esys-all-attr no-lock where
      271                   buf_esys-all-attr.attr-code = p-code
      272              and  buf_esys-all-attr.table-name  = p-table-name
      273              and  buf_esys-all-attr.key1  = p-key1
      274              and  buf_esys-all-attr.key2  = p-key2
      275              and  buf_esys-all-attr.key3  = p-key3
      276              and  buf_esys-all-attr.key4  = p-key4
      277              and  buf_esys-all-attr.key5  = p-key5
      278              and  buf_esys-all-attr.key6  = p-key6
      279              and  buf_esys-all-attr.key7  = p-key7
      280              and  buf_esys-all-attr.key8  = p-key8  no-error .
      281       if available buf_esys-all-attr then do:
      282         P-EXIST = YES.
      283       end.
      284     end.
      285   end procedure.
      286   procedure esallatr-delete :
      287     do
      288     on error undo, return error
      289     :
      290       define input  parameter p-table-name as character no-undo .
      291       define input  parameter p-key1     as int64 no-undo .
      292       define input  parameter p-key2     as int64 no-undo .
      293       define input  parameter p-key3     as character no-undo .
      294       define input  parameter p-key4     as character no-undo .
      295       define input  parameter p-key5     as int64 no-undo .
      296       define input  parameter p-key6     as int64 no-undo .
      297       define input  parameter p-key7     as character no-undo .
      298       define input  parameter p-key8     as character no-undo .
      299       define input parameter  p-code     like ub.esys-all-attr.attr-code  no-undo .
      300       define output parameter p-deleted  as logical no-undo .
      301       define buffer buf_esys-all-attr for ub.esys-all-attr .
      302       define variable v-type           as character no-undo .
      303       define variable v-format         as character no-undo .
      304       define variable v-label          as character no-undo .
      305       define variable v-user-can-edit  as logical   no-undo .
      306       define variable v-output-display as logical   no-undo .
      307       define variable v-other          as character no-undo .
      308       run esallatr-name in this-procedure
      309         (input  p-code
      310         ,output v-type
      311         ,output v-format
      312         ,output v-label
      313         ,output v-user-can-edit
      314         ,output v-output-display
      315         ,output v-other
      316         ) no-error .
      317       if error-status :error then do:
      318         undo, return error return-value .
      319       end.
      320       Find first  buf_esys-all-attr exclusive-lock where
      321                   buf_esys-all-attr.attr-code = p-code
      322              and  buf_esys-all-attr.table-name  = p-table-name
      323              and  buf_esys-all-attr.key1  = p-key1
      324              and  buf_esys-all-attr.key2  = p-key2
      325              and  buf_esys-all-attr.key3  = p-key3
      326              and  buf_esys-all-attr.key4  = p-key4
      327              and  buf_esys-all-attr.key5  = p-key5
      328              and  buf_esys-all-attr.key6  = p-key6
      329              and  buf_esys-all-attr.key7  = p-key7
      330              and  buf_esys-all-attr.key8  = p-key8  no-error .
      331       if not available buf_esys-all-attr then do:
      332         p-DELETED = NO.
      333       end.
      334       ELSE DO:
      335         delete buf_esys-all-attr.
      336         p-DELETED = YES.
      337       END.
      338     end.
      339   end procedure.
      340   procedure esallatr-news :
      341     do
      342     on error undo, return error
      343     :
      344       define input  parameter p-code           as character no-undo .
      345       define output parameter p-news           as logical   no-undo .
      346       case p-code :
      347               when 'custom-pack-name':U then do:     assign     p-news = true.   end.
      348               when 'route-custom-pack-name':U then do:     assign     p-news = true.   end.
      349         otherwise do:
      350           undo, return error substitute("неизвестный атрибут ВС &1", p-code ).
      351         end.
      352       end.
      353     end.
      354   end procedure.
      355   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   procedure gen-key-rec :
      357     define input  parameter p-tbl-name    as character no-undo.
      358     define input  parameter p-bh_tbl-name as handle    no-undo.
      359     define output parameter p-key-rec     as character no-undo.
      360     do
      361     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      362     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      363     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      364     :
      365       define variable fh               as handle    no-undo .
      366       define variable v-ok             as logical   no-undo .
      367       define variable v-inform         as character no-undo .
      368       define variable v-ind            as integer   no-undo .
      369       define variable v-idx-field-qnty as integer   no-undo .
      370       if p-tbl-name = ?
      371         or p-tbl-name = "":U
      372       then do:
      373         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      374       end.
      375       if not p-bh_tbl-name:available then do:
      376         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      377       end.
      378       assign
      379         p-key-rec = p-tbl-name
      380         v-inform  = p-bh_tbl-name:index-information(1)
      381         v-ind     = 2
      382       .
      383       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      384       on error undo, return error
      385       :
      386         assign
      387           v-inform = p-bh_tbl-name:index-information( v-ind )
      388           v-ind    = v-ind + 1
      389         .
      390       end.
      391       if v-inform = ?
      392         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      393         or entry( 3, v-inform, ",":U ) <> "1":U
      394       then do:
      395         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      396       end.
      397       else do:
      398         assign
      399           v-idx-field-qnty = num-entries( v-inform ) - 4
      400         .
      401         if v-idx-field-qnty < 2 then do:
      402           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      403         end.
      404         do v-ind = 1 to v-idx-field-qnty by 2
      405         on error undo, return error
      406         :
      407           assign
      408             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      409             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      410           .
      411         end.
      412       end.
      413       if p-key-rec = ? then do:
      414         assign
      415           p-key-rec = "":U
      416         .
      417         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      418       end.
      419     end.
      420     return.
      421   end procedure.
      422   procedure gen-where-keyr-tab :
      423     define input  parameter i-tableSerach as character no-undo.
      424     define input  parameter i-tablekey   as character  no-undo.
      425     define input  parameter p-key-rec    as character  no-undo.
      426     define input  parameter p-key-handle as handle     no-undo .
      427     define input  parameter p-db-name    as character  no-undo .
      428     define input  parameter p-tt-handle  as handle     no-undo .
      429     define output parameter o-Where      as character  no-undo.
      430     do
      431     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      432     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      433     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      434     :
      435       define variable v-full-tbl-name  as character no-undo .
      436       define variable bh_tbl-name      as handle    no-undo .
      437       define variable fh_key           as handle    no-undo .
      438       define variable fh_search        as handle    no-undo .
      439       define variable v-field-num      as integer   no-undo .
      440       define variable v-count-fld      as integer   no-undo .
      441       define variable v-inform         as character no-undo .
      442       define variable v-ind            as integer   no-undo .
      443       define variable v-idx-field-qnty as integer   no-undo .
      444       define variable v-field-name     as character no-undo .
      445       define variable v-field-val      as character no-undo .
      446       define variable v-word-link      as character no-undo .
      447       define variable vTable           as character no-undo.
      448       define variable bh_tbl-key       as handle    no-undo .
      449       assign
      450         p-key-rec = trim( p-key-rec )
      451       .
      452       if p-key-handle <> ? then do:
      453         if not valid-handle(p-key-handle)
      454            or p-key-handle:type <> "buffer"
      455         then do:
      456           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      457         end.
      458         if num-entries( p-key-rec, chr(3) ) > 1
      459           or p-key-rec = ?
      460           or p-key-rec = "":U
      461         then do:
      462           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      463         end.
      464       end.
      465       else do:
      466         if p-key-rec = ?
      467           or p-key-rec = "":U
      468         then do:
      469           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      470         end.
      471       end.
      472       assign
      473         vTable = entry( 1 , p-key-rec, chr(3) )
      474       .
      475       if p-tt-handle <> ?
      476         and ( not valid-handle(p-tt-handle)
      477               or p-tt-handle:type <> "buffer"
      478             )
      479       then do:
      480         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      481       end.
      482       if p-tt-handle = ? then do:
      483         assign
      484           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      485         .
      486         create buffer bh_tbl-name for table v-full-tbl-name .
      487       end.
      488       else do:
      489         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      490       end.
      491       assign
      492         v-inform = bh_tbl-name:index-information(1)
      493         v-ind    = 2
      494       .
      495       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      496       on error undo, return error
      497       :
      498         assign
      499           v-inform = bh_tbl-name:index-information( v-ind )
      500           v-ind    = v-ind + 1
      501         .
      502       end.
      503       if v-inform = ?
      504         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      505         or entry( 3, v-inform, ",":U ) <> "1":U
      506       then do:
      507         delete object bh_tbl-name no-error.
      508         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      509       end.
      510       assign
      511         v-idx-field-qnty = num-entries( v-inform ) - 4
      512       .
      513       if v-idx-field-qnty < 2 then do:
      514         delete object bh_tbl-name no-error.
      515         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      516       end.
      517       assign
      518         o-where     = "where":U
      519         v-word-link = "":U
      520         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      521         v-count-fld = 0
      522       .
      523       if i-tablekey ne "" and i-tablekey ne ?
      524       then do:
      525         assign
      526           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      527         .
      528         create buffer bh_tbl-key for table v-full-tbl-name .
      529       end.
      530       if i-tableSerach ne "" and i-tableSerach ne ?
      531       then do:
      532         delete object bh_tbl-name no-error.
      533         assign
      534           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      535         .
      536         create buffer bh_tbl-name for table v-full-tbl-name .
      537       end.
      538       block_where:
      539       do v-ind = 1 to v-idx-field-qnty by 2
      540       on error undo, return error
      541       :
      542         assign
      543           v-count-fld = v-count-fld + 1
      544         .
      545         if p-key-handle = ?
      546           and v-count-fld > v-field-num
      547         then do:
      548           leave block_where.
      549         end.
      550         define variable VfieldKeyTable as handle no-undo.
      551         assign
      552           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      553           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      554         .
      555         if     bh_tbl-key ne ?
      556         then do:
      557            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      558            if VfieldKeyTable eq ?
      559            then next block_where.
      560         end.
      561         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      562         then
      563            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      564         else
      565            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      566         if p-key-handle = ? then do:
      567           assign
      568             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      569           .
      570         end.
      571         else do:
      572           assign
      573             fh_key = p-key-handle:buffer-field( v-field-name )
      574           .
      575           if fh_key = ?
      576             or not valid-handle( fh_key )
      577           then do:
      578             delete object bh_tbl-name.
      579             if     bh_tbl-key ne ?
      580             then
      581                delete object bh_tbl-key.
      582             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      583           end.
      584           assign
      585             v-field-val = fh_key:buffer-value
      586           .
      587         end.
      588         if fh_search:data-type ="character":U then do:
      589           assign
      590             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      591             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      592             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      593             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      594             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      595             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      596             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      597             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      598             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      599             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      600             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      601             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      602             v-field-val = substitute( '"&1"', v-field-val )
      603           .
      604         end.
      605         assign
      606           o-where = substitute( "&1 &2", o-where, v-field-val )
      607         .
      608         if v-word-link = "":U then do:
      609           assign
      610             v-word-link = "and":U
      611           .
      612         end.
      613       end.
      614       delete object bh_tbl-name.
      615       if     bh_tbl-key ne ?
      616       then
      617          delete object bh_tbl-key.
      618       if p-key-handle = ?
      619         and v-count-fld <> v-field-num
      620       then do:
      621         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      622       end.
      623     end.
      624   end procedure.
      625   procedure gen-hn-keyr-tab :
      626     define input  parameter i-tableSerach as character no-undo.
      627     define input  parameter i-tablekey   as character no-undo.
      628     define input  parameter p-key-rec    as character no-undo.
      629     define input  parameter p-key-handle as handle    no-undo .
      630     define input  parameter p-db-name    as character no-undo .
      631     define input  parameter p-tt-handle  as handle    no-undo .
      632     define input  parameter p-stts-lock  as integer   no-undo .
      633     define output parameter o-hn         as handle    no-undo.
      634     define variable v-full-tbl-name as character no-undo.
      635     define variable v-where         as character no-undo.
      636     define variable bh_tbl-name     as handle    no-undo.
      637     define variable vTable          as character no-undo.
      638     do
      639     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      640     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      641     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      642         run gen-where-keyr-tab(i-tableSerach,
      643                                i-tablekey,
      644                                p-key-rec,
      645                                p-key-handle,
      646                                p-db-name,
      647                                p-tt-handle,
      648                                output v-where).
      649         if i-tableSerach ne "" and i-tableSerach ne ?
      650         then do:
      651            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      652            create buffer bh_tbl-name for table v-full-tbl-name .
      653         end.
      654         else do:
      655            if p-tt-handle = ? then do:
      656               assign
      657                  vTable = entry( 1 , p-key-rec, chr(3) )
      658               .
      659               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      660               create buffer bh_tbl-name for table v-full-tbl-name .
      661            end.
      662            else do:
      663               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      664            end.
      665         end.
      666         if p-tt-handle = ? then do:
      667            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      668         end.
      669         else do:
      670            bh_tbl-name:find-first( v-where ) no-error .
      671         end.
      672         o-hn = bh_tbl-name.
      673      end.
      674   end procedure.
      675   procedure gen-hn-keyr :
      676     define input  parameter p-key-rec    as character no-undo.
      677     define input  parameter p-key-handle as handle    no-undo .
      678     define input  parameter p-db-name    as character no-undo .
      679     define input  parameter p-tt-handle  as handle    no-undo .
      680     define input  parameter p-stts-lock  as integer   no-undo .
      681     define output parameter o-hn         as handle    no-undo.
      682     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      683   end.
      684   procedure gen-row-keyr :
      685     define input  parameter p-key-rec    as character no-undo.
      686     define input  parameter p-key-handle as handle    no-undo .
      687     define input  parameter p-db-name    as character no-undo .
      688     define input  parameter p-tt-handle  as handle    no-undo .
      689     define input  parameter p-stts-lock  as integer   no-undo .
      690     define output parameter p-tbl-row    as rowid     no-undo.
      691     define output parameter p-tbl-name   as character no-undo.
      692     define variable vHn as handle no-undo.
      693       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      694       p-tbl-row = if vHn:available then vHn:rowid else ?.
      695       p-tbl-name =  vHn:table.
      696       delete object vHn no-error.
      697     if p-tbl-row = ? then do:
      698       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      699     end.
      700     else do:
      701       return.
      702     end.
      703   end procedure.
      704   procedure gen-key-fv :
      705     define input  parameter p-key-rec    as character no-undo .
      706     define output parameter p-field-list as character no-undo .
      707     define output parameter p-value-list as character no-undo.
      708     do
      709     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      710     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      711     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      712     :
      713       define variable v-full-tbl-name  as character no-undo .
      714       define variable bh_tbl-name      as handle    no-undo .
      715       define variable v-tbl-name       as character no-undo .
      716       define variable v-field-num      as integer   no-undo .
      717       define variable v-count-fld      as integer   no-undo .
      718       define variable v-inform         as character no-undo .
      719       define variable v-ind            as integer   no-undo .
      720       define variable v-idx-field-qnty as integer   no-undo .
      721       define variable v-delim-key      as character no-undo .
      722       if p-key-rec = ?
      723         or p-key-rec = "":U
      724       then do:
      725         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      726       end.
      727       assign
      728         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      729         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      730       .
      731       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      732       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      733       assign
      734         v-inform = bh_tbl-name:index-information(1)
      735         v-ind    = 2
      736       .
      737       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      738       on error undo, return error
      739       :
      740         assign
      741           v-inform = bh_tbl-name:index-information( v-ind )
      742           v-ind    = v-ind + 1
      743         .
      744       end.
      745       if v-inform = ?
      746         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      747         or entry( 3, v-inform, ",":U ) <> "1":U
      748       then do:
      749         delete object bh_tbl-name no-error.
      750         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      751       end.
      752       assign
      753         v-idx-field-qnty = num-entries( v-inform ) - 4
      754       .
      755       if v-idx-field-qnty < 2 then do:
      756         delete object bh_tbl-name no-error.
      757         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      758       end.
      759       assign
      760         p-field-list = "":U
      761         p-value-list = "":U
      762         v-delim-key  = "":U
      763         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      764         v-count-fld  = 0
      765       .
      766       block_where:
      767       do v-ind = 1 to v-idx-field-qnty by 2
      768       on error undo, return error
      769       :
      770         assign
      771           v-count-fld = v-count-fld + 1
      772         .
      773         if v-count-fld > v-field-num then do:
      774           leave block_where.
      775         end.
      776         assign
      777           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      778           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      779         .
      780         if v-ind = 1 then do:
      781           assign
      782             v-delim-key = chr(3)
      783           .
      784         end.
      785       end.
      786       delete object bh_tbl-name.
      787       if v-count-fld <> v-field-num then do:
      788         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      789       end.
      790     end.
      791   end procedure.
      792   procedure gen-key-field :
      793     define input  parameter p-table      as character no-undo .
      794     define output parameter p-field-list as character no-undo .
      795     do
      796     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      797     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      798     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      799     :
      800       define variable v-full-tbl-name  as character no-undo .
      801       define variable bh_tbl-name      as handle    no-undo .
      802       define variable v-tbl-name       as character no-undo .
      803       define variable v-field-num      as integer   no-undo .
      804       define variable v-count-fld      as integer   no-undo .
      805       define variable v-inform         as character no-undo .
      806       define variable v-ind            as integer   no-undo .
      807       define variable v-idx-field-qnty as integer   no-undo .
      808       define variable v-delim-key      as character no-undo .
      809       if p-table = ?
      810         or p-table = "":U
      811       then do:
      812         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      813       end.
      814       assign
      815         v-tbl-name      = p-table
      816         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      817       .
      818       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      819       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      820       assign
      821         v-inform = bh_tbl-name:index-information(1)
      822         v-ind    = 2
      823       .
      824       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      825       on error undo, return error
      826       :
      827         assign
      828           v-inform = bh_tbl-name:index-information( v-ind )
      829           v-ind    = v-ind + 1
      830         .
      831       end.
      832       if v-inform = ?
      833         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      834         or entry( 3, v-inform, ",":U ) <> "1":U
      835       then do:
      836         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      837       end.
      838       assign
      839         v-idx-field-qnty = num-entries( v-inform ) - 4
      840       .
      841       if v-idx-field-qnty < 2 then do:
      842         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      843       end.
      844       assign
      845         p-field-list = "":U
      846         v-delim-key  = "":U
      847         v-count-fld  = 0
      848       .
      849       block_where:
      850       do v-ind = 1 to v-idx-field-qnty by 2
      851       on error undo, return error
      852       :
      853         assign
      854           v-count-fld = v-count-fld + 1
      855         .
      856         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      857         if v-ind = 1 then do:
      858           assign
      859             v-delim-key = chr(3)
      860           .
      861         end.
      862       end.
      863       delete object bh_tbl-name.
      864     end.
      865   end procedure.
      866   define variable v-news as logical no-undo .
      867   define buffer buf_esys-all-attr for ub.esys-all-attr.
      868   define buffer buf_esys-route-dump for ub.esys-route-dump.
      869   main-block:
      870   do
      871   on error  undo main-block, return error substitute("&1. error &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      872   on endkey undo main-block, return error substitute("&1. endkey")
      873   on stop   undo main-block, return error substitute("&1. stop")
      874   :
      875     if g#news and g#db-num = 0
      876     then do :
      877       assign ub.esys-route.esr-tbl-ord = next-value( s-news-ord, ub ) .
      878     end.
      879     if false
      880     then do:
      881       for each buf_esys-all-attr exclusive-lock where
      882               buf_esys-all-attr.table-name =  'esys-route':U
      883           and buf_esys-all-attr.key1 = ub.esys-route.esr-dump-ord
      884           and buf_esys-all-attr.key2 = ub.esys-route.esys-id
      885           and buf_esys-all-attr.key5 = ub.esys-route.db-num
      886       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      887       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      888       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      889       :
      890         buf_esys-all-attr.key6 = ub.esys-route.db-num.
      891         run str/callnews.p
      892           (input 'esys-all-attr':U
      893           ,input (buffer buf_esys-all-attr:handle)
      894           ) no-error .
      895         if error-status:error then do:
      896           undo main-block, return error substitute( '&1. Ошибка при маршрутизации записи "&2" в СПН. &3&4&3&5'
      897                                                     ,vss-workfile
      898                                                     ,'esys-all-attr':U
      899                                                     ,chr(10)
      900                                                     ,return-value
      901                                                     ,error-status :get-message ( 1 )
      902                                                   ).
      903         end.
      904       end.
      905       for each buf_esys-route-dump exclusive-lock where
      906           buf_esys-route-dump.esrd-dump-ord = ub.esys-route.esr-dump-ord
      907       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      908       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      909       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      910       :
      911         buf_esys-route-dump.esrd-cr-db-num = ub.esys-route.db-num.
      912       end.
      913       ub.esys-route.esr-cr-db-num = ub.esys-route.db-num.
      914       run str/callnews.p
      915         ( input 'esys-route':U
      916         , input (buffer ub.esys-route:handle)
      917         ) no-error .
      918       if error-status:error then do:
      919         undo main-block, return error substitute( '&1. Ошибка при маршрутизации записи "&2" в СПН. &3&4&3&5'
      920                                                   ,vss-workfile
      921                                                   ,'esys-route':U
      922                                                   ,chr(10)
      923                                                   ,return-value
      924                                                   ,error-status :get-message ( 1 )
      925                                                 ).
      926       end.
      927     end.
      928     return .
      929   end.
