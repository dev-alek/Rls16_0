        1   block-level on error undo, throw.
        2   define input parameter p-doc-code   like ub.doc-line.doc-code  no-undo .
        3   define input parameter p-artic      like ub.doc-line.artic     no-undo .
        4   define input parameter p-prod-type  like ub.doc-line.prod-type no-undo .
        5   define input parameter p-prod-code  like ub.doc-line.prod-code no-undo .
        6   define input parameter p-new-SLT-pc as decimal no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Изменение НП поставщика в строке документа".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   procedure partrqst :
       84     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
       85     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
       86     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
       87     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
       88     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
       89     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
       90     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
       91     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
       92     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
       93     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
       94     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
       95     define output parameter p-total-parts-price-base     as decimal                 no-undo .
       96     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
       97     define output parameter p-total-parts-transport-base as decimal                 no-undo .
       98     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
       99     define output parameter p-total-parts-other-base     as decimal                 no-undo .
      100     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
      101     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
      102     do
      103     on error undo, return error return-value
      104     :
      105       assign
      106         p-total-parts-qnty           = 0
      107         p-total-parts-fact-qnty      = 0
      108         p-total-parts-cli-qnty       = 0
      109         p-total-parts-fact-cli-qnty  = 0
      110         p-total-parts-price-cli      = 0
      111         p-total-parts-price-base     = 0
      112         p-total-parts-price-rubl     = 0
      113         p-total-parts-transport-base = 0
      114         p-total-parts-transport-rubl = 0
      115         p-total-parts-other-base     = 0
      116         p-total-parts-other-rubl     = 0
      117       .
      118       define buffer buf_parts for ub.parts .
      119       for each buf_parts no-lock
      120         where buf_parts.out-code  = p-doc-code
      121           and buf_parts.obj-type  = p-obj-type
      122           and buf_parts.obj-code  = p-obj-code
      123           and buf_parts.artic     = p-artic
      124           and buf_parts.prod-type = p-prod-type
      125           and buf_parts.prod-code = p-prod-code
      126       on error undo, return error return-value
      127       :
      128         define variable v-parts-fact-multiplier as decimal   no-undo .
      129         assign
      130           v-parts-fact-multiplier = 1
      131         .
      132         if buf_parts.qnty <> 0 then do:
      133           assign
      134             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      135           .
      136         end.
      137         assign
      138           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      139           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      140           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      141           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      142                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      143           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      144           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      145           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      146           p-total-parts-transport-base  = p-total-parts-transport-base
      147                                         + buf_parts.fact-qnty
      148                                           * (if   buf_parts.transport-base <> ?
      149                                             then buf_parts.transport-base
      150                                             else 0
      151                                             )
      152           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      153                                         + buf_parts.fact-qnty
      154                                           * (if   buf_parts.transport-rubl <> ?
      155                                             then buf_parts.transport-rubl
      156                                             else 0
      157                                             )
      158           p-total-parts-other-base      = p-total-parts-other-base
      159                                         + buf_parts.fact-qnty
      160                                           * (if   buf_parts.other-base <> ?
      161                                             then buf_parts.other-base
      162                                             else 0
      163                                             )
      164           p-total-parts-other-rubl      = p-total-parts-other-rubl
      165                                         + buf_parts.fact-qnty
      166                                           * (if   buf_parts.other-rubl <> ?
      167                                             then buf_parts.other-rubl
      168                                             else 0
      169                                             )
      170         .
      171       end.
      172     end.
      173   end procedure.
      174     def var price-cli-loc like ub.doc-line.price-cli no-undo .
      175     def var varr-b        as   character             no-undo.
      176       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      177       define buffer   in-vatp-parts    for ub.parts   .
      178       define buffer   in-vatp-doc      for ub.trn-doc .
      179       define buffer   in-vatp-goods    for ub.goods   .
      180       define buffer   in-vatp-sysconf  for ub.sysconf .
      181       define buffer   in-vatp_doc-attr for ub.doc-attr.
      182       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      183       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      184       define variable varinvprb                  as   character              no-undo.
      185       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      186       define variable cli-base-rate              as   decimal                no-undo.
      187       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      188       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      189       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      190       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      191       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      192       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      193       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      194       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      195       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      196       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      197       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      198       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      199       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      200       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      201       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      202       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      203       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      204       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      205       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      206       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      207       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      208       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      209       define variable varinvatp-envd             as   character              no-undo.
      210       define variable varinvatp-type             as   character              no-undo.
      211   define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
      212   find first ub.doc-line no-lock
      213     where ub.doc-line.doc-code   = p-doc-code
      214       and ub.doc-line.artic      = p-artic
      215       and ub.doc-line.prod-type  = p-prod-type
      216       and ub.doc-line.prod-code  = p-prod-code
      217     no-error .
      218   if not available ub.doc-line then do:
      219     message
      220       vss-workfile vss-revision vss-description skip
      221       "Не найдена запись doc-line" skip
      222       "p-doc-code"  p-doc-code  skip
      223       "p-artic"     p-artic     skip
      224       "p-prod-type" p-prod-type skip
      225       "p-prod-code" p-prod-code skip
      226       view-as alert-box error .
      227   end.
      228   if p-new-SLT-pc = ub.doc-line.SLT-pc then do:
      229     return .
      230   end.
      231   trans-block:
      232   do transaction
      233   on error undo trans-block, return error
      234   :
      235     find first ub.trn-doc exclusive-lock
      236       where ub.trn-doc.doc-code = p-doc-code
      237       .
      238     if ub.trn-doc.doc-type <> 'при':U
      239     then do:
      240       message
      241         vss-workfile vss-revision vss-description skip
      242         "У данного документа нельзя менять процент НП" skip
      243         "Указанный документ не является документом внешнего прихода" skip
      244         "Документ" p-doc-code skip
      245         "Артикул" p-artic p-prod-type p-prod-code skip
      246         "Тип документа" ub.trn-doc.doc-type skip
      247         view-as alert-box .
      248       undo, return error return-value .
      249     end.
      250     if ub.trn-doc.status_ <> 'факт':U
      251     then do:
      252       message
      253         vss-workfile vss-revision vss-description skip
      254         "У данного документа нельзя менять процент НП" skip
      255         "Статус документа отличен от статуса" 'факт':U skip
      256         "Статус документа" ub.trn-doc.status_ skip
      257         "Артикул" p-artic p-prod-type p-prod-code skip
      258         "Статус документа" ub.trn-doc.status_ skip
      259         view-as alert-box .
      260       undo, return error return-value .
      261     end.
      262     if  ub.trn-doc.SLT-type = 'без':U
      263     and p-new-SLT-pc <> 0
      264     then do:
      265       message
      266         vss-workfile vss-revision vss-description skip
      267         "У документа с типом заведения НП" 'без':U skip
      268         "можно задать только нулевой процент НП" skip
      269         "Статус документа" ub.trn-doc.status_ skip
      270         "Артикул" p-artic p-prod-type p-prod-code skip
      271         "Статус документа" ub.trn-doc.status_ skip
      272         "Процент НДС" p-new-SLT-pc skip
      273         view-as alert-box .
      274       undo, return error return-value .
      275     end.
      276     find current ub.doc-line exclusive-lock .
      277     assign
      278       ub.doc-line.SLT-pc = p-new-SLT-pc
      279     .
      280     for each parts exclusive-lock
      281       where parts.in-code   = p-doc-code
      282         and parts.artic     = p-artic
      283         and parts.prod-type = p-prod-type
      284         and parts.prod-code = p-prod-code
      285     on error undo trans-block, return error
      286     :
      287   if varr-b = "rubl":u then do:
      288     assign
      289     price-cli-loc =
      290       ( ( ub.parts.price-rubl
      291         - ub.parts.transport-rubl
      292         - ub.parts.other-rubl
      293         - ub.parts.road-tax-rubl
      294         )
      295         *
      296         ( if ub.trn-doc.slt-type = 'нет':U
      297           then 100 / (100 + ub.parts.slt-pc)
      298           else 1
      299         )
      300         *
      301         ( if ub.trn-doc.vat-type = 'нет':U
      302           then 100 / (100 + ub.parts.vat-pc)
      303           else 1
      304         )
      305         + ub.parts.road-tax-rubl
      306       )
      307       / ub.trn-doc.exch-rate *  ub.trn-doc.exch-scale * ub.parts.cli-base-rate
      308       .
      309   end.
      310   else do:
      311     assign
      312     price-cli-loc =
      313       ( ( ub.parts.price-base
      314         - ub.parts.transport-base
      315         - ub.parts.other-base
      316         - ub.parts.road-tax-base
      317         )
      318         *
      319         ( if ub.trn-doc.slt-type = 'нет':U
      320           then 100 / (100 + ub.parts.slt-pc)
      321           else 1
      322         )
      323         *
      324         ( if ub.trn-doc.vat-type = 'нет':U
      325           then 100 / (100 + ub.parts.vat-pc)
      326           else 1
      327         )
      328         + ub.parts.road-tax-base
      329       )
      330         * ub.trn-doc.base-rate / ub.trn-doc.base-scale
      331       / ub.trn-doc.exch-rate *  ub.trn-doc.exch-scale * ub.parts.cli-base-rate
      332       .
      333   end.
      334       assign
      335         parts.SLT-pc    = p-new-SLT-pc
      336         parts.price-cli = price-cli-loc
      337       .
      338       define variable v-gds-code as integer   no-undo .
      339   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pargocod in g#library
      340     (input  recid(parts)
      341     ,output v-gds-code
      342     )  .
      343       for each parts-attr exclusive-lock
      344         where parts-attr.in-code   = parts.in-code
      345           and parts-attr.gds-code  = v-gds-code
      346           and parts-attr.part-code = parts.part-code
      347       on error undo trans-block, return error
      348       :
      349         assign
      350           parts-attr.SLT-pc    = parts.SLT-pc
      351           parts-attr.price-cli = parts.price-cli
      352         .
      353   assign
      354     price-rubl-with-tax-loc = parts.price-rubl
      355     price-base-with-tax-loc = parts.price-base
      356   .
      357   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      358   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      359     (output varinvprb
      360     )  .
      361     if parts.out-code = 'free-zone':U     or
      362        parts.out-code = 'out-zone':U   or
      363        parts.doc-type = 'акт':U then do:
      364       assign
      365         in-vatp-have-vat-slt = yes.
      366     end.
      367     else do:
      368       find first in-vatp_doc-attr no-lock
      369         where in-vatp_doc-attr.doc-code  = parts.out-code
      370           and in-vatp_doc-attr.attr-code = 'envd':U
      371         no-error .
      372       if not available in-vatp_doc-attr then do:
      373         assign
      374           in-vatp-have-vat-slt = yes.
      375       end.
      376       else do:
      377            in-vatp-have-vat-slt = no.
      378       end.
      379     end.
      380     assign
      381      price-cli-with-tax-loc = parts.price-cli
      382      cli-base-rate          = parts.cli-base-rate.
      383     ASSIGN   road-tax-base-loc  = (if parts.road-tax-base  = ? then 0 else parts.road-tax-base)
      384              road-tax-rubl-loc  = (if parts.road-tax-rubl  = ? then 0 else parts.road-tax-rubl).
      385     ASSIGN  transport-base-loc = (if parts.transport-base = ? then 0 else parts.transport-base)
      386             transport-rubl-loc = (if parts.transport-rubl = ? then 0 else parts.transport-rubl)
      387             other-base-loc     = (if parts.other-base     = ? then 0 else parts.other-base)
      388             other-rubl-loc     = (if parts.other-rubl     = ? then 0 else parts.other-rubl)
      389             vat-pc-loc         = (if parts.vat-pc         = ? then 0 else parts.vat-pc)
      390             slt-pc-loc         = (if parts.slt-pc         = ? then 0 else parts.slt-pc).
      391             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      392       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      393     assign
      394       exch-rate-cli-loc = (parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / parts.price-cli .
      395     assign
      396       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      397       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      398       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      399       transport-cli-loc  = 0
      400       other-cli-loc      = 0
      401     .
      402   ASSIGN
      403             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      404       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      405   .
      406         assign
      407           parts-attr.vat-base         = vat-base-loc
      408           parts-attr.vat-rubl         = vat-rubl-loc
      409           parts-attr.slt-base         = slt-base-loc
      410           parts-attr.slt-rubl         = slt-rubl-loc
      411           parts-attr.discnt-base      = 0
      412           parts-attr.discnt-rubl      = 0
      413         .
      414       end.
      415       define buffer buf_trn-doc for ub.trn-doc .
      416       find first buf_trn-doc exclusive-lock
      417         where buf_trn-doc.doc-code = parts.out-code
      418         no-error .
      419       if available buf_trn-doc
      420       and buf_trn-doc.status_ = 'факт':U
      421       then do:
      422         run trg/markdoc.p
      423           (input buf_trn-doc.doc-code
      424           ,input 'doc-change':u
      425           ) no-error .
      426         if error-status :error
      427         then do:
      428           message
      429             "Не удалось зарегистрировать изменение документа" skip
      430             "Документ" parts.out-code skip
      431             error-status :get-message(1) skip
      432             return-value skip
      433             view-as alert-box error .
      434           undo, return error .
      435         end.
      436       end.
      437     end.
      438     run partrqst in this-procedure
      439       (input  ub.doc-line.doc-code
      440       ,input  ub.doc-line.obj-type
      441       ,input  ub.doc-line.obj-code
      442       ,input  ub.doc-line.artic
      443       ,input  ub.doc-line.prod-type
      444       ,input  ub.doc-line.prod-code
      445           ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
      446       ).
      447     if  trn-doc.doc-type = 'при':U
      448     and trn-doc.internal = no
      449     then do:
      450       if v-total-parts-cli-qnty <> 0 then do:
      451         assign
      452           ub.doc-line.price-cli = v-total-parts-price-cli / v-total-parts-cli-qnty
      453         .
      454       end.
      455     end.
      456     run trg/markdoc.p
      457       (input ub.trn-doc.doc-code
      458       ,input 'doc-change':u
      459       ) no-error .
      460     if error-status :error
      461     then do:
      462       message
      463         "Не удалось зарегистрировать изменение документа" skip
      464         "Документ" ub.trn-doc.doc-code skip
      465         error-status :get-message(1) skip
      466         return-value skip
      467         view-as alert-box error .
      468       undo, return error .
      469     end.
      470   end.
