     1390   ,reportShift~
     1391   ,shift-param~
     1392   ,susp-chk~
     1393   ':U .
     1394   define variable oth-list1 as character no-undo .
     1395   define variable oth-list2 as character no-undo .
     1396   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1397   DEFINE VARIABLE v-today as date no-undo .
     1398   DEFINE VARIABLE v-time as integer no-undo .
     1399   define variable v-updated as logical no-undo .
     1400   define variable v-ii as integer no-undo .
     1401   define variable v-mess as logical no-undo .
     1402   define buffer buf_hist-nws-option for ub.hist-nws-option.
     1403   define buffer buf2_hist-nws-option for ub.hist-nws-option.
     1404   define buffer locked_hist-nws-option for ub.hist-nws-option.
     1405   run waitfram-show in this-procedure ( "Реинициализация настроек опций истории и маршрутизации").
     1406   main-block:
     1407   do
     1408   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1409   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1410   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1411   :
     1412     _v-ii:
     1413     do v-ii = 1 to num-entries( news-list):
     1414       find first buf_hist-nws-option no-lock where
     1415                 buf_hist-nws-option.db-num = g#db-num
     1416             and buf_hist-nws-option.table-name = entry(v-ii, news-list) no-error.
     1417       if entry(v-ii, news-list) begins "c-":U then next _v-ii.
     1418       if not available buf_hist-nws-option  then do:
     1419         if g#db-num > 0  then do:
     1420           find first buf_hist-nws-option no-lock where
     1421                     buf_hist-nws-option.db-num = 0
     1422               and  buf_hist-nws-option.table-name = entry(v-ii, news-list)
     1423               and  buf_hist-nws-option.charkey_one = '':U
     1424               and  buf_hist-nws-option.charkey_two = '':U
     1425               and  buf_hist-nws-option.charkey_three = '':U
     1426               and  buf_hist-nws-option.key#_one = 0
     1427               and  buf_hist-nws-option.key#_two = 0
     1428               and  buf_hist-nws-option.key#_three = 0
     1429               no-error.
     1430           if available buf_hist-nws-option then do:
     1431             if not available locked_hist-nws-option then do:
     1432               if p-read-only then do:
     1433                 v-mess = yes.
     1434                 leave _v-ii.
     1435               end.
     1436               find first locked_hist-nws-option exclusive-lock where
     1437                         locked_hist-nws-option.db-num = g#db-num
     1438                     and locked_hist-nws-option.hn-id = 0.
     1439             end.
     1440             find first buf2_hist-nws-option share-lock where
     1441                       buf2_hist-nws-option.db-num = g#db-num
     1442                   and buf2_hist-nws-option.hn-id = buf_hist-nws-option.hn-id no-error .
     1443             if available buf2_hist-nws-option then do:
     1444             end.
     1445             else do:
     1446               if p-read-only then do:
     1447                 v-mess = yes.
     1448                 leave _v-ii.
     1449               end.
     1450               create buf2_hist-nws-option.
     1451               assign
     1452               buf2_hist-nws-option.db-num = g#db-num
     1453               buf2_hist-nws-option.hn-id = buf_hist-nws-option.hn-id.
     1454             end.
     1455             buffer-copy buf_hist-nws-option
     1456             except
     1457             db-num
     1458             get-hist-from-nws
     1459             hist-from-prim
     1460             hist-to-nws
     1461             nws-to-cd
     1462             nws-to-hist
     1463             smart-nws
     1464             to buf2_hist-nws-option
     1465             assign
     1466             buf2_hist-nws-option.db-num = g#db-num
     1467             buf2_hist-nws-option.get-hist-from-nws = ( if buf_hist-nws-option.get-hist-from-nws = integer('10':U)
     1468                                                         or buf_hist-nws-option.get-hist-from-nws = integer('-10':U)
     1469                                                         then buf_hist-nws-option.get-hist-from-nws
     1470                                                         else integer('0':U))
     1471             buf2_hist-nws-option.hist-from-prim = ( if buf_hist-nws-option.hist-from-prim = integer('10':U)
     1472                                                         or buf_hist-nws-option.hist-from-prim = integer('-10':U)
     1473                                                         then buf_hist-nws-option.hist-from-prim
     1474                                                         else integer('0':U))
     1475             buf2_hist-nws-option.hist-to-nws = ( if buf_hist-nws-option.hist-to-nws = integer('10':U)
     1476                                                         or buf_hist-nws-option.hist-to-nws = integer('-10':U)
     1477                                                         then buf_hist-nws-option.hist-to-nws
     1478                                                         else integer('0':U))
     1479             buf2_hist-nws-option.nws-to-cd = ( if buf_hist-nws-option.nws-to-cd = integer('10':U)
     1480                                                         or buf_hist-nws-option.nws-to-cd = integer('-10':U)
     1481                                                         then buf_hist-nws-option.nws-to-cd
     1482                                                         else integer('-1':U))
     1483             buf2_hist-nws-option.nws-to-hist = ( if buf_hist-nws-option.nws-to-hist = integer('10':U)
     1484                                                         or buf_hist-nws-option.nws-to-hist = integer('-10':U)
     1485                                                         then buf_hist-nws-option.nws-to-hist
     1486                                                         else integer('0':U))
     1487             buf2_hist-nws-option.smart-nws = ( if buf_hist-nws-option.smart-nws = integer('10':U)
     1488                                                         or buf_hist-nws-option.smart-nws = integer('-10':U)
     1489                                                         then buf_hist-nws-option.smart-nws
     1490                                                         else integer('-1':U))
     1491             v-updated                      = yes
     1492             .
     1493           end.
     1494         end.
     1495         else do:
     1496           if p-read-only then do:
     1497             v-mess = yes.
     1498             leave _v-ii.
     1499           end.
     1500           if not available locked_hist-nws-option then do:
     1501             find first locked_hist-nws-option exclusive-lock where
     1502                       locked_hist-nws-option.db-num = g#db-num
     1503                   and locked_hist-nws-option.hn-id = 0 no-wait no-error.
     1504             if locked locked_hist-nws-option then do:
     1505                message
     1506                substitute("В процессе входа в систему потребовалось реинициализировать настройки записи истории и маршрутизации&1"+
     1507                           "однако ресурс занят&1" +
     1508                           "ТАБЛИЦА &2" +
     1509                           "Имя пользователя, использующего ресурс будет известно после нажатия клавиши ВВОД"
     1510                           , chr(10)
     1511                           ,entry(v-ii, news-list)
     1512                           )
     1513                view-as alert-box error .
     1514                 find first locked_hist-nws-option exclusive-lock where
     1515                           locked_hist-nws-option.db-num = g#db-num
     1516                       and locked_hist-nws-option.hn-id = 0
     1517                       no-error.
     1518                return.
     1519             end.
     1520           end.
     1521           create buf2_hist-nws-option.
     1522           assign
     1523           buf2_hist-nws-option.db-num = g#db-num
     1524           buf2_hist-nws-option.hn-id  = next-value(s-hn-id, ub)
     1525           buf2_hist-nws-option.subject-group = '':U
     1526           buf2_hist-nws-option.table-name = entry(v-ii, news-list)
     1527           buf2_hist-nws-option.get-hist-from-nws = integer('0':U)
     1528           buf2_hist-nws-option.hist-from-prim    = integer('0':U)
     1529           buf2_hist-nws-option.hist-to-nws       = integer('0':U)
     1530           buf2_hist-nws-option.nws-to-cd         = integer('-1':U)
     1531           buf2_hist-nws-option.nws-to-hist       = integer('0':U)
     1532           buf2_hist-nws-option.smart-nws         = integer('-1':U)
     1533           v-updated                              = yes
     1534           .
     1535         end.
     1536       end.
     1537     end.
     1538     if v-mess then do:
     1539       return error substitute("&1 &2 &3&4До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!"
     1540                               ,vss-workfile
     1541                               ,vss-revision
     1542                               ,vss-description
     1543                               ,chr(10)).
     1544     end.
     1545     if v-updated then do:
     1546       run cur-time in this-procedure(output v-today, output v-time).
     1547       assign
     1548       locked_hist-nws-option.option-descr = substitute("&1 &2", string(v-today, "99/99/9999"), string(v-time, "HH:MM:SS")).
     1549     end.
     1550   end.
     1551   run waitfram-hide in this-procedure .
