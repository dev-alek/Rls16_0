        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Библиотека процедур для распределенной обработки ДК".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure gen-key-rec :
       79     define input  parameter p-tbl-name    as character no-undo.
       80     define input  parameter p-bh_tbl-name as handle    no-undo.
       81     define output parameter p-key-rec     as character no-undo.
       82     do
       83     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       84     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       85     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       86     :
       87       define variable fh               as handle    no-undo .
       88       define variable v-ok             as logical   no-undo .
       89       define variable v-inform         as character no-undo .
       90       define variable v-ind            as integer   no-undo .
       91       define variable v-idx-field-qnty as integer   no-undo .
       92       if p-tbl-name = ?
       93         or p-tbl-name = "":U
       94       then do:
       95         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       96       end.
       97       if not p-bh_tbl-name:available then do:
       98         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
       99       end.
      100       assign
      101         p-key-rec = p-tbl-name
      102         v-inform  = p-bh_tbl-name:index-information(1)
      103         v-ind     = 2
      104       .
      105       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      106       on error undo, return error
      107       :
      108         assign
      109           v-inform = p-bh_tbl-name:index-information( v-ind )
      110           v-ind    = v-ind + 1
      111         .
      112       end.
      113       if v-inform = ?
      114         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      115         or entry( 3, v-inform, ",":U ) <> "1":U
      116       then do:
      117         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      118       end.
      119       else do:
      120         assign
      121           v-idx-field-qnty = num-entries( v-inform ) - 4
      122         .
      123         if v-idx-field-qnty < 2 then do:
      124           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      125         end.
      126         do v-ind = 1 to v-idx-field-qnty by 2
      127         on error undo, return error
      128         :
      129           assign
      130             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      131             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      132           .
      133         end.
      134       end.
      135       if p-key-rec = ? then do:
      136         assign
      137           p-key-rec = "":U
      138         .
      139         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      140       end.
      141     end.
      142     return.
      143   end procedure.
      144   procedure gen-where-keyr-tab :
      145     define input  parameter i-tableSerach as character no-undo.
      146     define input  parameter i-tablekey   as character  no-undo.
      147     define input  parameter p-key-rec    as character  no-undo.
      148     define input  parameter p-key-handle as handle     no-undo .
      149     define input  parameter p-db-name    as character  no-undo .
      150     define input  parameter p-tt-handle  as handle     no-undo .
      151     define output parameter o-Where      as character  no-undo.
      152     do
      153     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      154     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      155     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      156     :
      157       define variable v-full-tbl-name  as character no-undo .
      158       define variable bh_tbl-name      as handle    no-undo .
      159       define variable fh_key           as handle    no-undo .
      160       define variable fh_search        as handle    no-undo .
      161       define variable v-field-num      as integer   no-undo .
      162       define variable v-count-fld      as integer   no-undo .
      163       define variable v-inform         as character no-undo .
      164       define variable v-ind            as integer   no-undo .
      165       define variable v-idx-field-qnty as integer   no-undo .
      166       define variable v-field-name     as character no-undo .
      167       define variable v-field-val      as character no-undo .
      168       define variable v-word-link      as character no-undo .
      169       define variable vTable           as character no-undo.
      170       define variable bh_tbl-key       as handle    no-undo .
      171       assign
      172         p-key-rec = trim( p-key-rec )
      173       .
      174       if p-key-handle <> ? then do:
      175         if not valid-handle(p-key-handle)
      176            or p-key-handle:type <> "buffer"
      177         then do:
      178           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      179         end.
      180         if num-entries( p-key-rec, chr(3) ) > 1
      181           or p-key-rec = ?
      182           or p-key-rec = "":U
      183         then do:
      184           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      185         end.
      186       end.
      187       else do:
      188         if p-key-rec = ?
      189           or p-key-rec = "":U
      190         then do:
      191           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      192         end.
      193       end.
      194       assign
      195         vTable = entry( 1 , p-key-rec, chr(3) )
      196       .
      197       if p-tt-handle <> ?
      198         and ( not valid-handle(p-tt-handle)
      199               or p-tt-handle:type <> "buffer"
      200             )
      201       then do:
      202         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      203       end.
      204       if p-tt-handle = ? then do:
      205         assign
      206           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      207         .
      208         create buffer bh_tbl-name for table v-full-tbl-name .
      209       end.
      210       else do:
      211         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      212       end.
      213       assign
      214         v-inform = bh_tbl-name:index-information(1)
      215         v-ind    = 2
      216       .
      217       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      218       on error undo, return error
      219       :
      220         assign
      221           v-inform = bh_tbl-name:index-information( v-ind )
      222           v-ind    = v-ind + 1
      223         .
      224       end.
      225       if v-inform = ?
      226         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      227         or entry( 3, v-inform, ",":U ) <> "1":U
      228       then do:
      229         delete object bh_tbl-name no-error.
      230         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      231       end.
      232       assign
      233         v-idx-field-qnty = num-entries( v-inform ) - 4
      234       .
      235       if v-idx-field-qnty < 2 then do:
      236         delete object bh_tbl-name no-error.
      237         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      238       end.
      239       assign
      240         o-where     = "where":U
      241         v-word-link = "":U
      242         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      243         v-count-fld = 0
      244       .
      245       if i-tablekey ne "" and i-tablekey ne ?
      246       then do:
      247         assign
      248           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      249         .
      250         create buffer bh_tbl-key for table v-full-tbl-name .
      251       end.
      252       if i-tableSerach ne "" and i-tableSerach ne ?
      253       then do:
      254         delete object bh_tbl-name no-error.
      255         assign
      256           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      257         .
      258         create buffer bh_tbl-name for table v-full-tbl-name .
      259       end.
      260       block_where:
      261       do v-ind = 1 to v-idx-field-qnty by 2
      262       on error undo, return error
      263       :
      264         assign
      265           v-count-fld = v-count-fld + 1
      266         .
      267         if p-key-handle = ?
      268           and v-count-fld > v-field-num
      269         then do:
      270           leave block_where.
      271         end.
      272         define variable VfieldKeyTable as handle no-undo.
      273         assign
      274           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      275           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      276         .
      277         if     bh_tbl-key ne ?
      278         then do:
      279            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      280            if VfieldKeyTable eq ?
      281            then next block_where.
      282         end.
      283         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      284         then
      285            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      286         else
      287            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      288         if p-key-handle = ? then do:
      289           assign
      290             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      291           .
      292         end.
      293         else do:
      294           assign
      295             fh_key = p-key-handle:buffer-field( v-field-name )
      296           .
      297           if fh_key = ?
      298             or not valid-handle( fh_key )
      299           then do:
      300             delete object bh_tbl-name.
      301             if     bh_tbl-key ne ?
      302             then
      303                delete object bh_tbl-key.
      304             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      305           end.
      306           assign
      307             v-field-val = fh_key:buffer-value
      308           .
      309         end.
      310         if fh_search:data-type ="character":U then do:
      311           assign
      312             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      313             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      314             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      315             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      316             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      317             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      318             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      319             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      320             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      321             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      322             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      323             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      324             v-field-val = substitute( '"&1"', v-field-val )
      325           .
      326         end.
      327         assign
      328           o-where = substitute( "&1 &2", o-where, v-field-val )
      329         .
      330         if v-word-link = "":U then do:
      331           assign
      332             v-word-link = "and":U
      333           .
      334         end.
      335       end.
      336       delete object bh_tbl-name.
      337       if     bh_tbl-key ne ?
      338       then
      339          delete object bh_tbl-key.
      340       if p-key-handle = ?
      341         and v-count-fld <> v-field-num
      342       then do:
      343         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      344       end.
      345     end.
      346   end procedure.
      347   procedure gen-hn-keyr-tab :
      348     define input  parameter i-tableSerach as character no-undo.
      349     define input  parameter i-tablekey   as character no-undo.
      350     define input  parameter p-key-rec    as character no-undo.
      351     define input  parameter p-key-handle as handle    no-undo .
      352     define input  parameter p-db-name    as character no-undo .
      353     define input  parameter p-tt-handle  as handle    no-undo .
      354     define input  parameter p-stts-lock  as integer   no-undo .
      355     define output parameter o-hn         as handle    no-undo.
      356     define variable v-full-tbl-name as character no-undo.
      357     define variable v-where         as character no-undo.
      358     define variable bh_tbl-name     as handle    no-undo.
      359     define variable vTable          as character no-undo.
      360     do
      361     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      362     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      363     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      364         run gen-where-keyr-tab(i-tableSerach,
      365                                i-tablekey,
      366                                p-key-rec,
      367                                p-key-handle,
      368                                p-db-name,
      369                                p-tt-handle,
      370                                output v-where).
      371         if i-tableSerach ne "" and i-tableSerach ne ?
      372         then do:
      373            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      374            create buffer bh_tbl-name for table v-full-tbl-name .
      375         end.
      376         else do:
      377            if p-tt-handle = ? then do:
      378               assign
      379                  vTable = entry( 1 , p-key-rec, chr(3) )
      380               .
      381               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      382               create buffer bh_tbl-name for table v-full-tbl-name .
      383            end.
      384            else do:
      385               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      386            end.
      387         end.
      388         if p-tt-handle = ? then do:
      389            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      390         end.
      391         else do:
      392            bh_tbl-name:find-first( v-where ) no-error .
      393         end.
      394         o-hn = bh_tbl-name.
      395      end.
      396   end procedure.
      397   procedure gen-hn-keyr :
      398     define input  parameter p-key-rec    as character no-undo.
      399     define input  parameter p-key-handle as handle    no-undo .
      400     define input  parameter p-db-name    as character no-undo .
      401     define input  parameter p-tt-handle  as handle    no-undo .
      402     define input  parameter p-stts-lock  as integer   no-undo .
      403     define output parameter o-hn         as handle    no-undo.
      404     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      405   end.
      406   procedure gen-row-keyr :
      407     define input  parameter p-key-rec    as character no-undo.
      408     define input  parameter p-key-handle as handle    no-undo .
      409     define input  parameter p-db-name    as character no-undo .
      410     define input  parameter p-tt-handle  as handle    no-undo .
      411     define input  parameter p-stts-lock  as integer   no-undo .
      412     define output parameter p-tbl-row    as rowid     no-undo.
      413     define output parameter p-tbl-name   as character no-undo.
      414     define variable vHn as handle no-undo.
      415       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      416       p-tbl-row = if vHn:available then vHn:rowid else ?.
      417       p-tbl-name =  vHn:table.
      418       delete object vHn no-error.
      419     if p-tbl-row = ? then do:
      420       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      421     end.
      422     else do:
      423       return.
      424     end.
      425   end procedure.
      426   procedure gen-key-fv :
      427     define input  parameter p-key-rec    as character no-undo .
      428     define output parameter p-field-list as character no-undo .
      429     define output parameter p-value-list as character no-undo.
      430     do
      431     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      432     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      433     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      434     :
      435       define variable v-full-tbl-name  as character no-undo .
      436       define variable bh_tbl-name      as handle    no-undo .
      437       define variable v-tbl-name       as character no-undo .
      438       define variable v-field-num      as integer   no-undo .
      439       define variable v-count-fld      as integer   no-undo .
      440       define variable v-inform         as character no-undo .
      441       define variable v-ind            as integer   no-undo .
      442       define variable v-idx-field-qnty as integer   no-undo .
      443       define variable v-delim-key      as character no-undo .
      444       if p-key-rec = ?
      445         or p-key-rec = "":U
      446       then do:
      447         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      448       end.
      449       assign
      450         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      451         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      452       .
      453       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      454       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      455       assign
      456         v-inform = bh_tbl-name:index-information(1)
      457         v-ind    = 2
      458       .
      459       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      460       on error undo, return error
      461       :
      462         assign
      463           v-inform = bh_tbl-name:index-information( v-ind )
      464           v-ind    = v-ind + 1
      465         .
      466       end.
      467       if v-inform = ?
      468         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      469         or entry( 3, v-inform, ",":U ) <> "1":U
      470       then do:
      471         delete object bh_tbl-name no-error.
      472         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      473       end.
      474       assign
      475         v-idx-field-qnty = num-entries( v-inform ) - 4
      476       .
      477       if v-idx-field-qnty < 2 then do:
      478         delete object bh_tbl-name no-error.
      479         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      480       end.
      481       assign
      482         p-field-list = "":U
      483         p-value-list = "":U
      484         v-delim-key  = "":U
      485         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      486         v-count-fld  = 0
      487       .
      488       block_where:
      489       do v-ind = 1 to v-idx-field-qnty by 2
      490       on error undo, return error
      491       :
      492         assign
      493           v-count-fld = v-count-fld + 1
      494         .
      495         if v-count-fld > v-field-num then do:
      496           leave block_where.
      497         end.
      498         assign
      499           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      500           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      501         .
      502         if v-ind = 1 then do:
      503           assign
      504             v-delim-key = chr(3)
      505           .
      506         end.
      507       end.
      508       delete object bh_tbl-name.
      509       if v-count-fld <> v-field-num then do:
      510         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      511       end.
      512     end.
      513   end procedure.
      514   procedure gen-key-field :
      515     define input  parameter p-table      as character no-undo .
      516     define output parameter p-field-list as character no-undo .
      517     do
      518     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      519     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      520     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      521     :
      522       define variable v-full-tbl-name  as character no-undo .
      523       define variable bh_tbl-name      as handle    no-undo .
      524       define variable v-tbl-name       as character no-undo .
      525       define variable v-field-num      as integer   no-undo .
      526       define variable v-count-fld      as integer   no-undo .
      527       define variable v-inform         as character no-undo .
      528       define variable v-ind            as integer   no-undo .
      529       define variable v-idx-field-qnty as integer   no-undo .
      530       define variable v-delim-key      as character no-undo .
      531       if p-table = ?
      532         or p-table = "":U
      533       then do:
      534         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      535       end.
      536       assign
      537         v-tbl-name      = p-table
      538         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      539       .
      540       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      541       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      542       assign
      543         v-inform = bh_tbl-name:index-information(1)
      544         v-ind    = 2
      545       .
      546       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      547       on error undo, return error
      548       :
      549         assign
      550           v-inform = bh_tbl-name:index-information( v-ind )
      551           v-ind    = v-ind + 1
      552         .
      553       end.
      554       if v-inform = ?
      555         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      556         or entry( 3, v-inform, ",":U ) <> "1":U
      557       then do:
      558         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      559       end.
      560       assign
      561         v-idx-field-qnty = num-entries( v-inform ) - 4
      562       .
      563       if v-idx-field-qnty < 2 then do:
      564         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      565       end.
      566       assign
      567         p-field-list = "":U
      568         v-delim-key  = "":U
      569         v-count-fld  = 0
      570       .
      571       block_where:
      572       do v-ind = 1 to v-idx-field-qnty by 2
      573       on error undo, return error
      574       :
      575         assign
      576           v-count-fld = v-count-fld + 1
      577         .
      578         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      579         if v-ind = 1 then do:
      580           assign
      581             v-delim-key = chr(3)
      582           .
      583         end.
      584       end.
      585       delete object bh_tbl-name.
      586     end.
      587   end procedure.
      588   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   procedure cur-time :
      590      define output parameter p-today as date      no-undo .
      591      define output parameter p-time  as integer   no-undo .
      592     do
      593     on error undo, return error
      594     :
      595       define variable v-date1 as date      no-undo .
      596       define variable v-date2 as date      no-undo .
      597       define variable v-time  as integer   no-undo .
      598       assign
      599         v-date1 = today
      600         v-time  = time
      601         v-date2 = today
      602       .
      603       if v-date1 <> v-date2
      604       then do:
      605         assign
      606           v-date1 = today
      607           v-time  = v-time
      608         .
      609       end.
      610       assign
      611         p-today = v-date1
      612         p-time  = v-time
      613       .
      614     end.
      615   end.
      616   function cur-time-date returns character
      617   :
      618     return string(today, '99/99/9999':U) .
      619   end.
      620   function cur-time-mjd returns decimal
      621   :
      622     define variable v-date as date      no-undo .
      623     define variable v-time as integer   no-undo .
      624     run cur-time in this-procedure
      625       (output v-date
      626       ,output v-time
      627       ) .
      628     return integer(v-date) - 2400002 + (v-time / 86400) .
      629   end.
      630   function cur-time-get-ending-index returns integer
      631   (input p-number as integer
      632   )
      633   :
      634     if p-number < 0
      635     or p-number = ?
      636     then do:
      637       return 1 .
      638     end.
      639     define variable v-rest as integer   no-undo .
      640     assign
      641       p-number = p-number modulo 100
      642     .
      643     if p-number < 20
      644     then do:
      645       assign
      646         v-rest = p-number
      647       .
      648     end.
      649     else do:
      650       assign
      651         v-rest = p-number modulo 10
      652       .
      653     end.
      654     case v-rest :
      655       when 1
      656       then do:
      657         return 2 .
      658       end.
      659       when 2 or
      660       when 3 or
      661       when 4
      662       then do:
      663         return 3 .
      664       end.
      665       otherwise do:
      666         return 1 .
      667       end.
      668     end case .
      669   end.
      670   procedure cur-time-mjd-to-date :
      671      define input  parameter i-mjd-diff as decimal no-undo.
      672      define output parameter o-Date     as date    no-undo.
      673      define output parameter o-Time     as integer no-undo.
      674      define variable v-day-number as integer   no-undo .
      675      if    i-mjd-diff < 0
      676         or i-mjd-diff = ?
      677      then do:
      678         return "?" .
      679      end.
      680      assign
      681         v-day-number = truncate(i-mjd-diff,0).
      682         o-Date = date(v-day-number + 2400002).
      683         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      684     .
      685   end.
      686   function cur-time-mjd-to-string returns character
      687   (input p-mjd-diff as decimal
      688   )
      689   :
      690     define variable v-day-number as integer   no-undo .
      691     define variable v-seconds    as integer   no-undo .
      692     define variable v-hour       as integer   no-undo .
      693     define variable v-min        as integer   no-undo .
      694     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      695     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      696     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      697     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      698     if p-mjd-diff < 0
      699     or p-mjd-diff = ?
      700     then do:
      701       return "?" .
      702     end.
      703     assign
      704       v-day-number = integer(truncate(p-mjd-diff,0))
      705       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      706     .
      707     if v-seconds > 86400
      708     then do:
      709       assign
      710         v-seconds = 86400 - 1
      711       .
      712     end.
      713     if v-seconds < 0
      714     then do:
      715       assign
      716         v-seconds = 0
      717       .
      718     end.
      719     assign
      720       v-hour = truncate(v-seconds / 3600, 0)
      721     .
      722     assign
      723       v-seconds = v-seconds modulo 3600
      724     .
      725     assign
      726       v-min = truncate(v-seconds / 60, 0)
      727     .
      728     assign
      729       v-seconds = v-seconds modulo 60
      730     .
      731     return
      732         (if v-day-number <> 0
      733           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      734           else ""
      735         )
      736       + (if v-day-number <> 0 or v-hour <> 0
      737           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      738           else ""
      739         )
      740       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      741           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      742           else ""
      743         )
      744       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      745       .
      746   end.
      747   function cur-time-string returns character
      748   :
      749     define variable v-date as date      no-undo .
      750     define variable v-time as integer   no-undo .
      751     run cur-time in this-procedure
      752       (output v-date
      753       ,output v-time
      754       ) .
      755     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      756   end.
      757   function cur-time-string-sec returns character
      758   :
      759     define variable v-date as date      no-undo .
      760     define variable v-time as integer   no-undo .
      761     run cur-time in this-procedure
      762       (output v-date
      763       ,output v-time
      764       ) .
      765     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      766   end.
      767   function cur-time-custom  returns character
      768   (input p-prefix as character
      769   ,input p-date-format as character
      770   ,input p-delimiter as character
      771   ,input p-time-format as character
      772   ,input p-suffix as character
      773   )
      774   :
      775     define variable v-date as date      no-undo .
      776     define variable v-time as integer   no-undo .
      777     run cur-time in this-procedure
      778       (output v-date
      779       ,output v-time
      780       ) .
      781     return
      782       p-prefix
      783       + string(v-date, p-date-format)
      784       + p-delimiter
      785       + string(v-time, p-time-format)
      786       + p-suffix
      787       .
      788   end.
      789   function cur-time-print  returns character
      790   :
      791     define variable v-date as date      no-undo .
      792     define variable v-time as integer   no-undo .
      793     run cur-time in this-procedure
      794       (output v-date
      795       ,output v-time
      796       ) .
      797     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      798   end.
      799   function cur-time-datetime returns datetime
      800   :
      801     define variable v-char as character no-undo .
      802     define variable v-datetime as datetime no-undo .
      803     v-char = cur-time-string().
      804     v-datetime = datetime(v-char).
      805     return  v-datetime.
      806   end.
      807   function cur-time-string-msec returns character
      808   :
      809     define variable v-date as datetime  no-undo .
      810     v-date = now.
      811     return string(v-date) .
      812   end.
      813   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      814   procedure discardh_write-dis-card-proc  :
      815   define parameter buffer buf_dis-card for ub.dis-card .
      816   define input parameter p-source-type like ub.c-dc-hist.source-type no-undo .
      817   define input parameter p-source-ref  like ub.c-dc-hist.source-ref no-undo .
      818   define variable v-date as date      no-undo.
      819   define variable v-time  as integer   no-undo.
      820   define buffer buf_c-dc-hist for ub.c-dc-hist.
      821   define buffer buf_c-dis-card for ub.c-dis-card.
      822     do
      823     on error undo, return error
      824     :
      825       if not available buf_dis-card then do:
      826         message
      827           vss-workfile vss-revision vss-description skip
      828           "Ошибка задания входных параметров" skip
      829           "Не определена ДК" skip
      830           view-as alert-box error .
      831         undo, return error .
      832       end.
      833       run cur-time in this-procedure(output v-date, output v-time).
      834       create buf_c-dis-card.
      835       buffer-copy buf_dis-card to buf_c-dis-card
      836       assign
      837       buf_c-dis-card.d-card             = buf_dis-card.d-card
      838       buf_c-dis-card.card-num           = buf_dis-card.card-num
      839       buf_c-dis-card.chip-num           = next-value (s-dc-chip, ub)
      840       buf_c-dis-card.corr-time          = v-time
      841       buf_c-dis-card.corr-user-db-num   = g#db-num
      842       buf_c-dis-card.corr-user-name     = (if g#news
      843                                            then (chr(4) +  'СПН':U)
      844                                            else (if g#esys
      845                                                  then (chr(4) +  'ВС':U)
      846                                                  else g#userid
      847                                                 )
      848                                            )
      849       buf_c-dis-card.corr-date          = v-date
      850       .
      851       create buf_c-dc-hist.
      852       buffer-copy buf_c-dis-card to buf_c-dc-hist
      853       assign
      854       buf_c-dc-hist.action =  integer('2':U)
      855       buf_c-dc-hist.subject = 'dis-card':U
      856       buf_c-dc-hist.host-code =  buf_dis-card.emitent-host-code
      857       buf_c-dc-hist.is-news = g#news
      858       buf_c-dc-hist.source-type = p-source-type
      859       buf_c-dc-hist.source-ref = p-source-ref
      860       .
      861       if not ( g#db-num > 0 )
      862       or (g#news
      863           and ( g#db-num > 0 )
      864           and buf_c-dis-card.corr-user-name = (chr(4) +  'СПН':U)
      865           )
      866       then do:
      867         run str/callnews.p
      868           (input 'c-dis-card':U
      869           ,input (buffer buf_c-dis-card:handle)
      870           ).
      871         run str/callnews.p
      872           (input 'c-dc-hist':U
      873           ,input (buffer buf_c-dc-hist:handle)
      874           ).
      875       end.
      876     end.
      877   end procedure.
      878   procedure block-del-dis-card :
      879   define input  parameter pc-db-num       like ub.db-rec-attr.db-num       no-undo .
      880   define input  parameter pc-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
      881   define input  parameter pc-attr-code    like ub.db-rec-attr.attr-code    no-undo .
      882   define input  parameter pc-parameters   as   character                   no-undo .
      883   define output parameter pc-err-msg      as   character                   no-undo .
      884     do
      885     on error undo, return error return-value
      886     :
      887       define variable v-rowid    as rowid     no-undo .
      888       define variable v-tbl-name as character no-undo .
      889       define variable v-is-prt-bar-code as logical no-undo .
      890       define variable l-terminal-prt as logical no-undo .
      891       define variable l-is-used as logical no-undo init yes.
      892       define variable v-old-status as character no-undo .
      893       define variable v-return-value as character no-undo .
      894       define buffer buf_dis-card for ub.dis-card.
      895       run gen-row-keyr in this-procedure
      896         ( input  pc-uniq-key-rec
      897          ,input ?
      898          ,input "ub":U
      899          ,input ?
      900          ,input share-lock
      901          ,output v-rowid
      902          ,output v-tbl-name
      903         ) no-error .
      904       if error-status :error then do:
      905         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. &3 &4", vss-workfile, pc-uniq-key-rec, chr(10), return-value ).
      906       end.
      907       if v-tbl-name <> 'dis-card':U then do:
      908         return error substitute( "&1. Данная процедура может работать только с таблицей ДК", vss-workfile ).
      909       end.
      910       find first buf_dis-card
      911         where rowid( buf_dis-card ) = v-rowid
      912         no-error .
      913       if not available buf_dis-card then do:
      914         return error substitute( "&1. Нет необходимой ДК &2", vss-workfile, pc-uniq-key-rec ).
      915       end.
      916       if buf_dis-card.status_ = 'неисп':U
      917       or buf_dis-card.status_ = 'смкли':U then do:
      918         assign
      919         pc-err-msg = substitute( "ДК &1 уже заблокирована или удалена!!! Блокировка невозможна!!!", pc-uniq-key-rec )
      920         .
      921         return .
      922       end.
      923       do
      924       on error undo, return error return-value
      925       on stop undo, return error return-value
      926       :
      927         run discardh_write-dis-card-proc in this-procedure  (
      928                                                       buffer buf_dis-card
      929                                                       ,input (if g#news
      930                                                               then 'db':U
      931                                                               else (if g#esys
      932                                                                     then 'esys':U
      933                                                                     else "":U)
      934                                                               )
      935                                                       ,input  (if g#news
      936                                                                 then string(g#news-source-db)
      937                                                                 else (if g#esys
      938                                                                       then string(g#esys-source-esys)
      939                                                                       else "":U)
      940                                                                 )
      941                                                     ) .
      942         assign
      943         v-old-status = buf_dis-card.status_
      944         buf_dis-card.status_ = 'неисп':U
      945         .
      946         run proc-is-used-dis-card in this-procedure ( buffer buf_dis-card
      947                                                    , input pc-db-num
      948                                                    , output l-is-used) no-error .
      949         v-return-value = return-value.
      950         if error-status :error
      951         then do:
      952           undo, return error substitute( "&1. Ошибка при проверке на использование ДК &2:&3&4"
      953                                         , vss-workfile
      954                                         , buf_dis-card.d-card
      955                                         , chr(10)
      956                                         , error-status:get-message(1)
      957                                         ).
      958         end.
      959         if l-is-used then do:
      960           run discardh_write-dis-card-proc in this-procedure  (
      961                                                         buffer buf_dis-card
      962                                                         ,input (if g#news
      963                                                                 then 'db':U
      964                                                                 else (if g#esys
      965                                                                       then 'esys':U
      966                                                                       else "":U)
      967                                                                 )
      968                                                         ,input  (if g#news
      969                                                                   then string(g#news-source-db)
      970                                                                   else (if g#esys
      971                                                                         then string(g#esys-source-esys)
      972                                                                         else "":U)
      973                                                                   )
      974                                                       ) .
      975           assign
      976           buf_dis-card.status_  = v-old-status
      977           pc-err-msg = substitute( "&1. ДК &2 используется:&3&4"
      978                                    , vss-workfile
      979                                    , buf_dis-card.d-card
      980                                    , chr(10)
      981                                    , v-return-value
      982                                     )
      983           .
      984           return pc-err-msg.
      985         end.
      986       end.
      987     end.
      988   end procedure.
      989   procedure delete-dis-card :
      990   define input  parameter pe-db-num       like ub.db-rec-attr.db-num       no-undo .
      991   define input  parameter pe-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
      992   define input  parameter pe-attr-code    like ub.db-rec-attr.attr-code    no-undo .
      993   define input  parameter pe-parameters   as   character                   no-undo .
      994   define output parameter pe-err-msg      as   character                   no-undo .
      995     do
      996     on error undo, return error return-value
      997     :
      998       define variable v-rowid            as rowid     no-undo .
      999       define variable v-tbl-name         as character no-undo .
     1000       define variable v_bp-rowid         as rowid     no-undo .
     1001       define variable v-d-card           like ub.dis-card.d-card no-undo .
     1002       define variable l-is-used          as logical    no-undo .
     1003       define variable v-old-status_      as character no-undo .
     1004       define variable v-return-value     as character no-undo .
     1005       define buffer buf_dis-card         for ub.dis-card .
     1006       define buffer buf_c-dc-hist        for ub.c-dc-hist .
     1007       define buffer buf_dis-card-property    for ub.dis-card-property .
     1008       define buffer buf_c-dis-card-property  for ub.c-dis-card-property .
     1009       define buffer buf_dis-obj          for ub.dis-obj .
     1010       define buffer buf_c-dis-obj        for ub.c-dis-obj .
     1011       define buffer buf_dis-host         for ub.dis-host .
     1012       define buffer buf_c-dis-host       for ub.c-dis-host .
     1013       run gen-row-keyr in this-procedure
     1014         ( input  pe-uniq-key-rec
     1015          ,input ?
     1016          ,input "ub":U
     1017          ,input ?
     1018          ,input share-lock
     1019          ,output v-rowid
     1020          ,output v-tbl-name
     1021         ) no-error .
     1022       if error-status :error then do:
     1023         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pe-uniq-key-rec, return-value ).
     1024       end.
     1025       if v-tbl-name <> 'dis-card':U then do:
     1026         return error substitute( "&1. Данная процедура может работать только с таблицей ДК", vss-workfile ).
     1027       end.
     1028       assign
     1029       v-d-card = entry(1, pe-parameters, chr(4))
     1030       v-old-status_ = entry(2, pe-parameters, chr(4))
     1031       .
     1032       find first buf_dis-card exclusive-lock where
     1033                 buf_dis-card.d-card = v-d-card no-wait no-error.
     1034       if not available buf_dis-card
     1035       and not locked(buf_dis-card) then do:
     1036         find first buf_dis-card no-lock where
     1037                     buf_dis-card.d-card = v-d-card no-error.
     1038         if not available buf_dis-card then return.
     1039       end.
     1040       if not available buf_dis-card then do:
     1041         return error substitute( "&1. Не найдена или занята ДК &2", vss-workfile, v-d-card ).
     1042       end.
     1043       if buf_dis-card.status_ <> 'неисп':U then do:
     1044         return error substitute( "&1. ДК &2 не заблокирована для удаления", vss-workfile, buf_dis-card.d-card ).
     1045       end.
     1046       run proc-is-used-dis-card in this-procedure ( buffer buf_dis-card, input pe-db-num, output l-is-used) no-error .
     1047       v-return-value = return-value .
     1048       if error-status :error
     1049       then do:
     1050         undo, return error substitute( "&1. Ошибка при проверке на использование ДК &2:&3&4"
     1051                                        , vss-workfile
     1052                                        , buf_dis-card.d-card
     1053                                        , chr(10)
     1054                                        , error-status:get-message(1)
     1055                                          ).
     1056       end.
     1057       if l-is-used then do:
     1058         undo, return error substitute( "&1. ДК &2 используется &3&4"
     1059                                       , vss-workfile
     1060                                       , buf_dis-card.d-card
     1061                                       , chr(10)
     1062                                       , v-return-value
     1063                                       ).
     1064       end.
     1065       do
     1066       on error undo, return error return-value
     1067       on stop undo, return error return-value
     1068       :
     1069         delete buf_dis-card.
     1070       end.
     1071     end.
     1072   end procedure.
     1073   procedure undo-delete-dis-card :
     1074   define input  parameter pr-db-num       like ub.db-rec-attr.db-num       no-undo .
     1075   define input  parameter pr-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1076   define input  parameter pr-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1077   define input  parameter pr-parameters   as   character                   no-undo .
     1078   define output parameter pr-err-msg      as   character                   no-undo .
     1079     do
     1080     on error undo, return error return-value
     1081     :
     1082       define variable v-rowid            as rowid     no-undo .
     1083       define variable v-tbl-name         as character no-undo .
     1084       define variable v_bp-rowid         as rowid     no-undo .
     1085       define variable v-d-card           like ub.dis-card.d-card no-undo .
     1086       define variable v-new              as logical no-undo .
     1087       define variable v-old-status_      as character no-undo .
     1088       define buffer buf_db-rec-attr    for ub.db-rec-attr .
     1089       define buffer buf_dis-card       for ub.dis-card    .
     1090       define buffer buf_c-dis-card     for ub.c-dis-card.
     1091       run gen-row-keyr in this-procedure
     1092         ( input  pr-uniq-key-rec
     1093          ,input ?
     1094          ,input "ub":U
     1095          ,input ?
     1096          ,input share-lock
     1097          ,output v-rowid
     1098          ,output v-tbl-name
     1099         ) no-error .
     1100       if error-status :error then do:
     1101         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pr-uniq-key-rec, return-value ).
     1102       end.
     1103       if v-tbl-name <> 'dis-card':U then do:
     1104         return error substitute( "&1. Данная процедура может работать только с таблицей ДК", vss-workfile ).
     1105       end.
     1106       assign
     1107       v-d-card = entry(1, pr-parameters, chr(4))
     1108       v-old-status_ = entry(2, pr-parameters, chr(4))
     1109       .
     1110       find first buf_dis-card exclusive-lock where
     1111                  rowid(buf_dis-card) = v-rowid no-error  .
     1112       if not available buf_dis-card then do:
     1113         find first buf_dis-card exclusive-lock where
     1114                    buf_dis-card.d-card = v-d-card no-error no-wait.
     1115         if not available buf_dis-card
     1116         AND not LOCKED(buf_dis-card)
     1117         then do:
     1118           find first buf_dis-card no-lock where
     1119                    buf_dis-card.d-card = v-d-card no-error.
     1120           if not available buf_dis-card then do:
     1121             find last buf_c-dis-card no-lock where
     1122                       buf_c-dis-card.d-card = v-d-card
     1123                   and buf_c-dis-card.corr-user-db-num = g#db-num no-error.
     1124             if available buf_c-dis-card then do:
     1125                create buf_dis-card.
     1126                buffer-copy buf_c-dis-card to buf_dis-card.
     1127                 run discardh_write-dis-card-proc in this-procedure  (
     1128                                                               buffer buf_dis-card
     1129                                                             ,input (if g#news
     1130                                                                     then 'db':U
     1131                                                                     else (if g#esys
     1132                                                                           then 'esys':U
     1133                                                                           else "":U)
     1134                                                                     )
     1135                                                             ,input  (if g#news
     1136                                                                       then string(g#news-source-db)
     1137                                                                       else (if g#esys
     1138                                                                             then string(g#esys-source-esys)
     1139                                                                             else "":U)
     1140                                                                       )
     1141                                                             ) .
     1142                assign
     1143                buf_dis-card.status_ = v-old-status_
     1144                .
     1145                return.
     1146             end.
     1147           end.
     1148           return error substitute( "&1. Не найдена или занята ДК &2", vss-workfile, v-d-card ).
     1149         end.
     1150       end.
     1151       do
     1152       on error undo, return error return-value
     1153       on stop undo, return error return-value
     1154       :
     1155         if buf_dis-card.status_ = 'неисп':U then do:
     1156           run discardh_write-dis-card-proc in this-procedure  (
     1157                                                         buffer buf_dis-card
     1158                                                       ,input (if g#news
     1159                                                               then 'db':U
     1160                                                               else (if g#esys
     1161                                                                     then 'esys':U
     1162                                                                     else "":U)
     1163                                                               )
     1164                                                       ,input  (if g#news
     1165                                                                 then string(g#news-source-db)
     1166                                                                 else (if g#esys
     1167                                                                       then string(g#esys-source-esys)
     1168                                                                       else "":U)
     1169                                                                 )
     1170                                                       ) .
     1171           assign
     1172           buf_dis-card.status_ = v-old-status_
     1173           .
     1174           release buf_dis-card.
     1175         end.
     1176       end.
     1177     end.
     1178   end procedure.
     1179   procedure proc-is-used-dis-card :
     1180   define parameter buffer buf_dis-card for ub.dis-card.
     1181   define input parameter p-db-num like ub.db.db-num no-undo .
     1182   define output parameter p-is-used as logical no-undo init yes.
     1183     do
     1184     on error undo, return error return-value
     1185     :
     1186       define buffer buf_dis-card-property for ub.dis-card-property.
     1187       define buffer buf_dis-obj for ub.dis-obj.
     1188       define buffer buf2_dis-card for ub.dis-card.
     1189       define buffer buf_dis-host for ub.dis-host.
     1190       define buffer buf_chk-doc for ub.chk-doc.
     1191       define buffer buf_clients for ub.clients.
     1192       define buffer buf_payment for ub.payment.
     1193       define buffer buf_sysconf for ub.sysconf.
     1194       for each buf2_dis-card no-lock where
     1195               buf2_dis-card.card-num = buf_dis-card.card-num:
     1196         if buf2_dis-card.d-card = buf_dis-card.d-card then next.
     1197         return substitute("dis-card Перевыпущенная карта &1 для карты &2", buf2_dis-card.d-card, buf_dis-card.d-card).
     1198       end.
     1199       for each buf_sysconf,
     1200           each buf_payment no-lock where
     1201               buf_payment.cli-type = buf_dis-card.cli-type
     1202           and buf_payment.cli-code = buf_dis-card.cli-code
     1203           and buf_payment.d-card = buf_dis-card.d-card :
     1204         return substitute("payment Платеж &1 на фирму &2 для карты &2", buf_payment.pmnt-code, buf_payment.host-code, buf_dis-card.d-card).
     1205       end.
     1206       for each buf_clients no-lock where
     1207               buf_clients.obj-type = 'маг':U
     1208           and buf_clients.db-num = g#db-num:
     1209          find first buf_chk-doc no-lock where
     1210                   buf_chk-doc.obj-type = buf_Clients.obj-type
     1211               and buf_chk-doc.obj-code = buf_Clients.obj-code
     1212               and buf_chk-doc.d-card = buf_dis-card.d-card no-error.
     1213          if available buf_chk-doc then do:
     1214            return substitute("chk-doc Чек &1 для карты &2", buf_chk-doc.doc-code, buf_dis-card.d-card).
     1215          end.
     1216       end.
     1217       for each buf_dis-obj no-lock where
     1218               buf_dis-obj.d-card = buf_dis-card.d-card:
     1219         if buf_dis-obj.pay-tot-rubl <> 0
     1220         or buf_dis-obj.num-chk <> 0
     1221         or buf_dis-obj.gds-tot-rubl <> 0  then do:
     1222           return substitute("dis-obj Итоги на объекте &1&2 для карты &3", buf_dis-obj.obj-type, buf_dis-obj.obj-code, buf_dis-card.d-card).
     1223         end.
     1224       end.
     1225       for each buf_dis-host no-lock where
     1226               buf_dis-host.d-card = buf_dis-card.d-card:
     1227         if buf_dis-host.pay-tot-rubl <> 0
     1228         or buf_dis-host.num-chk <> 0
     1229         or buf_dis-host.gds-tot-rubl <> 0  then do:
     1230           if buf_dis-host.host-code > 0 then
     1231           return substitute("dis-host Итоги на фирме &1 для карты &2", buf_dis-host.host-code, buf_dis-card.d-card).
     1232           else
     1233           return substitute("dis-host Глобальные итоги").
     1234         end.
     1235       end.
     1236       assign
     1237       p-is-used = no
     1238       .
     1239       return "":U.
     1240     end.
     1241   end procedure.
     1242   procedure block-chown-dis-card :
     1243   define input  parameter pc-db-num       like ub.db-rec-attr.db-num       no-undo .
     1244   define input  parameter pc-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1245   define input  parameter pc-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1246   define input  parameter pc-parameters   as   character                   no-undo .
     1247   define output parameter pc-err-msg      as   character                   no-undo .
     1248     do
     1249     on error undo, return error return-value
     1250     :
     1251       define variable v-rowid    as rowid     no-undo .
     1252       define variable v-tbl-name as character no-undo .
     1253       define variable v-is-prt-bar-code as logical no-undo .
     1254       define variable l-terminal-prt as logical no-undo .
     1255       define variable l-is-used as logical no-undo init yes.
     1256       define variable v-old-status as character no-undo .
     1257       define variable v-return-value as character no-undo .
     1258       define buffer buf_dis-card for ub.dis-card.
     1259       run gen-row-keyr in this-procedure
     1260         ( input  pc-uniq-key-rec
     1261          ,input ?
     1262          ,input "ub":U
     1263          ,input ?
     1264          ,input share-lock
     1265          ,output v-rowid
     1266          ,output v-tbl-name
     1267         ) no-error .
     1268       if error-status :error then do:
     1269         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. &3 &4", vss-workfile, pc-uniq-key-rec, chr(10), return-value ).
     1270       end.
     1271       if v-tbl-name <> 'dis-card':U then do:
     1272         return error substitute( "&1. Данная процедура может работать только с таблицей ДК", vss-workfile ).
     1273       end.
     1274       find first buf_dis-card
     1275         where rowid( buf_dis-card ) = v-rowid
     1276         no-error .
     1277       if not available buf_dis-card then do:
     1278         return error substitute( "&1. Нет необходимой ДК &2", vss-workfile, pc-uniq-key-rec ).
     1279       end.
     1280       if buf_dis-card.status_ = 'смкли':U
     1281       or buf_dis-card.status_ = 'неисп':U
     1282       then do:
     1283         assign
     1284         pc-err-msg = substitute( "ДК &1 уже заблокирована или удалена!!! Блокировка невозможна!!!", pc-uniq-key-rec )
     1285         .
     1286         return .
     1287       end.
     1288       do
     1289       on error undo, return error return-value
     1290       on stop undo, return error return-value
     1291       :
     1292         run discardh_write-dis-card-proc in this-procedure  (
     1293                                                       buffer buf_dis-card
     1294                                                       ,input (if g#news
     1295                                                               then 'db':U
     1296                                                               else (if g#esys
     1297                                                                     then 'esys':U
     1298                                                                     else "":U)
     1299                                                               )
     1300                                                       ,input  (if g#news
     1301                                                                 then string(g#news-source-db)
     1302                                                                 else (if g#esys
     1303                                                                       then string(g#esys-source-esys)
     1304                                                                       else "":U)
     1305                                                                 )
     1306                                                     ) .
     1307         assign
     1308         v-old-status = buf_dis-card.status_
     1309         buf_dis-card.status_ = 'неисп':U
     1310         .
     1311         run proc-is-used-trn-doc-dis-card in this-procedure ( buffer buf_dis-card
     1312                                                             , input pc-db-num
     1313                                                             , output l-is-used) no-error .
     1314         v-return-value = return-value .
     1315         if error-status :error
     1316         then do:
     1317           undo, return error substitute( "&1. Ошибка при проверке на использование ДК &2:&3&4"
     1318                                         , vss-workfile
     1319                                         , buf_dis-card.d-card
     1320                                         , chr(10)
     1321                                         , error-status:get-message(1)
     1322                                         ).
     1323         end.
     1324         if l-is-used then do:
     1325           run discardh_write-dis-card-proc in this-procedure  (
     1326                                                         buffer buf_dis-card
     1327                                                       ,input (if g#news
     1328                                                               then 'db':U
     1329                                                               else (if g#esys
     1330                                                                     then 'esys':U
     1331                                                                     else "":U)
     1332                                                               )
     1333                                                       ,input  (if g#news
     1334                                                                 then string(g#news-source-db)
     1335                                                                 else (if g#esys
     1336                                                                       then string(g#esys-source-esys)
     1337                                                                       else "":U)
     1338                                                                 )
     1339                                                       ) .
     1340           assign
     1341           buf_dis-card.status_  = v-old-status
     1342           pc-err-msg = substitute( "&1. ДК &2 используется:&3&4"
     1343                                     , vss-workfile
     1344                                     , buf_dis-card.d-card
     1345                                     , chr(10)
     1346                                     , v-return-value
     1347                                     )
     1348           .
     1349           return pc-err-msg.
     1350         end.
     1351       end.
     1352     end.
     1353   end procedure.
     1354   procedure chown-dis-card :
     1355   define input  parameter pe-db-num       like ub.db-rec-attr.db-num       no-undo .
     1356   define input  parameter pe-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1357   define input  parameter pe-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1358   define input  parameter pe-parameters   as   character                   no-undo .
     1359   define output parameter pe-err-msg      as   character                   no-undo .
     1360     do
     1361     on error undo, return error return-value
     1362     :
     1363       define variable v-rowid            as rowid     no-undo .
     1364       define variable v-tbl-name         as character no-undo .
     1365       define variable v_bp-rowid         as rowid     no-undo .
     1366       define variable v-d-card           like ub.dis-card.d-card no-undo .
     1367       define variable l-is-used          as logical    no-undo .
     1368       define variable v-old-status_      as character no-undo .
     1369       define variable v-cli-type         like ub.dis-card.cli-type.
     1370       define variable v-cli-code         like ub.dis-card.cli-code.
     1371       define variable v-old-cli-type     like ub.dis-card.cli-type.
     1372       define variable v-old-cli-code     like ub.dis-card.cli-code.
     1373       define variable v-return-value     as character no-undo .
     1374       define buffer buf_dis-card         for ub.dis-card .
     1375       run gen-row-keyr in this-procedure
     1376         ( input  pe-uniq-key-rec
     1377          ,input ?
     1378          ,input "ub":U
     1379          ,input ?
     1380          ,input share-lock
     1381          ,output v-rowid
     1382          ,output v-tbl-name
     1383         ) no-error .
     1384       if error-status :error then do:
     1385         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pe-uniq-key-rec, return-value ).
     1386       end.
     1387       if v-tbl-name <> 'dis-card':U then do:
     1388         return error substitute( "&1. Данная процедура может работать только с таблицей ДК", vss-workfile ).
     1389       end.
     1390       assign
     1391       v-d-card = entry(1, pe-parameters, chr(4))
     1392       v-old-status_ = entry(2, pe-parameters, chr(4))
     1393       v-cli-type = entry(3, pe-parameters, chr(4))
     1394       v-cli-code = integer(entry(4, pe-parameters, chr(4)))
     1395       v-old-cli-type = entry(5, pe-parameters, chr(4))
     1396       v-old-cli-code = integer(entry(6, pe-parameters, chr(4)))
     1397       .
     1398       find first buf_dis-card exclusive-lock where
     1399                 buf_dis-card.d-card = v-d-card no-wait no-error.
     1400       if not available buf_dis-card
     1401       and not locked(buf_dis-card) then do:
     1402         find first buf_dis-card no-lock where
     1403                     buf_dis-card.d-card = v-d-card no-error.
     1404         if not available buf_dis-card then return.
     1405       end.
     1406       if not available buf_dis-card then do:
     1407         return error substitute( "&1. Не найдена или занята ДК &2", vss-workfile, v-d-card ).
     1408       end.
     1409       if buf_dis-card.status_ <> 'смкли':U then do:
     1410         return error substitute( "&1. ДК &2 не заблокирована для смены владельца", vss-workfile, buf_dis-card.d-card ).
     1411       end.
     1412       run proc-is-used-trn-doc-dis-card in this-procedure ( buffer buf_dis-card, input pe-db-num, output l-is-used) no-error .
     1413       v-return-value = return-value .
     1414       if error-status :error
     1415       then do:
     1416         undo, return error substitute( "&1. Ошибка при проверке на использование ДК &2:&3&4"
     1417                                        , vss-workfile
     1418                                        , buf_dis-card.d-card
     1419                                        , chr(10)
     1420                                        , error-status:get-message(1)
     1421                                          ).
     1422       end.
     1423       if l-is-used then do:
     1424         undo, return error substitute( "&1. ДК &2 используется &3&4"
     1425                                       , vss-workfile
     1426                                       , buf_dis-card.d-card
     1427                                       , chr(10)
     1428                                       , v-return-value
     1429                                       ).
     1430       end.
     1431       do
     1432       on error undo, return error return-value
     1433       on stop undo, return error return-value
     1434       :
     1435          run proc-chown-dis-card in this-procedure ( buffer buf_dis-card
     1436                                                     ,input v-cli-type
     1437                                                     ,input v-cli-code
     1438                                                     ).
     1439       end.
     1440     end.
     1441   end procedure.
     1442   procedure undo-chown-dis-card :
     1443   define input  parameter pr-db-num       like ub.db-rec-attr.db-num       no-undo .
     1444   define input  parameter pr-uniq-key-rec like ub.db-rec-attr.uniq-key-rec no-undo .
     1445   define input  parameter pr-attr-code    like ub.db-rec-attr.attr-code    no-undo .
     1446   define input  parameter pr-parameters   as   character                   no-undo .
     1447   define output parameter pr-err-msg      as   character                   no-undo .
     1448     do
     1449     on error undo, return error return-value
     1450     :
     1451       define variable v-rowid            as rowid     no-undo .
     1452       define variable v-tbl-name         as character no-undo .
     1453       define variable v_bp-rowid         as rowid     no-undo .
     1454       define variable v-d-card           like ub.dis-card.d-card no-undo .
     1455       define variable v-new              as logical no-undo .
     1456       define variable v-old-status_      as character no-undo .
     1457       define variable v-cli-type         like ub.dis-card.cli-type.
     1458       define variable v-cli-code         like ub.dis-card.cli-code.
     1459       define variable v-old-cli-type     like ub.dis-card.cli-type.
     1460       define variable v-old-cli-code     like ub.dis-card.cli-code.
     1461       define buffer buf_db-rec-attr    for ub.db-rec-attr .
     1462       define buffer buf_dis-card       for ub.dis-card    .
     1463       run gen-row-keyr in this-procedure
     1464         ( input  pr-uniq-key-rec
     1465          ,input ?
     1466          ,input "ub":U
     1467          ,input ?
     1468          ,input share-lock
     1469          ,output v-rowid
     1470          ,output v-tbl-name
     1471         ) no-error .
     1472       if error-status :error then do:
     1473         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pr-uniq-key-rec, return-value ).
     1474       end.
     1475       if v-tbl-name <> 'dis-card':U then do:
     1476         return error substitute( "&1. Данная процедура может работать только с таблицей ДК", vss-workfile ).
     1477       end.
     1478       assign
     1479       v-d-card = entry(1, pr-parameters, chr(4))
     1480       v-old-status_ = entry(2, pr-parameters, chr(4))
     1481       v-cli-type = entry(3, pr-parameters, chr(4))
     1482       v-cli-code = integer(entry(4, pr-parameters, chr(4)))
     1483       v-old-cli-type = entry(5, pr-parameters, chr(4))
     1484       v-old-cli-code = integer(entry(6, pr-parameters, chr(4)))
     1485       .
     1486       find first buf_dis-card exclusive-lock where
     1487                  rowid(buf_dis-card) = v-rowid no-error  .
     1488       if not available buf_dis-card then do:
     1489         find first buf_dis-card exclusive-lock where
     1490                    buf_dis-card.d-card = v-d-card no-error no-wait.
     1491         if not available buf_dis-card
     1492         AND not LOCKED(buf_dis-card)
     1493         then do:
     1494           find first buf_dis-card no-lock where
     1495                    buf_dis-card.d-card = v-d-card no-error.
     1496           if not available buf_dis-card then do:
     1497             return .
     1498           end.
     1499           return error substitute( "&1. Не найдена или занята ДК &2", vss-workfile, v-d-card ).
     1500         end.
     1501       end.
     1502       do
     1503       on error undo, return error return-value
     1504       on stop undo, return error return-value
     1505       :
     1506         if not (buf_dis-card.cli-type = v-old-cli-type
     1507           and    buf_dis-card.cli-code = v-old-cli-code) then do:
     1508           run proc-chown-dis-card in this-procedure ( buffer buf_dis-card
     1509                                                       ,input v-old-cli-type
     1510                                                       ,input v-old-cli-code
     1511                                                       ).
     1512         end.
     1513       end.
     1514     end.
     1515   end procedure.
     1516   procedure after-chown-dis-card :
     1517   define input  parameter pa-action       as character no-undo .
     1518   define input  parameter pa-uniq-key-rec as character no-undo .
     1519   define input  parameter pa-db-init      as integer   no-undo .
     1520   define input  parameter pa-parameters   as character no-undo .
     1521   define output parameter pa-err-msg      as character no-undo .
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525       define variable v-rowid            as rowid     no-undo .
     1526       define variable v-tbl-name         as character no-undo .
     1527       define variable v_bp-rowid         as rowid     no-undo .
     1528       define variable v-d-card           like ub.dis-card.d-card no-undo .
     1529       define variable l-is-used          as logical    no-undo .
     1530       define variable v-old-status_      as character no-undo .
     1531       define variable v-cli-type         like ub.dis-card.cli-type.
     1532       define variable v-cli-code         like ub.dis-card.cli-code.
     1533       define variable v-old-cli-type     like ub.dis-card.cli-type.
     1534       define variable v-old-cli-code     like ub.dis-card.cli-code.
     1535       define buffer buf_dis-card         for ub.dis-card .
     1536       run gen-row-keyr in this-procedure
     1537         ( input  pa-uniq-key-rec
     1538          ,input ?
     1539          ,input "ub":U
     1540          ,input ?
     1541          ,input share-lock
     1542          ,output v-rowid
     1543          ,output v-tbl-name
     1544         ) no-error .
     1545       if error-status :error then do:
     1546         return error substitute( "&1. Ошибка при определении rowid записи для ключа &2. chr(10) &3", vss-workfile, pa-uniq-key-rec, return-value ).
     1547       end.
     1548       if v-tbl-name <> 'dis-card':U then do:
     1549         return error substitute( "&1. Данная процедура может работать только с таблицей ДК", vss-workfile ).
     1550       end.
     1551       assign
     1552       v-d-card = entry(1, pa-parameters, chr(4))
     1553       v-old-status_ = entry(2, pa-parameters, chr(4))
     1554       v-cli-type = entry(3, pa-parameters, chr(4))
     1555       v-cli-code = integer(entry(4, pa-parameters, chr(4)))
     1556       v-old-cli-type = entry(5, pa-parameters, chr(4))
     1557       v-old-cli-code = integer(entry(6, pa-parameters, chr(4)))
     1558       .
     1559       find first buf_dis-card exclusive-lock where
     1560                 buf_dis-card.d-card = v-d-card no-wait no-error.
     1561       if not available buf_dis-card
     1562       and not locked(buf_dis-card) then do:
     1563         find first buf_dis-card no-lock where
     1564                     buf_dis-card.d-card = v-d-card no-error.
     1565         if not available buf_dis-card then return.
     1566       end.
     1567       if not available buf_dis-card then do:
     1568         return error substitute( "&1. Не найдена или занята ДК &2", vss-workfile, v-d-card ).
     1569       end.
     1570       do
     1571       on error undo, return error return-value
     1572       on stop undo, return error return-value
     1573       :
     1574          if buf_dis-card.status_ = 'смкли':U then do:
     1575             run discardh_write-dis-card-proc in this-procedure  (
     1576                                                           buffer buf_dis-card
     1577                                                         ,input (if g#news
     1578                                                                 then 'db':U
     1579                                                                 else (if g#esys
     1580                                                                       then 'esys':U
     1581                                                                       else "":U)
     1582                                                                 )
     1583                                                         ,input  (if g#news
     1584                                                                   then string(g#news-source-db)
     1585                                                                   else (if g#esys
     1586                                                                         then string(g#esys-source-esys)
     1587                                                                         else "":U)
     1588                                                                   )
     1589                                                         ) .
     1590           assign
     1591           buf_dis-card.status_ = v-old-status_
     1592           .
     1593         end.
     1594       end.
     1595     end.
     1596   end procedure.
     1597   procedure proc-is-used-trn-doc-dis-card :
     1598   define parameter buffer buf_dis-card for ub.dis-card.
     1599   define input parameter p-db-num like ub.db.db-num no-undo .
     1600   define output parameter p-is-used as logical no-undo init yes.
     1601     do
     1602     on error undo, return error return-value
     1603     :
     1604       define buffer buf_dis-card-property for ub.dis-card-property.
     1605       define buffer buf_dis-obj for ub.dis-obj.
     1606       define buffer buf2_dis-card for ub.dis-card.
     1607       define buffer buf_clients for ub.clients.
     1608       define buffer buf_sysconf for ub.sysconf.
     1609       define buffer buf_payment for ub.payment.
     1610       define buffer buf_trn-doc for ub.trn-doc.
     1611       for each buf2_dis-card no-lock where
     1612               buf2_dis-card.card-num = buf_dis-card.card-num:
     1613         if buf2_dis-card.d-card = buf_dis-card.d-card then next.
     1614         return substitute("dis-card Перевыпущенная карта &1 для карты &2", buf2_dis-card.d-card, buf_dis-card.d-card).
     1615       end.
     1616       for each buf_sysconf,
     1617           each buf_payment no-lock where
     1618               buf_payment.cli-type = buf_dis-card.cli-type
     1619           and buf_payment.cli-code = buf_dis-card.cli-code
     1620           and buf_payment.d-card = buf_dis-card.d-card :
     1621         if buf_payment.source-type <> 'касс':U then do:
     1622           return substitute("payment Платеж &1 на фирму &2 для документа &3 для карты &4"
     1623                            , buf_payment.pmnt-code
     1624                            , buf_payment.host-code
     1625                            , buf_payment.source-ref
     1626                            , buf_dis-card.d-card
     1627                            ).
     1628         end.
     1629       end.
     1630       for each buf_clients no-lock where
     1631              buf_clients.db-num = g#db-num:
     1632          for each buf_trn-doc no-lock where
     1633                   buf_trn-doc.obj-type = buf_Clients.obj-type
     1634               and buf_trn-doc.obj-code = buf_Clients.obj-code
     1635               and buf_trn-doc.cli-type = buf_dis-card.cli-type
     1636               and buf_trn-doc.cli-code = buf_dis-card.cli-code:
     1637            if buf_trn-doc.d-card = buf_dis-card.d-card then do:
     1638              return substitute("trn-doc Документ &1 для карты &2", buf_trn-doc.doc-code, buf_dis-card.d-card).
     1639            end.
     1640          end.
     1641       end.
     1642       assign
     1643       p-is-used = no
     1644       .
     1645       return "":U.
     1646     end.
     1647   end procedure.
     1648   procedure proc-chown-dis-card :
     1649   define parameter buffer buf_dis-card for ub.dis-card.
     1650   define input parameter p-cli-type like ub.dis-card.cli-type no-undo .
     1651   define input parameter p-cli-code like ub.dis-card.cli-code no-undo .
     1652   define variable v-is-update as logical no-undo .
     1653   define variable v-chip-num as integer no-undo .
     1654   define buffer buf_chk-doc          for ub.chk-doc .
     1655   define buffer buf_chk-gds          for ub.chk-gds .
     1656   define buffer buf_clients          for ub.clients.
     1657   define buffer buf_sysconf          for ub.sysconf.
     1658   define buffer buf_payment          for ub.payment.
     1659     do
     1660     on error undo, return error return-value
     1661     :
     1662       for each buf_sysconf,
     1663           each buf_payment where
     1664               buf_payment.host-code = buf_sysconf.host-code
     1665           and buf_payment.d-card = buf_dis-card.d-card
     1666       on error undo, return error return-value
     1667           :
     1668         if buf_payment.source-type = 'касс':U then do:
     1669           if buf_payment.payer-type = buf_payment.cli-type
     1670           and buf_payment.payer-code = buf_payment.cli-code
     1671           then
     1672           assign
     1673           buf_payment.payer-type = p-cli-type
     1674           buf_payment.payer-code = p-cli-code
     1675           .
     1676           assign
     1677           buf_payment.cli-type = p-cli-type
     1678           buf_payment.cli-code = p-cli-code
     1679           .
     1680         end.
     1681       end.
     1682       for each buf_clients no-lock where
     1683               buf_clients.obj-type = 'маг':U:
     1684         for each buf_chk-doc where
     1685                   buf_chk-doc.obj-type = buf_Clients.obj-type
     1686               and buf_chk-doc.obj-code = buf_Clients.obj-code
     1687               and buf_chk-doc.d-card = buf_dis-card.d-card:
     1688             run trg/chk-doch.p (
     1689                             buffer buf_chk-doc
     1690                           , input no
     1691                           , input no
     1692                           , input no
     1693                           , input-output v-chip-num
     1694                           , output v-is-update).
     1695           for each buf_chk-gds where
     1696                   buf_chk-gds.doc-code = buf_chk-doc.doc-code:
     1697             if buf_chk-gds.d-card = buf_dis-card.d-card
     1698             then
     1699             assign
     1700             buf_chk-gds.cli-type = p-cli-type
     1701             buf_chk-gds.cli-code = p-cli-code
     1702             .
     1703           end.
     1704           assign
     1705           buf_chk-doc.cli-type = p-cli-type
     1706           buf_chk-doc.cli-code = p-cli-code
     1707           .
     1708           run trg/chk-doch.p (
     1709                           buffer buf_chk-doc
     1710                         , input yes
     1711                         , input no
     1712                         , input no
     1713                         , input-output v-chip-num
     1714                         , output v-is-update).
     1715         end.
     1716         assign
     1717         buf_dis-card.cli-type = p-cli-type
     1718         buf_dis-card.cli-code = p-cli-code
     1719         .
     1720       end.
     1721     end.
     1722   end procedure.
