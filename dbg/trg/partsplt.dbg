      456     on error undo, return error return-value
      457     :
      458       if substring(buf_parts-attr.part-code, 1, length(v-new-part-code)) = v-new-part-code
      459       then do:
      460         assign
      461           v-ind-part-code
      462             = integer(substring(buf_parts-attr.part-code, length(v-new-part-code) + 1 ) )
      463           no-error
      464         .
      465         if error-status :error = false
      466         then do:
      467           if v-ind-part-code > v-ind
      468           then do:
      469             assign
      470               v-ind = v-ind-part-code
      471             .
      472           end.
      473         end.
      474       end.
      475     end.
      476     run gbl/fldfrmt.p
      477       (input  "parts"
      478       ,input  "part-code"
      479       ,output v-part-code-format
      480       ) .
      481     for each temp-parts-qnty
      482     on error undo, return error return-value
      483     :
      484       assign
      485         v-ind = v-ind + 1
      486       .
      487       find first buf_parts-attr no-lock
      488         where buf_parts-attr.in-code   = ub.parts.in-code
      489           and buf_parts-attr.gds-code  = v-gds-code
      490           and buf_parts-attr.part-code = ub.parts.part-code
      491         no-error .
      492       if not available buf_parts-attr
      493       then do:
      494         message
      495           vss-workfile vss-revision vss-description skip
      496           "Не найден атрибут партии" skip
      497           "Невозможно произвести разбиение партии" skip
      498           "Объект" p-obj-type p-obj-code skip
      499           "Артикул" p-artic p-prod-type p-prod-code skip
      500           "Партия" p-in-code p-part-code skip
      501           "Документ" p-out-code skip
      502           view-as alert-box error .
      503         undo, return error return-value .
      504       end.
      505       define variable v-cli-base-rate as decimal   no-undo .
      506       if v-spacial-doc = true then do:
      507         assign
      508           v-cli-base-rate = ub.parts.cli-base-rate
      509         .
      510       end.
      511       else do:
      512         assign
      513           v-cli-base-rate = temp-parts-qnty.fact-qnty / temp-parts-qnty.cli-qnty
      514         .
      515       end.
      516       if v-cli-base-rate = ?
      517       then do:
      518         message
      519           vss-workfile vss-revision vss-description skip
      520           "Ошибка при определении v-cli-base-rate" skip
      521           "Невозможно произвести разбиение партии" skip
      522           "Объект" p-obj-type p-obj-code skip
      523           "Артикул" p-artic p-prod-type p-prod-code skip
      524           "Партия" p-in-code p-part-code skip
      525           "Документ" p-out-code skip
      526           "Фактическое количество" temp-parts-qnty.fact-qnty skip
      527           "Количество поставщика" temp-parts-qnty.cli-qnty skip
      528           view-as alert-box error .
      529         undo, return error return-value .
      530       end.
      531       create buf_parts .
      532       buffer-copy ub.parts to buf_parts
      533       assign
      534         buf_parts.part-code     = string(v-new-part-code + string(v-ind), v-part-code-format)
      535         buf_parts.out-code      = ub.parts.out-code
      536         buf_parts.status_       = ub.parts.status_
      537         buf_parts.doc-type      = ub.parts.doc-type
      538         buf_parts.rsrv-free     = ub.parts.rsrv-free
      539         buf_parts.qnty          = temp-parts-qnty.qnty
      540         buf_parts.fact-qnty     = temp-parts-qnty.fact-qnty
      541         buf_parts.cli-qnty      = temp-parts-qnty.cli-qnty
      542         buf_parts.cli-base-rate = v-cli-base-rate
      543       .
      544       if temp-parts-qnty.pl-code <> ?
      545         and temp-parts-qnty.pl-code <> 0
      546       then do:
      547         assign
      548           buf_parts.pl-code = temp-parts-qnty.pl-code
      549         .
      550       end.
      551       validate buf_parts .
      552       if v-cur-db-num <> 0
      553         and v-spacial-doc <> true
      554       then do:
      555         run add-dump in v-cmd-proc-handle
      556           (input v-cmd-code1
      557           ,input 'parts':U
      558           ,input '+update':U
      559           ,input (buffer buf_parts :handle)
      560           ,input '':U
      561           ,output v-rec-ord
      562           ) no-error .
      563         if error-status :error
      564         then do:
      565           message
      566             vss-workfile vss-revision vss-description skip
      567             substitute( "Ошибка при добавлении записи &1 в команду с кодом &2", 'parts':U, v-cmd-code1 ) skip
      568             error-status :get-message(1) skip
      569             return-value skip
      570             view-as alert-box error .
      571           delete procedure v-cmd-proc-handle .
      572           undo, return error return-value .
      573         end.
      574       end.
      575       create new_parts-attr .
      576       buffer-copy buf_parts-attr to new_parts-attr
      577       assign
      578         new_parts-attr.in-code        = buf_parts.in-code
      579         new_parts-attr.gds-code       = v-gds-code
      580         new_parts-attr.part-code      = buf_parts.part-code
      581         new_parts-attr.orig-in-code   = buf_parts-attr.in-code
      582         new_parts-attr.orig-gds-code  = buf_parts-attr.gds-code
      583         new_parts-attr.orig-part-code = buf_parts-attr.part-code
      584       .
      585       validate new_parts-attr .
      586       if l-create-bar-code
      587       then do:
      588         define variable v-bar-code-is-new as logical no-undo .
      589         define variable v-root-node like ub.gds-prt.node-code no-undo .
      590   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      592     (input  p-artic
      593     ,input  p-prod-type
      594     ,input  p-prod-code
      595     ,output v-root-node
      596     )  .
      597         find first buf_goods no-lock
      598           where buf_goods.artic     = p-artic
      599             and buf_goods.prod-type = p-prod-type
      600             and buf_goods.prod-code = p-prod-code
      601           .
      602   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
      604     (input  buf_goods.gds-code
      605     ,input  v-root-node
      606     ,input  buf_parts.part-code
      607     ,input  buf_parts.in-code
      608     ,input  buf_goods.unit-base
      609     ,input  ?
      610     ,output v-bar-code-is-new
      611     ,buffer buf_bar-code
      612     ) no-error .
      613         if error-status :error
      614         then do:
      615           message
      616             vss-workfile vss-revision vss-description skip
      617             "Ошибка при создании бар-кода партии" skip
      618             error-status :get-message(1) skip
      619             return-value skip
      620             view-as alert-box error .
      621           undo, return error return-value .
      622         end.
      623       end.
      624     end.
      625     create buf_temp-parts .
      626     buffer-copy ub.parts to buf_temp-parts
      627     assign
      628       buf_temp-parts.qnty      = - v-total-qnty
      629       buf_temp-parts.fact-qnty = - v-total-fact-qnty
      630       buf_temp-parts.cli-qnty  = - v-total-cli-qnty
      631     .
      632     if v-cur-db-num <> 0
      633       and v-spacial-doc <> true
      634     then do:
      635       run add-dump in v-cmd-proc-handle
      636         (input v-cmd-code1
      637         ,input 'parts':U
      638         ,input '+update':U
      639         ,input (buffer buf_temp-parts :handle)
      640         ,input '':U
      641         ,output v-rec-ord
      642         ) no-error .
      643       if error-status :error
      644       then do:
      645         message
      646           vss-workfile vss-revision vss-description skip
      647           substitute( "Ошибка при добавлении записи &1 в команду с кодом &2", 'parts':U, v-cmd-code1 ) skip
      648           error-status :get-message(1) skip
      649           return-value skip
      650           view-as alert-box error .
      651         delete procedure v-cmd-proc-handle .
      652         undo, return error return-value .
      653       end.
      654     end.
      655     assign
      656       ub.parts.qnty      = ub.parts.qnty      - v-total-qnty
      657       ub.parts.fact-qnty = ub.parts.fact-qnty - v-total-fact-qnty
      658       ub.parts.cli-qnty  = ub.parts.cli-qnty  - v-total-cli-qnty
      659     .
      660     if  ub.parts.qnty      = 0
      661     and ub.parts.fact-qnty = 0
      662     and ub.parts.cli-qnty  = 0
      663     then do:
      664       delete ub.parts .
      665     end.
      666     else do:
      667       if ub.parts.qnty      = 0
      668       or ub.parts.fact-qnty = 0
      669       or ub.parts.cli-qnty  = 0
      670       then do:
      671         message
      672           vss-workfile vss-revision vss-description skip
      673           "Ошибка задания входных параметров" skip
      674           "После разбиения или все количества в партии должны равняться нулю" skip
      675           "или все количества должны быть отличны от нуля" skip
      676           "Объект" p-obj-type p-obj-code skip
      677           "Артикул" p-artic p-prod-type p-prod-code skip
      678           "Партия" p-in-code p-part-code skip
      679           "Документ" p-out-code skip
      680           "ub.parts.qnty"      ub.parts.qnty      skip
      681           "ub.parts.fact-qnty" ub.parts.fact-qnty skip
      682           "ub.parts.cli-qnty"  ub.parts.cli-qnty  skip
      683           view-as alert-box error .
      684         undo, return error return-value .
      685       end.
      686     end.
      687     if v-cur-db-num <> 0
      688       and v-spacial-doc <> true
      689     then do:
      690       run send-command in v-cmd-proc-handle
      691         ( input v-cmd-code1
      692         ,input "0"
      693         ) no-error .
      694       if error-status :error then do:
      695         message
      696           vss-workfile vss-revision vss-description skip
      697           substitute( "Ошибка при отправке в новости команды с кодом &1", v-cmd-code1 ) skip
      698           error-status :get-message(1) skip
      699           return-value skip
      700           view-as alert-box error .
      701         delete procedure v-cmd-proc-handle .
      702         undo, return error return-value .
      703       end.
      704       delete procedure v-cmd-proc-handle .
      705     end.
      706   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      707   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscheck in g#library
      708     (input p-obj-type
      709     ,input p-obj-code
      710     ,input p-artic
      711     ,input p-prod-type
      712     ,input p-prod-code
      713     ,input ?
      714     ,input ''
      715     ) no-error .
      716     if error-status :error
      717     then do:
      718       message
      719         vss-workfile vss-revision vss-description skip
      720         "Ошибка проверки целостности товара после операции разбиения" skip
      721         "Объект" p-obj-type p-obj-code skip
      722         "Артикул" p-artic p-prod-type p-prod-code skip
      723         "Партия" p-in-code p-part-code skip
      724         "Документ" p-out-code skip
      725         error-status :get-message(1) skip
      726         return-value skip
      727         view-as alert-box error .
      728       undo, return error return-value .
      729     end.
      730   end.
