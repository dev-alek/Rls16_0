        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.fin-code-cor-acc .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление кода корресп. счета ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2', ub.fin-code-cor-acc.fin-code, ub.fin-code-cor-acc.host-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   main-block :
       82   do transaction
       83   on error undo main-block, return error
       84   :
       85   find first sysconf no-lock where
       86               ( sysconf.cor-acc-in   = ub.fin-code-cor-acc.fin-code    and
       87                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
       88               ( sysconf.cor-acc1-in  = ub.fin-code-cor-acc.fin-code    and
       89                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
       90               ( sysconf.cor-acc-out  = ub.fin-code-cor-acc.fin-code    and
       91                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
       92               ( sysconf.cor-acc1-out = ub.fin-code-cor-acc.fin-code    and
       93                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
       94               ( sysconf.cor-acc-in-cash  = ub.fin-code-cor-acc.fin-code    and
       95                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
       96               ( sysconf.cor-acc1-in-cash  = ub.fin-code-cor-acc.fin-code    and
       97                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
       98               ( sysconf.cor-acc-out-cash  = ub.fin-code-cor-acc.fin-code    and
       99                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
      100               ( sysconf.cor-acc1-out-cash  = ub.fin-code-cor-acc.fin-code    and
      101                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
      102               ( sysconf.cor-acc-in-payoff  = ub.fin-code-cor-acc.fin-code    and
      103                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
      104               ( sysconf.cor-acc1-in-payoff  = ub.fin-code-cor-acc.fin-code    and
      105                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
      106               ( sysconf.cor-acc-out-payoff  = ub.fin-code-cor-acc.fin-code    and
      107                 sysconf.host-code = ub.fin-code-cor-acc.host-code ) or
      108               ( sysconf.cor-acc1-out-payoff = ub.fin-code-cor-acc.fin-code    and
      109                 sysconf.host-code = ub.fin-code-cor-acc.host-code )
      110           no-error .
      111   if available sysconf
      112     then do:
      113       message
      114         vss-workfile vss-revision vss-description skip
      115         "Нельзя удалять запись! " skip
      116         "Значение справочника используется в настройке фирмы"  skip
      117         view-as alert-box error .
      118       undo main-block, return error .
      119     end.
      120    if not g#news then do:
      121       run nws/cmd-del.p
      122         ( input "fin-code-cor-acc":U
      123          ,input (buffer ub.fin-code-cor-acc:handle)
      124          ,input "":U
      125         ) no-error .
      126       if error-status :error then do:
      127         undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      128       end.
      129      end.
      130       if g#oxml = yes
      131       then do:
      132       run str/calloxml.p (
      133             input 'delete':U
      134           , input 'fin-code-cor-acc':U
      135           , input ( buffer ub.fin-code-cor-acc:handle )
      136       ) no-error.
      137       if error-status :error
      138       then do:
      139           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      140                                , chr(10)
      141                                , vss-workfile
      142                                , return-value
      143                                , error-status :get-message ( 1 ) ).
      144       end.
      145       end.
      146   end.
