        1   block-level on error undo, throw.
        2   trigger procedure for delete of ub.ext-artic-attr.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление таблицы атрибутов внешних артикулов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info1 as character no-undo format "x(65)":U initial "@(#)$Workfile$ $Revision$":U.
      304   procedure ext-artic-attr-name :
      305   do
      306     on error undo, return error
      307     :
      308     define input  parameter p-code           as character no-undo .
      309     define output parameter p-type           as character no-undo .
      310     define output parameter p-format         as character no-undo .
      311     define output parameter p-label          as character no-undo .
      312     define output parameter p-user-can-edit  as logical   no-undo .
      313     define output parameter p-output-display as logical   no-undo .
      314     define output parameter p-other          as character no-undo .
      315     case p-code :
      316         otherwise do:
      317           undo, return error "неизвестный глобальный атрибут внешнего артикула" + " " + p-code .
      318         end.
      319     end case.
      320   end.
      321   end procedure.
      322   procedure ext-artic-attr-tooltip :
      323   do
      324     on error undo, return error
      325     :
      326       define input  parameter p-code    as character no-undo .
      327       define output parameter p-tooltip as character no-undo .
      328       define output parameter p-label   as character no-undo .
      329       case p-code :
      330         otherwise do:
      331           undo, return error "Неизвестный глобальный атрибут внешнего артикула" + " " + p-code .
      332         end.
      333       end case.
      334   end.
      335   end procedure.
      336   procedure ext-artic-attr-value :
      337   do
      338     on error undo, return error
      339     :
      340     define input  parameter p-code as character no-undo .
      341     define input  parameter p-gds-code as int no-undo .
      342     define input  parameter p-cli-type like ub.ext-artic-attr.cli-type no-undo .
      343     define input  parameter p-cli-code like ub.ext-artic-attr.cli-code no-undo .
      344     define output parameter p-value as character no-undo .
      345     define output parameter p-type     as character no-undo .
      346     define buffer buf_ext-artic-attr for ub.ext-artic-attr.
      347     def var v-format         as character no-undo .
      348     def var v-label          as character no-undo .
      349     def var v-user-can-edit  as logical   no-undo .
      350     def var v-output-display as logical   no-undo .
      351     def var v-other          as character no-undo .
      352       run ext-artic-attr-name in this-procedure
      353         ( input  p-code
      354         , output p-type
      355         , output v-format
      356         , output v-label
      357         , output v-user-can-edit
      358         , output v-output-display
      359         , output v-other
      360         ) no-error .
      361       if error-status :error then do:
      362         undo, return error return-value .
      363       end.
      364       find first  buf_ext-artic-attr no-lock
      365             where buf_ext-artic-attr.attr-code = p-code
      366              and  buf_ext-artic-attr.gds-code  = p-gds-code
      367              and  buf_ext-artic-attr.cli-type  = p-cli-type
      368              and  buf_ext-artic-attr.cli-code  = p-cli-code
      369              no-error .
      370      if avail buf_ext-artic-attr then do:
      371       assign
      372         p-value = buf_ext-artic-attr.attr-value
      373       .
      374      end.
      375      else do:
      376       assign
      377         p-value = if p-type = 'L':U then "no":U else ""
      378       .
      379      end.
      380   end.
      381   end procedure.
      382   procedure ext-artic-attr-write :
      383   do
      384     on error undo, return error
      385     :
      386       define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
      387       define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
      388       define input parameter p-cli-type like ub.ext-artic-attr.cli-type no-undo .
      389       define input parameter p-cli-code like ub.ext-artic-attr.cli-code no-undo .
      390       define input parameter p-value    like ub.goods-attr.attr-value no-undo .
      391       define buffer buf_ext-artic-attr for ub.ext-artic-attr .
      392       def var v-type           as character no-undo .
      393       def var v-format         as character no-undo .
      394       def var v-label          as character no-undo .
      395       def var v-user-can-edit  as logical   no-undo .
      396       def var v-output-display as logical   no-undo .
      397       def var v-other          as character no-undo .
      398       run ext-artic-attr-name in this-procedure
      399         ( input  p-code
      400         , output v-type
      401         , output v-format
      402         , output v-label
      403         , output v-user-can-edit
      404         , output v-output-display
      405         , output v-other
      406         ) no-error .
      407       if error-status :error then do:
      408         undo, return error return-value .
      409       end.
      410       find first buf_ext-artic-attr exclusive-lock
      411           where buf_ext-artic-attr.gds-code  = p-gds-code
      412             and buf_ext-artic-attr.cli-type  = p-cli-type
      413             and buf_ext-artic-attr.cli-code  = p-cli-code
      414             and buf_ext-artic-attr.attr-code = p-code
      415             no-error .
      416       if not available buf_ext-artic-attr then do:
      417         create buf_ext-artic-attr .
      418         assign
      419           buf_ext-artic-attr.gds-code   = p-gds-code
      420           buf_ext-artic-attr.cli-type   = p-cli-type
      421           buf_ext-artic-attr.cli-code   = p-cli-code
      422           buf_ext-artic-attr.attr-code  = p-code
      423           buf_ext-artic-attr.attr-value = p-value
      424         no-error
      425         .
      426       end.
      427       else
      428         assign
      429           buf_ext-artic-attr.attr-value = p-value
      430         no-error
      431         .
      432   end.
      433   end procedure.
      434   procedure ext-artic-attr-exist :
      435   do
      436     on error undo, return error
      437     :
      438       define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
      439       define input parameter p-cli-type like ub.ext-artic-attr.cli-type no-undo .
      440       define input parameter p-cli-code like ub.ext-artic-attr.cli-code no-undo .
      441       define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
      442       define output parameter p-exist   as logical   no-undo .
      443       define buffer buf_ext-artic-attr for ub.ext-artic-attr .
      444       def var v-type           as character no-undo .
      445       def var v-format         as character no-undo .
      446       def var v-label          as character no-undo .
      447       def var v-user-can-edit  as logical   no-undo .
      448       def var v-output-display as logical   no-undo .
      449       def var v-other          as character no-undo .
      450       run ext-artic-attr-name in this-procedure
      451         ( input  p-code
      452         , output v-type
      453         , output v-format
      454         , output v-label
      455         , output v-user-can-edit
      456         , output v-output-display
      457         , output v-other
      458         ) no-error .
      459       if error-status :error then do:
      460         undo, return error return-value .
      461       end.
      462       find first buf_ext-artic-attr no-lock
      463             where buf_ext-artic-attr.gds-code  = p-gds-code
      464               and buf_ext-artic-attr.cli-type  = p-cli-type
      465               and buf_ext-artic-attr.cli-code  = p-cli-code
      466               and buf_ext-artic-attr.attr-code = p-code
      467               no-error .
      468       if available buf_ext-artic-attr then do:
      469           assign
      470             p-exist  = yes
      471           .
      472       end.
      473   end.
      474   end procedure.
      475   procedure ext-artic-attr-delete :
      476   do
      477     on error undo, return error
      478     :
      479       define input parameter p-gds-code like ub.goods-attr.gds-code   no-undo .
      480       define input parameter p-cli-type like ub.ext-artic-attr.cli-type no-undo .
      481       define input parameter p-cli-code like ub.ext-artic-attr.cli-code no-undo .
      482       define input parameter p-code     like ub.goods-attr.attr-code  no-undo .
      483       define output parameter p-deleted  as logical   no-undo .
      484       define buffer buf_ext-artic-attr for ub.ext-artic-attr .
      485       def var v-type           as character no-undo .
      486       def var v-format         as character no-undo .
      487       def var v-label          as character no-undo .
      488       def var v-user-can-edit  as logical   no-undo .
      489       def var v-output-display as logical   no-undo .
      490       def var v-other          as character no-undo .
      491       run ext-artic-attr-name in this-procedure
      492         ( input  p-code
      493         , output v-type
      494         , output v-format
      495         , output v-label
      496         , output v-user-can-edit
      497         , output v-output-display
      498         , output v-other
      499         ) no-error .
      500       if error-status :error then do:
      501         undo, return error return-value .
      502       end.
      503       find first buf_ext-artic-attr exclusive-lock
      504             where buf_ext-artic-attr.gds-code  = p-gds-code
      505               and buf_ext-artic-attr.cli-type  = p-cli-type
      506               and buf_ext-artic-attr.cli-code  = p-cli-code
      507               and buf_ext-artic-attr.attr-code = p-code
      508               no-error .
      509       if not available buf_ext-artic-attr then do:
      510         assign
      511           p-deleted = no .
      512         .
      513       end.
      514       else do:
      515         delete buf_ext-artic-attr.
      516         assign
      517           p-deleted = yes .
      518         .
      519       END.
      520   end.
      521   end procedure.
      522   procedure ext-artic-attr-news :
      523   do
      524     on error undo, return error
      525     :
      526       define input  parameter p-code           as character no-undo .
      527       define output parameter p-news           as logical   no-undo .
      528       case p-code :
      529         otherwise do:
      530           undo, return error "неизвестный глобальный атрибут внешнего артикула" + " " + p-code .
      531         end.
      532       end case.
      533   end.
      534   end procedure.
      535   procedure ext-artic-attr-copy :
      536     do
      537     on error undo, return error
      538     :
      539       define input  parameter p-code           as character no-undo .
      540       define output parameter p-copy           as logical   no-undo .
      541       case p-code :
      542         otherwise do:
      543           undo, return error "неизвестный глобальный атрибут внешнего артикула" + " " + p-code .
      544         end.
      545       end.
      546     end.
      547   end procedure.
      548   define buffer buf_c-ext-artic-attr for ub.c-ext-artic-attr.
      549   define variable v-date as date      no-undo .
      550   define variable v-time as integer   no-undo .
      551   define variable v-news as logical   no-undo .
      552   main-block:
      553   do on error   undo main-block , return error return-value
      554      on endkey  undo main-block , return error return-value
      555      on stop    undo main-block , return error return-value
      556      :
      557       run ext-artic-attr-news in this-procedure ( input ub.ext-artic-attr.attr-code , output v-news ) no-error .
      558       run cur-time in this-procedure ( output v-date , output v-time ) .
      559       create buf_c-ext-artic-attr.
      560       buffer-copy ub.ext-artic-attr to buf_c-ext-artic-attr
      561       assign
      562         buf_c-ext-artic-attr.chip-num         = next-value( s-gds-chip , ub )
      563         buf_c-ext-artic-attr.corr-date        = v-date
      564         buf_c-ext-artic-attr.corr-time        = v-time
      565         buf_c-ext-artic-attr.corr-user-db-num = g#db-num
      566         buf_c-ext-artic-attr.corr-user-name   = g#userid
      567         buf_c-ext-artic-attr.action = integer( '99':U )
      568       .
      569       if v-news then do:
      570         run nws/cmd-del.p ( input "ext-artic-attr":u , input (buffer ext-artic-attr :handle) , input "":u ) no-error .
      571         if error-status :error then do:
      572           return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ) .
      573         end.
      574       end.
      575       if g#oxml = yes
      576       then do:
      577       run str/calloxml.p (
      578             input 'delete':U
      579           , input 'ext-artic-attr':U
      580           , input ( buffer ub.ext-artic-attr:handle )
      581       ) no-error.
      582       if error-status :error
      583       then do:
      584           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      585                                , chr(10)
      586                                , vss-workfile
      587                                , return-value
      588                                , error-status :get-message ( 1 ) ).
      589       end.
      590       end.
      591   end.
