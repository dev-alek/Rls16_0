        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.ext-classif old old-ext-classif.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись ext-classif".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8|&9'
       29                           , ub.ext-classif.classif-subject
       30                           , ub.ext-classif.classif-name
       31                           , ub.ext-classif.key#_one
       32                           , ub.ext-classif.key#_two
       33                           , ub.ext-classif.key#_three
       34                           , ub.ext-classif.charkey_one
       35                           , ub.ext-classif.charkey_two
       36                           , ub.ext-classif.charkey_three
       37                           , ub.ext-classif.nonunique
       38                           )
       39       .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define   shared variable g#auto as logical no-undo.
       83   define   shared variable g#news as logical no-undo.
       84   define   shared variable g#oxml as logical no-undo.
       85   define   shared variable g#esys as logical no-undo.
       86   define   shared variable g#news-source-db as integer no-undo.
       87   define   shared variable g#esys-source-esys as integer no-undo.
       88   define   shared variable g#db-num as integer   no-undo .
       89   define   shared variable g#userid as character no-undo .
       90   define   shared variable g#passwd as character no-undo .
       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   procedure cur-time :
       94      define output parameter p-today as date      no-undo .
       95      define output parameter p-time  as integer   no-undo .
       96     do
       97     on error undo, return error
       98     :
       99       define variable v-date1 as date      no-undo .
      100       define variable v-date2 as date      no-undo .
      101       define variable v-time  as integer   no-undo .
      102       assign
      103         v-date1 = today
      104         v-time  = time
      105         v-date2 = today
      106       .
      107       if v-date1 <> v-date2
      108       then do:
      109         assign
      110           v-date1 = today
      111           v-time  = v-time
      112         .
      113       end.
      114       assign
      115         p-today = v-date1
      116         p-time  = v-time
      117       .
      118     end.
      119   end.
      120   function cur-time-date returns character
      121   :
      122     return string(today, '99/99/9999':U) .
      123   end.
      124   function cur-time-mjd returns decimal
      125   :
      126     define variable v-date as date      no-undo .
      127     define variable v-time as integer   no-undo .
      128     run cur-time in this-procedure
      129       (output v-date
      130       ,output v-time
      131       ) .
      132     return integer(v-date) - 2400002 + (v-time / 86400) .
      133   end.
      134   function cur-time-get-ending-index returns integer
      135   (input p-number as integer
      136   )
      137   :
      138     if p-number < 0
      139     or p-number = ?
      140     then do:
      141       return 1 .
      142     end.
      143     define variable v-rest as integer   no-undo .
      144     assign
      145       p-number = p-number modulo 100
      146     .
      147     if p-number < 20
      148     then do:
      149       assign
      150         v-rest = p-number
      151       .
      152     end.
      153     else do:
      154       assign
      155         v-rest = p-number modulo 10
      156       .
      157     end.
      158     case v-rest :
      159       when 1
      160       then do:
      161         return 2 .
      162       end.
      163       when 2 or
      164       when 3 or
      165       when 4
      166       then do:
      167         return 3 .
      168       end.
      169       otherwise do:
      170         return 1 .
      171       end.
      172     end case .
      173   end.
      174   procedure cur-time-mjd-to-date :
      175      define input  parameter i-mjd-diff as decimal no-undo.
      176      define output parameter o-Date     as date    no-undo.
      177      define output parameter o-Time     as integer no-undo.
      178      define variable v-day-number as integer   no-undo .
      179      if    i-mjd-diff < 0
      180         or i-mjd-diff = ?
      181      then do:
      182         return "?" .
      183      end.
      184      assign
      185         v-day-number = truncate(i-mjd-diff,0).
      186         o-Date = date(v-day-number + 2400002).
      187         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189   end.
      190   function cur-time-mjd-to-string returns character
      191   (input p-mjd-diff as decimal
      192   )
      193   :
      194     define variable v-day-number as integer   no-undo .
      195     define variable v-seconds    as integer   no-undo .
      196     define variable v-hour       as integer   no-undo .
      197     define variable v-min        as integer   no-undo .
      198     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      199     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      200     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      201     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      202     if p-mjd-diff < 0
      203     or p-mjd-diff = ?
      204     then do:
      205       return "?" .
      206     end.
      207     assign
      208       v-day-number = integer(truncate(p-mjd-diff,0))
      209       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      210     .
      211     if v-seconds > 86400
      212     then do:
      213       assign
      214         v-seconds = 86400 - 1
      215       .
      216     end.
      217     if v-seconds < 0
      218     then do:
      219       assign
      220         v-seconds = 0
      221       .
      222     end.
      223     assign
      224       v-hour = truncate(v-seconds / 3600, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 3600
      228     .
      229     assign
      230       v-min = truncate(v-seconds / 60, 0)
      231     .
      232     assign
      233       v-seconds = v-seconds modulo 60
      234     .
      235     return
      236         (if v-day-number <> 0
      237           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0
      241           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      245           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      246           else ""
      247         )
      248       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      249       .
      250   end.
      251   function cur-time-string returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      260   end.
      261   function cur-time-string-sec returns character
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      270   end.
      271   function cur-time-custom  returns character
      272   (input p-prefix as character
      273   ,input p-date-format as character
      274   ,input p-delimiter as character
      275   ,input p-time-format as character
      276   ,input p-suffix as character
      277   )
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return
      286       p-prefix
      287       + string(v-date, p-date-format)
      288       + p-delimiter
      289       + string(v-time, p-time-format)
      290       + p-suffix
      291       .
      292   end.
      293   function cur-time-print  returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-datetime returns datetime
      304   :
      305     define variable v-char as character no-undo .
      306     define variable v-datetime as datetime no-undo .
      307     v-char = cur-time-string().
      308     v-datetime = datetime(v-char).
      309     return  v-datetime.
      310   end.
      311   function cur-time-string-msec returns character
      312   :
      313     define variable v-date as datetime  no-undo .
      314     v-date = now.
      315     return string(v-date) .
      316   end.
      317   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      318   define new global shared variable g#lib-nws as handle no-undo .
      319   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   procedure gen-key-rec :
      321     define input  parameter p-tbl-name    as character no-undo.
      322     define input  parameter p-bh_tbl-name as handle    no-undo.
      323     define output parameter p-key-rec     as character no-undo.
      324     do
      325     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      326     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      327     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      328     :
      329       define variable fh               as handle    no-undo .
      330       define variable v-ok             as logical   no-undo .
      331       define variable v-inform         as character no-undo .
      332       define variable v-ind            as integer   no-undo .
      333       define variable v-idx-field-qnty as integer   no-undo .
      334       if p-tbl-name = ?
      335         or p-tbl-name = "":U
      336       then do:
      337         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      338       end.
      339       if not p-bh_tbl-name:available then do:
      340         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      341       end.
      342       assign
      343         p-key-rec = p-tbl-name
      344         v-inform  = p-bh_tbl-name:index-information(1)
      345         v-ind     = 2
      346       .
      347       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      348       on error undo, return error
      349       :
      350         assign
      351           v-inform = p-bh_tbl-name:index-information( v-ind )
      352           v-ind    = v-ind + 1
      353         .
      354       end.
      355       if v-inform = ?
      356         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      357         or entry( 3, v-inform, ",":U ) <> "1":U
      358       then do:
      359         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      360       end.
      361       else do:
      362         assign
      363           v-idx-field-qnty = num-entries( v-inform ) - 4
      364         .
      365         if v-idx-field-qnty < 2 then do:
      366           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      367         end.
      368         do v-ind = 1 to v-idx-field-qnty by 2
      369         on error undo, return error
      370         :
      371           assign
      372             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      373             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      374           .
      375         end.
      376       end.
      377       if p-key-rec = ? then do:
      378         assign
      379           p-key-rec = "":U
      380         .
      381         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      382       end.
      383     end.
      384     return.
      385   end procedure.
      386   procedure gen-where-keyr-tab :
      387     define input  parameter i-tableSerach as character no-undo.
      388     define input  parameter i-tablekey   as character  no-undo.
      389     define input  parameter p-key-rec    as character  no-undo.
      390     define input  parameter p-key-handle as handle     no-undo .
      391     define input  parameter p-db-name    as character  no-undo .
      392     define input  parameter p-tt-handle  as handle     no-undo .
      393     define output parameter o-Where      as character  no-undo.
      394     do
      395     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      396     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      397     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      398     :
      399       define variable v-full-tbl-name  as character no-undo .
      400       define variable bh_tbl-name      as handle    no-undo .
      401       define variable fh_key           as handle    no-undo .
      402       define variable fh_search        as handle    no-undo .
      403       define variable v-field-num      as integer   no-undo .
      404       define variable v-count-fld      as integer   no-undo .
      405       define variable v-inform         as character no-undo .
      406       define variable v-ind            as integer   no-undo .
      407       define variable v-idx-field-qnty as integer   no-undo .
      408       define variable v-field-name     as character no-undo .
      409       define variable v-field-val      as character no-undo .
      410       define variable v-word-link      as character no-undo .
      411       define variable vTable           as character no-undo.
      412       define variable bh_tbl-key       as handle    no-undo .
      413       assign
      414         p-key-rec = trim( p-key-rec )
      415       .
      416       if p-key-handle <> ? then do:
      417         if not valid-handle(p-key-handle)
      418            or p-key-handle:type <> "buffer"
      419         then do:
      420           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      421         end.
      422         if num-entries( p-key-rec, chr(3) ) > 1
      423           or p-key-rec = ?
      424           or p-key-rec = "":U
      425         then do:
      426           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      427         end.
      428       end.
      429       else do:
      430         if p-key-rec = ?
      431           or p-key-rec = "":U
      432         then do:
      433           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      434         end.
      435       end.
      436       assign
      437         vTable = entry( 1 , p-key-rec, chr(3) )
      438       .
      439       if p-tt-handle <> ?
      440         and ( not valid-handle(p-tt-handle)
      441               or p-tt-handle:type <> "buffer"
      442             )
      443       then do:
      444         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      445       end.
      446       if p-tt-handle = ? then do:
      447         assign
      448           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      449         .
      450         create buffer bh_tbl-name for table v-full-tbl-name .
      451       end.
      452       else do:
      453         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      454       end.
      455       assign
      456         v-inform = bh_tbl-name:index-information(1)
      457         v-ind    = 2
      458       .
      459       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      460       on error undo, return error
      461       :
      462         assign
      463           v-inform = bh_tbl-name:index-information( v-ind )
      464           v-ind    = v-ind + 1
      465         .
      466       end.
      467       if v-inform = ?
      468         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      469         or entry( 3, v-inform, ",":U ) <> "1":U
      470       then do:
      471         delete object bh_tbl-name no-error.
      472         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      473       end.
      474       assign
      475         v-idx-field-qnty = num-entries( v-inform ) - 4
      476       .
      477       if v-idx-field-qnty < 2 then do:
      478         delete object bh_tbl-name no-error.
      479         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      480       end.
      481       assign
      482         o-where     = "where":U
      483         v-word-link = "":U
      484         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      485         v-count-fld = 0
      486       .
      487       if i-tablekey ne "" and i-tablekey ne ?
      488       then do:
      489         assign
      490           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      491         .
      492         create buffer bh_tbl-key for table v-full-tbl-name .
      493       end.
      494       if i-tableSerach ne "" and i-tableSerach ne ?
      495       then do:
      496         delete object bh_tbl-name no-error.
      497         assign
      498           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      499         .
      500         create buffer bh_tbl-name for table v-full-tbl-name .
      501       end.
      502       block_where:
      503       do v-ind = 1 to v-idx-field-qnty by 2
      504       on error undo, return error
      505       :
      506         assign
      507           v-count-fld = v-count-fld + 1
      508         .
      509         if p-key-handle = ?
      510           and v-count-fld > v-field-num
      511         then do:
      512           leave block_where.
      513         end.
      514         define variable VfieldKeyTable as handle no-undo.
      515         assign
      516           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      517           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      518         .
      519         if     bh_tbl-key ne ?
      520         then do:
      521            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      522            if VfieldKeyTable eq ?
      523            then next block_where.
      524         end.
      525         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      526         then
      527            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      528         else
      529            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      530         if p-key-handle = ? then do:
      531           assign
      532             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      533           .
      534         end.
      535         else do:
      536           assign
      537             fh_key = p-key-handle:buffer-field( v-field-name )
      538           .
      539           if fh_key = ?
      540             or not valid-handle( fh_key )
      541           then do:
      542             delete object bh_tbl-name.
      543             if     bh_tbl-key ne ?
      544             then
      545                delete object bh_tbl-key.
      546             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      547           end.
      548           assign
      549             v-field-val = fh_key:buffer-value
      550           .
      551         end.
      552         if fh_search:data-type ="character":U then do:
      553           assign
      554             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      555             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      556             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      557             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      558             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      559             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      560             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      561             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      562             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      563             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      564             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      565             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      566             v-field-val = substitute( '"&1"', v-field-val )
      567           .
      568         end.
      569         assign
      570           o-where = substitute( "&1 &2", o-where, v-field-val )
      571         .
      572         if v-word-link = "":U then do:
      573           assign
      574             v-word-link = "and":U
      575           .
      576         end.
      577       end.
      578       delete object bh_tbl-name.
      579       if     bh_tbl-key ne ?
      580       then
      581          delete object bh_tbl-key.
      582       if p-key-handle = ?
      583         and v-count-fld <> v-field-num
      584       then do:
      585         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      586       end.
      587     end.
      588   end procedure.
      589   procedure gen-hn-keyr-tab :
      590     define input  parameter i-tableSerach as character no-undo.
      591     define input  parameter i-tablekey   as character no-undo.
      592     define input  parameter p-key-rec    as character no-undo.
      593     define input  parameter p-key-handle as handle    no-undo .
      594     define input  parameter p-db-name    as character no-undo .
      595     define input  parameter p-tt-handle  as handle    no-undo .
      596     define input  parameter p-stts-lock  as integer   no-undo .
      597     define output parameter o-hn         as handle    no-undo.
      598     define variable v-full-tbl-name as character no-undo.
      599     define variable v-where         as character no-undo.
      600     define variable bh_tbl-name     as handle    no-undo.
      601     define variable vTable          as character no-undo.
      602     do
      603     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      604     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      605     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      606         run gen-where-keyr-tab(i-tableSerach,
      607                                i-tablekey,
      608                                p-key-rec,
      609                                p-key-handle,
      610                                p-db-name,
      611                                p-tt-handle,
      612                                output v-where).
      613         if i-tableSerach ne "" and i-tableSerach ne ?
      614         then do:
      615            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      616            create buffer bh_tbl-name for table v-full-tbl-name .
      617         end.
      618         else do:
      619            if p-tt-handle = ? then do:
      620               assign
      621                  vTable = entry( 1 , p-key-rec, chr(3) )
      622               .
      623               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      624               create buffer bh_tbl-name for table v-full-tbl-name .
      625            end.
      626            else do:
      627               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      628            end.
      629         end.
      630         if p-tt-handle = ? then do:
      631            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      632         end.
      633         else do:
      634            bh_tbl-name:find-first( v-where ) no-error .
      635         end.
      636         o-hn = bh_tbl-name.
      637      end.
      638   end procedure.
      639   procedure gen-hn-keyr :
      640     define input  parameter p-key-rec    as character no-undo.
      641     define input  parameter p-key-handle as handle    no-undo .
      642     define input  parameter p-db-name    as character no-undo .
      643     define input  parameter p-tt-handle  as handle    no-undo .
      644     define input  parameter p-stts-lock  as integer   no-undo .
      645     define output parameter o-hn         as handle    no-undo.
      646     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      647   end.
      648   procedure gen-row-keyr :
      649     define input  parameter p-key-rec    as character no-undo.
      650     define input  parameter p-key-handle as handle    no-undo .
      651     define input  parameter p-db-name    as character no-undo .
      652     define input  parameter p-tt-handle  as handle    no-undo .
      653     define input  parameter p-stts-lock  as integer   no-undo .
      654     define output parameter p-tbl-row    as rowid     no-undo.
      655     define output parameter p-tbl-name   as character no-undo.
      656     define variable vHn as handle no-undo.
      657       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      658       p-tbl-row = if vHn:available then vHn:rowid else ?.
      659       p-tbl-name =  vHn:table.
      660       delete object vHn no-error.
      661     if p-tbl-row = ? then do:
      662       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      663     end.
      664     else do:
      665       return.
      666     end.
      667   end procedure.
      668   procedure gen-key-fv :
      669     define input  parameter p-key-rec    as character no-undo .
      670     define output parameter p-field-list as character no-undo .
      671     define output parameter p-value-list as character no-undo.
      672     do
      673     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      674     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      675     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      676     :
      677       define variable v-full-tbl-name  as character no-undo .
      678       define variable bh_tbl-name      as handle    no-undo .
      679       define variable v-tbl-name       as character no-undo .
      680       define variable v-field-num      as integer   no-undo .
      681       define variable v-count-fld      as integer   no-undo .
      682       define variable v-inform         as character no-undo .
      683       define variable v-ind            as integer   no-undo .
      684       define variable v-idx-field-qnty as integer   no-undo .
      685       define variable v-delim-key      as character no-undo .
      686       if p-key-rec = ?
      687         or p-key-rec = "":U
      688       then do:
      689         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      690       end.
      691       assign
      692         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      693         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      694       .
      695       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      696       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      697       assign
      698         v-inform = bh_tbl-name:index-information(1)
      699         v-ind    = 2
      700       .
      701       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      702       on error undo, return error
      703       :
      704         assign
      705           v-inform = bh_tbl-name:index-information( v-ind )
      706           v-ind    = v-ind + 1
      707         .
      708       end.
      709       if v-inform = ?
      710         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      711         or entry( 3, v-inform, ",":U ) <> "1":U
      712       then do:
      713         delete object bh_tbl-name no-error.
      714         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      715       end.
      716       assign
      717         v-idx-field-qnty = num-entries( v-inform ) - 4
      718       .
      719       if v-idx-field-qnty < 2 then do:
      720         delete object bh_tbl-name no-error.
      721         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      722       end.
      723       assign
      724         p-field-list = "":U
      725         p-value-list = "":U
      726         v-delim-key  = "":U
      727         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      728         v-count-fld  = 0
      729       .
      730       block_where:
      731       do v-ind = 1 to v-idx-field-qnty by 2
      732       on error undo, return error
      733       :
      734         assign
      735           v-count-fld = v-count-fld + 1
      736         .
      737         if v-count-fld > v-field-num then do:
      738           leave block_where.
      739         end.
      740         assign
      741           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      742           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      743         .
      744         if v-ind = 1 then do:
      745           assign
      746             v-delim-key = chr(3)
      747           .
      748         end.
      749       end.
      750       delete object bh_tbl-name.
      751       if v-count-fld <> v-field-num then do:
      752         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      753       end.
      754     end.
      755   end procedure.
      756   procedure gen-key-field :
      757     define input  parameter p-table      as character no-undo .
      758     define output parameter p-field-list as character no-undo .
      759     do
      760     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      761     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      762     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      763     :
      764       define variable v-full-tbl-name  as character no-undo .
      765       define variable bh_tbl-name      as handle    no-undo .
      766       define variable v-tbl-name       as character no-undo .
      767       define variable v-field-num      as integer   no-undo .
      768       define variable v-count-fld      as integer   no-undo .
      769       define variable v-inform         as character no-undo .
      770       define variable v-ind            as integer   no-undo .
      771       define variable v-idx-field-qnty as integer   no-undo .
      772       define variable v-delim-key      as character no-undo .
      773       if p-table = ?
      774         or p-table = "":U
      775       then do:
      776         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      777       end.
      778       assign
      779         v-tbl-name      = p-table
      780         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      781       .
      782       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      783       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      784       assign
      785         v-inform = bh_tbl-name:index-information(1)
      786         v-ind    = 2
      787       .
      788       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      789       on error undo, return error
      790       :
      791         assign
      792           v-inform = bh_tbl-name:index-information( v-ind )
      793           v-ind    = v-ind + 1
      794         .
      795       end.
      796       if v-inform = ?
      797         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      798         or entry( 3, v-inform, ",":U ) <> "1":U
      799       then do:
      800         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      801       end.
      802       assign
      803         v-idx-field-qnty = num-entries( v-inform ) - 4
      804       .
      805       if v-idx-field-qnty < 2 then do:
      806         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      807       end.
      808       assign
      809         p-field-list = "":U
      810         v-delim-key  = "":U
      811         v-count-fld  = 0
      812       .
      813       block_where:
      814       do v-ind = 1 to v-idx-field-qnty by 2
      815       on error undo, return error
      816       :
      817         assign
      818           v-count-fld = v-count-fld + 1
      819         .
      820         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      821         if v-ind = 1 then do:
      822           assign
      823             v-delim-key = chr(3)
      824           .
      825         end.
      826       end.
      827       delete object bh_tbl-name.
      828     end.
      829   end procedure.
      830   define variable v-date as date no-undo .
      831   define variable v-time as integer no-undo .
      832   define variable v-gds-code as integer no-undo .
      833   define variable v-obj-type as character no-undo .
      834   define variable v-obj-code as integer no-undo .
      835   define variable v-field-list as character no-undo .
      836   define variable v-value-list as character no-undo .
      837   define buffer buf_c-ext-classif for ub.c-ext-classif.
      838   define buffer buf_c-gds-hist for ub.c-gds-hist.
      839   define buffer buf_c-cli-hist for ub.c-cli-hist.
      840   main-block:
      841   do
      842   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      843   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      844   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      845   :
      846     if lookup(ub.ext-classif.classif-name, 'th-th150_clients,th-th14_clients,th-th150_goods,th-th14_goods,gds-grp,th-th_gds-grp,gds-grp,th-th_gds-grp,goods_fibegais-transId,FormF1-esys':U) > 0
      847     and lookup(ub.ext-classif.classif-name, 'th-th150_clients,th-th14_clients,th-th150_goods,th-th14_goods,gds-grp,th-th_gds-grp,rpm_gds-grp,goods_fib':U) > 0
      848     then return.
      849     if g#news then do:
      850       define variable v-send as integer no-undo .
      851       v-send = integer('0':U).
      852   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      854     (input  g#db-num
      855     ,input  'ext-classif':U
      856     ,input  0
      857     ,input  '':U
      858     ,input  0
      859     ,input  '':U
      860     ,input  '':U
      861     ,input  '':U
      862     ,input  0
      863     ,input  0
      864     ,input  0
      865     ,input  'nws-to-hist'
      866     ,output v-send
      867     ) no-error .
      868     end.
      869     if (not g#news
      870     or v-send >= 0)
      871     and lookup(ub.ext-classif.classif-name, 'th-th150_clients,th-th14_clients,th-th150_goods,th-th14_goods,gds-grp,th-th_gds-grp,gds-grp,th-th_gds-grp,goods_fibegais-transId,FormF1-esys':U) = 0
      872     then do:
      873       run cur-time in this-procedure(output v-date, output v-time).
      874       create buf_c-ext-classif.
      875       buffer-copy old-ext-classif to buf_c-ext-classif
      876       assign
      877       buf_c-ext-classif.classif-subject    = ub.ext-classif.classif-subject
      878       buf_c-ext-classif.uniq-key-rec       = ub.ext-classif.uniq-key-rec
      879       buf_c-ext-classif.classif-name       = ub.ext-classif.classif-name
      880       buf_c-ext-classif.charkey_one        = ub.ext-classif.charkey_one
      881       buf_c-ext-classif.charkey_two        = ub.ext-classif.charkey_two
      882       buf_c-ext-classif.charkey_three      = ub.ext-classif.charkey_three
      883       buf_c-ext-classif.key#_one           = ub.ext-classif.key#_one
      884       buf_c-ext-classif.key#_two           = ub.ext-classif.key#_two
      885       buf_c-ext-classif.key#_three         = ub.ext-classif.key#_three
      886       buf_c-ext-classif.db-num             = ub.ext-classif.db-num
      887       buf_c-ext-classif.corr-time          = v-time
      888       buf_c-ext-classif.corr-user-db-num   = g#db-num
      889       buf_c-ext-classif.corr-user-name     = (if g#news
      890                                               then (chr(4) +  'СПН':U)
      891                                               else (if g#esys
      892                                                    then (chr(4) +  'ВС':U)
      893                                                    else g#userid)
      894                                               )
      895       buf_c-ext-classif.corr-date          = v-date
      896       .
      897       if lookup(ub.ext-classif.classif-name, 'oss-ref,rvd-reason,reasons-suspicious-check,egais-transId,FormF1-esys':U) = 0 then
      898           do:
      899               run gen-key-fv in this-procedure (
      900                                                   input ub.ext-classif.uniq-key-rec
      901                                                   ,output v-field-list
      902                                                   ,output v-value-list) no-error.
      903               if error-status:error then
      904                   do:
      905                       undo, return error substitute( "&2&1Ошибка... &1&3&1&4"
      906                                                       , chr(10)
      907                                                       , vss-workfile
      908                                                       , return-value
      909                                                       , error-status :get-message ( 1 ) ).
      910                   end.
      911           end.
      912         case ub.ext-classif.classif-subject :
      913           when 'clients':U then do:
      914             assign
      915             v-obj-type = entry(lookup("obj-type":U
      916                                               , v-field-list
      917                                               , chr(3))
      918                                         , v-value-list, chr(3))
      919             v-obj-code = integer(entry(lookup("obj-code":U
      920                                               , v-field-list
      921                                               , chr(3))
      922                                         , v-value-list, chr(3)))
      923             no-error .
      924             buf_c-ext-classif.chip-num           = next-value (s-cli-chip, ub).
      925             create buf_c-cli-hist.
      926             buffer-copy buf_c-ext-classif
      927             to buf_c-cli-hist
      928             assign
      929             buf_c-cli-hist.subject  = 'ext-classif':U
      930             buf_c-cli-hist.obj-type = v-obj-type
      931             buf_c-cli-hist.obj-code = v-obj-code
      932             buf_c-cli-hist.action   = integer( if new ub.ext-classif then '1':U else '2':U )
      933             .
      934           end.
      935           when 'goods':U then do:
      936             if ub.ext-classif.uniq-key-rec begins 'goods':U then
      937             do:
      938               assign
      939                 v-gds-code = integer(entry(lookup("gds-code":U
      940                                                   , v-field-list
      941                                                   , chr(3))
      942                                             , v-value-list, chr(3)))
      943                 buf_c-ext-classif.chip-num           = next-value (s-gds-chip, ub)
      944               .
      945               create buf_c-gds-hist.
      946               buffer-copy buf_c-ext-classif
      947                 to buf_c-gds-hist
      948                 assign
      949                 buf_c-gds-hist.subject = 'ext-classif':U
      950                 buf_c-gds-hist.gds-code = v-gds-code
      951               .
      952             end.
      953             else
      954               buf_c-ext-classif.chip-num = next-value (s-ref-corr-chip, ub).
      955           end.
      956           otherwise do:
      957             buf_c-ext-classif.chip-num           = next-value (s-ref-corr-chip, ub).
      958           end.
      959         end case.
      960       end.
      961     if lookup(ub.ext-classif.classif-name, 'th-th150_clients,th-th14_clients,th-th150_goods,th-th14_goods,gds-grp,th-th_gds-grp,rpm_gds-grp,goods_fib':U) = 0 then do:
      962     run str/callnews.p
      963       ( input 'ext-classif':U
      964         ,input (buffer ub.ext-classif:handle )
      965       ) .
      966     if g#oxml = yes
      967     then do:
      968       run str/calloxml.p (
      969             input 'update':U
      970           , input 'ext-classif':U
      971           , input ( buffer ub.ext-classif:handle )
      972       ) no-error.
      973       if error-status :error
      974       then do:
      975           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      976                                , chr(10)
      977                                , vss-workfile
      978                                , return-value
      979                                , error-status :get-message ( 1 ) ).
      980       end.
      981     end.
      982     end.
      983   end.
