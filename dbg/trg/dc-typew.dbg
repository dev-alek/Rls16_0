        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.dis-card-type OLD old_dis-card-type.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись для таблицы типы дисконтных карт".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5'
       29                            , ub.dis-card-type.emitent-host-code
       30                            , ub.dis-card-type.type
       31                            , ub.dis-card-type.host-code
       32                           , ub.dis-card-type.obj-type
       33                           , ub.dis-card-type.obj-code
       34                            )
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   procedure cur-time :
       89      define output parameter p-today as date      no-undo .
       90      define output parameter p-time  as integer   no-undo .
       91     do
       92     on error undo, return error
       93     :
       94       define variable v-date1 as date      no-undo .
       95       define variable v-date2 as date      no-undo .
       96       define variable v-time  as integer   no-undo .
       97       assign
       98         v-date1 = today
       99         v-time  = time
      100         v-date2 = today
      101       .
      102       if v-date1 <> v-date2
      103       then do:
      104         assign
      105           v-date1 = today
      106           v-time  = v-time
      107         .
      108       end.
      109       assign
      110         p-today = v-date1
      111         p-time  = v-time
      112       .
      113     end.
      114   end.
      115   function cur-time-date returns character
      116   :
      117     return string(today, '99/99/9999':U) .
      118   end.
      119   function cur-time-mjd returns decimal
      120   :
      121     define variable v-date as date      no-undo .
      122     define variable v-time as integer   no-undo .
      123     run cur-time in this-procedure
      124       (output v-date
      125       ,output v-time
      126       ) .
      127     return integer(v-date) - 2400002 + (v-time / 86400) .
      128   end.
      129   function cur-time-get-ending-index returns integer
      130   (input p-number as integer
      131   )
      132   :
      133     if p-number < 0
      134     or p-number = ?
      135     then do:
      136       return 1 .
      137     end.
      138     define variable v-rest as integer   no-undo .
      139     assign
      140       p-number = p-number modulo 100
      141     .
      142     if p-number < 20
      143     then do:
      144       assign
      145         v-rest = p-number
      146       .
      147     end.
      148     else do:
      149       assign
      150         v-rest = p-number modulo 10
      151       .
      152     end.
      153     case v-rest :
      154       when 1
      155       then do:
      156         return 2 .
      157       end.
      158       when 2 or
      159       when 3 or
      160       when 4
      161       then do:
      162         return 3 .
      163       end.
      164       otherwise do:
      165         return 1 .
      166       end.
      167     end case .
      168   end.
      169   procedure cur-time-mjd-to-date :
      170      define input  parameter i-mjd-diff as decimal no-undo.
      171      define output parameter o-Date     as date    no-undo.
      172      define output parameter o-Time     as integer no-undo.
      173      define variable v-day-number as integer   no-undo .
      174      if    i-mjd-diff < 0
      175         or i-mjd-diff = ?
      176      then do:
      177         return "?" .
      178      end.
      179      assign
      180         v-day-number = truncate(i-mjd-diff,0).
      181         o-Date = date(v-day-number + 2400002).
      182         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      183     .
      184   end.
      185   function cur-time-mjd-to-string returns character
      186   (input p-mjd-diff as decimal
      187   )
      188   :
      189     define variable v-day-number as integer   no-undo .
      190     define variable v-seconds    as integer   no-undo .
      191     define variable v-hour       as integer   no-undo .
      192     define variable v-min        as integer   no-undo .
      193     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      194     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      195     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      196     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      197     if p-mjd-diff < 0
      198     or p-mjd-diff = ?
      199     then do:
      200       return "?" .
      201     end.
      202     assign
      203       v-day-number = integer(truncate(p-mjd-diff,0))
      204       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      205     .
      206     if v-seconds > 86400
      207     then do:
      208       assign
      209         v-seconds = 86400 - 1
      210       .
      211     end.
      212     if v-seconds < 0
      213     then do:
      214       assign
      215         v-seconds = 0
      216       .
      217     end.
      218     assign
      219       v-hour = truncate(v-seconds / 3600, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 3600
      223     .
      224     assign
      225       v-min = truncate(v-seconds / 60, 0)
      226     .
      227     assign
      228       v-seconds = v-seconds modulo 60
      229     .
      230     return
      231         (if v-day-number <> 0
      232           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0
      236           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      237           else ""
      238         )
      239       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      240           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      241           else ""
      242         )
      243       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      244       .
      245   end.
      246   function cur-time-string returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      255   end.
      256   function cur-time-string-sec returns character
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      265   end.
      266   function cur-time-custom  returns character
      267   (input p-prefix as character
      268   ,input p-date-format as character
      269   ,input p-delimiter as character
      270   ,input p-time-format as character
      271   ,input p-suffix as character
      272   )
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return
      281       p-prefix
      282       + string(v-date, p-date-format)
      283       + p-delimiter
      284       + string(v-time, p-time-format)
      285       + p-suffix
      286       .
      287   end.
      288   function cur-time-print  returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-datetime returns datetime
      299   :
      300     define variable v-char as character no-undo .
      301     define variable v-datetime as datetime no-undo .
      302     v-char = cur-time-string().
      303     v-datetime = datetime(v-char).
      304     return  v-datetime.
      305   end.
      306   function cur-time-string-msec returns character
      307   :
      308     define variable v-date as datetime  no-undo .
      309     v-date = now.
      310     return string(v-date) .
      311   end.
      312   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      313   procedure gen-key-rec :
      314     define input  parameter p-tbl-name    as character no-undo.
      315     define input  parameter p-bh_tbl-name as handle    no-undo.
      316     define output parameter p-key-rec     as character no-undo.
      317     do
      318     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      319     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      320     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      321     :
      322       define variable fh               as handle    no-undo .
      323       define variable v-ok             as logical   no-undo .
      324       define variable v-inform         as character no-undo .
      325       define variable v-ind            as integer   no-undo .
      326       define variable v-idx-field-qnty as integer   no-undo .
      327       if p-tbl-name = ?
      328         or p-tbl-name = "":U
      329       then do:
      330         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      331       end.
      332       if not p-bh_tbl-name:available then do:
      333         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      334       end.
      335       assign
      336         p-key-rec = p-tbl-name
      337         v-inform  = p-bh_tbl-name:index-information(1)
      338         v-ind     = 2
      339       .
      340       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      341       on error undo, return error
      342       :
      343         assign
      344           v-inform = p-bh_tbl-name:index-information( v-ind )
      345           v-ind    = v-ind + 1
      346         .
      347       end.
      348       if v-inform = ?
      349         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      350         or entry( 3, v-inform, ",":U ) <> "1":U
      351       then do:
      352         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      353       end.
      354       else do:
      355         assign
      356           v-idx-field-qnty = num-entries( v-inform ) - 4
      357         .
      358         if v-idx-field-qnty < 2 then do:
      359           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      360         end.
      361         do v-ind = 1 to v-idx-field-qnty by 2
      362         on error undo, return error
      363         :
      364           assign
      365             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      366             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      367           .
      368         end.
      369       end.
      370       if p-key-rec = ? then do:
      371         assign
      372           p-key-rec = "":U
      373         .
      374         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      375       end.
      376     end.
      377     return.
      378   end procedure.
      379   procedure gen-where-keyr-tab :
      380     define input  parameter i-tableSerach as character no-undo.
      381     define input  parameter i-tablekey   as character  no-undo.
      382     define input  parameter p-key-rec    as character  no-undo.
      383     define input  parameter p-key-handle as handle     no-undo .
      384     define input  parameter p-db-name    as character  no-undo .
      385     define input  parameter p-tt-handle  as handle     no-undo .
      386     define output parameter o-Where      as character  no-undo.
      387     do
      388     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      389     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      390     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      391     :
      392       define variable v-full-tbl-name  as character no-undo .
      393       define variable bh_tbl-name      as handle    no-undo .
      394       define variable fh_key           as handle    no-undo .
      395       define variable fh_search        as handle    no-undo .
      396       define variable v-field-num      as integer   no-undo .
      397       define variable v-count-fld      as integer   no-undo .
      398       define variable v-inform         as character no-undo .
      399       define variable v-ind            as integer   no-undo .
      400       define variable v-idx-field-qnty as integer   no-undo .
      401       define variable v-field-name     as character no-undo .
      402       define variable v-field-val      as character no-undo .
      403       define variable v-word-link      as character no-undo .
      404       define variable vTable           as character no-undo.
      405       define variable bh_tbl-key       as handle    no-undo .
      406       assign
      407         p-key-rec = trim( p-key-rec )
      408       .
      409       if p-key-handle <> ? then do:
      410         if not valid-handle(p-key-handle)
      411            or p-key-handle:type <> "buffer"
      412         then do:
      413           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      414         end.
      415         if num-entries( p-key-rec, chr(3) ) > 1
      416           or p-key-rec = ?
      417           or p-key-rec = "":U
      418         then do:
      419           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      420         end.
      421       end.
      422       else do:
      423         if p-key-rec = ?
      424           or p-key-rec = "":U
      425         then do:
      426           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      427         end.
      428       end.
      429       assign
      430         vTable = entry( 1 , p-key-rec, chr(3) )
      431       .
      432       if p-tt-handle <> ?
      433         and ( not valid-handle(p-tt-handle)
      434               or p-tt-handle:type <> "buffer"
      435             )
      436       then do:
      437         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      438       end.
      439       if p-tt-handle = ? then do:
      440         assign
      441           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      442         .
      443         create buffer bh_tbl-name for table v-full-tbl-name .
      444       end.
      445       else do:
      446         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      447       end.
      448       assign
      449         v-inform = bh_tbl-name:index-information(1)
      450         v-ind    = 2
      451       .
      452       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      453       on error undo, return error
      454       :
      455         assign
      456           v-inform = bh_tbl-name:index-information( v-ind )
      457           v-ind    = v-ind + 1
      458         .
      459       end.
      460       if v-inform = ?
      461         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      462         or entry( 3, v-inform, ",":U ) <> "1":U
      463       then do:
      464         delete object bh_tbl-name no-error.
      465         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      466       end.
      467       assign
      468         v-idx-field-qnty = num-entries( v-inform ) - 4
      469       .
      470       if v-idx-field-qnty < 2 then do:
      471         delete object bh_tbl-name no-error.
      472         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      473       end.
      474       assign
      475         o-where     = "where":U
      476         v-word-link = "":U
      477         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      478         v-count-fld = 0
      479       .
      480       if i-tablekey ne "" and i-tablekey ne ?
      481       then do:
      482         assign
      483           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      484         .
      485         create buffer bh_tbl-key for table v-full-tbl-name .
      486       end.
      487       if i-tableSerach ne "" and i-tableSerach ne ?
      488       then do:
      489         delete object bh_tbl-name no-error.
      490         assign
      491           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      492         .
      493         create buffer bh_tbl-name for table v-full-tbl-name .
      494       end.
      495       block_where:
      496       do v-ind = 1 to v-idx-field-qnty by 2
      497       on error undo, return error
      498       :
      499         assign
      500           v-count-fld = v-count-fld + 1
      501         .
      502         if p-key-handle = ?
      503           and v-count-fld > v-field-num
      504         then do:
      505           leave block_where.
      506         end.
      507         define variable VfieldKeyTable as handle no-undo.
      508         assign
      509           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      510           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      511         .
      512         if     bh_tbl-key ne ?
      513         then do:
      514            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      515            if VfieldKeyTable eq ?
      516            then next block_where.
      517         end.
      518         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      519         then
      520            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      521         else
      522            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      523         if p-key-handle = ? then do:
      524           assign
      525             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      526           .
      527         end.
      528         else do:
      529           assign
      530             fh_key = p-key-handle:buffer-field( v-field-name )
      531           .
      532           if fh_key = ?
      533             or not valid-handle( fh_key )
      534           then do:
      535             delete object bh_tbl-name.
      536             if     bh_tbl-key ne ?
      537             then
      538                delete object bh_tbl-key.
      539             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      540           end.
      541           assign
      542             v-field-val = fh_key:buffer-value
      543           .
      544         end.
      545         if fh_search:data-type ="character":U then do:
      546           assign
      547             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      548             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      549             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      550             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      551             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      552             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      553             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      554             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      555             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      556             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      557             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      558             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      559             v-field-val = substitute( '"&1"', v-field-val )
      560           .
      561         end.
      562         assign
      563           o-where = substitute( "&1 &2", o-where, v-field-val )
      564         .
      565         if v-word-link = "":U then do:
      566           assign
      567             v-word-link = "and":U
      568           .
      569         end.
      570       end.
      571       delete object bh_tbl-name.
      572       if     bh_tbl-key ne ?
      573       then
      574          delete object bh_tbl-key.
      575       if p-key-handle = ?
      576         and v-count-fld <> v-field-num
      577       then do:
      578         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      579       end.
      580     end.
      581   end procedure.
      582   procedure gen-hn-keyr-tab :
      583     define input  parameter i-tableSerach as character no-undo.
      584     define input  parameter i-tablekey   as character no-undo.
      585     define input  parameter p-key-rec    as character no-undo.
      586     define input  parameter p-key-handle as handle    no-undo .
      587     define input  parameter p-db-name    as character no-undo .
      588     define input  parameter p-tt-handle  as handle    no-undo .
      589     define input  parameter p-stts-lock  as integer   no-undo .
      590     define output parameter o-hn         as handle    no-undo.
      591     define variable v-full-tbl-name as character no-undo.
      592     define variable v-where         as character no-undo.
      593     define variable bh_tbl-name     as handle    no-undo.
      594     define variable vTable          as character no-undo.
      595     do
      596     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      597     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      598     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      599         run gen-where-keyr-tab(i-tableSerach,
      600                                i-tablekey,
      601                                p-key-rec,
      602                                p-key-handle,
      603                                p-db-name,
      604                                p-tt-handle,
      605                                output v-where).
      606         if i-tableSerach ne "" and i-tableSerach ne ?
      607         then do:
      608            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      609            create buffer bh_tbl-name for table v-full-tbl-name .
      610         end.
      611         else do:
      612            if p-tt-handle = ? then do:
      613               assign
      614                  vTable = entry( 1 , p-key-rec, chr(3) )
      615               .
      616               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      617               create buffer bh_tbl-name for table v-full-tbl-name .
      618            end.
      619            else do:
      620               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      621            end.
      622         end.
      623         if p-tt-handle = ? then do:
      624            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      625         end.
      626         else do:
      627            bh_tbl-name:find-first( v-where ) no-error .
      628         end.
      629         o-hn = bh_tbl-name.
      630      end.
      631   end procedure.
      632   procedure gen-hn-keyr :
      633     define input  parameter p-key-rec    as character no-undo.
      634     define input  parameter p-key-handle as handle    no-undo .
      635     define input  parameter p-db-name    as character no-undo .
      636     define input  parameter p-tt-handle  as handle    no-undo .
      637     define input  parameter p-stts-lock  as integer   no-undo .
      638     define output parameter o-hn         as handle    no-undo.
      639     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      640   end.
      641   procedure gen-row-keyr :
      642     define input  parameter p-key-rec    as character no-undo.
      643     define input  parameter p-key-handle as handle    no-undo .
      644     define input  parameter p-db-name    as character no-undo .
      645     define input  parameter p-tt-handle  as handle    no-undo .
      646     define input  parameter p-stts-lock  as integer   no-undo .
      647     define output parameter p-tbl-row    as rowid     no-undo.
      648     define output parameter p-tbl-name   as character no-undo.
      649     define variable vHn as handle no-undo.
      650       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      651       p-tbl-row = if vHn:available then vHn:rowid else ?.
      652       p-tbl-name =  vHn:table.
      653       delete object vHn no-error.
      654     if p-tbl-row = ? then do:
      655       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      656     end.
      657     else do:
      658       return.
      659     end.
      660   end procedure.
      661   procedure gen-key-fv :
      662     define input  parameter p-key-rec    as character no-undo .
      663     define output parameter p-field-list as character no-undo .
      664     define output parameter p-value-list as character no-undo.
      665     do
      666     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      667     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      668     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      669     :
      670       define variable v-full-tbl-name  as character no-undo .
      671       define variable bh_tbl-name      as handle    no-undo .
      672       define variable v-tbl-name       as character no-undo .
      673       define variable v-field-num      as integer   no-undo .
      674       define variable v-count-fld      as integer   no-undo .
      675       define variable v-inform         as character no-undo .
      676       define variable v-ind            as integer   no-undo .
      677       define variable v-idx-field-qnty as integer   no-undo .
      678       define variable v-delim-key      as character no-undo .
      679       if p-key-rec = ?
      680         or p-key-rec = "":U
      681       then do:
      682         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      683       end.
      684       assign
      685         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      686         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      687       .
      688       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      689       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      690       assign
      691         v-inform = bh_tbl-name:index-information(1)
      692         v-ind    = 2
      693       .
      694       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      695       on error undo, return error
      696       :
      697         assign
      698           v-inform = bh_tbl-name:index-information( v-ind )
      699           v-ind    = v-ind + 1
      700         .
      701       end.
      702       if v-inform = ?
      703         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      704         or entry( 3, v-inform, ",":U ) <> "1":U
      705       then do:
      706         delete object bh_tbl-name no-error.
      707         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      708       end.
      709       assign
      710         v-idx-field-qnty = num-entries( v-inform ) - 4
      711       .
      712       if v-idx-field-qnty < 2 then do:
      713         delete object bh_tbl-name no-error.
      714         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      715       end.
      716       assign
      717         p-field-list = "":U
      718         p-value-list = "":U
      719         v-delim-key  = "":U
      720         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      721         v-count-fld  = 0
      722       .
      723       block_where:
      724       do v-ind = 1 to v-idx-field-qnty by 2
      725       on error undo, return error
      726       :
      727         assign
      728           v-count-fld = v-count-fld + 1
      729         .
      730         if v-count-fld > v-field-num then do:
      731           leave block_where.
      732         end.
      733         assign
      734           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      735           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      736         .
      737         if v-ind = 1 then do:
      738           assign
      739             v-delim-key = chr(3)
      740           .
      741         end.
      742       end.
      743       delete object bh_tbl-name.
      744       if v-count-fld <> v-field-num then do:
      745         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      746       end.
      747     end.
      748   end procedure.
      749   procedure gen-key-field :
      750     define input  parameter p-table      as character no-undo .
      751     define output parameter p-field-list as character no-undo .
      752     do
      753     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      754     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      755     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      756     :
      757       define variable v-full-tbl-name  as character no-undo .
      758       define variable bh_tbl-name      as handle    no-undo .
      759       define variable v-tbl-name       as character no-undo .
      760       define variable v-field-num      as integer   no-undo .
      761       define variable v-count-fld      as integer   no-undo .
      762       define variable v-inform         as character no-undo .
      763       define variable v-ind            as integer   no-undo .
      764       define variable v-idx-field-qnty as integer   no-undo .
      765       define variable v-delim-key      as character no-undo .
      766       if p-table = ?
      767         or p-table = "":U
      768       then do:
      769         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      770       end.
      771       assign
      772         v-tbl-name      = p-table
      773         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      774       .
      775       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      776       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      777       assign
      778         v-inform = bh_tbl-name:index-information(1)
      779         v-ind    = 2
      780       .
      781       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      782       on error undo, return error
      783       :
      784         assign
      785           v-inform = bh_tbl-name:index-information( v-ind )
      786           v-ind    = v-ind + 1
      787         .
      788       end.
      789       if v-inform = ?
      790         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      791         or entry( 3, v-inform, ",":U ) <> "1":U
      792       then do:
      793         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      794       end.
      795       assign
      796         v-idx-field-qnty = num-entries( v-inform ) - 4
      797       .
      798       if v-idx-field-qnty < 2 then do:
      799         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      800       end.
      801       assign
      802         p-field-list = "":U
      803         v-delim-key  = "":U
      804         v-count-fld  = 0
      805       .
      806       block_where:
      807       do v-ind = 1 to v-idx-field-qnty by 2
      808       on error undo, return error
      809       :
      810         assign
      811           v-count-fld = v-count-fld + 1
      812         .
      813         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      814         if v-ind = 1 then do:
      815           assign
      816             v-delim-key = chr(3)
      817           .
      818         end.
      819       end.
      820       delete object bh_tbl-name.
      821     end.
      822   end procedure.
      823   define variable v-date         as date      no-undo .
      824   define variable v-time         as integer   no-undo .
      825   define variable v-uniq-key-rec as character no-undo .
      826   define variable v-descr        as character no-undo .
      827   define buffer buf_c-dis-card-type for ub.c-dis-card-type.
      828   main-block:
      829   do
      830       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      831       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      832       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      833       :
      834       if not g#news then
      835       do:
      836           if new(ub.dis-card-type) then
      837           do:
      838               run gen-key-rec in this-procedure ( input 'dis-card-type':U
      839                   ,input buffer ub.dis-card-type:handle
      840                   ,output v-uniq-key-rec).
      841               if ub.dis-card-type.uniq-key-rec <> v-uniq-key-rec then
      842               do:
      843                   if ub.dis-card-type.uniq-key-rec = '':U then
      844                   do:
      845                       ub.dis-card-type.uniq-key-rec = v-uniq-key-rec.
      846                   end.
      847                   else
      848                   do:
      849                       run vss-get-parameters in this-procedure (output v-descr).
      850                       message
      851                           vss-workfile vss-revision vss-description skip
      852                           "Неверное значение поля uniq-key-rec" ub.dis-card-type.uniq-key-rec skip
      853                           "Должно быть" v-uniq-key-rec
      854                           v-descr
      855                           view-as alert-box error .
      856                       ub.dis-card-type.uniq-key-rec = v-uniq-key-rec.
      857                       undo main-block, return error .
      858                   end.
      859               end.
      860           end.
      861           else
      862           do:
      863               if ub.dis-card-type.type <> old_dis-card-type.type
      864                   or ub.dis-card-type.emitent-host-code <> old_dis-card-type.emitent-host-code
      865                   then
      866               do:
      867                   run vss-get-parameters in this-procedure (output v-descr).
      868                   message
      869                       vss-workfile vss-revision vss-description skip
      870                       "Нельзя изменять поля первичного ключа" skip
      871                       v-descr skip
      872                       "Старый ПК" old_dis-card-type.uniq-key-rec
      873                       view-as alert-box error .
      874                   undo main-block, return error .
      875               end.
      876           end.
      877       end.
      878       define variable v-cmp as logical no-undo .
      879       if not new(ub.dis-card-type) then
      880       do:
      881           buffer-compare ub.dis-card-type
      882               to old_dis-card-type
      883               case-sensitive
      884               save result in v-cmp.
      885       end.
      886       else
      887       do:
      888           v-cmp = no.
      889       end.
      890       if not v-cmp then
      891       do:
      892           run cur-time in this-procedure(output v-date, output v-time).
      893           create buf_c-dis-card-type.
      894           buffer-copy old_dis-card-type to buf_c-dis-card-type
      895               assign
      896               buf_c-dis-card-type.emitent-host-code    = ub.dis-card-type.emitent-host-code
      897               buf_c-dis-card-type.type                 = ub.dis-card-type.type
      898               buf_c-dis-card-type.host-code            = ub.dis-card-type.host-code
      899               buf_c-dis-card-type.obj-type             = ub.dis-card-type.obj-type
      900               buf_c-dis-card-type.obj-code             = ub.dis-card-type.obj-code
      901               buf_c-dis-card-type.chip-num           = next-value (s-dc-chip, ub)
      902               buf_c-dis-card-type.corr-time          = v-time
      903               buf_c-dis-card-type.corr-user-db-num   = g#db-num
      904               buf_c-dis-card-type.corr-user-name     = g#userid
      905               buf_c-dis-card-type.corr-date          = v-date
      906               buf_c-dis-card-type.action = (if new ub.dis-card-type then integer('1':U) else integer('2':U))
      907               buf_c-dis-card-type.subject = 'dis-card-type':U
      908               buf_c-dis-card-type.uniq-key-rec         = ub.dis-card-type.uniq-key-rec
      909               .
      910       end.
      911       if g#oxml = yes
      912           then
      913       do:
      914           run str/calloxml.p (
      915               input 'update':U
      916               , input 'dis-card-type':U
      917               , input ( buffer ub.dis-card-type:handle )
      918               ) no-error.
      919           if error-status :error
      920               then
      921           do:
      922               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      923                   , chr(10)
      924                   , vss-workfile
      925                   , return-value
      926                   , error-status :get-message ( 1 ) ).
      927           end.
      928       end.
      929       if new(ub.dis-card-type) then
      930       do:
      931           run trg/userlog.p (
      932               input 'create':U
      933               , input 'dis-card-type':U
      934               , input ( buffer ub.dis-card-type :handle )
      935               , input ?
      936               , input ""
      937               ) no-error.
      938           if error-status :error
      939               then
      940           do:
      941               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      942                   , chr(10)
      943                   , vss-workfile
      944                   , return-value
      945                   , error-status :get-message ( 1 ) ).
      946           end.
      947       end.
      948       else
      949       do:
      950           run trg/userlog.p (
      951               input 'update':U
      952               , input 'dis-card-type':U
      953               , input ( buffer ub.dis-card-type :handle )
      954               , input ?
      955               , input ""
      956               ) no-error.
      957           if error-status :error
      958               then
      959           do:
      960               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      961                   , chr(10)
      962                   , vss-workfile
      963                   , return-value
      964                   , error-status :get-message ( 1 ) ).
      965           end.
      966       end.
      967   end.
