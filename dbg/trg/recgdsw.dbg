        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.recipe-gds OLD buffer buf_old_recipe-gds.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись строки рецепта".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   main-block:
      304   do
      305   on error undo main-block, return error return-value
      306   :
      307       if ub.recipe-gds.nws-self = yes
      308       then do:
      309           run str/callnews.p (
      310                 input 'recipe-gds':U
      311               , input ( buffer ub.recipe-gds :handle )
      312           ) no-error.
      313           if error-status :error
      314           then do:
      315               undo, return error substitute( "&1. Ошибка отправки записи recipe-gds по новостям. &2&3&2&4",
      316                                        vss-workfile, chr(10), return-value, error-status :get-message ( 1 ) ).
      317           end.
      318           assign
      319               ub.recipe-gds.nws-self = no
      320           .
      321       end.
      322       if not g#news
      323       then do:
      324           run write-history in this-procedure.
      325       end.
      326       if g#oxml = yes
      327       then do:
      328       run str/calloxml.p (
      329             input 'update':U
      330           , input 'recipe-gds':U
      331           , input ( buffer ub.recipe-gds :handle )
      332       ) no-error.
      333       if error-status :error
      334       then do:
      335           undo, return error substitute( "&1. Ошибка отправки записи recipe-gds в систему OpenXML. &2&3&2&4",
      336                                        vss-workfile, chr(10), return-value, error-status :get-message ( 1 ) ).
      337       end.
      338       end.
      339   end.
      340   procedure write-history :
      341       define variable v-today             as date         no-undo.
      342       define variable v-time              as integer      no-undo.
      343       define variable v-recipe-chip-num   as integer      no-undo.
      344       define variable v-recipe-type       as character    no-undo.
      345       define variable v-is-default        as logical      no-undo.
      346       define buffer buf_c-recipe-gds      for ub.c-recipe-gds.
      347       define buffer buf_c-table-bind      for ub.c-table-bind.
      348       define buffer buf_c-recipe-hist     for ub.c-recipe-hist.
      349       define buffer buf_c-gds-hist        for ub.c-gds-hist.
      350   do
      351   for buf_c-recipe-gds
      352     , buf_c-table-bind
      353     , buf_c-recipe-hist
      354     , buf_c-gds-hist
      355   on error undo, return error
      356   :
      357       run cur-time in this-procedure (
      358             output v-today
      359           , output v-time
      360       ).
      361       create buf_c-recipe-gds.
      362       buffer-copy buf_old_recipe-gds to buf_c-recipe-gds.
      363       assign
      364           buf_c-recipe-gds.corr-user-db-num = g#db-num
      365           buf_c-recipe-gds.chip-num         = next-value( s-fbr-chip, ub )
      366           buf_c-recipe-gds.recipe-code      = ub.recipe-gds.recipe-code
      367           buf_c-recipe-gds.prod-type        = ub.recipe-gds.prod-type
      368           buf_c-recipe-gds.prod-code        = ub.recipe-gds.prod-code
      369           buf_c-recipe-gds.artic            = ub.recipe-gds.artic
      370           buf_c-recipe-gds.corr-time        = v-time
      371           buf_c-recipe-gds.corr-user-name   = g#userid
      372           buf_c-recipe-gds.corr-date        = v-today
      373           buf_c-recipe-gds.corr-action      = ( if new( ub.recipe-gds )
      374                                                 then integer( '1':U )
      375                                                 else integer( '2':U ) )
      376       .
      377       if new( ub.recipe-gds )
      378       then do:
      379           assign
      380               buf_c-recipe-gds.recipe-code    = ub.recipe-gds.recipe-code
      381               buf_c-recipe-gds.gds-code       = ub.recipe-gds.gds-code
      382               buf_c-recipe-gds.artic          = ub.recipe-gds.artic
      383               buf_c-recipe-gds.prod-type      = ub.recipe-gds.prod-type
      384               buf_c-recipe-gds.prod-code      = ub.recipe-gds.prod-code
      385           .
      386       end.
      387       run get-recipe-for-this-line in this-procedure (
      388             input buf_c-recipe-gds.recipe-code
      389           , input buf_c-recipe-gds.chip-num
      390           , output v-recipe-chip-num
      391           , output v-recipe-type
      392           , output v-is-default
      393       ).
      394       create buf_c-recipe-hist.
      395       assign
      396           buf_c-recipe-hist.artic                 = ub.recipe-gds.artic
      397           buf_c-recipe-hist.prod-type             = ub.recipe-gds.prod-type
      398           buf_c-recipe-hist.prod-code             = ub.recipe-gds.prod-code
      399           buf_c-recipe-hist.subject               = 'recipe-gds':U
      400           buf_c-recipe-hist.corr-date             = v-today
      401           buf_c-recipe-hist.corr-time             = v-time
      402           buf_c-recipe-hist.corr-user-name        = g#userid
      403           buf_c-recipe-hist.chip-num              = next-value( s-fbr-chip, ub )
      404           buf_c-recipe-hist.corr-user-db-num      = g#db-num
      405           buf_c-recipe-hist.gds-code              = buf_c-recipe-gds.gds-code
      406           buf_c-recipe-hist.is-default            = v-is-default
      407           buf_c-recipe-hist.recipe-chip-num       = v-recipe-chip-num
      408           buf_c-recipe-hist.recipe-code           = buf_c-recipe-gds.recipe-code
      409           buf_c-recipe-hist.recipe-gds-chip-num   = buf_c-recipe-gds.chip-num
      410           buf_c-recipe-hist.recipe-type           = v-recipe-type
      411           buf_c-recipe-hist.action                = buf_c-recipe-gds.corr-action
      412       .
      413       create buf_c-gds-hist.
      414       buffer-copy buf_c-recipe-hist
      415       except chip-num
      416       to buf_c-gds-hist
      417       assign
      418       buf_c-gds-hist.action = buf_c-recipe-gds.corr-action
      419       buf_c-gds-hist.subject = 'recipe-gds':U
      420       buf_c-gds-hist.is-news = g#news
      421       buf_c-gds-hist.chip-num = next-value (s-gds-chip, ub)
      422       buf_c-gds-hist.source-type = (if g#news then 'db':U else "":U)
      423       buf_c-gds-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      424       .
      425       create buf_c-table-bind.
      426       assign
      427           buf_c-table-bind.corr-user-db-num     = g#db-num
      428           buf_c-table-bind.tbl-name-src   = 'c-recipe-gds':U
      429           buf_c-table-bind.chip-num-src   = buf_c-recipe-gds.chip-num
      430           buf_c-table-bind.tbl-name-rec   = 'c-gds-hist':U
      431           buf_c-table-bind.chip-num-rec   = buf_c-gds-hist.chip-num
      432           buf_c-table-bind.is-news         = g#news
      433           buf_c-table-bind.corr-user-name  = g#userid
      434           buf_c-table-bind.subject = 'recipe-gds':U
      435       .
      436   end.
      437   end procedure.
      438   procedure get-recipe-for-this-line :
      439   define input parameter p-recipe-code        as character        no-undo.
      440   define input parameter p-chip-num           as integer          no-undo.
      441   define output parameter p-recipe-chip-num   as integer          no-undo.
      442   define output parameter p-recipe-type       as character        no-undo.
      443   define output parameter p-is-default        as logical          no-undo.
      444       define variable v-recipe-found      as logical      no-undo.
      445       define buffer buf_c-recipe          for ub.c-recipe.
      446       define buffer buf_recipe            for ub.recipe.
      447   do
      448   for buf_c-recipe
      449     , buf_recipe
      450   on error undo, return error
      451   :
      452       assign
      453           v-recipe-found = no
      454       .
      455       for each buf_c-recipe no-lock
      456          where buf_c-recipe.recipe-code = p-recipe-code
      457            and buf_c-recipe.chip-num    < p-chip-num
      458       on error undo, return error
      459       :
      460           assign
      461               v-recipe-found      = yes
      462               p-recipe-chip-num   = buf_c-recipe.chip-num
      463               p-recipe-type       = buf_c-recipe.recipe-type
      464               p-is-default        = buf_c-recipe.is-default
      465           .
      466       end.
      467       if v-recipe-found = no
      468       then do:
      469           find first buf_recipe no-lock
      470                where buf_recipe.recipe-code = p-recipe-code
      471           no-error.
      472           if available buf_recipe
      473           then do:
      474               assign
      475                   v-recipe-found      = yes
      476                   p-recipe-chip-num   = 0
      477                   p-recipe-type       = buf_recipe.recipe-type
      478                   p-is-default        = buf_recipe.is-default
      479               .
      480           end.
      481           else do:
      482               assign
      483                   v-recipe-found      = no
      484                   p-recipe-chip-num   = 0
      485                   p-recipe-type       = "":U
      486                   p-is-default        = no
      487               .
      488           end.
      489       end.
      490   end.
      491   end procedure.
