        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.route .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление записи маршрутизации".
        9   do
       10   on error undo, return error
       11   :
       12   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       13   define buffer buf_route           for ub.route .
       14   define buffer buf_route-dump      for ub.route-dump .
       15   define buffer buf_route-dump-link for ub.route-dump-link .
       16   define buffer buf_sys-ctrl        for ub.sys-ctrl .
       17   disable triggers for load of ub.route-dump .
       18   find first buf_sys-ctrl no-lock.
       19   if buf_sys-ctrl.db-num = 0 then do:
       20     find first buf_route no-lock
       21       where buf_route.dump-ord = ub.route.dump-ord
       22         and buf_route.db-num   > ub.route.db-num
       23       no-error
       24     .
       25     if not available buf_route then do:
       26       find first buf_route no-lock
       27         where buf_route.dump-ord = ub.route.dump-ord
       28           and buf_route.db-num   < ub.route.db-num
       29         no-error
       30       .
       31     end.
       32   end.
       33   if buf_sys-ctrl.db-num <> 0
       34     or not available buf_route
       35   then do:
       36     for each buf_route-dump-link
       37       where buf_route-dump-link.dump-ord = ub.route.dump-ord
       38     on error undo, return error
       39     :
       40       delete buf_route-dump-link.
       41     end.
       42     for each buf_route-dump
       43       where buf_route-dump.dump-ord = ub.route.dump-ord
       44     on error undo, return error
       45     :
       46       delete buf_route-dump.
       47     end.
       48   end.
       49   end.
