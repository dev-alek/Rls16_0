        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.config old old-config.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись данных настройки и конфигурации системы".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   Function reverse returns character (str as character).
       80      define variable rev_incl_s as character init "" no-undo .
       81      define variable rev_incl_i as integer no-undo .
       82      define variable rev_incl_l as integer no-undo .
       83      rev_incl_l = length(str).
       84      do rev_incl_i = 1 to rev_incl_l:
       85         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
       86      end.
       87      return rev_incl_s.
       88   end.
       89   procedure check-enc.
       90     define input  parameter p-db-num    as integer   no-undo .
       91     define input  parameter p-db-key    as character no-undo .
       92     define input  parameter p-code      as character no-undo .
       93     define input  parameter p-value     as character no-undo .
       94     define input  parameter p-beg-date  as date      no-undo .
       95     define input  parameter p-end-date  as date      no-undo .
       96     define input  parameter p-enc-value as character no-undo .
       97     define output parameter p-answer    as logical   no-undo .
       98     define variable tmp         as character no-undo .
       99     define variable v-enc-value as character no-undo .
      100     if p-db-num <> 0
      101       and p-db-key = "":U
      102     then do:
      103       assign
      104         p-answer = true
      105       .
      106       return.
      107     end.
      108     if p-db-key = "unload-db":U then do:
      109       assign
      110         p-answer = true
      111       .
      112       return.
      113     end.
      114     if p-code = ""  then do:
      115       assign
      116         tmp = string( p-db-num ) + reverse (p-db-key).
      117       .
      118     end.
      119     else do:
      120       assign
      121         tmp = string( p-db-num )
      122               + trim( p-db-key )
      123               + reverse( trim( p-code ) )
      124               + reverse( trim( p-value ) )
      125               + reverse( string( p-beg-date, "99.99.9999" ) )
      126               + reverse( string( p-end-date, "99.99.9999" ) )
      127       .
      128     end.
      129     run pswd-enc in this-procedure
      130       ( input tmp
      131        ,output v-enc-value
      132       ) no-error .
      133     if error-status:error then do:
      134       message
      135         vss-workfile vss-revision vss-description skip
      136         "Ошибка при вызове процедуры pswd-enc" skip
      137         return-value skip
      138         error-status :get-message(1) skip
      139         view-as alert-box error .
      140       undo, return error .
      141     end.
      142     if v-enc-value = p-enc-value then do:
      143       assign
      144         p-answer = true
      145       .
      146     end.
      147     else do:
      148       assign
      149         p-answer = false
      150       .
      151     end.
      152   end.
      153   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   procedure pswd-enc :
      155     define input parameter  pswd     as character no-undo .
      156     define output parameter enc-pswd as character no-undo .
      157     do
      158     on error undo, return error return-value
      159     :
      160       assign
      161         enc-pswd = encode(pswd + string(index(pswd, "k")))
      162       .
      163     end.
      164   end procedure.
      165   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   procedure cur-time :
      167      define output parameter p-today as date      no-undo .
      168      define output parameter p-time  as integer   no-undo .
      169     do
      170     on error undo, return error
      171     :
      172       define variable v-date1 as date      no-undo .
      173       define variable v-date2 as date      no-undo .
      174       define variable v-time  as integer   no-undo .
      175       assign
      176         v-date1 = today
      177         v-time  = time
      178         v-date2 = today
      179       .
      180       if v-date1 <> v-date2
      181       then do:
      182         assign
      183           v-date1 = today
      184           v-time  = v-time
      185         .
      186       end.
      187       assign
      188         p-today = v-date1
      189         p-time  = v-time
      190       .
      191     end.
      192   end.
      193   function cur-time-date returns character
      194   :
      195     return string(today, '99/99/9999':U) .
      196   end.
      197   function cur-time-mjd returns decimal
      198   :
      199     define variable v-date as date      no-undo .
      200     define variable v-time as integer   no-undo .
      201     run cur-time in this-procedure
      202       (output v-date
      203       ,output v-time
      204       ) .
      205     return integer(v-date) - 2400002 + (v-time / 86400) .
      206   end.
      207   function cur-time-get-ending-index returns integer
      208   (input p-number as integer
      209   )
      210   :
      211     if p-number < 0
      212     or p-number = ?
      213     then do:
      214       return 1 .
      215     end.
      216     define variable v-rest as integer   no-undo .
      217     assign
      218       p-number = p-number modulo 100
      219     .
      220     if p-number < 20
      221     then do:
      222       assign
      223         v-rest = p-number
      224       .
      225     end.
      226     else do:
      227       assign
      228         v-rest = p-number modulo 10
      229       .
      230     end.
      231     case v-rest :
      232       when 1
      233       then do:
      234         return 2 .
      235       end.
      236       when 2 or
      237       when 3 or
      238       when 4
      239       then do:
      240         return 3 .
      241       end.
      242       otherwise do:
      243         return 1 .
      244       end.
      245     end case .
      246   end.
      247   procedure cur-time-mjd-to-date :
      248      define input  parameter i-mjd-diff as decimal no-undo.
      249      define output parameter o-Date     as date    no-undo.
      250      define output parameter o-Time     as integer no-undo.
      251      define variable v-day-number as integer   no-undo .
      252      if    i-mjd-diff < 0
      253         or i-mjd-diff = ?
      254      then do:
      255         return "?" .
      256      end.
      257      assign
      258         v-day-number = truncate(i-mjd-diff,0).
      259         o-Date = date(v-day-number + 2400002).
      260         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      261     .
      262   end.
      263   function cur-time-mjd-to-string returns character
      264   (input p-mjd-diff as decimal
      265   )
      266   :
      267     define variable v-day-number as integer   no-undo .
      268     define variable v-seconds    as integer   no-undo .
      269     define variable v-hour       as integer   no-undo .
      270     define variable v-min        as integer   no-undo .
      271     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      272     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      273     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      274     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      275     if p-mjd-diff < 0
      276     or p-mjd-diff = ?
      277     then do:
      278       return "?" .
      279     end.
      280     assign
      281       v-day-number = integer(truncate(p-mjd-diff,0))
      282       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      283     .
      284     if v-seconds > 86400
      285     then do:
      286       assign
      287         v-seconds = 86400 - 1
      288       .
      289     end.
      290     if v-seconds < 0
      291     then do:
      292       assign
      293         v-seconds = 0
      294       .
      295     end.
      296     assign
      297       v-hour = truncate(v-seconds / 3600, 0)
      298     .
      299     assign
      300       v-seconds = v-seconds modulo 3600
      301     .
      302     assign
      303       v-min = truncate(v-seconds / 60, 0)
      304     .
      305     assign
      306       v-seconds = v-seconds modulo 60
      307     .
      308     return
      309         (if v-day-number <> 0
      310           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      311           else ""
      312         )
      313       + (if v-day-number <> 0 or v-hour <> 0
      314           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      315           else ""
      316         )
      317       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      318           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      319           else ""
      320         )
      321       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      322       .
      323   end.
      324   function cur-time-string returns character
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      333   end.
      334   function cur-time-string-sec returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      343   end.
      344   function cur-time-custom  returns character
      345   (input p-prefix as character
      346   ,input p-date-format as character
      347   ,input p-delimiter as character
      348   ,input p-time-format as character
      349   ,input p-suffix as character
      350   )
      351   :
      352     define variable v-date as date      no-undo .
      353     define variable v-time as integer   no-undo .
      354     run cur-time in this-procedure
      355       (output v-date
      356       ,output v-time
      357       ) .
      358     return
      359       p-prefix
      360       + string(v-date, p-date-format)
      361       + p-delimiter
      362       + string(v-time, p-time-format)
      363       + p-suffix
      364       .
      365   end.
      366   function cur-time-print  returns character
      367   :
      368     define variable v-date as date      no-undo .
      369     define variable v-time as integer   no-undo .
      370     run cur-time in this-procedure
      371       (output v-date
      372       ,output v-time
      373       ) .
      374     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      375   end.
      376   function cur-time-datetime returns datetime
      377   :
      378     define variable v-char as character no-undo .
      379     define variable v-datetime as datetime no-undo .
      380     v-char = cur-time-string().
      381     v-datetime = datetime(v-char).
      382     return  v-datetime.
      383   end.
      384   function cur-time-string-msec returns character
      385   :
      386     define variable v-date as datetime  no-undo .
      387     v-date = now.
      388     return string(v-date) .
      389   end.
      390   main-block:
      391   do
      392       on error  undo main-block, return error substitute("&1. error &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      393       on endkey undo main-block, return error substitute("&1. endkey")
      394       on stop   undo main-block, return error substitute("&1. stop")
      395       :
      396       define variable v-ok              as logical   no-undo .
      397       define variable v-host-code       as integer   no-undo .
      398       define variable v-assignment-type as character no-undo .
      399       define variable v-field-chg       as character no-undo .
      400       define variable v-date            as date      no-undo .
      401       define variable v-time            as integer   no-undo .
      402       define buffer buf_c-config for ub.c-config .
      403       define buffer buf_sys-ctrl for ub.sys-ctrl .
      404       if ub.config.param-code = ""
      405           or ub.config.param-code = ?
      406           then
      407       do:
      408           message
      409               vss-workfile vss-revision vss-description skip
      410               "Имя параметра должно быть задано" skip
      411               "param-code" ub.config.param-code skip
      412               view-as alert-box error .
      413           undo, return error .
      414       end.
      415       if not new ub.config
      416           and ub.config.param-code <> old-config.param-code
      417           then
      418       do:
      419           message
      420               vss-workfile vss-revision vss-description skip
      421               "Нельзя изменить имя параметра" skip
      422               "param-code" ub.config.param-code skip
      423               view-as alert-box error .
      424           return error .
      425       end.
      426       if length(ub.config.param-code) > 8
      427           then
      428       do:
      429           message
      430               vss-workfile vss-revision vss-description skip
      431               "Длина имени параметра не может превышать 8 символов" skip
      432               "param-code" ub.config.param-code skip
      433               view-as alert-box error .
      434           undo, return error .
      435       end.
      436       if lookup( ub.config.param-type, "C,L,D,I,T") = 0
      437           then
      438       do:
      439           message
      440               vss-workfile vss-revision vss-description skip
      441               "Неизвестный тип параметра" skip
      442               "param-code" ub.config.param-code skip
      443               "param-type" ub.config.param-type skip
      444               view-as alert-box error .
      445           undo, return error .
      446       end.
      447       if ub.config.host-code <> 0
      448           then
      449       do:
      450           find first ub.sysconf no-lock
      451               where ub.sysconf.host-code = ub.config.host-code
      452               no-error .
      453           if not available ub.sysconf
      454               then
      455           do:
      456               message
      457                   vss-workfile vss-revision vss-description skip
      458                   "Задан неправильный код фирмы"    skip
      459                   "param-code" ub.config.param-code skip
      460                   "host-code"  ub.config.host-code  skip
      461                   view-as alert-box error .
      462               undo, return error .
      463           end.
      464       end.
      465       if ub.config.obj-type <> ""
      466           or ub.config.obj-code <> 0
      467           then
      468       do:
      469   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      470   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      471     (input  ub.config.obj-type
      472     ,input  ub.config.obj-code
      473     ,output v-host-code
      474     ) no-error .
      475           if error-status :error
      476               then
      477           do:
      478               message
      479                   vss-workfile vss-revision vss-description skip
      480                   "Ошибка при определении кода фирмы для объекта" skip
      481                   "param-code" ub.config.param-code skip
      482                   "ub.config.obj-type" ub.config.obj-type skip
      483                   "ub.config.obj-code" ub.config.obj-code skip
      484                   view-as alert-box error .
      485               undo, return error .
      486           end.
      487           if ub.config.host-code = 0
      488               or ub.config.host-code = ?
      489               then
      490           do:
      491               assign
      492                   ub.config.host-code = v-host-code
      493                   .
      494           end.
      495           if ub.config.host-code <> v-host-code
      496               then
      497           do:
      498               message
      499                   vss-workfile vss-revision vss-description skip
      500                   "Фирма не соответствует объекту"  skip
      501                   "param-code" ub.config.param-code skip
      502                   "host-code"  ub.config.host-code  skip
      503                   "obj-type"   ub.config.obj-type   skip
      504                   "obj-code"   ub.config.obj-code   skip
      505                   view-as alert-box error .
      506               undo, return error .
      507           end.
      508       end.
      509       assign
      510           v-assignment-type = ( if  ub.config.host-code = 0  then "0" else "1" )
      511                           + ( if  ub.config.obj-type  = ""
      512                               and ub.config.obj-code  = 0
      513                               then "0" else "1"
      514                             )
      515           .
      516       if lookup( v-assignment-type, '00,10,11':U ) = 0
      517           then
      518       do:
      519           message
      520               vss-workfile vss-revision vss-description skip
      521               "Неправильная привязка параметра конфигурации" skip
      522               "param-code" ub.config.param-code skip
      523               "host-code"  ub.config.host-code  skip
      524               "obj-type"   ub.config.obj-type   skip
      525               "obj-code"   ub.config.obj-code   skip
      526               "привязка"   v-assignment-type    skip
      527               view-as alert-box error .
      528           undo, return error .
      529       end.
      530       if not new ub.config
      531           and ub.config.conf-type <> old-config.conf-type
      532           then
      533       do:
      534           message
      535               vss-workfile vss-revision vss-description skip
      536               "Нельзя изменить тип параметра." skip
      537               "param-code" ub.config.param-code skip
      538               view-as alert-box error .
      539           return error .
      540       end.
      541       if not new ub.config
      542           and ub.config.conf-type = 'к,п':U
      543           then
      544       do:
      545           if ub.config.host-code  <> old-config.host-code
      546               or ub.config.obj-type   <> old-config.obj-type
      547               or ub.config.obj-code   <> old-config.obj-code
      548               then
      549           do:
      550               message
      551                   vss-workfile vss-revision vss-description skip
      552                   "Параметр кодированный" skip
      553                   "Нельзя изменить привязку кодированного параметра" skip
      554                   "param-code" ub.config.param-code skip
      555                   view-as alert-box error .
      556               return error .
      557           end.
      558       end.
      559       if lookup( ub.config.conf-type, 'к,п':U ) > 0
      560           then
      561       do:
      562           find first ub.db no-lock
      563               where ub.db.db-num = ub.config.db-num
      564               .
      565           run check-enc in this-procedure
      566               ( input ub.config.db-num
      567               ,input ub.db.db-key
      568               ,input ub.config.param-code
      569               ,input ub.config.param-value
      570               ,input ub.config.beg-date
      571               ,input ub.config.end-date
      572               ,input ub.config.param-encoded
      573               ,output v-ok
      574               ) no-error .
      575           if error-status :error
      576               then
      577           do:
      578               undo main-block, return error substitute("&1. Ошибка при проверке кодировки параметра &2&3&4&3&5", vss-workfile, ub.config.param-code, chr(10), return-value, error-status :get-message ( 1 ) ).
      579           end.
      580           if v-ok <> true
      581               then
      582           do:
      583               undo main-block, return error substitute("&1. Неверное кодированное значение параметра &2", vss-workfile, ub.config.param-code ).
      584           end.
      585       end.
      586       if  ub.config.db-num = g#db-num
      587           and lookup(ub.config.conf-type, 'к,п':U) > 0
      588           then
      589       do:
      590           run gbl/menu-clr.p
      591               (input 0
      592               ) .
      593           run gbl/actn-clr.p
      594               (input 0
      595               ) .
      596       end.
      597       if ub.config.beg-date = ?
      598           or ub.config.end-date = ?
      599           then
      600       do:
      601           undo main-block, return error substitute("&1. Не задана дата начала и/или окончания действия параметра &2", vss-workfile, ub.config.param-code ).
      602       end.
      603       buffer-compare ub.config to old-config save result in v-field-chg.
      604       if v-field-chg <> "stts":U
      605           then
      606       do:
      607           find first buf_sys-ctrl no-lock .
      608           run cur-time in this-procedure
      609               ( output v-date
      610               ,output v-time
      611               ).
      612           create buf_c-config.
      613           if new(ub.config) then
      614           do:
      615               assign
      616                   buf_c-config.param-code = ub.config.param-code
      617                   buf_c-config.host-code  = ub.config.host-code
      618                   buf_c-config.obj-type   = ub.config.obj-type
      619                   buf_c-config.obj-code   = ub.config.obj-code
      620                   buf_c-config.beg-date   = ub.config.beg-date
      621                   buf_c-config.end-date   = ub.config.end-date
      622                   buf_c-config.db-num     = ub.config.db-num
      623                   .
      624           end.
      625           else
      626           do:
      627               buffer-copy old-config to buf_c-config .
      628           end.
      629           assign
      630               buf_c-config.chip-num         = next-value (s-cfg-chip, ub)
      631               buf_c-config.corr-time        = v-time
      632               buf_c-config.corr-date        = v-date
      633               buf_c-config.corr-user-db-num = buf_sys-ctrl.db-num
      634               buf_c-config.corr-user-name   = (if g#news = true then "СПН" else g#userid )
      635               buf_c-config.action           = integer(if new(ub.config) then '1':U else '2':U)
      636               .
      637           if trim( buf_c-config.corr-user-name ) = "":U then
      638           do:
      639               assign
      640                   buf_c-config.corr-user-name = userid( "ub":U )
      641                   .
      642           end.
      643       end.
      644       run str/callnews.p
      645           (input 'config':U
      646           ,input (buffer ub.config:handle)
      647           ) no-error .
      648       if error-status :error
      649           then
      650       do:
      651           undo main-block, return error substitute("&1. Невозможно маршрутизировать config для отправки в новости &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( 1 ) ).
      652       end.
      653       if g#oxml = yes then
      654       do:
      655           run str/calloxml.p
      656               ( input 'update':U
      657               ,input 'config':U
      658               ,input ( buffer ub.config:handle )
      659               ) no-error.
      660           if error-status :error then
      661           do:
      662               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      663                   , chr(10)
      664                   , vss-workfile
      665                   , return-value
      666                   , error-status :get-message ( 1 ) ).
      667           end.
      668       end.
      669       if new(ub.config) then
      670       do:
      671           run trg/userlog.p (
      672               input 'create':U
      673               , input 'config':U
      674               , input ( buffer ub.config :handle )
      675               , input ?
      676               , input ""
      677               ) no-error.
      678           if error-status :error
      679               then
      680           do:
      681               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      682                   , chr(10)
      683                   , vss-workfile
      684                   , return-value
      685                   , error-status :get-message ( 1 ) ).
      686           end.
      687       end.
      688       else
      689       do:
      690           run trg/userlog.p (
      691               input 'update':U
      692               , input 'config':U
      693               , input ( buffer ub.config :handle )
      694               , input ?
      695               , input ""
      696               ) no-error.
      697           if error-status :error
      698               then
      699           do:
      700               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      701                   , chr(10)
      702                   , vss-workfile
      703                   , return-value
      704                   , error-status :get-message ( 1 ) ).
      705           end.
      706       end.
      707   end.
