        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.code-range old buffer old_code-range .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись диапазонов кодов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define buffer buf_code-range for ub.code-range .
       79   define variable v-code-range-type-list  as character no-undo .
       80   define variable v-analogous-type        as character no-undo .
       81   define variable ind                     as integer   no-undo .
       82   define variable v-code-range-stts-list  as character no-undo init "f,a,u,c,l,X->0" .
       83   define variable l-need-send-to-news     as logical   no-undo init false .
       84   define variable l-record-the-same       as logical   no-undo .
       85   define variable v-is-scgb               as logical   no-undo .
       86   main-block:
       87   do
       88   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       89   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       90   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       91   :
       92     assign
       93       v-code-range-type-list = 'bcgb':U + chr(44)
       94                                + 'sclc':U + chr(44)
       95                                + 'scgb':U + chr(44)
       96                                + 'pglc':U + chr(44)
       97                                + 'sslc':U + chr(44)
       98                                + 'ssgb':U + chr(44)
       99                                + 'ptlc':U + chr(44)
      100                                + 'dcgb':U + chr(44)
      101                                + 'drgb':U + chr(44)
      102                                + 'ctgb':U + chr(44)
      103                                + 'fmgb':U + chr(44)
      104                                + 'pngb':U + chr(44)
      105                                + 'cagb':U + chr(44)
      106                                + 'fdgb':U
      107     .
      108     if lookup( ub.code-range.range-type, 'sslc,bcgb,sclc,scgb,ssgb,pglc,ptlc':U ) <> 0 then do:
      109       assign
      110         v-analogous-type = 'sslc,bcgb,sclc,scgb,ssgb,pglc,ptlc':U
      111         .
      112     end.
      113     else do:
      114       assign
      115         v-analogous-type = ub.code-range.range-type
      116         .
      117     end.
      118     assign
      119       l-need-send-to-news = false
      120     .
      121     if new ub.code-range
      122       and g#db-num <> 0
      123       and ub.code-range.range-type <> 'cagb':U
      124       and g#news   <> true
      125     then do:
      126       message
      127         vss-workfile vss-revision vss-description skip
      128         "Создание новых диапазонов кодов допустимо только в БД 0!" skip
      129         view-as alert-box.
      130       undo main-block, return error .
      131     end.
      132     if new ub.code-range
      133       and g#db-num = 0
      134       and ub.code-range.range-type = 'scgb':U
      135     then do:
      136   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      139   define variable par-type          as character no-undo.
      140   define variable v-value-character as character no-undo .
      141   define variable v-value-date      as date      no-undo .
      142   define variable v-value-decimal   as decimal   no-undo .
      143   define variable v-value-integer   as integer   no-undo .
      144   define variable v-value-logical   as logical   no-undo .
      145   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   empty temp-table thbjattr_thbj-attr.
      147   run adm/shattri.p (
      148      input "get":U
      149     ,input ''
      150     ,input 0
      151     ,input 'gds-ref':U
      152     ,input  ""
      153     ,output v-value-character
      154     ,output v-value-date
      155     ,output v-value-decimal
      156     ,output v-value-integer
      157     ,output v-value-logical
      158     ,output par-type
      159     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      160     ) no-error .
      161       for each thbjattr_thbj-attr :
      162           if thbjattr_thbj-attr.prop-code = 'is-scgb':U then v-is-scgb = thbjattr_thbj-attr.property-value-logical .
      163       end.
      164       if v-is-scgb <> true then do:
      165         message
      166           vss-workfile vss-revision vss-description skip
      167           "Создание диапазонов глобальных весовых кодов запрещено (is-scgb)!" skip
      168           "Изменить этот параметр можно в Администратор-Глобальные настройки" skip
      169           view-as alert-box.
      170         undo main-block, return error .
      171       end.
      172     end.
      173     if not new ub.code-range then do:
      174       if ub.code-range.stts = "c":U then do:
      175         if ub.code-range.range-type <> old_code-range.range-type
      176           or ub.code-range.first-code <> old_code-range.first-code
      177         then do:
      178           message
      179             vss-workfile vss-revision vss-description skip
      180             "Нельзя менять значения типа и(или) начала диапазона" skip
      181             "новый range-type" ub.code-range.range-type skip
      182             "новый first-code" ub.code-range.first-code skip
      183             "старый range-type" old_code-range.range-type skip
      184             "старый first-code" old_code-range.first-code skip
      185             view-as alert-box .
      186           undo main-block, return error .
      187         end.
      188       end.
      189       else do:
      190         buffer-compare
      191         ub.code-range
      192         except ub.code-range.db-num ub.code-range.stts ub.code-range.PS ub.code-range.beg-date
      193         to old_code-range
      194         save result in l-record-the-same .
      195         if l-record-the-same <> true then do:
      196           message
      197             vss-workfile vss-revision vss-description skip
      198             "Для диапазона бар-кодов возможно только изменение статуса" skip
      199             "Или смена номера базы данных с -1 на номер реальной базы данных"
      200             "db-num"     ub.code-range.db-num     skip
      201             "stts"       ub.code-range.stts       skip
      202             "range-type" ub.code-range.range-type skip
      203             "first-code" ub.code-range.first-code skip
      204             "last-code"  ub.code-range.last-code  skip
      205             view-as alert-box .
      206           undo main-block, return error .
      207         end.
      208         if ub.code-range.db-num <> old_code-range.db-num then do:
      209           if old_code-range.db-num = -1
      210             or ( ub.code-range.db-num = 0
      211                  and ub.code-range.stts = "X->0":U
      212                )
      213           then do:
      214             assign
      215               l-need-send-to-news = true
      216             .
      217           end.
      218           else do:
      219             message
      220               vss-workfile vss-revision vss-description skip
      221               "Для диапазона бар-кодов возможно только изменение статуса" skip
      222               "Смена номера базы данных допустима только если предыдущий номер БД был -1" skip
      223               "База данных"   ub.code-range.db-num skip
      224               "Тип диапазона" ub.code-range.range-type skip
      225               "Статус"        ub.code-range.stts skip
      226               "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      227               view-as alert-box .
      228             undo main-block, return error .
      229           end.
      230         end.
      231         if old_code-range.stts = "X->0":U
      232         then do:
      233           assign
      234             l-need-send-to-news = true
      235           .
      236         end.
      237       end.
      238     end.
      239     else do:
      240       if not g#news then do:
      241         assign
      242           ub.code-range.beg-date = today
      243         .
      244       end.
      245       if ub.code-range.db-num <> -1 and ub.code-range.stts = "f" then do:
      246         assign
      247           l-need-send-to-news = true
      248         .
      249       end.
      250     end.
      251     if ub.code-range.db-num <> -1 then do:
      252       find first ub.db no-lock
      253         where ub.db.db-num = ub.code-range.db-num
      254         no-error .
      255       if not available ub.db then do:
      256         message
      257           vss-workfile vss-revision vss-description skip
      258           "Диапазон бар-кодов, ссылка на несуществующую базу данных." skip
      259           "База данных"   ub.code-range.db-num skip
      260           "Тип диапазона" ub.code-range.range-type skip
      261           "Статус"        ub.code-range.stts skip
      262           "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      263           view-as alert-box error .
      264         undo main-block, return error .
      265       end.
      266     end.
      267     if lookup(ub.code-range.range-type, v-code-range-type-list) = 0 then do:
      268       message
      269         vss-workfile vss-revision vss-description skip
      270         "Диапазон бар-кодов, неизвестный тип диапазона" skip
      271         "База данных"   ub.code-range.db-num skip
      272         "Тип диапазона" ub.code-range.range-type skip
      273         "Статус"        ub.code-range.stts skip
      274         "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      275         view-as alert-box .
      276       undo main-block, return error .
      277     end.
      278     if length(ub.code-range.range-type) > 4 then do:
      279       message
      280         vss-workfile vss-revision vss-description skip
      281         "Длина типа диапазона бар-кодов не может превышать 4 символа" skip
      282         "База данных"   ub.code-range.db-num skip
      283         "Тип диапазона" ub.code-range.range-type skip
      284         "Статус"        ub.code-range.stts skip
      285         "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      286         view-as alert-box .
      287       undo main-block, return error .
      288     end.
      289     if lookup(ub.code-range.stts, v-code-range-stts-list ) = 0 then do:
      290       message
      291         vss-workfile vss-revision vss-description skip
      292         "Диапазон бар-кодов, неизвестный статус" skip
      293         "База данных"   ub.code-range.db-num skip
      294         "Тип диапазона" ub.code-range.range-type skip
      295         "Статус"        ub.code-range.stts skip
      296         "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      297         view-as alert-box .
      298       undo main-block, return error .
      299     end.
      300     if not new ub.code-range
      301       and old_code-range.stts <> ub.code-range.stts
      302       and old_code-range.db-num <> -1
      303       and ub.code-range.stts <> "c":U
      304       and old_code-range.stts <> "c":U
      305       and ub.code-range.stts <> "X->0":U
      306       and old_code-range.stts <> "X->0":U
      307     then do:
      308       if  (ub.code-range.stts = "a":U and old_code-range.stts = "f":U)
      309       or  (ub.code-range.stts = "u":U and old_code-range.stts = "a":U)
      310       or  (ub.code-range.stts = "u":U and old_code-range.stts = "f":U)
      311       then do:
      312       end.
      313       else do:
      314         message
      315           vss-workfile vss-revision vss-description skip
      316           "Диапазон бар-кодов - неправильная смена статуса" skip
      317           "База данных"   ub.code-range.db-num skip
      318           "Тип диапазона" ub.code-range.range-type skip
      319           "Статус"        ub.code-range.stts skip
      320           "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      321           "Предыдущий статус" old_code-range.stts skip
      322           view-as alert-box .
      323         undo main-block, return error .
      324       end.
      325     end.
      326     if ub.code-range.stts = "a" and ub.code-range.db-num = g#db-num then do:
      327       find first buf_code-range
      328         where buf_code-range.db-num     = ub.code-range.db-num
      329           and buf_code-range.range-type = ub.code-range.range-type
      330           and buf_code-range.stts       = ub.code-range.stts
      331           and recid(buf_code-range)     <> recid(ub.code-range)
      332         no-error .
      333       if available buf_code-range then do:
      334         message
      335           vss-workfile vss-revision vss-description skip
      336           "Для базы данных и типа может быть только один активный диапазон" skip
      337           "Изменение статуса диапазона" skip
      338           "База данных"   ub.code-range.db-num skip
      339           "Тип диапазона" ub.code-range.range-type skip
      340           "Статус"        ub.code-range.stts skip
      341           "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      342           "Существующий диапазон" skip
      343           "База данных"   buf_code-range.db-num skip
      344           "Тип диапазона" buf_code-range.range-type skip
      345           "Статус"        buf_code-range.stts skip
      346           "Диапазон"      buf_code-range.first-code  ":" buf_code-range.last-code  skip
      347           view-as alert-box .
      348         undo main-block, return error .
      349       end.
      350     end.
      351     if ub.code-range.first-code = ?
      352     or ub.code-range.first-code <= 0 then do:
      353       message
      354         vss-workfile vss-revision vss-description skip
      355         "Диапазон бар-кодов, начальное значение неопределено или отрицательно" skip
      356         "База данных"   ub.code-range.db-num skip
      357         "Тип диапазона" ub.code-range.range-type skip
      358         "Статус"        ub.code-range.stts skip
      359         "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      360         view-as alert-box .
      361       undo main-block, return error .
      362     end.
      363     if ub.code-range.last-code = ?
      364     or ub.code-range.last-code <= 0 then do:
      365       message
      366         vss-workfile vss-revision vss-description skip
      367         "Диапазон бар-кодов, конечное значение неопределено или отрицательно" skip
      368         "База данных"   ub.code-range.db-num skip
      369         "Тип диапазона" ub.code-range.range-type skip
      370         "Статус"        ub.code-range.stts skip
      371         "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      372         view-as alert-box .
      373       undo main-block, return error .
      374     end.
      375     if ub.code-range.first-code >= ub.code-range.last-code then do:
      376       message
      377         vss-workfile vss-revision vss-description skip
      378         "Диапазон бар-кодов, начальное значение превышает или равно конечному значению" skip
      379         "База данных"   ub.code-range.db-num skip
      380         "Тип диапазона" ub.code-range.range-type skip
      381         "Статус"        ub.code-range.stts skip
      382         "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      383         view-as alert-box .
      384       undo main-block, return error .
      385     end.
      386     case ub.code-range.range-type :
      387       when 'bcgb':U then do:
      388         if ub.code-range.first-code < 1 then do:
      389           message
      390             vss-workfile vss-revision vss-description skip
      391             "Начало диапазона собственных кодов должно быть не меньше 100000" skip
      392             "db-num"     ub.code-range.db-num     skip
      393             "stts"       ub.code-range.stts       skip
      394             "range-type" ub.code-range.range-type skip
      395             "first-code" ub.code-range.first-code skip
      396             "last-code"  ub.code-range.last-code  skip
      397             view-as alert-box .
      398           undo main-block, return error .
      399         end.
      400       end.
      401       when 'scgb':U
      402       or when 'sclc':U
      403       or when 'pglc':U
      404       then do:
      405         if ub.code-range.first-code < 100
      406            or ub.code-range.last-code > 99999 then do:
      407           message
      408             vss-workfile vss-revision vss-description skip
      409             "Диапазон весовых кодов штучных кодов для весов может быть в пределах от 100 до 99999 включительно" skip
      410             "db-num"     ub.code-range.db-num     skip
      411             "stts"       ub.code-range.stts       skip
      412             "range-type" ub.code-range.range-type skip
      413             "first-code" ub.code-range.first-code skip
      414             "last-code"  ub.code-range.last-code  skip
      415             view-as alert-box .
      416           undo main-block, return error .
      417         end.
      418       end.
      419       when 'ptlc':U then do:
      420         if ub.code-range.last-code > 99 then do:
      421           message
      422             vss-workfile vss-revision vss-description skip
      423             "Диапазон топливных кодов может быть в пределах от 1 до 99 включительно" skip
      424             "db-num"     ub.code-range.db-num     skip
      425             "stts"       ub.code-range.stts       skip
      426             "range-type" ub.code-range.range-type skip
      427             "first-code" ub.code-range.first-code skip
      428             "last-code"  ub.code-range.last-code  skip
      429             view-as alert-box .
      430           undo main-block, return error .
      431         end.
      432       end.
      433     end case.
      434     define variable v-check-type as character no-undo .
      435     do ind = 1 to num-entries( v-analogous-type ) :
      436       assign
      437         v-check-type = entry( ind, v-analogous-type )
      438       .
      439       for each buf_code-range
      440         where buf_code-range.first-code >= ub.code-range.first-code
      441           and buf_code-range.first-code <= ub.code-range.last-code
      442           and buf_code-range.range-type = v-check-type
      443           and recid(buf_code-range) <> recid(ub.code-range)
      444       on error undo main-block, return error
      445       :
      446         message
      447           vss-workfile vss-revision vss-description skip
      448           "Существует диапазон бар-кодов, который пересекается с создаваемым диапазоном" skip
      449           "База данных"   ub.code-range.db-num skip
      450           "Тип диапазона" ub.code-range.range-type skip
      451           "Статус"        ub.code-range.stts skip
      452           "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      453           "Существует диапазон:" buf_code-range.first-code ":" buf_code-range.last-code skip
      454           "Тип диапазона" buf_code-range.range-type skip
      455           view-as alert-box .
      456         undo main-block, return error .
      457       end.
      458       for each buf_code-range
      459         where buf_code-range.last-code >= ub.code-range.first-code
      460           and buf_code-range.last-code <= ub.code-range.last-code
      461           and buf_code-range.range-type = v-check-type
      462           and recid(buf_code-range) <> recid(ub.code-range)
      463       on error undo main-block, return error
      464       :
      465         message
      466           vss-workfile vss-revision vss-description skip
      467           "Существует диапазон бар-кодов, который пересекается с создаваемым диапазоном" skip
      468           "База данных"   ub.code-range.db-num skip
      469           "Тип диапазона" ub.code-range.range-type skip
      470           "Статус"        ub.code-range.stts skip
      471           "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      472           "Существует диапазон:" buf_code-range.first-code ":" buf_code-range.last-code skip
      473           "Тип диапазона" buf_code-range.range-type skip
      474           view-as alert-box .
      475         undo main-block, return error .
      476       end.
      477       for each buf_code-range
      478         where buf_code-range.last-code  >= ub.code-range.first-code
      479           and buf_code-range.first-code <= ub.code-range.first-code
      480           and buf_code-range.range-type = v-check-type
      481           and recid(buf_code-range) <> recid(ub.code-range)
      482       on error undo main-block, return error
      483       :
      484         message
      485           vss-workfile vss-revision vss-description skip
      486           "Существует диапазон бар-кодов, который пересекается с создаваемым диапазоном" skip
      487           "База данных"   ub.code-range.db-num skip
      488           "Тип диапазона" ub.code-range.range-type skip
      489           "Статус"        ub.code-range.stts skip
      490           "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      491           "Существует диапазон:" buf_code-range.first-code ":" buf_code-range.last-code skip
      492           "Тип диапазона" buf_code-range.range-type skip
      493           view-as alert-box .
      494         undo main-block, return error .
      495       end.
      496       for each buf_code-range
      497         where buf_code-range.last-code  >= ub.code-range.last-code
      498           and buf_code-range.first-code <= ub.code-range.last-code
      499           and buf_code-range.range-type = v-check-type
      500           and recid(buf_code-range) <> recid(ub.code-range)
      501       on error undo main-block, return error
      502       :
      503         message
      504           vss-workfile vss-revision vss-description skip
      505           "Существует диапазон бар-кодов, который пересекается с создаваемым диапазоном" skip
      506           "База данных"   ub.code-range.db-num skip
      507           "Тип диапазона" ub.code-range.range-type skip
      508           "Статус"        ub.code-range.stts skip
      509           "Диапазон"      ub.code-range.first-code  ":" ub.code-range.last-code  skip
      510           "Существует диапазон:" buf_code-range.first-code ":" buf_code-range.last-code skip
      511           "Тип диапазона" buf_code-range.range-type skip
      512           view-as alert-box .
      513         undo main-block, return error .
      514       end.
      515     end.
      516     if l-need-send-to-news = true then do:
      517       run str/callnews.p
      518         (input "code-range"
      519         ,input (buffer ub.code-range:handle)
      520         ).
      521     end.
      522     if g#oxml = yes then do:
      523       run str/calloxml.p (
      524             input 'update':U
      525           , input 'code-range':U
      526           , input ( buffer ub.code-range:handle )
      527       ) no-error.
      528       if error-status :error
      529       then do:
      530           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      531                                , chr(10)
      532                                , vss-workfile
      533                                , return-value
      534                                , error-status :get-message ( 1 ) ).
      535       end.
      536     end.
      537   end.
