        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.cli-grp.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление группы клиентов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3',ub.cli-grp.node-code,ub.cli-grp.upper-code,ub.cli-grp.node-name)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure cli-grplib-get-full-name :
      308      define input parameter  p-node-code  as integer      no-undo.
      309      define output parameter p-full-name as character    no-undo.
      310   do
      311   on error undo, return error
      312   :
      313       define variable v-upper-code    as integer           no-undo.
      314       define buffer buf_cli-grp       for ub.cli-grp.
      315       define buffer buf_upper_cli-grp for ub.cli-grp.
      316       find first buf_cli-grp no-lock
      317            where buf_cli-grp.node-code = p-node-code
      318       no-error.
      319       if not available buf_cli-grp
      320       then do:
      321           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      322       end.
      323       assign
      324           p-full-name  = ""
      325           v-upper-code = 1
      326       .
      327       do while buf_cli-grp.upper-code <> 0
      328       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      329       :
      330           assign
      331               p-full-name  = buf_cli-grp.node-name
      332                            + (if p-full-name <> "" then chr(47) else "")
      333                            + p-full-name
      334               v-upper-code = buf_cli-grp.upper-code
      335           .
      336           find first buf_cli-grp no-lock
      337                where buf_cli-grp.node-code = v-upper-code
      338           no-error.
      339           if not available buf_cli-grp
      340           then do:
      341               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      342                                   + string( v-upper-code )
      343                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      344           end.
      345       end.
      346       assign
      347       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      348       .
      349   end.
      350   end .
      351   procedure cgrplib-get-node-from-full-name :
      352   define input parameter p-full-name as character no-undo .
      353   define output parameter p-node-code as integer no-undo .
      354   define variable v-ii as integer no-undo .
      355   define variable v-upper-code as integer no-undo .
      356   define variable v-root-code as integer no-undo .
      357   define variable v-entry as character no-undo .
      358   define buffer buf_cli-grp       for ub.cli-grp.
      359   do
      360   on error undo, return error
      361   :
      362     find first buf_cli-grp no-lock
      363         where buf_cli-grp.upper-code = 0
      364     no-error .
      365     if not available buf_cli-grp
      366     then do:
      367         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      368     end.
      369     else do:
      370       assign
      371       v-root-code = buf_cli-grp.node-code
      372       .
      373     end.
      374     v-upper-code = v-root-code.
      375     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      376       assign
      377       v-entry = entry(v-ii, p-full-name, chr(47)).
      378       if v-entry = '' then leave.
      379       find first buf_cli-grp no-lock where
      380                 buf_cli-grp.node-name = v-entry
      381             and buf_cli-grp.upper-code = v-upper-code
      382             no-error.
      383       if not available buf_cli-grp then do:
      384         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      385       end.
      386       else do:
      387         p-node-code = buf_cli-grp.node-code.
      388         v-upper-code = buf_cli-grp.node-code.
      389       end.
      390     end.
      391   end.
      392   end .
      393   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   define new global shared variable g#lib-nws as handle no-undo .
      396   procedure clientsh_write-clients-proc  :
      397   define parameter buffer buf_clients for ub.clients .
      398   define input parameter p-source-type like ub.c-cli-hist.source-type no-undo .
      399   define input parameter p-source-ref  like ub.c-cli-hist.source-ref no-undo .
      400   define variable v-date as date      no-undo.
      401   define variable v-time  as integer   no-undo.
      402   define buffer buf_c-cli-hist for ub.c-cli-hist.
      403   define buffer buf_c-clients for ub.c-clients.
      404     do
      405     on error undo, return error
      406     :
      407       if not available buf_clients then do:
      408         message
      409           vss-workfile vss-revision vss-description skip
      410           "Ошибка задания входных параметров" skip
      411           "Не определен контрагент" skip
      412           view-as alert-box error .
      413         undo, return error .
      414       end.
      415       if g#news then do:
      416         define variable v-send as integer no-undo .
      417         define variable v-subject as character no-undo .
      418         case buf_clients.obj-type:
      419           when 'орг':U then v-subject =  'firm':U.
      420           when 'чел':U then v-subject =  'person':U.
      421           when 'маг':U then v-subject =  'shop':U.
      422           when 'скл':U then v-subject =  'store':U.
      423         end case.
      424         v-send = integer('0':U).
      425   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      426   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      427     (input  g#db-num
      428     ,input  v-subject
      429     ,input  0
      430     ,input  '':U
      431     ,input  0
      432     ,input  '':U
      433     ,input  '':U
      434     ,input  '':U
      435     ,input  0
      436     ,input  0
      437     ,input  0
      438     ,input  'nws-to-hist'
      439     ,output v-send
      440     ) no-error .
      441         if v-send < 0 then return.
      442       end.
      443       run cur-time in this-procedure(output v-date, output v-time).
      444       create buf_c-clients.
      445       buffer-copy buf_clients to buf_c-clients
      446       assign
      447       buf_c-clients.obj-code           = buf_clients.obj-code
      448       buf_c-clients.obj-type           = buf_clients.obj-type
      449       buf_c-clients.chip-num           = next-value (s-cli-chip, ub)
      450       buf_c-clients.corr-time          = v-time
      451       buf_c-clients.corr-user-db-num   = g#db-num
      452       buf_c-clients.corr-user-name     = (if g#news
      453                                           then (chr(4) +  'СПН':U)
      454                                           else (if g#esys
      455                                                 then (chr(4) +  'ВС':U)
      456                                                 else g#userid)
      457                                           )
      458       buf_c-clients.corr-date          = v-date
      459       .
      460       create buf_c-cli-hist.
      461       buffer-copy buf_c-clients to buf_c-cli-hist
      462       assign
      463       buf_c-cli-hist.action =  integer('2':U)
      464       buf_c-cli-hist.subject = 'clients':U
      465       buf_c-cli-hist.host-code = (if buf_clients.obj-type = 'орг':U
      466                                   and
      467                                   can-find(first ub.sysconf no-lock where
      468                                                     ub.sysconf.host-code = buf_clients.obj-code)
      469                                   then buf_clients.obj-code
      470                                   else 0)
      471       buf_c-cli-hist.is-news = g#news
      472       buf_c-cli-hist.source-type = p-source-type
      473       buf_c-cli-hist.source-ref = p-source-ref
      474       .
      475     end.
      476   end procedure.
      477   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      478   procedure cli-grph_write-cli-grp-trigger :
      479   define input parameter p-new-record as logical no-undo .
      480   define input parameter p-source-type as character no-undo .
      481   define input parameter p-source-ref  as character no-undo .
      482   define input parameter p-action as integer no-undo .
      483   define variable v-date as date      no-undo.
      484   define variable v-time  as integer   no-undo.
      485   define buffer buf_c-cli-grp for ub.c-cli-grp.
      486     do
      487     on error undo, return error
      488     :
      489       run cur-time in this-procedure(output v-date, output v-time).
      490       create buf_c-cli-grp.
      491       buffer-copy ub.cli-grp to buf_c-cli-grp
      492       assign
      493       buf_c-cli-grp.node-code           = (if p-new-record then ub.cli-grp.node-code else ub.cli-grp.node-code)
      494       buf_c-cli-grp.chip-num           = next-value (s-cli-grp-chip, ub)
      495       buf_c-cli-grp.corr-time          = v-time
      496       buf_c-cli-grp.corr-user-db-num   = g#db-num
      497       buf_c-cli-grp.corr-user-name     = (if g#news
      498                                           then (chr(4) +  'СПН':U)
      499                                           else (if g#esys
      500                                                 then (chr(4) +  'ВС':U)
      501                                                 else
      502                                                g#userid)
      503                                           )
      504       buf_c-cli-grp.corr-date          = v-date
      505       buf_c-cli-grp.is-del             = (p-action = integer('99':U))
      506       buf_c-cli-grp.action             =  p-action
      507       buf_c-cli-grp.subject            = 'cli-grp':U
      508       .
      509     end.
      510   end procedure.
      511   define buffer b-cli-grp     for ub.cli-grp.
      512   define buffer other_cli-grp for ub.cli-grp.
      513   define variable name     as char    no-undo.
      514   define variable uc       as int     no-undo.
      515   define variable conf-par as char    no-undo.
      516   define variable par-type as char    no-undo.
      517   define variable v-date   as date    no-undo .
      518   define variable v-time   as integer no-undo .
      519   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      520   main-block:
      521   do
      522       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      523       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      524       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      525       :
      526       if not g#news and ( g#db-num > 0 ) then
      527       do:
      528           message
      529               vss-workfile vss-revision vss-description skip
      530               "Нельзя удалять запись ГРУППЫ КЛИЕНТОВ в УБД" skip
      531               "Номер текущей БД" g#db-num
      532               view-as alert-box error .
      533           undo , return error .
      534       end.
      535       on write of ub.clients override
      536           do:
      537           end.
      538       run cli-grplib-get-full-name in this-procedure
      539           (input ub.cli-grp.upper-code
      540           ,output name
      541           ).
      542       for each ub.clients where
      543           ub.clients.grp-code = ub.cli-grp.node-code
      544           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      545           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      546           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      547           :
      548           run clientsh_write-clients-proc   in this-procedure (
      549               buffer ub.clients
      550               ,input 'grp-chg':U
      551               ,input string(ub.cli-grp.node-code)
      552               ).
      553           assign
      554               ub.clients.grp-code = ub.cli-grp.upper-code
      555               ub.clients.grp-name = name
      556               .
      557       end.
      558       for each b-cli-grp  where
      559           b-cli-grp.upper-code = ub.cli-grp.node-code
      560           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      561           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      562           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
      563           assign
      564               b-cli-grp.upper-code = ub.cli-grp.upper-code
      565               .
      566       end.
      567       for each buf_dis-grp-rule where
      568           buf_Dis-grp-rule.classif-type = 'cli-grp':U
      569           and buf_Dis-grp-rule.node-code = ub.cli-grp.node-code
      570           and buf_Dis-grp-rule.host-code = 0
      571           and buf_Dis-grp-rule.obj-type = '':U
      572           and buf_Dis-grp-rule.obj-code = 0
      573           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      574           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      575           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      576           :
      577           delete buf_Dis-grp-rule.
      578       end.
      579       find first b-cli-grp where
      580           b-cli-grp.node-code = ub.cli-grp.upper-code.
      581       if not can-find(first other_cli-grp no-lock where
      582           other_cli-grp.upper-code = b-cli-grp.node-code
      583           AND recid(other_cli-grp) <> recid(ub.cli-grp)) then
      584       do:
      585           assign
      586               b-cli-grp.is-term = yes
      587               .
      588       end.
      589       define variable v-synch-cli-grp as integer no-undo .
      590       assign
      591           v-synch-cli-grp = next-value(synch-cli-grp, ub)
      592           .
      593       run nws/cmd-del.p
      594           ( input 'cli-grp':U
      595           ,input (buffer ub.cli-grp:handle)
      596           ,input "":U
      597           ) no-error .
      598       if error-status :error then
      599       do:
      600           undo main-block, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      601       end.
      602       if not g#news then
      603       do:
      604           run cli-grph_write-cli-grp-trigger in this-procedure (
      605               no
      606               ,"":U
      607               ,"":U
      608               , integer('99':U)
      609               ).
      610       end.
      611       if g#oxml = yes
      612           then
      613       do:
      614           run str/calloxml.p (
      615               input 'delete':U
      616               , input 'cli-grp':U
      617               , input ( buffer ub.cli-grp:handle )
      618               ) no-error.
      619           if error-status :error
      620               then
      621           do:
      622               undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      623                   , chr(10)
      624                   , vss-workfile
      625                   , return-value
      626                   , error-status :get-message ( 1 ) ).
      627           end.
      628       end.
      629       run trg/userlog.p (
      630           input 'delete':U
      631           , input 'cli-grp':U
      632           , input ( buffer ub.cli-grp :handle )
      633           , input ?
      634           , input ""
      635           ) no-error.
      636       if error-status :error
      637           then
      638       do:
      639           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      640               , chr(10)
      641               , vss-workfile
      642               , return-value
      643               , error-status :get-message ( 1 ) ).
      644       end.
      645   end.
