     4481   procedure partslib-process-document :
     4482     define input  parameter p-doc-code         as character no-undo .
     4483     define input  parameter p-obj-type         as character no-undo .
     4484     define input  parameter p-obj-code         as integer   no-undo .
     4485     define input  parameter p-artic            as character no-undo .
     4486     define input  parameter p-prod-type        as character no-undo .
     4487     define input  parameter p-prod-code        as integer   no-undo .
     4488     define input  parameter p-goods-gds-goods  as logical   no-undo .
     4489     define input  parameter p-goods-twounit    as logical   no-undo .
     4490     define output parameter p-total-parts-qnty as decimal   no-undo .
     4491     define variable v-parts-sign as integer   no-undo .
     4492     define buffer buf_trn-doc    for ub.trn-doc .
     4493     define buffer buf_doc-line   for ub.doc-line .
     4494     define buffer buf_parts      for ub.parts .
     4495     define buffer buf_temp-parts for temp-parts .
     4496     do
     4497     on error undo, return error return-value
     4498     :
     4499       find first buf_trn-doc no-lock
     4500         where buf_trn-doc.doc-code = p-doc-code
     4501         no-error .
     4502       if not available buf_trn-doc
     4503       then do:
     4504         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     4505                                      ,p-doc-code
     4506                                      ) .
     4507       end.
     4508       case buf_trn-doc.doc-type
     4509       :
     4510         when 'при':U or
     4511         when 'возврат':U or
     4512         when 'инв':U
     4513         then do:
     4514           assign
     4515             v-parts-sign = -1
     4516           .
     4517         end.
     4518         when 'рас':U or
     4519         when 'спи':U
     4520         then do:
     4521           assign
     4522             v-parts-sign = 1
     4523           .
     4524         end.
     4525         otherwise do:
     4526           undo, return error substitute("Неизвестный тип документа &1"
     4527                                       ,buf_trn-doc.doc-type
     4528                                       ) .
     4529         end.
     4530       end.
     4531       find first buf_doc-line no-lock
     4532         where buf_doc-line.doc-code  = p-doc-code
     4533           and buf_doc-line.artic     = p-artic
     4534           and buf_doc-line.prod-type = p-prod-type
     4535           and buf_doc-line.prod-code = p-prod-code
     4536         no-error .
     4537       if not available buf_doc-line
     4538       then do:
     4539         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     4540                                      ,p-doc-code
     4541                                      ,artic
     4542                                      ,prod-type
     4543                                      ,prod-code
     4544                                      ) .
     4545       end.
     4546       assign
     4547         p-total-parts-qnty = 0
     4548       .
     4549       if p-goods-gds-goods = true
     4550       then do:
     4551         for each buf_parts no-lock
     4552           where buf_parts.out-code  = p-doc-code
     4553             and buf_parts.obj-type  = p-obj-type
     4554             and buf_parts.obj-code  = p-obj-code
     4555             and buf_parts.artic     = p-artic
     4556             and buf_parts.prod-type = p-prod-type
     4557             and buf_parts.prod-code = p-prod-code
     4558         on error undo, return error
     4559         :
     4560           run partslib-create-temp-parts in this-procedure
     4561             (buffer buf_parts
     4562             ,buffer buf_temp-parts
     4563             ,input  p-goods-twounit
     4564             ) .
     4565           assign
     4566             p-total-parts-qnty        = p-total-parts-qnty
     4567                                       + v-parts-sign * buf_parts.fact-qnty
     4568             buf_temp-parts.qnty       = buf_temp-parts.qnty
     4569                                       + v-parts-sign * buf_parts.fact-qnty
     4570             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     4571                                       + v-parts-sign * buf_parts.fact-qnty
     4572             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     4573                                       + v-parts-sign * buf_parts.cli-qnty
     4574           .
     4575           if buf_temp-parts.qnty = 0
     4576           then do:
     4577             delete buf_temp-parts .
     4578           end.
     4579         end.
     4580       end.
     4581       else do:
     4582         assign
     4583           p-total-parts-qnty = p-total-parts-qnty
     4584                              + v-parts-sign * buf_doc-line.fact-qnty
     4585         .
     4586       end.
     4587     end.
     4588   end procedure.
     4589   procedure partslib-init-temp-parts-by-date :
     4590     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     4591     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     4592     define input parameter p-artic           like ub.parts.artic     no-undo .
     4593     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     4594     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     4595     define input parameter p-fact-date       as date      no-undo .
     4596     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     4597     do
     4598     on error undo, return error
     4599     :
     4600       define variable v-fact-order                as decimal   no-undo .
     4601       define variable v-shift-end-fact-order      as decimal   no-undo .
     4602       define variable v-day-end-fact-order        as decimal   no-undo .
     4603       run factord in this-procedure
     4604         (input  p-fact-date
     4605         ,input  1
     4606         ,input  1
     4607         ,input  ?
     4608         ,input  0
     4609         ,input  false
     4610         ,output v-fact-order
     4611         ,output v-shift-end-fact-order
     4612         ,output v-day-end-fact-order
     4613         ) no-error .
     4614       if error-status :error
     4615       then do:
     4616         message
     4617           vss-workfile vss-revision vss-description skip
     4618           vss-include-info25 skip
     4619           "Ошибка при определении момента времени, на который требуется остаток" skip
     4620           "Объект" p-obj-type p-obj-code skip
     4621           "Артикул" p-artic p-prod-type p-prod-code skip
     4622           "Дата" p-fact-date skip
     4623           view-as alert-box error .
     4624         undo, return error .
     4625       end.
     4626       run partslib-init-temp-parts-by-factord in this-procedure
     4627         (input p-obj-type
     4628         ,input p-obj-code
     4629         ,input p-artic
     4630         ,input p-prod-type
     4631         ,input p-prod-code
     4632         ,input v-day-end-fact-order
     4633         ,input false
     4634         ) no-error .
     4635       if error-status :error
     4636       then do:
     4637         message
     4638           vss-workfile vss-revision vss-description skip
     4639           vss-include-info25 skip
     4640           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     4641           "Объект" p-obj-type p-obj-code skip
     4642           "Артикул" p-artic p-prod-type p-prod-code skip
     4643           "Дата" p-fact-date skip
     4644           view-as alert-box error .
     4645         undo, return error .
     4646       end.
     4647     end.
     4648   end procedure.
     4649   procedure partslib-calc-cost :
     4650     define output parameter p-fact-qnty      as decimal   no-undo .
     4651     define output parameter p-vat-pc         as decimal   no-undo .
     4652     define output parameter p-slt-pc         as decimal   no-undo .
     4653     define output parameter p-sum-base       as decimal   no-undo .
     4654     define output parameter p-sum-rubl       as decimal   no-undo .
     4655     define output parameter p-vat-base       as decimal   no-undo .
     4656     define output parameter p-vat-rubl       as decimal   no-undo .
     4657     define output parameter p-slt-base       as decimal   no-undo .
     4658     define output parameter p-slt-rubl       as decimal   no-undo .
     4659     define output parameter p-road-tax-base  as decimal   no-undo .
     4660     define output parameter p-road-tax-rubl  as decimal   no-undo .
     4661     define output parameter p-transport-base as decimal   no-undo .
     4662     define output parameter p-transport-rubl as decimal   no-undo .
     4663     define output parameter p-other-base     as decimal   no-undo .
     4664     define output parameter p-other-rubl     as decimal   no-undo .
     4665     define output parameter p-excise-base    as decimal   no-undo .
     4666     define output parameter p-excise-rubl    as decimal   no-undo .
     4667     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     4668     do
     4669     on error undo, return error return-value
     4670     :
     4671       define buffer buf_temp-parts for temp-parts .
     4672       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     4673       define buffer   in-vatp-parts    for ub.parts   .
     4674       define buffer   in-vatp-doc      for ub.trn-doc .
     4675       define buffer   in-vatp-goods    for ub.goods   .
     4676       define buffer   in-vatp-sysconf  for ub.sysconf .
     4677       define buffer   in-vatp_doc-attr for ub.doc-attr.
     4678       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     4679       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     4680       define variable varinvprb                  as   character              no-undo.
     4681       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     4682       define variable cli-base-rate              as   decimal                no-undo.
     4683       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     4684       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     4685       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     4686       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     4687       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     4688       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     4689       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     4690       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4691       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     4692       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     4693       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4694       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     4695       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     4696       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     4697       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     4698       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     4699       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     4700       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     4701       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     4702       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     4703       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     4704       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     4705       define variable varinvatp-envd             as   character              no-undo.
     4706       define variable varinvatp-type             as   character              no-undo.
     4707       for each buf_temp-parts
     4708       on error undo, return error
     4709       :
     4710   assign
     4711     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     4712     price-base-with-tax-loc = buf_temp-parts.price-base
     4713   .
     4714   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4715   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4716     (output varinvprb
     4717     )  .
     4718     if buf_temp-parts.out-code = 'free-zone':U     or
     4719        buf_temp-parts.out-code = 'out-zone':U   or
     4720        buf_temp-parts.doc-type = 'акт':U then do:
     4721       assign
     4722         in-vatp-have-vat-slt = yes.
     4723     end.
     4724     else do:
     4725       find first in-vatp_doc-attr no-lock
     4726         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     4727           and in-vatp_doc-attr.attr-code = 'envd':U
     4728         no-error .
     4729       if not available in-vatp_doc-attr then do:
     4730         assign
     4731           in-vatp-have-vat-slt = yes.
     4732       end.
     4733       else do:
     4734            in-vatp-have-vat-slt = no.
     4735       end.
     4736     end.
     4737     assign
     4738      price-cli-with-tax-loc = buf_temp-parts.price-cli
     4739      cli-base-rate          = buf_temp-parts.cli-base-rate.
     4740     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     4741              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     4742     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     4743             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     4744             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     4745             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     4746             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     4747             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     4748             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4749       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4750     assign
     4751       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     4752     assign
     4753       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     4754       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     4755       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     4756       transport-cli-loc  = 0
     4757       other-cli-loc      = 0
     4758     .
     4759   ASSIGN
     4760             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4761       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4762   .
     4763         assign
     4764           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     4765           p-vat-pc         = p-vat-pc         + vat-pc-loc
     4766           p-slt-pc         = p-slt-pc         + slt-pc-loc
     4767           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     4768           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     4769           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     4770           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     4771           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     4772           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     4773           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     4774           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     4775           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     4776           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     4777           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     4778           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     4779           p-excise-base    = p-excise-base    + 0
     4780           p-excise-rubl    = p-excise-rubl    + 0
     4781         .
     4782       end.
     4783       if p-fact-qnty      = ?
     4784       or p-sum-base       = ?
     4785       or p-sum-rubl       = ?
     4786       or p-vat-base       = ?
     4787       or p-vat-rubl       = ?
     4788       or p-slt-base       = ?
     4789       or p-slt-rubl       = ?
     4790       or p-road-tax-base  = ?
     4791       or p-road-tax-rubl  = ?
     4792       or p-transport-base = ?
     4793       or p-transport-rubl = ?
     4794       or p-other-base     = ?
     4795       or p-other-rubl     = ?
     4796       or p-excise-base    = ?
     4797       or p-excise-rubl    = ?
     4798       then do:
     4799         message
     4800           vss-workfile vss-revision vss-description skip
     4801           vss-include-info25 skip
     4802           "Программа in-vatp.i вернула неопределенные значения" skip
     4803           "p-fact-qnty"      p-fact-qnty      skip
     4804           "p-sum-base"       p-sum-base       skip
     4805           "p-sum-rubl"       p-sum-rubl       skip
     4806           "p-vat-base"       p-vat-base       skip
     4807           "p-vat-rubl"       p-vat-rubl       skip
     4808           "p-slt-base"       p-slt-base       skip
     4809           "p-slt-rubl"       p-slt-rubl       skip
     4810           "p-road-tax-base"  p-road-tax-base  skip
     4811           "p-road-tax-rubl"  p-road-tax-rubl  skip
     4812           "p-transport-base" p-transport-base skip
     4813           "p-transport-rubl" p-transport-rubl skip
     4814           "p-other-base"     p-other-base     skip
     4815           "p-other-rubl"     p-other-rubl     skip
     4816           "p-excise-base"    p-excise-base    skip
     4817           "p-excise-rubl"    p-excise-rubl    skip
     4818           view-as alert-box error .
     4819         undo, return error .
     4820       end.
     4821     end.
     4822   end procedure.
     4823   def var vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4824   define new global shared variable g#lib-trn  as handle no-undo .
     4825   define new global shared variable g#lib-trn2 as handle no-undo .
     4826   define new global shared variable g#lib-trn3 as handle no-undo .
     4827   define new global shared variable g#lib-trn4 as handle no-undo .
     4828   define temp-table tt-allsum-line      no-undo
     4829   field sum-type           as   character
     4830   field fact-qnty          like ub.doc-line.fact-qnty
     4831   field cli-qnty           like ub.doc-line.cli-qnty
     4832   field sum-dsc-base-doc   like ub.doc-line.price-base
     4833   field sum-dsc-rubl-doc   like ub.doc-line.price-base
     4834   field dsc-base-doc       like ub.doc-line.price-base
     4835   field dsc-rubl-doc       like ub.doc-line.price-base
     4836   field vat-base-doc       like ub.doc-line.price-base
     4837   field vat-rubl-doc       like ub.doc-line.price-base
     4838   field vat-base-buyer-doc like ub.doc-line.price-base
     4839   field vat-rubl-buyer-doc like ub.doc-line.price-base
     4840   field slt-base-doc       like ub.doc-line.price-base
     4841   field slt-rubl-doc       like ub.doc-line.price-base
     4842   field road-tax-base-doc  like ub.doc-line.price-base
     4843   field road-tax-rubl-doc  like ub.doc-line.price-base
     4844   field excise-base-doc    like ub.doc-line.price-base
     4845   field excise-rubl-doc    like ub.doc-line.price-base
     4846   field sum-dsc-base-acc   like ub.doc-line.price-base
     4847   field sum-dsc-rubl-acc   like ub.doc-line.price-base
