     7751             view-as alert-box error .
     7752           undo, return error return-value .
     7753         end.
     7754         run partslib-init-temp-parts-by-factord in this-procedure
     7755           (input p-obj-type
     7756           ,input p-obj-code
     7757           ,input v-artic
     7758           ,input v-prod-type
     7759           ,input v-prod-code
     7760           ,input p-day-end-fact-order
     7761           ,input false
     7762           ) .
     7763         for each buf_tt-clcparts
     7764         on error undo, return error return-value
     7765         :
     7766           delete buf_tt-clcparts .
     7767         end.
     7768         define variable v-rest-exist as logical   no-undo .
     7769         assign
     7770           v-rest-exist = false
     7771         .
     7772         for each buf_temp-prt-obj
     7773         on error undo, return error return-value
     7774         :
     7775           if buf_temp-prt-obj.fact-qnty <> 0
     7776           then do:
     7777             assign
     7778               v-rest-exist = true
     7779             .
     7780           end.
     7781         end.
     7782         define variable v-exist-qnty as integer   no-undo .
     7783         assign
     7784           v-exist-qnty = 0
     7785         .
     7786         for each buf_temp-parts
     7787         on error undo, return error return-value
     7788         :
     7789           create buf_tt-clcparts .
     7790           buffer-copy buf_temp-parts to buf_tt-clcparts .
     7791           if buf_temp-parts.qnty <> 0
     7792           then do:
     7793             assign
     7794               v-rest-exist = true
     7795               v-exist-qnty = v-exist-qnty + buf_temp-parts.qnty
     7796             .
     7797           end.
     7798         end.
     7799         if v-crsa-vat-pc = ?
     7800         then do:
     7801           if v-rest-exist = true
     7802           then do:
     7803             message
     7804               vss-workfile vss-revision vss-description skip
     7805               "Не задан налог товара на дату" skip
     7806               "Налог" "НДС" skip
     7807               "Код товара" p-gds-code skip
     7808               "Объект" p-obj-type p-obj-code skip
     7809               "Тип налога" '1':U skip
     7810               "Дата" string(p-archive-date, '99/99/9999':u) skip
     7811               "Количество" v-exist-qnty skip
     7812               view-as alert-box error .
     7813             undo, return error return-value .
     7814           end.
     7815           else do:
     7816             assign
     7817               v-crsa-vat-pc = 0
     7818             .
     7819           end.
     7820         end.
     7821         if v-crsa-slt-pc = ?
     7822         then do:
     7823           if v-rest-exist = true
     7824           then do:
     7825             message
     7826               vss-workfile vss-revision vss-description skip
     7827               "Не задан налог товара на дату" skip
     7828               "Налог" "НП" skip
     7829               "Код товара" p-gds-code skip
     7830               "Объект" p-obj-type p-obj-code skip
     7831               "Тип налога" '2':U skip
     7832               "Дата" p-archive-date skip
     7833               "Количество" v-exist-qnty skip
     7834               view-as alert-box error .
     7835             undo, return error return-value .
     7836           end.
     7837           else do:
     7838             assign
     7839               v-crsa-slt-pc = 0
     7840             .
     7841           end.
     7842         end.
     7843         define variable v-cons-vat-pc as decimal   no-undo .
     7844   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run consvtpc in g#library
     7846     (input  v-host-code
     7847     ,output v-cons-vat-pc
     7848     )  .
     7849         if v-cons-vat-pc = ?
     7850         then do:
     7851           message
     7852             vss-workfile vss-revision vss-description skip
     7853             "Не задан налог на услуги по продаже консигнационного товара" skip
     7854             "Фирма" v-host-code skip
     7855             view-as alert-box error .
     7856           undo, return error return-value .
     7857         end.
     7858         define variable v-cur-price-sale     as decimal   no-undo .
     7859         define variable v-cur-price-road-tax as decimal   no-undo .
     7860         define variable v-cur-price-excise   as decimal   no-undo .
     7861         if v-total-crsa-fact-qnty <> 0
     7862         then do:
     7863           assign
     7864             v-cur-price-sale     = v-cur-base / v-total-crsa-fact-qnty
     7865             v-cur-price-road-tax = v-cur-road-tax-base / v-total-crsa-fact-qnty
     7866             v-cur-price-excise   = v-cur-excise-base / v-total-crsa-fact-qnty
     7867           .
     7868         end.
     7869         else do:
     7870           assign
     7871             v-cur-price-sale     = 0
     7872             v-cur-price-road-tax = 0
     7873             v-cur-price-excise   = 0
     7874           .
     7875         end.
     7876         if v-cur-price-sale     = ?
     7877         or v-cur-price-road-tax = ?
     7878         or v-cur-price-excise   = ?
     7879         then do:
     7880           message
     7881             vss-workfile vss-revision vss-description skip
     7882             "Получены неопределенные значения в текущих продажных ценах" skip
     7883             "Объект" p-obj-type p-obj-code skip
     7884             "Код товара" p-gds-code skip
     7885             "cur-price-sale"     v-cur-price-sale     skip
     7886             "cur-price-road-tax" v-cur-price-road-tax skip
     7887             "cur-price-excise"   v-cur-price-excise   skip
     7888             view-as alert-box error .
     7889           undo, return error return-value .
     7890         end.
     7891         if  v-cur-base          = 0
     7892         and v-cur-VAT-base      = 0
     7893         and v-cur-SLT-base      = 0
     7894         and v-cur-road-tax-base = 0
     7895         and v-cur-excise-base   = 0
     7896         then do:
     7897           if p-base-rate = ?
     7898           or p-base-scale = ?
     7899           then do:
     7900             assign
     7901               p-base-rate  = 0
     7902               p-base-scale = 0
     7903             .
     7904           end.
     7905         end.
     7906         if p-base-rate = ?
     7907         or p-base-scale = ?
     7908         then do:
     7909           message
     7910             vss-workfile vss-revision vss-description skip
     7911             "Курс имеет неопределенное значение" skip
     7912             "Объект" p-obj-type p-obj-code skip
     7913             "Код товара" p-gds-code skip
     7914             "Причина" p-base-rate-reason skip
     7915             view-as alert-box error .
     7916           undo, return error return-value .
     7917         end.
     7918         run clcprtsl_calc-ttable in this-procedure
     7919           (input false
     7920           ,input true
     7921           ,input ?
     7922           ,input ?
     7923           ,input ?
     7924           ,input ?
     7925           ,input ?
     7926           ,input p-base-rate
     7927           ,input p-base-scale
     7928           ,input p-curr-r-b
     7929           ,input v-cur-price-sale
     7930           ,input v-cur-price-road-tax
     7931           ,input v-cur-price-excise
     7932           ,input v-crsa-vat-pc
     7933           ,input v-cons-vat-pc
     7934           ,input v-crsa-slt-pc
     7935           ) no-error .
     7936         if error-status :error
     7937         then do:
     7938           message
     7939             vss-workfile vss-revision vss-description skip
     7940             "Ошибка при вызове программы clcprtsl_calc-ttable" skip
     7941             "Объект" p-obj-type p-obj-code skip
     7942             "Код товара" p-gds-code skip
     7943             error-status :get-message(1) skip
     7944             return-value skip
     7945             view-as alert-box error .
     7946           undo, return error return-value .
     7947         end.
     7948         do v-aht-type-ind = 1 to extent(v-aht-type-list)
     7949         :
     7950           assign
     7951             v-aht-type = v-aht-type-list[v-aht-type-ind]
     7952           .
     7953           run aht_get-sum-type in this-procedure
     7954             (input  v-aht-type
     7955             ,output v-allsum-sum-type
     7956             ) .
     7957           define buffer buf_tt-allsum-line for tt-allsum-line .
     7958           find first buf_tt-allsum-line
     7959             where buf_tt-allsum-line.sum-type = v-allsum-sum-type
     7960             no-error .
     7961           if available buf_tt-allsum-line
     7962           then do:
     7963             assign
     7964               v-cost-fact-qnty      = - buf_tt-allsum-line.fact-qnty
     7965               v-cost-sum-base       = - buf_tt-allsum-line.sum-dsc-base-acc
     7966               v-cost-sum-rubl       = - buf_tt-allsum-line.sum-dsc-rubl-acc
     7967               v-cost-vat-base       = - buf_tt-allsum-line.vat-base-acc
     7968               v-cost-vat-rubl       = - buf_tt-allsum-line.vat-rubl-acc
     7969               v-cost-slt-base       = - buf_tt-allsum-line.slt-base-acc
     7970               v-cost-slt-rubl       = - buf_tt-allsum-line.slt-rubl-acc
     7971               v-cost-road-tax-base  = - buf_tt-allsum-line.road-tax-base-acc
     7972               v-cost-road-tax-rubl  = - buf_tt-allsum-line.road-tax-rubl-acc
     7973               v-cost-excise-base    = - buf_tt-allsum-line.excise-base-acc
     7974               v-cost-excise-rubl    = - buf_tt-allsum-line.excise-rubl-acc
     7975               v-cost-transport-base = - buf_tt-allsum-line.transport-base-acc
     7976               v-cost-transport-rubl = - buf_tt-allsum-line.transport-rubl-acc
     7977               v-cost-other-base     = - buf_tt-allsum-line.other-base-acc
