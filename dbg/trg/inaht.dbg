     2726   procedure prdoclib-clear-temp-prt-obj :
     2727     define buffer buf_temp-prt-obj for temp-prt-obj .
     2728     do
     2729     on error undo, return error return-value
     2730     :
     2731       for each buf_temp-prt-obj
