      612           new-buf_aht-stk-line.sum-type   = p-stk-sum-type
      613         .
      614         if available buf_aht-stk-line then do:
      615           assign
      616             new-buf_aht-stk-line.fact-qnty = buf_aht-stk-line.fact-qnty
