     6562     (input  bf_trn-doc.obj-type
     6563     ,input  bf_trn-doc.obj-code
     6564     ,input  varb-code
     6565     ,input  0
     6566     ,input  bf_trn-doc.fact-order
     6567     ,output vardoc-num
     6568     ,output varprice-sale
     6569     ,output varroad-tax
     6570     ,output varexcise
     6571     )  .
     6572             if varprice-sale = ?
     6573             then do:
     6574               assign
     6575                 varprice-sale = 0
     6576                 varroad-tax   = 0
     6577                 varexcise     = 0
     6578               .
     6579             end.
     6580             assign
     6581               varlastcur-base     = varprice-sale
     6582               varlastcur-road-tax = varroad-tax
     6583               varlastcur-excise   = varexcise
     6584               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     6585               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     6586               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     6587               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     6588             .
     6589         end.
     6590       end.
     6591       if varcur-fact-qnty = 0 then do:
     6592         assign
     6593           varcur-base      = varlastcur-base
     6594           varcur-road-tax  = varlastcur-road-tax
     6595           varcur-excise    = varlastcur-excise
     6596         .
     6597       end.
     6598       else do:
     6599         assign
     6600           varcur-base      = varcur-base      / varcur-fact-qnty
     6601           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     6602           varcur-excise    = varcur-excise    / varcur-fact-qnty
     6603         .
     6604       end.
     6605       if varcur-vat-pc = ?
     6606       then do:
     6607         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     6608       end.
     6609       if varcur-slt-pc = ?
