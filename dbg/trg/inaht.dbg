     7740           ,output v-cur-base
     7741           ,output v-cur-VAT-base
     7742           ,output v-cur-SLT-base
     7743           ,output v-cur-road-tax-base
     7744           ,output v-cur-excise-base
     7745           ) no-error .
     7746         if error-status :error
     7747         then do:
     7748           message
