     2744     on error undo, return error return-value
     2745     :
     2746       find first buf_temp-prt-obj
     2747         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2748         no-error .
     2749       if not available buf_temp-prt-obj
     2750       then do:
     2751         create buf_temp-prt-obj .
     2752         assign
     2753           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2754           buf_temp-prt-obj.price-sale       = ?
     2755           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2756           buf_temp-prt-obj.price-list-qnty  = ?
     2757           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2758           buf_temp-prt-obj.price-list-recid = ?
     2759         .
     2760         find first buf_gds-prt no-lock
     2761           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2762           .
     2763         assign
     2764           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2765         .
     2766         if buf_temp-prt-obj.is-term
     2767         then do:
     2768           assign
     2769             buf_temp-prt-obj.price-sale = p-root-price-sale
     2770           .
     2771         end.
     2772       end.
     2773     end.
     2774   end procedure.
     2775   procedure prdoclib-temp-prt-obj-by-prt-root :
     2776     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     2777     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2778     define buffer buf_gds-prt for ub.gds-prt .
     2779     do
     2780     on error undo, return error return-value
     2781     :
     2782       find first buf_temp-prt-obj
     2783         where buf_temp-prt-obj.prt-code = p-prt-code
     2784         no-error .
     2785       if not available buf_temp-prt-obj
     2786       then do:
     2787         create buf_temp-prt-obj .
     2788         assign
     2789           buf_temp-prt-obj.prt-code         = p-prt-code
     2790           buf_temp-prt-obj.price-sale       = ?
     2791           buf_temp-prt-obj.fact-qnty        = 0
     2792           buf_temp-prt-obj.price-list-qnty  = ?
     2793           buf_temp-prt-obj.prt-obj-recid    = ?
     2794           buf_temp-prt-obj.price-list-recid = ?
     2795         .
     2796         find first buf_gds-prt no-lock
     2797           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2798           .
     2799         assign
     2800           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2801         .
     2802         if buf_temp-prt-obj.is-term
     2803         then do:
     2804           assign
     2805             buf_temp-prt-obj.price-sale = 0
     2806           .
     2807         end.
     2808       end.
     2809     end.
     2810   end procedure.
     2811   procedure prdoclib-init-temp-prt-obj :
     2812     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2813     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2814     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2815     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2816     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2817     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2818     define buffer buf_prt-obj      for ub.prt-obj .
     2819     define buffer buf_temp-prt-obj for temp-prt-obj .
     2820     do
     2821     on error undo, return error return-value
     2822     :
     2823       run prdoclib-clear-temp-prt-obj in this-procedure .
     2824       for each buf_prt-obj
     2825         where buf_prt-obj.obj-type  = p-obj-type
     2826           and buf_prt-obj.obj-code  = p-obj-code
     2827           and buf_prt-obj.artic     = p-artic
     2828           and buf_prt-obj.prod-type = p-prod-type
     2829           and buf_prt-obj.prod-code = p-prod-code
     2830       on error undo, return error return-value
     2831       :
     2832         run prdoclib-create-temp-prt-obj in this-procedure
     2833           (input  p-root-price-sale
     2834           ,buffer buf_prt-obj
     2835           ,buffer buf_temp-prt-obj
     2836           ).
     2837       end.
     2838     end.
     2839   end procedure.
     2840   procedure prdoclib-calc-fact-sale :
     2841     define input  parameter p-price-list-recid   as recid     no-undo .
     2842     define output parameter p-fact-qnty          as decimal   no-undo .
     2843     define output parameter p-cur-base           as decimal   no-undo .
     2844     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2845     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2846     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2847     define output parameter p-cur-excise-base    as decimal   no-undo .
     2848     define buffer buf_main_price-list for ub.price-list .
     2849     define buffer buf_price-list      for ub.price-list .
     2850     define buffer buf_goods           for ub.goods .
     2851     define buffer buf_gds-obj         for ub.gds-obj .
     2852     define buffer buf_bar-code        for ub.bar-code .
     2853     define variable l-empty-scale   as logical   no-undo .
     2854     do
     2855     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     2856     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2857     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2858     :
     2859       find first buf_main_price-list no-lock
     2860         where recid(buf_main_price-list) = p-price-list-recid
     2861         no-error .
     2862       if not available buf_main_price-list
     2863       then do:
     2864         message
     2865           vss-workfile vss-revision vss-description skip
     2866           vss-include-info8 skip
     2867           "Ошибка задания входных параметров" skip
     2868           "Не найдена строка переоценки" skip
     2869           "Код записи (recid)" p-price-list-recid skip
     2870           view-as alert-box error .
     2871         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2872       end.
     2873       if buf_main_price-list.main-price <> true
     2874       then do:
     2875         message
     2876           vss-workfile vss-revision vss-description skip
     2877           vss-include-info8 skip
     2878           "Ошибка задания входных параметров" skip
     2879           "Строка переоценки не является основной" skip
     2880           "Код записи (recid)" p-price-list-recid skip
     2881           "Переоценка" buf_main_price-list.doc-num skip
     2882           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2883           "Бар-код" buf_main_price-list.b-code skip
     2884           view-as alert-box error .
     2885         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2886       end.
     2887       find first buf_goods no-lock
     2888         where buf_goods.artic     = buf_main_price-list.artic
     2889           and buf_goods.prod-type = buf_main_price-list.prod-type
     2890           and buf_goods.prod-code = buf_main_price-list.prod-code
     2891         no-error .
     2892       if not available buf_goods
     2893       then do:
     2894         message
     2895           vss-workfile vss-revision vss-description skip
     2896           vss-include-info8 skip
     2897           "Не найден товар" skip
     2898           "Переоценка" buf_main_price-list.doc-num skip
     2899           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2900           view-as alert-box error .
     2901         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2902       end.
     2903   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2904   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2905     (input  buf_main_price-list.artic
     2906     ,input  buf_main_price-list.prod-type
     2907     ,input  buf_main_price-list.prod-code
     2908     ,input  'empty-scale=request':u
     2909     ,output l-empty-scale
     2910     ) no-error .
     2911       if error-status :error
     2912       then do:
     2913         message
     2914           vss-workfile vss-revision vss-description skip
     2915           vss-include-info8 skip
     2916           "Ошибка при определении атрибута товара" skip
     2917           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2918           'empty-scale=request':u skip
     2919           error-status :get-message(1) skip
     2920           return-value skip
     2921           view-as alert-box error .
     2922         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2923       end.
     2924       find first buf_gds-obj no-lock
     2925         where buf_gds-obj.gds-code = buf_goods.gds-code
     2926           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     2927           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     2928         no-error .
     2929         if not available buf_gds-obj then do:
     2930   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2932     (input  buf_main_price-list.obj-type
     2933     ,input  buf_main_price-list.obj-code
     2934     ,input  buf_goods.artic
     2935     ,input  buf_goods.prod-type
     2936     ,input  buf_goods.prod-code
     2937     ,buffer buf_gds-obj
     2938     ) no-error .
     2939           if error-status :error then do:
     2940              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2941           end.
     2942         end.
     2943       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2944       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2945       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2946       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2947       define variable vat-base-sale-prl               as decimal   no-undo .
     2948       define variable vat-rubl-sale-prl               as decimal   no-undo .
     2949       define variable vat-base-buyer-prl              as decimal   no-undo .
     2950       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2951       define variable slt-base-sale-prl               as decimal   no-undo .
     2952       define variable slt-rubl-sale-prl               as decimal   no-undo .
     2953       define variable road-tax-base-sale-prl          as decimal   no-undo .
     2954       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2955       define variable excise-base-sale-prl            as decimal   no-undo .
     2956       define variable excise-rubl-sale-prl            as decimal   no-undo .
     2957       define variable discnt-base-sale-prl            as decimal   no-undo .
     2958       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2959       if buf_main_price-list.doc-qnty <> 0
     2960       then do:
     2961         run prl-vat in this-procedure
     2962           (input  recid(buf_main_price-list)
     2963           ,output price-rubl-with-tax-sale-prl
     2964           ,output price-base-with-tax-sale-prl
     2965           ,output price-rubl-without-tax-sale-prl
     2966           ,output price-base-without-tax-sale-prl
     2967           ,output vat-base-sale-prl
     2968           ,output vat-rubl-sale-prl
     2969           ,output vat-base-buyer-prl
     2970           ,output vat-rubl-buyer-prl
     2971           ,output slt-base-sale-prl
     2972           ,output slt-rubl-sale-prl
     2973           ,output road-tax-base-sale-prl
     2974           ,output road-tax-rubl-sale-prl
     2975           ,output excise-base-sale-prl
     2976           ,output excise-rubl-sale-prl
     2977           ,output discnt-base-sale-prl
     2978           ,output discnt-rubl-sale-prl
     2979           ) no-error .
     2980         if error-status :error
     2981         then do:
     2982           message
     2983             vss-workfile vss-revision vss-description skip
     2984             vss-include-info8 skip
     2985             "Ошибка при вызове процеды prl-vat" skip
     2986             "Документ" buf_main_price-list.doc-num skip
     2987             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2988             error-status :get-message(1) skip
     2989             return-value skip
     2990             view-as alert-box error .
     2991           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2992         end.
     2993       end.
     2994       else do:
     2995         assign
     2996           price-rubl-with-tax-sale-prl    = 0
     2997           price-base-with-tax-sale-prl    = 0
     2998           price-rubl-without-tax-sale-prl = 0
     2999           price-base-without-tax-sale-prl = 0
     3000           vat-base-sale-prl               = 0
     3001           vat-rubl-sale-prl               = 0
     3002           vat-base-buyer-prl              = 0
     3003           vat-rubl-buyer-prl              = 0
     3004           slt-base-sale-prl               = 0
     3005           slt-rubl-sale-prl               = 0
     3006           road-tax-base-sale-prl          = 0
     3007           road-tax-rubl-sale-prl          = 0
     3008           excise-base-sale-prl            = 0
     3009           excise-rubl-sale-prl            = 0
     3010           discnt-base-sale-prl            = 0
     3011           discnt-rubl-sale-prl            = 0
     3012         .
     3013       end.
     3014       define variable v-curr-r-b as character no-undo .
     3015   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3016   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3017     (output v-curr-r-b
     3018     )  .
     3019       if v-curr-r-b = 'base':U
     3020       then do:
     3021         assign
     3022           p-fact-qnty         = buf_main_price-list.doc-qnty
     3023           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     3024           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     3025           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     3026           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     3027           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     3028         .
     3029       end.
     3030       else do:
     3031         assign
     3032           p-fact-qnty         = buf_main_price-list.doc-qnty
     3033           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     3034           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     3035           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     3036           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
