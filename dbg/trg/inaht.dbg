      595       find last buf_aht-stk-line exclusive-lock
      596         where buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
      597           and buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
      598           and buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
      599           and buf_aht-stk-line.sum-type   = p-stk-sum-type
      600           and buf_aht-stk-line.fact-order <= p-fact-order
      601         use-index category
      602         no-error .
      603       if not available buf_aht-stk-line
      604       or buf_aht-stk-line.fact-order <> p-fact-order
      605       then do:
      606         create new-buf_aht-stk-line .
