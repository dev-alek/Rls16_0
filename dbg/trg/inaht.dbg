     7713     ,output v-prod-type
     7714     ,output v-prod-code
     7715     )  .
     7716         run prdoclib-init-prt-obj-by-factord in this-procedure
     7717           (input p-obj-type
     7718           ,input p-obj-code
     7719           ,input v-artic
     7720           ,input v-prod-type
     7721           ,input v-prod-code
     7722           ,input p-day-end-fact-order
     7723           ,input false
     7724           ) .
     7725         assign
     7726           v-fact-qnty         = 0
     7727           v-cur-base          = 0
     7728           v-cur-VAT-base      = 0
     7729           v-cur-SLT-base      = 0
     7730           v-cur-road-tax-base = 0
     7731           v-cur-excise-base   = 0
     7732         .
