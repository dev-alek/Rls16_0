     8083                                                               ,input v-cost-sum-base            ,input v-cost-sum-rubl            ,input v-cost-vat-base            ,input v-cost-vat-rubl            ,input v-cost-slt-base            ,input v-cost-slt-rubl            ,input v-cost-road-tax-base       ,input v-cost-road-tax-rubl       ,input v-cost-excise-base         ,input v-cost-excise-rubl         ,input v-cost-transport-base      ,input v-cost-transport-rubl      ,input v-cost-other-base          ,input v-cost-other-rubl          ,input v-cost-discnt-base         ,input v-cost-discnt-rubl
     8084                                                               ,input v-crsa-sum-base            ,input v-crsa-sum-rubl            ,input v-crsa-vat-base            ,input v-crsa-vat-rubl            ,input v-crsa-slt-base            ,input v-crsa-slt-rubl            ,input v-crsa-road-tax-base       ,input v-crsa-road-tax-rubl       ,input v-crsa-excise-base         ,input v-crsa-excise-rubl         ,input v-crsa-transport-base      ,input v-crsa-transport-rubl      ,input v-crsa-other-base          ,input v-crsa-other-rubl          ,input v-crsa-discnt-base         ,input v-crsa-discnt-rubl
     8085                                                               ,input v-sale-sum-base            ,input v-sale-sum-rubl            ,input v-sale-vat-base            ,input v-sale-vat-rubl            ,input v-sale-slt-base            ,input v-sale-slt-rubl            ,input v-sale-road-tax-base       ,input v-sale-road-tax-rubl       ,input v-sale-excise-base         ,input v-sale-excise-rubl         ,input v-sale-transport-base      ,input v-sale-transport-rubl      ,input v-sale-other-base          ,input v-sale-other-rubl          ,input v-sale-discnt-base         ,input v-sale-discnt-rubl
     8086               ) no-error .
