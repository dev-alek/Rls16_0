     8061                                                                                       "v-crsa-sum-base"       v-crsa-sum-base        skip     "v-crsa-sum-rubl"       v-crsa-sum-rubl        skip     "v-crsa-vat-base"       v-crsa-vat-base        skip     "v-crsa-vat-rubl"       v-crsa-vat-rubl        skip     "v-crsa-slt-base"       v-crsa-slt-base        skip     "v-crsa-slt-rubl"       v-crsa-slt-rubl        skip     "v-crsa-road-tax-base"  v-crsa-road-tax-base   skip     "v-crsa-road-tax-rubl"  v-crsa-road-tax-rubl   skip     "v-crsa-excise-base"    v-crsa-excise-base     skip     "v-crsa-excise-rubl"    v-crsa-excise-rubl     skip     "v-crsa-transport-base" v-crsa-transport-base  skip     "v-crsa-transport-rubl" v-crsa-transport-rubl  skip     "v-crsa-other-base"     v-crsa-other-base      skip     "v-crsa-other-rubl"     v-crsa-other-rubl      skip     "v-crsa-discnt-base"    v-crsa-discnt-base     skip     "v-crsa-discnt-rubl"    v-crsa-discnt-rubl     skip
