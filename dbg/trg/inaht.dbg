     6939       define variable other-base-locoprl             like ub.doc-line.price-base no-undo.
     6940       define variable other-rubl-locoprl             like ub.doc-line.price-rubl no-undo.
     6941       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
     6942       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
     6943       define variable varinvatp-envdoprl             as   character              no-undo.
     6944       define variable varinvatp-typeoprl             as   character              no-undo.
     6945     define buffer bf_price-list for ub.price-list.
     6946     define buffer bf_goods      for ub.goods.
     6947     define buffer bf_sysconf    for ub.sysconf.
     6948     define buffer bf_parts      for ub.parts.
     6949     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
     6950     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
     6951     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
     6952     define variable varexcise      like ub.price-list.excise     no-undo.
     6953     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
     6954     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
     6955     define variable varprice-base  like ub.price-list.price-sale no-undo.
     6956     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     6957     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     6958     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     6959     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     6960     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     6961     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     6962     define variable varobj-type    like ub.price-list.obj-type   no-undo.
     6963     define variable varobj-code    like ub.price-list.obj-code   no-undo.
     6964     define variable varartic       like ub.price-list.artic      no-undo.
     6965     define variable varprod-type   like ub.price-list.prod-type  no-undo.
     6966     define variable varprod-code   like ub.price-list.prod-code  no-undo.
     6967     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
     6968     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
     6969     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     6970     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     6971     define variable vardoc-type     as   character              no-undo.
     6972     do
     6973     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     6974     :
     6975       find first bf_price-list no-lock
     6976         where recid(bf_price-list) = parrecid
     6977         no-error .
     6978       if not available bf_price-list
     6979       then do:
     6980         return error "Ошибка во входящих параметрах prl-vat.i" .
     6981       end.
     6982       find first bf_goods no-lock
     6983         where bf_goods.artic     = bf_price-list.artic
     6984           and bf_goods.prod-type = bf_price-list.prod-type
     6985           and bf_goods.prod-code = bf_price-list.prod-code
     6986         no-error .
     6987       if not available bf_goods
     6988       then do:
     6989         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     6990       end.
     6991       assign
     6992         varvat-pc = bf_price-list.vat-pc
     6993         varslt-pc = bf_price-list.slt-pc
     6994       .
     6995       if varvat-pc = ?
     6996       then do:
     6997         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     6998       end.
     6999       if varslt-pc = ?
     7000       then do:
     7001         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     7002       end.
     7003       assign
     7004         varbase-rate   = 1
     7005         varbase-scale  = 1
     7006         varroad-tax    = bf_price-list.road-tax
     7007         varexcise      = bf_price-list.excise
     7008         varprice-base  = bf_price-list.price-sale
     7009         varprice-rubl  = bf_price-list.price-sale
     7010         vardiscnt-base = 0
     7011         vardiscnt-rubl = 0
     7012       .
     7013       assign
     7014         varfact-qnty = 0
     7015       .
     7016       for each bf_parts no-lock
     7017         where bf_parts.out-code   = bf_price-list.doc-num
     7018           and bf_parts.obj-type   = bf_price-list.obj-type
     7019           and bf_parts.obj-code   = bf_price-list.obj-code
     7020           and bf_parts.artic      = bf_price-list.artic
     7021           and bf_parts.prod-type  = bf_price-list.prod-type
     7022           and bf_parts.prod-code  = bf_price-list.prod-code
     7023       :
     7024         assign
     7025           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     7026         .
     7027       end.
     7028       assign
     7029         vardoc-num   = bf_price-list.doc-num
     7030         vardoc-code  = bf_price-list.doc-num
     7031         varobj-type  = bf_price-list.obj-type
     7032         varobj-code  = bf_price-list.obj-code
     7033         varartic     = bf_price-list.artic
     7034         varprod-type = bf_price-list.prod-type
     7035         varprod-code = bf_price-list.prod-code
     7036         vardoc-qnty  = varfact-qnty
     7037         varext-doc-type = 'ot':U
     7038       .
     7039   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7041     (input  bf_price-list.obj-type
     7042     ,input  bf_price-list.obj-code
     7043     ,output v-host-code
     7044     )  .
     7045       find first bf_sysconf no-lock
     7046         where bf_sysconf.host-code = v-host-code
     7047         .
     7048       if bf_sysconf.cons-vat-pc = ?
     7049       then do:
     7050         return error "Не задан консигнационный НДС по фирме." .
     7051       end.
     7052       else do:
     7053         assign
     7054           varcons-vat-pc = bf_sysconf.cons-vat-pc
     7055         .
     7056       end.
     7057   if varext-doc-type = 'ot':U or
     7058      varext-doc-type = ?                 then do:
     7059     assign
     7060      out-vatp-have-vat-sltprl = yes.
     7061   end.
     7062   else do:
     7063     find first out-vatp_doc-attrprl no-lock
     7064       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     7065         and out-vatp_doc-attrprl.attr-code = 'envd':U
     7066         no-error .
     7067     if not available out-vatp_doc-attrprl then do:
     7068       assign
     7069         out-vatp-have-vat-sltprl = yes.
     7070     end.
     7071     else do:
     7072        out-vatp-have-vat-sltprl = no.
     7073     end.
     7074   end.
     7075   find first out-vatp_goodsprl where out-vatp_goodsprl.artic     = varartic     and
     7076                                      out-vatp_goodsprl.prod-type = varprod-type and
     7077                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
     7078   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7079   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     7080     (input  varartic
     7081     ,input  varprod-type
     7082     ,input  varprod-code
     7083     ,output varroot-nodeprl
     7084     ) no-error .
     7085   if error-status :error then do:
     7086     message
     7087       vss-workfile vss-revision vss-description skip
     7088       "Ошибка при определении корневого признака товара" skip
     7089       "Артикул" varartic varprod-type varprod-code skip
     7090       error-status :get-message(1) skip
     7091       return-value skip
     7092       view-as alert-box error .
