     4090   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4091   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     4092   procedure partslib-clear-temp-parts :
     4093     define buffer buf_temp-parts for temp-parts .
     4094     do
     4095     on error undo, return error
     4096     :
     4097       for each buf_temp-parts
     4098       on error undo, return error
     4099       :
     4100         delete buf_temp-parts .
     4101       end.
     4102     end.
     4103   end procedure.
     4104   procedure partslib-create-temp-parts :
     4105     define parameter buffer buf_parts       for ub.parts .
     4106     define parameter buffer buf_temp-parts  for temp-parts .
     4107     define input  parameter p-goods-twounit as logical   no-undo .
     4108     define variable v-base-part-code as character no-undo .
     4109     do
     4110     on error undo, return error
     4111     :
     4112       if p-goods-twounit = true
     4113       then do:
     4114         assign
     4115           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     4116         .
     4117       end.
     4118       else do:
     4119         assign
     4120           v-base-part-code = buf_parts.part-code
     4121         .
     4122       end.
     4123       find first buf_temp-parts exclusive-lock
     4124         where buf_temp-parts.obj-type  = buf_parts.obj-type
     4125           and buf_temp-parts.obj-code  = buf_parts.obj-code
     4126           and buf_temp-parts.artic     = buf_parts.artic
     4127           and buf_temp-parts.prod-type = buf_parts.prod-type
     4128           and buf_temp-parts.prod-code = buf_parts.prod-code
     4129           and buf_temp-parts.in-code   = buf_parts.in-code
     4130           and buf_temp-parts.out-code  = 'free-zone':U
     4131           and buf_temp-parts.part-code = v-base-part-code
     4132         no-error.
     4133       if not available buf_temp-parts
     4134       then do:
     4135         create buf_temp-parts .
     4136         buffer-copy buf_parts to buf_temp-parts
     4137         assign
     4138           buf_temp-parts.out-code  = 'free-zone':U
     4139           buf_temp-parts.part-code = v-base-part-code
     4140           buf_temp-parts.rsrv-free = yes
     4141           buf_temp-parts.status_   = no
     4142           buf_temp-parts.qnty      = 0
     4143           buf_temp-parts.fact-qnty = 0
     4144           buf_temp-parts.real-qnty = 0
     4145           buf_temp-parts.cli-qnty  = 0
     4146         .
     4147       end.
     4148     end.
     4149   end procedure.
     4150   procedure partslib-init-temp-parts :
     4151     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     4152     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     4153     define input parameter p-artic           like ub.parts.artic     no-undo .
     4154     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     4155     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     4156     define buffer buf_parts      for ub.parts .
     4157     define buffer buf_temp-parts for temp-parts .
     4158     define variable v-goods-twounit    as logical   no-undo .
     4159     do
     4160     on error undo, return error
     4161     :
     4162   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4163   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4164     (input  p-artic
     4165     ,input  p-prod-type
     4166     ,input  p-prod-code
     4167     ,input  'twounit=request':u
     4168     ,output v-goods-twounit
     4169     ) no-error .
     4170       if error-status :error
     4171       then do:
     4172         message
     4173           vss-workfile vss-revision vss-description skip
     4174           vss-include-info25 skip
     4175           "Ошибка при определении атрибута товара" skip
     4176           "Артикул" p-artic p-prod-type p-prod-code skip
     4177           "twounit=request" skip
     4178           error-status :get-message(1) skip
     4179           return-value skip
     4180           view-as alert-box error .
     4181         undo, return error return-value .
     4182       end.
     4183       run partslib-clear-temp-parts in this-procedure .
     4184       for each buf_parts
     4185         where buf_parts.obj-type  = p-obj-type
     4186           and buf_parts.obj-code  = p-obj-code
     4187           and buf_parts.artic     = p-artic
     4188           and buf_parts.prod-type = p-prod-type
     4189           and buf_parts.prod-code = p-prod-code
     4190           and buf_parts.rsrv-free = yes
     4191           and buf_parts.status_   = no
     4192           and buf_parts.in-code   <> buf_parts.out-code
     4193       on error undo, return error
     4194       :
     4195         run partslib-create-temp-parts in this-procedure
     4196           (buffer buf_parts
     4197           ,buffer buf_temp-parts
     4198           ,input  v-goods-twounit
     4199           ) .
     4200         define variable v-parts-qnty          as decimal   no-undo .
     4201         define variable v-parts-cli-qnty      as decimal   no-undo .
     4202         define variable v-parts-free-qnty     as decimal   no-undo .
     4203         define variable v-parts-free-cli-qnty as decimal   no-undo .
     4204         if buf_parts.out-code = 'free-zone':U
     4205         then do:
     4206           assign
     4207             v-parts-qnty          = buf_parts.qnty
     4208             v-parts-cli-qnty      = buf_parts.cli-qnty
     4209             v-parts-free-qnty     = buf_parts.qnty
     4210             v-parts-free-cli-qnty = buf_parts.cli-qnty
     4211           .
     4212         end.
     4213         else do:
     4214           assign
     4215             v-parts-qnty          = abs(buf_parts.qnty)
     4216             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     4217             v-parts-free-qnty     = 0
     4218             v-parts-free-cli-qnty = 0
     4219           .
     4220         end.
     4221         assign
     4222           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     4223           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     4224           buf_temp-parts.real-qnty     = 0
     4225           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     4226           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     4227           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     4228         .
     4229       end.
     4230     end.
     4231   end procedure.
