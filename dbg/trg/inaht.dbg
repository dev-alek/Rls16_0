      745   end procedure.
      746   procedure aht_add-document :
      747     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
      748     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
      749     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
      750     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
      751     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
      752     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
      753     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
      754     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
      755     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
      756     define buffer buf_aht-doc for ub.aht-doc .
      757     do
      758     on error undo, return error return-value
      759     :
      760       find first buf_aht-doc exclusive-lock
      761         where buf_aht-doc.doc-code = p-doc-code
      762         no-error .
      763       if available buf_aht-doc then do:
      764         message
      765           vss-workfile vss-revision vss-description skip
      766           vss-include-info1 skip
      767           "Попытка повторного создания записи" skip
      768           "Документ" p-doc-code skip
      769           view-as alert-box error .
      770         undo, return error .
      771       end.
      772       if p-fact-order = ?
      773       or p-fact-order = 0
      774       then do:
      775         message
      776           vss-workfile vss-revision vss-description skip
      777           vss-include-info1 skip
      778           "Ошибка задания входных параметров" skip
      779           "Не задан номер документа" skip
      780           "Документ" p-doc-code skip
      781           "Номер документа" p-fact-order skip
      782           view-as alert-box error .
      783         undo, return error .
      784       end.
      785       create buf_aht-doc .
      786       assign
      787         buf_aht-doc.doc-code     = p-doc-code
      788         buf_aht-doc.obj-type     = p-obj-type
      789         buf_aht-doc.obj-code     = p-obj-code
      790         buf_aht-doc.ext-doc-type = p-ext-doc-type
      791         buf_aht-doc.is-trn-doc   = p-is-trn-doc
      792         buf_aht-doc.fact-order   = p-fact-order
      793         buf_aht-doc.fact-date    = p-fact-date
      794         buf_aht-doc.shift-date   = p-shift-date
      795         buf_aht-doc.shift-num    = p-shift-num
      796       .
      797     end.
      798   end procedure.
      799   procedure aht_add-date :
      800     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
      801     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
      802     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
      803     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
      804     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
      805     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
      806     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
      807     define buffer buf_aht-stk for ub.aht-stk .
      808     do
      809     on error undo, return error return-value
      810     :
      811       find first buf_aht-stk no-lock
      812         where buf_aht-stk.obj-type   = p-obj-type
      813           and buf_aht-stk.obj-code   = p-obj-code
      814           and buf_aht-stk.stk-type   = p-stk-type
      815           and buf_aht-stk.fact-order = p-fact-order
      816         no-error .
      817       if not available buf_aht-stk then do:
      818         create buf_aht-stk .
      819         assign
      820           buf_aht-stk.obj-type   = p-obj-type
      821           buf_aht-stk.obj-code   = p-obj-code
      822           buf_aht-stk.stk-type   = p-stk-type
      823           buf_aht-stk.fact-order = p-fact-order
      824           buf_aht-stk.fact-date  = p-fact-date
      825           buf_aht-stk.shift-date = p-shift-date
      826           buf_aht-stk.shift-num  = p-shift-num
      827         .
      828       end.
      829     end.
      830   end procedure.
      831   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   procedure factord :
      833     define input  parameter p-fact-date            as date    no-undo .
      834     define input  parameter p-fact-time            as integer no-undo .
      835     define input  parameter p-fact-num             as integer no-undo .
      836     define input  parameter p-shift-date           as date    no-undo .
      837     define input  parameter p-shift-num            as integer no-undo .
      838     define input  parameter p-shift-on             as logical no-undo .
      839     define output parameter p-fact-order           as decimal no-undo .
      840     define output parameter p-shift-end-fact-order as decimal no-undo .
      841     define output parameter p-day-end-fact-order   as decimal no-undo .
      842     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      843     if p-fact-date = ?
      844     then do:
      845       return error "Не указана фактическая дата" .
      846     end.
      847     define variable v-fact-date-num as integer no-undo .
      848     assign
      849       v-fact-date-num = integer(p-fact-date)
      850     .
      851     if p-fact-num = ?
      852     or p-fact-num = 0
      853     then do:
      854       return error "Не задан p-fact-num " + string(p-fact-num) .
      855     end.
      856     if p-fact-num < 0
      857     then do:
      858       return error "Отрицательный fact-num " + string(p-fact-num) .
      859     end.
      860     if p-fact-num >= 100000000
      861     then do:
      862       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      863     end.
      864     if p-shift-on = true
      865     then do:
      866       if p-shift-date = ?
      867       then do:
      868         return error "Не задана дата смены" .
      869       end.
      870       if p-shift-num = ?
      871       or p-shift-num = 0
      872       then do:
      873         return error "Не задан номер смены" .
      874       end.
      875     end.
      876     else do:
      877       assign
      878         p-shift-date = p-fact-date
      879         p-shift-num  = 24
      880       .
      881     end.
      882     define variable v-shift-offset as integer no-undo .
      883     if p-shift-date = p-fact-date
      884     then do:
      885       assign
      886         v-shift-offset = 1
      887       .
      888     end.
      889     if p-shift-date < p-fact-date
      890     then do:
      891       assign
      892         v-shift-offset = 0
      893       .
      894     end.
      895     if p-shift-date > p-fact-date
      896     then do:
      897       message
      898         vss-workfile vss-revision vss-description skip
      899         "Неправильная дата закрытия смены" skip
      900         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      901         view-as alert-box error .
      902       undo, return error
      903         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      904           ,string(p-fact-date, '99/99/9999':U)
      905           ,string(p-shift-date, '99/99/9999':U)
      906           )
      907       .
      908     end.
      909     if p-shift-num < 1
      910     or p-shift-num > 24
      911     then do:
      912       message
      913         vss-workfile vss-revision vss-description skip
      914         "Неправильный номер смены" skip
      915         "p-shift-num" p-shift-num skip
      916         view-as alert-box error .
      917       undo, return error return-value .
      918     end.
      919     assign
      920       p-fact-order           = v-fact-date-num
      921                              + v-shift-offset * 0.5
      922                              + p-shift-num    * 0.02 - 0.01
      923                              + p-fact-num     * 0.0000000001
      924       p-shift-end-fact-order = v-fact-date-num
      925                              + v-shift-offset * 0.5
      926                              + p-shift-num    * 0.02
      927       p-day-end-fact-order   = v-fact-date-num
      928                              + 0.99
      929     .
      930     if p-fact-order           <= v-fact-date-num
      931     or p-shift-end-fact-order <= v-fact-date-num
      932     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      933     or p-shift-end-fact-order >= p-day-end-fact-order
      934     then do:
      935       message
      936         vss-workfile vss-revision vss-description skip
      937         "Внутренняя ошибка при генерации фактического номера" skip
      938         "p-fact-date"            p-fact-date            skip
      939         "p-fact-time"            p-fact-time            skip
      940         "p-fact-num"             p-fact-num             skip
      941         "p-shift-date"           p-shift-date           skip
      942         "p-shift-num"            p-shift-num            skip
      943         "p-shift-on"             p-shift-on             skip
      944         "p-shift-end-fact-order" p-shift-end-fact-order skip
      945         "p-day-end-fact-order"   p-day-end-fact-order   skip
      946         "v-fact-date-num"        v-fact-date-num        skip
      947         view-as alert-box error .
      948       undo, return error return-value .
      949     end.
      950   end procedure.
      951   procedure day-begin-fact-order :
      952     define input  parameter p-fact-date            as date    no-undo .
      953     define output parameter p-day-begin-fact-order as decimal no-undo .
      954     do
      955     on error undo, return error return-value
      956     :
      957       if p-fact-date = ?
      958       then do:
      959         assign
      960           p-day-begin-fact-order = 0
      961         .
      962       end.
      963       else do:
      964         assign
      965           p-day-begin-fact-order = integer(p-fact-date)
      966         .
      967       end.
      968     end.
      969   end procedure.
      970   procedure factord-max-fact-order :
      971     define output parameter p-max-fact-order as decimal   no-undo .
      972     do
      973     on error undo, return error return-value
      974     :
      975       run day-begin-fact-order in this-procedure
      976         (input  date(1, 1, 5000)
      977         ,output p-max-fact-order
      978         ) .
      979     end.
      980   end procedure.
      981   procedure factord-cut-archive :
      982     define input  parameter p-obj-type             as character no-undo .
      983     define input  parameter p-obj-code             as integer   no-undo .
      984     define input  parameter p-fact-date            as date      no-undo .
      985     define output parameter p-shift-on             as logical   no-undo .
      986     define output parameter p-shift-date           as date      no-undo .
      987     define output parameter p-shift-num            as integer   no-undo .
      988     define output parameter p-day-end-fact-order   as decimal   no-undo .
      989     define output parameter p-shift-end-fact-order as decimal   no-undo .
      990     define variable v-fact-order as decimal   no-undo .
      991     define buffer buf_shift-obj for ub.shift-obj .
      992     do
      993     on error undo, return error return-value
      994     :
      995   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      997     (input  p-obj-type
      998     ,input  p-obj-code
      999     ,input  'shift-on=request'
     1000     ,output p-shift-on
     1001     ) no-error .
     1002       if error-status :error
     1003       then do:
     1004         message
     1005           vss-workfile vss-revision vss-description skip
     1006           "Ошибка при определении атрибута объекта" skip
     1007           "Объект" p-obj-type p-obj-code skip
     1008           error-status :get-message(1) skip
     1009           return-value skip
     1010           view-as alert-box error .
     1011         undo, return error return-value .
     1012       end.
     1013       if p-shift-on = false
     1014       then do:
     1015         assign
     1016           p-shift-date               = ?
     1017           p-shift-num                = 0
     1018         .
     1019       end.
     1020       else do:
     1021         find first buf_shift-obj share-lock
     1022           where buf_shift-obj.obj-type   = p-obj-type
     1023             and buf_shift-obj.obj-code   = p-obj-code
     1024             and buf_shift-obj.shift-date > p-fact-date
     1025           use-index pi
     1026           no-error .
     1027         if not available buf_shift-obj
     1028         or buf_shift-obj.status_ <> 'зкр':U
     1029         then do:
     1030           message
     1031             vss-workfile vss-revision vss-description skip
     1032             "Невозможно вычислить последнюю смену" skip
     1033             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1034             "Объект" p-obj-type p-obj-code skip
     1035             "Дата" p-fact-date skip
     1036             view-as alert-box error .
     1037           undo, return error return-value .
     1038         end.
     1039         find last buf_shift-obj share-lock
     1040           where buf_shift-obj.obj-type = p-obj-type
     1041             and buf_shift-obj.obj-code = p-obj-code
     1042             and buf_shift-obj.shift-date <= p-fact-date
     1043           use-index pi
     1044           no-error .
     1045         if available buf_shift-obj
     1046         then do:
     1047           if  buf_shift-obj.status_ = 'зкр':U
     1048           then do:
     1049             assign
     1050               p-shift-date = buf_shift-obj.shift-date
     1051               p-shift-num  = buf_shift-obj.shift-num
     1052             .
     1053           end.
     1054           else do:
     1055             message
     1056               vss-workfile vss-revision vss-description skip
     1057               "Невозможно вычислить последнюю смену" skip
     1058               "Статус смены отличен от статуса" 'зкр':U skip
     1059               "Объект" p-obj-type p-obj-code skip
     1060               "Дата" p-fact-date skip
     1061               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1062               view-as alert-box error .
     1063             undo, return error return-value .
     1064           end.
     1065         end.
     1066         else do:
     1067           assign
     1068             p-shift-date = p-fact-date - 1
     1069             p-shift-num  = 1
     1070           .
     1071         end.
     1072       end.
     1073       run factord in this-procedure
     1074         (input  p-fact-date
     1075         ,input  1
     1076         ,input  1
     1077         ,input  p-shift-date
     1078         ,input  p-shift-num
     1079         ,input  p-shift-on
     1080         ,output v-fact-order
     1081         ,output p-shift-end-fact-order
     1082         ,output p-day-end-fact-order
     1083         ) no-error .
     1084       if error-status :error
     1085       then do:
     1086         message
     1087           vss-workfile vss-revision vss-description skip
     1088           "Ошибка при вызове процедуры factord"
     1089           error-status :get-message(1) skip
     1090           return-value skip
     1091           view-as alert-box error .
     1092         undo, return error return-value .
     1093       end.
     1094     end.
     1095   end procedure.
     1096   procedure factord-lock-shift :
     1097     define input  parameter p-obj-type  as character no-undo .
     1098     define input  parameter p-obj-code  as integer   no-undo .
     1099     define input  parameter p-fact-date as date      no-undo .
     1100     define parameter buffer buf_shift-obj for ub.shift-obj .
     1101     define variable v-shift-on      as logical   no-undo .
     1102     define variable v-extra-message as character no-undo .
     1103     define variable v-error as character no-undo .
     1104     do
     1105     on error undo, return error return-value
     1106     :
     1107   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1108   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1109     (input  p-obj-type
     1110     ,input  p-obj-code
     1111     ,input  'shift-on=request'
     1112     ,output v-shift-on
     1113     ) no-error .
     1114       if error-status :error
     1115       then do:
     1116         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1117         undo, return error v-error .
     1118       end.
     1119       if v-shift-on = true
     1120       then do:
     1121         find first buf_shift-obj share-lock
     1122           where buf_shift-obj.obj-type   = p-obj-type
     1123             and buf_shift-obj.obj-code   = p-obj-code
     1124             and buf_shift-obj.shift-date > p-fact-date
     1125           use-index pi
     1126           no-error .
     1127         if not available buf_shift-obj
     1128         or buf_shift-obj.status_ <> 'зкр':U
     1129         then do:
     1130           find last buf_shift-obj
     1131             where buf_shift-obj.obj-type = p-obj-type
     1132               and buf_shift-obj.obj-code = p-obj-code
     1133               and buf_shift-obj.status_  = 'зкр':U
     1134             use-index stts
     1135             no-error .
     1136           if available buf_shift-obj
     1137           then do:
     1138             assign
     1139               v-extra-message =
     1140                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1141                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1142                               )
     1143             .
     1144           end.
     1145           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1146           undo, return error v-error .
     1147         end.
     1148       end.
     1149     end.
     1150   end procedure.
     1151   procedure factord-end-day :
     1152     define input  parameter p-fact-date            as date    no-undo .
     1153     define output parameter p-day-end-fact-order   as decimal no-undo .
     1154     do
     1155     on error undo, return error return-value
     1156     :
     1157       if p-fact-date = ?
     1158       then do:
     1159         return error "Не указана фактическая дата" .
     1160       end.
     1161       assign
     1162         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1163       .
     1164     end.
     1165   end procedure.
     1166   procedure factord-to-date :
     1167     define input  parameter p-fact-order as decimal no-undo .
     1168     define output parameter p-fact-date  as date    no-undo .
     1169     define variable v-ref-date  as date      no-undo .
     1170     define variable v-ref-delta as integer   no-undo .
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174       if p-fact-order = ?
     1175       or p-fact-order = 0
     1176       then do:
     1177         return error "Не указан fact-order" .
     1178       end.
     1179       assign
     1180         v-ref-date  = date(1, 1, 2000)
     1181       .
     1182       assign
     1183         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1184       .
     1185       assign
     1186         p-fact-date = v-ref-date + v-ref-delta
     1187       .
     1188     end.
     1189   end procedure.
     1190   procedure factord-to-fact-num :
     1191     define input  parameter p-fact-order as decimal no-undo .
     1192     define output parameter p-fact-num   as integer no-undo .
     1193     define variable v-fact-order-trunc as decimal no-undo .
     1194     do
     1195     on error undo, return error return-value
     1196     :
     1197       if p-fact-order = ?
     1198       or p-fact-order = 0
     1199       then do:
     1200         return error "Не указан fact-order" .
     1201       end.
     1202       assign
     1203        v-fact-order-trunc = truncate(p-fact-order, 2)
     1204       .
     1205       assign
     1206         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1207       .
     1208     end.
     1209   end procedure.
     1210   procedure factord-to-shift-num :
     1211     define input  parameter p-fact-order as decimal no-undo .
     1212     define output parameter p-shift-num   as integer no-undo .
     1213     define variable  p-shift-numd  as decimal   no-undo .
     1214     define variable v-fact-order-trunc as decimal no-undo .
     1215     do
     1216     on error undo, return error return-value
     1217     :
     1218       if p-fact-order = ?
     1219       or p-fact-order = 0
     1220       then do:
     1221         return error "Не указан fact-order" .
     1222       end.
     1223       assign
     1224        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1225       .
     1226       if v-fact-order-trunc < 0.5 then do:
     1227         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1228       end.
     1229       assign
     1230         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1231         .
     1232        assign
     1233         p-shift-num = truncate (p-shift-numd , 0)
     1234       .
     1235     end.
     1236   end procedure.
     1237   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1238   define temp-table doc-list no-undo
     1239     field doc-code         like ub.trn-doc.doc-code
     1240     field obj-type         like ub.trn-doc.obj-type
     1241     field obj-code         like ub.trn-doc.obj-code
     1242     field fact-date        like ub.trn-doc.fact-date
     1243     field shift-date       like ub.trn-doc.shift-date
     1244     field shift-num        like ub.trn-doc.shift-num
     1245     field shift-name       like ub.trn-doc.shift-name
     1246     field fact-order       as decimal
     1247     field is-trn-doc       as logical
     1248     field doc-type         like ub.trn-doc.doc-type
     1249     field is-archive-exist as logical
     1250     index xpk is primary unique doc-code doc-type
     1251     index xfact-order fact-order
     1252     index xfact-date  fact-date
     1253     .
     1254   define temp-table doclslib-goods no-undo
     1255     field gds-code  as integer
     1256     field artic     as character
     1257     field prod-type as character
     1258     field prod-code as integer
     1259     index xpk is primary unique gds-code
     1260     index xie1 artic prod-type prod-code
     1261     .
     1262   define buffer inkas_trn-doc for ub.trn-doc .
     1263   define stream doclsliblog .
     1264   procedure doclslib-clear-doc-list :
     1265     define buffer buf_doc-list for doc-list .
     1266     do
     1267     on error undo, return error
     1268     :
     1269       for each buf_doc-list
     1270       on error undo, return error
     1271       :
     1272         delete buf_doc-list .
     1273       end.
     1274     end.
     1275   end procedure.
     1276   procedure doclslib-init-trn-doc :
     1277     define input parameter p-obj-type      as character no-undo .
     1278     define input parameter p-obj-code      as integer   no-undo .
     1279     define input parameter p-cut-date      as date      no-undo .
     1280     define buffer buf_trn-doc for ub.trn-doc .
     1281     define buffer buf_doc-list for doc-list .
     1282     do
     1283     on error undo, return error
     1284     :
     1285       if p-cut-date = ?
     1286       then do:
     1287         for each buf_trn-doc no-lock
     1288           where buf_trn-doc.obj-type = p-obj-type
     1289             and buf_trn-doc.obj-code = p-obj-code
     1290             and buf_trn-doc.status_  = 'факт':U
     1291         on error undo, return error
     1292         :
     1293           create buf_doc-list .
     1294           assign
     1295             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1296             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1297             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1298             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1299             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1300             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1301             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1302             buf_doc-list.is-trn-doc = true
     1303           .
     1304         end.
     1305       end.
     1306       else do:
     1307         for each buf_trn-doc no-lock
     1308           where buf_trn-doc.obj-type  = p-obj-type
     1309             and buf_trn-doc.obj-code  = p-obj-code
     1310             and buf_trn-doc.status_   = 'факт':U
     1311             and buf_trn-doc.fact-date >= p-cut-date
     1312         on error undo, return error
     1313         :
     1314           create buf_doc-list .
     1315           assign
     1316             buf_doc-list.doc-code   = buf_trn-doc.doc-code
     1317             buf_doc-list.doc-type   = buf_trn-doc.doc-type
     1318             buf_doc-list.fact-date  = buf_trn-doc.fact-date
     1319             buf_doc-list.shift-date = buf_trn-doc.shift-date
     1320             buf_doc-list.shift-num  = buf_trn-doc.shift-num
     1321             buf_doc-list.shift-name = buf_trn-doc.shift-name
     1322             buf_doc-list.fact-order = buf_trn-doc.fact-order
     1323             buf_doc-list.is-trn-doc = true
     1324           .
     1325         end.
     1326       end.
     1327     end.
     1328   end procedure.
     1329   procedure doclslib-init-price-doc :
     1330     define input parameter p-obj-type      as character no-undo .
     1331     define input parameter p-obj-code      as integer   no-undo .
     1332     define input parameter p-cut-date      as date      no-undo .
     1333     define buffer buf_price-doc for ub.price-doc .
     1334     define buffer buf_doc-list for doc-list .
     1335     do
     1336     on error undo, return error
     1337     :
     1338       if p-cut-date = ?
     1339       then do:
     1340         for each buf_price-doc no-lock
     1341           where buf_price-doc.obj-type = p-obj-type
     1342             and buf_price-doc.obj-code = p-obj-code
     1343             and buf_price-doc.status_  = 'акт':U
     1344         on error undo, return error
     1345         :
     1346           create buf_doc-list .
     1347           assign
     1348             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1349             buf_doc-list.doc-type   = ''
     1350             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1351             buf_doc-list.shift-date = buf_price-doc.shift-date
     1352             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1353             buf_doc-list.shift-name = buf_price-doc.shift-name
     1354             buf_doc-list.fact-order = buf_price-doc.fact-order
     1355             buf_doc-list.is-trn-doc = false
     1356           .
     1357         end.
     1358       end.
     1359       else do:
     1360         for each buf_price-doc no-lock
     1361           where buf_price-doc.obj-type = p-obj-type
     1362             and buf_price-doc.obj-code = p-obj-code
     1363             and buf_price-doc.status_  = 'акт':U
     1364             and ub.buf_price-doc.fact-date >= p-cut-date
     1365         on error undo, return error
     1366         :
     1367           create buf_doc-list .
     1368           assign
     1369             buf_doc-list.doc-code   = buf_price-doc.doc-num
     1370             buf_doc-list.doc-type   = ''
     1371             buf_doc-list.fact-date  = buf_price-doc.fact-date
     1372             buf_doc-list.shift-date = buf_price-doc.shift-date
     1373             buf_doc-list.shift-num  = buf_price-doc.shift-num
     1374             buf_doc-list.shift-name = buf_price-doc.shift-name
     1375             buf_doc-list.fact-order = buf_price-doc.fact-order
     1376             buf_doc-list.is-trn-doc = false
     1377           .
     1378         end.
     1379       end.
     1380     end.
     1381   end procedure.
     1382   procedure doclslib-clear-bydate-doc-list :
     1383     define input parameter p-fact-date as date no-undo .
     1384     define buffer buf_doc-list for doc-list .
     1385     do
     1386     on error undo, return error
     1387     :
     1388       if p-fact-date <> ?
     1389       then do:
     1390         for each buf_doc-list
     1391           where buf_doc-list.fact-date < p-fact-date
     1392         on error undo, return error
     1393         :
     1394           delete buf_doc-list .
     1395         end.
     1396       end.
     1397     end.
     1398   end procedure.
     1399   procedure doclslib-clear-rst :
     1400     define input parameter p-fact-date as date no-undo .
     1401     define buffer buf_doc-list for doc-list .
     1402     do
     1403     on error undo, return error
     1404     :
     1405       if p-fact-date <> ?
     1406       then do:
     1407         for each buf_doc-list
     1408           where buf_doc-list.fact-date >= p-fact-date
     1409         on error undo, return error
     1410         :
