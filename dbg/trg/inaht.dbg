     7659     define input  parameter p-cons-pay             as integer   no-undo .
     7660     define input  parameter p-curr-r-b             as character no-undo .
     7661     define input  parameter p-base-rate            like ub.curr-accnt.exch-rate no-undo .
     7662     define input  parameter p-base-scale           like ub.curr-accnt.exch-scale no-undo .
     7663     define input  parameter p-base-rate-reason     as character no-undo .
     7664     define input  parameter p-archive-date         as date      no-undo .
     7665     define buffer buf_goods        for ub.goods .
