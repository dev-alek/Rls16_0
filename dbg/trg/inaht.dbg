     3165                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     3166               p-cur-VAT-base      = p-cur-VAT-base
     3167                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     3168               p-cur-SLT-base      = p-cur-SLT-base
     3169                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     3170               p-cur-road-tax-base = p-cur-road-tax-base
     3171                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     3172               p-cur-excise-base   = p-cur-excise-base
     3173                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     3174             .
     3175           end.
     3176           else do:
     3177             assign
     3178               p-fact-qnty         = p-fact-qnty
     3179                                   + buf_price-list.doc-qnty
     3180               p-cur-base          = p-cur-base
     3181                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     3182               p-cur-VAT-base      = p-cur-VAT-base
     3183                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     3184               p-cur-SLT-base      = p-cur-SLT-base
     3185                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     3186               p-cur-road-tax-base = p-cur-road-tax-base
     3187                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     3188               p-cur-excise-base   = p-cur-excise-base
     3189                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     3190             .
     3191           end.
     3192         end.
     3193     end.
     3194   end procedure.
     3195   procedure prdoclib-calc-prc :
     3196     define input  parameter p-price-doc-recid as   recid                  no-undo.
     3197     define input  parameter p-cons-pay        as   integer                no-undo.
     3198     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     3199     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     3200     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     3201     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     3202     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     3203     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     3204     do
     3205     on error undo, return error return-value
     3206     :
     3207       define buffer buf_price-doc       for ub.price-doc .
     3208       define buffer buf_price-list      for ub.price-list .
     3209       define buffer buf_parts           for ub.parts .
     3210       define variable v-ov-qnty     as decimal   no-undo .
     3211       define variable v-ov-base     as decimal   no-undo .
     3212       define variable v-ov-VAT-base as decimal   no-undo .
     3213       define variable v-ov-SLT-base as decimal   no-undo .
     3214       define variable v-cons-qnty   as decimal   no-undo .
     3215       define variable v-prch-qnty   as decimal   no-undo .
     3216       define variable v-cons-mult   as decimal   no-undo .
     3217       define variable v-prch-mult   as decimal   no-undo .
     3218       find first buf_price-doc no-lock
     3219         where recid(buf_price-doc) = p-price-doc-recid
     3220         no-error .
     3221       if not available buf_price-doc
     3222       then do:
     3223         message
     3224           vss-workfile vss-revision vss-description skip
     3225           vss-include-info8 skip
     3226           "Ошибка задания входных параметров" skip
     3227           "Не найден документ переоценки" skip
     3228           "Код записи (recid)" p-price-doc-recid skip
     3229           view-as alert-box error .
     3230         undo, return error .
     3231       end.
     3232       for each buf_price-list no-lock
     3233         where buf_price-list.doc-num    = buf_price-doc.doc-num
     3234           and buf_price-list.main-price = true
     3235       on error undo, return error return-value
     3236       :
     3237         run prdoclib-calc-ov
     3238           (input recid(buf_price-list)
     3239           ,output v-ov-qnty
     3240           ,output v-ov-base
     3241           ,output v-ov-VAT-base
     3242           ,output v-ov-SLT-base
     3243           ) no-error .
     3244         if error-status :error
     3245         then do:
     3246           if error-status :get-message(1) <> ""
     3247           then do:
     3248             message
     3249               vss-workfile vss-revision vss-description skip
     3250               vss-include-info8 skip
     3251               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     3252               error-status :get-message(1) skip
     3253               return-value skip
     3254               view-as alert-box error .
     3255           end.
     3256           undo, return error return-value .
     3257         end.
     3258         assign
     3259           v-cons-qnty = 0
     3260           v-prch-qnty = 0
     3261         .
     3262         for each buf_parts no-lock
     3263           where buf_parts.out-code  = buf_price-list.doc-num
     3264             and buf_parts.obj-type  = buf_price-list.obj-type
     3265             and buf_parts.obj-code  = buf_price-list.obj-code
     3266             and buf_parts.artic     = buf_price-list.artic
     3267             and buf_parts.prod-type = buf_price-list.prod-type
     3268             and buf_parts.prod-code = buf_price-list.prod-code
     3269         on error undo, return error return-value
     3270         :
     3271           if buf_parts.pay-code = p-cons-pay
     3272           then do:
     3273             assign
     3274               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     3275             .
     3276           end.
     3277           else do:
     3278             assign
     3279               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     3280             .
     3281           end.
     3282         end.
     3283         if (v-cons-qnty + v-prch-qnty) = 0
     3284         then do:
     3285           assign
     3286             v-cons-mult = 0
     3287             v-prch-mult = 1
     3288           .
     3289         end.
     3290         else do:
     3291           assign
     3292             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     3293             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     3294           .
     3295         end.
     3296         assign
     3297           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     3298           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     3299           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     3300           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     3301           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     3302           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     3303         .
     3304       end.
     3305     end.
     3306   end procedure.
     3307   procedure prdoclib-calc-ov :
     3308     define input  parameter p-price-list-recid as recid     no-undo .
     3309     define output parameter p-fact-qnty        as decimal   no-undo .
     3310     define output parameter p-ov-base          as decimal   no-undo .
     3311     define output parameter p-ov-VAT-base      as decimal   no-undo .
     3312     define output parameter p-ov-SLT-base      as decimal   no-undo .
     3313     do
     3314     on error undo, return error return-value
     3315     :
     3316       define buffer buf_main_price-list    for ub.price-list .
     3317       define buffer buf_prev_price-list    for ub.price-list .
     3318       define buffer buf_special_price-list for ub.price-list .
     3319       define buffer buf_goods              for ub.goods .
     3320       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     3321       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     3322       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     3323       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     3324       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     3325       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     3326       define variable v-prev-price-list-recid as   recid                  no-undo.
     3327       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     3328       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     3329       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     3330       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     3331       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     3332       find first buf_main_price-list no-lock
     3333         where recid(buf_main_price-list) = p-price-list-recid
     3334         no-error .
     3335       if not available buf_main_price-list
     3336       then do:
     3337         message
     3338           vss-workfile vss-revision vss-description skip
     3339           vss-include-info8 skip
     3340           "Ошибка задания входных параметров" skip
     3341           "Не найдена строка переоценки" skip
     3342           "Код записи (recid)" p-price-list-recid skip
     3343           view-as alert-box error .
     3344         undo, return error .
     3345       end.
     3346       if buf_main_price-list.main-price <> true
     3347       then do:
     3348         message
     3349           vss-workfile vss-revision vss-description skip
     3350           vss-include-info8 skip
     3351           "Ошибка задания входных параметров" skip
     3352           "Строка переоценки не является основной" skip
     3353           "Код записи (recid)" p-price-list-recid skip
     3354           "Переоценка" buf_main_price-list.doc-num skip
     3355           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3356           "Бар-код" buf_main_price-list.b-code skip
     3357           view-as alert-box error .
     3358         undo, return error .
     3359       end.
     3360       run prdoclib-calc-fact-sale in this-procedure
     3361         (input  recid(buf_main_price-list)
     3362         ,output v-fact-qnty
     3363         ,output v-cur-base
     3364         ,output v-cur-VAT-base
     3365         ,output v-cur-SLT-base
     3366         ,output v-cur-road-tax-base
     3367         ,output v-cur-excise-base
     3368         ) no-error.
     3369       if error-status :error
     3370       then do:
     3371         message
     3372           vss-workfile vss-revision vss-description skip
     3373           vss-include-info8 skip
     3374           "Ошибка при расчете сумм переоценки." skip
     3375           "Документ переоценки" buf_main_price-list.doc-num skip
     3376           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3377           error-status :get-message(1) skip
     3378           return-value skip
     3379           view-as alert-box error .
     3380         undo, return error .
     3381       end.
     3382   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3383   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3384     (input  buf_main_price-list.obj-type
     3385     ,input  buf_main_price-list.obj-code
     3386     ,input  buf_main_price-list.b-code
     3387     ,input  buf_main_price-list.b-code
     3388     ,input  buf_main_price-list.fact-order
     3389     ,output v-prev-price-list-recid
     3390     ,output v-prev-cli-base-rate
     3391     ) no-error .
     3392       if error-status :error
     3393       then do:
     3394         message
     3395           vss-workfile vss-revision vss-description skip
     3396           vss-include-info8 skip
     3397           "Ошибка при поиске предыдущей переоценки." skip
     3398           "Документ переоценки " buf_main_price-list.doc-num skip
     3399           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3400           error-status :get-message(1) skip
     3401           return-value skip
     3402           view-as alert-box error .
     3403         undo, return error .
     3404       end.
     3405       if v-prev-price-list-recid <> ?
     3406       then do:
     3407         find first buf_prev_price-list no-lock
     3408           where recid(buf_prev_price-list) = v-prev-price-list-recid
     3409           .
     3410         find first buf_special_price-list no-lock
     3411           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     3412             and buf_special_price-list.main-price = false
     3413             and buf_special_price-list.artic      = buf_prev_price-list.artic
     3414             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     3415             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     3416             and buf_special_price-list.doc-qnty   <> ?
     3417           no-error .
     3418         if available buf_special_price-list
     3419         then do:
     3420           message
     3421             "Товар имеет специальные цены на признаки" skip
     3422             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3423             "Переоценка" buf_prev_price-list.doc-num skip
     3424             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3425             view-as alert-box error .
     3426           undo, return error .
     3427         end.
     3428         find first buf_goods no-lock
     3429           where buf_goods.artic     = buf_main_price-list.artic
     3430             and buf_goods.prod-type = buf_main_price-list.prod-type
     3431             and buf_goods.prod-code = buf_main_price-list.prod-code
     3432           no-error .
     3433         if not available buf_goods
     3434         then do:
     3435           message
     3436             vss-workfile vss-revision vss-description skip
     3437             vss-include-info8 skip
     3438             "Не найден товар" skip
     3439             "Переоценка" buf_main_price-list.doc-num skip
     3440             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3441             view-as alert-box error .
     3442           undo, return error .
     3443         end.
     3444         if buf_prev_price-list.vat-pc = ?
     3445         or buf_prev_price-list.slt-pc = ?
     3446         then do:
     3447           message
     3448             "В переоценке не заданы налоги товара" skip
     3449             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     3450             "Переоценка" buf_prev_price-list.doc-num skip
     3451             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     3452             "НДС" buf_prev_price-list.vat-pc skip
     3453             "НП" buf_prev_price-list.slt-pc skip
     3454             view-as alert-box error .
     3455           undo, return error return-value .
     3456         end.
     3457         define variable v-prev-cur-SLT-pc as decimal no-undo .
     3458         assign
     3459           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     3460         .
     3461         assign
     3462           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     3463           v-prev-cur-VAT-base = v-fact-qnty
     3464                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     3465                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     3466           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     3467         .
     3468         assign
     3469           p-fact-qnty   = v-fact-qnty
     3470           p-ov-base     = v-cur-base     - v-prev-cur-base
     3471           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3472           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3473         .
     3474       end.
     3475       else do:
     3476         assign
     3477           v-prev-cur-base     = 0
     3478           v-prev-cur-VAT-base = 0
     3479           v-prev-cur-SLT-base = 0
     3480           .
     3481         assign
     3482           p-fact-qnty   = v-fact-qnty
     3483           p-ov-base     = v-cur-base     - v-prev-cur-base
     3484           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     3485           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     3486         .
     3487       end.
     3488     end.
     3489   end procedure.
     3490   procedure prdoclib-init-prt-obj-by-factord :
     3491     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3492     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3493     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3494     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3495     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3496     define input parameter p-fact-order         as decimal   no-undo .
     3497     define input parameter p-include-fact-order as logical   no-undo .
     3498     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     3499     define buffer buf_gds-obj      for ub.gds-obj .
     3500     define buffer buf_doc-line     for ub.doc-line .
     3501     define buffer buf_temp-prt-obj for temp-prt-obj .
     3502     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     3503     do
     3504     on error undo, return error return-value
     3505     :
     3506       do transaction
     3507       on error undo, return error return-value
     3508       :
     3509   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3510   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3511     (input  p-obj-type
     3512     ,input  p-obj-code
     3513     ,input  p-artic
     3514     ,input  p-prod-type
     3515     ,input  p-prod-code
     3516     ,buffer buf_gds-obj
     3517     ) no-error .
     3518         if error-status :error
     3519         then do:
     3520           message
     3521             vss-workfile vss-revision vss-description skip
     3522             vss-include-info8 skip
     3523             "Невозможно найти gds-obj" skip
     3524             error-status :get-message(1) skip
     3525             return-value skip
     3526             view-as alert-box error .
     3527           undo, return error .
     3528         end.
     3529         find current buf_gds-obj exclusive-lock .
     3530       end.
     3531       run prdoclib-init-temp-prt-obj in this-procedure
     3532         (input p-obj-type
     3533         ,input p-obj-code
     3534         ,input p-artic
     3535         ,input p-prod-type
     3536         ,input p-prod-code
     3537         ,input 0
     3538         ) .
     3539       for each buf_temp-prt-obj
     3540         where buf_temp-prt-obj.is-term <> true
     3541       on error undo, return error return-value
     3542       :
     3543         delete buf_temp-prt-obj .
     3544       end.
     3545       if p-include-fact-order = true
     3546       then do:
     3547         assign
     3548          p-fact-order = p-fact-order - 0.0000000001
     3549         .
     3550       end.
     3551       for each buf_doc-line no-lock
     3552         where buf_doc-line.obj-type   = p-obj-type
     3553           and buf_doc-line.obj-code   = p-obj-code
     3554           and buf_doc-line.artic      = p-artic
     3555           and buf_doc-line.prod-type  = p-prod-type
     3556           and buf_doc-line.prod-code  = p-prod-code
     3557           and buf_doc-line.status_    = 'факт':U
     3558           and buf_doc-line.fact-order >= p-fact-order
     3559       on error undo, return error return-value
     3560       :
     3561         run prdoclib-process-document in this-procedure
     3562           (input  buf_doc-line.doc-code
     3563           ,input  p-obj-type
     3564           ,input  p-obj-code
     3565           ,input  p-artic
     3566           ,input  p-prod-type
     3567           ,input  p-prod-code
     3568           ,output v-total-gds-dtl-qnty
     3569           ) .
     3570       end.
     3571     end.
     3572   end procedure.
     3573   procedure prdoclib-process-document :
     3574     define input  parameter p-doc-code           as character no-undo .
     3575     define input  parameter p-obj-type           as character no-undo .
     3576     define input  parameter p-obj-code           as integer   no-undo .
     3577     define input  parameter p-artic              as character no-undo .
     3578     define input  parameter p-prod-type          as character no-undo .
     3579     define input  parameter p-prod-code          as integer   no-undo .
     3580     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3581     define buffer buf_trn-doc      for ub.trn-doc .
     3582     define buffer buf_gds-dtl      for ub.gds-dtl .
     3583     define buffer buf_temp-prt-obj for temp-prt-obj .
     3584     do
     3585     on error undo, return error return-value
     3586     :
     3587       find first buf_trn-doc no-lock
     3588         where buf_trn-doc.doc-code = p-doc-code
     3589         no-error .
     3590       if not available buf_trn-doc then do:
     3591         message
     3592           vss-workfile vss-revision vss-description skip
     3593           vss-include-info8 skip
     3594           "Ошибка при поиске документа" skip
     3595           "Документ" p-doc-code skip
     3596           "Объект" p-obj-type p-obj-code skip
     3597           "Артикул" p-artic p-prod-type p-prod-code skip
     3598           view-as alert-box error .
     3599         undo, return error .
     3600       end.
     3601       assign
     3602         p-total-gds-dtl-qnty = 0
     3603       .
     3604       for each buf_gds-dtl no-lock
     3605         where buf_gds-dtl.doc-code  = p-doc-code
     3606           and buf_gds-dtl.artic     = p-artic
     3607           and buf_gds-dtl.prod-type = p-prod-type
     3608           and buf_gds-dtl.prod-code = p-prod-code
     3609       on error undo, return error
     3610       :
     3611         define variable v-term-node as integer   no-undo .
     3612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3613     (input  buf_gds-dtl.prt-code
     3614     ,output v-term-node
     3615     )  .
     3616         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3617           (input  v-term-node
     3618           ,buffer buf_temp-prt-obj
     3619           ) .
     3620         if buf_temp-prt-obj.is-term <> true then do:
     3621           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3622                                        ,buf_gds-dtl.prt-code
     3623                                        ) .
     3624         end.
     3625         case buf_trn-doc.doc-type :
     3626           when 'при':U or
     3627           when 'возврат':U
     3628           then do:
     3629             assign
     3630               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3631                                           - buf_gds-dtl.fact-qnty
     3632               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3633                                           - buf_gds-dtl.fact-qnty
     3634             .
     3635           end.
     3636           when 'рас':U or
     3637           when 'спи':U
     3638           then do:
     3639             assign
     3640               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3641                                           + buf_gds-dtl.fact-qnty
     3642               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3643                                           + buf_gds-dtl.fact-qnty
     3644             .
     3645           end.
     3646           when 'инв':U
     3647           then do:
     3648             assign
     3649               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3650                                           - buf_gds-dtl.doc-qnty
     3651               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3652                                           - buf_gds-dtl.doc-qnty
     3653             .
     3654           end.
     3655           otherwise do:
     3656             undo, return error substitute("Неизвестный тип документа &1"
     3657                                          ,buf_trn-doc.doc-type
     3658                                          ) .
     3659           end.
     3660         end.
     3661       end.
     3662     end.
     3663   end procedure.
     3664   procedure prdoclib-prc-pl-document :
     3665     define input  parameter p-doc-code              as character no-undo .
     3666     define input  parameter p-obj-type              as character no-undo .
     3667     define input  parameter p-obj-code              as integer   no-undo .
     3668     define input  parameter p-gds-code              as integer   no-undo .
     3669     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3670     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3671     do
     3672     on error undo, return error return-value
     3673     :
     3674       define buffer buf_trn-doc      for ub.trn-doc .
     3675       define buffer buf_doc-pl       for ub.doc-pl .
     3676       define buffer buf_temp-pl-gds for temp-pl-gds .
     3677       define variable v-sign as decimal   no-undo .
     3678       find first buf_trn-doc no-lock
     3679         where buf_trn-doc.doc-code = p-doc-code
     3680         no-error .
     3681       if not available buf_trn-doc then do:
     3682         message
     3683           vss-workfile vss-revision vss-description skip
     3684           vss-include-info8 skip
     3685           "Ошибка при поиске документа" skip
     3686           "Документ" p-doc-code skip
     3687           "Объект" p-obj-type p-obj-code skip
     3688           "Товар" p-gds-code skip
     3689           view-as alert-box error .
     3690         undo, return error .
     3691       end.
     3692       assign
     3693         p-total-pl-gds-qnty     = 0
     3694         p-total-pl-gds-cli-qnty = 0
     3695       .
     3696       for each buf_doc-pl no-lock
     3697         where buf_doc-pl.out-code  = p-doc-code
     3698           and buf_doc-pl.gds-code  = p-gds-code
     3699       on error undo, return error return-value
     3700       :
     3701         find first buf_temp-pl-gds
     3702           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3703             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3704             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3705           .
     3706         case buf_trn-doc.doc-type :
     3707           when 'при':U
     3708           or when 'возврат':U
     3709           or when 'инв':U
     3710           then do:
     3711             assign
     3712               v-sign = -1.0
     3713             .
     3714           end.
     3715           when 'рас':U or
     3716           when 'спи':U
     3717           then do:
     3718             assign
     3719               v-sign = 1.0
     3720             .
     3721           end.
     3722           otherwise do:
     3723             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3724           end.
     3725         end case.
     3726         assign
     3727           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3728           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3729           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3730           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3731         .
     3732       end.
     3733     end.
     3734   end procedure.
     3735   procedure prdoclib-init-prt-obj-by-date :
     3736     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3737     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3738     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3739     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3740     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3741     define input parameter p-fact-date  as date      no-undo .
     3742     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3743     do
     3744     on error undo, return error return-value
     3745     :
     3746       define variable v-fact-order                as decimal   no-undo .
     3747       define variable v-shift-end-fact-order      as decimal   no-undo .
     3748       define variable v-day-end-fact-order        as decimal   no-undo .
     3749       run factord in this-procedure
     3750         (input  p-fact-date
     3751         ,input  1
     3752         ,input  1
     3753         ,input  ?
     3754         ,input  0
     3755         ,input  false
     3756         ,output v-fact-order
     3757         ,output v-shift-end-fact-order
     3758         ,output v-day-end-fact-order
     3759         ) no-error .
     3760       if error-status :error
     3761       then do:
     3762         message
     3763           vss-workfile vss-revision vss-description skip
     3764           vss-include-info8 skip
     3765           "Ошибка при определении момента времени, на который требуется остаток" skip
     3766           "Объект" p-obj-type p-obj-code skip
     3767           "Артикул" p-artic p-prod-type p-prod-code skip
     3768           "Дата" p-fact-date skip
     3769           view-as alert-box error .
     3770         undo, return error .
     3771       end.
     3772       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3773         (input p-obj-type
     3774         ,input p-obj-code
     3775         ,input p-artic
     3776         ,input p-prod-type
     3777         ,input p-prod-code
     3778         ,input v-day-end-fact-order
     3779         ,input false
     3780         ) no-error .
     3781       if error-status :error
     3782       then do:
     3783         message
     3784           vss-workfile vss-revision vss-description skip
     3785           vss-include-info8 skip
     3786           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3787           "Объект" p-obj-type p-obj-code skip
     3788           "Артикул" p-artic p-prod-type p-prod-code skip
     3789           "Дата" p-fact-date skip
     3790           view-as alert-box error .
     3791         undo, return error .
     3792       end.
     3793     end.
     3794   end procedure.
     3795   procedure prdoclib-calc-temp-fact-sale :
     3796     define input  parameter p-obj-type           as character no-undo .
     3797     define input  parameter p-obj-code           as integer   no-undo .
     3798     define input  parameter p-gds-code           as integer   no-undo .
     3799     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3800     define input  parameter p-curr-r-b           as character no-undo .
     3801     define output parameter p-fact-qnty          as decimal   no-undo .
     3802     define output parameter p-cur-base           as decimal   no-undo .
     3803     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3804     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3805     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3806     define output parameter p-cur-excise-base    as decimal   no-undo .
     3807     define buffer buf_temp-prt-obj for temp-prt-obj .
     3808     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3809     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3810     define variable parrecid-prl        as recid     no-undo .
     3811     define variable v-fact-qnty         as decimal   no-undo .
     3812     define variable v-cur-base          as decimal   no-undo .
     3813     define variable v-cur-VAT-base      as decimal   no-undo .
     3814     define variable v-cur-SLT-base      as decimal   no-undo .
     3815     define variable v-cur-road-tax-base as decimal   no-undo .
     3816     define variable v-cur-excise-base   as decimal   no-undo .
     3817     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3818     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3819     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3820     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3821     define variable vat-base-sale-prl               as decimal   no-undo .
     3822     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3823     define variable vat-base-buyer-prl              as decimal   no-undo .
     3824     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3825     define variable slt-base-sale-prl               as decimal   no-undo .
     3826     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3827     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3828     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3829     define variable excise-base-sale-prl            as decimal   no-undo .
     3830     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3831     define variable discnt-base-sale-prl            as decimal   no-undo .
     3832     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3833     do
     3834     on error undo, return error return-value
     3835     :
     3836       for each buf_temp-prt-obj no-lock
     3837       on error undo, return error return-value
     3838       :
     3839   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3840     (input  p-gds-code
     3841     ,input  buf_temp-prt-obj.prt-code
     3842     ,output v-prt-b-code
     3843     ) no-error .
     3844         if error-status :error
     3845         then do:
     3846           message
     3847             vss-workfile vss-revision vss-description skip
     3848             "Ошибка при определении бар-кода признака" skip
     3849             "Код товара"   p-gds-code skip
     3850             "Код признака" buf_temp-prt-obj.prt-code skip
     3851             error-status :get-message(1) skip
     3852             return-value skip
     3853             view-as alert-box error .
     3854           undo, return error .
     3855         end.
     3856   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3858     (input  p-obj-type
     3859     ,input  p-obj-code
     3860     ,input  v-prt-b-code
     3861     ,input  0
     3862     ,input  p-day-end-fact-order
     3863     ,output parrecid-prl
     3864     ,output v-cli-base-rate
     3865     ) no-error .
     3866         if error-status :error
     3867         then do:
     3868           message
     3869             vss-workfile vss-revision vss-description skip
     3870             "Ошибка при определении цены бар-кода" skip
     3871             "Объект" p-obj-type p-obj-code skip
     3872             "Бар-код" v-prt-b-code skip
     3873             "fact-order" p-day-end-fact-order skip
     3874             error-status :get-message(1) skip
     3875             return-value skip
     3876             view-as alert-box error .
     3877           undo, return error .
     3878         end.
     3879         if parrecid-prl <> ?
     3880         then do:
     3881           run prl-vat in this-procedure
     3882             (input  parrecid-prl
     3883             ,output price-rubl-with-tax-sale-prl
     3884             ,output price-base-with-tax-sale-prl
     3885             ,output price-rubl-without-tax-sale-prl
     3886             ,output price-base-without-tax-sale-prl
     3887             ,output vat-base-sale-prl
     3888             ,output vat-rubl-sale-prl
     3889             ,output vat-base-buyer-prl
     3890             ,output vat-rubl-buyer-prl
     3891             ,output slt-base-sale-prl
     3892             ,output slt-rubl-sale-prl
     3893             ,output road-tax-base-sale-prl
     3894             ,output road-tax-rubl-sale-prl
     3895             ,output excise-base-sale-prl
     3896             ,output excise-rubl-sale-prl
     3897             ,output discnt-base-sale-prl
     3898             ,output discnt-rubl-sale-prl
     3899             ) no-error .
     3900           if error-status :error
     3901           then do:
     3902             message
     3903               vss-workfile vss-revision vss-description skip
     3904               "Ошибка при вызове процеды prl-vat" skip
     3905               "Объект" p-obj-type p-obj-code skip
     3906               "Код товара" p-gds-code skip
     3907               "Указатель на запись переоценки" parrecid-prl skip
     3908               error-status :get-message(1) skip
     3909               return-value skip
     3910               view-as alert-box error .
     3911             undo, return error .
     3912           end.
     3913         end.
     3914         else do:
     3915           assign
     3916             price-rubl-with-tax-sale-prl    = 0
     3917             price-base-with-tax-sale-prl    = 0
     3918             price-rubl-without-tax-sale-prl = 0
     3919             price-base-without-tax-sale-prl = 0
     3920             vat-base-sale-prl               = 0
     3921             vat-rubl-sale-prl               = 0
     3922             slt-base-sale-prl               = 0
     3923             slt-rubl-sale-prl               = 0
     3924             road-tax-base-sale-prl          = 0
     3925             road-tax-rubl-sale-prl          = 0
     3926             excise-base-sale-prl            = 0
     3927             excise-rubl-sale-prl            = 0
     3928             discnt-base-sale-prl            = 0
     3929             discnt-rubl-sale-prl            = 0
     3930           .
     3931         end.
     3932         assign
     3933           v-fact-qnty         = v-fact-qnty
     3934                               + buf_temp-prt-obj.fact-qnty
     3935           v-cur-base          = v-cur-base
     3936                               + (if p-curr-r-b = 'base':U
     3937                                   then price-base-with-tax-sale-prl
     3938                                   else price-rubl-with-tax-sale-prl
     3939                                 )
     3940                               * buf_temp-prt-obj.fact-qnty
     3941           v-cur-VAT-base      = v-cur-VAT-base
     3942                               + (if p-curr-r-b = 'base':U
     3943                                   then vat-base-sale-prl
     3944                                   else vat-rubl-sale-prl
     3945                                 )
     3946                               * buf_temp-prt-obj.fact-qnty
     3947           v-cur-SLT-base      = v-cur-SLT-base
     3948                               + (if p-curr-r-b = 'base':U
     3949                                   then slt-base-sale-prl
     3950                                   else slt-rubl-sale-prl
     3951                                 )
     3952                               * buf_temp-prt-obj.fact-qnty
     3953           v-cur-road-tax-base = v-cur-road-tax-base
     3954                               + (if p-curr-r-b = 'base':U
     3955                                   then road-tax-base-sale-prl
     3956                                   else road-tax-rubl-sale-prl
     3957                                 )
     3958                               * buf_temp-prt-obj.fact-qnty
     3959           v-cur-excise-base   = v-cur-excise-base
     3960                               + (if p-curr-r-b = 'base':U
     3961                                   then excise-base-sale-prl
     3962                                   else excise-rubl-sale-prl
     3963                                 )
     3964                               * buf_temp-prt-obj.fact-qnty
     3965         .
     3966       end.
     3967       assign
     3968         p-fact-qnty         = v-fact-qnty
     3969         p-cur-base          = v-cur-base
     3970         p-cur-VAT-base      = v-cur-VAT-base
     3971         p-cur-SLT-base      = v-cur-SLT-base
     3972         p-cur-road-tax-base = v-cur-road-tax-base
     3973         p-cur-excise-base   = v-cur-excise-base
     3974       .
     3975     end.
     3976   end procedure.
     3977   procedure prdoclib-clear-temp-pl-gds :
     3978     define buffer buf_temp-pl-gds for temp-pl-gds .
     3979     do
     3980     on error undo, return error return-value
     3981     :
     3982       for each buf_temp-pl-gds
     3983       on error undo, return error return-value
     3984       :
     3985         delete buf_temp-pl-gds .
     3986       end.
     3987     end.
     3988   end procedure.
     3989   procedure prdoclib-init-temp-pl-gds :
     3990     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3991     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3992     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3993     define buffer buf_pl-gds      for ub.pl-gds .
     3994     define buffer buf_temp-pl-gds for temp-pl-gds .
     3995     do
     3996     on error undo, return error return-value
     3997     :
     3998       run prdoclib-clear-temp-pl-gds in this-procedure .
     3999       for each buf_pl-gds
     4000         where buf_pl-gds.obj-type = p-obj-type
     4001           and buf_pl-gds.obj-code = p-obj-code
     4002           and buf_pl-gds.gds-code = p-gds-code
     4003       on error undo, return error return-value
     4004       :
     4005         create buf_temp-pl-gds .
     4006         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     4007       end.
     4008     end.
     4009   end procedure.
     4010   procedure prdoclib-init-pl-gds-by-factord :
     4011     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     4012     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     4013     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     4014     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     4015     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     4016     define input parameter p-fact-order         as decimal   no-undo .
     4017     define input parameter p-include-fact-order as logical   no-undo .
     4018     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     4019     define buffer buf_goods       for ub.goods .
     4020     define buffer buf_gds-obj     for ub.gds-obj .
     4021     define buffer buf_doc-line    for ub.doc-line .
     4022     define buffer buf_temp-pl-gds for temp-pl-gds .
     4023     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     4024     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     4025     do
     4026     on error undo, return error return-value
     4027     :
     4028       do transaction
     4029       on error undo, return error return-value
     4030       :
     4031   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
