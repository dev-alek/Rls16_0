     6701   procedure clcprtsl_calc-ttable :
     6702   define input parameter paris-doc           as   logical                 no-undo.
     6703   define input parameter paris-cur           as   logical                 no-undo.
     6704   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     6705   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     6706   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     6707   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     6708   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     6709   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     6710   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     6711   define input parameter parr-b              as   character               no-undo.
     6712   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     6713   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     6714   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     6715   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     6716   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     6717   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     6718   define buffer bf_tt-allsum      for tt-allsum.
     6719   define buffer bf_tt-clcparts    for tt-clcparts.
     6720   define buffer bf_tt-allsum-line for tt-allsum-line.
     6721   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     6722   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     6723   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     6724   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     6725   define variable varexcise          like ub.price-list.excise     no-undo.
     6726   do on error undo, return error return-value :
     6727   for each bf_tt-allsum-line
     6728   on error undo, return error return-value
     6729    :
     6730     delete bf_tt-allsum-line.
     6731   end.
     6732   for each bf_tt-allsum
     6733   on error undo, return error return-value
     6734   :
     6735     delete bf_tt-allsum.
     6736   end.
     6737   for each bf_tt-clcparts
     6738   on error undo, return error return-value
     6739   :
     6740   if v-calcbypart then do:
     6741             assign
     6742             parcur-base =   bf_tt-clcparts.part-cur-base
     6743             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     6744             parcur-excise =   bf_tt-clcparts.part-cur-excise
     6745             .
     6746   end.
     6747      run clcprtsl_calc-parts in this-procedure (
     6748        input recid(bf_tt-clcparts),
     6749        input paris-doc,
     6750        input paris-cur,
     6751        input parroad-tax,
     6752        input parexcise,
     6753        input parvat-pc,
     6754        input parcons-vat-pc,
     6755        input parslt-pc,
     6756        input parbase-rate,
     6757        input parbase-scale,
     6758        input parr-b,
     6759        input parcur-base,
     6760        input parcur-road-tax,
     6761        input parcur-excise,
     6762        input parcur-vat-pc,
     6763        input parcurcons-vat-pc,
     6764        input parcurslt-pc
     6765        ) no-error.
     6766     if error-status:error then do:
     6767       message
     6768         vss-workfile vss-revision vss-description skip
     6769         vss-include-info32 skip
     6770         "Ошибка при обсчете партии" skip
     6771         "Документ партии " bf_tt-clcparts.out-code skip
     6772         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     6773         return-value skip
     6774         error-status:get-message(1) skip
     6775         error-status:get-message(2) skip
     6776         error-status:get-message(3) skip
     6777         view-as alert-box error .
     6778       undo, return error .
     6779     end.
     6780     for each bf_tt-allsum on error undo, return error return-value :
     6781       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     6782       if not available bf_tt-allsum-line then do:
     6783         create bf_tt-allsum-line.
     6784         assign
     6785           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     6786       end.
     6787       assign
     6788         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     6789         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     6790         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     6791         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     6792         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     6793         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     6794         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     6795         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     6796         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     6797         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     6798         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     6799         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     6800         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     6801         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     6802         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     6803         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     6804         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     6805         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     6806         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     6807         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
