     7693           "Ошибка при определении атрибута товара" skip
     7694           "Код товара" p-gds-code skip
     7695           'gds-goods=request':u
     7696           view-as alert-box error .
     7697         undo, return error return-value .
     7698       end.
     7699       if v-gds-goods
     7700       then do:
     7701         define variable v-cur-base          as decimal   no-undo .
     7702         define variable v-cur-VAT-base      as decimal   no-undo .
     7703         define variable v-cur-SLT-base      as decimal   no-undo .
     7704         define variable v-cur-road-tax-base as decimal   no-undo .
