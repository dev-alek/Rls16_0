      583   procedure aht_store-stk-line :
      584     define parameter buffer buf_temp-aht-ot-line for temp-aht-ot-line .
      585     define input  parameter p-stk-sum-type   as character no-undo .
      586     define input  parameter p-fact-order     like ub.trn-doc.fact-order   no-undo .
      587     define input  parameter p-cut-fact-order like ub.trn-doc.fact-order   no-undo .
