     2037       .
     2038     end.
     2039   end procedure.
     2040   procedure doclslib-check-doc-arh-exist :
     2041     define buffer buf_doc-list for doc-list .
     2042     define buffer buf_ot-tot for ub.ot-tot .
     2043     do
     2044     on error undo, return error return-value
     2045     :
     2046       for each buf_doc-list
     2047       on error undo, return error
     2048       :
     2049         find first buf_ot-tot no-lock
     2050           where buf_ot-tot.doc-code = buf_doc-list.doc-code
     2051           no-error .
     2052         if available buf_ot-tot
     2053         then do:
     2054           assign
     2055             buf_doc-list.is-archive-exist = true
     2056           .
     2057         end.
     2058         else do:
     2059           assign
     2060             buf_doc-list.is-archive-exist = false
     2061           .
     2062         end.
     2063       end.
     2064     end.
     2065   end procedure.
     2066   procedure doclslib-check-doc-aht-exist :
     2067     define buffer buf_doc-list for doc-list .
     2068     define buffer buf_aht-doc for ub.aht-doc .
     2069     do
     2070     on error undo, return error return-value
     2071     :
     2072       for each buf_doc-list
     2073       on error undo, return error
     2074       :
     2075         find first buf_aht-doc no-lock
     2076           where buf_aht-doc.doc-code = buf_doc-list.doc-code
     2077           no-error .
     2078         if available buf_aht-doc
     2079         then do:
     2080           assign
     2081             buf_doc-list.is-archive-exist = true
     2082           .
     2083         end.
     2084         else do:
     2085           assign
     2086             buf_doc-list.is-archive-exist = false
     2087           .
     2088         end.
     2089       end.
     2090     end.
     2091   end procedure.
     2092   procedure doclslib-check-doc-ahsp-exist :
     2093     define buffer buf_doc-list for doc-list .
     2094     define buffer buf_ot-supp-line for ub.ot-supp-tot .
     2095     do
     2096     on error undo, return error return-value
     2097     :
     2098       for each buf_doc-list
     2099       on error undo, return error
     2100       :
     2101         find first buf_ot-supp-line no-lock
     2102           where buf_ot-supp-line.doc-code = buf_doc-list.doc-code
     2103           no-error .
     2104         if available buf_ot-supp-line
     2105         then do:
     2106           assign
     2107             buf_doc-list.is-archive-exist = true
     2108           .
     2109         end.
     2110         else do:
     2111           if buf_doc-list.doc-type = 'инв':U
     2112           then do:
     2113             define variable v-need-process as logical   no-undo .
     2114             run trg/ah-csptr.p
     2115               (input  buf_doc-list.doc-code
     2116               ,input  0
     2117               ,input  true
     2118               ,output v-need-process
     2119               ).
     2120             if v-need-process = true
     2121             then do:
     2122               assign
     2123                 buf_doc-list.is-archive-exist = false
     2124               .
     2125             end.
     2126             else do:
     2127               assign
     2128                 buf_doc-list.is-archive-exist = true
     2129               .
     2130             end.
     2131           end.
     2132           else do:
     2133             assign
     2134               buf_doc-list.is-archive-exist = false
     2135             .
     2136           end.
     2137         end.
     2138       end.
     2139     end.
     2140   end procedure.
     2141   procedure doclslib-clear-ahsp-doc-list :
     2142     define buffer buf_doc-list for doc-list .
     2143     define buffer buf_trn-doc  for ub.trn-doc .
     2144     define buffer buf_doc-line for ub.doc-line .
     2145     define buffer buf_parts    for ub.parts .
     2146     do
     2147     on error undo, return error return-value
     2148     :
     2149       check-doc-list :
     2150       for each buf_doc-list
     2151       on error undo, return error return-value
     2152       :
     2153         find first buf_trn-doc no-lock
     2154           where buf_trn-doc.doc-code = buf_doc-list.doc-code
     2155           .
     2156         if buf_trn-doc.office = true
     2157         then do:
     2158           delete buf_doc-list .
     2159           next check-doc-list .
     2160         end.
     2161         find first buf_doc-line no-lock
     2162           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2163           no-error .
     2164         if not available buf_doc-line
     2165         then do:
     2166           delete buf_doc-list .
     2167           next check-doc-list .
     2168         end.
     2169         find first buf_parts no-lock
     2170           where buf_parts.out-code = buf_trn-doc.doc-code
     2171             and buf_parts.fact-qnty <> 0
     2172           no-error .
     2173         if not available buf_parts
     2174         then do:
     2175           delete buf_doc-list .
     2176           next check-doc-list .
     2177         end.
     2178       end.
     2179     end.
     2180   end procedure.
     2181   procedure doclslib-init-goods :
     2182     define buffer buf_doclslib-goods for doclslib-goods .
     2183     define buffer buf_doc-list       for doc-list .
     2184     define buffer buf_trn-doc        for ub.trn-doc .
     2185     define buffer buf_price-doc      for ub.price-doc .
     2186     define buffer buf_doc-line       for ub.doc-line .
     2187     define buffer buf_price-list     for ub.price-list .
     2188     define variable v-gds-code as integer   no-undo .
     2189     do
     2190     on error undo, return error return-value
     2191     :
     2192       for each buf_doclslib-goods
     2193       on error undo, return error return-value
     2194       :
     2195         delete buf_doclslib-goods .
     2196       end.
     2197       for each buf_doc-list
     2198       on error undo, return error return-value
     2199       :
     2200         if buf_doc-list.is-trn-doc
     2201         then do:
     2202           find first buf_trn-doc no-lock
     2203             where buf_trn-doc.doc-code = buf_doc-list.doc-code
     2204             .
     2205           for each buf_doc-line no-lock
     2206             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2207           on error undo, return error return-value
     2208           :
     2209   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2210   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2211     (input  buf_doc-line.artic
     2212     ,input  buf_doc-line.prod-type
     2213     ,input  buf_doc-line.prod-code
     2214     ,output v-gds-code
     2215     )  .
     2216             find first buf_doclslib-goods
     2217               where buf_doclslib-goods.gds-code = v-gds-code
     2218               no-error .
     2219             if not available buf_doclslib-goods
     2220             then do:
     2221               create buf_doclslib-goods .
     2222               assign
     2223                 buf_doclslib-goods.gds-code  = v-gds-code
     2224                 buf_doclslib-goods.artic     = buf_doc-line.artic
     2225                 buf_doclslib-goods.prod-type = buf_doc-line.prod-type
     2226                 buf_doclslib-goods.prod-code = buf_doc-line.prod-code
     2227               .
     2228             end.
     2229           end.
     2230         end.
     2231         else do:
     2232           find first buf_price-doc no-lock
     2233             where buf_price-doc.doc-num = buf_doc-list.doc-code
     2234             .
     2235           for each buf_price-list no-lock
     2236             where buf_price-list.doc-num = buf_price-doc.doc-num
     2237           on error undo, return error return-value
     2238           :
     2239   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2241     (input  buf_price-list.artic
     2242     ,input  buf_price-list.prod-type
     2243     ,input  buf_price-list.prod-code
     2244     ,output v-gds-code
     2245     )  .
     2246             find first buf_doclslib-goods
     2247               where buf_doclslib-goods.gds-code = v-gds-code
     2248               no-error .
     2249             if not available buf_doclslib-goods
     2250             then do:
     2251               create buf_doclslib-goods .
     2252               assign
     2253                 buf_doclslib-goods.gds-code  = v-gds-code
     2254                 buf_doclslib-goods.artic     = buf_price-list.artic
     2255                 buf_doclslib-goods.prod-type = buf_price-list.prod-type
     2256                 buf_doclslib-goods.prod-code = buf_price-list.prod-code
     2257               .
     2258             end.
     2259           end.
     2260         end.
     2261       end.
     2262     end.
     2263   end procedure.
     2264   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2265   define temp-table temp-pl-gds no-undo   like ub.pl-gds .
     2266   define temp-table temp-prt-obj no-undo   field prt-code         like ub.prt-obj.prt-code     field price-sale       like ub.prt-obj.price-sale   field fact-qnty        like ub.prt-obj.fact-qnty    field price-list-qnty  like ub.prt-obj.fact-qnty    field is-term          as logical   field prt-obj-recid    as recid     field price-list-recid as recid     index xpk is primary unique prt-code   index xie1 is-term .
     2267   procedure prdoclib-process-goods :
     2268     define input  parameter p-obj-type          as character no-undo .
     2269     define input  parameter p-obj-code          as integer   no-undo .
     2270     define input  parameter p-artic             as character no-undo .
     2271     define input  parameter p-prod-type         as character no-undo .
     2272     define input  parameter p-prod-code         as integer   no-undo .
     2273     define input  parameter p-check-price-list  as logical   no-undo .
     2274     define input  parameter p-check-price-parts as logical   no-undo .
     2275     define input  parameter p-doc-num           as character no-undo .
     2276     define input  parameter p-fact-date         as date      no-undo .
     2277     define input  parameter p-corr-user-db-num  as integer   no-undo .
     2278     define input  parameter p-corr-user-name    as character no-undo .
     2279     define input  parameter p-corr-date         as date      no-undo .
     2280     define input  parameter p-corr-time         as integer   no-undo .
     2281     define input  parameter p-corr-time-str     as character no-undo .
     2282     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
     2283     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
     2284     define buffer buf_gds-obj      for ub.gds-obj .
     2285     define buffer buf_prt-obj      for ub.prt-obj .
     2286     define buffer buf_price-list   for ub.price-list .
     2287     define buffer buf_bar-code     for ub.bar-code .
     2288     define buffer buf_temp-prt-obj for temp-prt-obj .
     2289     define variable v-gds-code             like ub.goods.gds-code    no-undo .
     2290     define variable v-root-node            like ub.prt-obj.prt-code  no-undo .
     2291     define variable v-root-b-code          like ub.bar-code.b-code   no-undo .
     2292     define variable v-total-term-fact-qnty like ub.prt-obj.fact-qnty no-undo .
     2293     define variable v-total-fact-sale      like ub.gds-obj.fact-sale no-undo .
     2294     define variable v-doc-num     like ub.price-list.doc-num    no-undo .
     2295     define variable v-price-sale  like ub.price-list.price-sale no-undo .
     2296     define variable v-road-tax    like ub.price-list.road-tax   no-undo .
     2297     define variable v-excise      like ub.price-list.excise     no-undo .
     2298     do
     2299     on error undo, return error return-value
     2300     :
     2301   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2302   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2303     (input  p-artic
     2304     ,input  p-prod-type
     2305     ,input  p-prod-code
     2306     ,output v-root-node
     2307     )  .
     2308   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2309   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscr in g#library
     2310     (input  p-obj-type
     2311     ,input  p-obj-code
     2312     ,input  p-artic
     2313     ,input  p-prod-type
     2314     ,input  p-prod-code
     2315     ,input  v-root-node
     2316     ,buffer buf_gds-obj
     2317     ,buffer buf_prt-obj
     2318     ) no-error .
     2319       if error-status :error
     2320       then do:
     2321         message
     2322           vss-workfile vss-revision vss-description skip
     2323           vss-include-info8 skip
     2324           "Ошибка при начале товародвижения товара на объекте" skip
     2325           "Объект" p-obj-type p-obj-code skip
