     7617       then do:
     7618         create buf_temp-aht-stk-tot .
     7619         assign
     7620           buf_temp-aht-stk-tot.obj-type   = p-obj-type
     7621           buf_temp-aht-stk-tot.obj-code   = p-obj-code
     7622           buf_temp-aht-stk-tot.sum-type   = v-sum-type
     7623           buf_temp-aht-stk-tot.fact-order = v-day-end-fact-order
     7624         .
     7625       end.
     7626     end.
     7627     for each buf_temp-aht-stk-tot on error undo, return error return-value :
     7628       create buf_aht-stk-tot .
     7629       buffer-copy buf_temp-aht-stk-tot to buf_aht-stk-tot
     7630       .
     7631     end.
     7632     run aht_add-date in this-procedure
     7633       (input p-obj-type
