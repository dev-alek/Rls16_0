     6933       define variable road-tax-base-locoprl          like ub.doc-line.road-tax   no-undo.
     6934       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
     6935       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
