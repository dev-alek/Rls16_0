      608           new-buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
      609           new-buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
      610           new-buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
