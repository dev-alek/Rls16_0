     3040         define variable v-unit-base like ub.goods.unit-base no-undo .
     3041   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3042   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     3043     (input  buf_goods.gds-code
     3044     ,output v-unit-base
     3045     ) no-error .
     3046         if error-status :error
     3047         then do:
     3048           message
     3049             vss-workfile vss-revision vss-description skip
     3050             vss-include-info8 skip
     3051             "Ошибка при определении базовой единицы измерения товара" skip
     3052             "Код товара" buf_goods.gds-code skip
     3053             error-status :get-message(1) skip
     3054             return-value skip
     3055             view-as alert-box error .
     3056           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3057         end.
     3058         for each buf_price-list no-lock
     3059           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     3060             and buf_price-list.main-price = false
     3061             and buf_price-list.artic      = buf_main_price-list.artic
     3062             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     3063             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     3064         :
     3065           if buf_price-list.doc-qnty = ?
     3066           then do:
     3067             find first buf_bar-code no-lock
     3068               where buf_bar-code.b-code = buf_price-list.b-code
     3069               no-error .
     3070             if available buf_bar-code
     3071             and buf_bar-code.unit-cli = v-unit-base
     3072             then do:
     3073               message
     3074                 vss-workfile vss-revision vss-description skip
     3075                 vss-include-info8 skip
     3076                 "Ошибка при закрытии переоценки" skip
     3077                 "Не задано количество для бар-кода с основной единицей измерения" skip
     3078                 "Переоценка" buf_main_price-list.doc-num skip
     3079                 "Бар-код" buf_price-list.b-code skip
     3080                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     3081                 "Количество" buf_price-list.doc-qnty skip
     3082                 "Основная единица измерения" v-unit-base skip
     3083                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     3084                 view-as alert-box error .
     3085               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3086             end.
     3087             next .
     3088           end.
     3089           if not can-find
     3090             (first buf_bar-code
     3091             where buf_bar-code.b-code = buf_price-list.b-code
     3092             )
     3093           then do:
     3094             message
     3095               vss-workfile vss-revision vss-description skip
     3096               vss-include-info8 skip
     3097               "В переоценке задан несуществующий бар-код" skip
     3098               "Переоценка" buf_price-list.doc-num skip
     3099               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     3100               "Бар-код" buf_price-list.b-code skip
     3101               view-as alert-box error .
     3102             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3103           end.
     3104           if buf_price-list.doc-qnty <> 0
     3105           then do:
     3106             run prl-vat in this-procedure
     3107               (input  recid(buf_price-list)
     3108               ,output price-rubl-with-tax-sale-prl
     3109               ,output price-base-with-tax-sale-prl
     3110               ,output price-rubl-without-tax-sale-prl
     3111               ,output price-base-without-tax-sale-prl
     3112               ,output vat-base-sale-prl
     3113               ,output vat-rubl-sale-prl
     3114               ,output vat-base-buyer-prl
     3115               ,output vat-rubl-buyer-prl
     3116               ,output slt-base-sale-prl
     3117               ,output slt-rubl-sale-prl
     3118               ,output road-tax-base-sale-prl
     3119               ,output road-tax-rubl-sale-prl
     3120               ,output excise-base-sale-prl
     3121               ,output excise-rubl-sale-prl
     3122               ,output discnt-base-sale-prl
     3123               ,output discnt-rubl-sale-prl
     3124               ) no-error .
     3125             if error-status :error
     3126             then do:
     3127               message
     3128                 vss-workfile vss-revision vss-description skip
     3129                 vss-include-info8 skip
     3130                 "Ошибка при вызове процеды prl-vat" skip
     3131                 "Документ" buf_price-list.doc-num skip
     3132                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     3133                 error-status :get-message(1) skip
     3134                 return-value skip
     3135                 view-as alert-box error .
     3136               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     3137             end.
     3138           end.
     3139           else do:
     3140             assign
     3141               price-rubl-with-tax-sale-prl    = 0
     3142               price-base-with-tax-sale-prl    = 0
     3143               price-rubl-without-tax-sale-prl = 0
     3144               price-base-without-tax-sale-prl = 0
     3145               vat-base-sale-prl               = 0
     3146               vat-rubl-sale-prl               = 0
     3147               vat-base-buyer-prl              = 0
     3148               vat-rubl-buyer-prl              = 0
     3149               slt-base-sale-prl               = 0
     3150               slt-rubl-sale-prl               = 0
     3151               road-tax-base-sale-prl          = 0
     3152               road-tax-rubl-sale-prl          = 0
     3153               excise-base-sale-prl            = 0
     3154               excise-rubl-sale-prl            = 0
     3155               discnt-base-sale-prl            = 0
     3156               discnt-rubl-sale-prl            = 0
     3157             .
     3158           end.
     3159           if v-curr-r-b = 'base':U
     3160           then do:
     3161             assign
     3162               p-fact-qnty         = p-fact-qnty
