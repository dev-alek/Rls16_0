     1716             (input p-log-handle
     1717             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1718                              ,buf_doc-list.doc-code
     1719                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1720                              ,buf_doc-list.fact-order
     1721                              )
     1722             ) .
     1723           run trg/aht-doc.p
     1724             (input buf_doc-list.doc-code
     1725             ,input p-cut-date
     1726             ).
     1727           run doclslib-log-information in this-procedure
     1728             (input p-log-handle
     1729             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1730                              ,buf_doc-list.doc-code
     1731                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1732                              ,buf_doc-list.fact-order
     1733                              )
     1734             ) .
     1735         end.
     1736         else do:
     1737           run doclslib-log-information in this-procedure
     1738             (input p-log-handle
     1739             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1740                              ,buf_doc-list.doc-code
     1741                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1742                              ,buf_doc-list.fact-order
     1743                              )
     1744             ) .
     1745           run trg/aht-prc.p
     1746             (input buf_doc-list.doc-code
     1747             ,input p-cut-date
     1748             ).
     1749           run doclslib-log-information in this-procedure
     1750             (input p-log-handle
     1751             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1752                              ,buf_doc-list.doc-code
     1753                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1754                              ,buf_doc-list.fact-order
     1755                              )
     1756             ) .
     1757         end.
     1758         if  p-update-recalc  = true
     1759         and v-prev-fact-date <> ?
     1760         and buf_doc-list.fact-date > v-prev-fact-date
     1761         then do:
     1762           run gbl/clntat-w.p
     1763             (input p-obj-type
     1764             ,input p-obj-code
     1765             ,input 'aht-recalc':U
     1766             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1767             ) .
     1768           run doclslib-log-information in this-procedure
     1769             (input p-log-handle
     1770             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1771                              ,string(v-prev-fact-date, '99/99/9999':u)
     1772                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1773                              )
     1774             ) .
     1775         end.
     1776         assign
     1777           v-prev-fact-date = buf_doc-list.fact-date
     1778         .
     1779       end.
     1780     end.
     1781   end procedure.
     1782   procedure doclslib-calc-ahsp :
     1783     define input  parameter p-log-handle    as handle    no-undo .
     1784     define input  parameter p-obj-type      as character no-undo .
     1785     define input  parameter p-obj-code      as integer   no-undo .
     1786     define input  parameter p-cut-date      as date      no-undo .
     1787     define input  parameter p-update-recalc as logical   no-undo .
     1788     define variable v-prev-fact-date as date      no-undo .
     1789     define buffer buf_doc-list for doc-list .
     1790     define buffer stop-ahsp-restore-lock_btpr for ub.batchprocess .
     1791     define buffer stop-ahsp-news-lock_btpr    for ub.batchprocess .
     1792     do
     1793     on error undo, return error return-value
     1794     :
     1795       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1796       run gbl/lockrngd.p
     1797         (input  'grar':U
     1798         ,input  'disable':U
     1799         ,buffer buf_lock_gdsrenart_batchprocess
     1800         ) no-error .
     1801       if error-status :error
     1802       then do:
     1803         if error-status :get-message(1) <> ""
     1804         then do:
     1805           message
     1806             vss-workfile vss-revision vss-description skip
     1807             "Ошибка при блокировании функции переименования артикула товара" skip
     1808             error-status :get-message(1) skip
     1809             return-value skip
     1810             view-as alert-box error .
     1811         end.
     1812         undo, return error return-value .
     1813       end.
     1814       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1815       run gbl/lockrngd.p
     1816         (input  'grgc':U
     1817         ,input  'disable':U
     1818         ,buffer buf_lock_gdsrengc_batchprocess
     1819         ) no-error .
     1820       if error-status :error
     1821       then do:
     1822         if error-status :get-message(1) <> ""
     1823         then do:
     1824           message
     1825             vss-workfile vss-revision vss-description skip
     1826             "Ошибка при блокировании функции переименования кода товара" skip
     1827             error-status :get-message(1) skip
     1828             return-value skip
     1829             view-as alert-box error .
     1830         end.
     1831         undo, return error return-value .
     1832       end.
     1833       for each buf_doc-list
     1834         where buf_doc-list.is-trn-doc = true
     1835       by buf_doc-list.fact-order
     1836       on error undo, return error
     1837       :
     1838         find first stop-ahsp-restore-lock_btpr no-lock
     1839           where stop-ahsp-restore-lock_btpr.bp_type       = 'lock':U + 'rsss':U
     1840             and stop-ahsp-restore-lock_btpr.bp_status     = 'N':U
     1841             and stop-ahsp-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1842             and stop-ahsp-restore-lock_btpr.Key#_Two      = 0
     1843             and stop-ahsp-restore-lock_btpr.Key#_Three    = 0
     1844             and stop-ahsp-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1845             and stop-ahsp-restore-lock_btpr.CharKey_Two   = ""
     1846             and stop-ahsp-restore-lock_btpr.CharKey_Three = ""
     1847           no-error .
     1848         if available stop-ahsp-restore-lock_btpr
     1849         then do:
     1850           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1851         end.
     1852         find first stop-ahsp-news-lock_btpr no-lock
     1853           where stop-ahsp-news-lock_btpr.bp_type       = 'lock':U + 'rssn':U
     1854             and stop-ahsp-news-lock_btpr.bp_status     = 'N':U
     1855             and stop-ahsp-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1856             and stop-ahsp-news-lock_btpr.Key#_Two      = 0
     1857             and stop-ahsp-news-lock_btpr.Key#_Three    = 0
     1858             and stop-ahsp-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1859             and stop-ahsp-news-lock_btpr.CharKey_Three = ""
     1860           no-error .
     1861         if available stop-ahsp-news-lock_btpr
     1862         then do:
     1863           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1864         end.
     1865         run doclslib-log-information in this-procedure
     1866           (input p-log-handle
     1867           ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1868                             ,buf_doc-list.doc-code
     1869                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1870                             ,buf_doc-list.fact-order
     1871                             )
     1872           ) .
     1873         define variable v-need-process as logical   no-undo .
     1874         run trg/ah-csptr.p
     1875           (input  buf_doc-list.doc-code
     1876           ,input  p-cut-date
     1877           ,input  false
     1878           ,output v-need-process
     1879           ).
     1880         run doclslib-log-information in this-procedure
     1881           (input p-log-handle
     1882           ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1883                             ,buf_doc-list.doc-code
     1884                             ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1885                             ,buf_doc-list.fact-order
     1886                             )
     1887           ) .
     1888         if  p-update-recalc  = true
     1889         and v-prev-fact-date <> ?
     1890         and buf_doc-list.fact-date > v-prev-fact-date
     1891         then do:
     1892           run gbl/clntat-w.p
     1893             (input p-obj-type
     1894             ,input p-obj-code
     1895             ,input 'ahsp-recalc':U
     1896             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1897             ) .
     1898           run doclslib-log-information in this-procedure
     1899             (input p-log-handle
     1900             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1901                              ,string(v-prev-fact-date, '99/99/9999':u)
     1902                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1903                              )
     1904             ) .
     1905         end.
     1906         assign
     1907           v-prev-fact-date = buf_doc-list.fact-date
     1908         .
     1909       end.
     1910     end.
     1911   end procedure.
     1912   procedure doclslib-log-information :
     1913     define input  parameter p-log-handle as handle    no-undo .
     1914     define input  parameter p-message    as character no-undo .
     1915     do
     1916     on error undo, return error return-value
     1917     :
     1918       define variable v-log-procedure-name as character no-undo .
     1919       assign
     1920         v-log-procedure-name = "cb-doclslib-log"
     1921       .
     1922       if valid-handle(p-log-handle)
     1923       and p-log-handle :get-signature(v-log-procedure-name) <> ""
     1924       then do:
     1925         run value(v-log-procedure-name) in p-log-handle
     1926           (input p-message
     1927           ) no-error .
     1928       end.
     1929     end.
     1930   end procedure.
     1931   procedure doclslib-find-last-fact-date :
     1932     define output parameter p-last-fact-date  as date      no-undo .
     1933     define output parameter p-reason          as character no-undo .
     1934     do
     1935     on error undo, return error
     1936     :
     1937       define variable v-last-fact-date    as date      no-undo .
     1938       define buffer buf_doc-list for doc-list .
     1939       assign
     1940         v-last-fact-date    = ?
     1941       .
     1942       for each buf_doc-list
     1943       by buf_doc-list.fact-order
     1944       on error undo, return error
     1945       :
     1946         if buf_doc-list.is-archive-exist = false
     1947         or buf_doc-list.fact-date = ?
     1948         then do:
     1949           assign
     1950             p-reason = p-reason + substitute("По документу &1 отсутствует рассчитанный складской архив"
     1951                                             ,buf_doc-list.doc-code
     1952                                             )
     1953           .
     1954           leave .
     1955         end.
     1956         if buf_doc-list.fact-date = ?
     1957         then do:
     1958           assign
     1959             p-reason = p-reason + substitute("Документ &1 имеет не заданную фактическую дату "
     1960                                             ,buf_doc-list.doc-code
     1961                                             )
     1962           .
     1963           leave .
     1964         end.
     1965         if v-last-fact-date = ?
     1966         or (v-last-fact-date <> ?
     1967             and v-last-fact-date < buf_doc-list.fact-date
     1968            )
     1969         then do:
     1970           assign
     1971             v-last-fact-date = buf_doc-list.fact-date
     1972             p-reason         = substitute("Последний рассчитанный документ &1" + chr(10)
     1973                                          ,buf_doc-list.doc-code
     1974                                          )
     1975           .
     1976         end.
     1977       end.
     1978       assign
     1979         p-last-fact-date = v-last-fact-date
     1980       .
     1981     end.
     1982   end procedure.
     1983   procedure doclslib-check-arh-exist :
     1984     define input parameter  p-obj-type       as character no-undo .
     1985     define input parameter  p-obj-code       as integer   no-undo .
     1986     define input parameter  p-cut-fact-order as decimal   no-undo .
     1987     define output parameter p-archive-exist  as logical   no-undo .
     1988     define buffer buf_stk-tot for ub.stk-tot .
     1989     do
     1990     on error undo, return error
     1991     :
     1992       find first buf_stk-tot no-lock
     1993         where buf_stk-tot.obj-type   = p-obj-type
     1994           and buf_stk-tot.obj-code   = p-obj-code
     1995           and buf_stk-tot.fact-order > p-cut-fact-order
     1996         no-error .
     1997       assign
     1998         p-archive-exist = (available buf_stk-tot)
     1999       .
     2000     end.
     2001   end procedure.
     2002   procedure doclslib-check-aht-exist :
     2003     define input parameter  p-obj-type       as character no-undo .
     2004     define input parameter  p-obj-code       as integer   no-undo .
     2005     define input parameter  p-cut-fact-order as decimal   no-undo .
     2006     define output parameter p-archive-exist  as logical   no-undo .
     2007     define buffer buf_aht-stk-tot for ub.aht-stk-tot .
     2008     do
     2009     on error undo, return error
     2010     :
     2011       find first buf_aht-stk-tot no-lock
     2012         where buf_aht-stk-tot.obj-type   = p-obj-type
     2013           and buf_aht-stk-tot.obj-code   = p-obj-code
     2014           and buf_aht-stk-tot.fact-order > p-cut-fact-order
     2015         no-error .
     2016       assign
     2017         p-archive-exist = (available buf_aht-stk-tot)
     2018       .
     2019     end.
     2020   end procedure.
     2021   procedure doclslib-check-ahsp-exist :
     2022     define input parameter  p-obj-type       as character no-undo .
     2023     define input parameter  p-obj-code       as integer   no-undo .
     2024     define input parameter  p-cut-fact-order as decimal   no-undo .
     2025     define output parameter p-archive-exist  as logical   no-undo .
     2026     define buffer buf_stk-supp-tot for ub.stk-supp-tot .
     2027     do
     2028     on error undo, return error
     2029     :
     2030       find first buf_stk-supp-tot no-lock
     2031         where buf_stk-supp-tot.obj-type   = p-obj-type
     2032           and buf_stk-supp-tot.obj-code   = p-obj-code
     2033           and buf_stk-supp-tot.fact-order > p-cut-fact-order
     2034         no-error .
     2035       assign
