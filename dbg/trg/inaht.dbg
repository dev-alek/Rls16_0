     1415   end procedure.
     1416   procedure doclslib-export-doc-list :
     1417     define input  parameter p-obj-type      as character no-undo .
     1418     define input  parameter p-obj-code      as integer no-undo .
     1419     define input  parameter p-log-file-name as character no-undo .
     1420     define input  parameter p-description   as character no-undo .
     1421     define buffer buf_doc-list for doc-list .
     1422     do
     1423     on error undo, return error
     1424     :
     1425       output stream doclsliblog to value(p-log-file-name) .
     1426       export stream doclsliblog "#############################################################" .
     1427       export stream doclsliblog "Список документов" .
     1428       export stream doclsliblog p-description .
     1429       export stream doclsliblog "Объект" p-obj-type p-obj-code .
     1430       export stream doclsliblog "Дата" string(today, '99/99/9999':U) string(time, 'HH:MM:SS':U).
     1431       for each buf_doc-list
     1432       by buf_doc-list.fact-order
     1433       on error undo, return error
     1434       :
     1435         export stream doclsliblog buf_doc-list .
     1436       end.
     1437       export stream doclsliblog "#############################################################" .
     1438       output stream doclsliblog close .
     1439     end.
     1440   end procedure.
     1441   procedure doclslib-clear-batch-process :
     1442     define input parameter p-bp_type like ub.batchprocess.bp_type no-undo .
     1443     define buffer buf_batchprocess        for ub.batchprocess .
     1444     define buffer execdelete_batchprocess for ub.batchprocess .
     1445     define buffer buf_doc-list            for doc-list .
     1446     for each buf_doc-list
     1447     on end-key undo, return error substitute( "doclslib-clear-batch-process. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1448     on error   undo, return error substitute( "doclslib-clear-batch-process. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1449     on stop    undo, return error substitute( "doclslib-clear-batch-process. STOP      &2"
     1450                                    + "bp_type &3&2"
     1451                                    + "Документ &4"
     1452                                    , chr(10)
     1453                                    , p-bp_type
     1454                                    , buf_doc-list.doc-code
     1455                                   )
     1456     :
     1457       find first buf_batchprocess exclusive-lock
     1458         where buf_BatchProcess.BP_Status   = 'N':U
     1459           and buf_batchprocess.bp_type     = p-bp_type
     1460           and buf_batchprocess.charkey_one = buf_doc-list.doc-code
     1461         no-error .
     1462       if available buf_batchprocess
     1463       then do:
     1464         delete buf_batchprocess .
     1465       end.
     1466     end.
     1467   end procedure.
     1468   procedure doclslib-calc-arh :
     1469     define input  parameter p-log-handle     as handle    no-undo .
     1470     define input  parameter p-obj-type       as character no-undo .
     1471     define input  parameter p-obj-code       as integer   no-undo .
     1472     define input  parameter p-cut-date       as date      no-undo .
     1473     define input  parameter p-update-recalc  as logical   no-undo .
     1474     define variable v-prev-fact-date as date      no-undo .
     1475     define buffer buf_doc-list for doc-list .
     1476     define buffer stop-arh-restore-lock_btpr for ub.batchprocess .
     1477     define buffer stop-arh-news-lock_btpr    for ub.batchprocess .
     1478     do
     1479     on stop    undo, return error substitute( "doclslib-calc-arh. stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1480     on end-key undo, return error substitute( "doclslib-calc-arh. end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1481     on error   undo, return error substitute( "doclslib-calc-arh. error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1482     :
     1483       define buffer buf_lock_gdsrenart_batchprocess for ub.batchprocess .
     1484       run gbl/lockrngd.p
     1485         (input  'grar':U
     1486         ,input  'disable':U
     1487         ,buffer buf_lock_gdsrenart_batchprocess
     1488         ) no-error .
     1489       if error-status :error
     1490       then do:
     1491         if error-status :get-message(1) <> ""
     1492         then do:
     1493           message
     1494             vss-workfile vss-revision vss-description skip
     1495             "Ошибка при блокировании функции переименования артикула товара" skip
     1496             error-status :get-message(1) skip
     1497             return-value skip
     1498             view-as alert-box error .
     1499         end.
     1500         undo, return error return-value .
     1501       end.
     1502       define buffer buf_lock_gdsrengc_batchprocess for ub.batchprocess .
     1503       run gbl/lockrngd.p
     1504         (input  'grgc':U
     1505         ,input  'disable':U
     1506         ,buffer buf_lock_gdsrengc_batchprocess
     1507         ) no-error .
     1508       if error-status :error
     1509       then do:
     1510         if error-status :get-message(1) <> ""
     1511         then do:
     1512           message
     1513             vss-workfile vss-revision vss-description skip
     1514             "Ошибка при блокировании функции переименования кода товара" skip
     1515             error-status :get-message(1) skip
     1516             return-value skip
     1517             view-as alert-box error .
     1518         end.
     1519         undo, return error return-value .
     1520       end.
     1521       for each buf_doc-list
     1522       by buf_doc-list.fact-order
     1523       on stop    undo, return error substitute( "f e . stop      &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1524       on end-key undo, return error substitute( "f e . end-key   &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1525       on error   undo, return error substitute( "f e . error     &1&2&3", return-value, chr(10), error-status :get-message ( 1 ) )
     1526       :
     1527         find first stop-arh-restore-lock_btpr no-lock
     1528           where stop-arh-restore-lock_btpr.bp_type       = 'lock':U + 'rsrs':U
     1529             and stop-arh-restore-lock_btpr.bp_status     = 'N':U
     1530             and stop-arh-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1531             and stop-arh-restore-lock_btpr.Key#_Two      = 0
     1532             and stop-arh-restore-lock_btpr.Key#_Three    = 0
     1533             and stop-arh-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1534             and stop-arh-restore-lock_btpr.CharKey_Two   = ""
     1535             and stop-arh-restore-lock_btpr.CharKey_Three = ""
     1536           no-error .
     1537         if available stop-arh-restore-lock_btpr
     1538         then do:
     1539           run doclslib-log-information in this-procedure
     1540             (input p-log-handle
     1541             ,input "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива"
     1542             ) .
     1543           undo, return error "Процедура восстановления складского архива запросила остановку процедуры расчета складского архива" .
     1544         end.
     1545         find first stop-arh-news-lock_btpr no-lock
     1546           where stop-arh-news-lock_btpr.bp_type       = 'lock':U + 'rsrn':U
     1547             and stop-arh-news-lock_btpr.bp_status     = 'N':U
     1548             and stop-arh-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1549             and stop-arh-news-lock_btpr.Key#_Two      = 0
     1550             and stop-arh-news-lock_btpr.Key#_Three    = 0
     1551             and stop-arh-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1552             and stop-arh-news-lock_btpr.CharKey_Three = ""
     1553           no-error .
     1554         if available stop-arh-news-lock_btpr
     1555         then do:
     1556           run doclslib-log-information in this-procedure
     1557             (input p-log-handle
     1558             ,input "Система новостей запросила остановку процедуры расчета складского архива"
     1559             ) .
     1560           undo, return error "Система новостей запросила остановку процедуры расчета складского архива" .
     1561         end.
     1562         if buf_doc-list.is-trn-doc
     1563         then do:
     1564           run doclslib-log-information in this-procedure
     1565             (input p-log-handle
     1566             ,input substitute("Начало расчёта. Документ &1. Факт &2. Номер &3"
     1567                              ,buf_doc-list.doc-code
     1568                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1569                              ,buf_doc-list.fact-order
     1570                              )
     1571             ) .
     1572           run trg/calc-arh.p
     1573             (input buf_doc-list.doc-code
     1574             ,input p-cut-date
     1575             ).
     1576           run doclslib-log-information in this-procedure
     1577             (input p-log-handle
     1578             ,input substitute("Расчёт завершен. Документ &1. Факт &2. Номер &3"
     1579                              ,buf_doc-list.doc-code
     1580                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1581                              ,buf_doc-list.fact-order
     1582                              )
     1583             ) .
     1584         end.
     1585         else do:
     1586           run doclslib-log-information in this-procedure
     1587             (input p-log-handle
     1588             ,input substitute("Начало расчёта. Переоценка &1. Факт &2. Номер &3"
     1589                              ,buf_doc-list.doc-code
     1590                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1591                              ,buf_doc-list.fact-order
     1592                              )
     1593             ) .
     1594           run trg/calc-apc.p
     1595             (input buf_doc-list.doc-code
     1596             ,input p-cut-date
     1597             ).
     1598           run doclslib-log-information in this-procedure
     1599             (input p-log-handle
     1600             ,input substitute("Расчёт завершен. Переоценка &1. Факт &2. Номер &3"
     1601                              ,buf_doc-list.doc-code
     1602                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1603                              ,buf_doc-list.fact-order
     1604                              )
     1605             ) .
     1606         end.
     1607         if  p-update-recalc  = true
     1608         and v-prev-fact-date <> ?
     1609         and buf_doc-list.fact-date > v-prev-fact-date
     1610         then do:
     1611           run gbl/clntat-w.p
     1612             (input p-obj-type
     1613             ,input p-obj-code
     1614             ,input 'arh-recalc':U
     1615             ,input string(buf_doc-list.fact-date, '99/99/9999':U)
     1616             ) .
     1617           run doclslib-log-information in this-procedure
     1618             (input p-log-handle
     1619             ,input substitute("Завершён расчет дня &1. Устанавливается дата перерасчёта &2"
     1620                              ,string(v-prev-fact-date, '99/99/9999':u)
     1621                              ,string(buf_doc-list.fact-date, '99/99/9999':u)
     1622                              )
     1623             ) .
     1624         end.
     1625         assign
     1626           v-prev-fact-date = buf_doc-list.fact-date
     1627         .
     1628       end.
     1629     end.
     1630   end procedure.
     1631   procedure doclslib-calc-aht :
     1632     define input  parameter p-log-handle    as handle    no-undo .
     1633     define input  parameter p-obj-type      as character no-undo .
     1634     define input  parameter p-obj-code      as integer   no-undo .
     1635     define input  parameter p-cut-date      as date      no-undo .
     1636     define input  parameter p-update-recalc as logical   no-undo .
     1637     define variable v-prev-fact-date as date      no-undo .
     1638     define buffer buf_doc-list for doc-list .
     1639     define buffer stop-aht-restore-lock_btpr for ub.batchprocess .
     1640     define buffer stop-aht-news-lock_btpr    for ub.batchprocess .
     1641     do
