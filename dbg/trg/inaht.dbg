     1675             "Ошибка при блокировании функции переименования кода товара" skip
     1676             error-status :get-message(1) skip
     1677             return-value skip
     1678             view-as alert-box error .
     1679         end.
     1680         undo, return error return-value .
     1681       end.
     1682       for each buf_doc-list
     1683       by buf_doc-list.fact-order
     1684       on error undo, return error
     1685       :
     1686         find first stop-aht-restore-lock_btpr no-lock
     1687           where stop-aht-restore-lock_btpr.bp_type       = 'lock':U + 'rsts':U
     1688             and stop-aht-restore-lock_btpr.bp_status     = 'N':U
     1689             and stop-aht-restore-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1690             and stop-aht-restore-lock_btpr.Key#_Two      = 0
     1691             and stop-aht-restore-lock_btpr.Key#_Three    = 0
     1692             and stop-aht-restore-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1693             and stop-aht-restore-lock_btpr.CharKey_Two   = ""
     1694             and stop-aht-restore-lock_btpr.CharKey_Three = ""
     1695           no-error .
     1696         if available stop-aht-restore-lock_btpr
     1697         then do:
     1698           undo, return error "Процедура восстановления складского архива запросила остановку процедуры автоматического расчета складского архива" .
     1699         end.
     1700         find first stop-aht-news-lock_btpr no-lock
     1701           where stop-aht-news-lock_btpr.bp_type       = 'lock':U + 'rstn':U
     1702             and stop-aht-news-lock_btpr.bp_status     = 'N':U
     1703             and stop-aht-news-lock_btpr.Key#_One      = buf_doc-list.obj-code
     1704             and stop-aht-news-lock_btpr.Key#_Two      = 0
     1705             and stop-aht-news-lock_btpr.Key#_Three    = 0
     1706             and stop-aht-news-lock_btpr.CharKey_One   = buf_doc-list.obj-type
     1707             and stop-aht-news-lock_btpr.CharKey_Three = ""
     1708           no-error .
     1709         if available stop-aht-news-lock_btpr
     1710         then do:
     1711           undo, return error "Система новостей запросила остановку процедуры автоматического расчета складского архива" .
     1712         end.
     1713         if buf_doc-list.is-trn-doc
     1714         then do:
