     8132   procedure clear-tot :
     8133     define buffer buf_temp-aht-stk-tot for temp-aht-stk-tot .
     8134     do on error undo, return error return-value :
     8135       for each buf_temp-aht-stk-tot on error undo, return error return-value :
     8136         delete buf_temp-aht-stk-tot .
     8137       end.
     8138     end.
     8139   end procedure.
     8140   procedure clear-line :
     8141     define buffer buf_temp-aht-stk-line      for temp-aht-stk-line .
