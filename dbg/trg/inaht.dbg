     2738   procedure prdoclib-create-temp-prt-obj :
     2739     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2740     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2741     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2742     define buffer buf_gds-prt for ub.gds-prt .
