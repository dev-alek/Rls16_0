        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.clients  OLD old-clients.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись клиента".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2', ub.clients.obj-type, ub.clients.obj-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cli-grplib-get-full-name :
       83      define input parameter  p-node-code  as integer      no-undo.
       84      define output parameter p-full-name as character    no-undo.
       85   do
       86   on error undo, return error
       87   :
       88       define variable v-upper-code    as integer           no-undo.
       89       define buffer buf_cli-grp       for ub.cli-grp.
       90       define buffer buf_upper_cli-grp for ub.cli-grp.
       91       find first buf_cli-grp no-lock
       92            where buf_cli-grp.node-code = p-node-code
       93       no-error.
       94       if not available buf_cli-grp
       95       then do:
       96           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
       97       end.
       98       assign
       99           p-full-name  = ""
      100           v-upper-code = 1
      101       .
      102       do while buf_cli-grp.upper-code <> 0
      103       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      104       :
      105           assign
      106               p-full-name  = buf_cli-grp.node-name
      107                            + (if p-full-name <> "" then chr(47) else "")
      108                            + p-full-name
      109               v-upper-code = buf_cli-grp.upper-code
      110           .
      111           find first buf_cli-grp no-lock
      112                where buf_cli-grp.node-code = v-upper-code
      113           no-error.
      114           if not available buf_cli-grp
      115           then do:
      116               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      117                                   + string( v-upper-code )
      118                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      119           end.
      120       end.
      121       assign
      122       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      123       .
      124   end.
      125   end .
      126   procedure cgrplib-get-node-from-full-name :
      127   define input parameter p-full-name as character no-undo .
      128   define output parameter p-node-code as integer no-undo .
      129   define variable v-ii as integer no-undo .
      130   define variable v-upper-code as integer no-undo .
      131   define variable v-root-code as integer no-undo .
      132   define variable v-entry as character no-undo .
      133   define buffer buf_cli-grp       for ub.cli-grp.
      134   do
      135   on error undo, return error
      136   :
      137     find first buf_cli-grp no-lock
      138         where buf_cli-grp.upper-code = 0
      139     no-error .
      140     if not available buf_cli-grp
      141     then do:
      142         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      143     end.
      144     else do:
      145       assign
      146       v-root-code = buf_cli-grp.node-code
      147       .
      148     end.
      149     v-upper-code = v-root-code.
      150     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      151       assign
      152       v-entry = entry(v-ii, p-full-name, chr(47)).
      153       if v-entry = '' then leave.
      154       find first buf_cli-grp no-lock where
      155                 buf_cli-grp.node-name = v-entry
      156             and buf_cli-grp.upper-code = v-upper-code
      157             no-error.
      158       if not available buf_cli-grp then do:
      159         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      160       end.
      161       else do:
      162         p-node-code = buf_cli-grp.node-code.
      163         v-upper-code = buf_cli-grp.node-code.
      164       end.
      165     end.
      166   end.
      167   end .
      168   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   procedure cur-time :
      170      define output parameter p-today as date      no-undo .
      171      define output parameter p-time  as integer   no-undo .
      172     do
      173     on error undo, return error
      174     :
      175       define variable v-date1 as date      no-undo .
      176       define variable v-date2 as date      no-undo .
      177       define variable v-time  as integer   no-undo .
      178       assign
      179         v-date1 = today
      180         v-time  = time
      181         v-date2 = today
      182       .
      183       if v-date1 <> v-date2
      184       then do:
      185         assign
      186           v-date1 = today
      187           v-time  = v-time
      188         .
      189       end.
      190       assign
      191         p-today = v-date1
      192         p-time  = v-time
      193       .
      194     end.
      195   end.
      196   function cur-time-date returns character
      197   :
      198     return string(today, '99/99/9999':U) .
      199   end.
      200   function cur-time-mjd returns decimal
      201   :
      202     define variable v-date as date      no-undo .
      203     define variable v-time as integer   no-undo .
      204     run cur-time in this-procedure
      205       (output v-date
      206       ,output v-time
      207       ) .
      208     return integer(v-date) - 2400002 + (v-time / 86400) .
      209   end.
      210   function cur-time-get-ending-index returns integer
      211   (input p-number as integer
      212   )
      213   :
      214     if p-number < 0
      215     or p-number = ?
      216     then do:
      217       return 1 .
      218     end.
      219     define variable v-rest as integer   no-undo .
      220     assign
      221       p-number = p-number modulo 100
      222     .
      223     if p-number < 20
      224     then do:
      225       assign
      226         v-rest = p-number
      227       .
      228     end.
      229     else do:
      230       assign
      231         v-rest = p-number modulo 10
      232       .
      233     end.
      234     case v-rest :
      235       when 1
      236       then do:
      237         return 2 .
      238       end.
      239       when 2 or
      240       when 3 or
      241       when 4
      242       then do:
      243         return 3 .
      244       end.
      245       otherwise do:
      246         return 1 .
      247       end.
      248     end case .
      249   end.
      250   procedure cur-time-mjd-to-date :
      251      define input  parameter i-mjd-diff as decimal no-undo.
      252      define output parameter o-Date     as date    no-undo.
      253      define output parameter o-Time     as integer no-undo.
      254      define variable v-day-number as integer   no-undo .
      255      if    i-mjd-diff < 0
      256         or i-mjd-diff = ?
      257      then do:
      258         return "?" .
      259      end.
      260      assign
      261         v-day-number = truncate(i-mjd-diff,0).
      262         o-Date = date(v-day-number + 2400002).
      263         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      264     .
      265   end.
      266   function cur-time-mjd-to-string returns character
      267   (input p-mjd-diff as decimal
      268   )
      269   :
      270     define variable v-day-number as integer   no-undo .
      271     define variable v-seconds    as integer   no-undo .
      272     define variable v-hour       as integer   no-undo .
      273     define variable v-min        as integer   no-undo .
      274     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      275     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      276     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      277     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      278     if p-mjd-diff < 0
      279     or p-mjd-diff = ?
      280     then do:
      281       return "?" .
      282     end.
      283     assign
      284       v-day-number = integer(truncate(p-mjd-diff,0))
      285       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      286     .
      287     if v-seconds > 86400
      288     then do:
      289       assign
      290         v-seconds = 86400 - 1
      291       .
      292     end.
      293     if v-seconds < 0
      294     then do:
      295       assign
      296         v-seconds = 0
      297       .
      298     end.
      299     assign
      300       v-hour = truncate(v-seconds / 3600, 0)
      301     .
      302     assign
      303       v-seconds = v-seconds modulo 3600
      304     .
      305     assign
      306       v-min = truncate(v-seconds / 60, 0)
      307     .
      308     assign
      309       v-seconds = v-seconds modulo 60
      310     .
      311     return
      312         (if v-day-number <> 0
      313           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      314           else ""
      315         )
      316       + (if v-day-number <> 0 or v-hour <> 0
      317           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      318           else ""
      319         )
      320       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      321           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      322           else ""
      323         )
      324       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      325       .
      326   end.
      327   function cur-time-string returns character
      328   :
      329     define variable v-date as date      no-undo .
      330     define variable v-time as integer   no-undo .
      331     run cur-time in this-procedure
      332       (output v-date
      333       ,output v-time
      334       ) .
      335     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      336   end.
      337   function cur-time-string-sec returns character
      338   :
      339     define variable v-date as date      no-undo .
      340     define variable v-time as integer   no-undo .
      341     run cur-time in this-procedure
      342       (output v-date
      343       ,output v-time
      344       ) .
      345     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      346   end.
      347   function cur-time-custom  returns character
      348   (input p-prefix as character
      349   ,input p-date-format as character
      350   ,input p-delimiter as character
      351   ,input p-time-format as character
      352   ,input p-suffix as character
      353   )
      354   :
      355     define variable v-date as date      no-undo .
      356     define variable v-time as integer   no-undo .
      357     run cur-time in this-procedure
      358       (output v-date
      359       ,output v-time
      360       ) .
      361     return
      362       p-prefix
      363       + string(v-date, p-date-format)
      364       + p-delimiter
      365       + string(v-time, p-time-format)
      366       + p-suffix
      367       .
      368   end.
      369   function cur-time-print  returns character
      370   :
      371     define variable v-date as date      no-undo .
      372     define variable v-time as integer   no-undo .
      373     run cur-time in this-procedure
      374       (output v-date
      375       ,output v-time
      376       ) .
      377     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      378   end.
      379   function cur-time-datetime returns datetime
      380   :
      381     define variable v-char as character no-undo .
      382     define variable v-datetime as datetime no-undo .
      383     v-char = cur-time-string().
      384     v-datetime = datetime(v-char).
      385     return  v-datetime.
      386   end.
      387   function cur-time-string-msec returns character
      388   :
      389     define variable v-date as datetime  no-undo .
      390     v-date = now.
      391     return string(v-date) .
      392   end.
      393   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   define new global shared variable g#lib-nws as handle no-undo .
      396   procedure clientsh_write-clients-trigger :
      397   define input parameter p-new-record as logical no-undo .
      398   define input parameter p-source-type like ub.c-cli-hist.source-type no-undo .
      399   define input parameter p-source-ref  like ub.c-cli-hist.source-ref no-undo .
      400   define variable v-date as date      no-undo.
      401   define variable v-time  as integer   no-undo.
      402   define buffer buf_c-cli-hist for ub.c-cli-hist.
      403   define buffer buf_c-clients for ub.c-clients.
      404     do
      405     on error undo, return error
      406     :
      407       if g#news then do:
      408         define variable v-send as integer no-undo .
      409         define variable v-subject as character no-undo .
      410         case old-clients.obj-type:
      411           when 'орг':U then v-subject =  'firm':U.
      412           when 'чел':U then v-subject =  'person':U.
      413           when 'маг':U then v-subject =  'shop':U.
      414           when 'скл':U then v-subject =  'store':U.
      415         end case.
      416         v-send = integer('0':U).
      417   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      418   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      419     (input  g#db-num
      420     ,input  v-subject
      421     ,input  0
      422     ,input  '':U
      423     ,input  0
      424     ,input  '':U
      425     ,input  '':U
      426     ,input  '':U
      427     ,input  0
      428     ,input  0
      429     ,input  0
      430     ,input  'nws-to-hist'
      431     ,output v-send
      432     ) no-error .
      433         if v-send < 0 then return.
      434       end.
      435       run cur-time in this-procedure(output v-date, output v-time).
      436       create buf_c-clients.
      437       buffer-copy old-clients to buf_c-clients
      438       assign
      439       buf_c-clients.obj-code           = ub.clients.obj-code
      440       buf_c-clients.obj-type           = ub.clients.obj-type
      441       buf_c-clients.chip-num           = next-value (s-cli-chip, ub)
      442       buf_c-clients.corr-time          = v-time
      443       buf_c-clients.corr-user-db-num   = g#db-num
      444       buf_c-clients.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) else g#userid)
      445       buf_c-clients.corr-date          = v-date
      446       .
      447       create buf_c-cli-hist.
      448       buffer-copy buf_c-clients to buf_c-cli-hist
      449       assign
      450       buf_c-cli-hist.action =  (if p-new-record
      451                                 then integer('1':U)
      452                                 else integer('2':U))
      453       buf_c-cli-hist.subject = 'clients':U
      454       buf_c-cli-hist.host-code = (if ub.clients.obj-type = 'орг':U
      455                                   and
      456                                   can-find(first ub.sysconf no-lock where
      457                                                     ub.sysconf.host-code = ub.clients.obj-code)
      458                                   then ub.clients.obj-code
      459                                   else 0)
      460       buf_c-cli-hist.is-news = g#news
      461       buf_c-cli-hist.source-type = p-source-type
      462       buf_c-cli-hist.source-ref = p-source-ref
      463       .
      464       release buf_c-clients no-error .
      465       if error-status:error then do:
      466         undo , return error return-value .
      467       end.
      468       release buf_c-cli-hist no-error .
      469       if error-status:error then do:
      470         undo , return error return-value .
      471       end.
      472     end.
      473   end procedure.
