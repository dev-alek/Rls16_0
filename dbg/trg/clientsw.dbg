      643   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      645                                                       ,input p-range-type as character
      646                                                       ,input p-code as integer):
      647   define variable v-seq-val as integer no-undo .
      648   define buffer buf_code-range for ub.code-range.
      649   find first buf_code-range no-lock where
      650             buf_code-range.db-num = p-db-num
      651       and  buf_code-range.range-type = p-range-type
      652       and  buf_code-range.stts = 'u'
      653       and buf_code-range.first-code <= p-code
      654       and buf_code-range.last-code >= p-code no-error .
      655   if available buf_code-range then return yes.
      656   CASE p-range-type:
      657     when 'pngb':U then do:
      658       v-seq-val = current-value(s-pngb-code, ub).
      659     end.
      660     when 'fmgb':U then do:
      661       v-seq-val = current-value(s-fmgb-code, ub).
      662     end.
      663   END CASE.
      664   if p-code <= v-seq-val then do:
      665     find first buf_code-range no-lock where
      666               buf_code-range.db-num = p-db-num
      667         and  buf_code-range.range-type = p-range-type
      668         and  buf_code-range.stts = 'a'
      669         and buf_code-range.first-code <= p-code
      670         no-error .
      671    if available buf_code-range then return yes.
      672   end.
      673   find first buf_code-range no-lock where
      674             buf_code-range.db-num = p-db-num
      675       and  buf_code-range.range-type = p-range-type
      676       and  buf_code-range.stts = 'f'
      677       and buf_code-range.first-code <= p-code
      678       and buf_code-range.last-code >= p-code
      679       no-error .
      680   if available buf_code-range then return yes.
      681   return no.
      682   END FUNCTION.
      683   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      684                                                       ,input p-range-type as character
      685                                                       ,input p-code as integer):
      686   define variable v-seq-val as integer no-undo .
      687   define buffer buf_code-range for ub.code-range.
      688   CASE p-range-type:
      689     when 'pngb':U then do:
      690       v-seq-val = current-value(s-pngb-code, ub).
      691     end.
      692     when 'fmgb':U then do:
      693       v-seq-val = current-value(s-fmgb-code, ub).
      694     end.
      695   END CASE.
      696   if p-code <= v-seq-val then do:
      697     find first buf_code-range no-lock where
      698               buf_code-range.db-num = p-db-num
      699         and  buf_code-range.range-type = p-range-type
      700         and buf_code-range.first-code <= p-code
      701         and buf_code-range.last-code >= p-code no-error .
      702     if available buf_code-range then return yes.
      703   end.
      704   return no.
      705   END FUNCTION.
      706   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      707                                                       ,input p-db-num as integer
      708                                                       ,input p-staff-code as integer
      709                                                       ,input p-date as date
      710                                                        ):
      711   define buffer buf_staff for ub.staff.
      712   if p-date = ? then do:
      713     p-date = today .
      714   end.
      715   find first buf_staff no-lock where
      716             buf_staff.role = p-role
      717         and buf_staff.role-level = 'db':U
      718         and buf_staff.db-num = p-db-num
      719         and buf_staff.staff-code = p-staff-code
      720         and buf_staff.date-end >= p-date use-index pi  no-error .
      721   if available buf_staff then do:
      722     return buf_staff.psn-code.
      723   end.
      724   return 0.
      725   end FUNCTION.
      726   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      727                                                             ,input p-db-num as integer
      728                                                             ,input p-date as date
      729                                                                 ):
      730   define buffer buf_staff for ub.staff.
      731   define buffer buf2_staff for ub.staff.
      732   if p-date = ? then do:
      733     p-date = today .
      734   end.
      735   for each  buf_staff no-lock where
      736             buf_staff.role = p-role
      737         and buf_staff.db-num = p-db-num,
      738   first buf2_staff no-lock where
      739         buf2_staff.role = p-role
      740     and buf2_staff.role-level = 'db':U
      741     and buf2_staff.staff-code = buf_staff.staff-code
      742     and buf2_staff.date-start <= p-date
      743     and buf2_staff.date-end >= p-date
      744   by buf_staff.staff-code
      745   by date-start descending:
      746     return buf_staff.staff-code.
      747   end.
      748   end FUNCTION.
      749   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      750                                                  ,input p-db-num as integer
      751                                                  ,input p-psn-code as integer
      752                                                  ,input p-date as date
      753                                                  ,output p-c-password as character
      754                                                        ):
      755   define buffer buf_staff for ub.staff.
      756   if p-date = ? then do:
      757     p-date = today .
      758   end.
      759   find first buf_staff no-lock where
      760             buf_staff.role = p-role
      761         and buf_staff.role-level = 'db':U
      762         and buf_staff.db-num = p-db-num
      763        and buf_staff.date-end >= p-date
      764        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      765   if available buf_staff
      766   then do:
      767     assign
      768     p-c-password = buf_staff.password.
      769     return buf_staff.staff-code.
      770   end.
      771   p-c-password = ''.
      772   return 0.
      773   end FUNCTION.
      774   FUNCTION gbclcode-is-psn-role returns integer (
      775                                                 input p-role as character
      776                                                 ,input p-psn-code as integer
      777                                                 ,input p-date as date
      778                                                     ):
      779   define buffer buf_staff for ub.staff.
      780   if p-date = ? then do:
      781     p-date = today .
      782   end.
      783   for each buf_staff no-lock where
      784             buf_staff.psn-code = p-psn-code
      785        and  buf_staff.role = p-role
      786   by buf_staff.role-level
      787   by buf_staff.date-start
      788        :
      789     if  buf_staff.date-start <= p-date and
      790     buf_staff.date-end >= p-date  then do:
      791       return buf_staff.staff-code.
      792     end.
      793   end.
      794   return 0.
      795   end FUNCTION.
      796   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      797   define variable v-role-name as character no-undo .
      798   assign
      799   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      800   no-error .
      801   return v-role-name.
      802   END.
      803   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   FUNCTION gbclcode-get-position returns character ( input p-role as character
      805                                                     ,input p-role-level as character
      806                                                     ,input p-work-place as character
      807                                                     ,input p-staff-code as integer
      808                                                                ):
      809   define variable v-role-name as character no-undo .
      810   define variable v-role-level as character no-undo .
      811   define variable v-staff-code as integer no-undo .
      812   assign
      813   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      814   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      815   v-staff-code = p-staff-code
      816   no-error .
      817   return substitute("&1, &2, Код &3"
      818                   ,v-role-name
      819                   ,v-role-level
      820                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      821   END.
      822   FUNCTION gbclcode-get-work-place returns character (
      823                                                   input p-role as character
      824                                                  ,input p-role-level as character
      825                                                  ,input p-db-num as integer
      826                                                  ,input p-host-code as integer
      827                                                  ,input p-obj-type as character
      828                                                  ,input p-obj-code as integer
      829                                                  ) :
      830   define variable v-work-place as character no-undo .
      831   define variable v-obj-type as character no-undo .
      832     case p-role-level:
      833       when 'db':U then do:
      834         v-work-place = string(p-db-num, "99999").
      835       end.
      836       when 'firm':U then do:
      837         v-work-place = string(p-host-code, "99999").
      838       end.
      839       when 'object':U then do:
      840         assign
      841         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      842         .
      843       end.
      844     END CASE.
      845     return v-work-place.
      846   END FUNCTION.
      847   FUNCTION gbclcode-get-level-last-code returns integer (
      848                                                           input p-role as character
      849                                                         , input p-role-level as character
      850                                                         , input p-work-place as character
      851                                                         , input p-date-start as date
      852                                                         ):
      853   DEFINE VARIABLE v-today as date no-undo .
      854   define buffer buf_staff for ub.staff.
      855   if p-work-place = chr(63) then return ?.
      856   if p-date-start = ? then do:
      857     v-today = today .
      858   end.
      859   else do:
      860     v-today = p-date-start.
      861   end.
      862   find last buf_staff no-lock where
      863             buf_staff.role = p-role
      864        and  buf_staff.role-level = p-role-level
      865        and  buf_staff.work-place = p-work-place
      866        and  buf_staff.date-start <= v-today + 1
      867        and  buf_staff.date-end >= v-today + 1
      868        use-index pi  no-error .
      869   if available buf_staff
      870   then return buf_staff.staff-code.
      871   return 0.
      872   end FUNCTION.
      873   define variable g-name         as char      format "x(30)" no-undo .
      874   DEFINE VARIABLE conf-par       as character no-undo .
      875   DEFINE VARIABLE par-type       as character no-undo .
      876   DEFINE VARIABLE v-l-chr        as character no-undo .
      877   define variable v-date         as date      no-undo.
      878   define variable v-time         as integer   no-undo.
      879   define variable v-seller-code  as integer   no-undo .
      880   define variable v-cashier-code as integer   no-undo .
      881   define variable v-password     as character no-undo .
      882   define variable v-trg-param    as character no-undo .
      883   assign
      884       v-trg-param          = ub.clients.trg-param
      885       ub.clients.trg-param = '':U
      886       .
      887   define buffer buf_dis-card for ub.dis-card.
      888   define buffer buf_person   for ub.person.
      889   define buffer buf_sysconf  for ub.sysconf.
      890   define buffer buf_shop     for ub.shop.
      891   define buffer buf_store    for ub.store.
      892   main-block:
      893   do
      894       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      895       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      896       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      897       :
      898       if not new(ub.clients) then
      899       do:
      900           if ub.clients.obj-type <> old-clients.obj-type
      901               or ub.clients.obj-code <> old-clients.obj-code then
      902           do:
      903               message
      904                   vss-workfile vss-revision vss-description skip
      905                   "Нельзя поменять тип или код клиента" skip
      906                   "ub.clients.obj-type" ub.clients.obj-type skip
      907                   "ub.clients.obj-code" ub.clients.obj-code skip
      908                   "old-clients.obj-type" old-clients.obj-type skip
      909                   "old-clients.obj-code" old-clients.obj-code skip
      910                   view-as alert-box error .
      911               undo main-block, return error .
      912           end.
      913       end.
      914       else
      915       do:
      916           if  ub.clients.obj-type <> 'скл':U
      917               and ub.clients.obj-type <> 'маг':U
      918               and ub.clients.obj-type <> 'орг':U
      919               and ub.clients.obj-type <> 'чел':U
      920               then
      921           do:
      922               message
      923                   vss-workfile vss-revision vss-description skip
      924                   "Неизвестный тип клиента" skip
      925                   "ub.clients.obj-type" ub.clients.obj-type skip
      926                   view-as alert-box error .
      927               undo main-block, return error .
      928           end.
      929           if ub.clients.obj-code = ? then
      930           do:
      931               message
      932                   vss-workfile vss-revision vss-description skip
      933                   "Не задан код клиента" skip
      934                   "ub.clients.obj-code" ub.clients.obj-code skip
      935                   view-as alert-box error .
      936               undo main-block, return error .
      937           end.
      938           if ub.clients.obj-code = 0 then
      939           do:
      940               message
      941                   vss-workfile vss-revision vss-description skip
      942                   "Не задан код клиента" skip
      943                   "ub.clients.obj-code" ub.clients.obj-code skip
      944                   view-as alert-box error .
      945               undo main-block, return error .
      946           end.
      947       end.
      948       if ub.clients.obj-type = 'скл':U
      949           or ub.clients.obj-type = 'маг':U
      950           then
      951       do:
      952           find first ub.db no-lock
      953               where ub.db.db-num = ub.clients.db-num
      954               no-error .
      955           if not available ub.db then
      956           do:
      957               message
      958                   vss-workfile vss-revision vss-description skip
      959                   "Неправильная ссылка на базу данных" skip
      960                   "Клиент" ub.clients.obj-type ub.clients.obj-code skip
      961                   "База данных" ub.clients.db-num skip
      962                   view-as alert-box error .
      963               undo, return error .
      964           end.
      965           if new(ub.clients)
      966               then
      967           do:
      968               define variable v-attr-arh-disable-chr   as character no-undo .
      969               define variable v-attr-arh-disable-type  as character no-undo .
      970               define variable v-attr-arh-disable       as logical   no-undo .
      971               define variable v-attr-ahsp-disable-chr  as character no-undo .
      972               define variable v-attr-ahsp-disable-type as character no-undo .
      973               define variable v-attr-ahsp-disable      as logical   no-undo .
      974               define variable v-attr-aht-disable-chr   as character no-undo .
      975               define variable v-attr-aht-disable-type  as character no-undo .
      976               define variable v-attr-aht-disable       as logical   no-undo .
      977               run db-attr-value in this-procedure
      978                   (input  ub.clients.db-num
      979                   ,input  'arh-disable':U
      980                   ,output v-attr-arh-disable-chr
      981                   ,output v-attr-arh-disable-type
      982                   ) .
      983               assign
      984                   v-attr-arh-disable = lookup(v-attr-arh-disable-chr, 'yes,true':u) > 0
      985                   .
      986               if v-attr-arh-disable = true
      987                   then
      988               do:
      989                   run trg/ahobjdis.p
      990                       (input  'arh':U
      991                       ,input  ub.clients.obj-type
      992                       ,input  ub.clients.obj-code
      993                       ,input  true
      994                       ) .
      995               end.
      996               run db-attr-value in this-procedure
      997                   (input  ub.clients.db-num
      998                   ,input  'ahsp-disable':U
      999                   ,output v-attr-ahsp-disable-chr
     1000                   ,output v-attr-ahsp-disable-type
     1001                   ) .
     1002               assign
     1003                   v-attr-ahsp-disable = lookup(v-attr-arh-disable-chr, 'yes,true':u) > 0
     1004                   .
     1005               if v-attr-ahsp-disable = true
     1006                   then
     1007               do:
     1008                   run trg/ahobjdis.p
     1009                       (input  'ahsp':U
     1010                       ,input  ub.clients.obj-type
     1011                       ,input  ub.clients.obj-code
     1012                       ,input  true
     1013                       ) .
     1014               end.
     1015               run db-attr-value in this-procedure
     1016                   (input  ub.clients.db-num
     1017                   ,input  'ahsp-disable':U
     1018                   ,output v-attr-aht-disable-chr
     1019                   ,output v-attr-aht-disable-type
     1020                   ) .
     1021               assign
     1022                   v-attr-aht-disable = lookup(v-attr-arh-disable-chr, 'yes,true':u) > 0
     1023                   .
     1024               if v-attr-aht-disable = true
     1025                   then
     1026               do:
     1027                   run trg/ahobjdis.p
     1028                       (input  'aht':U
     1029                       ,input  ub.clients.obj-type
     1030                       ,input  ub.clients.obj-code
     1031                       ,input  true
     1032                       ) .
     1033               end.
     1034           end.
     1035           if not new(ub.clients) then
     1036           do:
     1037               if ub.clients.obj-type = 'маг':U then
     1038               do:
     1039                   find first buf_shop no-lock where
     1040                       buf_shop.obj-code = ub.clients.obj-code .
     1041                   find first buf_sysconf no-lock where
     1042                       buf_sysconf.host-code = buf_shop.host-code.
     1043               end.
     1044               else
     1045               do:
     1046                   find first buf_store no-lock where
     1047                       buf_store.obj-code = ub.clients.obj-code .
     1048                   find first buf_sysconf no-lock where
     1049                       buf_sysconf.host-code = buf_store.host-code.
     1050               end.
     1051               if buf_sysconf.firm-db-num <> 0 AND
     1052                   ub.clients.db-num <> 0 then
     1053               do:
     1054                   message
     1055                       vss-workfile vss-revision vss-description skip
     1056                       "Главная БД фирмы не совпадает с БД, к которой относится объект" skip
     1057                       view-as alert-box error .
     1058                   undo main-block, return error.
     1059               end.
     1060           end.
     1061           if not new(ub.clients) then
     1062           do:
     1063               if ub.clients.db-num <> old-clients.db-num then
     1064               do:
     1065                   run trg/objchk.p
     1066                       (input ub.clients.obj-type
     1067                       ,input ub.clients.obj-code
     1068                       ,input "check-open":u
     1069                       ) no-error .
     1070                   if error-status :error then
     1071                   do:
     1072                       message
     1073                           vss-workfile vss-revision vss-description skip
     1074                           "Нельзя переносить объект из одной удаленной БД в другую удаленную" skip
     1075                           "Не прошла проверка отсутствия открытых документов" skip
     1076                           "Клиент" ub.clients.obj-type ub.clients.obj-code skip
     1077                           "Новая база данных" ub.clients.db-num skip
     1078                           "Старая база данных" old-clients.db-num skip
     1079                           error-status :get-message(1) skip
     1080                           return-value skip
     1081                           view-as alert-box error .
     1082                       undo, return error .
     1083                   end.
     1084               end.
     1085           end.
     1086       end.
     1087       else
     1088       do:
     1089           if ub.clients.db-num <> ? then
     1090           do:
     1091               message
     1092                   vss-workfile vss-revision vss-description skip
     1093                   "Клиент не может принадлежать какой либо базе данных" skip
     1094                   "Поле база данных должно иметь неопределенное значение" skip
     1095                   "Клиент" ub.clients.obj-type ub.clients.obj-code skip
     1096                   "База данных" ub.clients.db-num skip
     1097                   view-as alert-box error .
     1098               undo, return error .
     1099           end.
     1100       end.
     1101       if ub.clients.grp-code = ? then
     1102       do:
     1103           message
     1104               vss-workfile vss-revision vss-description skip
     1105               "Должна быть задана группа клиентов" skip
     1106               "Клиент" ub.clients.obj-type ub.clients.obj-code skip
     1107               view-as alert-box error .
     1108           undo, return error .
     1109       end.
     1110       find first ub.cli-grp no-lock
     1111           where ub.cli-grp.node-code = clients.grp-code
     1112           no-error .
     1113       if not available ub.cli-grp then
     1114       do:
     1115           message
     1116               vss-workfile vss-revision vss-description skip
     1117               "Неизвестная группа клиентов" skip
     1118               "Клиент" ub.clients.obj-type ub.clients.obj-code skip
     1119               "Группа клиентов" clients.grp-code skip
     1120               view-as alert-box error .
     1121           undo, return error .
     1122       end.
     1123       if new(ub.clients)
     1124           or (old-clients.grp-code <> clients.grp-code) or clients.grp-name = "" then
     1125       do:
     1126           assign
     1127               g-name = ""
     1128               .
     1129           run cli-grplib-get-full-name in this-procedure
     1130               (input        clients.grp-code
     1131               ,output g-name
     1132               ).
     1133           assign
     1134               clients.grp-name = g-name
     1135               .
     1136       end.
     1137       buffer-compare ub.clients
     1138           to old-clients
     1139           case-sensitive
     1140           save result in v-l-chr .
     1141       if
     1142           not g#news and
     1143           not (ub.clients.obj-type = 'маг':U or ub.clients.obj-type = 'скл':U) then
     1144       do:
     1145   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1146   define variable send-ref as logical no-undo.
     1147   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1148     (input  'send-ref'
     1149     ,input  0
     1150     ,input  ''
     1151     ,input  0
     1152     ,input  ''
     1153     ,input  ''
     1154     ,input  ''
     1155     ,input  no
     1156     ,output conf-par
     1157     ,output par-type
     1158     ) no-error .
     1159     send-ref = (IF error-status:error or conf-par <> "yes" then no else yes).
     1160           if send-ref then
     1161           do:
     1162               if not new(ub.clients) then
     1163               do:
     1164                   if lookup("obj-name", v-l-chr) > 0 then
     1165                   do:
     1166                       for each buf_dis-card no-lock where
     1167                           buf_dis-card.cli-type = ub.clients.obj-type
     1168                           AND buf_dis-card.cli-code = ub.clients.obj-code :
     1169                           run trg/nu_dcard.p (
     1170                               input  buf_dis-card.d-card
     1171                               ,input  buf_dis-card.emitent-host-code
     1172                               ,input  "":U
     1173                               ,input  0
     1174                               ,input  "U":U
     1175                               ).
     1176                       end.
     1177                   end.
     1178               end.
     1179           end.
     1180           If ub.clients.obj-type = 'чел':U then
     1181           do:
     1182               if old-clients.obj-name <> ub.clients.obj-name then
     1183               do:
     1184                   assign
     1185                       v-seller-code = gbclcode-get-db-role (
     1186                                                     input 'S':U
     1187                                                    ,input g#db-num
     1188                                                    ,input ub.clients.obj-code
     1189                                                    ,input ?
     1190                                                    ,output v-password
     1191                                                       ) no-error .
     1192                   if v-seller-code > 0 then
     1193                   do:
     1194                       run trg/nu_slr.p (
     1195                           input  v-seller-code
     1196                           ,input ub.clients.obj-code
     1197                           ,input 0
     1198                           ,input  "":U
     1199                           ,input  0
     1200                           ,input  "U":U
     1201                           ,input v-password
     1202                           ).
     1203                   end.
     1204                   assign
     1205                       v-cashier-code = gbclcode-get-db-role (
     1206                                                      input 'C':U
     1207                                                     ,input g#db-num
     1208                                                     ,input ub.clients.obj-code
     1209                                                     ,input ?
     1210                                                     ,output v-password
     1211                                                       ) no-error .
     1212                   if v-cashier-code > 0 then
     1213                   do:
     1214                       run trg/nu_cshr.p (
     1215                           input  v-cashier-code
     1216                           ,input ub.clients.obj-code
     1217                           ,input 0
     1218                           ,input  "":U
     1219                           ,input  0
     1220                           ,input  "U":U
     1221                           ,input v-password
     1222                           ).
     1223                   end.
     1224               end.
     1225           end.
     1226       end.
     1227       if lookup('no-hist':U, v-trg-param) = 0 then
     1228       do:
     1229           if
     1230               g#news
     1231               or  (v-l-chr <> "":U
     1232               and lookup(v-l-chr, "sup-gds,sup-cons,sup-serv,buy-gds,buy-cons,buy-serv,is-prod":U) = 0
     1233               ) then
     1234           do:
     1235               run clientsh_write-clients-trigger in this-procedure  (
     1236                   input new(ub.clients)
     1237                   ,input (if g#news
     1238                   then 'db':U
     1239                   else (if g#esys
     1240                   then 'esys':U
     1241                   else "":U)
     1242                   )
     1243                   ,input  (if g#news
     1244                   then string(g#news-source-db)
     1245                   else (if g#esys
     1246                   then string(g#esys-source-esys)
     1247                   else "":U)
     1248                   )
     1249                   ) no-error .
     1250               if error-status:error then undo main-block, return error return-value.
     1251           end.
     1252       end.
     1253       if lookup('no-callnews':U, v-trg-param) = 0 then
     1254       do:
     1255           run str/callnews.p
     1256               (input 'clients':U
     1257               ,input (buffer ub.clients:handle)
     1258               ) no-error .
     1259           if error-status:error then
     1260           do:
     1261               undo main-block, return error return-value .
     1262           end.
     1263       end.
     1264   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     1265     (input ?
     1266     ,input this-procedure:handle
     1267     ,input ?
     1268     ,input  ( if new(ub.clients) then 'cliadd':U else 'cliupdate':U )
     1269     ,input  buffer old-clients:handle
     1270     ,input  buffer ub.clients:handle
     1271     ,input ''
     1272     ,input ''
     1273     ) no-error .
     1274       if error-status:error
     1275           then
     1276       do:
     1277           if not g#news then
     1278           do:
     1279               message
     1280                   vss-workfile vss-revision vss-description skip
     1281                   "Ошибка при вызове процедуры rum-runa.i" skip
     1282                   error-status :get-message(1) skip
     1283                   return-value skip
     1284                   view-as alert-box error .
     1285           end.
     1286           undo main-block,  return error return-value .
     1287       end.
     1288       if not g#news and g#db-num = 0 then
     1289       do:
     1290           if ub.clients.turnover-buyer =  true  and  old-clients.turnover-buyer = false then
     1291           do:
     1292               run ref/calcturn.p (ub.clients.obj-type, ub.clients.obj-code) no-error .
     1293           end.
     1294           if ub.clients.turnover-buyer =  false and  old-clients.turnover-buyer = true  then
     1295           do:
     1296               run ref/delturn.p ( ub.clients.obj-type, ub.clients.obj-code ) no-error .
     1297           end.
     1298       end.
     1299       if g#oxml = yes
     1300           then
     1301       do:
     1302           run str/calloxml.p (
     1303               input 'update':U
     1304               , input 'clients':U
     1305               , input ( buffer ub.clients:handle )
     1306               ) no-error.
     1307           if error-status :error
     1308               then
     1309           do:
     1310               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     1311                   , chr(10)
     1312                   , vss-workfile
     1313                   , return-value
     1314                   , error-status :get-message ( 1 ) ).
     1315           end.
     1316       end.
     1317       if new(ub.clients) then
     1318       do:
     1319           run trg/userlog.p (
     1320               input 'create':U
     1321               , input 'clients':U
     1322               , input ( buffer ub.clients :handle )
     1323               , input ?
     1324               , input ""
     1325               ) no-error.
     1326           if error-status :error
     1327               then
     1328           do:
     1329               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     1330                   , chr(10)
     1331                   , vss-workfile
     1332                   , return-value
     1333                   , error-status :get-message ( 1 ) ).
     1334           end.
     1335       end.
     1336       else
     1337       do:
     1338           run trg/userlog.p (
     1339               input 'update':U
     1340               , input 'clients':U
     1341               , input ( buffer ub.clients :handle )
     1342               , input ?
     1343               , input ""
     1344               ) no-error.
     1345           if error-status :error
     1346               then
     1347           do:
     1348               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     1349                   , chr(10)
     1350                   , vss-workfile
     1351                   , return-value
     1352                   , error-status :get-message ( 1 ) ).
     1353           end.
     1354       end.
     1355   end.
