      521   procedure db-attr-value :
      522     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      523     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      524     define output parameter p-value     like ub.db-attr.attr-value no-undo .
      525     define output parameter p-type      as character no-undo .
      526     do
      527     on error undo, return error
      528     :
