        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.price-doc .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление переоценки".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2',ub.price-doc.doc-num,ub.price-doc.status_)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define buffer buf_c-price-doc  for ub.c-price-doc  .
       82   define buffer buf_c-price-list for ub.c-price-list  .
       83   define buffer buf_c-price-list-attr for ub.c-price-list-attr  .
       84   define buffer buf_c-doc-attr for ub.c-doc-attr .
       85   define variable v-is-erpRN    as logical no-undo .
       86   define variable par-is-erpRN  as character no-undo .
       87   define variable par-type      as character no-undo .
       88   main-block :
       89   do transaction
       90   on error undo main-block, return error
       91   :
       92   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
       93     (input  'is-erpRN'
       94     ,input  ''
       95     ,input  ''
       96     ,input  0
       97     ,input  ''
       98     ,input  ''
       99     ,input  ''
      100     ,input  no
      101     ,output par-is-erpRN
      102     ,output par-type
      103     ) no-error .
      104     v-is-erpRN = lookup(par-is-erpRN, "true,yes":U) > 0.
      105     if ub.price-doc.status_ = 'акт':U
      106     then do:
      107       message
      108         vss-workfile vss-revision vss-description skip
      109         "Ошибка при удалении документа переоценки" skip
      110         "Нельзя удалять переоценку, находящуюся в статусе" 'акт':U skip
      111         "Документ переоценки" ub.price-doc.doc-num skip
      112         "Статус" ub.price-doc.status_ skip
      113         view-as alert-box error .
      114       undo main-block, return error .
      115     end.
      116     define buffer buf_clients for ub.clients .
      117     find first buf_clients no-lock
      118       where buf_clients.obj-type = ub.price-doc.obj-type
      119         and buf_clients.obj-code = ub.price-doc.obj-code
      120       no-error .
      121     if not available buf_clients then do:
      122       message
      123         vss-workfile vss-revision vss-description skip
      124         "Не найден объект" skip
      125         "Переоценка" ub.price-doc.doc-num skip
      126         "Объект" ub.price-doc.obj-type ub.price-doc.obj-code skip
      127         view-as alert-box error .
      128       undo, return error .
      129     end.
      130     if g#news
      131     then do:
      132       message
      133         vss-workfile vss-revision vss-description skip
      134         "Удаление переоценки в новостях невозможно" skip
      135         "Переоцека" ub.price-doc.doc-num skip
      136         "Объект" ub.price-doc.obj-type ub.price-doc.obj-code skip
      137         "Статус" ub.price-doc.status_ skip
      138         view-as alert-box error .
      139       undo, return error .
      140     end.
      141     if buf_clients.db-num <> 0
      142     and not v-is-erpRN
      143     and ub.price-doc.status_ <> 'новый':U then do:
      144       message
      145         vss-workfile vss-revision vss-description skip
      146         "Удаление переоценки УБД возвможно только в статусе" 'новый':U skip
      147         "Переоцека" ub.price-doc.doc-num skip
      148         "Объект" ub.price-doc.obj-type ub.price-doc.obj-code skip
      149         "Статус" ub.price-doc.status_ skip
      150         view-as alert-box error .
      151       undo, return error .
      152     end.
      153     if ub.price-doc.status_ = 'разрешен':U then do:
      154       if ub.price-doc.obj-type = 'маг':U then do:
      155         message
      156           vss-workfile vss-revision vss-description skip
      157           "Для магазина запрещено удаление переоценок в статусе" ub.price-doc.status_ skip
      158           "Переоцека" ub.price-doc.doc-num skip
      159           "Объект" ub.price-doc.obj-type ub.price-doc.obj-code skip
      160           "Статус" ub.price-doc.status_ skip
      161           view-as alert-box error .
      162         undo, return error .
      163       end.
      164       for each ub.price-list
      165         where ub.price-list.doc-num = ub.price-doc.doc-num
      166       on error undo, return error
      167       break
      168       by ub.price-list.artic
      169       by ub.price-list.prod-type
      170       by ub.price-list.prod-code
      171       :
      172         if last-of(ub.price-list.prod-code) then do:
      173           define variable l-ov-on as logical no-undo .
      174   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      176     (input  ub.price-list.obj-type
      177     ,input  ub.price-list.obj-code
      178     ,input  ub.price-list.artic
      179     ,input  ub.price-list.prod-type
      180     ,input  ub.price-list.prod-code
      181     ,input  'ov-on=false'
      182     ,output l-ov-on
      183     ) no-error .
      184           if error-status :error then do:
      185             message
      186               vss-workfile vss-revision vss-description skip
      187               "Ошибка задания признака товара на объекте" skip
      188               "Переоценка" ub.price-list.doc-num skip
      189               "Объект" ub.price-list.obj-type ub.price-list.obj-code skip
      190               "Артикул" ub.price-list.artic ub.price-list.prod-type ub.price-list.prod-code skip
      191               "action" "ov-on=false" skip
      192               error-status :get-message(1) skip
      193               return-value skip
      194               view-as alert-box error .
      195             undo, return error .
      196           end.
      197         end.
      198       end.
      199     end.
      200      if ub.price-doc.status_ <> 'новый':U then do:
      201         create buf_c-price-doc.
      202         BUFFER-COPY ub.price-doc TO buf_c-price-doc
      203         assign
      204           buf_c-price-doc.chip-num           = next-value (s-corr-chip, ub)
      205           buf_c-price-doc.corr-time          = time
      206           buf_c-price-doc.corr-user-db-num   = g#db-num
      207           buf_c-price-doc.corr-man           = g#userid
      208           buf_c-price-doc.corr-date          = today
      209           buf_c-price-doc.is-del             = true
      210         .
      211      end.
      212     for each ub.price-list exclusive-lock
      213       where ub.price-list.doc-num = ub.price-doc.doc-num
      214     on error undo main-block, return error
      215     :
      216       if ub.price-doc.status_ <> 'новый':U then do:
      217         create buf_c-price-list.
      218         BUFFER-COPY ub.price-list TO buf_c-price-list
      219         assign
      220           buf_c-price-list.chip-num           = buf_c-price-doc.chip-num
      221           buf_c-price-list.corr-time           = time
      222           buf_c-price-list.corr-user-db-num    = g#db-num
      223           buf_c-price-list.corr-user-name     = g#userid
      224           buf_c-price-list.corr-date          = today
      225           buf_c-price-list.is-del             = true
      226         .
      227        end.
      228       delete ub.price-list .
      229     end.
      230     for each ub.doc-attr where ub.doc-attr.doc-code = ub.price-doc.doc-num
      231       on error undo main-block, return error
      232       :
      233       if ub.price-doc.status_ <> 'новый':U then do:
      234         create buf_c-doc-attr.
      235         BUFFER-COPY ub.doc-attr TO buf_c-doc-attr
      236         assign
      237           buf_c-doc-attr.chip-num           = buf_c-price-doc.chip-num
      238           buf_c-doc-attr.corr-time           = time
      239           buf_c-doc-attr.corr-user-db-num    = g#db-num
      240           buf_c-doc-attr.corr-user-name     = g#userid
      241           buf_c-doc-attr.corr-date          = today
      242         .
      243       end.
      244       delete ub.doc-attr.
      245     end.
      246     for each ub.price-list-attr where ub.price-list-attr.doc-num = ub.price-doc.doc-num
      247       on error undo main-block, return error
      248       :
      249       if ub.price-doc.status_ <> 'новый':U then do:
      250         create buf_c-price-list-attr.
      251         BUFFER-COPY ub.price-list-attr TO buf_c-price-list-attr
      252         assign
      253           buf_c-price-list-attr.chip-num           = buf_c-price-doc.chip-num
      254           buf_c-price-list-attr.corr-time           = time
      255           buf_c-price-list-attr.corr-user-db-num    = g#db-num
      256           buf_c-price-list-attr.corr-user-name     = g#userid
      257           buf_c-price-list-attr.corr-date          = today
      258           buf_c-price-list-attr.is-del             = true
      259         .
      260       end.
      261       delete ub.price-list-attr.
      262     end.
      263       if g#oxml = yes
      264       then do:
      265       run str/calloxml.p (
      266             input 'delete':U
      267           , input 'price-doc':U
      268           , input ( buffer ub.price-doc:handle )
      269       ) no-error.
      270       if error-status :error
      271       then do:
      272           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      273                                , chr(10)
      274                                , vss-workfile
      275                                , return-value
      276                                , error-status :get-message ( 1 ) ).
      277       end.
      278       end.
      279     if ub.price-doc.PS <> "temp"
      280     then do :
      281   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      282     (input ?
      283     ,input this-procedure:handle
      284     ,input ?
      285     ,input 'event_price-doc':U
      286     ,input  buffer ub.price-doc:handle
      287     ,input ?
      288     ,input ''
      289     ,input ''
      290     ) no-error .
      291         if error-status:error
      292         then do:
      293           define variable v-message as character no-undo .
      294           v-message = substitute("&1 &2 &3&4Ошибка при вызове процедуры rum-runa.i&4&5&4&5&6"
      295                                   ,vss-workfile
      296                                   ,vss-revision
      297                                   ,vss-description
      298                                   ,chr(10)
      299                                   , error-status:get-message(1)
      300                                   , return-value ).
      301           if not g#news
      302           and not g#auto
      303           and not g#esys
      304           then do:
      305             message
      306             v-message
      307             view-as alert-box error .
      308           end.
      309           undo main-block,  return error v-message.
      310         end.
      311     end.
      312   end.
