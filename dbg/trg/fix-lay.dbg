     1994            and buf_tt-layout-elem.device-type = buf_layout-elem.device-type
     1995            and buf_tt-layout-elem.mode-id = buf_layout-elem.mode-id
     1996            and buf_tt-layout-elem.widget-id = buf_layout-elem.widget-id no-error .
