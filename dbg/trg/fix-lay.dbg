     2297                and buf2_layout-elem-rule.mode-id = buf_tt-layout-elem-rule.mode-id
     2298                and buf2_layout-elem-rule.widget-id = buf_tt-layout-elem-rule.widget-id no-error.
     2299             if not available buf2_layout-elem-rule
     2300             or (available (buf2_layout-elem-rule)
     2301                and
     2302                buf2_layout-elem-rule.rule_id <> buf_tt-layout-elem-rule.rule_id) then do:
     2303                run  layouth_create-layout_h  in this-procedure (
     2304                                                              input 'ИЗМЕНЕНИЕ':U
     2305                                                             ,input buf2_layout.layout-id
     2306                                                             ,buffer buf2_layout
     2307                                                             ,output v-chip-num).
     2308               if available buf2_layout-elem-rule then do:
