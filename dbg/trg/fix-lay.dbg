     2193         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2194         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2195         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
     2196           find first buf_tt-rule-call-param where
     2197                    buf_tt-rule-call-param.call_id = buf_rule-call-param.call_id
     2198               and  buf_tt-rule-call-param.codex_id = buf_rule-call-param.codex_id
     2199               and  buf_tt-rule-call-param.ruleset_id = buf_rule-call-param.ruleset_id
     2200               and  buf_tt-rule-call-param.order_id = buf_rule-call-param.order_id
     2201               and  buf_tt-rule-call-param.param-name = buf_rule-call-param.param-name
     2202               and  buf_tt-rule-call-param.p-index = buf_rule-call-param.p-index no-error.
     2203           if not available buf_tt-rule-call-param then do:
     2204             if v-chip-num < 0 then do:
     2205               run  layouth_create-layout_h  in this-procedure (
