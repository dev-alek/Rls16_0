     2310                 run  layouth_create-layout-elem-rule_h  in this-procedure (
     2311                                                                 input 'ИЗМЕНЕНИЕ':U
     2312                                                               ,input buf2_layout-elem-rule.layout-id
     2313                                                               ,input buf2_layout-elem-rule.mode-id
     2314                                                               ,input buf2_layout-elem-rule.widget-id
     2315                                                               ,buffer buf2_layout-elem-rule
     2316                                                               ,input v-chip-num).
