     2246                                                         ,input buf_layout-elem-rule.widget-id
     2247                                                         ,buffer buf_layout-elem-rule
     2248                                                         ,input v-chip-num).
     2249           for each buf_rule-by-call where
     2250                buf_rule-by-call.call_id = buf_layout-elem-rule.uniq-key-rec
     2251           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2252           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2253           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
     2254              delete buf_rule-by-call.
     2255           end.
     2256           for each buf_rule-call-param where
     2257                 buf_rule-call-param.call_id = buf_layout-elem-rule.uniq-key-rec
     2258           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2259           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2260           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
     2261             if v-chip-num < 0 then do:
