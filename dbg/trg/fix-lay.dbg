     1028   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1029   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   procedure layouth_create-layout_h :
     1031   define input parameter p-mode as character no-undo .
     1032   define input parameter p-layout-id as character no-undo .
     1033   define parameter buffer buf_layout for ub.layout.
     1034   define output parameter p-chip-num as integer no-undo .
     1035   define variable v-chip-num as integer no-undo .
     1036   DEFINE VARIABLE v-today as date no-undo .
     1037   DEFINE VARIABLE v-time as integer no-undo .
     1038   define buffer buf_c-layout for ub.c-layout.
     1039   do
     1040   on error undo, return error
     1041   :
     1042     run cur-time in this-procedure ( output v-today, output v-time).
     1043     find last buf_c-layout no-lock where
     1044               buf_c-layout.layout-id = p-layout-id
     1045          and  buf_c-layout.corr-user-db-num = g#db-num
     1046          use-index pi no-error.
     1047     assign
     1048     v-chip-num = (if available buf_c-layout
     1049                   then buf_c-layout.chip-num + 1
     1050                   else 0).
     1051     create buf_c-layout.
     1052     if available buf_layout
     1053     and p-mode <> 'ДОБАВЛЕНИЕ':U
     1054     then do:
     1055       buffer-copy buf_layout
     1056       to buf_c-layout.
     1057     end.
     1058     if not available buf_layout then do:
     1059       assign
     1060       buf_c-layout.layout-id = p-layout-id
     1061       .
     1062     end.
     1063     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1064       assign
     1065       buf_c-layout.layout-id = p-layout-id
     1066       .
     1067     end.
     1068     assign
     1069     buf_c-layout.subject = 'layout':U
     1070     buf_c-layout.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
     1071                            then integer('1':U)
     1072                            else (if p-mode = 'ИЗМЕНЕНИЕ':U
     1073                                  then integer('2':U)
     1074                                  else integer('99':U)
     1075                                  )
     1076                           )
     1077     buf_c-layout.chip-num = v-chip-num
     1078     buf_c-layout.corr-user-db-num = g#db-num
     1079     buf_c-layout.corr-user-name = g#userid
     1080     buf_c-layout.corr-date = v-today
     1081     buf_c-layout.corr-time = v-time
     1082     p-chip-num = v-chip-num
     1083     .
     1084   end.
     1085   end procedure.
     1086   procedure layouth_create-layout-elem-rule_h :
     1087   define input parameter p-mode as character no-undo .
     1088   define input parameter p-layout-id as character no-undo .
     1089   define input parameter p-mode-id as character no-undo .
     1090   define input parameter p-widget-id as character no-undo .
     1091   define parameter buffer buf_layout-elem-rule for ub.layout-elem-rule.
     1092   define input parameter p-chip-num as integer no-undo .
     1093   DEFINE VARIABLE v-today as date no-undo .
     1094   DEFINE VARIABLE v-time as integer no-undo .
     1095   define buffer buf_c-layout-elem-rule for ub.c-layout-elem-rule.
     1096   do
     1097   on error undo, return error
     1098   :
     1099     run cur-time in this-procedure ( output v-today, output v-time).
     1100     create buf_c-layout-elem-rule.
     1101     if available buf_layout-elem-rule
     1102     and p-mode <> 'ДОБАВЛЕНИЕ':U
     1103     then do:
     1104       buffer-copy buf_layout-elem-rule
     1105       to buf_c-layout-elem-rule.
     1106     end.
     1107     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1108       assign
     1109       buf_c-layout-elem-rule.layout-id = p-layout-id
     1110       buf_c-layout-elem-rule.mode-id = p-mode-id
     1111       buf_c-layout-elem-rule.widget-id = p-widget-id
     1112       .
     1113     end.
     1114     assign
     1115     buf_c-layout-elem-rule.subject = 'layout-elem-rule':U
     1116     buf_c-layout-elem-rule.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
     1117                            then integer('1':U)
     1118                            else (if p-mode = 'ИЗМЕНЕНИЕ':U
     1119                                  then integer('2':U)
     1120                                  else integer('99':U)
     1121                                  )
     1122                           )
     1123     buf_c-layout-elem-rule.chip-num = p-chip-num
     1124     buf_c-layout-elem-rule.corr-user-db-num = g#db-num
     1125     buf_c-layout-elem-rule.corr-user-name = g#userid
     1126     buf_c-layout-elem-rule.corr-date = v-today
     1127     buf_c-layout-elem-rule.corr-time = v-time
     1128     .
     1129   end.
     1130   end procedure.
     1131   procedure layouth_create-rule-call-param_h :
     1132   define input parameter p-mode as character no-undo .
     1133   define input parameter p-call#-id as integer no-undo .
     1134   define input parameter p-codex-id as integer no-undo .
     1135   define input parameter p-ruleset-id as integer no-undo .
     1136   define input parameter p-order-id as integer no-undo .
     1137   define input parameter p-param-name as character no-undo .
     1138   define input parameter p-index as integer no-undo .
     1139   define input parameter p-call-id as character no-undo .
     1140   define parameter buffer buf_rule-call-param for ub.rule-call-param.
     1141   define input parameter p-chip-num as integer no-undo .
     1142   DEFINE VARIABLE v-today as date no-undo .
     1143   DEFINE VARIABLE v-time as integer no-undo .
     1144   define buffer buf_c-rule-call-param for ub.c-rule-call-param.
     1145   do
     1146   on error undo, return error
     1147   :
     1148     run cur-time in this-procedure ( output v-today, output v-time).
     1149     create buf_c-rule-call-param.
     1150     if available buf_rule-call-param
     1151     and p-mode <> 'ДОБАВЛЕНИЕ':U
     1152     then do:
     1153       buffer-copy buf_rule-call-param
     1154       to buf_c-rule-call-param.
     1155     end.
     1156     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1157       assign
     1158       buf_c-rule-call-param.call#_id = p-call#-id
     1159       buf_c-rule-call-param.codex_id = p-codex-id
     1160       buf_c-rule-call-param.ruleset_id = p-ruleset-id
     1161       buf_c-rule-call-param.order_id = p-order-id
     1162       buf_c-rule-call-param.param-name = p-param-name
     1163       buf_c-rule-call-param.p-index = p-index
     1164       buf_c-rule-call-param.call_id = p-call-id
     1165       .
     1166     end.
     1167     assign
     1168     buf_c-rule-call-param.action = (if p-mode = 'ДОБАВЛЕНИЕ':U
     1169                                     then integer('1':U)
     1170                                     else (if p-mode = 'удаление':U
     1171                                           then integer('99':U)
     1172                                           else integer('2':U)
     1173                                           )
     1174                                     )
     1175     buf_c-rule-call-param.chip-num = p-chip-num
     1176     buf_c-rule-call-param.corr-user-db-num = g#db-num
     1177     buf_c-rule-call-param.corr-user-name = g#userid
     1178     buf_c-rule-call-param.corr-date = v-today
     1179     buf_c-rule-call-param.corr-time = v-time
     1180     .
     1181   end.
     1182   end procedure.
     1183   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   procedure gen-key-rec :
     1185     define input  parameter p-tbl-name    as character no-undo.
     1186     define input  parameter p-bh_tbl-name as handle    no-undo.
     1187     define output parameter p-key-rec     as character no-undo.
     1188     do
     1189     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1190     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1191     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1192     :
     1193       define variable fh               as handle    no-undo .
     1194       define variable v-ok             as logical   no-undo .
     1195       define variable v-inform         as character no-undo .
     1196       define variable v-ind            as integer   no-undo .
     1197       define variable v-idx-field-qnty as integer   no-undo .
     1198       if p-tbl-name = ?
     1199         or p-tbl-name = "":U
     1200       then do:
     1201         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info9 ).
     1202       end.
     1203       if not p-bh_tbl-name:available then do:
     1204         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info9, p-tbl-name ).
     1205       end.
     1206       assign
     1207         p-key-rec = p-tbl-name
     1208         v-inform  = p-bh_tbl-name:index-information(1)
     1209         v-ind     = 2
     1210       .
     1211       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1212       on error undo, return error
     1213       :
     1214         assign
     1215           v-inform = p-bh_tbl-name:index-information( v-ind )
     1216           v-ind    = v-ind + 1
     1217         .
     1218       end.
     1219       if v-inform = ?
     1220         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1221         or entry( 3, v-inform, ",":U ) <> "1":U
     1222       then do:
     1223         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, p-tbl-name ).
     1224       end.
     1225       else do:
     1226         assign
     1227           v-idx-field-qnty = num-entries( v-inform ) - 4
     1228         .
     1229         if v-idx-field-qnty < 2 then do:
     1230           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, p-tbl-name ).
     1231         end.
     1232         do v-ind = 1 to v-idx-field-qnty by 2
     1233         on error undo, return error
     1234         :
     1235           assign
     1236             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1237             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1238           .
     1239         end.
     1240       end.
     1241       if p-key-rec = ? then do:
     1242         assign
     1243           p-key-rec = "":U
     1244         .
     1245         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info9, p-tbl-name ).
     1246       end.
     1247     end.
     1248     return.
     1249   end procedure.
     1250   procedure gen-where-keyr-tab :
     1251     define input  parameter i-tableSerach as character no-undo.
     1252     define input  parameter i-tablekey   as character  no-undo.
     1253     define input  parameter p-key-rec    as character  no-undo.
     1254     define input  parameter p-key-handle as handle     no-undo .
     1255     define input  parameter p-db-name    as character  no-undo .
     1256     define input  parameter p-tt-handle  as handle     no-undo .
     1257     define output parameter o-Where      as character  no-undo.
     1258     do
     1259     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1260     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1261     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1262     :
     1263       define variable v-full-tbl-name  as character no-undo .
     1264       define variable bh_tbl-name      as handle    no-undo .
     1265       define variable fh_key           as handle    no-undo .
     1266       define variable fh_search        as handle    no-undo .
     1267       define variable v-field-num      as integer   no-undo .
     1268       define variable v-count-fld      as integer   no-undo .
     1269       define variable v-inform         as character no-undo .
     1270       define variable v-ind            as integer   no-undo .
     1271       define variable v-idx-field-qnty as integer   no-undo .
     1272       define variable v-field-name     as character no-undo .
     1273       define variable v-field-val      as character no-undo .
     1274       define variable v-word-link      as character no-undo .
     1275       define variable vTable           as character no-undo.
     1276       define variable bh_tbl-key       as handle    no-undo .
     1277       assign
     1278         p-key-rec = trim( p-key-rec )
     1279       .
     1280       if p-key-handle <> ? then do:
     1281         if not valid-handle(p-key-handle)
     1282            or p-key-handle:type <> "buffer"
     1283         then do:
     1284           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info9 ).
     1285         end.
     1286         if num-entries( p-key-rec, chr(3) ) > 1
     1287           or p-key-rec = ?
     1288           or p-key-rec = "":U
     1289         then do:
     1290           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info9, p-key-rec ).
     1291         end.
     1292       end.
     1293       else do:
     1294         if p-key-rec = ?
     1295           or p-key-rec = "":U
     1296         then do:
     1297           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     1298         end.
     1299       end.
     1300       assign
     1301         vTable = entry( 1 , p-key-rec, chr(3) )
     1302       .
     1303       if p-tt-handle <> ?
     1304         and ( not valid-handle(p-tt-handle)
     1305               or p-tt-handle:type <> "buffer"
     1306             )
     1307       then do:
     1308         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info9, vTable, chr(10) ).
     1309       end.
     1310       if p-tt-handle = ? then do:
     1311         assign
     1312           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1313         .
     1314         create buffer bh_tbl-name for table v-full-tbl-name .
     1315       end.
     1316       else do:
     1317         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1318       end.
     1319       assign
     1320         v-inform = bh_tbl-name:index-information(1)
     1321         v-ind    = 2
     1322       .
     1323       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1324       on error undo, return error
     1325       :
     1326         assign
     1327           v-inform = bh_tbl-name:index-information( v-ind )
     1328           v-ind    = v-ind + 1
     1329         .
     1330       end.
     1331       if v-inform = ?
     1332         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1333         or entry( 3, v-inform, ",":U ) <> "1":U
     1334       then do:
     1335         delete object bh_tbl-name no-error.
     1336         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info9, vTable ).
     1337       end.
     1338       assign
     1339         v-idx-field-qnty = num-entries( v-inform ) - 4
     1340       .
     1341       if v-idx-field-qnty < 2 then do:
     1342         delete object bh_tbl-name no-error.
     1343         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, vTable ).
     1344       end.
     1345       assign
     1346         o-where     = "where":U
     1347         v-word-link = "":U
     1348         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1349         v-count-fld = 0
     1350       .
     1351       if i-tablekey ne "" and i-tablekey ne ?
     1352       then do:
     1353         assign
     1354           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1355         .
     1356         create buffer bh_tbl-key for table v-full-tbl-name .
     1357       end.
     1358       if i-tableSerach ne "" and i-tableSerach ne ?
     1359       then do:
     1360         delete object bh_tbl-name no-error.
     1361         assign
     1362           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1363         .
     1364         create buffer bh_tbl-name for table v-full-tbl-name .
     1365       end.
     1366       block_where:
     1367       do v-ind = 1 to v-idx-field-qnty by 2
     1368       on error undo, return error
     1369       :
     1370         assign
     1371           v-count-fld = v-count-fld + 1
     1372         .
     1373         if p-key-handle = ?
     1374           and v-count-fld > v-field-num
     1375         then do:
     1376           leave block_where.
     1377         end.
     1378         define variable VfieldKeyTable as handle no-undo.
     1379         assign
     1380           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1381           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1382         .
     1383         if     bh_tbl-key ne ?
     1384         then do:
     1385            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1386            if VfieldKeyTable eq ?
     1387            then next block_where.
     1388         end.
     1389         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1390         then
     1391            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1392         else
     1393            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1394         if p-key-handle = ? then do:
     1395           assign
     1396             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1397           .
     1398         end.
     1399         else do:
     1400           assign
     1401             fh_key = p-key-handle:buffer-field( v-field-name )
     1402           .
     1403           if fh_key = ?
     1404             or not valid-handle( fh_key )
     1405           then do:
     1406             delete object bh_tbl-name.
     1407             if     bh_tbl-key ne ?
     1408             then
     1409                delete object bh_tbl-key.
     1410             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info9, p-key-handle:name, v-field-name ).
     1411           end.
     1412           assign
     1413             v-field-val = fh_key:buffer-value
     1414           .
     1415         end.
     1416         if fh_search:data-type ="character":U then do:
     1417           assign
     1418             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1419             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1420             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1421             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1422             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1423             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1424             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1425             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1426             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1427             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1428             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1429             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1430             v-field-val = substitute( '"&1"', v-field-val )
     1431           .
     1432         end.
     1433         assign
     1434           o-where = substitute( "&1 &2", o-where, v-field-val )
     1435         .
     1436         if v-word-link = "":U then do:
     1437           assign
     1438             v-word-link = "and":U
     1439           .
     1440         end.
     1441       end.
     1442       delete object bh_tbl-name.
     1443       if     bh_tbl-key ne ?
     1444       then
     1445          delete object bh_tbl-key.
     1446       if p-key-handle = ?
     1447         and v-count-fld <> v-field-num
     1448       then do:
     1449         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info9, vTable ).
     1450       end.
     1451     end.
     1452   end procedure.
     1453   procedure gen-hn-keyr-tab :
     1454     define input  parameter i-tableSerach as character no-undo.
     1455     define input  parameter i-tablekey   as character no-undo.
     1456     define input  parameter p-key-rec    as character no-undo.
     1457     define input  parameter p-key-handle as handle    no-undo .
     1458     define input  parameter p-db-name    as character no-undo .
     1459     define input  parameter p-tt-handle  as handle    no-undo .
     1460     define input  parameter p-stts-lock  as integer   no-undo .
     1461     define output parameter o-hn         as handle    no-undo.
     1462     define variable v-full-tbl-name as character no-undo.
     1463     define variable v-where         as character no-undo.
     1464     define variable bh_tbl-name     as handle    no-undo.
     1465     define variable vTable          as character no-undo.
     1466     do
     1467     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1468     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1469     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1470         run gen-where-keyr-tab(i-tableSerach,
     1471                                i-tablekey,
     1472                                p-key-rec,
     1473                                p-key-handle,
     1474                                p-db-name,
     1475                                p-tt-handle,
     1476                                output v-where).
     1477         if i-tableSerach ne "" and i-tableSerach ne ?
     1478         then do:
     1479            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1480            create buffer bh_tbl-name for table v-full-tbl-name .
     1481         end.
     1482         else do:
     1483            if p-tt-handle = ? then do:
     1484               assign
     1485                  vTable = entry( 1 , p-key-rec, chr(3) )
     1486               .
     1487               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1488               create buffer bh_tbl-name for table v-full-tbl-name .
     1489            end.
     1490            else do:
     1491               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1492            end.
     1493         end.
     1494         if p-tt-handle = ? then do:
     1495            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1496         end.
     1497         else do:
     1498            bh_tbl-name:find-first( v-where ) no-error .
     1499         end.
     1500         o-hn = bh_tbl-name.
     1501      end.
     1502   end procedure.
     1503   procedure gen-hn-keyr :
     1504     define input  parameter p-key-rec    as character no-undo.
     1505     define input  parameter p-key-handle as handle    no-undo .
     1506     define input  parameter p-db-name    as character no-undo .
     1507     define input  parameter p-tt-handle  as handle    no-undo .
     1508     define input  parameter p-stts-lock  as integer   no-undo .
     1509     define output parameter o-hn         as handle    no-undo.
     1510     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1511   end.
     1512   procedure gen-row-keyr :
     1513     define input  parameter p-key-rec    as character no-undo.
     1514     define input  parameter p-key-handle as handle    no-undo .
     1515     define input  parameter p-db-name    as character no-undo .
     1516     define input  parameter p-tt-handle  as handle    no-undo .
     1517     define input  parameter p-stts-lock  as integer   no-undo .
     1518     define output parameter p-tbl-row    as rowid     no-undo.
     1519     define output parameter p-tbl-name   as character no-undo.
     1520     define variable vHn as handle no-undo.
     1521       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1522       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1523       p-tbl-name =  vHn:table.
     1524       delete object vHn no-error.
     1525     if p-tbl-row = ? then do:
     1526       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info9, p-tbl-name, p-key-rec ).
     1527     end.
     1528     else do:
     1529       return.
     1530     end.
     1531   end procedure.
     1532   procedure gen-key-fv :
     1533     define input  parameter p-key-rec    as character no-undo .
     1534     define output parameter p-field-list as character no-undo .
     1535     define output parameter p-value-list as character no-undo.
     1536     do
     1537     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1538     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1539     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1540     :
     1541       define variable v-full-tbl-name  as character no-undo .
     1542       define variable bh_tbl-name      as handle    no-undo .
     1543       define variable v-tbl-name       as character no-undo .
     1544       define variable v-field-num      as integer   no-undo .
     1545       define variable v-count-fld      as integer   no-undo .
     1546       define variable v-inform         as character no-undo .
     1547       define variable v-ind            as integer   no-undo .
     1548       define variable v-idx-field-qnty as integer   no-undo .
     1549       define variable v-delim-key      as character no-undo .
     1550       if p-key-rec = ?
     1551         or p-key-rec = "":U
     1552       then do:
     1553         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info9 ).
     1554       end.
     1555       assign
     1556         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1557         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1558       .
     1559       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1560       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info9 ).
     1561       assign
     1562         v-inform = bh_tbl-name:index-information(1)
     1563         v-ind    = 2
     1564       .
     1565       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1566       on error undo, return error
     1567       :
     1568         assign
     1569           v-inform = bh_tbl-name:index-information( v-ind )
     1570           v-ind    = v-ind + 1
     1571         .
     1572       end.
     1573       if v-inform = ?
     1574         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1575         or entry( 3, v-inform, ",":U ) <> "1":U
     1576       then do:
     1577         delete object bh_tbl-name no-error.
     1578         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     1579       end.
     1580       assign
     1581         v-idx-field-qnty = num-entries( v-inform ) - 4
     1582       .
     1583       if v-idx-field-qnty < 2 then do:
     1584         delete object bh_tbl-name no-error.
     1585         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     1586       end.
     1587       assign
     1588         p-field-list = "":U
     1589         p-value-list = "":U
     1590         v-delim-key  = "":U
     1591         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1592         v-count-fld  = 0
     1593       .
     1594       block_where:
     1595       do v-ind = 1 to v-idx-field-qnty by 2
     1596       on error undo, return error
     1597       :
     1598         assign
     1599           v-count-fld = v-count-fld + 1
     1600         .
     1601         if v-count-fld > v-field-num then do:
     1602           leave block_where.
     1603         end.
     1604         assign
     1605           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1606           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1607         .
     1608         if v-ind = 1 then do:
     1609           assign
     1610             v-delim-key = chr(3)
     1611           .
     1612         end.
     1613       end.
     1614       delete object bh_tbl-name.
     1615       if v-count-fld <> v-field-num then do:
     1616         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info9, v-tbl-name ).
     1617       end.
     1618     end.
     1619   end procedure.
     1620   procedure gen-key-field :
     1621     define input  parameter p-table      as character no-undo .
     1622     define output parameter p-field-list as character no-undo .
     1623     do
     1624     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1625     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1626     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1627     :
     1628       define variable v-full-tbl-name  as character no-undo .
     1629       define variable bh_tbl-name      as handle    no-undo .
     1630       define variable v-tbl-name       as character no-undo .
     1631       define variable v-field-num      as integer   no-undo .
     1632       define variable v-count-fld      as integer   no-undo .
     1633       define variable v-inform         as character no-undo .
     1634       define variable v-ind            as integer   no-undo .
     1635       define variable v-idx-field-qnty as integer   no-undo .
     1636       define variable v-delim-key      as character no-undo .
     1637       if p-table = ?
     1638         or p-table = "":U
     1639       then do:
     1640         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info9 ).
     1641       end.
     1642       assign
     1643         v-tbl-name      = p-table
     1644         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1645       .
     1646       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1647       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info9 ).
     1648       assign
     1649         v-inform = bh_tbl-name:index-information(1)
     1650         v-ind    = 2
     1651       .
     1652       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1653       on error undo, return error
     1654       :
     1655         assign
     1656           v-inform = bh_tbl-name:index-information( v-ind )
     1657           v-ind    = v-ind + 1
     1658         .
     1659       end.
     1660       if v-inform = ?
     1661         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1662         or entry( 3, v-inform, ",":U ) <> "1":U
     1663       then do:
     1664         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info9, v-tbl-name ).
     1665       end.
     1666       assign
     1667         v-idx-field-qnty = num-entries( v-inform ) - 4
     1668       .
     1669       if v-idx-field-qnty < 2 then do:
     1670         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info9, v-inform, v-tbl-name ).
     1671       end.
     1672       assign
     1673         p-field-list = "":U
     1674         v-delim-key  = "":U
     1675         v-count-fld  = 0
     1676       .
     1677       block_where:
     1678       do v-ind = 1 to v-idx-field-qnty by 2
     1679       on error undo, return error
     1680       :
     1681         assign
     1682           v-count-fld = v-count-fld + 1
     1683         .
     1684         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1685         if v-ind = 1 then do:
     1686           assign
     1687             v-delim-key = chr(3)
     1688           .
     1689         end.
     1690       end.
     1691       delete object bh_tbl-name.
     1692     end.
     1693   end procedure.
     1694   define variable v-check1 as logical no-undo .
     1695   define variable v-check2 as logical no-undo .
     1696   define variable v-force as logical no-undo .
     1697   define variable v-mes   as character no-undo .
     1698   define variable v-full-path        as character no-undo .
     1699   define variable v-path             as character no-undo .
     1700   define variable v-file-name        as character no-undo .
     1701   define variable v-file-name-no-ext as character no-undo .
     1702   define variable v-file-name-ext    as character no-undo .
     1703   define variable v-md5-signature as character no-undo .
     1704   define new shared temp-table tt-layout no-undo like ub.layout . find first buf_temp-tables where buf_temp-tables.tbl-name = "layout" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "layout"    buf_temp-tables.buf-handle = buffer tt-layout:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1705   define new shared temp-table tt-layout-elem no-undo like ub.layout-elem . find first buf_temp-tables where buf_temp-tables.tbl-name = "layout-elem" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "layout-elem"    buf_temp-tables.buf-handle = buffer tt-layout-elem:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1706   define new shared temp-table tt-layout-elem-rule no-undo like ub.layout-elem-rule . find first buf_temp-tables where buf_temp-tables.tbl-name = "layout-elem-rule" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "layout-elem-rule"    buf_temp-tables.buf-handle = buffer tt-layout-elem-rule:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1707   define new shared temp-table tt-wi-mode no-undo like ub.wi-mode . find first buf_temp-tables where buf_temp-tables.tbl-name = "wi-mode" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "wi-mode"    buf_temp-tables.buf-handle = buffer tt-wi-mode:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1708   define new shared temp-table tt-rule-call-param no-undo like ub.rule-call-param . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule-call-param" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule-call-param"    buf_temp-tables.buf-handle = buffer tt-rule-call-param:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1709   define new shared temp-table tt-rule-by-call no-undo like ub.rule-by-call . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule-by-call" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule-by-call"    buf_temp-tables.buf-handle = buffer tt-rule-by-call:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1710   define new shared temp-table tt-rule-by-set no-undo like ub.rule-by-set . find first buf_temp-tables where buf_temp-tables.tbl-name = "rule-by-set" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "rule-by-set"    buf_temp-tables.buf-handle = buffer tt-rule-by-set:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1711   define buffer buf_tt-layout for tt-layout.
     1712   define buffer buf_tt-layout-elem for tt-layout-elem.
     1713   define buffer buf_tt-wi-mode for tt-wi-mode.
     1714   run waitfram-show in this-procedure ("Реинициализация раскладок").
     1715   main-block:
     1716   do
     1717   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1718   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1719   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1720   :
     1721     if ( g#db-num > 0 ) then return.
     1722     if not p-forced then do:
     1723       run check-layout-version in this-procedure (output v-check1).
     1724     end.
     1725     if v-check1
     1726     or p-forced
     1727     then do:
     1728       if v-check1
     1729        and p-read-only then do:
     1730           return error substitute("&1 &2 &3&4До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!"
     1731                                   ,vss-workfile
     1732                                   ,vss-revision
     1733                                   ,vss-description
     1734                                   ,chr(10)).
     1735        end.
     1736        run gbl/md5.p (
     1737          input  "cmp/fix-lay.txt"
     1738         ,output v-md5-signature
     1739         ) .
     1740       if v-md5-signature <> "0FE47550AC5DF79F387CB798B90641F8" then do:
     1741         message
     1742         substitute("Несовпадение файла эталонных записей по расладкам (fix-lay.txt) с контрольным числом")
     1743         view-as alert-box error .
     1744         undo, return error .
     1745       end.
     1746       run gbl/filename.p ( input "cmp/fix-lay.txt"
     1747                           ,output v-full-path
     1748                           ,output v-path
     1749                           ,output v-file-name
     1750                           ,output v-file-name-no-ext
     1751                           ,output v-file-name-ext
     1752                           ) no-error .
     1753       if error-status:error then do:
     1754         message
     1755         substitute("Не найден файл эталонных записей по раскладкам (fix-lay.txt)")
     1756         view-as alert-box error .
     1757         undo, return error .
     1758       end.
     1759       run str/diallog.w (
     1760             input ?
     1761           ,input this-procedure
     1762           ,input ('utl/upgimptt.p' + chr(4)  +
     1763                   '1' + chr(4) +
     1764                   '1' + chr(4) +
     1765                   '1' + chr(4) +
     1766                   '1')
     1767           ,input v-full-path
     1768           ,input yes
     1769           ,input 'Прервать'
     1770           ,input 'Чтение файла в память') no-error .
     1771       if error-status:error then do:
     1772         message
     1773         substitute("Ошибка при чтении в память файла эталонных записей по раскладкам (fix-lay.txt)&1&2&1&3"
     1774                      , chr(10)
     1775                      , error-status:get-message(1)
     1776                      , return-value )
     1777         view-as alert-box error .
     1778         undo, return error .
     1779       end.
     1780       if v-check1 then do:
     1781         find first buf_tt-layout no-lock where
     1782                   buf_tt-layout.layout-id = '_'  no-error.
     1783         if not available buf_tt-layout
     1784         or buf_tt-layout.layout-name <> "v15_1.11" then do:
     1785           message
     1786           substitute("Версии дефолтных раскладок в r-кодах и файле эталонных записей по раскладкам (fix-lay.txt) НЕ СОВПАДАЮТ&1" +
     1787                      "в r-кодах - &2&1" +
     1788                      "в файле - &3"
     1789                      , chr(10)
     1790                      , "v15_1.11"
     1791                      , (if available buf_tt-layout then buf_tt-layout.layout-name else '')
     1792                      )
     1793           view-as alert-box error .
     1794           undo, return error .
     1795         end.
     1796       end.
     1797       run add-wi-mode in this-procedure no-error .
     1798       if error-status:error then do:
     1799         run waitfram-hide in this-procedure .
     1800         assign
     1801         v-mes = substitute("Ошибки при инициализации режимов работы IBS TH POS:&1&2 &3"
     1802                            , chr(10)
     1803                            , error-status:get-message(1)
     1804                            , return-value ).
     1805         if p-forced then do:
     1806           message
     1807           v-mes
     1808           view-as alert-box error .
     1809         end.
     1810         undo, return error v-mes.
     1811       end.
     1812       run add-layout-elem in this-procedure  no-error .
     1813       if error-status:error then do:
     1814         run waitfram-hide in this-procedure .
     1815         assign
     1816         v-mes = substitute("Ошибки при инициализации элементов для раскладок IBS TH POS:&1&2 &3"
     1817                            , chr(10)
     1818                            , error-status:get-message(1)
     1819                            , return-value ).
     1820         if p-forced then do:
     1821           message
     1822           v-mes
     1823           view-as alert-box error .
     1824         end.
     1825         undo, return error v-mes.
     1826       end.
     1827       run add-layout in this-procedure no-error .
     1828       if error-status:error then do:
     1829         run waitfram-hide in this-procedure .
     1830         assign
     1831         v-mes = substitute("Ошибки при инициализации раскладок:&1&2 &3"
     1832                            , chr(10)
     1833                            , error-status:get-message(1)
     1834                            , return-value ).
     1835         if p-forced then do:
     1836           message
     1837           v-mes
     1838           view-as alert-box error .
     1839         end.
     1840         undo, return error v-mes.
     1841       end.
     1842       run delete-layout-elem in this-procedure no-error .
     1843       if error-status:error then do:
     1844         run waitfram-hide in this-procedure .
     1845         assign
     1846         v-mes = substitute("Ошибки при удалении ненужных элементов для раскладок:&1&2 &3"
     1847                            , chr(10)
     1848                            , error-status:get-message(1)
     1849                            , return-value ).
     1850         if p-forced then do:
     1851           message
     1852           v-mes
     1853           view-as alert-box error .
     1854         end.
     1855         undo, return error v-mes.
     1856       end.
     1857       run delete-wi-mode in this-procedure no-error .
     1858       if error-status:error then do:
     1859         run waitfram-hide in this-procedure .
     1860         assign
     1861         v-mes = substitute("Ошибки при удалении ненужных режимов:&1&2 &3"
     1862                            , chr(10)
     1863                            , error-status:get-message(1)
     1864                            , return-value ).
     1865         if p-forced then do:
     1866           message
     1867           v-mes
     1868           view-as alert-box error .
     1869         end.
     1870         undo, return error v-mes.
     1871       end.
     1872       run delete-rule-by-set in this-procedure no-error.
     1873       if error-status:error then do:
     1874         run waitfram-hide in this-procedure .
     1875         assign
     1876         v-mes = substitute("Ошибки при удалении ненужных привязок правил:&1&2 &3"
     1877                            , chr(10)
     1878                            , error-status:get-message(1)
     1879                            , return-value ).
     1880         if p-forced then do:
     1881           message
     1882           v-mes
     1883           view-as alert-box error .
     1884         end.
     1885         undo, return error v-mes.
     1886       end.
     1887     end.
     1888     for each buf_temp-tables
     1889     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1890     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1891     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1892     :
     1893       if valid-handle(buf_temp-tables.tbl-handle) then do:
     1894         delete object buf_temp-tables.tbl-handle.
     1895        end.
     1896     end.
     1897   end.
     1898   run waitfram-hide in this-procedure .
     1899   procedure add-layout-elem :
     1900   define variable v-cmp as logical   no-undo .
     1901   define variable v-chip-num as integer no-undo .
     1902   define buffer buf_tt-layout-elem for tt-layout-elem.
     1903   define buffer buf_layout-elem for ub.layout-elem.
     1904   define buffer buf_layout-elem-rule for ub.layout-elem-rule.
     1905   define buffer buf_layout for ub.layout.
     1906   define buffer buf2_layout-elem-rule for ub.layout-elem-rule.
     1907   main-block:
     1908   do
     1909   on error undo, return error return-value
     1910   :
     1911     for each buf_tt-layout-elem
     1912     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1913     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1914     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1915     :
     1916       v-cmp = no.
     1917       find first buf_layout-elem where
     1918                buf_layout-elem.layout-type = buf_tt-layout-elem.layout-type
     1919            and buf_layout-elem.device-type = buf_tt-layout-elem.device-type
     1920            and buf_layout-elem.mode-id = buf_tt-layout-elem.mode-id
     1921            and buf_layout-elem.widget-id = buf_tt-layout-elem.widget-id no-error .
     1922       if not available buf_layout-elem then do:
     1923         create buf_layout-elem.
     1924         v-cmp = no.
     1925       end.
     1926       else do:
     1927         buffer-compare buf_tt-layout-elem to buf_layout-elem save result in v-cmp.
     1928       end.
     1929       if not v-cmp then do:
     1930         buffer-copy buf_tt-layout-elem to buf_layout-elem.
     1931       end.
     1932       if buf_tt-layout-elem.elem-type = integer('-1':U) then do:
     1933         for each buf_layout-elem-rule no-lock where
     1934                 buf_layout-elem-rule.mode-id = tt-layout-elem.mode-id
     1935             and buf_layout-elem-rule.widget-id = tt-layout-elem.widget-id
     1936           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1937           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1938           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1939           :
     1940           find first buf_layout share-lock where
     1941                    buf_layout.layout-id = buf_layout-elem-rule.layout-id
     1942                and buf_layout.layout-type = buf_layout-elem.layout-type
     1943                and buf_layout.device-type = buf_layout-elem.device-type no-error.
     1944           if available buf_layout
     1945           and buf_layout.is-default = integer('0':U)
     1946           then do:
     1947             run  layouth_create-layout_h  in this-procedure (
     1948                                                            input 'ИЗМЕНЕНИЕ':U
     1949                                                           ,input buf_layout.layout-id
     1950                                                           ,buffer buf_layout
     1951                                                           ,output v-chip-num).
     1952             if buf_layout.sts <> integer('99':U) then
     1953             assign
     1954             buf_layout.sts = integer('50':U)
     1955             .
     1956             find first buf2_layout-elem-rule exclusive-lock where
     1957                       recid(buf2_layout-elem-rule) = recid(buf_layout-elem-rule).
