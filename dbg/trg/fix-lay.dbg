     2336                 except layout-id
     2337                 to buf2_layout-elem-rule
     2338                 assign
     2339                 buf2_layout-elem-rule.layout-id = buf2_layout.layout-id
     2340                 buf2_layout-elem-rule.is-mandatory = integer('1':U)
     2341                 .
     2342                 run gen-key-rec in this-procedure ( input 'layout-elem-rule':U
     2343                                                     ,input (buffer  buf2_layout-elem-rule:handle)
     2344                                                     ,output v-ler-uniq-key-rec).
     2345                 buf2_layout-elem-rule.uniq-key-rec = v-ler-uniq-key-rec.
     2346                 find first buf_wi-mode no-lock where
     2347                           buf_wi-mode.mode-type = 'cd-IBS-TH':U
     2348                       and buf_wi-mode.mode-id  = buf2_layout-elem-rule.mode-id.
     2349                 find first buf_rule-by-call share-lock where
     2350                           buf_rule-by-call.call_id = buf2_layout-elem-rule.uniq-key-rec
     2351                       and buf_rule-by-call.codex_id = buf_wi-mode.codex_id
     2352                       and buf_rule-by-call.ruleset_id = buf_wi-mode.ruleset_id
     2353                       and buf_rule-by-call.order_id = 0 no-error.
     2354                 if not available buf_rule-by-call then do:
     2355                   run rul/g-callid.p (
     2356                                       input (if buf2_layout.is-default = integer('0':U)
     2357                                               then 'layout-elem-rule':U
     2358                                               else 'layout-elem-rule':U + chr(44) + "minus")
     2359                                       ,input buf2_layout-elem-rule.uniq-key-rec
     2360                                       ,output v-call#-id).
     2361                   create buf_rule-by-call.
     2362                   assign
     2363                   buf_rule-by-call.call_id = buf2_layout-elem-rule.uniq-key-rec
     2364                   buf_rule-by-call.call#_id = v-call#-id
     2365                   buf_rule-by-call.codex_id = buf_wi-mode.codex_id
     2366                   buf_rule-by-call.ruleset_id = buf_wi-mode.ruleset_id
     2367                   buf_rule-by-call.order_id = 0
     2368                   .
     2369                   run gen-key-rec in this-procedure ( input 'rule-by-call':U
     2370                                                       ,input (buffer  buf_rule-by-call:handle)
     2371                                                       ,output v-rbc-uniq-key-rec).
     2372                   buf_rule-by-call.uniq-key-rec = v-rbc-uniq-key-rec.
     2373                   .
     2374                 end.
     2375               end.
     2376             end.
     2377           end.
     2378         end.
     2379       end.
     2380     end.
     2381   end.
     2382   end procedure.
     2383   procedure add-wi-mode:
     2384   define variable v-cmp as logical   no-undo .
     2385   define buffer buf_tt-wi-mode for tt-wi-mode.
     2386   define buffer buf_wi-mode for ub.wi-mode.
     2387   main-block:
     2388   do
     2389   on error undo, return error return-value
     2390   :
     2391     for each buf_tt-wi-mode
     2392     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2393     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2394     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2395     :
     2396       v-cmp = no.
     2397       find first buf_wi-mode where
     2398                buf_wi-mode.mode-type = buf_tt-wi-mode.mode-type
     2399            and buf_wi-mode.mode-id = buf_tt-wi-mode.mode-id  no-error .
     2400       if not available buf_wi-mode then do:
     2401         create buf_wi-mode.
     2402         v-cmp = no.
     2403       end.
     2404       else do:
     2405         buffer-compare buf_tt-wi-mode to buf_wi-mode save result in v-cmp.
     2406       end.
     2407       if not v-cmp then do:
     2408         buffer-copy buf_tt-wi-mode to buf_wi-mode.
     2409       end.
     2410     end.
     2411   end.
     2412   end procedure.
     2413   procedure delete-wi-mode :
     2414   define variable v-chip-num as integer   no-undo .
     2415   define buffer buf_tt-wi-mode for tt-wi-mode.
     2416   define buffer buf_wi-mode for ub.wi-mode.
     2417   define buffer buf_layout-elem-rule for ub.layout-elem-rule.
     2418   define buffer buf2_layout-elem-rule for ub.layout-elem-rule.
     2419   define buffer buf_layout for ub.layout.
     2420   main-block:
     2421   do
     2422   on error undo, return error
     2423   :
     2424     for each buf_wi-mode share-lock
     2425     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2426     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2427     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2428     :
     2429       find first buf_tt-wi-mode where
     2430                 buf_tt-wi-mode.mode-type = buf_wi-mode.mode-type
     2431             and buf_tt-wi-mode.mode-id = buf_wi-mode.mode-id no-error.
     2432       if not available buf_tt-wi-mode
     2433       and buf_wi-mode.mode-type = 'cd-IBS-TH':U
     2434       then do:
     2435          for each buf_layout-elem-rule no-lock where
     2436                   buf_layout-elem-rule.mode-id = buf_wi-mode.mode-id
     2437           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2438           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2439           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2440          :
     2441              v-chip-num = -1.
     2442             find first buf_layout share-lock where
     2443                   buf_layout.layout-id = buf_layout-elem-rule.layout-id no-error.
     2444             if available buf_layout
     2445             then do:
     2446                run  layouth_create-layout_h  in this-procedure (
     2447                                                              input 'ИЗМЕНЕНИЕ':U
     2448                                                             ,input buf_layout.layout-id
     2449                                                             ,buffer buf_layout
     2450                                                             ,output v-chip-num).
     2451               if buf_layout.sts <> integer('99':U) then
     2452               assign
     2453               buf_layout.sts = integer('50':U)
     2454               .
     2455             end.
     2456             find first buf2_layout-elem-rule exclusive-lock where
     2457                     recid(buf2_layout-elem-rule) = recid(buf_layout-elem-rule).
     2458              if v-chip-num >= 0 then
     2459              run  layouth_create-layout-elem-rule_h  in this-procedure (
     2460                                                               input 'ИЗМЕНЕНИЕ':U
     2461                                                             ,input buf2_layout-elem-rule.layout-id
     2462                                                             ,input buf2_layout-elem-rule.mode-id
     2463                                                             ,input buf2_layout-elem-rule.widget-id
     2464                                                             ,buffer buf2_layout-elem-rule
     2465                                                             ,input v-chip-num).
     2466             assign
     2467             buf2_layout-elem-rule.sts = integer('1':U)
     2468             .
     2469          end.
     2470          delete buf_wi-mode.
     2471       end.
     2472     end.
     2473   end.
     2474   end procedure.
     2475   procedure delete-rule-by-set :
     2476   define buffer buf_tt-rule-by-set for tt-rule-by-set.
     2477   define buffer buf_rule-by-set for ub.rule-by-set.
     2478   main-block:
     2479   do
     2480   on error undo, return error
     2481   :
     2482     for each buf_rule-by-set share-lock
     2483     where buf_rule-by-set.codex_id = 19
     2484     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2485     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2486     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2487     :
     2488       find first buf_tt-rule-by-set where
     2489                 buf_tt-rule-by-set.codex_id = buf_rule-by-set.codex_id
     2490             and buf_tt-rule-by-set.ruleset_id = buf_rule-by-set.ruleset_id
     2491             and buf_tt-rule-by-set.rule_id = buf_rule-by-set.rule_id
     2492             no-error.
     2493       if not available buf_tt-rule-by-set
     2494       and buf_rule-by-set.codex_id = 19
     2495       then do:
     2496         delete buf_rule-by-set.
     2497       end.
     2498     end.
     2499   end.
     2500   end procedure.
