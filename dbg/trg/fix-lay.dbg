     2329                                                               ,input buf2_layout.layout-id
     2330                                                               ,input buf_tt-layout-elem-rule.mode-id
     2331                                                               ,input buf_tt-layout-elem-rule.widget-id
     2332                                                               ,buffer buf2_layout-elem-rule
     2333                                                               ,input v-chip-num).
