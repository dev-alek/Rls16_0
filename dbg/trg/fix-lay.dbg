        1   block-level on error undo, throw.
        2   define input parameter p-forced as logical no-undo .
        3   define input parameter p-read-only as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Приведение дефолтных раскладок, имеющихся в БД к эталонному виду".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure factord :
       81     define input  parameter p-fact-date            as date    no-undo .
       82     define input  parameter p-fact-time            as integer no-undo .
       83     define input  parameter p-fact-num             as integer no-undo .
       84     define input  parameter p-shift-date           as date    no-undo .
       85     define input  parameter p-shift-num            as integer no-undo .
       86     define input  parameter p-shift-on             as logical no-undo .
       87     define output parameter p-fact-order           as decimal no-undo .
       88     define output parameter p-shift-end-fact-order as decimal no-undo .
       89     define output parameter p-day-end-fact-order   as decimal no-undo .
       90     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
       91     if p-fact-date = ?
       92     then do:
       93       return error "Не указана фактическая дата" .
       94     end.
       95     define variable v-fact-date-num as integer no-undo .
       96     assign
       97       v-fact-date-num = integer(p-fact-date)
       98     .
       99     if p-fact-num = ?
      100     or p-fact-num = 0
      101     then do:
      102       return error "Не задан p-fact-num " + string(p-fact-num) .
      103     end.
      104     if p-fact-num < 0
      105     then do:
      106       return error "Отрицательный fact-num " + string(p-fact-num) .
      107     end.
      108     if p-fact-num >= 100000000
      109     then do:
      110       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      111     end.
      112     if p-shift-on = true
      113     then do:
      114       if p-shift-date = ?
      115       then do:
      116         return error "Не задана дата смены" .
      117       end.
      118       if p-shift-num = ?
      119       or p-shift-num = 0
      120       then do:
      121         return error "Не задан номер смены" .
      122       end.
      123     end.
      124     else do:
      125       assign
      126         p-shift-date = p-fact-date
      127         p-shift-num  = 24
      128       .
      129     end.
      130     define variable v-shift-offset as integer no-undo .
      131     if p-shift-date = p-fact-date
      132     then do:
      133       assign
      134         v-shift-offset = 1
      135       .
      136     end.
      137     if p-shift-date < p-fact-date
      138     then do:
      139       assign
      140         v-shift-offset = 0
      141       .
      142     end.
      143     if p-shift-date > p-fact-date
      144     then do:
      145       message
      146         vss-workfile vss-revision vss-description skip
      147         "Неправильная дата закрытия смены" skip
      148         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      149         view-as alert-box error .
      150       undo, return error
      151         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      152           ,string(p-fact-date, '99/99/9999':U)
      153           ,string(p-shift-date, '99/99/9999':U)
      154           )
      155       .
      156     end.
      157     if p-shift-num < 1
      158     or p-shift-num > 24
      159     then do:
      160       message
      161         vss-workfile vss-revision vss-description skip
      162         "Неправильный номер смены" skip
      163         "p-shift-num" p-shift-num skip
      164         view-as alert-box error .
      165       undo, return error return-value .
      166     end.
      167     assign
      168       p-fact-order           = v-fact-date-num
      169                              + v-shift-offset * 0.5
      170                              + p-shift-num    * 0.02 - 0.01
      171                              + p-fact-num     * 0.0000000001
      172       p-shift-end-fact-order = v-fact-date-num
      173                              + v-shift-offset * 0.5
      174                              + p-shift-num    * 0.02
      175       p-day-end-fact-order   = v-fact-date-num
      176                              + 0.99
      177     .
      178     if p-fact-order           <= v-fact-date-num
      179     or p-shift-end-fact-order <= v-fact-date-num
      180     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      181     or p-shift-end-fact-order >= p-day-end-fact-order
      182     then do:
      183       message
      184         vss-workfile vss-revision vss-description skip
      185         "Внутренняя ошибка при генерации фактического номера" skip
      186         "p-fact-date"            p-fact-date            skip
      187         "p-fact-time"            p-fact-time            skip
      188         "p-fact-num"             p-fact-num             skip
      189         "p-shift-date"           p-shift-date           skip
      190         "p-shift-num"            p-shift-num            skip
      191         "p-shift-on"             p-shift-on             skip
      192         "p-shift-end-fact-order" p-shift-end-fact-order skip
      193         "p-day-end-fact-order"   p-day-end-fact-order   skip
      194         "v-fact-date-num"        v-fact-date-num        skip
      195         view-as alert-box error .
      196       undo, return error return-value .
      197     end.
      198   end procedure.
      199   procedure day-begin-fact-order :
      200     define input  parameter p-fact-date            as date    no-undo .
      201     define output parameter p-day-begin-fact-order as decimal no-undo .
      202     do
      203     on error undo, return error return-value
      204     :
      205       if p-fact-date = ?
      206       then do:
      207         assign
      208           p-day-begin-fact-order = 0
      209         .
      210       end.
      211       else do:
      212         assign
      213           p-day-begin-fact-order = integer(p-fact-date)
      214         .
      215       end.
      216     end.
      217   end procedure.
      218   procedure factord-max-fact-order :
      219     define output parameter p-max-fact-order as decimal   no-undo .
      220     do
      221     on error undo, return error return-value
      222     :
      223       run day-begin-fact-order in this-procedure
      224         (input  date(1, 1, 5000)
      225         ,output p-max-fact-order
      226         ) .
      227     end.
      228   end procedure.
      229   procedure factord-cut-archive :
      230     define input  parameter p-obj-type             as character no-undo .
      231     define input  parameter p-obj-code             as integer   no-undo .
      232     define input  parameter p-fact-date            as date      no-undo .
      233     define output parameter p-shift-on             as logical   no-undo .
      234     define output parameter p-shift-date           as date      no-undo .
      235     define output parameter p-shift-num            as integer   no-undo .
      236     define output parameter p-day-end-fact-order   as decimal   no-undo .
      237     define output parameter p-shift-end-fact-order as decimal   no-undo .
      238     define variable v-fact-order as decimal   no-undo .
      239     define buffer buf_shift-obj for ub.shift-obj .
      240     do
      241     on error undo, return error return-value
      242     :
      243   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      245     (input  p-obj-type
      246     ,input  p-obj-code
      247     ,input  'shift-on=request'
      248     ,output p-shift-on
      249     ) no-error .
      250       if error-status :error
      251       then do:
      252         message
      253           vss-workfile vss-revision vss-description skip
      254           "Ошибка при определении атрибута объекта" skip
      255           "Объект" p-obj-type p-obj-code skip
      256           error-status :get-message(1) skip
      257           return-value skip
      258           view-as alert-box error .
      259         undo, return error return-value .
      260       end.
      261       if p-shift-on = false
      262       then do:
      263         assign
      264           p-shift-date               = ?
      265           p-shift-num                = 0
      266         .
      267       end.
      268       else do:
      269         find first buf_shift-obj share-lock
      270           where buf_shift-obj.obj-type   = p-obj-type
      271             and buf_shift-obj.obj-code   = p-obj-code
      272             and buf_shift-obj.shift-date > p-fact-date
      273           use-index pi
      274           no-error .
      275         if not available buf_shift-obj
      276         or buf_shift-obj.status_ <> 'зкр':U
      277         then do:
      278           message
      279             vss-workfile vss-revision vss-description skip
      280             "Невозможно вычислить последнюю смену" skip
      281             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      282             "Объект" p-obj-type p-obj-code skip
      283             "Дата" p-fact-date skip
      284             view-as alert-box error .
      285           undo, return error return-value .
      286         end.
      287         find last buf_shift-obj share-lock
      288           where buf_shift-obj.obj-type = p-obj-type
      289             and buf_shift-obj.obj-code = p-obj-code
      290             and buf_shift-obj.shift-date <= p-fact-date
      291           use-index pi
      292           no-error .
      293         if available buf_shift-obj
      294         then do:
      295           if  buf_shift-obj.status_ = 'зкр':U
      296           then do:
      297             assign
      298               p-shift-date = buf_shift-obj.shift-date
      299               p-shift-num  = buf_shift-obj.shift-num
      300             .
      301           end.
      302           else do:
      303             message
      304               vss-workfile vss-revision vss-description skip
      305               "Невозможно вычислить последнюю смену" skip
      306               "Статус смены отличен от статуса" 'зкр':U skip
      307               "Объект" p-obj-type p-obj-code skip
      308               "Дата" p-fact-date skip
      309               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      310               view-as alert-box error .
      311             undo, return error return-value .
      312           end.
      313         end.
      314         else do:
      315           assign
      316             p-shift-date = p-fact-date - 1
      317             p-shift-num  = 1
      318           .
      319         end.
      320       end.
      321       run factord in this-procedure
      322         (input  p-fact-date
      323         ,input  1
      324         ,input  1
      325         ,input  p-shift-date
      326         ,input  p-shift-num
      327         ,input  p-shift-on
      328         ,output v-fact-order
      329         ,output p-shift-end-fact-order
      330         ,output p-day-end-fact-order
      331         ) no-error .
      332       if error-status :error
      333       then do:
      334         message
      335           vss-workfile vss-revision vss-description skip
      336           "Ошибка при вызове процедуры factord"
      337           error-status :get-message(1) skip
      338           return-value skip
      339           view-as alert-box error .
      340         undo, return error return-value .
      341       end.
      342     end.
      343   end procedure.
      344   procedure factord-lock-shift :
      345     define input  parameter p-obj-type  as character no-undo .
      346     define input  parameter p-obj-code  as integer   no-undo .
      347     define input  parameter p-fact-date as date      no-undo .
      348     define parameter buffer buf_shift-obj for ub.shift-obj .
      349     define variable v-shift-on      as logical   no-undo .
      350     define variable v-extra-message as character no-undo .
      351     define variable v-error as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      357     (input  p-obj-type
      358     ,input  p-obj-code
      359     ,input  'shift-on=request'
      360     ,output v-shift-on
      361     ) no-error .
      362       if error-status :error
      363       then do:
      364         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      365         undo, return error v-error .
      366       end.
      367       if v-shift-on = true
      368       then do:
      369         find first buf_shift-obj share-lock
      370           where buf_shift-obj.obj-type   = p-obj-type
      371             and buf_shift-obj.obj-code   = p-obj-code
      372             and buf_shift-obj.shift-date > p-fact-date
      373           use-index pi
      374           no-error .
      375         if not available buf_shift-obj
      376         or buf_shift-obj.status_ <> 'зкр':U
      377         then do:
      378           find last buf_shift-obj
      379             where buf_shift-obj.obj-type = p-obj-type
      380               and buf_shift-obj.obj-code = p-obj-code
      381               and buf_shift-obj.status_  = 'зкр':U
      382             use-index stts
      383             no-error .
      384           if available buf_shift-obj
      385           then do:
      386             assign
      387               v-extra-message =
      388                     substitute("Дата начала последеней закрытой смены на объекте &1"
      389                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      390                               )
      391             .
      392           end.
      393           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      394           undo, return error v-error .
      395         end.
      396       end.
      397     end.
      398   end procedure.
      399   procedure factord-end-day :
      400     define input  parameter p-fact-date            as date    no-undo .
      401     define output parameter p-day-end-fact-order   as decimal no-undo .
      402     do
      403     on error undo, return error return-value
      404     :
      405       if p-fact-date = ?
      406       then do:
      407         return error "Не указана фактическая дата" .
      408       end.
      409       assign
      410         p-day-end-fact-order = integer(p-fact-date) + 0.99
      411       .
      412     end.
      413   end procedure.
      414   procedure factord-to-date :
      415     define input  parameter p-fact-order as decimal no-undo .
      416     define output parameter p-fact-date  as date    no-undo .
      417     define variable v-ref-date  as date      no-undo .
      418     define variable v-ref-delta as integer   no-undo .
      419     do
      420     on error undo, return error return-value
      421     :
      422       if p-fact-order = ?
      423       or p-fact-order = 0
      424       then do:
      425         return error "Не указан fact-order" .
      426       end.
      427       assign
      428         v-ref-date  = date(1, 1, 2000)
      429       .
      430       assign
      431         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      432       .
      433       assign
      434         p-fact-date = v-ref-date + v-ref-delta
      435       .
      436     end.
      437   end procedure.
      438   procedure factord-to-fact-num :
      439     define input  parameter p-fact-order as decimal no-undo .
      440     define output parameter p-fact-num   as integer no-undo .
      441     define variable v-fact-order-trunc as decimal no-undo .
      442     do
      443     on error undo, return error return-value
      444     :
      445       if p-fact-order = ?
      446       or p-fact-order = 0
      447       then do:
      448         return error "Не указан fact-order" .
      449       end.
      450       assign
      451        v-fact-order-trunc = truncate(p-fact-order, 2)
      452       .
      453       assign
      454         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      455       .
      456     end.
      457   end procedure.
      458   procedure factord-to-shift-num :
      459     define input  parameter p-fact-order as decimal no-undo .
      460     define output parameter p-shift-num   as integer no-undo .
      461     define variable  p-shift-numd  as decimal   no-undo .
      462     define variable v-fact-order-trunc as decimal no-undo .
      463     do
      464     on error undo, return error return-value
      465     :
      466       if p-fact-order = ?
      467       or p-fact-order = 0
      468       then do:
      469         return error "Не указан fact-order" .
      470       end.
      471       assign
      472        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      473       .
      474       if v-fact-order-trunc < 0.5 then do:
      475         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      476       end.
      477       assign
      478         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      479         .
      480        assign
      481         p-shift-num = truncate (p-shift-numd , 0)
      482       .
      483     end.
      484   end procedure.
      485   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      486   procedure cur-time :
      487      define output parameter p-today as date      no-undo .
      488      define output parameter p-time  as integer   no-undo .
      489     do
      490     on error undo, return error
      491     :
      492       define variable v-date1 as date      no-undo .
      493       define variable v-date2 as date      no-undo .
      494       define variable v-time  as integer   no-undo .
      495       assign
      496         v-date1 = today
      497         v-time  = time
      498         v-date2 = today
      499       .
      500       if v-date1 <> v-date2
      501       then do:
      502         assign
      503           v-date1 = today
      504           v-time  = v-time
      505         .
      506       end.
      507       assign
      508         p-today = v-date1
      509         p-time  = v-time
      510       .
      511     end.
      512   end.
      513   function cur-time-date returns character
      514   :
      515     return string(today, '99/99/9999':U) .
      516   end.
      517   function cur-time-mjd returns decimal
      518   :
      519     define variable v-date as date      no-undo .
      520     define variable v-time as integer   no-undo .
      521     run cur-time in this-procedure
      522       (output v-date
      523       ,output v-time
      524       ) .
      525     return integer(v-date) - 2400002 + (v-time / 86400) .
      526   end.
      527   function cur-time-get-ending-index returns integer
      528   (input p-number as integer
      529   )
      530   :
      531     if p-number < 0
      532     or p-number = ?
      533     then do:
      534       return 1 .
      535     end.
      536     define variable v-rest as integer   no-undo .
      537     assign
      538       p-number = p-number modulo 100
      539     .
      540     if p-number < 20
      541     then do:
      542       assign
      543         v-rest = p-number
      544       .
      545     end.
      546     else do:
      547       assign
      548         v-rest = p-number modulo 10
      549       .
      550     end.
      551     case v-rest :
      552       when 1
      553       then do:
      554         return 2 .
      555       end.
      556       when 2 or
      557       when 3 or
      558       when 4
      559       then do:
      560         return 3 .
      561       end.
      562       otherwise do:
      563         return 1 .
      564       end.
      565     end case .
      566   end.
      567   procedure cur-time-mjd-to-date :
      568      define input  parameter i-mjd-diff as decimal no-undo.
      569      define output parameter o-Date     as date    no-undo.
      570      define output parameter o-Time     as integer no-undo.
      571      define variable v-day-number as integer   no-undo .
      572      if    i-mjd-diff < 0
      573         or i-mjd-diff = ?
      574      then do:
      575         return "?" .
      576      end.
      577      assign
      578         v-day-number = truncate(i-mjd-diff,0).
      579         o-Date = date(v-day-number + 2400002).
      580         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      581     .
      582   end.
      583   function cur-time-mjd-to-string returns character
      584   (input p-mjd-diff as decimal
      585   )
      586   :
      587     define variable v-day-number as integer   no-undo .
      588     define variable v-seconds    as integer   no-undo .
      589     define variable v-hour       as integer   no-undo .
      590     define variable v-min        as integer   no-undo .
      591     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      592     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      593     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      594     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      595     if p-mjd-diff < 0
      596     or p-mjd-diff = ?
      597     then do:
      598       return "?" .
      599     end.
      600     assign
      601       v-day-number = integer(truncate(p-mjd-diff,0))
      602       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      603     .
      604     if v-seconds > 86400
      605     then do:
      606       assign
      607         v-seconds = 86400 - 1
      608       .
      609     end.
      610     if v-seconds < 0
      611     then do:
      612       assign
      613         v-seconds = 0
      614       .
      615     end.
      616     assign
      617       v-hour = truncate(v-seconds / 3600, 0)
      618     .
      619     assign
      620       v-seconds = v-seconds modulo 3600
      621     .
      622     assign
      623       v-min = truncate(v-seconds / 60, 0)
      624     .
      625     assign
      626       v-seconds = v-seconds modulo 60
      627     .
      628     return
      629         (if v-day-number <> 0
      630           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      631           else ""
      632         )
      633       + (if v-day-number <> 0 or v-hour <> 0
      634           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      635           else ""
      636         )
      637       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      638           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      639           else ""
      640         )
      641       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      642       .
      643   end.
      644   function cur-time-string returns character
      645   :
      646     define variable v-date as date      no-undo .
      647     define variable v-time as integer   no-undo .
      648     run cur-time in this-procedure
      649       (output v-date
      650       ,output v-time
      651       ) .
      652     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      653   end.
      654   function cur-time-string-sec returns character
      655   :
      656     define variable v-date as date      no-undo .
      657     define variable v-time as integer   no-undo .
      658     run cur-time in this-procedure
      659       (output v-date
      660       ,output v-time
      661       ) .
      662     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      663   end.
      664   function cur-time-custom  returns character
      665   (input p-prefix as character
      666   ,input p-date-format as character
      667   ,input p-delimiter as character
      668   ,input p-time-format as character
      669   ,input p-suffix as character
      670   )
      671   :
      672     define variable v-date as date      no-undo .
      673     define variable v-time as integer   no-undo .
      674     run cur-time in this-procedure
      675       (output v-date
      676       ,output v-time
      677       ) .
      678     return
      679       p-prefix
      680       + string(v-date, p-date-format)
      681       + p-delimiter
      682       + string(v-time, p-time-format)
      683       + p-suffix
      684       .
      685   end.
      686   function cur-time-print  returns character
      687   :
      688     define variable v-date as date      no-undo .
      689     define variable v-time as integer   no-undo .
      690     run cur-time in this-procedure
      691       (output v-date
      692       ,output v-time
      693       ) .
      694     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      695   end.
      696   function cur-time-datetime returns datetime
      697   :
      698     define variable v-char as character no-undo .
      699     define variable v-datetime as datetime no-undo .
      700     v-char = cur-time-string().
      701     v-datetime = datetime(v-char).
      702     return  v-datetime.
      703   end.
      704   function cur-time-string-msec returns character
      705   :
      706     define variable v-date as datetime  no-undo .
      707     v-date = now.
      708     return string(v-date) .
      709   end.
      710   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      711   define variable v-waitfram-action01         as character   no-undo .
      712   define variable v-waitfram-action02         as character   no-undo .
      713   define variable v-waitfram-action03         as character   no-undo .
      714   define variable mWaitFramTextBeg            as character   no-undo.
      715   define variable mWaitFramTextEnd            as character   no-undo.
      716   define variable mWaitFramView               as logical     no-undo.
      717   define variable mWaitProcEvent              as logical     no-undo init yes.
      718   define variable mWaitFramInterval           as integer     no-undo init 1 .
      719   define variable mWaitFramStop               as logical     no-undo.
      720   define variable mWaitFramStopUser           as logical     no-undo.
      721   define variable mWaitFramStopTimeOut        as logical     no-undo.
      722   define variable mWaitFramStartProc          as datetime-tz no-undo.
      723   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      724   define button B-WaitFramStop auto-end-key
      725        label "Стоп"
      726        size 10 by 1 tooltip "Остоновить процесс".
      727   define button B-viewProcInfo
      728        label "Информация"
      729        size 15 by 1 tooltip "Информация о процесс".
      730   define frame waitfram
      731     v-waitfram-action01 format "x(72)" no-label skip
      732     v-waitfram-action02 format "x(72)" no-label skip
      733     v-waitfram-action03 format "x(72)" no-label skip
      734     B-viewProcInfo
      735     B-WaitFramStop at row 4 col 30
      736     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      737     .
      738   define new global shared variable mBatchMode as logical no-undo init ?.
      739   define variable mFramBachModHandle as handle no-undo.
      740   mFramBachModHandle = frame waitfram:handle.
      741   define variable mFameOldVis as logical no-undo.
      742   define variable mVisCUrentVin as logical no-undo.
      743   if session:batch-mode
      744   then
      745      mBatchMode = yes.
      746   if mBatchMode = ? then do:
      747     mVisCUrentVin = current-window:visible.
      748     mFameOldVis = mFramBachModHandle:visible.
      749     mFramBachModHandle:visible  = yes.
      750     mBatchMode = mFramBachModHandle:visible ne yes.
      751     mFramBachModHandle:visible = mFameOldVis.
      752     current-window:visible = mVisCUrentVin.
      753   end.
      754    if  log-manager:logfile-name ne ?
      755     then DO:
      756         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      757         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      758         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      759     end.
      760   on choose of B-WaitFramStop in frame waitfram
      761   do:
      762     mWaitFramStop = yes.
      763     mWaitFramStopUser = yes.
      764   end.
      765   function waitfram-check-timeout returns logical():
      766      define variable vtime as int64 no-undo.
      767      if mWaitFramStopTimeOut
      768      then
      769         return yes.
      770      vtime = ( now - mWaitFramStartProc ) / 1000 .
      771      if     mWaitFramTimeOut ne ?
      772         and mWaitFramTimeOut ne 0
      773         and mWaitFramTimeOut lt vtime
      774      then do:
      775         mWaitFramStopTimeOut = yes.
      776      end.
      777      return mWaitFramStopTimeOut.
      778   end.
      779   procedure waitfram-hide :
      780     if not session:batch-mode
      781     then do
      782     on error undo, return error return-value
      783     :
      784       pause 0 before-hide .
      785       if not mBatchMode then
      786         hide frame waitfram .
      787     if     not mWaitFramView
      788        and mWaitProcEvent
      789     then
      790       process events .
      791     end.
      792   end procedure.
      793   procedure waitfram-show :
      794     define input  parameter p-message as character no-undo .
      795     define variable v-left-margin as integer   no-undo .
      796     if not session:batch-mode
      797     then do
      798     on error undo, return error return-value
      799     :
      800       if length(p-message) <= 70 then do:
      801         assign
      802           v-left-margin = integer((70 - length(p-message)) / 2)
      803         .
      804         assign
      805           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      806         .
      807         assign
      808           v-waitfram-action01 = " "
      809           v-waitfram-action02 = " "
      810                                    + fill(" ", v-left-margin)
      811                                    + p-message
      812           v-waitfram-action03 = " "
      813         .
      814       end.
      815       else do:
      816         define variable vRindex1 as integer no-undo.
      817         define variable vRindex2 as integer no-undo.
      818         vRindex1 = r-index(p-message," ",70).
      819         if vRindex1 = 0
      820         then
      821            vRindex1 = 70.
      822         if length(p-message)  <= vRindex1 + 70 then do:
      823           assign
      824             v-waitfram-action01 = " "
      825             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      826             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      827           .
      828         end.
      829         else do:
      830           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      831           if vRindex2 <= vRindex1
      832           then
      833              vRindex2 = vRindex1 + 70.
      834           assign
      835             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      836             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      837             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      838           .
      839         end.
      840       end.
      841       B-viewProcInfo:visible   in frame waitfram = no.
      842       B-viewProcInfo:sensitive in frame waitfram = no.
      843       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      844       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      845       if  (   mWaitFramView
      846          or  mWaitProcEvent)
      847          and not mBatchMode
      848       then
      849          display
      850             v-waitfram-action01 skip
      851             v-waitfram-action02 skip
      852             v-waitfram-action03 skip
      853          with frame waitfram .
      854       if     mWaitFramView
      855          then do:
      856             if     mWaitFramInterval ne ?
      857                and not mBatchMode
      858             then
      859                wait-for go of frame waitfram pause mWaitFramInterval.
      860          end.
      861          else
      862             if     mWaitProcEvent
      863                and not mBatchMode
      864             then
      865                process events .
      866     end.
      867   end procedure.
      868      procedure waitfram-show-this:
      869         define input  parameter iInterval as int64 no-undo.
      870         define variable vtime as int64 no-undo.
      871         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      872         mWaitFramInterval = iInterval.
      873         run waitfram-show (substitute("&1&2 &3&4" ,
      874                                       mWaitFramTextBeg ,
      875                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      876                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      877                                       mWaitFramTextEnd
      878                                      )
      879                           ).
      880      end.
      881      procedure WaitFramRunPause:
      882         define input  parameter iInterval as dec no-undo.
      883         define variable vStart  as datetime-tz no-undo.
      884         define variable vend    as datetime-tz no-undo.
      885         define variable vint as int64 no-undo.
      886         define variable vOk as logical no-undo.
      887         vStart = now.
      888         vend   = vStart.
      889         publish "WaitFramPause" (iInterval,output vOk).
      890         vend   =  now.
      891         vint = vend - vStart.
      892         vint = iInterval - vint / 1000.
      893         if     not mWaitFramStop
      894            and (   vint > 0
      895                 or (    not vOk
      896                     and iInterval eq ?
      897                     )
      898                 )
      899         then
      900            run waitfram-show-this (iInterval).
      901         vend   =  now.
      902         vint = vend - vStart.
      903         vint = iInterval - vint / 1000.
      904         if     not mWaitFramStop
      905            and vint > 0
      906         then do:
      907            run gbl/pause.p (vint * 1000).
      908         end.
      909         if iInterval ne ?
      910         then
      911            publish "WaitFramStop".
      912         waitfram-check-timeout().
      913      end.
      914      procedure WaitFramWaitFor:
      915         define input  parameter iInterval as dec no-undo.
      916         assign
      917            mWaitFramStartProc   = now
      918            mWaitFramStopUser    = no
      919            mWaitFramStopTimeOut = no
      920         .
      921         block-wait:
      922         do while not mWaitFramStop:
      923            run WaitFramRunPause (iInterval).
      924            if  waitfram-check-timeout()
      925            then do:
      926               leave block-wait.
      927            end.
      928         end.
      929         run waitfram-hide.
      930      end.
      931   procedure waitfram-join :
      932     define input  parameter p-line-1  as character no-undo .
      933     define input  parameter p-line-2  as character no-undo .
      934     define input  parameter p-line-3  as character no-undo .
      935     define output parameter p-message as character no-undo .
      936     do
      937     on error undo, return error return-value
      938     :
      939       assign
      940         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      941                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      942                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      943       .
      944     end.
      945   end procedure.
      946   function waitfram-join-function returns character
      947     (input p-line-1 as character
      948     ,input p-line-2 as character
      949     ,input p-line-3 as character
      950     ).
      951     define variable v-message as character no-undo .
      952     run waitfram-join in this-procedure
      953       (input  p-line-1
      954       ,input  p-line-2
      955       ,input  p-line-3
      956       ,output v-message
      957       ) .
      958     return v-message .
      959   end function .
      960   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      961   procedure check-layout-version :
      962   define output parameter p-check as logical no-undo .
      963   define variable v-dopi1 as integer no-undo .
      964   define variable v-dopi2 as integer no-undo .
      965   define variable v-dopi3 as integer no-undo .
      966   define variable v-dopi4 as integer no-undo .
      967   define buffer buf_layout for ub.layout .
      968     do
      969     on error undo, return error
      970     :
      971       find first buf_layout no-lock where
      972                 buf_layout.layout-id = '_'  no-error.
      973       if (not available buf_layout
      974       or buf_layout.layout-name <> "v15_1.11" )
      975       then do:
      976         assign
      977         v-dopi1 = integer(entry(2, buf_layout.layout-name,  "."))
      978         v-dopi2 = integer(entry(2, "v15_1.11", "."))
      979         v-dopi3 = integer(entry(2, entry(1, buf_layout.layout-name, "."), "_"))
      980         v-dopi4 = integer(entry(2, entry(1, "v15_1.11", "."), "_"))
      981         no-error .
      982         if error-status:error
      983         or v-dopi2 > v-dopi1
      984         or v-dopi4 > v-dopi3
      985         or left-trim(entry(1, buf_layout.layout-name, "."), "v":U) < "15"
      986         then do:
      987           assign
      988           p-check = yes.
      989         end.
      990       end.
      991     end.
      992   end procedure.
      993   procedure get-layout-version :
      994   define output parameter p-layout-version as character no-undo init ?.
      995   define buffer buf_layout for ub.layout .
      996   do
      997   on error undo, return error
      998   :
      999     find first buf_layout no-lock where
     1000                 buf_layout.layout-id = '_'  no-error.
     1001     if available buf_layout then do:
     1002       p-layout-version = buf_layout.layout-name.
     1003     end.
     1004   end.
     1005   end procedure.
