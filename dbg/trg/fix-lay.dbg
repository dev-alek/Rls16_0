     2207                                                             ,input buf_tt-layout.layout-id
     2208                                                             ,buffer buf_layout
     2209                                                             ,output v-chip-num).
     2210             end.
     2211             run  layouth_create-rule-call-param_h  in this-procedure (
     2212                                                             input 'удаление':U
     2213                                                           ,input buf_rule-call-param.call#_id
     2214                                                           ,input buf_rule-call-param.codex_id
     2215                                                           ,input buf_rule-call-param.ruleset_id
     2216                                                           ,input buf_rule-call-param.order_id
     2217                                                           ,input buf_rule-call-param.param-name
     2218                                                           ,input buf_rule-call-param.p-index
     2219                                                           ,input buf_rule-call-param.call_id
     2220                                                           ,buffer buf_rule-call-param
     2221                                                           ,input v-chip-num).
     2222           end.
     2223         end.
     2224       end.
     2225       for each buf_layout-elem-rule where
