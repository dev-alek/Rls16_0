     2284       if buf_tt-layout.is-default = integer('-1':U) then do:
     2285         for each buf2_layout no-lock where
     2286                 buf2_layout.layout-type = buf_tt-layout.layout-type
     2287             and buf2_layout.device-type = buf_tt-layout.device-type:
