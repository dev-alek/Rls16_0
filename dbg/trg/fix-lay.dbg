     1007   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   define new shared temp-table temp-tables no-undo
     1009   field tbl-name as character
     1010   field buf-handle as handle
     1011   field tbl-handle as handle
     1012   index pi is unique primary
     1013   tbl-name.
