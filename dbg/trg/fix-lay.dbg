     2227       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2228       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2229       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
     2230         find first buf_tt-layout-elem-rule where
