        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.inv-line NEW BUFFER newb OLD BUFFER oldb.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Триггер на запись итогов по топливным товарам":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character no-undo format "x(65)":U initial "@(#)$Workfile$ $Revision$":U.
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure valid-ren-art-tbl-list :
       81     do
       82     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       83     on stop   undo, return error substitute( "&1. stop", vss-workfile )
       84     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
       85     :
       86       define variable v-std-list        as character no-undo .
       87       define variable v-ignore-list     as character no-undo .
       88       define variable v-special-list    as character no-undo .
       89       assign
       90         v-std-list     = "cli-gds,cli-gds-attr,cli-art,cli-art-attr,contract-specif,c-contract-specif,doc-line,c-doc-line,fbr-line,c-fbr-line,fbr-recipe,fbr-recipe-gds,fbr-pln-line,c-fbr-pln-line,gds-dtl,c-gds-dtl,gds-dtl-attr,c-gds-dtl-attr,gds-obj,inv-line,inv-line-attr,c-inv-line,ot-supp-line,ot-supp-line-attr,ot-line-attr,ord-line,c-ord-line,ord-line-rcv,ord-dtl,c-ord-dtl,ord-dtl-attr,ord-dtl-rcv,ord-dtl-cons,ord-gds-cons,prt-obj,prt-obj-attr,parts,c-parts,parts-supp,parts-supp-attr,price-list,c-price-list,price-doc-forming-gds,c-price-doc-forming-gds,price-doc-forming-gds-qnty,c-price-doc-forming-gds-qnty,price-doc-forming-gds-sum,c-price-doc-forming-gds-sum,price-doc-forming-gds-tnv,c-price-doc-forming-gds-tnv,recipe,recipe-gds,c-recipe,c-recipe-gds,c-recipe-hist,stk-supp-line,stk-supp-line-attr,stk-line-attr,tmp-sale-dtl,tmp-sale-dtl-attr,tmp-sale-gds,tmp-sale-gds-attr":U
       91         v-ignore-list  = "c-goods,c-order-line":U
       92         v-special-list = "goods,ot-line,stk-line,order-line":U
       93       .
       94   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95       define variable v-ind         as integer   no-undo .
       96       define variable v-num-entries as integer   no-undo .
       97       define variable v-inform      as character no-undo .
       98       define variable bh_tbl-name   as handle    no-undo .
       99       define variable v-tbl-not-idx as character no-undo .
      100       define variable v-idx-avail   as logical   no-undo .
      101       define variable new-tbl-list  as character no-undo .
      102       define variable old-tbl-list  as character no-undo .
      103       define variable old-tbl-avail as logical   no-undo .
      104       define variable v-double-tbl  as character no-undo .
      105       define variable v-tbl-name    as character no-undo .
      106       define variable v-msg         as character no-undo .
      107       assign
      108         v-msg         = "":U
      109         v-tbl-not-idx = "":U
      110         new-tbl-list  = "":U
      111       .
      112       for each ub._Field no-lock
      113         where ub._Field._Field-Name = 'artic':U
      114       ,first ub._File of ub._Field
      115       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      116       :
      117         if  lookup( ub._File._File-Name, v-std-list     ) = 0
      118         and lookup( ub._File._File-Name, v-ignore-list  ) = 0
      119         and lookup( ub._File._File-Name, v-special-list ) = 0
      120         then do:
      121           assign
      122             new-tbl-list = new-tbl-list + chr(10) + ub._File._File-Name
      123           .
      124         end.
      125         if lookup( ub._File._File-Name, v-std-list ) <> 0
      126           or lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0
      127         then do:
      128           create buffer bh_tbl-name for table substitute( "ub.&1":U, ub._File._File-Name ) .
      129           assign
      130             v-idx-avail = false
      131             v-inform    = bh_tbl-name:index-information(1)
      132             v-ind       = 2
      133           .
      134           block_chk-idx:
      135           do while v-inform <> ?
      136           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      137           :
      138             if v-inform <> ?
      139                 and lookup( entry( 5, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
      140                 and lookup( entry( 7, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
      141                 and lookup( entry( 9, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
      142             then do:
      143               assign
      144                 v-idx-avail = true
      145               .
      146               leave block_chk-idx.
      147             end.
      148             assign
      149               v-inform = bh_tbl-name:index-information( v-ind )
      150               v-ind    = v-ind + 1
      151             .
      152           end.
      153           if v-idx-avail = false then do:
      154             if lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0 then do:
      155               assign
      156                 new-tbl-list = new-tbl-list + " (индекса нет)"
      157               .
      158             end.
      159             else do:
      160               assign
      161                 v-tbl-not-idx = v-tbl-not-idx + chr(10) + ub._File._File-Name
      162               .
      163             end.
      164           end.
      165           delete object bh_tbl-name.
      166         end.
      167       end.
      168       assign
      169         old-tbl-list  = "":U
      170         v-double-tbl  = "":U
      171         v-num-entries = num-entries( v-std-list )
      172       .
      173       do v-ind = 1 to v-num-entries
      174       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      175       :
      176         assign
      177           v-tbl-name    = entry( v-ind, v-std-list )
      178           old-tbl-avail = false
      179         .
      180         find first ub._File no-lock
      181           where ub._File._File-Name = v-tbl-name
      182           no-error .
      183         if not available ub._File then do:
      184           assign
      185             old-tbl-avail = true
      186           .
      187         end.
      188         else do:
      189           find first ub._Field no-lock
      190             where ub._Field._File-recid = recid( ub._File )
      191               and ub._Field._Field-Name = 'artic':U
      192             no-error .
      193           if not available ub._Field then do:
      194             assign
      195               old-tbl-avail = true
      196             .
      197           end.
      198             find first ub._Field no-lock
      199               where ub._Field._File-recid = recid( ub._File )
      200                 and ub._Field._Field-Name = "prod-type"
      201               no-error .
      202             if not available ub._Field then do:
      203               assign
      204                 old-tbl-avail = true
      205               .
      206             end.
      207             find first ub._Field no-lock
      208               where ub._Field._File-recid = recid( ub._File )
      209                 and ub._Field._Field-Name = "prod-code"
      210               no-error .
      211             if not available ub._Field then do:
      212               assign
      213                 old-tbl-avail = true
      214               .
      215             end.
      216         end.
      217         if old-tbl-avail = true then do:
      218           assign
      219             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
      220           .
      221         end.
      222         if ( lookup( v-tbl-name, v-std-list ) > v-ind
      223              or lookup( v-tbl-name, v-ignore-list ) > 0
      224              or lookup( v-tbl-name, v-special-list ) > 0
      225            )
      226           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
      227         then do:
      228           assign
      229             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
      230           .
      231         end.
      232       end.
      233       assign
      234         v-num-entries = num-entries( v-ignore-list )
      235       .
      236       do v-ind = 1 to v-num-entries
      237       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      238       :
      239         assign
      240           v-tbl-name = entry( v-ind, v-ignore-list )
      241           old-tbl-avail = false
      242         .
      243         find first ub._File no-lock
      244           where ub._File._File-Name = v-tbl-name
      245           no-error .
      246         if not available ub._File then do:
      247           assign
      248             old-tbl-avail = true
      249           .
      250         end.
      251         else do:
      252           find first ub._Field no-lock
      253             where ub._Field._File-recid = recid( ub._File )
      254               and ub._Field._Field-Name = 'artic':U
      255             no-error .
      256           if not available ub._Field then do:
      257             assign
      258               old-tbl-avail = true
      259             .
      260           end.
      261             find first ub._Field no-lock
      262               where ub._Field._File-recid = recid( ub._File )
      263                 and ub._Field._Field-Name = "prod-type"
      264               no-error .
      265             if not available ub._Field then do:
      266               assign
      267                 old-tbl-avail = true
      268               .
      269             end.
      270             find first ub._Field no-lock
      271               where ub._Field._File-recid = recid( ub._File )
      272                 and ub._Field._Field-Name = "prod-code"
      273               no-error .
      274             if not available ub._Field then do:
      275               assign
      276                 old-tbl-avail = true
      277               .
      278             end.
      279         end.
      280         if old-tbl-avail = true then do:
      281           assign
      282             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
      283           .
      284         end.
      285         if ( lookup( v-tbl-name, v-std-list ) > 0
      286              or lookup( v-tbl-name, v-ignore-list ) > v-ind
      287              or lookup( v-tbl-name, v-special-list ) > 0
      288            )
      289           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
      290         then do:
      291           assign
      292             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
      293           .
      294         end.
      295       end.
      296       assign
      297         v-num-entries = num-entries( v-special-list )
      298       .
      299       do v-ind = 1 to v-num-entries
      300       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      301       :
      302         assign
      303           v-tbl-name = entry( v-ind, v-special-list )
      304         .
      305         find first ub._File no-lock
      306           where ub._File._File-Name = v-tbl-name
      307           no-error .
      308         if available ub._File then do:
      309           find first ub._Field no-lock
      310             where ub._Field._File-recid = recid( ub._File )
      311               and ub._Field._Field-Name = 'artic':U
      312             no-error .
      313         end.
      314         if not available ub._File
      315           or ( available ub._File
      316                and not available ub._Field
      317              )
      318         then do:
      319           assign
      320             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
      321           .
      322         end.
      323         if ( lookup( v-tbl-name, v-std-list ) > 0
      324              or lookup( v-tbl-name, v-ignore-list ) > 0
      325              or lookup( v-tbl-name, v-special-list ) > v-ind
      326            )
      327           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
      328         then do:
      329           assign
      330             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
      331           .
      332         end.
      333       end.
      334       if v-tbl-not-idx <> "" then do:
      335         assign
      336           v-msg = v-msg + substitute( "Таблицы не имеют индекса с полями &3 на первом месте и нет спецобработки: &2&1&1", chr(10), v-tbl-not-idx, 'artic, prod-type, prod-code':U )
      337         .
      338       end.
      339       if new-tbl-list <> "":U then do:
      340         assign
      341           v-msg = v-msg + substitute( "Нет обработки таблиц: &2&1&1", chr(10), new-tbl-list )
      342         .
      343       end.
      344       if v-double-tbl <> "":U then do:
      345         assign
      346           v-msg = v-msg + substitute( "В списках есть задублированные таблицы: &2&1&1", chr(10), v-double-tbl )
      347         .
      348       end.
      349       if old-tbl-list <> "":U then do:
      350         assign
      351           v-msg = v-msg + substitute( "В списках есть несуществующие таблицы или таблицы в которых отсутствуют переименовываемые поля: &2&1&1", chr(10), old-tbl-list )
      352         .
      353       end.
      354       if v-msg <> "":U then do:
      355         return error substitute( "Утилита переименования &3 не корректна.&1&1&2", chr(10), v-msg, 'artic, prod-type, prod-code':U ) .
      356       end.
      357     end.
      358   end procedure.
      359   procedure check-use-artic :
      360     define input  parameter p-tbl-name  as   character                      no-undo .
      361     define input  parameter p-artic     like ub.goods.artic     no-undo .
      362     define input  parameter p-prod-type like ub.goods.prod-type no-undo .
      363     define input  parameter p-prod-code like ub.goods.prod-code no-undo .
      364     do
      365     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      366     on stop   undo, return error substitute( "&1. stop",   vss-include-info0 )
      367     on endkey undo, return error substitute( "&1. endkey", vss-include-info0 )
      368     :
      369       define buffer buf_goods for ub.goods .
      370       if lookup( p-tbl-name, "c-goods,c-order-line":U ) = 0 then do:
      371         find first buf_goods no-lock
      372           where buf_goods.artic     = p-artic
      373             and buf_goods.prod-type = p-prod-type
      374             and buf_goods.prod-code = p-prod-code
      375           no-error .
      376         if not available buf_goods then do:
      377           return error substitute( "&1 (check-use-artic). Не найден товар с артикулом &2 и производителем &3 &4", vss-include-info0, p-artic, p-prod-type, p-prod-code ) .
      378         end.
      379         if buf_goods.stts = integer('51':U) then do:
      380           return error substitute( "&1 (check-use-artic). Нельзя использовать товар с артикулом &2 и производителем &3 &4&5"
      381                                   + "Выполняется переименование артикула и(или) производителя"
      382                                   ,vss-include-info0
      383                                   ,p-artic
      384                                   ,p-prod-type
      385                                   ,p-prod-code
      386                                   ,chr(10)
      387                                 ) .
      388         end.
      389       end.
      390       return .
      391     end.
      392   end procedure.
      393   do
      394   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      395   on stop   undo, return error substitute( "&1. stop", vss-workfile )
      396   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      397   :
      398       if g#oxml = yes
      399       then do:
      400       run str/calloxml.p (
      401             input 'update':U
      402           , input 'inv-line':U
      403           , input ( buffer ub.inv-line:handle )
      404       ) no-error.
      405       if error-status :error
      406       then do:
      407           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      408                                , chr(10)
      409                                , vss-workfile
      410                                , return-value
      411                                , error-status :get-message ( 1 ) ).
      412       end.
      413       end.
      414   end.
