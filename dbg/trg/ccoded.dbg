        1   block-level on error undo, throw.
        2   trigger procedure for delete of ub.c-code.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo init "Тригер удаления c-code".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   procedure gen-key-rec :
      305     define input  parameter p-tbl-name    as character no-undo.
      306     define input  parameter p-bh_tbl-name as handle    no-undo.
      307     define output parameter p-key-rec     as character no-undo.
      308     do
      309     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      310     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      311     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      312     :
      313       define variable fh               as handle    no-undo .
      314       define variable v-ok             as logical   no-undo .
      315       define variable v-inform         as character no-undo .
      316       define variable v-ind            as integer   no-undo .
      317       define variable v-idx-field-qnty as integer   no-undo .
      318       if p-tbl-name = ?
      319         or p-tbl-name = "":U
      320       then do:
      321         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      322       end.
      323       if not p-bh_tbl-name:available then do:
      324         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      325       end.
      326       assign
      327         p-key-rec = p-tbl-name
      328         v-inform  = p-bh_tbl-name:index-information(1)
      329         v-ind     = 2
      330       .
      331       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      332       on error undo, return error
      333       :
      334         assign
      335           v-inform = p-bh_tbl-name:index-information( v-ind )
      336           v-ind    = v-ind + 1
      337         .
      338       end.
      339       if v-inform = ?
      340         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      341         or entry( 3, v-inform, ",":U ) <> "1":U
      342       then do:
      343         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      344       end.
      345       else do:
      346         assign
      347           v-idx-field-qnty = num-entries( v-inform ) - 4
      348         .
      349         if v-idx-field-qnty < 2 then do:
      350           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      351         end.
      352         do v-ind = 1 to v-idx-field-qnty by 2
      353         on error undo, return error
      354         :
      355           assign
      356             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      357             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      358           .
      359         end.
      360       end.
      361       if p-key-rec = ? then do:
      362         assign
      363           p-key-rec = "":U
      364         .
      365         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      366       end.
      367     end.
      368     return.
      369   end procedure.
      370   procedure gen-where-keyr-tab :
      371     define input  parameter i-tableSerach as character no-undo.
      372     define input  parameter i-tablekey   as character  no-undo.
      373     define input  parameter p-key-rec    as character  no-undo.
      374     define input  parameter p-key-handle as handle     no-undo .
      375     define input  parameter p-db-name    as character  no-undo .
      376     define input  parameter p-tt-handle  as handle     no-undo .
      377     define output parameter o-Where      as character  no-undo.
      378     do
      379     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      380     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      381     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      382     :
      383       define variable v-full-tbl-name  as character no-undo .
      384       define variable bh_tbl-name      as handle    no-undo .
      385       define variable fh_key           as handle    no-undo .
      386       define variable fh_search        as handle    no-undo .
      387       define variable v-field-num      as integer   no-undo .
      388       define variable v-count-fld      as integer   no-undo .
      389       define variable v-inform         as character no-undo .
      390       define variable v-ind            as integer   no-undo .
      391       define variable v-idx-field-qnty as integer   no-undo .
      392       define variable v-field-name     as character no-undo .
      393       define variable v-field-val      as character no-undo .
      394       define variable v-word-link      as character no-undo .
      395       define variable vTable           as character no-undo.
      396       define variable bh_tbl-key       as handle    no-undo .
      397       assign
      398         p-key-rec = trim( p-key-rec )
      399       .
      400       if p-key-handle <> ? then do:
      401         if not valid-handle(p-key-handle)
      402            or p-key-handle:type <> "buffer"
      403         then do:
      404           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      405         end.
      406         if num-entries( p-key-rec, chr(3) ) > 1
      407           or p-key-rec = ?
      408           or p-key-rec = "":U
      409         then do:
      410           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      411         end.
      412       end.
      413       else do:
      414         if p-key-rec = ?
      415           or p-key-rec = "":U
      416         then do:
      417           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      418         end.
      419       end.
      420       assign
      421         vTable = entry( 1 , p-key-rec, chr(3) )
      422       .
      423       if p-tt-handle <> ?
      424         and ( not valid-handle(p-tt-handle)
      425               or p-tt-handle:type <> "buffer"
      426             )
      427       then do:
      428         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      429       end.
      430       if p-tt-handle = ? then do:
      431         assign
      432           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      433         .
      434         create buffer bh_tbl-name for table v-full-tbl-name .
      435       end.
      436       else do:
      437         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      438       end.
      439       assign
      440         v-inform = bh_tbl-name:index-information(1)
      441         v-ind    = 2
      442       .
      443       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      444       on error undo, return error
      445       :
      446         assign
      447           v-inform = bh_tbl-name:index-information( v-ind )
      448           v-ind    = v-ind + 1
      449         .
      450       end.
      451       if v-inform = ?
      452         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      453         or entry( 3, v-inform, ",":U ) <> "1":U
      454       then do:
      455         delete object bh_tbl-name no-error.
      456         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      457       end.
      458       assign
      459         v-idx-field-qnty = num-entries( v-inform ) - 4
      460       .
      461       if v-idx-field-qnty < 2 then do:
      462         delete object bh_tbl-name no-error.
      463         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      464       end.
      465       assign
      466         o-where     = "where":U
      467         v-word-link = "":U
      468         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      469         v-count-fld = 0
      470       .
      471       if i-tablekey ne "" and i-tablekey ne ?
      472       then do:
      473         assign
      474           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      475         .
      476         create buffer bh_tbl-key for table v-full-tbl-name .
      477       end.
      478       if i-tableSerach ne "" and i-tableSerach ne ?
      479       then do:
      480         delete object bh_tbl-name no-error.
      481         assign
      482           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      483         .
      484         create buffer bh_tbl-name for table v-full-tbl-name .
      485       end.
      486       block_where:
      487       do v-ind = 1 to v-idx-field-qnty by 2
      488       on error undo, return error
      489       :
      490         assign
      491           v-count-fld = v-count-fld + 1
      492         .
      493         if p-key-handle = ?
      494           and v-count-fld > v-field-num
      495         then do:
      496           leave block_where.
      497         end.
      498         define variable VfieldKeyTable as handle no-undo.
      499         assign
      500           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      501           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      502         .
      503         if     bh_tbl-key ne ?
      504         then do:
      505            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      506            if VfieldKeyTable eq ?
      507            then next block_where.
      508         end.
      509         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      510         then
      511            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      512         else
      513            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      514         if p-key-handle = ? then do:
      515           assign
      516             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      517           .
      518         end.
      519         else do:
      520           assign
      521             fh_key = p-key-handle:buffer-field( v-field-name )
      522           .
      523           if fh_key = ?
      524             or not valid-handle( fh_key )
      525           then do:
      526             delete object bh_tbl-name.
      527             if     bh_tbl-key ne ?
      528             then
      529                delete object bh_tbl-key.
      530             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      531           end.
      532           assign
      533             v-field-val = fh_key:buffer-value
      534           .
      535         end.
      536         if fh_search:data-type ="character":U then do:
      537           assign
      538             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      539             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      540             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      541             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      542             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      543             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      544             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      545             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      546             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      547             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      548             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      549             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      550             v-field-val = substitute( '"&1"', v-field-val )
      551           .
      552         end.
      553         assign
      554           o-where = substitute( "&1 &2", o-where, v-field-val )
      555         .
      556         if v-word-link = "":U then do:
      557           assign
      558             v-word-link = "and":U
      559           .
      560         end.
      561       end.
      562       delete object bh_tbl-name.
      563       if     bh_tbl-key ne ?
      564       then
      565          delete object bh_tbl-key.
      566       if p-key-handle = ?
      567         and v-count-fld <> v-field-num
      568       then do:
      569         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      570       end.
      571     end.
      572   end procedure.
      573   procedure gen-hn-keyr-tab :
      574     define input  parameter i-tableSerach as character no-undo.
      575     define input  parameter i-tablekey   as character no-undo.
      576     define input  parameter p-key-rec    as character no-undo.
      577     define input  parameter p-key-handle as handle    no-undo .
      578     define input  parameter p-db-name    as character no-undo .
      579     define input  parameter p-tt-handle  as handle    no-undo .
      580     define input  parameter p-stts-lock  as integer   no-undo .
      581     define output parameter o-hn         as handle    no-undo.
      582     define variable v-full-tbl-name as character no-undo.
      583     define variable v-where         as character no-undo.
      584     define variable bh_tbl-name     as handle    no-undo.
      585     define variable vTable          as character no-undo.
      586     do
      587     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      588     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      589     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      590         run gen-where-keyr-tab(i-tableSerach,
      591                                i-tablekey,
      592                                p-key-rec,
      593                                p-key-handle,
      594                                p-db-name,
      595                                p-tt-handle,
      596                                output v-where).
      597         if i-tableSerach ne "" and i-tableSerach ne ?
      598         then do:
      599            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      600            create buffer bh_tbl-name for table v-full-tbl-name .
      601         end.
      602         else do:
      603            if p-tt-handle = ? then do:
      604               assign
      605                  vTable = entry( 1 , p-key-rec, chr(3) )
      606               .
      607               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      608               create buffer bh_tbl-name for table v-full-tbl-name .
      609            end.
      610            else do:
      611               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      612            end.
      613         end.
      614         if p-tt-handle = ? then do:
      615            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      616         end.
      617         else do:
      618            bh_tbl-name:find-first( v-where ) no-error .
      619         end.
      620         o-hn = bh_tbl-name.
      621      end.
      622   end procedure.
      623   procedure gen-hn-keyr :
      624     define input  parameter p-key-rec    as character no-undo.
      625     define input  parameter p-key-handle as handle    no-undo .
      626     define input  parameter p-db-name    as character no-undo .
      627     define input  parameter p-tt-handle  as handle    no-undo .
      628     define input  parameter p-stts-lock  as integer   no-undo .
      629     define output parameter o-hn         as handle    no-undo.
      630     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      631   end.
      632   procedure gen-row-keyr :
      633     define input  parameter p-key-rec    as character no-undo.
      634     define input  parameter p-key-handle as handle    no-undo .
      635     define input  parameter p-db-name    as character no-undo .
      636     define input  parameter p-tt-handle  as handle    no-undo .
      637     define input  parameter p-stts-lock  as integer   no-undo .
      638     define output parameter p-tbl-row    as rowid     no-undo.
      639     define output parameter p-tbl-name   as character no-undo.
      640     define variable vHn as handle no-undo.
      641       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      642       p-tbl-row = if vHn:available then vHn:rowid else ?.
      643       p-tbl-name =  vHn:table.
      644       delete object vHn no-error.
      645     if p-tbl-row = ? then do:
      646       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      647     end.
      648     else do:
      649       return.
      650     end.
      651   end procedure.
      652   procedure gen-key-fv :
      653     define input  parameter p-key-rec    as character no-undo .
      654     define output parameter p-field-list as character no-undo .
      655     define output parameter p-value-list as character no-undo.
      656     do
      657     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      658     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      659     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      660     :
      661       define variable v-full-tbl-name  as character no-undo .
      662       define variable bh_tbl-name      as handle    no-undo .
      663       define variable v-tbl-name       as character no-undo .
      664       define variable v-field-num      as integer   no-undo .
      665       define variable v-count-fld      as integer   no-undo .
      666       define variable v-inform         as character no-undo .
      667       define variable v-ind            as integer   no-undo .
      668       define variable v-idx-field-qnty as integer   no-undo .
      669       define variable v-delim-key      as character no-undo .
      670       if p-key-rec = ?
      671         or p-key-rec = "":U
      672       then do:
      673         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      674       end.
      675       assign
      676         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      677         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      678       .
      679       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      680       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      681       assign
      682         v-inform = bh_tbl-name:index-information(1)
      683         v-ind    = 2
      684       .
      685       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      686       on error undo, return error
      687       :
      688         assign
      689           v-inform = bh_tbl-name:index-information( v-ind )
      690           v-ind    = v-ind + 1
      691         .
      692       end.
      693       if v-inform = ?
      694         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      695         or entry( 3, v-inform, ",":U ) <> "1":U
      696       then do:
      697         delete object bh_tbl-name no-error.
      698         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      699       end.
      700       assign
      701         v-idx-field-qnty = num-entries( v-inform ) - 4
      702       .
      703       if v-idx-field-qnty < 2 then do:
      704         delete object bh_tbl-name no-error.
      705         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      706       end.
      707       assign
      708         p-field-list = "":U
      709         p-value-list = "":U
      710         v-delim-key  = "":U
      711         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      712         v-count-fld  = 0
      713       .
      714       block_where:
      715       do v-ind = 1 to v-idx-field-qnty by 2
      716       on error undo, return error
      717       :
      718         assign
      719           v-count-fld = v-count-fld + 1
      720         .
      721         if v-count-fld > v-field-num then do:
      722           leave block_where.
      723         end.
      724         assign
      725           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      726           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      727         .
      728         if v-ind = 1 then do:
      729           assign
      730             v-delim-key = chr(3)
      731           .
      732         end.
      733       end.
      734       delete object bh_tbl-name.
      735       if v-count-fld <> v-field-num then do:
      736         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      737       end.
      738     end.
      739   end procedure.
      740   procedure gen-key-field :
      741     define input  parameter p-table      as character no-undo .
      742     define output parameter p-field-list as character no-undo .
      743     do
      744     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      745     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      746     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      747     :
      748       define variable v-full-tbl-name  as character no-undo .
      749       define variable bh_tbl-name      as handle    no-undo .
      750       define variable v-tbl-name       as character no-undo .
      751       define variable v-field-num      as integer   no-undo .
      752       define variable v-count-fld      as integer   no-undo .
      753       define variable v-inform         as character no-undo .
      754       define variable v-ind            as integer   no-undo .
      755       define variable v-idx-field-qnty as integer   no-undo .
      756       define variable v-delim-key      as character no-undo .
      757       if p-table = ?
      758         or p-table = "":U
      759       then do:
      760         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      761       end.
      762       assign
      763         v-tbl-name      = p-table
      764         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      765       .
      766       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      767       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      768       assign
      769         v-inform = bh_tbl-name:index-information(1)
      770         v-ind    = 2
      771       .
      772       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      773       on error undo, return error
      774       :
      775         assign
      776           v-inform = bh_tbl-name:index-information( v-ind )
      777           v-ind    = v-ind + 1
      778         .
      779       end.
      780       if v-inform = ?
      781         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      782         or entry( 3, v-inform, ",":U ) <> "1":U
      783       then do:
      784         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      785       end.
      786       assign
      787         v-idx-field-qnty = num-entries( v-inform ) - 4
      788       .
      789       if v-idx-field-qnty < 2 then do:
      790         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      791       end.
      792       assign
      793         p-field-list = "":U
      794         v-delim-key  = "":U
      795         v-count-fld  = 0
      796       .
      797       block_where:
      798       do v-ind = 1 to v-idx-field-qnty by 2
      799       on error undo, return error
      800       :
      801         assign
      802           v-count-fld = v-count-fld + 1
      803         .
      804         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      805         if v-ind = 1 then do:
      806           assign
      807             v-delim-key = chr(3)
      808           .
      809         end.
      810       end.
      811       delete object bh_tbl-name.
      812     end.
      813   end procedure.
      814   define variable v-date      as date      no-undo .
      815   define variable v-time      as integer   no-undo .
      816   define variable v-field-chg as character no-undo .
      817   define variable v-Seq       as int64     no-undo init ?.
      818   define variable vFlagseq    as logical no-undo.
      819   define variable vuniq-key-rec as character no-undo.
      820   define variable v-rowid as rowid no-undo.
      821   define variable v-tbl-name as character no-undo.
      822   if    (    g#db-num eq 0
      823          and c-code.nwsgbd )
      824      or (    g#db-num eq 0
      825          and c-code.nwsubd )
      826   then do:
      827     if not g#news then do :
      828       run nws/cmd-del.p
      829         ( input 'c-Code':U
      830          ,input (buffer ub.c-code:handle)
      831          ,input "":U
      832         ) no-error .
      833       if error-status :error then do:
      834         message
      835           vss-workfile vss-revision vss-description skip
      836           "Невозможно маршрутизировать удаление c-code для отправки в новости" skip
      837           error-status :get-message(1) skip
      838           return-value skip
      839           view-as alert-box error .
      840         undo , return error return-value .
      841       end.
      842       end.
      843   end.
