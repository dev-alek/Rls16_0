        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF UB.ORD-DOC .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление заказа".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   main-block :
       79   do transaction
       80       on error undo main-block, return error
       81       :
       82       define variable v-message as character no-undo .
       83   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
       84     (input ?
       85     ,input this-procedure:handle
       86     ,input ?
       87     ,input  (if ub.ord-doc.doc-type = 'ОР':U then 'event_intorder':U else 'event_order':U)
       88     ,input  buffer ub.ord-doc:handle
       89     ,input ?
       90     ,input ''
       91     ,input ''
       92     ) no-error .
       93       if error-status:error
       94           then
       95       do:
       96           v-message = substitute("&1 &2 &3&4Ошибка при вызове процедуры rum-runa.i&4&5&4&5&6"
       97               ,vss-workfile
       98               ,vss-revision
       99               ,vss-description
      100               ,chr(10)
      101               , error-status:get-message(1)
      102               , return-value ).
      103           if not g#news then
      104           do:
      105               message
      106                   v-message
      107                   view-as alert-box error .
      108           end.
      109           undo main-block,  return error v-message.
      110       end.
      111       for each ub.ord-line
      112           where ub.ord-line.doc-code = ub.ORD-doc.doc-code
      113           on error undo main-block, return error
      114           :
      115           delete ub.ord-line .
      116       end.
      117       for each ub.ord-doc-attr
      118           where ub.ord-doc-attr.doc-code = ub.ord-doc.doc-code
      119           on error undo main-block, return error
      120           :
      121           delete ub.ord-doc-attr .
      122       end.
      123       for each ub.ord-doc-rcv
      124           where ub.ord-doc-rcv.doc-code = ub.ord-doc.doc-code
      125           and ub.ord-doc-rcv.doc-type = "out":U
      126           and ub.ord-doc-rcv.status_  = 'новый':U
      127           on error undo main-block, return error
      128           :
      129           delete ub.ord-doc-rcv .
      130       end.
      131       run trg/userlog.p (
      132           input 'delete':U
      133           , input 'ord-doc':U
      134           , input ( buffer ub.ord-doc :handle )
      135           , input ?
      136           , input ""
      137           ) no-error.
      138       if error-status :error
      139           then
      140       do:
      141           undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      142               , chr(10)
      143               , vss-workfile
      144               , return-value
      145               , error-status :get-message ( 1 ) ).
      146       end.
      147       if ub.ord-doc.status_ = 'запрос':U then
      148       do:
      149           run nws/cmd-del.p
      150               ( input "ord-doc":U
      151               ,input (buffer ub.ord-doc:handle)
      152               ,input "":U
      153               ) no-error .
      154           if error-status :error then
      155           do:
      156               undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      157           end.
      158       end.
      159       if g#oxml = yes
      160           then
      161       do:
      162           run str/calloxml.p (
      163               input 'delete':U
      164               , input 'ord-doc':U
      165               , input ( buffer ub.ORD-DOC:handle )
      166               ) no-error.
      167           if error-status :error
      168               then
      169           do:
      170               undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      171                   , chr(10)
      172                   , vss-workfile
      173                   , return-value
      174                   , error-status :get-message ( 1 ) ).
      175           end.
      176       end.
      177   end.
