        1   block-level on error undo, throw.
        2   define input parameter p-forced as logical no-undo .
        3   define input parameter p-read-only as logical no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Приведение гейтов лежащих в CLOB соответствие с текущей версией".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   define variable v-waitfram-action01         as character   no-undo .
      306   define variable v-waitfram-action02         as character   no-undo .
      307   define variable v-waitfram-action03         as character   no-undo .
      308   define variable mWaitFramTextBeg            as character   no-undo.
      309   define variable mWaitFramTextEnd            as character   no-undo.
      310   define variable mWaitFramView               as logical     no-undo.
      311   define variable mWaitProcEvent              as logical     no-undo init yes.
      312   define variable mWaitFramInterval           as integer     no-undo init 1 .
      313   define variable mWaitFramStop               as logical     no-undo.
      314   define variable mWaitFramStopUser           as logical     no-undo.
      315   define variable mWaitFramStopTimeOut        as logical     no-undo.
      316   define variable mWaitFramStartProc          as datetime-tz no-undo.
      317   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      318   define button B-WaitFramStop auto-end-key
      319        label "Стоп"
      320        size 10 by 1 tooltip "Остоновить процесс".
      321   define button B-viewProcInfo
      322        label "Информация"
      323        size 15 by 1 tooltip "Информация о процесс".
      324   define frame waitfram
      325     v-waitfram-action01 format "x(72)" no-label skip
      326     v-waitfram-action02 format "x(72)" no-label skip
      327     v-waitfram-action03 format "x(72)" no-label skip
      328     B-viewProcInfo
      329     B-WaitFramStop at row 4 col 30
      330     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      331     .
      332   define new global shared variable mBatchMode as logical no-undo init ?.
      333   define variable mFramBachModHandle as handle no-undo.
      334   mFramBachModHandle = frame waitfram:handle.
      335   define variable mFameOldVis as logical no-undo.
      336   define variable mVisCUrentVin as logical no-undo.
      337   if session:batch-mode
      338   then
      339      mBatchMode = yes.
      340   if mBatchMode = ? then do:
      341     mVisCUrentVin = current-window:visible.
      342     mFameOldVis = mFramBachModHandle:visible.
      343     mFramBachModHandle:visible  = yes.
      344     mBatchMode = mFramBachModHandle:visible ne yes.
      345     mFramBachModHandle:visible = mFameOldVis.
      346     current-window:visible = mVisCUrentVin.
      347   end.
      348    if  log-manager:logfile-name ne ?
      349     then DO:
      350         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      351         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      352         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      353     end.
      354   on choose of B-WaitFramStop in frame waitfram
      355   do:
      356     mWaitFramStop = yes.
      357     mWaitFramStopUser = yes.
      358   end.
      359   function waitfram-check-timeout returns logical():
      360      define variable vtime as int64 no-undo.
      361      if mWaitFramStopTimeOut
      362      then
      363         return yes.
      364      vtime = ( now - mWaitFramStartProc ) / 1000 .
      365      if     mWaitFramTimeOut ne ?
      366         and mWaitFramTimeOut ne 0
      367         and mWaitFramTimeOut lt vtime
      368      then do:
      369         mWaitFramStopTimeOut = yes.
      370      end.
      371      return mWaitFramStopTimeOut.
      372   end.
      373   procedure waitfram-hide :
      374     if not session:batch-mode
      375     then do
      376     on error undo, return error return-value
      377     :
      378       pause 0 before-hide .
      379       if not mBatchMode then
      380         hide frame waitfram .
      381     if     not mWaitFramView
      382        and mWaitProcEvent
      383     then
      384       process events .
      385     end.
      386   end procedure.
      387   procedure waitfram-show :
      388     define input  parameter p-message as character no-undo .
      389     define variable v-left-margin as integer   no-undo .
      390     if not session:batch-mode
      391     then do
      392     on error undo, return error return-value
      393     :
      394       if length(p-message) <= 70 then do:
      395         assign
      396           v-left-margin = integer((70 - length(p-message)) / 2)
      397         .
      398         assign
      399           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      400         .
      401         assign
      402           v-waitfram-action01 = " "
      403           v-waitfram-action02 = " "
      404                                    + fill(" ", v-left-margin)
      405                                    + p-message
      406           v-waitfram-action03 = " "
      407         .
      408       end.
      409       else do:
      410         define variable vRindex1 as integer no-undo.
      411         define variable vRindex2 as integer no-undo.
      412         vRindex1 = r-index(p-message," ",70).
      413         if vRindex1 = 0
      414         then
      415            vRindex1 = 70.
      416         if length(p-message)  <= vRindex1 + 70 then do:
      417           assign
      418             v-waitfram-action01 = " "
      419             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      420             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      421           .
      422         end.
      423         else do:
      424           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      425           if vRindex2 <= vRindex1
      426           then
      427              vRindex2 = vRindex1 + 70.
      428           assign
      429             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      430             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      431             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      432           .
      433         end.
      434       end.
      435       B-viewProcInfo:visible   in frame waitfram = no.
      436       B-viewProcInfo:sensitive in frame waitfram = no.
      437       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      438       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      439       if  (   mWaitFramView
      440          or  mWaitProcEvent)
      441          and not mBatchMode
      442       then
      443          display
      444             v-waitfram-action01 skip
      445             v-waitfram-action02 skip
      446             v-waitfram-action03 skip
      447          with frame waitfram .
      448       if     mWaitFramView
      449          then do:
      450             if     mWaitFramInterval ne ?
      451                and not mBatchMode
      452             then
      453                wait-for go of frame waitfram pause mWaitFramInterval.
      454          end.
      455          else
      456             if     mWaitProcEvent
      457                and not mBatchMode
      458             then
      459                process events .
      460     end.
      461   end procedure.
      462      procedure waitfram-show-this:
      463         define input  parameter iInterval as int64 no-undo.
      464         define variable vtime as int64 no-undo.
      465         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      466         mWaitFramInterval = iInterval.
      467         run waitfram-show (substitute("&1&2 &3&4" ,
      468                                       mWaitFramTextBeg ,
      469                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      470                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      471                                       mWaitFramTextEnd
      472                                      )
      473                           ).
      474      end.
      475      procedure WaitFramRunPause:
      476         define input  parameter iInterval as dec no-undo.
      477         define variable vStart  as datetime-tz no-undo.
      478         define variable vend    as datetime-tz no-undo.
      479         define variable vint as int64 no-undo.
      480         define variable vOk as logical no-undo.
      481         vStart = now.
      482         vend   = vStart.
      483         publish "WaitFramPause" (iInterval,output vOk).
      484         vend   =  now.
      485         vint = vend - vStart.
      486         vint = iInterval - vint / 1000.
      487         if     not mWaitFramStop
      488            and (   vint > 0
      489                 or (    not vOk
      490                     and iInterval eq ?
      491                     )
      492                 )
      493         then
      494            run waitfram-show-this (iInterval).
      495         vend   =  now.
      496         vint = vend - vStart.
      497         vint = iInterval - vint / 1000.
      498         if     not mWaitFramStop
      499            and vint > 0
      500         then do:
      501            run gbl/pause.p (vint * 1000).
      502         end.
      503         if iInterval ne ?
      504         then
      505            publish "WaitFramStop".
      506         waitfram-check-timeout().
      507      end.
      508      procedure WaitFramWaitFor:
      509         define input  parameter iInterval as dec no-undo.
      510         assign
      511            mWaitFramStartProc   = now
      512            mWaitFramStopUser    = no
      513            mWaitFramStopTimeOut = no
      514         .
      515         block-wait:
      516         do while not mWaitFramStop:
      517            run WaitFramRunPause (iInterval).
      518            if  waitfram-check-timeout()
      519            then do:
      520               leave block-wait.
      521            end.
      522         end.
      523         run waitfram-hide.
      524      end.
      525   procedure waitfram-join :
      526     define input  parameter p-line-1  as character no-undo .
      527     define input  parameter p-line-2  as character no-undo .
      528     define input  parameter p-line-3  as character no-undo .
      529     define output parameter p-message as character no-undo .
      530     do
      531     on error undo, return error return-value
      532     :
      533       assign
      534         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      535                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      536                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      537       .
      538     end.
      539   end procedure.
      540   function waitfram-join-function returns character
      541     (input p-line-1 as character
      542     ,input p-line-2 as character
      543     ,input p-line-3 as character
      544     ).
      545     define variable v-message as character no-undo .
      546     run waitfram-join in this-procedure
      547       (input  p-line-1
      548       ,input  p-line-2
      549       ,input  p-line-3
      550       ,output v-message
      551       ) .
      552     return v-message .
      553   end function .
      554   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   procedure check-gate-version :
      556   define output parameter p-check as logical no-undo .
      557   define variable v-dopi1 as integer no-undo .
      558   define variable v-dopi2 as integer no-undo .
      559   define variable v-dopi3 as integer no-undo .
      560   define variable v-dopi4 as integer no-undo .
      561   define buffer buf_clob-bind for ub.clob-bind .
      562     do
      563     on error undo, return error
      564     :
      565       find first buf_clob-bind no-lock where
      566                 buf_clob-bind.db-num = 0
      567            and  buf_clob-bind.int64-id = 0
      568                 no-error.
      569       if (not available buf_clob-bind
      570       or buf_clob-bind.descr <> "v15_1.60" )
      571       then do:
      572         assign
      573         v-dopi1 = integer(entry(2, buf_clob-bind.descr,  "."))
      574         v-dopi2 = integer(entry(2, "v15_1.60", "."))
      575         v-dopi3 = integer(entry(2, entry(1, buf_clob-bind.descr, "."), "_"))
      576         v-dopi4 = integer(entry(2, entry(1, "v15_1.60", "."), "_"))
      577         no-error .
      578         if error-status:error
      579         or v-dopi2 > v-dopi1
      580         or v-dopi4 > v-dopi3
      581         or left-trim(entry(1, buf_clob-bind.descr, "."), "v":U) < "15"
      582         then do:
      583           assign
      584           p-check = yes.
      585         end.
      586       end.
      587     end.
      588   end procedure.
      589   procedure get-gate-version :
      590   define output parameter p-gate-version as character no-undo init ?.
      591   define buffer buf_clob-bind for ub.clob-bind .
      592   do
      593   on error undo, return error
      594   :
      595     find first buf_clob-bind no-lock where
      596               buf_clob-bind.db-num = 0
      597           and  buf_clob-bind.int64-id = 0
      598               no-error.
      599     if available buf_clob-bind then do:
      600       p-gate-version = buf_clob-bind.descr.
      601     end.
      602   end.
      603   end procedure.
      604   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   procedure gen-key-rec :
      606     define input  parameter p-tbl-name    as character no-undo.
      607     define input  parameter p-bh_tbl-name as handle    no-undo.
      608     define output parameter p-key-rec     as character no-undo.
      609     do
      610     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      611     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      612     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      613     :
      614       define variable fh               as handle    no-undo .
      615       define variable v-ok             as logical   no-undo .
      616       define variable v-inform         as character no-undo .
      617       define variable v-ind            as integer   no-undo .
      618       define variable v-idx-field-qnty as integer   no-undo .
      619       if p-tbl-name = ?
      620         or p-tbl-name = "":U
      621       then do:
      622         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      623       end.
      624       if not p-bh_tbl-name:available then do:
      625         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      626       end.
      627       assign
      628         p-key-rec = p-tbl-name
      629         v-inform  = p-bh_tbl-name:index-information(1)
      630         v-ind     = 2
      631       .
      632       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      633       on error undo, return error
      634       :
      635         assign
      636           v-inform = p-bh_tbl-name:index-information( v-ind )
      637           v-ind    = v-ind + 1
      638         .
      639       end.
      640       if v-inform = ?
      641         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      642         or entry( 3, v-inform, ",":U ) <> "1":U
      643       then do:
      644         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      645       end.
      646       else do:
      647         assign
      648           v-idx-field-qnty = num-entries( v-inform ) - 4
      649         .
      650         if v-idx-field-qnty < 2 then do:
      651           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      652         end.
      653         do v-ind = 1 to v-idx-field-qnty by 2
      654         on error undo, return error
      655         :
      656           assign
      657             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      658             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      659           .
      660         end.
      661       end.
      662       if p-key-rec = ? then do:
      663         assign
      664           p-key-rec = "":U
      665         .
      666         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      667       end.
      668     end.
      669     return.
      670   end procedure.
      671   procedure gen-where-keyr-tab :
      672     define input  parameter i-tableSerach as character no-undo.
      673     define input  parameter i-tablekey   as character  no-undo.
      674     define input  parameter p-key-rec    as character  no-undo.
      675     define input  parameter p-key-handle as handle     no-undo .
      676     define input  parameter p-db-name    as character  no-undo .
      677     define input  parameter p-tt-handle  as handle     no-undo .
      678     define output parameter o-Where      as character  no-undo.
      679     do
      680     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      681     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      682     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      683     :
      684       define variable v-full-tbl-name  as character no-undo .
      685       define variable bh_tbl-name      as handle    no-undo .
      686       define variable fh_key           as handle    no-undo .
      687       define variable fh_search        as handle    no-undo .
      688       define variable v-field-num      as integer   no-undo .
      689       define variable v-count-fld      as integer   no-undo .
      690       define variable v-inform         as character no-undo .
      691       define variable v-ind            as integer   no-undo .
      692       define variable v-idx-field-qnty as integer   no-undo .
      693       define variable v-field-name     as character no-undo .
      694       define variable v-field-val      as character no-undo .
      695       define variable v-word-link      as character no-undo .
      696       define variable vTable           as character no-undo.
      697       define variable bh_tbl-key       as handle    no-undo .
      698       assign
      699         p-key-rec = trim( p-key-rec )
      700       .
      701       if p-key-handle <> ? then do:
      702         if not valid-handle(p-key-handle)
      703            or p-key-handle:type <> "buffer"
      704         then do:
      705           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      706         end.
      707         if num-entries( p-key-rec, chr(3) ) > 1
      708           or p-key-rec = ?
      709           or p-key-rec = "":U
      710         then do:
      711           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      712         end.
      713       end.
      714       else do:
      715         if p-key-rec = ?
      716           or p-key-rec = "":U
      717         then do:
      718           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      719         end.
      720       end.
      721       assign
      722         vTable = entry( 1 , p-key-rec, chr(3) )
      723       .
      724       if p-tt-handle <> ?
      725         and ( not valid-handle(p-tt-handle)
      726               or p-tt-handle:type <> "buffer"
      727             )
      728       then do:
      729         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      730       end.
      731       if p-tt-handle = ? then do:
      732         assign
      733           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      734         .
      735         create buffer bh_tbl-name for table v-full-tbl-name .
      736       end.
      737       else do:
      738         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      739       end.
      740       assign
      741         v-inform = bh_tbl-name:index-information(1)
      742         v-ind    = 2
      743       .
      744       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      745       on error undo, return error
      746       :
      747         assign
      748           v-inform = bh_tbl-name:index-information( v-ind )
      749           v-ind    = v-ind + 1
      750         .
      751       end.
      752       if v-inform = ?
      753         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      754         or entry( 3, v-inform, ",":U ) <> "1":U
      755       then do:
      756         delete object bh_tbl-name no-error.
      757         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      758       end.
      759       assign
      760         v-idx-field-qnty = num-entries( v-inform ) - 4
      761       .
      762       if v-idx-field-qnty < 2 then do:
      763         delete object bh_tbl-name no-error.
      764         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      765       end.
      766       assign
      767         o-where     = "where":U
      768         v-word-link = "":U
      769         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      770         v-count-fld = 0
      771       .
      772       if i-tablekey ne "" and i-tablekey ne ?
      773       then do:
      774         assign
      775           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      776         .
      777         create buffer bh_tbl-key for table v-full-tbl-name .
      778       end.
      779       if i-tableSerach ne "" and i-tableSerach ne ?
      780       then do:
      781         delete object bh_tbl-name no-error.
      782         assign
      783           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      784         .
      785         create buffer bh_tbl-name for table v-full-tbl-name .
      786       end.
      787       block_where:
      788       do v-ind = 1 to v-idx-field-qnty by 2
      789       on error undo, return error
      790       :
      791         assign
      792           v-count-fld = v-count-fld + 1
      793         .
      794         if p-key-handle = ?
      795           and v-count-fld > v-field-num
      796         then do:
      797           leave block_where.
      798         end.
      799         define variable VfieldKeyTable as handle no-undo.
      800         assign
      801           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      802           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      803         .
      804         if     bh_tbl-key ne ?
      805         then do:
      806            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      807            if VfieldKeyTable eq ?
      808            then next block_where.
      809         end.
      810         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      811         then
      812            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      813         else
      814            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      815         if p-key-handle = ? then do:
      816           assign
      817             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      818           .
      819         end.
      820         else do:
      821           assign
      822             fh_key = p-key-handle:buffer-field( v-field-name )
      823           .
      824           if fh_key = ?
      825             or not valid-handle( fh_key )
      826           then do:
      827             delete object bh_tbl-name.
      828             if     bh_tbl-key ne ?
      829             then
      830                delete object bh_tbl-key.
      831             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      832           end.
      833           assign
      834             v-field-val = fh_key:buffer-value
      835           .
      836         end.
      837         if fh_search:data-type ="character":U then do:
      838           assign
      839             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      840             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      841             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      842             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      843             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      844             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      845             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      846             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      847             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      848             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      849             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      850             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      851             v-field-val = substitute( '"&1"', v-field-val )
      852           .
      853         end.
      854         assign
      855           o-where = substitute( "&1 &2", o-where, v-field-val )
      856         .
      857         if v-word-link = "":U then do:
      858           assign
      859             v-word-link = "and":U
      860           .
      861         end.
      862       end.
      863       delete object bh_tbl-name.
      864       if     bh_tbl-key ne ?
      865       then
      866          delete object bh_tbl-key.
      867       if p-key-handle = ?
      868         and v-count-fld <> v-field-num
      869       then do:
      870         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      871       end.
      872     end.
      873   end procedure.
      874   procedure gen-hn-keyr-tab :
      875     define input  parameter i-tableSerach as character no-undo.
      876     define input  parameter i-tablekey   as character no-undo.
      877     define input  parameter p-key-rec    as character no-undo.
      878     define input  parameter p-key-handle as handle    no-undo .
      879     define input  parameter p-db-name    as character no-undo .
      880     define input  parameter p-tt-handle  as handle    no-undo .
      881     define input  parameter p-stts-lock  as integer   no-undo .
      882     define output parameter o-hn         as handle    no-undo.
      883     define variable v-full-tbl-name as character no-undo.
      884     define variable v-where         as character no-undo.
      885     define variable bh_tbl-name     as handle    no-undo.
      886     define variable vTable          as character no-undo.
      887     do
      888     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      889     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      890     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      891         run gen-where-keyr-tab(i-tableSerach,
      892                                i-tablekey,
      893                                p-key-rec,
      894                                p-key-handle,
      895                                p-db-name,
      896                                p-tt-handle,
      897                                output v-where).
      898         if i-tableSerach ne "" and i-tableSerach ne ?
      899         then do:
      900            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      901            create buffer bh_tbl-name for table v-full-tbl-name .
      902         end.
      903         else do:
      904            if p-tt-handle = ? then do:
      905               assign
      906                  vTable = entry( 1 , p-key-rec, chr(3) )
      907               .
      908               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      909               create buffer bh_tbl-name for table v-full-tbl-name .
      910            end.
      911            else do:
      912               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      913            end.
      914         end.
      915         if p-tt-handle = ? then do:
      916            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      917         end.
      918         else do:
      919            bh_tbl-name:find-first( v-where ) no-error .
      920         end.
      921         o-hn = bh_tbl-name.
      922      end.
      923   end procedure.
      924   procedure gen-hn-keyr :
      925     define input  parameter p-key-rec    as character no-undo.
      926     define input  parameter p-key-handle as handle    no-undo .
      927     define input  parameter p-db-name    as character no-undo .
      928     define input  parameter p-tt-handle  as handle    no-undo .
      929     define input  parameter p-stts-lock  as integer   no-undo .
      930     define output parameter o-hn         as handle    no-undo.
      931     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      932   end.
      933   procedure gen-row-keyr :
      934     define input  parameter p-key-rec    as character no-undo.
      935     define input  parameter p-key-handle as handle    no-undo .
      936     define input  parameter p-db-name    as character no-undo .
      937     define input  parameter p-tt-handle  as handle    no-undo .
      938     define input  parameter p-stts-lock  as integer   no-undo .
      939     define output parameter p-tbl-row    as rowid     no-undo.
      940     define output parameter p-tbl-name   as character no-undo.
      941     define variable vHn as handle no-undo.
      942       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      943       p-tbl-row = if vHn:available then vHn:rowid else ?.
      944       p-tbl-name =  vHn:table.
      945       delete object vHn no-error.
      946     if p-tbl-row = ? then do:
      947       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      948     end.
      949     else do:
      950       return.
      951     end.
      952   end procedure.
      953   procedure gen-key-fv :
      954     define input  parameter p-key-rec    as character no-undo .
      955     define output parameter p-field-list as character no-undo .
      956     define output parameter p-value-list as character no-undo.
      957     do
      958     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      959     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      960     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      961     :
      962       define variable v-full-tbl-name  as character no-undo .
      963       define variable bh_tbl-name      as handle    no-undo .
      964       define variable v-tbl-name       as character no-undo .
      965       define variable v-field-num      as integer   no-undo .
      966       define variable v-count-fld      as integer   no-undo .
      967       define variable v-inform         as character no-undo .
      968       define variable v-ind            as integer   no-undo .
      969       define variable v-idx-field-qnty as integer   no-undo .
      970       define variable v-delim-key      as character no-undo .
      971       if p-key-rec = ?
      972         or p-key-rec = "":U
      973       then do:
      974         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      975       end.
      976       assign
      977         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      978         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      979       .
      980       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      981       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      982       assign
      983         v-inform = bh_tbl-name:index-information(1)
      984         v-ind    = 2
      985       .
      986       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      987       on error undo, return error
      988       :
      989         assign
      990           v-inform = bh_tbl-name:index-information( v-ind )
      991           v-ind    = v-ind + 1
      992         .
      993       end.
      994       if v-inform = ?
      995         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      996         or entry( 3, v-inform, ",":U ) <> "1":U
      997       then do:
      998         delete object bh_tbl-name no-error.
      999         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1000       end.
     1001       assign
     1002         v-idx-field-qnty = num-entries( v-inform ) - 4
     1003       .
     1004       if v-idx-field-qnty < 2 then do:
     1005         delete object bh_tbl-name no-error.
     1006         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1007       end.
     1008       assign
     1009         p-field-list = "":U
     1010         p-value-list = "":U
     1011         v-delim-key  = "":U
     1012         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1013         v-count-fld  = 0
     1014       .
     1015       block_where:
     1016       do v-ind = 1 to v-idx-field-qnty by 2
     1017       on error undo, return error
     1018       :
     1019         assign
     1020           v-count-fld = v-count-fld + 1
     1021         .
     1022         if v-count-fld > v-field-num then do:
     1023           leave block_where.
     1024         end.
     1025         assign
     1026           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1027           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1028         .
     1029         if v-ind = 1 then do:
     1030           assign
     1031             v-delim-key = chr(3)
     1032           .
     1033         end.
     1034       end.
     1035       delete object bh_tbl-name.
     1036       if v-count-fld <> v-field-num then do:
     1037         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
     1038       end.
     1039     end.
     1040   end procedure.
     1041   procedure gen-key-field :
     1042     define input  parameter p-table      as character no-undo .
     1043     define output parameter p-field-list as character no-undo .
     1044     do
     1045     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1046     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1047     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1048     :
     1049       define variable v-full-tbl-name  as character no-undo .
     1050       define variable bh_tbl-name      as handle    no-undo .
     1051       define variable v-tbl-name       as character no-undo .
     1052       define variable v-field-num      as integer   no-undo .
     1053       define variable v-count-fld      as integer   no-undo .
     1054       define variable v-inform         as character no-undo .
     1055       define variable v-ind            as integer   no-undo .
     1056       define variable v-idx-field-qnty as integer   no-undo .
     1057       define variable v-delim-key      as character no-undo .
     1058       if p-table = ?
     1059         or p-table = "":U
     1060       then do:
     1061         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1062       end.
     1063       assign
     1064         v-tbl-name      = p-table
     1065         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1066       .
     1067       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1068       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1069       assign
     1070         v-inform = bh_tbl-name:index-information(1)
     1071         v-ind    = 2
     1072       .
     1073       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1074       on error undo, return error
     1075       :
     1076         assign
     1077           v-inform = bh_tbl-name:index-information( v-ind )
     1078           v-ind    = v-ind + 1
     1079         .
     1080       end.
     1081       if v-inform = ?
     1082         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1083         or entry( 3, v-inform, ",":U ) <> "1":U
     1084       then do:
     1085         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1086       end.
     1087       assign
     1088         v-idx-field-qnty = num-entries( v-inform ) - 4
     1089       .
     1090       if v-idx-field-qnty < 2 then do:
     1091         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1092       end.
     1093       assign
     1094         p-field-list = "":U
     1095         v-delim-key  = "":U
     1096         v-count-fld  = 0
     1097       .
     1098       block_where:
     1099       do v-ind = 1 to v-idx-field-qnty by 2
     1100       on error undo, return error
     1101       :
     1102         assign
     1103           v-count-fld = v-count-fld + 1
     1104         .
     1105         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1106         if v-ind = 1 then do:
     1107           assign
     1108             v-delim-key = chr(3)
     1109           .
     1110         end.
     1111       end.
     1112       delete object bh_tbl-name.
     1113     end.
     1114   end procedure.
     1115   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1116   procedure progs-name :
     1117     define input  parameter p-action-code         as character no-undo .
     1118     define output parameter p-main-prog-name      as character no-undo .
     1119     define output parameter p-list-db-proc-name   as character no-undo .
     1120     define output parameter p-commit-proc-name    as character no-undo .
     1121     define output parameter p-execution-proc-name as character no-undo .
     1122     define output parameter p-recover-proc-name   as character no-undo .
     1123     define output parameter p-after-proc-name     as character no-undo .
     1124     do
     1125     on error undo, return error
     1126     :
     1127       case p-action-code :
     1128               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
     1129               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
     1130               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
     1131               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
     1132               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
     1133               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
     1134               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
     1135               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
     1136               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
     1137               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
     1138               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
     1139               otherwise do:
     1140           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info4, p-action-code ).
     1141         end.
     1142       end case.
     1143     end.
     1144     return.
     1145   end procedure.
     1146   procedure progs-title :
     1147     define input  parameter p-action-code         as character no-undo .
     1148     define output parameter p-action-title      as character no-undo .
     1149     do
     1150     on error undo, return error
     1151     :
     1152       case p-action-code :
     1153               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     1154               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     1155               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     1156               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     1157               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     1158               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     1159               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     1160               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     1161               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     1162               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     1163               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     1164               otherwise do:
     1165           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info4, p-action-code ).
     1166         end.
     1167       end case.
     1168     end.
     1169     return.
     1170   end procedure.
     1171   FUNCTION progs-title-function returns character(
     1172      input  p-action-code         as character):
     1173   define variable p-action-title      as character no-undo .
     1174     do
     1175     on error undo, return error
     1176     :
     1177       case p-action-code :
     1178               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
     1179               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
     1180               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
     1181               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
     1182               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
     1183               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
     1184               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
     1185               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
     1186               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
     1187               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
     1188               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
     1189               otherwise do:
     1190           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info4, p-action-code ).
     1191         end.
     1192       end case.
     1193     end.
     1194     return p-action-title.
     1195   end FUNCTION.
     1196   procedure get-row-keyr-string :
     1197    define input  parameter p-key-rec  as character no-undo.
     1198    define output parameter p-tbl-title as character no-undo.
     1199    define output parameter p-rec-string  as character no-undo.
     1200     do
     1201     on error undo, return error
     1202     :
     1203       define variable v-full-tbl-name as character no-undo .
     1204       define variable bh_tbl-name     as handle    no-undo .
     1205       define variable fh              as handle    no-undo .
     1206       define variable v-ok            as logical   no-undo .
     1207       define variable v-field-num     as integer   no-undo .
     1208       define variable v-count-fld     as integer   no-undo .
     1209       define variable v-tbl-name as character no-undo.
     1210       if p-key-rec = ?
     1211         or p-key-rec = "":U
     1212       then do:
     1213         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1214       end.
     1215       assign
     1216         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1217         v-full-tbl-name = "ub.":U + v-tbl-name
     1218         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
     1219         p-rec-string         = "":U
     1220         v-count-fld     = 0
     1221       .
     1222       find ub._file
     1223         where ub._file._file-name = v-tbl-name
     1224         no-error.
     1225       if not available ub._file then do:
     1226         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info4, v-tbl-name ).
     1227       end.
     1228       assign
     1229       p-tbl-title = ub._file._file-label
     1230       .
     1231       find ub._index
     1232         where recid( ub._index  ) = ub._file._prime-index
     1233         no-error.
     1234       if not available ub._index
     1235         or LC( ub._index._index-name ) = "default":U
     1236       then do:
     1237         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1238       end.
     1239       block_where :
     1240       for each ub._index-field of ub._index  ,
     1241           each ub._field of _index-field
     1242           break by _index-seq
     1243       on error undo, return error
     1244       :
     1245         assign
     1246           v-count-fld = v-count-fld + 1
     1247         .
     1248         if v-count-fld > v-field-num then do:
     1249           leave block_where.
     1250         end.
     1251         if p-rec-string = "":U then do:
     1252           assign
     1253             p-rec-string = "":U
     1254           .
     1255         end.
     1256         else do:
     1257           assign
     1258             p-rec-string = p-rec-string + chr(32) + chr(44)
     1259           .
     1260         end.
     1261         assign
     1262           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
     1263         .
     1264       end.
     1265       if v-count-fld <> v-field-num then do:
     1266         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
     1267       end.
     1268     end.
     1269     return.
     1270   end procedure.
     1271   FUNCTION uniq-key-rec-string-f returns character(
     1272      input  p-uniq-key-rec         as character):
     1273   define variable v-tbl-title as character no-undo .
     1274   define variable v-rec-string as character no-undo .
     1275     do
     1276     on error undo, return error
     1277     :
     1278       run get-row-keyr-string in this-procedure (
     1279                                                 input p-uniq-key-rec
     1280                                                 ,output v-tbl-title
     1281                                                 ,output v-rec-string).
     1282       assign
     1283       v-rec-string = (if v-tbl-title <> ? and
     1284                       v-tbl-title <> "":U
     1285                       then (v-tbl-title + ":")
     1286                      else "":U) + chr(32) + v-rec-string
     1287       .
     1288     end.
     1289     return v-rec-string.
     1290   end FUNCTION.
     1291   procedure create_db-rec_route :
     1292     define input parameter p1-uniq-key-rec as character no-undo .
     1293     define input parameter p1-action       as character no-undo .
     1294     define input parameter p1-operation    as character no-undo .
     1295     define input parameter p1-send-db-list as character no-undo .
     1296     define input parameter p1-db-init      as integer   no-undo .
     1297     define input parameter p1-parameters   as character no-undo .
     1298     define input parameter p1-answer-code  as integer   no-undo .
     1299     define input parameter p1-answer-msg   as character no-undo .
     1300     do
     1301     on error undo, return error
     1302     :
     1303       define variable v-command     as character no-undo .
     1304       define variable v-ind         as integer   no-undo .
     1305       define variable v-num-entries as integer   no-undo .
     1306       define variable v-curr-db     as integer   no-undo .
     1307       define variable v-db-for-send as character no-undo .
     1308       define variable v-db-num      as integer   no-undo .
     1309       define variable v-db-num-char as character no-undo .
     1310       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1311       find first buf_sys-ctrl no-lock .
     1312       assign
     1313         v-curr-db     = buf_sys-ctrl.db-num
     1314         v-db-for-send = "":U
     1315       .
     1316       if v-curr-db = 0 then do:
     1317         if p1-answer-code >= 0 then do:
     1318           if v-curr-db <> p1-db-init then do:
     1319             assign
     1320               v-db-for-send = string( p1-db-init )
     1321             .
     1322           end.
     1323         end.
     1324         else do:
     1325           assign
     1326             v-num-entries = num-entries( p1-send-db-list, chr(44) )
     1327           .
     1328           do v-ind = 1 to v-num-entries:
     1329             assign
     1330               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
     1331               v-db-num      = integer( v-db-num-char )
     1332             .
     1333             if v-db-num <> v-curr-db
     1334               and v-db-num <> p1-db-init
     1335             then do:
     1336               if v-db-for-send = "":U then do:
     1337                 assign
     1338                   v-db-for-send = v-db-num-char
     1339                 .
     1340               end.
     1341               else do:
     1342                 assign
     1343                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     1344                 .
     1345               end.
     1346             end.
     1347           end.
     1348         end.
     1349       end.
     1350       else do:
     1351         assign
     1352           v-db-for-send = "0":U
     1353         .
     1354       end.
     1355       if v-db-for-send <> "":U then do:
     1356         assign
     1357           v-command = "command":U + chr(1)
     1358                       + "two-commit":U + chr(1)
     1359                       + p1-action + chr(1)
     1360                       + p1-operation + chr(1)
     1361                       + p1-uniq-key-rec + chr(1)
     1362                       + string( p1-db-init ) + chr(1)
     1363                       + p1-parameters + chr(1)
     1364                       + string( p1-answer-code ) + chr(1)
     1365                       + p1-answer-msg
     1366         .
     1367         run nws/cr-route.p ( input 'send-cmd':U
     1368                       ,input v-command
     1369                       ,input ?
     1370                       ,input v-db-for-send
     1371                       ) no-error .
     1372         if error-status :error then do:
     1373           return error return-value.
     1374         end.
     1375       end.
     1376     end.
     1377     return.
     1378   end procedure.
     1379   procedure create_msg_route :
     1380     define input parameter p2-send-db-list as character no-undo .
     1381     define input parameter p2-msg          as character no-undo .
     1382     do
     1383     on error undo, return error
     1384     :
     1385       define variable v-msg-command as character no-undo .
     1386       define variable v-ind         as integer   no-undo .
     1387       define variable v-num-entries as integer   no-undo .
     1388       define variable v-curr-db     as integer   no-undo .
     1389       define variable v-db-for-send as character no-undo .
     1390       define variable v-db-num      as integer   no-undo .
     1391       define variable v-db-num-char as character no-undo .
     1392       define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1393       find first buf_sys-ctrl no-lock .
     1394       assign
     1395         v-curr-db     = buf_sys-ctrl.db-num
     1396         v-db-for-send = "":U
     1397       .
     1398       if v-curr-db = 0 then do:
     1399         assign
     1400           v-num-entries = num-entries( p2-send-db-list, chr(44) )
     1401         .
     1402         do v-ind = 1 to v-num-entries:
     1403           assign
     1404             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
     1405             v-db-num      = integer( v-db-num-char )
     1406           .
     1407           if v-db-num <> v-curr-db then do:
     1408             if v-db-for-send = "":U then do:
     1409               assign
     1410                 v-db-for-send = v-db-num-char
     1411               .
     1412             end.
     1413             else do:
     1414               assign
     1415                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
     1416               .
     1417             end.
     1418           end.
     1419         end.
     1420       end.
     1421       else do:
     1422         assign
     1423           v-db-for-send = "0":U
     1424         .
     1425       end.
     1426       if v-db-for-send <> "":U then do:
     1427         assign
     1428           v-msg-command = "command":U + chr(1)
     1429                           + "message-to-log":U + chr(1)
     1430                           + p2-msg
     1431         .
     1432         run nws/cr-route.p ( input 'send-cmd':U
     1433                       ,input v-msg-command
     1434                       ,input ?
     1435                       ,input v-db-for-send
     1436                       ) no-error .
     1437         if error-status :error then do:
     1438           return error substitute( "&1&2&3"
     1439                                     , return-value
     1440                                     , chr(10)
     1441                                     , error-status :get-message(1)
     1442                                   ).
     1443         end.
     1444       end.
     1445     end.
     1446     return.
     1447   end procedure.
     1448   function get-send-db-list returns character
     1449     ( input p-curr-db     as integer
     1450      ,input p-all-db-list as character
     1451     )
     1452   :
     1453     define variable v-send-db-list as character no-undo .
     1454     if p-curr-db = 0 then do:
     1455       assign
     1456         v-send-db-list = p-all-db-list
     1457       .
     1458     end.
     1459     else do:
     1460       assign
     1461         v-send-db-list = string(p-curr-db)
     1462       .
     1463     end.
     1464     return v-send-db-list .
     1465   end function .
     1466   define stream imp-stream.
     1467   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1468   define new shared temp-table temp-tables no-undo
     1469   field tbl-name as character
     1470   field buf-handle as handle
     1471   field tbl-handle as handle
     1472   index pi is unique primary
     1473   tbl-name.
     1474   define new shared temp-table temp-command no-undo
     1475   field command-name as character
     1476   field tbl-name as character
     1477   field uniq-key-rec as character
     1478   index pi is unique primary
     1479   tbl-name
     1480   command-name
     1481   uniq-key-rec
     1482   index icommand
     1483   command-name
     1484   tbl-name
     1485   uniq-key-rec
     1486   .
     1487   define buffer buf_temp-tables for temp-tables.
     1488   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1489   procedure clbdattd_two-commit-del :
     1490   define parameter buffer buf_clob-data for ub.clob-data.
     1491   define input parameter p-error-mode as integer no-undo .
     1492   define variable v-key-rec as character no-undo .
     1493   define variable v-param as character no-undo .
     1494   define variable v-ext-prg-handle as handle no-undo .
     1495   define variable v-rec as recid no-undo .
     1496   define variable l-is-used as logical   no-undo init yes.
     1497   define variable v-db-num as integer no-undo .
     1498   define variable v-int64-id as int64 no-undo .
     1499   define variable v-curr-db as integer   no-undo .
     1500   define buffer buf2_clob-data for ub.clob-data.
     1501   define buffer buf_sys-ctrl for ub.sys-ctrl .
     1502   define buffer buf_db-rec-attr for ub.db-rec-attr .
     1503   main-block:
     1504   do
     1505   on error undo, return error return-value
     1506   :
     1507     if can-find(first ub.db where ub.db.db-num > 0) then do:
     1508       run gen-key-rec( input 'clob-data':U
     1509                       ,input (buffer buf_clob-data:handle )
     1510                       ,output v-key-rec
     1511                     ) no-error.
     1512       if error-status :error then do:
     1513         undo main-block, return error substitute("&1 &2 &3&4Ошибка при генерации уникального ключа для clob-data4&5&6&5&7"
     1514                                                   ,vss-workfile
     1515                                                   ,vss-revision
     1516                                                   ,vss-description
     1517                                                   , buf_clob-data.file-name_
     1518                                                   ,chr(10)
     1519                                                   , error-status:get-message(1)
     1520                                                   , return-value ).
     1521       end.
     1522       assign
     1523       v-param = string(buf_clob-data.db-num) + chr(4) +
     1524                 string(buf_clob-data.int64-id) + chr(4) +
     1525                 buf_clob-data.crc-field
     1526       v-db-num = buf_clob-data.db-num
     1527       v-int64-id = buf_clob-data.int64-id
     1528       .
     1529       run nws/db-rec.p (
     1530                           input 'delete_nu-clob-data':U
     1531                           ,input v-key-rec
     1532                           ,input v-param
     1533                         ) no-error .
     1534       if error-status:error then do:
     1535         if p-error-mode = 0 then do:
     1536           find first buf_sys-ctrl no-lock .
     1537           assign
     1538             v-curr-db  = buf_sys-ctrl.db-num.
     1539           find first buf_db-rec-attr exclusive-lock
     1540             where buf_db-rec-attr.db-num       = v-curr-db
     1541               and buf_db-rec-attr.uniq-key-rec = v-key-rec
     1542               and buf_db-rec-attr.attr-code    = 'delete_nu-clob-data':U
     1543             no-wait no-error.
     1544           if available buf_db-rec-attr
     1545             or ( not available buf_db-rec-attr
     1546                 and locked buf_db-rec-attr
     1547               )
     1548           then do:
     1549             return.
     1550           end.
     1551         end.
     1552         else do:
     1553         undo, return error substitute("&1&2&3"
     1554                                        ,error-status:get-message(1)
     1555                                        ,chr(10)
     1556                                        , return-value ).
     1557       end.
     1558       end.
     1559       find first buf2_clob-data no-lock where
     1560                 buf2_clob-data.db-num = buf_clob-data.db-num
     1561             and buf2_clob-data.int64-id = buf_clob-data.int64-id no-error.
     1562       if available buf2_clob-data
     1563       and buf2_clob-data.crc-field > '':U
     1564       and p-error-mode = 1
     1565       then do:
     1566         message return-value
     1567         view-as alert-box .
     1568       end.
     1569     end.
     1570     else do:
     1571       run trg/clobdatt.p persistent set v-ext-prg-handle .
     1572       find current buf_clob-data  exclusive-lock.
     1573       assign
     1574       v-rec = recid(buf_clob-data)
     1575       buf_clob-data.crc-field = '':U
     1576       .
     1577       release buf_clob-data.
     1578       find first buf_clob-data where
     1579               recid(buf_clob-data) = v-rec.
     1580       run value( "proc-is-used-clob-data" ) in v-ext-prg-handle (
     1581                                                                   buffer buf_clob-data
     1582                                                                 , input g#db-num
     1583                                                                 , output l-is-used) no-error .
     1584       if not error-status:error
     1585       and not l-is-used then do:
     1586         delete buf_clob-data no-error .
     1587       end.
     1588       if valid-handle(v-ext-prg-handle) then do:
     1589         delete procedure v-ext-prg-handle  .
     1590       end.
     1591       find first buf2_clob-data no-lock where
     1592                 buf2_clob-data.db-num = buf_clob-data.db-num
     1593             and buf2_clob-data.int64-id = buf_clob-data.int64-id no-error.
     1594       if available buf2_clob-data
     1595       and buf2_clob-data.crc-field > '':U
     1596       and p-error-mode = 1
     1597       then do:
     1598         message return-value
     1599         view-as alert-box .
     1600       end.
     1601       else do:
     1602         error-status:error = no.
     1603       end.
     1604     end.
     1605     if error-status :error then do:
     1606       undo, return error substitute("Ошибка при запуске удаления clob-data &1&2&3&4&3&5"
     1607                                     ,v-db-num
     1608                                     ,v-int64-id
     1609                                     ,chr(10)
     1610                                     , error-status:get-message(1)
     1611                                     , return-value ).
     1612     end.
     1613   end.
     1614   end procedure.
     1615   define variable v-check1 as logical no-undo .
     1616   define variable v-force as logical no-undo .
     1617   define variable v-mes   as character no-undo .
     1618   define variable v-full-path        as character no-undo .
     1619   define variable v-path             as character no-undo .
     1620   define variable v-file-name        as character no-undo .
     1621   define variable v-file-name-no-ext as character no-undo .
     1622   define variable v-file-name-ext    as character no-undo .
     1623   define variable v-md5-signature as character no-undo .
     1624   define new shared temp-table tt-clob-data no-undo like ub.clob-data . find first buf_temp-tables where buf_temp-tables.tbl-name = "clob-data" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "clob-data"    buf_temp-tables.buf-handle = buffer tt-clob-data:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1625   define new shared temp-table tt-clob-bind no-undo like ub.clob-bind . find first buf_temp-tables where buf_temp-tables.tbl-name = "clob-bind" no-error. if not available buf_temp-tables then do:   create buf_temp-tables.   assign   buf_temp-tables.tbl-name = "clob-bind"    buf_temp-tables.buf-handle = buffer tt-clob-bind:handle    buf_temp-tables.tbl-handle = buf_temp-tables.buf-handle:table-handle   .   release buf_temp-tables. end.
     1626   define buffer buf_tt-clob-data for tt-clob-data.
     1627   define buffer buf_tt-clob-bind for tt-clob-bind.
     1628   define buffer buf_clob-bind for ub.clob-bind.
     1629   run waitfram-show in this-procedure ("Реинициализация конфигурации GATE").
     1630   if ( g#db-num > 0 ) then return.
     1631   if not p-forced then do:
     1632     run check-gate-version in this-procedure (output v-check1).
     1633   end.
     1634   if v-check1
     1635   or p-forced
     1636   then do:
     1637      if v-check1
     1638      and p-read-only then do:
     1639         return error substitute("&1 &2 &3&4До начала работы с данной БД (режим RO) необходимо произвести вход в ОСНОВНУЮ БД!!!"
     1640                                 ,vss-workfile
     1641                                 ,vss-revision
     1642                                 ,vss-description
     1643                                 ,chr(10)).
     1644      end.
     1645       run gbl/md5.p (
     1646         input  "cmp/fix-gate.txt"
     1647       ,output v-md5-signature
     1648       ) .
     1649     if v-md5-signature <> "C2DEC59EF921E3FE00FF75C4995E0C05" then do:
     1650       message
     1651       substitute("Несовпадение файла эталонных записей по конфигурации GATE (fix-date.txt) с контрольным числом")
     1652       view-as alert-box error .
     1653       undo, return error .
     1654     end.
     1655     run gbl/filename.p ( input "cmp/fix-gate.txt"
     1656                         ,output v-full-path
     1657                         ,output v-path
     1658                         ,output v-file-name
     1659                         ,output v-file-name-no-ext
     1660                         ,output v-file-name-ext
     1661                         ) no-error .
     1662     if error-status:error then do:
     1663       message
     1664       substitute("Не найден файл эталонных записей по конфигурации гейтов (fix-gate.txt)")
     1665       view-as alert-box error .
     1666       undo, return error .
     1667     end.
     1668     run str/diallog.w (
     1669           input ?
     1670         ,input this-procedure
     1671         ,input ('utl/upgimptt.p' + chr(4)  +
     1672                 '1' + chr(4) +
     1673                 '1' + chr(4) +
     1674                 '1' + chr(4) +
     1675                 '1')
     1676         ,input v-full-path
     1677         ,input yes
     1678         ,input 'Прервать'
     1679         ,input 'Чтение файла в память') no-error .
     1680     if error-status:error then do:
     1681       for each buf_temp-tables
     1682       :
     1683         if valid-handle(buf_temp-tables.tbl-handle) then do:
     1684           delete object buf_temp-tables.tbl-handle.
     1685         end.
     1686       end.
     1687       message
     1688       substitute("Ошибка при чтении в память файла эталонных записей по гейтам (fix-gate.txt)&1&2&1&3"
     1689                     , chr(10)
     1690                     , error-status:get-message(1)
     1691                     , return-value )
     1692       view-as alert-box error .
     1693       undo, return error .
     1694     end.
     1695     find first buf_tt-clob-bind no-lock where
     1696               buf_tt-clob-bind.db-num = 0
     1697           and buf_tt-clob-bind.int64-id = 0  no-error.
     1698     if not available buf_tt-clob-bind
     1699     or buf_tt-clob-bind.descr <> "v15_1.60" then do:
     1700       message
     1701       substitute("Версии шаблонов скидок в r-кодах и файле эталонных записей по гейтам (fix-gate.txt) НЕ СОВПАДАЮТ&1" +
     1702                   "в r-кодах - &2&1" +
     1703                   "в файле - &3"
     1704                   , chr(10)
     1705                   , "v15_1.60"
     1706                   , buf_tt-clob-bind.descr
     1707                   )
     1708       view-as alert-box error .
     1709       undo, return error .
     1710     end.
     1711     main-block:
     1712     do
     1713     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1714     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1715     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1716     :
     1717       run check-gates in this-procedure no-error .
     1718       if error-status:error then do:
     1719         run waitfram-hide in this-procedure .
     1720         assign
     1721         v-mes = substitute("Ошибки при инициализации гейтов:&1&2 &3"
     1722                           , chr(10)
     1723                           , error-status:get-message(1)
     1724                           , return-value ).
     1725         if p-forced then do:
     1726           message
     1727           v-mes
     1728           view-as alert-box error .
     1729         end.
     1730         undo, return error v-mes.
     1731       end.
     1732       find first buf_tt-clob-bind where
     1733                 buf_tt-clob-bind.db-num = 0
     1734             and buf_tt-clob-bind.int64-id = 0.
     1735       find first buf_clob-bind where
     1736                 buf_clob-bind.db-num = 0
     1737             and buf_clob-bind.int64-id = 0 no-error.
     1738       if not available buf_clob-bind then do:
     1739         create buf_clob-bind.
     1740       end.
     1741       buffer-copy buf_tt-clob-bind to buf_clob-bind.
     1742     end.
     1743   end.
     1744   for each buf_temp-tables
     1745   :
     1746     if valid-handle(buf_temp-tables.tbl-handle) then do:
     1747       delete object buf_temp-tables.tbl-handle.
     1748     end.
     1749   end.
     1750   run waitfram-hide in this-procedure .
     1751   procedure check-gates :
     1752   define variable v-path                    as character                no-undo .
     1753   DEFINE VARIABLE v-full-path               as character                no-undo .
     1754   DEFINE VARIABLE v-file-name               as character                no-undo .
     1755   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1756   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1757   define variable v-md5-signature           as character no-undo .
     1758   define variable v-found as logical   no-undo .
     1759   define variable v-clob-db-num             as integer   no-undo .
     1760   define variable v-int64-id as int64 no-undo .
     1761   define variable v-cmp-log as logical   no-undo .
     1762   define variable v-part-num as integer   no-undo .
     1763   define buffer buf_tt-clob-bind for tt-clob-bind.
     1764   define buffer buf_tt-clob-data for tt-clob-data.
     1765   define buffer buf_clob-data for ub.clob-data.
     1766   define buffer buf2_clob-data for ub.clob-data.
     1767   main-block:
     1768   do
     1769   on error undo, return error return-value
     1770   :
     1771       for each buf_tt-clob-data
     1772       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1773       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1774       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1775       :
     1776         run gbl/filename.p (
     1777                         input buf_tt-clob-data.file-name_
     1778                       ,output v-full-path
     1779                       ,output v-path
     1780                       ,output v-file-name
     1781                       ,output v-file-name-no-ext
     1782                       ,output v-file-name-ext
     1783                       ) no-error .
     1784         if error-status:error then do:
     1785           undo main-block, return error substitute("Не удается найти файл &1",  buf_tt-clob-data.file-name_).
     1786         end.
     1787         run gbl/md5.p (
     1788                                 input  v-full-path
     1789                                 ,output v-md5-signature
     1790                                 ) no-error .
     1791         if error-status:error then do:
     1792           undo main-block, return error substitute("&1 &2 &3&4&5&4&6"
     1793                                         ,vss-workfile
     1794                                         ,vss-revision
     1795                                         ,vss-description
     1796                                         ,chr(10)
     1797                                         , error-status:get-message(1)
     1798                                         , return-value ).
     1799         end.
     1800         if v-md5-signature <> buf_tt-clob-data.crc-field then do:
     1801           undo main-block, return error substitute("Не совпадает md5 &1 для описания в конфигурации (fix-gate.txt) и файла, лежащего в пути",  buf_tt-clob-data.file-name_).
     1802         end.
     1803       end.
     1804       for each buf_tt-clob-bind where
     1805               buf_tt-clob-bind.db-num = 0
     1806           and buf_tt-clob-bind.int64-id > 0
     1807       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1808       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1809       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1810       :
     1811         find first buf_clob-bind where
     1812                   buf_clob-bind.resource-type = buf_tt-clob-bind.resource-type
     1813               and buf_clob-bind.uniq-key-rec = buf_tt-clob-bind.uniq-key-rec
     1814               and buf_clob-bind.field-name = buf_tt-clob-bind.field-name
     1815               and buf_clob-bind.part-num = buf_tt-clob-bind.part-num no-error.
     1816         if not available buf_clob-bind then do:
     1817           assign
     1818           v-clob-db-num = ?
     1819           v-int64-id = 0
     1820           .
     1821           run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     1822                               ,input "override"
     1823                               ,input ?
     1824                               ,input buf_tt-clob-bind.uniq-key-rec
     1825                               ,input buf_tt-clob-bind.field-name
     1826                               ,input buf_tt-clob-bind.descr
     1827                               ,input-output buf_tt-clob-bind.part-num
     1828                               ,input 'gate':U
     1829                               ,input-output v-clob-db-num
     1830                               ,input-output v-int64-id
     1831                               ,input buf_tt-clob-bind.uniq-key-rec
     1832                               ,input ?
     1833                               ) no-error .
     1834         if error-status :error then do:
     1835           undo main-block, return error substitute("Ошибка при записи clob-data &1&2&3&2&4"
     1836                                                     ,buf_tt-clob-bind.uniq-key-rec
     1837                                                     ,chr(10)
     1838                                                     , error-status:get-message(1)
     1839                                                     , return-value ).
     1840         end.
     1841        end.
     1842        else do:
     1843         do transaction
     1844         on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1845         on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1846         on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile ):
     1847           find first buf_tt-clob-data where
     1848                     buf_tt-clob-data.db-num = buf_tt-clob-bind.db-num
     1849                 and buf_tt-clob-data.int64-id = buf_tt-clob-bind.int64-id.
     1850           v-found = no.
     1851           _cdata:
     1852           for each buf_clob-data no-lock where buf_clob-data.file-name_ = buf_tt-clob-data.file-name_
     1853           by buf_clob-data.db-num
     1854           by buf_clob-data.int64-id
     1855           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1856           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1857           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1858           :
     1859             find first buf2_clob-data exclusive-lock where
     1860                     rowid(buf2_clob-data) = rowid(buf_clob-data).
     1861             if buf_tt-clob-data.crc-field <> buf2_clob-data.crc-field
     1862             or buf_tt-clob-data.file-size <> buf2_clob-data.file-size then do:
     1863               run clbdattd_two-commit-del in this-procedure ( buffer buf_clob-data, input 0) no-error.
     1864               if error-status :error then do:
     1865                 undo main-block, return error substitute("Ошибка при попытке запустить удаление неиспользуемых clob-data &1 (1)(&2&3)&4&5&4&6"
     1866                                                          ,buf_clob-data.file-name_
     1867                                                          ,buf_clob-data.db-num
     1868                                                          ,buf_clob-data.int64-id
     1869                                                          ,chr(10)
     1870                                                          , error-status:get-message(1)
     1871                                                          , return-value ).
     1872               end.
     1873               else do:
     1874                 undo _cdata,  next _cdata.
     1875               end.
     1876             end.
     1877             else do:
     1878               v-found = yes.
     1879             end.
     1880           end.
     1881           if not v-found then do:
     1882             assign
     1883             v-clob-db-num = ?
     1884             v-int64-id = 0
     1885             .
     1886             run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     1887                                 ,input "add-new"
     1888                                 ,input ?
     1889                                 ,input buf_tt-clob-bind.uniq-key-rec
     1890                                 ,input buf_tt-clob-bind.field-name
     1891                                 ,input buf_tt-clob-bind.descr
     1892                                 ,input-output buf_tt-clob-bind.part-num
     1893                                 ,input 'gate':U
     1894                                 ,input-output v-clob-db-num
     1895                                 ,input-output v-int64-id
     1896                                 ,input buf_tt-clob-bind.uniq-key-rec
     1897                                 ,input ?
     1898                                 ) no-error .
     1899             if error-status:error then do:
     1900               undo main-block, return error return-value .
     1901             end.
     1902           end.
     1903           else do:
     1904             buffer-compare buf_clob-bind
     1905             using descr
     1906             to buf_tt-clob-bind
     1907             save result in v-cmp-log.
     1908             if v-cmp-log = no then do:
     1909               assign
     1910               buf_clob-bind.descr = buf_tt-clob-bind.descr.
     1911             end.
     1912           end.
     1913         end.
     1914       end.
     1915     end.
     1916     for each buf_clob-bind no-lock where
     1917             buf_clob-bind.resource-type = 'gate':U
     1918        and buf_clob-bind.db-num = 0
     1919        and buf_clob-bind.int64-id > 0
     1920     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1921     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1922     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1923     :
     1924       find first buf_tt-clob-bind no-lock where
     1925                 buf_tt-clob-bind.uniq-key-rec = buf_clob-bind.uniq-key-rec
     1926             and buf_tt-clob-bind.field-name_ = buf_clob-bind.field-name_
     1927             and buf_tt-clob-bind.part-num = buf_clob-bind.part-num no-error.
     1928      if not available buf_tt-clob-bind then do:
     1929        find first buf_clob-data no-lock where
     1930                 buf_clob-data.db-num = buf_clob-bind.db-num
     1931             and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     1932         assign
     1933         v-clob-db-num = ?
     1934         v-int64-id = 0
     1935         v-part-num = buf_clob-bind.part-num
     1936         .
     1937         run gbl/file2clb.p ( input 'удаление':U
     1938                             ,input "leave"
     1939                             ,input ?
     1940                             ,input buf_clob-bind.uniq-key-rec
     1941                             ,input buf_clob-bind.field-name
     1942                             ,input '':U
     1943                             ,input-output v-part-num
     1944                             ,input 'gate':U
     1945                             ,input-output v-clob-db-num
     1946                             ,input-output v-int64-id
     1947                             ,input buf_clob-bind.uniq-key-rec
     1948                             ,input ?
     1949                             ) no-error .
     1950        if error-status :error then do:
     1951          undo main-block, return error return-value .
     1952        end.
     1953        if available buf_clob-data then do:
     1954           run clbdattd_two-commit-del in this-procedure ( buffer buf_clob-data, input 0) no-error.
     1955           if error-status :error then do:
     1956             undo main-block, return error substitute("Ошибка при попытке запустить удаление неиспользуемых clob-data &1 (&2&3)(2)&4&5&4&6"
     1957                                                       ,buf_clob-data.file-name_
     1958                                                       ,buf_clob-data.db-num
     1959                                                       ,buf_clob-data.int64-id
     1960                                                       ,chr(10)
     1961                                                       , error-status:get-message(1)
     1962                                                       , return-value ).
     1963           end.
     1964        end.
     1965      end.
     1966     end.
     1967   end.
     1968   end procedure.
