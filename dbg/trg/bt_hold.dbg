        1   block-level on error undo, throw.
        2   define input  parameter p-last-date         as date      no-undo .
        3   define input  parameter p-check-act         as logical   no-undo .
        4   define input  parameter p-check-act-db-num  as integer   no-undo .
        5   define input  parameter p-check-act-user-id as character no-undo .
        6   def var vss-revision    as character no-undo init "$Revision$":U .
        7   def var vss-author      as character no-undo init "$Author$":U .
        8   def var vss-date        as character no-undo init "$Date$":U .
        9   def var vss-workfile    as character no-undo init "$Workfile$":U .
       10   def var vss-archive     as character no-undo init "$Archive$":U .
       11   def var vss-description as character no-undo init "Расчет межфирменных архивов".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure holdattr-code :
       83     do
       84     on error undo, return error
       85     :
       86       define input  parameter p-code           as character no-undo .
       87       define output parameter p-type           as character no-undo .
       88       define output parameter p-format         as character no-undo .
       89       define output parameter p-label          as character no-undo .
       90       define output parameter p-user-can-edit  as logical   no-undo .
       91       define output parameter p-output-display as logical   no-undo .
       92       define output parameter p-other          as character no-undo .
       93       case p-code :
       94               when 'begin-date':U then do:     assign     p-label = "Дата начала межфирменного архива"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата начала межфирменного архива"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       95               when 'is-calc':U then do:     assign     p-label = "Произв.расчет арх."     p-type = 'L':U      p-format = "+/-"     p-label = "Произв.расчет арх."     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
       96         otherwise do:
       97           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
       98         end.
       99       end.
      100     end.
      101   end procedure.
      102   procedure holdattr-tooltip :
      103     do
      104     on error undo, return error
      105     :
      106       define input  parameter p-code    as character no-undo .
      107       define output parameter p-tooltip as character no-undo .
      108       define output parameter p-label   as character no-undo .
      109       case p-code :
      110               when 'begin-date':U then do:     assign     p-tooltip = "Дата начала межфирменного архива"     p-label = "Дата начала межфирменного архива" .   end.
      111               when 'is-calc':U then do:     assign     p-tooltip = "Производится расчет межфирменного архива"     p-label = "Произв.расчет арх." .   end.
      112         otherwise do:
      113           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      114         end.
      115       end.
      116     end.
      117   end procedure.
      118   procedure holdattr-value :
      119     do
      120     on error undo, return error
      121     :
      122       define input  parameter p-cat-code  like ub.hold-attr.cat-code     no-undo .
      123       define input  parameter p-code      like ub.hold-attr.attr-code  no-undo .
      124       define output parameter p-value     like ub.hold-attr.attr-value no-undo .
      125       define output parameter p-type      as character no-undo .
      126       define buffer buf_hold-attr for ub.hold-attr .
      127       def var v-format         as character no-undo .
      128       def var v-label          as character no-undo .
      129       def var v-user-can-edit  as logical   no-undo .
      130       def var v-output-display as logical   no-undo .
      131       def var v-other          as character no-undo .
      132       run holdattr-code in this-procedure
      133         (input  p-code
      134         ,output p-type
      135         ,output v-format
      136         ,output v-label
      137         ,output v-user-can-edit
      138         ,output v-output-display
      139         ,output v-other
      140         ) no-error .
      141       if error-status :error then do:
      142         undo, return error return-value .
      143       end.
      144       find first buf_hold-attr no-lock
      145         where buf_hold-attr.cat-code    = p-cat-code
      146           and buf_hold-attr.attr-code = p-code
      147         no-error .
      148       if avail buf_hold-attr then do:
      149         assign
      150           p-value =  buf_hold-attr.attr-value
      151         .
      152       end.
      153       else do:
      154         assign
      155           p-value = if p-type = 'L':U then "no":U else ""
      156         .
      157       end.
      158     end.
      159   end procedure.
      160   procedure holdattr-write :
      161     do
      162     on error undo, return error
      163     :
      164       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      165       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      166       define input parameter p-value     like ub.hold-attr.attr-value no-undo .
      167       define buffer buf_hold-attr for ub.hold-attr .
      168       def var v-type           as character no-undo .
      169       def var v-format         as character no-undo .
      170       def var v-label          as character no-undo .
      171       def var v-user-can-edit  as logical   no-undo .
      172       def var v-output-display as logical   no-undo .
      173       def var v-other          as character no-undo .
      174       run holdattr-code in this-procedure
      175         (input  p-code
      176         ,output v-type
      177         ,output v-format
      178         ,output v-label
      179         ,output v-user-can-edit
      180         ,output v-output-display
      181         ,output v-other
      182         ) no-error .
      183       if error-status :error then do:
      184         undo, return error return-value .
      185       end.
      186       find first buf_hold-attr exclusive-lock
      187         where buf_hold-attr.cat-code    = p-cat-code
      188           and buf_hold-attr.attr-code = p-code
      189         no-error .
      190       if not available buf_hold-attr then do:
      191         create buf_hold-attr .
      192         assign
      193           buf_hold-attr.cat-code    = p-cat-code
      194           buf_hold-attr.attr-code = p-code
      195         .
      196       end.
      197       assign
      198         buf_hold-attr.attr-value = p-value
      199       .
      200     end.
      201   end procedure.
      202   procedure holdattr-exist :
      203     do
      204     on error undo, return error
      205     :
      206       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      207       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      208       define output parameter p-exist    as logical  no-undo .
      209       define buffer buf_hold-attr for ub.hold-attr .
      210       def var v-type           as character no-undo .
      211       def var v-format         as character no-undo .
      212       def var v-label          as character no-undo .
      213       def var v-user-can-edit  as logical   no-undo .
      214       def var v-output-display as logical   no-undo .
      215       def var v-other          as character no-undo .
      216       run holdattr-code in this-procedure
      217         (input  p-code
      218         ,output v-type
      219         ,output v-format
      220         ,output v-label
      221         ,output v-user-can-edit
      222         ,output v-output-display
      223         ,output v-other
      224         ) no-error .
      225       if error-status :error then do:
      226         undo, return error return-value .
      227       end.
      228       find first buf_hold-attr no-lock
      229         where buf_hold-attr.cat-code    = p-cat-code
      230           and buf_hold-attr.attr-code = p-code
      231         no-error .
      232       if  available buf_hold-attr then do:
      233         p-exist = yes.
      234       end.
      235     end.
      236   end procedure.
      237   procedure holdattr-delete :
      238     do
      239     on error undo, return error
      240     :
      241       define input parameter p-cat-code   like ub.hold-attr.cat-code     no-undo .
      242       define input parameter p-code     like ub.hold-attr.attr-code  no-undo .
      243       define output parameter p-deleted  as logical no-undo.
      244       define buffer buf_hold-attr for ub.hold-attr .
      245       def var v-type           as character no-undo .
      246       def var v-format         as character no-undo .
      247       def var v-label          as character no-undo .
      248       def var v-user-can-edit  as logical   no-undo .
      249       def var v-output-display as logical   no-undo .
      250       def var v-other          as character no-undo .
      251       run holdattr-code in this-procedure
      252         (input  p-code
      253         ,output v-type
      254         ,output v-format
      255         ,output v-label
      256         ,output v-user-can-edit
      257         ,output v-output-display
      258         ,output v-other
      259         ) no-error .
      260       if error-status :error then do:
      261         undo, return error return-value .
      262       end.
      263       find first buf_hold-attr exclusive-lock
      264         where buf_hold-attr.cat-code    = p-cat-code
      265           and buf_hold-attr.attr-code = p-code
      266         no-error NO-WAIT.
      267       if not available buf_hold-attr then do:
      268         p-deleted = no.
      269       end.
      270       else do:
      271         delete buf_hold-attr.
      272         p-deleted = yes.
      273       end.
      274     end.
      275   end procedure.
      276   procedure holdattr-news :
      277     do
      278     on error undo, return error
      279     :
      280       define input  parameter p-code           as character no-undo .
      281       define output parameter p-news           as logical   no-undo .
      282       case p-code :
      283               when 'begin-date':U then do:     assign     p-news = no.   end.
      284               when 'is-calc':U then do:     assign     p-news = no.   end.
      285         otherwise do:
      286           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      287         end.
      288       end.
      289     end.
      290   end procedure.
      291   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   procedure cur-time :
      293      define output parameter p-today as date      no-undo .
      294      define output parameter p-time  as integer   no-undo .
      295     do
      296     on error undo, return error
      297     :
      298       define variable v-date1 as date      no-undo .
      299       define variable v-date2 as date      no-undo .
      300       define variable v-time  as integer   no-undo .
      301       assign
      302         v-date1 = today
      303         v-time  = time
      304         v-date2 = today
      305       .
      306       if v-date1 <> v-date2
      307       then do:
      308         assign
      309           v-date1 = today
      310           v-time  = v-time
      311         .
      312       end.
      313       assign
      314         p-today = v-date1
      315         p-time  = v-time
      316       .
      317     end.
      318   end.
      319   function cur-time-date returns character
      320   :
      321     return string(today, '99/99/9999':U) .
      322   end.
      323   function cur-time-mjd returns decimal
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return integer(v-date) - 2400002 + (v-time / 86400) .
      332   end.
      333   function cur-time-get-ending-index returns integer
      334   (input p-number as integer
      335   )
      336   :
      337     if p-number < 0
      338     or p-number = ?
      339     then do:
      340       return 1 .
      341     end.
      342     define variable v-rest as integer   no-undo .
      343     assign
      344       p-number = p-number modulo 100
      345     .
      346     if p-number < 20
      347     then do:
      348       assign
      349         v-rest = p-number
      350       .
      351     end.
      352     else do:
      353       assign
      354         v-rest = p-number modulo 10
      355       .
      356     end.
      357     case v-rest :
      358       when 1
      359       then do:
      360         return 2 .
      361       end.
      362       when 2 or
      363       when 3 or
      364       when 4
      365       then do:
      366         return 3 .
      367       end.
      368       otherwise do:
      369         return 1 .
      370       end.
      371     end case .
      372   end.
      373   procedure cur-time-mjd-to-date :
      374      define input  parameter i-mjd-diff as decimal no-undo.
      375      define output parameter o-Date     as date    no-undo.
      376      define output parameter o-Time     as integer no-undo.
      377      define variable v-day-number as integer   no-undo .
      378      if    i-mjd-diff < 0
      379         or i-mjd-diff = ?
      380      then do:
      381         return "?" .
      382      end.
      383      assign
      384         v-day-number = truncate(i-mjd-diff,0).
      385         o-Date = date(v-day-number + 2400002).
      386         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      387     .
      388   end.
      389   function cur-time-mjd-to-string returns character
      390   (input p-mjd-diff as decimal
      391   )
      392   :
      393     define variable v-day-number as integer   no-undo .
      394     define variable v-seconds    as integer   no-undo .
      395     define variable v-hour       as integer   no-undo .
      396     define variable v-min        as integer   no-undo .
      397     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      398     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      399     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      400     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      401     if p-mjd-diff < 0
      402     or p-mjd-diff = ?
      403     then do:
      404       return "?" .
      405     end.
      406     assign
      407       v-day-number = integer(truncate(p-mjd-diff,0))
      408       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      409     .
      410     if v-seconds > 86400
      411     then do:
      412       assign
      413         v-seconds = 86400 - 1
      414       .
      415     end.
      416     if v-seconds < 0
      417     then do:
      418       assign
      419         v-seconds = 0
      420       .
      421     end.
      422     assign
      423       v-hour = truncate(v-seconds / 3600, 0)
      424     .
      425     assign
      426       v-seconds = v-seconds modulo 3600
      427     .
      428     assign
      429       v-min = truncate(v-seconds / 60, 0)
      430     .
      431     assign
      432       v-seconds = v-seconds modulo 60
      433     .
      434     return
      435         (if v-day-number <> 0
      436           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      437           else ""
      438         )
      439       + (if v-day-number <> 0 or v-hour <> 0
      440           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      441           else ""
      442         )
      443       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      444           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      445           else ""
      446         )
      447       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      448       .
      449   end.
      450   function cur-time-string returns character
      451   :
      452     define variable v-date as date      no-undo .
      453     define variable v-time as integer   no-undo .
      454     run cur-time in this-procedure
      455       (output v-date
      456       ,output v-time
      457       ) .
      458     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      459   end.
      460   function cur-time-string-sec returns character
      461   :
      462     define variable v-date as date      no-undo .
      463     define variable v-time as integer   no-undo .
      464     run cur-time in this-procedure
      465       (output v-date
      466       ,output v-time
      467       ) .
      468     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      469   end.
      470   function cur-time-custom  returns character
      471   (input p-prefix as character
      472   ,input p-date-format as character
      473   ,input p-delimiter as character
      474   ,input p-time-format as character
      475   ,input p-suffix as character
      476   )
      477   :
      478     define variable v-date as date      no-undo .
      479     define variable v-time as integer   no-undo .
      480     run cur-time in this-procedure
      481       (output v-date
      482       ,output v-time
      483       ) .
      484     return
      485       p-prefix
      486       + string(v-date, p-date-format)
      487       + p-delimiter
      488       + string(v-time, p-time-format)
      489       + p-suffix
      490       .
      491   end.
      492   function cur-time-print  returns character
      493   :
      494     define variable v-date as date      no-undo .
      495     define variable v-time as integer   no-undo .
      496     run cur-time in this-procedure
      497       (output v-date
      498       ,output v-time
      499       ) .
      500     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      501   end.
      502   function cur-time-datetime returns datetime
      503   :
      504     define variable v-char as character no-undo .
      505     define variable v-datetime as datetime no-undo .
      506     v-char = cur-time-string().
      507     v-datetime = datetime(v-char).
      508     return  v-datetime.
      509   end.
      510   function cur-time-string-msec returns character
      511   :
      512     define variable v-date as datetime  no-undo .
      513     v-date = now.
      514     return string(v-date) .
      515   end.
      516   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      517   define variable v-waitfram-action01         as character   no-undo .
      518   define variable v-waitfram-action02         as character   no-undo .
      519   define variable v-waitfram-action03         as character   no-undo .
      520   define variable mWaitFramTextBeg            as character   no-undo.
      521   define variable mWaitFramTextEnd            as character   no-undo.
      522   define variable mWaitFramView               as logical     no-undo.
      523   define variable mWaitProcEvent              as logical     no-undo init yes.
      524   define variable mWaitFramInterval           as integer     no-undo init 1 .
      525   define variable mWaitFramStop               as logical     no-undo.
      526   define variable mWaitFramStopUser           as logical     no-undo.
      527   define variable mWaitFramStopTimeOut        as logical     no-undo.
      528   define variable mWaitFramStartProc          as datetime-tz no-undo.
      529   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      530   define button B-WaitFramStop auto-end-key
      531        label "Стоп"
      532        size 10 by 1 tooltip "Остоновить процесс".
      533   define button B-viewProcInfo
      534        label "Информация"
      535        size 15 by 1 tooltip "Информация о процесс".
      536   define frame waitfram
      537     v-waitfram-action01 format "x(72)" no-label skip
      538     v-waitfram-action02 format "x(72)" no-label skip
      539     v-waitfram-action03 format "x(72)" no-label skip
      540     B-viewProcInfo
      541     B-WaitFramStop at row 4 col 30
      542     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      543     .
      544   define new global shared variable mBatchMode as logical no-undo init ?.
      545   define variable mFramBachModHandle as handle no-undo.
      546   mFramBachModHandle = frame waitfram:handle.
      547   define variable mFameOldVis as logical no-undo.
      548   define variable mVisCUrentVin as logical no-undo.
      549   if session:batch-mode
      550   then
      551      mBatchMode = yes.
      552   if mBatchMode = ? then do:
      553     mVisCUrentVin = current-window:visible.
      554     mFameOldVis = mFramBachModHandle:visible.
      555     mFramBachModHandle:visible  = yes.
      556     mBatchMode = mFramBachModHandle:visible ne yes.
      557     mFramBachModHandle:visible = mFameOldVis.
      558     current-window:visible = mVisCUrentVin.
      559   end.
      560    if  log-manager:logfile-name ne ?
      561     then DO:
      562         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      563         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      564         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      565     end.
      566   on choose of B-WaitFramStop in frame waitfram
      567   do:
      568     mWaitFramStop = yes.
      569     mWaitFramStopUser = yes.
      570   end.
      571   function waitfram-check-timeout returns logical():
      572      define variable vtime as int64 no-undo.
      573      if mWaitFramStopTimeOut
      574      then
      575         return yes.
      576      vtime = ( now - mWaitFramStartProc ) / 1000 .
      577      if     mWaitFramTimeOut ne ?
      578         and mWaitFramTimeOut ne 0
      579         and mWaitFramTimeOut lt vtime
      580      then do:
      581         mWaitFramStopTimeOut = yes.
      582      end.
      583      return mWaitFramStopTimeOut.
      584   end.
      585   procedure waitfram-hide :
      586     if not session:batch-mode
      587     then do
      588     on error undo, return error return-value
      589     :
      590       pause 0 before-hide .
      591       if not mBatchMode then
      592         hide frame waitfram .
      593     if     not mWaitFramView
      594        and mWaitProcEvent
      595     then
      596       process events .
      597     end.
      598   end procedure.
      599   procedure waitfram-show :
      600     define input  parameter p-message as character no-undo .
      601     define variable v-left-margin as integer   no-undo .
      602     if not session:batch-mode
      603     then do
      604     on error undo, return error return-value
      605     :
      606       if length(p-message) <= 70 then do:
      607         assign
      608           v-left-margin = integer((70 - length(p-message)) / 2)
      609         .
      610         assign
      611           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      612         .
      613         assign
      614           v-waitfram-action01 = " "
      615           v-waitfram-action02 = " "
      616                                    + fill(" ", v-left-margin)
      617                                    + p-message
      618           v-waitfram-action03 = " "
      619         .
      620       end.
      621       else do:
      622         define variable vRindex1 as integer no-undo.
      623         define variable vRindex2 as integer no-undo.
      624         vRindex1 = r-index(p-message," ",70).
      625         if vRindex1 = 0
      626         then
      627            vRindex1 = 70.
      628         if length(p-message)  <= vRindex1 + 70 then do:
      629           assign
      630             v-waitfram-action01 = " "
      631             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      632             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      633           .
      634         end.
      635         else do:
      636           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      637           if vRindex2 <= vRindex1
      638           then
      639              vRindex2 = vRindex1 + 70.
      640           assign
      641             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      642             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      643             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      644           .
      645         end.
      646       end.
      647       B-viewProcInfo:visible   in frame waitfram = no.
      648       B-viewProcInfo:sensitive in frame waitfram = no.
      649       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      650       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      651       if  (   mWaitFramView
      652          or  mWaitProcEvent)
      653          and not mBatchMode
      654       then
      655          display
      656             v-waitfram-action01 skip
      657             v-waitfram-action02 skip
      658             v-waitfram-action03 skip
      659          with frame waitfram .
      660       if     mWaitFramView
      661          then do:
      662             if     mWaitFramInterval ne ?
      663                and not mBatchMode
      664             then
      665                wait-for go of frame waitfram pause mWaitFramInterval.
      666          end.
      667          else
      668             if     mWaitProcEvent
      669                and not mBatchMode
      670             then
      671                process events .
      672     end.
      673   end procedure.
      674      procedure waitfram-show-this:
      675         define input  parameter iInterval as int64 no-undo.
      676         define variable vtime as int64 no-undo.
      677         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      678         mWaitFramInterval = iInterval.
      679         run waitfram-show (substitute("&1&2 &3&4" ,
      680                                       mWaitFramTextBeg ,
      681                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      682                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      683                                       mWaitFramTextEnd
      684                                      )
      685                           ).
      686      end.
      687      procedure WaitFramRunPause:
      688         define input  parameter iInterval as dec no-undo.
      689         define variable vStart  as datetime-tz no-undo.
      690         define variable vend    as datetime-tz no-undo.
      691         define variable vint as int64 no-undo.
      692         define variable vOk as logical no-undo.
      693         vStart = now.
      694         vend   = vStart.
      695         publish "WaitFramPause" (iInterval,output vOk).
      696         vend   =  now.
      697         vint = vend - vStart.
      698         vint = iInterval - vint / 1000.
      699         if     not mWaitFramStop
      700            and (   vint > 0
      701                 or (    not vOk
      702                     and iInterval eq ?
      703                     )
      704                 )
      705         then
      706            run waitfram-show-this (iInterval).
      707         vend   =  now.
      708         vint = vend - vStart.
      709         vint = iInterval - vint / 1000.
      710         if     not mWaitFramStop
      711            and vint > 0
      712         then do:
      713            run gbl/pause.p (vint * 1000).
      714         end.
      715         if iInterval ne ?
      716         then
      717            publish "WaitFramStop".
      718         waitfram-check-timeout().
      719      end.
      720      procedure WaitFramWaitFor:
      721         define input  parameter iInterval as dec no-undo.
      722         assign
      723            mWaitFramStartProc   = now
      724            mWaitFramStopUser    = no
      725            mWaitFramStopTimeOut = no
      726         .
      727         block-wait:
      728         do while not mWaitFramStop:
      729            run WaitFramRunPause (iInterval).
      730            if  waitfram-check-timeout()
      731            then do:
      732               leave block-wait.
      733            end.
      734         end.
      735         run waitfram-hide.
      736      end.
      737   procedure waitfram-join :
      738     define input  parameter p-line-1  as character no-undo .
      739     define input  parameter p-line-2  as character no-undo .
      740     define input  parameter p-line-3  as character no-undo .
      741     define output parameter p-message as character no-undo .
      742     do
      743     on error undo, return error return-value
      744     :
      745       assign
      746         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      747                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      748                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      749       .
      750     end.
      751   end procedure.
      752   function waitfram-join-function returns character
      753     (input p-line-1 as character
      754     ,input p-line-2 as character
      755     ,input p-line-3 as character
      756     ).
      757     define variable v-message as character no-undo .
      758     run waitfram-join in this-procedure
      759       (input  p-line-1
      760       ,input  p-line-2
      761       ,input  p-line-3
      762       ,output v-message
      763       ) .
      764     return v-message .
      765   end function .
      766   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      767   procedure get-ro_get-read-only :
      768     define output parameter p-ro-set as logical   no-undo .
      769     do
      770     on error  undo, return error substitute( "&1(get-ro_get-read-only). &2&3&4", vss-include-info3, return-value, error-status :get-message( 1 ) )
      771     on stop   undo, return error substitute( "&1(get-ro_get-read-only). stop", vss-include-info3 )
      772     on endkey undo, return error substitute( "&1(get-ro_get-read-only). endkey", vss-include-info3 )
      773     :
      774       if lookup( 'READ-ONLY':U, DBRESTRICTIONS('ub':U) ) > 0
      775       then do:
      776         assign
      777           p-ro-set = true
      778         .
      779       end.
      780       else do:
      781         assign
      782           p-ro-set = false
      783         .
      784       end.
      785     end.
      786   end procedure.
      787   define stream slog .
      788   define variable lwasprocessing as logical   no-undo .
      789   define variable v-get-ro_read-only as logical   no-undo .
      790   main-block:
      791   do
      792   on error undo main-block, return error
      793   :
      794     run get-ro_get-read-only in this-procedure
      795       (output v-get-ro_read-only
      796       ) .
      797     run process-documents in this-procedure
      798       (input 1
      799       ,input 'hold':U
      800       ,input 'hold':U
      801       ) no-error .
      802     if error-status :error
      803     then do:
      804       return error return-value .
      805     end.
      806     run process-documents in this-procedure
      807       (input 2
      808       ,input 'hinv':U
      809       ,input 'hinv':U
      810       ) no-error .
      811     if error-status :error
      812     then do:
      813       return error return-value .
      814     end.
      815     run process-documents in this-procedure
      816       (input 3
      817       ,input 'hspi':U
      818       ,input 'hspi':U
      819       ) no-error .
      820     if error-status :error
      821     then do:
      822       return error return-value .
      823     end.
      824     if lwasprocessing then do:
      825       return "true":u .
      826     end.
      827     else do:
      828       return "":u .
      829     end.
      830   end.
      831   procedure process-documents :
      832     define input  parameter p-cat-code as integer   no-undo .
      833     define input  parameter p-lock-code as character no-undo .
      834     define input  parameter p-btpr-type-code as character no-undo .
      835     define variable v-today as date      no-undo.
      836     define variable v-time  as integer   no-undo.
      837     define buffer buf_batchprocess            for ub.batchprocess .
      838     define buffer update_batchprocess         for ub.batchprocess .
      839     define buffer calc-hold-lock_batchprocess for ub.batchprocess .
      840     define buffer buf_trn-doc                 for ub.trn-doc .
      841     do
      842     on error undo, return error
      843     :
      844       if v-get-ro_read-only = false
      845       then do:
      846         run gbl/lock-prc.p
      847           (input p-lock-code
      848           ,input p-cat-code
      849           ,input 0
      850           ,input 0
      851           ,input ""
      852           ,input ""
      853           ,input ""
      854           ,input "Категория,,,,,,Расчет межфирменных архивов"
      855           ,input false
      856           ,buffer calc-hold-lock_batchprocess
      857           ) no-error .
      858         if error-status :error
      859         then do:
      860           if error-status :get-message(1) <> ""
      861           then do:
      862             message
      863               vss-workfile vss-revision vss-description skip
      864               "Ошибка при попытке заблокировать ресурс" skip
      865               "Невозможно произвести расчет межфирменного архива" skip
      866               "Категория" p-cat-code skip
      867               error-status :get-message(1) skip
      868               return-value skip
      869               view-as alert-box error .
      870             undo, return error substitute("&1: Ошибка при попытке заблокировать ресурс &2"
      871                                         ,vss-workfile
      872                                         ,error-status :get-message(1)
      873                                         ).
      874           end.
      875           undo, return error substitute("В данный момент рассчитывается межфирменный архив категории &1"
      876                                       ,p-cat-code ) .
      877         end.
      878       end.
      879       define variable v-hold-calc-value as character no-undo .
      880       define variable v-hold-calc-type  as character no-undo .
      881       define variable v-hold-calc       as logical   no-undo .
      882       run holdattr-value in this-procedure
      883         (input  p-cat-code
      884         ,input  'is-calc':U
      885         ,output v-hold-calc-value
      886         ,output v-hold-calc-type
      887         ) .
      888       assign
      889         v-hold-calc = (lookup(v-hold-calc-value, 'yes,true') > 0)
      890       .
      891       if v-hold-calc = true then do:
      892         return .
      893       end.
      894       define variable v-attr-begin-date-value as character no-undo .
      895       define variable v-attr-begin-date-type  as character no-undo .
      896       define variable v-attr-begin-date       as date      no-undo .
      897       assign
      898         v-attr-begin-date = ?
      899       .
      900       run holdattr-value in this-procedure
      901         (input  p-cat-code
      902         ,input  'begin-date':U
      903         ,output v-attr-begin-date-value
      904         ,output v-attr-begin-date-type
      905         ) .
      906       if v-attr-begin-date-value <> "" then do:
      907         assign
      908           v-attr-begin-date = date(v-attr-begin-date-value)
      909         .
      910       end.
      911       define buffer buf_hold-time for ub.hold-time .
      912       for each buf_hold-time share-lock
      913         where buf_hold-time.cat-code  = p-cat-code
      914           and buf_hold-time.time-type = 'мес':U
      915           and buf_hold-time.status_   = 'удаленные':U
      916       on error undo, return error
      917       :
      918         if v-get-ro_read-only = false
      919         then do:
      920           run trg/harhrclc.p
      921             (input buf_hold-time.cat-code
      922             ,input p-lock-code
      923             ,input p-btpr-type-code
      924             ,input buf_hold-time.start-date
      925             ) no-error .
      926           if error-status :error
      927           then do:
      928             return error return-value .
      929           end.
      930         end.
      931         else do:
      932           undo, return error "Межфирменный архив требует перерасчета. Невозможно выполнить перерасчет в режиме только_для_чтения." .
      933         end.
      934       end.
      935       for each buf_BatchProcess share-lock
      936         where buf_BatchProcess.bp_type   = p-btpr-type-code
      937           and buf_BatchProcess.bp_status = 'N':U
      938       on error undo, return error
      939       :
      940         if v-get-ro_read-only = false
      941         then do:
      942           find first buf_trn-doc no-lock
      943             where buf_trn-doc.doc-code = buf_batchprocess.charkey_one
      944             no-error .
      945           if available buf_trn-doc
      946           then do:
      947             run waitfram-show in this-procedure
      948               (input substitute("Расчет межфирменного архива категории &1. Документ &2. Дата &3"
      949                               ,p-cat-code
      950                               ,buf_trn-doc.doc-code
      951                               ,buf_trn-doc.fact-date
      952                               )
      953               ) .
      954             if p-last-date = ?
      955             or ( p-last-date <> ?
      956                 and buf_trn-doc.fact-date <= p-last-date
      957                 )
      958             then do:
      959               if  v-attr-begin-date <> ?
      960               and buf_trn-doc.fact-date < v-attr-begin-date
      961               then do:
      962                 run cur-time in this-procedure
      963                   (output v-today
      964                   ,output v-time
      965                   ).
      966                 output stream slog to objhold.txt append .
      967                 export stream slog
      968                   string(v-today, '99/99/9999':u)
      969                   string(v-time, 'HH:MM:SS':u)
      970                   buf_trn-doc.doc-code
      971                   'mark_deleted':u
      972                   p-cat-code
      973                   .
      974                 output stream slog close .
      975                 do transaction
      976                 on error undo, return error return-value
      977                 :
      978     find first update_batchprocess exclusive-lock
      979       where rowid(update_batchprocess) = rowid(buf_batchprocess)
      980       no-error .
      981     if not available update_batchprocess then do:
      982       message
      983         vss-workfile vss-revision vss-description skip
      984         "Не найдена запись пересчета архива" skip
      985         view-as alert-box error .
      986       undo, return error .
      987     end.
      988     if update_batchprocess.bp_status <> 'N':U then do:
      989       message
      990         vss-workfile vss-revision vss-description skip
      991         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
      992         "BP_Type"       update_batchprocess.BP_Type       skip
      993         "BP_Status"     update_batchprocess.BP_Status     skip
      994         "Key#_One"      update_batchprocess.Key#_One      skip
      995         "Key#_Two"      update_batchprocess.Key#_Two      skip
      996         "Key#_Three"    update_batchprocess.Key#_Three    skip
      997         "CharKey_One"   update_batchprocess.CharKey_One   skip
      998         "CharKey_Two"   update_batchprocess.CharKey_Two   skip
      999         "CharKey_Three" update_batchprocess.CharKey_Three skip
     1000         view-as alert-box error .
     1001       undo, return error .
     1002     end.
     1003       define variable v-btpr_upd-today-4 as date      no-undo.
     1004     define variable v-btpr_upd-time-4  as integer   no-undo.
     1005     run cur-time in this-procedure ( output v-btpr_upd-today-4
     1006                                    , output v-btpr_upd-time-4
     1007                                    ).
     1008     assign
     1009       update_batchprocess.bp_status         = 'D':U
     1010       update_batchprocess.bp_execcounttries = update_batchprocess.bp_execcounttries + 1
     1011       update_batchprocess.bp_execuser_id    = g#userid
     1012       update_batchprocess.bp_execsysdate    = v-btpr_upd-today-4
     1013       update_batchprocess.bp_execsystime    = string(v-btpr_upd-time-4, 'hh:mm')
     1014       update_batchprocess.bp_execsystimeint = v-btpr_upd-time-4
     1015     .
     1016                 end.
     1017               end.
     1018               else do:
     1019                 if p-check-act = true
     1020                 then do:
     1021                   def var v-ok as logical   no-undo .
     1022   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1023   do:
     1024     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1025       (input  p-check-act-db-num
     1026       ,input  p-check-act-user-id
     1027       ,input  0
     1028       ,input  'actn_archive-hold_update':U
     1029       ,input  'global':U
     1030       ,input  0
     1031       ,input  '':U
     1032       ,input  0
     1033       ,input  0
     1034       ,input  0
     1035       ,input  0
     1036       ,input  false
     1037       ,output v-ok
     1038       )  .
     1039   end.
     1040                   if v-ok <> true
     1041                   then do:
     1042                                       undo, return error substitute("Отсутствуют права на расчет межфирменного архива (&1/&2/&3)"
     1043                       ,return-value
     1044                       ,'архив-межфирм':U
     1045                       ,'ИЗМЕНЕНИЕ':U
     1046                       ) .
     1047                   end.
     1048                 end.
     1049                 run cur-time in this-procedure
     1050                   (output v-today
     1051                   ,output v-time
     1052                   ).
     1053                 output stream slog to objhold.txt append .
     1054                 export stream slog
     1055                   string(v-today, '99/99/9999':u)
     1056                   string(v-time, 'HH:MM:SS':u)
     1057                   buf_trn-doc.doc-code
     1058                   'calc':u
     1059                   p-cat-code
     1060                   .
     1061                 output stream slog close .
     1062                 assign
     1063                   lwasprocessing = true
     1064                 .
     1065                 do transaction
     1066                 on error undo, return error
     1067                 :
     1068     find first update_batchprocess exclusive-lock
     1069       where rowid(update_batchprocess) = rowid(buf_batchprocess)
     1070       no-error .
     1071     if not available update_batchprocess then do:
     1072       message
     1073         vss-workfile vss-revision vss-description skip
     1074         "Не найдена запись пересчета архива" skip
     1075         view-as alert-box error .
     1076       undo, return error .
     1077     end.
     1078     if update_batchprocess.bp_status <> 'N':U then do:
     1079       message
     1080         vss-workfile vss-revision vss-description skip
     1081         "Запись пересчета архива имеет статус, отличный от" 'N':U skip
     1082         "BP_Type"       update_batchprocess.BP_Type       skip
     1083         "BP_Status"     update_batchprocess.BP_Status     skip
     1084         "Key#_One"      update_batchprocess.Key#_One      skip
     1085         "Key#_Two"      update_batchprocess.Key#_Two      skip
     1086         "Key#_Three"    update_batchprocess.Key#_Three    skip
     1087         "CharKey_One"   update_batchprocess.CharKey_One   skip
     1088         "CharKey_Two"   update_batchprocess.CharKey_Two   skip
     1089         "CharKey_Three" update_batchprocess.CharKey_Three skip
     1090         view-as alert-box error .
     1091       undo, return error .
     1092     end.
     1093       define variable v-btpr_upd-today-6 as date      no-undo.
     1094     define variable v-btpr_upd-time-6  as integer   no-undo.
     1095     run cur-time in this-procedure ( output v-btpr_upd-today-6
     1096                                    , output v-btpr_upd-time-6
     1097                                    ).
     1098     assign
     1099       update_batchprocess.bp_status         = 'D':U
     1100       update_batchprocess.bp_execcounttries = update_batchprocess.bp_execcounttries + 1
     1101       update_batchprocess.bp_execuser_id    = g#userid
     1102       update_batchprocess.bp_execsysdate    = v-btpr_upd-today-6
     1103       update_batchprocess.bp_execsystime    = string(v-btpr_upd-time-6, 'hh:mm')
     1104       update_batchprocess.bp_execsystimeint = v-btpr_upd-time-6
     1105     .
     1106                   run trg/harhtclc.p
     1107                     (input p-cat-code
     1108                     ,input p-lock-code
     1109                     ,input p-btpr-type-code
     1110                     ,input buf_trn-doc.doc-code
     1111                     ) no-error .
     1112                   if error-status :error
     1113                   then do:
     1114                     return error return-value .
     1115                   end.
     1116                 end.
     1117               end.
     1118             end.
     1119           end.
     1120         end.
     1121         else do:
     1122           undo, return error "Межфирменный архив требует расчета. Невозможно выполнить расчет в режиме только_для_чтения." .
     1123         end.
     1124       end.
     1125       run waitfram-hide in this-procedure .
     1126     end.
     1127   end procedure.
