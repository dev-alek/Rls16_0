        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.rp-by-call.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление Привязки профайла к месту".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3'
       29                            , ub.rp-by-call.profile_id
       30                            , ub.rp-by-call.call#_id
       31                            , ub.rp-by-call.once-more
       32                            )
       33       .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure cur-time :
       87      define output parameter p-today as date      no-undo .
       88      define output parameter p-time  as integer   no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       define variable v-date1 as date      no-undo .
       93       define variable v-date2 as date      no-undo .
       94       define variable v-time  as integer   no-undo .
       95       assign
       96         v-date1 = today
       97         v-time  = time
       98         v-date2 = today
       99       .
      100       if v-date1 <> v-date2
      101       then do:
      102         assign
      103           v-date1 = today
      104           v-time  = v-time
      105         .
      106       end.
      107       assign
      108         p-today = v-date1
      109         p-time  = v-time
      110       .
      111     end.
      112   end.
      113   function cur-time-date returns character
      114   :
      115     return string(today, '99/99/9999':U) .
      116   end.
      117   function cur-time-mjd returns decimal
      118   :
      119     define variable v-date as date      no-undo .
      120     define variable v-time as integer   no-undo .
      121     run cur-time in this-procedure
      122       (output v-date
      123       ,output v-time
      124       ) .
      125     return integer(v-date) - 2400002 + (v-time / 86400) .
      126   end.
      127   function cur-time-get-ending-index returns integer
      128   (input p-number as integer
      129   )
      130   :
      131     if p-number < 0
      132     or p-number = ?
      133     then do:
      134       return 1 .
      135     end.
      136     define variable v-rest as integer   no-undo .
      137     assign
      138       p-number = p-number modulo 100
      139     .
      140     if p-number < 20
      141     then do:
      142       assign
      143         v-rest = p-number
      144       .
      145     end.
      146     else do:
      147       assign
      148         v-rest = p-number modulo 10
      149       .
      150     end.
      151     case v-rest :
      152       when 1
      153       then do:
      154         return 2 .
      155       end.
      156       when 2 or
      157       when 3 or
      158       when 4
      159       then do:
      160         return 3 .
      161       end.
      162       otherwise do:
      163         return 1 .
      164       end.
      165     end case .
      166   end.
      167   procedure cur-time-mjd-to-date :
      168      define input  parameter i-mjd-diff as decimal no-undo.
      169      define output parameter o-Date     as date    no-undo.
      170      define output parameter o-Time     as integer no-undo.
      171      define variable v-day-number as integer   no-undo .
      172      if    i-mjd-diff < 0
      173         or i-mjd-diff = ?
      174      then do:
      175         return "?" .
      176      end.
      177      assign
      178         v-day-number = truncate(i-mjd-diff,0).
      179         o-Date = date(v-day-number + 2400002).
      180         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      181     .
      182   end.
      183   function cur-time-mjd-to-string returns character
      184   (input p-mjd-diff as decimal
      185   )
      186   :
      187     define variable v-day-number as integer   no-undo .
      188     define variable v-seconds    as integer   no-undo .
      189     define variable v-hour       as integer   no-undo .
      190     define variable v-min        as integer   no-undo .
      191     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      192     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      193     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      194     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      195     if p-mjd-diff < 0
      196     or p-mjd-diff = ?
      197     then do:
      198       return "?" .
      199     end.
      200     assign
      201       v-day-number = integer(truncate(p-mjd-diff,0))
      202       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204     if v-seconds > 86400
      205     then do:
      206       assign
      207         v-seconds = 86400 - 1
      208       .
      209     end.
      210     if v-seconds < 0
      211     then do:
      212       assign
      213         v-seconds = 0
      214       .
      215     end.
      216     assign
      217       v-hour = truncate(v-seconds / 3600, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 3600
      221     .
      222     assign
      223       v-min = truncate(v-seconds / 60, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 60
      227     .
      228     return
      229         (if v-day-number <> 0
      230           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0
      234           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      238           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      239           else ""
      240         )
      241       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      242       .
      243   end.
      244   function cur-time-string returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      253   end.
      254   function cur-time-string-sec returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      263   end.
      264   function cur-time-custom  returns character
      265   (input p-prefix as character
      266   ,input p-date-format as character
      267   ,input p-delimiter as character
      268   ,input p-time-format as character
      269   ,input p-suffix as character
      270   )
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return
      279       p-prefix
      280       + string(v-date, p-date-format)
      281       + p-delimiter
      282       + string(v-time, p-time-format)
      283       + p-suffix
      284       .
      285   end.
      286   function cur-time-print  returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-datetime returns datetime
      297   :
      298     define variable v-char as character no-undo .
      299     define variable v-datetime as datetime no-undo .
      300     v-char = cur-time-string().
      301     v-datetime = datetime(v-char).
      302     return  v-datetime.
      303   end.
      304   function cur-time-string-msec returns character
      305   :
      306     define variable v-date as datetime  no-undo .
      307     v-date = now.
      308     return string(v-date) .
      309   end.
      310   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      311   procedure gen-key-rec :
      312     define input  parameter p-tbl-name    as character no-undo.
      313     define input  parameter p-bh_tbl-name as handle    no-undo.
      314     define output parameter p-key-rec     as character no-undo.
      315     do
      316     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      317     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      318     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      319     :
      320       define variable fh               as handle    no-undo .
      321       define variable v-ok             as logical   no-undo .
      322       define variable v-inform         as character no-undo .
      323       define variable v-ind            as integer   no-undo .
      324       define variable v-idx-field-qnty as integer   no-undo .
      325       if p-tbl-name = ?
      326         or p-tbl-name = "":U
      327       then do:
      328         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      329       end.
      330       if not p-bh_tbl-name:available then do:
      331         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      332       end.
      333       assign
      334         p-key-rec = p-tbl-name
      335         v-inform  = p-bh_tbl-name:index-information(1)
      336         v-ind     = 2
      337       .
      338       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      339       on error undo, return error
      340       :
      341         assign
      342           v-inform = p-bh_tbl-name:index-information( v-ind )
      343           v-ind    = v-ind + 1
      344         .
      345       end.
      346       if v-inform = ?
      347         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      348         or entry( 3, v-inform, ",":U ) <> "1":U
      349       then do:
      350         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      351       end.
      352       else do:
      353         assign
      354           v-idx-field-qnty = num-entries( v-inform ) - 4
      355         .
      356         if v-idx-field-qnty < 2 then do:
      357           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      358         end.
      359         do v-ind = 1 to v-idx-field-qnty by 2
      360         on error undo, return error
      361         :
      362           assign
      363             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      364             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      365           .
      366         end.
      367       end.
      368       if p-key-rec = ? then do:
      369         assign
      370           p-key-rec = "":U
      371         .
      372         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      373       end.
      374     end.
      375     return.
      376   end procedure.
      377   procedure gen-where-keyr-tab :
      378     define input  parameter i-tableSerach as character no-undo.
      379     define input  parameter i-tablekey   as character  no-undo.
      380     define input  parameter p-key-rec    as character  no-undo.
      381     define input  parameter p-key-handle as handle     no-undo .
      382     define input  parameter p-db-name    as character  no-undo .
      383     define input  parameter p-tt-handle  as handle     no-undo .
      384     define output parameter o-Where      as character  no-undo.
      385     do
      386     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      387     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      388     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      389     :
      390       define variable v-full-tbl-name  as character no-undo .
      391       define variable bh_tbl-name      as handle    no-undo .
      392       define variable fh_key           as handle    no-undo .
      393       define variable fh_search        as handle    no-undo .
      394       define variable v-field-num      as integer   no-undo .
      395       define variable v-count-fld      as integer   no-undo .
      396       define variable v-inform         as character no-undo .
      397       define variable v-ind            as integer   no-undo .
      398       define variable v-idx-field-qnty as integer   no-undo .
      399       define variable v-field-name     as character no-undo .
      400       define variable v-field-val      as character no-undo .
      401       define variable v-word-link      as character no-undo .
      402       define variable vTable           as character no-undo.
      403       define variable bh_tbl-key       as handle    no-undo .
      404       assign
      405         p-key-rec = trim( p-key-rec )
      406       .
      407       if p-key-handle <> ? then do:
      408         if not valid-handle(p-key-handle)
      409            or p-key-handle:type <> "buffer"
      410         then do:
      411           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      412         end.
      413         if num-entries( p-key-rec, chr(3) ) > 1
      414           or p-key-rec = ?
      415           or p-key-rec = "":U
      416         then do:
      417           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      418         end.
      419       end.
      420       else do:
      421         if p-key-rec = ?
      422           or p-key-rec = "":U
      423         then do:
      424           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      425         end.
      426       end.
      427       assign
      428         vTable = entry( 1 , p-key-rec, chr(3) )
      429       .
      430       if p-tt-handle <> ?
      431         and ( not valid-handle(p-tt-handle)
      432               or p-tt-handle:type <> "buffer"
      433             )
      434       then do:
      435         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      436       end.
      437       if p-tt-handle = ? then do:
      438         assign
      439           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      440         .
      441         create buffer bh_tbl-name for table v-full-tbl-name .
      442       end.
      443       else do:
      444         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      445       end.
      446       assign
      447         v-inform = bh_tbl-name:index-information(1)
      448         v-ind    = 2
      449       .
      450       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      451       on error undo, return error
      452       :
      453         assign
      454           v-inform = bh_tbl-name:index-information( v-ind )
      455           v-ind    = v-ind + 1
      456         .
      457       end.
      458       if v-inform = ?
      459         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      460         or entry( 3, v-inform, ",":U ) <> "1":U
      461       then do:
      462         delete object bh_tbl-name no-error.
      463         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      464       end.
      465       assign
      466         v-idx-field-qnty = num-entries( v-inform ) - 4
      467       .
      468       if v-idx-field-qnty < 2 then do:
      469         delete object bh_tbl-name no-error.
      470         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      471       end.
      472       assign
      473         o-where     = "where":U
      474         v-word-link = "":U
      475         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      476         v-count-fld = 0
      477       .
      478       if i-tablekey ne "" and i-tablekey ne ?
      479       then do:
      480         assign
      481           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      482         .
      483         create buffer bh_tbl-key for table v-full-tbl-name .
      484       end.
      485       if i-tableSerach ne "" and i-tableSerach ne ?
      486       then do:
      487         delete object bh_tbl-name no-error.
      488         assign
      489           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      490         .
      491         create buffer bh_tbl-name for table v-full-tbl-name .
      492       end.
      493       block_where:
      494       do v-ind = 1 to v-idx-field-qnty by 2
      495       on error undo, return error
      496       :
      497         assign
      498           v-count-fld = v-count-fld + 1
      499         .
      500         if p-key-handle = ?
      501           and v-count-fld > v-field-num
      502         then do:
      503           leave block_where.
      504         end.
      505         define variable VfieldKeyTable as handle no-undo.
      506         assign
      507           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      508           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      509         .
      510         if     bh_tbl-key ne ?
      511         then do:
      512            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      513            if VfieldKeyTable eq ?
      514            then next block_where.
      515         end.
      516         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      517         then
      518            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      519         else
      520            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      521         if p-key-handle = ? then do:
      522           assign
      523             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      524           .
      525         end.
      526         else do:
      527           assign
      528             fh_key = p-key-handle:buffer-field( v-field-name )
      529           .
      530           if fh_key = ?
      531             or not valid-handle( fh_key )
      532           then do:
      533             delete object bh_tbl-name.
      534             if     bh_tbl-key ne ?
      535             then
      536                delete object bh_tbl-key.
      537             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      538           end.
      539           assign
      540             v-field-val = fh_key:buffer-value
      541           .
      542         end.
      543         if fh_search:data-type ="character":U then do:
      544           assign
      545             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      546             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      547             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      548             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      549             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      550             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      551             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      552             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      553             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      554             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      555             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      556             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      557             v-field-val = substitute( '"&1"', v-field-val )
      558           .
      559         end.
      560         assign
      561           o-where = substitute( "&1 &2", o-where, v-field-val )
      562         .
      563         if v-word-link = "":U then do:
      564           assign
      565             v-word-link = "and":U
      566           .
      567         end.
      568       end.
      569       delete object bh_tbl-name.
      570       if     bh_tbl-key ne ?
      571       then
      572          delete object bh_tbl-key.
      573       if p-key-handle = ?
      574         and v-count-fld <> v-field-num
      575       then do:
      576         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      577       end.
      578     end.
      579   end procedure.
      580   procedure gen-hn-keyr-tab :
      581     define input  parameter i-tableSerach as character no-undo.
      582     define input  parameter i-tablekey   as character no-undo.
      583     define input  parameter p-key-rec    as character no-undo.
      584     define input  parameter p-key-handle as handle    no-undo .
      585     define input  parameter p-db-name    as character no-undo .
      586     define input  parameter p-tt-handle  as handle    no-undo .
      587     define input  parameter p-stts-lock  as integer   no-undo .
      588     define output parameter o-hn         as handle    no-undo.
      589     define variable v-full-tbl-name as character no-undo.
      590     define variable v-where         as character no-undo.
      591     define variable bh_tbl-name     as handle    no-undo.
      592     define variable vTable          as character no-undo.
      593     do
      594     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      595     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      596     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      597         run gen-where-keyr-tab(i-tableSerach,
      598                                i-tablekey,
      599                                p-key-rec,
      600                                p-key-handle,
      601                                p-db-name,
      602                                p-tt-handle,
      603                                output v-where).
      604         if i-tableSerach ne "" and i-tableSerach ne ?
      605         then do:
      606            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      607            create buffer bh_tbl-name for table v-full-tbl-name .
      608         end.
      609         else do:
      610            if p-tt-handle = ? then do:
      611               assign
      612                  vTable = entry( 1 , p-key-rec, chr(3) )
      613               .
      614               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      615               create buffer bh_tbl-name for table v-full-tbl-name .
      616            end.
      617            else do:
      618               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      619            end.
      620         end.
      621         if p-tt-handle = ? then do:
      622            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      623         end.
      624         else do:
      625            bh_tbl-name:find-first( v-where ) no-error .
      626         end.
      627         o-hn = bh_tbl-name.
      628      end.
      629   end procedure.
      630   procedure gen-hn-keyr :
      631     define input  parameter p-key-rec    as character no-undo.
      632     define input  parameter p-key-handle as handle    no-undo .
      633     define input  parameter p-db-name    as character no-undo .
      634     define input  parameter p-tt-handle  as handle    no-undo .
      635     define input  parameter p-stts-lock  as integer   no-undo .
      636     define output parameter o-hn         as handle    no-undo.
      637     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      638   end.
      639   procedure gen-row-keyr :
      640     define input  parameter p-key-rec    as character no-undo.
      641     define input  parameter p-key-handle as handle    no-undo .
      642     define input  parameter p-db-name    as character no-undo .
      643     define input  parameter p-tt-handle  as handle    no-undo .
      644     define input  parameter p-stts-lock  as integer   no-undo .
      645     define output parameter p-tbl-row    as rowid     no-undo.
      646     define output parameter p-tbl-name   as character no-undo.
      647     define variable vHn as handle no-undo.
      648       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      649       p-tbl-row = if vHn:available then vHn:rowid else ?.
      650       p-tbl-name =  vHn:table.
      651       delete object vHn no-error.
      652     if p-tbl-row = ? then do:
      653       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      654     end.
      655     else do:
      656       return.
      657     end.
      658   end procedure.
      659   procedure gen-key-fv :
      660     define input  parameter p-key-rec    as character no-undo .
      661     define output parameter p-field-list as character no-undo .
      662     define output parameter p-value-list as character no-undo.
      663     do
      664     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      665     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      666     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      667     :
      668       define variable v-full-tbl-name  as character no-undo .
      669       define variable bh_tbl-name      as handle    no-undo .
      670       define variable v-tbl-name       as character no-undo .
      671       define variable v-field-num      as integer   no-undo .
      672       define variable v-count-fld      as integer   no-undo .
      673       define variable v-inform         as character no-undo .
      674       define variable v-ind            as integer   no-undo .
      675       define variable v-idx-field-qnty as integer   no-undo .
      676       define variable v-delim-key      as character no-undo .
      677       if p-key-rec = ?
      678         or p-key-rec = "":U
      679       then do:
      680         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      681       end.
      682       assign
      683         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      684         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      685       .
      686       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      687       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      688       assign
      689         v-inform = bh_tbl-name:index-information(1)
      690         v-ind    = 2
      691       .
      692       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      693       on error undo, return error
      694       :
      695         assign
      696           v-inform = bh_tbl-name:index-information( v-ind )
      697           v-ind    = v-ind + 1
      698         .
      699       end.
      700       if v-inform = ?
      701         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      702         or entry( 3, v-inform, ",":U ) <> "1":U
      703       then do:
      704         delete object bh_tbl-name no-error.
      705         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      706       end.
      707       assign
      708         v-idx-field-qnty = num-entries( v-inform ) - 4
      709       .
      710       if v-idx-field-qnty < 2 then do:
      711         delete object bh_tbl-name no-error.
      712         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      713       end.
      714       assign
      715         p-field-list = "":U
      716         p-value-list = "":U
      717         v-delim-key  = "":U
      718         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      719         v-count-fld  = 0
      720       .
      721       block_where:
      722       do v-ind = 1 to v-idx-field-qnty by 2
      723       on error undo, return error
      724       :
      725         assign
      726           v-count-fld = v-count-fld + 1
      727         .
      728         if v-count-fld > v-field-num then do:
      729           leave block_where.
      730         end.
      731         assign
      732           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      733           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      734         .
      735         if v-ind = 1 then do:
      736           assign
      737             v-delim-key = chr(3)
      738           .
      739         end.
      740       end.
      741       delete object bh_tbl-name.
      742       if v-count-fld <> v-field-num then do:
      743         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      744       end.
      745     end.
      746   end procedure.
      747   procedure gen-key-field :
      748     define input  parameter p-table      as character no-undo .
      749     define output parameter p-field-list as character no-undo .
      750     do
      751     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      752     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      753     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      754     :
      755       define variable v-full-tbl-name  as character no-undo .
      756       define variable bh_tbl-name      as handle    no-undo .
      757       define variable v-tbl-name       as character no-undo .
      758       define variable v-field-num      as integer   no-undo .
      759       define variable v-count-fld      as integer   no-undo .
      760       define variable v-inform         as character no-undo .
      761       define variable v-ind            as integer   no-undo .
      762       define variable v-idx-field-qnty as integer   no-undo .
      763       define variable v-delim-key      as character no-undo .
      764       if p-table = ?
      765         or p-table = "":U
      766       then do:
      767         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      768       end.
      769       assign
      770         v-tbl-name      = p-table
      771         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      772       .
      773       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      774       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      775       assign
      776         v-inform = bh_tbl-name:index-information(1)
      777         v-ind    = 2
      778       .
      779       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      780       on error undo, return error
      781       :
      782         assign
      783           v-inform = bh_tbl-name:index-information( v-ind )
      784           v-ind    = v-ind + 1
      785         .
      786       end.
      787       if v-inform = ?
      788         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      789         or entry( 3, v-inform, ",":U ) <> "1":U
      790       then do:
      791         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      792       end.
      793       assign
      794         v-idx-field-qnty = num-entries( v-inform ) - 4
      795       .
      796       if v-idx-field-qnty < 2 then do:
      797         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      798       end.
      799       assign
      800         p-field-list = "":U
      801         v-delim-key  = "":U
      802         v-count-fld  = 0
      803       .
      804       block_where:
      805       do v-ind = 1 to v-idx-field-qnty by 2
      806       on error undo, return error
      807       :
      808         assign
      809           v-count-fld = v-count-fld + 1
      810         .
      811         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      812         if v-ind = 1 then do:
      813           assign
      814             v-delim-key = chr(3)
      815           .
      816         end.
      817       end.
      818       delete object bh_tbl-name.
      819     end.
      820   end procedure.
      821   define variable v-date as date no-undo .
      822   define variable v-time as integer no-undo .
      823   define variable v-field-list as character no-undo .
      824   define variable v-value-list as character no-undo .
      825   define variable v-host-code as integer no-undo .
      826   define buffer buf_c-rp-by-call for ub.c-rp-by-call.
      827   define buffer buf_c-dis-card-type for ub.c-dis-card-type.
      828   define buffer buf_c-thbj-attr for ub.c-thbj-attr.
      829   define buffer buf_c-cli-hist for ub.c-cli-hist.
      830   main-block:
      831   do
      832   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      833   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      834   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      835   :
      836     if not g#news
      837     or g#db-num <> 0 then do:
      838       run cur-time in this-procedure ( output v-date, output v-time).
      839       create buf_c-rp-by-call.
      840       assign
      841       buf_c-rp-by-call.call_id = ub.rp-by-call.call_id
      842       buf_c-rp-by-call.call#_id = ub.rp-by-call.call#_id
      843       buf_c-rp-by-call.profile_id = ub.rp-by-call.profile_id
      844       buf_c-rp-by-call.once-more = ub.rp-by-call.once-more
      845       buf_c-rp-by-call.corr-time          = v-time
      846       buf_c-rp-by-call.corr-user-db-num   = g#db-num
      847       buf_c-rp-by-call.corr-user-name     = (if g#news
      848                                       then (chr(4) +  'СПН':U)
      849                                       else g#userid)
      850       buf_c-rp-by-call.corr-date          = v-date
      851       .
      852       run  gen-key-fv in this-procedure (
      853                                           input ub.rp-by-call.call_id
      854                                           ,output v-field-list
      855                                           ,output v-value-list).
      856       if ub.rp-by-call.call_id begins 'dis-card-type':U then do:
      857         create buf_c-dis-card-type.
      858         buffer-copy buf_c-rp-by-call
      859         except chip-num
      860         to buf_c-dis-card-type
      861         assign
      862         buf_c-dis-card-type.chip-num = next-value (s-dc-chip, ub)
      863         buf_c-rp-by-call.chip-num           = buf_c-dis-card-type.chip-num
      864         buf_c-dis-card-type.uniq-key-rec = buf_c-rp-by-call.call_id
      865         buf_c-dis-card-type.type =  entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      866         buf_c-dis-card-type.emitent-host-code = integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)))
      867         buf_c-dis-card-type.action             = integer('99':U)
      868         buf_c-dis-card-type.subject            = 'rp-by-call':U
      869         .
      870       end.
      871       if ub.rp-by-call.call_id begins 'thbj-attr':U then do:
      872         create buf_c-thbj-attr.
      873         buffer-copy buf_c-rp-by-call
      874         except chip-num
      875         to buf_c-thbj-attr
      876         assign
      877         buf_c-thbj-attr.chip-num =  next-value (s-cli-chip, ub)
      878         buf_c-rp-by-call.chip-num    = buf_c-thbj-attr.chip-num
      879         buf_c-thbj-attr.prop-code         = entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3))
      880         buf_c-thbj-attr.upper-prop-code   = entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3))
      881         buf_c-thbj-attr.obj-type          = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      882         buf_c-thbj-attr.obj-code          = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)))
      883         buf_c-thbj-attr.action             = integer('99':U)
      884         buf_c-thbj-attr.subject            = 'rp-by-call':U
      885         .
      886         if buf_c-thbj-attr.obj-type = 'маг':U
      887         or buf_c-thbj-attr.obj-type = 'скл':U then do:
      888   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      890     (input  buf_c-thbj-attr.obj-type
      891     ,input  buf_c-thbj-attr.obj-code
      892     ,output v-host-code
      893     )  .
      894         end.
      895         if buf_c-thbj-attr.obj-type = 'орг':U then do:
      896           assign
      897           v-host-code = buf_c-thbj-attr.obj-code.
      898         end.
      899         create buf_c-cli-hist.
      900         buffer-copy buf_c-thbj-attr to buf_c-cli-hist
      901         assign
      902         buf_c-cli-hist.action = integer('99':U)
      903         buf_c-cli-hist.subject = 'thbj-attr':U
      904         buf_c-cli-hist.host-code = v-host-code
      905         buf_c-cli-hist.is-news = g#news
      906         buf_c-cli-hist.source-type = (if g#news then 'db':U else "":U)
      907         buf_c-cli-hist.source-ref = (if g#news then string(g#news-source-db) else "":U)
      908         .
      909       end.
      910       if ub.rp-by-call.call_id begins 'schedule':U then do:
      911         buf_c-rp-by-call.chip-num = next-value(s-ref-corr-chip, ub).
      912     end.
      913     end.
      914     if g#oxml = yes
      915     then do:
      916     run str/calloxml.p (
      917           input 'delete':U
      918         , input 'rp-by-call':U
      919         , input ( buffer ub.rp-by-call:handle )
      920     ) no-error.
      921       if error-status :error
      922       then do:
      923           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      924                                 , chr(10)
      925                                 , vss-workfile
      926                                 , return-value
      927                                 , error-status :get-message ( 1 ) ).
      928       end.
      929     end.
      930   end.
