      659   DEFINE VARIABLE var-entry as character no-undo .
      660   define variable v-mes     as character no-undo .
      661   define variable v-file    as logical no-undo .
      662   define variable v-type as character no-undo .
      663   define buffer buf_clients for ub.clients .
      664   define buffer buf_wth-line for ub.wth-line .
      665   define buffer current-place for ub.wth-place .
      666   define buffer out-place for ub.wth-place .
      667   define buffer buf_operator for ub.clients .
      668   define buffer buf_deliver for ub.clients .
      669   define buffer buf_receiver for ub.clients .
      670   define buffer bind_wth-doc for ub.wth-doc .
      671   define buffer bind_inkas for ub.inkas .
      672   define variable v-chk-wth-prs  as logical   no-undo.
      673   define variable conf-par as character no-undo.
      674   define variable par-type as character no-undo.
      675   _main:
      676   do
      677   on error undo, return error
      678   :
      679   FIND FIRST ub.sysconf No-LOCK WHERE
      680              ub.sysconf.host-code = parhost-code No-ERROR.
      681   IF NOT AVAIL ub.sysconf THEN DO:
      682     v-mes = substitute("Не найдена фирма &1", parhost-code).
      683     run err-mess(input-output v-mes).
      684     undo _main, return error v-mes.
      685   END.
      686   if lookup(parext-type,'rj,rf,rp':U) > 0 and pardoc-type <> 'возврат':U or
      687      lookup(parext-type,'we,dc,dp,df':U) > 0 and pardoc-type <> 'спи':U or
      688      lookup(parext-type,'ee,ei,ej,jj,oj,ce,ef,ep':U) > 0 and pardoc-type <> 'рас':U or
      689      lookup(parext-type,'ie,ii,ij,fj,pj,ip,ff,pc,ps,pz,ci':U) > 0 and pardoc-type <> 'при':U then do:
      690        v-mes = substitute("Расширенный тип документа &1 не соответствует типу документа &2",parext-type, pardoc-type).
      691        run err-mess(input-output v-mes).
      692        undo _main, return error (v-mes).
      693   end.
      694   if parauto-fill and parobj-type = 'скл':U then do:
      695     v-mes = substitute("Для автоматического документа объект документа &1&2 должен быть магазином", parobj-type, parobj-code).
      696     run err-mess(input-output v-mes).
      697     var-entry = "obj-code":U.
      698     undo _main, return error (if p-silent then v-mes else var-entry).
      699   end.
      700   if parauto-fill and pardoc-type = 'спи':U then do:
      701     v-mes = substitute("Не бывает автоматических документов с типом", pardoc-type).
      702     run err-mess(input-output v-mes).
      703     undo _main, return error (v-mes).
      704   end.
      705   if parauto-fill and parlines-exist then do:
      706     if (
      707         (parcli-type = ub.sysconf.sale-type AND
      708          parcli-code = ub.sysconf.sale-code) AND
      709          can-find(first ub.chk-doc No-LOCK WHERE
      710                         ub.chk-doc.obj-type = parobj-type
      711                     and ub.chk-doc.obj-code = parobj-code
      712                     and ub.chk-doc.out-code = pardoc-code)
      713        ) then do:
      714       v-mes = substitute("К автодокументу МЦ для контрагента &1&2 не могут быть привязаны чеки МЦ", parcli-type, parcli-code).
      715       run err-mess(input-output v-mes).
      716       undo _main, return error (v-mes).
      717     end.
      718     if ( not par-borned and
      719          NOT (parcli-type = ub.sysconf.sale-type AND
      720              parcli-code = ub.sysconf.sale-code) AND
      721          NOT can-find(first ub.chk-doc No-LOCK WHERE
      722                             ub.chk-doc.out-code = pardoc-code)
      723       ) then do:
      724       v-mes = substitute("К данному автодокументу должны быть привязаны чеки МЦ").
      725       run err-mess(input-output v-mes).
      726       undo _main, return error (v-mes).
      727     end.
      728   end.
      729   FIND FIRST buf_clients No-LOCK WHERE
      730             buf_clients.obj-type = parcli-type AND
      731             buf_clients.obj-code = parcli-code NO-ERROR.
      732   IF NOT AVAIL buf_clients THEN DO:
      733     v-mes = substitute("Не найден клиент &1&2 в справочнике клиентов", parcli-type, parcli-code).
      734     run err-mess(input-output v-mes).
      735     var-entry = "cli-type":U.
      736     undo _main, return error (if p-silent then v-mes else var-entry).
      737   END.
      738   if buf_clients.stts <> 0 then do:
      739     v-mes = substitute( "Нельзя создавать документ для удаленного контрагента &1&2", parcli-type, parcli-code).
      740     run err-mess(input-output v-mes).
      741     var-entry = "cli-type":U.
      742     undo _main, return error (if p-silent then v-mes else var-entry).
      743   end.
      744   parcli-name = buf_clients.obj-name.
      745   IF par-inter_ AND
      746    NOT ( parcli-type = parobj-type AND
      747          parcli-code = parobj-code) then do:
      748     v-mes = substitute( "Для документа внутриобъектного перемещения МЦ неверно определен клиент &1&2", parcli-type, parcli-code).
      749     run err-mess(input-output v-mes).
      750     var-entry = "cli-type":U.
      751     undo _main, return error (if p-silent then v-mes else var-entry).
      752   end.
      753   IF par-exter_ and not parext-type = 'ps':U then do:
      754     IF
      755     (parcli-type = parobj-type AND
      756     parcli-code = parobj-code) OR
      757     parcli-type = 'маг':U OR
      758     parcli-type = 'скл':U
      759     then do:
      760       v-mes = substitute( "Для документа внешнего перемещения МЦ неверно определен клиент &1&2", parcli-type, parcli-code).
      761       run err-mess(input-output v-mes).
      762       var-entry = "cli-code":U.
      763       undo _main, return error (if p-silent then v-mes else var-entry).
      764     end.
      765   end.
      766   else if  parext-type = 'ps':U then do:
      767    IF NOT ( parcli-type = 'маг':U OR
      768             parcli-type = 'скл':U) then do:
      769       message "Для документа погашения МЦ неверно определен клиент"
      770       view-as alert-box error .
      771       var-entry =  "cli-type":U.
      772       RETURN ERROR var-entry.
      773     END.
      774   end.
      775   else do:
      776    IF NOT ( parcli-type = 'маг':U OR
      777             parcli-type = 'скл':U) then do:
      778       message "Для документа внутренного перемещения МЦ неверно определен клиент"
      779       view-as alert-box error .
      780       var-entry =  "cli-type":U.
      781       RETURN ERROR var-entry.
      782     END.
      783     CASE parcli-type:
      784       when 'маг':U then do:
      785         FIND FIRST ub.shop no-LOCK WHERE
      786                    ub.shop.obj-code = parcli-code No-ERROR.
      787         if not avail ub.shop or ub.shop.host-code <> parhost-code then do:
      788           message "Для документа внутренного перемещения МЦ неверно определен клиент" SKIP
      789                   "магазин принадлежит другой фирме"
      790           view-as alert-box .
      791           var-entry =  "cli-code":U.
      792         end.
      793       end.
      794       when 'скл':U then do:
      795         FIND FIRST ub.store no-LOCK WHERE
      796                    ub.store.obj-code = parcli-code No-ERROR.
      797         if not avail ub.store or ub.store.host-code <> parhost-code then do:
      798           message "Для документа внутренного перемещения МЦ неверно определен клиент" SKIP
      799                   "склад принадлежит другой фирме"
      800           view-as alert-box .
      801           var-entry =  "cli-code":U.
      802         end.
      803       end.
      804     END CASE.
      805   end.
      806   if pardoc-type = 'спи':U and
      807      (par-inter_ or
      808       (par-exter_ AND NOT (parcli-type = 'орг':U AND parcli-code = parhost-code))
      809      ) then do:
      810     v-mes = substitute( "Для документа внутреннего перемещения МЦ типа &1 неверно определен клиент &2&3&4склад принадлежит другой фирме"
      811                        , pardoc-type
      812                        , parcli-type
      813                        , parcli-code
      814                        , chr(10)
      815                        ).
      816     run err-mess(input-output v-mes).
      817     var-entry = "cli-code":U.
      818     undo _main, return error (if p-silent then v-mes else var-entry).
      819   end.
      820   FIND FIRST buf_wth-line No-LOCK WHERE
      821              buf_wth-line.doc-code = pardoc-code No-ERROR.
      822   IF AVAIL buf_wth-line then do:
      823     if parext-type <> 'dc':U then do:
      824       FIND FIRST current-place NO-LOCK WHERE
      825           current-place.host-code   = parhost-code AND
      826           current-place.obj-type    = parobj-type AND
      827           current-place.obj-code    = parobj-code AND
      828           current-place.w-p-code    = buf_wth-line.w-p-code  NO-ERROR.
      829       IF NOT AVAIL current-place and
      830           not (buf_wth-line.w-p-code = 0 or buf_wth-line.w-p-code = ?)
      831       THEN DO:
      832         v-mes = substitute( "Не найдено место хранения МЦ &1 в справочнике!"
      833                             ,buf_wth-line.w-p-code
      834                           ).
      835         run err-mess(input-output v-mes).
      836         var-entry = "current-w-p-code":U.
      837         undo _main, return error (if p-silent then v-mes else var-entry).
      838       END.
      839     end.
      840     if parauto-fill and current-place.cash-desk = 0 and not par-borned  then do:
      841       v-mes = substitute( "Для автоматического документа МХ МЦ &1 должно быть кассой"
      842                           ,buf_wth-line.w-p-code
      843                         ).
      844       run err-mess(input-output v-mes).
      845       var-entry = "current-w-p-code":U.
      846       undo _main, return error (if p-silent then v-mes else var-entry).
      847     end.
      848     if parobj-type = parcli-type AND
      849        parobj-code = parcli-code and
      850        par-inter_  = yes         and
      851       (buf_wth-line.out-code = 0 or buf_wth-line.out-code = ?) THEN DO:
      852       v-mes = substitute( "Для внутриобъектного перемещения не указано место хранения!"
      853                           ,buf_wth-line.out-code
      854                         ).
      855       run err-mess(input-output v-mes).
      856       var-entry = "out-w-p-code":U.
      857       undo _main, return error (if p-silent then v-mes else var-entry).
      858     end.
      859     FIND FIRST out-place NO-LOCK WHERE
      860               out-place.host-code   = parhost-code AND
      861               out-place.obj-type    = parcli-type AND
      862               out-place.obj-code    = parcli-code AND
      863               out-place.w-p-code    = buf_wth-line.out-code  NO-ERROR.
      864     IF NOT AVAIL out-place AND
      865        buf_wth-line.out-code <> 0 AND
      866        buf_wth-line.out-code <> ? AND
      867        pardoc-type <> 'возврат':U and
      868        pardoc-type <> 'при':U and
      869        par-exter_ = no  and
      870        par-inter_ = no THEN DO:
      871       v-mes = substitute( "Не найдено место хранения МЦ &1 в справочнике!"
      872                           ,buf_wth-line.out-code
      873                         ).
      874       run err-mess(input-output v-mes).
      875       var-entry = "out-w-p-code":U.
      876       undo _main, return error (if p-silent then v-mes else var-entry).
      877     END.
      878     if parauto-fill and par-borned and out-place.cash-desk = 0 then do:
      879       v-mes = substitute( "Для автоматического документа МХ МЦ &1 должно быть кассой"
      880                           ,buf_wth-line.out-code
      881                         ).
      882       run err-mess(input-output v-mes).
      883       var-entry = "out-w-p-code":U.
      884       undo _main, return error (if p-silent then v-mes else var-entry).
      885     end.
      886     IF parobj-type = parcli-type AND
      887        parobj-code = parcli-code and
      888        par-inter_ = yes THEN DO:
      889       IF current-place.w-p-code = out-place.w-p-code THEN DO:
      890         v-mes = substitute( "Нельзя перемещать МЦ в место их хранения!"
      891                             ,buf_wth-line.out-code
      892                           ).
      893         run err-mess(input-output v-mes).
      894         var-entry = "out-w-p-code":U.
      895         undo _main, return error (if p-silent then v-mes else var-entry).
      896       END.
      897       if pardoc-type = 'рас':U then parcli-name = out-place.w-p-name.
      898       else if pardoc-type = 'при':U then parcli-name = current-place.w-p-name.
      899     END.
      900   end.
      901   else do:
      902     if parlines-exist then do:
      903       v-mes = substitute( "Нет строк в документе!" ).
      904       run err-mess(input-output v-mes).
      905       var-entry = "b-add":U.
      906       undo _main, return error (if p-silent then v-mes else var-entry).
      907     end.
      908   end.
      909   define variable v-value-character as character no-undo .
      910   define variable v-value-date as date no-undo .
      911   define variable v-value-decimal as decimal no-undo .
      912   define variable v-value-integer as INTEGER no-undo .
      913   define variable v-value-logical AS LOGICAL no-undo .
      914   define variable v-param-type as character no-undo .
      915   define variable v-stfactpref as character no-undo .
      916   define variable v-numsfact   as integer no-undo .
      917   define temp-table temp-thbj-attr no-undo like ub.thbj-attr.
      918   define variable v-tth as handle no-undo .
      919   assign
      920   v-tth = buffer thbjattr_thbj-attr:table-handle .
      921   run adm/shattri.p (
      922       input "get":U
      923       ,input  parobj-type
      924       ,input  parobj-code
      925       ,input  'wthdoc_obj':U
      926       ,input  'prsdoc':U
      927       ,output v-value-character
      928       ,output v-value-date
      929       ,output v-value-decimal
      930       ,output v-value-integer
      931       ,output v-value-logical
      932       ,output v-param-type
      933       ,INPUT-OUTPUT table-handle v-tth
      934       ) no-error .
      935   IF not error-status:error  then do:
      936       v-chk-wth-prs =  v-value-logical.
      937   end.
      938   if par-operator  <> ? or v-chk-wth-prs then do:
      939     FIND FIRST buf_operator NO-LOCK WHERE
      940       buf_operator.obj-type = 'чел':U         AND
      941       buf_operator.obj-code = par-operator NO-ERROR.
      942     IF NOT AVAIL buf_operator THEN DO:
      943       v-mes = substitute( "Не найдено физ.лицо &1 в справочнике клиентов!", par-operator ).
      944       run err-mess(input-output v-mes).
      945       var-entry = "operator":U.
      946       undo _main, return error (if p-silent then v-mes else var-entry).
      947     END.
      948   end.
      949   if par-deliver  <> ? or v-chk-wth-prs then do:
      950     FIND FIRST buf_deliver NO-LOCK WHERE
      951       buf_deliver.obj-type = 'чел':U         AND
      952       buf_deliver.obj-code = par-deliver NO-ERROR.
      953     IF NOT AVAIL buf_deliver THEN DO:
      954       v-mes = substitute( "Не найдено физ.лицо &1 в справочнике клиентов!", par-deliver ).
      955       run err-mess(input-output v-mes).
      956       var-entry = "deliver":U.
      957       undo _main, return error (if p-silent then v-mes else var-entry).
      958     END.
      959   end.
      960   if par-receiver <> ? or
      961      (v-chk-wth-prs and
      962       lookup(parext-type, "ie,ee,pz,xc") = 0)
      963   then do:
      964     FIND FIRST buf_receiver NO-LOCK WHERE
      965       buf_receiver.obj-type = 'чел':U         AND
      966       buf_receiver.obj-code = par-receiver NO-ERROR.
      967     IF NOT AVAIL buf_receiver THEN DO:
      968       v-mes = substitute( "Не найдено физ.лицо &1 в справочнике клиентов!", par-receiver ).
      969       run err-mess(input-output v-mes).
      970       var-entry = "receiver":U.
      971       undo _main, return error (if p-silent then v-mes else var-entry).
      972     END.
      973   end.
      974   if parsource-ref <> '':U and parsource-ref <> ? then do:
      975     if parsource-ref = pardoc-code and parsource-type = 'док.МЦ':U then do:
      976       v-mes = substitute( "Нельзя связать документ с самим собой!" ).
      977       run err-mess(input-output v-mes).
      978       var-entry = "source-ref":U.
      979       undo _main, return error (if p-silent then v-mes else var-entry).
      980     end.
      981     CASE parsource-type:
      982       when 'док.МЦ':U then do:
      983         IF par-inter_ then do:
      984           find first bind_wth-doc No-LOCK WHERE
      985                     bind_wth-doc.doc-code = parsource-ref No-ERROR.
      986           if not avail bind_wth-doc then do:
      987             v-mes = substitute("Не найден документ &1 для связи!", parsource-ref ).
      988             run err-mess(input-output v-mes).
      989             var-entry = "source-ref":U.
      990             undo _main, return error (if p-silent then v-mes else var-entry).
      991           end.
      992         end.
      993       end.
      994       when 'касса':U then do:
      995         find first bind_inkas No-LOCK WHERE
      996                   bind_inkas.inkas-code = parsource-ref No-ERROR.
      997         if not avail bind_inkas then do:
      998           v-mes = substitute("Не найден документ &1 для связи!", parsource-ref ).
      999           run err-mess(input-output v-mes).
     1000           var-entry = "source-ref":U.
     1001           undo _main, return error (if p-silent then v-mes else var-entry).
     1002         end.
     1003       end.
     1004       OTHERWISE do:
     1005           v-mes = substitute("Неверный тип документа &1 для связи", parsource-type ).
     1006           run err-mess(input-output v-mes).
     1007           var-entry = "source-type":U.
     1008           undo _main, return error (if p-silent then v-mes else var-entry).
     1009       end.
     1010     END CASE.
     1011   end.
     1012   end.
     1013   PROCEDURE err-mess:
     1014     DEFINE INPUT-output PARAMETER p-mes as character No-UNDO.
     1015     p-mes = substitute("Документ МЦ №&1: &2&3&4&5", pardoc-code, parobj-type, parobj-code, chr(10), p-mes).
     1016     if not p-silent then
     1017     message
     1018     p-mes
     1019     view-as alert-box error .
     1020   END PROCEDURE.
