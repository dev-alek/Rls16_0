        1   block-level on error undo, throw.
        2   trigger procedure for delete of ub.counter.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U .
        4   define variable vss-author      as character no-undo initial "$Author$":U .
        5   define variable vss-date        as character no-undo initial "$Date$":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        7   define variable vss-archive     as character no-undo initial "$Archive$":U .
        8   define variable vss-description as character no-undo init "Тригер удаления counter".
        9   if counter.file-name eq "cashbookrule"
       10   then do:
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
      305   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      306   procedure gen-key-rec :
      307     define input  parameter p-tbl-name    as character no-undo.
      308     define input  parameter p-bh_tbl-name as handle    no-undo.
      309     define output parameter p-key-rec     as character no-undo.
      310     do
      311     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      312     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      313     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      314     :
      315       define variable fh               as handle    no-undo .
      316       define variable v-ok             as logical   no-undo .
      317       define variable v-inform         as character no-undo .
      318       define variable v-ind            as integer   no-undo .
      319       define variable v-idx-field-qnty as integer   no-undo .
      320       if p-tbl-name = ?
      321         or p-tbl-name = "":U
      322       then do:
      323         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      324       end.
      325       if not p-bh_tbl-name:available then do:
      326         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      327       end.
      328       assign
      329         p-key-rec = p-tbl-name
      330         v-inform  = p-bh_tbl-name:index-information(1)
      331         v-ind     = 2
      332       .
      333       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      334       on error undo, return error
      335       :
      336         assign
      337           v-inform = p-bh_tbl-name:index-information( v-ind )
      338           v-ind    = v-ind + 1
      339         .
      340       end.
      341       if v-inform = ?
      342         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      343         or entry( 3, v-inform, ",":U ) <> "1":U
      344       then do:
      345         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      346       end.
      347       else do:
      348         assign
      349           v-idx-field-qnty = num-entries( v-inform ) - 4
      350         .
      351         if v-idx-field-qnty < 2 then do:
      352           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      353         end.
      354         do v-ind = 1 to v-idx-field-qnty by 2
      355         on error undo, return error
      356         :
      357           assign
      358             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      359             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      360           .
      361         end.
      362       end.
      363       if p-key-rec = ? then do:
      364         assign
      365           p-key-rec = "":U
      366         .
      367         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      368       end.
      369     end.
      370     return.
      371   end procedure.
      372   procedure gen-where-keyr-tab :
      373     define input  parameter i-tableSerach as character no-undo.
      374     define input  parameter i-tablekey   as character  no-undo.
      375     define input  parameter p-key-rec    as character  no-undo.
      376     define input  parameter p-key-handle as handle     no-undo .
      377     define input  parameter p-db-name    as character  no-undo .
      378     define input  parameter p-tt-handle  as handle     no-undo .
      379     define output parameter o-Where      as character  no-undo.
      380     do
      381     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      382     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      383     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      384     :
      385       define variable v-full-tbl-name  as character no-undo .
      386       define variable bh_tbl-name      as handle    no-undo .
      387       define variable fh_key           as handle    no-undo .
      388       define variable fh_search        as handle    no-undo .
      389       define variable v-field-num      as integer   no-undo .
      390       define variable v-count-fld      as integer   no-undo .
      391       define variable v-inform         as character no-undo .
      392       define variable v-ind            as integer   no-undo .
      393       define variable v-idx-field-qnty as integer   no-undo .
      394       define variable v-field-name     as character no-undo .
      395       define variable v-field-val      as character no-undo .
      396       define variable v-word-link      as character no-undo .
      397       define variable vTable           as character no-undo.
      398       define variable bh_tbl-key       as handle    no-undo .
      399       assign
      400         p-key-rec = trim( p-key-rec )
      401       .
      402       if p-key-handle <> ? then do:
      403         if not valid-handle(p-key-handle)
      404            or p-key-handle:type <> "buffer"
      405         then do:
      406           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      407         end.
      408         if num-entries( p-key-rec, chr(3) ) > 1
      409           or p-key-rec = ?
      410           or p-key-rec = "":U
      411         then do:
      412           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      413         end.
      414       end.
      415       else do:
      416         if p-key-rec = ?
      417           or p-key-rec = "":U
      418         then do:
      419           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      420         end.
      421       end.
      422       assign
      423         vTable = entry( 1 , p-key-rec, chr(3) )
      424       .
      425       if p-tt-handle <> ?
      426         and ( not valid-handle(p-tt-handle)
      427               or p-tt-handle:type <> "buffer"
      428             )
      429       then do:
      430         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      431       end.
      432       if p-tt-handle = ? then do:
      433         assign
      434           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      435         .
      436         create buffer bh_tbl-name for table v-full-tbl-name .
      437       end.
      438       else do:
      439         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      440       end.
      441       assign
      442         v-inform = bh_tbl-name:index-information(1)
      443         v-ind    = 2
      444       .
      445       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      446       on error undo, return error
      447       :
      448         assign
      449           v-inform = bh_tbl-name:index-information( v-ind )
      450           v-ind    = v-ind + 1
      451         .
      452       end.
      453       if v-inform = ?
      454         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      455         or entry( 3, v-inform, ",":U ) <> "1":U
      456       then do:
      457         delete object bh_tbl-name no-error.
      458         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      459       end.
      460       assign
      461         v-idx-field-qnty = num-entries( v-inform ) - 4
      462       .
      463       if v-idx-field-qnty < 2 then do:
      464         delete object bh_tbl-name no-error.
      465         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      466       end.
      467       assign
      468         o-where     = "where":U
      469         v-word-link = "":U
      470         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      471         v-count-fld = 0
      472       .
      473       if i-tablekey ne "" and i-tablekey ne ?
      474       then do:
      475         assign
      476           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      477         .
      478         create buffer bh_tbl-key for table v-full-tbl-name .
      479       end.
      480       if i-tableSerach ne "" and i-tableSerach ne ?
      481       then do:
      482         delete object bh_tbl-name no-error.
      483         assign
      484           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      485         .
      486         create buffer bh_tbl-name for table v-full-tbl-name .
      487       end.
      488       block_where:
      489       do v-ind = 1 to v-idx-field-qnty by 2
      490       on error undo, return error
      491       :
      492         assign
      493           v-count-fld = v-count-fld + 1
      494         .
      495         if p-key-handle = ?
      496           and v-count-fld > v-field-num
      497         then do:
      498           leave block_where.
      499         end.
      500         define variable VfieldKeyTable as handle no-undo.
      501         assign
      502           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      503           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      504         .
      505         if     bh_tbl-key ne ?
      506         then do:
      507            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      508            if VfieldKeyTable eq ?
      509            then next block_where.
      510         end.
      511         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      512         then
      513            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      514         else
      515            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      516         if p-key-handle = ? then do:
      517           assign
      518             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      519           .
      520         end.
      521         else do:
      522           assign
      523             fh_key = p-key-handle:buffer-field( v-field-name )
      524           .
      525           if fh_key = ?
      526             or not valid-handle( fh_key )
      527           then do:
      528             delete object bh_tbl-name.
      529             if     bh_tbl-key ne ?
      530             then
      531                delete object bh_tbl-key.
      532             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      533           end.
      534           assign
      535             v-field-val = fh_key:buffer-value
      536           .
      537         end.
      538         if fh_search:data-type ="character":U then do:
      539           assign
      540             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      541             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      542             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      543             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      544             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      545             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      546             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      547             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      548             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      549             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      550             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      551             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      552             v-field-val = substitute( '"&1"', v-field-val )
      553           .
      554         end.
      555         assign
      556           o-where = substitute( "&1 &2", o-where, v-field-val )
      557         .
      558         if v-word-link = "":U then do:
      559           assign
      560             v-word-link = "and":U
      561           .
      562         end.
      563       end.
      564       delete object bh_tbl-name.
      565       if     bh_tbl-key ne ?
      566       then
      567          delete object bh_tbl-key.
      568       if p-key-handle = ?
      569         and v-count-fld <> v-field-num
      570       then do:
      571         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      572       end.
      573     end.
      574   end procedure.
      575   procedure gen-hn-keyr-tab :
      576     define input  parameter i-tableSerach as character no-undo.
      577     define input  parameter i-tablekey   as character no-undo.
      578     define input  parameter p-key-rec    as character no-undo.
      579     define input  parameter p-key-handle as handle    no-undo .
      580     define input  parameter p-db-name    as character no-undo .
      581     define input  parameter p-tt-handle  as handle    no-undo .
      582     define input  parameter p-stts-lock  as integer   no-undo .
      583     define output parameter o-hn         as handle    no-undo.
      584     define variable v-full-tbl-name as character no-undo.
      585     define variable v-where         as character no-undo.
      586     define variable bh_tbl-name     as handle    no-undo.
      587     define variable vTable          as character no-undo.
      588     do
      589     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      590     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      591     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      592         run gen-where-keyr-tab(i-tableSerach,
      593                                i-tablekey,
      594                                p-key-rec,
      595                                p-key-handle,
      596                                p-db-name,
      597                                p-tt-handle,
      598                                output v-where).
      599         if i-tableSerach ne "" and i-tableSerach ne ?
      600         then do:
      601            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      602            create buffer bh_tbl-name for table v-full-tbl-name .
      603         end.
      604         else do:
      605            if p-tt-handle = ? then do:
      606               assign
      607                  vTable = entry( 1 , p-key-rec, chr(3) )
      608               .
      609               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      610               create buffer bh_tbl-name for table v-full-tbl-name .
      611            end.
      612            else do:
      613               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      614            end.
      615         end.
      616         if p-tt-handle = ? then do:
      617            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      618         end.
      619         else do:
      620            bh_tbl-name:find-first( v-where ) no-error .
      621         end.
      622         o-hn = bh_tbl-name.
      623      end.
      624   end procedure.
      625   procedure gen-hn-keyr :
      626     define input  parameter p-key-rec    as character no-undo.
      627     define input  parameter p-key-handle as handle    no-undo .
      628     define input  parameter p-db-name    as character no-undo .
      629     define input  parameter p-tt-handle  as handle    no-undo .
      630     define input  parameter p-stts-lock  as integer   no-undo .
      631     define output parameter o-hn         as handle    no-undo.
      632     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      633   end.
      634   procedure gen-row-keyr :
      635     define input  parameter p-key-rec    as character no-undo.
      636     define input  parameter p-key-handle as handle    no-undo .
      637     define input  parameter p-db-name    as character no-undo .
      638     define input  parameter p-tt-handle  as handle    no-undo .
      639     define input  parameter p-stts-lock  as integer   no-undo .
      640     define output parameter p-tbl-row    as rowid     no-undo.
      641     define output parameter p-tbl-name   as character no-undo.
      642     define variable vHn as handle no-undo.
      643       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      644       p-tbl-row = if vHn:available then vHn:rowid else ?.
      645       p-tbl-name =  vHn:table.
      646       delete object vHn no-error.
      647     if p-tbl-row = ? then do:
      648       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      649     end.
      650     else do:
      651       return.
      652     end.
      653   end procedure.
      654   procedure gen-key-fv :
      655     define input  parameter p-key-rec    as character no-undo .
      656     define output parameter p-field-list as character no-undo .
      657     define output parameter p-value-list as character no-undo.
      658     do
      659     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      660     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      661     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      662     :
      663       define variable v-full-tbl-name  as character no-undo .
      664       define variable bh_tbl-name      as handle    no-undo .
      665       define variable v-tbl-name       as character no-undo .
      666       define variable v-field-num      as integer   no-undo .
      667       define variable v-count-fld      as integer   no-undo .
      668       define variable v-inform         as character no-undo .
      669       define variable v-ind            as integer   no-undo .
      670       define variable v-idx-field-qnty as integer   no-undo .
      671       define variable v-delim-key      as character no-undo .
      672       if p-key-rec = ?
      673         or p-key-rec = "":U
      674       then do:
      675         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      676       end.
      677       assign
      678         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      679         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      680       .
      681       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      682       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      683       assign
      684         v-inform = bh_tbl-name:index-information(1)
      685         v-ind    = 2
      686       .
      687       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      688       on error undo, return error
      689       :
      690         assign
      691           v-inform = bh_tbl-name:index-information( v-ind )
      692           v-ind    = v-ind + 1
      693         .
      694       end.
      695       if v-inform = ?
      696         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      697         or entry( 3, v-inform, ",":U ) <> "1":U
      698       then do:
      699         delete object bh_tbl-name no-error.
      700         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      701       end.
      702       assign
      703         v-idx-field-qnty = num-entries( v-inform ) - 4
      704       .
      705       if v-idx-field-qnty < 2 then do:
      706         delete object bh_tbl-name no-error.
      707         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      708       end.
      709       assign
      710         p-field-list = "":U
      711         p-value-list = "":U
      712         v-delim-key  = "":U
      713         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      714         v-count-fld  = 0
      715       .
      716       block_where:
      717       do v-ind = 1 to v-idx-field-qnty by 2
      718       on error undo, return error
      719       :
      720         assign
      721           v-count-fld = v-count-fld + 1
      722         .
      723         if v-count-fld > v-field-num then do:
      724           leave block_where.
      725         end.
      726         assign
      727           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      728           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      729         .
      730         if v-ind = 1 then do:
      731           assign
      732             v-delim-key = chr(3)
      733           .
      734         end.
      735       end.
      736       delete object bh_tbl-name.
      737       if v-count-fld <> v-field-num then do:
      738         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      739       end.
      740     end.
      741   end procedure.
      742   procedure gen-key-field :
      743     define input  parameter p-table      as character no-undo .
      744     define output parameter p-field-list as character no-undo .
      745     do
      746     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      747     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      748     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      749     :
      750       define variable v-full-tbl-name  as character no-undo .
      751       define variable bh_tbl-name      as handle    no-undo .
      752       define variable v-tbl-name       as character no-undo .
      753       define variable v-field-num      as integer   no-undo .
      754       define variable v-count-fld      as integer   no-undo .
      755       define variable v-inform         as character no-undo .
      756       define variable v-ind            as integer   no-undo .
      757       define variable v-idx-field-qnty as integer   no-undo .
      758       define variable v-delim-key      as character no-undo .
      759       if p-table = ?
      760         or p-table = "":U
      761       then do:
      762         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      763       end.
      764       assign
      765         v-tbl-name      = p-table
      766         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      767       .
      768       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      769       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      770       assign
      771         v-inform = bh_tbl-name:index-information(1)
      772         v-ind    = 2
      773       .
      774       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      775       on error undo, return error
      776       :
      777         assign
      778           v-inform = bh_tbl-name:index-information( v-ind )
      779           v-ind    = v-ind + 1
      780         .
      781       end.
      782       if v-inform = ?
      783         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      784         or entry( 3, v-inform, ",":U ) <> "1":U
      785       then do:
      786         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      787       end.
      788       assign
      789         v-idx-field-qnty = num-entries( v-inform ) - 4
      790       .
      791       if v-idx-field-qnty < 2 then do:
      792         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      793       end.
      794       assign
      795         p-field-list = "":U
      796         v-delim-key  = "":U
      797         v-count-fld  = 0
      798       .
      799       block_where:
      800       do v-ind = 1 to v-idx-field-qnty by 2
      801       on error undo, return error
      802       :
      803         assign
      804           v-count-fld = v-count-fld + 1
      805         .
      806         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      807         if v-ind = 1 then do:
      808           assign
      809             v-delim-key = chr(3)
      810           .
      811         end.
      812       end.
      813       delete object bh_tbl-name.
      814     end.
      815   end procedure.
      816   define buffer buf_c-counter  for ub.c-counter .
      817   define variable v-date      as date      no-undo .
      818   define variable v-time      as integer   no-undo .
      819   define variable v-field-chg as character no-undo .
      820   define variable v-Seq       as int64     no-undo init ?.
      821   define variable vFlagseq    as logical no-undo.
      822   define variable vuniq-key-rec as character no-undo.
      823   define variable v-rowid as rowid no-undo.
      824   define variable v-tbl-name as character no-undo.
      825       run cur-time in this-procedure (output v-date, output v-time).
      826       publish "getNextseq" ("counter","s-c-counter-chip-num", "ub", output v-Seq ).
      827       if v-Seq = ?
      828       then
      829          v-Seq  = next-value (s-c-counter-chip-num, ub).
      830       else
      831          vFlagSeq = yes.
      832       if vFlagseq
      833       then do:
      834    for first buf_c-counter where buf_c-counter.db eq counter.db
      835   and buf_c-counter.file-name eq counter.file-name
      836   and buf_c-counter.key eq counter.key
      837   and buf_c-counter.code eq counter.code
      838     and buf_c-counter.corr-user-db-num   = g#db-num and buf_c-counter.chip-num = v-Seq exclusive-lock: leave. end.
      839       end.
      840       if not available buf_c-counter
      841       then do:
      842          create buf_c-counter.
      843          buffer-copy ub.counter to buf_c-counter
      844          assign
      845            buf_c-counter.chip-num           = v-Seq
      846            buf_c-counter.corr-date          = v-date
      847            buf_c-counter.corr-time          = v-time
      848            buf_c-counter.corr-user-db-num   = g#db-num
      849            buf_c-counter.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
      850            buf_c-counter.action             = 99
      851            buf_c-counter.is-del             = true
      852          .
      853       end.
      854       else
      855          buf_c-counter.action             = 99.
      856     if not g#news then do :
      857       run nws/cmd-del.p
      858         ( input 'counter':U
      859          ,input (buffer ub.counter:handle)
      860          ,input "":U
      861         ) no-error .
      862       if error-status :error then do:
      863         message
      864           vss-workfile vss-revision vss-description skip
      865           "Невозможно маршрутизировать удаление counter для отправки в новости" skip
      866           error-status :get-message(1) skip
      867           return-value skip
      868           view-as alert-box error .
      869         undo , return error return-value .
      870       end.
      871       end.
      872   end.
      873   else do:
      874       run cur-time in this-procedure (output v-date, output v-time).
      875       publish "getNextseq" ("counter","s-c-counter-chip-num", "ub", output v-Seq ).
      876       if v-Seq = ?
      877       then
      878          v-Seq  = next-value (s-c-counter-chip-num, ub).
      879       else
      880          vFlagSeq = yes.
      881       if vFlagseq
      882       then do:
      883    for first buf_c-counter where buf_c-counter.db eq counter.db
      884   and buf_c-counter.file-name eq counter.file-name
      885   and buf_c-counter.key eq counter.key
      886   and buf_c-counter.code eq counter.code
      887     and buf_c-counter.corr-user-db-num   = g#db-num and buf_c-counter.chip-num = v-Seq exclusive-lock: leave. end.
      888       end.
      889       if not available buf_c-counter
      890       then do:
      891          create buf_c-counter.
      892          buffer-copy ub.counter to buf_c-counter
      893          assign
      894            buf_c-counter.chip-num           = v-Seq
      895            buf_c-counter.corr-date          = v-date
      896            buf_c-counter.corr-time          = v-time
      897            buf_c-counter.corr-user-db-num   = g#db-num
      898            buf_c-counter.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
      899            buf_c-counter.action             = 99
      900            buf_c-counter.is-del             = true
      901          .
      902       end.
      903       else
      904          buf_c-counter.action             = 99.
      905   end.
