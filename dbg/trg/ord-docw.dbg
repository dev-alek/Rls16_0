     2292               (input 'ord-doc':U
     2293               ,input (buffer ub.ord-doc:handle)
     2294               ) no-error .
     2295           if error-status :error then
     2296           do:
     2297               message
     2298                   vss-workfile vss-revision vss-description skip
     2299                   "Невозможно маршрутизировать ord-doc для отправки в новости" skip
     2300                   "Заказ О-РЦ " ub.ord-doc.doc-code skip
     2301                   error-status :get-message(1) skip
     2302                   return-value skip
     2303                   view-as alert-box error .
     2304               undo, return error .
     2305           end.
     2306       end.
     2307       define variable l-date as date      no-undo .
     2308       define variable l-time as integer   no-undo .
     2309       define variable s-date as date      no-undo .
     2310       define variable s-num  as integer   no-undo .
     2311       define variable s-name as character no-undo .
     2312       if ub.ord-doc.status_ = 'факт':U then
     2313       do:
     2314           if not g#news then
     2315           do:
     2316               run cur-time in this-procedure (output l-date , output l-time) no-error .
     2317               ub.ord-doc.fact-time  = l-time .
     2318               run gbl/factdate.p ( input        ub.ord-doc.obj-type  ,
     2319                   input        ub.ord-doc.obj-code   ,
     2320                   input-output ub.ord-doc.fact-date ,
     2321                   input-output ub.ord-doc.fact-time ,
     2322                   input-output s-date  ,
     2323                   input-output s-num ,
     2324                   input-output s-name,
     2325                   input        yes     ).
     2326               assign
     2327                   ub.ord-doc.shift-date = s-date
     2328                   ub.ord-doc.shift-num  = s-num
     2329                   ub.ord-doc.shift-name = s-name.
     2330               if ub.ord-doc.fact-num =  0 or ub.ord-doc.fact-num = ?  then
     2331               do:
     2332                   assign
     2333                       ub.ord-doc.fact-num = next-value (s-ORD-fact, ub)
     2334                       .
     2335               end.
     2336               if ub.ord-doc.fact-order =  0 or ub.ord-doc.fact-order = ?  then
     2337               do:
     2338                   define variable v-fact-order           as decimal no-undo .
     2339                   define variable v-shift-end-fact-order as decimal no-undo .
     2340                   define variable v-day-end-fact-order   as decimal no-undo .
     2341                   define variable l-shift-on             as logical no-undo .
     2342   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2343   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2344     (input  ub.ord-doc.obj-type
     2345     ,input  ub.ord-doc.obj-code
     2346     ,input  'shift-on=request'
     2347     ,output l-shift-on
     2348     ) no-error .
     2349                   if error-status :error then
     2350                   do:
     2351                       message
     2352                           vss-workfile vss-revision vss-description skip
     2353                           "Ошибка при определении атрибута объекта" skip
     2354                           "Заказ" ub.ord-doc.doc-code skip
     2355                           "Объект" ub.ord-doc.obj-type ub.ord-doc.obj-code skip
     2356                           error-status :get-message(1) skip
     2357                           return-value skip
     2358                           view-as alert-box error .
     2359                       undo main-block, return error .
     2360                   end.
     2361                   run factord in this-procedure
     2362                       (input  ub.ord-doc.fact-date
     2363                       ,input  ub.ord-doc.fact-time
     2364                       ,input  ub.ord-doc.fact-num
     2365                       ,input  ub.ord-doc.shift-date
     2366                       ,input  ub.ord-doc.shift-num
     2367                       ,input  l-shift-on
     2368                       ,output v-fact-order
     2369                       ,output v-shift-end-fact-order
     2370                       ,output v-day-end-fact-order
     2371                       ) no-error .
     2372                   if error-status :error
     2373                       or v-fact-order = ?
     2374                       or v-fact-order = 0 then
     2375                   do:
     2376                       message
     2377                           vss-workfile vss-revision vss-description skip
     2378                           "Ошибка при определении фактического номера складского документа" skip
     2379                           "Заказ" ub.ord-doc.doc-code skip
     2380                           "fact-date"               ub.ord-doc.fact-date   skip
     2381                           "fact-time"               ub.ord-doc.fact-time   skip
     2382                           "fact-num"                ub.ord-doc.fact-num    skip
     2383                           "shift-date"              ub.ord-doc.shift-date  skip
     2384                           "shift-num"               ub.ord-doc.shift-num   skip
     2385                           "v-fact-order"            v-fact-order           skip
     2386                           "v-shift-end-fact-order"  v-shift-end-fact-order skip
     2387                           "v-day-end-fact-order"    v-day-end-fact-order   skip
     2388                           error-status :get-message(1) skip
     2389                           return-value skip
     2390                           view-as alert-box error .
     2391                       undo, return error .
     2392                   end.
     2393                   assign
     2394                       ub.ord-doc.fact-order = v-fact-order
     2395                       .
     2396               end.
     2397           end.
     2398       end.
     2399       run cur-time in this-procedure ( output v-today
     2400           , output start-time
     2401           ).
     2402       assign
     2403           current-action = "Проверка статуса."
     2404           .
     2405       view frame a.
     2406       display
     2407           ub.ord-doc.doc-code
     2408           v-description-ord-type
     2409           with frame a.
     2410       if g#news  = false then
     2411       do:
     2412           if  not (ub.ord-doc.status_ = 'новый':U and ub.ord-doc.flag_ = false and old_ord-doc.obj-code <> 0 ) or
     2413               ( old_ord-doc.user-name <> g#userid )
     2414               then
     2415           do:
     2416               create ub.c-ord-doc.
     2417               BUFFER-COPY old_ord-doc  TO ub.c-ord-doc
     2418                   assign
     2419                   ub.c-ord-doc.chip-num           = next-value (s-corr-chip, ub)
     2420                   ub.c-ord-doc.corr-time          = start-time
     2421                   ub.c-ord-doc.corr-user-db-num   = g#db-num
     2422                   ub.c-ord-doc.corr-user-name     = g#userid
     2423                   ub.c-ord-doc.corr-date          = v-today
     2424                   .
     2425           end.
     2426       end.
     2427       if  (( ub.ord-doc.status_    = 'отказ':U
     2428           or
     2429           ( ub.ord-doc.status_    = 'запрос':U  and ub.ord-doc.flag_ = true and ub.ord-doc.doc-type   = 'ОО':U )
     2430           or
     2431           ( ub.ord-doc.status_    = 'запрос':U  and ub.ord-doc.doc-type   = 'ОР':U )
     2432           or
     2433           ( ub.ord-doc.status_    = 'разрешено':U  and ub.ord-doc.doc-type   = 'ОР':U )
     2434           or
     2435           ( ub.ord-doc.status_    = 'отгружено':U and ub.ord-doc.doc-type   = 'ОР':U )
     2436           or
     2437           ub.ord-doc.status_    = 'факт':U
     2438           or
     2439           ( ub.ord-doc.status_    = 'поставка':U and
     2440           old_ord-doc.out-code  <> ub.ord-doc.out-code )
     2441           or
     2442           ( ub.ord-doc.order-type = 2 and
     2443           g#db-num <> 0 and
     2444           ub.ord-doc.status_    = 'новый':U and
     2445           ub.ord-doc.flag_      = true  and
     2446           ub.ord-doc.doc-type   = 'ОО':U )
     2447           or
     2448           ( ub.ord-doc.order-type = 3 and
     2449           g#db-num = 0 and
     2450           ub.ord-doc.status_    = 'новый':U and
     2451           ub.ord-doc.flag_      = true  and
     2452           ub.ord-doc.doc-type   = 'ОО':U )
     2453           ) and
     2454           g#news  = false)
     2455           or is-edi-send-nws(ub.ord-doc.cli-type, ub.ord-doc.cli-code, ub.ord-doc.obj-type, ub.ord-doc.obj-code)
     2456           then
     2457       do:
     2458           run str/callnews.p
     2459               (input 'ord-doc':U
     2460               ,input (buffer ub.ord-doc:handle)
     2461               ) no-error .
     2462           if error-status :error then
     2463           do:
     2464               message
     2465                   vss-workfile vss-revision vss-description skip
     2466                   "Невозможно маршрутизировать ord-doc для отправки в новости" skip
     2467                   "Заказ" ub.ord-doc.doc-code skip
     2468                   error-status :get-message(1) skip
     2469                   return-value skip
     2470                   view-as alert-box error .
     2471               undo, return error .
     2472           end.
     2473       end.
     2474       define variable v-message as character no-undo .
     2475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     2476     (input ?
     2477     ,input this-procedure:handle
     2478     ,input ?
     2479     ,input  (if ub.ord-doc.doc-type = 'ОР':U then 'event_intorder':U else 'event_order':U)
     2480     ,input  buffer old_ord-doc:handle
     2481     ,input  buffer ub.ord-doc:handle
     2482     ,input ''
     2483     ,input ''
     2484     ) no-error .
     2485       if error-status:error
     2486           then
     2487       do:
     2488           v-message = substitute("&1 &2 &3&4Ошибка при вызове процедуры rum-runa.i&4&5&4&5&6"
     2489               ,vss-workfile
     2490               ,vss-revision
     2491               ,vss-description
     2492               ,chr(10)
     2493               , error-status:get-message(1)
     2494               , return-value ).
     2495           if not g#news then
     2496           do:
     2497               message
     2498                   v-message
     2499                   view-as alert-box error .
     2500           end.
     2501           undo main-block,  return error v-message.
     2502       end.
     2503       assign
     2504           current-action = "Проверка строк."
     2505           .
     2506       for each ub.ord-line exclusive-lock
     2507           where ub.ord-line.doc-code = ub.ord-doc.doc-code
     2508           on error undo main-block, return error
     2509           on end-key undo main-block, return error
     2510           :
     2511           run ord-savl_process-line in this-procedure ( buffer ub.ord-doc, buffer ub.ord-line) no-error .
     2512           if error-status :error then
     2513           do:
     2514               message
     2515                   vss-workfile vss-revision vss-description skip
     2516                   "Ошибка при обработке товара" skip
     2517                   "Заказ" ub.ord-doc.doc-code skip
     2518                   "Артикул" ub.ord-line.artic ub.ord-line.prod-type ub.ord-line.prod-code skip
     2519                   error-status :get-message(1) skip
     2520                   return-value skip
     2521                   view-as alert-box error .
     2522           end.
     2523       end.
     2524       if new ub.ord-doc then
     2525       do:
     2526           run trg/userlog.p (
     2527               input 'create':U
     2528               , input 'ord-doc':U
     2529               , input ( buffer ub.ord-doc :handle )
     2530               , input ?
     2531               , input ""
     2532               ) no-error.
     2533           if error-status :error
     2534               then
     2535           do:
     2536               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     2537                   , chr(10)
     2538                   , vss-workfile
     2539                   , return-value
     2540                   , error-status :get-message ( 1 ) ).
     2541           end.
     2542       end.
     2543       else
     2544       do:
     2545           run trg/userlog.p (
     2546               input 'update':U
     2547               , input 'ord-doc':U
     2548               , input ( buffer ub.ord-doc :handle )
     2549               , input ?
     2550               , input ""
     2551               ) no-error.
     2552           if error-status :error
     2553               then
     2554           do:
     2555               undo, return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     2556                   , chr(10)
     2557                   , vss-workfile
     2558                   , return-value
     2559                   , error-status :get-message ( 1 ) ).
     2560           end.
     2561       end.
     2562       if g#oxml = yes
     2563           then
     2564       do:
     2565           run str/calloxml.p (
     2566               input 'update':U
     2567               , input 'ord-doc':U
     2568               , input ( buffer ub.ORD-doc:handle )
     2569               ) no-error.
     2570           if error-status :error
     2571               then
     2572           do:
     2573               undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
     2574                   , chr(10)
     2575                   , vss-workfile
     2576                   , return-value
     2577                   , error-status :get-message ( 1 ) ).
     2578           end.
     2579       end.
     2580   end.
     2581   procedure show-action :
     2582       do
     2583           on error undo, return error
     2584           :
     2585           define input parameter p-action as character no-undo .
     2586           define variable v-today as date    no-undo.
     2587           define variable v-time  as integer no-undo.
     2588           run cur-time in this-procedure ( output v-today
     2589               , output v-time
     2590               ).
     2591           assign
     2592               current-time   = string(v-time - start-time, "HH:MM:SS")
     2593               current-action = p-action
     2594               .
     2595           display
     2596               current-time current-action
     2597               with frame a.
     2598       end.
     2599   end procedure.
     2600   procedure sum-head :
     2601       do
     2602           on error undo, return error return-value
     2603           :
     2604           assign
     2605               ub.ord-doc.qnty     = 0
     2606               ub.ord-doc.cli-qnty = 0
     2607               ub.ord-doc.sum-cli  = 0
     2608               ub.ord-doc.sum-rubl = 0
     2609               ub.ord-doc.sum-base = 0
     2610               .
     2611           for each ub.ord-line no-lock where
     2612               ub.ord-line.doc-code = ub.ord-doc.doc-code :
     2613               assign
     2614                   ub.ord-doc.qnty     = ub.ord-doc.qnty + ub.ord-line.qnty
     2615                   ub.ord-doc.cli-qnty = ub.ord-doc.cli-qnty + ub.ord-line.cli-qnty
     2616                   ub.ord-doc.sum-cli  = ub.ord-doc.sum-cli  + ( ub.ord-line.cli-qnty * ub.ord-line.price-cli)
     2617                   ub.ord-doc.sum-rubl = ub.ord-doc.sum-rubl + ( ub.ord-line.qnty * ub.ord-line.price-rubl )
     2618                   ub.ord-doc.sum-base = ub.ord-doc.sum-base + ( ub.ord-line.qnty * ub.ord-line.price-base )
     2619                   .
     2620           end.
     2621       end.
     2622   end procedure.
     2623   procedure display-line-process :
     2624       define input parameter p-num-rec as integer no-undo .
     2625       define parameter buffer buf_ord-line for ub.ord-line.
     2626       DEFINE VARIABLE v-today as date    no-undo .
     2627       DEFINE VARIABLE v-time  as integer no-undo .
     2628       do
     2629           on error undo, return error
     2630           :
     2631           run cur-time in this-procedure ( output v-today
     2632               ,output v-time
     2633               ).
     2634           assign
     2635               current-time = string(v-time - start-time, "HH:MM:SS")
     2636               .
     2637           display
     2638               p-num-rec  @ num_rec
     2639               buf_ord-line.artic
     2640               num_gds
     2641               current-time
     2642               current-action
     2643               with frame a.
     2644       end.
     2645   end procedure.
