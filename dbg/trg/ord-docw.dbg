     2244     )  .
     2245               end.
     2246               if ub.ord-doc.base-rate = 0 or ub.ord-doc.base-scale = 0  then
     2247               do:
     2248   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2249   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     2250     (input  ub.ord-doc.host-code
     2251     ,input  ub.ord-doc.doc-date
     2252     ,output ub.ord-doc.base-rate
     2253     ,output ub.ord-doc.base-scale
     2254     ) no-error .
     2255               end.
     2256               for each ub.ord-line exclusive-lock
     2257                   where ub.ord-line.doc-code = ub.ord-doc.doc-code :
     2258                   find first buf_goods no-lock where
     2259                       buf_goods.artic = ub.ord-line.artic and
     2260                       buf_goods.prod-type = ub.ord-line.prod-type  and
     2261                       buf_goods.prod-code = ub.ord-line.prod-code no-error .
     2262                   if available buf_goods then
