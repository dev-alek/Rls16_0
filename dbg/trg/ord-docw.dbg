     2274                   ub.ord-doc.real-time-create = time
     2275                   ub.ord-doc.creid            = g#userid
     2276                   ub.ord-doc.fact-num         = next-value (s-ORD-fact, ub)
     2277                   .
     2278       end.
     2279       if ub.ord-doc.status_ = 'согласование':U then
     2280       do:
     2281           assign
