     2042   procedure ord-savl_ver-gds-flor :
     2043   define input  parameter  p-gds-code as integer   no-undo .
     2044   define output parameter  p-nabor   as logical   no-undo .
     2045   main-block:
     2046   do
     2047   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2048   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2049   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2050   :
     2051     p-nabor = false .
     2052     run ver-gds-grp-nabor in this-procedure ( input p-gds-code, output p-nabor) .
     2053   end.
     2054   end procedure.
     2055   procedure ord-savl_del-str-info :
     2056   define input   parameter p-str1    as character no-undo .
     2057   define input   parameter p-str-dop as character no-undo .
     2058   define output  parameter p-str2    as character no-undo .
     2059   main-block:
     2060   do
     2061   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2062   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2063   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2064   :
     2065     p-str1     = trim  (p-str1   ) .
     2066     p-str-dop  = trim  (p-str-dop) .
     2067     p-str1     = trim  (p-str1   ,chr(10) ) .
     2068     p-str-dop  = trim  (p-str-dop,chr(10) ) .
     2069     if length (p-str1) + length (p-str-dop )     >=  2000  then do:
     2070       p-str2 = substitute ("&1 вся информация не умещается...." , p-str1 ) .
     2071       return .
     2072     end.
     2073     p-str2  = substitute ("&1&3&2" , p-str1, p-str-dop ,chr(10) ) .
     2074   end.
     2075   end procedure.
     2076   define variable num_rec                as integer   no-undo .
     2077   define variable num_gds                as integer   no-undo .
     2078   define variable start-time             as integer   no-undo .
     2079   define variable current-time           as character no-undo .
     2080   define variable current-action         as character no-undo .
     2081   define variable v-description-ord-type as character no-undo .
     2082   define variable v-today                as date      no-undo.
     2083   define variable v-time                 as integer   no-undo.
     2084   define buffer bf_contract-specif for ub.contract-specif  .
     2085   define buffer buf_goods          for ub.goods  .
     2086   define variable v-curr-abbr as character no-undo .
     2087   FUNCTION is-edi-send-nws RETURN logical (  input p-cli-type as character
     2088       , input p-cli-code as integer
     2089       , input p-obj-type     as character
     2090       , input p-obj-code     as integer
     2091       ) .
     2092       define variable v-obj-db-num       as integer   no-undo .
     2093       define variable v-uniq-key-rec     as character no-undo .
     2094       define variable v-obj-uniq-key-rec as character no-undo .
     2095       define variable v-is-edi           as logical   no-undo .
     2096       define variable par-is-edi         as character no-undo .
     2097       define variable par-type           as character no-undo .
     2098       define buffer buf_clients      for ub.clients .
     2099       define buffer obj_clients      for ub.clients .
     2100       define buffer buf_ext-classif  for ub.ext-classif .
     2101       define buffer buf2_ext-classif for ub.ext-classif .
     2102       define buffer buf_ext-system   for ub.ext-system  .
     2103   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2104   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2105     (input  p-obj-type
     2106     ,input  p-obj-code
     2107     ,output v-obj-db-num
     2108     )  .
     2109       if v-obj-db-num = 0 then
     2110       do:
     2111           return no.
     2112       end.
     2113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2114     (input  'is-edi'
     2115     ,input  ''
     2116     ,input  ''
     2117     ,input  0
     2118     ,input  ''
     2119     ,input  ''
     2120     ,input  ''
     2121     ,input  no
     2122     ,output par-is-edi
     2123     ,output par-type
     2124     ) no-error .
     2125       v-is-edi = lookup(par-is-edi, "true,yes":U) > 0.
     2126       if not v-is-edi then
     2127       do:
     2128           return no.
     2129       end.
     2130       find first buf_clients no-lock
     2131           where buf_clients.obj-type = p-cli-type
     2132           and buf_clients.obj-code = p-cli-code
     2133           no-error .
     2134       if not available buf_clients then
     2135       do:
     2136           return no .
     2137       end.
     2138       find first obj_clients no-lock where
     2139           obj_clients.obj-type = p-obj-type
     2140           and obj_clients.obj-code = p-obj-code no-error.
     2141       if not available buf_clients then
     2142       do:
     2143           return no .
     2144       end.
     2145       run gen-key-rec IN THIS-PROCEDURE ( input 'clients':U
     2146           , input (buffer buf_clients:handle)
     2147           , output v-uniq-key-rec).
     2148       run gen-key-rec IN THIS-PROCEDURE ( input 'clients':U
     2149           , input (buffer obj_clients:handle)
     2150           , output v-obj-uniq-key-rec).
     2151       for each buf_ext-classif no-lock
     2152           where buf_ext-classif.uniq-key-rec = v-uniq-key-rec
     2153           and buf_ext-classif.classif-subject = 'clients':U
     2154           and buf_ext-classif.classif-name    = 'exite-edi':U,
     2155           first buf_ext-system no-lock
     2156           where buf_ext-system.esys-id = buf_ext-classif.key#_one
     2157           and buf_ext-system.db-num  = 0
     2158           and buf_ext-system.esys-have-export = yes
     2159           and buf_ext-system.esys-db-num-exp = 0
     2160           ,
     2161           first buf2_ext-classif no-lock
     2162           where buf2_ext-classif.uniq-key-rec = v-obj-uniq-key-rec
     2163           and buf2_ext-classif.classif-subject = 'clients':U
     2164           and buf2_ext-classif.classif-name    = 'exite-edi':U
     2165           and buf2_ext-classif.key#_one  = buf_ext-classif.key#_one:
     2166           leave.
     2167       end.
     2168       if available buf_ext-classif then
     2169       do :
     2170           return yes .
     2171       end.
     2172       return no .
     2173   END FUNCTION.
     2174   assign
     2175       v-description-ord-type = ub.ord-doc.doc-type
     2176       .
     2177   define frame a
     2178       ub.ord-doc.doc-code                        label "Заказ" skip
     2179       v-description-ord-type                     label "Тип документа" skip
     2180       current-action         format "x(40)"      no-label skip
     2181       num_rec                format ">>>>>>>9"   label "Обработано артикулов" skip
     2182       ub.ord-line.artic                          label "Текущий артикул" skip
     2183       num_gds                format ">>>>>>>9"   label "Обработано признаков" skip
     2184       current-time           format "x(8)"       label "Время" skip
     2185       with view-as dialog-box side-labels three-d
     2186       title "Обработка заказа"
     2187       .
     2188   main-block :
     2189   do transaction
     2190       on error undo main-block, return error
     2191       :
     2192       define variable kol-str as integer no-undo .
     2193       kol-str = 0.
     2194       if not g#news
     2195           then
     2196       do:
     2197           if ub.ord-doc.contract-code > 0  and
     2198               not ( ub.ord-doc.status_ = 'факт':U or
     2199               ub.ord-doc.status_ = 'отказ':U)
     2200               then
     2201           do:
     2202               find first bf_contract-specif where bf_contract-specif.host-code    = ub.ord-doc.host-code     and
     2203                   bf_contract-specif.contract-num = ub.ord-doc.contract-code no-lock no-error.
     2204               if available bf_contract-specif then
     2205               do:
     2206                   for each ub.ord-line no-lock where
     2207                       ub.ord-line.doc-code = ub.ord-doc.doc-code :
     2208                       if not can-find (first bf_contract-specif no-lock where
     2209                           bf_contract-specif.host-code    = ub.ord-doc.host-code and
     2210                           bf_contract-specif.contract-num = ub.ord-doc.contract-code and
     2211                           bf_contract-specif.gds-code     = ub.ord-line.gds-code   ) then
     2212                       do:
     2213                           message
     2214                               "Выбран Договор со спецификацией !!!" skip
     2215                               "Несоответствие списка товаров заказа и спецификации " skip
     2216                               "Заказ      :" ub.ord-doc.doc-code        skip
     2217                               "код товара :" ub.ord-line.gds-code skip
     2218                               "артикл     :" ub.ord-line.artic skip
     2219                               view-as alert-box error .
     2220                       end.
     2221                   end.
     2222               end.
     2223           end.
     2224   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2225   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     2226     (output ub.ord-doc.user-db-num
     2227     ,output ub.ord-doc.user-name
     2228     ,output ub.ord-doc.sys-date
     2229     ,output ub.ord-doc.sys-time
     2230     ,output ub.ord-doc.sys-time-int
     2231     )  .
     2232           if ub.ord-doc.status_ = 'новый':U then
     2233           do:
