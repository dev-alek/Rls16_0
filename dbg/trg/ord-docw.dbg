     2283               .
     2284       end.
     2285       if ub.ord-doc.doc-type = 'ОР':U
     2286           and ub.ord-doc.status_ <> 'новый':U
     2287           and g#db-num = 0
     2288           and g#news
     2289           then
     2290       do:
