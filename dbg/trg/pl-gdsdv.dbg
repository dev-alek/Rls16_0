        1   block-level on error undo, throw.
        2   DEFINE INPUT  PARAMETER pobj-type like ub.clients.obj-type     no-undo.
        3   DEFINE INPUT  PARAMETER pobj-code like ub.clients.obj-code     no-undo.
        4   DEFINE INPUT  PARAMETER ppl-code  like ub.place.pl-code        no-undo.
        5   DEFINE INPUT  PARAMETER pgds-code like ub.goods.gds-code       no-undo.
        6   DEFINE OUTPUT PARAMETER loc#log   as logical                   no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":u .
        8   define variable vss-author      as character no-undo init "$Author$":u .
        9   define variable vss-date        as character no-undo init "$Date$":u .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       11   define variable vss-archive     as character no-undo init "$Archive$":u .
       12   define variable vss-description as character no-undo init "Проверки возможности удаления связи топливо-резервуар" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   define   shared variable g#auto as logical no-undo.
       74   define   shared variable g#news as logical no-undo.
       75   define   shared variable g#oxml as logical no-undo.
       76   define   shared variable g#esys as logical no-undo.
       77   define   shared variable g#news-source-db as integer no-undo.
       78   define   shared variable g#esys-source-esys as integer no-undo.
       79   define   shared variable g#db-num as integer   no-undo .
       80   define   shared variable g#userid as character no-undo .
       81   define   shared variable g#passwd as character no-undo .
       82   define variable v-shift-date as date      no-undo.
       83   define variable v-shift-num  as integer   no-undo.
       84   define variable v-shift-name as character no-undo.
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
       87     (input  pobj-type
       88     ,input  pobj-code
       89     ,output v-shift-date
       90     ,output v-shift-num
       91     ,output v-shift-name
       92     ) no-error .
       93   if NOT error-status:error and v-shift-num > 0 then do:
       94     FIND FIRST ub.rvs-doc NO-LOCK WHERE
       95                ub.rvs-doc.obj-type = pobj-type AND
       96                ub.rvs-doc.obj-code = pobj-code AND
       97                ub.rvs-doc.shift-date = v-shift-date AND
       98                ub.rvs-doc.shift-num = v-shift-num AND
       99                ub.rvs-doc.status_ = 'факт':U AND
      100                ub.rvs-doc.rvs-type = 'смена':U NO-ERROR.
      101     IF AVAIL ub.rvs-doc then do:
      102       FOR EACH ub.rvs-line NO-LOCK WHERE
      103                ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code AND
      104                ub.rvs-line.gds-code = pgds-code AND
      105                ub.rvs-line.pl-code  = ppl-code:
      106         IF ub.rvs-line.system-qnty <> 0 then do:
      107           return
      108          ("объект " + pobj-type + string(pobj-code) + chr(10) +
      109          "резервуар " + string(ppl-code) + chr(10) +
      110          "топливо " + string(pgds-code) + chr(10) +
      111          "имеются ненулевые книжные остатки по сверке текущей смены")
      112          .
      113         END.
      114         IF ub.rvs-line.state-measure-qnty <> 0 then do:
      115           return
      116          ("объект " + pobj-type + string(pobj-code) + chr(10) +
      117          "резервуар " + string(ppl-code) + chr(10) +
      118          "топливо " + string(pgds-code) + chr(10) +
      119          "имеются ненулевые подтвержденные фактические остатки по сверке текущей смены")
      120          .
      121         END.
      122       END.
      123     END.
      124     else do:
      125       return
      126       ("объект " + pobj-type + string(pobj-code) + chr(10) +
      127        "не было сверки по текущей смене типа " + 'смена':U)
      128        .
      129     end.
      130   end.
      131   else do:
      132     FIND last ub.shift-obj No-LOCK WHERE
      133               ub.shift-obj.obj-type = pobj-type AND
      134               ub.shift-obj.obj-code = pobj-code AND
      135               ub.shift-obj.status_ = 'факт':U use-index stts No-ERROR.
      136     IF AVAIL ub.shift-obj then do:
      137       FIND FIRST ub.rvs-doc NO-LOCK WHERE
      138                 ub.rvs-doc.obj-type = ub.shift-obj.obj-type AND
      139                 ub.rvs-doc.obj-code = ub.shift-obj.obj-code AND
      140                 ub.rvs-doc.shift-date = ub.shift-obj.shift-date AND
      141                 ub.rvs-doc.shift-num = ub.shift-obj.shift-num AND
      142                 ub.rvs-doc.status_ = 'факт':U AND
      143                 ub.rvs-doc.rvs-type = 'смена':U NO-ERROR.
      144       IF AVAIL ub.rvs-doc then do:
      145         FOR EACH ub.rvs-line NO-LOCK WHERE
      146                 ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code AND
      147                 ub.rvs-line.gds-code = pgds-code AND
      148                 ub.rvs-line.pl-code  = ppl-code:
      149           IF ub.rvs-line.system-qnty <> 0 then do:
      150             return
      151           ("объект " + pobj-type + string(pobj-code) + chr(10) +
      152           "резервуар " + string(ppl-code) + chr(10) +
      153           "топливо " + string(pgds-code) + chr(10) +
      154           "имеются ненулевые книжные остатки по сверке последней закрытой смены")
      155           .
      156           END.
      157           IF ub.rvs-line.state-measure-qnty <> 0 then do:
      158             return
      159           ("объект " + pobj-type + string(pobj-code) + chr(10) +
      160           "резервуар " + string(ppl-code) + chr(10) +
      161           "топливо " + string(pgds-code) + chr(10) +
      162           "имеются ненулевые подтвержденные фактические остатки по сверке последней закрытой смены")
      163           .
      164           END.
      165         END.
      166       END.
      167       else return error.
      168     END.
      169   END.
      170   _deletion:
      171   DO
      172   ON ERROR undo _deletion, return error
      173   :
      174   FOR EACH ub.pl-gds-pump where
      175           ub.pl-gds-pump.obj-type = pobj-type AND
      176           ub.pl-gds-pump.obj-code = pobj-code AND
      177           ub.pl-gds-pump.pl-code = ppl-code AND
      178           ub.pl-gds-pump.gds-code = pgds-code:
      179     DELETE UB.PL-GDS-PUMP NO-ERROR.
      180     if error-status:error then do:
      181       undo _deletion, return  ("Не удалось удалить запись pl-gds-pump " + chr(10) +
      182                               "объект " + pobj-type + string(pobj-code) + chr(10) +
      183                               "резервуар " + string(ppl-code) + chr(10) +
      184                               "топливо " + string(pgds-code) + chr(10) +
      185                               "ТРК " + string(ub.pl-gds-pump.pump-code)).
      186     end.
      187   END.
      188   END.
      189   loc#log = yes.
