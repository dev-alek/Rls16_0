      905   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-1:PARENT eq ?
      906   THEN FRAME DIALOG-1:PARENT = ACTIVE-WINDOW.
      907   ON WINDOW-CLOSE OF FRAME DIALOG-1 APPLY "END-ERROR":U TO SELF.
      908   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      909   on help of frame DIALOG-1
      910   do:
      911     run gbl/app_help.p
      912       (input this-procedure :file-name
      913       ,input ''
      914       ,input ?
      915       ) no-error.
      916     if error-status :error then do:
      917       message
      918         "Ошибка при вызове помощи"
      919         error-status :get-message(1)
      920         view-as alert-box .
      921     end.
      922   end.
      923   run minbtn-set in this-procedure .
      924   on choose of b-help in frame DIALOG-1
      925   do:
      926     apply "help":u to frame DIALOG-1 .
      927   end.
      928   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   procedure minbtn-set :
      930       do
      931           on error undo, return error return-value
      932           :
      933           define variable ii              as integer       no-undo .
      934           define variable fh              as widget-handle no-undo .
      935           define variable hh              as widget-handle no-undo .
      936           define variable v-h             as handle        extent 4 no-undo .
      937           define variable v-name-button   as character     no-undo .
      938           define variable v-help-old-x    as decimal       no-undo .
      939           define variable v-help-old-y    as decimal       no-undo .
      940           define variable v-help-old-size as decimal       no-undo .
      941           define variable v-frame-width   as decimal       no-undo .
      942           define variable jj              as integer       no-undo .
      943           do
      944               on error undo, return error
      945               :
      946               assign
      947                   v-frame-width = frame DIALOG-1:width - 0.3
      948                   fh            = frame DIALOG-1:first-child
      949                   hh            = fh:first-child
      950                   ii            = 1
      951                   .
      952               do while valid-handle(hh):
      953                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      954                   do:
      955                       case lc(hh:name) :
      956                           when "b-help" then
      957                               do:
      958                                   hh:load-image-up("cmp/b-help.bmp":u) .
      959                                   hh:load-image-down("cmp/b-help.bmp":u) .
      960                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      961                                   hh:TOOLTIP = "Помощь" .
      962                                   v-help-old-x = hh:column .
      963                                   v-help-old-y = hh:row    .
      964                                   v-help-old-size = hh:width .
      965                                   hh:width-chars = 2.5 .
      966                               end.
      967                           when "b-print" then
      968                               do:
      969                                   hh:load-image("cmp/b-print.bmp":u) .
      970                                   hh:TOOLTIP = "Печать" .
      971                                   v-h[ii] = hh:handle .
      972                                   ii = ii + 1 .
      973                                   hh:width-chars = 3 .
      974                               end.
      975                           when "b-history" or
      976                           when "b-hist" then
      977                               do:
      978                                   hh:load-image("cmp/b-hist.bmp":u) .
      979                                   hh:TOOLTIP = "История" .
      980                                   v-h[ii] = hh:handle .
      981                                   ii = ii + 1 .
      982                                   hh:width-chars = 3 .
      983                               end.
      984                           when "b-sch" then
      985                               do:
      986                                   hh:load-image("cmp/b-sch.bmp":u) .
      987                                   hh:TOOLTIP = "Установка Фильтра" .
      988                                   v-h[ii] = hh:handle .
      989                                   ii = ii + 1 .
      990                                   hh:width-chars = 3 .
      991                               end.
      992                           when "b-hist-user" then
      993                               do:
      994                                   hh:load-image("cmp/b-hist.bmp":u) .
      995                                   hh:TOOLTIP = "История пользователя" .
      996                                   ii = ii + 1 .
      997                               end.
      998                       end case.
      999                   end.
     1000                   hh = hh:next-sibling.
     1001               end.
     1002               b-help:column = v-frame-width - b-help:width-chars.
     1003               jj = 0.
     1004               repeat ii = 4 to 1 by -1 :
     1005                   if valid-handle (v-h[ii] ) then
     1006                   do:
     1007                       jj  = jj + 1 .
     1008                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1009                       v-h[ii]:row    = v-help-old-y .
     1010                   end.
     1011               end.
     1012           end.
     1013       end.
     1014   end procedure.
     1015   MAIN-BLOCK:
     1016   DO
     1017   ON ERROR   UNDO MAIN-BLOCK, RETURN ERROR
     1018   ON END-KEY UNDO MAIN-BLOCK, RETURN ERROR
     1019   ON STOP    UNDO MAIN-BLOCK, RETURN ERROR
     1020   :
     1021   define variable v-today as date      no-undo.
     1022   define variable v-time  as integer   no-undo.
     1023     find first ub.goods no-lock
     1024       where ub.goods.artic     = p-artic
     1025         and ub.goods.prod-type = p-prod-type
     1026         and ub.goods.prod-code = p-prod-code
     1027       no-error .
     1028     if not available goods
     1029     then do:
     1030       message
     1031         vss-workfile vss-revision vss-description skip
     1032         "Ошибка задания входных параметров" skip
     1033         "Не найден товар" skip
     1034         "Артикул" p-artic p-prod-code p-prod-type skip
     1035         view-as alert-box error .
     1036       undo main-block, return error .
     1037     end.
     1038     find first clients no-lock
     1039       where clients.obj-type = p-supp-type
     1040         and clients.obj-code = p-supp-code
     1041       no-error .
     1042     if not available clients
     1043     then do:
     1044       message
     1045         vss-workfile vss-revision vss-description skip
     1046         "Ошибка задания входных параметров" skip
     1047         "Не найден контрагент" skip
     1048         "Контрагент" p-supp-type p-supp-code skip
     1049         view-as alert-box error .
     1050       undo main-block, return error .
     1051     end.
     1052     define buffer buf_obj_clients for ub.clients .
     1053     find first buf_obj_clients no-lock
     1054       where buf_obj_clients.obj-type = p-obj-type
     1055         and buf_obj_clients.obj-code = p-obj-code
     1056         no-error .
     1057     if not available buf_obj_clients
     1058     then do:
     1059       message
     1060         vss-workfile vss-revision vss-description skip
     1061         "Ошибка задания входных параметров" skip
     1062         "Не найден объект" skip
     1063         "Контрагент" p-obj-type p-obj-code skip
     1064         view-as alert-box error .
     1065       undo main-block, return error .
     1066     end.
     1067     assign
     1068       name      = substitute("&1 &2 &3 &4"
     1069                        ,goods.artic
     1070                        ,goods.prod-type
     1071                        ,goods.prod-code
     1072                        ,goods.gds-name
     1073                        )
     1074       fi-obj    = substitute("&1 &2 &3"
     1075                        ,p-obj-type
     1076                        ,p-obj-code
     1077                        ,buf_obj_clients.obj-name
     1078                        )
     1079       supp-name = substitute("&1 &2 &3"
     1080                         ,p-supp-type
     1081                         ,p-supp-code
     1082                         ,clients.obj-name
     1083                         )
     1084       need-qnty = p-parts-qnty
     1085     .
     1086     assign
     1087       fi-price-base = p-price-base
     1088       fi-price-rubl = p-price-rubl
     1089     .
     1090     define variable v-host-code  as integer no-undo .
     1091     define variable v-exch-rate  like ub.curr-accnt.exch-rate no-undo .
     1092     define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     1093   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1094   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1095     (input  p-obj-type
     1096     ,input  p-obj-code
     1097     ,output v-host-code
     1098     )  .
     1099   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1101     (input  v-host-code
     1102     ,output v-base-code
     1103     )  .
     1104     run cur-time in this-procedure
     1105       (output  v-today
     1106       ,output  v-time
     1107       ).
     1108   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1109   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1110     (input  v-host-code
     1111     ,input  v-today
     1112     ,output v-exch-rate
     1113     ,output v-exch-scale
     1114     ) no-error .
     1115     assign
     1116       rate-mmvb  = v-exch-rate
     1117       scale-mmvb = v-exch-scale
     1118     .
     1119     if  p-base-rate > 0
     1120     and p-base-scale > 0
     1121     then do:
     1122       assign
     1123         fi-rate  = p-base-rate
     1124         fi-scale = p-base-scale
     1125       .
     1126     end.
     1127     else do:
     1128       assign
     1129         fi-rate  = v-exch-rate
     1130         fi-scale = v-exch-scale
     1131       .
     1132     end.
     1133     define buffer buf_currency for ub.currency .
     1134     find first buf_currency no-lock
     1135       where buf_currency.curr-code = v-base-code
     1136       no-error .
     1137     if available buf_currency
     1138     then do:
     1139       assign
     1140         v-currency-base = buf_currency.curr-abbr
     1141       .
     1142     end.
     1143     else do:
     1144       assign
     1145         v-currency-base = "ВАЛ"
     1146       .
     1147     end.
     1148     find first buf_currency no-lock
     1149       where buf_currency.curr-code = 0
     1150       .
     1151     assign
     1152       v-currency-rubl = buf_currency.curr-abbr
     1153     .
     1154     assign
     1155       fi-currency-base   = v-currency-base
     1156       fi-currency-base-2 = v-currency-base
     1157       fi-currency-base-3 = v-currency-base
     1158       fi-currency-rubl   = v-currency-rubl
     1159       fi-currency-rubl-2 = v-currency-rubl
     1160       fi-currency-rubl-3 = v-currency-rubl
     1161       b-rubl-from-base :label =  v-currency-base + " --> " + v-currency-rubl
     1162       b-base-from-rubl :label =  v-currency-rubl + " --> " + v-currency-base
     1163     .
     1164     if fi-price-rubl > 0
     1165     and fi-scale >0
     1166     and fi-price-base > 0
     1167     then do:
     1168       assign
     1169         fi-rate = fi-price-rubl * fi-scale / fi-price-base
     1170       .
     1171     end.
     1172     assign
     1173     b-base-from-rubl:LABEL in frame DIALOG-1 = "Руб --> Вал"
     1174     b-base-from-rubl:TOOLTIP in frame DIALOG-1  = "Расчет базовой учетной цены (Вал) на основе рублевой (Руб)"
     1175     b-rubl-from-base:label in frame DIALOG-1  = "Вал --> Руб"
     1176     b-rubl-from-base:TOOLTIP in frame DIALOG-1 = "Расчет рублевой учетной цены (Руб) на основе базовой (Вал)"
     1177     fi-price-rubl:TOOLTIP in frame DIALOG-1  = "Рублевая учетная цена"
     1178     .
     1179     RUN enable_UI.
     1180     if v-base-code = 0
     1181     then do:
     1182       assign
     1183         fi-price-base      :sensitive = false
     1184         fi-scale           :sensitive = false
     1185         fi-rate            :sensitive = false
     1186         b-curr-rate        :sensitive = false
     1187         b-rate-from-price  :sensitive = false
     1188         b-base-from-rubl   :sensitive = false
     1189         b-rubl-from-base   :sensitive = false
     1190         rate-mmvb          :sensitive = false
     1191         scale-mmvb         :sensitive = false
     1192         fi-currency-base   :sensitive = false
     1193         fi-currency-base-2 :sensitive = false
     1194         fi-currency-base-3 :sensitive = false
     1195         fi-currency-rubl-2 :sensitive = false
     1196         fi-currency-rubl-3 :sensitive = false
     1197         rect-1             :sensitive = false
     1198         rect-2             :sensitive = false
     1199         fi-formula-1       :sensitive = false
     1200         fi-formula-2       :sensitive = false
     1201         fi-formula-3       :sensitive = false
     1202         fi-formula-4       :sensitive = false
     1203         fi-formula-5       :sensitive = false
     1204         fi-formula-6       :sensitive = false
     1205       .
     1206       assign
     1207         fi-price-base      :visible = false
     1208         fi-scale           :visible = false
     1209         fi-rate            :visible = false
     1210         b-curr-rate        :visible = false
     1211         b-rate-from-price  :visible = false
     1212         b-base-from-rubl   :visible = false
     1213         b-rubl-from-base   :visible = false
     1214         rate-mmvb          :visible = false
     1215         scale-mmvb         :visible = false
     1216         fi-currency-base   :visible = false
     1217         fi-currency-base-2 :visible = false
     1218         fi-currency-base-3 :visible = false
     1219         fi-currency-rubl-2 :visible = false
     1220         fi-currency-rubl-3 :visible = false
     1221         rect-1             :visible = false
     1222         rect-2             :visible = false
     1223         fi-formula-1       :visible = false
     1224         fi-formula-2       :visible = false
     1225         fi-formula-3       :visible = false
     1226         fi-formula-4       :visible = false
     1227         fi-formula-5       :visible = false
     1228         fi-formula-6       :visible = false
     1229       .
     1230     end.
     1231     if fi-price-base :sensitive
     1232     then do:
     1233       define variable v-curr-r-b as character no-undo .
     1234   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1235   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1236     (output v-curr-r-b
     1237     )  .
     1238       if v-curr-r-b = 'base':U
     1239       then do:
     1240         apply "entry":u to fi-price-base in frame DIALOG-1.
     1241       end.
     1242       else do:
     1243         apply "entry":u to fi-price-rubl in frame DIALOG-1.
     1244       end.
     1245     end.
     1246     else do:
     1247       apply "entry":u to fi-price-rubl in frame DIALOG-1.
     1248     end.
     1249     WAIT-FOR GO OF FRAME DIALOG-1.
     1250   END.
     1251   RUN disable_UI.
     1252   PROCEDURE calc-base-from-rubl :
     1253     run validate-not-zero
     1254       (input 'scale':u
     1255       ).
     1256     if return-value = 'false':u
     1257     then do:
     1258       return 'false':u .
     1259     end.
     1260     do with frame DIALOG-1:
     1261       assign
     1262         fi-price-base :screen-value = string(input fi-price-rubl * input fi-scale / input fi-rate)
     1263       .
     1264     end.
     1265   END PROCEDURE.
     1266   PROCEDURE calc-rate-from-price :
     1267     run validate-not-zero
     1268       (input 'price-base':u
     1269       ).
     1270     if return-value = 'false':u
     1271     then do:
     1272       return 'false':u .
     1273     end.
     1274     do with frame DIALOG-1:
     1275       assign
     1276         fi-rate :screen-value = string( input fi-price-rubl * input fi-scale / input fi-price-base)
     1277       .
     1278     end.
     1279   END PROCEDURE.
     1280   PROCEDURE calc-rubl-from-base :
     1281     run validate-not-zero
     1282       (input 'scale':u
     1283       ).
     1284     if return-value = 'false':u
     1285     then do:
     1286       return 'false':u .
     1287     end.
     1288     do with frame DIALOG-1:
     1289       assign
     1290         fi-price-rubl :screen-value = string(input fi-price-base * input fi-rate  / input fi-scale)
     1291       .
     1292     end.
     1293   END PROCEDURE.
     1294   PROCEDURE disable_UI :
     1295     HIDE FRAME DIALOG-1.
     1296   END PROCEDURE.
     1297   PROCEDURE enable_UI :
     1298     DISPLAY name fi-obj need-qnty supp-name fi-rate rate-mmvb fi-scale scale-mmvb
     1299             fi-price-rubl fi-price-base fi-currency-base-2 fi-formula-2
     1300             fi-currency-rubl fi-currency-rubl-2 fi-formula-1 fi-formula-3
     1301             fi-currency-rubl-3 fi-formula-4 fi-currency-base fi-currency-base-3
     1302             fi-formula-5 fi-formula-6
     1303         WITH FRAME DIALOG-1.
     1304     ENABLE b-exit b-quit b-goods b-supp b-help RECT-1 RECT-2 RECT-3 RECT-4
     1305            b-rate-from-price b-curr-rate fi-rate fi-scale fi-price-rubl
     1306            b-rubl-from-base fi-price-base b-base-from-rubl fi-currency-base-2
     1307            fi-formula-2 fi-currency-rubl fi-currency-rubl-2 fi-formula-1
     1308            fi-formula-3 fi-currency-rubl-3 fi-formula-4 fi-currency-base
     1309            fi-currency-base-3 fi-formula-5 fi-formula-6
     1310         WITH FRAME DIALOG-1.
     1311   END PROCEDURE.
     1312   PROCEDURE validate-not-zero :
     1313     define input parameter p-need-check as character no-undo .
     1314     do with frame DIALOG-1 :
     1315       case p-need-check
     1316       :
     1317         when 'rate':u
     1318         then do:
     1319           if input fi-rate = 0
     1320           or input fi-rate = ?
     1321           then do:
     1322             message
     1323               "Задайте" fi-rate:label
     1324               view-as alert-box .
     1325             apply "entry":u to fi-rate.
     1326             return 'false':u .
     1327           end.
     1328         end.
     1329         when 'price-base':u
     1330         then do:
     1331           if input fi-price-base = 0
     1332           or input fi-price-base = ?
     1333           then do:
     1334             message
     1335               "Задайте базовую учетную цену"
     1336               view-as alert-box .
     1337             apply "entry":u to fi-price-base.
     1338             return 'false':u .
     1339           end.
     1340         end.
     1341         when 'price-rubl':u
     1342         then do:
     1343           if input fi-price-rubl = 0
     1344           or input fi-price-rubl = ?
     1345           then do:
     1346             message
     1347               "Задайте учетную цену в рублях"
     1348               view-as alert-box .
     1349             apply "entry":u to fi-price-rubl.
     1350             return 'false':u .
     1351           end.
     1352         end.
     1353         when 'scale':u
     1354         then do:
     1355           if input fi-scale = 0
     1356           or input fi-scale = ?
     1357           then do:
     1358             message
     1359               "Задайте базовую учетную цену"
     1360               view-as alert-box .
     1361             apply 'entry':u to fi-scale.
     1362             return 'false':u .
     1363           end.
     1364         end.
     1365         otherwise do:
     1366           message
     1367             vss-workfile vss-revision vss-description skip
     1368             "Процедура validate-not-zero. Неизвестный параметр " skip
     1369             "p-need-check" p-need-check skip
     1370             view-as alert-box error .
     1371           undo, return error .
     1372         end.
     1373       end case.
     1374     end.
     1375   END PROCEDURE.
