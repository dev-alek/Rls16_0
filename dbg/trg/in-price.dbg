      524        fi-formula-5 AT ROW 17 COL 66 COLON-ALIGNED NO-LABEL
      525        fi-formula-6 AT ROW 17.77 COL 72.5 COLON-ALIGNED NO-LABEL
      526        RECT-1 AT ROW 12.27 COL 41.5
      527        RECT-2 AT ROW 15.77 COL 41.5
      528        RECT-3 AT ROW 7.27 COL 41.5
      529        RECT-4 AT ROW 7.27 COL 68.5
      530        SPACE(2.37) SKIP(8.72)
      531       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      532            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      533            TITLE "Редактирование учётной цены":L
      534            DEFAULT-BUTTON b-exit.
      535   ASSIGN
      536          FRAME DIALOG-1:SCROLLABLE       = FALSE.
      537   ASSIGN
      538          b-chg:HIDDEN IN FRAME DIALOG-1           = TRUE.
      539   ON GO OF FRAME DIALOG-1
      540   DO:
      541     define variable v-ok as logical   no-undo .
      542     if p-action = '':U
      543     then do:
      544       assign
      545         p-action = 'exit':U
      546       .
      547     end.
      548     if p-action = 'exit':U
      549     then do:
      550       if  fi-price-base :sensitive
      551       then do:
      552         if input frame DIALOG-1 fi-price-base = ?
      553         then do:
      554           message
      555             substitute("Не задана цена (&1)"
      556                       ,fi-currency-base :screen-value
      557                       ) skip
      558             view-as alert-box error .
      559           apply 'entry':u to fi-price-base .
      560           return no-apply .
      561         end.
      562         if input frame DIALOG-1 fi-price-base = 0
      563         then do:
      564           assign
      565             v-ok = false
      566           .
      567           message
      568             substitute("Задана нулевая цена (&1)"
      569                       ,fi-currency-base :screen-value
      570                       ) skip
      571             "Продолжить?" skip
      572             view-as alert-box question buttons yes-no update v-ok .
      573           if v-ok <> true
      574           then do:
      575             apply 'entry':u to fi-price-base .
      576             return no-apply .
      577           end.
      578         end.
      579       end.
      580       if fi-price-rubl :sensitive
      581       then do:
      582         if input frame DIALOG-1 fi-price-rubl = ?
      583         then do:
      584           message
      585             substitute("Не задана учетная цена (&1)"
      586                       ,fi-currency-rubl :screen-value
      587                       ) skip
      588             view-as alert-box error .
      589           apply 'entry':u to fi-price-rubl .
      590           return no-apply .
      591         end.
      592         if input frame DIALOG-1 fi-price-rubl = 0
      593         then do:
      594           assign
      595             v-ok = false
      596           .
      597           message
      598             substitute("Учетная цена (&1) равна нулю"
      599                       ,fi-currency-rubl :screen-value
      600                       ) skip
      601             "Партия будет сохранена с нулевой учётной ценой." skip
      602             "Продолжить?" skip
      603             view-as alert-box question buttons yes-no update v-ok .
      604           if v-ok <> true
      605           then do:
      606             apply 'entry':u to fi-price-rubl .
      607             return no-apply .
      608           end.
      609         end.
      610       end.
      611       assign
      612         p-price-base = input frame DIALOG-1 fi-price-base
      613         p-price-rubl = input frame DIALOG-1 fi-price-rubl
      614       .
      615       if v-base-code = 0
      616       then do:
      617         assign
      618           p-price-base = p-price-rubl
      619         .
      620       end.
      621     end.
      622   END.
