        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR WRITE OF ub.fbr-gds-grp OLD oldb.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на запись группы блюд".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3', ub.fbr-gds-grp.obj-type, ub.fbr-gds-grp.obj-code, ub.fbr-gds-grp.node-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure fbr-gds-grph_write-fbr-gds-grp-trigger :
      308   define input parameter p-new-record as logical no-undo .
      309   define input parameter p-source-type like ub.c-fbr-gds-grp-hist.source-type no-undo .
      310   define input parameter p-source-ref  like ub.c-fbr-gds-grp-hist.source-ref no-undo .
      311   define input parameter p-action as integer no-undo .
      312   define variable v-date as date      no-undo.
      313   define variable v-time  as integer   no-undo.
      314   define buffer buf_c-fbr-gds-grp-hist for ub.c-fbr-gds-grp-hist.
      315   define buffer buf_c-fbr-gds-grp for ub.c-fbr-gds-grp.
      316     do
      317     on error undo, return error
      318     :
      319       run cur-time in this-procedure(output v-date, output v-time).
      320       create buf_c-fbr-gds-grp.
      321       buffer-copy oldb to buf_c-fbr-gds-grp
      322       assign
      323       buf_c-fbr-gds-grp.obj-type           = (if p-new-record then ub.fbr-gds-grp.obj-type else oldb.obj-type)
      324       buf_c-fbr-gds-grp.obj-code           = (if p-new-record then ub.fbr-gds-grp.obj-code else oldb.obj-code)
      325       buf_c-fbr-gds-grp.node-code           = (if p-new-record then ub.fbr-gds-grp.node-code else oldb.node-code)
      326       buf_c-fbr-gds-grp.chip-num           = next-value (s-fbr-gds-grp-chip, ub)
      327       buf_c-fbr-gds-grp.corr-time          = v-time
      328       buf_c-fbr-gds-grp.corr-user-db-num   = g#db-num
      329       buf_c-fbr-gds-grp.corr-user-name     = (if g#news
      330                                               then (chr(4) +  'СПН':U)
      331                                               else (if g#esys
      332                                                     then (chr(4) +  'ВС':U)
      333                                                     else g#userid)
      334                                               )
      335       buf_c-fbr-gds-grp.corr-date          = v-date
      336       .
      337       create buf_c-fbr-gds-grp-hist.
      338       buffer-copy buf_c-fbr-gds-grp to buf_c-fbr-gds-grp-hist
      339       assign
      340       buf_c-fbr-gds-grp-hist.obj-type           = buf_c-fbr-gds-grp.obj-type
      341       buf_c-fbr-gds-grp-hist.obj-code           = buf_c-fbr-gds-grp.obj-code
      342       buf_c-fbr-gds-grp-hist.node-code           = buf_c-fbr-gds-grp.node-code
      343       buf_c-fbr-gds-grp-hist.action = p-action
      344       buf_c-fbr-gds-grp-hist.subject = 'fbr-gds-grp':U
      345       buf_c-fbr-gds-grp-hist.is-news = g#news
      346       buf_c-fbr-gds-grp-hist.source-type = p-source-type
      347       buf_c-fbr-gds-grp-hist.source-ref = p-source-ref
      348       .
      349     end.
      350   end procedure.
      351   procedure fbr-gds-grph_write-fbr-gds-grp-attr-proc  :
      352   define parameter buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr .
      353   define input parameter p-action as integer no-undo .
      354   define input parameter p-source-type like ub.c-gds-hist.source-type no-undo .
      355   define input parameter p-source-ref  like ub.c-gds-hist.source-ref no-undo .
      356   define variable v-date as date      no-undo.
      357   define variable v-time  as integer   no-undo.
      358   define buffer buf_c-fbr-gds-grp-hist for ub.c-fbr-gds-grp-hist.
      359   define buffer buf_c-fbr-gds-grp-attr for ub.c-fbr-gds-grp-attr.
      360     do
      361     on error undo, return error
      362     :
      363       if not available buf_fbr-gds-grp-attr then do:
      364         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      365                       "Ошибка задания входных параметров:Не определен атрибут группы блюд" ).
      366       end.
      367       run cur-time in this-procedure(output v-date, output v-time).
      368       create buf_c-fbr-gds-grp-attr.
      369       buffer-copy buf_fbr-gds-grp-attr to buf_c-fbr-gds-grp-attr
      370       assign
      371       buf_c-fbr-gds-grp-attr.obj-type           = buf_fbr-gds-grp-attr.obj-type
      372       buf_c-fbr-gds-grp-attr.obj-code           = buf_fbr-gds-grp-attr.obj-code
      373       buf_c-fbr-gds-grp-attr.node-code          = buf_fbr-gds-grp-attr.node-code
      374       buf_c-fbr-gds-grp-attr.attr-code          = buf_fbr-gds-grp-attr.attr-code
      375       buf_c-fbr-gds-grp-attr.chip-num           = next-value (s-fbr-gds-grp-chip, ub)
      376       buf_c-fbr-gds-grp-attr.corr-time          = v-time
      377       buf_c-fbr-gds-grp-attr.corr-user-db-num   = g#db-num
      378       buf_c-fbr-gds-grp-attr.corr-user-name     = (if g#news
      379                                               then (chr(4) +  'СПН':U)
      380                                               else (if g#esys
      381                                                     then (chr(4) +  'ВС':U)
      382                                                     else g#userid)
      383                                               )
      384       buf_c-fbr-gds-grp-attr.corr-date          = v-date
      385       .
      386       create buf_c-fbr-gds-grp-hist.
      387       buffer-copy buf_c-fbr-gds-grp-attr to buf_c-fbr-gds-grp-hist
      388       assign
      389       buf_c-fbr-gds-grp-hist.action =  p-action
      390       buf_c-fbr-gds-grp-hist.subject = 'fbr-gds-grp-attr':U
      391       buf_c-fbr-gds-grp-hist.is-news = g#news
      392       buf_c-fbr-gds-grp-hist.source-type = p-source-type
      393       buf_c-fbr-gds-grp-hist.source-ref = p-source-ref
      394       .
      395     end.
      396   end procedure.
      397   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
      398   define buffer other_fbr-gds-grp for ub.fbr-gds-grp.
      399   DEFINE VARIABLE conf-par as character no-undo .
      400   DEFINE VARIABLE par-type as character no-undo .
      401   define variable v-obj-db-num like ub.db.db-num no-undo .
      402   define variable v-l as logical no-undo .
      403   define variable v-fbrggrp-root-code like ub.fbr-gds-grp.node-code no-undo .
      404   on write of ub.fbr-gds-grp override do: end.
      405   main-block:
      406   do
      407   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      408   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      409   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      410   :
      411     if g#db-num > 0
      412     and ub.fbr-gds-grp.obj-type = "":U
      413     and ub.fbr-gds-grp.obj-code = 0
      414     and not g#news
      415     then do:
      416       message
      417        vss-workfile vss-revision vss-description skip
      418       "Нельзя изменять запись глобальной ГРУППЫ БЛЮД (рубрикатора) в УБД" skip
      419       view-as alert-box error .
      420       undo main-block, return error .
      421     end.
      422     if not (g#news and g#db-num = 0)
      423     and ub.fbr-gds-grp.obj-type <> '':U
      424     and ub.fbr-gds-grp.obj-code <> 0 then do:
      425   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      426   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      427     (input  ub.fbr-gds-grp.obj-type
      428     ,input  ub.fbr-gds-grp.obj-code
      429     ,output v-obj-db-num
      430     )  .
      431         if v-obj-db-num <> g#db-num then do:
      432           message
      433           vss-workfile vss-revision vss-description skip
      434           "Нельзя изменять запись ГРУППЫ БЛЮД (рубрикатора) в чужой БД" skip
      435           view-as alert-box error .
      436           undo main-block, return error .
      437         end.
      438     end.
      439     if ub.fbr-gds-grp.node-code <> oldb.node-code then do:
      440         find buf_fbr-gds-grp
      441           where buf_fbr-gds-grp.node-code = ub.fbr-gds-grp.upper-code
      442           AND buf_fbr-gds-grp.obj-type = ub.fbr-gds-grp.obj-type
      443           AND buf_fbr-gds-grp.obj-code = ub.fbr-gds-grp.obj-code
      444           no-error .
      445           if available buf_fbr-gds-grp then
      446         assign
      447           ub.fbr-gds-grp.lvl-num = buf_fbr-gds-grp.lvl-num + 1
      448           buf_fbr-gds-grp.is-term = no
      449         .
      450     end.
      451     else if ub.fbr-gds-grp.upper-code <> oldb.upper-code then do:
      452        run fbrglib-get-root-code in this-procedure ( output v-fbrggrp-root-code ) no-error.
      453       if error-status :error
      454       then do:
      455           undo main-block, return error "Не найден корневой узел." + chr(10) + return-value.
      456       end.
      457       if ub.fbr-gds-grp.upper-code = v-fbrggrp-root-code then do:
      458         find buf_fbr-gds-grp
      459           where buf_fbr-gds-grp.node-code = v-fbrggrp-root-code
      460            no-error
      461           .
      462       end.
      463       else do:
      464         find buf_fbr-gds-grp
      465           where buf_fbr-gds-grp.node-code = ub.fbr-gds-grp.upper-code
      466           AND buf_fbr-gds-grp.obj-type = ub.fbr-gds-grp.obj-type
      467           AND buf_fbr-gds-grp.obj-code = ub.fbr-gds-grp.obj-code no-error
      468           .
      469       end.
      470         if available buf_fbr-gds-grp then
      471         assign
      472           buf_fbr-gds-grp.is-term = no
      473           ub.fbr-gds-grp.lvl-num = if ub.fbr-gds-grp.upper-code = v-fbrggrp-root-code
      474                                    then 0
      475                                    else (buf_fbr-gds-grp.lvl-num + 1)
      476         .
      477       find first buf_fbr-gds-grp where
      478                buf_fbr-gds-grp.node-code = oldb.upper-code
      479             AND buf_fbr-gds-grp.obj-type = ub.fbr-gds-grp.obj-type
      480             AND buf_fbr-gds-grp.obj-code = ub.fbr-gds-grp.obj-code
      481                no-error .
      482       if available buf_fbr-gds-grp
      483       and not can-find(first other_fbr-gds-grp no-lock where
      484                              other_fbr-gds-grp.upper-code = buf_fbr-gds-grp.node-code
      485                           AND other_fbr-gds-grp.obj-type = ub.fbr-gds-grp.obj-type
      486                           AND other_fbr-gds-grp.obj-code = ub.fbr-gds-grp.obj-code
      487                         ) then do:
      488         assign
      489         buf_fbr-gds-grp.is-term = yes
      490         .
      491       end.
      492     end.
      493     else do:
      494       assign
      495         ub.fbr-gds-grp.is-term = yes
      496       .
      497     end.
      498     run fbr-grp-tree in this-procedure
      499       (input ub.fbr-gds-grp.node-code
      500        ,input ub.fbr-gds-grp.obj-type
      501        ,input ub.fbr-gds-grp.obj-code
      502       ) no-error.
      503     if error-status :error then do:
      504       message
      505         vss-workfile vss-revision vss-description skip
      506         "Ошибка при вызове процедуры fbr-grp-tree" skip
      507         error-status :get-message(1) skip
      508         return-value skip
      509         view-as alert-box error .
      510       undo main-block, return error.
      511     end.
      512       run str/callnews.p (
      513             input "fbr-gds-grp"
      514           , input (buffer ub.fbr-gds-grp:handle)
      515       ) no-error.
      516       if error-status :error
      517       then do:
      518           message
      519                    vss-workfile vss-revision vss-description
      520               skip "Ошибка пересылки группы блюд по новостям."
      521               skip return-value
      522               skip trim(error-status :get-message(1))
      523                    trim(error-status :get-message(2))
      524                    trim(error-status :get-message(3))
      525           view-as alert-box error.
      526           undo main-block, return error .
      527       end.
      528      if ub.fbr-gds-grp.obj-type <> "":U
      529      AND ub.fbr-gds-grp.obj-code <> 0 then do:
      530        find first buf_fbr-gds-grp where
      531                  buf_fbr-gds-grp.node-code = ub.fbr-gds-grp.upper-code
      532               AND buf_fbr-gds-grp.obj-type = ub.fbr-gds-grp.obj-type
      533               AND buf_fbr-gds-grp.obj-code = ub.fbr-gds-grp.obj-code no-error.
      534         if available buf_Fbr-gds-grp then do:
      535   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      536   define variable send-ref as logical no-undo.
      537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      538     (input  'send-ref'
      539     ,input  0
      540     ,input  ''
      541     ,input  0
      542     ,input  ''
      543     ,input  ''
      544     ,input  ''
      545     ,input  no
      546     ,output conf-par
      547     ,output par-type
      548     ) no-error .
      549     send-ref = (IF error-status:error or conf-par <> "yes" then no else yes).
      550           if not g#news and send-ref then do:
      551             assign
      552             v-l = yes
      553             .
      554             buffer-compare ub.fbr-gds-grp using
      555             out-code
      556             upper-code
      557             node-name
      558             to oldb
      559             case-sensitive
      560             save result in v-l .
      561             if not v-l then do:
      562               run trg/nu_fgrp.p (
      563                             input  ub.fbr-gds-grp.obj-type
      564                             ,input  ub.fbr-gds-grp.obj-code
      565                             ,input  ub.fbr-gds-grp.node-code
      566                             ,input  ub.fbr-gds-grp.upper-code
      567                             ,input  ub.fbr-gds-grp.out-code
      568                             ,input  buf_Fbr-gds-grp.out-code
      569                             ,input  ub.Fbr-gds-grp.lvl-num
      570                             ,input  "U":U
      571                             ).
      572             end.
      573         end.
      574        end.
      575      end.
      576       if not g#news
      577       and not new(ub.fbr-gds-grp)
      578       then do:
      579         buffer-compare oldb to ub.fbr-gds-grp
      580         case-sensitive
      581         save result in v-l.
      582       end.
      583       if not v-l or new(ub.fbr-gds-grp) then
      584       run fbr-gds-grph_write-fbr-gds-grp-trigger in this-procedure (
      585                                                               new(ub.fbr-gds-grp)
      586                                                             ,"":U
      587                                                             ,"":U
      588                                                             , (if new(ub.fbr-gds-grp) then integer('1':U) else integer('2':U))
      589                                                             ).
      590       if g#oxml = yes
      591       then do:
      592       run str/calloxml.p (
      593             input 'update':U
      594           , input 'fbr-gds-grp':U
      595           , input ( buffer ub.fbr-gds-grp:handle )
      596       ) no-error.
      597       if error-status :error
      598       then do:
      599           undo, return error substitute( "&2&1Ошибка при отправке записи в систему OpenXML&1&3&1&4"
      600                                , chr(10)
      601                                , vss-workfile
      602                                , return-value
      603                                , error-status :get-message ( 1 ) ).
      604       end.
      605       end.
      606   end.
      607   procedure fbr-grp-tree :
      608     define input  parameter nc       as integer   no-undo .
      609     define input parameter p-obj-type like ub.fbr-gds-grp.obj-type no-undo .
      610     define input parameter p-obj-code like ub.fbr-gds-grp.obj-code no-undo .
      611     def buffer buf_fbr-gds-grp for ub.fbr-gds-grp .
      612     do
      613     on error undo, return error return-value
      614     :
      615       for each buf_fbr-gds-grp
      616         where buf_fbr-gds-grp.upper-code = nc
      617         AND buf_fbr-gds-grp.obj-type = p-obj-type
      618         AND buf_fbr-gds-grp.obj-code = p-obj-code
      619       on error undo, return error
      620       :
      621         if nc = ub.fbr-gds-grp.node-code then do:
      622           assign
      623             ub.fbr-gds-grp.is-term = no
      624           .
      625         end.
      626         run fbr-grp-tree
      627           (input buf_fbr-gds-grp.node-code
      628            ,input buf_fbr-gds-grp.obj-type
      629            ,input buf_fbr-gds-grp.obj-code
      630           ).
      631       end.
      632     end.
      633   end procedure.
      634   procedure fbrglib-get-root-code :
      635   do
      636   on error undo, return error
      637   :
      638   define output parameter p-root-code as integer      no-undo.
      639       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      640       find first buf_fbr-gds-grp no-lock
      641            where buf_fbr-gds-grp.upper-code = 0
      642       no-error .
      643       if not available buf_fbr-gds-grp
      644       then do:
      645           undo, return error .
      646       end.
      647       else do:
      648           assign
      649               p-root-code = buf_fbr-gds-grp.node-code
      650           .
      651       end.
      652   end.
      653   end procedure.
