      843         buf_c-gds-hist.source-ref = (if g#news
      844                                      then string(g#news-source-db)
      845                                      else (if g#esys
      846                                            then string(g#esys-source-esys)
      847                                            else "":U)
      848                                      )
      849         .
      850       end.
      851       if ub.dis-gds-rule.obj-type = 'маг':U
      852       or ub.dis-gds-rule.obj-type = 'скл':U then do:
      853   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      855     (input  ub.dis-gds-rule.obj-type
      856     ,input  ub.dis-gds-rule.obj-code
      857     ,output v-obj-db-num
      858     )  .
      859         if g#db-num = 0 and v-obj-db-num <> 0  then do:
      860           assign v-db-list = string( v-obj-db-num ) .
      861         end.
      862         if g#db-num <> 0 and not g#news then do:
      863           assign v-db-list = "0" .
      864         end.
      865       end.
      866       run nws/cmd-del.p
      867         ( input 'dis-gds-rule':U
      868         ,input (buffer ub.dis-gds-rule:handle)
      869         ,input v-db-list
      870         ) no-error .
      871       if error-status :error then do:
      872         undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
      873       end.
      874     end.
      875       if g#oxml = yes
      876       then do:
      877       run str/calloxml.p (
      878             input 'delete':U
      879           , input 'dis-gds-rule':U
      880           , input ( buffer ub.dis-gds-rule:handle )
      881       ) no-error.
      882       if error-status :error
      883       then do:
      884           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      885                                , chr(10)
      886                                , vss-workfile
      887                                , return-value
      888                                , error-status :get-message ( 1 ) ).
      889       end.
      890       end.
      891   end.
