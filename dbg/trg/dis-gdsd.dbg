        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.dis-gds-rule.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление dis-gds-rule".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6'
       29                                 ,ub.dis-gds-rule.obj-type
       30                                 ,ub.dis-gds-rule.obj-code
       31                                , ub.dis-gds-rule.gds-code
       32                                 ,ub.dis-gds-rule.pos-type
       33                                 ,ub.dis-gds-rule.discnt-role
       34                                 ,ub.dis-gds-rule.nonunique
       35                                 )
       36       .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define temp-table temp-drt-prop no-undo like ub.drt-prop.
       91   procedure disrules-fill-properties:
       92   define input  parameter p-templ-rl-root as integer   no-undo .
       93   define buffer buf_drt-prop for ub.drt-prop.
       94   define buffer buf_temp-drt-prop for temp-drt-prop.
       95   do
       96   on error undo, return error return-value
       97   :
       98     for each buf_temp-drt-prop:
       99       delete buf_temp-drt-prop.
      100     end.
      101     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      102       create buf_temp-drt-prop.
      103       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      104     end.
      105   end.
      106   end procedure.
      107   ~
      108   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   procedure discfgru-check :
      110   define input parameter p-table-name as character no-undo .
      111   define input parameter p-templ-rl-root as integer no-undo .
      112   define input parameter p-time-templ-rl-root as integer no-undo .
      113   define input parameter p-pos-type as character no-undo .
      114   define output parameter p-disnct-role as character no-undo .
      115   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      116     do
      117     on error undo, return error return-value
      118     :
      119       find first buf_dis-cfg-rule no-lock where
      120               buf_dis-cfg-rule.table-name = p-table-name
      121           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      122           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      123           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      124       if not available buf_dis-cfg-rule
      125       or p-pos-type = "":U
      126       then do:
      127          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      128                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      129                                  , p-templ-rl-root
      130                                  , (if p-time-templ-rl-root = ?
      131                                     then '':U
      132                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      133                                     )
      134                                  ).
      135       end.
      136       assign
      137       p-disnct-role = buf_dis-cfg-rule.discnt-role
      138       .
      139     end.
      140   end procedure.
      141   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   FUNCTION get-region RETURNS CHARACTER
      143     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      144     define variable par-region as character no-undo.
      145     if parhost-code = 0 and
      146          parobj-type = "":U and
      147          parobj-code = 0 then do:
      148          par-region = "Глобально".
      149          return par-region.
      150       end.
      151       if parobj-type = 'орг':U then do:
      152          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      153          return par-region.
      154       end.
      155       if parobj-type = 'регион':U
      156       then do:
      157          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      158          return par-region.
      159       end.
      160       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      161       return par-region.
      162   END FUNCTION.
      163   FUNCTION get-objregion RETURNS CHARACTER
      164     (  input parobj-type as character, input parobj-code as integer ) :
      165     define variable par-region as character no-undo.
      166     if  parobj-type = "":U and
      167         parobj-code = 0
      168     then do:
      169        par-region = "Глобально".
      170     end.
      171     else if parobj-type = 'орг':U
      172     then do:
      173        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      174     end.
      175     else if parobj-type = 'регион':U
      176     then do:
      177        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      178     end.
      179     else
      180        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      181     return par-region.
      182   END FUNCTION.
      183   procedure disgdsru-name :
      184   define buffer buf_dis-rule for ub.dis-rule.
      185   do
      186     on error undo, return error
      187     :
      188     define input  parameter p-templ-rl-root  as integer no-undo .
      189     define output parameter p-label          as character no-undo .
      190     find first buf_dis-rule no-lock where
      191               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      192     if available buf_dis-rule
      193     then do:
      194       if buf_dis-rule.rule-num > 0 then
      195       p-label = buf_dis-rule.des.
      196     end.
      197     else do:
      198       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      199     end.
      200   end.
      201   end procedure.
      202   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
      203   define variable v-rule-label as character no-undo .
      204   run disgdsru-name in this-procedure ( input p-templ-rl-root
      205                                        ,output v-rule-label) no-error.
      206   return v-rule-label.
      207   end function.
      208   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
      209   define variable v-rule-label as character no-undo .
      210   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
      211   end function.
      212   procedure disgdsru-write :
      213     do
      214     on error undo, return error
      215     :
      216       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
      217       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
      218       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
      219       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
      220       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
      221       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
      222       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      223       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
      224       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
      225       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
      226       define buffer buf_dis-rule for ub.dis-rule.
      227       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
      228       define variable v-label          as character no-undo .
      229       define variable v-discnt-role as character no-undo .
      230       run discfgru-check in this-procedure (
      231                                             input 'dis-gds-rule':U
      232                                            ,input p-templ-rl-root
      233                                            ,input p-time-templ-rl-root
      234                                            ,input p-pos-type
      235                                            ,output v-discnt-role
      236                                             ) no-error .
      237       if error-status :error then do:
      238         undo, return error return-value .
      239       end.
      240       if p-discnt-role = ? then do:
      241         p-discnt-role = v-discnt-role.
      242       end.
      243       if p-discnt-role <> v-discnt-role then do:
      244         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
      245                                 ,p-gds-code
      246                                 ,p-obj-type
      247                                 ,p-obj-code
      248                                 ,p-pos-type
      249                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      250                                 ,chr(10)
      251                                 ,p-templ-rl-root
      252                                 ,p-rule-num).
      253       end.
      254       if p-pos-type = ? then do:
      255   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   define variable v-param-type4 as character no-undo .
      257   define variable v-value-date4 as date no-undo .
      258   define variable v-value-decimal4 as decimal no-undo .
      259   define variable v-value-integer4 as INTEGER no-undo .
      260   define variable v-value-logical4 AS LOGICAL no-undo .
      261   define variable v-tth4 as handle no-undo .
      262   run adm/shattri.p (
      263       input "get":U
      264       ,input  p-obj-type
      265       ,input  p-obj-code
      266       ,input  'cd-sending':U
      267       ,input  'dflt-cd':U
      268       ,output p-pos-type
      269       ,output v-value-date4
      270       ,output v-value-decimal4
      271       ,output v-value-integer4
      272       ,output v-value-logical4
      273       ,output v-param-type4
      274       ,INPUT-OUTPUT table-handle v-tth4
      275       )  .
      276   delete object v-tth4 no-error.
      277       end.
      278       find first buf_dis-rule no-lock where
      279                 buf_dis-rule.rule-num = p-rule-num no-error.
      280       if not available buf_Dis-rule then do:
      281         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
      282                                 ,p-gds-code
      283                                 ,p-obj-type
      284                                 ,p-obj-code
      285                                 ,p-pos-type
      286                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      287                                 ,chr(10)
      288                                 ,p-rule-num).
      289       end.
      290       if buf_dis-rule.root <> yes then do:
      291         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
      292                                 ,p-gds-code
      293                                 ,p-obj-type
      294                                 ,p-obj-code
      295                                 ,p-pos-type
      296                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      297                                 ,chr(10)
      298                                 ,p-rule-num).
      299       end.
      300       if not (p-obj-type = buf_dis-rule.obj-type
      301           and p-obj-code = buf_dis-rule.obj-code)
      302       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
      303                and
      304                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
      305        then do:
      306         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
      307                                 ,p-gds-code
      308                                 ,p-obj-type
      309                                 ,p-obj-code
      310                                 ,p-pos-type
      311                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      312                                 ,chr(10)
      313                                 ) +
      314                             substitute("Правило скидки &1 определено для &2&3" +
      315                                        "а привязка к товару для &4"
      316                                        ,buf_dis-rule.rule-num
      317                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      318                                        ,chr(10)
      319                                        ,get-objregion( p-obj-type, p-obj-code)
      320                                        ))
      321                                 .
      322       end.
      323       find first buf_dis-gds-rule exclusive-lock where
      324                  buf_dis-gds-rule.gds-code  = p-gds-code
      325              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      326              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      327              AND buf_dis-gds-rule.pos-type  = p-pos-type
      328              AND buf_dis-gds-rule.discnt-role = p-discnt-role
      329              and buf_dis-gds-rule.nonunique = p-nonunique
      330              no-error .
      331       if not available buf_dis-gds-rule then do:
      332         find first buf_dis-gds-rule exclusive-lock where
      333                   buf_dis-gds-rule.gds-code  = p-gds-code
      334               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      335               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      336               AND buf_dis-gds-rule.pos-type  = p-pos-type
      337               AND buf_dis-gds-rule.discnt-role = p-discnt-role
      338               no-error .
      339         if available buf_Dis-gds-rule then do:
      340           if p-nonunique = ''
      341           and available buf_dis-gds-rule
      342           then do:
      343             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
      344                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      345                                      , p-gds-code
      346                                      , buf_Dis-rule.obj-type
      347                                      , buf_Dis-rule.obj-code
      348                                      , p-nonunique
      349                                     ).
      350           end.
      351           if available buf_dis-gds-rule
      352           and buf_dis-gds-rule.nonunique = ''
      353           and p-nonunique <> ''then do:
      354             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
      355                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      356                                      , p-gds-code
      357                                      , buf_Dis-rule.obj-type
      358                                      , buf_Dis-rule.obj-code
      359                                     ).
      360           end.
      361         end.
      362         create buf_dis-gds-rule .
      363         assign
      364         buf_dis-gds-rule.gds-code  = p-gds-code
      365         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      366         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      367         buf_dis-gds-rule.pos-type = p-pos-type
      368         buf_dis-gds-rule.discnt-role = v-discnt-role
      369         buf_dis-gds-rule.rule-num = p-rule-num
      370         buf_dis-gds-rule.nonunique = p-nonunique
      371         no-error
      372         .
      373       end.
      374       ASSIGN
      375       buf_dis-gds-rule.rule-num = p-rule-num
      376       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
      377       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
      378       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
      379       buf_dis-gds-rule.nonunique = p-nonunique
      380       no-error.
      381     end.
      382   end procedure.
      383   PROCEDURE cmp-disgdsru-write :
      384   do
      385   on error undo, return error
      386   :
      387     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
      388     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
      389     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
      390     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
      391     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
      392     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      393     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
      394     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
      395     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
      396     define variable v-rule-label          as character no-undo .
      397     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
      398     define buffer buf_dis-rule     for ub.dis-rule.
      399     run disgdsru-name in this-procedure (
      400                                         input  p-templ-rl-root
      401                                         ,output v-rule-label
      402                                         ) no-error .
      403     if error-status :error then do:
      404       undo, return error return-value .
      405     end.
      406     find first buf_tt0-dis-gds-rule exclusive-lock where
      407                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      408             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      409             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      410             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      411             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      412             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
      413             no-error .
      414     if not available buf_tt0-dis-gds-rule then do:
      415       create buf_tt0-dis-gds-rule .
      416       assign
      417       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      418       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      419       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      420       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      421       buf_tt0-dis-gds-rule.nonunique = p-nonunique
      422       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      423       no-error
      424       .
      425     end.
      426     find first buf_dis-rule no-lock where
      427               buf_dis-rule.rule-num = p-rule-num.
      428     ASSIGN
      429     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
      430     buf_tt0-dis-gds-rule.rule-num = p-rule-num
      431     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
      432     buf_tt0-dis-gds-rule.nonunique = p-nonunique
      433     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
      434     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
      435     no-error.
      436     release buf_tt0-dis-gds-rule no-error .
      437     if error-status:error then do:
      438       undo, return error return-value .
      439     end.
      440   end.
      441   END PROCEDURE.
      442   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   procedure cur-time :
      444      define output parameter p-today as date      no-undo .
      445      define output parameter p-time  as integer   no-undo .
      446     do
      447     on error undo, return error
      448     :
      449       define variable v-date1 as date      no-undo .
      450       define variable v-date2 as date      no-undo .
      451       define variable v-time  as integer   no-undo .
      452       assign
      453         v-date1 = today
      454         v-time  = time
      455         v-date2 = today
      456       .
      457       if v-date1 <> v-date2
      458       then do:
      459         assign
      460           v-date1 = today
      461           v-time  = v-time
      462         .
      463       end.
      464       assign
      465         p-today = v-date1
      466         p-time  = v-time
      467       .
      468     end.
      469   end.
      470   function cur-time-date returns character
      471   :
      472     return string(today, '99/99/9999':U) .
      473   end.
      474   function cur-time-mjd returns decimal
      475   :
      476     define variable v-date as date      no-undo .
      477     define variable v-time as integer   no-undo .
      478     run cur-time in this-procedure
      479       (output v-date
      480       ,output v-time
      481       ) .
      482     return integer(v-date) - 2400002 + (v-time / 86400) .
      483   end.
      484   function cur-time-get-ending-index returns integer
      485   (input p-number as integer
      486   )
      487   :
      488     if p-number < 0
      489     or p-number = ?
      490     then do:
      491       return 1 .
      492     end.
      493     define variable v-rest as integer   no-undo .
      494     assign
      495       p-number = p-number modulo 100
      496     .
      497     if p-number < 20
      498     then do:
      499       assign
      500         v-rest = p-number
      501       .
      502     end.
      503     else do:
      504       assign
      505         v-rest = p-number modulo 10
      506       .
      507     end.
      508     case v-rest :
      509       when 1
      510       then do:
      511         return 2 .
      512       end.
      513       when 2 or
      514       when 3 or
      515       when 4
      516       then do:
      517         return 3 .
      518       end.
      519       otherwise do:
      520         return 1 .
      521       end.
      522     end case .
      523   end.
      524   procedure cur-time-mjd-to-date :
      525      define input  parameter i-mjd-diff as decimal no-undo.
      526      define output parameter o-Date     as date    no-undo.
      527      define output parameter o-Time     as integer no-undo.
      528      define variable v-day-number as integer   no-undo .
      529      if    i-mjd-diff < 0
      530         or i-mjd-diff = ?
      531      then do:
      532         return "?" .
      533      end.
      534      assign
      535         v-day-number = truncate(i-mjd-diff,0).
      536         o-Date = date(v-day-number + 2400002).
      537         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      538     .
      539   end.
      540   function cur-time-mjd-to-string returns character
      541   (input p-mjd-diff as decimal
      542   )
      543   :
      544     define variable v-day-number as integer   no-undo .
      545     define variable v-seconds    as integer   no-undo .
      546     define variable v-hour       as integer   no-undo .
      547     define variable v-min        as integer   no-undo .
      548     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      549     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      550     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      551     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      552     if p-mjd-diff < 0
      553     or p-mjd-diff = ?
      554     then do:
      555       return "?" .
      556     end.
      557     assign
      558       v-day-number = integer(truncate(p-mjd-diff,0))
      559       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      560     .
      561     if v-seconds > 86400
      562     then do:
      563       assign
      564         v-seconds = 86400 - 1
      565       .
      566     end.
      567     if v-seconds < 0
      568     then do:
      569       assign
      570         v-seconds = 0
      571       .
      572     end.
      573     assign
      574       v-hour = truncate(v-seconds / 3600, 0)
      575     .
      576     assign
      577       v-seconds = v-seconds modulo 3600
      578     .
      579     assign
      580       v-min = truncate(v-seconds / 60, 0)
      581     .
      582     assign
      583       v-seconds = v-seconds modulo 60
      584     .
      585     return
      586         (if v-day-number <> 0
      587           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      588           else ""
      589         )
      590       + (if v-day-number <> 0 or v-hour <> 0
      591           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      592           else ""
      593         )
      594       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      595           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      596           else ""
      597         )
      598       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      599       .
      600   end.
      601   function cur-time-string returns character
      602   :
      603     define variable v-date as date      no-undo .
      604     define variable v-time as integer   no-undo .
      605     run cur-time in this-procedure
      606       (output v-date
      607       ,output v-time
      608       ) .
      609     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      610   end.
      611   function cur-time-string-sec returns character
      612   :
      613     define variable v-date as date      no-undo .
      614     define variable v-time as integer   no-undo .
      615     run cur-time in this-procedure
      616       (output v-date
      617       ,output v-time
      618       ) .
      619     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      620   end.
      621   function cur-time-custom  returns character
      622   (input p-prefix as character
      623   ,input p-date-format as character
      624   ,input p-delimiter as character
      625   ,input p-time-format as character
      626   ,input p-suffix as character
      627   )
      628   :
      629     define variable v-date as date      no-undo .
      630     define variable v-time as integer   no-undo .
      631     run cur-time in this-procedure
      632       (output v-date
      633       ,output v-time
      634       ) .
      635     return
      636       p-prefix
      637       + string(v-date, p-date-format)
      638       + p-delimiter
      639       + string(v-time, p-time-format)
      640       + p-suffix
      641       .
      642   end.
      643   function cur-time-print  returns character
      644   :
      645     define variable v-date as date      no-undo .
      646     define variable v-time as integer   no-undo .
      647     run cur-time in this-procedure
      648       (output v-date
      649       ,output v-time
      650       ) .
      651     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      652   end.
      653   function cur-time-datetime returns datetime
      654   :
      655     define variable v-char as character no-undo .
      656     define variable v-datetime as datetime no-undo .
      657     v-char = cur-time-string().
      658     v-datetime = datetime(v-char).
      659     return  v-datetime.
      660   end.
      661   function cur-time-string-msec returns character
      662   :
      663     define variable v-date as datetime  no-undo .
      664     v-date = now.
      665     return string(v-date) .
      666   end.
