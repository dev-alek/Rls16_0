        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.dis-card-property.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Триггер на удаление свойства ДК".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      304   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   procedure gen-key-rec :
      306     define input  parameter p-tbl-name    as character no-undo.
      307     define input  parameter p-bh_tbl-name as handle    no-undo.
      308     define output parameter p-key-rec     as character no-undo.
      309     do
      310     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      311     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      312     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      313     :
      314       define variable fh               as handle    no-undo .
      315       define variable v-ok             as logical   no-undo .
      316       define variable v-inform         as character no-undo .
      317       define variable v-ind            as integer   no-undo .
      318       define variable v-idx-field-qnty as integer   no-undo .
      319       if p-tbl-name = ?
      320         or p-tbl-name = "":U
      321       then do:
      322         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      323       end.
      324       if not p-bh_tbl-name:available then do:
      325         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      326       end.
      327       assign
      328         p-key-rec = p-tbl-name
      329         v-inform  = p-bh_tbl-name:index-information(1)
      330         v-ind     = 2
      331       .
      332       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      333       on error undo, return error
      334       :
      335         assign
      336           v-inform = p-bh_tbl-name:index-information( v-ind )
      337           v-ind    = v-ind + 1
      338         .
      339       end.
      340       if v-inform = ?
      341         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      342         or entry( 3, v-inform, ",":U ) <> "1":U
      343       then do:
      344         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      345       end.
      346       else do:
      347         assign
      348           v-idx-field-qnty = num-entries( v-inform ) - 4
      349         .
      350         if v-idx-field-qnty < 2 then do:
      351           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      352         end.
      353         do v-ind = 1 to v-idx-field-qnty by 2
      354         on error undo, return error
      355         :
      356           assign
      357             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      358             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      359           .
      360         end.
      361       end.
      362       if p-key-rec = ? then do:
      363         assign
      364           p-key-rec = "":U
      365         .
      366         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      367       end.
      368     end.
      369     return.
      370   end procedure.
      371   procedure gen-where-keyr-tab :
      372     define input  parameter i-tableSerach as character no-undo.
      373     define input  parameter i-tablekey   as character  no-undo.
      374     define input  parameter p-key-rec    as character  no-undo.
      375     define input  parameter p-key-handle as handle     no-undo .
      376     define input  parameter p-db-name    as character  no-undo .
      377     define input  parameter p-tt-handle  as handle     no-undo .
      378     define output parameter o-Where      as character  no-undo.
      379     do
      380     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      381     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      382     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      383     :
      384       define variable v-full-tbl-name  as character no-undo .
      385       define variable bh_tbl-name      as handle    no-undo .
      386       define variable fh_key           as handle    no-undo .
      387       define variable fh_search        as handle    no-undo .
      388       define variable v-field-num      as integer   no-undo .
      389       define variable v-count-fld      as integer   no-undo .
      390       define variable v-inform         as character no-undo .
      391       define variable v-ind            as integer   no-undo .
      392       define variable v-idx-field-qnty as integer   no-undo .
      393       define variable v-field-name     as character no-undo .
      394       define variable v-field-val      as character no-undo .
      395       define variable v-word-link      as character no-undo .
      396       define variable vTable           as character no-undo.
      397       define variable bh_tbl-key       as handle    no-undo .
      398       assign
      399         p-key-rec = trim( p-key-rec )
      400       .
      401       if p-key-handle <> ? then do:
      402         if not valid-handle(p-key-handle)
      403            or p-key-handle:type <> "buffer"
      404         then do:
      405           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      406         end.
      407         if num-entries( p-key-rec, chr(3) ) > 1
      408           or p-key-rec = ?
      409           or p-key-rec = "":U
      410         then do:
      411           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      412         end.
      413       end.
      414       else do:
      415         if p-key-rec = ?
      416           or p-key-rec = "":U
      417         then do:
      418           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      419         end.
      420       end.
      421       assign
      422         vTable = entry( 1 , p-key-rec, chr(3) )
      423       .
      424       if p-tt-handle <> ?
      425         and ( not valid-handle(p-tt-handle)
      426               or p-tt-handle:type <> "buffer"
      427             )
      428       then do:
      429         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      430       end.
      431       if p-tt-handle = ? then do:
      432         assign
      433           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      434         .
      435         create buffer bh_tbl-name for table v-full-tbl-name .
      436       end.
      437       else do:
      438         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      439       end.
      440       assign
      441         v-inform = bh_tbl-name:index-information(1)
      442         v-ind    = 2
      443       .
      444       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      445       on error undo, return error
      446       :
      447         assign
      448           v-inform = bh_tbl-name:index-information( v-ind )
      449           v-ind    = v-ind + 1
      450         .
      451       end.
      452       if v-inform = ?
      453         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      454         or entry( 3, v-inform, ",":U ) <> "1":U
      455       then do:
      456         delete object bh_tbl-name no-error.
      457         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      458       end.
      459       assign
      460         v-idx-field-qnty = num-entries( v-inform ) - 4
      461       .
      462       if v-idx-field-qnty < 2 then do:
      463         delete object bh_tbl-name no-error.
      464         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      465       end.
      466       assign
      467         o-where     = "where":U
      468         v-word-link = "":U
      469         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      470         v-count-fld = 0
      471       .
      472       if i-tablekey ne "" and i-tablekey ne ?
      473       then do:
      474         assign
      475           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      476         .
      477         create buffer bh_tbl-key for table v-full-tbl-name .
      478       end.
      479       if i-tableSerach ne "" and i-tableSerach ne ?
      480       then do:
      481         delete object bh_tbl-name no-error.
      482         assign
      483           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      484         .
      485         create buffer bh_tbl-name for table v-full-tbl-name .
      486       end.
      487       block_where:
      488       do v-ind = 1 to v-idx-field-qnty by 2
      489       on error undo, return error
      490       :
      491         assign
      492           v-count-fld = v-count-fld + 1
      493         .
      494         if p-key-handle = ?
      495           and v-count-fld > v-field-num
      496         then do:
      497           leave block_where.
      498         end.
      499         define variable VfieldKeyTable as handle no-undo.
      500         assign
      501           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      502           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      503         .
      504         if     bh_tbl-key ne ?
      505         then do:
      506            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      507            if VfieldKeyTable eq ?
      508            then next block_where.
      509         end.
      510         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      511         then
      512            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      513         else
      514            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      515         if p-key-handle = ? then do:
      516           assign
      517             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      518           .
      519         end.
      520         else do:
      521           assign
      522             fh_key = p-key-handle:buffer-field( v-field-name )
      523           .
      524           if fh_key = ?
      525             or not valid-handle( fh_key )
      526           then do:
      527             delete object bh_tbl-name.
      528             if     bh_tbl-key ne ?
      529             then
      530                delete object bh_tbl-key.
      531             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      532           end.
      533           assign
      534             v-field-val = fh_key:buffer-value
      535           .
      536         end.
      537         if fh_search:data-type ="character":U then do:
      538           assign
      539             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      540             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      541             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      542             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      543             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      544             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      545             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      546             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      547             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      548             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      549             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      550             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      551             v-field-val = substitute( '"&1"', v-field-val )
      552           .
      553         end.
      554         assign
      555           o-where = substitute( "&1 &2", o-where, v-field-val )
      556         .
      557         if v-word-link = "":U then do:
      558           assign
      559             v-word-link = "and":U
      560           .
      561         end.
      562       end.
      563       delete object bh_tbl-name.
      564       if     bh_tbl-key ne ?
      565       then
      566          delete object bh_tbl-key.
      567       if p-key-handle = ?
      568         and v-count-fld <> v-field-num
      569       then do:
      570         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      571       end.
      572     end.
      573   end procedure.
      574   procedure gen-hn-keyr-tab :
      575     define input  parameter i-tableSerach as character no-undo.
      576     define input  parameter i-tablekey   as character no-undo.
      577     define input  parameter p-key-rec    as character no-undo.
      578     define input  parameter p-key-handle as handle    no-undo .
      579     define input  parameter p-db-name    as character no-undo .
      580     define input  parameter p-tt-handle  as handle    no-undo .
      581     define input  parameter p-stts-lock  as integer   no-undo .
      582     define output parameter o-hn         as handle    no-undo.
      583     define variable v-full-tbl-name as character no-undo.
      584     define variable v-where         as character no-undo.
      585     define variable bh_tbl-name     as handle    no-undo.
      586     define variable vTable          as character no-undo.
      587     do
      588     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      589     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      590     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      591         run gen-where-keyr-tab(i-tableSerach,
      592                                i-tablekey,
      593                                p-key-rec,
      594                                p-key-handle,
      595                                p-db-name,
      596                                p-tt-handle,
      597                                output v-where).
      598         if i-tableSerach ne "" and i-tableSerach ne ?
      599         then do:
      600            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      601            create buffer bh_tbl-name for table v-full-tbl-name .
      602         end.
      603         else do:
      604            if p-tt-handle = ? then do:
      605               assign
      606                  vTable = entry( 1 , p-key-rec, chr(3) )
      607               .
      608               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      609               create buffer bh_tbl-name for table v-full-tbl-name .
      610            end.
      611            else do:
      612               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      613            end.
      614         end.
      615         if p-tt-handle = ? then do:
      616            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      617         end.
      618         else do:
      619            bh_tbl-name:find-first( v-where ) no-error .
      620         end.
      621         o-hn = bh_tbl-name.
      622      end.
      623   end procedure.
      624   procedure gen-hn-keyr :
      625     define input  parameter p-key-rec    as character no-undo.
      626     define input  parameter p-key-handle as handle    no-undo .
      627     define input  parameter p-db-name    as character no-undo .
      628     define input  parameter p-tt-handle  as handle    no-undo .
      629     define input  parameter p-stts-lock  as integer   no-undo .
      630     define output parameter o-hn         as handle    no-undo.
      631     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      632   end.
      633   procedure gen-row-keyr :
      634     define input  parameter p-key-rec    as character no-undo.
      635     define input  parameter p-key-handle as handle    no-undo .
      636     define input  parameter p-db-name    as character no-undo .
      637     define input  parameter p-tt-handle  as handle    no-undo .
      638     define input  parameter p-stts-lock  as integer   no-undo .
      639     define output parameter p-tbl-row    as rowid     no-undo.
      640     define output parameter p-tbl-name   as character no-undo.
      641     define variable vHn as handle no-undo.
      642       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      643       p-tbl-row = if vHn:available then vHn:rowid else ?.
      644       p-tbl-name =  vHn:table.
      645       delete object vHn no-error.
      646     if p-tbl-row = ? then do:
      647       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      648     end.
      649     else do:
      650       return.
      651     end.
      652   end procedure.
      653   procedure gen-key-fv :
      654     define input  parameter p-key-rec    as character no-undo .
      655     define output parameter p-field-list as character no-undo .
      656     define output parameter p-value-list as character no-undo.
      657     do
      658     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      659     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      660     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      661     :
      662       define variable v-full-tbl-name  as character no-undo .
      663       define variable bh_tbl-name      as handle    no-undo .
      664       define variable v-tbl-name       as character no-undo .
      665       define variable v-field-num      as integer   no-undo .
      666       define variable v-count-fld      as integer   no-undo .
      667       define variable v-inform         as character no-undo .
      668       define variable v-ind            as integer   no-undo .
      669       define variable v-idx-field-qnty as integer   no-undo .
      670       define variable v-delim-key      as character no-undo .
      671       if p-key-rec = ?
      672         or p-key-rec = "":U
      673       then do:
      674         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      675       end.
      676       assign
      677         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      678         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      679       .
      680       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      681       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      682       assign
      683         v-inform = bh_tbl-name:index-information(1)
      684         v-ind    = 2
      685       .
      686       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      687       on error undo, return error
      688       :
      689         assign
      690           v-inform = bh_tbl-name:index-information( v-ind )
      691           v-ind    = v-ind + 1
      692         .
      693       end.
      694       if v-inform = ?
      695         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      696         or entry( 3, v-inform, ",":U ) <> "1":U
      697       then do:
      698         delete object bh_tbl-name no-error.
      699         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      700       end.
      701       assign
      702         v-idx-field-qnty = num-entries( v-inform ) - 4
      703       .
      704       if v-idx-field-qnty < 2 then do:
      705         delete object bh_tbl-name no-error.
      706         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      707       end.
      708       assign
      709         p-field-list = "":U
      710         p-value-list = "":U
      711         v-delim-key  = "":U
      712         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      713         v-count-fld  = 0
      714       .
      715       block_where:
      716       do v-ind = 1 to v-idx-field-qnty by 2
      717       on error undo, return error
      718       :
      719         assign
      720           v-count-fld = v-count-fld + 1
      721         .
      722         if v-count-fld > v-field-num then do:
      723           leave block_where.
      724         end.
      725         assign
      726           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      727           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      728         .
      729         if v-ind = 1 then do:
      730           assign
      731             v-delim-key = chr(3)
      732           .
      733         end.
      734       end.
      735       delete object bh_tbl-name.
      736       if v-count-fld <> v-field-num then do:
      737         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      738       end.
      739     end.
      740   end procedure.
      741   procedure gen-key-field :
      742     define input  parameter p-table      as character no-undo .
      743     define output parameter p-field-list as character no-undo .
      744     do
      745     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      746     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      747     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      748     :
      749       define variable v-full-tbl-name  as character no-undo .
      750       define variable bh_tbl-name      as handle    no-undo .
      751       define variable v-tbl-name       as character no-undo .
      752       define variable v-field-num      as integer   no-undo .
      753       define variable v-count-fld      as integer   no-undo .
      754       define variable v-inform         as character no-undo .
      755       define variable v-ind            as integer   no-undo .
      756       define variable v-idx-field-qnty as integer   no-undo .
      757       define variable v-delim-key      as character no-undo .
      758       if p-table = ?
      759         or p-table = "":U
      760       then do:
      761         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      762       end.
      763       assign
      764         v-tbl-name      = p-table
      765         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      766       .
      767       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      768       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      769       assign
      770         v-inform = bh_tbl-name:index-information(1)
      771         v-ind    = 2
      772       .
      773       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      774       on error undo, return error
      775       :
      776         assign
      777           v-inform = bh_tbl-name:index-information( v-ind )
      778           v-ind    = v-ind + 1
      779         .
      780       end.
      781       if v-inform = ?
      782         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      783         or entry( 3, v-inform, ",":U ) <> "1":U
      784       then do:
      785         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      786       end.
      787       assign
      788         v-idx-field-qnty = num-entries( v-inform ) - 4
      789       .
      790       if v-idx-field-qnty < 2 then do:
      791         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      792       end.
      793       assign
      794         p-field-list = "":U
      795         v-delim-key  = "":U
      796         v-count-fld  = 0
      797       .
      798       block_where:
      799       do v-ind = 1 to v-idx-field-qnty by 2
      800       on error undo, return error
      801       :
      802         assign
      803           v-count-fld = v-count-fld + 1
      804         .
      805         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      806         if v-ind = 1 then do:
      807           assign
      808             v-delim-key = chr(3)
      809           .
      810         end.
      811       end.
      812       delete object bh_tbl-name.
      813     end.
      814   end procedure.
      815   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   define new global shared variable g#lib-nws as handle no-undo .
      817   procedure disproph_write-dcp-trigger  :
      818   define input parameter p-new-record as logical no-undo .
      819   define input parameter p-source-type as character no-undo .
      820   define input parameter p-source-ref as character no-undo .
      821   define variable v-date as date      no-undo.
      822   define variable v-time  as integer   no-undo.
      823   define variable v-uniq-key-rec as character no-undo .
      824   define buffer buf_dis-card for ub.dis-card.
      825   define buffer buf_c-dc-hist for ub.c-dc-hist.
      826   define buffer buf_c-dis-card-property for ub.c-dis-card-property.
      827     main-block:
      828     do
      829     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      830     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      831     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      832     :
      833       define variable v-send as integer no-undo .
      834       v-send = integer('0':U).
      835       if not p-new-record then do:
      836         find first buf_dis-card no-lock where
      837                   buf_dis-card.d-card = ub.dis-card-property.d-card no-error.
      838         if available buf_dis-card then do:
      839           if g#news then do:
      840   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      842     (input  g#db-num
      843     ,input  'dis-card-property':U
      844     ,input  0
      845     ,input  '':U
      846     ,input  0
      847     ,input  buf_dis-card.type
      848     ,input  '':U
      849     ,input  '':U
      850     ,input  buf_dis-card.emitent-host-code
      851     ,input  (if ub.dis-card-property.dt-code > 0 then 0 else -1)
      852     ,input  0
      853     ,input  'nws-to-hist'
      854     ,output v-send
      855     ) no-error .
      856           end.
      857           else do:
      858   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      859   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      860     (input  g#db-num
      861     ,input  'dis-card-property':U
      862     ,input  0
      863     ,input  '':U
      864     ,input  0
      865     ,input  buf_dis-card.type
      866     ,input  '':U
      867     ,input  '':U
      868     ,input  buf_dis-card.emitent-host-code
      869     ,input  (if ub.dis-card-property.dt-code > 0 then 0 else -1)
      870     ,input  0
      871     ,input  'hist-from-prim'
      872     ,output v-send
      873     ) no-error .
      874           end.
      875         end.
      876       end.
      877       if v-send >= 0 then do:
      878         run cur-time in this-procedure(output v-date, output v-time).
      879         create buf_c-dis-card-property.
      880         buffer-copy ub.dis-card-property to buf_c-dis-card-property
      881         assign
      882         buf_c-dis-card-property.d-card            = ub.dis-card-property.d-card
      883         buf_c-dis-card-property.card-num          = ub.dis-card-property.card-num
      884         buf_c-dis-card-property.host-code         = ub.dis-card-property.host-code
      885         buf_c-dis-card-property.obj-type          = ub.dis-card-property.obj-type
      886         buf_c-dis-card-property.obj-code          = ub.dis-card-property.obj-code
      887         buf_c-dis-card-property.dt-code           = ub.dis-card-property.dt-code
      888         buf_c-dis-card-property.node-code         = ub.dis-card-property.node-code
      889         buf_c-dis-card-property.dtm-code         = ub.dis-card-property.dtm-code
      890         buf_c-dis-card-property.main-card         = ub.dis-card-property.main-card
      891         buf_c-dis-card-property.first-main-card   = ub.dis-card-property.first-main-card
      892         buf_c-dis-card-property.first-card        = ub.dis-card-property.first-card
      893         buf_c-dis-card-property.chip-num          = next-value (s-dc-chip, ub)
      894         buf_c-dis-card-property.corr-time         = v-time
      895         buf_c-dis-card-property.corr-user-db-num  = g#db-num
      896         buf_c-dis-card-property.corr-user-name    = (if g#news
      897                                                      then (chr(4) +  'СПН':U)
      898                                                      else (if g#esys
      899                                                            then (chr(4) +  'ВС':U)
      900                                                            else g#userid
      901                                                            )
      902                                                      )
      903         buf_c-dis-card-property.corr-date         = v-date
      904         .
      905         run gen-key-rec in this-procedure (
      906                                             input 'dis-card-property':U
      907                                           ,input buffer ub.dis-card-property:handle
      908                                           ,output v-uniq-key-rec).
      909         create buf_c-dc-hist.
      910         buffer-copy buf_c-dis-card-property to buf_c-dc-hist
      911         assign
      912         buf_c-dc-hist.action = integer('99':U)
      913         buf_c-dc-hist.subject = 'dis-card-property':U
      914         buf_c-dc-hist.is-news = g#news
      915         buf_c-dc-hist.source-type = p-source-type
      916         buf_c-dc-hist.source-ref = p-source-ref
      917         buf_c-dc-hist.uniq-key-rec = v-uniq-key-rec
      918         .
      919         run disproph_send-nws in this-procedure (
      920                                                  buffer buf_c-dis-card-property
      921                                                 ,buffer buf_c-dc-hist
      922                                                 ,buffer buf_Dis-card
      923                                                   ).
      924       end.
      925     end.
      926   end procedure.
      927   procedure disproph_send-nws :
      928   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
      929   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
      930   define parameter buffer buf_Dis-card for ub.dis-card.
      931   define variable v-dh-hn as integer no-undo .
      932   main-block:
      933   do
      934   on error undo, return error return-value
      935   :
      936     if g#news
      937     and g#db-num > 0
      938     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
      939     then return.
      940     if g#db-num = 0
      941     or (g#news
      942         and g#db-num > 0
      943         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
      944         )
      945     then do:
      946       if not available buf_dis-card then do:
      947         find first buf_dis-card no-lock where
      948                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
      949       end.
      950       if not available buf_dis-card then do:
      951         assign
      952         v-dh-hn = integer('0':U).
      953       end.
      954       else do:
      955   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      956   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
      957     (input  g#db-num
      958     ,input  'dis-card-property':U
      959     ,input  0
      960     ,input  '':U
      961     ,input  0
      962     ,input  buf_dis-card.type
      963     ,input  '':U
      964     ,input  '':U
      965     ,input  buf_dis-card.emitent-host-code
      966     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
      967     ,input  0
      968     ,input  'hist-to-nws'
      969     ,output v-dh-hn
      970     ) no-error .
      971       end.
      972       if v-dh-hn >= 0 then do:
      973         run str/callnews.p (
      974           input 'c-dis-card-property':U
      975           ,input (buffer buf_c-dis-card-property:handle)
      976           ) no-error .
      977         if error-status:error then do:
      978           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      979         end.
      980         if available buf_c-dc-hist then do:
      981           run str/callnews.p (
      982             input 'c-dc-hist':U
      983             ,input (buffer buf_c-dc-hist:handle)
      984             ) no-error .
      985           if error-status:error then do:
      986             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
      987           end.
      988         end.
      989       end.
      990     end.
      991   end.
      992   end procedure.
      993   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   define variable v-disprop-menu-section-num as integer no-undo .
      995   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   procedure discprop-node-code :
      997   define input parameter p-dtm-code as integer no-undo .
      998   define input parameter p-node-code as integer no-undo .
      999   define output parameter p-data-type as character no-undo .
     1000   define output parameter p-format as character no-undo .
     1001   define output parameter p-label as character no-undo .
     1002   define output parameter p-range as integer no-undo .
     1003   define output parameter p-rw-option as character no-undo .
     1004   define buffer buf_prop-map for ub.prop-map.
     1005   define buffer buf_prop-head for ub.prop-head.
     1006   do
     1007   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1008   :
     1009   find first buf_prop-head no-lock where
     1010             buf_prop-head.dtm-code = p-dtm-code no-error .
     1011   if available buf_prop-head then do:
     1012     if p-node-code > 0 then do:
     1013       find first buf_prop-map no-lock where
     1014                 buf_prop-map.dtm-code = p-dtm-code
     1015             and buf_prop-map.node-code = p-node-code no-error .
     1016       if available buf_prop-map then do:
     1017         assign
     1018         p-data-type = buf_prop-map.node-value-type
     1019         p-format = buf_prop-map.node-format
     1020         p-label = buf_prop-map.node-label
     1021         p-rw-option = buf_prop-map.rw-option
     1022         .
     1023       end.
     1024     end.
     1025     if buf_prop-head.storage-place  = "":U
     1026     and buf_prop-head.storage-place-host  > "":U
     1027     and buf_prop-head.storage-place-obj  > "":U then do:
     1028       p-range =  12.
     1029     end.
     1030     if buf_prop-head.storage-place  > "":U
     1031     and buf_prop-head.storage-place-host  > "":U
     1032     and buf_prop-head.storage-place-obj  > "":U then do:
     1033       p-range =  3.
     1034     end.
     1035     if buf_prop-head.storage-place  > "":U
     1036     and buf_prop-head.storage-place-host  > "":U
     1037     and buf_prop-head.storage-place-obj  = "":U then do:
     1038       p-range =  2.
     1039     end.
     1040     if buf_prop-head.storage-place  = "":U
     1041     and buf_prop-head.storage-place-host  > "":U
     1042     and buf_prop-head.storage-place-obj  = "":U then do:
     1043       p-range =  1.
     1044     end.
     1045     if buf_prop-head.storage-place  > "":U
     1046     and buf_prop-head.storage-place-host  = "":U
     1047     and buf_prop-head.storage-place-obj  = "":U then do:
     1048       p-range =  0.
     1049     end.
     1050   end.
     1051   end.
     1052   end procedure.
     1053   procedure discprop-initial:
     1054   define input parameter p-dtm-code as integer no-undo .
     1055   define input parameter p-node-code as integer no-undo .
     1056   define output parameter p-init-value-character as character no-undo .
     1057   define output parameter p-init-value-date as date no-undo .
     1058   define output parameter p-init-value-decimal as decimal no-undo .
     1059   define output parameter p-init-value-integer as integer no-undo .
     1060   define output parameter p-init-value-logical as logical no-undo .
     1061   define buffer buf_prop-map for ub.prop-map.
     1062   find first buf_prop-map no-lock where
     1063             buf_prop-map.dtm-code = p-dtm-code
     1064         and buf_prop-map.node-code = p-node-code no-error.
     1065   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     1066                                                               , p-node-code
     1067                                                               , p-dtm-code).
     1068   assign
     1069   p-init-value-character = buf_prop-map.init-value-character
     1070   p-init-value-date = buf_prop-map.init-value-date
     1071   p-init-value-decimal = buf_prop-map.init-value-decimal
     1072   p-init-value-integer = buf_prop-map.init-value-integer
     1073   p-init-value-logical = buf_prop-map.init-value-logical
     1074   .
     1075   end procedure.
     1076   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     1077   define buffer buf_attr-prop for ub.attr-prop.
     1078   find first buf_attr-prop no-lock where
     1079             buf_attr-prop.table-name = 'dis-card-property':U
     1080         and buf_attr-prop.templ-rl-root = p-dtm-code
     1081         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     1082         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     1083   if not available buf_attr-prop
     1084   or logical(buf_attr-prop.property-value) = no then do:
     1085     return no.
     1086   end.
     1087   return yes.
     1088   end function.
     1089   procedure discprop-edit :
     1090   define input parameter p-dtm-code-node-name as character no-undo .
     1091   define output parameter p-edit-menu-section-num as integer no-undo .
     1092   define buffer buf_attr-prop for ub.attr-prop.
     1093   do
     1094   on error undo, return error return-value
     1095   :
     1096     find first buf_attr-prop no-lock where
     1097             buf_attr-prop.table-name = 'dis-card-property':U
     1098        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     1099        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     1100        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     1101     if available buf_attr-prop then do:
     1102       assign
     1103       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     1104     end.
     1105   end.
     1106   end procedure.
     1107   procedure discprop-node-name :
     1108   define input parameter p-dtm-code-node-name as character no-undo .
     1109   define output parameter p-tool-tip as character no-undo .
     1110   define output parameter p-node-label as character no-undo .
     1111   define buffer buf_prop-map for ub.prop-map.
     1112   define buffer buf_prop-head for ub.prop-head.
     1113   do
     1114   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1115   :
     1116     find first buf_prop-head no-lock where
     1117               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     1118     assign
     1119     p-tool-tip   = if available buf_prop-head
     1120                    then buf_prop-head.prop-des
     1121                    else entry(1, p-dtm-code-node-name, chr(4) )
     1122     p-node-label = (if available buf_prop-head
     1123                     then buf_prop-head.prop-label
     1124                     else '':U)
     1125     .
     1126     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     1127       find first buf_prop-map no-lock where
     1128                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     1129           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     1130       if available buf_prop-map then do:
     1131         assign
     1132         p-tool-tip   = buf_prop-map.node-description
     1133         p-node-label = (if available buf_prop-head
     1134                         then buf_prop-head.prop-label
     1135                         else '':U) + ":" + buf_prop-map.node-label
     1136         .
     1137       end.
     1138     end.
     1139   end.
     1140   end procedure.
     1141   procedure discprop-write :
     1142   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     1143   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     1144   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     1145   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     1146   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     1147   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     1148   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     1149   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     1150   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     1151   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     1152   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     1153   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1154   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1155   define input parameter p-source-type     as character no-undo .
     1156   define input parameter p-source-ref      as character no-undo .
     1157   define input-output parameter p-chip-num as integer no-undo .
     1158   define input-output parameter p-corr-date as date no-undo .
     1159   define input-output parameter p-corr-time as integer no-undo .
     1160   do
     1161   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1162   :
     1163     define buffer buf_dis-card-property for ub.dis-card-property .
     1164     define buffer buf_dis-card for ub.dis-card.
     1165     define buffer buf_prop-ref for ub.prop-ref.
     1166     define variable v-data-type      as character no-undo .
     1167     define variable v-data-type-1    as character no-undo .
     1168     define variable v-format         as character no-undo .
     1169     define variable v-label          as character no-undo .
     1170     define variable v-range          as integer   no-undo .
     1171     define variable v-rw-option      as character no-undo .
     1172     run discprop-node-code in this-procedure
     1173       (
     1174        input  p-dtm-code
     1175       ,input  p-node-code
     1176       ,output v-data-type
     1177       ,output v-format
     1178       ,output v-label
     1179       ,output v-range
     1180       ,output v-rw-option
     1181       ) no-error .
     1182     if error-status :error then do:
     1183       undo, return error return-value .
     1184     end.
     1185     v-data-type-1 = entry(1, v-data-type).
     1186     if p-dt-code = ? then do:
     1187       find buf_prop-ref no-lock where
     1188           buf_prop-ref.dtm-code = p-dtm-code
     1189       and buf_prop-ref.sum-id = p-sum-id no-error.
     1190       if not available buf_prop-ref then do:
     1191         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1192                                       ,p-dtm-code
     1193                                       ,p-sum-id).
     1194       end.
     1195       assign
     1196       p-dt-code = buf_prop-ref.dt-code.
     1197     end.
     1198     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1199       undo, return error "Нельзя редактировать свойство в данной БД".
     1200     end.
     1201     run discprop-check in this-procedure (
     1202                                             input v-range
     1203                                           ,input p-d-card
     1204                                           ,input p-host-code
     1205                                           ,input p-obj-type
     1206                                           ,input p-obj-code
     1207                                           ,input p-dtm-code
     1208                                           ,input p-node-code
     1209                                           ,input p-dt-code
     1210                                         ) no-error .
     1211     if error-status:error then undo,  return error return-value .
     1212     find first buf_dis-card-property exclusive-lock
     1213       where buf_dis-card-property.d-card    = p-d-card
     1214         and buf_dis-card-property.host-code = p-host-code
     1215         and buf_dis-card-property.obj-type  = p-obj-type
     1216         and buf_dis-card-property.obj-code  = p-obj-code
     1217         and buf_dis-card-property.dt-code = p-dt-code
     1218         and buf_dis-card-property.node-code = p-node-code
     1219       no-error .
     1220       find first buf_dis-card no-lock where
     1221                   buf_dis-card.d-card = p-d-card.
     1222     if not available buf_dis-card-property then do:
     1223       create buf_dis-card-property .
     1224       assign
     1225         buf_dis-card-property.d-card    = p-d-card
     1226         buf_dis-card-property.host-code = p-host-code
     1227         buf_dis-card-property.obj-type  = p-obj-type
     1228         buf_dis-card-property.obj-code  = p-obj-code
     1229         buf_dis-card-property.dt-code = p-dt-code
     1230         buf_dis-card-property.node-code = p-node-code
     1231         buf_dis-card-property.dtm-code = p-dtm-code
     1232         buf_dis-card-property.sum-id   = p-sum-id
     1233         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1234         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1235         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1236         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1237       .
     1238     end.
     1239     else do:
     1240       if (v-data-type-1 = 'character':U
     1241       and buf_dis-card-property.property-value-character = p-value-character)
     1242       or  (v-data-type-1 = 'date':U
     1243           and buf_dis-card-property.property-value-date = p-value-date)
     1244       or  (v-data-type-1 = 'decimal':U
     1245           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1246       or  (v-data-type-1 = 'integer':U
     1247           and buf_dis-card-property.property-value-integer = p-value-integer)
     1248       or  (v-data-type-1 = 'logical':U
     1249           and buf_dis-card-property.property-value-logical = p-value-logical)
     1250       then return.
     1251     end.
     1252     run disproph_write-dis-card-property-proc  in this-procedure (
     1253             buffer buf_dis-card-property
     1254             ,buffer Buf_dis-card
     1255             ,input p-d-card
     1256             ,input p-dt-code
     1257             ,input p-host-code
     1258             ,input p-obj-type
     1259             ,input p-obj-code
     1260             ,input p-dtm-code
     1261             ,input buf_dis-card.card-num
     1262             ,input buf_dis-card.main-card
     1263             ,input buf_dis-card.first-card
     1264             ,input buf_dis-card.first-main-card
     1265             ,input p-node-code
     1266             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1267             ,input p-source-type
     1268             ,input p-source-ref
     1269             ,input-output p-chip-num
     1270             ,input-output p-corr-date
     1271             ,input-output p-corr-time
     1272             ).
     1273     assign
     1274     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1275                                                       then p-value-character
     1276                                                       else buf_dis-card-property.property-value-character)
     1277     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1278                                                       then p-value-date
     1279                                                       else buf_dis-card-property.property-value-date)
     1280     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1281                                                       then p-value-decimal
     1282                                                       else buf_dis-card-property.property-value-decimal)
     1283     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1284                                                       then p-value-integer
     1285                                                       else buf_dis-card-property.property-value-integer)
     1286     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1287                                                       then p-value-logical
     1288                                                       else buf_dis-card-property.property-value-logical)
     1289     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1290     .
     1291     release buf_dis-card-property no-error .
     1292     if error-status:error then do:
     1293       return error return-value .
     1294     end.
     1295   end.
     1296   end procedure.
     1297   procedure discprop-delete :
     1298   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1299   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1300   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1301   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1302   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1303   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1304   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1305   define input parameter p-source-type as character no-undo .
     1306   define input parameter p-source-ref as character no-undo .
     1307   define output parameter p-deleted  as logical no-undo.
     1308   define input-output parameter p-chip-num as integer no-undo .
     1309   define input-output parameter p-corr-date as date no-undo .
     1310   define input-output parameter p-corr-time as integer no-undo .
     1311   do
     1312   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1313   :
     1314   define buffer buf_dis-card-property for ub.dis-card-property .
     1315   define buffer buf_dis-card for ub.dis-card.
     1316   define variable v-data-type      as character no-undo .
     1317   define variable v-format         as character no-undo .
     1318   define variable v-label          as character no-undo .
     1319   define variable v-range          as integer   no-undo .
     1320   define variable v-rw-option      as character   no-undo .
     1321     run discprop-node-code in this-procedure
     1322       (input  p-dtm-code
     1323       ,input  p-node-code
     1324       ,output v-data-type
     1325       ,output v-format
     1326       ,output v-label
     1327       ,output v-range
     1328       ,output v-rw-option
     1329       ) no-error .
     1330     if error-status :error then do:
     1331       undo, return error return-value .
     1332     end.
     1333     find first buf_dis-card-property exclusive-lock
     1334       where buf_dis-card-property.d-card    = p-d-card
     1335         and buf_dis-card-property.host-code = p-host-code
     1336         and buf_dis-card-property.obj-type  = p-obj-type
     1337         and buf_dis-card-property.obj-code  = p-obj-code
     1338         and buf_dis-card-property.dt-code = p-dt-code
     1339         and buf_dis-card-property.node-code = p-node-code
     1340       no-error NO-WAIT.
     1341     if not available buf_dis-card-property then do:
     1342       p-deleted = no.
     1343     end.
     1344     else do:
     1345       run disproph_write-dis-card-property-proc  in this-procedure (
     1346            buffer buf_dis-card-property
     1347           ,buffer buf_dis-card
     1348           ,input buf_dis-card-property.d-card
     1349           ,input buf_dis-card-property.dt-code
     1350           ,input buf_dis-card-property.host-code
     1351           ,input buf_dis-card-property.obj-type
     1352           ,input buf_dis-card-property.obj-code
     1353           ,input buf_dis-card-property.dtm-code
     1354           ,input buf_dis-card-property.card-num
     1355           ,input buf_dis-card-property.main-card
     1356           ,input buf_dis-card-property.first-card
     1357           ,input buf_dis-card-property.first-main-card
     1358           ,input buf_dis-card-property.node-code
     1359           ,input integer('99':U)
     1360           ,input p-source-type
     1361           ,input p-source-ref
     1362           ,input-output p-chip-num
     1363           ,input-output p-corr-date
     1364           ,input-output p-corr-time
     1365            ).
     1366       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1367       delete buf_dis-card-property no-error .
     1368       if error-status:error then do:
     1369         return error return-value.
     1370       end.
     1371       p-deleted = yes.
     1372     end.
     1373   end.
     1374   end procedure.
     1375   procedure discprop-check :
     1376   define input parameter p-range  as integer no-undo .
     1377   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1378   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1379   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1380   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1381   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1382   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1383   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1384   define variable v-message as character no-undo .
     1385   define buffer buf_sysconf for ub.sysconf.
     1386   define buffer buf_clients for ub.clients.
     1387   define buffer buf_dis-card for ub.dis-card.
     1388   define buffer buf_attr-prop for ub.attr-prop.
     1389   do
     1390   on error undo, return error return-value
     1391   :
     1392     if p-host-code > 0 then do:
     1393       FIND FIRST buf_sysconf No-LOCK WHERE
     1394                 buf_sysconf.host-code = p-host-code No-ERROR.
     1395       IF NOT AVAIL buf_sysconf THEN DO:
     1396         v-message = substitute("Не найдена фирма &1", p-host-code).
     1397         RETURN ERROR v-message.
     1398       END.
     1399     end.
     1400     if p-obj-type <> "":U or
     1401         p-obj-code <> 0 then do:
     1402       find first buf_clients No-LOCK WHERE
     1403                 buf_clients.obj-type = p-obj-type AND
     1404                 buf_clients.obj-code = p-obj-code no-error .
     1405       if not available buf_clients then do:
     1406         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1407         RETURN ERROR v-message.
     1408       end.
     1409     end.
     1410     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1411       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1412                               , p-obj-type
     1413                               , p-obj-code
     1414                               , p-host-code).
     1415       RETURN ERROR v-message.
     1416     end.
     1417     if p-d-card <> "":U then do:
     1418       find first buf_dis-card No-LOCK WHERE
     1419                   buf_dis-card.d-card = p-d-card No-ERROR.
     1420       if not avail buf_dis-card then do:
     1421         v-message =substitute("Не найдена ДК").
     1422         return error  v-message.
     1423       end.
     1424       if buf_dis-card.emitent-host-code <> 0
     1425       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1426         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1427         return error v-message.
     1428       end.
     1429       if buf_dis-card.emitent-host-code = 0
     1430       and p-range = 1
     1431       and p-host-code <> 0 then do:
     1432         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1433                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1434                                 , chr(10)
     1435                               ).
     1436         return error v-message.
     1437       end.
     1438     end.
     1439   end.
     1440   end procedure.
     1441   define variable v-trg-param as character no-undo .
     1442   define variable v-run-hist as logical no-undo .
     1443   v-trg-param = ub.dis-card-property.trg-param.
     1444   ub.dis-card-property.trg-param = '':U.
     1445   define buffer locked_dis-card-property for ub.dis-card-property.
     1446   main-block:
     1447   do
     1448   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1449   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1450   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1451   :
     1452     if ub.dis-card-property.dtm-code > 0
     1453     and discprop-usercanedit ( input ub.dis-card-property.dtm-code, input g#db-num) = yes
     1454     then do:
     1455       Find first locked_dis-card-property exclusive-lock  where
     1456                 locked_dis-card-property.d-card    = ub.dis-card-property.d-card
     1457             AND locked_dis-card-property.dtm-code  = 0
     1458             no-error no-wait.
     1459       if locked locked_dis-card-property then do:
     1460         undo main-block, return error substitute("Свойство &1 для ДК &2 занято"
     1461                                                   , ub.dis-card-property.dtm-code
     1462                                                   , ub.dis-card-property.d-card
     1463                                                   ).
     1464       end.
     1465     end.
     1466     if lookup('no-hist':U, v-trg-param) = 0
     1467     and ub.dis-card-property.dtm-code > 0
     1468     then do:
     1469         assign
     1470         v-run-hist = yes
     1471         .
     1472     end.
     1473     if v-run-hist then do:
     1474       run disproph_write-dcp-trigger  in this-procedure  (
     1475                                            input no
     1476                                             ,input (if g#news
     1477                                                     then 'db':U
     1478                                                     else (if g#esys
     1479                                                           then 'esys':U
     1480                                                           else "":U)
     1481                                                     )
     1482                                             ,input  (if g#news
     1483                                                       then string(g#news-source-db)
     1484                                                       else (if g#esys
     1485                                                             then string(g#esys-source-esys)
     1486                                                             else "":U)
     1487                                                       )
     1488                                         ) .
     1489     end.
     1490     if lookup('no-callnews':U, v-trg-param) = 0
     1491     and ub.dis-card-property.dtm-code > 0
     1492     then do:
     1493       run nws/cmd-del.p
     1494         ( input 'dis-card-property':U
     1495         ,input (buffer ub.dis-card-property:handle)
     1496         ,input '':U
     1497         ) no-error .
     1498       if error-status :error then do:
     1499         undo, return error substitute( "&1. Ошибка при отправке в новости команды на удаление записи. &2&3&2&4", vss-workfile, chr(10), return-value, error-status :get-message ( error-status :num-messages ) ).
     1500       end.
     1501     end.
     1502     if g#oxml = yes
     1503     then do:
     1504       run str/calloxml.p (
     1505             input 'delete':U
     1506           , input 'dis-card-property':U
     1507           , input ( buffer ub.dis-card-property:handle )
     1508       ) no-error.
     1509       if error-status :error
     1510       then do:
     1511           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
     1512                                , chr(10)
     1513                                , vss-workfile
     1514                                , return-value
     1515                                , error-status :get-message ( 1 ) ).
     1516       end.
     1517     end.
     1518   end.
