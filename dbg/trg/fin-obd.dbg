        1   block-level on error undo, throw.
        2   TRIGGER PROCEDURE FOR DELETE OF ub.fin-ob .
        3   define variable  vss-revision    as character no-undo init "$Revision$":U .
        4   define variable  vss-author      as character no-undo init "$Author$":U .
        5   define variable  vss-date        as character no-undo init "$Date$":U .
        6   define variable  vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable  vss-archive     as character no-undo init "$Archive$":U .
        8   define variable  vss-description as character no-undo init "Триггер на yдаление финансового обязательства ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27       assign
       28         p-vss-parameters = substitute('&1|&2', ub.fin-ob.doc-code, ub.fin-ob.host-code)
       29       .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   main-block :
      307   do transaction
      308   on error undo main-block, return error
      309   :
      310   define buffer other_fin-ob        for ub.fin-ob.
      311   define buffer other_fin-ob-before for ub.fin-ob-before.
      312   define buffer other_fin-ob-trn    for ub.fin-ob-trn.
      313   define buffer buf_c-fin-ob        for ub.c-fin-ob.
      314   define variable v-trn-code as character no-undo .
      315   define variable v-fin-ob as character no-undo .
      316   define variable v-col-fin-ob as integer no-undo .
      317   define variable v-type-pay-orig  as character no-undo .
      318   define variable v-type-pay       as character no-undo .
      319   define variable v-pay as character no-undo .
      320   define variable v-ok as logical no-undo .
      321   define variable v-not-flag as logical no-undo .
      322   define variable v-galki as logical no-undo .
      323   define variable v-date as date no-undo .
      324   define variable v-time as integer no-undo .
      325   find first contract no-lock where  contract.contract-code = fin-ob.contract-code no-error .
      326   v-ok = true .
      327   v-not-flag = true .
      328   if available contract then do:
      329       if lookup ( contract.usl-opl , 'По факту поставки,Отсрочка платежа (по поставке)' ) > 0
      330         then
      331           assign
      332             v-type-pay-orig = "по поставке"
      333             v-pay = 'По факту поставки,Отсрочка платежа (по поставке)'
      334           .
      335         else
      336           assign
      337               v-type-pay-orig = "по реализации"
      338               v-pay = 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)'
      339           .
      340   end.
      341   for each fin-ob-trn no-lock where fin-ob-trn.doc-code  = fin-ob.doc-code
      342       on error undo, return error :
      343       v-trn-code = fin-ob-trn.trn-doc-code.
      344       v-fin-ob =  "" .
      345       v-col-fin-ob =  0 .
      346       if v-trn-code <> "" then do:
      347           for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code  = v-trn-code and
      348                                                   other_fin-ob-trn.doc-code      <> fin-ob.doc-code ,
      349               first other_fin-ob no-lock where other_fin-ob.doc-code  = other_fin-ob-trn.doc-code ,
      350                 first contract   no-lock where contract.contract-code = other_fin-ob.contract-code and
      351                                                lookup( contract.usl-opl , v-pay ) > 0
      352               on error undo, return error :
      353               v-fin-ob = v-fin-ob + " ФО " + string(other_fin-ob-trn.doc-code) + "," .
      354               v-col-fin-ob = v-col-fin-ob + 1.
      355           end.
      356       end.
      357       if v-pay = 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' then do:
      358           if v-trn-code <> "" then do:
      359           for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code  = v-trn-code and
      360                                                   other_fin-ob-trn.doc-code      <> fin-ob.doc-code ,
      361               first other_fin-ob-before no-lock where other_fin-ob-before.before-code  = other_fin-ob-trn.doc-code ,
      362                 first contract   no-lock where contract.contract-code = other_fin-ob-before.contract-code and
      363                                                lookup( contract.usl-opl , v-pay ) > 0
      364               on error undo, return error :
      365               v-fin-ob = v-fin-ob + "  ПФО " + string(other_fin-ob-trn.doc-code).
      366               v-col-fin-ob = v-col-fin-ob + 1.
      367           end.
      368          end.
      369       end.
      370       if v-col-fin-ob > 0 then
      371       message "Финансовое обязательство было создано по накладной  " v-trn-code skip
      372                "Тип оплаты : " v-type-pay-orig skip
      373                "По этой же накладной было одновременно создано еще : " v-col-fin-ob   skip
      374                "Вн. номера : " v-fin-ob                                     skip
      375                "По накладной ФО и ПФО автоматически генерируются один раз "  skip
      376                "   по одному типу оплаты (поставке или реализации)       "  skip
      377                " "                                                          skip  skip
      378                "( ДА  - удалить финансовое обязательство " fin-ob.doc-code " , "  skip
      379                "      без возможности повторной автоматической генерации по накладной "  skip
      380                " НЕТ - не удалять ) "
      381                view-as alert-box question
      382                buttons yes-no
      383                title "Вопрос"
      384                update v-ok
      385                .
      386   end.
      387   v-not-flag  = v-ok.
      388   if v-ok = false then   UNDO , RETURN ERROR.
      389   find first fin-connect NO-LOCK
      390     where fin-connect.host-code = fin-ob.host-code
      391       and fin-connect.fin-ob-code = fin-ob.doc-code
      392   no-error .
      393   if available fin-connect then do:
      394     MESSAGE
      395       "Нельзя удалять связанные фин. обязательства! Сначала удалите связь с платежем."
      396      VIEW-AS ALERT-BOX ERROR TITLE "Удаление невозможно!" .
      397      UNDO , RETURN ERROR.
      398   end.
      399   for each fin-ob-tax  exclusive-lock  where
      400       fin-ob-tax.doc-code  = fin-ob.doc-code  and
      401       fin-ob-tax.host-code = fin-ob.host-code
      402       on error undo main-block, return error
      403       :
      404          delete  fin-ob-tax.
      405   end.
      406   for each fin-ob-trn no-lock where
      407       fin-ob-trn.doc-code  = fin-ob.doc-code  and
      408       fin-ob-trn.host-code = fin-ob.host-code
      409       on error undo main-block, return error
      410       :
      411       for each trn-doc  exclusive-lock   where
      412          trn-doc.doc-code = fin-ob-trn.trn-doc-code
      413           on error undo main-block, return error  :
      414           v-galki = true .
      415               for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code =  fin-ob-trn.trn-doc-code and
      416                                                       other_fin-ob-trn.doc-code     <>  fin-ob-trn.doc-code ,
      417                   first other_fin-ob no-lock where other_fin-ob.doc-code  = other_fin-ob-trn.doc-code ,
      418                     first contract   no-lock where contract.contract-code = other_fin-ob.contract-code and
      419                                                   lookup( contract.usl-opl , v-pay ) > 0
      420                     on error undo, return error :
      421                     v-galki = false .
      422               end.
      423               for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code =  fin-ob-trn.trn-doc-code and
      424                                                       other_fin-ob-trn.doc-code     <>  fin-ob-trn.doc-code ,
      425                   first other_fin-ob-before no-lock where other_fin-ob-before.before-code  = other_fin-ob-trn.doc-code ,
      426                     first contract   no-lock where contract.contract-code = other_fin-ob-before.contract-code and
      427                                                   lookup( contract.usl-opl , v-pay ) > 0
      428                     on error undo, return error :
      429                     v-galki = false .
      430               end.
      431                 if v-galki = true  then do:
      432                     if v-pay = 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' then do:
      433                         assign
      434                             trn-doc.cr-expfo    = false
      435                             trn-doc.expfo-date  = 01/01/1990
      436                         no-error .
      437                     end.
      438                     else do:
      439                         assign
      440                             trn-doc.cr-incfo    = false
      441                             trn-doc.incfo-date  = 01/01/1990
      442                         no-error .
      443                     end.
      444                     if trn-doc.cr-expfo = false and
      445                        trn-doc.cr-incfo = false then do:
      446                       assign
      447                         trn-doc.cr-incorexpfo = false.
      448                     end.
      449                       if error-status :error then
      450                       message vss-workfile vss-revision vss-description skip
      451                           "Ошибка корректировки накладной" skip
      452                           error-status :get-message(1)
      453                           view-as alert-box information .
      454                 end.
      455       end.
      456       for each c-trn-doc  exclusive-lock   where
      457          c-trn-doc.doc-code = fin-ob-trn.trn-doc-code
      458           on error undo main-block, return error  :
      459           v-galki = true .
      460               for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code =  fin-ob-trn.trn-doc-code and
      461                                                       other_fin-ob-trn.doc-code     <>  fin-ob-trn.doc-code ,
      462                   first other_fin-ob no-lock where other_fin-ob.doc-code  = other_fin-ob-trn.doc-code ,
      463                     first contract   no-lock where contract.contract-code = other_fin-ob.contract-code and
      464                                                   lookup( contract.usl-opl , v-pay ) > 0
      465                     on error undo, return error :
      466                     v-galki = false .
      467               end.
      468               for each other_fin-ob-trn no-lock where other_fin-ob-trn.trn-doc-code =  fin-ob-trn.trn-doc-code and
      469                                                       other_fin-ob-trn.doc-code     <>  fin-ob-trn.doc-code ,
      470                   first other_fin-ob-before no-lock where other_fin-ob-before.before-code  = other_fin-ob-trn.doc-code ,
      471                     first contract   no-lock where contract.contract-code = other_fin-ob-before.contract-code and
      472                                                   lookup( contract.usl-opl , v-pay ) > 0
      473                     on error undo, return error :
      474                     v-galki = false .
      475               end.
      476                 if v-galki = true  then do:
      477                     if v-pay = 'По факту реализации,По реализации части приход. накладной,Отсрочка платежа (по реализации)' then do:
      478                         assign
      479                             c-trn-doc.cr-expfo    = false
      480                             c-trn-doc.expfo-date  = 01/01/1990
      481                         no-error .
      482                     end.
      483                     else do:
      484                         assign
      485                             c-trn-doc.cr-incfo    = false
      486                             c-trn-doc.incfo-date  = 01/01/1990
      487                         no-error .
      488                     end.
      489                     if c-trn-doc.cr-expfo = false and
      490                        c-trn-doc.cr-incfo = false then do:
      491                       assign
      492                         c-trn-doc.cr-incorexpfo = false.
      493                     end.
      494                       if error-status :error then
      495                       message vss-workfile vss-revision vss-description skip
      496                           "Ошибка корректировки накладной" skip
      497                           error-status :get-message(1)
      498                           view-as alert-box information .
      499                 end.
      500       end.
      501   end.
      502   for each fin-ob-trn  exclusive-lock  where
      503       fin-ob-trn.doc-code  = fin-ob.doc-code  and
      504       fin-ob-trn.host-code = fin-ob.host-code
      505       on error undo main-block, return error
      506       :
      507          delete  fin-ob-trn.
      508   end.
      509   for each fin-gds-part  exclusive-lock  where
      510       fin-gds-part.fin-ob-code  = fin-ob.doc-code  and
      511       fin-gds-part.host-code = fin-ob.host-code
      512       on error undo main-block, return error
      513       :
      514          delete  fin-gds-part.
      515   end.
      516   for each fin-ob-before  exclusive-lock  where
      517       fin-ob-before.doc-code  = fin-ob.doc-code  and
      518       fin-ob-before.host-code = fin-ob.host-code
      519       on error undo main-block, return error
      520       :
      521          assign
      522            fin-ob-before.status_= 'новый':U
      523            fin-ob-before.doc-code = ""       .
      524   end.
      525       if fin-ob.status_ = 'факт':U then
      526         run str/calc-bal.p (input "finob", input no, input fin-ob.doc-type, input fin-ob.host-code, input fin-ob.contract-code, input fin-ob.sum-contract, input fin-ob.sum-rubl, input fin-ob.sum-base) .
      527       run cur-time in this-procedure(output v-date, output v-time).
      528       create buf_c-fin-ob.
      529       buffer-copy fin-ob to buf_c-fin-ob
      530       assign
      531       buf_c-fin-ob.chip-num           = next-value (s-corr-chip, ub)
      532       buf_c-fin-ob.corr-time          = v-time
      533       buf_c-fin-ob.corr-user-db-num   = g#db-num
      534       buf_c-fin-ob.corr-user-name     = g#userid
      535       buf_c-fin-ob.corr-date          = v-date
      536       buf_c-fin-ob.is-doc-del         = true
      537       .
      538       if fin-ob.status_ = 'факт':U then  buf_c-fin-ob.is-del  = true .
      539       if g#oxml = yes
      540       then do:
      541       run str/calloxml.p (
      542             input 'delete':U
      543           , input 'fin-ob':U
      544           , input ( buffer ub.fin-ob:handle )
      545       ) no-error.
      546       if error-status :error
      547       then do:
      548           undo, return error substitute( "&2&1Ошибка при отправке в систему OpenXML команды на удаление записи&1&3&1&4"
      549                               , chr(10)
      550                               , vss-workfile
      551                               , return-value
      552                               , error-status :get-message ( 1 ) ).
      553       end.
      554       end.
      555   end.
