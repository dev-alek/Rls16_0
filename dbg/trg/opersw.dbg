        1   block-level on error undo, throw.
        2   trigger procedure for write of ub.OperServ
        3     new buffer new-OperServ
        4     old buffer old-OperServ
        5   .
        6   define variable vss-revision    as character no-undo initial "$Revision$":U .
        7   define variable vss-author      as character no-undo initial "$Author$":U .
        8   define variable vss-date        as character no-undo initial "$Date$":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       10   define variable vss-archive     as character no-undo initial "$Archive$":U .
       11   define variable vss-description as character no-undo init "Тригер изменение OperServ".
       12   if new-OperServ.gds-code eq 0
       13   then
       14      new-OperServ.gds-code = ?.
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   procedure cur-time :
       86      define output parameter p-today as date      no-undo .
       87      define output parameter p-time  as integer   no-undo .
       88     do
       89     on error undo, return error
       90     :
       91       define variable v-date1 as date      no-undo .
       92       define variable v-date2 as date      no-undo .
       93       define variable v-time  as integer   no-undo .
       94       assign
       95         v-date1 = today
       96         v-time  = time
       97         v-date2 = today
       98       .
       99       if v-date1 <> v-date2
      100       then do:
      101         assign
      102           v-date1 = today
      103           v-time  = v-time
      104         .
      105       end.
      106       assign
      107         p-today = v-date1
      108         p-time  = v-time
      109       .
      110     end.
      111   end.
      112   function cur-time-date returns character
      113   :
      114     return string(today, '99/99/9999':U) .
      115   end.
      116   function cur-time-mjd returns decimal
      117   :
      118     define variable v-date as date      no-undo .
      119     define variable v-time as integer   no-undo .
      120     run cur-time in this-procedure
      121       (output v-date
      122       ,output v-time
      123       ) .
      124     return integer(v-date) - 2400002 + (v-time / 86400) .
      125   end.
      126   function cur-time-get-ending-index returns integer
      127   (input p-number as integer
      128   )
      129   :
      130     if p-number < 0
      131     or p-number = ?
      132     then do:
      133       return 1 .
      134     end.
      135     define variable v-rest as integer   no-undo .
      136     assign
      137       p-number = p-number modulo 100
      138     .
      139     if p-number < 20
      140     then do:
      141       assign
      142         v-rest = p-number
      143       .
      144     end.
      145     else do:
      146       assign
      147         v-rest = p-number modulo 10
      148       .
      149     end.
      150     case v-rest :
      151       when 1
      152       then do:
      153         return 2 .
      154       end.
      155       when 2 or
      156       when 3 or
      157       when 4
      158       then do:
      159         return 3 .
      160       end.
      161       otherwise do:
      162         return 1 .
      163       end.
      164     end case .
      165   end.
      166   procedure cur-time-mjd-to-date :
      167      define input  parameter i-mjd-diff as decimal no-undo.
      168      define output parameter o-Date     as date    no-undo.
      169      define output parameter o-Time     as integer no-undo.
      170      define variable v-day-number as integer   no-undo .
      171      if    i-mjd-diff < 0
      172         or i-mjd-diff = ?
      173      then do:
      174         return "?" .
      175      end.
      176      assign
      177         v-day-number = truncate(i-mjd-diff,0).
      178         o-Date = date(v-day-number + 2400002).
      179         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      180     .
      181   end.
      182   function cur-time-mjd-to-string returns character
      183   (input p-mjd-diff as decimal
      184   )
      185   :
      186     define variable v-day-number as integer   no-undo .
      187     define variable v-seconds    as integer   no-undo .
      188     define variable v-hour       as integer   no-undo .
      189     define variable v-min        as integer   no-undo .
      190     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      191     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      192     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      193     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      194     if p-mjd-diff < 0
      195     or p-mjd-diff = ?
      196     then do:
      197       return "?" .
      198     end.
      199     assign
      200       v-day-number = integer(truncate(p-mjd-diff,0))
      201       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      202     .
      203     if v-seconds > 86400
      204     then do:
      205       assign
      206         v-seconds = 86400 - 1
      207       .
      208     end.
      209     if v-seconds < 0
      210     then do:
      211       assign
      212         v-seconds = 0
      213       .
      214     end.
      215     assign
      216       v-hour = truncate(v-seconds / 3600, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 3600
      220     .
      221     assign
      222       v-min = truncate(v-seconds / 60, 0)
      223     .
      224     assign
      225       v-seconds = v-seconds modulo 60
      226     .
      227     return
      228         (if v-day-number <> 0
      229           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0
      233           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      237           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      238           else ""
      239         )
      240       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      241       .
      242   end.
      243   function cur-time-string returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      252   end.
      253   function cur-time-string-sec returns character
      254   :
      255     define variable v-date as date      no-undo .
      256     define variable v-time as integer   no-undo .
      257     run cur-time in this-procedure
      258       (output v-date
      259       ,output v-time
      260       ) .
      261     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      262   end.
      263   function cur-time-custom  returns character
      264   (input p-prefix as character
      265   ,input p-date-format as character
      266   ,input p-delimiter as character
      267   ,input p-time-format as character
      268   ,input p-suffix as character
      269   )
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return
      278       p-prefix
      279       + string(v-date, p-date-format)
      280       + p-delimiter
      281       + string(v-time, p-time-format)
      282       + p-suffix
      283       .
      284   end.
      285   function cur-time-print  returns character
      286   :
      287     define variable v-date as date      no-undo .
      288     define variable v-time as integer   no-undo .
      289     run cur-time in this-procedure
      290       (output v-date
      291       ,output v-time
      292       ) .
      293     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      294   end.
      295   function cur-time-datetime returns datetime
      296   :
      297     define variable v-char as character no-undo .
      298     define variable v-datetime as datetime no-undo .
      299     v-char = cur-time-string().
      300     v-datetime = datetime(v-char).
      301     return  v-datetime.
      302   end.
      303   function cur-time-string-msec returns character
      304   :
      305     define variable v-date as datetime  no-undo .
      306     v-date = now.
      307     return string(v-date) .
      308   end.
      309   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   procedure gen-key-rec :
      311     define input  parameter p-tbl-name    as character no-undo.
      312     define input  parameter p-bh_tbl-name as handle    no-undo.
      313     define output parameter p-key-rec     as character no-undo.
      314     do
      315     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      316     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      317     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      318     :
      319       define variable fh               as handle    no-undo .
      320       define variable v-ok             as logical   no-undo .
      321       define variable v-inform         as character no-undo .
      322       define variable v-ind            as integer   no-undo .
      323       define variable v-idx-field-qnty as integer   no-undo .
      324       if p-tbl-name = ?
      325         or p-tbl-name = "":U
      326       then do:
      327         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      328       end.
      329       if not p-bh_tbl-name:available then do:
      330         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      331       end.
      332       assign
      333         p-key-rec = p-tbl-name
      334         v-inform  = p-bh_tbl-name:index-information(1)
      335         v-ind     = 2
      336       .
      337       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      338       on error undo, return error
      339       :
      340         assign
      341           v-inform = p-bh_tbl-name:index-information( v-ind )
      342           v-ind    = v-ind + 1
      343         .
      344       end.
      345       if v-inform = ?
      346         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      347         or entry( 3, v-inform, ",":U ) <> "1":U
      348       then do:
      349         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      350       end.
      351       else do:
      352         assign
      353           v-idx-field-qnty = num-entries( v-inform ) - 4
      354         .
      355         if v-idx-field-qnty < 2 then do:
      356           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      357         end.
      358         do v-ind = 1 to v-idx-field-qnty by 2
      359         on error undo, return error
      360         :
      361           assign
      362             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      363             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      364           .
      365         end.
      366       end.
      367       if p-key-rec = ? then do:
      368         assign
      369           p-key-rec = "":U
      370         .
      371         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      372       end.
      373     end.
      374     return.
      375   end procedure.
      376   procedure gen-where-keyr-tab :
      377     define input  parameter i-tableSerach as character no-undo.
      378     define input  parameter i-tablekey   as character  no-undo.
      379     define input  parameter p-key-rec    as character  no-undo.
      380     define input  parameter p-key-handle as handle     no-undo .
      381     define input  parameter p-db-name    as character  no-undo .
      382     define input  parameter p-tt-handle  as handle     no-undo .
      383     define output parameter o-Where      as character  no-undo.
      384     do
      385     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      386     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      387     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      388     :
      389       define variable v-full-tbl-name  as character no-undo .
      390       define variable bh_tbl-name      as handle    no-undo .
      391       define variable fh_key           as handle    no-undo .
      392       define variable fh_search        as handle    no-undo .
      393       define variable v-field-num      as integer   no-undo .
      394       define variable v-count-fld      as integer   no-undo .
      395       define variable v-inform         as character no-undo .
      396       define variable v-ind            as integer   no-undo .
      397       define variable v-idx-field-qnty as integer   no-undo .
      398       define variable v-field-name     as character no-undo .
      399       define variable v-field-val      as character no-undo .
      400       define variable v-word-link      as character no-undo .
      401       define variable vTable           as character no-undo.
      402       define variable bh_tbl-key       as handle    no-undo .
      403       assign
      404         p-key-rec = trim( p-key-rec )
      405       .
      406       if p-key-handle <> ? then do:
      407         if not valid-handle(p-key-handle)
      408            or p-key-handle:type <> "buffer"
      409         then do:
      410           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      411         end.
      412         if num-entries( p-key-rec, chr(3) ) > 1
      413           or p-key-rec = ?
      414           or p-key-rec = "":U
      415         then do:
      416           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      417         end.
      418       end.
      419       else do:
      420         if p-key-rec = ?
      421           or p-key-rec = "":U
      422         then do:
      423           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      424         end.
      425       end.
      426       assign
      427         vTable = entry( 1 , p-key-rec, chr(3) )
      428       .
      429       if p-tt-handle <> ?
      430         and ( not valid-handle(p-tt-handle)
      431               or p-tt-handle:type <> "buffer"
      432             )
      433       then do:
      434         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      435       end.
      436       if p-tt-handle = ? then do:
      437         assign
      438           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      439         .
      440         create buffer bh_tbl-name for table v-full-tbl-name .
      441       end.
      442       else do:
      443         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      444       end.
      445       assign
      446         v-inform = bh_tbl-name:index-information(1)
      447         v-ind    = 2
      448       .
      449       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      450       on error undo, return error
      451       :
      452         assign
      453           v-inform = bh_tbl-name:index-information( v-ind )
      454           v-ind    = v-ind + 1
      455         .
      456       end.
      457       if v-inform = ?
      458         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      459         or entry( 3, v-inform, ",":U ) <> "1":U
      460       then do:
      461         delete object bh_tbl-name no-error.
      462         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      463       end.
      464       assign
      465         v-idx-field-qnty = num-entries( v-inform ) - 4
      466       .
      467       if v-idx-field-qnty < 2 then do:
      468         delete object bh_tbl-name no-error.
      469         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      470       end.
      471       assign
      472         o-where     = "where":U
      473         v-word-link = "":U
      474         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      475         v-count-fld = 0
      476       .
      477       if i-tablekey ne "" and i-tablekey ne ?
      478       then do:
      479         assign
      480           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      481         .
      482         create buffer bh_tbl-key for table v-full-tbl-name .
      483       end.
      484       if i-tableSerach ne "" and i-tableSerach ne ?
      485       then do:
      486         delete object bh_tbl-name no-error.
      487         assign
      488           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      489         .
      490         create buffer bh_tbl-name for table v-full-tbl-name .
      491       end.
      492       block_where:
      493       do v-ind = 1 to v-idx-field-qnty by 2
      494       on error undo, return error
      495       :
      496         assign
      497           v-count-fld = v-count-fld + 1
      498         .
      499         if p-key-handle = ?
      500           and v-count-fld > v-field-num
      501         then do:
      502           leave block_where.
      503         end.
      504         define variable VfieldKeyTable as handle no-undo.
      505         assign
      506           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      507           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      508         .
      509         if     bh_tbl-key ne ?
      510         then do:
      511            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      512            if VfieldKeyTable eq ?
      513            then next block_where.
      514         end.
      515         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      516         then
      517            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      518         else
      519            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      520         if p-key-handle = ? then do:
      521           assign
      522             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      523           .
      524         end.
      525         else do:
      526           assign
      527             fh_key = p-key-handle:buffer-field( v-field-name )
      528           .
      529           if fh_key = ?
      530             or not valid-handle( fh_key )
      531           then do:
      532             delete object bh_tbl-name.
      533             if     bh_tbl-key ne ?
      534             then
      535                delete object bh_tbl-key.
      536             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      537           end.
      538           assign
      539             v-field-val = fh_key:buffer-value
      540           .
      541         end.
      542         if fh_search:data-type ="character":U then do:
      543           assign
      544             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      545             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      546             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      547             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      548             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      549             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      550             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      551             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      552             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      553             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      554             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      555             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      556             v-field-val = substitute( '"&1"', v-field-val )
      557           .
      558         end.
      559         assign
      560           o-where = substitute( "&1 &2", o-where, v-field-val )
      561         .
      562         if v-word-link = "":U then do:
      563           assign
      564             v-word-link = "and":U
      565           .
      566         end.
      567       end.
      568       delete object bh_tbl-name.
      569       if     bh_tbl-key ne ?
      570       then
      571          delete object bh_tbl-key.
      572       if p-key-handle = ?
      573         and v-count-fld <> v-field-num
      574       then do:
      575         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      576       end.
      577     end.
      578   end procedure.
      579   procedure gen-hn-keyr-tab :
      580     define input  parameter i-tableSerach as character no-undo.
      581     define input  parameter i-tablekey   as character no-undo.
      582     define input  parameter p-key-rec    as character no-undo.
      583     define input  parameter p-key-handle as handle    no-undo .
      584     define input  parameter p-db-name    as character no-undo .
      585     define input  parameter p-tt-handle  as handle    no-undo .
      586     define input  parameter p-stts-lock  as integer   no-undo .
      587     define output parameter o-hn         as handle    no-undo.
      588     define variable v-full-tbl-name as character no-undo.
      589     define variable v-where         as character no-undo.
      590     define variable bh_tbl-name     as handle    no-undo.
      591     define variable vTable          as character no-undo.
      592     do
      593     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      594     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      595     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      596         run gen-where-keyr-tab(i-tableSerach,
      597                                i-tablekey,
      598                                p-key-rec,
      599                                p-key-handle,
      600                                p-db-name,
      601                                p-tt-handle,
      602                                output v-where).
      603         if i-tableSerach ne "" and i-tableSerach ne ?
      604         then do:
      605            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      606            create buffer bh_tbl-name for table v-full-tbl-name .
      607         end.
      608         else do:
      609            if p-tt-handle = ? then do:
      610               assign
      611                  vTable = entry( 1 , p-key-rec, chr(3) )
      612               .
      613               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      614               create buffer bh_tbl-name for table v-full-tbl-name .
      615            end.
      616            else do:
      617               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      618            end.
      619         end.
      620         if p-tt-handle = ? then do:
      621            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      622         end.
      623         else do:
      624            bh_tbl-name:find-first( v-where ) no-error .
      625         end.
      626         o-hn = bh_tbl-name.
      627      end.
      628   end procedure.
      629   procedure gen-hn-keyr :
      630     define input  parameter p-key-rec    as character no-undo.
      631     define input  parameter p-key-handle as handle    no-undo .
      632     define input  parameter p-db-name    as character no-undo .
      633     define input  parameter p-tt-handle  as handle    no-undo .
      634     define input  parameter p-stts-lock  as integer   no-undo .
      635     define output parameter o-hn         as handle    no-undo.
      636     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      637   end.
      638   procedure gen-row-keyr :
      639     define input  parameter p-key-rec    as character no-undo.
      640     define input  parameter p-key-handle as handle    no-undo .
      641     define input  parameter p-db-name    as character no-undo .
      642     define input  parameter p-tt-handle  as handle    no-undo .
      643     define input  parameter p-stts-lock  as integer   no-undo .
      644     define output parameter p-tbl-row    as rowid     no-undo.
      645     define output parameter p-tbl-name   as character no-undo.
      646     define variable vHn as handle no-undo.
      647       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      648       p-tbl-row = if vHn:available then vHn:rowid else ?.
      649       p-tbl-name =  vHn:table.
      650       delete object vHn no-error.
      651     if p-tbl-row = ? then do:
      652       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      653     end.
      654     else do:
      655       return.
      656     end.
      657   end procedure.
      658   procedure gen-key-fv :
      659     define input  parameter p-key-rec    as character no-undo .
      660     define output parameter p-field-list as character no-undo .
      661     define output parameter p-value-list as character no-undo.
      662     do
      663     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      664     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      665     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      666     :
      667       define variable v-full-tbl-name  as character no-undo .
      668       define variable bh_tbl-name      as handle    no-undo .
      669       define variable v-tbl-name       as character no-undo .
      670       define variable v-field-num      as integer   no-undo .
      671       define variable v-count-fld      as integer   no-undo .
      672       define variable v-inform         as character no-undo .
      673       define variable v-ind            as integer   no-undo .
      674       define variable v-idx-field-qnty as integer   no-undo .
      675       define variable v-delim-key      as character no-undo .
      676       if p-key-rec = ?
      677         or p-key-rec = "":U
      678       then do:
      679         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      680       end.
      681       assign
      682         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      683         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      684       .
      685       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      686       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      687       assign
      688         v-inform = bh_tbl-name:index-information(1)
      689         v-ind    = 2
      690       .
      691       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      692       on error undo, return error
      693       :
      694         assign
      695           v-inform = bh_tbl-name:index-information( v-ind )
      696           v-ind    = v-ind + 1
      697         .
      698       end.
      699       if v-inform = ?
      700         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      701         or entry( 3, v-inform, ",":U ) <> "1":U
      702       then do:
      703         delete object bh_tbl-name no-error.
      704         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      705       end.
      706       assign
      707         v-idx-field-qnty = num-entries( v-inform ) - 4
      708       .
      709       if v-idx-field-qnty < 2 then do:
      710         delete object bh_tbl-name no-error.
      711         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      712       end.
      713       assign
      714         p-field-list = "":U
      715         p-value-list = "":U
      716         v-delim-key  = "":U
      717         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      718         v-count-fld  = 0
      719       .
      720       block_where:
      721       do v-ind = 1 to v-idx-field-qnty by 2
      722       on error undo, return error
      723       :
      724         assign
      725           v-count-fld = v-count-fld + 1
      726         .
      727         if v-count-fld > v-field-num then do:
      728           leave block_where.
      729         end.
      730         assign
      731           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      732           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      733         .
      734         if v-ind = 1 then do:
      735           assign
      736             v-delim-key = chr(3)
      737           .
      738         end.
      739       end.
      740       delete object bh_tbl-name.
      741       if v-count-fld <> v-field-num then do:
      742         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      743       end.
      744     end.
      745   end procedure.
      746   procedure gen-key-field :
      747     define input  parameter p-table      as character no-undo .
      748     define output parameter p-field-list as character no-undo .
      749     do
      750     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      751     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      752     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      753     :
      754       define variable v-full-tbl-name  as character no-undo .
      755       define variable bh_tbl-name      as handle    no-undo .
      756       define variable v-tbl-name       as character no-undo .
      757       define variable v-field-num      as integer   no-undo .
      758       define variable v-count-fld      as integer   no-undo .
      759       define variable v-inform         as character no-undo .
      760       define variable v-ind            as integer   no-undo .
      761       define variable v-idx-field-qnty as integer   no-undo .
      762       define variable v-delim-key      as character no-undo .
      763       if p-table = ?
      764         or p-table = "":U
      765       then do:
      766         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      767       end.
      768       assign
      769         v-tbl-name      = p-table
      770         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      771       .
      772       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      773       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      774       assign
      775         v-inform = bh_tbl-name:index-information(1)
      776         v-ind    = 2
      777       .
      778       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      779       on error undo, return error
      780       :
      781         assign
      782           v-inform = bh_tbl-name:index-information( v-ind )
      783           v-ind    = v-ind + 1
      784         .
      785       end.
      786       if v-inform = ?
      787         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      788         or entry( 3, v-inform, ",":U ) <> "1":U
      789       then do:
      790         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      791       end.
      792       assign
      793         v-idx-field-qnty = num-entries( v-inform ) - 4
      794       .
      795       if v-idx-field-qnty < 2 then do:
      796         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      797       end.
      798       assign
      799         p-field-list = "":U
      800         v-delim-key  = "":U
      801         v-count-fld  = 0
      802       .
      803       block_where:
      804       do v-ind = 1 to v-idx-field-qnty by 2
      805       on error undo, return error
      806       :
      807         assign
      808           v-count-fld = v-count-fld + 1
      809         .
      810         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      811         if v-ind = 1 then do:
      812           assign
      813             v-delim-key = chr(3)
      814           .
      815         end.
      816       end.
      817       delete object bh_tbl-name.
      818     end.
      819   end procedure.
      820   define buffer buf_c-OperServ  for ub.c-OperServ .
      821   define variable v-date      as date      no-undo .
      822   define variable v-time      as integer   no-undo .
      823   define variable v-field-chg as character no-undo .
      824   define variable v-Seq       as int64     no-undo init ?.
      825   define variable vFlagseq    as logical no-undo.
      826   define variable vuniq-key-rec as character no-undo.
      827   define variable v-rowid as rowid no-undo.
      828   define variable v-tbl-name as character no-undo.
      829         buffer-compare new-OperServ to old-OperServ case-sensitive save result in v-field-chg.
      830         if v-field-chg > "":U then . else return .
      831         run cur-time in this-procedure (output v-date, output v-time).
      832       publish "getNextseq" ("OperServ","s-c-OperServ-chip-num", "ub", output v-Seq ).
      833       if v-Seq = ?
      834       then
      835          v-Seq  = next-value (s-c-OperServ-chip-num, ub).
      836       else
      837          vFlagSeq = yes.
      838       if vFlagSeq
      839       then do:
      840                        if new(new-OperServ)
      841          then do:
      842    for first buf_c-OperServ where buf_c-OperServ.id eq new-OperServ.id
      843     and buf_c-OperServ.corr-user-db-num   = g#db-num and buf_c-OperServ.chip-num = v-Seq exclusive-lock: leave. end.
      844          end.
      845          else do:
      846    for first buf_c-OperServ where buf_c-OperServ.id eq old-OperServ.id
      847     and buf_c-OperServ.corr-user-db-num   = g#db-num and buf_c-OperServ.chip-num = v-Seq exclusive-lock: leave. end.
      848          end.
      849       end.
      850      if new(new-OperServ)
      851      then do:
      852         if not available buf_c-OperServ
      853         then do:
      854            create buf_c-OperServ.
      855         buffer-copy new-OperServ to buf_c-OperServ
      856         assign
      857            buf_c-OperServ.chip-num           = v-Seq
      858            buf_c-OperServ.corr-date          = v-date
      859            buf_c-OperServ.corr-time          = v-time
      860            buf_c-OperServ.corr-user-db-num   = g#db-num
      861            buf_c-OperServ.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
      862            buf_c-OperServ.action             = 1
      863            buf_c-OperServ.is-del             = false
      864         .
      865         end.
      866         else
      867            if buf_c-OperServ.action eq 99
      868            then
      869               buf_c-OperServ.action = 2.
      870      end.
      871      else do:
      872         if not available buf_c-OperServ
      873         then do:
      874            create buf_c-OperServ.
      875            buffer-copy old-OperServ to buf_c-OperServ
      876            assign
      877               buf_c-OperServ.chip-num           = v-Seq
      878               buf_c-OperServ.corr-date          = v-date
      879               buf_c-OperServ.corr-time          = v-time
      880               buf_c-OperServ.corr-user-db-num   = g#db-num
      881               buf_c-OperServ.corr-user-name     = (if g#news then (chr(4) +  'СПН':U) + " " else "") + g#userid
      882               buf_c-OperServ.action             = 2 when buf_c-OperServ.action ne 1
      883               buf_c-OperServ.is-del             = false
      884            .
      885         end.
      886      end.
      887     if not g#news then do :
      888          define variable mCompare as logical no-undo.
      889          if     available old-OperServ
      890             and not new(new-OperServ)
      891          then do:
      892             buffer-compare new-OperServ
      893                   using id
      894                   to old-OperServ
      895                   case-sensitive
      896                   save result in mCompare .
      897             if not mCompare
      898             then do:
      899                run nws/cmd-del.p
      900                    ( input 'OperServ':U
      901                     ,input (buffer old-OperServ:handle)
      902                     ,input "":U
      903                    ) no-error .
      904                if error-status :error then do:
      905                   message
      906                      vss-workfile vss-revision vss-description skip
      907                      "Невозможно маршрутизировать удаление OperServ для отправки в новости" skip
      908                      error-status :get-message(1) skip
      909                      return-value skip
      910                      view-as alert-box error .
      911                   undo , return error return-value .
      912                end.
      913             end.
      914          end.
      915        run str/callnews.p
      916         (input 'OperServ':U
      917         ,input (buffer ub.new-OperServ:handle)
      918         ) no-error.
      919       if error-status :error then do:
      920         message
      921           vss-workfile vss-revision vss-description skip
      922           "Невозможно маршрутизировать OperServ для отправки в новости" skip
      923           error-status :get-message(1) skip
      924           return-value skip
      925           view-as alert-box error .
      926         undo , return error return-value .
      927       end.
      928       end.
