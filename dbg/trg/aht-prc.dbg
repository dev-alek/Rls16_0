     1421           ,output slt-rubl-sale-prl
     1422           ,output road-tax-base-sale-prl
     1423           ,output road-tax-rubl-sale-prl
     1424           ,output excise-base-sale-prl
     1425           ,output excise-rubl-sale-prl
     1426           ,output discnt-base-sale-prl
     1427           ,output discnt-rubl-sale-prl
     1428           ) no-error .
     1429         if error-status :error
