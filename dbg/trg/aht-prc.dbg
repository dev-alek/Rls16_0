     2839          and out-vatp_doc-lineprl.artic      = varartic
     2840          and out-vatp_doc-lineprl.prod-type  = varprod-type
     2841          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     2842   if available out-vatp_doc-lineprl           and
     2843     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     2844     assign
