     6383   procedure show-action :
     6384     do
     6385     on error undo, return error
     6386     :
     6387       define input parameter p-action as character no-undo .
     6388       define variable v-today as date      no-undo.
     6389       define variable v-time  as integer   no-undo.
     6390       run cur-time in this-procedure ( output v-today
     6391                                      , output v-time
     6392                                      ).
     6393       assign
     6394         v-current-time = string(v-time - v-start-time, "HH:MM:SS")
     6395         v-current-action = p-action
     6396       .
     6397       if mFrameView
     6398       then display
     6399         v-current-time
     6400         v-current-action
     6401         with frame a .
     6402     end.
     6403   end procedure.
