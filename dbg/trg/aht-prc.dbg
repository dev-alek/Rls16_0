     5181     ,input  bf_trn-doc.fact-order
     5182     ,output vardoc-num
     5183     ,output varprice-sale
     5184     ,output varroad-tax
     5185     ,output varexcise
     5186     ,output varcur-vat-pc
     5187     ,output varcur-slt-pc
