     3408   procedure aht_add-document :
     3409     define input  parameter p-doc-code     like ub.aht-doc.doc-code     no-undo .
     3410     define input  parameter p-obj-type     like ub.aht-doc.obj-type     no-undo .
     3411     define input  parameter p-obj-code     like ub.aht-doc.obj-code     no-undo .
     3412     define input  parameter p-ext-doc-type like ub.aht-doc.ext-doc-type no-undo .
     3413     define input  parameter p-is-trn-doc   like ub.aht-doc.is-trn-doc   no-undo .
     3414     define input  parameter p-fact-order   like ub.aht-doc.fact-order   no-undo .
     3415     define input  parameter p-fact-date    like ub.aht-doc.fact-date    no-undo .
     3416     define input  parameter p-shift-date   like ub.aht-doc.shift-date   no-undo .
     3417     define input  parameter p-shift-num    like ub.aht-doc.shift-num    no-undo .
     3418     define buffer buf_aht-doc for ub.aht-doc .
     3419     do
     3420     on error undo, return error return-value
     3421     :
     3422       find first buf_aht-doc exclusive-lock
     3423         where buf_aht-doc.doc-code = p-doc-code
     3424         no-error .
     3425       if available buf_aht-doc then do:
     3426         message
     3427           vss-workfile vss-revision vss-description skip
     3428           vss-include-info26 skip
     3429           "Попытка повторного создания записи" skip
     3430           "Документ" p-doc-code skip
     3431           view-as alert-box error .
     3432         undo, return error .
     3433       end.
     3434       if p-fact-order = ?
     3435       or p-fact-order = 0
     3436       then do:
     3437         message
     3438           vss-workfile vss-revision vss-description skip
     3439           vss-include-info26 skip
     3440           "Ошибка задания входных параметров" skip
     3441           "Не задан номер документа" skip
     3442           "Документ" p-doc-code skip
     3443           "Номер документа" p-fact-order skip
     3444           view-as alert-box error .
     3445         undo, return error .
     3446       end.
     3447       create buf_aht-doc .
     3448       assign
     3449         buf_aht-doc.doc-code     = p-doc-code
     3450         buf_aht-doc.obj-type     = p-obj-type
     3451         buf_aht-doc.obj-code     = p-obj-code
     3452         buf_aht-doc.ext-doc-type = p-ext-doc-type
     3453         buf_aht-doc.is-trn-doc   = p-is-trn-doc
     3454         buf_aht-doc.fact-order   = p-fact-order
     3455         buf_aht-doc.fact-date    = p-fact-date
     3456         buf_aht-doc.shift-date   = p-shift-date
     3457         buf_aht-doc.shift-num    = p-shift-num
     3458       .
     3459     end.
     3460   end procedure.
     3461   procedure aht_add-date :
     3462     define input  parameter p-obj-type     like ub.aht-stk.obj-type     no-undo .
     3463     define input  parameter p-obj-code     like ub.aht-stk.obj-code     no-undo .
     3464     define input  parameter p-stk-type     like ub.aht-stk.stk-type     no-undo .
     3465     define input  parameter p-fact-order   like ub.aht-stk.fact-order   no-undo .
     3466     define input  parameter p-fact-date    like ub.aht-stk.fact-date    no-undo .
     3467     define input  parameter p-shift-date   like ub.aht-stk.shift-date   no-undo .
     3468     define input  parameter p-shift-num    like ub.aht-stk.shift-num    no-undo .
     3469     define buffer buf_aht-stk for ub.aht-stk .
     3470     do
     3471     on error undo, return error return-value
     3472     :
     3473       find first buf_aht-stk no-lock
     3474         where buf_aht-stk.obj-type   = p-obj-type
     3475           and buf_aht-stk.obj-code   = p-obj-code
     3476           and buf_aht-stk.stk-type   = p-stk-type
     3477           and buf_aht-stk.fact-order = p-fact-order
     3478         no-error .
     3479       if not available buf_aht-stk then do:
     3480         create buf_aht-stk .
     3481         assign
     3482           buf_aht-stk.obj-type   = p-obj-type
     3483           buf_aht-stk.obj-code   = p-obj-code
     3484           buf_aht-stk.stk-type   = p-stk-type
     3485           buf_aht-stk.fact-order = p-fact-order
     3486           buf_aht-stk.fact-date  = p-fact-date
     3487           buf_aht-stk.shift-date = p-shift-date
     3488           buf_aht-stk.shift-num  = p-shift-num
     3489         .
     3490       end.
     3491     end.
     3492   end procedure.
