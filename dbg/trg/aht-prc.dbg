     1641         end.
     1642     end.
     1643   end procedure.
     1644   procedure prdoclib-calc-prc :
     1645     define input  parameter p-price-doc-recid as   recid                  no-undo.
     1646     define input  parameter p-cons-pay        as   integer                no-undo.
     1647     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     1648     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     1649     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     1650     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     1651     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     1652     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     1653     do
     1654     on error undo, return error return-value
     1655     :
     1656       define buffer buf_price-doc       for ub.price-doc .
     1657       define buffer buf_price-list      for ub.price-list .
     1658       define buffer buf_parts           for ub.parts .
     1659       define variable v-ov-qnty     as decimal   no-undo .
     1660       define variable v-ov-base     as decimal   no-undo .
     1661       define variable v-ov-VAT-base as decimal   no-undo .
     1662       define variable v-ov-SLT-base as decimal   no-undo .
     1663       define variable v-cons-qnty   as decimal   no-undo .
     1664       define variable v-prch-qnty   as decimal   no-undo .
     1665       define variable v-cons-mult   as decimal   no-undo .
     1666       define variable v-prch-mult   as decimal   no-undo .
     1667       find first buf_price-doc no-lock
     1668         where recid(buf_price-doc) = p-price-doc-recid
     1669         no-error .
     1670       if not available buf_price-doc
     1671       then do:
     1672         message
     1673           vss-workfile vss-revision vss-description skip
     1674           vss-include-info4 skip
     1675           "Ошибка задания входных параметров" skip
     1676           "Не найден документ переоценки" skip
     1677           "Код записи (recid)" p-price-doc-recid skip
     1678           view-as alert-box error .
     1679         undo, return error .
     1680       end.
     1681       for each buf_price-list no-lock
     1682         where buf_price-list.doc-num    = buf_price-doc.doc-num
     1683           and buf_price-list.main-price = true
     1684       on error undo, return error return-value
     1685       :
     1686         run prdoclib-calc-ov
     1687           (input recid(buf_price-list)
     1688           ,output v-ov-qnty
     1689           ,output v-ov-base
     1690           ,output v-ov-VAT-base
     1691           ,output v-ov-SLT-base
     1692           ) no-error .
     1693         if error-status :error
     1694         then do:
     1695           if error-status :get-message(1) <> ""
     1696           then do:
     1697             message
     1698               vss-workfile vss-revision vss-description skip
     1699               vss-include-info4 skip
     1700               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     1701               error-status :get-message(1) skip
     1702               return-value skip
     1703               view-as alert-box error .
     1704           end.
     1705           undo, return error return-value .
     1706         end.
     1707         assign
     1708           v-cons-qnty = 0
     1709           v-prch-qnty = 0
     1710         .
     1711         for each buf_parts no-lock
     1712           where buf_parts.out-code  = buf_price-list.doc-num
     1713             and buf_parts.obj-type  = buf_price-list.obj-type
     1714             and buf_parts.obj-code  = buf_price-list.obj-code
     1715             and buf_parts.artic     = buf_price-list.artic
     1716             and buf_parts.prod-type = buf_price-list.prod-type
     1717             and buf_parts.prod-code = buf_price-list.prod-code
     1718         on error undo, return error return-value
     1719         :
     1720           if buf_parts.pay-code = p-cons-pay
     1721           then do:
     1722             assign
     1723               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     1724             .
     1725           end.
     1726           else do:
     1727             assign
     1728               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     1729             .
     1730           end.
     1731         end.
     1732         if (v-cons-qnty + v-prch-qnty) = 0
     1733         then do:
     1734           assign
     1735             v-cons-mult = 0
     1736             v-prch-mult = 1
     1737           .
     1738         end.
     1739         else do:
     1740           assign
     1741             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     1742             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     1743           .
     1744         end.
     1745         assign
     1746           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     1747           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     1748           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     1749           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     1750           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     1751           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     1752         .
     1753       end.
     1754     end.
     1755   end procedure.
     1756   procedure prdoclib-calc-ov :
     1757     define input  parameter p-price-list-recid as recid     no-undo .
     1758     define output parameter p-fact-qnty        as decimal   no-undo .
     1759     define output parameter p-ov-base          as decimal   no-undo .
     1760     define output parameter p-ov-VAT-base      as decimal   no-undo .
     1761     define output parameter p-ov-SLT-base      as decimal   no-undo .
     1762     do
     1763     on error undo, return error return-value
     1764     :
     1765       define buffer buf_main_price-list    for ub.price-list .
     1766       define buffer buf_prev_price-list    for ub.price-list .
     1767       define buffer buf_special_price-list for ub.price-list .
     1768       define buffer buf_goods              for ub.goods .
     1769       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     1770       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     1771       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     1772       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     1773       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     1774       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     1775       define variable v-prev-price-list-recid as   recid                  no-undo.
     1776       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     1777       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     1778       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     1779       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     1780       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     1781       find first buf_main_price-list no-lock
     1782         where recid(buf_main_price-list) = p-price-list-recid
     1783         no-error .
     1784       if not available buf_main_price-list
     1785       then do:
     1786         message
     1787           vss-workfile vss-revision vss-description skip
     1788           vss-include-info4 skip
     1789           "Ошибка задания входных параметров" skip
     1790           "Не найдена строка переоценки" skip
     1791           "Код записи (recid)" p-price-list-recid skip
     1792           view-as alert-box error .
     1793         undo, return error .
     1794       end.
     1795       if buf_main_price-list.main-price <> true
     1796       then do:
     1797         message
     1798           vss-workfile vss-revision vss-description skip
     1799           vss-include-info4 skip
     1800           "Ошибка задания входных параметров" skip
     1801           "Строка переоценки не является основной" skip
     1802           "Код записи (recid)" p-price-list-recid skip
     1803           "Переоценка" buf_main_price-list.doc-num skip
     1804           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1805           "Бар-код" buf_main_price-list.b-code skip
     1806           view-as alert-box error .
     1807         undo, return error .
     1808       end.
     1809       run prdoclib-calc-fact-sale in this-procedure
     1810         (input  recid(buf_main_price-list)
     1811         ,output v-fact-qnty
     1812         ,output v-cur-base
     1813         ,output v-cur-VAT-base
     1814         ,output v-cur-SLT-base
     1815         ,output v-cur-road-tax-base
     1816         ,output v-cur-excise-base
     1817         ) no-error.
     1818       if error-status :error
     1819       then do:
     1820         message
     1821           vss-workfile vss-revision vss-description skip
     1822           vss-include-info4 skip
     1823           "Ошибка при расчете сумм переоценки." skip
     1824           "Документ переоценки" buf_main_price-list.doc-num skip
     1825           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1826           error-status :get-message(1) skip
     1827           return-value skip
     1828           view-as alert-box error .
     1829         undo, return error .
     1830       end.
     1831   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1832   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1833     (input  buf_main_price-list.obj-type
     1834     ,input  buf_main_price-list.obj-code
     1835     ,input  buf_main_price-list.b-code
     1836     ,input  buf_main_price-list.b-code
     1837     ,input  buf_main_price-list.fact-order
     1838     ,output v-prev-price-list-recid
     1839     ,output v-prev-cli-base-rate
     1840     ) no-error .
     1841       if error-status :error
     1842       then do:
     1843         message
     1844           vss-workfile vss-revision vss-description skip
     1845           vss-include-info4 skip
     1846           "Ошибка при поиске предыдущей переоценки." skip
     1847           "Документ переоценки " buf_main_price-list.doc-num skip
     1848           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1849           error-status :get-message(1) skip
     1850           return-value skip
     1851           view-as alert-box error .
     1852         undo, return error .
     1853       end.
     1854       if v-prev-price-list-recid <> ?
     1855       then do:
     1856         find first buf_prev_price-list no-lock
     1857           where recid(buf_prev_price-list) = v-prev-price-list-recid
     1858           .
     1859         find first buf_special_price-list no-lock
     1860           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     1861             and buf_special_price-list.main-price = false
     1862             and buf_special_price-list.artic      = buf_prev_price-list.artic
     1863             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     1864             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     1865             and buf_special_price-list.doc-qnty   <> ?
     1866           no-error .
     1867         if available buf_special_price-list
     1868         then do:
     1869           message
     1870             "Товар имеет специальные цены на признаки" skip
     1871             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1872             "Переоценка" buf_prev_price-list.doc-num skip
     1873             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1874             view-as alert-box error .
     1875           undo, return error .
     1876         end.
     1877         find first buf_goods no-lock
     1878           where buf_goods.artic     = buf_main_price-list.artic
     1879             and buf_goods.prod-type = buf_main_price-list.prod-type
     1880             and buf_goods.prod-code = buf_main_price-list.prod-code
     1881           no-error .
     1882         if not available buf_goods
     1883         then do:
     1884           message
     1885             vss-workfile vss-revision vss-description skip
     1886             vss-include-info4 skip
     1887             "Не найден товар" skip
     1888             "Переоценка" buf_main_price-list.doc-num skip
     1889             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1890             view-as alert-box error .
     1891           undo, return error .
     1892         end.
     1893         if buf_prev_price-list.vat-pc = ?
     1894         or buf_prev_price-list.slt-pc = ?
     1895         then do:
     1896           message
     1897             "В переоценке не заданы налоги товара" skip
     1898             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     1899             "Переоценка" buf_prev_price-list.doc-num skip
     1900             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     1901             "НДС" buf_prev_price-list.vat-pc skip
     1902             "НП" buf_prev_price-list.slt-pc skip
     1903             view-as alert-box error .
     1904           undo, return error return-value .
     1905         end.
     1906         define variable v-prev-cur-SLT-pc as decimal no-undo .
     1907         assign
     1908           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     1909         .
     1910         assign
     1911           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     1912           v-prev-cur-VAT-base = v-fact-qnty
     1913                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     1914                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     1915           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     1916         .
     1917         assign
     1918           p-fact-qnty   = v-fact-qnty
     1919           p-ov-base     = v-cur-base     - v-prev-cur-base
     1920           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1921           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1922         .
     1923       end.
     1924       else do:
     1925         assign
     1926           v-prev-cur-base     = 0
     1927           v-prev-cur-VAT-base = 0
     1928           v-prev-cur-SLT-base = 0
     1929           .
     1930         assign
     1931           p-fact-qnty   = v-fact-qnty
     1932           p-ov-base     = v-cur-base     - v-prev-cur-base
     1933           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     1934           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     1935         .
     1936       end.
     1937     end.
     1938   end procedure.
     1939   procedure prdoclib-init-prt-obj-by-factord :
     1940     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     1941     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     1942     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     1943     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     1944     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     1945     define input parameter p-fact-order         as decimal   no-undo .
     1946     define input parameter p-include-fact-order as logical   no-undo .
     1947     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     1948     define buffer buf_gds-obj      for ub.gds-obj .
     1949     define buffer buf_doc-line     for ub.doc-line .
     1950     define buffer buf_temp-prt-obj for temp-prt-obj .
     1951     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     1952     do
     1953     on error undo, return error return-value
     1954     :
     1955       do transaction
     1956       on error undo, return error return-value
     1957       :
     1958   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1959   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1960     (input  p-obj-type
     1961     ,input  p-obj-code
     1962     ,input  p-artic
     1963     ,input  p-prod-type
     1964     ,input  p-prod-code
     1965     ,buffer buf_gds-obj
     1966     ) no-error .
     1967         if error-status :error
     1968         then do:
     1969           message
     1970             vss-workfile vss-revision vss-description skip
     1971             vss-include-info4 skip
     1972             "Невозможно найти gds-obj" skip
     1973             error-status :get-message(1) skip
     1974             return-value skip
     1975             view-as alert-box error .
     1976           undo, return error .
     1977         end.
     1978         find current buf_gds-obj exclusive-lock .
     1979       end.
     1980       run prdoclib-init-temp-prt-obj in this-procedure
     1981         (input p-obj-type
     1982         ,input p-obj-code
     1983         ,input p-artic
     1984         ,input p-prod-type
     1985         ,input p-prod-code
     1986         ,input 0
     1987         ) .
     1988       for each buf_temp-prt-obj
     1989         where buf_temp-prt-obj.is-term <> true
     1990       on error undo, return error return-value
     1991       :
     1992         delete buf_temp-prt-obj .
     1993       end.
     1994       if p-include-fact-order = true
     1995       then do:
     1996         assign
     1997          p-fact-order = p-fact-order - 0.0000000001
     1998         .
     1999       end.
     2000       for each buf_doc-line no-lock
     2001         where buf_doc-line.obj-type   = p-obj-type
     2002           and buf_doc-line.obj-code   = p-obj-code
     2003           and buf_doc-line.artic      = p-artic
     2004           and buf_doc-line.prod-type  = p-prod-type
     2005           and buf_doc-line.prod-code  = p-prod-code
     2006           and buf_doc-line.status_    = 'факт':U
     2007           and buf_doc-line.fact-order >= p-fact-order
     2008       on error undo, return error return-value
     2009       :
     2010         run prdoclib-process-document in this-procedure
     2011           (input  buf_doc-line.doc-code
     2012           ,input  p-obj-type
     2013           ,input  p-obj-code
     2014           ,input  p-artic
     2015           ,input  p-prod-type
     2016           ,input  p-prod-code
     2017           ,output v-total-gds-dtl-qnty
     2018           ) .
     2019       end.
     2020     end.
     2021   end procedure.
     2022   procedure prdoclib-process-document :
     2023     define input  parameter p-doc-code           as character no-undo .
     2024     define input  parameter p-obj-type           as character no-undo .
     2025     define input  parameter p-obj-code           as integer   no-undo .
     2026     define input  parameter p-artic              as character no-undo .
     2027     define input  parameter p-prod-type          as character no-undo .
     2028     define input  parameter p-prod-code          as integer   no-undo .
     2029     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2030     define buffer buf_trn-doc      for ub.trn-doc .
     2031     define buffer buf_gds-dtl      for ub.gds-dtl .
     2032     define buffer buf_temp-prt-obj for temp-prt-obj .
     2033     do
     2034     on error undo, return error return-value
     2035     :
     2036       find first buf_trn-doc no-lock
     2037         where buf_trn-doc.doc-code = p-doc-code
     2038         no-error .
     2039       if not available buf_trn-doc then do:
     2040         message
     2041           vss-workfile vss-revision vss-description skip
     2042           vss-include-info4 skip
     2043           "Ошибка при поиске документа" skip
     2044           "Документ" p-doc-code skip
     2045           "Объект" p-obj-type p-obj-code skip
     2046           "Артикул" p-artic p-prod-type p-prod-code skip
     2047           view-as alert-box error .
     2048         undo, return error .
     2049       end.
     2050       assign
     2051         p-total-gds-dtl-qnty = 0
     2052       .
     2053       for each buf_gds-dtl no-lock
     2054         where buf_gds-dtl.doc-code  = p-doc-code
     2055           and buf_gds-dtl.artic     = p-artic
     2056           and buf_gds-dtl.prod-type = p-prod-type
     2057           and buf_gds-dtl.prod-code = p-prod-code
     2058       on error undo, return error
     2059       :
     2060         define variable v-term-node as integer   no-undo .
     2061   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2062     (input  buf_gds-dtl.prt-code
     2063     ,output v-term-node
     2064     )  .
     2065         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2066           (input  v-term-node
     2067           ,buffer buf_temp-prt-obj
     2068           ) .
     2069         if buf_temp-prt-obj.is-term <> true then do:
     2070           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2071                                        ,buf_gds-dtl.prt-code
     2072                                        ) .
     2073         end.
     2074         case buf_trn-doc.doc-type :
     2075           when 'при':U or
     2076           when 'возврат':U
     2077           then do:
     2078             assign
     2079               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2080                                           - buf_gds-dtl.fact-qnty
     2081               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2082                                           - buf_gds-dtl.fact-qnty
     2083             .
     2084           end.
     2085           when 'рас':U or
     2086           when 'спи':U
     2087           then do:
     2088             assign
     2089               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2090                                           + buf_gds-dtl.fact-qnty
     2091               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2092                                           + buf_gds-dtl.fact-qnty
     2093             .
     2094           end.
     2095           when 'инв':U
     2096           then do:
     2097             assign
     2098               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2099                                           - buf_gds-dtl.doc-qnty
     2100               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2101                                           - buf_gds-dtl.doc-qnty
     2102             .
     2103           end.
     2104           otherwise do:
     2105             undo, return error substitute("Неизвестный тип документа &1"
     2106                                          ,buf_trn-doc.doc-type
     2107                                          ) .
     2108           end.
     2109         end.
     2110       end.
     2111     end.
     2112   end procedure.
     2113   procedure prdoclib-prc-pl-document :
     2114     define input  parameter p-doc-code              as character no-undo .
     2115     define input  parameter p-obj-type              as character no-undo .
     2116     define input  parameter p-obj-code              as integer   no-undo .
     2117     define input  parameter p-gds-code              as integer   no-undo .
     2118     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2119     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2120     do
     2121     on error undo, return error return-value
     2122     :
     2123       define buffer buf_trn-doc      for ub.trn-doc .
     2124       define buffer buf_doc-pl       for ub.doc-pl .
     2125       define buffer buf_temp-pl-gds for temp-pl-gds .
     2126       define variable v-sign as decimal   no-undo .
     2127       find first buf_trn-doc no-lock
     2128         where buf_trn-doc.doc-code = p-doc-code
     2129         no-error .
     2130       if not available buf_trn-doc then do:
     2131         message
     2132           vss-workfile vss-revision vss-description skip
     2133           vss-include-info4 skip
     2134           "Ошибка при поиске документа" skip
     2135           "Документ" p-doc-code skip
     2136           "Объект" p-obj-type p-obj-code skip
     2137           "Товар" p-gds-code skip
     2138           view-as alert-box error .
     2139         undo, return error .
     2140       end.
     2141       assign
     2142         p-total-pl-gds-qnty     = 0
     2143         p-total-pl-gds-cli-qnty = 0
     2144       .
     2145       for each buf_doc-pl no-lock
     2146         where buf_doc-pl.out-code  = p-doc-code
     2147           and buf_doc-pl.gds-code  = p-gds-code
     2148       on error undo, return error return-value
     2149       :
     2150         find first buf_temp-pl-gds
     2151           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2152             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2153             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2154           .
     2155         case buf_trn-doc.doc-type :
     2156           when 'при':U
     2157           or when 'возврат':U
     2158           or when 'инв':U
     2159           then do:
     2160             assign
     2161               v-sign = -1.0
     2162             .
     2163           end.
     2164           when 'рас':U or
     2165           when 'спи':U
     2166           then do:
     2167             assign
     2168               v-sign = 1.0
     2169             .
     2170           end.
     2171           otherwise do:
     2172             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2173           end.
     2174         end case.
     2175         assign
     2176           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2177           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2178           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2179           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2180         .
     2181       end.
     2182     end.
     2183   end procedure.
     2184   procedure prdoclib-init-prt-obj-by-date :
     2185     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2186     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2187     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2188     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2189     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2190     define input parameter p-fact-date  as date      no-undo .
     2191     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2192     do
     2193     on error undo, return error return-value
     2194     :
     2195       define variable v-fact-order                as decimal   no-undo .
     2196       define variable v-shift-end-fact-order      as decimal   no-undo .
     2197       define variable v-day-end-fact-order        as decimal   no-undo .
     2198       run factord in this-procedure
     2199         (input  p-fact-date
     2200         ,input  1
     2201         ,input  1
     2202         ,input  ?
     2203         ,input  0
     2204         ,input  false
     2205         ,output v-fact-order
     2206         ,output v-shift-end-fact-order
     2207         ,output v-day-end-fact-order
     2208         ) no-error .
     2209       if error-status :error
     2210       then do:
     2211         message
     2212           vss-workfile vss-revision vss-description skip
     2213           vss-include-info4 skip
     2214           "Ошибка при определении момента времени, на который требуется остаток" skip
     2215           "Объект" p-obj-type p-obj-code skip
     2216           "Артикул" p-artic p-prod-type p-prod-code skip
     2217           "Дата" p-fact-date skip
     2218           view-as alert-box error .
     2219         undo, return error .
     2220       end.
     2221       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2222         (input p-obj-type
     2223         ,input p-obj-code
     2224         ,input p-artic
     2225         ,input p-prod-type
     2226         ,input p-prod-code
     2227         ,input v-day-end-fact-order
     2228         ,input false
     2229         ) no-error .
     2230       if error-status :error
     2231       then do:
     2232         message
     2233           vss-workfile vss-revision vss-description skip
     2234           vss-include-info4 skip
     2235           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2236           "Объект" p-obj-type p-obj-code skip
     2237           "Артикул" p-artic p-prod-type p-prod-code skip
     2238           "Дата" p-fact-date skip
     2239           view-as alert-box error .
     2240         undo, return error .
     2241       end.
     2242     end.
     2243   end procedure.
     2244   procedure prdoclib-calc-temp-fact-sale :
     2245     define input  parameter p-obj-type           as character no-undo .
     2246     define input  parameter p-obj-code           as integer   no-undo .
     2247     define input  parameter p-gds-code           as integer   no-undo .
     2248     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2249     define input  parameter p-curr-r-b           as character no-undo .
     2250     define output parameter p-fact-qnty          as decimal   no-undo .
     2251     define output parameter p-cur-base           as decimal   no-undo .
     2252     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2253     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2254     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2255     define output parameter p-cur-excise-base    as decimal   no-undo .
     2256     define buffer buf_temp-prt-obj for temp-prt-obj .
     2257     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2258     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2259     define variable parrecid-prl        as recid     no-undo .
     2260     define variable v-fact-qnty         as decimal   no-undo .
     2261     define variable v-cur-base          as decimal   no-undo .
     2262     define variable v-cur-VAT-base      as decimal   no-undo .
     2263     define variable v-cur-SLT-base      as decimal   no-undo .
     2264     define variable v-cur-road-tax-base as decimal   no-undo .
     2265     define variable v-cur-excise-base   as decimal   no-undo .
     2266     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2267     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2268     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2269     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2270     define variable vat-base-sale-prl               as decimal   no-undo .
     2271     define variable vat-rubl-sale-prl               as decimal   no-undo .
     2272     define variable vat-base-buyer-prl              as decimal   no-undo .
     2273     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2274     define variable slt-base-sale-prl               as decimal   no-undo .
     2275     define variable slt-rubl-sale-prl               as decimal   no-undo .
     2276     define variable road-tax-base-sale-prl          as decimal   no-undo .
     2277     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2278     define variable excise-base-sale-prl            as decimal   no-undo .
     2279     define variable excise-rubl-sale-prl            as decimal   no-undo .
