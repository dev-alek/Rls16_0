     1502             error-status :get-message(1) skip
     1503             return-value skip
     1504             view-as alert-box error .
     1505           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1506         end.
     1507         for each buf_price-list no-lock
     1508           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     1509             and buf_price-list.main-price = false
     1510             and buf_price-list.artic      = buf_main_price-list.artic
     1511             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     1512             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     1513         :
     1514           if buf_price-list.doc-qnty = ?
     1515           then do:
     1516             find first buf_bar-code no-lock
     1517               where buf_bar-code.b-code = buf_price-list.b-code
     1518               no-error .
     1519             if available buf_bar-code
     1520             and buf_bar-code.unit-cli = v-unit-base
     1521             then do:
     1522               message
     1523                 vss-workfile vss-revision vss-description skip
     1524                 vss-include-info4 skip
     1525                 "Ошибка при закрытии переоценки" skip
     1526                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1527                 "Переоценка" buf_main_price-list.doc-num skip
     1528                 "Бар-код" buf_price-list.b-code skip
     1529                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1530                 "Количество" buf_price-list.doc-qnty skip
     1531                 "Основная единица измерения" v-unit-base skip
     1532                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1533                 view-as alert-box error .
     1534               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1535             end.
     1536             next .
     1537           end.
     1538           if not can-find
     1539             (first buf_bar-code
     1540             where buf_bar-code.b-code = buf_price-list.b-code
     1541             )
     1542           then do:
     1543             message
     1544               vss-workfile vss-revision vss-description skip
     1545               vss-include-info4 skip
     1546               "В переоценке задан несуществующий бар-код" skip
     1547               "Переоценка" buf_price-list.doc-num skip
     1548               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1549               "Бар-код" buf_price-list.b-code skip
     1550               view-as alert-box error .
     1551             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1552           end.
     1553           if buf_price-list.doc-qnty <> 0
     1554           then do:
     1555             run prl-vat in this-procedure
     1556               (input  recid(buf_price-list)
     1557               ,output price-rubl-with-tax-sale-prl
     1558               ,output price-base-with-tax-sale-prl
     1559               ,output price-rubl-without-tax-sale-prl
     1560               ,output price-base-without-tax-sale-prl
     1561               ,output vat-base-sale-prl
     1562               ,output vat-rubl-sale-prl
     1563               ,output vat-base-buyer-prl
     1564               ,output vat-rubl-buyer-prl
     1565               ,output slt-base-sale-prl
     1566               ,output slt-rubl-sale-prl
     1567               ,output road-tax-base-sale-prl
     1568               ,output road-tax-rubl-sale-prl
     1569               ,output excise-base-sale-prl
     1570               ,output excise-rubl-sale-prl
     1571               ,output discnt-base-sale-prl
     1572               ,output discnt-rubl-sale-prl
     1573               ) no-error .
     1574             if error-status :error
     1575             then do:
     1576               message
     1577                 vss-workfile vss-revision vss-description skip
     1578                 vss-include-info4 skip
     1579                 "Ошибка при вызове процеды prl-vat" skip
     1580                 "Документ" buf_price-list.doc-num skip
     1581                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     1582                 error-status :get-message(1) skip
     1583                 return-value skip
     1584                 view-as alert-box error .
     1585               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1586             end.
     1587           end.
     1588           else do:
     1589             assign
     1590               price-rubl-with-tax-sale-prl    = 0
     1591               price-base-with-tax-sale-prl    = 0
     1592               price-rubl-without-tax-sale-prl = 0
     1593               price-base-without-tax-sale-prl = 0
     1594               vat-base-sale-prl               = 0
     1595               vat-rubl-sale-prl               = 0
     1596               vat-base-buyer-prl              = 0
     1597               vat-rubl-buyer-prl              = 0
     1598               slt-base-sale-prl               = 0
     1599               slt-rubl-sale-prl               = 0
     1600               road-tax-base-sale-prl          = 0
     1601               road-tax-rubl-sale-prl          = 0
     1602               excise-base-sale-prl            = 0
     1603               excise-rubl-sale-prl            = 0
     1604               discnt-base-sale-prl            = 0
     1605               discnt-rubl-sale-prl            = 0
     1606             .
     1607           end.
     1608           if v-curr-r-b = 'base':U
     1609           then do:
     1610             assign
     1611               p-fact-qnty         = p-fact-qnty
     1612                                   + buf_price-list.doc-qnty
     1613               p-cur-base          = p-cur-base
     1614                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     1615               p-cur-VAT-base      = p-cur-VAT-base
     1616                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     1617               p-cur-SLT-base      = p-cur-SLT-base
     1618                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     1619               p-cur-road-tax-base = p-cur-road-tax-base
     1620                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     1621               p-cur-excise-base   = p-cur-excise-base
     1622                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     1623             .
     1624           end.
     1625           else do:
     1626             assign
     1627               p-fact-qnty         = p-fact-qnty
     1628                                   + buf_price-list.doc-qnty
     1629               p-cur-base          = p-cur-base
     1630                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     1631               p-cur-VAT-base      = p-cur-VAT-base
     1632                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     1633               p-cur-SLT-base      = p-cur-SLT-base
     1634                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     1635               p-cur-road-tax-base = p-cur-road-tax-base
     1636                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     1637               p-cur-excise-base   = p-cur-excise-base
