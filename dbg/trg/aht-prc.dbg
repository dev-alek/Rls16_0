     2689         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2690       end.
     2691       if varslt-pc = ?
     2692       then do:
     2693         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2694       end.
     2695       assign
     2696         varbase-rate   = 1
     2697         varbase-scale  = 1
     2698         varroad-tax    = bf_price-list.road-tax
     2699         varexcise      = bf_price-list.excise
     2700         varprice-base  = bf_price-list.price-sale
     2701         varprice-rubl  = bf_price-list.price-sale
     2702         vardiscnt-base = 0
     2703         vardiscnt-rubl = 0
     2704       .
     2705       assign
     2706         varfact-qnty = 0
     2707       .
     2708       for each bf_parts no-lock
     2709         where bf_parts.out-code   = bf_price-list.doc-num
     2710           and bf_parts.obj-type   = bf_price-list.obj-type
     2711           and bf_parts.obj-code   = bf_price-list.obj-code
     2712           and bf_parts.artic      = bf_price-list.artic
     2713           and bf_parts.prod-type  = bf_price-list.prod-type
     2714           and bf_parts.prod-code  = bf_price-list.prod-code
     2715       :
     2716         assign
     2717           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     2718         .
     2719       end.
     2720       assign
     2721         vardoc-num   = bf_price-list.doc-num
     2722         vardoc-code  = bf_price-list.doc-num
     2723         varobj-type  = bf_price-list.obj-type
     2724         varobj-code  = bf_price-list.obj-code
     2725         varartic     = bf_price-list.artic
     2726         varprod-type = bf_price-list.prod-type
     2727         varprod-code = bf_price-list.prod-code
     2728         vardoc-qnty  = varfact-qnty
     2729         varext-doc-type = 'ot':U
     2730       .
     2731   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2732   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2733     (input  bf_price-list.obj-type
     2734     ,input  bf_price-list.obj-code
     2735     ,output v-host-code
     2736     )  .
     2737       find first bf_sysconf no-lock
     2738         where bf_sysconf.host-code = v-host-code
     2739         .
     2740       if bf_sysconf.cons-vat-pc = ?
     2741       then do:
     2742         return error "Не задан консигнационный НДС по фирме." .
     2743       end.
     2744       else do:
     2745         assign
     2746           varcons-vat-pc = bf_sysconf.cons-vat-pc
     2747         .
     2748       end.
     2749   if varext-doc-type = 'ot':U or
     2750      varext-doc-type = ?                 then do:
     2751     assign
     2752      out-vatp-have-vat-sltprl = yes.
     2753   end.
     2754   else do:
     2755     find first out-vatp_doc-attrprl no-lock
     2756       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     2757         and out-vatp_doc-attrprl.attr-code = 'envd':U
     2758         no-error .
     2759     if not available out-vatp_doc-attrprl then do:
     2760       assign
     2761         out-vatp-have-vat-sltprl = yes.
     2762     end.
     2763     else do:
     2764        out-vatp-have-vat-sltprl = no.
     2765     end.
     2766   end.
     2767   find first out-vatp_goodsprl where out-vatp_goodsprl.artic     = varartic     and
     2768                                      out-vatp_goodsprl.prod-type = varprod-type and
     2769                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
     2770   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2771   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     2772     (input  varartic
     2773     ,input  varprod-type
     2774     ,input  varprod-code
     2775     ,output varroot-nodeprl
     2776     ) no-error .
     2777   if error-status :error then do:
     2778     message
     2779       vss-workfile vss-revision vss-description skip
     2780       "Ошибка при определении корневого признака товара" skip
     2781       "Артикул" varartic varprod-type varprod-code skip
     2782       error-status :get-message(1) skip
     2783       return-value skip
     2784       view-as alert-box error .
     2785     undo, return error .
     2786   end.
     2787   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2788     (input  varroot-nodeprl
     2789     ,input  'empty-scale=request'
     2790     ,output varempty-scaleprl
     2791     ) no-error .
     2792   if error-status :error then do:
     2793     message
     2794       vss-workfile vss-revision vss-description skip
     2795       "Ошибка при определении атрибута признака" skip
     2796       "Артикул" varartic varprod-type varprod-code skip
     2797       "Признак" varroot-nodeprl skip
     2798       "Запрашивался атрибут" "empty-scale=request" skip
     2799       error-status :get-message(1) skip
     2800       return-value skip
     2801       view-as alert-box error .
     2802     undo, return error .
     2803   end.
     2804   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2806     (output varoutvprbprl
     2807     )  .
     2808   if varoutvprbprl = "base":u then do:
     2809     assign
     2810           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     2811       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     2812     .
     2813   end.
     2814   else do:
     2815     assign
     2816           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     2817       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     2818     .
     2819   end.
     2820   if varoutvprbprl = "rubl":u then do:
     2821     assign
     2822           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     2823       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     2824   end.
     2825   else do:
     2826     assign
     2827           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     2828       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     2829   end.
     2830   assign
     2831     varis-cons-parts-haveprl =  no.
     2832   assign
     2833     varfact-qntyprl       = 0
     2834     varcons-qntyprl       = 0
     2835     varprice-base-consprl = 0
     2836     varprice-rubl-consprl = 0.
     2837   find first out-vatp_doc-lineprl where
