     4685       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     4686     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     4687     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     4688   end.
     4689   when 3 then do:
     4690     assign
     4691       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     4692       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     4693     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     4694     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     4695   end.
     4696   when 2 then do:
     4697     assign
     4698       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     4699       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     4700     assign
