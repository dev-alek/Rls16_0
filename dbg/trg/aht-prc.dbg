     5231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5232     (input  bf_trn-doc.obj-type
     5233     ,input  bf_trn-doc.obj-code
     5234     ,input  varb-code
     5235     ,input  0
     5236     ,input  bf_trn-doc.fact-order
     5237     ,output vardoc-num
     5238     ,output varprice-sale
     5239     ,output varroad-tax
     5240     ,output varexcise
     5241     )  .
     5242             if varprice-sale = ?
     5243             then do:
     5244               assign
     5245                 varprice-sale = 0
     5246                 varroad-tax   = 0
     5247                 varexcise     = 0
     5248               .
     5249             end.
     5250             assign
     5251               varlastcur-base     = varprice-sale
     5252               varlastcur-road-tax = varroad-tax
     5253               varlastcur-excise   = varexcise
     5254               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5255               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5256               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5257               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5258             .
     5259         end.
     5260       end.
     5261       if varcur-fact-qnty = 0 then do:
     5262         assign
     5263           varcur-base      = varlastcur-base
     5264           varcur-road-tax  = varlastcur-road-tax
     5265           varcur-excise    = varlastcur-excise
     5266         .
     5267       end.
     5268       else do:
     5269         assign
     5270           varcur-base      = varcur-base      / varcur-fact-qnty
     5271           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5272           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5273         .
     5274       end.
     5275       if varcur-vat-pc = ?
     5276       then do:
     5277         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5278       end.
     5279       if varcur-slt-pc = ?
     5280       then do:
     5281         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5282       end.
     5283       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     5284       assign
     5285         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     5286       if varcur-cons-vat-pc = ? then do:
     5287         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     5288       end.
     5289       define buffer buf_tt-clcparts for tt-clcparts .
     5290       for each buf_tt-clcparts
     5291       on error undo, return error return-value
     5292       :
     5293         delete buf_tt-clcparts.
     5294       end.
     5295       for each bf_parts no-lock
     5296         where bf_parts.out-code  = bf_doc-line.doc-code
     5297           and bf_parts.obj-type  = bf_doc-line.obj-type
     5298           and bf_parts.obj-code  = bf_doc-line.obj-code
     5299           and bf_parts.artic     = bf_doc-line.artic
     5300           and bf_parts.prod-type = bf_doc-line.prod-type
     5301           and bf_parts.prod-code = bf_doc-line.prod-code
     5302       on error undo, return error return-value
     5303       :
     5304         create buf_tt-clcparts .
     5305         buffer-copy bf_parts to buf_tt-clcparts .
     5306         if v-calcbypart = yes   then do:
     5307   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     5308     (buffer bf_parts
     5309     ,output v-b-pcode
     5310     ) no-error .
     5311   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5312   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5313     (input  bf_parts.obj-type
     5314     ,input  bf_parts.obj-code
     5315     ,input  v-b-pcode
     5316     ,input  0
     5317     ,input  bf_trn-doc.fact-order
     5318     ,output vardoc-num
     5319     ,output varprice-salef
     5320     ,output varroad-tax
     5321     ,output varexcise
     5322     ) no-error .
     5323             if varprice-sale = ?
     5324             then do:
     5325               assign
     5326                 varprice-salef = 0
     5327                 varroad-tax   = 0
     5328                 varexcise     = 0
     5329               .
     5330             end.
     5331             assign
     5332             part-cur-base  = varprice-salef
     5333             part-cur-road-tax  = varroad-tax
     5334             part-cur-excise = varexcise.
     5335         end.
     5336       end.
     5337       run clcprtsl_calc-ttable in this-procedure
     5338         (input yes,
     5339          input yes,
     5340          input bf_doc-line.road-tax,
     5341          input bf_doc-line.excise,
     5342          input bf_doc-line.vat-pc,
     5343          input bf_doc-line.cons-vat-pc,
     5344          input bf_doc-line.slt-pc,
     5345          input bf_trn-doc.base-rate,
     5346          input bf_trn-doc.base-scale,
     5347          input varr-b,
     5348          input varcur-base,
     5349          input varcur-road-tax,
     5350          input varcur-excise,
     5351          input varcur-vat-pc,
     5352          input varcur-cons-vat-pc,
     5353          input varcur-slt-pc
     5354          ) no-error.
     5355       if error-status:error then do:
     5356         message
     5357           vss-workfile vss-revision vss-description skip
     5358           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5359           return-value skip
     5360           trim(error-status :get-message(1))
     5361           trim(error-status :get-message(2))
     5362           trim(error-status :get-message(3))
     5363           trim(error-status :get-message(4))
     5364           trim(error-status :get-message(5)) skip
     5365           view-as alert-box error.
     5366         undo, return error .
     5367       end.
     5368     end.
     5369   end.
     5370   end.
     5371   procedure clcprtsl_calc-ttable :
     5372   define input parameter paris-doc           as   logical                 no-undo.
     5373   define input parameter paris-cur           as   logical                 no-undo.
     5374   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5375   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5376   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5377   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5378   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5379   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5380   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5381   define input parameter parr-b              as   character               no-undo.
     5382   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5383   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5384   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5385   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5386   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5387   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5388   define buffer bf_tt-allsum      for tt-allsum.
     5389   define buffer bf_tt-clcparts    for tt-clcparts.
     5390   define buffer bf_tt-allsum-line for tt-allsum-line.
     5391   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5392   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5393   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5394   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5395   define variable varexcise          like ub.price-list.excise     no-undo.
     5396   do on error undo, return error return-value :
     5397   for each bf_tt-allsum-line
     5398   on error undo, return error return-value
     5399    :
     5400     delete bf_tt-allsum-line.
     5401   end.
     5402   for each bf_tt-allsum
     5403   on error undo, return error return-value
     5404   :
     5405     delete bf_tt-allsum.
     5406   end.
     5407   for each bf_tt-clcparts
     5408   on error undo, return error return-value
     5409   :
     5410   if v-calcbypart then do:
     5411             assign
     5412             parcur-base =   bf_tt-clcparts.part-cur-base
     5413             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5414             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5415             .
     5416   end.
     5417      run clcprtsl_calc-parts in this-procedure (
     5418        input recid(bf_tt-clcparts),
     5419        input paris-doc,
     5420        input paris-cur,
     5421        input parroad-tax,
     5422        input parexcise,
     5423        input parvat-pc,
     5424        input parcons-vat-pc,
     5425        input parslt-pc,
     5426        input parbase-rate,
     5427        input parbase-scale,
     5428        input parr-b,
     5429        input parcur-base,
     5430        input parcur-road-tax,
     5431        input parcur-excise,
     5432        input parcur-vat-pc,
     5433        input parcurcons-vat-pc,
     5434        input parcurslt-pc
     5435        ) no-error.
     5436     if error-status:error then do:
     5437       message
     5438         vss-workfile vss-revision vss-description skip
     5439         vss-include-info27 skip
     5440         "Ошибка при обсчете партии" skip
     5441         "Документ партии " bf_tt-clcparts.out-code skip
     5442         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5443         return-value skip
     5444         error-status:get-message(1) skip
     5445         error-status:get-message(2) skip
     5446         error-status:get-message(3) skip
     5447         view-as alert-box error .
     5448       undo, return error .
     5449     end.
     5450     for each bf_tt-allsum on error undo, return error return-value :
     5451       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5452       if not available bf_tt-allsum-line then do:
     5453         create bf_tt-allsum-line.
     5454         assign
     5455           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     5456       end.
     5457       assign
     5458         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     5459         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     5460         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     5461         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     5462         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     5463         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     5464         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     5465         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     5466         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     5467         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     5468         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     5469         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     5470         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     5471         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     5472         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     5473         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     5474         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     5475         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     5476         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     5477         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     5478         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     5479         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     5480         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     5481         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     5482         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     5483         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     5484         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     5485         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     5486         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     5487         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     5488         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     5489         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     5490         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     5491         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     5492         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     5493         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     5494         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     5495         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     5496         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     5497         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     5498         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     5499         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     5500         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     5501         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     5502         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     5503         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     5504         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     5505         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     5506         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     5507         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     5508         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     5509         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     5510         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     5511         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     5512         .
     5513     end.
     5514   end.
     5515   end.
     5516   end procedure.
     5517   define variable v-ind                       as integer   no-undo .
     5518   define variable v-doc-date                  as date      no-undo .
     5519   define variable v-start-time                as integer   no-undo .
     5520   define variable v-current-time              as character no-undo .
     5521   define variable v-current-action            as character no-undo .
     5522   main-block :
     5523   do transaction
     5524   on error undo main-block, return error
     5525   :
     5526     define frame a
     5527       v-current-action format 'x(40)':u      no-labels skip
     5528       v-ind            format '>>>>>>>9':u   label "Обработано артикулов" skip
     5529       v-current-time   format 'x(8)':u       label "Время расчета документа" skip
     5530       p-doc-code       format 'x(14)':u      label "Переоценка" skip
     5531       v-doc-date       format '99/99/9999':u label "Дата закрытия документа" skip
     5532       with view-as dialog-box side-labels three-d
     5533       title "Расчет складского архива по типам приобретения"
     5534       .
     5535     define variable mFrameView  as logical no-undo init yes.
     5536     define variable mFramHandle as handle  no-undo.
     5537     mFramHandle = frame a:handle.
     5538     if  log-manager:logfile-name ne ?
     5539     then DO:
     5540         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameoxmError").
     5541         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameoxmError").
     5542     end.
     5543     mFrameView = not session:batch-mode and mFramHandle:visible.
     5544     if mFrameView
     5545     then do:
     5546       view frame a .
     5547       display
     5548         p-doc-code
     5549         with frame a .
     5550     end.
     5551     run process-price-doc in this-procedure
     5552       (input p-doc-code
     5553       ,input p-cut-date
     5554       ) no-error .
     5555     if error-status :error
     5556     then do:
     5557       message
     5558         vss-workfile vss-revision vss-description skip
     5559         "Ошибка при обработке документа" skip
     5560         "Переоценка" p-doc-code skip
     5561         "Ограничение на обновление складского архива" p-cut-date skip
     5562         error-status :get-message(1) skip
     5563         return-value skip
     5564         view-as alert-box error .
     5565       undo, return error .
     5566     end.
     5567   end.
     5568   procedure process-price-doc :
     5569     define input  parameter p-doc-code as character no-undo .
     5570     define input  parameter p-cut-date as date      no-undo .
     5571     define variable v-fact-order                as decimal   no-undo .
     5572     define variable v-shift-end-fact-order      as decimal   no-undo .
     5573     define variable v-day-end-fact-order        as decimal   no-undo .
     5574     define variable v-day-cut-fact-order        as decimal   no-undo .
     5575     define variable v-today as date      no-undo .
     5576     define variable v-time  as integer   no-undo .
     5577     define buffer buf_price-doc for ub.price-doc .
     5578     define buffer buf_price-list for ub.price-list .
     5579     do
     5580     on error undo, return error return-value
     5581     :
     5582       find first buf_price-doc share-lock
     5583         where buf_price-doc.doc-num = p-doc-code
     5584         no-error .
     5585       if not available buf_price-doc
     5586       then do:
     5587         message
     5588           vss-workfile vss-revision vss-description skip
     5589           "Ошибка задания входных параметров" skip
     5590           "Не найдена переоценка" p-doc-code skip
     5591           view-as alert-box error .
     5592         undo, return error .
     5593       end.
     5594       assign
     5595         v-doc-date = buf_price-doc.fact-date
     5596       .
     5597       if mFrameView
     5598       then display
     5599         v-doc-date
     5600         with frame a .
     5601       if buf_price-doc.status_ <> 'акт':U
     5602       then do:
     5603         message
     5604           vss-workfile vss-revision vss-description skip
     5605           "Нельзя рассчитать складской архив по типам приобретения для документа переоценки не закрытого до статуса" 'акт':U skip
     5606           "Переоценка" p-doc-code skip
     5607           view-as alert-box error .
     5608         undo, return error .
     5609       end.
     5610       define variable v-shift-on as logical   no-undo .
     5611   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5613     (input  buf_price-doc.obj-type
     5614     ,input  buf_price-doc.obj-code
     5615     ,input  'shift-on=request'
     5616     ,output v-shift-on
     5617     ) no-error .
     5618       if error-status :error
