     2909           varprice-base-consprl = varprice-base-consprl + (price-base-with-tax-locoprl - (if road-tax-base-locoprl = ? then 0 else road-tax-base-locoprl))* out-vatp_partsprl.fact-qnty
     2910           varprice-rubl-consprl = varprice-rubl-consprl + (price-rubl-with-tax-locoprl - (if road-tax-rubl-locoprl = ? then 0 else road-tax-rubl-locoprl))* out-vatp_partsprl.fact-qnty.
     2911         assign
     2912           varis-cons-parts-haveprl = yes
     2913           varcons-qntyprl          = varcons-qntyprl + out-vatp_partsprl.fact-qnty.
     2914       end.
     2915       assign
     2916         varfact-qntyprl = varfact-qntyprl + out-vatp_partsprl.fact-qnty.
     2917     end.
     2918   end.
     2919   assign
     2920     varprice-base-consprl = varprice-base-consprl / varcons-qntyprl
     2921     varprice-rubl-consprl = varprice-rubl-consprl / varcons-qntyprl.
     2922   if varprice-base-consprl = ? then do:
     2923     assign
