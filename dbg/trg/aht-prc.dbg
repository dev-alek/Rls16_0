     4670       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     4671   end.
     4672   create bfpc_tt-allsum.
     4673   create bfspc_tt-allsum.
     4674   case cl_tt-clcparts.purch-code :
     4675   when 1           then do:
     4676     assign
     4677       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     4678       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
