     4656       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     4657       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     4658       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     4659       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
