     1441         end.
     1442       end.
     1443       else do:
     1444         assign
     1445           price-rubl-with-tax-sale-prl    = 0
     1446           price-base-with-tax-sale-prl    = 0
     1447           price-rubl-without-tax-sale-prl = 0
     1448           price-base-without-tax-sale-prl = 0
     1449           vat-base-sale-prl               = 0
     1450           vat-rubl-sale-prl               = 0
     1451           vat-base-buyer-prl              = 0
     1452           vat-rubl-buyer-prl              = 0
     1453           slt-base-sale-prl               = 0
     1454           slt-rubl-sale-prl               = 0
     1455           road-tax-base-sale-prl          = 0
     1456           road-tax-rubl-sale-prl          = 0
     1457           excise-base-sale-prl            = 0
     1458           excise-rubl-sale-prl            = 0
     1459           discnt-base-sale-prl            = 0
     1460           discnt-rubl-sale-prl            = 0
     1461         .
     1462       end.
     1463       define variable v-curr-r-b as character no-undo .
     1464   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1466     (output v-curr-r-b
     1467     )  .
     1468       if v-curr-r-b = 'base':U
     1469       then do:
     1470         assign
     1471           p-fact-qnty         = buf_main_price-list.doc-qnty
     1472           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1473           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
