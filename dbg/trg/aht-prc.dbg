     3080   procedure aht_update-ot-tot :
     3081     define input  parameter p-obj-type            like ub.trn-doc.obj-type     no-undo .
     3082     define input  parameter p-obj-code            like ub.trn-doc.obj-code     no-undo .
     3083     define input  parameter p-fact-order          like ub.trn-doc.fact-order   no-undo .
     3084     define input  parameter p-ext-doc-type        like ub.trn-doc.ext-doc-type no-undo .
     3085     define buffer buf_temp-aht-ot-line for temp-aht-ot-line .
     3086     define buffer buf_temp-aht-ot-tot for temp-aht-ot-tot .
     3087     do
     3088     on error undo, return error
     3089     :
     3090       for each buf_temp-aht-ot-line
     3091       on error undo, return error
     3092       :
     3093         find first buf_temp-aht-ot-tot
     3094           where buf_temp-aht-ot-tot.doc-code = buf_temp-aht-ot-line.doc-code
     3095             and buf_temp-aht-ot-tot.sum-type = buf_temp-aht-ot-line.sum-type
     3096           no-error .
     3097         if not available buf_temp-aht-ot-tot then do:
     3098           create buf_temp-aht-ot-tot .
     3099           assign
     3100             buf_temp-aht-ot-tot.doc-code     = buf_temp-aht-ot-line.doc-code
     3101             buf_temp-aht-ot-tot.sum-type     = buf_temp-aht-ot-line.sum-type
     3102             buf_temp-aht-ot-tot.ext-doc-type = p-ext-doc-type
     3103             buf_temp-aht-ot-tot.obj-type     = p-obj-type
     3104             buf_temp-aht-ot-tot.obj-code     = p-obj-code
     3105             buf_temp-aht-ot-tot.fact-order   = p-fact-order
     3106           .
     3107         end.
     3108         assign
     3109           buf_temp-aht-ot-tot.fact-qnty = buf_temp-aht-ot-tot.fact-qnty + buf_temp-aht-ot-line.fact-qnty
