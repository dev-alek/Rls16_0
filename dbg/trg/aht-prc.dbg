     3258         where buf_aht-stk-line.obj-type   = buf_temp-aht-ot-line.obj-type
     3259           and buf_aht-stk-line.obj-code   = buf_temp-aht-ot-line.obj-code
     3260           and buf_aht-stk-line.gds-code   = buf_temp-aht-ot-line.gds-code
