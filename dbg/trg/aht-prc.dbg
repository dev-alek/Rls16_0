     1482           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     1483           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     1484           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     1485           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     1486           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
