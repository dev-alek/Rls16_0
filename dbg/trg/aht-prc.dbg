     2926   if varprice-rubl-consprl = ? then do:
     2927     assign
     2928       varprice-rubl-consprl = 0.
     2929   end.
     2930   assign
     2931       slt-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc)
     2932     vat-base-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     2933     discnt-base-saleprl            = vardiscnt-base
     2934     price-base-with-tax-saleprl    = (varprice-base - vardiscnt-base)
     2935       slt-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc)
     2936     vat-rubl-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc)
     2937     discnt-rubl-saleprl            = vardiscnt-rubl
     2938     price-rubl-with-tax-saleprl    = (varprice-rubl - vardiscnt-rubl)
     2939     .
     2940   if vardoc-type = 'инв':U then do:
     2941     assign
     2942       varfact-qntyprl = vardoc-qnty.
