     3903   do on error undo, return error return-value :
     3904   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     3905   for each bf_tt-allsum on error undo, return error return-value :
     3906     delete bf_tt-allsum.
     3907   end.
     3908   assign
     3909     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     3910     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     3911   .
     3912   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3914     (output varinvprbcl
     3915     )  .
     3916     if cl_tt-clcparts.out-code = 'free-zone':U     or
     3917        cl_tt-clcparts.out-code = 'out-zone':U   or
     3918        cl_tt-clcparts.doc-type = 'акт':U then do:
     3919       assign
     3920         in-vatp-have-vat-sltcl = yes.
     3921     end.
     3922     else do:
     3923       find first in-vatp_doc-attrcl no-lock
     3924         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     3925           and in-vatp_doc-attrcl.attr-code = 'envd':U
     3926         no-error .
     3927       if not available in-vatp_doc-attrcl then do:
     3928         assign
     3929           in-vatp-have-vat-sltcl = yes.
     3930       end.
     3931       else do:
     3932            in-vatp-have-vat-sltcl = no.
     3933       end.
     3934     end.
     3935     assign
     3936      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     3937      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     3938     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     3939              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
