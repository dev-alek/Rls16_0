     4944   procedure clcprtsl_calc-line :
     4945   define input  parameter parrec-line as recid no-undo.
     4946   define variable v-tax-date         as   date                     no-undo.
     4947   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     4948   define variable varr-b             as   character                no-undo.
     4949   define variable varr-btype         as   character                no-undo.
     4950   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     4951   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     4952   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     4953   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     4954   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     4955   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     4956   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     4957   define variable varb-code          like ub.bar-code.b-code       no-undo.
     4958   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4959   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4960   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4961   define variable varexcise          like ub.price-list.excise     no-undo.
     4962   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     4963   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     4964   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     4965   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4966   define variable v-varsum           as decimal                  no-undo.
     4967   define variable varprice-salef as decimal   no-undo .
     4968   define buffer bf_trn-doc             for ub.trn-doc.
     4969   define buffer bf_doc-line            for ub.doc-line.
     4970   define buffer bf_gds-dtl             for ub.gds-dtl.
     4971   define buffer bf_goods               for ub.goods.
     4972   define buffer bf_parts               for ub.parts.
     4973   define buffer bf_sysconf             for ub.sysconf.
     4974   define buffer bf_tt-allsum-line      for tt-allsum-line.
     4975   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     4976   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     4977   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     4978   define buffer buf_parts        for ub.parts.
     4979   v-calcbypart = no.
     4980   do on error undo, return error return-value :
     4981   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4982   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4983     (output varr-b
     4984     )  .
     4985     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     4986     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     4987     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     4988                               bf_goods.prod-type = bf_doc-line.prod-type and
     4989                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     4990     if bf_trn-doc.fact-date <> ?        then do:
     4991       assign v-tax-date = bf_trn-doc.fact-date.
     4992     end.
     4993     else do:
     4994       assign v-tax-date = ?.
     4995     end.
     4996   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4998     (input  bf_goods.gds-code
     4999     ,input  '1':U
     5000     ,input  v-tax-date
     5001     ,input  bf_trn-doc.host-code
     5002     ,input  bf_trn-doc.obj-type
     5003     ,input  bf_trn-doc.obj-code
     5004     ,output v-vat-pc
     5005     ) no-error .
     5006     if error-status :error
     5007     or v-vat-pc = ? then do:
     5008        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5009     end.
     5010     if bf_goods.gds-type = 'у':U or
     5011        bf_trn-doc.status_ = 'запрос':U then do:
     5012       for each bf_tt-allsum-line
     5013       on error undo, return error return-value
     5014        :
     5015         delete bf_tt-allsum-line.
     5016       end.
     5017       create bf_tt-allsum-line.
     5018       assign
     5019        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     5020       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5021                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     5022                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5023                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     5024         assign
     5025           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     5026           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     5027           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     5028           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     5029           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     5030           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5031           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5032           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     5033           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     5034           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     5035           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5036           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5037           bf_tt-allsum-line.vat-cli-acc          =  ?
     5038           .
     5039       end.
     5040       assign
     5041         bf_tt-allsum-line.cli-qnty             =  ?
     5042         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5043         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5044         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
