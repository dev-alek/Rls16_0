     1187   procedure prdoclib-create-temp-prt-obj :
     1188     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1189     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1190     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1191     define buffer buf_gds-prt for ub.gds-prt .
     1192     do
     1193     on error undo, return error return-value
     1194     :
     1195       find first buf_temp-prt-obj
     1196         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1197         no-error .
     1198       if not available buf_temp-prt-obj
     1199       then do:
     1200         create buf_temp-prt-obj .
     1201         assign
     1202           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1203           buf_temp-prt-obj.price-sale       = ?
     1204           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1205           buf_temp-prt-obj.price-list-qnty  = ?
     1206           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1207           buf_temp-prt-obj.price-list-recid = ?
     1208         .
     1209         find first buf_gds-prt no-lock
     1210           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1211           .
     1212         assign
     1213           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1214         .
     1215         if buf_temp-prt-obj.is-term
     1216         then do:
     1217           assign
     1218             buf_temp-prt-obj.price-sale = p-root-price-sale
     1219           .
     1220         end.
     1221       end.
     1222     end.
     1223   end procedure.
     1224   procedure prdoclib-temp-prt-obj-by-prt-root :
     1225     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1226     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1227     define buffer buf_gds-prt for ub.gds-prt .
     1228     do
     1229     on error undo, return error return-value
     1230     :
     1231       find first buf_temp-prt-obj
     1232         where buf_temp-prt-obj.prt-code = p-prt-code
     1233         no-error .
     1234       if not available buf_temp-prt-obj
     1235       then do:
     1236         create buf_temp-prt-obj .
     1237         assign
     1238           buf_temp-prt-obj.prt-code         = p-prt-code
     1239           buf_temp-prt-obj.price-sale       = ?
     1240           buf_temp-prt-obj.fact-qnty        = 0
     1241           buf_temp-prt-obj.price-list-qnty  = ?
     1242           buf_temp-prt-obj.prt-obj-recid    = ?
     1243           buf_temp-prt-obj.price-list-recid = ?
     1244         .
     1245         find first buf_gds-prt no-lock
     1246           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1247           .
     1248         assign
     1249           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1250         .
     1251         if buf_temp-prt-obj.is-term
     1252         then do:
     1253           assign
     1254             buf_temp-prt-obj.price-sale = 0
     1255           .
     1256         end.
     1257       end.
     1258     end.
     1259   end procedure.
     1260   procedure prdoclib-init-temp-prt-obj :
     1261     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1262     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1263     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1264     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1265     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1266     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1267     define buffer buf_prt-obj      for ub.prt-obj .
     1268     define buffer buf_temp-prt-obj for temp-prt-obj .
     1269     do
     1270     on error undo, return error return-value
     1271     :
     1272       run prdoclib-clear-temp-prt-obj in this-procedure .
     1273       for each buf_prt-obj
     1274         where buf_prt-obj.obj-type  = p-obj-type
     1275           and buf_prt-obj.obj-code  = p-obj-code
     1276           and buf_prt-obj.artic     = p-artic
     1277           and buf_prt-obj.prod-type = p-prod-type
     1278           and buf_prt-obj.prod-code = p-prod-code
     1279       on error undo, return error return-value
     1280       :
     1281         run prdoclib-create-temp-prt-obj in this-procedure
     1282           (input  p-root-price-sale
     1283           ,buffer buf_prt-obj
     1284           ,buffer buf_temp-prt-obj
     1285           ).
     1286       end.
     1287     end.
     1288   end procedure.
     1289   procedure prdoclib-calc-fact-sale :
     1290     define input  parameter p-price-list-recid   as recid     no-undo .
     1291     define output parameter p-fact-qnty          as decimal   no-undo .
     1292     define output parameter p-cur-base           as decimal   no-undo .
