     1345           vss-include-info4 skip
     1346           "Не найден товар" skip
     1347           "Переоценка" buf_main_price-list.doc-num skip
     1348           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     1349           view-as alert-box error .
     1350         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     1351       end.
