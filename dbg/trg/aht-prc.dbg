     1316           "Ошибка задания входных параметров" skip
     1317           "Не найдена строка переоценки" skip
     1318           "Код записи (recid)" p-price-list-recid skip
     1319           view-as alert-box error .
     1320         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     1321       end.
     1322       if buf_main_price-list.main-price <> true
     1323       then do:
     1324         message
